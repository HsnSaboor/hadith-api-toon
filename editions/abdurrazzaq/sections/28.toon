hadiths[605]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"16336","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ  أَنَّهُ كَانَيَكْرَهُ عِتْقَ النَّصْرَانِيِّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16337","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ عَطَاءٍ ، وَمُجَاهِدٍ , قَالا : يُجْزِئُ فِي الظِّهَارِ مِنَ الرَّقَبَةِ الْيَهُودِيُّ وَالنَّصْرَانِيُّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16338","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ : كُلُّ شَيْءٍ فِي الْقُرْآنِ مُؤْمِنَةٌ , فَالَّذِي قَدْ صَلَّى ، وَمَا لَمْ يَكُنْ مُؤْمِنَةً فَيُجْزِئُ مَا لَمْ يُصَلِّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16339","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنْعِتْقِ الْيَهُودِيِّ وَالنَّصْرَانِيِّ , هَلْ فِيهِ أَجْرٌ ؟ قَالَ : لا , وَكَرِهَ عِتْقَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16340","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : لأَنْ أَحْمِلَ عَلَى نَعْلَيْنِ فِي سَبِيلِ اللَّهِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَعْتِقَ وَلَدَ زِنَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16341","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ الزُّبَيْرَ بْنَ مُوسَى بْنِ مِينَاءَ أَخْبَرَهُ , أَنْ أُمَّ صَالِحٍ ابْنَةُ طَارِقِ بْنِ عَلْقَمَةَ بْنِ مُرْتَفَعٍ أَخْبَرَتْهُ , أَنَّهَا سَأَلَتْ عَائِشَةَ أُمَّ الْمُؤْمِنِينَ  عَنْإِعْتَاقِ أَوْلادِ الزِّنَا , فَقَالَتْ : أَعْتِقُوهُمْ وَأَحْسِنُوا إِلَيْهِمْ "", وَأَمَّا ابْنُ عُيَيْنَةَ , فَذَكَرَهُ عَنْ عُمَرَ ، عَنِ الزُّبَيْرِ ، عَنْ مُوسَى ، عَنْ أُمِّ حَكِيمٍ ابْنَةِ طَارِقٍ ، عَنْ عَائِشَةَ مِثْلَهُ , قَالَ : وَأَظُنُّهُ قَالَ : قَالَتْ : "" وَاسْتَوْصُوا بِهِمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16342","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ سُلَيْمَانِ بْنِ يَسَارٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ :  فِيأَوْلادِ الزِّنَا : "" أَعْتِقُوهُمْ وَأَحْسِنُوا إِلَيْهِمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16343","عَنِ الأَسْلَمِيِّ ، عَنْ أَبِي الزِّنَادِ ، عَنْ خَارِجَةَ بْنِ زَيْدٍ ، أَنَّ زَيْدَ بْنَ ثَابِتٍ : أَعْتَقَ غُلامًا لَهُ مَجُوسِيًّا ، وَأَعْتَقَ وَلَدَ زَنْيَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16344","عَنْ سُفْيَانَ , فِيرَجُلٍ كَانَتْ عَلَيْهِ رَقَبَةٌ , فَاشْتَرَى أَخَاهُ أَوْ ذَا رَحِمٍ , فَأَعْتَقَهُ , قَالَ :  لا يُجْزِئُهُ مِنْ رَقَبَتِهِ , لأَنَّهُ لا يَسْتَطِيعُ أَنْ يَمْلِكَهُ سَاعَةً ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16345","عَنْ سُفْيَانَ , قَالَ : الصَّبِيُّ الَّذِي لَمْ يَعْقِلْ يُجْزِئُ فِي الظِّهَارِ وَالْيَمِينِ , وَالْمُشْرِكُ أَيْضًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16346","عَنِ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عَمْرِو بْنِ أَوْسٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ,  أَنَّأُمَّهُ هَلَكَتْ , وَأَمَرَتْهُ أَنْ يُعْتِقَ عَنْهَا رَقَبَةً مُؤْمِنَةً ، فَجَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ , وَقَالَ : لا أَمْلُكُ إِلا جَارِيَةً سَوْدَاءَ أَعْجَمِيَّةً , لا تَدْرِي مَا الصَّلاةُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" ايْتِنِي بِهَا "" , فَجَاءَ بِهَا , فَقَالَ : "" أَيْنَ اللَّهُ ؟ "" , قَالَتْ : فِي السَّمَاءِ , قَالَ : "" فَمَنْ أَنَا ؟ "" , قَالَتْ : رَسُولُ اللَّهِ , قَالَ : "" أَعْتِقْهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16347","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْكَافِرَةُ أَتَرَى فِيهَا أَجْرًا ؟ قَالَ : نَعَمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16348","عَنِ الثَّوْرِيِّ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ أَبِي عَبْدِ اللَّهِ الْحِمْيَرِيِّ ، عَنْ مَعْقِلِ بْنِ يَسَارٍ , قَالَ : إِذَا اشْتَرَيْتَ نَسَمَةً ، فَلا تَشْتَرِطْ لأَهْلِهَا الْعِتْقَ ، فَإِنَّهُ عُقْدَةٌ مِنَ الرِّقِّ , وَلَكِنِ اشْتَرِهَا إِنْ شِئْتَ بِعْتَ ، وَإِنْ شِئْتَ وَهَبْتَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16349","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، وَإِسْمَاعِيلَ بْنِ أَبِي خالد ، عَنِ الشَّعْبِيِّ ، قَالا : إِذَا اشْتَرَيْتَ نَسَمَةً فَاشْتَرِطْ عَلَيْكَ الْعِتْقَ ، فَلَيْسَتَ بِالسَّلِيمَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16350","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : مَنْ مَلَكَ ذَا رَحِمِ مَحْرَمٍ عَتَقَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16351","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : مَنْ مَلَكَ ذَا رَحِمِ مَحْرَمٍ فَهُوَ حُرٌّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16352","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ رَجُلٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : مَنْ مَلَكَ ذَا رَحِمِ مَحْرَمٍ عَتَقَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16353","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ ، عَنِ الشَّعْبِيِّ , قَالَ : إِذَا مَلَكَ الأَبُ , أَوِ الابْنُ , أَوِ الأَخُ , أَوِ الأُمُّ , عَتَقُوا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16354","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ ، عَنْ عَطَاءٍ , قَالَ : إِذَا مَلَكَ الأَخُ , أَوِ الأُخْتَ , أَوِ الْعَمَّةَ , أَوِ الْخَالَةَ , عَتَقُوا "", وَذَكَرَهُ الْحَجَّاجُ بْنُ أَرْطَاةَ , عَنْ عَطَاءٍ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16355","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، وَالأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ , قَالَ : جَاءَ رَجُلٌ إِلَى ابْنِ مَسْعُودٍ , فَقَالَ :  إِنَّجَارِيَةً لِي أَرْضَعَتِ ابْنًا لِي , وَإِنِّي أُرِيدُ أَنْ أَبِيعَهَا , قَالَ : فَمَنَعُهُ ابْنُ مَسْعُودٍ , وَقَالَ : لَيْتَهُ يُنَادِي : مَنْ أَبِيعُهُ أُمَّ وَلَدِي ؟ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16356","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُسْتَوْرِدِ بْنِ الأَحْنَفِ , قَالَ : جَاءَ رَجُلٌ إِلَى ابْنِ مَسْعُودٍ , فَقَالَ :  إِنَّعَمِّي أَنْكَحَنِي وَلِيدَتَهُ , وَإِنَّهَا وَلَدَتْ لِي , وَإِنَّهُ يُرِيدُ أَنْ يَسْتَرِقَّهُمْ , قَالَ : لَيْسَ ذَلِكَ لَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16357","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا مَلَكَ الْوَالِدُ الْوَلَدَ عَتَقُوا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16358","عَنِ الثَّوْرِيِّ ، عَنْ زَكَرِيَّا ، عَنْ عَامِرٍ , قَالَ : إِذَا مَلَكَ الأَبُ وَالابْنُ عَتَقَا ، وَإِنْ لَمْ يَتَكَلَّمْ بِعَتْقِهِمَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16359","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : مَنْ مَلَكَ أَخَاهُ عَتَقَ , وَإِنْ لَمْ يَكُنْ تَكَلَّمَ بِعِتْقِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16360","أَخْبَرَنَا هِشَامُ ، عَنِ الْحَسَنِ , قَالَ : إِذَا مَلَكَ الأَخُ مِنَ الرَّضَاعَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16361","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , قَالَ : إِذَا مَلَكَ الرَّجُلُ أَخَاهُ مِنَ الرَّضَاعَةِ لَمْ يُعْتَقْ "" , قَالَ الزُّهْرِيُّ : "" وَمَضَتِ السُّنَّةُ أَنْ يُبَاعَ الأَخُ مِنَ الرَّضَاعَةِ "", قَالَ : مَعْمَرٌ : وَقَالَ قَتَادَةُ : يُبَاعُ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16362","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، وَالْحَسَنِ , قَالا : يُبَاعُ الأَخُ مِنَ الرَّضَاعَةِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16363","أَخْبَرَنَا الثَّوْرِيُّ , قَالَ : بَيْعُ الأُمِّ مِنَ الرَّضَاعَةِ هُوَ فِي الْقَضَاءِ جَائِزٌ ، وَيُكْرَهُ لَهُ وَالأَخُ مِنَ الرَّضَاعَةِ يَسْتَخْدِمُهُ أَخُوهُ , وَيَسْتَغِلُّهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16364","أَخْبَرَنَا سَعِيدُ بْنُ السَّائِبِ , قَالَ : أَوْصَى رَجُلٌ مِنَّا بِرَقَبَتَيْنِ ، وَسَمَّى لَهُمَا ثَمَنًا , فَلَمْ نَجِدْ "" ، فَسَأَلْتُ عَطَاءَ بْنَ أَبِي رَبَاحٍ , قَالَ : "" اجْمَعْهُ فِي رَقَبَةٍ وَاحِدَةٍ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16365","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ , فِي رَجُلٍ يَقُولُ : إِنِ اشْتَرَيْتُ فُلانًا فَهُوَ حُرٌّ , فَاشْتَرَاهُ , قَالَ : "" يُعْتَقُ "" , قُلْتُ لَهُ : فَأَيْنَ قَوْلُهُمْ : لا عِتْقَ إِلا فِيمَا يَمْلِكُ ؟ قَالَ : إِنَّمَا ذَلِكَ أَنْ يَقُولَ : "" غُلامُ فُلانٍ حُرُّ ، فَهَذَا لا يَجُوزُ ، فَأَمَّا إِذَا كَانَ فِي مُلْكِهِ فَهُوَ حُرٌّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16366","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , وَعَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالا : الْعُمْرَى أَنْ يَقُولَ : هِيَ لَكَ حَيَاتُكَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16367","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّ طَاوُسًا أَخْبَرَهُ , أَنَّ حُجْرًا الْمَدَرَيَّ أَخْبَرَهُ , أَنَّهُ سَمِعَ زَيْدَ بْنَ ثَابِتٍ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْعُمْرَى لِلْوَارِثِ "", عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنْ حُجْرٍ الْمَدَرِيِّ ، عَنْ زَيْدِ بْنِ ثَابِتٍ مِثْلَهُ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16368","عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ طَاوُسٍ ، عَنْ رَجُلٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : جَعَلَ الرُّقْبَى لِلَّذِي أَرْقَبَهَا ، وَالْعُمْرَى لِلَّذِي أَعْمَرَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16369","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَعْمَرَ شَيْئًا فَهُوَ لَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16370","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَبِيبُ بْنُ أَبِي ثَابِتٍ ، أَنَّهُ سَمِعَ عَبْدَ اللَّهِ بْنَ عَمْرٍو ، سَأَلَهُ أَعْرَابِيٌّ , فَقَالَ :رَجُلٌ أَعْطَى ابْنًا لَهُ نَاقَةً لَهُ مَا عَاشَ , فَنَتَجَتْ ذَوْدًا ، فَقَالَ ابْنُ عُمَرَ :  هِيَ لَهُ حَيَاتُهُ وَمَوْتُهُ "" , قَالَ : أَفَرَأَيْتَ إنْ كَانَتْ صَدَقَةً ؟ قَالَ : "" هُوَ أَبْعَدُ لَهَا مِنْهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16371","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : سَمِعْتُهُ يَقُولُ : الْعُمْرَى جَائِزَةٌ , وَيُقْضَى بِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16372","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ , يَقُولُ : وَسَأَلَهُ أَعْرَابِيٌّ , فَقَالَ :رَجُلٌ أَعْطَى ابْنَهُ نَاقَةً لَهُ حَيَاتَهُ , فَأَنْتَجَهَا , فَكَانَتْ إِبَلا ، فَقَالَ ابْنُ عُمَرَ :  هِيَ لَهُ حَيَاتَهُ وَمَوْتَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16373","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : شَهِدْتُ شُرَيْحًا وَجَاءَهُ رَجُلٌ فَسَأَلَهُ عَنِ الْعُمْرَى , فَقَالَ : هِيَ جَائِزَةٌ لأَهْلِهَا ، ثُمَّ سَكَتَ الرَّجُلِ سَاعَةً , فَقَالَ : كَيْفَ قَضَيْتَ ؟ قَالَ : لَيْسَ أَنَا قَضَيْتُ , وَلَكِنَّ اللَّهَ قَضَاهُ عَلَى لِسَانِ نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَنْ مَلَكَ شَيْئًا حَيَاتَهُ فَهُوَ لِوَرَثَتِهِ إِذَا مَاتَ, عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، مِثْلَ قَوْلِ شُرَيْحٍ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16374","عَنِ الثَّوْرِيِّ ، عَنِ خَالِدٍ الْحَذَّاءِ ، عَنِ ابْنِ سِيرِينَ , قَالَ : أُتِيَ شُرَيْحٌ فِيالْعُمْرَى فَقَضَى أَنَّهَا لِصَاحِبِهَا, فَقَالَ : أَقَضَيْتَ لِي يَا أَبَا أُمَيَّةَ ؟ قَالَ : لَيْسَ أَنَا قَضَيْتُ إِنَّمَا قَضَى لَكَ مُحَمَّدٌ , يَعْنِي النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16375","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ سُلَيْمَانَ بْنَ هِشَامٍ ، أَرْسَلَ إِلَيْهِ وَإِلَى الزُّهْرِيِّ وَهُوَ بِمَكَّةَ , فَسَأَلَهُمَا عَنِ الْعُمْرَى , فَقُلْتُ : هِيَ جَائِزَةٌ لأَهْلِهَا , قَالَ : وَخَالَفَهُ الزُّهْرِيُّ , فَقَالَ : إِنَّكُمَا قَدِ اخْتَلَفْتُمَا عَلَيَّ , فَهَلْ بِمَكَّةَ عَالِمٌ ؟ قَالَ : قُلْتُ : نَعَمْ , بِهَا شَيْخٌ لا أَعْلَمُ كَمِثْلِهِ شَيْخًا أَقَدَمَ عِلْمًا مِنْهُ , قَالَ : مَنْ هُوَ ؟ قُلْتُ : عَطَاءُ بْنُ أَبِي رَبَاحٍ , فَأَرْسَلَ إِلَيْهِ أَنَّ هَذَيْنِ قَدِ اخْتَلَفَا عَلَيَّ فِي الْعُمْرَى , فَمَا تَقُولُ فِيهَا ؟ قَالَ : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّالْعُمْرَى جَائِزَةٌ "", فَقَالَ رَجُلٌ : لَكِنَّ عَبْدَ الْمَلِكِ بْنَ مَرْوَانَ لَمْ يَقْضِ بِهَذَا ، فَقَالَ : بَلْ قَضَى بِهَا عَبْدُ الْمَلِكِ فِي بَنِي فُلانٍ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16376","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : أَخْبَرَنِي عِكْرِمَةُ بْنُ خَالِدٍ ، أَنَّ أَوْسَ بْنَ سَعْدِ بْنِ أَبِي سَرْحٍ أَخِي بَنِي عَامِرِ بْنِ لُؤَيٍّ أَخْبَرَهُ ,كَانَ لَنَا مَسْكَنٌ فِي دَارِ الْحَكَمِ , فَقَالَ عَبْدُ الْمَلِكِ فِي إِمَارَتِهِ : مَسْكَنَكَ الَّذِي فِي دَارِ الْعَاصِي , قُلْتُ : مَا هِيَ بِدَارِ آلِ أَبِي الْعَاصِ ، وَلَكِنَّهَا دَارُنَا , كَانَتْ لَنَا فِي الْجَاهِلِيَّةِ ، ثُمَّ أَسْلَمْنَا عَلَيْهَا , فَقَالَ : مَا كَانَتْ لَكُمْ إِلا عُمْرَى , قَالَ : قُلْتُ : أَيًّا مَا كَانَتْ فَهِيَ لَنَا بِقَضَاءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ, قَالَ : صَدَقْتَ , أَفَتَبِيعُهَا ؟ قَالَ : قُلْتُ : أَمَّا بِمَالٍ فَلا أَبِيعُهَا إِلا بِدَارٍ , قَالَ : فَانْظُرْ أَيَّ دُورِي شِئْتَ بِمِثْلِهِ , قَالَ : قُلْتُ : دَارُ أَيُّوبَ بْنِ الأَخْنَسِ , قَالَ : تِلْكَ دَارٌ مِنْ دُورِ مَرْوَانَ , وَلَكِنْ غَيَّرَهَا , قَالَ : قُلْتُ : دَارُ حِرْمَاشٍ , قَالَ : هِيَ لَكَ , قَالَ : فَبِعْتُهَا إِيَّاهُ بِدَارِ حِرْمَاشٍ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16377","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : مَنْ أَعْمَرَ شَيْئًا فَهُوَ لَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16378","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ :أَعْمَرَتِ امْرَأَةٌ بِالْمَدِينَةِ حَائِطًا لَهَا ابْنًا لَهَا ، ثُمَّ تُوُفِّي , وَتُوُفِّيَتْ بَعْدَهُ ، وَتَرَكَ وَلَدًا , وَلَهُ إِخْوَةٌ بَنُونَ لِلْمُعَمِّرَةِ ، فَقَالَ وَلَدُ الْمُعَمِّرَةِ : رَجَعَ الْحَائِطُ إِلَيْنَا , وَقَالَ وَلَدُ الْمُعَمَّرِ : بَلْ كَانَ الْحَائِطُ لأَبِينَا حَيَاتَهُ وَمَوْتَهُ , فَاخْتَصَمُوا إِلَى طَارِقٍ مَوْلَى عُثْمَانَ , فَدَعَا جَابِرًا , فَشَهِدَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْعُمْرَى لِصَاحِبِهَا, فَقَضَى بِذَلِكَ طَارِقٌ ، ثُمَّ كَتَبَ إِلَى عَبْدِ الْمَلِكِ أَخْبَرَهُ بِذَلِكَ ، وَأَخْبَرَهُ بِشَهَادَةِ جَابِرٍ ، فَقَالَ عَبْدُ الْمَلِكِ : صَدَقَ جَابِرٌ , قَالَ : فَأَمْضَى ذَلِكَ طَارِقٌ , فَإِنَّ ذَلِكَ الْحَائِطَ لِبَنِي الْمُعَمَّرِ حَتَّى الْيَوْمِ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16379","قَالَ ابْنُ جُرَيْجٍ : وَقَالَ عَمْرُو بْنُ شُعَيْبٍ :  قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّالْعُمْرَى لِمَنْ أَعْمَرَهَا "", قَالَ ابْنُ جُرَيْجٍ : وَحُدِّثْتُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ : "" الْعُمْرَى لِصَاحِبِهَا إِذَا كَانَ قَدْ قَبَضَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16380","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : إِنَّمَاالْعُمْرَى الَّتِي أَجَازَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَقُولَ :  هِيَ لَكَ وَلِعَقِبِكَ "", فَأَمَّا إِذَا قَالَ : "" هِيَ لَكَ مَا عِشْتَ "" , فَإِنَّهَا تَرْجِعُ إِلَى صَاحِبِهَا , قَالَ : وَكَانَ الزُّهْرِيُّ يُفْتِي بِهِ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16381","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ أَنَّهُ حَدَّثَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ : أَيُّمَا رَجُلٍ أَعْمَرَ عُمْرَى لَهُ وَلِعَقِبِهِ , فَهِيَ لَهُ , يَرِثُهَا مِنْ عَقِبِهِ مَنْ وَرِثَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16382","عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : إِذَا أَعْطَى الرَّجُلُ بَعْضَ وَرَثَتِهِ شَيْئًا مِنْ مَالِهِ حَيَاتَهُ , أَوْ أَسْكَنَهُ إِيَّاهُ حَيَاتَهُ ، فَإِنُّهُ يَرْجِعُ فِي الْمِيرَاثِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16383","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :الرَّجُلُ يُعْمِرُ وَيَشْتَرِطُ عَلَى الَّذِي أَعْطَى أَنَّكَ إِذَا مِتَّ فَهُوَ حُرٌّ , قَالَ :  يَكُونُ حُرٌّ , مَرَّتَيْنِ تَتْرَى "" , قُلْتُ : سَبِيلٌ مِنْ سُبُلِ اللَّهِ ؟ قَالَ : "" نَعَمْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16384","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا : إِذَا قَالَ : هِيَ لَكَ حَيَاتَكَ , فَإِذَا مِتُّ فَهِيَ حُرَّةٌ "" قَالَ : "" لا , وَكَمَا مِتُّ فَهِيَ حُرَّةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16385","عَنِ ابْنِ جُرَيْجٍ , قَالَ : إِذَا مِتُّ فَإِنَّهُ يُبَاعُ ، ثُمَّ ثَمَنُهُ لِلْمَسَاكِينِ "" , قَالَ : "" وَيَكُونُ كَذَلِكَ مَرَّتَيْنِ تَتْرَى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16386","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَفَرَأَيْتَإِنْ قَالَ : هُوَ رَدٌّ عَلَى وَرَثَتِي , قَالَ :  لا , هُوَ لِلَّذِي أَعْطَى حِينَئِذٍ , حَيَاتَهُ وَمَوْتَهُ "" , قُلْتُ : فَلِمَ يَخْتَلِفَانِ , قَالَ : "" لأَنَّهُ شَرْطُ الْعَتَاقَةِ مَعَ الإِعْمَارِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16387","عَنِ ابْنِ جُرَيْجٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : إِذَا قَالَ : هِيَ لَكَ حَيَاتَكَ ، ثُمَّ هِيَ لِفُلانٍ , فَهِيَ عَلَى مَا قَالَ , قَالَ عَلِيٌّ : "" هُوَ عَلَى شَرْطِهِ "", قَالَ مَعْمَرٌ : قَالَ قَتَادَةُ : هِيَ لِوَرَثَةَ الأَوَّلِ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16388","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا أَوْصَى ، فَقَالَ : هِيَ لِفُلانٍ حَيَاتَهُ ، فَإِذَا مَاتَ فَهِيَ لِفُلانٍ , قَالَ :  هِيَ لِلأَوَّلِ "" , وَقَالَ : "" لَيْسَ لِلأَخِرِ شَيْءٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16389","عَنِ الأَسْلَمِيِّ ، عَنْ دَاوُدَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :الْعُمْرَى جَائِزَةٌ مَوْرُوثَةٌ","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16390","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ ، عَنِ الْعُمْرَى وَسُنَّتِهَا , عَنْ حَدِيثِ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَ جَابِرَ بْنَ عَبْدِ اللَّهِ الأَنْصَارِيَّ أَخْبَرَهُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَضَى أَنَّهُأَيُّمَا رَجُلٍ أَعْمَرَ رَجُلا عُمْرَى لَهُ وَلِعَقِبِهِ "", فَقَالَ : قَدْ أَعْطَيَتُكَهَا وَعَقِبَكَ مَا بَقِي مِنْهُمْ أَحَدٌ , فَإِنَّهَا لِمَنْ أَعْطَاهَا ، وَإِنَّهَا لا تَرْجِعُ إِلَى صَاحِبِهَا , مِنْ أَجْلِ أَنَّهُ أَعْطَى عَطَاءً وَقَعَتْ فِيهِ الْمَوَارِيثُ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16391","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فَإِنْ أَعْطَاهُ سَنَةً أَوْ سَنَتَيْنِ فَتِلْكَ مِنْحَةٌ مَنَحَهَا أَخَاهُ , وَلَيْسَتْ بِعُمْرَى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16392","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ , قَالَ :إِذَا قَالَ :  هِيَ لَكَ مَنِيحَ مَا عِشْتُ , أَوْ هِيَ لَكَ سُكْنَى مَا عِشْتُ ، فَإِنَّهَا تَرْجِعُ عَلَيْهِ "" , وَإِذَا قَالَ : "" هِيَ لَكَ مَا عِشْتُ , وَلَمْ يَذْكُرْ مَنِيحًا ، وَلا جَائِزَةَ سَكَنِ , فَهِيَ جَائِزَةٌ لَهُ وَلِعَقِبِهِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16393","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سُئِلَ عَطَاءٌ عَنْ رَجُلٍ , وَأَنَا أَسْمَعُ عَنْرَجُلٍ قَالَ : وَلِيدَتِي هَذِهِ لَكَ مَا عِشْتُ , قَالَ :  هَذِهِ الْعُمْرَى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16394","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، وَعَطَاءٍ , قَالا :إِذَا قَالَ :  هَذِهِ الدَّارُ سُكْنَى لَكَ مَا عِشْتُ , فَهِيَ لَهُ وَلِعَقِبِهِ "", وَكَانَ قَتَادَةُ يَقُولُ وَيُفْتِي بِهِ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16395","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ ، عَنِ الشَّعْبِيِّ , قَالَ : السُّكْنَى تَرْجِعُ إِلَى أَهْلِهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16396","عَنْ مَعْمَرٍ ، عَنْ مَنْصُورٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : السُّكْنَى تَرْجِعُ إِلَى أَهْلِهَا إِذَا مَاتَ مَنْ سَكَنَهَا , وَسَكَّنَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16397","عَنْ مَعْمَرٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : فِي السُّكْنَى يَرْجِعُ فِيهَا صَاحِبُهَا إِذَا شَاءَ ، فَإِنَّمَا هِيَ عَارِيَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16398","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ حَفْصَةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَسْكَنَتْ مَوَلاةً لَهَا بَيْتًا مَا عَاشَتْ ، فَمَاتَتْ مَوَلاتُهَا , فَقَبَضَتْ حَفْصَةُ بَيْتَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16399","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ : السُّكْنَى تَرْجِعُ إِلَى أَهْلِهَا , إِذَا مَاتَ مَنْ سَكَنَهَا ، وَلَيْسَ لِصَاحِبِهَا أَنْ يَرْجِعَ فِيهَا , وَالْعُمْرَى جَائِزَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16400","عَنِ الثَّوْرِيِّ ، قَالَ :إِذَا قَالَ :  هِيَ لَكَ سُكْنَى رَجَعَتْ "" , وَإِذَا قَالَ : "" هِيَ لَكَ , اسْكُنْهَا , فَهِيَ جَائِزَةٌ لَهُ , أَبَدًا , إِنَّمَا هِيَ كَالتَّعَلُّمِ مِنْهُ أَبَدًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16401","عَنِ ابْنِ التَّيْمِيِّ , قَالَ : أَخْبَرَنَا إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، عَنِ الشَّعْبِيِّ , فِيرَجُلٍ يَقُولُ لَكَ هَذِهِ الدَّارُ سُكْنَى حَتَّى تَمُوتَ , قَالَ :  هِيَ حَيَاتَهُ وَمَوْتَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16402","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : الرُّقْبَى "" , أَنْ يَقُولَ : "" هِيَ لِلأَخِرِ مِنِّي وَمِنْكَ مَوْتًا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16403","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ طَاوُسٍ , قَالَ : الرُّقْبَى "" , أَنْ تَقُولَ : "" خُذْهَا هِيَ لِلأَخِرِ مِنِّي وَمِنْكَ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16404","عَنْ سُفْيَانَ , قَالَ : الرُّقْبَى "" , أَنْ يَقُولَ : "" هِيَ لَكَ , فَإِذَا مِتَّ فَهِيَ إِلَيَّ رَدٌّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16405","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَحِلُّ الرُّقْبَى ، وَمَنْ أُرْقِبَ شَيْئًا فَهُوَ لَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16406","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ طَاوُسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا رُقْبَى , فَمَنْ أَرْقَبَ رُقْبَى فَهِيَ لِمَنْ أُرْقِبَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16407","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : مَنْ أُرْقِبَ شَيْئًا وَمَنْ أُعْمِرَهَا ، وَمَنْ أُعْمِرَ شَيْئًا فَهُوَ لَهُ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16408","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ طَاوُسٍ ، عَنْ رَجُلٍ ، عَنْ زَيْدٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : جَعَلَ الرُّقْبَى لِلَّذِي أُرْقِبَهَا ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16409","عَنْ قَتَادَةَ , قَالَ : الرُّقْبَى جَائِزَةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16410","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : الرُّقْبَى وَصِيَّةٌ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16411","عَنْ مَعْمَرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : اشْتَرَى ثَلاثُ نِسْوَةٍ دَارًا ، فَقُلْنَ هِيَ لِلْمُطَلَّقَةِ , وَالأَيِّمِ ، وَالْمُحْتَاجَةِ مِنَّا , فَمَاتَتْ وَاحِدَةٌ مِنْهُنَّ ، فَاخْتَصَمُوا إِلَى شُرَيْحٍ , فَقَالَ : هَذِهِ الرُّقْبَى , إِذَا مَاتَتِ الأُولَى فَلَيْسَ لِلْبَاقِيَتَيْنِ شَيْءٌ ، هِيَ عَلَى سَهْمَانِ اللَّهِ عَزَّ وَجَلَّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16412","عَنِ ابْنِ جُرَيْجٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، عَنْ عَلِيٍّ , قَالَ : الرُّقْبَى بِمَنْزِلَةِ الْعُمْرَى ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16413","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا عُمْرَى ، وَلا رُقْبَى , فَمَنْ أُعْمِرَ شَيْئًا أَوْ أُرْقِبَهُ , فَهِيَ لَهُ حَيَاتَهُ وَمَوْتَهُ "" , قَالَ : "" وَالرُّقْبَى أَنْ يَقُولَ : هَذَا لِلأَخِرِ مِنِّي وَمِنْكَ مَوْتًا ، وَالْعُمْرَى أَنْ يَجْعَلَهُ حَيَاتَهُ , بِأَنْ يُعْمِرَ حَيَاتَهُ "", قُلْتُ لِحَبِيبٍ : فَإِنَّ عَطَاءً أَخْبَرَنِي عَنْكَ فِي الرُّقْبَى , قَالَ : لَمْ أَسْمَعْ مِنِ ابْنِ عُمَرَ فِي الرُّقْبَى شَيْئًا , وَلَمْ أَسْمَعْ مِنْهُ إِلا هَذَا الْحَدِيثَ فِي الْعُمْرَى , وَلَمْ أُخْبِرْ عَطَاءً فِي الْعُمْرَى شَيْئًا ، قَالَ عَطَاءٌ : فَإِنْ أَعْطَى سَنَةً أَوْ سَنَتَيْنِ يُسَمِّيهِ , فَتِلْكَ مَنِيحَةٌ يَمْنَحُهَا إِيَّاهُ , لَيْسَتْ بِعُمْرَى""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16414","عَنْ مَعْمَرٍ ، عَنْ عَطَاءِ بْنِ السَّائِبِ , قَالَ : كُنْتُ جَالِسًا , فَمَرَّ رَجُلٌ , فَقِيلَ هَذَا شُرَيْحٌ , فَقُمْتُ إِلَيْهِ فَقُلْتُ : أَفْتِنِي ، فَقَالَ :  لَسْتُ أُفْتِي وَلَكِنِّي أَقْضِي "" , قُلْتُ :رَجُلٌ وَهَبَ دَارًا لِوَلَدِهِ ، ثُمَّ وَلَدِ وَلَدِهِ , حَبِيسًا عَلَيْهِمْ , لا يُبَاعُ وَلا يُوهَبُ ، فَقَالَ : "" لا حَبْسَ فِي الإِسْلامِ عَنْ فَرَائِضِ اللَّهِ عَزَّ وَجَلَّ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16415","عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , قَالَ : تَصَدَّقَ الزُّبَيْرُ بِدَارٍ لَهُ ، وَجَعَلَهَا حَبِيسًا عَلَى وَلَدِهِ ، وَوَلَدِ وَلَدِهِ , فَجَازَتْ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16416","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ فِيصَدَقَةِ الرِّبَاعِ :  لا يَخْرُجُ أَحَدٌ مِنْ أَهْلِ الصَّدَقَةِ عَنْ أَحَدٍ مِنْهُمْ , إِلا أَنْ يَكُونَ عِنْدَهُمْ فَضْلٌ مِنَ الْمَسْكَنِ ""","","","","","Book of the Mudabbar (Slave Promised Freedom)"
"16417","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الدُّبَّاءِ ، وَالْمُزَفَّتِ ""","","","","","Book of Drinks"
"16418","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ بَلَغَنِي أَنَّهُ : نُهِيَ عَنْ أَنْ يُشْرَبَ فِي الدُّبَّاءِ وَالنَّقِيرِ ، وَكُلِّ شَيْءٍ مُزَفَّتٍ , مِنْ سِقَاءٍ وَغَيْرِهِ "", لَمْ يَبْلُغْنِي غَيْرُ ذَلِكَ , قَالَ : قُلْتُ : الرَّصَاصَةُ ؟ قَالَ : زَعَمُوا أَنَّ ابْنَ مَسْعُودٍ كَانَ يَشْرَبُ فِي الرَّصَاصَةِ""","","","","","Book of Drinks"
"16419","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الدُّبَّاءِ ، وَالنَّقِيرِ ، وَالْمُزَفَّتِ ، وَالْحَنْتَمِ ""","","","","","Book of Drinks"
"16420","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَبِي جَمْرَةَ الضُّبَعِيِّ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الدُّبَّاءِ ، وَالنَّقِيرِ ، وَالْمُزَفَّتِ ، وَالْحَنْتَمِ ""","","","","","Book of Drinks"
"16421","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي أَوْفَى , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَهَى عَنِ الْجَرِّ الأَخْضَرِ "", يَعْنِي : النَّبِيذَ فِي الْجَرِّ , قُلْتُ : وَالأَبْيَضُ ؟ قَالَ : لا أَدْرِي""","","","","","Book of Drinks"
"16422","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو قَزَعَةَ ، أَنَّ أَبَا نَضْرَةَ أَخْبَرَهُ , وَحَسَنًا أَخْبَرَهُمَا , أَنَّ أَبَا سَعِيدٍ الْخُدْرِيَّ أَخْبَرَهُ : أَنَّ وَفْدَ عَبْدِ الْقَيْسِ لَمَّا أَتَوُا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالُوا : يَا نَبِيَّ اللَّهِ , جَعَلَنَا اللَّهُ فِدَاكَ , مَاذَا يَصْلُحُ لَنَا مِنَ الأَشْرِبَةِ ؟ فَقَالَ : لا تَشْرَبُوا فِي النَّقِيرِ "" , قَالُوا : يَا نَبِيَّ اللَّهِ , جَعَلَنَا اللَّهُ فِدَاكَ , أَوَ تَدْرِي مَا النَّقِيرُ ؟ قَالَ : "" نَعَمِ , الْجِذْعُ يُنْقَرُ وَسَطُهُ ، وَلا الدُّبَّاءِ ، وَلا الْحَنْتَمَةِ ، وَعَلَيْكُمْ بِالْمُوكَى ""","","","","","Book of Drinks"
"16423","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو هَارُونَ الْعَبْدِيُّ , قَالَ لِي أَبُو سَعِيدٍ الْخُدْرِيُّ : كُنَا جُلُوسًا عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  جَاءَ كُمْ وَفْدُ عَبْدِ الْقَيْسِ "" , قَالَ : وَلا نَرَى شَيْئًا , فَمَكَثْنَا سَاعَةً ، فَإِذَا هُمْ قَدْ جَاءُوا فَسَلَّمُوا عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لَهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :"" أَبَقِي مَعَكُمْ شَيْءٌ مِنْ تَمْرِكُمْ ؟ "" , أَوْ قَالَ : "" مَنْ زَادِكُمْ ؟ "" , قَالُوا : نَعَمْ ، فَأَمَرَ بِنَطْعٍ فَبُسِطَ ، ثُمَّ صَبُّوا بَقِيَّةَ تَمْرٍ كَانَ مَعَهُمْ ، فَجَمَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَصْحَابَهُ ، وَقَالَ : "" تُسَمُّونَ هَذِهِ التَّمْرَ الْبَرْنِيَّ , وَهَذَهِ كَذَا ، وَهَذَهِ كَذَا , لأَلْوَانِ التَّمْرِ "" , قَالُوا : نَعَمْ , ثُمَّ أَمَرَ بِكُلِّ رَجُلٍ مِنْهُمْ رَجُلا مِنَ الْمُسْلِمِينَ , يُنْزِلُهُ عِنْدَهُ ، وَيُقْرِئُهُ الْقُرْآنَ ، وَيُعَلِّمُهُ الصَّلاةَ , فَمَكَثُوا جُمْعَةً ، ثُمَّ دَعَاهُمْ , فَوَجَدَهُمْ قَدْ كَادُوا أَنْ يَتَعَلَّمُوا ، وَأَنْ يَفْقَهُوا , فَحَوَّلَهُمْ إِلَى غَيْرِهِ ، ثُمَّ تَرَكَهُمْ جُمْعَةً أُخْرَى ، ثُمَّ دَعَاهُمْ , فَوَجَدَهُمْ قَدْ قَرَءُوا وَفَقِهُوا , فَقَالُوا : يَا رَسُولَ اللَّهِ , إِنَّا قَدِ اشْتَقْنَا إِلَى بِلادِنَا , وَقَدْ عَلِمَ اللَّهُ خَيْرًا , وَفَقَّهْنَا ، فَقَالَ : "" ارْجِعُوا إِلَى بِلادِكُمْ "" , فَقَالُوا : لَوْ سَأَلْنَا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ شَرَابٍ نَشْرَبُهُ بِأَرْضِنَا , فَقَالُوا : يَا رَسُولَ اللَّهِ , إِنَّا نَأْخُذُ النَّخْلَةَ فَنُجَوِّبُهَا ، ثُمَّ نَضَعُ التَّمْرَ فِيهَا , وَنَصُبُّ عَلَيْهِ الْمَاءَ ، فَإِذَا صَفَا شَرِبْنَاهُ , قَالَ : "" وَمَاذَا ؟ "" , قَالُوا : نَأْخُذُ هَذِهِ الزِّقَاقَ الْمُزَفَّتَةِ فَنَضَعُ فِيهَا التَّمْرَ ، ثُمَّ نَصُبُّ فِيهَا الْمَاءَ ، فَإِذَا صَفَا شَرِبْنَاهُ , قَالَ : "" وَمَاذَا ؟ "" , قَالَ : نَأْخُذُ هَذِهِ الدُّبَّاءَ فَنَضَعُ فِيهَا التَّمْرَ ، ثُمَّ نَصُبُّ عَلَيْهِ الْمَاءَ ، فَإِذَا صَفَا شَرِبْنَاهُ , قَالَ : "" وَمَاذَا ؟ "" , قَالُوا : وَنَأْخُذُ هَذِهِ الْحَنْتَمَةَ , فَنَضَعُ فِيهَا التَّمْرَ ، ثُمَّ نَصُبُّ عَلَيْهِ الْمَاءَ , فَإِذَا صَفَا شَرِبْنَاهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لا تَنْبِذُوا فِي الدُّبَّاءِ ، وَلا فِي النَّقِيرِ ، وَلا فِي الْحَنْتَمِ , وَانْتَبِذُوا فِي هَذِهِ الأَسْقِيَةِ الَّتِي يُلاثُ عَلَى أَفْوَاهِهَا ، فَإِنْ رَابَكُمْ فَاكْسِرُوهُ بِالْمَاءِ "", قَالَ أَبُو هَارُونَ : فَقُلْتُ لأَبِي سَعِيدٍ : أَشَرِبْتَ نَبِيذَ الْجَرِّ بَعْدَ ذَلِكَ ؟ فَقَالَ : سُبْحَانَ اللَّهِ ! أَبَعْدَ نَهْيِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","","","","Book of Drinks"
"16424","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قِيلَ لِعَطَاءٍ :سِقَايَةُ ابْنِ عَبَّاسٍ الَّتِي يَجْعَلُ فِيهَا النَّبِيذَ مُزَفَّتَةٌ ؟ قَالَ :  أَجَلْ ! "" , وَلَمْ يَكُنْ عَلَى عَهْدِ ابْنِ عَبَّاسٍ , إِنَّمَا كَانُوا ، قَبْلَ ذَلِكَ يُسْقَوْنَ فِي حِيَاضٍ مِنْ أُدْمٍ, فَأَحْدَثَتْ هَذِهِ عَلَى عَهْدِ الْحَجَّاجِ , بَعْدَ ابْنِ عَبَّاسٍ""","","","","","Book of Drinks"
"16425","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي الْحَسَنُ بْنُ مُسْلِمٍ ، عَنْ طَاوُسٍ ، أَنَّهُ كَانَ يَقُولُ :  نَهَى ابْنُ عُمَرَ عَنْنَبِيذِ الْجَرِّ ، وَالدُّبَّاءِ ""","","","","","Book of Drinks"
"16426","قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عُمَرَ , أَنَّ رَجُلا جَاءَهُ ، فَقَالَ :نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  أَنْ تَنْتَبِذُوا فِي الْجَرِّ وَالدُّبَّاءِ ؟ قَالَ : "" نَعَمْ، فَكَانَ أَبُوهُ يَنَهَى عَنْ كُلِّ جَرٍّ وَدُبَّاءٍ , مُزَفَّتَةٍ وَغَيْرِ مُزَفَّتَةٍ ""","","","","","Book of Drinks"
"16427","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ ابْنَ عُمَرَ , يَقُولُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَنَهَى عَنِ الْجَرِّ ، وَالْمُزَفَّتِ ، وَالدُّبَّاءِ ""","","","","","Book of Drinks"
"16428","قَالَ أَبُو الزُّبَيْرِ , وَسَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ :نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْجَرِّ ، وَالْمُزَفَّتِ ، وَالنَّقِيرِ ، وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا لَمْ يَجِدْ سِقَاءً يُنْبَذُ لَهُ فِيهِ , نُبِذَ لَهُ فِي تَوْرٍ مِنْ حِجَارَةٍ","","","","","Book of Drinks"
"16429","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْوَاحِدِ بْنِ أَيْمَنَ ، عَنْ أَبِيهِ ، أَنَّ نَافِعَ بْنَ عَبْدِ الْحَارِثِ نُبِذَ لِعُمَرَ بْنِ الْخَطَّابِ فِي الْمَزَادِ ""","","","","","Book of Drinks"
"16430","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ كَثِيرٍ ، عَنْ مُجَاهِدٍ , قَالَ : نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُنْبَذَ فِي كُلِّ شَيْءٍ يُطْبَقُ ""","","","","","Book of Drinks"
"16431","عَنْ مَعْمَرٍ ، عَنْ ثَابِتٍ الْبُنَانِيِّ , قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْنَبِيذِ الْجَرِّ , فَقَالَ :  حَرَامٌ "", فَقُلْتُ : أَنَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ ابْنُ عُمَرَ : "" يَزْعُمُونَ ذَلِكَ ""","","","","","Book of Drinks"
"16432","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَعَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالا : يُكْرَهُ الْقَارُورَةُ , وَالرَّصَاصَةُ , أَنْ يُنْبَذَ فِيهِمَا ""","","","","","Book of Drinks"
"16433","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ عِكْرِمَةَ , يَقُولُ : شَقَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَشَاعِلَ يَوْمَ خَيْبَرَ , وَذَلِكَ أَنَّهُ وَجَدَ أَهْلَ خَيْبَرَ يَشْرَبُونَ فِيهَا ""","","","","","Book of Drinks"
"16434","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ عِكْرِمَةَ , قَالَ : دَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى بَعْضِ أَهْلِهِ ، وَقَدْنَبَذُوا لِصِبِيٍّ لَهُمْ فِي كُوزٍ , فَأَهْرَاقَ الشَّرَابَ , وَكَسَرَ الْكُوزَ","","","","","Book of Drinks"
"16435","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَعَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ  كَانَايَكْرَهَانِ النَّبِيذَ فِي الْحِجَارَةِ ، وَفِي كُلِّ شَيْءٍ إِلا الأَسْقِيَةَ الَّتِي يُوكَا عَلَيْهَا ""","","","","","Book of Drinks"
"16436","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ : لا تَتَّخُذُوا مِنْ جُلُودُ الْبَقَرِ سِقَاءً يُنْبَذُ فِيهِ لَمْ يُصْنَعْ لَهُ ، وَكَانَ مِنْ أُهُبِ الْغَنَمِ , فَهَذَا خِدَاعٌ , وَاللَّهُ لا يُحِبُّ الْخِدَاعَ "" , قَالَ : وَقِيلَ لِعِكْرِمَةَ : أَنْشَرَبُ نَبِيذَ الْجَرِّ حُلْوًا ؟ فَقَالَ : "" لا "" , قَالَ : فَالرُّبُّ فِي الْجَرِّ ؟ قَالَ : "" نَعَمْ "" , قِيلَ : فَلِمَ ؟ قَالَ : "" إِنَّ الرُّبَّ إِذَا تَرَكْتَهُ لَمْ يَزْدَدْ إِلا حَلاوَةً ، وَإِنَّ النَّبِيذَ إِذَا تَرَكْتَهُ لَمْ يَزْدَدْ إِلا شِدَّةً ""","","","","","Book of Drinks"
"16437","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : لأَنْ أَشْرَبَ قُمْقَمًا مِنْ مَاءٍ مُحْمًى يُحْرِقُ مَا أَحْرَقَ ، وَيُبْقِي مَا أَبْقَى , أَحَبُّ إِلَيَّ مِنْ أَنْ أَشْرَبَ نَبِيذَ الْجَرِّ ""","","","","","Book of Drinks"
"16438","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْنَبِيذِ الْجَرِّ , فَقَالَ :  حَرَامٌ "" , فَأَخْبَرْتُ بِذَلِكَ ابْنَ عَبَّاسٍ , فَقَالَ : "" صَدَقَ , ذَلِكَ مَا حَرَّمَ اللَّهُ وَرَسُولُهُ ""، فَقُلْتُ : وَمَا الْجَرُّ ؟ قَالَ : "" كُلُّ شَيْءٍ مِنْ مَدَرٍ ""","","","","","Book of Drinks"
"16439","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , قَالَ : سَأَلَهُ رَجُلٌ ، فَقَالَ : إِنَّانَأْخُذُ التَّمْرَ فَنَجْعَلَهُ فِي الْفَخَّارَةِ , فَذَكَرَ كَيْفَ يَصْنَعُ ، فَقَالَ ابْنُ عُمَرَ :  إِنَّ أَهْلَ أَرْضِ كَذَا وَكَذَا لَيَصْنَعُونَ خَمْرًا مِنْ كَذَا ، وَيُسَمُّونَهُ كَذَا وَكَذَا , حَتَّى عَدَّ خَمْسَةَ أَشْرِبَةٍ , سَمَّاهَا خَمْرًا ، وَعَدَّدَ خَمْسَةَ أَرَضِينَ "", قَالَ مُحَمَّدٌ : فَحَفِظْتُ الْعَسَلَ , وَالشَّعِيرَ , وَاللَّبَنَ""","","","","","Book of Drinks"
"16440","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي الْعَالِيَةَ ، قَالَ : دَخَلْتُ عَلَى أَبِي سَعِيدٍ الْخُدْرِيِّ , فَسَأَلْتُهُ عَنْنَبِيذِ الْجَرِّ فَنَهَانِي , قُلْتُ لَهُ : فَالْجُفُّ ؟ قَالَ :  ذَلِكَ أَخْبَثُ وَأَخْبَثُ "" , قُلْتُ لَهُ : مَا الْجُفُّ ؟ قَالَ : "" مِثْلُ الصَّدَاقِ شَيْءٌ لَهُ قَوَائِمُ ""","","","","","Book of Drinks"
"16441","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ،أُتِيَ وَهُوَ بِطَرِيقِ الشَّامِ بِسَطِيحَتَيْنِ فِيهِمَا نَبِيذٌ , فَشَرِبَ مِنْ إِحْدَاهُمَا , وَعَدَلَ عَنِ الأُخْرَى , قَالَ : فَأَمَرَ بِالأُخْرَى فَرُفِعَتْ , فَجِيءَ بِهَا مِنَ الْغَدِ ، وَقَدِ اشْتَدَّ مَا فِيهَا بَعْضَ الشِّدَّةِ , قَالَ : فَذَاقَهُ , ثُمَّ قَالَ : بَخٍ بَخٍ , اكْسِرُوا بِالْمَاءِ ""","","","","","Book of Drinks"
"16442","عَنْ أَبَانَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ صَلَّى بِأَصْحَابِهِ يَوْمًا ، فَلَمَّا قَضَى صَلاتَهُ نَادَى رَجُلٌ , فَقَالَ : يَا رَسُولَ اللَّهِ , إنَّ هَذَا رَجُلٌ شَارِبٌ ، فَدَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الرَّجُلَ , فَقَالَ :  مَا شَرِبْتُ ؟ "" , فَقَالَ : عَمَدْتُ إِلَى زَبِيبٍ فَجَعَلْتُهُ فِي جَرٍّ , حَتَّى إِذَا بَلَغَ فَشَرِبْتُهُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" يَا أَهْلَ الْوَادِي ,أَلا إِنِّي أَنْهَاكُمْ عَمَّا فِي الْجَرِّ الأَحْمَرِ ، وَالأَخْضَرِ ، وَالأَبْيَضِ ، وَالأَسْوَدِ مِنْهُ ، لِيُنْبِذْ أَحَدُكُمْ فِي سِقَائِهِ ، فَإِذَا خَشِيَهُ فَلْيُشَجِّجْهُ بِالْمَاءِ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ أَبَانَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ""","","","","","Book of Drinks"
"16443","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ عَامِرِ بْنِ شَقِيقٍ ، عَنْ شَقِيقٍ ، عَنِ ابْنِ مَسْعُودٍ :  أَنَّهُسَقَاهُ نَبِيذًا فِي جَرَّةٍ خَضْرَاءَ "", قَالَ أَبُو وَائِلٍ : وَقَدْ رَأَيْتُ تِلْكَ الْجَرَّةَ""","","","","","Book of Drinks"
"16444","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ قَرْصَافَةَ بِنْتِ عَمِّهِ , قَالَتْ : دَخَلْتُ عَلَى عَائِشَةَ , فَطَرَحَتْ لِي وَسَادَةً , فَسَأَلَتْهَا امْرَأَةٌ عَنِ النَّبِيذِ , فَقَالَتْ : نَجْعَلُ التَّمْرَةَ فِي الْكُوزِ , فَنَطْبُخُهُ , فَنَصْنَعَهُ نَبِيذًا , فَنَشْرَبُهُ "" , فَقَالَتْ : "" اشْرَبِي وَلا تَشْرَبِي مُسْكِرًا ""","","","","","Book of Drinks"
"16445","عَنْ إِسْرَائِيلَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّ أَبِي عُبَيْدَةَ , قَالَتْ : كُنْتُ أَنْتَبِذُ لِعَبْدِ اللَّهِ فِي جَرَّةٍ خَضْرَاءَ ، وَهُوَ يَنْظُرُ إِلَيْهَا فَيَشْرَبُ مِنْهَا ""","","","","","Book of Drinks"
"16446","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : سَمِعْتُ أَبَا جَمْرَةَ الضُّبَعِيَّ , يَقُولُ : كَانَ أَنَسُ بْنُ مَالِكٍ  يَشْرَبُنَبِيذَ الْجَرِّ , قَالَ أَبُو جَمْرَةَ : وَقَالَ ابْنُ عَبَّاسٍ : "" لا تَشْرَبْهُ ، وَإِنْ كَانَ أَحْلَى مِنَ الْعَسَلِ ""","","","","","Book of Drinks"
"16447","عَنْ رَجُلٍ ، عَنْ شُعْبَةَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ : شَرِبَ ابْنُ مَسْعُودٍ , وَأُسَامَةُ , وَأَبُو مَسْعُودٍ الأَنْصَارِيُّ , مِنْ نَبِيذِ الْجَرِّ "", عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ مِثْلَهُ""","","","","","Book of Drinks"
"16448","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ ، عَنِ ابْنِ بُرَيْدةَ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِنِّيكُنْتُ نَهَيْتُكُمْ عَنْ نَبِيذِ الْجَرِّ , فَانْتَبَذُوا فِي كُلِّ وَعَاءٍ , وَاجْتَنِبُوا كُلَّ مُسْكِرٍ ""","","","","","Book of Drinks"
"16449","عَنِ ابْنِ جُرَيْجٍ , قَالَ : بَلَغَنِي عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , أَنَّهُ قَالَ :نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ نَنْبُذَ جَرَّةً , أَوْ قُرْعَةً , أَوْ فِي جَرَّةٍ مِنْ رَصَاصٍ , أَوْ جَرَّةٍ مِنْ قَوَارِيرَ ، وَأَلا يَنْبُذُوا إِلا فِي سِقَاءٍ يُوكَا عَلَيْهِ","","","","","Book of Drinks"
"16450","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَنْ أُصَدِّقُ ، أَنَّ رَجُلا جَاءَ ابْنَ مَسْعُودٍ فَسَقَاهُ مِنْ جَرٍّ , قَالَ : ثُمَّ أَتَيْتُ عَلِيًّا فَاسْتَسْقَى , فَسُقِي مَنْ جَرٍّ , فَقَالَ لِلَّذِي سَقَاهُ : "" مِنْ أَيْنَ سَقَيْتَنِي ؟ "" , فَقَالَ : مِنَ الْجَرِّ , فَقَالَ : "" ائْتِنِي بِهَا فَابْتَرَزَ ، ثُمَّ احْتَمَلَ الْجَرَّ , فَضَرَبَ بِهِ فَانْكَسَرَ "" , قَالَ : "" لَوْ لَمْ أَنْهَ عَنْهُ إِلا مَرَّةً أَوْ مَرَّتَيْنِ ""","","","","","Book of Drinks"
"16451","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ فَأَسْرَعْتُ ، فَلَمْ أَنْتَهِ إِلَيْهِ حَتَّى نَزَلَ , فَسَأَلْتُ النَّاسَ مَا قَالَ , قَالُوا : نَهَى عَنِ النَّبِيذِ ، وَالْمُزَفَّتِ أَنْ يُنْتَبَذَ فِيهِمَا ""","","","","","Book of Drinks"
"16452","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ سُلَيْمَانَ الأَحْوَلِ ، عَنْ مُجَاهِدٍ ، عَنْ أَبِي عِيَاضٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الأَوْعِيَةِ "" , فَقِيلَ لَهُ : لَيْسَ كُلُّ النَّاسِ يَجِدُ سِقَاءً فَأَذِنَ فِي الْجَرِّ غَيْرِ الْمُزَفَّتِ""","","","","","Book of Drinks"
"16453","عَنْ بَكَّارِ بْنِ 000 ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّهُ سَأَلَ طَاوُسًا , عَنِ الشَّرَابِ فَأَخْبَرَهُ , عَنِ ابْنِ عُمَرَ :  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْجَرِّ وَالدُّبَّاءِ ""","","","","","Book of Drinks"
"16454","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ شُعْبَةَ بْنِ الْحَجَّاجِ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ زَاذَانَ , قَالَ : قُلْتُ لابْنِ عُمَرَ : أَخْبِرْنِي عَمَّا نَهَى عَنْهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الأَوْعِيَةِ , قَالَ : نَهَى عَنِ الْحَنْتَمِ : وَهِيَ الْجَرَّةُ ، وَنَهَى عَنِ الدُّبَّاءِ : وَهِيَ الْقَرْعَةُ ، وَنَهَى عَنِ النَّقِيرِ : وَهِيَ النَّخْلَةُ تُنْسَجُ نَسْجًا , وَتُنْقَرُ نَقْرًا ، وَنَهَى عَنِ الْمُزَفَّتِ : وَهُوَ الْمُقَيَّرِ ، وَأَمَرَ أَنْ يُشْرَبَ فِي الأَسْقِيَةِ ""","","","","","Book of Drinks"
"16455","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ , قَالَ : حُدَّثَتْنِي أُمَيْمَةُ , قَالَتْ : سَمِعْتُ عَائِشَةَ , تَقُولُ :  أَيَعْجَزُ أَحَدُكُمْ أَنْ يَأْخُذَ كُلَّ عَامٍ جِلْدَ أُضْحِيَتِهَا , يَجْعَلُهُ سِقَاءً يُنْبَذُ فِيهِ "" , نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَوْ قَالَتْ : ""نَهَى نَبِيُّ اللَّهِ عَنِ الْجَرِّ أَنْ يُنْتَبَذَ فِيهِ ، وَعَنْ وَعَاءَيْنِ آخَرَيْنِ , إِلا الْخَلَّ ""","","","","","Book of Drinks"
"16456","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى ابْنِ أَبِي كَثِيرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي قَتَادَةَ ، عَنْ أَبِيهِ , قَالَ :نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الزَّهْوِ وَالرُّطَبِ أَنْ يُخْتَلَطَ ، وَعَنِ الزَّبِيبِ وَالتَّمْرِ أَنْ يُخْتَلَطَ , وَقَالَ : يُنْبَذُ كُلُّ وَاحِدٍ مِنْهُمَا وَحْدَهُ, قُلْتُ لَهُ : مَا الزَّهْوُ ؟ قَالَ : هُوَ دُونَ الرُّطَبِ","","","","","Book of Drinks"
"16457","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ ، سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : لا تَجْمَعُوا بَيْنَ الرُّطَبِ ، وَالْبُسْرِ ، وَبَيْنَ التَّمْرِ ، وَالزَّبِيبِ نَبِيذًا "", عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، مِثْلَ قَوْلِ عَطَاءٍ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ""","","","","","Book of Drinks"
"16458","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ التَّمْرِ ، وَالزَّبِيبِ وَالرُّطَبِ ، وَالْبُسْرِ "", يَعْنِي : أَنْ يَنْتَبِذَا جَمِيعًا""","","","","","Book of Drinks"
"16459","عَنِ الثَّوْرِيِّ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ , قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : الْبُسْرُ وَالرُّطَبُ خَمْرٌ "" , يَعْنِي إِذَا جُمِعَا""","","","","","Book of Drinks"
"16460","أَخْبَرَنَا مَعْمَرٌ ، عَنْ ثَابِتٍ ، وَقَتَادَةَ , وَأَبَانَ ، كُلُّهُمْ عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : لَمَّا حُرِّمَتِ الْخَمْرُ , قَالَ : إِنِّي يَوْمَئِذٍ لأُسْقِي أَحَدَ عَشَرَ رَجُلا , فَأَمَرُونِي فَكَفَأْتُهَا , وَكَفَأَ النَّاسُ آنِيَتَهُمْ بِمَا فِيهَا , حَتَّى كَادَتِ السِّكَكُ أَنْ تُمْنَعَ مِنْ رِيحِهَا ، قَالَ أَنَسُ : وَمَا خَمْرُهُمْ يَوْمَئِذٍ إِلا الْبُسْرُ ، وَالتَّمْرُ مَخْلُوطَيْنِ , قَالَ : فَجَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّهُ كَانَ عِنْدِي مَالُ يَتِيمٍ فَاشْتَرَيْتُ بِهِ خَمْرًا , فَتَأْذَنُ لِي أَنْ أَبِيعَهُ فَأَرُدَّ عَلَى الْيَتِيمِ مَالَهُ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَاتَلَ اللَّهُ الْيَهُودَ , حُرِّمَتْ عَلَيْهِمُ الثُّرُوبُ ، فَبَاعُوهَا وَأَكَلُوا أَثْمَانَهَا "" , وَلَمْ يَأْذَنْ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي بَيْعِ الْخَمْرِ""","","","","","Book of Drinks"
"16461","قَالَ مَعْمَرٌ : وَأَخْبَرَنِي الزُّهْرِيُّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَعَنَ اللَّهُ الْيَهُودَ , حُرِّمَتْ عَلَيْهِمُ الشُّحُومُ , فَبَاعُوهَا وَأَكَلُوا أَثْمَانَهَا ""","","","","","Book of Drinks"
"16462","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي مَنْ  رَأَى أَنَسَ بْنَ مَالِكٍيُقْطَعُ لَهُ ذَنُوبُ الْبُسْرِ ""","","","","","Book of Drinks"
"16463","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ :  كَانَ أَنَسٌإِذَا أَرَادَ أَنْ يَنْبِذَ يَقْطَعُ مِنَ التَّمْرَةِ مَا نَضَجَ مِنْهَا , فَيَضَعُهُ وَحْدَهُ ، وَيَنْبِذَ التَّمْرَ وَحْدَهُ ، وَالْبُسْرَ وَحْدَهُ ""","","","","","Book of Drinks"
"16464","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَمْرُو بْنُ دِينَارٍ ، سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , أَوْ أَخْبَرَنِي عَنْهُ مَنْ أُصَدِّقُ ،أَلا يُجْمَعَ بَيْنَ الرُّطَبِ ، وَالْبُسْرِ ، وَالزَّبِيبِ ، وَالتَّمْرِ، قُلْتُ لِعَمْرٍو : وَهَلْ غَيْرُ ذَلِكَ ؟ قَالَ :  لا "" , قُلْتُ لِعَمْرٍو : أَوْ لَيْسَ إِنَّمَا نُهِيَ عَنْ أَنْ يُجْمَعَ بَيْنَهُمَا فِي النَّبِيذِ ، وَأَنْ يُنْبَذَا جَمِيعًا ؟ "" قَالَ : "" بَلَى "" , قُلْتُ : فَغَيْرُ ذَلِكَ مِمَّا فِي النَّخْلَةِ ؟ قَالَ : "" لا أَدْرِي ""","","","","","Book of Drinks"
"16465","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، نَهَى أَنْ يَنْتَبِذُوا الْبُسْرَ ، وَالتَّمْرَ ""","","","","","Book of Drinks"
"16466","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ أَبِي إِسْحَاقَ : أَنَّ رَجُلا سَأَلَ ابْنَ عُمَرَ , فَقَالَ : أَجْمَعُ التَّمْرَ الزَّبِيبَ ؟ قَالَ : لا , قَالَ : فَلِمَ ؟ قَالَ : نَهَى عَنْهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : لِمَ ؟ قَالَ :سَكِرَ رَجُلٌ فَحَدَّهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ أَمَرَ أَنْ يُنْظَرَ مَا شَرَابُهُ ، فَإِذَا هُوَ تَمْرٌ وَزَبِيبٌ : فَنَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُجْمَعَ بَيْنَ التَّمْرِ ، وَالزَّبِيبِ , وَقَالَ : يَكْفِي كُلُّ وَاحِدٍ مِنْهُمَا وَحْدَهُ","","","","","Book of Drinks"
"16467","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُ كَانَ يَقُولُ :  قَدْنُهِيَ أَنْ يُنْتَبَذَ الْبُسْرُ ، وَالرُّطَبُ جَمِيعًا ، وَالتَّمْرُ ، وَالزَّبِيبُ جَمِيعًا ""","","","","","Book of Drinks"
"16468","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَذَكَرَ جَابِرٌ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى أَنْ يُجْمَعَ بَيْنَ نَبِيذَيْنِ غَيْرَ مَا ذَكَرْتَ ؟ غَيْرَ الْبُسْرِ ، وَالرُّطَبِ ، وَالزَّبِيبِ ، وَالتَّمْرِ , قَالَ : لا , إِلا أَنْ أَكُونَ نَسِيتُ""","","","","","Book of Drinks"
"16469","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً عَمَّا سُوَى مَا ذَكَرَ جَابِرٌ ، مِمَّا فِيالْحَبَلَةِ وَالنَّخْلَةِ أَنْ يُجْمَعَ بَيْنَهُ , فَكَانَ يَأْبَى، قَالَ فِي الْحُلْقَانِ : يُقْطَعُ بَعْضُهُ مِنْ بَعْضٍ , قَالَ : فَسَأَلْتُهُ عَنِ الْعَسَلِ أَيُجْمَعُ بِأَشْيَاءَ مِنَ التَّمْرِ وَالْفِرْسِكِ بِالْعَسَلِ نَبِيذًا ؟ فَقَالَ : إِنِّي أَرَى مَا شَدَّ بَعْضُهُ بَعْضًا كَانَ عَلَى ذَلِكَ , قَالَ : قُلْتُ لَهُ : أَيُجْمَعُ بَيْنَ التَّمْرِ وَالزَّبِيبِ , يُنْبَذَانِ ثُمَّ يُشْرَبَانِ حُلْوَيْنِ ؟ قَالَ :  لا ، قَدْ نُهِيَ عَنِ الْجَمْعِ بَيْنَهُمَا "" ، قَالَ ابْنُ جُرَيْجٍ : وَأَقُولُ أَنَا : أَجَلْ أَلا تَرَى أَنَّهُ لَوْ نُبِذَ شَرَابٌ فِي الظَّرْفِ : "" نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْهُ , لَمْ يُشَرَبْ حُلْوًا "" , قَالَ عَبْدُ الرَّزَّاقِ : وَالْحُلْقَانُ : قَضِيبٌ يُشَقُّ , ثُمَّ يُوضَعُ فِي جَوْفِهِ قَضِيبَانِ ثُمَّ بِتَمْرٍ""","","","","","Book of Drinks"
"16470","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كَيْفَ تَقُولُفِي الْجَمْعِ بَيْنَهُمَا عِنْدَ الشَّرَابِ ، وَقَدْ نُبِذَا فِي ظَرْفَيْنِ شَتَّى ؟ فَكَرِهَهُ ، وَقَالَ : قَدْ نَهَى عَنْهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، كَأَنَّهُ أَدْخَلَ ذَلِكَ فِي نَهْيِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَعَاوَدْتُهُ , فَكَرِهَهُ , قَالَ : وَأَخْشَى أَنْ يَشْتِدَّ , وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : مَا أَرَى بِذَلِكَ بَأْسًا , قَالَ عَبْدُ الرَّزَّاقِ : وَلا أَرَى بِذَلِكَ بَأْسًا","","","","","Book of Drinks"
"16471","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ كَرِهَ أَنْ يُجْعَلَ نَطْلُ النَّبِيذِ فِي النَّبِيذِ لِيَشْتَدَّ بِالنَّطْلِ "" , النَّطْلُ : الطَّحِلُ""","","","","","Book of Drinks"
"16472","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ زَيْدِ ابْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ :  أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى أَنْ يُنْبَذَ الزَّبِيبُ ، وَالتَّمْرُ جَمِيعًا ، وَالزَّهْوُ ، وَالرُّطَبُ جَمِيعًا ""","","","","","Book of Drinks"
"16473","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ، أَنَّ عُرْوَةَ أَخْبَرَهُ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، أَنَّهُ سَمِعَهُ يَقُولُ :  قَدْ كَانَيُكْرَهُ شَرَابُ فَضَيخِ الْبُسْرِ بَحْتًا ""","","","","","Book of Drinks"
"16474","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ أَبِي الشَّعْثَاءِ :  أَنَّهُ قَدْ كَانَ يُنَهَى عَنْ شَرَابِ الْبُسْرِ ، بَحْتًا "" , قَالَ : وَأَخْبَرَنِي أَيْضًا عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّهُ : "" كَانَيُنْهَى أَنْ يُشْرَبَ الْبُسْرُ بَحْتًا "", عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ جَابِرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَحْسَبُهُ ذَكَرَهُ عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ , عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ ، وَعَمْرُو بْنُ دِينَارٍ , وَأَبُو الزُّبَيْرِ : مَا عَلِمْنَاهُ يَكْرَهُ""","","","","","Book of Drinks"
"16475","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَالْحَسَنِ ،  قَالَ مَعْمَرٌ : وَبَلَغَنِي عَنْ أَنَسٍ ، أَنَّهُمْ قَالُوا :لا بَأْسَ بِهِ, قَالَ مَعْمَرٌ : وَأَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  انْتَبِذُوا كُلَّ وَاحِدٍ مِنْهُمَا وَحْدَهُ ""","","","","","Book of Drinks"
"16476","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، كَانَ يَقُولُ : إِذَا فَضَخَهُ نَهَارًا فَأَمْسَى فَلا يُقَرِّبْهُ "", قَالَ : وَيَقُولُ بَعْضُهُمْ : حَتَّى يَغْلِي""","","","","","Book of Drinks"
"16477","عَنْ دَاوُدَ بْنِ إِبْرَاهِيمَ ، قَالَ : سَأَلْتُ طَاوُسًا عَنِالْعَصِيرِ , فَقَالَ :  اشْرَبْهُ فِي سِقَاءٍ مَا لَمْ تَخَفْهُ ، فَإِذَا خِفْتَهُ فَاكْسِرْهُ بِالْمَاءِ ""","","","","","Book of Drinks"
"16478","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنِ ابْنِ عُمَرَ , قَالَ : اشْرَبِ الْعَصِيرَ مَا لَمْ يَأْخُذْهُ شَيْطَانُهُ "" , قَالَ : وَمَتَّى يَأْخُذُهُ شَيْطَانُهُ ؟ قَالَ : "" بَعْدَ ثَلاثٍ "" , أَوْ قَالَ : "" فِي ثَلاثٍ ""","","","","","Book of Drinks"
"16479","عَنِ الثَّوْرِيِّ ، عَنْ حُصَيْنٍ ، أَنَّ أَبَا عُبَيْدَةَ بْنَ عَبْدِ اللَّهِ  كَانَيَبِيعُ الْعَصِيرَ ""","","","","","Book of Drinks"
"16480","أَخْبَرَنَا هَمَّامُ بْنُ نَافِعٍ , قَالَ : سُئِلَ طَاوُسٌ عَنْ بَيْعِ الْعَصِيرِ , فَسَكَتَ ، فَقَالَ عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ الصَّنْعَانِيّ : مَا حَلَّ لَكَ شُرْبُهُ حَلَّ لَكَ بَيْعُهُ "", فَتَبَسَّمَ طَاوُسٌ , وَقَالَ : صَدَقَ أَبُو مُحَمَّدٍ""","","","","","Book of Drinks"
"16481","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ :  سَأَلَ قَهْرَمَانُ سَعْدِ بْنِ أَبِي وَقَّاصٍ سَعْدًا عَنْ أَرْضِهِ , وَهُوَ كَأَنَّهُيَسْتَأْذِنُهُ أَنْ يَعْصِرَ عِنَبَهُ ، فَقَالَ لَهُ سَعْدٌ : "" بِعْهُ عِنَبًا "" , قَالَ : لا يَشْتَرُونَهُ , قَالَ : "" اجْعَلْهُ زَبِيبًا "" , قَالَ : لا يَصْلُحُ , قَالَ : "" اقْلَعْهُ ""","","","","","Book of Drinks"
"16482","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ عَنْ رَجُلٍ بَاعَ عِنَبَهُ مِمَّنْ يَعْصِرُهُ خَمْرًا , قَالَ : "" لا بَأْسَ بِهِ "", قَالَ مَعْمَرٌ : وَأَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , أَنَّهُ كَانَ يَكْرَهُهُ""","","","","","Book of Drinks"
"16483","أَخْبَرَنَا مَعْمَرٌ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنْرَجُلٍ بَاعَ مِنْ رَجُلٍ شَاةً يُرِيدُ أَنْ يَذْبَحَهَا لِصَنَمِهِ , قَالَ "" لا بَأْسَ بِهِ ""","","","","","Book of Drinks"
"16484","أَخْبَرَنَا مَعْمَرٌ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ  أَنَّرَجُلا ابْتَاعَ خَمْرًا ، وَخَلَطَ فِيهِ مَاءً ، ثُمَّ حَمَلَهُ إِلَى أَرْضِ الْهِنْدِ , فَبَاعَهُ , وَجَعَلَ الْكِيسَ فِي السَّفِينَةِ ، وَكَانَ فِي السَّفِينَةِ قِرْدٌ , فَأَخَذَ الْقِرْدُ الْكِيسَ ، وَصَعَدَ عَلَى الدَّقَلِ , فَجَعَلَ يُلْقِي عَلَى السَّفِينَةِ دِرْهَمًا وَفِي الْبَحْرِ دِرْهَمًا , حَتَّى أَتَى عَلَى آخِرِهِ ""","","","","","Book of Drinks"
"16485","أَخْبَرَنَا مُحَمَّدُ بْنُ سَعِيدِ بْنِ رُمَّانَةَ , قَالَ : أَخْبَرَنِي حَكِيمُ بْنُ الرَّفَافِ , قَالَ : أَتَيْتُ ابْنَ عُمَرَ أَنَا , وَقَيْسٌ مَوْلَى الضَّحَّاكِ , فَوَجَدْنَاهُ قَدْ هَبَطَ مِنَ الْجَمْرَةِ يُرِيدُ مَكَّةَ ، فَقَالَ لَهُ قَيْسٌ : الْحَمْدُ للَّهِ الَّذِي رَزَقَنَا رُؤْيَتَكَ ، وَإِنَّكَ قَدْ رَأَيْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَفِي رُؤْيَتِكَ بَرَكَةٌ , وَلَوَلا أَنَّكَ عَلَى هَذَا الْحَالِ لَسَأَلْتُكَ , قَالَ :  سَلْ عَمَّا بَدَا لَكَ "" , قَالَ : فَقَالَ لَهُ : رَجُلٌ قَدِ اخْتَلَفَ إِلَى هَذَا الْبَيْتِ أَرْبَعِينَ عَامًا مَا بَيْنَ حَجٍّ وَعُمْرَةٍ ، فَإِذَاانْصَرَفَ إِلَى أَهْلِهِ وَجَدَهُمْ قَدْ صَنَعُوا لَهُ نَبِيذًا مِنْ هَذَا الزَّبِيبِ ، فَإِنْ صُبَّ عَلَيْهِ الْمَاءُ لَمْ يُحِفْ ، وَإِنْ شَرِبَهُ كَمَا هُوَ سَكِرَ ، فَقَالَ لَهُ ابْنُ عُمَرَ : "" أُدْنُ مِنِّي "" ، فَدَنَا مِنْهُ : "" فَدَفَعَهُ فِي صَدْرِهِ حَتَّى وَقَعَ عَلَى اسْتِهِ ، ثُمَّ قَالَ : أَنْتَ هُوَ ! فَلا حَجَّ لَكَ وَلا كَرَامَةَ ""، فَقَالَ : مَا سَأَلْتُكُ إِلا عَنْ نَفْسِي , وَاللَّهِ لا أَذُوقُ مِنْهُ قَطْرَةً أَبَدًا""","","","","","Book of Drinks"
"16486","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : كُلُّ مُسْكِرٍ حَرَامٌ ""","","","","","Book of Drinks"
"16487","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعَثَ أَبَا مُوسَى وَأَخَاهُ إِلَى الْيَمَنِ عَامِلَيْنِ , فَقَالا : يَا رَسُولَ اللَّهِ , إِنَّأَهْلَ الْيَمَنِ يَشْرَبُونَ أَشْرِبَةً لَهُمْ , قَالَ :  وَمَا هِيَ ؟ "" , قَالا : الْبِتْعُ وَالْمِزْرُ , قَالَ : "" وَمَا ذَاكَ ؟ "" , قَالَ : أَمَّا الْبِتْعُ : فَالْعَسَلُ يَقْرِضُ ، وَأَمَّا الْمِزْرُ : فَشَرَابٌ يُجْعَلُ مِنَ الذُّرَةِ وَالشَّعِيرِ ، فَقَالَ : "" لا أَدْرِي مَا ذَلِكَ ؟ حُرِّمَ عَلَيْكُمَا كُلُّ مُسْكِرٍ ""","","","","","Book of Drinks"
"16488","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  تَلا آيَةَ الْخَمْرِ وَهُوَ يَخْطُبُ النَّاسَ عَلَى الْمِنْبَرِ , فَقَالَ رَجُلٌ : فَكَيْفَ بِالْمِزْرِ يَا رَسُولَ اللَّهِ ؟ قَالَ : "" وَمَا الْمِزْرِ ؟ "" , قَالَ : شَرَابٌ يُصْنَعُ مِنَ الْحَبِّ , قَالَ : "" يُسْكِرُ ؟ "" , قَالَ : نَعَمْ , قَالَ : ""كُلُّ شَرَابٍ مُسْكِرٍ حَرَامٌ ""","","","","","Book of Drinks"
"16489","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ عَائِشَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنِالْبِتْعِ , فَقَالَ :  كُلُّ شَرَابٍ يُسْكِرُ فَهُوَ حَرَامٌ "", قَالَ عَبْدُ الرَّزَّاقِ : الْبِتْعُ نَبِيذُ الْعَسَلِ""","","","","","Book of Drinks"
"16490","أَخْبَرَنَا هِشَامُ بْنُ حَسَّانَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : كُنْتُ عِنْدَ ابْنِ عُمَرَ , فَجَاءَهُ رَجُلٌ ، فَقَالَ : إِنِّي رَجُلٌ لا أَسْتَمْرِئُ الطَّعَامَ , فَآمُرُ أَهْلِي فَيَنْتَبِذُونَ لِي فِي جَرٍّ مِثْلَ هَذَا ، وَأَشَارَ بِيَدِهِ فَيَهْضِمُ طَعَامِي ، فَقَالَ ابْنُ عُمَرَ : أَنْهَاكَ عَنِ الْمُسْكِرِ قَلِيلِهِ وَكَثِيرِهِ , وَأُشْهِدُ اللَّهَ عَلَيْكَ ثَلاثَ مَرَّاتٍ ""","","","","","Book of Drinks"
"16491","عَنْ مَالِكٍ ، وَعَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : كُلُّ مُسْكِرٍ حَرَامٌ وَكُلُّ مُسْكِرٍ خَمْرٌ ""","","","","","Book of Drinks"
"16492","عَنِ ابْنِ أَبِي سَبْرَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : كُلُّ مُسْكِرٍ حَرَامٌ ""","","","","","Book of Drinks"
"16493","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ الْمَدِينِيِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : مَا أَسْكَرَ مِنْهُ الْفَرَقُ ، فَالْحَسْوَةُ مِنْهُ حَرَامٌ ""","","","","","Book of Drinks"
"16494","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ , قَالَ : أَخْبَرَنَا عَمْرُو بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَلِيلُ مَا أَسْكَرَ كَثِيرُهُ حَرَامٌ ""","","","","","Book of Drinks"
"16495","عَنْ عَقِيلَ بْنِ مَعْقِلٍ ، أَنَّ هَمَّامَ بْنَ مُنَبِّهٍ أَخْبَرَهُ , قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ النَّبِيذِ , فَقُلْتُ : يَا أَبَا عَبْدِ الرَّحْمَنِ , هَذَا الشَّرَابُ مَا تَقُولُ فِيهِ ؟ قَالَ :  كُلُّ مُسْكِرٍ حَرَامٌ "" , قَالَ : قُلْتُ : فَإِنْ شَرِبْتُ مِنَ الْخَمْرِ فَلَمْ أَسْكَرْ ؟ فَقَالَ : "" أُفٍّ أُفٍّ ! وَمَا بَالُ الْخَمْرِ وَغَضِبَ "" , قَالَ : فَتَرَكْتُهُ حَتَّى انْبَسَطَ , أَوْ قَالَ : أَسْفَرَ وَجْهُهُ , أَوْ قَالَ : حَدَّثَ مَنْ كَانَ حَوْلَهُ , فَقُلْتُ : يَا أَبَا عَبْدِ الرَّحْمَنِ , إِنَّكَ بَقِيَّةُ مَنْ قَدْ عَرَفْتُ , وَقَدْ يَأْتِي الرَّاكِبُ فَيَسْأَلُكَ عَنِ الشَّيْءِ , فَيَأْخُذُ بِذَنَبِ الْكَلِمَةِ يَضْرِبُ بِهَا فِي الآفَاقِ , يَقُولُ : قَالَ ابْنُ عُمَرَ : "" كَذَا وَكَذَا "" , قَالَ : "" أَعِرَاقِيٌّ أَنْتَ ؟ "" , قُلْتُ : لا , قَالَ : "" فَمِمَّنْ أَنْتَ ؟ "" , قُلْتُ : مِنْ أَهْلِ الْيَمَنِ ، قَالَ : "" أَمَّاالْخَمْرُ فَحَرَامٌ , لا سَبِيلَ إِلَيْهَا ، وَأَمَّا مَا سُواهَا مِنَ الأَشْرِبَةِ , فَكُلُّ مُسْكِرٌ حَرَامٌ ""","","","","","Book of Drinks"
"16496","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : أَنْهَاكَ عَنِ الْمُسْكِرِ قَلِيلِهِ ، وَكَثِيرِهِ ، وَأُشْهِدُ اللَّهَ عَلَيْكَ ""","","","","","Book of Drinks"
"16497","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : إِنْ شَرِبَ رَجُلٌ مِنَ الْمُسْكِرِ مَا لا يَبْلُغُ أَنْ يُسْكِرَ عَنْهُ , أَوْجَعَهُ بِالْمَاءِ ، فَقَدْ وَجَبَ عَلَيْهِ الْحَدُّ ، وَإِنْ لَمْ يُسْكِرْ "" , قُلْتُ : لَمْ يَنْزِلْ فِيهِ شَيْءٌ ؟ قَالَ : "" لا عُقُوبَةَ وَلا حَدٌّ , إِلا أَنْ يَعُودَ فَيُعَاقَبَ "" , قُلْتُ لَهُ : فَوَجَدْتُ شَرَابًا مُسْكِرًا بَيْنَ يَدَيَّ ؟ فَقَالَ : "" لا حَدَّ , فَأَنْزَلَهُ بِمَنْزِلَةِ مَنْ لَمْ يَنْزِلْ فِيهِ شَيْءٌ ""","","","","","Book of Drinks"
"16498","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَبْدُ الْكَرِيمِ بْنُ أَبِي الْمُخَارِقِ : وَلا يُجْلَدُ فِيمَا دُونَ الْخَمْرِ وَالطِّلاءِ مِنَ الْمُسْكِرِ , إِلا أَنْ يَسْكَرَ مِنْهُ ، فَإِنْ شَرِبَ حَسْوَةً مِنْ خَمْرٍ أَوْ طِلاءٍ حُدَّ ""","","","","","Book of Drinks"
"16499","عَنِ الثَّوْرِيِّ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنِ أَبِي الْعَلاءِ بْنِ عَبْدِ اللَّهِ بْنِ الشِّخِّيرِ , قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَشْرِبَةٍ "" , قَالَ : فَقِيلَ لَهُ : إِنَّهُ لا بُدَّ مِنْهَا أَوْ نَحْوَ هَذَا , قَالَ : "" فَاشْرَبُوا مَا لَمْ يُسَفِّهْ أَحْلامَكُمُ , وَلا يُذْهِبْ أَمْوَالَكُمْ ""","","","","","Book of Drinks"
"16500","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ ذَرِّ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ أَبْزَى ، عَنْ أَبِيهِ , قَالَ : سَأَلْتُ أُبَيَّ بْنَ كَعْبٍ عَنِالنَّبِيذِ , فَقَالَ :  اشْرَبِ الْمَاءَ ، وَاشْرَبِ السَّوَيْقَ ، وَاشْرَبِ اللَّبَنَ الَّذِي نَجَعْتَ بِهِ "" , قُلْتُ : لا تُوافِقُنِي هَذِهِ الأَشْرِبَةُ , قَالَ : "" فَالْخَمْرُ إِذَا تُرِيدُ ""","","","","","Book of Drinks"
"16501","عَنِ الثَّوْرِيِّ , قَالَ : حَدَّثَنِي أَبُو الْجُوَيْرِيَةَ الْجَرْمِيُّ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ أَوْ سَأَلَهُ رَجُلٌ عَنِالْبَاذَقِ , فَقَالَ : سَبَقَ مُحَمَّدٌ الْبَاذَقَ , وَمَا أَسْكَرَ فَهُوَ حَرَامٌ ، قُلْتُ : يَا ابْنَ عَبَّاسٍ ، أَرَأَيْتَ الشَّرَابَ الْحُلْوَ الْحَلالَ الطَّيِّبَ ؟ قَالَ :  فَاشْرَبِ الْحَلالَ الطَّيِّبَ ، فَلَيْسَ بَعْدَ الْحَلالِ الطَّيِّبِ إِلا الْحَرَامَ الْخَبِيثَ "", قَالَ أَبُو يَعْقُوبَ : قُلْنَا لَهُ : مَا الْبَاذَقُ ؟ قَالَ : شَيْءٌ يُشَدُّ بِهِ الشَّرَابُ""","","","","","Book of Drinks"
"16502","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ  أَنَّرَجُلا عَبَّ فِي شَرَابٍ نُبِذَ لِعُمَرَ بْنِ الْخَطَّابِ بِطَرِيقِ الْمَدِينَةِ , فَسَكِرَ , فَتَرَكَهُ عُمَرُ حَتَّى أَفَاقَ , فَحَدَّهُ ، ثُمَّ أَوْجَعَهُ عُمَرُ بِالْمَاءِ فَشَرِبَ مِنْهُ , قَالَ : وَنَبَذَ نَافِعُ بْنُ عَبْدِ الْحَارِثِ لِعُمَرَ بْنِ الْخَطَّابِ فِي الْمَزَادِ , وَهُوَ عَامِلُ مَكَّةَ , فَاسْتَأْخَرَ عُمَرُ حَتَّى عَدَا الشَّرَابُ طَوْرَهُ ، ثُمَّ عَدَا , فَدَعَا بِهِ عُمَرُ فَوَجَدَهُ شَدِيدًا , فَصَنَعَهُ فِي الْجِفَانِ ، فَأَوْجَعَهُ بِالْمَاءِ ، ثُمَّ شَرِبَ وَسَقَى النَّاسَ ""","","","","","Book of Drinks"
"16503","عَنْ إِبْرَاهِيمَ بْنِ يَزِيدَ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، عَنْ عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَتَّقِي الشَّرَابَ فِي الإِنَاءِ الضَّارِيِّ ""","","","","","Book of Drinks"
"16504","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ أَبِي مُلَيْكَةَ يُحَدِّثُ , قَالَ : حَدَّثَنِي وَهَبُ بْنُ الأَسْوَدِ , قَالَ :أَخَذْنَا زَبِيبًا مِنْ زَبِيبِ الْمَطَاهِرِ ، فَأَكْثَرْنَا مِنْهُ فِي أَدَاوَانَا ، وَأَقْلَلْنَا الْمَاءَ ، فَلَمْ يَلْقَ عُمَرَ حَتَّى عَدَا طَوْرَهُ ، فَلَمَّا لَقَوْا عُمَرَ , قَالَ :  هَلْ مِنْ شَرَابٍ "" , قَالَ : قُلْنَا : نَعَمْ يَا أَمِيرَ الْمُؤْمِنِينَ , فَأَخْبَرُوهُ هَذِهِ الْقِصَّةَ ، وَأَنْ قَدْ عَدَا طَوْرَهُ , قَالَ : "" أَرُونِيهِ , فَذَاقَهُ , فَوَجَدَهُ شَدِيدًا ، فَكَسَرَهُ بِالْمَاءِ ثُمَّ شَرِبَ "", قَالَ عَبْدُ الرَّزَّاقُ : وَهَذَا كُلُّهُ فِي الأَسْقِيَةِ""","","","","","Book of Drinks"
"16505","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَ طَافَ بِالْبَيْتِ أَتَى عَبَّاسًا , فَقَالَ : اسْقُوا "" , فَقَالَ عَبَّاسٌ : أَلا نَسْقِيَكَ يَا رَسُولَ اللَّهِ مِنْ شَرَابٍ صَنَعْنَاهُ فِي الْبَيْتِ ؟ فَإِنَّ هَذَا الشَّرَابَ قَدْ لَوَّثَتْهُ الأَيْدِي ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" اسْقُوا مِمَّا تَسْقُونَ النَّاسَ "" ، قَالَ : فَسَقَوْهُ. فَرَوَى ابْنُ عُيَيْنَةَ ، ثُمَّ دَعَا بِمَاءٍ فَصَبَّهُ عَلَيْهِ ، ثُمَّ شَرِبَ ، وَكَانَ ذَلِكَ الشَّرَابُ فِي الأَسْقِيَةِ""","","","","","Book of Drinks"
"16506","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ مِينَاءَ ، أَنَّهُ سَمِعَ الْقَاسِمَ بْنَ مُحَمَّدٍ ، يَقُولُ : نُهِيَ عَنْ أَنْ يُشْرَبَ النَّبِيذُ بَعْدَ ثَلاثٍ ""","","","","","Book of Drinks"
"16507","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ ابْنِ سِيرِينَ ، أَنَّ عُبَيْدَةَ ، كَانَ يَقُولُ : أَحْدَثَ النَّاسُ أَشْرِبَةً مَا أَدْرِي مَا هِيَ ؟ مَا لِي شَرَابٌ مُنْذُ عِشْرِينَ سَنَةً إِلا الْمَاءَ ، وَالسَّوَيْقَ ، وَالْعَسَلَ ، وَاللَّبَنَ "". وَذَكَرَهُ ابْنُ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ ابْنِ سِيرِينَ , عَنْ عُبَيْدَةَ""","","","","","Book of Drinks"
"16508","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ مُجَاهِدٍ , قَالَ :عَمِدَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى السِّقَايَةِ , سِقَايَةِ زَمْزَمَ ، فَشَرِبَ مِنَ النَّبِيذِ ، فَشَدَّ وَجْهَهُ ، ثُمَّ أَمَرَ بِهِ الثَّانِيَةَ ، فَكُسِرَ بِالْمَاءِ ، ثُمَّ شَرِبَ مِنْهُ فَشَدَّ وَجْهَهُ ، ثُمَّ أَمَرَ بِهِ الثَّالِثَةَ فَكُسِرَ بِالْمَاءِ ، ثُمَّ شُرِبَ","","","","","Book of Drinks"
"16509","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ : سَمِعْتُ ابْنَ الْمُسَيِّبِ , يَقُولُ :  تَلَقَّتْ ثَقِيفٌ عُمَرَ بْنَ الْخَطَّابِ بِشَرَابٍ فَدَعَاهُمْ بِهِ ، فَلَمَّاقَرَّبَهُ إِلَى فَمِهِ كَرِهَهُ ، ثُمَّ دَعَا بِمَاءٍ فَكَسَرَهُ ، ثُمَّ قَالَ : هَكَذَا فَاشْرَبُوهُ ""","","","","","Book of Drinks"
"16510","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ عَجْلانَ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : إِذَا أَطَعَمَكَ أَخُوكَ الْمُسْلِمُ طَعَامًا فَكُلْ ، وَإِذَا سَقَاكَ شَرَابًا فَاشْرَبْ , وَلا تَسْأَلْ ، فَإِنْ رَابَكَ فَاشْجُجْهُ بِالْمَاءِ "", عَنْ أَبِي مَعْشَرٍ الْمَدِينِيِّ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ مِثْلَهُ""","","","","","Book of Drinks"
"16511","عَنْ زُهَيْرِ بْنِ نَافِعٍ , قَالَ : سَأَلْتُ عَطَاءَ بْنَ أَبِي رَبَاحٍ ، عَنِ الْمِزْرِ , فَقَالَ : وَمَا الْمِزْرُ ؟ فَقَالَ رَجُلٌ إِلَى جَنْبِهِ : الْغُبَيْرَاءُ ، فَقَالَ : كُلُّ مُسْكِرٍ حَرَامٌ ""","","","","","Book of Drinks"
"16512","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ سَمِعَ ، هَانِئًا مَوْلَى عُثْمَانَ , قَالَ :  شَهِدْتُ عُثْمَانَوَأُتِيَ بِرَجُلٍ وُجِدَ مَعَهُ نَبِيذٌ فِي دُبَّاءَةٍ يَحْمِلُهُ ، فَجَلَدَهُ أَسْوَاطًا ، وَأَهْرَاقَ الشَّرَابَ ، وَكَسَرَ الدُّبَّاءَةَ "", وَأَخْبَرَنِي أَبُو وَائِلٍ , أَنَّهُ سَمِعَهُ مِنْ هَانِئٍ مِثْلَهُ""","","","","","Book of Drinks"
"16513","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنِ السَّائِبِ بْنِ يَزِيدَ , قَالَ :  شَهِدْتُ عُمَرَ بْنَ الْخَطَّابِ صَلَّى عَلَى جَنَازَةٍ ، ثُمَّ أَقْبَلَ عَلَيْنَا "" , فَقَالَ "" إِنِّيوَجَدْتُ مِنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ رِيحَ الشَّرَابِ ، وَإِنِّي سَأَلْتُهُ عَنْهَا , فَزَعَمَ أَنَّهَا الطِّلاءُ ، وَإِنِّي سَائِلٌ عَنِ الشَّرَابِ الَّذِي شَرِبَ ، فَإِنْ كَانَ مُسْكِرًا جَلَدْتُهُ "", قَالَ : فَشَهِدْتُهُ بَعْدَ ذَلِكَ يَجْلِدُهُ""","","","","","Book of Drinks"
"16514","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ ، عَنِ السَّائِبِ بْنِ يَزِيدَ  أَنَّهُ حَضَرَ عُمَرَ بْنَ الْخَطَّابِ ، وَهُوَيَجْلِدُ رَجُلا وَجَدَ مِنْهُ رِيحَ شَرَابٍ , فَجَلَدَهُ الْحَدَّ تَامًّا ""","","","","","Book of Drinks"
"16515","عَنْ مَعْمَرٍ ، عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , قَالَ :  كَانَ عُمَرُإِذَا وَجَدَ مِنْ رَجُلٍ رِيحَ شَرَابٍ جَلَدَهُ جَلَدَاتٍ ، إِنْ كَانَ مِمَّنْ يُدْمِنُ الشَّرَابَ ، وَإِنْ كَانَ غَيْرَ مُدْمِنٍ تُرِكَهُ ""","","","","","Book of Drinks"
"16516","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، مِنْ وَلَدِ يَعَلَى بْنِ أُمَيَّةَ , عَنْ أَبِيهِ ، أَنَّ يَعَلَى بْنَ أُمَيَّةَ قَالَ : قُلْتُ لِعُمَرَ :إِنَّا بِأَرْضٍ فِيهَا شَرَابٌ كَثِيرٌ , يَعْنِي : الْيَمَنَ , فَكَيْفَ نَجْلِدُهُ ؟ قَالَ :  إِذَا اسْتُقْرِئَ أُمَّ الْقُرْآنِ فَلَمْ يَقْرَأْهَا ، وَلَمْ يَعْرِفَ رِدَاءَهُ ، إِذَا أَلْقَيْتَهُ بَيْنَ الأَرْدِيَةِ , فَاحْدُدْهُ ""","","","","","Book of Drinks"
"16517","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، يَزْعُمُ أَنَّهُ اسْتَشَارَ ابْنَ الزُّبَيْرِ , وَهُوَ أَمِيرُ الطَّائِفِ فِيالرِّيحِ ، أَيَجْلِدُ فِيهَا ؟ فَكَتَبَ إِلَيْهِ :  إِذَا وَجَدْتَهَا مِنَ الْمُدْمِنِ ، وَإِلا فَلا ""","","","","","Book of Drinks"
"16518","عَنْ مَعْمَرٍ , قَالَ : بَلَغَنِي ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ أُتِيَ بِقَوْمٍ قَدْ شَرِبُوا , قَدْ سَكِرَ بَعْضُهُمْ وَلَمْ يَسْكَرْ بَعْضٌ , فَحَدَّهُمْ جَمِيعًا "", قَالَ مَعْمَرٌ : وَبَلَغَنِي أَنَّهُ إِذَا وَجَدَ عِنْدَ رَجُلٍ شَرَابًا مُسْكِرًا بَيْنَ يَدَيْهِ وَلَمْ يَشْرَبْهُ , فَالنَّكَالُ""","","","","","Book of Drinks"
"16519","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَنْ شَرِبَ حَسْوَتَيْ خَمْرٍ حُدَّ "" , قَالَ : "" وَإِنْ سَقَى رَجُلٌ ابْنَهُ حَسْوَةً كَذَلِكَ حُدَّ ""","","","","","Book of Drinks"
"16520","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، وَمَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ صَفِيَّةَ ابْنَةِ أَبِي عُبَيْدٍ , قَالَتْ : وَجَدَ عُمَرُ بْنُ الْخَطَّابِ فِي بَيْتِ رُوَيْشِدٍ الثَّقَفِيِّ خَمْرًا , وَقَدْ كَانَ جُلِدَ فِي الْخَمْرِ , فَحَرَّقَ بَيْتَهُ , وَقَالَ : "" مَا اسْمُهُ ؟ "" , قَالَ : رُوَيْشِدٌ , قَالَ : "" بَلْ فُوَيْسِقٌ "", أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنْ صَفِيَّةَ مِثْلَهُ""","","","","","Book of Drinks"
"16521","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرِّيحُ وَهُوَ يَعْقِلُ ؟ قَالَ : لا أَحِدُّ إِلا بِبَيِّنَةٍ , إنَّ الرِّيحَ لِيَكُونُ مِنَ الشَّرَابِ الَّذِي لَيْسَ بِهِ بَأْسٌ "", قَالَ : وَقَالَ عَمْرُو بْنُ دِينَارٍ : لا أَحِدُّ فِي الرِّيحِ""","","","","","Book of Drinks"
"16522","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ وَجَدَ قَوْمًا عَلَى شَرَابٍ , وَوَجَدَ مَعَهُمْ سَاقِيًا , فَضَرَبَهُ مَعَهُمْ ""","","","","","Book of Drinks"
"16523","عَنْ عَبْدِ الْقُدُّوسِ ، عَنْ نَافِعٍ , قَالَ : وَجَدَ عُمَرُ فِي بَيْتِ رُوَيْشِدٍ الثَّقَفِيِّ خَمْرًا , فَحَرَّقَ بَيْتَهُ , وَقَالَ : "" مَا اسْمُكَ ؟ "" , قَالَ : رُوَيْشِدٌ , قَالَ : "" بَلْ أَنْتَ فُوَيْسِقٌ ""","","","","","Book of Drinks"
"16524","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :غَرَّبَ عُمَرُ ابْنَ أُمَيَّةَ بْنِ خَلَفٍ فِي الشَّرَابِ إِلَى خَيْبَرَ , فَلَحِقَ بِهِرْقَلَ , فَتَنَصَّرَ ، قَالَ عُمَرُ :  لا أُغَرِّبُ بَعْدَهُ مُسْلِمًا أَبَدًا ""","","","","","Book of Drinks"
"16525","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ , قَالَ : كَانَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ بِالشَّامِ , فَقَالُوا : اقْرَأْ عَلَيْنَا ! فَقَرَأَ سُورَةَ يُوسُفَ , فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : مَا هَكَذَا أُنْزِلَتْ ، فَقَالَ عَبْدُ اللَّهِ : وَيْحَكَ , وَاللَّهِ لَقَدْ قَرَأْتُهَا عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ لِي :  أَحْسَنْتَ "" , فَبَيْنَا هُوَ يُرَاجِعُهُ وَجَدَ مِنْهُ رِيحَ خَمْرٍ ، فَقَالَ عَبْدُ اللَّهِ :أَتَشْرَبُ الرِّجْسَ ، وَتَكْذِبُ بِالْقُرْآنِ ؟ لا أَقُومُ حَتَّى تُجْلَدَ الْحَدَّ , فَجُلِدَ الْحَدُّ""","","","","","Book of Drinks"
"16526","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَطَاءِ بْنِ أَبِي مَرْوَانَ ، عَنْ أَبِيهِ ، أَنَّ عَلِيًّاضَرَبَ النَّجَاشِيَّ الْحَارِثِيَّ الشَّاعِرَ , ثُمَّ حَبَسَهُ ، كَانَ شَرِبَ الْخَمْرَ فِي رَمَضَانَ , فَضَرَبَهُ ثَمَانِينَ جَلْدَةً وَحَبَسَهُ ، ثُمَّ أَخْرَجَهُ مِنَ الْغَدِ , فَجَلَدَهُ عِشْرِينَ ، وَقَالَ :  إِنَّمَا جَلَدْتُكَ هَذِهِ الْعِشْرَينَ لِجُرْأَتِكَ عَلَى اللَّهِ ، وَإِفْطَارِكَ فِي رَمَضَانَ ""","","","","","Book of Drinks"
"16527","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي سِنَانَ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي الْهُذَيْلِ , قَالَ : أُتِيَ عُمَرُبِشَيْخٍ شَرِبَ الْخَمْرَ فِي رَمَضَانَ , فَقَالَ :  لِلْمِنْخَرَيْنِ ! فِي رَمَضَانَ وَوِلْدَانُنَا صِيَامٌ ؟ فَضَرَبَهُ ثَمَانِينَ , وَسَيَّرَهُ إِلَى الشَّامِ ""","","","","","Book of Drinks"
"16528","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ أُمَيَّةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  كَانَإِذَا وَجَدَ شَارِبًا فِي رَمَضَانَ نَفَاهُ مَعَ الْحَدِّ ""","","","","","Book of Drinks"
"16529","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : مَنْ شَرِبَ فِي رَمَضَانَ ، فَإِنْ كَانَ ابْتَدَعَ دِينًا غَيْرَ الإِسْلامِ اسْتُتِيبَ ، وَإِنْ كَانَ فَاسِقًا مِنَ الْفُسَّاقِ جُلِدَ , وَنُكِّلَ , وَطُوِّفَ , وَسُمِعَ بِهِ ، وَالَّذِي يَتْرُكُ الصَّلاةَ مِثْلُ ذَلِكَ ""","","","","","Book of Drinks"
"16530","عَنْ مَعْمَرٍ , قَالَ :  بَلَغَنِي أَنَّهُإِذَا شَرِبَ الرَّجُلُ مُسْكِرًا نُكِّلَ وَعُزِّرَ ""","","","","","Book of Drinks"
"16531","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : شَرِبَ أَخِي عَبْدُ الرَّحْمَنِ بْنُ عُمَرَ ، وَشَرِبَ مَعَهُ أَبُو سِرْوَعَةَ عُقْبَةُ بْنُ الْحَارِثِ ، وَهُمَا بِمِصْرَ فِي خِلافَةِ عُمَرَ , فَسَكِرَا ، فَلَمَّا أَصْبَحَا انْطَلَقَا إِلَى عَمْرِو بْنِ الْعَاصِ ، وَهُوَ أَمِيرُ مِصْرَ "" , فَقَالا : طَهِّرْنَا , فَإِنَّا قَدْ سَكِرْنَا مِنْ شَرَابٍ شَرِبْنَاهُ ، فَقَالَ عَبْدُ اللَّهِ : فَذَكَرَ لِي أَخِي أَنَّهُ سَكِرَ , فَقُلْتُ : ادْخُلِ الدَّارَ أُطَهِّرْكَ ، وَلَمْ أَشْعُرْ أَنَّهُمْ أَتَيَا عَمْروا , فَأَخْبَرَنِي أَخِي أَنَّهُ قَدْ أَخْبَرَ الأَمِيرَ بِذَلِكَ ، فَقَالَ عَبْدُ اللَّهِ : لا يَحْلِقُ الْقَوْمُ عَلَى رُءوسِ النَّاسِ , ادْخُلِ الدَّارَ أَحْلِقْكَ ، وَكَانُوا إِذْ ذَاكَ يَحْلِقُونَ مَعَ الْحُدُودِ فَدَخَلَ الدَّارَ ، فَقَالَ عَبْدُ اللَّهِ : فَحَلَقْتُ أَخِي بِيَدِي ، ثُمَّ جَلَدَهُمْ عَمْرٌو , فَسَمِعَ بِذَلِكَ عُمَرُ , فَكَتَبَ إِلَى عَمْرٍو : "" أَنِ ابْعِثْ إِلَيَّ بِعَبْدِ الرَّحْمَنِ عَلَى قَتَبٍ "" , فَفَعَلَ ذَلِكَ ، فَلَمَّا قَدِمَ عَلَى عُمَرَ : "" جَلَدَهُ ، وَعَاقَبَهُ لِمَكَانِهِ مِنْهُ "" ، ثُمَّ أَرْسَلَهُ , فَلِبَثَ شَهْرًا صَحِيحًا ، ثُمَّ أَصَابَهُ قَدَرُهُ فَمَاتَ , فَيَحْسِبُ عَامَّةُ النَّاسِ أَنَّمَا مَاتَ مِنْ جَلْدِ عُمَرَ , وَلَمْ يَمُتْ مِنْ جَلْدِ عُمَرَ""","","","","","Book of Drinks"
"16532","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، وَعِكْرِمَةَ ، قَالا : قَالَ ابْنُ عَبَّاسٍ : جَعَلَ اللَّهُ حَلْقَ الرَّأْسِ سُنَّةً ، وَنُسُكًا فَجَعَلْتُمُوهُ نَكَالا ، وَزِدْتُمُوهُ فِي الْعُقُوبَةِ ""","","","","","Book of Drinks"
"16533","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي حَيَّانَ ، عَنِ الشَّعْبِيِّ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ : نَزَلَ تَحْرِيمُ الْخَمْرِ , وَهِيَ مِنْ خَمْسٍ : مِنَ التَّمْرِ ، وَالزَّبِيبِ ، وَالْحِنْطَةِ ، وَالشَّعِيرِ ، وَالْعَسَلِ ، وَالْخَمْرِ مَا خَامَرَ الْعَقْلَ "", عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنْ عُمَرَ مِثْلَهُ""","","","","","Book of Drinks"
"16534","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي بُرْدَةَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : الأَشْرِبَةُ مِنْ خَمْسٍ : مِنَ الْحِنْطَةِ ، وَالشَّعِيرِ ، وَالزَّبِيبِ ، وَالتَّمْرِ ، وَالْعَسَلِ ، وَمَا خَمْرَتَهُ فَعَتَّقْتَهُ فَهُوَ خَمْرٌ ""","","","","","Book of Drinks"
"16535","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ أَبِي بَكْرٍ ، عَنْ رَجُلٍ مِنْ أَهْلِ الشَّامِ يُقَالُ لَهُ : عَبْدُ اللَّهِ بْنُ مُحَيْرِيزٍ الْجُمَحِيُّ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : سَيَكُونُ فِي آخِرِ أُمَّتِي نَاسٌ يَسْتَحِلُّونَ الْخَمْرَ بِاسْمٍ يُسَمُّونَهَا إِيَّاهُ ""","","","","","Book of Drinks"
"16536","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ : أَخْبَرَنِي أَبُو كَثِيرٍ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْخَمْرُ مِنْ هَاتَيْنِ الشَّجَرَتَيْنِ : النَّخْلَةِ , وَالْعِنَبَةِ ""","","","","","Book of Drinks"
"16537","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى , عَنْ رَبِيعَةَ ، عَنْ عَطَاءِ بْنِ أَبِي مُسْلِمٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْخَمْرُ مِنَ الْعِنَبِ , وَالسَّكَرُ مِنَ التَّمْرِ ، وَالْمِزْرُ مِنَ الذُّرَةِ ، وَالغُبَيْرَاءُ مِنَ الْحِنْطَةِ ، وَالْبِتْعُ مِنَ الْعَسَلِ ، كُلُّ مُسْكِرٍ حَرَامٌ , وَالْمَكْرُ وَالْخَدِيعَةُ فِي النَّارِ ، وَالْبَيْعُ عَنْ تَرَاضٍ ""","","","","","Book of Drinks"
"16538","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ، عَنِ أَبِي بَكْرِ بْنِ حَفْصٍ ، عَنِ ابْنِ مُحَيْرِيزٍ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَيَشْرَبَنَّ طَائِفَةٌ مِنْ أُمَّتِي الْخَمْرَ بِاسْمٍ يُسَمُّونَهَا إِيَّاهُ ""","","","","","Book of Drinks"
"16539","أَخْبَرَنَا مَعْمَرُ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ شَرِبَ الْخَمْرَ فِي الدُّنْيَا ، ثُمَّ مَاتَ وَهُوَ يَشْرَبُهَا , لَمْ يَتُبْ مِنْهَا , حَرَّمَهَا اللَّهُ عَلَيْهِ فِي الآخِرَةِ "", عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ""","","","","","Book of Drinks"
"16540","أَخْبَرَنَا مَعْمَرُ , قَالَ : حَدَّثَنِي عَطَاءُ بْنُ السَّائِبِ ، عَنْ عَبْدِ اللَّهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ شَرِبَ الْخَمْرَ لَمْ تُقْبَلْ صَلاتُهُ أَرْبَعِينَ لَيْلَةً ، فَإِنْ تَابَ اللَّهُ عَلَيْهِ ، قَالَهَا ثَلاثًا ، فَإِنْ عَادَ كَانَ حَقًّا عَلَى اللَّهِ أَنْ يَسْقِيَهُ مِنْ نَهْرِ الْخَبَالِ "" , قِيلَ : وَمَا نَهْرُ الْخَبَالِ ؟ قَالَ : "" صَدِيدُ أَهْلِ النَّارِ ""","","","","","Book of Drinks"
"16541","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ الْعَزِيزِ بْنَ عَبْدِ اللَّهِ يُحَدِّثُ , عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , أَنَّهُ قَالَ : مَنْ شَرِبَ الْخَمْرَ لَمْ يَقْبَلِ اللَّهُ مِنْهُ صَلاةً أَرْبَعِينَ صَبَاحًا ، فَإِنْ مَاتَ فِي الأَرْبَعِينَ دَخَلَ النَّارَ ، وَلَمْ يَنْظُرِ اللَّهُ إِلَيْهِ ""","","","","","Book of Drinks"
"16542","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ، عَنْ أَبِيهِ , قَالَ : سَمِعْتُ عُثْمَانَ بْنَ عَفَّانَ يَخْطُبُ النَّاسَ ، فَقَالَ : اجْتَنِبُوا الْخَمْرَ , فَإِنَّهَا أُمُّ الْخَبَائِثِ ، إِنَّ رَجُلا مِمَّنْ كَانَ قَبْلَكُمْ كَانَ يَتَعَبَّدُ وَيَعْتَزِلُ النِّسَاءَ , فَعَلِقَتْهُ امْرَأَةٌ غَاوِيَةٌ ، فَأَرْسَلَتْ إِلَيْهِ أَنِّي أُرِيدُ أَنْ أُشْهِدَكَ بِشَهَادَةٍ ، فَانْطَلَقَ مَعَ جَارِيَتِهَا , فَجَعَلَ كُلَّمَا دَخَلَ بَابًا أَغْلَقَتُهُ دُونَهُ , حَتَّى أَفْضَى إِلَى امْرَأَةٍ وَضِيئَةٍ ، وَعِنْدَهَا بَاطِيَةٌ فِيهَا خَمْرٌ "" , فَقَالَتْ : إِنِّي وَاللَّهِ مَا دَعَوْتُكَ لِشَهَادَةٍ , وَلَكِنْ دَعَوْتُكَ لِتَقَعَ عَلَيَّ , أَوْ لِتَشْرَبَ مِنْ هَذَا الْخَمْرَ كَأْسًا , أَوْ لِتَقْتُلَ هَذَا الْغُلامَ ، وَإِلا صِحْتُ بِكَ ، وَفَضَحْتُكَ , فَلَمَّا أَنْ رَأَى أَنْ لَيْسَ بُدٌّ مِنْ بَعْضِ مَا قَالَتْ , قَالَ : "" اسْقِينِي مَنْ هَذَا الْخَمْرَ كَأْسًا , فَسَقَتْهُ "" , فَقَالَ : "" زِيدِينِي كَأْسًا , فَشَرِبَ فَسَكِرَ ، فَقَتَلَ الْغُلامَ , وَوَقَعَ عَلَى الْمَرْأَةِ ، فَاجْتَنِبُوا الْخَمْرَ , فَوَاللَّهِ لا يَجْتَمِعُ الإِيمَانُ ، وَإِدْمَانُ الْخَمْرِ فِي قَلْبِ رَجُلٍ إِلا أَوْشَكَ أَحَدُهُمَا أَنْ يُخْرِجَ صَاحِبَهُ ""","","","","","Book of Drinks"
"16543","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :يَلْقَى اللَّهَ شَارِبُ الْخَمْرَ يَوْمَ القِيَامَةِ حِينَ يَلْقَاهُ ، وَهُوَ سَكْرَانُ , فَيَقُولُ : وَيْلَكَ مَا شَرِبْتَ ؟ فَيَقُولُ : الْخَمْرَ , قَالَ : أَوْ لَمْ أُحَرِّمُهَا عَلَيْكَ ؟ فَيَقُولُ : بَلَى ! فَيُؤْمَرُ بِهِ إِلَى النَّارِ","","","","","Book of Drinks"
"16544","عَنْ مَعْمَرٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ : عَنِ امْرَأَةٍ سَأَلَتْ عَائِشَةَ فِي نِسْوَةٍ عَنِالنَّبِيذِ ، فَقَالَتْ :  قَدْ أَكْثَرْتُنَّ عَلَيَّ ، إِذَا ظَنَّتْ إِحْدَاكُنَّ أَنَّهُ إِذَا نَقَعَتْ كِسْرَتَهَا فِي الْمَاءِ أَنَّ ذَلِكَ يُسْكِرُهَا فَلْتَجْتَنِبْهُ ""","","","","","Book of Drinks"
"16545","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ رَجُلٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ :  إِنَّهُ فِي الْكِتَابِ مَكْتُوبٌ أَنَّخَطِيئَةَ الْخَمْرِ تَعْلُو الْخَطَايَا , كَمَا تَعْلُو شَجَرَتُهَا الشَّجَرَ ""","","","","","Book of Drinks"
"16546","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ لَيْثٍ ، عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ ، عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ , قَالَ : شَارِبُ الْخَمْرِ كَعَابِدِ الْوَثَنِ ، وَشَارِبُ الْخَمْرِ كَعَابِدٍ اللاتَ وَالْعُزَّى ""","","","","","Book of Drinks"
"16547","أَخْبَرَنَا هَمَّامُ ، عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّهُ سَمِعَ ابْنَ جُبَيْرٍ , يَقُولُ : مِنْ شَرِبَ مُسْكِرًا لَمْ يَقْبَلِ اللَّهُ مِنْهُ صَلاةً مَا كَانَ فِيُ مَثَانَتِهِ مِنْهُ قَطْرَةٌ ، فَإِنْ مَاتَ مِنْهَا , كَانَ حَقًّا عَلَى اللَّهِ أَنْ يَسْقِيَهُ مِنْ طِينَةِ الْخَبَالِ ، وَهِيَ صَدِيدُ أَهْلِ النَّارِ وَقَيْحِهِمْ ""","","","","","Book of Drinks"
"16548","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِي ذَرٍّ , قَالَ : مَنْ شَرِبَ مُسْكِرًا مِنَ الشَّرَابِ فَهُوَ رِجْسٌ , وَرِجْسَ صَلاتَهُ أَرْبَعِينَ لَيْلَةٍ ، فَإِنْ تَابَ اللَّهُ عَلَيْهِ ، فَإِنْ عَادَ لَهَا فِي الثَّالِثَةِ أَوِ الرَّابِعَةِ كَانَ حَقًّا عَلَى اللَّهِ أَنْ يَسْقِيَهُ مِنْ طِينَةِ الْخَبَالِ ""","","","","","Book of Drinks"
"16549","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ شَهْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ : لُعِنَتِ الْخَمْرَ ، وَشَارِبُهَا ، وَسَاقِيهَا ، وَعَاصِرُهَا ، وَمُعْتَصِرُهَا ، وَبَائِعُهَا ، وَمُبْتَاعُهَا ، وَآكِلُ ثَمَنِهَا ، وَحَاملُهَا , وَالْمَحْمُولَةُ لَهُ ""","","","","","Book of Drinks"
"16550","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، رَفَعَ الْحَدِيثَ ، قَالَ :  إِنَّالْخَبَائِثَ جُعِلَتْ فِي بَيْتٍ فَأُغْلِقَ عَلَيْهَا , وَجُعِلَ مُفْتَاحَهَا الْخَمْرَ ، فَمَنْ شَرِبَ الْخَمْرَ وَقَعَ بِالْخَبَائِثِ ""","","","","","Book of Drinks"
"16551","عَنْ إِسْرَائِيلَ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ، عَنْ عُبَيْدِ بْنِ عُمَيْرٍ , قَالَ : إنَّ الْخَمْرَ مُفْتَاحُ كُلِّ شَرٍّ ""","","","","","Book of Drinks"
"16552","عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنِ ابْنِ الْمُنْكَدِرِ , عَنِ ابْنِ عَبَّاسٍ ، إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ مَاتَ مُدْمِنَ خَمْرٍ , لَقِيَ اللَّهَ ، وَهُوَ عَلَيْهِ غَضْبَانُ ، وَهُوَ كَعَابِدِ وَثَنٍ ""","","","","","Book of Drinks"
"16553","عَنِ ابْنِ أَبِي يَحْيَى ، عَنِ ابْنِ الْمُنْكَدِرِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ شَرِبَ الْخَمْرَ صَبَاحًا كَانَ كَالْمُشْرِكِ بِاللَّهِ حَتَّى يُمْسِي ، وَكَذَلِكَ إنْ شَرِبَهَا لَيْلا حَتَّى يُصْبِحَ ، وَمَنْ شَرِبَهَا حَتَّى يَسْكَرَ لَمْ يَقْبَلِ اللَّهُ لَهُ صَلاةً أَرْبَعِينَ صَبَاحًا ، وَمَنْ مَاتَ وَفِي عُرُوقِهِ مِنْهَا شَيْءٌ مَاتَ مِيتَةَ جَاهِلِيَّةٍ ""","","","","","Book of Drinks"
"16554","أَخْبَرَنَا عُمَرُ بْنُ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : حَلَفَ اللَّهُ بِعِزَّتِهِ وَقُدْرَتِهِ لا يَشْرَبُ عَبْدٌ مُسْلِمٌ شَرْبَةً مِنْ خَمْرٍ ، إِلا سَقَيْتُهُ بِمَا انْتَهَكَ مِنْهَا مِنَ الْحَمِيمِ ، مُعَذِّبٌ لَهُ ، أَوْ مَغْفُورٌ لَهُ ، وَلا يَتْرُكُهَا وَهُوَ عَلَيْهَا قَادِرٌ ابْتِغَاءَ مَرْضَاتِي إِلا سَقَيْتُهُ مِنْهَا ، فَأَرْوَيْتُهُ فِي حَظِيرَةِ الْقُدُسِ ""","","","","","Book of Drinks"
"16555","عَنِ الثَّوْرِيِّ ، عَنْ شَدَّادِ بْنِ أَبِي الْعَالِيَةِ ، عَنْ أَبِي دَاوُدَ الأَحْمَرِيِّ , قَالَ :  خَطَبَنَا حُذَيْفَةُ بِالْمَدَائِنِ , فَقَالَ : يَا أَيُّهَا النَّاسُ ,تَفَقَّدُوا أَرِقَّاءَكُمْ , وَاعْلَمُوا مِنْ أَيْنَ يَأْتُونَكُمْ بِضَرَائِبِهِمْ , فَإِنَّ لَحْمًا نَبَتَ مِنْ سُحْتٍ لَنْ يَدْخُلُ الْجَنَّةَ أَبَدًا ، وَاعْلَمُوا إِنَّ بَائِعَ الْخَمْرِ ، وَمُبْتَاعَهُ ، وَسَاقِيَهُ ، وَمُسْقِيَهُ , كَشَارِبِهِ ، وَاعْلَمُوا إِنَّ بَائِعَ الْخِنْزِيرِ ، وَمُبْتَاعَهُ ، وَمُقْتَنِيهِ , كَآكِلِهِ ""","","","","","Book of Drinks"
"16556","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ لَيْثِ بْنِ أَبِي سُلَيْمٍ , قَالَ : حَدَّثَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ , قَالَ : يَجِيءُ يَوْمَ القِيَامَةِ شَارِبُ الْخَمْرِ مُسْوَدًا وَجْهُهُ , مُزْرَقَةٌ عَيْنَاهُ , مَائِلٌ شِقُّهُ "" , أَوْ قَالَ : "" شِدْقُهُ مُدْلِيًا لِسَانُهُ , يَسِيلُ لُعَابُهُ عَلَى صَدْرِهِ , يَقْذُرُهُ كُلُّ مَنْ يَرَاهُ ""","","","","","Book of Drinks"
"16557","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ أَيُّوبَ بْنَ أَبِي تَمِيمَةَ ، يَقُولُ : لَمْ يُحَدَّ فِي الْخَمْرِ أَحَدٌ مِنْ أَهْلِ بَدْرٍ إِلا قُدَامَةُ بْنُ مَظْعُونٍ ""","","","","","Book of Drinks"
"16558","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عَامِرِ بْنِ رَبِيعَةَ ، وَكَانَ أَبُوهُ شَهِدَ بَدْرًا : إِنَّ عُمَرَ بْنَ الْخَطَّابِ ، اسْتَعْمَلَ قُدَامَةَ بْنَ مَظْعُونٍ عَلَى الْبَحْرَيْنِ , وَهُوَ خَالُ حَفْصَةَ , وَعَبْدِ اللَّهِ بْنِ عُمَرَ , فَقَدِمَ الْجَارُودُ سَيِّدُ عَبْدِ الْقَيْسِ عَلَى عُمَرَ مِنَ الْبَحْرَيْنِ , فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ , إِنَّ قُدَامَةَ شَرِبَ فَسَكِرَ ، وَلَقَدْ رَأَيْتُ حَدًّا مِنْ حِدُودِ اللَّهِ , حَقًّا عَلَيَّ أَنْ أَرْفَعَهُ إِلَيْكَ , فَقَالَ عُمَرُ : "" مَنْ يَشْهَدُ مَعَكَ "" , قَالَ : أَبُو هُرَيْرَةَ , فَدَعَا أَبَا هُرَيْرَةَ , فَقَالَ : بِمَ أَشْهَدُ ؟ قَالَ : لَمْ أَرَهُ يَشْرَبُ , وَلَكِنِّي رَأَيْتُهُ سَكْرَانَ , فَقَالَ عُمَرُ : "" لَقَدْ تَنَطَّعْتَ فِي الشَّهَادَةِ , قَالَ : ثُمَّ كَتَبَ إِلَى قُدَامَةَ أَنْ يَقْدِمَ إِلَيْهِ مِنَ الْبَحْرَيْنِ , فَقَالَ الْجَارُودُ لِعُمَرَ : أَقِمْ عَلَى هَذَا كِتَابَ اللَّهِ عَزَّ وَجَلَّ , فَقَالَ عُمَرُ : "" أَخَصْمٌ أَنْتَ أَمْ شَهِيدٌ ؟ "" , قَالَ : بَلْ شَهِيدٌ , قَالَ : "" فَقَدْ أَدَّيْتَ شَهَادَتَكَ "" , قَالَ : فَقَدْ صَمَتَ الْجَارُودُ حَتَّى غَدَا عَلَى عُمَرَ , فَقَالَ : أَقِمْ عَلَى هَذَا حَدَّ اللَّهِ , فَقَالَ عُمَرُ : "" مَا أَرَاكَ إِلا خَصْمًا ، وَمَا شَهِدَ مَعَكَ إِلا رَجُلٌ "" , فَقَالَ الْجَارُودُ : إِنِّي أُنْشِدُكَ اللَّهَ ، فَقَالَ عُمَرُ : "" لَتُمْسِكَنَّ لِسَانَكَ , أَوْ لأسُوءَنَّكَ "" , فَقَالَ الْجَارُودُ : أَمَّا وَاللَّهِ مَا ذَاكَ بِالْحَقِّ أَنْ شَرِبَ ابْنُ عَمِّكَ وَتَسُوءُنِي ، فَقَالَ أَبُو هُرَيْرَةَ : إِنْ كُنْتَ تَشُكَّ فِي شَهَادَتِنَا فَأَرْسَلَ إِلَى ابْنَةِ الْوَلِيدِ فَسَلْهَا ، وَهِيَ امْرَأَةُ قُدَامَةَ , فَأَرْسَلَ عُمَرُ إِلَى هِنْدَ ابْنَةِ الْوَلِيدِ يَنْشُدُهَا , فَأَقَامَتِ الشَّهَادَةَ عَلَى زَوْجِهَا , فَقَالَ عُمَرُ لِقُدَامَةَ : "" إِنِّي حَادُّكَ "" , فَقَالَ : لَوْ شَرِبْتَ كَمَا يَقُولُونَ مَا كَانَ لَكُمْ أَنْ تَجْلُدُونِي ، فَقَالَ عُمَرُ : "" لِمَ ؟ "" , قَالَ قُدَامَةُ : قَالَ اللَّهُ تَعَالَى :  لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا إِذَا مَا اتَّقَوْا وَآمَنُوا الآيَةُ , فَقَالَ عُمَرُ : "" أَخْطَأْتَ التَّأْوِيلَ , إِنَّكَ إِذَا اتَّقَيْتَ اجْتَنَبْتَ مَا حَرَّمَ اللَّهُ عَلَيْكَ "" , قَالَ : ثُمَّ أَقْبَلَ عُمَرُ عَلَى النَّاسِ , فَقَالَ : "" مَاذَا تَرَوْنَ فِي جَلْدِ قُدَامَةَ ؟ "" , قَالُوا : لا نَرَى أَنْ تَجْلِدَهُ مَا كَانَ مَرِيضًا ، فَسَكَتَ عَنْ ذَلِكَ أَيَّامًا , وَأَصْبَحَ يَوْمًا وَقَدْ عَزَمَ عَلَى جَلْدِهِ , فَقَالَ لأَصْحَابِهِ : "" مَاذَا تَرَوْنَ فِي جَلْدِ قُدَامَةَ ؟ "" , قَالُوا : لا نَرَى أَنْ تَجْلِدَهُ مَا كَانَ ضَعِيفًا , فَقَالَ عُمَرُ : "" لأَنْ يَلْقَى اللَّهَ تَحْتَ السِّيَاطِ أَحَبُّ إِلَيَّ مِنْ أَنْ يَلْقَاهُ وَهُوَ فِي عُنُقِي , ائْتُونِي بِسَوْطٍ تَامٍّ "" , فَأَمَرَ بِقُدَامَةَ فَجُلِدَ , فَغَاضَبَ عُمَرُ قُدَامَةَ , وَهَجَرَهُ , فَحَجَّ وَقُدَامَةُ مَعَهُ مُغَاضِبًا لَهُ ، فَلَمَّا قَفَلا مِنْ حَجِّهِمَا ، وَنَزَلَ عُمَرُ بِالسُّقْيَا , نَامَ ، ثُمَّ اسْتَيْقَظَ مِنْ نَوْمِهِ , قَالَ : "" عَجِّلُوا عَلَيَّ بِقُدَامَةَ فَائْتُونِي بِهِ , فَوَاللَّهِ إِنِّي لأَرَى آتٍ أَتَانِي "" , فَقَالَ سَالِمْ : قُدَامَةَ فَإِنَّهُ أَخُوكَ , فَعَجِّلُوا إِلَيَّ بِهِ , فَلَمَّا أَتَوْهُ أَبَى أَنْ يَأْتِيَ ، فَأَمَرَ بِهِ عُمَرُ إِنْ أَبَى إِنْ يَجُرُّوهُ إِلَيْهِ , فَكَلَّمَهُ عُمَرُ , وَاسْتَغْفَرَ لَهُ , فَكَانَ ذَلِكَ أَوَّلَ صُلْحِهِمَا""","","","","","Book of Drinks"
"16559","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : كَانَ أَبُو مِحْجَنٍ لا يَزَالُ يُجْلَدُ فِي الْخَمْرِ ، فَلَمَّا أَكْثَرَ عَلَيْهِمْ سَجَنُوهُ , وَأَوْثَقُوهُ ، فَلَمَّا كَانَ يَوْمُ الْقَادِسِيَّةِ رَآهُمْ يَقْتَتِلُونَ ، فَكَأَنَّهُ رَأَى الْمُشْرِكِينَ وَقَدْ أَصَابُوا فِي الْمُسْلِمِينَ , فَأَرْسَلَ إِلَى أُمِّ وَلَدِ سَعْدٍ , أَوْ إِلَى امْرَأَةِ سَعْدٍ , يَقُولُ لَهَا : إِنَّ أَبَا مِحْجَنٍ ، يَقُولُ لَكِ : "" إِنْ خَلَّيْتِ سَبِيلَهُ , وَحَمَلْتِيهِ عَلَى هَذَا الْفَرَسِ ، وَدَفَعْتِ إِلَيْهِ سِلاحًا , لَيَكُونَنَّ أَوَّلَ مَنْ يَرْجِعُ , إِلا أَنْ يَقْتُلَ "" ، وَقَالَ أَبُو مِحْجَنٍ يَتَمَثَّلَ : كَفَى حُزْنًا إِنْ تَلْتَقِيَ الْخَيْلُ بِالْقِنَا وَأُتْرَكَ مَشْدُودًا عَلَيَّ وَثَاقِيَا إِذَا شِئْتُ عَنَّانِي الْحَدِيدُ وَغُلِّقَتْ مَصَارِيعُ مَنْ دُونِي تُصَمَّ الْمُنَادِيَا ، فَذَهَبَتِ الأُخْرَى ، فَقَالَتْ ذَلِكَ لامْرَأَةِ سَعْدٍ ، فَحَلَّتْ عَنْهُ قُيُودَهُ ، وَحُمِلَ عَلَى فَرَسٍ كَانَ فِي الدَّارِ , وَأُعْطِيَ سِلاحًا ، ثُمَّ جَعَلَ يَرْكُضُ حَتَّى لَحِقَ بِالْقَوْمِ ، فَجَعَلَ لا يَزَالُ يَحْمِلُ عَلَى رَجُلٍ فَيَقْتُلُهُ ، وَيَدُقُّ صُلْبَهُ ، فَنَظَرَ إِلَيْهِ سَعْدٌ ، فَتَعَجَّبَ ، وَقَالَ : "" مَنْ هَذَا الْفَارِسُ ؟ "" , قَالَ : "" فَلَمْ يَلْبَثُوا إِلا يَسِيرًا حَتَّى هَزَمَهُمُ اللَّهُ "" , فَرَجَعَ أَبُو مِحْجَنٍ وَرَدَّ السِّلاحَ ، وَجَعَلَ رِجْلَيْهِ فِي الْقُيُودِ كَمَا كَانَ ، فَجَاءَ سَعْدٌ ، فَقَالَتْ لَهُ امْرَأَتُهُ , أَوْ أُمُّ وَلَدِهِ : كَيْفَ كَانَ قِتَالُكُمْ ؟ فَجَعَلَ يُخْبِرُهَا وَيَقُولُ : لَقِينَا وَلَقِينَا حَتَّى بَعَثَ اللَّهُ رَجُلا عَلَى فَرَسٍ أَبْلَقَ ، لَوْلا أَنِّي تَرَكْتُ أَبَا مِحْجَنٍ فِي الْقُيُودِ لَظَنَنْتُ أَنَّهَا بَعْضُ شَمَائِلِ أَبِي مِحْجَنٍ ، فَقَالَتْ : وَاللَّهِ إِنَّهُ لأَبُو مِحْجَنٍ ، كَانَ مِنْ أَمْرِهِ كَذَا وَكَذَا ، فَقَصَّتْ عَلَيْهِ الْقِصَّةُ , قَالَ : فَدَعَا بِهِ وَحَلَّ عَنْهُ قُيُودَهُ ، وَقَالَ : "" لا نَجْلِدُكَ فِي الْخَمْرِ أَبَدًا "" ، قَالَ أَبُو مِحْجَنٍ : وَأَنَا وَاللَّهِ لا تَدْخُلُ فِي رَأْسِي أَبَدًا ، إِنَّمَا كُنْتُ آنَفُ أَنْ أَدَعَهَا مِنْ أَجْلِ جَلْدِكَ , قَالَ : فَلَمْ يَشْرَبْهَا بَعْدَ ذَلِكَ""","","","","","Book of Drinks"
"16560","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ إِنَّ أَبَا عُبَيْدَةَ بِالشَّامِوَجَدَ أَبَا جَنْدَلَ بْنَ سُهَيْلِ بْنِ عَمْرِو , وَضِرَارَ بْنَ الْخَطَّابِ الْمُحَارِبِيَّ ، وَأَبَا الأَزْوَرِ , وَهُمْ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْ شَرِبُوا ، فَقَالَ أَبُو جَنْدَلٍ :   لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا إِذَا مَا اتَّقَوْا وَآمَنُوا وَعَمِلُوا الصَّالِحَاتِ , الآيَةَ , فَكَتَبَ أَبُو عُبَيْدَةَ , إِلَى عُمَرَ , إِنَّ أَبَا جَنْدَلٍ خَصَمَنِي بِهَذِهِ الآيَةِ , فَكَتَبَ عُمَرُ : "" إِنَّ الَّذِي زَيَّنَ لأَبِي جَنْدَلٍ الْخَطِيئَةَ زَيَّنَ لَهُ الْخُصُومَةَ , فَاحْدُدْهُمْ "" , فَقَالَ أَبُو الأَزْوَرِ : أَتَحُدُّونَا ؟ فَقَالَ أَبُو عُبَيْدَةَ : نَعَمْ , قَالَ : فَدَعُونَا نَلْقَى الْعَدُوَّ غَدًا , فَإِنْ قُتِلْنَا فَذَاكَ ، وَإِنْ رَجَعْنَا إِلَيْكُمْ فَحُدُّونَا , قَالَ : فَلَقِي أَبُو جَنْدَلٍ , وَضِرَارٌ , وَأَبُو الأَزْوَرِ , الْعَدُوَّ , فَاسْتُشْهِدَ أَبُو الأَزْوَرِ وَحُدَّ الآخَرَانِ , قَالَ : فَقَالَ أَبُو جَنْدَلٍ : هَلَكْتُ , فَكَتَبَ بِذَلِكَ أَبُو عُبَيْدَةَ إِلَى عُمَرَ , فَكَتَبَ إِلَى أَبِي جَنْدَلٍ وَتَرَكَ أَبَا عُبَيْدَةَ : "" إِنَّ الَّذِي زَيَّنَ لَكَ الْخَطِيئَةَ حَظَرَ عَلَيْكَ التَّوْبَةَ :  حم { 1 } تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْعَلِيمِ { 2 } غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ , الآيَةَ ""","","","","","Book of Drinks"
"16561","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : سَمِعْتُ مَكْحُوَلا ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ شَرِبَ الْخَمْرَ فَاضْرِبُوهُ "" , ثُمَّ قَالَ : "" مَنْ شَرِبَ الْخَمْرَ فَاضْرِبُوهُ "" , ثُمَّ قَالَ فِي الرَّابِعَةِ : "" مِنْ شَرِبَ الْخَمْرَ فَاقْتُلُوهُ ""","","","","","Book of Drinks"
"16562","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , قَالَ : سَمِعْتُ عَمْرَو بْنَ شُعَيْبٍ يُحَدِّثُ , إِنَّ أَبَا مُوسَى الأَشْعَرِيَّ ، حِينَ بَعَثَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى الْيَمَنِ سَأَلَهُ , قَالَ : إِنَّ قَوْمِي يَصْنَعُونَ شَرَابًا مِنَ الذُّرَةِ ، يُقَالُ لَهُ : الْمِزْرُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَيُسْكِرُ ؟ "" , قَالَ : نَعَمْ , قَالَ : "" فَانْهَهُمْ عَنْهُ "" , قَالَ : قَدْ نَهَيْتُهُمْ فَلَمْ يَنْتَهُوا , قَالَ : "" فَمَنْ لَمْ يَنْتَهِ فِي الثَّالِثَةِ فَاقْتُلْهُ ""","","","","","Book of Drinks"
"16563","عَنْ مَعْمَرٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا شَرِبُوا فَاجْلِدُوهُمْ "" , قَالَهَا ثَلاثًا , قَالَ : "" فَإِذَا شَرِبُوا الرَّابِعَةَ فَاقْتُلُوهُمْ "", قَالَ مَعْمَرٌ : فَذَكَرْتُ ذَلِكَ لابْنِ الْمُنْكَدِرِ , فَقَالَ : قَدْ تُرِكَ الْقَتْلُ , قَدْ أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِابْنِ النُّعَيْمَانِ فَجَلَدَهُ ، ثُمَّ أُتِيَ بِهِ فَجَلَدَهُ ، ثُمَّ أُتِيَ بِهِ فَجَلَدَهُ ، ثُمَّ أُتِيَ بِهِ الرَّابِعَةَ فَجَلَدَهُ , أَوْ أَكْثَرَ""","","","","","Book of Drinks"
"16564","عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ , قَالَ : أُتِيَ بِابْنِ النُّعَيْمَانِ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَفَجَلَدَهُ ، ثُمَّ أُتِيَ بِهِ فَجَلَدَهُ , قَالَ : مِرَارًا أَرْبَعًا , أَوْ خَمْسًا , فَقَالَ رَجُلٌ : اللَّهُمَّ الْعَنْهُ ، مَا أَكْثَرُ مَا يَشْرَبُ ، وَمَا أَكْثَرُ مَا يُجْلَدُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لا تَلْعَنْهُ , فَإِنَّهُ يُحِبُّ اللَّهَ وَرَسُولَهُ ""","","","","","Book of Drinks"
"16565","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا شَرِبُوا فَاجْلِدُوهُمْ ، ثُمَّ إِذَا شَرِبُوا فَاجْلِدُوهُمْ ، ثُمَّ إِذَا شَرِبُوا فَاجْلِدُوهُمْ ، ثُمَّ إِذَا شَرِبُوا فَاقْتُلُوهُمْ ، ثُمَّ قَالَ : "" إِنَّ اللَّهَ قَدْ وَضَعَ عَنْهُمُ الْقَتْلَ ، فَإِذَا شَرِبُوا فَاجْلِدُوهُمْ ، ثُمَّ إِذَا شَرِبُوا فَاجْلِدُوهُمْ "", ذَكَرَهَا أَرْبَعَ مَرَّاتٍ""","","","","","Book of Drinks"
"16566","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنِ الزُّهْرِيِّ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَجَلَدَ رَجُلا فِي الْخَمْرَ ثَلاثَ مَرَّاتٍ ، ثُمَّ أُتِيَ بِهِ الرَّابِعَةَ فَضَرَبَهُ أَيْضًا , لَمْ يَزِدْ عَلَى ذَلِكَ","","","","","Book of Drinks"
"16567","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :مَنْ شَرِبَ الْخَمْرَ فَحُدُّوهُ , فَإِنْ شَرِبَ الثَّانِيَةَ فَحُدُّوهُ , فَإِنْ شَرِبَ الثَّالِثَةَ فَحُدُّوهُ , فَإِنْ شَرِبَ الرَّابِعَةَ فَاقْتُلُوهُ , قَالَ : فَأُتِيَ بِابْنِ النُّعَيْمَانِ قَدْ شَرِبَ , فَضُرِبَ بِالنِّعَالِ وَالأَيْدِي ، ثُمَّ أُتِيَ بِهِ الثَّانِيَةَ فَكَذَلِكَ ، ثُمَّ أُتِيَ بِهِ الثَّالِثَةَ فَكَذَلِكَ ، ثُمَّ أُتِيَ بِهِ الرَّابِعَةَ فَحَدَّهُ , وَوَضَعَ الْقَتْلَ","","","","","Book of Drinks"
"16568","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ضَرَبَ رَجُلا فِي الْخَمْرِ أَرْبَعَ مَرَّاتٍ "", ثُمَّ إِنَّ عُمَرَ بْنَ الْخَطَّابِ ضَرَبَ أَبَا مِحْجَنٍ الثَّقَفِي فِي الْخَمْرِ ثَمَانِ مَرَّاتٍ ، وَأَمَّا ابْنُ جُرَيْجٍ ، فَقَالَ : بَلَغَنِي إِنَّ عُمَرَ بْنَ الْخَطَّابِ جَلَدَ أَبَا مِحْجَنِ بْنَ حَبِيبِ بْنِ عَمْرِو بْنِ عُمَيْرٍ الثَّقَفِيَّ فِي الْخَمْرِ سَبْعَ مَرَّاتٍ""","","","","","Book of Drinks"
"16569","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ ، عَنْ ذَكْوَانَ ، عَنْ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ : مَنْ شَرِبَ الْخَمْرَ فَاجْلِدُوهُ , قَالَهَا ثَلاثًا , قَالَ : فَإِنْ شَرِبَهَا أَرْبَعَ مَرَّاتٍ فَاقْتُلُوهُ ""","","","","","Book of Drinks"
"16570","عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ رُفَيْعٍ ، عَنْ حَرَامِ بْنِ مُعَاوِيَةَ , قَالَ : كَتَبَ إِلَيْنَا عُمَرُ بْنُ الْخَطَّابِ لا يُجَاوِرَنَّكُمْ خِنْزِيرٌ ، وَلا يُرْفَعُ فِيكُمْ صَلِيبٌ ، وَلا تَأْكُلُوا عَلَى مَائِدَةٍ يُشْرَبُ عَلَيْهَا الْخَمْرُ ، وَأَدِّبُوا الْخَيْلَ ، وَامْشُوا بَيْنَ الْغَرَضَيْنِ ""","","","","","Book of Drinks"
"16571","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَبْدِ اللَّهِ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدٍ مَوْلَى أَسْلَمَ أَخْبَرَهُ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا يَحِلُّ لأَحَدٍ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الآخَرِ أَنْ يَجْلِسَ عَلَى مَائِدَةٍ يُشْرَبُ عَلَيْهَا الْخَمْرُ ، وَلا يَحِلُّ لأَحَدٍ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الآخَرِ أَنْ يَتَخَلَّفَ عَنِ الْجُمُعَةِ "", قَالَ عَبْدُ الرَّزَّاقِ : وَسَمِعْتُهُ عَنِ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ بِهَذَا الإِسْنَادِ""","","","","","Book of Drinks"
"16572","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ عِمْرَانَ بْنِ حُدَيْرٍ , قَالَ : صَنَعَ أَبُو مِجْلَزٍ طَعَامًا وَدَعَا عَلَيْهِ أَصْحَابَهُ ، فَاسْتَسْقَى رَجُلٌ مِنْهُمْ , فَأُتِيَ بِشَرَابٍ ، فَشَرِبَ , ثُمَّ جَعَلَ يُنَاوِلُهُ الَّذِي عَنْ يَمِينِهِ , قَالَ : فَقَالَ أَبُو مِجْلَزٍ : لا تُدِرْهُ مِثْلَ الْكَأْسِ , دَعْهُ , فَمَنْ أَحَبَّ أَنْ يَشْرَبَ فَلْيَدْعُ بِهِ ""","","","","","Book of Drinks"
"16573","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَتَمْتَشِطُ الْمَرْأَةُ بِالسُّكْرِ , قَالَ : لا ""، وَقَالَ عَبْدُ الْكَرِيمِ : "" لا "" , وَقَالَ عَمْرُو بْنُ دِينَارٍ : "" لا تَمْتَشِطُ الْمَرْأَةُ بِالْخَمْرِ ""","","","","","Book of Drinks"
"16574","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ :  كَانَتْ عَائِشَةُتَنَهَى إِنْ تَمْتَشِطَ الْمَرْأَةُ بِالْمُسْكِرِ ""","","","","","Book of Drinks"
"16575","عَنْ مَعْمَرٍ , قَالَ : سُئِلَ عِكْرِمَةُأَتَمْتَشِطُ الْمَرْأَةُ بِالْمُسْكِرِ ؟ قَالَ :  لا تَمْتَشِطُ بِمَعْصِيَةِ اللَّهِ ""","","","","","Book of Drinks"
"16576","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ الْمَدِينِيِّ ، عَنْ نَافِعٍ ، قَالَ : قِيلَ لابْنِ عُمَرَ : إِنَّالنِّسَاءَ يَمْتَشِطْنَ بِالْخَمْرِ ، فَقَالَ ابْنُ عُمَرَ :  أَلْقَى اللَّهُ فِي رُءُوسِهِنَّ الْحَاصَّةَ ""","","","","","Book of Drinks"
"16577","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ حُذَيْفَةَ ، قَالَ : ذُكِرَ نِسَاءٌ يَمْتَشِطْنَ بِالْخَمْرِ ، فَقَالَ : لا طَيَّبَهُنَّ اللَّهُ ""","","","","","Book of Drinks"
"16578","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ ،وَجَدَ فِي بَيْتِهِ رِيحَ السَّوْسَنِ , فَقَالَ :  أَخْرِجُوهُ , رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ ""","","","","","Book of Drinks"
"16579","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، عَنْ عَبْدِ اللَّهِ :  أنَّاللَّهَ لَمْ يَجْعَلْ شِفَاءَكُمْ فِيمَا حَرَّمَ عَلَيْكُمْ "", عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ نَحْوَهُ , قَالَ مَعْمَرٌ : وَالسَّكَرُ يَكُونُ مِنَ التَّمْرَةِ يُخْلَطُ مَعَهُ شَيْءٌ""","","","","","Book of Drinks"
"16580","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ  أَنَّ عَائِشَةَ كَانَتْتَنَهَى عَنِ الدَّوَاءِ بِالْخَمْرِ ""","","","","","Book of Drinks"
"16581","عَنْ عَبْدِ اللَّهِ ، عَنْ شُعْبَةَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ عَلْقَمَةَ بْنِ وَائِلٍ الْحَضْرَمِيِّ ، عَنْ أَبِيهِ أَنَّ رَجُلا يُقَالُ لَهُ : سُوَيْدُ بْنُ طَارِقٍ سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِالْخَمْرِ , فَنَهَاهُ عَنْهَا , فَقَالَ : إِنَّمَا أَصْنَعُهَا لِلدَّوَاءِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهَا دَاءً لَيْسَتْ بِدَوَاءٍ "", عَنْ إِسْرَائِيلَ ، عَنْ سِمَاكٍ ، بِهَذَا الإِسْنَادِ مِثْلَهُ""","","","","","Book of Drinks"
"16582","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، قَالَ : قَالَ ابْنُ مَسْعُودٍ : لا تَسْقُوا أَوْلادَكُمُ الْخَمْرَ ، فَإِنَّ أَوْلادَكُمْ وُلِدُوا عَلَى الْفِطْرَةِ , أَتَسْقُونَهُمْ مِمَّا لا عِلْمَ لَهُمْ بِهِ ، إِنَّمَا إِثْمُهُمْ عَلَى مَنْ سَقَاهُمْ , إِنَّ اللَّهَ تَعَالَى لَمْ يَجْعَلْ شِفَاءَكُمْ فِيمَا حَرَّمَ عَلَيْكُمْ ""","","","","","Book of Drinks"
"16583","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ الْمَدِينِيِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّغُلامًا لَهُ سَقَى بَعِيرًا لَهُ خَمْرًا فَتَوَاعَدَهُ ""","","","","","Book of Drinks"
"16584","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ :  ذُكِرَ لَهُغُلامٌ لَهُ نَاقَةٌ رِجْلُهُ أَنَّهَا انْكَسَرَتْ , فَنُعِتَ لَهَا الْخَمْرُ ، فَقَالَ ابْنُ عُمَرَ : "" لَعَلَّكَ سَقَيْتَهَا "" , قَالَ : لا , قَالَ : "" لَوْ فَعَلْتَ أَوْجَعْتُكَ ضَرْبًا ""","","","","","Book of Drinks"
"16585","عَنِ الثَّوْرِيِّ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ  أَنَّ عُمَرَ كَانَيَكْرَهُ أَنْ يُدَاوِيَ دُبُرَ دَابَّتِهِ بِالْخَمْرِ ""","","","","","Book of Drinks"
"16586","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانُوايَكْرَهُونَ أَنْ يَسْقُوا دَوَابَّهُمُ الْخَمْرَ ، وَأَنْ يَتَدَلَّكُوا بِدَرْدَيِّ الْخَمْرِ "", قَالَ الثَّوْرِيُّ : يُفْطِرُ الَّذِي يَحْتَقِنُ بِالْخَمْرِ , وَلا يُضْرَبُ الْحَدَّ , وَإِنِ اصْطَبَغَ رَجُلٌ بِخَمْرٍ فَلَيْسَ عَلَيْهِ حَدٌّ وَلَكِنْ تَعْزِيرٌ""","","","","","Book of Drinks"
"16587","عَنْ مَعْمَرٍ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ , قَالَ : حُدِّثْتُنِي امْرَأَةٌ يُقَالُ لَهَا أُمُّ حِرَاشٍ , أَنَّهَا رَأَتْ عَلِيًّا يَصْطَبِغُ بِخَلِّ خَمْرٍ ""","","","","","Book of Drinks"
"16588","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ التَّيْمِيِّ ، عَنِ امْرَأَةٍ يُقَالُ لَهَا أُمُّ حِرَاشٍ , قَالَتْ :  رَأَيْتُ عَلِيًّاأَخَذَ خُبْزًا مِنْ سَلَّةٍ فَاصْطَبَغَ بِخَلِّ خَمْرٍ ""","","","","","Book of Drinks"
"16589","عَنْ سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ التَّنُّوخِيِّ ، عَنْ عَطِيَّةَ بْنِ قَيْسٍ , قَالَ : مَرَّ رَجُلٌ مِنْ أَصْحَابِ أَبِي الدَّرْدَاءِ , وَرَجُلٌ يَتَغَدَّى , فَدَعَاهُ إِلَى طَعَامِهِ , فَقَالَ : وَمَا طَعَامُكَ ؟ قَالَ : خُبْزٌ وَمُرِيٌّ وَزَيْتٌ , قَالَ :الْمُرِيٌّ الَّذِي يُصْنَعُ مِنَ الْخَمْرِ ؟ قَالَ : نَعَمْ , قَالَ : هُوَ خَمْرٌ , فَتَوَاعَدَا إِلَى أَبِي الدَّرْدَاءِ ، فَسَأَلاهُ ، فَقَالَ :  ذَبَحَتْ خَمْرَهَا الشَّمْسُ ، وَالْمَلْحُ ، وَالْحِيتَانُ "" , يَقُولُ : "" لا بَأْسَ بِهِ ""","","","","","Book of Drinks"
"16590","عَنْ عَبْدِ الْقُدُّوسِ ، أَنَّهُ سَمِعَ مَكْحُوَلا , يَقُولُ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لا يَحِلُّ خَلٌّ مِنْ خَمْرٍ أُفْسِدَتْ , حَتَّى يَكُونَ اللَّهُ هُوَ الَّذِي أَفَسَدَهَا "". عَنِ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ ، وَغَيْرِهِ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنِ ابْنِ شِهَابٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ أَسْلَمَ مَوْلَى عُمَرَ ، عَنْ عُمَرَ مِثْلَهُ , عَنْ عَبْدِ الْوَهَّابِ , قَالَ : سَمِعْتُهُ مِنِ ابْنِ أَبِي ذِئْبٍ""","","","","","Book of Drinks"
"16591","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَيُجْعَلُ الْخَمْرُ خَلا ؟ قَالَ : نَعَمْ ""، وَقَالَ لِي : ذَلِكَ عَمْرُو بْنُ دِينَارٍ مِثْلَهُ""","","","","","Book of Drinks"
"16592","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ , قَالَ : رَأَيْتُ ابْنَ سِيرِينَ اصْطَنَعَ خَلَّ خَمْرٍ "" , أَوْ قَالَ : "" حَسَا خَلَّ خَمْرٍ ""","","","","","Book of Drinks"
"16593","عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ رُفَيْعٍ ، عَنْ مَعْبَدٍ الْجُهَنِيَّ , قَالَ :  سَأَلَهُ رَجُلٌ عَنِالرُّبِّ يُجْعَلُ نَبِيذًا "" , فَقَالَ : "" أَحْيَيَتَهَا بَعْدَمَا كَانَتْ قَدْ مَاتَتْ ""","","","","","Book of Drinks"
"16594","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ أَسْلَمَ مَوْلَى عُمَرَ , قَالَ : قَدِمْنَا الْجَابِيَةَ مَعَ عُمَرَ ،فَأُتِينَا بِطِلاءٍ وَهُوَ مِثْلُ عَقِيدِ الرُّبِّ ، إِنَّمَا يُخَاضُ بِالْمِخْوَضِ , فَقَالَ عُمَرُ :  إِنَّ فِي هَذَا الشَّرَابِ مَا انْتَهَى إِلَيْهِ ""","","","","","Book of Drinks"
"16595","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ عَامِرِ بْنِ شَقِيقِ ، عَنْ شَقِيقِ بْنِ سَلَمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، رَزَقَهُمُ الطِّلاءَ , فَسَأَلَهُ رَجُلٌ عَنِ الطِّلاءِ , فَقَالَ :  كَانَ عُمَرُرَزَقَنَا الطِّلاءُ نَجْدَحُهُ فِي سُوَيْقِنَا ، وَنَأْكُلُهُ بَأُدْمِنَا ، وَخُبْزِنَا , لَيْسَ بِبَاذَقِكُمُ الْخَبِيثَ ""","","","","","Book of Drinks"
"16596","عَنْ دَاوُدَ بْنِ إِبْرَاهِيمَ , قَالَ :  سَأَلْتُ طَاوُسًا عَنِالطِّلاءِ , فَقَالَ : "" لا بَأْسَ بِهِ "" , فَقُلْتُ : وَمَا الطِّلاءُ ؟ قَالَ : "" أَرَأَيْتَ شَيْئًا مِثْلَ الْعَسَلِ تَأْكُلُهُ بِالْخُبْزِ ، وَتَصُبُّ عَلَيْهِ الْمَاءَ فَتَشْرَبُهُ ؟ عَلَيْكَ بِهِ ! وَلا تَقْرَبْ مَا دُونَهُ ، وَلا تَشْرَبْهُ ، وَلا تَسْقِهِ ، وَلا تَبِعْهُ ، وَلا تَسْتَعِنْ بِثَمَنِهِ ""","","","","","Book of Drinks"
"16597","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : كُتِبَ لِنُوحٍ مِنْ كُلِّ شَيْءٍ اثْنَانِ , أَوْ قَالَ : زَوْجَانِ , فَاخَذَ مَا كُتِبَ لَهُ , وَضَلَّتْ عَلَيْهِ حَبَلَتَانِ ، فَجَعَلَ يَلْتَمِسُهُمَا "" , فَلَقِيَهُ مَلَكٌ , فَقَالَ لَهُ : مَا تَبْغِي ؟ قَالَ : حَبَلَتَيْنِ , قَالَ : إِنَّ الشَّيْطَانَ ذَهَبَ بِهِمَا , قَالَ الْمَلِكُ : "" أَنَا آتِيكَ بِهِ وَبِهِمَا "" , فَقَالَ لَهُ : إِنَّهُ لَكَ فِيهِمَا شَرِيكٌ ، فَاحْسِنْ مُشَارَكَتَهُ , قَالَ : لِي الثُّلُثُ وَلَهُ الثُّلُثَانِ , قَالَ الْمَلَكُ : "" أَحْسَنْتَ , وَأَنْتَ مُحْسَانٌ , إِنَّ لَكَ إِنْ تَأْكُلَهُ عِنَبًا , وَزَبِيبًا , وَتَطْبَخُهُ حَتَّى يَذْهَبَ ثُلُثَاهُ , وَيَبْقَى الثُّلُثُ "", قَالَ ابْنُ سِيرِينَ : فَوَافَقَ ذَلِكَ كِتَابَ عُمَرَ بْنِ الْخَطَّابِ""","","","","","Book of Drinks"
"16598","عَنْ مَعْمَرٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : كَتَبَ عُمَرُ بْنُ الْخَطَّابِ , إِلَى عَمَّارِ بْنِ يَاسِرٍ :  أَمَّا بَعْدُ ، فَإِنَّهَاجَاءَتْنَا أَشْرِبَةٌ مِنْ قِبَلِ الشَّامِ كَأَنَّهَا طِلاءُ الإِبِلِ ، قَدْ طُبِخَ حَتَّى ذَهَبَ ثُلُثَاهَا الَّذِي فِيهِ خَبَثُ الشَّيْطَانِ , أَوْ قَالَ : خَبِيثُ الشَّيْطَانِ , وَرِيحُ جُنُونِهِ ، وَبَقِيَ ثُلُثُهُ ، فَاصْطَبَغَهُ ، وَمُرْ مَنْ قِبَلَكَ إِنْ يَصْطَبِغُوهُ ""","","","","","Book of Drinks"
"16599","عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ سُوَيْدِ بْنِ غَفَلَةَ , قَالَ : كَتَبَ عُمَرُ إِلَى عُمَّالِهِ :  أَنْيَرْزُقُوا النَّاسَ الطِّلاءَ مَا ذَهَبَ ثُلُثَاهُ وَبَقِي ثُلُثُهُ ""","","","","","Book of Drinks"
"16600","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدِ بْنِ أَبْي عَرُوبَةَ ، عَنْ قَتَادَةَ ، أَنَّ أَبَا طَلْحَةَ , وَأَبَا عُبَيْدَةَ , وَمُعَاذَ بْنَ جَبَلٍ  كَانُوايَشْرَبُونَ الطِّلاءَ إِذَا ذَهَبَ ثُلُثَاهُ وَبَقِيَ ثُلُثُهُ ""، يَعْنِي الرُّبَّ""","","","","","Book of Drinks"
"16601","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً ، يُسْأَلُ  عَنِالْمَرْأَةِ تَنْكَسِرُ رِجْلُهَا , أَوْ فَخِذُهَا , أَوْ سَاقُهَا , أَوْ مَا كَانَ مِنْهَا , أَيَجْبِرُهَا الطَّبِيبُ لَيْسَ بِذِي مَحْرَمٍ ؟ قَالَ : "" نَعَمْ ، ذَلِكَ فِي الضَّرُورَةِ "", فَقَالَ عَبْدُ اللَّهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ : الْمَرْأَةُ تَمُوتُ وَفِي بَطْنِهَا وَلَدُهَا ، فَيُخْشَى عَلَيْهِ أَنْ يَمُوتَ , أَيَسْطُو عَلَيْهَا الرَّجُلُ فَيَقْطَعُ وَلَدَهَا مِنْ بَطْنِهَا ؟ قَالَ : "" لَيْسَ ذَلِكَ كَغَيْرِهِ مِنْهَا ، وَلَوْ يَكُونُ فِي ذَلِكَ مِنَ الشِّفَاءِ مَا يَكُونُ فِي خَيْرِ عُضْوٍ مِنْهَا لَكَانَ "" , قَالَ عَبْدُ اللَّهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ : "" فَإِنَّ النَّاقَةَ إِذَا عَضِبَتْ فَيُخْشَى عَلَيْهَا , يُقْطَعُ وَلَدُهَا فِي بَطْنِهَا , فَأَبَى وَكَرِهَهُ مِنَ الْمَرْأَةِ ""","","","","","Book of Drinks"
"16602","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً  يَسْأَلُهُإِنْسَانٌ نُعِتَ لَهْ إِنْ يَشْتَرِطَ عَلَى كَبِدِهِ , فَيَشْرَبُ ذَلِكَ الدَّمَ , مِنْ وَجَعٍ كَانَ بِهِ , فَرَخَّصَ لَهُ فِيهِ , قُلْتُ لَهُ : حَرَّمَهُ اللَّهُ تَعَالَى , قَالَ : ضَرُورَةٌ , قُلْتُ لَهُ : إِنَّهُ لَوْ يَعْلَمُ إِنَّ فِي ذَلِكَ شِفَاءً , وَلَكِنْ لا يَعْلَمُ ، وَذَكَرْتُ لَهُ أَلْبَانَ الأُتُنِ عِنْدَ ذَلِكَ , فَرَخَّصَ فِيهِ إِنْ يُشْرَبَ دَوَاءً ""","","","","","Book of Drinks"
"16603","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ جَابِرِ بْنِ زَيْدٍ , قَالَ :  كَانَرَجُلٌ يُعَالِجُ النِّسَاءَ فِي الْكَسْرِ وَأَشْبَاهِهِ , فَقَالَ لَهُ جَابِرٌ : "" لا تَمْنَعْ شَيْئًا مِنْ ذَلِكَ ""","","","","","Book of Drinks"
"16604","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، فِيالْمَرْأَةِ يَكُونُ بِهَا الْكَسْرُ , أَوِ الْجُرْحُ , لا يُطِيقُ عِلاجَهُ إِلا الرِّجَالُ , قَالَ :  اللَّهُ تَعَالَى أَعْذَرَ بِالْعُذْرِ ""","","","","","Book of Drinks"
"16605","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : سَمِعْتُهُ يُسْأَلُ  عَنِالْمَحْرِسِ يُقْطَعُ آذَانَهَمُ فَيُخَاطُ , قَالَ : شَيْءٌ يُرَادُ بِهِ الْعِلاجُ ""","","","","","Book of Drinks"
"16606","عَنِ ابْنِ أَبِي يَحْيَى ، عَنْ رَجُلٍ سَمَّاهُ , قَالَ : شَرِبَ عَلِيُّ بْنُ الْحُسَيْنِ أَلْبَانَ الأُتُنِ مِنْ مَرَضٍ كَانَ بِهِ ""","","","","","Book of Drinks"
"16607","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  سَأَلْتُهُعَنْ أَلْبَانِ الأُتُنِ الأَهْلِيَّةِ ، وَنُعِتَ ، لابْنِهِ فَكَرِهَهُ ""","","","","","Book of Drinks"
"16608","عَنِ الثَّوْرِيِّ ، عَنْ سَالِمٍ الأَفْطَسِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ :  نُهِيَ عَنْلُحُومِ الْحُمُرِ الأَهْلِيَّةِ , وَأَلْبَانِهَا ""","","","","","Book of Drinks"
"16609","عَنِ الثَّوْرِيِّ ، قَالَ : يَقُولُونَ : إِذَا مَاتَتِ الْحُبْلَى , فَرُجِي إِنْ يَعِيشَ مَا فِي بَطْنِهَا , شُقَّ بَطْنُهَا , قَالَ : بَلَغَنَا أَنَّهُ عَاشَ ذَلِكَ ، قَالَ الثَّوْرِيُّ : وَقَالَ بَعْضُ أَصْحَابِنَا : يَشُقُّ مِمَّا يَلِي فَخِذَهَا الْيُسْرَى ""","","","","","Book of Drinks"
"16610","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : قَدِمَ الْمَدِينَةَ قَوْمٌ فَاجْتَوَوْهَا ، فَأَمَرَهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِنَعَمٍ ، وَأَذِنَ لَهُمْ بَأَبْوَالِهَا ، وَأَلْبَانِهَا , فَلَمَّا صَحَوْا قَتَلُوا الرَّاعِيَ ، وَاسْتَاقُوا الإِبِلَ ، فَأُتِيَ بِهِمُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَطَعَ أَيْدِيَهُمْ , وَأَرْجُلَهُمْ ، وَسَمَلَ أَعْيُنَهُمْ ، وَتُرِكُوا حَتَّى مَاتُوا "", قَالَ : وَقَالَ لِي هِشَامُ بْنُ عُرْوَةَ : سَمَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَعْيُنَهُمْ , وَذَكَرَ أَنَّ أَنَسًا ذَكَرَ ذَلِكَ لِلْحَجَّاجِ , فَقَالَ الْحَسَنُ : عَمِدَ أَنَسٌ إِلَى شَيْطَانٍ فَحَدَّثَهَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَطَعَ وَسَمَلَ ، يَعِيبُ ذَلِكَ عَلَى أَنَسٍ ، فَقُلْتُ لَهُ : مَا سَمَلَ ؟ قَالَ : يُحَدُّ الْمِرْآةُ أَوِ الْحَدِيدُ ، ثُمَّ يُقَرَّبُ إِلَى عَيْنَيْهِ حَتَّى تَذُوبَا , عَنِ الثَّوْرِيِّ ، لَعَلَّهُ عَنْ أَيُّوبَ أَبُو سَعِيدٍ , يَشُكُّ عَنْ أَبِي قِلابَةَ ، عَنْ أَنَسٍ ، أَنَّهُمْ مِنَ عُكْلٍ""","","","","","Book of Drinks"
"16611","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ :  أَنَّهُ كَانَلا يَرَى بَأْسًا أَنْ يُتَدَاوَى بِالْبَوْلِ ""","","","","","Book of Drinks"
"16612","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي رَجُلٌ مِنْ بَنِي زُهْرَةَ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :فِي أَلْبَانِ الإِبِلِ وَأَبْوَالِهَا دَوَاءٌ لِذَرَبِكُمْ، يَعْنِي : الْمُرَّ وَأَشْبَاهَهُ مِنَ الأَمْرَاضِ","","","","","Book of Drinks"
"16613","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَا أَكَلْتَ لَحْمَهُ فَاشْرَبْ بَوْلَهُ ""","","","","","Book of Drinks"
"16614","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ , قَالَ : مَا أَكَلْتَ لَحْمَهُ فَلا بَأْسَ بِبَوْلِهِ "", وَأَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ مِثْلَهُ""","","","","","Book of Drinks"
"16615","عَنِ الثَّوْرِيِّ ، عَنْ أَبَانَ بْنِ أَبِي عَيَّاشٍ ، عَنِ الْحَسَنِ , قَالَ : لا بَأْسَ بِبَوْلِ كُلِّ ذَاتِ كِرْشٍ ""","","","","","Book of Drinks"
"16616","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : لا بَأْسَ بَأَبْوَالِ الإِبِلِ , كَانَ بَعْضُهُمْ يَسْتَنْشِقُ مِنْهَا "" , قَالَ : "" وَكَانُوا لا يَرَوْنَ بَأَبْوَالِ الْبَقَرِ وَالْغَنَمِ بَأْسًا ""","","","","","Book of Drinks"
"16617","عَنْ رَجُلٍ مِنْ أَهْلِ الْبَصْرَةِ , عَنْ أَبِيهِ ، عَنِ الْحَسَنِ  أَنَهُرَخَّصَ فِي أَبْوَالِ الأُتُنِ لِلدَّوَاءِ ""","","","","","Book of Drinks"
"16618","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ مَجْزَأَةَ بْنِ زَاهِرٍ ، عَنْ أَبِيهِ ،  وَكَانَ مِمَّنْ شَهِدَ الشَّجَرَةَ , أَنَهُاشْتَكَى فَوُصِفَ لَهُ أَنْ يَسْتَنْقِعَ بَأَلْبَانِ الأُتُنِ وَمَرَقِهَا يَعْنِي : لَحْمُهَا يُطْبَخُ , فَكِرَهَ ذَلِكَ ""","","","","","Book of Drinks"
"16619","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، أَنَّ أَبَاهُ ، أَمَرَ طَبِيبًا أَنْ يَنْظُرَ ، جُرْحًا فِي فَخِذِ امْرَأَةٍ فَجَوَّبَ لَهُ عَنْهُ "" , يَعْنِي : فَجَوَّفَ لَهُ عَنْهُ""","","","","","Book of Drinks"
"16620","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ قَيْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ :  إِنَّ اللَّهَ تَعَالَىلَمْ يُنْزِلْ دَاءً إِلا وَقَدْ أَنْزَلَ مَعَهُ دَوَاءً ، فَعَلَيْكُمْ بِأَلْبَانِ الْبَقَرِ ، فَإِنَّهَا تَرِمُّ مِنَ الشَّجَرِ كُلِّهِ ""","","","","","Book of Drinks"
"16621","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ أَبَا هُرَيْرَةَ , قَالَ : حَرَّمَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا بَيْنَ لابَتَيِ الْمَدِينَةِ "", قَالَ أَبُو هُرَيْرَةَ : فَلَوْ وَجَدْتَ الظِّبَاءَ مَا بَيْنَ لابَتَيْهَا مَا ذَعَرْتُهُنَّ ، وَجَعَلَ حَوْلَ الْمَدِينَةِ اثْنَيْ عَشَرَ مِيلا حِمًى""","","","","","Book of Drinks"
"16622","عَنِ ابنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرٍ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ , قَالَ وَهُوَ يَخْطُبُ بِالْمَدِينَةِ :  إِنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَحَرَّمَ مَا بَيْنَ لابَتَيِ الْمَدِينَةِ "", أَوْ قَالَ : هُوَ هُوَ""","","","","","Book of Drinks"
"16623","عَنْ مَعْمَرٍ ، عَنْ حَرَامِ بْنِ عُثْمَانَ ، عَنْ جَابِرٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :حَرَّمَ كُلَّ دَافِعَةٍ أَقْبَلَتْ عَلَى الْمَدِينَةِ مِنَ الْعَضُدِ , وَشَيْئًا آخَرَ قالهُ , قَالَ : إِلا لِمُنْشِدِ ضَالَةٍ , أَوْ عَصَا لِحَدِيدَةٍ يَنْتَفِعُ بِهَا","","","","","Book of Drinks"
"16624","عَنِ ابنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنْ زَيْدِ بْنِ ثَابِتٍ ، أَنَّهُ قَالَ :  إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَحَرَّمَ مَا بَيْنَ لابَتَيِ الْمَدِينَةِ مِنَ الصَّيْدِ وَالْعِضَاهِ ""","","","","","Book of Drinks"
"16625","عَنِ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ حَتَّى إِذَا كَانَ عِنْدَ السُّقْيَا مِنَ الْحَرَّةِ , قَالَ : اللَّهُمَّ إِنَّ إِبْرَاهِيمَ عَبْدَكَ وَرَسُولَكَ حَرَّمَ مَكَّةَ ، اللَّهُمَّ وَإِنِّي أُحَرِّمُ مَا بَيْنَ لابَتَيِ الْمَدِينَةِ , مِثْلَ مَا حَرَّمَ إِبْرَاهِيمُ مَكَّةَ ""","","","","","Book of Drinks"
"16626","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ بْنُ أَبِي الْمُخَارِقِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ لِغُلامِ قُدَامَةَ بْنِ مَظْعُونٍ : أَنْتَ عَلَى هَؤُلاءِ الْحَطَّابِينَ ، فَمَنْ وَجَدْتَهُ احْتَطَبَ مِنْ بَيْنَ لابَتَيِ الْمَدِينَةِ فَلَكَ فَأْسُهُ وَحَبْلُهُ "" , قَالَ : وَثَوْبَاهُ ؟ قَالَ عُمْرُ : "" لا , ذَلِكَ كَثِيرٌ ""","","","","","Book of Drinks"
"16627","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عُمَرَ ، أَنَّ سَعْدَ بْنَ أَبِي وَقَّاصٍ ، وَجَدَ إِنْسَانًا يَعْضِدُ , فَيَخْبِطُ عَضَاهَا بِالْعَقِيقِ ، فَأَخَذَ فَأْسَهُ وَنِطْعَهُ ، وَمَا سُوَى ذَلِكَ , فَانْطَلَقَ الْعَبْدُ إِلَى سَادَتِهِ ، فَأَخْبَرَهُمَ الْخَبَرَ , فَانْطَلَقُوا إِلَى سَعْدٍ , فَقَالُوا : الْغُلامُ غُلامُنَا , فَارْدُدْ إِلَيْهِ مَا أَخَذْتَ مِنْهُ , فَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :مَنْ وَجَدْتُمُوهُ يَعْضِدُ أَوْ يَحْتَطِبُ عِضَاهَ الْمَدِينَةِ بَرِيدًا فِي بَرِيدٍ ، فَلَكُمْ سَلَبُهُ, فَلَمْ أَكُنْ أَرُدُّ شَيْئًا أَعْطَانِيهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Drinks"
"16628","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ أَهْلِ الْمَدِينَةِ , قَالَ : كَانَ سَعْدٌ , وَابْنُ عُمَرَ إِذَا وَجَدَا أَحَدًا يَقْطَعُ مِنَ الْحِمَى شَيْئًا , سَلَبَاهُ فَأْسَهُ وَحَبْلَهُ ""","","","","","Book of Drinks"
"16629","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ عَلِيٍّ , قَالَ : مَا عِنْدَنَا شَيْءٌ إِلا كِتَابُ اللَّهِ , إِلا شَيْءٌ فِي هَذِهِ الصَّحِيفَةِ : الْمَدِينَةُ حَرَامٌ مَا بَيْنَ عِيرٍ إِلَى ثَوْرٍ , مَنْ أَحْدَثَ فِيهَا ، أَوْ آوَى مُحْدِثًا ، فَعَلَيْهِ لَعْنَةُ اللَّهِ , وَالْمَلائِكَةِ , وَالنَّاسِ أَجْمَعِينَ ، لا يَقْبَلُ اللَّهُ مِنْهُ صَرْفًا ، وَلا عَدْلا , وَمَنْ تَوَلَّى قَوْمَا بِغَيْرِ إِذْنِ مَوَالِيهِمْ ، فَعَلَيْهِ لَعْنَةُ اللَّهِ , وَالْمَلائِكَةِ , وَالنَّاسِ أَجْمَعِينَ ، لا يَقْبَلُ اللَّهُ مِنْهُ صَرْفًا وَلا عَدْلا , وَذِمَّةُ اللَّهِ وَاحِدَةٌ , يَسْعَى بِهَا أَدْنَاهُمْ ، فَمَنْ أَخْفَرَ مُسْلِمًا فَعَلَيْهِ لَعْنَةُ اللَّهِ , وَالْمَلائِكَةِ , وَالنَّاسِ أَجْمَعِينَ ، لا يُقْبَلُ مِنْهُ عَدْلٌ وَلا صَرْفٌ "", وَيَقُولُ : الصَّرْفُ وَالْعَدْلُ : التَّطَوُّعُ وَالْفَرِيضَةُ""","","","","","Book of Drinks"
"16630","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ يُحَنَّسٍ ، عَنْ أَبِي عَبْدِ اللَّهِ الْقَرَّاظِ ، أَنَّهُ قَالَ : أَشْهَدُ عَلَى أَبِي هُرَيْرَةَ , أَنَّهُ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَرَادَ أَهْلَ هَذِهِ الْبَلْدِ بِسُوءٍ يَعْنِي الْمَدِينَةَ , أَذَابَهُ اللَّهُ فِي النَّارِ , كَمَا يَذُوبُ الْمِلْحُ فِي الْمَاءِ ""","","","","","Book of Drinks"
"16631","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ يَحْيَى بْنِ عُمَارَةَ ، أَنَّهُ سَمِعَ أَبَا عَبْدِ اللَّهِ الْقَرَّاظَ مِنْ أَصْحَابِ أَبِي هُرَيْرَةَ , يَزْعُمُ أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ أَرَادَ أَهْلَهَا بِسُوءٍ أَذَابَهُ اللَّهُ كَمَا يَذُوبُ الْمِلْحُ فِي الْمَاءِ ""","","","","","Book of Drinks"
"16632","عَنْ أَبِي مَعْشَرٍ , قَالَ : سَمِعْتُ أَبَا عَبْدِ اللَّهِ الْقَرَّاظَ , يَقُولُ : سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ لِيَزِيدَ بْنِ مُعَاوِيَةَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَرَادَ أَهْلَ هَذِهِ الْبَلْدَةَ بِسُوءٍ يُرِيدُ الْمَدِينَةَ , أَذَابَهُ اللَّهُ تَعَالَى كَمَا يَذُوبُ الْمِلْحُ فِي الْمَاءِ ""","","","","","Book of Drinks"
"16633","عَنْ مَعْمَرٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :اللَّهُمَّ مَنْ أَرَادَ الْمَدِينَةَ بِسُوءٍ ، فَأَذِبْهُ كَمَا يَذُوبُ الرَّصَاصُ فِي النَّارِ ، وَكَمَا يَذُوبُ الْمِلْحُ فِي الْمَاءِ , وَكَمَا تَذُوبُ الإِهَالَةَ فِي الشَّمْسِ","","","","","Book of Drinks"
"16634","عَنْ مُحَمَّدِ بْنِ أَبِي سَبْرَةَ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ خَالِدِ بْنِ يَسَارٍ ، عَنْ بَعْضِ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَخَافَ أَهْلَ الْمَدِينَةِ أَخَافَهُ اللَّهُ ""","","","","","Book of Drinks"
"16635","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، عَنْ سُفْيَانَ بْنِ أَبِي زُهَيْرٍ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : تُفْتَحُ الْيَمَنُ فَيَأْتِي قَوْمٌ يَبُسُّونَ فَيَتَحَمَّلُونَ بِأَهْلِيهِمْ ، وَمَنْ أَطَاعَهُمْ , وَالْمَدِينَةُ خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ ، ثُمَّ تُفْتَحُ الشَّامُ ، فَيَأْتِيَ قَوْمٌ يَبُسُّونَ فَيَتَحَمَّلُونَ بِأَهْلِيهِمْ ، وَمَنْ أَطَاعَهُمْ وَالْمَدِينَةُ خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ ، ثُمَّ يُفْتَحُ الْعِرَاقُ ، فَيَأْتِيَ قَوْمٌ يَبُسُّونَ فَيَتَحَمَّلُونَ بِأَهْلِيهِمْ ، وَمَنْ أَطَاعَهُمْ , وَالْمَدِينَةُ خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ ""","","","","","Book of Drinks"
"16636","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا يَخْرُجُ أَحَدٌ مِنَ الْمَدِينَةِ رَغْبَةً عَنْهَا إِلا أَبْدَلَهَا اللَّهُ بِهِ خَيْرًا مِنْهُ ""","","","","","Book of Drinks"
"16637","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ بَعْضِ أَهْلِ الْعِلْمِ ، أَنَّهُ قَالَ : مَنْ مَاتَ بِالْمَدِينَةِ شَهِدَ لَهُ أَوْ شَفَعَ لَهُ "", عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَ حَدِيثِ ابْنِ جُرَيْجٍ""","","","","","Book of Drinks"
"16638","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ صَبَرَ عَلَى لأْوَاءِ الْمَدِينَةِ , أَوْ جَهْدِهَا , كُنْتُ لَهُ شَهِيدًا , أَوْ شَفِيعًا يَوْمَ الْقِيَامَةِ "" , قَالَ : وَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لَيَنْحَازَنَّ الإِيمَانُ إِلَيْهَا كَمَا يَحُوزُ السَّيْلُ الدِّمَنُ ""","","","","","Book of Drinks"
"16639","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ الْمُنْكَدِرِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : جَاءَ أَعْرَابِيٌّ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَفَبَايَعَهُ عَلَى الإِسْلامِ , فَجَاءَ مِنَ الْغَدِ مَحْمُومًا , فَقَالَ : يَا رَسُولَ اللَّهِ , أَقِلْنِي , فَأَبَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَجَاءَهُ ثَلاثَةَ أَيَّامٍ مُتَوَالِيَةً , كُلَّ ذَلِكَ يَقُولُ : يَا رَسُولَ اللَّهِ , أَقِلْنِي بَيْعَتِي , فَأَبَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا وَلَّى , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمَدِينَةَ كَالْكِيرِ , تَنْفِي خَبَثَهَا ، وَتَنْصَعُ طِيبَهَا ""","","","","","Book of Drinks"
"16640","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ سَعِيدِ بْنِ يَسَارٍ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : أُمِرْتُ بِقَرْيَةٍ تَأْكُلُ الْقُرَى "" , يَقُولُونَ : يَثْرِبُ , وَهِيَ الْمَدِينَةُ , تَنْفِي النَّاسَ كَمَا يَنْفِي الكِيرُ الْخَبَثَ""","","","","","Book of Drinks"
"16641","عَنْ يَحْيَى بْنِ الْعَلاءِ الْبَجَلِيِّ ، وَغَيْرِهِ ، عَنْ غَالِبِ بْنِ عُبَيْدِ اللَّهِ ، رَفَعَ الْحَدِيثَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ زَارَنِي يَعْنِي : مَنْ أَتَى الْمَدِينَةَ , كَانَ فِي جِوَارِي ، وَمَنْ مَاتَ , يَعْنِي : بِوَاحِدٍ مِنَ الْحَرَمَيْنِ بُعِثَ مِنَ الآمِنِينَ يَوْمَ الْقِيَامَةِ ""","","","","","Book of Drinks"
"16642","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ لِلْمَدِينَةِ : يَثْرِبُ , فَلْيَقُلْ : أَسْتَغْفِرُ اللَّهَ ثَلاثًا , هِيَ طِيبَةٌ , هِيَ طِيبَةٌ , هِيَ طِيبَةٌ "", أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Drinks"
"16643","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَطَلَعَ لَهُ أُحُدٌ ، فَقَالَ :  هَذَا جَبَلٌ يُحِبُّنَا وَنُحِبُّهُ ""","","","","","Book of Drinks"
"16644","عَنِ ابْنِ أَبِي يَحْيَى ، عَنْ عَمْرِو بْنِ أَبِي عَمْرٍو , قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِكٍ , يَقُولُ :طَلَعَ عَلَيْنَا أَحَدٌ وَنَحْنُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  هَذَا جَبَلٌ يُحِبُّنَا وَنُحِبُّهُ ""","","","","","Book of Drinks"
"16645","عَنِ ابْنِ أَبِي يَحْيَى ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِي لَيْلَى , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أُحُدٌ عَلَى تُرْعَةٍ مِنْ تُرَعِ الْجَنَّةِ ، وَالتُّرْعَةُ بَابٌ وَدَحْلٌ عَلَى رُكْنٍ مِنْ أَرْكَانِ النَّارِ ""","","","","","Book of Drinks"
"16646","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى ، عَنْ عَبْدِ اللَّهِ بْنِ تَمَّامٍ ، عَنِ امْرَأَةٍ يُقَالُ لَهَا : زَيْنَبُ ، عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ :  إِنَّأُحُدًا عَلَى بَابٍ مِنْ أَبْوَابِ الْجَنَّةِ ، فَإِذَا جِئْتُمُوهُ فَكُلُوا مِنْ شَجَرَهِ ، وَلَوْ مِنْ عِضَاهِهِ ""","","","","","Book of Drinks"
"16647","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : الْعَمْدُ السِّلاحُ , كَذَلِكَ بَلَغَنَا مَرَّتَيْنِ تَتْرَى ""","","","","","Book of Blood Money (Diyat)"
"16648","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنَا عَبْدُ الْكَرِيمِ ، عَنْ عَلِيٍّ ، وَابْنِ مَسْعُودٍ  أَنَّالْعَمْدَ السِّلاحُ ""","","","","","Book of Blood Money (Diyat)"
"16649","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَأَلْتُ طَاوُسًا ,  عَنْ قَوْلِ اللَّهِ فِيالْعَمْدِ ، مَا هُوَ ؟ قَالَ : مَا يَقُولُونَ ؟ قَالَ : قُلْتُ : يَقُولُونَ : السِّلاحُ, قَالَ : "" وَهَلْ يَقُولُ أَبُو عَبْدِ الرَّحْمَنِ غَيْرَ ذَلِكَ ؟ وَمَا هُوَ إِلا ذَلِكَ "" , قَالَ : وَقَالَ لِي ابْنُ طَاوُسٍ : وَفِيمَا أَخْبَرْتُكَ عَنِ الْمَرْأَتَيْنِ شِفَاءٌ لِخَبَرَ الْهُذَلِيَّتَيْنِ , قَالَ : "" وَلَوْ جَاءَ رَجُلٌ بِحَجَرٍ , فَرَضَخَ بِهِ رَأْسَ رَجُلٍ ، إِنَّهُ لَعَمْدٌ ""","","","","","Book of Blood Money (Diyat)"
"16650","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَمْرُو بْنُ شُعَيْبٍ , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ قَتَلَ مُتَعَمِّدًا ، فَإِنَّهُ يُدْفَعُ إِلَى أَهْلِ الْقَتِيلِ ، فَإِنْ شَاءُوا قَتَلُوهُ ، وَإِنْ شَاءُوا أَخَذُوا الْعَقْلَ , دِيَةَ مُسْلِمَةٍ ، وَهِيَ مِائَةٌ مِنَ الإِبِلِ ثَلاثُونَ حِقَّةً , وَثَلاثُونَ جَذَعَةً , وَأَرْبَعُونَ خَلِفَةً ، فَذَلِكَ الْعَمْدُ إِذَا لَمْ يُقْتَلْ صَاحِبُهُ ""","","","","","Book of Blood Money (Diyat)"
"16651","عَنِ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ ، عَنْ عَمْرِو بْنِ سُلَيْمٍ مَوْلاهُمْ , عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : الْعَمْدُ الْحَدِيدُ , بِإِبْرَةٍ فَمَا فَوْقَهَا مِنَ السِّلاحِ ""","","","","","Book of Blood Money (Diyat)"
"16652","عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : لا عَمْدَ إِلا بِحَدِيدَةٍ ""","","","","","Book of Blood Money (Diyat)"
"16653","عَنْ مَعْمَرٍ ، عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرٍو , عَنِ الْحَسَنِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا قَوَدَ إِلا بِحَدِيدَةٍ ""","","","","","Book of Blood Money (Diyat)"
"16654","عَنْ إِسْرَائِيلَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ , قَالَ : لَيْسَ الْعَمْدُ إِلا بِحَدِيدَةٍ ""","","","","","Book of Blood Money (Diyat)"
"16655","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ , قَالَ : لَيْسَ الْعَمْدُ إِلا بِحَدِيدَةٍ ""","","","","","Book of Blood Money (Diyat)"
"16656","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ أَبِي عَازِبٍ ، عَنِ النُّعْمَانِ بْنِ بَشِيرٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : كُلُّ شَيْءٍ خَطَأٍ إِلا السَّيْفَ ، وَلِكُلِّ خَطَأٍ أَرْشٌ ""","","","","","Book of Blood Money (Diyat)"
"16657","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ ، قَالَ : كَتَبَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنِ اعْتَبَطَ مُؤْمِنًا قَتْلا فَإِنَّهُ قَوَدٌ , إِلا أَنْ يَرْضَى وَلِيُّ الْمَقْتُولِ ""","","","","","Book of Blood Money (Diyat)"
"16658","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : قَتْلُ الْعَمْدِ فِيمَا بَيْنَ النَّاسِ إِنِ اقْتَتَلُوا بِالسُّيُوفِ , قِصَاصٌ بَيْنَهُمْ , يَحْبِسُ الإِمَامُ عَلَى كُلِّ مَقْتُولٍ وَمَجْروحٍ حَقَّهُ ، وَإِنْ شَاءَ وَلِيُّ الْمَقْتُولِ وَالْمَجْرُوحِ اقْتَصَّ ، وَإِنِ اصْطَلَحُوا عَلَى العَقْلِ جَاءَ صُلْحُهُمْ  وَفِي السُّنَّةِ أَنْ لا يَقْتُلَ الإِمَامُ أَحَدًا عَفَا عَنْهُ أَوْلِيَاءُ الْمَقْتُولِ ، إِنَّمَا الإِمَامُ عَدْلٌ بَيْنَهُمْ , يَحْبِسُ عَلَيْهِمْ حُقُوقَهُمْ , وَالْخَطَأُ فِيمَا كَانَ مِنْ لِعْبٍ أَوْ رَمْيٍ ، فَأَصَابَ غَيْرَهُ , وَأَشْبَاهِ ذَلِكَ , فِيهِ الْعَقْلُ , وَالْعَقْلُ عَلَى عَاقِلَتِهِ فِي الْخَطَإِ ، وَأَمَّا الْعَمْدِ فَشِبْهُ الْعَمْدِ فَهُوَ عَلَيْهِ , إِلا أَنْ يُعِينَهُ الْعَاقِلَةُ ، وَعَلَيْهِمْ أَنْ يُعِينُوهُ "" , كَمَا بَلَغَنَا عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ فِي الْكِتَابِ الَّذِي كَتَبَهُ بَيْنَ قُرَيْشٍ ، وَالأَنْصَارِ : ""وَلا تَتْرُكُوا مُفْرَجًا أَنْ تُعِينُوهُ فِي فِكَاكٍ أَوْ عَقْلٍ ""","","","","","Book of Blood Money (Diyat)"
"16659","أَخْبَرَنَا ابنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ عُبَيْدَ بْنَ عُمَيْرٍ , يَقُولُ : يَنْطَلِقُ الرَّجُلُ الأَيِّدُ فَيَتَمَطَّى عَلَى الرَّجُلِ بِالْعَصَا وَالْحَجَرِ , حَتَّى يَفْضَخَ رَأْسَهُ "" , ثُمَّ يَقُولُ : "" لَيْسَ بِعَمْدٍ , وَأَيُّ عَمْدٍ أَعْمَدُ مِنْ ذَلِكَ ؟ ""","","","","","Book of Blood Money (Diyat)"
"16660","عَنْ مَعْمَرٍ ، عَنْ سِمَاكٍ ، أَنَّ عُرْوَةَ , كَتَبَ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  فِيرَجُلٍ خَنَقَ صَبِيًّا عَلَى أَوْضَاحٍ لَهُ حَتَّى قَتَلَهُ ، فَوَجَدُوا الْحَبْلَ فِي يَدِهِ فَاعْتَرَفَ بِذَلِكَ ، فَكَتَبَ أَنِ ادْفَعْهُ إِلَى أَوْلِيَاءِ الصَّبِيِّ ، فَإِنْ شَاءُوا قَتَلُوهُ ""","","","","","Book of Blood Money (Diyat)"
"16661","عَنْ مَعْمَرٍ ، عَنْ سِمَاكٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ فِيرَجُلٍ ضَرَبَ بِحَجَرٍ , قَالَ :  إِنْ كَانَ دَفَعَهُ بِالْحَجَرِ دَفْعًا فَأَقِدْهُ ، وَإِنْ كَانَ رَمَى رَمْيًا فَلا تُقِدْهُ ""","","","","","Book of Blood Money (Diyat)"
"16662","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ قَيْسٍ ، عَنِ الشَّعْبِيِّ , قَالَ : إِذَا عَادَ وَبَدَأَ بِالْعَصَا وَالْحَجَرِ فَهُوَ قَوَدٌ ""","","","","","Book of Blood Money (Diyat)"
"16663","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : إِذَا أَعَلَّ , يَعْنِي أَعَلَّ : عَادَ , فَهُوَ قَوَدٌ ""","","","","","Book of Blood Money (Diyat)"
"16664","عَنْ إِسْرَائِيلَ ، عَنْ جَابِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : مَنْ ضَرَبَ بِالْعَصَا مَرَّتَيْنِ فَفِيهِ دِيَةٌ مُغَلَّظَةٌ "", قَالَ جَابِرٌ : وَسَأَلْتُ الشَّعْبِيَّ ، وَالْحَكَمَ , عَنِ الرَّجُلِ يَضْرِبُ الضَّرْبَتَيْنِ بِالْعَصَا , ثُمَّ يَمُوتُ ، قَالا : دِيَةٌ مُغَلَّظَةٌ""","","","","","Book of Blood Money (Diyat)"
"16665","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الْحَكَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنِ اعْتَبَطَ مُؤْمِنًا قَتْلا ، فَإِنَّهُ قَوَدٌ , إِلا أَنْ يَرْضَى وَلِيُّ الْمَقْتُولِ ، وَالْمُؤْمِنُونَ عَلَيْهِ كَافَّةً , لا يَحِلُّ لِمُؤْمِنٍ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الآخِرِ أَنْ يُؤْوِيَهِ وَيَنْصُرَهُ ، فَمَنْ آوَاهُ وَنَصَرَهُ فَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ :  وَمَا اخْتَلَفْتُمْ فِيهِ مِنْ شَيْءٍ فَحُكْمُهُ إِلَى اللَّهِ ""","","","","","Book of Blood Money (Diyat)"
"16666","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , فِيالرَّجُلِ يَضْرِبُ الرَّجُلَ بِالْعَصَا , قَالَ :  شِبْهُ الْعَمْدِ , فَإِنْ أَعَلَّ مَثْنَى وَثُلاثَ فَفِيهِ الْقَوَدُ "", وَذَكَرَهُ الْحَسَنُ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16667","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : شِبْهُ الْعَمْدِ الْحَجَرُ وَالعَصَا "" , قَالَ ذَلِكَ مَرَّتَيْنِ تَتْرَى , قُلْتُ لَهُ : أَبَلَغَكَ غَيْرُ ذَلِكَ ؟ قَالَ : "" مَا عَلِمْنَا "" , قُلْتُ لِعَطَاءٍ : الْحَجَرُ وَالْعَصَا فِيمَا دُونَ النَّفْسِ خَطَأً شِبْهُ الْعَمْدِ ؟ قَالَ : "" نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"16668","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فَإِنْ قَامَ رَجُلٌ إِلَى رَجُلٍ بِحَجَرٍ فَكَسَرَ أَسْنَانَهُ , أَوْ بِعُودٍ فَفَقَأَ عَيْنَهُ ؟ قَالَ : "" لا يُقَادُ مِنْهُ "", قَالَ ابْنُ جُرَيْجٍ : وَأَقُولُ أَنَا : "" يُقَادُ مِنْهُ ، فَإِنَّ ذَلِكَ لَيْسَ كَالنَّفْسِ , أَنْ يَشُجَّ الرَّجُلُ الرَّجُلَ لا يُرِيدُ نَفْسَهُ فَيَتْوَى فِي نَفْسِهِ ، وَإِنَّ هَذَا قَدْ عَمَدَ عَيْنَهُ وَأَسْنَانَهُ ""","","","","","Book of Blood Money (Diyat)"
"16669","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ،  فِيرَجُلٍ قَامَ إِلَى رَجُلٍ بِحَجَرٍ , فَكَسَرَ أَسْنَانَهُ , وَفَقَأَ عَيْنَهُ , قَالَ : "" يُقَادُ مِنْهُ ""","","","","","Book of Blood Money (Diyat)"
"16670","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : شِبْهُ الْعَمْدِ الْحَجَرُ وَالْعَصَا وَالسَّوْطُ وَالدَّفْعَةُ وَالدَّفْقَةُ ، وَكُلُّ شَيْءٍ عَمِدْتَهُ بِهِ فَفِيهِ التَّغْلِيظُ فِي الدِّيَةِ "" , قَالَ : "" وَالْخَطَأُ أَنْ يَرْمِيَ شَيْئًا فَيُخْطِئَ بِهِ ""","","","","","Book of Blood Money (Diyat)"
"16671","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ مَا اسْتَقْبَلْتُهُ مِنَ الدَّفْعَةِ وَالدَّفْقَةِ , قَالَ : لَيْسَ ذَلِكَ شِبْهَ الْعَمْدِ ""","","","","","Book of Blood Money (Diyat)"
"16672","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ عَلِيٍّ ، وَابْنِ مَسْعُودٍ  أَنَّشِبْهَ الْعَمْدِ الْحَجَرُ وَالْعَصَا ""","","","","","Book of Blood Money (Diyat)"
"16673","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : شِبْهُ الْعَمْدِ مُغَلَّظٌ ، وَلا يُقْتَلُ صَاحِبُهُ , وَذَلِكَ أَنْ يَنْزِلَ الشَّيْطَانُ بَيْنَ النَّاسِ , فَيَكُونُ رَمْيًا فِي عَمِيَّا مِنْ غَيْرِ ضَغِينَةٍ ، وَلا حَمْلِ سِلاحٍ , فَمَنْ حَمَلَ عَلَيْنَا السِّلاحَ ، فَلَيْسَ مِنَّا , وَلا رَاصِدٍ بِطَرِيقٍ ، فَمَنْ قُتِلَ عَلَى غَيْرِ هَذَا فَهُوَ شِبْهُ الْعَمْدِ ، وَعَقْلُهُ مُغَلَّظٌ , وَلا يُقْتَلُ صَاحِبُهُ ""","","","","","Book of Blood Money (Diyat)"
"16674","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ طَاوُسًا ، يَقُولُ : الرَّجُلُ يُصَابُ فِي الرَّمِّيَّا فِي الْقِتَالِ بِالْعَصَا ، أَوْ بِالسَّوْطِ ، أَوِ الرَّامِي بِالْحِجَارَةِ , يُودِي ، وَلا يُقْتَلُ بِهِ , مِنْ أَجْلِ أَنَّهُ لا يَعْلَمُ مَنْ قَاتِلَهُ , وَأَقُولُ :  أَلا تَرَى إِلَى قَضَاءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْهُذَلِيَّتَيْنِ ,ضَرَبَتْ إحْدَاهُمَا الأُخْرَى بِعَمُودٍ فَقَتَلَتْهَا , أَنَّهُ لَمْ يَقْتُلْهَا بِهَا , وَوَدَاهَا وَجَنِينَهَا "", أَخْبَرَنَاهُ ابْنُ طَاوُسٍ , عَنْ أَبِيهِ""","","","","","Book of Blood Money (Diyat)"
"16675","لَعَلَّهُ عَنِ ابْنِ جُرَيْجٍ  قَالَ أَبُو سَعِيدٍ : سَقَطَ مِنْ كِتَابِي قَالَ : أَخْبَرَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : عِنْدَ أَبِي كِتَابٌ فِيهِ ذِكْرٌ مِنَ الْعُقُولِ , جَاءَ بِهِ الْوَحْيُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّهُ مَا قَضَى بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ عَقْلٍ , أَوْ صَدَقَةٍ , فَإِنَّهُ جَاءَ بِهِ الْوَحْيُ "" , قَالَ : فَفِي ذَلِكَ الْكِتَابِ , وَهُوَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ""قَتْلُ الْعَمْدِ دِيَتُهُ دِيَةُ الْخَطَإِ , الْحَجَرُ ، وَالْعَصَا ، وَالسَّوْطُ , مَا لَمْ يَحْمِلْ سِلاحًا ""","","","","","Book of Blood Money (Diyat)"
"16676","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : مَنْ قُتِلَ فِي قَتْلِ عِمِّيَّةٍ , رَمْيَةً بِحَجَرٍ أَوْ عَصَا , فَفِيهِ دِيَةٌ مُغَلَّظَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16677","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ قُتِلَ فِي عَمِيَّا , رَمْيًا بِحَجَرٍ , أَوْ ضَرْبًا بِسَوْطٍ , أَوْ بِعَصَا ، فَعَقْلُهُ عَقْلُ الْخَطَإِ , وَمَنْ قُتِلَ اعْتِبَاطًا فَهُوَ قَوَدٌ , لا يُحَالُ بَيْنَهُ وَبَيْنَ قَاتِلِهِ , فَمَنْ حَالَ بَيْنَهُ وَبَيْنَ قَاتِلِهِ فَعَلَيْهِ لَعْنَةُ اللَّهِ , وَالْمَلائِكَةِ ، وَالنَّاسِ أَجْمَعِينَ , لا يَقْبَلُ اللَّهُ مِنْهُ صَرْفًا وَلا عَدْلا ""","","","","","Book of Blood Money (Diyat)"
"16678","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : شِبْهُ الْعَمْدِ الضَّرْبَةُ بِالْعِظَامِ , أَوْ بِالْحَجَرِ , أَوِ السَّوْطِ ""","","","","","Book of Blood Money (Diyat)"
"16679","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ : شِبْهُ الْعَمْدِ الضَّرْبَةُ بِالْخَشَبَةِ الضَّخْمَةِ , وَالْحَجَرِ الْعَظِيمِ ""","","","","","Book of Blood Money (Diyat)"
"16680","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : الْعَمْدُ مَا كَانَ بِسِلاحٍ , وَمَا كَانَ دُونَ حَدِيدَةٍ ، فَهُوَ شِبْهُ الْعَمْدِ الْخَشَبَةُ ، وَالْحَجَرُ , وَالْعَصَا , أَنْ يُرِيدَ شَيْئًا فَيُصِيبَ غَيْرَهُ ، وَلا يَكُونُ شِبْهُ الْعَمْدِ إِلا فِي النَّفْسِ ""","","","","","Book of Blood Money (Diyat)"
"16681","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : الْخَطَأُ أَنْ يَرْمِيَ إِنْسَانًا فَيُصِيبَ غَيْرَهُ , أَوْ يَرْمِيَ شَيْئًا فَيُخْطِئَ بِهِ ""","","","","","Book of Blood Money (Diyat)"
"16682","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : الْخَطَأُ أَنْ تُرِيدَ شَيْئًا فَتُصِيبَ غَيْرَهُ ""","","","","","Book of Blood Money (Diyat)"
"16683","عَنْ مَعْمَرٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ  فِيالْخَطَإِ : أَنْ يُرِيدَ امْرَأً فَيُصِيبَ غَيْرَهُ ""","","","","","Book of Blood Money (Diyat)"
"16684","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : يُغَلَّظُ فِي شِبْهِ الْعَمْدِ الدِّيَةُ , وَلا يُقْتَلُ بِهِ , مَرَّتَيْنِ تَتْرَى "", عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنْ عَلِيٍّ ، وَابْنِ مَسْعُودٍ , كَقَوْلِ عَطَاءٍ""","","","","","Book of Blood Money (Diyat)"
"16685","عَنْ مَعْمَرٍ ، عَنْ عَلِيِّ بْنِ زَيْدٍ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ عُمَرَ , قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى دَرَجِ الْكَعْبَةِ ، وَهُوَ يَقُولُ : الْحَمْدُ للَّهِ الَّذِي أَنْجَزَ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ ، وَهَزَمَ الأَحْزَابَ وَحْدَهُ ، أَلا إِنَّ كُلَّ مَأْثَرَةٍ كَانَتْ فِي الْجَاهِلِيَّةِ ، فَإِنَّهَا تَحْتَ قَدَمِي الْيَوْمَ , إِلا مَا كَانَتْ مِنْ سِدَانَةِ الْبَيْتِ وَسِقَايَةِ الْحَاجِّ , أَلا وَإِنَّ مَا بَيْنَ الْعَمْدِ وَالْخَطَإِ الْقَتْلُ بِالسَّوْطِ وَالْحَجَرِ , فِيهِمَا مِائَةُ بَعِيرٍ , مِنْهَا أَرْبَعُونَ فِي بُطُونِهَا أَوْلادُهَا ""","","","","","Book of Blood Money (Diyat)"
"16686","عَنِ الثَّوْرِيِّ ، عَنِ خَالِدٍ الْحَذَّاءِ ، عَنِ الْقَاسِمِ بْنِ رَبِيعَةَ ، عَنْ عُقْبَةَ بْنِ أَوْسٍ السَّدُوسِيِّ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لَمَّا قَدِمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَكَّةَ ، قَالَ : لا إِلَهَ إِلا اللَّهُ وَحْدَهُ , صَدَقَ وَعْدَهُ , وَنَصْرَ عَبْدَهُ , وَهَزَمَ الأَحْزَابَ وَحْدَهُ , أَلا إِنَّ كُلَّ مَأْثَرَةٍ تُعَدُّ وَتُدْعَى , وَمَالٌ وَدَمٌ تَحْتَ قَدَمَيْ هَاتَيْنِ , إِلا سِدَانَةَ الْبَيْتِ , وَسِقَايَةَ الْحُجَّاجِ , أَلا إِنَّ قَتِيلَ الْخَطَإِ قَتِيلُ السَّوْطِ وَالْعَصَا "", قَالَ الْقَاسِمُ : مِنْهَا أَرْبَعُونَ فِي بُطُونِهَا أَوْلادُهَا ، قَالَ خَالِدٌ : وَقَالَ غَيْرُ الْقَاسِمِ : مِائَةٌ مِنْهَا أَرْبَعُونَ فِي بُطُونِهَا أَوْلادُهَا""","","","","","Book of Blood Money (Diyat)"
"16687","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : الدِّيَةُ الْكُبْرَى الَّتِي غَلَّظَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلاثُونَ حِقَّةً , وَثَلاثُونَ بِنْتَ لَبُونٍ , وَأَرْبَعُونَ خَلِفَةً فَتِيَّةً سَمِينَةً ""","","","","","Book of Blood Money (Diyat)"
"16688","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : وَشِبْهُ الْعَمْدِ ثَلاثُونَ حِقَّةً , وَثَلاثُونَ بِنْتَ لَبُونٍ , وَأَرْبَعُونَ خَلِفَةً ""","","","","","Book of Blood Money (Diyat)"
"16689","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ , قَالَ : فِي الْكِتَابِ الَّذِي عِنْدَ أَبِي وَهُوَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي شِبْهِ الْعَمْدِ , مِثْلَ حَدِيثِ مَعْمَرٍ , وَقَالَ لِي : فِي ذَلِكَ الْكِتَابِ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا اصْطَلَحُوا فِي الْعَمْدِ فَهُوَ عَلَى مَا اصْطَلَحُوا عَلَيْهِ ""","","","","","Book of Blood Money (Diyat)"
"16690","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، أَنَّ عُمَرَ , قَالَ : فِي شِبْهِ الْعَمْدِ ثَلاثُونَ جَذَعَةً , وَثَلاثُونَ حِقَّةً , وَأَرْبَعُونَ مَا بَيْنَ ثَنِيَّةٍ إِلَى بَازِلِ عَامِهَا , كُلُّهَا خَلِفَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16691","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ قَتَلَ عَمْدًا ، فَإِنَّهُ يُدْفَعُ إِلَى أَهْلِ الْقَتِيلِ ، فَإِنْ شَاءُوا قَتَلُوهُ ، وَإِنْ شَاءُوا أَخَذُوا الْعَقْلَ , مِائَةً مِنَ الإِبِلِ , ثَلاثُونَ حِقَّةً , وَثَلاثُونَ جَذَعَةً , وَأَرْبَعُونَ خَلِفَةً ، فَذَلِكَ عَقْلُ الْعَمْدِ إِذَا لَمْ يُقْتَلْ صَاحِبُهُ "", عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، وَالشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ ، عَنْ أَبِي مُوسَى الأَشْعَرِيِّ ، وَالْمُغِيرَةِ بْنِ شُعْبَةَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16692","عَنِ الثَّوْرِيِّ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، وَسُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ ، عَنْ زَيْدٍ , قَالَ : فِي شِبْهِ الْعَمْدِ ثَلاثُونَ حِقَّةً , وَثَلاثُونَ جَذَعَةً , وَأَرْبَعُونَ بَيْنَ ثَنِيَّةِ إِلَى بَازِلِ عَامِهَا , كُلُّهَا خَلِفَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16693","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : أَرْبَعُونَ خَلِفَةً , وَثَلاثُونَ حِقَّةً , وَثَلاثُونَ جَذَعَةً ""","","","","","Book of Blood Money (Diyat)"
"16694","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَلِيٌّ : فِي شِبْهِ الْعَمْدِ ثَلاثٌ وَثَلاثُونَ حِقَّةً , وَثَلاثٌ وَثَلاثُونَ جَذَعَةً , وَأَرْبَعٌ وَثَلاثُونَ مَا بَيْنَ ثَنِيَّةٍ إِلَى بَازِلِ عَامِهَا , كُلُّهَا خَلِفَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16695","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : فِي شِبْهِ الْعَمْدِ خَمْسٌ وَعِشْرُونَ حِقَّةً ، وَخَمْسٌ وَعِشْرُونَ جَذَعَةً ، وَخَمْسٌ وَعِشْرُونَ بِنْتَ مَخَاصٍ ، وَخَمْسٌ وَعِشْرُونَ بِنْتَ لَبُونٍ "", عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي مِجْلَزٍ ، عَنْ أَبِي عُبَيْدَةَ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16696","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ عُثْمَانَ ، وَزَيْدًا ، قَالا : فِي شِبْهِ الْعَمْدِ أَرْبَعُونَ جَذَعَةً خَلِفَةً إِلَى بَازِلِ عَامِهَا , وَثَلاثُونَ حِقَّةً , وَثَلاثُونَ بِنْتَ لَبُونٍ ""","","","","","Book of Blood Money (Diyat)"
"16697","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : إِذَا اصْطَلَحُوا فِي الْعَمْدِ عَلَى شَيْءٍ ، فَهُوَ عَلَى مَا اصْطَلَحُوا عَلَيْهِ , أَقَلُّوا أَوْ أَكْثَرُوا ""","","","","","Book of Blood Money (Diyat)"
"16698","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , فِي تَغْلِيظِ الْبَقَرِ وَالْغَنَمِ , قَالَ : "" الرُّبُعُ وَالسُّدُسُ ""","","","","","Book of Blood Money (Diyat)"
"16699","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : تَغْلِيظُ الْبَقَرِ وَالْغَنَمِ ؟ قَالَ : "" مَا أَعْلَمُهُ ""","","","","","Book of Blood Money (Diyat)"
"16700","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ ، أَنَّ تَغْلِيظَ الْبَقَرِ وَالْغَنَمِ السُّدُسُ ليس فيها ذكر , قال : "" وَإنَّهُ لَتُؤْخَذُ الثَّنِيَّةُ السَّمِينَةُ "" ، قُلْتُ لِدَاوُدَ : أَثَبَتَ مَا تُخْبِرُنِي عَنْ سِنِي الْبَقَرِ وَالْغَنَمِ ؟ قَالَ : "" لَمْ يَزَلْ يَفْعَلُ ذَلِكَ ، وَلا يَعْزِيهِ إِلَى أَحَدٍ سَمِعَهُ مِنْهُ "" , قَالَ : "" يَقُولُهُ النَّاسُ ""","","","","","Book of Blood Money (Diyat)"
"16701","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ ابْنُ شِهَابٍ : عَقْلُ الْخَطَإِ خَمْسَةُ أَخْمَاسٍ : عِشْرُونَ مِنْهَا بِنْتَ لَبُونٍ , وَعِشْرُونَ بِنْتَ مَخَاضٍ , وَعِشْرُونَ حِقَّةً , وَعِشْرُونَ جَذَعَةً , وَعِشْرُونَ ابْنَ لَبُونٍ ""","","","","","Book of Blood Money (Diyat)"
"16702","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : ثَلاثُونَ حِقَّةً , وَثَلاثُونَ بِنْتَ لَبُونٍ ، وَثَلاثُونَ بِنْتَ مَخَاضٍ ، وَعَشْرٌ بَنُو لَبُونٍ ذُكُورٍ ""","","","","","Book of Blood Money (Diyat)"
"16703","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، قَالَ : دِيَةُ الْخَطَإِ مِنَ الإِبِلِ ثَلاثُونَ حِقَّةً ، وَثَلاثُونَ بِنْتَ لَبُونٍ ، وَعِشْرُونَ بِنْتَ مَخَاضٍ ، وَعِشْرُونَ بَنُو لَبُونٍ ذُكُورٌ "", عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ طَاوُسٍ , قَالَ : فِي الْكِتَابِ الَّذِي عِنْدَ أَبِي , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي دِيَةِ الْخَطَإِ , مِثْلَ حَدِيثِ مَعْمَرٍ , عَنِ ابْنِ جُرَيْجٍ , قَالَ : عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي دِيَةِ الْخَطَإِ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16704","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : دِيَةُ الْخَطَإِ مِنَ الإِبِلِ مِائَةٌ : خَمْسٌ وَعِشْرُونَ حِقَّةً ، وَخَمْسٌ وَعِشْرُونَ جَذَعَةً ، وَخَمْسٌ وَعِشْرُونَ بِنْتَ مَخَاضٍ ، وَخَمْسٌ وَعِشْرُونَ ابْنَ لَبُونٍ ذُكُورٌ ""","","","","","Book of Blood Money (Diyat)"
"16705","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَلِيٌّ : فِي الْخَطَإِ خَمْسٌ وَعِشْرُونَ حِقَّةً ، وَخَمْسٌ وَعِشْرُونَ جَذَعَةً ، وَخَمْسٌ وَعِشْرُونَ بِنْتَ مَخَاضٍ ، وَخَمْسٌ وَعِشْرُونَ بِنْتَ لَبُونٍ ""","","","","","Book of Blood Money (Diyat)"
"16706","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ فِي كِتَابٍ لِعُمَرَ بْنِ الْخَطَّابِ , عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : دِيَةُ الْمُسْلِمِ مِائَةٌ مِنَ الإِبِلِ أَرْبَاعٌ "" , مِثْلُ قَوْلِ عَلِيٍّ هَذَا , وَزَادَ : "" فَإِنْ لَمْ تُوجَدْ بِنْتُ الْمَخَاضِ , جُعِلَ مَكَانَهَا بَنُو لَبُونٍ ذُكُورٌ ""","","","","","Book of Blood Money (Diyat)"
"16707","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : فِي الْعَمْدِ أَخْمَاسًا : عِشْرُونَ حِقَّةً ، وَعِشْرُونَ جَذَعَةً ، وَعِشْرُونَ بَنَاتَ مَخَاضٍ ، وَعِشْرُونَ ابْنَ مَخَاضٍ ، وَعِشْرُونَ بِنْتَ لَبُونٍ ""","","","","","Book of Blood Money (Diyat)"
"16708","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  فِيدِيَةِ الْخَطَإِ ثَلاثُونَ جَذَعَةً ، وَثَلاثُونَ حِقَّةً ، وَثَلاثُونَ بِنْتَ لَبُونٍ ، وَعَشْرٌ بَنُو لَبُونٍ ذُكُورٌ ""","","","","","Book of Blood Money (Diyat)"
"16709","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قَالَ : الدِّيَةُ مِنَ الْبَقَرِ مِائَتَا بَقَرَةٍ ""","","","","","Book of Blood Money (Diyat)"
"16710","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا : الدِّيَةُ مِنَ الْبَقَرِ مِائَتَا بَقَرَةٍ "" , وَقَالَ قَتَادَةُ : "" تُؤْخَذُ الثَّنِيَّةُ فَصَاعِدًا ""","","","","","Book of Blood Money (Diyat)"
"16711","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ كَانَ عَقْلُهُ فِي الْبَقَرِ فَمِائَتَا بَقَرَةٍ "", قَالَ : وَقَالَ أَبُو بَكْرٍ مَنْ كَانَ عَقْلُهُ فِي الْبَقَرِ فَكُلُّ بَعِيرٍ بِبَقَرَتَيْنِ ، وَقَالَ عُمَرُ بْنُ الْخَطَّابِ : عَلَى أَهْلِ الْبَقَرِ مِائَتَا بَقَرَةٍ""","","","","","Book of Blood Money (Diyat)"
"16712","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الشَّعْبِيِّ ، عَنْ عُمَرَ , قَالَ : عَلَى أَهْلِ الْبَقَرِ مِائَتَا بَقَرَةٍ "", قَالَ سُفْيَانُ : وَسَمِعْنَا أَنَّهَا مُسِنَّةٌ""","","","","","Book of Blood Money (Diyat)"
"16713","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ مَكْحُولٍ , قَالَ :  مِائَتَا بَقَرَةٍ "" , قَالَ مَعْمَرٌ : وَقَالَ عَمْرُو بْنُ شُعَيْبٍ : "" فِيالْخَطَإِ الْجَذَعُ ، وَالثَّنِيُّ ، وَفِي الْمُغَلَّظَةِ خِيَارُ الْمَالِ ""","","","","","Book of Blood Money (Diyat)"
"16714","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ , فِيأَسْنَانِ الْبَقَرِ ، قَالَ عُمَرُ بْنُ الْخَطَّابِ :  مِائَتَا بَقَرَةٍ , مِائَةُ جَذَعَةٍ ، وَمِائَةُ مُسِنَّةٍ ""","","","","","Book of Blood Money (Diyat)"
"16715","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ  أَنَّأَسْنَانَ الْبَقَرِ رُبُعٌ تَوَابِعُ ، وَرُبُعٌ مَا أَعَانَتْ بِهِ الْعَشِيرَةُ , مِنْ صَغِيرٍ أَوْ كَبِيرٍ أَوْ ثَنِيٍّ ، وَمَا بَقِي مِنْ وَسَطِ الْمَالِ "" , قَالَ : "" يَقُولُهُ النَّاسُ "", قَالَ عَبْدُ الرَّزَّاقِ : يَعْنِي : مَا شِئْتَ مِنْ صَغِيرَةٍ أَوْ كَبِيرَةٍ""","","","","","Book of Blood Money (Diyat)"
"16716","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : الدِّيَةُ مِنَ الشَّاءِ أَلْفَا شَاةٍ "", عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ مِثْلَهُ , وَقَالَ قَتَادَةُ : "" تُؤْخَذُ الثَّنِيَّةُ فَصَاعِدًا ، وَلا تُؤْخَذُ عَوْرَاءُ , وَلا هَرِمَةٌ ، وَلا تَيْسٌ ""","","","","","Book of Blood Money (Diyat)"
"16717","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ كَانَ عَقْلُهُ مِنَ الشَّاةِ ، فَأَلْفَا شَاةٍ "", وَقَالَ أَبُو بَكْرٍ : مَنْ كَانَ عَقْلُهُ مِنَ الشَّاةِ فَكُلُّ بَعِيرٍ بِعِشْرِينَ شَاةً ، وَقَالَ عُمَرُ بْنُ الْخَطَّابِ : عَلَى أَهْلِ الشَّاءِ أَلْفَا شَاةٍ""","","","","","Book of Blood Money (Diyat)"
"16718","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ عُمَرَ , قَالَ : عَلَى أَهْلِ الشَّاةِ أَلْفَا شَاةٍ ""","","","","","Book of Blood Money (Diyat)"
"16719","عَنْ مَعْمَرٍ ، عَنْ يَعْلَى ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، رَفَعَهُ إِلَى عُمَرَ بْنِ الْخَطَّابِ , قَالَ : يُؤْخَذُ الثَّنِيُّ وَالْجَذَعُ , كَمَا يُؤْخَذُ فِي الصَّدَقَةِ يُؤْخَذُ فِي دِيَةِ الْخَطَإِ ""","","","","","Book of Blood Money (Diyat)"
"16720","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي عَاصِمٍ  أَنَّأَسْنَانَ دِيَةِ الْغَنَمِ رُبُعُ مَا جَازَ الْوَادِي مِنْ صَغِيرٍ أَوْ كَبِيرٍ ، وَرُبُعُ مَا أَعَانَتْ بِهِ الْعَشِيرَةُ مِنْ صَغِيرٍ ، وَكَبِيرٍ ، وَفَارِضٍ ، وَمَا بَقِي مِنْ وَسَطِ الْمَالِ ""، لَيْسَ فِيهِ ذِكْرٌ , قَالَ : "" لَمْ يَزَلْ يَقُولُهُ , وَيَقُولُهُ النَّاسُ ""","","","","","Book of Blood Money (Diyat)"
"16721","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ ابْنُ شِهَابٍ ، قَالَ عُمَرُ بْنُ الْخَطَّابِ : عَقْلُ الدِّيَةِ فِي الشَّاةِ أَلْفَا شَاةٍ ""","","","","","Book of Blood Money (Diyat)"
"16722","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ :  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَقَضَى فِي النَّفْسِ بِالدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16723","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : كَانَتِ الدِّيَةُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِائَةَ بَعِيرٍ , لِكُلِّ بَعِيرٍ أُوقِيَةٌ ، فَذَلِكَ أَرْبَعَةُ آلافٍ ""، فَلَمَّا كَانَ عُمَرُ غَلَتِ الإِبِلُ ، وَرَخُصَتِ الْوَرِقُ ، فَجَعَلَهَا عُمَرُ وُقِيَةً وَنِصْفًا ، ثُمَّ غَلَتِ الإِبِلُ ، وَرَخُصَتِ الْوَرِقُ أَيْضًا ، فَجَعَلَهَا عُمَرُ أُوقِيَتَيْنِ ، فَذَلِكَ ثَمَانِيَةُ آلافٍ ، ثُمَّ لَمْ تَزَلِ الإِبِلُ تَغْلُو ، وَتَرْخُصُ الْوَرِقُ حَتَّى جَعَلَهَا اثْنَيْ عَشَرَ أَلْفًا , أَوْ أَلْفَ دِينَارٍ ، وَمِنَ الْبَقَرِ مِائَتَا بَقَرَةٍ ، وَمِنَ الشَّاةِ أَلْفَ شَاةٍ ""","","","","","Book of Blood Money (Diyat)"
"16724","عَنِ ابْنِ جُرَيْجٍ ، قَالَ عَطَاءٌ : كَانَتِ الدِّيَةُ مِنَ الإِبِلِ , حَتَّى كَانَ عُمَرُ بْنُ الْخَطَّابِ , فَجَعَلَهَا لَمَّا غَلَتِ الإِبِلُ عِشْرِينَ وَمِائَةً لِكُلِ بَعِيرٍ "", قَالَ : قُلْتُ لِعَطَاءٍ : وَإِنْ شَاءَ الْقَرَوِيُّ أَعْطَى مِائَةَ نَاقَةٍ , أَوْ مِائَتَيْ بَقَرَةٍ ، أَوْ أَلْفَيْ شَاةٍ ، وَلَمْ يُعْطِ ذَهَبًا ؟ قَالَ : "" إِنْ شَاءَ أَعْطَى إِبِلا ، وَلَمْ يُعْطِ ذَهَبًا , هُوَ الأَمْرُ الأَوَّلُ ""","","","","","Book of Blood Money (Diyat)"
"16725","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَفَيُعْطِي الْقَرَوِيُّ إِنْ شَاءَ بَقَرًا أَوْ غَنَمًا ؟ قَالَ :  لا , لا يَتَعَاقَلُ أَهْلُ الْقُرَى مِنَ الْمَاشِيَةِ غَيْرَ الإِبِلِ "" , يَقُولُ : "" هُوَ عَقْلُهُمْ عَلَى عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Blood Money (Diyat)"
"16726","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : كَانَ يُقَالُ : عَلَى أَهْلِ الإِبِلِ الإِبِلُ ، وَعَلَى أَهْلِ الْبَقَرِ الْبَقَرُ ، وَعَلَى أَهْلِ الشَّاةِ الشَّاةُ ""","","","","","Book of Blood Money (Diyat)"
"16727","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : عَلَى أَهْلِ الإِبِلِ الإِبِلُ ، وَعَلَى أَهْلِ الذَّهَبِ الذَّهَبُ ، وَعَلَى أَهْلِ الْوَرِقِ الْوَرِقُ ، وَعَلَى أَهْلِ الْغَنَمِ الْغَنَمُ ، وَعَلَى أَهْلِ الْبَزِّ الْحُلَلُ ""","","","","","Book of Blood Money (Diyat)"
"16728","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنِ الْحَسَنِ , قَالَ : إِنْ شَاءَ صَاحِبُ الْبَقَرِ أَوِ الشَّاةِ أَعْطَى الإِبِلَ ""","","","","","Book of Blood Money (Diyat)"
"16729","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : مِائَةُ بَعِيرٍ أَوْ قِيمَةُ ذَلِكَ مِنْ غَيْرِهِ ""","","","","","Book of Blood Money (Diyat)"
"16730","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ :  جَعَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَالدِّيَةُ مِائَةٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16731","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ قَضَى عَلَى أَهْلِ الْوَرِقِ عَشَرَةَ آلافٍ ، وَعَلَى الدَّنَانِيرِ أَلْفَ دِينَارٍ ، وَعَلَى أَهْلِ الْحُلَلِ مِائَتَيْ حُلَّةٍ ، وَعَلَى أَهْلِ الْبَقَرِ مِائَتَيْ بَقَرَةٍ "" , قَالَ : "" وَسَمِعْنَا أَنَّهَا سُنَّةٌ ، وَعَلَى أَهْلِ الشَّاءِ أَلْفَيْ شَاةٍ , وَسَمِعْتُ أَنَّهَا سُنَّةٌ ، وَعَلَى أَهْلِ الإِبِلِ مِائَةً مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16732","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ :  قَضَى أَبُو بَكْرٍمَكَانَ كُلِّ بَعِيرٍ بَقَرَتَيْنِ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنِ أَبِي بَكْرٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16733","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : سَمِعْتُ طَاوُسًا , يَقُولُ : دِيَةُ الْحِمْيَرِيِّ ثَلاثُمِائَةِ حُلَّةٍ مِنْ حُلَلِ الثَّلاثِ ""","","","","","Book of Blood Money (Diyat)"
"16734","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً , قَالَ : قُلْتُ :الْبَدَوِيُّ صَاحِبُ الْبَقَرِ وَالشَّاةِ , أَلَهُ أَنْ يُعْطِيَ إِبِلا إِنْ شَاءَ ، وَإِنْ كَرِهَ الْمُتَبِعُ الْمَعْقُولَ لَهُ ؟ قَالَ :  هُوَ لَهُ حَقٌّ "" , قَالَ : "" مَا نَرَى إِلا أَنَّهُ مَا شَاءَ الْمَعْقُولُ لَهُ هُوَ حَقُّهُ ، لَهُ مَاشِيَةُ الْعَاقِلِ مَا كَانَتْ ، لا تُصْرَفُ إِلَى غَيْرِهَا إِنْ شَاءَ ""","","","","","Book of Blood Money (Diyat)"
"16735","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ كَانَ يَقُولُ : عَلَى النَّاسِ أَجْمَعِينَ أَهَلِ الْقَرْيَةِ ، أَوِ الْبَادِيَةِ مِائَةٌ مِنَ الإِبِلِ ، فَمَنْ لَمْ يَكُنْ عِنْدَهُ إِبِلٌ ، فَعَلَى أَهْلِ الْوَرِقِ الْوَرِقُ ، وَعَلَى أَهْلِ الْبَقَرِ الْبَقَرُ ، وَعَلَى أَهْلِ الْغَنَمِ الْغَنَمُ ، وَعَلَى أَهْلِ الْبَزِّ الْبَزُّ "" , قَالَ : "" يُعْطُونَ مِنْ أَيِّ صِنْفٍ كَانَ , بِقِيمَةِ الإِبِلِ مَا كَانَتْ ، إِنِ ارْتَفَعَتْ أَوِ انْخَفَضَتْ قِيمَتُهَا يَوْمَئِذٍ ""","","","","","Book of Blood Money (Diyat)"
"16736","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لابْنِ طَاوُسٍ , أَهْلُ الطَّعَامِ الذُّرَةُ عَلَيْهِمْ طَعَامٌ ؟ قَالَ :  لَمْ أَسْمَعْ بِذَلِكَ "" , قَالَ ابْنُ طَاوُسٍ : قَالَ أَبُوهُ : ""فَمَنِ اتَّقَى بِالإِبِلِ مِنَ النَّاسِ ، فَهُوَ حَقُّ الْمَعْقُولِ لَهُ الإِبِلُ ""","","","","","Book of Blood Money (Diyat)"
"16737","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَمْرُو بْنُ شُعَيْبٍ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يُقِيمُ الإِبِلَ عَلَى أَهْلِ الْقُرَى أَرْبَعَ مِائَةِ دِينَارٍ , أَوْ عَدْلَهَا مِنَ الْوَرَقِ ، وَيُقِيمُهَا عَلَى أَثْمَانِ الإِبِلِ ، فَإِذَا غَلَتْ رَفَعَ ثَمَنَهَا ، وَإِذَا هَانَتْ نَقُصَ مِنَ قِيمَتِهَا عَلَى أَهْلِ الْقُرَى , عَلَى نَحْوِ الثَّمَنِ مَا كَانَ "", قَالَ : وَقَضَى أَبُو بَكْرٍ فِي الدِّيَةِ عَلَى أَهْلِ الْقُرَى حِينَ كَثُرَ الْمَالُ ، وَغَلَتِ الإِبِلُ , فَأَقَامَ مِائَةً مِنَ الإِبِلِ سِتَّ مِائَةِ دِينَارٍ إِلَى ثَمَانِ مِائَةٍ , وَقَضَى عُمَرُ فِي الدِّيَةِ عَلَى أَهْلِ الْقُرَى اثْنَيْ عَشَرَ أَلْفًا ، وَقَالَ : إِنِّي أَرَى الزَّمَانَ تَخْتَلِفُ فِيهِ الدِّيَةُ ، تَنْخَفِضُ فِيهِ مِنْ قِيمَةِ الإِبِلِ ، وَتَرْتَفِعُ فِيهِ , وَأَرَى الْمَالَ قَدْ كَثُرَ ، وَأَنَا أَخْشَى عَلَيْكُمُ الْحُكَّامَ بَعْدِي ، وَأَنْ يُصَابَ الرَّجُلُ الْمُسْلِمُ فَتَهْلَكَ دِيَتُهُ بِالْبَاطِلِ ، وَأَنْ تَرْتَفَعَ دِيَتُهُ بِغَيْرِ حَقٍّ ، فَتُحْمَلَ عَلَى قَوْمٍ مُسْلِمِينَ فَتَجْتَاحُهُمْ , فَلَيْسَ عَلَى أَهْلِ الْقُرَى زِيَادَةٌ فِي تَغْلِيظِ عَقْلٍ ، وَلا فِي الشَّهْرِ الْحَرَامِ ، وَلا فِي الْحَرَمِ ، وَلا عَلَى أَهْلِ الْقُرَى فِيهِ تَغْلِيظٌ , لا يُزَادُ فِيهِ عَلَى اثْنَيْ عَشَرَ أَلْفًا ، وَعَقْلُ أَهْلِ الْبَادِيَةِ عَلَى أَهْلِ الإِبِلِ مِائَةٌ مِنَ الإِبِلِ عَلَى أَسْنَانِهَا ، كَمَا قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَعَلَى أَهْلِ الْبَقَرِ مِائَتَا بَقَرَةٍ ، وَعَلَى أَهْلِ الشَّاءِ أَلْفَا شَاةٍ ، وَلَوْ أُقِيمَ عَلَى أَهْلِ الْقُرَى إِلا عَقْلَهُمْ يَكُونُ ذَهَبًا وَوَرِقًا , فَيُقَامُ عَلَيْهِمْ ، وَلَوْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَضَى عَلَى أَهْلِ الْقُرَى فِي الذَّهَبِ وَالْوَرِقِ عَقْلا مُسَمَّى لا زِيَادَةَ فِيهِ , لاتَّبَعْنَا قَضَاءَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ ، وَلَكِنَّهُ كَانَ يُقِيمُهُ عَلَى أَثْمَانِ الإِبِلِ""","","","","","Book of Blood Money (Diyat)"
"16738","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : فَرَضَ الدِّيَةَ مِنَ الذَّهَبِ أَلْفَ دِينَارٍ ، وَمِنَ الْوَرِقِ اثْنَيْ عَشَرَ أَلْفًا ""","","","","","Book of Blood Money (Diyat)"
"16739","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ فِي كِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ شَاوَرَ السَّلَفَ حِينَ جَنَّدَ الأَجْنَادَ ، فَكَتَبَ :  أَنَّعَلَى أَهْلِ الإِبِلِ مِائَةً مِنَ الإِبِلِ ، وَعَلَى أَهْلِ الْبَقَرِ مِائَتَا بَقَرَةٍ ، وَعَلَى أَهْلِ الشَّاةِ أَلْفَا شَاةٍ ، وَعَلَى مَنْ نَسَجَ الْبَزَّ مِنْ أَهْلِ الْيَمَنِ بِقِيمَةِ خَمْسِ مِائَةِ حُلَّةٍ ، أَوْ قِيمَةِ ذَلِكَ مِمَّا سُوَى الْحُلَلِ ، فَإِنْ كَانَ الَّذِي أَصَابَهُ مِنَ الأَعْرَابِ فَدِيَتُهُ مِنَ الإِبِلِ , لا يُكَلَّفُ الأَعْرَابِيُّ الذَّهَبَ وَلا الْوَرِقَ , وَإِذَا أَصَابَهُ الأَعْرَابِيُّ وَدَاهُ بِمِائَةٍ مِنَ الإِبِلِ ، فَإِنْ لَمْ يَجِدْ إِبِلا فَعِدْلُهَا مِنَ الْغَنَمِ أَلْفَا شَاةٍ "", وَقَضَى عُثْمَانُ فِي التَّغْلِيظِ الدِّيَةَ بِأَرْبَعَةِ آلافِ دِرْهَمٍ""","","","","","Book of Blood Money (Diyat)"
"16740","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عِكْرِمَةَ , قَالَ :قَتَلَ مَوْلًى لِبَنِي عَدِيِّ بْنِ كَعْبٍ رَجُلا مِنَ الأَنْصَارِ  فَقَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي دِيَتِهِ اثْنَيْ عَشَرَ أَلْفَ دِرْهَمٍ "" , وَقَالَ : وَهُوَ الَّذِي يَقُولُ :  وَمَا نَقَمُوا إِلا أَنْ أَغْنَاهُمُ اللَّهُ وَرَسُولُهُ مِنْ فَضْلِهِ ""","","","","","Book of Blood Money (Diyat)"
"16741","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : لَيْسَ عَلَى أَهْلَ الْقُرَى تَغْلِيظٌ لأَنَّ الذَّهَبَ عَلَيْهِمْ ، وَالذَّهَبُ تَغْلِيظٌ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، عَنْ عُمَرَ مَثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16742","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ : لا تُغَلَّظُ الدِّيَةُ إِلا فِي أَسْنَانِ الإِبِلِ , لا فِي الذَّهَبِ ، وَلا فِي الْوَرِقِ , إِنَّمَا الذَّهَبُ وَالْوَرِقُ تَغْلِيظٌ ""","","","","","Book of Blood Money (Diyat)"
"16743","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  قَضَى عُثْمَانُفِي تَغْلِيظِ الدِّيَةِ بِأَرْبَعَةِ آلافِ دِرْهَمٍ ""","","","","","Book of Blood Money (Diyat)"
"16744","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ،  أَنَّهُ كَانَيُغَلِّظُ فِي دِيَةِ الْجَارِ ، وَالَّذِي يُقْتَلُ فِي الشَّهْرِ الْحَرَامِ ""","","","","","Book of Blood Money (Diyat)"
"16745","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَعَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالا : مَنْ قُتِلَ فِي الشَّهْرِ الْحَرَامِ ، وَمَنْ قُتِلَ وَهُوَ مُحْرِمٌ ، وَمَنْ قُتِلَ فِي الْحَرَمِ , فَالدِّيَةُ وَثُلُثُ الدِّيَةِ "", عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16746","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ : مَنْ قُتِلَ فِي الْحَرَمِ فَالدِّيَةُ وَثُلُثُ الدِّيَةِ ، وَمَنْ قُتِلَ مُحْرِمًا فَالدِّيَةُ مُغَلَّظَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16747","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ أَبِيهِ , قَالَ : أَوْطَأَ رَجُلٌ امْرَأَةً فَرَسًا فِي الْمَوْسِمِ , فَكَسَرَ ضِلْعًا مِنْ أَضْلاعِهَا ، فَمَاتَتْ ، فَقَضَى عُثْمَانُ فِيهَا بِثَمَانِيَةِ آلافِ دِرْهَمٍ , لأَنهَا كَانَتْ فِي الْحَرَمِ ، جَعَلَهَا الدِّيَةَ وَثُلُثَ الدِّيَةِ "", عَنِ الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ أَبِيهِ مِثْلَهُ , إِلا أَنَّ ابْنَ عُيَيْنَةَ , قَالَ : بِمَكَّةَ فِي ذِي الْقَعْدَةِ""","","","","","Book of Blood Money (Diyat)"
"16748","أَخْبَرَنَا ابْنُ جُرَيْجٍ قَالَ : قَالَ لِي عَطَاءٌ  فِيالرَّجُلِ يَقْتُلُ جَارَهُ : فِيهِ تَغْلِيظٌ , زَعَمُوا , قُلْتُ : فَذَا رَحِمٌ ؟ قَالَ "" بَلَغَنَا أَنَّ فِيهِ تَغْلِيظًا "" , قُلْتُ : فَابْنُ عَمَّةٍ ؟ قَالَ : "" نَعَمْ , فِي كُلِّ ذِي رَحِمٍ تَغْلِيظٌ ""","","","","","Book of Blood Money (Diyat)"
"16749","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : قَالَ لِي : تَغْلِيظٌ فِي الشَّهْرِ الْحَرَامِ , وَفِي الْحَرَمِ ""","","","","","Book of Blood Money (Diyat)"
"16750","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، وَسُلَيْمَانُ الأَحْوَلُ ، أَنَّهُمَا سَمِعَا طَاوُسًا , يَقُولُ :  فِيالْحَرَمِ , وَفِي الْجَارِ ، وَفِي الشَّهْرِ الْحَرَامِ تَغْلِيظٌ "", عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ طَاوُسٍ مِثْلَهُ , وَزَادَ فِيهِ قَالَ : "" تَغْلِيظٌ فِي أَسْنَانِ الإِبِلِ ، وَلا يُزَادُ فِي الدِّيَةِ شَيْئًا ""","","","","","Book of Blood Money (Diyat)"
"16751","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , أَنَّهُ كَانَ يَقُولُ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : فِي الْجَارِ وَالشَّهْرِ الْحَرَامِ تَغْلِيظٌ ""","","","","","Book of Blood Money (Diyat)"
"16752","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ ، أَوْ سَأَلَهُ رَجُلٌ , عَنْرَجُلٍ قَتَلَ جَارًا لَهُ فِي الشَّهْرِ الْحَرَامِ ، وَفِي الْحَرَمِ ، فَقَالَ ابْنُ عَبَّاسٍ :  لا أَدْرِي, فَكَانَ ابْنُ طَاوُسٍ لا يَقُولُ فِيهَا شَيْئًا ""","","","","","Book of Blood Money (Diyat)"
"16753","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : إِنْ قَتَلَ حَلالٌ حَرَامًا غُلِّظَتْ دِيَتُهُ ، وَإِنْ قَتَلَ حَرَامٌ حَلالا غُلِّظَ فِي دِيَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"16754","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : فِي الْجِرَاحِ تَغْلِيظٌ فِي الشَّهْرِ الْحَرَامِ ""","","","","","Book of Blood Money (Diyat)"
"16755","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , أَنَّهُ قَالَ : فِي وَجْهِ الْمَرْأَةِ تَغْلِيظٌ "" , وَأَنَّهُ قَالَ : "" فِي الشَّفَةِ السُّفْلَى تَغْلِيظٌ فِيهَا مِنَ الرَّجُلِ ، وَالْمَرْأَةِ "" , وَكَانَ يَقُولُ : "" التَّغْلِيظُ لَيْسَ بِزِيَادَةٍ فِي عَدَدِ الْمَالِ ، وَلَكِنْ فِي تَفْضِيلِ الإِبِلِ , فَكُلُّ اثْنَيْنِ قَدْرُهُمَا سَوَاءٌ , فَفَضُلَ أَحَدُهُمَا ، فَإِنَّمَا هُوَ تَغْلِيظٌ ، وَلَيْسَ بِزِيَادَةٍ فِي عَدَدِ الْمَالِ ""","","","","","Book of Blood Money (Diyat)"
"16756","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ شُعَيْبٍ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لَيْسَ عَلَى أَهْلِ الْقُرَى زِيَادَةٌ فِي تَغْلِيظِ عَقْلٍ ، وَلا فِي الشَّهْرِ الْحَرَامِ ، وَلا فِي الْحَرَمِ ""","","","","","Book of Blood Money (Diyat)"
"16757","عَنْ مَعْمَرٍ ، عَنْ لَيْثٍ ، عَنْ مُجَاهِدٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : قَضَى فِيمَنْ قُتِلَ فِي الشَّهْرِ الْحَرَامِ , أَوْ فِي الْحَرَمِ , أَوْ هُوَ مُحْرِمٌ , بِالدِّيَةِ وَثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16758","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ ، وَأَشْعَثَ ، عَنِ الشَّعْبِيِّ اتَّفَقَا عَلَى أَنَّهُ لا تَغْلِيظَ فِي الْحَرَمِ ، وَلا فِي الْمُحْرِمِ ، وَلا فِي أَشْبَاهِ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"16759","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ ، وَسُلَيْمَانَ بْنِ يَسَارٍ ، وَعَطَاءِ بْنِ أَبِي رَبَاحٍ , قَالُوا : مَنْ قُتِلَ فِي الشَّهْرِ الْحَرَامِ فِدِيَةٌ وَثُلُثٌ "", قَالَ قَتَادَةُ : فَذَكَرْتُ ذَلِكَ لِلْحَسَنِ , فَقَالَ : مَا أَعْرِفُ هَذَا""","","","","","Book of Blood Money (Diyat)"
"16760","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : مَا أُصِيبَ مِنْ مَوَاشِي النَّاسِ وَأَمْوَالِهِمْ فِي الشَّهْرِ الْحَرَامِ ، فَإِنَّهُ يُزَادُ الثُّلُثُ , هَذَا فِي الْعَمْدِ ""","","","","","Book of Blood Money (Diyat)"
"16761","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ، أَنَّ عُثْمَانَ أَغْرَمَ فِي نَاقَةِ مُحْرِمٍ أَهْلَكَهَا رَجُلٌ ، فَأَغْرَمَهُ الثُّلُثَ زِيَادَةً عَلَى ثَمَنِهَا ""","","","","","Book of Blood Money (Diyat)"
"16762","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ , قَالَ : أُتِيَ عُثْمَانُ بِرَجُلٍ ضَمَّ إِلَيْهِ ضَالَةَ رَجُلٍ فِي الشَّهْرِ الْحَرَامِ ، فَأُصِيبَتْ عِنْدَهُ , فَغَرِمَهَ ثَمَنَهَا ، وَمِثْلَ ثُلُثِ ثَمَنِهَا ""","","","","","Book of Blood Money (Diyat)"
"16763","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ مُسْلِمٍ ، عَنْ طَاوُسٍ ، وَعِكْرِمَةَ ، أَنَّهُ سَمِعَهُمَا يَقُولانِ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :فِي الضَّالَّةِ الْمَكْتُومَةِ مِنَ الإِبِلِ : فَدِيَتُهَا مِثْلُهَا إِنْ أَدَّاهَا بَعْدَمَا يَكْتُمُهَا , أَوْ وُجِدَتْ عِنْدَهُ ، فَعَلَيْهِ قَرِينَتُهَا مِثْلُهَا","","","","","Book of Blood Money (Diyat)"
"16764","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : شَهْرُ اللَّهِ الأَصَمُّ رَجَبٌ "" , قَالَ : "" وَكَانَ الْمُسْلِمُونَ يُعَظِّمُونَ الأَشْهُرَ الْحُرُمَ , لأَنَّ الظُّلْمَ فِيهَا أَحَدُّ "" , قَالَ : "" وَمَنْ قُتِلَ فِي شَهْرٍ حَلالٍ , أَوْ جُرِحَ لَمْ يُقْتَلْ فِي شَهْرٍ حَرَامٍ , حَتَّى يَجِيءَ شَهْرٌ حَلالٌ , قَالَ اللَّهُ تَعَالَى :  الشَّهْرُ الْحَرَامُ بِالشَّهْرِ الْحَرَامِ ""","","","","","Book of Blood Money (Diyat)"
"16765","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : أَخْبَرَنِي  أَنَّرَجُلا جُرِحَ فِي شَهْرٍ حَلالٍ ، فَأَرَادَ عُثْمَانُ بنُ مُحَمَّدٍ ، وَهُوَ أَمِيرٌ أَنْ يُقَيِّدَهُ فِي شَهْرٍ حَرَامٍ ، فَأَرْسَلَ إِلَيْهِ عُبَيْدُ بْنُ عُمَيْرٍ ، وَهُوَ فِي طَائِفَةِ الدَّارِ , لا تُقِدْهُ حَتَّى يَدْخُلَ شَهْرٌ حَلالٌ ""","","","","","Book of Blood Money (Diyat)"
"16766","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَرَأَيْتَ الرَّجُلَ يُقْتَلُ فِي الْحَرَمِ , أَيْنَ يُقْتَلُ قَاتِلُهُ ؟ قَالَ  حَيْثُ شَاءَ أَهْلُ الْمَقْتُولِ "" , قَالَ : "" وَإِنْ قَتَلَ فِي الْحِلِّ لَمْ يُقْتَلْ فِي الْحَرَمِ , وَكَذَلِكَ أَشْهُرُ الْحُرُمِ مِثْلُ الْحَرَمِ فِي ذَلِكَ "", عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16767","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : مَنْ قَتَلَ فِي الْحَرَمِ قُتِلَ فِي الْحَرَمِ ، وَمَنْ قُتِلَ فِي الْحِلِّ ، ثُمَّ دَخَلَ فِي الْحَرَمِ أُخْرِجَ إِلَى الْحِلِّ "" , فَيُقْتَلُ : قَالَ : "" تِلْكَ السُّنَّةُ ""","","","","","Book of Blood Money (Diyat)"
"16768","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : مَنْ قَتَلَ أَوْ سَرَقَ فِي الْحِلِّ ، ثُمَّ دَخَلَ الْحَرَمَ , فَإِنَّهُ لا يُجَالَسُ ، وَلا يُكَلَّمُ ، وَلا يُؤْوَى , وَيُنَاشَدُ حَتَّى يَخْرُجَ , فَيُقَامُ عَلَيْهِ ، وَمَنْ قَتَلَ أَوْ سَرَقَ فَأُخِذَ فِي الْحِلِّ فَأُدْخِلَ الْحَرَمَ ، فَأَرَادُوا أَنْ يُقِيمُوا عَلَيْهِ مَا أَصَابَ , أُخْرِجَ مِنَ الْحَرَمِ إِلَى الْحِلِّ ، وَإِنْ قُتِلَ فِي الْحَرَمِ أَوْ سَرَقَ أُقِيمَ عَلَيْهِ فِي الْحَرَمِ ""","","","","","Book of Blood Money (Diyat)"
"16769","أَخْبَرَنَا ابْنُ عُيَيْنَةَ ، عَنِ ابْنِ طَاوُسٍ ، وَإِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ،فِيمَنْ قَتَلَ فِي الْحِلِّ ثُمَّ دَخَلَ فِي الْحَرَمِ ، قَالَ :  لا يُجَالَسُ , وَلا يُكَلَّمُ , وَلا يُبَايَعُ , وَلا يُؤْوَى "", قَالَ ابْنُ طَاوُسٍ : وَيُذَكَّرُ , وَقَالَ إِبْرَاهِيمُ : يُؤْتَى إِلَيْهِ فَيُقَالُ : يَا فُلانُ ، اتَّقِي اللَّهَ فِي دَمِ فُلانٍ اخْرُجْ مِنَ الْمَحَارِمِ""","","","","","Book of Blood Money (Diyat)"
"16770","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، وَمُطَرِّفٍ ، عَنِ الشَّعْبِيِّ , قَالَ : إِذَا قَتَلَ فِي الْحَرَمِ أَوْ أَصَابَ حَدًّا فِي الْحَرَمِ , أُقِيمَ عَلَيْهِ فِي الْحَرَمِ ، وَإِذَا قَتَلَ فِي غَيْرِ الْحَرَمِ ثُمَّ دَخَلَ الْحَرَمَ أَمِنَ ""","","","","","Book of Blood Money (Diyat)"
"16771","أَخْبَرَنَا مَعْمَرٌ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، قَالَ : ابْنُ عَبَّاسٍ عَلَى ابْنِ الزُّبَيْرِ فِي رَجُلٍ أَخَذَهُ فِي الْحِلِّ ، ثُمَّ أَدَخَلَهُ الْحَرَمَ ، ثُمَّ أَخْرَجَهُ إِلَى الْحِلِّ فَقَتَلَهُ  , فَقَالَ :"" أَدَخَلَهُ الْحَرَمَ ، ثُمَّ أَخْرَجَهُ إِلَى الْحِلِّ فَقَتَلَهُ "" , أَيْ يَقُولُ : "" أَدَخَلَهُ بِأَمَانٍ ، ثُمَّ أَخْرَجَهُ , وَكَانَ ذَلِكَ الرَّجُلُ اتَّهَمَهُ ابْنُ الزُّبَيْرِ فِي بَعْضِ الأَمْرِ ، وَأَعَانَ عَلَيْهِ عَبْدَ الْمَلِكِ , فَكَانَ ابْنُ عَبَّاسٍ لَمْ يَرَ عَلَيْهِ قَتْلا ، فَلَمْ يَلْبَثْ بَعْدَهُ ابْنُ الزُّبَيْرِ إِلا قَلِيلا حَتَّى قُتِلَ ""","","","","","Book of Blood Money (Diyat)"
"16772","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  فِيالْمُوضِحَةِ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16773","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالْمُوضِحَةِ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16774","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيالْمُوضِحَةِ بِخَمْسٍ مِنَ الإِبِلِ , أَوْ عَدْلِهَا مِنَ الذَّهَبِ , أَوِ الْوَرِقِ , أَوَ الْبَقَرِ , أَوِ الشَّاءِ ""","","","","","Book of Blood Money (Diyat)"
"16775","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ , قَالا : أَخْبَرَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْمُوضِحَةِ خَمْسٌ ""","","","","","Book of Blood Money (Diyat)"
"16776","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَضَى فِيالْمُوضِحَةِ بِخَمْسٍ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16777","عَنِ الثَّوْرِيِّ ، وَمُحَمَّدٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالْمُوضِحَةِ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16778","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ بَعْضِ أَصْحَابِهِمْ , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ  كَتَبَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَلَمْ يَقْضِ فِيمَا دُونَ الْمُوضِحَةِ بِشَيْءٍ ""","","","","","Book of Blood Money (Diyat)"
"16779","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : كَتَبَ عُمَرُ إِلَى الأَجْنَادِ : وَلا نَعْلَمُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَضَى فِيمَا دُونَ الْمُوضِحَةِ بِشَيْءٍ  , قَالَ : "" وَقَضَى عُمَرُ بْنُ الْخَطَّابِ فِيالْمُوضِحَةِ بِخَمْسٍ مِنَ الإِبِلِ , أَوْ عَدْلِهَا مِنَ الذَّهَبِ , أَوِ الْوَرِقِ ، وَفِي مُوضِحَةِ الْمَرْأَةِ بِخَمْسٍ مِنَ الإِبِلِ , أَوْ عَدْلِهَا مِنَ الذَّهَبِ أَوِ الْوَرِقِ ""","","","","","Book of Blood Money (Diyat)"
"16780","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي رَجُلٌ مِنْ أَهْلِ الْيَمَنِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : تُقَدَّرُ الْمُوضِحَةُ بِالإِبْهَامِ ، فَمَا زَادَ عَلَى ذَلِكَ أُخِذَ بِحِسَابِ مَا زَادَ ""","","","","","Book of Blood Money (Diyat)"
"16781","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : مَا دُونَ الْمُوضِحَةِ حُكُومَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16782","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ أَبِي الْوَلِيدِ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَلَمْ يَقْضِ فِيمَا دُونَ الْمُوضِحَةِ بِشَيْءٍ ""","","","","","Book of Blood Money (Diyat)"
"16783","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالدَّامِيَةِ بَعِيرٌ ، وَفِي الْبَاضِعَةِ بَعِيرَانِ ، وَفِي الْمُتَلاحِمَةِ ثَلاثٌ مِنَ الإِبِلِ ، وَفِي السَّمْحَاقِ أَرْبَعٌ ، وَفِي الْمُوضِحَةِ خَمْسٌ ، وَفِي الْهَاشِمَةِ عَشْرٌ ، وَفِي الْمَنْقُولَةِ خَمْسَ عَشْرَةَ ، وَفِي الْمَأْمُومَةِ ثُلُثُ الدِّيَةِ ، وَفِي الرَّجُلِ يُضْرَبُ حَتَّى يَذْهَبَ عَقْلُهُ , الدِّيَةُ كَامِلَةٌ , أَوْ ضُرِبَ حَتَّى يَغَنَّ وَلا يَفْهَمَ , الدِّيَةُ كَامِلَةٌ , أَوْ يَبَحَّ فَلا يَفْهَمَ , الدِّيَةُ كَامِلَةٌ ، وَفِي جَفْنِ الْعَيْنِ رُبُعُ الدِّيَةِ ، وَفِي حَلَمَةُ الثَّدْيِ رُبُعُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16784","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي مُلَيْكَةَ : عَنْ رَجُلَيْنِ اخْتَصَمَا إِلَى عَبْدِ اللَّهِ بْنِ خَالِدٍ فِي مُوضِحَةٍ ، فَقَالَ : لَيْسَ فِيهَا شَيْءٌ , فَذَكَرْتُ ذَلِكَ لِعَبْدِ اللَّهِ بْنِ الزُّبَيْرِ , فَقَالَ : صَدَقَ عَبْدُ اللَّهِ بْنُ خَالِدٍ ، قَدْ كَانَ عُمَرُ بْنُ الْخَطَّابِ , يَقُولُ :  فِيالْمُوضِحَةِ لا يَعْقِلُهَا أَهْلُ الْقُرَى ، وَيَعْقِلُهَا أَهْلُ الْبَادِيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16785","عَنِ ابْنِ جُرَيْجٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، كَانَ يَقُولُ :  إِنَّمَاالْمُوضِحَةُ عَلَى أَهْلِ الْبَوَادِي "" , قَالَ : "" وَأَمَّا عَلَى أَهْلِ الْقُرَى فَلا "" , قَالَ : "" قَدْ أَدْرَكْتُ وَمَا يَتَعَاقَلُهَا أَهْلُ الْقُرَى ""","","","","","Book of Blood Money (Diyat)"
"16786","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ ابْنَ أَبِي مُلَيْكَةَ , يَقُولُ : جَاءَ عُمَيْرُ بْنُ خَالِدٍ مَوْلَى عَمْرِو بْنِ الْعَاصِ إِلَى ابْنِ الزُّبَيْرِ ,يَطْلُبُ مُوضِحَةً أُصِيبَ بِهَا حَسِبْتُ لَهُ ، فَقَالَ ابْنُ الزُّبَيْرِ : لَيْسَ فِيهَا شَيْءٌ , قَالَ ابْنُ الزُّبَيْرِ : قَالَ عُمَرُ بْنُ الْخَطَّابِ :  لا يَعْقِلُهَا أَهْلُ الْقُرَى وَيَعْقِلُهَا أَهْلُ الْبَادِيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16787","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، عَنْ عَبْدِ اللَّهِ بْنِ صَفْوَانَ ، عَنْ عَامِرٍ الْغِفَارِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ : أَبْطَلَ الْمُوضِحَةَ عَنْ أَهْلِ الْقُرَى ""","","","","","Book of Blood Money (Diyat)"
"16788","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ الْعَزِيزِ يُحَدِّثُ , عَنْ أَبِي سَلَمَةَ بْنِ سُفْيَانَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَبْطَلَهَا عَنْ أَهْلِ الْقُرَى ""","","","","","Book of Blood Money (Diyat)"
"16789","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْمُوضِحَةُ عَلَى أَهْلِ الْبَادِيَةِ خَمْسٌ ؟ قَالَ : نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"16790","عَنْ مَعْمَرٍ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ إِلَى أَهْلِ الْقُرَى  أَنْيَعْقِلُوا الْمُوضِحَةَ ، وَجَعَلَ فِيهَا خَمْسِينَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"16791","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مُوضِحَةٌ فِي غَيْرِ الرَّأْسِ , فِي الْوَجْهِ , أَوْ فِي الْيَدِ , أَيَعْقِلُهَا أَهْلُ الْبَادِيَةِ ؟ قَالَ : "" إِي وَاللَّهِ ! أَظُنُّهَا إِذَا أَوْضَحَتْ ""","","","","","Book of Blood Money (Diyat)"
"16792","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ  فِيالْمُوضِحَةِ الَّتِي تَكُونُ فِي جَسَدِ الإِنْسَانِ , لَيْسَتْ فِي رَأْسِهِ ، فَقَضَى أَنَّ كُلَّ عَظْمٍ كَانَ لَهُ نَذْرٌ مُسَمًّى , أَنَّ فِي مُوضِحَتِهِ نِصْفَ عُشْرِ نَذْرِهَا مَا كَانَ ، فَإِذَا كَانَتِ الْمُوضِحَةُ فِي الْيَدِ ، فَهِيَ نِصْفُ عُشْرِ نَذْرِهَا مَا لَمْ تَكُنْ فِي الأَصَابِعِ ، فَإِذَا كَانَتْ فِي الأَصَابِعِ مُوضِحَةٌ ، فَهِيَ نِصْفُ عُشْرِهَا , وَذَلِكَ أَنَّ الأَصَابِعَ يَفْتَرِقُ نَذْرُهَا ، فَكَانَتْ كُلُّ إِصْبَعٍ عَشْرًا مِنَ الإِبِلِ , وَمَا كَانَ فَوْقَ الأَصَابِعِ مِنَ الْكَفِّ فَنَذْرُهُ مِثْلُ نَذْرِ الذِّرَاعِ وَالْعَضُدِ ، وَقَضَى فِي الرَّجُلِ بِمِثْلِ مَا قَضَى بِهِ فِي الْيَدِ مِنَ النَّذْرِ , فِي أَصَابِعِهَا وَمُوضِحَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16793","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَضَى فِيمُوضِحَةِ الإِصْبَعِ نِصْفَ عُشْرِ نَذْرِ تِلْكَ الإِصْبَعِ ""","","","","","Book of Blood Money (Diyat)"
"16794","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ , قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ يَسَارٍ يَذْكُرُ  أَنَّالْمُوضِحَةَ فِي الْوَجْهِ مِثْلُ الْمُوضِحَةِ فِي الرَّأْسِ , إِلا أَنْ يَكُونَ فِي الْوَجْهِ عَيْبٌ ، فَيُزَادُ فِي مُوضِحَةِ الْوَجْهِ بِقَدْرِ عَيْبِ الْوَجْهِ , مَا بَيْنَهَا وَبَيْنَ عَقْلِ نِصْفِ الْمُوضِحَةِ ""","","","","","Book of Blood Money (Diyat)"
"16795","سَمِعْتُ الْحَجَّاجَ بْنَ أَرْطَاةَ يُحَدِّثُ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالْمُوضِحَةِ تَكُونُ فِي الرَّأْسِ ، وَالْحَاجِبِ ، وَالأَنْفِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16796","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , قَالَ : إِذَا كَانَتِ الْمُوضِحَةُ فِي جَسَدِ الإِنْسَانِ ، فَفِيهَا خَمْسَةٌ وَعِشْرُونَ دِينَارًا ، وَإِذَا كَانَتْ فِي الْيَدِ فَمِثْلُ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"16797","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : جِرَاحُ الرَّأْسِ وَالْوَجْهِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16798","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , قَالَ :  فِيالْمُوضِحَةِ فِي الْوَجْهِ ، وَالرَّأْسِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16799","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : هُمَا سَوَاءٌ "" , قَالَ : "" وَلا تَكُونُ فِي مُوضِحَةِ الْجَسَدِ , إِنَّمَا تَكُونُ فِيهِ حُكُومَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16800","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالْمُوضِحَةِ فِي الْوَجْهِ ضِعْفُ مَا فِي مُوضِحَةِ الرَّأْسِ ""","","","","","Book of Blood Money (Diyat)"
"16801","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ  فِيالْجِرَاحِ الَّتِي لَمْ يَقْضِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهَا ، وَلا أَبُو بَكْرٍ ، فَقَضَى فِي الْمُوضِحَةِ الَّتِي تَكُونُ فِي جَسَدِ الإِنْسَانِ ، وَلَيْسَتْ فِي الرَّأْسِ , أَنَّ كُلَّ عَظْمٍ لَهُ نَذْرٌ مُسَمًّى , فَفِي مُوضِحَتِهِ نِصْفُ عُشْرِ نَذْرِهِ مَا كَانَ ، فَإِذَا كَانَتْ مُوضِحَةٌ فِي الْيَدِ فَنِصْفُ عُشْرِ نَذْرِهَا مَا لَمْ تَكُنْ فِي الأَصَابِعِ ، فَهِيَ نِصْفُ عُشْرِ نَذْرِ الإِصْبَعِ ، فَمَا كَانَ فَوْقَ الأَصَابِعِ فِي الْكَفِّ فَنَذْرُهَا مِثْلُ الْمُوضِحَةِ فِي الذِّرَاعِ وَالْعَضُدِ , وَفِي الرِّجْلِ مِثْلُ مَا فِي الْيَدِ ""","","","","","Book of Blood Money (Diyat)"
"16802","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ بْنِ نُجَيٍّ ، أَنَّ عَلِيًّا  قَضَى فِيالسَّمْحَاقِ ، وَهِيَ الْمُلْطَأَةُ بِأَرْبَعٍ مِنَ الإِبِلِ "", عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنِ الْحَكَمِ ، عَنْ عَلِيٍّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16803","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالدَّامِيَةِ بَعِيرٌ ، وَفِي الْبَاضِعَةِ بَعِيرَانِ ، وَفِي الْمُتَلاحِمَةِ ثَلاثٌ ، وَفِي السَّمْحَاقِ أَرْبَعٌ ، وَفِي الْمُوضِحَةِ خَمْسٌ "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ مِثْلَهُ , قَالَ مَعْمَرٌ : وَلا أَعْلَمُهُ إِلا ذَكَرَهُ عَنْ عَلِيٍّ ، عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرتُ , عَنْ عَبْدِ الْمَلِكِ ، مِثْلَ قَوْلِ زَيْدٍ , إِلا أَنَّهُ لَمْ يَذْكُرِ الْمُوضِحَةَ""","","","","","Book of Blood Money (Diyat)"
"16804","قُلْتُ لِمَالِكٍ : إِنَّ الثَّوْرِيَّ أَخْبَرَنَا عَنْكَ , عَنْ يَزِيدَ بْنِ قُسَيْطٍ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ ، وَعُثْمَانَ ،  قَضَيَا فِيالْمُلْطَأَةِ بِنِصْفِ الْمُوضِحَةِ "", فَقَالَ لِي : قَدْ حَدَّثْتُهُ بِهِ , فَقُلْتُ : فَحَدَّثَنِي بِهِ , فَأَبَى , وَقَالَ : الْعَمَلُ عِنْدَنَا عَلَى غَيْرِ ذَلِكَ ، وَلَيْسَ الرَّجُلُ عِنْدَنَا هَنَالِكَ , يَعْنِي : يَزِيدَ بْنَ قُسَيْطٍ""","","","","","Book of Blood Money (Diyat)"
"16805","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنِ الشَّعْبِيِّ ، عَنْ زَيْدِ بْنِ ثَابِتٍ ، أَنَّهُ قَالَ :  فِيالدَّامِيَةِ الْكُبْرَى يَرَوْنَ أَنَّهَا الْمُتَلاحِمَةُ ثَلاثُ مِائَةِ دِرْهَمٍ ، وَفِي الْمُوضِحَةِ مِائَتَا دِرْهَمٍ ، وَفِي الدَّامِيَةِ الصُّغْرَى مِائَةُ دِرْهَمٍ ""","","","","","Book of Blood Money (Diyat)"
"16806","سَمِعْتُ مَوْلًى لِسُلَيْمَانَ بْنِ حَبِيبٍ يُحَدِّثُ , يُخْبِرُ مَعْمَرَ ، أَنَّ سُلَيْمَانَ بْنَ حَبِيبٍ  قَضَى فِيالصَّكَّةِ ، إِذَا احْمَرَّتْ أَوِ اخْضَرَّتْ أَوِ اسْوَدَّتْ بِسِتَّةِ دَنَانِيرَ ""","","","","","Book of Blood Money (Diyat)"
"16807","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , أَنَّهُ قَالَ :  فِيالْهَاشِمَةِ عَشْرٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16808","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : فِيهَا عَشْرٌ مِنَ الإِبِلِ "" , قَالَ قَتَادَةُ : وَقَالَ بَعْضُهُمْ : "" خَمْسَةٌ وَسَبْعُونَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"16809","عَنِ الثَّوْرِيِّ , قَالَ :  فِيالْهَاشِمَةِ فِي الرَّأْسِ سَمِعْنَا أَنَّ فِيهَا أَلْفَ دِرْهَمٍ ""","","","","","Book of Blood Money (Diyat)"
"16810","عَنْ مَعْمَرٍ , قَالَ :  بَلَغَنِي أَنَّ فِيالْحَرْصَةِ ، خَمْسَةً وَأَرْبَعونَ دِرْهَمًا ""","","","","","Book of Blood Money (Diyat)"
"16811","عَنِ ابْنِ جُرَيْجٍ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِيِّ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , أَنَّهُ قَالَ :  فِيالْحَرْصَةِ الَّتِي تَكُونُ بَيْنَ اللَّحْمِ وَالْجِلْدِ فِي الرَّأْسِ خَمْسُونَ دِرْهَمًا ""","","","","","Book of Blood Money (Diyat)"
"16812","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِيمُوضِحَةِ الْعَبْدِ وَسِنِّهِ فِي كُلِّ وَاحِدٍ مِنْهَا نِصْفُ عُشْرِ ثَمَنِهِ ""","","","","","Book of Blood Money (Diyat)"
"16813","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ زَكَرِيَّا ، عَنِ الشَّعْبِيِّ  فِيمُوضِحَةِ الْعَبْدِ نِصْفُ عُشْرِ ثَمَنِهِ ""","","","","","Book of Blood Money (Diyat)"
"16814","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  فِيالْمَأْمُومَةِ الثُّلُثُ ""","","","","","Book of Blood Money (Diyat)"
"16815","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالْمَأْمُومَةِ ثُلُثُ الدِّيَةِ "", عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِيٍّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16816","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ , قَالَ : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  فِيالْمَأْمُومَةِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16817","عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، وَالثَّوْرِيِّ ، كُلُّهُمْ عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  فِيالْمَأْمُومَةِ ثُلُثُ الدِّيَةِ ، وَإِنْ خَبَلَتْ شِقَّهُ , أَوْ غُشِي عَلَيْهِ مِنَ الرَّعْدِ , أَوْ ذَهَبُ عَقْلُهُ , فَفِيهَا الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"16818","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، أَنَّ مُجَاهِدًا ، كَانَ يَقُولُ :  فِيثَلاثٍ مِنَ الْمَأْمُومَةِ الدِّيَةُ إِنْ خَبَلَتْ شِقَّهُ , أَوْ ذَهَبَ عَقْلُهُ , أَوْ غُشِي عَلَيْهِ مِنَ الرَّعْدِ ""","","","","","Book of Blood Money (Diyat)"
"16819","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : عِنْدَ أَبِي كِتَابٌ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْمَأْمُومَةِ ثَلاثٌ وَثَلاثُونَ ""","","","","","Book of Blood Money (Diyat)"
"16820","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ ابْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالْمَأْمُومَةِ ثُلُثُ الدِّيَةِ "", قَالَ مُحَمَّدٌ : وَسَمِعْتُ مَكْحُولا , يَقُولُ : إِذَا كَانَتِ الْمَأْمُومَةُ عَمْدًا , فَفِيهَا ثُلُثَا الدِّيَةِ ، وَإِذَا كَانَتْ خَطَأً فَفِيهَا ثُلُثَا الدِّيَةِ""","","","","","Book of Blood Money (Diyat)"
"16821","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  فِي الْمَأْمُومَةِ ثُلُثُ الْعَقْلِ , ثَلاثَةٌ وَثَلاثُونَ مِنَ الإِبِلِ , أَوْ عَدْلُهَا مِنَ الذَّهَبِ , أَوِ الْوَرِقِ "" , قَالَ : وَقَضَى عُمَرُ بْنُ الْخَطَّابِ بِمِثْلِ ذَلِكَ , قَالَ : وَقَضَى عُمَرُ بْنُ الْخَطَّابِ : "" فِيالْمَأْمُومَةِ فِي الْجَسَدِ إِنْ أُصِيبَ السَّاقُ , أَوِ الْفَخِذُ , أَوِ الذِّرَاعُ , أَوِ الْعَضُدُ , حَتَّى يَخْرُجَ مُخُّهَا ، وَيَحِنَّ عَظْمُهَا فَلا يَجْتَمِعُ ، فِيهَا نِصْفُ مَأْمُومَةِ الرَّأْسِ , سِتَّةَ عَشَرَ قَلُوصًا وَنِصْفٌ ""","","","","","Book of Blood Money (Diyat)"
"16822","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالْمُنَقِّلَةِ خَمْسَ عَشْرَةَ ""","","","","","Book of Blood Money (Diyat)"
"16823","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيالْمُنَقِّلَةِ خَمْسَ عَشْرَةَ ""","","","","","Book of Blood Money (Diyat)"
"16824","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ :  فِيالْمُنَقِّلَةِ خَمْسَ عَشْرَةَ مِنَ الإِبِلِ "", قَالَ : وَقَالَهُ ابْنُ أَبِي مُلَيْكَةَ أَيْضًا""","","","","","Book of Blood Money (Diyat)"
"16825","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : فِي الْكِتَابِ الَّذِي عِنْدَ أَبِي , وَهُوَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْمُنَقِّلَةِ خَمْسَ عَشْرَةَ "", عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16826","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْمَنْقُولَةِ خَمْسَ عَشْرَةَ مِنَ الإِبِلِ ، أَوْ عَدْلُهَا مِنَ الذَّهَبِ ، أَوِ الْوَرِقِ ، أَوِ الشَّاءِ "", وَقَضَى عُمَرُ بْنُ الْخَطَّابِ بِمِثْلِ ذَلِكَ فِي مَنْقُولَةِ الرَّجُلِ وَالْمَرْأَةِ""","","","","","Book of Blood Money (Diyat)"
"16827","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ  أَنَّمَا كَانَتْ مِنْ مَنْقُولَةٍ يُنْقَلُ عِظَامُهَا فِي الْعَضُدِ , أَوِ الذِّرَاعِ , أَوِ السَّاقِ , أَوِ الْفَخِذِ ، فَهِيَ نِصْفُ مَنْقُولَةِ الرَّأْسِ ، سَبْعُ قَلائِصَ وَنِصْفٌ ""","","","","","Book of Blood Money (Diyat)"
"16828","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , عَنْ عُمَرَ :  فِيمَنْقُولَةِ الْجَسَدِ نِصْفُ مَنْقُولَةِ الرَّأْسِ ، إِذَا كَانَ تُنْقَلُ عِظَامُهَا فِي الذِّرَاعِ , أَوِ الْعَضُدِ , أَوِ السَّاقِ , أَوِ الْفَخِذِ ""","","","","","Book of Blood Money (Diyat)"
"16829","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : حَلْقُ الرَّأْسِ أَلَهُ نَذْرٌ ؟ قَالَ لَمْ أَعْلَمْ ""","","","","","Book of Blood Money (Diyat)"
"16830","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَيُّوبُ السَّخْتِيَانِيُّ ، قَالَ : قَالَ لِي ابْنُ سِيرِينَ : لَوْ نَتْفَ مِنْ لِحْيَتِكِ مَا يَكُونُ فِي ذَلِكَ ؟ "", ثُمَّ قَالَ مُحَمَّدٌ : قَالَ شُرَيْحٌ : "" تُوضَعُ فِي الْمِيزَانِ ، فَإِنْ لَمْ يَكُنْ فِي اللِّحْيَةِ مَا بَقِي فَفِي الرَّأْسِ "" ، قَالَ سُفْيَانُ : "" سَمِعْنَا أَنَّ الرَّأْسَ إِذَا حُلِقَ فَلَمْ يُنْبِتْ , أَوِ اللِّحْيَةُ فَفِي كُلٍّ مِنْهُمَا الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"16831","عَنْ إِسْرَائِيلَ ، عَنِ الْمِنْهَالِ بْنِ خَلِيفَةَ ، عَنْ تَمِيمِ بْنِ سَلَمَةَ ، قَالَ :أَفْرَغَ رَجُلٌ عَلَى رَأْسِ رَجُلٍ قِدْرًا , فَذَهَبَ شَعْرُهُ ، فَذَهَبَ إِلَى عَلِيٍّ  فَقَضَى عَلَيْهِ بِالدِّيَةِ كَامِلَةٍ ""","","","","","Book of Blood Money (Diyat)"
"16832","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ , فِيرَجُلٍ نَتَفَ مِنْ لِحْيَةِ رَجُلٍ , فَقَالَ :  يُقْتَصُّ مِنْهُ بِالْمِيزَانِ , فَمَا لَمْ يَفِ أُكْمِلَ مِنْ شَعْرِ الرَّأْسِ ""","","","","","Book of Blood Money (Diyat)"
"16833","قَالَ سُفْيَانُ :  سَمِعْنَا أَنَّ فِيالْجَبْهَةِ إِذَا كُسِرَتْ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"16834","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ :  فِيالْجَبْهَةِ إِذَا هُشِمَتْ ، وَفِيهَا غَوْصٌ مِنْ دَاخِلٍ مِائَةٌ ، وَخَمْسُونَ دِينَارًا , فَإِنْ كَانَ بَيْنَ الْحَاجِبَيْنِ , كَسْرٌ شَانُ الْوَجْهِ , وَلَمْ يُنْقَلْ مِنْهَا الْعِظَامُ , فَرُبُعُ الدِّيَةِ ، وَإِنْ كُسِرَ مَا بَيْنَ الأُذُنَيْنِ يُصِيبُ مَاضِغَ اللَّحْيَيْنِ , وَقَدْ أَدَّاهُ الشَّعْرُ فِي غَوْصٍ لَمْ يُصِبْهُ الْجُرْحُ ، وَلَمْ يُنْقَلْ مِنْهُ عَظْمٌ , فَفِيهِ مِائَةُ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16835","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْحَاجِبُ يُشْتَرُ ؟ قَالَ : لَمْ أَسْمَعْ فِيهِ بِشَيْءٍ ""","","","","","Book of Blood Money (Diyat)"
"16836","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالْحَاجِبَيْنِ الدِّيَةُ ، وَفِي أَحَدِهِمَا نِصْفُ الدِّيَةِ "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، مِثْلَ قَوْلِ ابْنِ الْمُسَيِّبِ , وَزَادَ : "" فَمَا ذَهَبَ مِنَ الْحَاجِبِ فَبِحِسَابِ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"16837","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ ، عَنِ الشَّعْبِيِّ ، قَالَ :  فِيالْحَاجِبَيْنِ الدِّيَةُ "" , قَالَ : وَقَالَ غَيْرُهُ : "" حُكُومَةُ عَدْلٍ ""","","","","","Book of Blood Money (Diyat)"
"16838","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ :  فِيالْحَاجِبِ ، إِذَا أُصِيبَ حَتَّى يَذْهَبَ شَعْرُهُ ، فَقَضَى فِيهِ مُوضِحَتَيْنِ , عَشْرًا مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16839","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، أَنَّهُ بَلَغَهُ عَنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْحَاجِبِ يَتَحَصَّصُ شَعْرُهُ , أَنَّ فِيهِ الرُّبُعَ ، وَفِيمَا ذَهَبَ مِنْهُ بِالْحِسَابِ ، فَإِنْ أُصِيبَ الْحَاجِبُ بِمَا يُوضِحُ ، وَيُذْهِبُ شَعْرَهُ , كَانَ نَذْرَ الْحَاجِبِ قَطُّ ، وَلَمْ يَكُنْ لِلْمُوضِحَةِ نَذْرٌ ، فَإِنْ أُصِيبَ بِمَنْقُولَةٍ كَانَ نَذَرَ الْحَاجِبِ ، وَالْمَنْقُولَةِ جَمِيعًا ""","","","","","Book of Blood Money (Diyat)"
"16840","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ , قَالَ :  اجْتَمَعَ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِيشُفْرِ الْعَيْنِ الأَعْلَى ، إِذَا نُتِفَ نِصْفُ دِيَةِ الْعَيْنِ ، وَفِي شُفْرِ الْعَيْنِ الأَسْفَلِ ثُلُثُ دِيَةِ الْعَيْنِ ، وَقَالُوا : إِذَا ذَهَبَ جَفْنُ الْعَيْنِ فَاعْوَرَّتْ فِدْيَةُ الْعَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"16841","عَنْ مَعْمَرٍ ، عَنْ بَعْضِ أَصْحَابِهِ , عَنِ الشَّعْبِيِّ , قَالَ :  فِيكُلِّ شُفْرٍ رُبُعُ دِيَةِ الْعَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"16842","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَكْحُولٍ ، عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ :  فِيجَفْنِ الْعَيْنِ رُبُعُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16843","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ :  فِيالأُذِنِ إِذَا اسْتُؤْصِلَتْ خَمْسُونَ مِنَ الإِبِلِ "", عَنِ ابْنِ جُرَيْجٍ ، وَمَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16844","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالأُذُنِ إِذًا النِّصْفُ , يَعْنِي : نِصْفَ الدِّيَةِ "", قَالَ سُفْيَانُ : فَمَا أُصِيبَ مِنَ الأُذُنِ فَبِحِسَابِ ذَلِكَ""","","","","","Book of Blood Money (Diyat)"
"16845","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالأُذُنِ إِذَا اسْتُؤْصِلَتْ نِصْفُ الدِّيَةِ ، وَإِذْ ذَهَبَ السَّمْعُ فَنِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16846","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّهُ قَالَ : قَالَ أَبُو بَكْرٍ :  فِيالأُذُنِ خَمْسَةَ عَشَرَ بَعِيرًا يُغَيِّبُهَا الشَّعْرُ وَالْعِمَامَةُ ""","","","","","Book of Blood Money (Diyat)"
"16847","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : أَوَّلُ مَنْ قَضَى فِي الأُذُنِ أَبُو بَكْرٍ , خَمْسَةَ عَشَرَ مِنَ الإِبِلِ لا يَضُرُّ سَمْعًا ، وَلا يُنْقِصُ قُوَّةً , يُغَيِّبُهَا الشَّعْرُ وَالْعِمَامَةُ ""","","","","","Book of Blood Money (Diyat)"
"16848","عَنِ ابْنِ جُرَيْجٍ ، أَنَّ عَلْقَمَةَ بْنَ قَيْسٍ قَالَ : قَالَ ابْنُ مَسْعُودٍ : كُلُّ زَوْجَيْنِ فَفِيهِمَا الدِّيَةُ ، وَكُلُّ وَاحِدٍ فَفِيهِ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"16849","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، أَنَّ أَبَا بَكْرٍ قَضَى  فِيالأُذُنِ بِخَمْسَةَ عَشَرَ مِنَ الإِبِلِ "" , وَقَالَ : "" إِنَّمَا هُوَ شَيْءٌ لا يَضُرُّ سَمْعًا ، وَلا يُنْقِصُ قُوَّةً , يُغَيِّبُهَا الشَّعْرُ وَالْعِمَامَةُ ""","","","","","Book of Blood Money (Diyat)"
"16850","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَضَى  فِيالأُذُنِ إِذَا اسْتُؤْصِلَتْ نِصْفُ الدِّيَةِ "", عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ مُسْلِمٍ ، عَنْ طَاوُسٍ ، وَعِكْرِمَةَ , أَنَّ عُمَرَ قَضَى بِهِ ، قَالَ مَعْمَرٌ : وَالنَّاسُ عَلَيْهِ""","","","","","Book of Blood Money (Diyat)"
"16851","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  فِيالأُذُنِ إِذِ اسْتُؤْصِلَتْ نِصْفُ الدِّيَةِ ، فَمَا قُطِعَ مِنْهَا فَبِحِسَابِ ذَلِكَ , يُقَدَّرُ بِالْقِرْطَاسِ "" , قَالَ قَتَادَةُ : "" وَإِذَا ذَهَبَ السَّمْعُ فَنِصْفُ دِيَتِهَا "", قَالَ : "" وَقَضَى فِيهَا أَبُو بَكْرٍ بِخَمْسَةَ عَشَرَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16852","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : إِذَا ذَهَبَ سَمْعُهَا وَلَمْ تُقْطَعْ فَقَدْ تَمَّ عَقْلُهَا ، وَإِنْ قُطِعَتْ وَذَهَبَ سَمْعُهَا فَفِيهَا الدِّيَةُ كَامِلَةً , أَلْفُ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16853","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ فِيالأُذُنِ , فَجَعَلَهَا مَنْقُولَةً , قَالَ :  لا يَذْهَبُ سَمْعُهَا , وَيَسْتُرُهَا الشَّعْرُ وَالْعِمَامَةُ "", وَقَضَى عُمَرُ فِيهَا : "" بِنِصْفِ الدِّيَةِ , أَوْ عَدْلِ ذَلِكَ مِنَ الذَّهَبِ , أَوِ الْوَرِقِ ""","","","","","Book of Blood Money (Diyat)"
"16854","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :إِذَا قُطِعَتِ الأُذُنُ تَمَّ عَقْلُهَا , قَالَ :  وَقَضَى فِيهَا أَبُو بَكْرٍ بِخَمْسَةَ عَشَرَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16855","عَنْ حُمَيْدٍ الشَّامِيِّ ، عَنِ الْحَجَّاجِ ، عَنْ مَكْحُولٍ ، عَنْ زَيْدٍ , قَالَ :  فِيشَحْمَةِ الأُذُنِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16856","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : لَمْ يَبْلُغْنِي فِي ذَهَابِ السَّمْعِ شَيْءٌ ""","","","","","Book of Blood Money (Diyat)"
"16857","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عُمَرَ , قَالَ : سَأَلْتُ ابْنَ عُلاثَةَ , قُلْتُ :الرَّجُلُ يَدَّعِي أَنَّهُ أَصْمَهُ مِنْ ضَرْبِهِ , كَيْفَ يُعْلَمُ ذَلِكَ ؟ قَالَ :  تُلْتَمَسُ غَفَلاتُهُ , فَإِنْ قُدِرَ عَلَى شَيْءٍ ، وَإِلا اسْتُحْلِفَ ، ثُمَّ أُعْطِيَ فَإِنِ ادَّعَى صَمَمًا فِي إِحْدَى أُذُنَيْهِ دُونَ الأُخْرَى ، فَإِنَّهُ يُحْشَى الَّتِي لَمْ تُصَمَّ وَتُلْتَمَسُ غَفَلاتُهُ ""","","","","","Book of Blood Money (Diyat)"
"16858","عَنِ الثَّوْرِيِّ , قَالَ : بَلَغَنِي ، عَنْ إِبْرَاهِيمَ ، وَغَيْرِهِ , قَالَ : يُغْتَرُّ فَيُنْظَرُ أَيَسْمَعُ أَمْ لا ""","","","","","Book of Blood Money (Diyat)"
"16859","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيذَهَابِ السَّمْعِ خَمْسُونَ ""","","","","","Book of Blood Money (Diyat)"
"16860","عَنِ ابْنِ جُرَيْجٍ , قَالَ : بَلَغَنِي أَنَّ رَجُلا جَاءَ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , فَقَالَ : ضَرَبَنِي فُلانٌ حَتَّى صَمَّتْ إِحْدَى أُذُنَيَّ "" , قَالَ : فَقَالَ لَهُ : "" كَيْفَ نَعْلَمُ ذَلِكَ ؟ , قَالَ : "" ادْعُ الأَطِبَّاءَ "" , فَدَعَاهُمْ , فَشَمُّوهَا , فَقَالُوا لِلصَّمَّاءِ : "" هَذِهِ الصَّمَّاءُ ""","","","","","Book of Blood Money (Diyat)"
"16861","عَنِ ابْنِ جُرَيْجٍ , قَالَ : مَا اجْتَمَعَ عَلَيْهِ لِعُمَرَ أَنْ قَالَ : لَمْ أَسْمَعْ فِي شَيْءٍ يُصَابُ بِهِ عَمَّمَ فَاهُ ، وَمَنْخَرَيْهِ ، فَإِنْ سَمِعَ صَرِيرًا فِي الأُذُنِ حِينَ يُعَمَّمُ , فَلَيْسَ بِهِ بَأْسٌ ""","","","","","Book of Blood Money (Diyat)"
"16862","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَتَبَ لَهُمْ كِتَابًا :  وَفِيالْعَيْنِ خَمْسُونَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16863","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالْعَيْنِ نِصْفُ الدِّيَةِ "", عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16864","عَنْ إِبْرَاهِيمَ بْنِ طَهْمَانَ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنِ الشَّعْبِيِّ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : الْعَيْنَانِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16865","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، قَالا : فِي الْعَيْنَيْنِ الدِّيَةُ كَامِلَةً ، وَفِي الْعَيْنِ نِصْفُ الدِّيَةِ , فَمَا ذَهَبَ فَبِحِسَابِ ذَلِكَ , قِيلَ لِمَعْمَرٍ : وَكَيْفَ يُعْلَمُ ذَلِكَ ؟ قَالَ : بَلَغَنِي عَنْ عَلِيٍّ ، أَنَّهُ قَالَ : يُغَمِّضُ عَيْنَهُ الَّتِي أُصِيبَتْ ، ثُمَّ يَنْظُرُ بِالأُخْرَى فَيَنْظُرُ أَيْنَ يَنْتَهِي بَصَرُهُ ، ثُمَّ يَنْظُرُ بِالَّتِي أُصِيبَتْ , فَمَا نَقَصَ فَبِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"16866","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ :  فِيالْعَيْنِ خَمْسُونَ "" , قَالَ : قُلْتُ لِعَطَاءٍ : فَذَهَبَ بَعْضُ بَصَرِهَا وَبَقِي بَعْضٌ ؟ قَالَ : "" بِحِسَابِ مَا ذَهَبَ , يُمْسِكُ عَلَى الصَّحِيحَةِ وَيَنْظُرُ بِالأُخْرَى ، ثُمَّ يُمْسِكُ عَلَى الأُخْرَى فَيَنْظُرُ بِالصَّحِيحَةِ فَيَحْسِبُ مَا ذَهَبَ مِنْهُ ""","","","","","Book of Blood Money (Diyat)"
"16867","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ , قَالَ : لَطَمَ رَجُلٌ رَجُلا , أَوْ غَيْرَ اللَّطْمِ , إِلا أَنَّهُ ذَهَبَ بَصَرُهُ وَعَيْنُهُ قَائِمَةٌ ، فَأَرَادُوا أَنْ يُقَيِّدُوهُ فَأَعْيَا عَلَيْهِمْ وَعَلَى النَّاسِ كَيْفَ يُقَيِّدُونَهُ ، وَجَعَلُوا لا يَدْرُونَ كَيْفَ يَصْنَعُونَ , فَأَتَاهُمْ عَلِيٌّ فَأَمَرَ بِهِ فَجَعَلَ عَلَى وَجْهِهِ كُرْسُفًا ، ثُمَّ اسْتَقْبَلَ بِهِ الشَّمْسَ ، وَأَدْنَى مِنْ عَيْنِهِ مَرْآةً ، فَالْتَمَعَ بَصَرُهُ وَعَيْنُهُ قَائِمَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16868","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : بَلَغَنِي قَالَ : أَحْسِبُهُ ، عَنْ عَلِيٍّ ، أَنَّهُ قَالَ : يُغْمِضُ عَيْنَهُ الَّتِي أُصِيبَتْ ، ثُمَّ يَنْظُرُ بِالأُخْرَى , فَيَنْظُرُ أَيْنَ مُنْتَهَى بَصَرِهِ ، ثُمَّ يَنْظُرُ بِهَذِهِ الَّتِي أُصِيبَتْ , فَمَا نَقَصَ أَخَذَ بِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"16869","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :ضَعُفَتْ عَيْنُهُ مِنْ كِبَرٍ فَأُصِيبَتْ , قَالَ :  نَذْرُهَا وَافٍ "" , وَقَالَ فِي الْمَرِيضِ يُقْتَلُ : "" دِيَتُهُ وَافِيَةٌ "", وَقَالَ مِثْلَ ذَلِكَ عَبْدُ الْكَرِيمِ""","","","","","Book of Blood Money (Diyat)"
"16870","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : فِي الْكِتَابِ الَّذِي عِنْدَ أَبِي , وَهُوَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْعَيْنِ خَمْسُونَ ""","","","","","Book of Blood Money (Diyat)"
"16871","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيالْعَيْنِ نِصْفُ الْعَقْلِ , خَمْسُونَ مِنَ الإِبِلِ , أَوْ عَدْلُهَا مِنَ الذَّهَبِ , أَوِ الْوَرِقِ , أَوِ الشَّاءِ , أَوِ الْبَقَرِ ""","","","","","Book of Blood Money (Diyat)"
"16872","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ :  فِيالْعَيْنِ نِصْفُ الدِّيَةِ , أَوْ عَدْلُ ذَلِكَ مِنَ الذَّهَبِ أَوِ الْوَرِقِ ، وَفِي عَيْنِ الْمَرْأَةِ نِصْفُ دِيَتِهَا , أَوْ عَدْلُ ذَلِكَ مِنَ الذَّهَبِ أَوِ الْوَرِقِ ""","","","","","Book of Blood Money (Diyat)"
"16873","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ فِيرَجُلٍ فَقَأَ عَيْنَ رَجُلٍ ، فَقَامَ إِلَيْهِ ابْنُ عَمِّهِ فَقَتَلَهُ , فَقَالَ :  يَجْعَلُ عَقْلَ الْعَيْنِ فِي مَالِ الْمَقْتُولِ لأَنَّهُ كَانَ عَمْدًا ، وَيُقَادُ الْقَاتِلُ بِالَّذِي قَتَلَ ""","","","","","Book of Blood Money (Diyat)"
"16874","عَنْ مَعْمَرٍ ، عَنِ ابْنِ شُبْرُمَةَ , فِيرَجُلٍ فَقَأَ عَيْنَ رَجُلٍ ثُمَّ عَمِي , قَالَ :  إِنْ كَانَ رُفِعَ إِلَى السُّلْطَانِ فَقَضَى عَلَيْهِ بِالْقِصَاصِ غَرِمَهُ ، وَإِنْ عَمِي قَبْلَ أَنْ يَقْضِيَ فَلَيْسَ لَهُ شَيْءٌ ، وَكَذَلِكَ الْقَاتِلُ يَمُوتُ أَوْ يُقْتَلُ بَعْدَمَا يُقْضَى عَلَيْهِ ، يَغْرَمُ ""","","","","","Book of Blood Money (Diyat)"
"16875","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , أَنَّرَجُلا فَقَأَ عَيْنَ نَفْسِهِ ، فَقَضَى لَهُ عُمَرُ بْنُ الْخَطَّابِ  بِعَقْلِهِ عَلَى عَاقِلَتِهِ ""","","","","","Book of Blood Money (Diyat)"
"16876","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا : إِذَا فُقِئَتْ عَيْنُ الأَعْوَرِ فُقِئَتْ عَيْنُ الَّذِي فَقَأَهَا ، وَغَرِمَ أَيْضًا لِلأَعْوَرِ خَمْسَمِائَةِ دِينَارٍ ، وَإِذَا فُقِئَتْ عَيْنُ الأَعْوَرِ خَطَأً فَلَهَا الدِّيَةُ , أَلْفُ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16877","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ  أَنَّالأَعْوَرَ تُفْقَأُ عَيْنُهُ فِيهَا الدِّيَةُ كَامِلَةً "" , قُلْتُ : عَمَّنْ ؟ قَالَ : "" لَمْ نَزَلْ نَسْمَعُهُ "", قَالَ : وَقَالَ ذَلِكَ رَبِيعَةُ""","","","","","Book of Blood Money (Diyat)"
"16878","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا : إِذَا فَقَأَ الأَعْوَرُ عَيْنَ رَجُلٍ صَحِيحٍ عَمْدًا أُغْرِمَ أَلْفَ دِينَارٍ ، وَإِذَا فَقَأَهَا خَطَأً أُغْرِمَ خَمْسَمِائَةِ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16879","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , فِيرَجُلٍ بِإِحْدَى عَيْنَيْهِ بَيَاضٌ , فَأُصِيبَتْ عَيْنُهُ الصَّحِيحَةُ , قَالَ :  نَرَى أَنْ يُزَادَ فِي عَقْلِ عَيْنِهِ مَا نَقَصَ مِنَ الأُخْرَى الَّتِي لَمْ تُصَبْ ""","","","","","Book of Blood Money (Diyat)"
"16880","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ ، وَعُثْمَانَ  قَضَيَا فِيعَيْنِ الأَعْوَرِ بِالدِّيَةِ تَامَّةً ""","","","","","Book of Blood Money (Diyat)"
"16881","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ أَبِي عِيَاضٍ , أَنَّ عُمَرَ , وَعُثْمَانَ  اجْتَمَعَا عَلَى أَنَّ فِيعَيْنِ الأَعْوَرِ الدِّيَةَ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"16882","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَيُّوبُ بْنُ مُوسَى ، أَنَّ رَجَاءَ بْنَ حَيْوَةَ أَخْبَرَهُ , أَنَّ صَاحِبَ حَرَسِ عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ ,أَصَابَ سَوْطُهُ عَيْنَ أَعْوَرَ فَفَقَأَهَا , قَالَ :  فَأَعْطَاهُ عَبْدُ الْمَلِكِ فِيهَا أَلْفَ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16883","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ :  فِيالْعَيْنِ ، إِذَا لَمْ يَبْقَ مِنْ بَصَرِهِ غَيْرُهَا , الدِّيَةُ كَامِلَةً ، وَفِي عَيْنِ الْمَرْأَةِ ، إِذَا لَمْ يَبْقَ مِنْ بَصَرِهَا غَيْرُهَا ثُمَّ أُصِيبَتْ ، الدِّيَةُ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"16884","عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدِ بْنِ أَبِي عَرُوبَةَ ، عَنْ قَتَادَةَ ، عَنْ أَبِي مِجْلَزٍ ، عَنْ عَبْدِ اللَّهِ بْنِ صَفْوَانَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  قَضَى فِيعَيْنِ أَعْوَرَ ، فُقِئَتْ عَيْنُهُ الصَّحِيحَةُ , بِالدِّيَةِ كَامِلَةً ""","","","","","Book of Blood Money (Diyat)"
"16885","عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ خِلاسِ بْنِ عَمْرٍو ، عَنْ عَلِيٍّ :  فِيرَجُلٍ أَعْوَرَ فُقِئَتْ عَيْنُهُ الصَّحِيحَةُ عَمْدًا "" إِنْ شَاءَ أَخَذَ الدِّيَةَ كَامِلَةً ، وَإِنْ شَاءَ فَقَأَ عَيْنًا , وَأَخَذَ نِصْفَ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16886","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ,  فِيعَيْنِ الأَعْوَرِ تُصَابُ , قَالَ : نِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16887","عَنِ الثَّوْرِيِّ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ ، فِيعَيْنِ الأَعْوَرِ تُصَابُ , قَالَ :  أَنَا أَدِي ، قَتِيلَ اللَّهِ , فِيهَا النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"16888","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ أَبِي الضُّحَى , قَالَ : سُئِلَ عَبْدُ اللَّهِ بْنُ مَعْقِلٍ عَنِالرَّجُلِ يَفْقَأُ عَيْنَ الأَعْوَرِ ، فَقَالَ :  مَا أَنَا فَقَأْتُ عَيْنَهُ الأُخْرَى ، فِيهَا النِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"16889","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنْ بَعْضِ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  فِيعَيْنِ الأَعْوَرِ خَمْسُونَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16890","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الأَعْوَرُ يُصِيبُ عَيْنَ إِنْسَانٍ عَمْدًا , أَيُقَادُ مِنْهُ ؟ قَالَ :  مَا أَرَى أَنْ يُقَادَ مِنْهُ ، أَرَى لَهُ الدِّيَةَ وَافِيَةً ""","","","","","Book of Blood Money (Diyat)"
"16891","عَنْ عُثْمَانَ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي عِيَاضٍ ، أَنَّ عُثْمَانَ قَضَى فِيرَجُلٍ أَعْوَرَ فَقَأَ عَيْنَ صَحِيحٍ , فَقَالَ :  عَلَيْهِ دِيَةُ عَيْنِهِ ، وَلا قَوَدَ عَلَيْهِ "", قَالَ قَتَادَةُ : وَقَالَ ابْنُ الْمُسَيِّبِ : لا يُسْتَقَادُ مِنَ الأَعْوَرِ وَعَلَيْهِ الدِّيَةُ كَامِلَةً ، إِذَا كَانَ عَمْدًا""","","","","","Book of Blood Money (Diyat)"
"16892","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , قَالا : إِذَا فَقَأَ الأَعْوَرُ عَيْنَ الصَّحِيحِ عَمْدًا أُغْرِمَ أَلْفَ دِينَارٍ ، وَإِذَا فَقَأَهَا خَطَأً غُرِّمَ خَمْسَمِائَةِ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16893","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ مُحَمَّدِ بْنِ أَبِي عِيَاضٍ ، أَنَّ عُمَرَ ، وَعُثْمَانَ , اجْتَمَعَا عَلَى  أَنَّالأَعْوَرَ إِنْ فَقَأَ عَيْنَ آخَرَ فَعَلَيْهِ مِثْلُ دِيَةِ عَيْنِهِ "" , وَذَكَرَ أَنَّ عَلِيًّا ، قَالَ : "" أَقَامَ اللَّهُ الْقِصَاصَ فِي كِتَابِهِ :  وَالْعَيْنَ بِالْعَيْنِ ، وَقَدْ عَلِمَ هَذَا فَعَلَيْهِ الْقِصَاصُ , فَإِنَّ اللَّهَ لَمْ يَكُنْ نَسِيًّا ""","","","","","Book of Blood Money (Diyat)"
"16894","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ :  قَضَى عُمَرُ بْنُ الْخَطَّابِ فِيالْعَيْنِ الْقَائِمَةِ ، إِذَا فُقِئَتْ بِثُلُثِ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16895","قَالَ مَعْمَرٌ : وَبَلَغَنِي أَنَّ قَتَادَةَ , قَالَ : عَنْ عَبْدِ اللَّهِ بْنِ بُرَيْدَةَ ، عَنْ يَحْيَى بْنِ يَعْمَرَ ، عَنِ ابْنِ عَبَّاسٍ , أَنَّ عُمَرَ قَضَى فِيالْيَدِ الشَّلاءِ ، وَالْعَيْنِ الْقَائِمَةِ الْعَوْرَاءِ , وَالسِّنِّ السَّوْدَاءِ , فِي كُلِّ وَاحِدَةٍ مِنْهُنَّ ثُلُثَ دِيَتِهَا , عَنْ عُثْمَانَ بْنِ مَطَرٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ بُرَيْدَةَ ، عَنْ يَحْيَى بْنِ يَعْمَرَ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16896","أَخْبَرَنَا الثَّوْرِيُّ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ ، عَنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الأَشَجِّ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّ زَيْدَ بْنَ ثَابِتٍ  قَضَى فِيالْعَيْنِ الْقَائِمَةِ ، إِذَا بُخِصَتْ بِمِائَةِ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16897","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، وَمَعْمَرُ , قَالا : أَخْبَرَنَا ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  أَنَّلِلْعَيْنِ الْقَائِمَةِ الَّتِي لا يُبْصِرُ بِهَا إِنْ ثُقِبَتْ أَوْ بُخِصَتْ , كَانَ فِيهَا نِصْفُ نَذْرِ الْعَيْنِ , خَمْسٌ وَعِشْرُونَ ، وَإِنْ كَانَ قَدْ أَخَذَ فِيهَا نَذْرَهَا أَوَّلَ مَرَّةٍ ""","","","","","Book of Blood Money (Diyat)"
"16898","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ دَاوُدَ بْنِ أَبِي عَاصِمٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  قَضَى فِيالْعَيْنِ الْقَائِمَةِ تُبْخَصُ بِثُلُثِ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16899","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ فِيالْعَيْنِ الْقَائِمَةِ تُبْخَصُ بِثُلُثِ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16900","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ أُمَيَّةَ ، أَنَّ بُكَيْرَ بْنَ عَبْدِ اللَّهِ بْنِ الأَشَجِّ أَخْبَرَهُ , أَنَّهُ سَمِعَ سُلَيْمَانَ بْنَ يَسَارٍ يُحَدِّثُ , عَنْ زَيْدِ بْنِ ثَابِتٍ , أَنَّهُ قَالَ :  فِيالْعَيْنِ الْقَائِمَةِ تُبْخَصُ عُشْرُ الدِّيَةَ مِائَةُ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16901","عَنِ ابْنِ جُرَيْجٍ ، عَنْ يَحْيَى ، أَنَّهُ سَمِعَ سَعِيدَ بْنَ الْمُسَيِّبِ , يَقُولُ :  فِيالْعَيْنِ الْقَائِمَةِ تُبْخَصُ عُشْرُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16902","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  قَضَى فِيالْعَيْنِ الْعَوْرَاءِ ، إِذَا خُسِفَتْ بِثُلُثِ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16903","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ  فِيالْعَيْنِ الْقَائِمَةِ ، إِذَا أُصِيبَتْ وَطُفِئَتْ بِثُلُثِ دِيَتِهَا ""","","","","","Book of Blood Money (Diyat)"
"16904","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ  فِيالْيَدِ الْعَثْمَاءِ ، وَالْعَيْنِ الْقَائِمَةِ ، وَالتَّرْقُوَةِ ، وَالضِّلْعِ ، وَأَشْبَاهِهِ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"16905","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ , أَنَّ فِي كِتَابٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ إِنْ لُطِمَتِ الْعَيْنُ فَدَمَعَتْ مِنْ أَعْلاهَا دُمُوعًا لا تَرْقَأُ ، فَإِنَّهَا ثُلُثَا دِيَةٍ ، وَإِنْ كَانَتْ دَمْعَةً لا يَجِفُّ دَمْعُهَا ، وَهِيَ دُونَ الدَّمْعَةِ الأُولَى فَنِصْفُ دِيَةِ الْعَيْنِ ، وَإِنْ كَانَتْ دَمْعَةً مِنَ الْجَفْنِ تَسْحَلُ أَحْيَانًا يَذْهَبُ فِيهَا بَصَرُهَا فَفِيهَا خَمْسُمِائَةِ دِينَارٍ ، وَإِنْ كَانَتْ دَمْعَةً تَجِفُّ مَرَّةً ، وَتَسْحَلُ أُخْرَى , تُؤْذِيهِ وَتَضُرُّ بِبَصَرِهِ , فَخُمْسِ دِيَةِ الْعَيْنِ ، وَإِنْ كَانَتْ دَمْعَةً مِنْ أَسْفَلِ الْعَيْنِ فِيهَا شُفْرَةٌ ، فَعَلَى نَحْوِ ذَلِكَ مِنْ مِائَةِ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16906","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ , قَالَ : إِنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , كَتَبَ إِلَى أُمَرَاءِ الأَجْنَادِ أَنْ يَكْتُبُوا إِلَيْهِ بِعِلْمِ عُلَمَائِهِمْ , قَالَ : وَمِمَّا اجْتَمَعَ عَلَيْهِ فُقَهَاؤُهُمْ  فِيشَتَرِ الْعَيْنِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16907","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ ، كَتَبَ إِلَى أُمَرَاءِ الأَجْنَادِ أَنْ يَكْتُبُوا إِلَيْهِ بِعِلْمِ عُلَمَائِهِمْ , قَالَ : وَمِمَّا اجْتَمَعَ عَلَيْهِ فُقَهَاؤُهُمْ  فِيحِجَاجِ الْعَيْنِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16908","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كَمْ فِي الأَنْفِ يُسْتَأْصَلُ ؟ قَالَ : الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"16909","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالأَنْفِ الدِّيَةُ إِذَا اسْتُؤْصِلَ ""","","","","","Book of Blood Money (Diyat)"
"16910","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَتَبَ لَهُمْ كِتَابًا , فِيهِ : وَفِي الأَنْفِ ، إِذَا أُوعِي جَدْعُهُ الدِّيَةُ كَامِلَةً , مِائَةٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16911","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَضَى فِي الأَنْفِ الدِّيَةَ ""","","","","","Book of Blood Money (Diyat)"
"16912","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيرَوْثَةِ الأَنْفِ ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16913","عَنِ ابْنِ جُرَيْجٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، أَنَّهُ كَانَ يَقُولُ :  فِيالرَّوْثَةِ الثُّلُثُ ، فَإِذَا بَلَغَ الْمَارِنُ الْعَظْمَ , فَالدِّيَةُ وَافِيَةً ، فَإِنْ أُصِيبَتْ مِنَ الرَّوْثَةِ الأَرْنَبَةُ أَوْ غَيْرُهَا مَا لَمْ يَبْلُغِ الْعَظْمَ فَبِحِسَابِ الرَّوْثَةِ ""","","","","","Book of Blood Money (Diyat)"
"16914","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَضَى فِيالأَنْفِ إِذَا جُدِعَ كُلُّهُ بِالدِّيَةِ ، وَإِذَا جُدِعَتْ رَوْثَتُهُ فَالنِّصْفُ ""","","","","","Book of Blood Money (Diyat)"
"16915","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , قَالَ :  فِيالأَنْفِ إِذَا أُوعِي جَدْعُهُ الدِّيَةُ كَامِلَةً ، فَمَا أُصِيبَ مِنَ الأَنْفِ دُونَ ذَلِكَ فَبِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"16916","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ :  قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيالأَنْفِ إِذَا جُدِعَ كُلُّهُ بِالْعَقْلِ كَامِلا ، وَإِذَا جُدِعَتْ رَوْثَتُهُ بِنِصْفِ الْعَقْلِ , خَمْسِينَ مِنَ الإِبِلِ ، أَوْ عَدْلِهَا مِنَ الذَّهَبِ , أَوِ الْوَرِقِ , أَوِ الْبَقَرِ , أَوِ الشَّاءِ ""","","","","","Book of Blood Money (Diyat)"
"16917","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , قَالَ : فِي الْكِتَابِ الَّذِي عِنْدَهُمْ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  فِيالأَنْفِ إِذَا قُطِعَ الْمَارِنُ مِائَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16918","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  فِيالأَنْفِ إِذَا أُوعِي جَدْعُهُ الدِّيَةُ كَامِلَةً ، وَمَا أُصِيبَ مِنَ الأَنْفِ دُونَ ذَلِكَ فَبِحِسَابِهِ , أَوْ عَدْلِ ذَلِكَ مِنَ الذَّهَبِ , أَوِ الْوَرِقِ ، وَفِي أَنْفِ الْمَرْأَةِ إِذَا أَوْعِيَتِ الدِّيَةُ كَامِلَةً ، فَمَا أُصِيبَ مِنَ الأَنْفِ دُونَ ذَلِكَ ، فَبِحِسَابِ ذَلِكَ مِنَ الذَّهَبِ أَوِ الْوَرِقِ ""","","","","","Book of Blood Money (Diyat)"
"16919","عَنِ الثَّوْرِيِّ ، عَنْ أَبِيهِ ، عَنِ الشَّعْبِيِّ , قَالَ : مَا ذَهَبَ مِنَ الأَنْفِ فَبِحِسَابِهِ ""","","","","","Book of Blood Money (Diyat)"
"16920","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : لِلأَنْفِ جَائِفَةٌ ؟ قَالَ : نَعَمْ ""","","","","","Book of Blood Money (Diyat)"
"16921","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  كَانَ يَقُولُ فِيجَائِفَةِ الأَنْفِ ثُلُثُ الدِّيَةِ ، فَإِنْ نَفَذَتْ فَالثُّلُثَانِ ""","","","","","Book of Blood Money (Diyat)"
"16922","عَنْ مَعْمَرٍ ، عَنْ عَطَاءٍ الْخُرَاسَانِيِّ  فِي الأَنْفِإِذَا خُرِمَ مِائَةُ دِينَارٍ "", قَالَ مَعْمَرٌ : وَسَمِعْتُ غَيْرَهُ يَقُولُ : "" ثُلُثُ الدِّيَةِ "" , يَقُولُ : "" هِيَ جَائِفَةٌ ""","","","","","Book of Blood Money (Diyat)"
"16923","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ : أَنَّ عَبْدًا كَسَرَ إِحْدَى قَصَبَتَيْ أَنْفِ رَجُلٍ , فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , فَقَالَ عُمَرُ : وَجَدْتُ فِي كِتَابٍ لِعُمَرَ بْنِ الْخَطَّابِ : أَيُّمَا عَظْمٍ كُسِرَ ، ثُمَّ جُبِرَ كَمَا كَانَ فَفِيهِ حِقَّتَانِ "", فَرَاجَعَهُ ابْنُ سُرَاقَةَ , قَالَ : إِنَّمَا كَسَرَ إِحْدَى الْقَصَبَتَيْنِ : "" فَأَبَى عُمَرُ إِلا أَنْ يَجْعَلَ فِيهِ الْحِقَّتَيْنِ ""","","","","","Book of Blood Money (Diyat)"
"16924","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , قَالَ : إِنْ كُسِرَ الأَنْفُ كَسْرًا يَكُونُ شَيْنًا فَسُدُسُ دِيَتِهِ ، وَإِنْ كَانَ فِي الْمَنْخَرَيْنِ مِنْهُمَا الشَّيْنُ فَثُلُثُ دِيَةِ الْمَنْخَرَيْنِ ، وَإِنْ كَانَ مَارِنُ الأَنْفِ مَهْبُورًا هَبْرَةً فَلَهُ ثُلُثُ الدِّيَةِ ، وَإِنْ كَانَ مَهْشُومًا مُلْتَطِيًا يَبَحُّ صَوْتُهُ كَالْعَيْنِ فَنِصْفُ الدِّيَةِ , فَعَسَّهُ وَبَحَّهُ خَمْسُمِائَةِ دِينَارٍ ، وَإِنْ كَانَ لَيْسَ فِيهِ عَيْبٌ وَلا غَشٌّ , وَلا رِيحٌ يُوجَدُ مِنْهُ , فَلَهُ رُبُعُ الدِّيَةِ ، فَإِنْ أُصِيبَتْ قَصَبَةُ الأَنْفِ فَجَافَتْ وَفِيهِ شَيْنٌ , غَيْرَ أَنَّهُ لا يَجِدُ فِيهِ رِيحَ نَتْنٍ , فَثُمُنُ الدِّيَةِ مِائَةٌ وَخَمْسَةٌ وَعِشْرُونَ دِينَارًا ، وَإِنْ ضَرَبَ أَنْفَهُ فَبَرَأَ فِي غَيْرِ شَيْنٍ , غَيْرَ أَنَّهُ لا يَجِدُ رِيحًا طَيِّبَةً ، وَلا رِيحَ نَتَنٍ , فَلَهُ عُشْرُ الدِّيَةِ , مِائَةُ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16925","سَمِعْتُ مَوْلًى لِسُلَيْمَانَ بْنِ حَبِيبٍ يُحَدِّثُ , قَالَ : قَضَى سُلَيْمَانُ بْنُ حَبِيبٍ فِي الأَنْفِ إِذَا أُوثِيَ بِعَشَرَةِ دَنَانِيرَ ، وَإِذَا كُسِرَ بِمِائَةِ دِينَارٍ ""","","","","","Book of Blood Money (Diyat)"
"16926","قَالَ سُفْيَانُ :  فِيالأَنْفِ إِذَا كُسِرَ حُكْمٌ ""","","","","","Book of Blood Money (Diyat)"
"16927","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، فِيرَجُلٍ نَتَفَ مِنْ لِحْيَةِ آخَرَ , قَالَ :  يُقْتَصُّ مِنْهُ بِالْمِيزَانِ , فَمَا لَمْ يَفِ أُكْمِلَ مِنْ شَعْرِ الرَّأْسِ "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ شُرَيْحٍ مِثْلَهُ""","","","","","Book of Blood Money (Diyat)"
"16928","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الشَّفَتَانِ ؟ قَالَ : خَمْسُونَ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16929","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالشَّفَتَيْنِ الدِّيَةُ كَامِلَةً "", قَالَ قَتَادَةُ : "" فَإِنْ قُطِعَتْ إِحْدَاهُمَا فَنِصْفُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16930","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ :  فِيالشَّفَةِ السُّفْلَى ثُلُثَا الدِّيَةِ ، وَفِي الْعُلْيَا ثُلُثُ الدِّيَةِ ""","","","","","Book of Blood Money (Diyat)"
"16931","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ :  فِيالشَّفَتَيْنِ : هُمَا سَوَاءٌ ، وَإِنَّمَا تَفْضُلُ السُّفْلَى فِي أَسْنَانِ الإِبِلِ "", وَقَالَ قَتَادَةُ : "" هُمَا سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16932","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ  فِيالشَّفَتَيْنِ خَمْسُونَ خَمْسُونَ ، وَتَفْضُلُ السُّفْلَى مِنَ الْعُلْيَا فِي الْمَرْأَةِ ، وَالرَّجُلِ فِي التَّغْلِيظِ ، وَلا تَفْضُلُ بِزِيَادَةٍ فِي الْعَدَدِ , وَلَكِنْ فِي أَسْنَانِ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16933","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي دَاوُدُ بنُ أَبِي عَاصِمٍ ، عَنْ يَعْقُوبَ بْنِ عَاصِمٍ ، أَنَّ مَرْوَانَ  قَضَى فِيالشَّفَةِ الْعُلْيَا بِخَمْسٍ وَأَرْبَعِينَ مِنَ الإِبِلِ ، وَفِي الشَّفَةِ السُّفْلَى بِخَمْسٍ وَخَمْسِينَ ""","","","","","Book of Blood Money (Diyat)"
"16934","عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى أَبُو بَكْرٍ :  فِيالشَّفَتَيْنِ بِالدِّيَةِ ، مِائَةٍ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
"16935","عَنِ الثَّوْرِيِّ ، عَنْ زَكَرِيَّا ، عَنِ الشَّعْبِيِّ , قَالَ : الشَّفَتَانِ سَوَاءٌ ""","","","","","Book of Blood Money (Diyat)"
"16936","عَنْ إِسْرَائِيلَ , قَالَ : أَخْبَرَنِي أَبُو إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ :  فِيالشَّفَتَيْنِ الدِّيَةُ ""","","","","","Book of Blood Money (Diyat)"
"16937","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ :  كَانَ يُقَالُ فِيكُلِّ وَاحِدٍ مِنَ الإِنْسَانِ : اللِّسَانِ ، وَالأَنْفِ ، وَشِبْهِ ذَلِكَ ، الدِّيَةُ ، وَفِي الاثْنَيْنِ الدِّيَةُ "" , قُلْتُ : الشَّفَتَيْنِ ؟ قَالَ : "" لَعَلَّ ذَلِكَ ""","","","","","Book of Blood Money (Diyat)"
"16938","عَنْ مَعْمَرٍ , قَالَ :  بَلَغَنِي فِيالشَّارِبَيْنَ عِشْرُونَ وَمِائَةُ دِينَارٍ , فِي كُلِّ وَاحِدٍ سِتُّونَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"16939","عَنِ ابْنِ جُرَيْجٍ , قَالَ : اجْتَمَعَ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ  أَنَّمَنْ مَرْطَ شَارِبَ فِيهِ سِتُّونَ دِينَارًا ، فَإِنْ مُرِطَا جَمِيعًا فَفِيهِمَا مِائَةٌ وَعِشْرُونَ دِينَارًا ""","","","","","Book of Blood Money (Diyat)"
"16940","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَتَبَ لَهُمْ كِتَابًا , فِيهِ :  وَفِيالسِّنِّ خَمْسٌ مِنَ الإِبِلِ ""","","","","","Book of Blood Money (Diyat)"
