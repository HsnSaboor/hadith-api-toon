hadiths[16]{hadithnumber,text}:
"20892","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے مجھ سے فرمایا اے عبدالرحمن بن سمرہ ! جب تم کسی بات پر قسم کھاا اور پھر کسی دوسری صورت میں خیر دیکھو تو خیر والے کام کو کر لو اور اپنی قسم کا کفارہ دے دو ۔"
"20893","حضرت عبدالرحمن رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ کی حیات طیبہ میں میں تیر اندازی کر رہا تھا کہ سورج کو گہن لگ گیا ، میں نے اپنے تیروں کو ایک طرف پھینکا اور نبی ﷽ کی طرف دوڑ پڑا تاکہ یہ دیکھ سکوں کہ کسوف شمس کے وقت نبی ﷽ کیا کرتے ہیں آ جب میں وہاں پہنچا تو نبی ﷽ ہاتھ اٹھائے اللہ کی تسبیح و تحمید اور تہلیل و تکبیر اور دعا میں مصروف تھے ، نبی ﷽ اس وقت تک اسی عمل میں مصروف رہے جب تک سورج روشن نہ ہو گیا ، پھر آپ ﷽ نے دو سورتیں پڑھیں اور دو رکعتیں پڑھائیں ۔"
"20894","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے فرمایا اے عبدالرحمن ! امارت + حکومت , کا سوال کبھی نہ کرنا ، اس لئے کہ اگر وہ تمہیں مانگ کر ملی تو تمہیں اس کے حوالے کر دیا جائے گا اور اگر بن مانگے تمہیں مل جائے تو اس پر تمہاری مدد کی جائے گی ، اور جب تم کسی بات پر قسم کھا لو ، پھر کسی دوسری صورت میں خیر دیکھو تو خیر والے کام کو کر لو اور اپنی قسم کا کفارہ دے دو ۔"
"20895","ابولبید کہتے ہیں کہ ہم نے حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ کے ساتھ کابل کے جہاد میں شرکت کی ، لوگوں کو ایک جگہ بکریاں نظر آئیں تو وہ انہیں لوٹ کر لے گئے ، یہ دیکھ کر حضرت عبدالرحمن رضی اللہ عنہ نے ایک منادی کو یہ نداء لگانے کا حکم دیا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ جو شخص لوٹ مار کرتا ہے وہ ہم میں سے نہیں ہے اس لئے یہ بکریاں واپس کر دو ، چنانچہ لوگوں نے وہ بکریاں واپس کر دیں اور انہوں نے وہ بکریاں برابر برابر تقسیم کر دیں ۔"
"20896","عمار بن ابی عمار کہتے ہیں کہ ایک مرتبہ ان کا گذر حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ کے پاس سے ہوا ، وہ نہر ام عبداللہ پر تھے ، اور اپنے لڑکوں اور غلاموں کے ساتھ مل کر پانی بہا رہے تھے ، عمار نے ان سے کہا اے ابوسعید ! آج تو جمعہ کا دن ہے ، انہوں نے فرمایا کہ نبی ﷽ فرمایا کرتے تھے جس دن موسلا دھار بارش برس رہی ہو تو تمہیں چاہیے کہ اپنے خیموں میں نماز پڑھ لو ۔"
"20897","گزشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"20898","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے فرمایا اے عبدالرحمن ! امارت + حکومت , کا سوال کبھی نہ کرنا ، اس لئے کہ اگر وہ تمہیں مانگ کر ملی تو تمہیں اس کے حوالے کر دیا جائے گا اور اگر بن مانگے تمہیں مل جائے تو اس پر تمہاری مدد کی جائے گی ، اور جب تم کسی بات پر قسم کھا لو ، پھر کسی دوسری صورت میں خیر دیکھو تو خیر والے کام کو کر لو اور اپنی قسم کا کفارہ دے دو ۔"
"20899","گزشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"20900","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا اپنے آباا اجداد یا بتوں کے نام کی قسم مت کھایا کرو ۔"
"20901","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے فرمایا اے عبدالرحمن ! امارت + حکومت , کا سوال کبھی نہ کرنا ، اس لئے کہ اگر وہ تمہیں مانگ کر ملی تو تمہیں اس کے حوالے کر دیا جائے گا اور اگر بن مانگے تمہیں مل جائے تو اس پر تمہاری مدد کی جائے گی ، اور جب تم کسی بات پر قسم کھا لو ، پھر کسی دوسری صورت میں خیر دیکھو تو خیر والے کام کو کر لو اور اپنی قسم کا کفارہ دے دو ۔"
"20902","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ نے فرمایا جو شخص لوٹ مار کرتا ہے وہ ہم میں سے نہیں ہے ۔"
"20903","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے فرمایا اے عبدالرحمن ! امارت + حکومت , کا سوال کبھی نہ کرنا ، اس لئے کہ اگر وہ تمہیں مانگ کر ملی تو تمہیں اس کے حوالے کر دیا جائے گا اور اگر بن مانگے تمہیں مل جائے تو اس پر تمہاری مدد کی جائے گی ، اور جب تم کسی بات پر قسم کھا لو ، پھر کسی دوسری صورت میں خیر دیکھو تو خیر والے کام کو کر لو اور اپنی قسم کا کفارہ دے دو ۔"
"20904","حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ سے مروی ہے کہ ایک مرتبہ نبی ﷽ نے مجھ سے فرمایا اے عبدالرحمن ! امارت + حکومت , کا سوال کبھی نہ کرنا ، اس لئے کہ اگر وہ تمہیں مانگ کر ملی تو تمہیں اس کے حوالے کر دیا جائے گا اور اگر بن مانگے تمہیں مل جائے تو اس پر تمہاری مدد کی جائے گی ، اور جب تم کسی بات پر قسم کھا لو ، پھر کسی دوسری صورت میں خیر دیکھو تو خیر والے کام کو کر لو اور اپنی قسم کا کفارہ دے دو ۔"
"20905","گزشتہ حدیث اس دوسری سند سے بھی مروی ہے ۔"
"20906","حضرت عبدالرحمن رضی اللہ عنہ سے مروی ہے کہ نبی ﷽ جس وقت """" جیش عسرہ """" + غزوہ تبوک , کی تیاری کر رہے تھے تو حضرت عثمان غنی رضی اللہ عنہ ایک کپڑے میں ایک ہزار دینار لے کر آئے اور لا کر نبی ﷽ کی گود میں ڈال دیئے ، نبی ﷽ انہیں اپنے ہاتھ سے پلٹتے جاتے تھے اور فرماتے جاتے تھے کہ آج کے بعد ابن عفان کوئی بھی عمل کریں ، وہ انہیں کوئی نقصان نہیں پہنچا سکے گا ، یہ جملہ آپ ﷽ نے کئی مرتبہ دہرایا ۔"
"20907","ابولبید کہتے ہیں کہ ہم نے حضرت عبدالرحمن بن سمرہ رضی اللہ عنہ کے ساتھ کابل کے جہاد میں شرکت کی ، لوگوں کو ایک جگہ بکریاں نظر آئیں تو وہ انہیں لوٹ کر لے گئے ، یہ دیکھ کر حضرت عبدالرحمن رضی اللہ عنہ نے ایک منادی کو یہ نداء لگانے کا حکم دیا کہ میں نے نبی ﷽ کو یہ فرماتے ہوئے سنا ہے کہ جو شخص لوٹ مار کرتا ہے وہ ہم میں سے نہیں ہے اس لئے یہ بکریاں واپس کر دو ، چنانچہ لوگوں نے وہ بکریاں واپس کر دیں اور انہوں نے وہ بکریاں برابر برابر تقسیم کر دیں ۔"
