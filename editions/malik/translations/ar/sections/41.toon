hadiths[34]{hadithnumber,text}:
"1500","[1500] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ،عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، أَنَّہُ کَانَ یَقُولُ : تُعَاقِلُ الْمَرْأَۃُ الرَّجُلَ إِلَی ثُلُثِ الدِّیَۃِ إِصْبَعُہَا کَإِصْبَعِہِ، وَسِنُّہَا کَسِنِّہِ، وَمُوضِحَتُہَا کَمُوضِحَتِہِ، وَمُنَقِّلَتُہَا کَمُنَقِّلَتِہِ۔\nموطا امام مالک حدیث: 1500 عربی حدیث:"
"1501","[1501] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ وَبَلَغَہُ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ: أَ نَّہُمَا کَانَا یَقُولاَنِ مِثْلَ قَوْلِ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْمَرْأَۃِ : أَ نَّہَا تُعَاقِلُ الرَّجُلَ إِلَی ثُلُثِ دِیَۃِ الرَّجُلِ، فَإِذَا بَلَغَتْ ثُلُثَ دِیَۃِ الرَّجُلِ کَانَتْ إِلَی النِّصْفِ مِنْ دِیَۃِ الرَّجُلِ۔\nموطا امام مالک حدیث: 1501 عربی حدیث:"
"1502","[1502] وَحَدَّثَنِی عَنْ مَالِکٍ، أَ نَّہُ سَمِعَ ابْنَ شِہَابٍ یَقُولُ : مَضَتِ السُّنَّۃُ أَنَّ الرَّجُلَ إِذَا أَصَابَ امْرَأَتَہُ بِجُرْحٍ : أَنَّ عَلَیْہِ عَقْلَ ذَلِکَ الْجُرْحِ، وَلاَ یُقَادُ مِنْہُ۔\nموطا امام مالک حدیث: 1502 عربی حدیث:"
"1503","[1503] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ، عَنْ أبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ، عَنْ أبِی ہُرَیْرَۃَ : أَنَّ امْرَأَتَیْنِ مِنْ ہُذَیْلٍ رَمَتْ إِحْدَاہُمَا الأُخْرَی فَطَرَحَتْ جَنِینَہَا، فَقَضَی فِیہِ رَسُولُ اللّٰہِ  ﷺ  بِغُرَّۃٍ عَبْدٍ أَوْ وَلِیدَۃٍ۔\nموطا امام مالک حدیث: 1503 عربی حدیث:"
"1504","[1504] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ رَسُولَ اللّٰہِ  ﷺ  قَضَی فِی الْجَنِینِ یُقْتَلُ فِی بَطْنِ أُمِّہِ بِغُرَّۃٍ عَبْدٍ أَوْ وَلِیدَۃٍ. فَقَالَ الَّذِی قُضِیَ عَلَیْہِ : کَیْفَ أَغْرَمُ مَالاَ شَرِبَ وَلاَ أَکَلْ وَلاَ نَطَقَ وَلاَ اسْتَہَلْ، وَمِثْلُ ذَلِکَ بَطَلْ۔ فَقَالَ رَسُولُ اللّٰہِ  ﷺ  : إِنَّمَا ہَذَا مِنْ إِخْوَانِ الْکُہَّانِ۔\nموطا امام مالک حدیث: 1504 عربی حدیث:"
"1505","[1505] وَحَدَّثَنِی عَنْ مَالِکٍ، عَنْ رَبِیعَۃَ بْنِ أبِی عَبْدِ الرَّحْمَنِ، أَ نَّہُ کَانَ یَقُولُ : الْغُرَّۃُ تُقَوَّمُ خَمْسِینَ دِینَاراً، أَوْ سِتَّ مِئَۃِ دِرْہَمٍ، وَدِیَۃُ الْمَرْأَۃِ الْحُرَّۃِ الْمُسْلِمَۃِ خَمْسُ مِئَۃِ دِینَارٍ، أَوْ سِتَّۃُ آلاَفِ دِرْہَمٍ۔\nموطا امام مالک حدیث: 1505 عربی حدیث:"
"1506","[1506] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، أَ نَّہُ کَانَ یَقُولُ : فِی الشَّفَتَیْنِ الدِّیَۃُ کَامِلَۃً، فَإِذَا قُطِعَتِ السُّفْلَی فَفِیہَا ثُلُثَا الدِّیَۃِ۔\nموطا امام مالک حدیث: 1506 عربی حدیث:"
"1507","[1507] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، أَنَّہُ سَأَلَ ابْنَ شِہَابٍ عَنِ الرَّجُلِ الأَعْوَرِ یَفْقَأُ عَیْنَ الصَّحِیحِ؟ فَقَالَ ابْنُ شِہَابٍ : إِنْ أَحَبَّ الصَّحِیحُ أَنْ یَسْتَقِیدَ مِنْہُ فَلَہُ الْقَوَدُ، وَإِنْ أَحَبَّ فَلَہُ الدِّیَۃُ أَلْفُ دِینَارٍ، أَوِ اثْنَا عَشَرَ أَلْفَ دِرْہَمٍ۔\nموطا امام مالک حدیث: 1507 عربی حدیث:"
"1508","[1508] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ، أَنَّ زَیْدَ بْنَ ثَابِتٍ کَانَ یَقُولُ : فِی الْعَیْنِ الْقَائِمَۃِ إِذَا طَفِئَتْ مِئَۃُ دِینَارٍ۔\nموطا امام مالک حدیث: 1508 عربی حدیث:"
"1509","[1509] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، أَ نَّہُ سَمِعَ سُلَیْمَانَ بْنَ یَسَارٍ یَذْکُرُ : أَنَّ الْمُوضِحَۃَ فِی الْوَجْہِ مِثْلُ الْمُوضِحَۃِ فِی الرَّأْسِ، إِلاَّ أَنْ تَعِیبَ الْوَجْہَ فَیُزَادُ فِی عَقْلِہَا، مَا بَیْنَہَا وَبَیْنَ عَقْلِ نِصْفِ الْمُوضِحَۃِ فِی الرَّأْسِ، فَیَکُونُ فِیہَا خَمْسَۃٌ وَسَبْعُونَ دِینَاراً۔\nموطا امام مالک حدیث: 1509 عربی حدیث:"
"1510","[1510] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، أَنَّہُ قَالَ : کُلُّ نَافِذَۃٍ فِی عُضْوٍ مِنَ الأَعْضَائِ فَفِیہَا ثُلُثُ عَقْلِ ذَلِکَ الْعُضْوِ۔\nموطا امام مالک حدیث: 1510 عربی حدیث:"
"1511","[1511] حَدَّثَنِی مَالِکٌ : کَانَ ابْنُ شِہَابٍ لاَ یَرَی ذَلِکَ، وَأَنَا لاَ أَرَی فِی نَافِذَۃٍ فِی عُضْوٍ مِنَ الأَعْضَائِ فِی الْجَسَدِ أَمْراً مُجْتَمَعاً عَلَیْہِ، وَلَکِنِّی أَرَی فِیہَا الاِجْتِہَادَ، یَجْتَہِدُ الإِمَامُ فِی ذَلِکَ، وَلَیْسَ فِی ذَلِکَ أَمْرٌ مُجْتَمَعٌ عَلَیْہِ عِنْدَنَا.\nموطا امام مالک حدیث: 1511 عربی حدیث:"
"1512","[1512] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ رَبِیعَۃَ بْنِ أبِی عَبْدِ الرَّحْمَنِ : أَنَّ عَبْدَ اللّٰہِ بْنَ الزُّبَیْرِ أَقَادَ مِنَ الْمُنَقِّلَۃِ۔\nموطا امام مالک حدیث: 1512 عربی حدیث:"
"1513","[1513] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ رَبِیعَۃَ بْنِ أبِی عَبْدِ الرَّحْمَنِ، أَ نَّہُ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ کَمْ فِی إِصْبَعِ الْمَرْأَۃِ : فَقَالَ عَشْرٌ مِنَ الإِبِلِ. فَقُلْتُ : کَمْ فِی إِصْبَعَیْنِ ؟ قَالَ : عِشْرُونَ مِنَ الإِبِلِ۔ فَقُلْتُ : کَمْ فِی ثَلَاثٍ : فَقَالَ : ثَـلَاثُونَ مِنَ الإِبِلِ. فَقُلْتُ : کَمْ فِی أَرْبَعٍ ؟ قَالَ : عِشْرُونَ مِنَ الإِبِلِ۔ فَقُلْتُ : حِینَ عَظُمَ جُرْحُہَا وَاشْتَدَّتْ مُصِیبَتُہَا نَقَصَ عَقْلُہَا ؟ فَقَالَ سَعِیدٌ : أَعِرَاقِیٌّ أَنْتَ ؟ فَقُلْتُ : بَلْ عَالِمٌ مُتَثَبِّتٌ، أَوْ جَاہِلٌ مُتَعَلِّمٌ۔ فَقَالَ سَعِیدٌ : ہِیَ السُّنَّۃُ یَا ابْنَ أَخِی۔\nموطا امام مالک حدیث: 1513 عربی حدیث:"
"1514","[1514] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ زَیْدِ بْنِ أَسْلَمَ، عَنْ مُسْلِمِ بْنِ جُنْدُبٍ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ بْنِ الْخَطَّابِ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَضَی فِی الضِّرْسِ بِجَمَلٍ وََفِی التَّرْقُوَۃِ بِجَمَلٍ، وَفِی الضِّلَعِ بِجَمَلٍ۔\nموطا امام مالک حدیث: 1514 عربی حدیث:"
"1515","[1515] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، أَ نَّہُ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : قَضَی عُمَرُ بْنُ الْخَطَّابِ فِی الأَضْرَاسِ بِبَعِیرٍ بَعِیرٍ، وَقَضَی مُعَاوِیَۃُ بْنُ أبِی سُفْیَانَ فِی الأَضْرَاسِ بِخَمْسَۃِ أَبْعِرَۃٍ خَمْسَۃِ أَبْعِرَۃٍ.قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : فَالدِّیَۃُ تَنْقُصُ فِی قَضَائِ عُمَرَ بْنِ الْخَطَّابِ، وَتَزِیدُ فِی قَضَائِ مُعَاوِیَۃَ، فَلَوْ کُنْتُ أَنَا لَجَعَلْتُ فِی الأَضْرَاسِ بَعِیرَیْنِ بَعِیرَیْنِ، فَتِلْکَ الدِّیَۃُ سَوَائٌ، وَکُلُّ مُجْتَہِدٍ مَأْجُورٌ۔\nموطا امام مالک حدیث: 1515 عربی حدیث:"
"1516","[1516] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، أَنَّہُ کَانَ یَقُولُ : إِذَا أُصِیبَتِ السِّنُّ فَاسْوَدَّتْ فَفِیہَا عَقْلُہَا تَامًّا، فَإِنْ طُرِحَتْ بَعْدَ أَنْ تَسْوَدَّ، فَفِیہَا عَقْلُہَا أَیْضاً تَامًّا۔\nموطا امام مالک حدیث: 1516 عربی حدیث:"
"1517","[1517] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ، عَنْ أبِی غَطَفَانَ بْنِ طَرِیفٍ الْمُرِّیِّ، أَ نَّہُ أَخْبَرَہُ : أَنَّ مَرْوَانَ بْنَ الْحَکَمِ بَعَثَہُ إِلَی عَبْدِ اللّٰہِ بْنِ عَبَّاسٍ یَسْأَلُہُ : مَاذَا فِی الضِّرْسِ؟ فَقَالَ عَبْدُ اللّٰہِ بْنُ عَبَّاسٍ : فِیہِ خَمْسٌ مِنَ الإِبِلِ. قَالَ : فَرَدَّنِی مَرْوَانُ إِلَی عَبْدِ اللّٰہِ بْنِ عَبَّاسٍ فَقَالَ : أَتَجْعَلُ مُقَدَّمَ الْفَمِ مِثْلَ الأَضْرَاسِ؟ فَقَالَ عَبْدُ اللّٰہِ بْنُ عَبَّاسٍ : لَوْ لَمْ تَعْتَبِرْ ذَلِکَ إِلاَّ بِالأَصَابِعِ عَقْلُہَا سَوَائٌ۔\nموطا امام مالک حدیث: 1517 عربی حدیث:"
"1518","[1518] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، أَ نَّہُ کَانَ یُسَوِّی بَیْنَ الأَسْنَانِ فِی الْعَقْلِ، وَلَا یُفَضِّلُ بَعْضَہَا عَلَی بَعْضٍ۔\nموطا امام مالک حدیث: 1518 عربی حدیث:"
"1520","[1520] وَحَدَّثَنِی مَالِکٌ، أَ نَّہُ بَلَغَہُ : أَنَّ مَرْوَانَ بْنَ الْحَکَمِ کَانَ یَقْضِی فِی الْعَبْدِ یُصَابُ بِالْجِرَاحِ : أَنَّ عَلَی مَنْ جَرَحَہُ قَدْرَ مَا نَقَصَ مِنْ ثَمَنِ الْعَبْدِ۔\nموطا امام مالک حدیث: 1520 عربی حدیث:"
"1521","[1521] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، أَ نَّہُ بَلَغَہُ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَضَی : أَنَّ دِیَۃَ الْیَہُودِیِّ أَوِ النَّصْرَانِیِّ إِذَا قُتِلَ أَحَدُہُمَا، مِثْلُ نِصْفِ دِیَۃِ الْحُرِّ الْمُسْلِمِ۔\nموطا امام مالک حدیث: 1521 عربی حدیث:"
"1522","[1522] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ : أَنَّ سُلَیْمَانَ بْنَ یَسَارٍ کَانَ یَقُولُ : دِیَۃُ الْمَجُوسِیِّ ثَمَانِی مِئَۃِ دِرْہَمٍ۔\nموطا امام مالک حدیث: 1522 عربی حدیث:"
"1523","[1523] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، أَ نَّہُ کَانَ یَقُولُ : لَیْسَ عَلَی الْعَاقِلَۃِ عَقْلٌ فِی قَتْلِ الْعَمْدِ، إِنَّمَا عَلَیْہِمْ عَقْلُ قَتْلِ الْخَطَإِ۔\nموطا امام مالک حدیث: 1523 عربی حدیث:"
"1524","[1524] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ، أَنَّہُ قَالَ : مَضَتِ السُّنَّۃُ أَنَّ الْعَاقِلَۃَ لَا تَحْمِلُ شَیْئاً مِنْ دِیَۃِ الْعَمْدِ، إِلاَّ أَنْ یَشَاؤُوا ذَلِکَ۔\nموطا امام مالک حدیث: 1524 عربی حدیث:"
"1525","[1525] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ مِثْلَ ذَلِکَ۔\nموطا امام مالک حدیث: 1525 عربی حدیث:"
"1526","[1526] عَنِ ابْنِ شِھَابٍ قَالَ مَالِکٌ : مَضَتِ السُّنَّۃُ فِی قَتْلِ الْعَمْدِ حِینَ یَعْفُو أَوْلِیَائُ الْمَقْتُولِ : أَنَّ الدِّیَۃَ تَکُونُ عَلَی الْقَاتِلِ فِی مَالِہِ خَاصَّۃً : إِلاَّ أَنْ تُعِینَہُ الْعَاقِلَۃُ عَنْ طِیبِ نَفْسٍ مِنْہَا۔\nموطا امام مالک حدیث: 1526 عربی حدیث:"
"1527","[1527] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ نَشَدَ النَّاسَ بِمِنًی : مَنْ کَانَ عِنْدَہُ عِلْمٌ مِنَ الدِّیَۃِ أَنْ یُخْبِرَنِی۔ فَقَامَ الضَّحَّاکُ بْنُ سُفْیَانَ الْکِلابِی فَقَالَ : کَتَبَ إِلَیَّ رَسُولُ اللّٰہِ  ﷺ  : أَنْ أُوَرِّثَ امْرَأَۃَ أَشْیَمَ الضِّبَأبِی مِنْ دِیَۃِ زَوْجِہَا۔ فَقَالَ لَہُ عُمَرُ بْنُ الْخَطَّابِ : ادْخُلِ الْخِبَائَ حَتَّی آتِیَکَ، فَلَمَّا نَزَلَ عُمَرُ بْنُ الْخَطَّابِ أَخْبَرَہُ الضَّحَّاکُ، فَقَضَی بِذَلِکَ عُمَرُ بْنُ الْخَطَّابِ. قَالَ ابْنُ شِہَابٍ :وَکَانَ قَتْلُ أَشْیَمَ خَطَأً۔\nموطا امام مالک حدیث: 1527 عربی حدیث:"
"1529","[1529] وَحَدَّثَنِی مَالِکٌ، أَنَّہُ بَلَغَہُ : أَنَّ سَعِیدَ بْنَ الْمُسَیَّبِ، وَسُلَیْمَانَ بْنَ یَسَارٍ سُئِلَا : أَتُغَلَّظُ الدِّیَۃُ فِی الشَّہْرِ الْحَرَامِ ؟ فَقَالَا: لَا، وَلَکِنْ یُزَادُ فِیہَا لِلْحُرْمَۃِ۔ فَقِیلَ لِسَعِیدٍ: ہَلْ یُزَادُ فِی الْجِرَاحِ کَمَا یُزَادُ فِی النَّفْسِ ؟ فَقَالَ : نَعَمْ۔\nموطا امام مالک حدیث: 1529 عربی حدیث:"
"1530","[1530] وَحَدَّثَنِی مَالِکٌ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ : أَنَّ رَجُلاً مِنَ الْأَنْصَارِ، یُقَالُ لَہُ : أُحَیْحَۃُ بْنُ الْجُلَاحِ ، کَانَ لَہُ عَمٌّ صَغِیرٌ ہُوَ أَصْغَرُ مِنْ أُحَیْحَۃَ، وَکَانَ عِنْدَ أَخْوَالِہِ، فَأَخَذَہُ أُحَیْحَۃُ فَقَتَلَہُ، فَقَالَ أَخْوَالُہُ : کُنَّا أَہْلَ ثُمِّہِ وَرُمِّہِ، حَتَّی إِذَا اسْتَوَی عَلَی عُمَمِہِ، غَلَبَنَا حَقُّ امْرِیٍٔ فِی عَمِّہِ۔ قَالَ عُرْوَۃُ فَلِذَلِکَ لَا یَرِثُ قَاتِلٌ مَنْ قَتَلَ۔\nموطا امام مالک حدیث: 1530 عربی حدیث:"
"1531","[1531] حَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنِ ابْنِ شِہَابٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ, وَأبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أبِی ہُرَیْرَۃَ، أَنَّ رَسُولَ اللّٰہِ  ﷺ  قَالَ :جَرْحُ الْعَجْمَائِ جُبَارٌ، وَالْبِئْرُ جُبَارٌ، وَالْمَعْدِنُ جُبَارٌ، وَفِی الرِّکَازِ الْخُمُسُ۔\nموطا امام مالک حدیث: 1531 عربی حدیث:"
"1532","[1532] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَتَلَ نَفَراً خَمْسَۃً أَوْ سَبْعَۃً بِرَجُلٍ وَاحِدٍ، قَتَلُوہُ قَتْلَ غِیلَۃٍ، وَقَالَ عُمَرُ : لَوْ تَمَالَأَ عَلَیْہِ أَہْلُ صَنْعَائَ، لَقَتَلْتُہُمْ جَمِیعاً۔\nموطا امام مالک حدیث: 1532 عربی حدیث:"
"1533","[1533] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ زُرَارَۃَ، أَنَّہُ بَلَغَہُ : أَنَّ حَفْصَۃَ زَوْجَ النَّبِیِّ ﷺ  قَتَلَتْ جَارِیَۃً لَہَا سَحَرَتْہَا، وَقَدْ کَانَتْ دَبَّرَتْہَا، فَأَمَرَتْ بِہَا فَقُتِلَتْ۔\nموطا امام مالک حدیث: 1533 عربی حدیث:"
"1534","[1534] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، عَنْ عُمَرَ بْنِ حُسَیْنٍ مَوْلَی عَائِشَۃَ بِنْتِ قُدَامَۃَ : أَنَّ عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ أَقَادَ وَلِیَّ رَجُلٍ مِنْ رَجُلٍ قَتَلَہُ بِعَصاً، فَقَتَلَہُ وَلِیُّہُ بِعَصاً۔\nموطا امام مالک حدیث: 1534 عربی حدیث:"
"1536","[1536] وَحَدَّثَنِی یَحْیَی، عَنْ مَالِکٍ، أَ نَّہُ بَلَغَہُ : أَنَّ أَبَا بَکْرِ بْنَ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ أَقَادَ مِنْ کَسْرِ الْفَخِذِ۔\nموطا امام مالک حدیث: 1536 عربی حدیث:"
