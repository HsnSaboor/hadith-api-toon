"546","[AI-translation] ((अली (रज़ियल्लाहु अन्हु) इतनी बुलन्द आवाज़ से तकबीरात कहते कि रास्ते के लोग सुनते))।"
"547","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ईद की नमाज़ों में जनाज़े की तकबीरों जैसी चार तकबीरें कहते))।"
"548","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने ईद की नमाज़ दो रकअतों में पढ़ाई और उनमें सिर्फ़ सूरत-ए-फ़ातिहा पढ़ी))।"
"549","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ईद की नमाज़ों में 'अम्मा यतसाअलून' और 'वश-शम्सि व दुहाहा' पढ़ते))।"
"550","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने दोनों ईदों के मौक़े पर इस्लामी इलाक़ों में हथियार पहनने से मना किया, सिवाय इसके कि दुश्मन मौजूद हो [तो ममनूअ नहीं]))।"
"551","[AI-translation] ((मैंने रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) को दोनों ईदों के दिनों में देखा, और आपके सामने नेज़ा था))।"
"552","[AI-translation] ((एक ईद के मौक़े पर लोगों पर बारिश हुई, तो नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने उन्हें मस्जिद के अन्दर ईद की नमाज़ पढ़ाई))।"
"553","[AI-translation] ((मेरी उम्मत के बेहतरीन लोग वे हैं जो सफ़र में क़स्र [छोटी] नमाज़ें पढ़ते हैं))।"
"554","[AI-translation] ((ऐ मक्का वालो! चार बरीद से कम फ़ासले के लिए क़स्र न करो, जैसे मक्का से उसफ़ान का फ़ासला))।"
"555","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) कभी सफ़र में क़स्र पढ़ते और कभी पूरी पढ़ते))।"
"556","[AI-translation] ((आइशा (रज़ियल्लाहु अन्हा) ने कहा कि मैं नबी (सल्लल्लाहु अलैहि वसल्लम) के साथ रमज़ान में उमरा के लिए गई, तो आपने क़स्र पढ़ीं जबकि मैंने पूरी पढ़ीं। फिर मैंने उनसे कहा: आपने क़स्र पढ़ीं और मैंने पूरी पढ़ीं। तो नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ऐ आइशा! तूने भी अच्छा किया))।"
"557","[AI-translation] ((जो सफ़र में पूरी नमाज़ें पढ़े वह ऐसा है जैसे घर में क़स्र पढ़े))।"
"558","[AI-translation] ((जो सफ़र में चार रकअतें पढ़े वह ऐसा है जैसे घर में दो रकअतें पढ़े))।"
"559","[AI-translation] ((जो सफ़र में चार रकअतें पढ़े वह नमाज़ दोहराए))।"
"560","[AI-translation] ((हज या जिहाद के सिवा क़स्र न करो))।"
"561","[AI-translation] ((जो नमाज़ भूल जाए उसकी नमाज़ का वक़्त जब याद आए वही है))।"
"562","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से उस शख़्स के बारे में पूछा गया जो नमाज़ के दौरान भूल जाए कि कितनी रकअतें पढ़ीं। आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: वह नमाज़ दोहराए और बैठकर दो सज्दे करे।"
"563","[AI-translation] ((ख़ौफ़ की नमाज़ में कोई सह्व [भूल] नहीं))।"
"564","[AI-translation] ((इमाम के पीछे मुक़्तदी पर सह्व के सज्दे [सज्दा-सह्व] नहीं, लेकिन अगर इमाम भूले तो इमाम और मुक़्तदी दोनों सह्व के सज्दे करें))।"
"565","[AI-translation] ((जब तुममें से कोई नमाज़ के दौरान जूते उतारे तो उन्हें अपने सामने न रखे, क्योंकि तब वह उनकी पैरवी करेगा, न उन्हें अपने पीछे रखे, क्योंकि तब उसका कोई भाई उनकी पैरवी कर सकता है; बल्कि उन्हें अपने पैरों के दरमियान रखे))।"
"566","[AI-translation] ((सूरज-चाँद ग्रहण की नमाज़ की हर रकअत [इकाई] में एक रुकूअ है))।"
"567","[AI-translation] ((क्या सूरत-ए-हज को इसलिए फ़ज़ीलत दी गई क्योंकि उसमें दो सज्दे हैं?)) नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((हाँ, और जो दोनों सज्दे न करे वह उन्हें न पढ़े))।"
"568","[AI-translation] ((क़ैदी की नमाज़ दो रकअतें हैं यहाँ तक कि वह मरे या अल्लाह उसे क़ैद से आज़ाद करे))।"
"569","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने हज़रत जाफ़र (रज़ियल्लाहु अन्हु) को कश्ती पर खड़े होकर नमाज़ पढ़ने का हुक्म दिया, सिवाय इसके कि डूबने का ख़तरा हो [तो बैठकर पढ़ने की इजाज़त है]))।"
"570","[AI-translation] ((अल्लाह तआला तीन लोगों की नमाज़ क़ुबूल नहीं करता, न उनकी कोई नेकी आसमानों की तरफ़ उठती है: भागा हुआ ग़ुलाम यहाँ तक कि अपने आक़ाओं के पास लौटे; वह औरत जिससे उसका शौहर नाराज़ हो यहाँ तक कि उससे राज़ी हो जाए; और नशे वाला यहाँ तक कि होश में आए))।"
"571","[AI-translation] ((जो यतीम का सरपरस्त बने वह उसके माल से तिजारत करे और उसे न छोड़े ताकि ज़कात उसे खा जाए))।"
"572","[AI-translation] ((मैंने पूछा: ऐ अल्लाह के रसूल (सल्लल्लाहु अलैहि वसल्लम)! ज़कात के बारे में, और आप (सल्लल्लाहु अलैहि वसल्लम) से इसके बारे में पूछा गया। आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: बेशक माल में ज़कात के सिवा भी [वाजिब] हक़ है। फिर आप (सल्लल्लाहु अलैहि वसल्लम) ने सूरत-ए-बक़रा की यह आयत पढ़ी: नेकी यह नहीं कि तुम अपने चेहरे मशरिक़ या मग़रिब की तरफ़ फेरो))।"
"573","[AI-translation] ((हर चरने वाले घोड़े पर एक दीनार ज़कात है))।"
"574","[AI-translation] ((दरमियानी मिक़दार [यानी दो तयशुदा मिक़दारों के दरमियान] में कोई फ़र्ज़ ज़कात नहीं))।"
"575","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) हमें तिजारत के सामान पर ज़कात देने का हुक्म देते))।"
"576","[AI-translation] ((खीरा, तरबूज़, अनार, गन्ना और सब्ज़ियों में रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने ज़कात माफ़ की है))।"
"577","[AI-translation] ((सब्ज़ियों पर कोई ज़कात नहीं))।"
"578","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने हुक्म दिया कि अंगूरों का अन्दाज़ा उसी तरह लगाया जाए जैसे खजूरों का लगाया जाता है, और उनकी ज़कात सूखी किशमिश की सूरत में वसूल की जाए जैसे खजूरों की ज़कात सूखी खजूरों [यानी छुआरा] की सूरत में ली जाती है))।"
"579","[AI-translation] ((ज़ेवर पर कोई ज़कात नहीं))।"
"580","[AI-translation] ((जब अनाज का अन्दाज़ा और क़ीमत लगाओ तो एक तिहाई छोड़ दो; अगर एक तिहाई न छोड़ सको तो एक चौथाई छोड़ दो))।"
"581","[AI-translation] ((शहद में कोई ज़कात नहीं))।"
"582","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने क़ब्लिय्या के मक़ाम की खानें हज़रत बिलाल इब्ने हारिस मुज़नी (रज़ियल्लाहु अन्हु) को अता कीं। यह जगह फ़रअ के मक़ाम के एक तरफ़ है। इस तरह इन खानों से आज तक ज़कात के सिवा कुछ नहीं लिया गया))।"
"583","[AI-translation] ((ज़कात कभी किसी माल में नहीं मिली सिवाय इसके कि उसने उसे हलाक कर दिया))।"
"584","[AI-translation] ((ज़कात अदा करो और इसके लिए आलिम शख़्स तलाश करो, क्योंकि वह ज़्यादा मुत्तक़ी और नेक है))।"
"585","[AI-translation] ((जल्द तुम्हारे पास [ज़कात वसूल करने वाले] ऐसे लोग आएँगे जो तुम्हें नापसन्द होंगे, लेकिन जब वे तुम्हारे पास आएँ तो उनका इस्तिक़बाल करो और उन्हें जैसे चाहें ज़कात वसूल करने दो। अगर वे अद्ल और इंसाफ़ से काम करें तो सवाब होगा, और अगर ज़ुल्म से काम करें तो गुनाह उन पर होगा। लेकिन तुम उन्हें राज़ी रखो, क्योंकि तुम्हारी ज़कात का कमाल उन्हें राज़ी रखने में है, और वे तुम्हारे लिए दुआ करें))।"
"586","[AI-translation] ((अनाज से अनाज, बकरियों से बकरी, ऊँटों से ऊँट, और गायों से गाय वसूल करना))।"
"587","[AI-translation] ((हमने कहा [रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से]: ज़कात वसूल करने वाले हम पर ज़ुल्म करते हैं; क्या हम उनकी ज़्यादती के बराबर अपना माल छुपा सकते हैं? आपने फ़रमाया: नहीं))।"
"588","[AI-translation] ((ज़कात के बारे में अल्लाह तआला किसी नबी के हुक्म पर राज़ी न हुआ न किसी और के हुक्म पर, यहाँ तक कि उसने ख़ुद इसके बारे में हुक्म दिया और ज़कात के ख़र्चों को आठ क़िस्मों में बाँटा))।"
"589","[AI-translation] ((सदक़ा-ए-फ़ित्र में गेहूँ का एक साअ दो अफ़राद की तरफ़ से है))।"
"590","[AI-translation] ((इस दिन [यानी ईद] ग़रीबों को दर-दर भटकने से आज़ाद करो))।"
"591","[AI-translation] ((बेहतरीन सदक़ा यह है कि मुसलमान आदमी इल्म सीखे फिर अपने मुसलमान भाई को सिखाए))।"
"592","[AI-translation] ((क्या मैं तुम्हें बेहतरीन सदक़ा न बताऊँ? [वह यह है कि] तेरी बहन तेरे पास लौट आए [तलाक़ या ऐसी वजह से] और उसके लिए तेरे सिवा कोई कमाने वाला न हो))।"
"593","[AI-translation] ((कौन-सा सदक़ा अफ़ज़ल है?)) नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((रमज़ान में दिया गया सदक़ा))।"
"594","[AI-translation] ((सदक़ा देने में जल्दी करो, क्योंकि सदक़ा बलाओं को टालता है))।"
"595","[AI-translation] ((थोड़ा सदक़ा भी बहुत-सी मुसीबतें टालता है))।"
"596","[AI-translation] ((सख़ी अल्लाह की रहमत के क़रीब है, जन्नत के क़रीब है, लोगों के क़रीब है और जहन्नम की आग से दूर है, जबकि बख़ील अल्लाह से दूर है, जन्नत से दूर है, लोगों से दूर है और जहन्नम के क़रीब है। और जाहिल सख़ी अल्लाह तआला को बख़ील आबिद से ज़्यादा महबूब है))।"
"597","[AI-translation] ((जन्नत सख़ी लोगों का घर है))।"
"598","[AI-translation] ((धोखेबाज़, बख़ील और एहसान जताने वाला जन्नत में दाख़िल न होगा))।"
"599","[AI-translation] ((सदक़ा बुरी मौत से बचाता है))।"
"600","[AI-translation] ((ग़रीब अमीरों के तौलिए हैं; वे उनसे अपने गुनाह साफ़ करते हैं))।"
"601","[AI-translation] ((जिसका उज़्र ज़ाहिर हो जाए तो उस पर सदक़ा वाजिब हो जाता है))।"
"602","[AI-translation] ((माँगने वाले को दो चाहे वह घोड़े पर सवार आकर माँगे))।"
"603","[AI-translation] ((अगर माँगना ही हो तो नेक लोगों से माँगो))।"
"604","[AI-translation] ((अल्लाह की ज़ात के वसीले से सिर्फ़ जन्नत माँगनी चाहिए))।"
"605","[AI-translation] ((जब यतीम रोता है तो उसके आँसू रहमान की हथेली पर गिरते हैं))।"
"606","[AI-translation] ((जिसने ऐसी जगह पानी पिलाया जहाँ पानी पर उसका क़ब्ज़ा था, तो हर घूँट पानी के बदले उसके लिए दस नेकियाँ हैं, चाहे वह नेक हो या बदकार))।"
"607","[AI-translation] ((लोगों से नर्मी और अच्छे सुलूक़ से पेश आना भी सदक़ा है))।"
"608","[AI-translation] ((जिसके पास सदक़ा न हो वह यहूदियों पर लानत करे))।"
