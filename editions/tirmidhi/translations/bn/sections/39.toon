hadiths[67]{hadithnumber,text}:
"2573","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2574","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2575","। হাসান বাসরী (রহঃ) হতে বর্ণিত"
"2576","। আবূ সাঈদ (রাঃ) হতে বর্ণিত আছে"
"2577","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2578","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত। তিনি বলেন"
"2579","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2580","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"2581","। আবূ সাঈদ (রাঃ) হতে বর্ণিত আছে"
"2582","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"2583","। আবূ উমামা (রাঃ) হতে বর্ণিত আছে"
"2584","। আবূ সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"2585","। ইবনু আব্বাস (রাযি.) হতে বর্ণিত আছে। রসূলুল্লাহসাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এ আয়াত তিলাওয়াত করলেনঃ “তোমরা আল্লাহ তা'আলাকে যথাযথভাবে ভয় কর এবং মুসলিম না হয়ে কোন অবস্থায় মৃত্যু বরণ করো না”— (সূরা আ-লি ইমরানঃ ১০২)। তারপর রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যাক্কুম’-এর একটি বিন্দুও যদি দুনিয়াতে পতিত হতো তাহলে দুনিয়াবাসীদের জীবন দুৰ্বিসহ হয়ে যেত। আর এটা যাদের খাদ্য হবে তাদের কি অবস্থা হবে। (য’ঈফ; ইবনু মাযাহ-হাঃ নং- ৪৩২৫) আবূ ঈসা বলেনঃ এ হাদীসটি হাসান সহীহ।"
"2586","। আবূদ দারদা (রাঃ) হতে বর্ণিত আছে"
"2587","। আবূ সাঈদ আল-খুদরী (রাযি.) হতে বর্ণিত আছে। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ""সেখানে তারা থাকবে বীভৎস চেহারায়”— (সূরা আল-মু'মিনূনঃ ১০৪) আয়াত প্রসঙ্গে বলেনঃ তাদের মুখমণ্ডল অগ্নিদগ্ধ হবে"
"2588","। আবদুল্লাহ ইবনু আমর ইবনুল আস (রাঃ) হতে বর্ণিত আছে"
"2589","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2590","। আবূ সাঈদ (রাযিঃ) হতে বর্ণিত"
"2591","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"2592","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2593","। আনাস (রাযিঃ) হতে বর্ণিত"
"2594","। আনাস (রাযি.) হতে বর্ণিত আছে"
"2595","। ‘আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2596","। আবূ যার (রাযিঃ) হতে বর্ণিত"
"2597","। জাবির (রাযিঃ) হতে বর্ণিত"
"2598","। আবূ সাঈদ আল-খুদরী (রাযিঃ) হতে বর্ণিত আছে যে"
"2599","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"2600","। ইমরান ইবনু হুসাইন (রাযিঃ) হতে বর্ণিত আছে যে"
"2601","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2602","। ইবনু আব্বাস (রাযিঃ) হতে বর্ণিত"
"2603","। ইমরান ইবনু হুসাইন (রাযিঃ) হতে বর্ণিত"
"2604","। নুমান ইবনু বাশীর (রাযিঃ) হতে বর্ণিত আছে যে"
"2605","। হারিসা ইবনু ওয়াহব আল-খুজাঈ (রাযিঃ) হতে বর্ণিত। তিনি বলেন"
"2643","। মু'আয ইবনু জাবাল (রাযিঃ) হতে বর্ণিত"
"2644","আবূ যার (রাযিঃ) হতে বর্ণিত আছে যে"
"2645","। ইবনু আব্বাস (রাযিঃ) হতে বর্ণিত আছে যে"
"2646","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2647","আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"2648","। সাখবারা (রাঃ) হতে বর্ণিত আছে"
"2649","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2650","। আবূ হারূন আল-আবদী (রাহঃ) হতে বর্ণিত আছে"
"2651","। আবূ সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"2652","। আবদুল্লাহ ইবনু আমর ইবনুল আস (রাযিঃ) হতে বর্ণিত"
"2653","। আবূদ দারদা (রাযিঃ) হতে বর্ণিত"
"2654","। কাব ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2655","। ইবনু উমার (রাযি.) হতে বর্ণিত আছে। রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি আল্লাহ তা'আলার সন্তুষ্টি অর্জনের উদ্দেশ্য ব্যতীত অন্য কোন উদ্দেশ্যে জ্ঞানার্জন করে অথবা এর দ্বারা আল্লাহ তা'আলার সন্তুষ্টি ব্যতীত অন্য কিছু অর্জনের ইচ্ছা করে সে যেন তার বাসস্থান জাহান্নামে নির্দিষ্ট করে নেয়। (য’ঈফ; ইবনু মাযাহ-হাঃ নং- ২৫৮) এ অনুচ্ছেদে জাবির (রাযি.) হতেও হাদীস বর্ণিত আছে। আবূ ঈসা বলেনঃ এ হাদীসটি হাসান গারীব। উপরিউক্ত সূত্র ব্যতীত আইয়ুবের কোন হাদীস আমাদের জানা নেই।"
"2656","। আবান ইবনু উসমান (রহঃ) হতে বর্ণিত"
"2657","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2658","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত আছে যে"
"2659","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2660","। আলী ইবনু আবী তালিব (রাযিঃ) হতে বর্ণিত"
"2661","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2662","। মুগীরাহ ইবনু শুবাহ (রাযিঃ) হতে বর্ণিত আছে যে"
"2663","। আবূ রাফি' (রাযিঃ) হতে বর্ণিত"
"2664","। মিকদাম ইবনু মাদীকারিব (রাযিঃ) হতে বর্ণিত"
"2665","। আবূ সাঈদ আল-খুদরী (রাযিঃ) হতে বর্ণিত"
"2666","। আবূ হুরাইরাহ (রাযি.) হতে বর্ণিত আছে। তিনি বলেন"
"2667","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2668","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত। তিনি বলতেন"
"2669","আবদুল্লাহ ইবনু আমর (রাযিঃ) হতে বর্ণিত"
"2670","। আনাস ইবনু মালিক (রাযিঃ) হতে বর্ণিত"
"2671","। আবূ মাসউদ আল-বদরী (রাযিঃ) হতে বর্ণিত আছে যে"
"2672","। আবূ মূসা আল-আশ'আরী (রাযিঃ) হতে বর্ণিত আছে যে"
"2673","। আবদুল্লাহ ইবনু মাসউদ (রাযিঃ) হতে বর্ণিত"
"2674","। আবূ হুরাইরাহ (রাযিঃ) হতে বর্ণিত"
"2675","। জারীর ইবনু আবদুল্লাহ (রাযিঃ) হতে বর্ণিত"
"2795","। জারহাদ আল-আসলামী (রাযিঃ) হতে বর্ণিত"