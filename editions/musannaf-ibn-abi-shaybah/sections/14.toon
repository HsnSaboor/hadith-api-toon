hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"13027","(۱۳۰۲۷) حدَّثَنَا بَکَّارُ بْنُ عَبْدِ اللہِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَتْبَعُ النَّاسَ فِی الْمَنَازِلِ ، یَنْہَاہُمْ عَنِ الْمُعَصْفَرِ۔","","Musannaf Ibn Abi Shaybah 13027","","","كتاب الحج"
"13028","(۱۳۰۲۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنّہ کَرِہَ أَنْ یُحْرِمَ الرَّجُلُ فِی الْمُعَصْفَرَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 13028","","","كتاب الحج"
"13029","(۱۳۰۲۹) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنْ أَبِیہِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إذَا لَمْ یَکُنْ فِی الثَّوْبِ الْمُعَصْفَرِ طِیبٌ فَلاَ بَأْسَ بِہِ لِلْمُحْرِمِ أَنْ یَلْبَسَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13029","","","كتاب الحج"
"13030","(۱۳۰۳۰) حدَّثَنَا حُمَیْدٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی الزُّبَیْرِ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عُمَرَ فَأَتَاہُ رَجُلٌ عَلَیْہِ ثَوْبَانِ مُعَصْفَرَانِ وَہُوَ مُحْرِمٌ ، فَقَالَ : فِی ہَذَیْنِ عَلَیَّ بَأْسٌ ؟ قَالَ : فِیہِمَا طِیبٌ ؟ قَالَ : لاَ ، قَالَ : فَلاَ بَأْسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 13030","","","كتاب الحج"
"13031","(۱۳۰۳۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنِی أَبِی ، قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ بِالْعَرَجِ عَلَیْہِ مُعَصْفَرٌ وَہُوَ مُحْرِمٌ ، فَقَالَ لَہُ عَمِّی إِسْحَاقُ : مَا ہَذَا ؟ قَالَ : إِنَّہُ لاَ یَنْفُضُ ، أَوْ إِنَّہَا لاَ تَنفضُ۔","","Musannaf Ibn Abi Shaybah 13031","","","كتاب الحج"
"13032","(۱۳۰۳۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13032","","","كتاب الحج"
"13033","(۱۳۰۳۳) حدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ابْنَۃِ الْمُنْذِرِ ؛ أَنَّ أَسْمَائَ کَانَتْ تَلْبَسُ الْمُعَصْفَرَ وَہِیَ مُحْرِمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 13033","","","كتاب الحج"
"13034","(۱۳۰۳۴) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ یَزِیدَ الْفَقِیرِ ، قَالَ : سَافَرْتُ مَعَ أُمِّ سَلَمَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ بَعْضُ مَنْ مَعَہَا تَلْبَسُ الْمُعَصْفَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 13034","","","كتاب الحج"
"13035","(۱۳۰۳۵) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، أَنَّ نِسَائَ عَبْدِ اللہِ بْنِ عُمَرَ وَبَنَاتِہِ کُنَّ یَلْبَسْنَ الْحُلِیَّ وَالْمُعَصْفَرَاتِ ، وَہُنَّ مُحْرِمَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13035","","","كتاب الحج"
"13036","(۱۳۰۳۶) حدَّثَنَا أبو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ ، قَالَتْ : تَلْبَسُ الْمُحْرِمَۃُ مَا شَائَتْ ، إِلاَّ الْمَہْرُودَ بِالْعُصْفُرِ۔","Sahih","Musannaf Ibn Abi Shaybah 13036","","","كتاب الحج"
"13037","(۱۳۰۳۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْجَعْدِ ، قَالَ : حدَّثَتْنِی عَائِشَۃُ ابْنَۃُ سعْدٍ ؛ أَنَّ سَعْدًا کَانَ یَقُولُ لِبَنَاتِہِ : ثِیَابُکُنَّ الَّتِی تُحْرِمْنَ فِیہَا ہی الْمُصَبَّغَاتُ ، إذَا أَحْرَمْتُنَّ فَضَعْنَہَا فِی حُجُورِکُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 13037","","","كتاب الحج"
"13038","(۱۳۰۳۸) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ ، قَالَتْ : تُکْرَہ الْمُشْبَعَۃُ بِالْعُصْفُرِ لِلنِّسَائِ۔","","Musannaf Ibn Abi Shaybah 13038","","","كتاب الحج"
"13039","(۱۳۰۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ الْمَہْرُودَ لِلْمُحْرِمَۃِ۔","","Musannaf Ibn Abi Shaybah 13039","","","كتاب الحج"
"13040","(۱۳۰۴۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ سُفْیَانَ مَوْلَی عَبْدِ اللہِ بْنِ إیَاسٍ ، قَالَ : رَأَیْتُ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحْرِمُونَ فِی الثَّوْبَیْنِ الأَبْیَضَیْنِ والْمُمَشَّقَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 13040","","","كتاب الحج"
"13041","(۱۳۰۴۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ کَثِیرِ بْنِ جُمْہَان ، قَالَ : أَتَی رَجُلٌ ابْنَ عُمَرَ ، فَقَالَ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، أَتَنْہَی النَّاسَ عَنِ الْمَصْبُوغِ وَتَلْبَسُہُ ؟ قَالَ : وَیْحَکَ إنَّمَا ھُوَ بالِمَدَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 13041","","","كتاب الحج"
"13042","(۱۳۰۴۲) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ، عَنْ یَعْقوبِ بْنِ قَیْسٍ، قَالَ: رَأَیْتُ عَلَی طَاوُوسٍ ثَوْبَیْنِ مُمَشَّقَیْنِ بِمَغْرۃٍ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13042","","","كتاب الحج"
"13043","(۱۳۰۴۳) حدَّثَنَا وَکِیعٌ، عَنْ حَرَامِ بْنِ ہِشَامٍ، قَالَ: رَأَیْتُ عَلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ثَوْبَیْنِ مُمَشَّقَیْنِ ، وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13043","","","كتاب الحج"
"13044","(۱۳۰۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : کَانَ نَفَرٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَبْدَؤُونَ بِالْمَدِینَۃِ وَیَقُولُونَ : نُہِلُّ مِنْ حَیْثُ أَہَلَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 13044","","","كتاب الحج"
"13045","(۱۳۰۴۵) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَنْتَ حَجَجْتَ ، وَلَمْ تَحُجَّ قَطُّ ، فَابْدَأْ بِمَکَّۃَ ، ثُمَّ تَمُرُّ عَلَی الْمَدِینَۃِ إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13045","","","كتاب الحج"
"13046","(۱۳۰۴۶) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبی ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا أَرَدْتَ الْحَجَّ وَالْعُمْرَۃَ فَابْدَأْ بِمَکَّۃَ ، وَاجْعَلْ کُلَّ شَیْئٍ لَہَا تَبَعًا۔","","Musannaf Ibn Abi Shaybah 13046","","","كتاب الحج"
"13047","(۱۳۰۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَد ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ یَبْدَأَ بِمَکَّۃَ، وَیَقُولُ : أُحِبُّ أَنْ تَکُونُ نَفَقَتِی وَوَجْہِی إلَی مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13047","","","كتاب الحج"
"13048","(۱۳۰۴۸) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : کُنَّا بِمَکَّۃَ فَأَرَدْنَا أَنْ نَأْتِیَ الْمَدِینَۃَ ، فَذَکَرْنَا ذَلِکَ لِسَعِیدِ بْنِ جُبَیْرٍ ، فَقَالَ : لَطَوَافٌ وَاحِدٌ بِہَذَا الْبَیْتِ أَحَبُّ إلَیَّ مِنْ إتْیَانِ الْمَدِینَۃِ ثَمَانَ مَرَّاتٍ۔","","Musannaf Ibn Abi Shaybah 13048","","","كتاب الحج"
"13049","(۱۳۰۴۹) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْتُ مَعَ عَلْقَمَۃَ ، وَالأَسْوَد ، وَعَمْرِو بْنِ مَیْمُونٍ فَبَدَؤُوا بِالْمَدِینَۃِ قَبْلَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13049","","","كتاب الحج"
"13050","(۱۳۰۵۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ ، قَالَتْ : أَہْدَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّۃً غَنَمًا إلَی الْبَیْتِ ، فَقَلَّدَہَا۔ (بخاری ۱۷۰۱۔ مسلم ۹۵۸)","Sahih","Musannaf Ibn Abi Shaybah 13050","","","كتاب الحج"
"13051","(۱۳۰۵۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، وَالأَعْمَش ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (بخاری ۱۷۰۳۔ ابوداؤد ۱۷۵۲)","Sahih","Musannaf Ibn Abi Shaybah 13051","","","كتاب الحج"
"13052","(۱۳۰۵۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْغَنَمُ لاَ تُقَلَّدُ ، وَلاَ تُشْعَرُ۔","","Musannaf Ibn Abi Shaybah 13052","","","كتاب الحج"
"13053","(۱۳۰۵۳) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَقَدْ رَأَیْتُ الْغَنَمَ یُؤْتَی بِہَا مُقَلَّدَۃً۔","","Musannaf Ibn Abi Shaybah 13053","","","كتاب الحج"
"13054","(۱۳۰۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ بَسَّامٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : رَأَیْتُ الْکِبَاشَ مُقَلَّدَۃً۔","","Musannaf Ibn Abi Shaybah 13054","","","كتاب الحج"
"13055","(۱۳۰۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ عَطَائٍ ؛ أَنَّ عَائِشَۃَ کَانَتْ تُقَلِّدُ الْغَنَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 13055","","","كتاب الحج"
"13056","(۱۳۰۵۶) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ الطَّوِیلِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ اللَّیْثِیِّ ؛ أَنَّ الشَّاۃَ کَانَتْ تُقَلَّدُ۔","","Musannaf Ibn Abi Shaybah 13056","","","كتاب الحج"
"13057","(۱۳۰۵۷) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ، عَنْ صَالِحِ بْنِ فَرْوَۃَ، عَنِ ابْنِ عُمَرَ، قَالَ: الشَّاۃُ لاَ تُقَلَّدُ۔","Da'if","Musannaf Ibn Abi Shaybah 13057","","","كتاب الحج"
"13058","(۱۳۰۵۸) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ أُنَاسًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسُوقُونَ الْغَنَمَ مُقَلَّدَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 13058","","","كتاب الحج"
"13059","(۱۳۰۵۹) حدَّثَنَا أبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ ، قَالَ : إذَا أَصَابَتِ الْمُحْرِمَ جَنَابَۃٌ، فَلْیَصُبَّ الْمَائَ عَلَی رَأْسِہِ صَبًّا ، وَلاَ یَعْرُکْہُ۔","","Musannaf Ibn Abi Shaybah 13059","","","كتاب الحج"
"13060","(۱۳۰۶۰) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حَبِیبٍ ، عَنْ عَطَائٍ فِی الْمُحْرِمِ إذَا اغْتَسَلَ ، قَالَ : یُشَرِّبُ الْمَائَ رَأْسَہُ، وَلاَ یَدْلُکُہُ۔","","Musannaf Ibn Abi Shaybah 13060","","","كتاب الحج"
"13061","(۱۳۰۶۱) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَغْسِلَ الْمُحْرِمُ رَأْسَہُ ، وَیَکْرَہُ أَنْ یَشُدَّ دَلْکَ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 13061","","","كتاب الحج"
"13062","(۱۳۰۶۲) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَصُبُّ الْمَائَ عَلَی رَأْسِہِ وَلاَ یَحُکُّہُ ، یَمْسَحُ یَدَہُ عَلَیْہِ مَسْحًا۔","","Musannaf Ibn Abi Shaybah 13062","","","كتاب الحج"
"13063","(۱۳۰۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَصُبُّ عَلَی رَأْسِہِ الْمَائَ وَہُوَ مُحْرِمٌ ، وَلاَ یَحُکُّہُ۔","","Musannaf Ibn Abi Shaybah 13063","","","كتاب الحج"
"13064","(۱۳۰۶۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَعَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، قَالَ : تَجْمَعُ الْمُحْرِمَۃُ شَعْرَہَا أَثْلاَثًا ، فَتَأْخُذُ ثُلُثَہُ۔","","Musannaf Ibn Abi Shaybah 13064","","","كتاب الحج"
"13065","(۱۳۰۶۵) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : تَجْمَعُ الْمُحْرِمَۃُ شَعْرَہَا ، ثُمَّ تَأْخُذُ مِنْہُ قَدْرَ أُنْمُلَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13065","","","كتاب الحج"
"13066","(۱۳۰۶۶) حدَّثَنَا عَبَّادٌ ، عَنِ الْحَجَّاجِ ، قَالَ : سَأَلْتُ عَطَائً عَنْ تَقْصِیرِ الْمَرْأَۃِ ؟ فَقَالَ : تَأْخُذُ مِنْ جَوَانِبِہَا شَیْئًا ، إنَّمَا ہُوَ تَحْلِیلٌ۔","","Musannaf Ibn Abi Shaybah 13066","","","كتاب الحج"
"13067","(۱۳۰۶۷) حدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنْ حَفْصَۃَ ابْنَۃِ سِیرِینَ؛ فِی تَقْصِیرِ الْمَرْأَۃِ مِنْ شَعْرِہَا، قَالَتْ: إِنَّہُ یُعْجِبُنِی أَنْ لاَ تُکْثِرَ الْمَرْأَۃُ الشَّابَّۃُ ، وَأَمَّا الَّتِی قَدْ وَلَّتْ فَإِنْ شَائَتْ أَخَذَتْ أَکْثَرَ ، فَإِنْ فَعَلَتْ فَلاَ تَزِیدُ عَلَی الرُّبْعِ۔","","Musannaf Ibn Abi Shaybah 13067","","","كتاب الحج"
"13068","(۱۳۰۶۸) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْمُحْرِمَۃِ کَیْفَ تُقَصِّرُ ؟ قَالَ : تَأْخُذُ مِنْ نَاصِیَتِہَا۔","","Musannaf Ibn Abi Shaybah 13068","","","كتاب الحج"
"13069","(۱۳۰۶۹) حدَّثَنَا أَبُو خَالِدٍ عَبْدُ الْعَزِیزِ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ کَمْ تَقُصُّ الْمَرْأَۃُ ؟ قَالَ : لَیْسَ فِیہِ شَیْئٌ مُؤقَّتٌ۔","","Musannaf Ibn Abi Shaybah 13069","","","كتاب الحج"
"13070","(۱۳۰۷۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُقَصِّرُ مِنْ شَعْرِہَا الْقَصِیرِ وَالطَّوِیلِ۔","","Musannaf Ibn Abi Shaybah 13070","","","كتاب الحج"
"13071","(۱۳۰۷۱) حدَّثَنَا وَکِیعٌ ، عَنْ عُقْبَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُ عَنِ الصَّرُورَۃِ کَمْ تُقَصِّرُ مِنْ شَعْرِہَا ؟ قَالَ : مثِلَ ہَذَا ، وَوَضَعَ إبْہَامَہُ عَلَی الْمِفْصَلِ الثَّانِی۔","","Musannaf Ibn Abi Shaybah 13071","","","كتاب الحج"
"13072","(۱۳۰۷۲) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ عُقْبَۃَ بْنِ أَبِی صَالِحٍ، قَالَ: سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْہُ؟ فَقَالَ: النِّسَائُ أَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 13072","","","كتاب الحج"
"13073","(۱۳۰۷۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُقَصِّرُ الْمَرْأَۃُ مِنْ شَعْرِہَا قَدْرَ أُنْمُلَۃٍ۔","","Musannaf Ibn Abi Shaybah 13073","","","كتاب الحج"
"13074","(۱۳۰۷۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : سَأَلْتُہُ : الْحَلْقُ لِلنِّسَائِ أَفْضَلُ ، أَوِ التَّقْصِیرُ ؟ قَالَ : لاَ ، بَلِ التَّقْصِیرُ ، قَصَّرَ أَزْوَاجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 13074","","","كتاب الحج"
"13075","(۱۳۰۷۵) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: تَأْخُذُ الْمَرْأَۃُ مِنْ شَعْرِہَا؛ مِنْ قَصِیرِہِ وَطَوِیلِہِ۔","","Musannaf Ibn Abi Shaybah 13075","","","كتاب الحج"
"13076","(۱۳۰۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : یَتَدَاوَی الْمُحْرِمُ بِأَیِّ دَوَائٍ شَائَ ، إِلاَّ دَوَائً فِیہِ طِیبٌ۔","Sahih","Musannaf Ibn Abi Shaybah 13076","","","كتاب الحج"
"13077","(۱۳۰۷۷) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إذَا تَشَقَّقَتْ یَدَا الْمُحْرِمِ، أَوْ رِجْلاَہُ فَلْیَدْہِنْہُمَا بِالزَّیْتِ ، أَوْ بِالسَّمْنِ۔","","Musannaf Ibn Abi Shaybah 13077","","","كتاب الحج"
"13078","(۱۳۰۷۸) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَتَدَاوَی الْمُحْرِمُ بِمَا یَأْکُلُ۔","Da'if","Musannaf Ibn Abi Shaybah 13078","","","كتاب الحج"
"13079","(۱۳۰۷۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ، وَوَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ خَیْثَمَۃَ قَالَ: رَأَیتُ الأَسْوَدَ یَصْہَرُ رِجْلَہُ بِالشَّحْمِ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13079","","","كتاب الحج"
"13080","(۱۳۰۸۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ أَشْعَثَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَتَدَاوَی الْمُحْرِمُ بِمَا یَأْکُلُ۔","Da'if","Musannaf Ibn Abi Shaybah 13080","","","كتاب الحج"
"13081","(۱۳۰۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ أَبَا ذَرٍّ یَقُولُ : لاَ بَأْسَ أَنْ یَتَدَاوَی الْمُحْرِمُ بِمَا یَأْکُلُ۔","Da'if","Musannaf Ibn Abi Shaybah 13081","","","كتاب الحج"
"13082","(۱۳۰۸۲) حدَّثَنَا عَفَّانَ ، عَنْ شُعْبَۃَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ مُرَّۃَ بْنِ خَالِدٍ ، عَنْ أَبِی ذَرٍّ ، بِنَحْوٍ مِنْ حَدِیثِ مِسْعَرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13082","","","كتاب الحج"
"13083","(۱۳۰۸۳) حدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یُدَاوِیَ الْمُحْرِمُ شِقَاقَہُ بِالسَّمْنِ وَالزَّیْتِ ، وَقَالَ مُجَاہِدٌ : إِنْ تَدَاوَی بِوَاحِدٍ مِنْہُمَا فَعَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 13083","","","كتاب الحج"
"13084","(۱۳۰۸۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیثٍ الْبَجَلِیِّ ، قَالَ : أَصَابَنِی شُقَاقٌ وَأَنَا مُحْرِمٌ ، فَسَأَلْتُ أَبَا جَعْفَرٍ ؟ فَقَالَ : اِدْہِنْہُ بِمَا کُنْتَ تَأْکُلُ۔","","Musannaf Ibn Abi Shaybah 13084","","","كتاب الحج"
"13085","(۱۳۰۸۵) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَدْہُنُ الْمُحْرِمُ شِقَاقَہُ بِمَا یَأْکُلُ۔","","Musannaf Ibn Abi Shaybah 13085","","","كتاب الحج"
"13086","(۱۳۰۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالشَّحْمِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13086","","","كتاب الحج"
"13087","(۱۳۰۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ، عَنِ النَّضْرِ بْنِ قَیْسٍ ، قَالَ: صُرِعَتِ امْرَأَتِی وَہِیَ مُحْرِمَۃٌ ، فَسَأَلْتُ الْقَاسِمَ؟ فَلَمْ یُرَخِّصْ لَہَا ، إِلاَّ فِی الزَّیْتِ الَّذِی یُصَبُّ عَلَی رَأْسِہَا۔","","Musannaf Ibn Abi Shaybah 13087","","","كتاب الحج"
"13088","(۱۳۰۸۸) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : لاَ بَأْسَ بِالزَّیْتِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13088","","","كتاب الحج"
"13089","(۱۳۰۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَامِرٍ ، وَعَطَائٍ قَالُوا : لاَ بَأْسَ أَنْ یَتَدَاوِیَ الْمُحْرِمُ بِالْمُرْدَاسَنْجِ ، مَا لَمْ یَکُنْ فِیہِ طِیبٌ۔","","Musannaf Ibn Abi Shaybah 13089","","","كتاب الحج"
"13090","(۱۳۰۹۰) حدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْتُ إلَی نَافِعٍ أَسْأَلُہُ عَنِ الْمُحْرِمِ یَتَدَاوَی ؟ فَکَتَبَ إلَیَّ : نَعَمْ ، دَوَائٌ لَیْسَ فِیہِ طِیبٌ۔","","Musannaf Ibn Abi Shaybah 13090","","","كتاب الحج"
"13091","(۱۳۰۹۱) حدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا انْکَسَرَ ظُفُرُ الْمُحْرِمِ أَلْقَاہُ ، وَلاَ بَأْسَ أَنْ یَجْعَلَ عَلَیْہِ الْمَرَارَۃَ۔","","Musannaf Ibn Abi Shaybah 13091","","","كتاب الحج"
"13092","(۱۳۰۹۲) حدَّثَنَا عَبَّادٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَدَاوَی الْمُحْرِمُ بِمَا أَحَبَّ ، مَا لَمْ یَکُنْ فِی شَیْئٍ مِنْ أَدْوِیَتہِِ طِیبٌ۔","","Musannaf Ibn Abi Shaybah 13092","","","كتاب الحج"
"13093","(۱۳۰۹۳) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ (ح) وَعَنْ ہِشَامِ بْنِ حَسَّانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یُدَاوِیَ الْمُحْرِمُ جِرَاحَاتِہِ بِالسَّمْنِ وَالزَّیْتِ۔","","Musannaf Ibn Abi Shaybah 13093","","","كتاب الحج"
"13094","(۱۳۰۹۴) حدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَرِہَ أَنْ یُدَاوِیَ الْمُحْرِمُ یَدَہُ بِالدَّسَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 13094","","","كتاب الحج"
"13095","(۱۳۰۹۵) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَتَدَاوَی الْمُحْرِمُ إِلاَّ بِدَوَائٍ لَیْسَ فِیہِ طِیب۔","","Musannaf Ibn Abi Shaybah 13095","","","كتاب الحج"
"13096","(۱۳۰۹۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، أَخْبَرَہُ عَمْرُو بْنُ أَوْسٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَہُ أَنْ یُرْدِفَ عَائِشَۃَ ، فَیُعْمِرَہَا مِنَ التَّنْعِیمِ۔ (بخاری ۱۷۸۴۔ مسلم ۱۳۵)","Sahih","Musannaf Ibn Abi Shaybah 13096","","","كتاب الحج"
"13097","(۱۳۰۹۷) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یُرِیدُ الْعُمْرَۃَ مِنْ مَکَّۃَ ، مِنْ أَیْنَ یُہِلُّ ؟ قَالَ : مِنَ التَّنْعِیمِ ، وَمِنْہَا أَہَلَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 13097","","","كتاب الحج"
"13098","(۱۳۰۹۸) حدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عَائِشَۃَ کَانَتْ تَکُونُ بِمَکَّۃَ ، فَإِذَا أَرَادَتْ أَنْ تَعْتَمِرَ خَرَجَتْ إلَی الْجُحْفَۃِ ، فَأَحْرَمَتْ مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 13098","","","كتاب الحج"
"13099","(۱۳۰۹۹) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ ، وَابْنَ الزُّبَیْرِ خَرَجَا مِنْ مَکَّۃَ ، حَتَّی أَتَیَا ذَا الْحُلَیْفَۃِ ، فَأَحْرَمَا وَلَمْ یَدْخُلاَ الْمَدِینَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 13099","","","كتاب الحج"
"13100","(۱۳۱۰۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُلَیْمَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، عَنِ ابْنِ أُذَیْنَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً أَتَی عُمَرَ فَسَأَلَہُ عَنِ الْعُمْرَۃِ ؟ فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، مَا اَتَیْتُکَ حَتَّی رَکِبْتُ الإِبِلَ ، وَالْخَیْلَ ، وَالسُّفُنَ فَمِنْ أَیْنَ أُہِلُّ ؟ قَالَ : ائْتِ عَلِیًّا فَاسْأَلْہُ ، فَأَتَی عَلِیًّا فَسَأَلَہُ ؟ فَقَالَ : مِنْ حَیْثُ أَبْدَأْتَ ، فَرَجَعَ إلَیْہِ فَأَخْبَرَہُ ، فَقَالَ : مَا أَجِدُ لَکَ إِلاَّ مَا قَالَ عَلِیٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 13100","","","كتاب الحج"
"13101","(۱۳۱۰۱) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ یحیی بْنِ الْجَزَّارِ ، وَعَنِ ابْنِ أذینۃ ، قَالَ : سُئِلَ عُمَرُ عَنِ الْعُمْرَۃِ وَہُوَ بِمَکَّۃَ ، مِنْ أَیْنَ أَعْتَمِرُ ؟ فَقَالَ : ائْتِ عَلِیَّ بْنَ أَبِی طَالِبٍ فَاسْأَلْہُ ، فَقَالَ : فَأَتَیْتُہُ ، فَقَالَ : مِنْ حِینَ أَبْدَأْتَ، یَعْنِی مِنْ مِیقَاتِ أَرْضِہِ، قَالَ: فَأَتَی عُمَرَ فَأَخْبَرَہُ ، فَقَالَ: مَا أَجِدُ لَکَ إِلاَّ مَا قَالَ عَلِیُّ بْنُ أَبِی طَالِبٍ۔","Hasan","Musannaf Ibn Abi Shaybah 13101","","","كتاب الحج"
"13102","(۱۳۱۰۲) حدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ أَبِی الْحَارِثِ التَّیمِیِّ، قَالَ: تَمَتَّعْتُ فَلَقِیتُ ابْنَ عَبَّاسٍ، فَقُلْتُ: إنِّی تَمَتَّعْتُ وَأَنَا أُرِیدُ أَنْ أُہِلَّ بِالْحَجِّ، فَمِنْ أَیْنَ أُہِلُّ بِالْحَجِّ؟ قَالَ: مِنْ حَیْثُ شِئْتَ، قُلْتُ: مِنَ الْمَسْجِدِ؟ قَالَ: مِنَ الْمَسْجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 13102","","","كتاب الحج"
"13103","(۱۳۱۰۳) حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِی مَعْنٍ ، قَالَ : قُلْتُ لِجَابِرِ بْنِ زَیْدٍ وَأَنَا بِمَکَّۃَ : مِنْ أَیْنَ أُحْرِمُ ؟ فَقَالَ : إِنْ شِئْتَ مِنْ خَلْفِ الْمَقَامِ ، وَإِنْ شِئْتَ فَمِنْ رَحْلِکَ۔","","Musannaf Ibn Abi Shaybah 13103","","","كتاب الحج"
"13104","(۱۳۱۰۴) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ ہِشَامٍ ؛ أَنَّ الْقَاسِمَ ، وَسَالِمًا کَانَا بِمَکَّۃَ ، فَأَرَادَا أَنْ یَعْتَمِرَا ، فَخَرَجَا حَتَّی أَہَلاَّ مِنْ ذِی الْحُلَیْفَۃِ۔","","Musannaf Ibn Abi Shaybah 13104","","","كتاب الحج"
"13105","(۱۳۱۰۵) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہَمَّامٍ ، قَالَ : سُئِلَ الْحَسَنُ عَنْ رَجُلٍ قَدِمَ مَکَّۃَ مُعْتَمِرًا ، ثُمَّ أَرَادَ أَنْ یَحُجَّ عَنْ أُمِّہِ ؟ فَقَالَ : یَخْرُجُ إلَی وَقْتِہِ ، وَقَالَ عَطَائٌ : یُحْرِمُ مِنْ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13105","","","كتاب الحج"
"13106","(۱۳۱۰۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، قَالَ : کُنْتُ قَاطِنًا بِمَکَّۃَ ، فَسَأَلْتُ مُجَاہِدًا : مِنْ أَیْنَ أُحْرِمُ ؟ قَالَ : مِنْ حَیْثُ شِئْتَ ، قُلْتُ : مِنْ ذَاتِ عِرْقٍ ، فَإِنَّہَا حَدُّنَا ؟ قَالَ : إذَا کُنْتَ بِمَکَّۃَ فَأَحْرِمْ مِنْ حَیْثُ شِئْتَ ، وَإِذَا جِئْتَ مِنْ بَلَدٍ آخَرَ فَلاَ تُجَاوِزِ الْحَدَّ حَتَّی تُحْرِمَ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَدْ أَحْرَمَ مِنَ الْجِعْرَانَۃِ ، وَہُوَ مُقْبِلٌ مِنَ الطَّائِفِ۔","","Musannaf Ibn Abi Shaybah 13106","","","كتاب الحج"
"13107","(۱۳۱۰۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُسْلِمٍ الْقَرِّیِّ ، قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : إنَّ أُمِّی حَجَّتْ وَلَمْ تَعْتَمِرْ ، فَمِنْ أَیْنَ أَعْتَمِرُ عَنْہَا ؟ قَالَ : مِنْ وَجْہِکَ الَّذِی جِئْتَ منہ۔","","Musannaf Ibn Abi Shaybah 13107","","","كتاب الحج"
"13108","(۱۳۱۰۸) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ سَمِعْتُہُ یَقُولُ : {وَأَتِمُّوا الْحَجَّ وَالْعُمْرَۃَ لِلَّہِ} فَسَأَلَہُ رَجُلٌ : مَا تَمَامُ الْعُمْرَۃِ ؟ فَقَالَ : أَنْ تَعْتَمِرَ مِنْ حَیْثُ أَبْدَأْتَ۔","","Musannaf Ibn Abi Shaybah 13108","","","كتاب الحج"
"13109","(۱۳۱۰۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا سُئِلَتْ : عَلَی النِّسَائِ رَمَلٌ ؟ فَقَالَتْ : أَلَیْسَ لَکُنَّ بِنَا أُسْوَۃٌ ؟ لَیْسَ عَلَیْکُنَّ رَمَلٌ بِالْبَیْتِ ، وَلاَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 13109","","","كتاب الحج"
"13110","(۱۳۱۱۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ عَلَی النِّسَائِ رَمَلٌ بِالْبَیْتِ ، وَلاَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13110","","","كتاب الحج"
"13111","(۱۳۱۱۱) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ عَلَی النِّسَائِ رَمَلٌ۔","Da'if","Musannaf Ibn Abi Shaybah 13111","","","كتاب الحج"
"13112","(۱۳۱۱۲) حدَّثَنَا عَبْدَۃُ، عَنْ عَبْدِ الْمَلِکِ، عَنْ عَطَائٍ، قَالَ: لَیْسَ عَلَی النِّسَائِ رَمَلٌ بِالْبَیْتِ، وَلاَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 13112","","","كتاب الحج"
"13113","(۱۳۱۱۳) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَعَطَائٍ، قَالَ: لَیْسَ عَلَی النِّسَائِ رَمَلٌ، وَلاَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 13113","","","كتاب الحج"
"13114","(۱۳۱۱۴) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: الْمَرْأَۃُ تَقُصُّ، لَیْسَ عَلَی النِّسَائِ حَلْقٌ، وَلاَ رَمَلٌ۔","","Musannaf Ibn Abi Shaybah 13114","","","كتاب الحج"
"13115","(۱۳۱۱۵) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : أَخْبَرَنِی جَابِرُ بْنُ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَکَحَ وَہُوَ مُحْرِمٌ۔ (بخاری ۵۱۱۴۔ مسلم ۴۷)","Sahih","Musannaf Ibn Abi Shaybah 13115","","","كتاب الحج"
"13116","(۱۳۱۱۶) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : تَزَوَّجَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَیْمُونَۃَ وَہُوَ مُحْرِمٌ۔ (بخاری ۱۸۳۷۔ نسائی ۳۲۰۱)","","Musannaf Ibn Abi Shaybah 13116","","","كتاب الحج"
"13117","(۱۳۱۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِتَزْوِیجِ الْمُحْرِمِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 13117","","","كتاب الحج"
"13118","(۱۳۱۱۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 13118","","","كتاب الحج"
"13119","(۱۳۱۱۹) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 13119","","","كتاب الحج"
"13120","(۱۳۱۲۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الْمُحْرِمِ یَتَزَوَّجُ ؟ قَالاَ : لاَ بَأْسَ بِہ۔","","Musannaf Ibn Abi Shaybah 13120","","","كتاب الحج"
"13121","(۱۳۱۲۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکٍ ، عَنْ عَطَائٍ ، قَالَ : یَتَزَوَّجُ ، لاَ أَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 13121","","","كتاب الحج"
"13122","(۱۳۱۲۲) حدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، وَعَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، وَیَعْلَی بْنِ حَکِیمٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِہ۔","Sahih","Musannaf Ibn Abi Shaybah 13122","","","كتاب الحج"
"13123","(۱۳۱۲۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13123","","","كتاب الحج"
"13124","(۱۳۱۲۴) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُغِیرَۃَ ، عَنْ شَبَّاکٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَزَوَّجَ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13124","","","كتاب الحج"
"13125","(۱۳۱۲۵) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ نُبَیہِ بْنِ وَہْبٍ ؛ أَنَّ عُمَرَ بْنَ عُبَیْدِ اللہِ بْنِ مَعْمَرٍ أَرَادَ أَنْ یَنْکِحَ وَہُوَ مُحْرِمٌ ، فَأَرْسَلَ إلَی أَبَانَ بْنِ عُثْمَانَ یَسْأَلُہُ ؟ فَقَالَ أَبَانُ : إِنَّ عُثْمَانَ حَدَّثَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمُحْرِمُ لاَ یَنْکِحُ ، وَلاَ یَخْطُبُ۔ (مسلم ۱۰۳۱۔ ابوداؤد ۱۸۳۷)","Sahih","Musannaf Ibn Abi Shaybah 13125","","","كتاب الحج"
"13126","(۱۳۱۲۶) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ مَطَرٍ ، عَنْ رَبِیعَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أَبِی رَافِعٍ ، قَالَ : تَزَوَّجَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَیْمُونَۃَ وَہُوَ حلال ، وَکُنْتُ الرَّسُولَ فِیمَا بَیْنَہُمَا۔n(ترمذی ۸۴۱۔ ابن حبان ۴۱۳۰)","Hasan","Musannaf Ibn Abi Shaybah 13126","","","كتاب الحج"
"13127","(۱۳۱۲۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ الزُّہْرِیِّ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَکَحَ وَہُو حَلاَلٌ۔","","Musannaf Ibn Abi Shaybah 13127","","","كتاب الحج"
"13128","(۱۳۱۲۸) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حدَّثَنَا أَبُو فَزَارَۃَ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، قَالَ: حَدَّثَتْنَا مَیْمُونَۃُ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَزَوَّجَہَا وَہُوَ حَلاَلٌ۔ (مسلم ۴۸۱۔ ترمذی ۸۴۵)","Sahih","Musannaf Ibn Abi Shaybah 13128","","","كتاب الحج"
"13129","(۱۳۱۲۹) حدَّثَنَا حَاتِمٍ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، أَنَّ عُمَرَ ، وَعَلِیًّا قَالاَ : الْمُحْرِمُ لاَ یَنْکِحُ ، وَلاَ یُنْکِحُ ، فَإِنْ نَکَحَ فَنِکَاحُہُ بَاطِلٌ۔","","Musannaf Ibn Abi Shaybah 13129","","","كتاب الحج"
"13130","(۱۳۱۳۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ نَافِعٍ ، أَنَّ عُمَرَ ، وابْنَ عُمَرَ ، قَالَ أَحَدُہُمَا : لاَ یَنْکِحُ ، وَلاَ یَخْطُبُ ، وَقَالَ الآخَرُ : لاَ یَنْکِحُ۔","Sahih","Musannaf Ibn Abi Shaybah 13130","","","كتاب الحج"
"13131","(۱۳۱۳۱) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یُزَوِّجُ الْمُحْرِمُ ، وَلاَ یَتَزَوَّجُ۔","Sahih","Musannaf Ibn Abi Shaybah 13131","","","كتاب الحج"
"13132","(۱۳۱۳۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سعد بن إبْرَاہِیمَ ، قَالَ : کَتَبَ یَزِیدُ بْنُ عَبْدِ الْمَلِکِ إلَی أَہْلِ الْمَدِینَۃِ یَسْأَلُہُمْ عَنِ الْمُحْرِمِ یَتَزَوَّجُ ؟ قَالَ : یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 13132","","","كتاب الحج"
"13133","(۱۳۱۳۳) حدَّثَنَا وَکِیعٌ ، عَنْ قُدَامَۃَ بْنِ مُوسَی ، قَالَ : زَوَّجَنِی أَہْلِی وَأَنَا مُحْرِمٌ ، فَأَرْسَلْنَا إلَی سَعِیدِ بْنِ الْمُسَیَّبِ، فَقَالَ : الْمُحْرِمُ لاَ یَنْکِحُ ، وَلاَ یُنْکِحُ۔","","Musannaf Ibn Abi Shaybah 13133","","","كتاب الحج"
"13134","(۱۳۱۳۴) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : إنَّ عِکْرِمَۃَ یَقُولُ : تَزَوَّجَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ مُحْرِمٌ ، فَقَالَ : کَذَبَ۔","","Musannaf Ibn Abi Shaybah 13134","","","كتاب الحج"
"13135","(۱۳۱۳۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْمُحْرِمُ لاَ یَتَزَوَّجُ ، وَلاَ یُزَوَّج۔","","Musannaf Ibn Abi Shaybah 13135","","","كتاب الحج"
"13136","(۱۳۱۳۶) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، قَالَ : لاَ یَصُومُ الْمُتَمَتِّعُ إِلاَّ فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 13136","","","كتاب الحج"
"13137","(۱۳۱۳۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یَصُومُ الْمُتَمَتِّعُ إِنْ شَائَ یَوْمًا مِنْ شَوَّالٍ ، وَإِنْ شَائَ یَوْمًا مِنْ ذِی الْقَعْدَۃِ ، قَالَ : وَقَالَ طَاوُوس ، وَعَطَائٌ : لاَ یَصُومُ الْمُتَمَتِّعُ إِلاَّ فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 13137","","","كتاب الحج"
"13138","(۱۳۱۳۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یَصُومُ الْمُتَمَتِّعُ إِلاَّ وَہُوَ مُحْرِمٌ ، لاَ یَقْضِی عَنْہُ إِلاَّ ذَلِکَ ، قُلْتُ : یَصُومَہا مِنْ شَوَّالٍ ؟ قَالَ : لاَ ، إِلاَّ مُحْرِمًا۔","","Musannaf Ibn Abi Shaybah 13138","","","كتاب الحج"
"13139","(۱۳۱۳۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوس ، وَعَطَائٍ قَالاَ : لاَ یَصُومُ الثَّلاَثَۃَ إِلاَّ فِی الْعَشْرِ ، وَقَالَ مُجَاہِدٌ : لاَ بَأْسَ أَنْ یَصُومَہَا فِی أَشْہُرِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13139","","","كتاب الحج"
"13140","(۱۳۱۴۰) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : إِنْ خَشِیَ أَنْ لاَ یُدْرِکَ الصَّوْمَ بِمَکَّۃَ ، صَامَ فِی الطَّرِیقِ یَوْمًا ، أَوِ اثْنَیْنِ۔","","Musannaf Ibn Abi Shaybah 13140","","","كتاب الحج"
"13141","(۱۳۱۴۱) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ فِی الَّذِی یَکُونُ فِی الطَّرِیقِ : إِنْ خَشِیَ أَنْ لاَ یَقْدَمَ إِلاَّ یَوْمَ عَرَفَۃَ ، صَامَ فِی الطَّرِیقِ ثَلاَثَۃَ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 13141","","","كتاب الحج"
"13142","(۱۳۱۴۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا لَمْ یَصُمِ الْمُتَمَتِّعُ فَعَلَیْہِ الْہَدْیُ۔","Sahih","Musannaf Ibn Abi Shaybah 13142","","","كتاب الحج"
"13143","(۱۳۱۴۳) حدَّثَنَا حَفْصٌ، وَابْنُ عُلَیَّۃَ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوسٍ، وَمُجَاہِدٍ قَالُوا: إذَا فَاتَہُ الصَّوْمُ فَعَلَیْہِ الْہَدْیُ۔","","Musannaf Ibn Abi Shaybah 13143","","","كتاب الحج"
"13144","(۱۳۱۴۴) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ رَجُلاً أَتَی عُمَرَ مُتَمَتِّعًا قَدْ فَاتَہُ الصَّوْمُ فِی الْعَشْرِ ، فَقَالَ لَہُ : اذْبَحْ شَاۃً ، قَالَ : لَیْسَ عِنْدِی ، قَالَ : سَلْ قَوْمَکَ ، قَالَ : لَیْسَ ہَاہُنَا أَحَدٌ مِنْ قَوْمِی ، قَالَ : أَعْطِہِ یَا مُعَیْقِیبَ ثَمَنَ شَاۃٍ۔","","Musannaf Ibn Abi Shaybah 13144","","","كتاب الحج"
"13145","(۱۳۱۴۵) حدَّثَنَا حَفْصٌ ، وَأَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بن شعیب ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13145","","","كتاب الحج"
"13146","(۱۳۱۴۶) حدَّثَنَا حَفْصٌ ، وَأَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بُدَّ مِنْ دَمٍ ، وَلَوْ یَبِیعُ ثَوْبَہُ۔","","Musannaf Ibn Abi Shaybah 13146","","","كتاب الحج"
"13147","(۱۳۱۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لاَ بُدَّ مِنْ دَمٍ ، وَلَوْ یُتَصَدَّقُ۔","","Musannaf Ibn Abi Shaybah 13147","","","كتاب الحج"
"13148","(۱۳۱۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بُدَّ مِنْ دَمٍ ، وَلَوْ یَبِیعُ ثَوْبَہُ۔","","Musannaf Ibn Abi Shaybah 13148","","","كتاب الحج"
"13149","(۱۳۱۴۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : إِنْ فَاتَہُ الصَّوْمُ فِی الْعَشْرِ تَسَحَّرَ لَیْلَۃَ الْحَصْبَۃِ ، فَصَامَ ثَلاَثَۃَ أَیَّامٍ ، وَسَبْعَۃً إذَا رَجَعَ۔","","Musannaf Ibn Abi Shaybah 13149","","","كتاب الحج"
"13150","(۱۳۱۵۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ فَاتَہُ ثَلاَثَۃُ أَیَّامٍ فِی الْحَجِّ ، فَلْیَصُمْ أَیَّامَ التَّشْرِیقِ ، فَإِنَّہُنَّ مِنَ الْحَجِّ۔","Sahih","Musannaf Ibn Abi Shaybah 13150","","","كتاب الحج"
"13151","(۱۳۱۵۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، أَوْ عَمْرَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَتْ تُرَخِّصُ لِلْمُتَمَتِّعِ أَنْ یَصُومَ أَیَّامَ التَّشْرِیقِ ، إذَا لَمْ یَصُمِ الْعَشْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 13151","","","كتاب الحج"
"13152","(۱۳۱۵۲) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْمُتَمَتِّعُ إذَا فَاتَہُ الصَّوْمُ أَیَّامَ الْعَشْرِ ، أَطْعَمَ عَنِ الثَّلاَثَۃِ وَصَامَ السَّبْعَۃَ إذَا رَجَعَ۔","","Musannaf Ibn Abi Shaybah 13152","","","كتاب الحج"
"13153","(۱۳۱۵۳) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، قَالَ : سَمِعْتُہُ یُحَدِّثُ عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ (ح) وَعَنْ سَالِمٍ، عَنِ ابْنِ عُمَرَ قَالاَ: لَمْ یُرَخَّصْ فِی أَیَّامِ التَّشْرِیقِ أَنْ یُصَمْنَ، إِلاَّ لِمَنْ لَمْ یَجِدِ الْہَدْیَ۔","Sahih","Musannaf Ibn Abi Shaybah 13153","","","كتاب الحج"
"13154","(۱۳۱۵۴) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : {وَسَبْعَۃٍ إذَا رَجَعْتُمْ} قَالَ : إِنْ شَائَ صَامَہَا فِی الطَّرِیقِ ، وَإِنْ شَائَ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13154","","","كتاب الحج"
"13155","(۱۳۱۵۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی صِیَامِ السَّبْعَۃِ الأَیَّامِ ، قَالَ : إِنْ شَائَ صَامَ فِی الطَّرِیقِ ، وَإِنْ شَائَ إذَا رَجَعَ إلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 13155","","","كتاب الحج"
"13156","(۱۳۱۵۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صُمِ السَّبْعَۃَ إِنْ شِئْتَ فِی الطَّرِیقِ ، وَإِنْ شِئْتَ إذَا رَجَعْتَ إلَی أَہْلِکَ ، وَلاَ تُفَرِّقْ بَیْنَہُنَّ۔","","Musannaf Ibn Abi Shaybah 13156","","","كتاب الحج"
"13157","(۱۳۱۵۷) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِنْ شَائَ صَامَ فِی الطَّرِیقِ ، وَإِنْ شَائَ إذَا رَجع۔","","Musannaf Ibn Abi Shaybah 13157","","","كتاب الحج"
"13158","(۱۳۱۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ مَرْثَدٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوس ؛ {وَسَبْعَۃٍ إذَا رَجَعْتُمْ} قَالَ : إِنْ شَائَ فَرَّقَ۔","","Musannaf Ibn Abi Shaybah 13158","","","كتاب الحج"
"13159","(۱۳۱۵۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَنِ اعْتَمَرَ فِی شَوَّالٍ ، أَوْ فِی ذِی الْقَعْدَۃِ ، ثُمَّ أَقَامَ حَتَّی یَحُجَّ ، فَہُوَ مُتَمَتِّعٌ ، عَلَیْہِ مَا اسْتَیْسَرَ مِنَ الْہَدْیِ ، فَمَنْ لَمْ یَجِدْ فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ فِی الْحَجِّ ، وَسَبْعَۃٍ إذَا رَجَعَ إلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 13159","","","كتاب الحج"
"13160","(۱۳۱۶۰) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یُرَی عَلَی الْمُتَمَتِّعِ بَدَنَۃً ؛ بَعِیرًا ، أَوْ بَقَرَۃً ، فَإِنْ لَمْ یَجِدْ صَامَ ثَلاَثَۃَ أَیَّامٍ ، وَسَبْعَۃً إذَا رَجَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 13160","","","كتاب الحج"
"13161","(۱۳۱۶۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَنِ اعْتَمَرَ فِی أَشْہُرِ الْحَجِّ ، ثُمَّ رَجَعَ فَلَیْسَ بِمُتَمَتِّعٍ ، ذَاکَ مَنْ أَقَامَ وَلَمْ یَرْجِعْ۔","","Musannaf Ibn Abi Shaybah 13161","","","كتاب الحج"
"13162","(۱۳۱۶۲) حدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13162","","","كتاب الحج"
"13163","(۱۳۱۶۳) حدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : إذَا اعْتَمَرَ فِی أَشْہُرِ الْحَجِّ ثُمَّ أَقَامَ فَہُوَ مُتَمَتِّعٌ ، فَإِنْ رَجَعَ فَلَیْسَ بِمُتَمَتِّعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13163","","","كتاب الحج"
"13164","(۱۳۱۶۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُسٍ ، وَمُجَاہِدٍ ، قَالُوا : إِنْ خَرَجَ فِی أَشْہُرِ الْحَجِّ ثُمَّ أَقَامَ فَہُوَ مُتَمَتِّعٌ۔","","Musannaf Ibn Abi Shaybah 13164","","","كتاب الحج"
"13165","(۱۳۱۶۵) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : مَنِ اعْتَمَرَ فِی أَشْہُرِ الْحَجِّ ، ثُمَّ رَجَعَ إلَی بَلَدِہِ ، ثُمَّ حَجَّ مِنْ عَامِہِ فَلَیْسَ بِمُتَمَتِّعٍ ، إنَّمَا الْمُتَمَتِّعُ مَنْ أَقَامَ وَلَمْ یَرْجِعْ۔","","Musannaf Ibn Abi Shaybah 13165","","","كتاب الحج"
"13166","(۱۳۱۶۶) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ ، قَالَ : قُلْتُ : الَّذِینَ یَعْتَمِرُونَ فِی رَجَبٍ ثُمَّ یُقِیمُونَ حَتَّی یَحُجُّوا ، أَمُتَمَتِّعُونَ ہُمْ ؟ قَالَ : لاَ ، إنَّمَا الْمُتَمَتِّعُ مَنْ أَہَلَّ بِالْعُمْرَۃِ فِی أَشْہُرِ الْحَجِّ ، ثُمَّ أَقَامَ حَتَّی یَحُجَّ، فَذَلِکَ مُتَمَتِّعٌ وَعَلَیْہِ الْہَدْیُ ، أَوِ الصَّوْمُ إِنْ لَمْ یَجِدْ۔","","Musannaf Ibn Abi Shaybah 13166","","","كتاب الحج"
"13167","(۱۳۱۶۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا اعْتَمَرَ فِی أَشْہُرِ الْحَجِّ ثُمَّ أَقَامَ فَہُوَ مُتَمَتِّعٌ۔","","Musannaf Ibn Abi Shaybah 13167","","","كتاب الحج"
"13168","(۱۳۱۶۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13168","","","كتاب الحج"
"13169","(۱۳۱۶۹) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13169","","","كتاب الحج"
"13170","(۱۳۱۷۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إِنْ أَقَامَ فَعَلَیْہِ ہَدْیٌ۔","","Musannaf Ibn Abi Shaybah 13170","","","كتاب الحج"
"13171","(۱۳۱۷۱) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا اعْتَمَرُوا فِی أَشْہُرِ الْحَجِّ ، ثُمَّ لَمْ یَحُجُّوا مِنْ عَامِہِمْ ذَلِکَ لَمْ یُہْدُوا۔","Sahih","Musannaf Ibn Abi Shaybah 13171","","","كتاب الحج"
"13172","(۱۳۱۷۲) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ سَیْفِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ یَزِیدَ الْفَقِیرِ ؛ أَنَّ قَوْمًا مِنْ أَہْلِ الْکُوفَۃِ تَمَتَّعُوا ثُمَّ خَرَجُوا إلَی الْمَدِینَۃِ ، فَأَقْبَلُوا مِنْہَا بِحَجٍّ ، فَسَأَلُوا ابْنَ عَبَّاسٍ ؟ فَقَالَ : أَنْتُمْ مُتَمَتِّعُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 13172","","","كتاب الحج"
"13173","(۱۳۱۷۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ الْہَدْیُ أَقَامَ ، أَوْ لَمْ یَقُمْ۔","","Musannaf Ibn Abi Shaybah 13173","","","كتاب الحج"
"13174","(۱۳۱۷۴) حدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، قَالَ: مَنِ اعْتَمَرَ فِی أَشْہُرِ الْحَجِّ، ثُمَّ حَجَّ فِی عَامِہِ فَہُوَ مُتَمَتِّعٌ۔","","Musannaf Ibn Abi Shaybah 13174","","","كتاب الحج"
"13175","(۱۳۱۷۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ أُمِّ الْمُؤْمِنِینَ (ح) وَعَنِ الْقَاسِمِ ، عَنْ أُمِّ الْمُؤْمِنِینَ ، قَالَتْ : یَا رَسُولَ اللہِ ، یَصْدُرُ النَّاسُ بِنُسُکَیْنِ وَأَصْدُرُ بِنُسُکٍ وَاحِدٍ ؟ قَالَ : انْتَظِرِی ، فَإِذَا طَہُرْتِ ، فَاخْرُجِی إلَی التَّنْعِیمِ فَأَہِلِّی مِنْہُ ، ثُمَّ الْقَیْنَا عِنْدَ کَذَا وَکَذَا ، وَلَکِنَّہَا عَلَی قَدْرِ نَصَبِکِ ، أَوْ قَالَ : نَفَقَتِکِ ، أَوْ کَمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۸۶۷۔ احمد ۶/۴۳)","Sahih","Musannaf Ibn Abi Shaybah 13175","","","كتاب الحج"
"13176","(۱۳۱۷۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الْوَلِیدِ بْنِ ہِشَامٍ الْمُعَیْطِیِّ ، قَالَ : سَأَلْتُ أُمَّ الدَّرْدَائِ عَنِ الْعُمْرَۃِ بَعْدَ الْحَجِّ ؟ فَأَمَرَتْنِی بِہَا۔","","Musannaf Ibn Abi Shaybah 13176","","","كتاب الحج"
"13177","(۱۳۱۷۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ سُئِلَ عَنِ الْعُمْرَۃِ بَعْدَ أَیَّامِ التَّشْرِیقِ ؟ فَلَمْ یَرَ بِہَا بَأْسًا ، وَقَالَ : لَیْسَ فِیہَا ہَدْیٌ۔","","Musannaf Ibn Abi Shaybah 13177","","","كتاب الحج"
"13178","(۱۳۱۷۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سُئِلَ عُمَرُ عَنِ الْعُمْرَۃِ بَعْدَ الْحَجِّ ؟ فَقَالَ : ہِیَ خَیْرٌ مِنْ لاَ شَیْئَ ۔ وَسُئِلَتْ عَائِشَۃُ ؟ فَقَالَتْ : عَلَی قَدْرِ النَّفَقَۃِ وَالْمَشَقَّۃِ ۔ وَسُئِلَ عَلِیٌّ ؟ فَقَالَ : ہِیَ خَیْرٌ مِنْ مِثْقَالِ ذَرَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13178","","","كتاب الحج"
"13179","(۱۳۱۷۹) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَتْ عَائِشَۃُ تَعْتَمِرُ فِی آخِرِ ذِی الْحِجَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13179","","","كتاب الحج"
"13180","(۱۳۱۸۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْعُمْرَۃِ بَعْدَ الْحَجِّ بِسِتَّۃِ أَیَّامٍ ؟ فَقَالَ : اعْتَمِرْ إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13180","","","كتاب الحج"
"13181","(۱۳۱۸۱) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنْ أَبِیہِ ، عَنْ جَعْفَرِ بْنِ نَجِیحٍ ، قَالَ : سَأَلَ رَجُلٌ طَاوُوسًا ، فَقَالَ : إِنِّی تَعَجَّلْتُ فِی یَوْمَیْنِ ، أَفَأَعْتَمِرُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 13181","","","كتاب الحج"
"13182","(۱۳۱۸۲) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی یَعْفُورٍ ، قَالَ : سَأَلْنَا ابْنَ عُمَرَ عَنِ الْعُمْرَۃِ بَعْدَ الْحَجِّ ؟ فَقَالَ : إنَّ أنَاسًا یَفْعَلُونَ ذَلِکَ ، وَلأَنْ أَعْتَمِرَ فِی غَیْرِ ذِی الْحِجَّۃِ ، أَحَبُّ إلَیَّ مِنْ أَنْ أَعْتَمِرَ فِی ذِی الْحِجَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13182","","","كتاب الحج"
"13183","(۱۳۱۸۳) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ خُصَیْفٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ، قَالُوا : لاَ عُمْرَۃَ إِلاَّ عُمْرَۃٌ ابْتَدَأْتَہَا مِنْ أَہْلِکَ ، وَلاَ عُمْرَۃَ إلاَّ بَعْدَ الصَّدَرِ۔nوَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : إِنْ رَجَعَ إلَی مِیقَاتِ أَہْلِہِ فَاعْتَمَرَ ، رَجَوْتُ أَنْ تَکُونَ عُمْرَۃً۔","","Musannaf Ibn Abi Shaybah 13183","","","كتاب الحج"
"13184","(۱۳۱۸۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَرِہُوا الْعُمْرَۃَ بَعْدَ الْحَجِّ ، وَقَالُوا : لاَ تُجْزِیء ، وَلاَ تَفِی ، وَقَالُوا : الطَّوَافُ بِالْبَیْتِ وَالصَّلاَۃُ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 13184","","","كتاب الحج"
"13185","(۱۳۱۸۵) حدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ؛ أَنَّ أَبَا مَعْقِلٍ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنَّ أُمَّ مَعْقِلٍ جَعَلَتْ عَلَیْہَا أَنْ تَحُجَّ فَلَمْ یَتَیَسَّرْ لَہَا ، فَقَالَ : تَعْتَمِرُ فِی رَمَضَانَ۔ (نسائی ۴۳۲۸)","","Musannaf Ibn Abi Shaybah 13185","","","كتاب الحج"
"13186","(۱۳۱۸۶) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عِیسَی بْنِ مَعْقِلٍ بْنِ أَبِی مَعْقِلٍ الأَسَدِیِّ ، عَنْ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ سَلاَمٍ ، عَنْ جَدَّتِہِ أُمِّ مَعْقِلٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اعْتَمِرِی فِی رَمَضَانَ ، فَإِنَّہَا حَجَّۃٌ۔ (ابوداؤد ۱۹۸۲۔ دارمی ۱۸۶۰)","Da'if","Musannaf Ibn Abi Shaybah 13186","","","كتاب الحج"
"13187","(۱۳۱۸۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ سَلاَمٍ ، سَمِعَ رَجُلاً مِنَ الأَنْصَارِ یَقُولُ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَہُ وَلامْرَأَتِہِ : اعْتَمِرَا فِی رَمَضَانَ ، فَإِنَّ عُمْرَۃً لَکُمَا فِی رَمَضَانَ تَعْدِلُ حَجَّۃً۔ (احمد ۴/۳۵)","Sahih","Musannaf Ibn Abi Shaybah 13187","","","كتاب الحج"
"13188","(۱۳۱۸۸) حدَّثَنَا وَکِیعٌ ، وَیَحْیَی بْنُ آَدَمَ ، عَنْ سُفْیَانَ ، عَنْ بَیَانٍ ، وَجَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ وَہْبِ بْنِ خَنْبَشٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَمْرَۃٌ فِی رَمَضَانَ تَعْدِلُ حَجَّۃً۔ (احمد ۱۷۷۔ ابن ماجہ ۲۹۹۱)","Sahih","Musannaf Ibn Abi Shaybah 13188","","","كتاب الحج"
"13189","(۱۳۱۸۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عُمْرَۃٌ فِی رَمَضَانَ تَعْدِلُ حَجَّۃً۔ (بخاری ۱۷۸۲۔ مسلم ۹۱۷)","","Musannaf Ibn Abi Shaybah 13189","","","كتاب الحج"
"13190","(۱۳۱۹۰) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُُہُ قُلْتُ : ہَذَا الْحَجُّ الأَکْبَرُ ، فَمَا الْحَجُّ الأَصْغَرُ؟ قَالَ : عُمْرَۃٌ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 13190","","","كتاب الحج"
"13191","(۱۳۱۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَمُجَاہِدٍ ، قَالَ : کَانَا یَعْتَمِرَانِ فِی شَہْرِ رَمَضَانَ مِنَ الْجِعْرَانَۃِ۔","","Musannaf Ibn Abi Shaybah 13191","","","كتاب الحج"
"13192","(۱۳۱۹۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ : قَالَ : خَرَجْتُ أَنَا وَعَطَائٌ فِی رَمَضَانَ ، فَأَحْرَمْنَا مِنَ الْجِعْرَانَۃِ۔","","Musannaf Ibn Abi Shaybah 13192","","","كتاب الحج"
"13193","(۱۳۱۹۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، قَالَ : کَانَ أبو بَکْرِ بْنُ عَبْدِ الرَّحْمَنِ لاَ یَعْتَمِرُ إِلاَّ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 13193","","","كتاب الحج"
"13194","(۱۳۱۹۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : سُئِلَ عَبْدُ اللہ عَنِ الْعُمْرَۃِ فِی أَشْہُرِ الْحَجِّ ؟ فَقَالَ عَبْدُ اللہ : (الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ) لَیْسَ فِیہِنَّ عُمْرَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 13194","","","كتاب الحج"
"13195","(۱۳۱۹۵) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : سُئِلَ عَلْقَمَۃُ عَنِ الْعُمْرَۃِ فِی أَشْہُرِ الْحَجِّ ؟ فَقَالَ : وَیَفْعَلُ ذَلِکَ أَحَدٌ ؟۔","","Musannaf Ibn Abi Shaybah 13195","","","كتاب الحج"
"13196","(۱۳۱۹۶) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلْقَاسِمِ بْنِ مُحَمَّدٍ : نَہَی عُمَرُ عَنِ الْعُمْرَۃِ فِی أَشْہُرِ الْحَجِّ ؟ فَتَلَکَّأَ ، وَقَالَ : نَہَی عُثْمَانُ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 13196","","","كتاب الحج"
"13197","(۱۳۱۹۷) حدَّثَنَا وَکِیعٌ، عَنِ ابْنِ أَبِی رَوَّادٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: قَالَ عُمَرَ: افْصِلُوا بَیْنَ حَجِّکُمْ وَعُمْرَتِکُمْ، اجْعَلُوا الْحَجَّ فِی أَشْہُرِ الْحَجِّ، وَاجْعَلُوا الْعُمْرَۃَ فِی غَیْرِ أَشْہُرِ الْحَجِّ، أَتَمُّ لِحَجِّکُمْ وَلِعُمْرَتِکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 13197","","","كتاب الحج"
"13198","(۱۳۱۹۸) حدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا أَعْلَمُہُمْ یَخْتَلِفُونَ أَنَّ الْعُمْرَۃَ فِی غَیْرِ أَشْہُرِ الْحَجِّ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 13198","","","كتاب الحج"
"13199","(۱۳۱۹۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ الْقَاسِمُ عَنِ الْعُمْرَۃِ فِی أَشْہُرِ الْحَجِّ ؟ فَقَالَ : کَانُوا لاَ یَرَوْنَہَا تَامَّۃً۔","","Musannaf Ibn Abi Shaybah 13199","","","كتاب الحج"
"13200","(۱۳۲۰۰) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ، عَنْ جَعْفَرٍ، عَنْ مَیْمُونٍ؛ أَنَّہُ قَالَ: اعْتَمَرْتُ مِنْ بَلَدِی ہَذَا فِی غَیْرِ أَشْہُرِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13200","","","كتاب الحج"
"13201","(۱۳۲۰۱) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَمِعْتُہُ یَقُولُ : اعْتَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُمُرًا ثَلاَثَاً ، کُلَّہَا فِی ذِی الْقَعْدَۃِ۔","","Musannaf Ibn Abi Shaybah 13201","","","كتاب الحج"
"13202","(۱۳۲۰۲) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی مَعَنٍ ، قَالَ : رَأَیْتُ جَابِرَ بْنَ زَیْدٍ ، وَأَبَا الْعَالِیَۃِ اعْتَمَرَا فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 13202","","","كتاب الحج"
"13203","(۱۳۲۰۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ یَزِیدَ ، عَنْ أَخِیہِ ، قَالَ : قَالَ لِی عِمْرَانُ بْنُ حُصَیْنٍ ؛ اِعْلَمْ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَدَ أَعْمَرَ طَائِفَۃً مِنْ أَہْلِہِ فِی عَشْر ذِی الْحِجَّۃِ ، فَلَمْ یُنْہَ عَنْہُ ، وَلَمْ یَنْزِلْ نَسْخُہُ ، قَالَ فِی ذَلِکَ قَائِلٌ مَا شَائَ۔ (مسلم ۱۶۵۔ ابن ماجہ ۲۹۷۸)","Sahih","Musannaf Ibn Abi Shaybah 13203","","","كتاب الحج"
"13204","(۱۳۲۰۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ قَالَتْ : مَا اعْتَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُمْرَۃً إِلاَّ شَہِدْتُہَا ، وَمَا اعْتَمَرَ إِلاَّ فِی ذِی الْقَعْدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13204","","","كتاب الحج"
"13205","(۱۳۲۰۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : الْعُمْرَۃُ فِی الْعَشْرِ أَحَبُّ إلَیَّ مِنَ الْعُمْرَۃِ بَعْدَ الْحَجِّ۔","Sahih","Musannaf Ibn Abi Shaybah 13205","","","كتاب الحج"
"13206","(۱۳۲۰۶) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَی إلی الْبَیْتِ فَصَلَّی بِمَکَّۃَ الظُّہْرَ ، یَعْنِی یَوْمَ النَّحْرِ۔ (مسلم ۱۱۰۔ ابوداؤد ۱۹۰۰)","Sahih","Musannaf Ibn Abi Shaybah 13206","","","كتاب الحج"
"13207","(۱۳۲۰۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِسْمَاعِیلَ ، عَنْ وَبَرَۃَ ، قَالَ : کَانَ الأَسْوَدُ إذَا رَمَی الْجَمْرَۃَ یَوْمَ النَّحْرِ زَارَ الْبَیْتَ مِنْ یَوْمِہِ ، ثُمَّ رَجَعَ إلَی مَنْزِلِہِ مِنْ یَوْمِہِ ، حَتَّی یَنْفِرَ مَعَ النَّاسِ إذَا نَفَرُوا۔","","Musannaf Ibn Abi Shaybah 13207","","","كتاب الحج"
"13208","(۱۳۲۰۸) حدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَسْتَحِبُّ أَنْ یَأْتِیَ الْبَیْتَ یَوْمَ النَّحْرِ قَبْلَ الْعَصْرِ فَیَطُوفَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13208","","","كتاب الحج"
"13209","(۱۳۲۰۹) حدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمَ قَالَ : أَفَضْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ عَشِیَّۃَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 13209","","","كتاب الحج"
"13210","(۱۳۲۱۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَنْحَرُ ہَدْیَہُ خَلْفَ الْعَقَبَۃِ ، ثُمَّ یَحْلِقُ رَأْسَہُ ، ثُمَّ یُفِیضُ کَمَا ہُوَ إلَی الْبَیْتِ ، قَبْلَ أَنْ یَرْجِعَ إلَی أَہْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 13210","","","كتاب الحج"
"13211","(۱۳۲۱۱) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَمْرِو بْنِ عَمْرٍو أَبِی الزَّعْرَائِ ، قَالَ : سَافَرْتُ مَعَ أَبِی الأَحْوَصِ ، فَلَمَّا کَانَ یَوْمُ النَّحْرِ رَمَی الْجَمْرَۃَ وَحَلَقَ ، وَأَفَاضَ إلَی الْبَیْتِ ، وَلَمْ یُضَحِّ۔","","Musannaf Ibn Abi Shaybah 13211","","","كتاب الحج"
"13212","(۱۳۲۱۲) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، قَالَ : کَانَ الأَسْوَدُ إذَا جَائَ مِنْ مِنًی رَمَی وَحَلَقَ ، ثُمَّ زَارَ الْبَیْتَ ، وَلاَ یُضَحِّی۔","","Musannaf Ibn Abi Shaybah 13212","","","كتاب الحج"
"13213","(۱۳۲۱۳) حُدِّثْتُ عَنِ ابْنِ مُبَارَکٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی قِلاَبَۃَ ، وَجَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُمَا زَارَا الْبَیْتَ یَوْمَ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 13213","","","كتاب الحج"
"13214","(۱۳۲۱۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، وَابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زَارَ الْبَیْتَ لَیْلاً۔ (ابوداؤد ۱۹۹۳۔ احمد ۱/۲۸۸)","","Musannaf Ibn Abi Shaybah 13214","","","كتاب الحج"
"13215","(۱۳۲۱۵) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : حدَّثَنَا دَاوُد بْنُ شَابُورَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : لَمْ یَکُنْ یُفِیضُ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ مَنْ کَانَ مِنْہُمْ تَکُونُ مَعَہُ امْرَأَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 13215","","","كتاب الحج"
"13216","(۱۳۲۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَّرَ الزِّیَارَۃَ إلَی اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 13216","","","كتاب الحج"
"13217","(۱۳۲۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنْ أَبِیہِ : قَالَ : کُنَّا مَعَ أَبِی أَیُّوبَ نَفَرًا مِنَ الأَنْصَارِ ، فَمَا زَارَ مِنَّا أَحَدٌ الْبَیْتَ حَتَّی کَانَ فِی النَّفْرِ الآخِرِ ، إِلاَّ رَجُلٌ کَانَ مَعَہُ أَہْلُہُ فَتَعَجَّلَ بِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 13217","","","كتاب الحج"
"13218","(۱۳۲۱۸) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، وَأَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ تُؤَخِّرَ الزِّیَارَۃَ إلَی یَوْمِ النَّفْرِ۔","","Musannaf Ibn Abi Shaybah 13218","","","كتاب الحج"
"13219","(۱۳۲۱۹) حدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ بِمِنًی مُعْتَمًّا مُتَقَمِّصًا ، وَکَانَ لاَ یُفِیضُ حَتَّی یَنْفِرَ فِی آخِرِ أَیَّامِ التَّشْرِیقِ۔","","Musannaf Ibn Abi Shaybah 13219","","","كتاب الحج"
"13220","(۱۳۲۲۰) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَأْتِی مَکَّۃَ إِلاَّ حِینَ یُفِیضُ۔","Sahih","Musannaf Ibn Abi Shaybah 13220","","","كتاب الحج"
"13221","(۱۳۲۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَأْتِی بَعْدَ النَّحْرِ یَوْمًا ، فَقِیلَ لَہُ : ہُوَ نَائِمٌ ، وَمَا زَارَ الْبَیْتَ بَعْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 13221","","","كتاب الحج"
"13222","(۱۳۲۲۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَخِّرَہ إلَی الْغَدِ۔","","Musannaf Ibn Abi Shaybah 13222","","","كتاب الحج"
"13223","(۱۳۲۲۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ ، قَالَ : لَقِیتُ أَبَا جَعْفَرٍ الْغَدَ مِنْ یَوْمِ النَّحْرِ ، فَقُلْتُ : إِنِّی لَمْ أَزُرِ الْبَیْتَ بعدُ ، فَقَالَ : وَأَنَا إِنَّمَا زُرْتُ الْیَوْمَ۔","","Musannaf Ibn Abi Shaybah 13223","","","كتاب الحج"
"13224","(۱۳۲۲۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ دِینَارٍ یَقُولُ بَعْدَ أَیَّامٍ : مَا زُرْتُ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 13224","","","كتاب الحج"
"13225","(۱۳۲۲۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، قَالَ : لَمْ أَعْقِلْ أَبِی یُفِیضُ إِلاَّ لَیْلاً۔","","Musannaf Ibn Abi Shaybah 13225","","","كتاب الحج"
"13226","(۱۳۲۲۶) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَزُورَ الْبَیْتَ لَیْلاً زِیَارَۃَ یَوْمِ النَّحْرِ ، وَلَکِنْ لاَ یَبِیتَنَّ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13226","","","كتاب الحج"
"13227","(۱۳۲۲۷) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَرَکَہُ حَتَّی تَمْضِی تِلْکَ الأَیَّامُ ، أَہْرَاقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 13227","","","كتاب الحج"
"13228","(۱۳۲۲۸) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَخِّرَ الزِّیَارَۃَ إلَی یَوْمِ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 13228","","","كتاب الحج"
"13229","(۱۳۲۲۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، وَابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ، عَنِ الْحَجَّاجِ بْنِ عَمْرٍو الأَنْصَارِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ حَجَّ فَکُسِرَ، أَوْ عَرَجَ حَلَّ ، وَعَلَیْہِ الْحَجُّ ، فَذَکَرْتُ ذَلِکَ لأَبِی ہُرَیْرَۃَ ، وَابْنِ عَبَّاسٍ ، فَقَالاَ : صَدَقَ۔n(ترمذی ۹۴۰۔ ابوداؤد ۱۸۵۷)","Sahih","Musannaf Ibn Abi Shaybah 13229","","","كتاب الحج"
"13230","(۱۳۲۳۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَمَرَ اللَّہُ تَعَالَی بِالْقِصَاصِ ، أَفَیَأْخُذُ مِنْکُمَ الْعُدْوَانَ ؟ حَجَّۃٌ بِحَجَّۃٍ ، وَعُمْرَۃٌ بِعُمْرَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13230","","","كتاب الحج"
"13231","(۱۳۲۳۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عِکْرِمَۃَ ، قَالَ : إذَا أَہَلَّ الرَّجُلُ بِالْحَجِّ فَأُحْصِرَ ، فَلیَبْعَثْ بِہَدْیِہِ ، فَإِنْ مَضَی جَعَلَہَا عُمْرَۃً ، وَعَلَیْہِ الْحَجُّ مِنْ قَابِلٍ ، وَلاَ ہَدْیَ عَلَیْہِ ، وَإِنْ ہُوَ أَخَّرَ ذَلِکَ حَتَّی یَحُجَّ ، فَعَلَیْہِ حَجَّۃٌ وَعُمْرَۃٌ ، وَمَا اسْتَیْسَرَ مِنَ الْہَدْیِ ، فَمَنْ لَمْ یَجِدْ فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ فِی الْحَجِّ، آخِرُہَا یَوْمُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 13231","","","كتاب الحج"
"13232","(۱۳۲۳۲) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلَنِی عَنْ ذَلِکَ سَعِیدُ بْنُ جُبَیْرٍ ؟ فَأَخْبَرْتُہُ ، فَقَالَ بِیَدِہِ ہَکَذَا وَعَقَدَ ثَلاَثِینَ ، ہَکَذَا قَالَ ابْنُ عَبَّاسٍ۔","Hasan","Musannaf Ibn Abi Shaybah 13232","","","كتاب الحج"
"13233","(۱۳۲۳۳) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ الزُّبَیْرِ یَخْطُبُ ، فَقَالَ : یَا أَیُّہَا النَّاسُ ، وَاللَّہِ مَا الْمُتَمَتِّعُ بِالْعُمْرَۃِ إلَی الْحَجِّ کَمَا تَقُولُونَ ، وَلَکِنْ إنَّمَا الْمُتَمَتِّعُ بِالْعُمْرَۃِ إلَی الْحَجِّ ؛ أَنْ یُہِلَّ الرَّجُلُ فَیُحْصَرُ إمَّا مَرَضٌ ، أَوْ أَمْرٌ یَحْبِسُہُ حَتَّی تَذْہَبَ أَیَّامُ الْحَجِّ ، فَیَقْدَمُ فَیَجْعَلُہَا عُمْرَۃً وَیَتَمَتَّعُ بِحَجَّۃٍ إلَی الْعَامِ الْمُقْبِلِ ، وَیُہْدِی وَیَحُجُّ ، فَہَذَا الْمُتَمَتِّعُ بِالْعُمْرَۃِ إلَی الْحَجِّ۔","Sahih","Musannaf Ibn Abi Shaybah 13233","","","كتاب الحج"
"13234","(۱۳۲۳۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، وحُمَیْدٍ ، عَنِ الْحَسَنِ قَالَ : عَلَیْہِ حَجَّۃٌ وَعُمْرَۃٌ۔","","Musannaf Ibn Abi Shaybah 13234","","","كتاب الحج"
"13235","(۱۳۲۳۵) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13235","","","كتاب الحج"
"13236","(۱۳۲۳۶) حدَّثَنَا ہُشَیْمٌ ، عن ابن شُبْرُمۃ ، عَنِ الشَّعْبِی ، قَالَ : عَلَیْہِ الْحَجُّ۔","","Musannaf Ibn Abi Shaybah 13236","","","كتاب الحج"
"13237","(۱۳۲۳۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ حَجَّ فَعَلَیْہِ أَنْ یَصِلَ إلَی الْبَیْتِ بِحَجٍّ ، أَوْ عُمْرَۃٍ، وَإِنْ کَانَ لَمْ یَحُجَّ فَعَلَیْہِ الْحَجُّ۔","","Musannaf Ibn Abi Shaybah 13237","","","كتاب الحج"
"13238","(۱۳۲۳۸) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَقُولُ : إذَا افْترَضَ الرَّجُلُ الْحَجَّ فَأَصَابَہُ حَصْرٌ، فَإِنَّہُ یَبْعَثُ بِہَدْیِہِ ، فَإِذَا بَلَغَ الْہَدْیُ مَحِلَّہُ ، حَلَّ مِنْ أَشْیَائَ وَحَرُمَ مِنْ أُخْرَی ، فَإِذَا کَانَ عَامُ قَابِلٍ أَہَلَّ بِالْحَجِّ وَالْعُمْرَۃِ ، فَإِنْ جَمَعَ بَیْنَہُمَا فَعَلَیْہِ الْہَدْیُ ، وَإِنْ شَائَ أَقَامَ حَتَّی یَبْرَأَ ، فَیَمْضِی مِنْ وَجْہِہِ فَیَطُوفُ بِالْبَیْتِ ، فَیُلْقِی عَنْہُ الْعُمْرَۃَ ، وَعَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 13238","","","كتاب الحج"
"13239","(۱۳۲۳۹) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ، عَنِ ابْنِ عَوْنٍ، قَالَ: سَأَلْتُ الْقَاسِمَ، وَسَالِمًا عَنِ الْمُحْصَرِ؟ فَقَالاَ: نَحْوَ قَوْلِ مُحَمَّدٍ۔","","Musannaf Ibn Abi Shaybah 13239","","","كتاب الحج"
"13240","(۱۳۲۴۰) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بن یسار ؛ أَنَّ مَعْبَدَ بْنَ حُزَابَۃَ الْمَخْزُومِیَّ صُرِعَ بِطَرِیقِ مَکَّۃَ ، فَخَرَجَ ابْنُہُ إلَی الْمَائِ الَّذِی صُرِعَ عَلَیْہِ أَبُوہُ ، فَوَجَدَ ابْنَ عَبَّاسٍ ، وَابْنَ عُمَرَ ، وَمَرْوَانَ بْنَ الْحَکَمِ ، فَکلُّہُمْ ذَکَرَ لَہُ مَصْرَعَ أَبِیہِ وَالَّذِی أَصَابَہُ ، وَکُلُّہُمْ قَالَ : یَتَدَاوَی بِالذِی یُصْلِحُہُ ، فَإِذَا صَحَّ اعْتَمَرَ فَفَسَخَ عَنْہُ حِرْمَ الْحَجِّ ، فَإِذَا أَدْرَکَہُ الْحَجُّ فَعَلَیْہِ الْحَجُّ ، وَمَا اسْتَیْسَرَ مِنَ الْہَدْیِ۔","Sahih","Musannaf Ibn Abi Shaybah 13240","","","كتاب الحج"
"13241","(۱۳۲۴۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : خَرَجْنَا عُمَّارًا حَتَّی إذَا کُنَّا بِذَاتِ الشُّقُوقِ ، لُدِغَ صَاحِبٌ لَنَا ، فَاعْتَرَضْنَا الطَّرِیقَ نَسْأَلَ مَا نصنعُ بِہِ ؟ فَإِذَا ابْنُ مَسْعُودٍ فِی رَکْبٍ ، فَقُلْنَا : لُدِغَ صَاحِبٌ لَنَا ؟ فَقَالَ : اجْعَلُوا بَیْنَکُمْ وَبَیْنَ صَاحِبِکُمْ یَوْمَ أَمَارَۃٍ ، وَلْیُرْسِلْ بِالْہَدْیِ ، فَإِذَا نُحِرَ الْہَدْیُ فَلْیُحِلَّ ، وَعَلَیْہِ الْعُمْرَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 13241","","","كتاب الحج"
"13242","(۱۳۲۴۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الْعَلاَئِ بْنِ الشِّخِّیرِ ، قَالَ : خَرَجْتُ مُعْتَمِرًا ، فَلَمَّا کُنْتُ بِبَعْضِ الطَّرِیقِ صُرِعْتُ عَنْ رَاحِلَتِی ، فَانْکَسَرَتْ رِجْلِی ، فَأَرْسَلْتُ إلَی ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ مَنْ یَسْأَلُہُمَا ، فَقَالاَ : إنَّ الْعُمْرَۃَ لَیْسَ لَہَا وَقْتٌ کَوَقْتِ الْحَجِّ ، لاَ یَحِلَّ حَتَّی یَطُوفَ بِالْبَیْتِ ، فَأَقَمْتُ بِالدَّثِیْنۃ خَمْسَۃَ أَشْہُرٍ ، أَوْ ثَمَانیَۃَ أَشْہُرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13242","","","كتاب الحج"
"13243","(۱۳۲۴۳) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوس ؛ فِی الْمُحْرِمِ بِعُمْرَۃٍ اعْتُرِضَ لَہُ ، قَالَ : یَبْعَثُ بِہَدْیٍ ، ثُمَّ یَحْسِبُ کَمْ یَسِیرُ ، ثُمَّ یَحْتَاطُ بِأَیَّامٍ ، ثُمَّ یَحِلُّ۔","","Musannaf Ibn Abi Shaybah 13243","","","كتاب الحج"
"13244","(۱۳۲۴۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : سَأَلْتُ مُجَاہِدًا عَنِ الْمُحْرِمِ یُوَاقِعُ امْرَأَتَہُ ؟ فَقَالَ: کَانَ ذَلِکَ عَلَی عَہْدِ عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : یَقْضِیَانِ حَجَّہُمَا ، وَاللَّہُ أَعْلَمُ بِحَجِّہِمَا ، ثُمَّ یَرْجِعَانِ حَلاَلاً کُلُّ وَاحِدٍ مِنْہُمَا لِصَاحِبِہِ ، فَإِذَا کَانَ مِنْ قَابِلٍ حَجَّا وَأَہْدَیَا ، وَتَفَرَّقَا مِنَ الْمَکَانِ الَّذِی أَصَابَہَا۔","","Musannaf Ibn Abi Shaybah 13244","","","كتاب الحج"
"13245","(۱۳۲۴۵) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَبْدِ اللہِ بْنِ وَہْبَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ ، فَقَالَ : إِنِّی وَقَعْتُ عَلَی امْرَأَتِی وَأَنَا مُحْرِمٌ ، فَقَالَ : اللَّہُ أَعْلَمُ بِحَجِّکُمَا ، امْضِیَا لِوَجْہِکُمَا ، وَعَلَیْکُمَا الْحَجُّ مِنْ قَابِلٍ ، فَإِذَا انْتَہَیْتَ إلَی الْمَکَانِ الَّذِی وَاقَعْتَ فِیہِ فَتَفَرَّقَا ، ثُمَّ لاَ تَجْتَمِعَا حَتَّی تَقْضِیَا حَجَّکُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 13245","","","كتاب الحج"
"13246","(۱۳۲۴۶) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمَا بَدَنَۃٌ ، فَإِذَا حَجَّا مِنْ قَابِلٍ تَفَرَّقَا مِنَ الْمَکَانِ الَّذِی أَصَابَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13246","","","كتاب الحج"
"13247","(۱۳۲۴۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : حدَّثَنِی سَعِیدُ بْنُ خُرْشِید ؛ أَنَّ رَجُلاً اسْتَفْتَی جَابِرَ بْنَ زَیْدٍ ، وَالْحَسَنَ بْنَ مُحَمَّدٍ عَنْ رَجُلٍ وَامْرَأَتِہِ أَہَلاَّ بِالْحَجِّ ، ثُمَّ وَقَعَ عَلَیْہَا ، فَقَالاَ : یُتِمَّانِ حَجَّہُمَا ، وَعَلَیْہِمَا الْحَجُّ مِنْ قَابِلٍ ، وَإِنْ کَانَا ذَا مَیْسَرَۃٍ أَہْدَی جَزُورًا۔","","Musannaf Ibn Abi Shaybah 13247","","","كتاب الحج"
"13248","(۱۳۲۴۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : أَتَی رَجُلٌ عَبْد اللہ بْن عَمْرٍو فَسَأَلَہُ عَنْ مُحْرِمٍ وَقَعَ بِامْرَأَتِہِ ؟ فَأَشَارَ لَہُ إلَی عَبْدِ اللہِ بْنِ عُمَرَ فَلَمْ یَعْرِفْہُ الرَّجُلُ ، قَالَ شُعَیْبٌ : فَذَہَبْتُ مَعَہُ ، فَسَأَلَہُ ؟ فَقَالَ : بَطَلَ حَجُّہُ ، قَالَ : فَیَقْعُدُ ؟ قَالَ : لاَ ، بَلْ یَخْرُجُ مَعَ النَّاسِ فَیَصْنَعُ مَا یَصْنَعُونَ، فَإِذَا أَدْرَکَہُ قَابِلٌ حَجَّ وَأَہْدَی ، فَرَجَعَا إلَی عَبْدِ اللہِ بْنِ عَمْرٍو فَأَخْبَرَاہُ ، فَأَرْسَلَنَا إلَی ابْنِ عَبَّاسٍ ، قَالَ شُعَیْبٌ : فَذَہَبْتُ إلَی ابْنِ عَبَّاسٍ مَعَہُ ، فَسَأَلَہُ ؟ فَقَالَ لَہُ : مِثْلَ مَا قَالَ ابْنُ عُمْر ، فَرَجَعَ إلَیْہِ فَأَخْبَرَہُ ، فَقَالَ لَہُ الرَّجُلُ : مَا تَقُولُ أَنْتَ ؟ فَقَالَ : مِثْلَ مَا قَالاَ۔","Hasan","Musannaf Ibn Abi Shaybah 13248","","","كتاب الحج"
"13249","(۱۳۲۴۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : یَمْضِیَانِ لِوَجْہِہِمَا ، وَیَقْضِیَانِ حَجَّہُمَا ، وَیَرْجِعَانِ حَیْثُ أَحَبَّا ، فَإِذَا کَانَ قَابِلٌ أَہَلاَّ مِنْ حَیْثُ کَانَا أَہَلاَّ لِحَجِّہِمَا الَّذِی أَفْسَدَا ، وَأَہْدَیَا وَتَفَرَّقَا۔","","Musannaf Ibn Abi Shaybah 13249","","","كتاب الحج"
"13250","(۱۳۲۵۰) حدَّثَنَا محمد بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالاَ : یَتِمَّانِ عَلَی حَجِّہِمَا ، وَعَلَی کُلِّ وَاحِدٍ مِنْہُمَا دَمٌ ، وَإِنْ کَانَ وَاحِدًا أَجْزَأَہُمَا ، وَعَلَیْہِمَا الْحَجُّ مِنْ قَابِلٍ ، وَلاَ یَتَفَرَّقَانِ۔","","Musannaf Ibn Abi Shaybah 13250","","","كتاب الحج"
"13251",") حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَعْرِفُ التَّفْرِیقَ فِی الرَّجُلِ إذَا وَاقَعَ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13251","","","كتاب الحج"
"13252","( (۱۳۲۵۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالاَ : یَقْضِیَانِ نُسُکَہُمَا وَعَلَیْہِمَا ہَدْیٌ ہَدْیٌ ، وَیَحُجَّانِ مِنْ قَابِلٍ ، فَإِذَا أَتَیَا الْمَکَانَ الَّذِی وَقَعَ بِہَا لَمْ یَجْتَمِعَا حَتَّی یَحِلاَّ۔","","Musannaf Ibn Abi Shaybah 13252","","","كتاب الحج"
"13253","(۱۳۲۵۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمَا بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 13253","","","كتاب الحج"
"13254","(۱۳۲۵۴) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، قَالَ: یُہْرِیقُ کُلُّ وَاحِدٍ مِنْہُمَا دَمًا۔","","Musannaf Ibn Abi Shaybah 13254","","","كتاب الحج"
"13255","(۱۳۲۵۵) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ: بَیْنَہُمَا بَدَنَۃٌ ، وَقَالَ سُفْیَانُ : شَاۃٌ تُجْزِیئ۔","","Musannaf Ibn Abi Shaybah 13255","","","كتاب الحج"
"13256","(۱۳۲۵۶) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمَا ہَدْیٌ۔","Sahih","Musannaf Ibn Abi Shaybah 13256","","","كتاب الحج"
"13257","(۱۳۲۵۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمَا شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13257","","","كتاب الحج"
"13258","(۱۳۲۵۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یُہْدِیَانِ ہَدْیًا من عَامِہِمَا۔","","Musannaf Ibn Abi Shaybah 13258","","","كتاب الحج"
"13259","(۱۳۲۵۹) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : عَلَی کُلِّ وَاحِدٍ مِنْہُمَا بَدَنَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 13259","","","كتاب الحج"
"13260","(۱۳۲۶۰) حدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، وَعَطَائٍ قَالاَ: یُہْرِیقُ کُلُّ وَاحِدٍ مِنْہُمَا دَمًا، إِنْ کَانَ وَاحِدًا أَجْزَأَہُمَا۔","","Musannaf Ibn Abi Shaybah 13260","","","كتاب الحج"
"13261","(۱۳۲۶۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالاَ : عَلَیْہِمَا ہَدْیٌ ہَدْیٌ فِیْہِ۔","","Musannaf Ibn Abi Shaybah 13261","","","كتاب الحج"
"13262","(۱۳۲۶۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : یُحْرِمَانِ مِنَ الْمَکَانِ الَّذِی أَحْدَثَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 13262","","","كتاب الحج"
"13263","(۱۳۲۶۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالاَ : یُحْرِمَانِ مِنَ الْمَکَانِ الَّذِی أَحْرَمَا۔","","Musannaf Ibn Abi Shaybah 13263","","","كتاب الحج"
"13264","(۱۳۲۶۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إِذَا کَانَ قَابِلاً أَہَلاَّ مِنْ حَیْثُ کَانَا أَہَلاَّ بِحَجِّہِمَا الَّذِی أَفْسَدَا۔","","Musannaf Ibn Abi Shaybah 13264","","","كتاب الحج"
"13265","(۱۳۲۶۵) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : أَرْسَلَ مُجَاہِدٌ ، وَسَعِیدُ بْنُ جُبَیْرٍ إلَی عَطَائٍ یَسْأَلاَنِہِ عَنِ الطَّعَامِ لِلْمُحْرِمِ فِیہِ الزَّعْفَرَانُ ؟ فَکَرِہَہُ ، فَقَالاَ : تَأثُرہُ عَنْ أَحَدٍ ؟ فَقَالَ : لاَ ، فَأَکَلا وَلَمْ یَنْظُرَا إلَی قَوْلِہِ۔","","Musannaf Ibn Abi Shaybah 13265","","","كتاب الحج"
"13266","(۱۳۲۶۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، وَعَطَائً عَنِ الْخُشْکَنَانَجِ وَالْخَبِیصِ الأَصْفَرِ ؟ فَکَرِہَاہُ ، قَالَ : فَسَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : تَدَّہِنُ بِالزَّیْتِ وَأَنْتَ مُحْرِمٌ ؟ قَالَ : قُلْتُ : لاَ ، قَالَ : فَتَدَّہِنُ بالسمن وَأَنْتَ مُحْرِمٌ ؟ قُلْتُ : لاَ ، قَالَ : فَإِنَّ الْخُشْکَنَانَجَ قَدْ طُبِخَ بِالنَّارِ۔","","Musannaf Ibn Abi Shaybah 13266","","","كتاب الحج"
"13267","(۱۳۲۶۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : لاَ بَأْسَ بِالْخُشْکَنَانَجِ الْمُعَصْفَرِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13267","","","كتاب الحج"
"13268",") حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالْخَبِیصِ الأَصْفَرِ وَالْخُشْکَنَانَجِ الأَصْفَرِ بَأْسًا ، إذَا مَسَّتْہُ النَّارُ۔","","Musannaf Ibn Abi Shaybah 13268","","","كتاب الحج"
"13269","(۱۳۲۶۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ طَاوُوسٍ ، وَعَطَائٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِالْخَبِیصِ الأَصْفَرِ لِلْمُحْرِمِ، وَیَقُولاَنِ : مَا مَسَّتْہُ النَّارُ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13269","","","كتاب الحج"
"13270","(۱۳۲۷۰) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَأْکُلَ الْمُحْرِمُ الطَّعَامَ فِیہِ الزَّعْفَرَانُ۔","","Musannaf Ibn Abi Shaybah 13270","","","كتاب الحج"
"13271","(۱۳۲۷۱) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالْخَبِیصِ الأَصْفَرِ وَالْخُشْکَنَانَجِ الأَصْفَرِ بَأْسًا لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13271","","","كتاب الحج"
"13272","(۱۳۲۷۲) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، قَالَ : ذُکِرَ لإِبْرَاہِیمَ أَنَّ الْمُغِیرَۃَ یَکْرَہُ أَنْ یَأْکُلَ الْخُشْکَنَانَجَ الأَصْفَرَ فِی الإِحْرَامِ ، فَکَانَ إبْرَاہِیمُ یَعْجَبُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13272","","","كتاب الحج"
"13273","(۱۳۲۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَد ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَأْکُلُ الْخُشْکَنَانَجَ الأَصْفَرَ وَہُوَ مُحْرِمٌ ۔ قَالَ : وَکَانَ أَبُو جَعْفَرٍ لاَ یَرَی بِالطَّعَامِ فِیہِ الزَّعْفَرَانُ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 13273","","","كتاب الحج"
"13274","(۱۳۲۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ رَجُلٍ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ؛ أَنَّہُ کَرِہَہُ ، ثُمَّ لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 13274","","","كتاب الحج"
"13275","(۱۳۲۷۵) حدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا بِالْخُشْکَنَانَجِ الأَصْفَرِ لِلْمُحْرِمِ۔","Da'if","Musannaf Ibn Abi Shaybah 13275","","","كتاب الحج"
"13276","(۱۳۲۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 13276","","","كتاب الحج"
"13277","(۱۳۲۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13277","","","كتاب الحج"
"13278","(۱۳۲۷۸) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَرِہَ الزَّعْفَرَانَ عَلَی الطَّعَامِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13278","","","كتاب الحج"
"13279","(۱۳۲۷۹) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ (ح) وَعَنِ الْحَکَمِ بْنِ عُتَیْبَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِأَکْلِ الْمُحْرِمِ الْمِلْحَ الَّذِی فِیہِ الزَّعْفَرَانُ۔","","Musannaf Ibn Abi Shaybah 13279","","","كتاب الحج"
"13280","(۱۳۲۸۰) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بأس بالْمِلْحِ الأَصْفَرِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13280","","","كتاب الحج"
"13281","(۱۳۲۸۱) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ الْمِلْحَ الأَصْفَرَ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13281","","","كتاب الحج"
"13282","(۱۳۲۸۲) حدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، قَالَ : سَأَلْتُ جَعْفَرًا عَنِ الْمِلْحِ الأَصْفَرِ لِلْمُحْرِمِ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 13282","","","كتاب الحج"
"13283","(۱۳۲۸۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، قَالَ : کُنْتُ عِنْدَ سَعِیدِ بْنِ الْمُسَیَّبِ ، فَقَالَ لَہُ رَجُلٌ : إنِّی أُرِیدُ أَنْ أُحْرِمَ وَمَعِی ثَوْبٌ مَصْبُوغٌ بِالزَّعْفَرَانِ ، فَغَسَلْتُہُ حَتَّی ذَہَبَ لَوْنُ الزَّعْفَرَانِ ، فَقَالَ سَعِیدٌ : مَعَکَ ثَوْبٌ غَیْرُہُ ؟ قَالَ: لاَ ، قَالَ : فَأَحْرِمْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 13283","","","كتاب الحج"
"13284","(۱۳۲۸۴) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَغْسِلُہُ وَیُحْرِمُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 13284","","","كتاب الحج"
"13285","(۱۳۲۸۵) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ صَالِحِ بْنِ جُبَیْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : أَتَیْتُہُ فِی مِلْحَفَۃٍ مَصْبُوغَۃٍ بِالزَّعْفَرَانِ مُشْبَعۃٍ ، فَقُلْتُ : أُحْرِمُ فِی ہَذِہِ ؟ فَقَالَ : اغْسِلْہَا وَأَحْرِمْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 13285","","","كتاب الحج"
"13286","(۱۳۲۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِسْحَاقَ ، مَوْلَی آلِ عُمَرَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ أَنْ یُحْرِمَ فِی الثَّوْبِ الْمَصْبُوغِ بِالزَّعْفَرَانِ ، إذَا غَسَلَہُ۔","","Musannaf Ibn Abi Shaybah 13286","","","كتاب الحج"
"13287","(۱۳۲۸۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یُحْرِمَ الرَّجُلُ فِی الثَّوْبِ قَدْ صُبِغَ بِالزَّعْفَرَانِ ، ثُمَّ غُسِلَ ، لَیْسَ لَہُ نَفْضٌ ، وَلاَ رَدْعٌ۔","","Musannaf Ibn Abi Shaybah 13287","","","كتاب الحج"
"13288","(۱۳۲۸۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الثَّوْبِ الْمَصْبُوغِ بِالْوَرْسِ وَالزَّعْفَرَانِ ، قَالَ : إذَا غُسِلَ ذَلِکَ مِنْہُ فَذَہَبَ لَمْ یَرَہُ شَیْئًا أَنْ یَلْبَسَہُ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 13288","","","كتاب الحج"
"13289","(۱۳۲۸۹) حدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13289","","","كتاب الحج"
"13290","(۱۳۲۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : اغْسِلْہُ وَأَحْرِمْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 13290","","","كتاب الحج"
"13291","(۱۳۲۹۱) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ؛ أَنَّ عَبْدَ اللہِ بْنَ عُرْوَۃَ سَأَلَ عُرْوَۃَ عَنِ الثَّوْبِ الْمَصْبُوغِ ، إِذَا غُسِلَ حَتَّی یَذْہَبَ لَوْنُہُ ؟ فنہاہ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 13291","","","كتاب الحج"
"13292","(۱۳۲۹۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ قَالَتْ : یُکْرَہُ لِلْمُحْرِمِ الثَّوْبُ الْمَصْبُوغُ بِالزَّعْفَرَانِ ، وَالْمُشْبَعَۃُ بِالْعُصْفُرِ لِلرِّجَالِ وَالنِّسَائِ ، إِلاَّ أَنْ یَکُونَ ثَوْبًا غَسِیلاً۔","","Musannaf Ibn Abi Shaybah 13292","","","كتاب الحج"
"13293","(۱۳۲۹۳) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا غُسِلَ الثَّوْبُ الْمَصْبُوغُ ، وَذَہَبَ رِیحُہُ ، قَالَ : لاَ بَأْسَ أَنْ یُحْرِمَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 13293","","","كتاب الحج"
"13294","(۱۳۲۹۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : سَأَلْتُُہُ عَنِ الْقَمْلَۃِ أَجِدُہَا عَلَی وَجْہِی وَأَنَا مُحْرِمٌ ؟ فَقَالَ : أَلْقِہَا عَنْ وَجْہِکَ ، فَلَیْسَ لَہَا فِیہِ نَصِیبٌ۔","","Musannaf Ibn Abi Shaybah 13294","","","كتاب الحج"
"13295","(۱۳۲۹۵) حدَّثَنَا حَفْصٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : جَائَتِ امْرَأَۃٌ إلَی ابْنِ عُمَرَ فَسَأَلَتْہُ ، فَقَالَتْ : إِنِّی وَجَدْتُ قَمْلَۃً فَأَلْقَیْتُہَا ، أَوْ قَتَلْتُہَا ؟ قَالَ : مَا الْقَمْلَۃُ مِنَ الصَّیْدِ۔","Sahih","Musannaf Ibn Abi Shaybah 13295","","","كتاب الحج"
"13296","(۱۳۲۹۶) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَجُلٌ لِعَطَائٍ : أَطْرَحُ الْقَمْلَۃَ تَدِبُّ عَلَیَّ ؟ قَالَ: نَعَمْ ، قَالَ : فَأَتَقَمَّلُ ؟ قَالَ : یُکْرَہُ أَنْ تُقَمِّلَ ثِیَابَکَ وَأَنْتَ مُحْرِمٌ ، قَالَ : قُلْتُ : الْقُرَادُ وَالْقَمْلَۃُ تَدِبُّ عَلَیَّ؟ قَالَ : انْبِذْ عَنْکَ مَا لَیْسَ مِنْکَ۔","","Musannaf Ibn Abi Shaybah 13296","","","كتاب الحج"
"13297","(۱۳۲۹۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سُئِلَ عِکْرِمَۃُ بْنُ خَالِدٍ الْمَخْزُومِیُّ عَنِ الْمُحْرِمِ یَرَی الْقَمْلَۃَ فِی ثَوْبِہِ ؟ قَالَ : یَأْخُذُہَا أَخْذًا رَفِیقًا ، فَیَضَعُہَا عَلَی الأَرْضِ وَلاَ یَتَفَلَّی۔","","Musannaf Ibn Abi Shaybah 13297","","","كتاب الحج"
"13298","(۱۳۲۹۸) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ عَطَائٍ ، قَالَ : یُلْقِی الْمُحْرِمُ عنْہُ الْقَمْلَۃَ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 13298","","","كتاب الحج"
"13299","(۱۳۲۹۹) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : عَلِقَ بِی قُرَادٌ وَأَنَا مُحْرِمٌ ، فَقُلْتُ لِطَلْقِ بْنِ حَبِیبٍ ؟ فَقَالَ : اطْرَحْہُ ، أَبعدَ اللہُ الْقُرَادَ۔","","Musannaf Ibn Abi Shaybah 13299","","","كتاب الحج"
"13300","(۱۳۳۰۰) حدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : طَافَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْبَیْتِ فِی حَجَّۃِ الْوَدَاعِ عَلَی رَاحِلَتِہِ ، یَسْتَلِمُ الْحَجَرَ بِمِحْجَنِہِ۔ (مسلم ۲۵۵۔ ابوداؤد ۱۸۷۵)","Hasan","Musannaf Ibn Abi Shaybah 13300","","","كتاب الحج"
"13301","(۱۳۳۰۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَافَ بِالْبَیْتِ عَلَی بَعِیرٍ ، فَکَانَ إذَا أَتَی عَلَی الْحَجَرِ الأَسْوَد أَشَارَ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 13301","","","كتاب الحج"
"13302","(۱۳۳۰۲) حدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ أُمَّ سَلَمَۃَ قَالَتْ : یَا رَسُولَ اللہِ ، مَا طُفْتُ طَوَافَ الْخُرُوجِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا أُقِیمَتِ الصَّلاَۃُ فَطُوفِی عَلَی بَعِیرِکَ مِنْ وَرَائِ النَّاسِ۔n(بخاری ۱۶۱۹۔ ابوداؤد ۱۸۷۷)","","Musannaf Ibn Abi Shaybah 13302","","","كتاب الحج"
"13303","(۱۳۳۰۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَدِ اشْتَکَی ، فَطَافَ بِالْبَیْتِ عَلَی بَعِیرٍ وَمَعَہُ مِحْجَنٌ ، کُلَّمَا مَرَّ عَلَی الْحَجَرِ اسْتَلَمَہُ ، فَلَمَّا فَرَغَ مِنْ طَوَافِہِ أَنَاخَ ، ثُمَّ صَلَّی رَکْعَتَیْنِ۔ (بخاری ۱۶۱۲۔ ابوداؤد ۱۸۷۲)","Da'if","Musannaf Ibn Abi Shaybah 13303","","","كتاب الحج"
"13304","(۱۳۳۰۴) حدَّثَنَا وَکِیعٌ ، عَنْ مَعْرُوفٍ الْمَکِّیِّ ، قَالَ : سَمِعْتُ أَبَا الطُّفَیْلِ وَأَنَا غُلاَمٌ یَقُول : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَطُوفُ بِالْبَیْتِ عَلَی رَاحِلَتِہِ۔ (مسلم ۹۲۷۔ ابوداؤد ۱۸۷۴)","Hasan","Musannaf Ibn Abi Shaybah 13304","","","كتاب الحج"
"13305","(۱۳۳۰۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَافَ بِالْبَیْتِ عَلَی رَاحِلَتِہِ ، یَسْتَلِمُ الْحَجَرَ بِمِحْجَنِہِ ، وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَقُلْتُ لِعَطَائٍ: مَا أَرَادَ إلَی ذَلِکَ؟ قَالَ: التَّوْسِعَۃَ عَلَی أُمَّتِہِ۔","","Musannaf Ibn Abi Shaybah 13305","","","كتاب الحج"
"13306","(۱۳۳۰۶) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی إِذَا رَآہُمْ یَطُوفُونَ بِالْبَیْتِ عَلَی الدَّوَابِّ نَہَاہُمْ۔","","Musannaf Ibn Abi Shaybah 13306","","","كتاب الحج"
"13307","(۱۳۳۰۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَعَی عَلَی رَاحِلَتِہِ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 13307","","","كتاب الحج"
"13308","(۱۳۳۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ قَیْسِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی إدْرِیسَ ، قَالَ : رَأَیْتُ عَائِشَۃَ تَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ عَلَی بَغْلٍ۔","Hasan","Musannaf Ibn Abi Shaybah 13308","","","كتاب الحج"
"13309","(۱۳۳۰۹) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَحْوَصِ ، قَالَ : رَأَیْتُ أَنَسًا یَطُوفُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ عَلَی حِمَارٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13309","","","كتاب الحج"
"13310","(۱۳۳۱۰) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الرَّبِیعِ بْنِ سَعد ، قَالَ ، سَأَلْتُ أَبَا جَعْفَرٍ عَنِ الطَّوَافِ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ؟ فَقَالَ : طَافَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَاکِبًا وَأَنَا أَطُوفُ رَاکِبًا ، فَطُفْتُ أَنَا وَہُوَ رَاکِبَیْنِ۔","","Musannaf Ibn Abi Shaybah 13310","","","كتاب الحج"
"13311","(۱۳۳۱۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ رُکُوبَ الرِّجَالِ وَالنِّسَائِ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، إِلاَّ مِنْ عُذْرٍ۔","","Musannaf Ibn Abi Shaybah 13311","","","كتاب الحج"
"13312","(۱۳۳۱۲) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ خَارِجَۃَ بْنِ الْحَارِثِ ، قَالَ : رَأَیْتُ عِرَاکَ بْنَ مَالِکٍ یَطُوفُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ عَلَی حِمَارٍ۔","","Musannaf Ibn Abi Shaybah 13312","","","كتاب الحج"
"13313","(۱۳۳۱۳) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ یَزِیدَ الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ مُجَاہِدًا ، وَعَطَائً یَسْعَیَانِ بَیْنَ الصَّفَا وَالْمَرْوَۃِ عَلَی دَابَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 13313","","","كتاب الحج"
"13314","(۱۳۳۱۴) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی إذَا رَآہُمْ وَ ہُمْ یَسْعَوْنَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ رُکْبَانًا ، قَالَ : قَدْ خَابَ ہَؤُلاَئِ وَخَسِرُوا۔","","Musannaf Ibn Abi Shaybah 13314","","","كتاب الحج"
"13315","(۱۳۳۱۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کان یَکْرَہُ الرُّکُوبَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ إِلاَّ مِنْ ضَرُورَۃٍ۔","","Musannaf Ibn Abi Shaybah 13315","","","كتاب الحج"
"13316","(۱۳۳۱۶) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی یَعْفُورٍ ، قَالَ : خَطَبَنَا رَجُلٌ مِنْ خُزَاعَۃَ ، کَانَ أَمِیرًا عَلَی الْحَجِّ بِمَکَّۃَ ، فَقَالَ : أَیُّہَا النَّاسُ ، إِنَّ عُمَرَ کَانَ رَجُلاً شَدِیدًا ، وَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ : یَا عُمَرُ ، إنَّکَ رَجُلٌ شَدِیدٌ تُؤْذِی الضَّعِیفَ ، فَإِذَا طُفْتَ بِالْبَیْتِ فَرَأَیْتَ مِنَ الْحَجَرِ خَلْوَۃً فَادْنُ مِنْہُ ، وَإِلاَّ فَکَبِّرْ وَہَلِّلْ وَامْضِ۔ (احمد ۱/۲۸۔ بیہقی ۸۰)","Da'if","Musannaf Ibn Abi Shaybah 13316","","","كتاب الحج"
"13317","(۱۳۳۱۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا حَاذَیْتَ بِہِ ، فَکَبِّرْ وَادْعُ وَصَلِّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 13317","","","كتاب الحج"
"13318","(۱۳۳۱۸) حدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ یَطُوفُ بِالْبَیْتِ ، حَتَّی إذَا حَاذَی بِالْحَجَرِ نَظَرَ إلَیْہِ وَالْتَفَتَ إلَیْہِ ، فَکَبَّرَ نَحْوَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13318","","","كتاب الحج"
"13319","(۱۳۳۱۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ أَنَسًا یَسْتَقْبِلُ الأَرْکَانَ بِالتَّکْبِیرِ۔","Sahih","Musannaf Ibn Abi Shaybah 13319","","","كتاب الحج"
"13320","(۱۳۳۲۰) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی إذَا غُلِبَ اسْتَقْبَلَہُ وَکَبَّرَ وَمَضَی۔","","Musannaf Ibn Abi Shaybah 13320","","","كتاب الحج"
"13321","(۱۳۳۲۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ حِینَ اسْتَفْتَحَ الطَّوَافَ اسْتَقْبَلَ الْحَجَرَ وَلَمْ یَمَسَّہُ ، وَرَفَعَ یَدَیْہِ وَکَبَّرَ ، فَسَأَلْتُ عَطَائً ؟ فَقَالَ : کَبِّرْ ، وَلاَ تَرْفَعْ یَدَیْکَ بِالتَّکْبِیرِ۔","","Musannaf Ibn Abi Shaybah 13321","","","كتاب الحج"
"13322","(۱۳۳۲۲) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ برْجَان ، قَالَ : رَأَیْتُ مُجَاہِدًا إذَا مَرَّ بِالْحَجَرِ نَظَرَ إلَیْہِ فَکَبَّرَ۔","","Musannaf Ibn Abi Shaybah 13322","","","كتاب الحج"
"13323","(۱۳۳۲۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، وَوَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ : قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ : مَا صَنَعْتَ ؟ قَالَ : اسْتَلَمْتُ وَتَرَکْتُ ، قَالَ : أَصَبْتَ۔ (حاکم ۳۰۷۔ ابن حبان ۳۸۲۳)","","Musannaf Ibn Abi Shaybah 13323","","","كتاب الحج"
"13324","(۱۳۳۲۴) حدَّثَنَا وَکِیعٌ، عَنْ طَلْحَۃَ بْنِ یَحْیَی، عَنِ الْقَاسِمِ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ زَاحَمَ عَلَی الْحَجَرِ حَتَّی دَمِیَ مَنْخِرُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 13324","","","كتاب الحج"
"13325","(۱۳۳۲۵) حدَّثَنَا عَلِیُّ بْنُ مُسْہِ[corrupt]ٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : طُفْتُ مَعَہُ ، فَکَانَ لاَ یُزَاحِمُ عَلَی الْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 13325","","","كتاب الحج"
"13326","(۱۳۳۲۶) حدَّثَنَا أَبُو سَعدٍ مُحَمَّدُ بْنُ مُیَسَّر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا کَانَ عَلَی الْحَجَرِ زِحَامٌ ، فَلاَ تُؤْذِیَنَّ وَلا تُؤْذَیَنَّ ، وَابْعُدْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13326","","","كتاب الحج"
"13327","(۱۳۳۲۷) حدَّثَنَا وَکِیعٌ ، عَنِ الْمُخْتَارِ بن عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : لاَ یُزَاحَمُ عَلَی الْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 13327","","","كتاب الحج"
"13328","(۱۳۳۲۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ یَکْرَہُ أَنْ تُزَاحِمَ عَلَی الْحَجَرِ، تُؤْذِی مُسْلِمًا ، أَوْ یُؤْذِیکَ۔","","Musannaf Ibn Abi Shaybah 13328","","","كتاب الحج"
"13329","(۱۳۳۲۹) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ ، وَمُحَمَّدِ بْنِ عَلِیٍّ ، وَسَالِمٍ ، وَالْقَاسِمِ ؛ أَنَّہُمْ لَمْ یَکُونُوا یُزَاحِمُونَ عَلَی الْحَجَرِ ، وَکَانُوا یُقِیمُونَ سَاعَۃً مُسْتَقْبَلَہ۔","","Musannaf Ibn Abi Shaybah 13329","","","كتاب الحج"
"13330","(۱۳۳۳۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَعْدِ بْنِ عُبَیْدٍ الطَّائِیِّ ، قَالَ : رَأَیْتُ الْحَسَنَ أَتَی الْحَجَرَ فَرَأَی زِحَامًا فَلَمْ یَسْتَلِمْہُ ، فَدَعَا ، ثُمَّ أَتَی الْمَقَامَ فَصَلَّی عِنْدَہُ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 13330","","","كتاب الحج"
"13331","(۱۳۳۳۱) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَوَّامِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَسْتَلِمُہُ وَلاَ یُزَاحِمُ علیہ ، وَکَانَ ابْنُ عُمَرَ یَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13331","","","كتاب الحج"
"13332","(۱۳۳۳۲) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، وَحَجَّاجٍ ، وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ: یَا أَیُّہَا النَّاسُ ، إنَّ دُخُولَکُمُ الْبَیْتَ لَیْسَ مِنْ حَجِّکُمْ فِی شَیْئٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13332","","","كتاب الحج"
"13333","(۱۳۳۳۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الْحَاجِّ ، قَالَ : إِنْ شَائَ دَخَلَ الْکَعْبَۃَ ، وَإِنْ شَائَ لَمْ یَدْخُلْہَا، وَقَالَ : إِنْ دَخَلَہَا فَحَسَنٌ ، وَإِنْ لَمْ یَدْخُلْہَا فَلاَ بَأْسَ ، وَإِنْ دَخَلْتَہَا فَتَیَامِن إلَی السَّارِیَۃِ الْوُسْطَی فَصَلِّ عِنْدَہَا۔","","Musannaf Ibn Abi Shaybah 13333","","","كتاب الحج"
"13334","(۱۳۳۳۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، عَنْ خَیْثَمَۃَ ؛ أَنَّہُ سُئِلَ عَنْ دُخُولِ الْبَیْتِ ؟ فَقَالَ : لاَ یَضُرُّک وَاللَّہِ أَنْ لاَ تَدْخُلَہُ۔","","Musannaf Ibn Abi Shaybah 13334","","","كتاب الحج"
"13335","(۱۳۳۳۵) حدَّثَنَا وَکِیعٌ ، عَنْ وَاقِدٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ شِئْتَ فَلاَ تَدْخُلْہُ۔","","Musannaf Ibn Abi Shaybah 13335","","","كتاب الحج"
"13336","(۱۳۳۳۶) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنْ دَخَلَ الْبَیْتَ دَخَلَ فِی حَسَنَۃٍ ، وَخَرَجَ مِنْ سَیِّئَۃٍ ، وَخَرَجَ مَغْفُورًا لَہُ۔","","Musannaf Ibn Abi Shaybah 13336","","","كتاب الحج"
"13337","(۱۳۳۳۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : حَاضَتْ صَفِیَّۃُ بَعْدَ مَا أَفَاضَتْ، فَأُخْبِرَ بِذَلِکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَحَابِسَتُنَا ہِیَ ؟ قُلْتُ : قَدْ طَافَتْ ثُمَّ حَاضَتْ بَعْدَ ذَلِکَ ، قَالَ : فَلْتَنْفِرْ۔ (مسلم ۳۸۳۔ ابوداؤد ۱۹۹۶)","Sahih","Musannaf Ibn Abi Shaybah 13337","","","كتاب الحج"
"13338","(۱۳۳۳۸) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ بِمِثْلِہِ ، إِلاَّ أَنَّہُ قَالَ : فَلاَ إِذَنْ۔n(بخاری ۱۷۵۷۔ مسلم ۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 13338","","","كتاب الحج"
"13339","(۱۳۳۳۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عَائِشَۃَ قَالَتْ : ذَکَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَفِیَّۃَ فَقُلْنَا : إِنَّہَا قَدْ حَاضَتْ ، فَقَالَ : عَقْرَی حَلْقَی ، مَا أُرَاہَا إِلاَّ حَابِسَتَنَا قَالَتْ: قُلْتُ : إِنَّہَا قَدْ طَافَتْ یَوْمَ النَّحْرِ ، قَالَ : فَلاَ إِذَنْ ، مُرُوہَا فَلْتَنْفِرْ۔ (مسلم ۹۶۵۔ نسائی ۴۱۸۹)","Sahih","Musannaf Ibn Abi Shaybah 13339","","","كتاب الحج"
"13340","(۱۳۳۴۰) حدَّثَنَا جَرِیرٌ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : سَأَلْتُ القَاسِمَ بْنَ مُحَمَّدٍ ، عَنِ امْرَأَۃٍ زَارَتِ الْبَیْتَ یَوْمَ النَّحْرِ ، ثُمَّ حَاضَتْ قَبْلَ النَّفْرِ ؟ فَقَالَ : یَرْحَمُ اللَّہُ عُمَرَ ، کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُونَ : قَدْ فَرَغَتْ إِلاَّ عُمَرَ ، فَإِنَّہُ کَانَ یَقُولُ : یَکُونُ آخِرَ عَہْدِہَا بِالْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 13340","","","كتاب الحج"
"13341","(۱۳۳۴۱) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : مَا رَأَیْتُ ابْنَ عَبَّاسٍ خَالَفَہُ أَحَدٌ فِی شَیْئٍ فَتَرَکَہُ ، حَتَّی یُقَرِّرَہُ ، فَخَالَفَہُ جَابِرُ بْنُ عَبْدِ اللہِ فِی الْمَرْأَۃِ تَطُوفُ ثُمَّ تَحِیضُ ، فَقَالَ ابْنُ عَبَّاسٍ : تَنْفِرُ ، فَأَرْسَلُوا إلَی امْرَأَۃٍ کَانَ أَصَابَہَا ذَلِکَ فَوَافَقَتِ ابْنَ عَبَّاسٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13341","","","كتاب الحج"
"13342","(۱۳۳۴۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ رَبِیعَۃَ ، قَالَ : سَأَلْتُ سَعْدَ بْنَ مَالِکٍ عَنِ امْرَأَۃٍ حَاضَتْ بَعْدَ الطَّوَافِ بِالْبَیْتِ یَوْمَ النَّحْرِ ؟ قَالَ : تَصْدُرُ۔","Da'if","Musannaf Ibn Abi Shaybah 13342","","","كتاب الحج"
"13343","(۱۳۳۴۳) حدَّثَنَا جَرِیرٌ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُقِیمُ عَلَی الْحَائِضِ ، إِنْ کَانَتْ طَافَتْ طَوَافَ یَوْمِ النَّحْرِ سَبْعَۃَ أَیَّامٍ ، حَتَّی تَطُوفَ طَوَافَ یَوْمِ النَّفْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 13343","","","كتاب الحج"
"13344","(۱۳۳۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ ہَانِیئٍ ؛ أَنَّ امْرَأَۃً طَافَتْ ثُمَّ حَاضَتْ یَوْمَ النَّحْرِ بَعْدَمَا طَافَتْ ، فَسُئِلَ الْحَسَنُ بْنُ عَلِیٍّ ؟ فَقَالَ : تَنْفِرُ۔","Da'if","Musannaf Ibn Abi Shaybah 13344","","","كتاب الحج"
"13345","(۱۳۳۴۵) حدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَارِثِ بْنِ عَبْدِ اللہِ بْنِ أَوْسٍ الثَّقَفِیِّ ، قَالَ : سَأَلْتُ عُمَرَ بْنَ الْخَطَّابِ عَنِ الْمَرْأَۃِ تَطُوفُ بِالْبَیْتِ ثُمَّ تَحِیضُ ؟ فَقَالَ : لِیَکُنْ آخِرُ عَہْدِہَا بِالْبَیْتِ ، فَقَالَ الْحَارِثُ : کَذَلِکَ أَفْتَانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ عُمَرُ : أُرِبْتَ عَنْ یَدَیْکَ ، سَأَلْتنِی عَنْ شَیْئٍ سَأَلْتَ عَنْہُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، کَیْمَا أُخَالِفَہُ۔n(ترمذی ۹۴۶۔ ابوداؤد ۱۹۹۷)","Sahih","Musannaf Ibn Abi Shaybah 13345","","","كتاب الحج"
"13346","(۱۳۳۴۶) حدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ الْیُحْمِدِیُّ ، عَنْ صَالِحٍ الدَّہَّانِ ، قَالَ : قَالَ جَابِرُ بْنُ زَیْدٍ : الصَّوْمُ وَالصَّلاَۃُ یُجْہِدَانِ الْبَدَنَ ، وَلاَ یُجْہِدَانِ الْمَالَ ، وَالصَّدَقَۃُ تُجْہِدُ الْمَالَ ، وَلاَ تُجْہِدُ الْبَدَنَ ، وَإِنِّی لاَ أَعْلَمُ شَیْئًا أَجْہَدَ لِلْمَالِ وَالْبَدَنِ مِنْ ہَذَا الْوَجْہِ ، یَعْنِی الْحَجَّ۔","","Musannaf Ibn Abi Shaybah 13346","","","كتاب الحج"
"13347","(۱۳۳۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مِسْکِینٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَرَوْنَ أَنَّـہُ إِذَا حَجَّ مِرَارًا ، أَنَّ الصَّدَقَۃَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 13347","","","كتاب الحج"
"13348","(۱۳۳۴۸) حدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَأَلْتُ الْحَجَّاجَ عَنْ رَجُلٍ ق[corrupt]ضَی مَنَاسِکَ الْحَجِّ ، أَیَحُجُّ ، أَوْ یُعْتِقُ ؟ قَالَ : لاَ ، بَلْ یُعْتِقُ۔","","Musannaf Ibn Abi Shaybah 13348","","","كتاب الحج"
"13349","(۱۳۳۴۹) حدَّثَنَا وَہْبُ بْنُ إسْمَاعِیلَ الأَسَدِیُّ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ الطَّائِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَہُ بَعْضُ جِیرَانِہِ ، فَقَالَ : إنِّی قَدْ تَہَیَّأْتُ لِلْخُرُوجِ ، وَلِی جِیرَانٌ مُحْتَاجُونَ مُتَعَفِّفُونَ ، فَمَا تَرَی لِی ؟ أَجْعَلُ کِرَائِی وَجَہَازِی فِیہِمْ ، أَوْ أَمْضِی لِوَجْہِی لِلْحَجِّ ؟ فَقَالَ : وَاللَّہِ ، إِنَّ الصَّدَقَۃَ لَعَظِیمٌ أَجْرُہَا ، وَمَا یَعْدِلُ عِنْدِی مَوْقِفٌ مِنَ تِلْکَ الْمَوَاقِفِ شَیْئًا مِنَ الأَشْیَائِ۔","","Musannaf Ibn Abi Shaybah 13349","","","كتاب الحج"
"13350","(۱۳۳۵۰) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : مَا أَنْفَقَ النَّاسُ مِنْ نَفَقَۃٍ أَعْظَمَ أَجْرًا مِنْ دَمٍ یُہَرَاقُ یَوْمَ النَّحْرِ ، إِلاَّ رَحِمٌ مُحْتَاجَۃٌ یَصِلُہَا۔","","Musannaf Ibn Abi Shaybah 13350","","","كتاب الحج"
"13351","(۱۳۳۵۱) حدَّثَنَا الْمُحَارِبی ، عَنْ لَیْثٍ ، عَنْ حَبِیبٍ ، عَنْ حُسَیْنِ بْنِ عَلِیٍّ ، قَالَ : لأَنْ أَقُوتَ أَہْلَ بَیْتٍ بِالْمَدِینَۃِ صَاعًا کُلَّ یَوْمٍ ، أَوْ صَاعَیْنِ شَہْرًا ، أَحَبُّ إلَیَّ مِنْ حَجَّۃٍ فِی إثْرِ حَجَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13351","","","كتاب الحج"
"13352","(۱۳۳۵۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : مَا عَمِلَ النَّاسُ بَعْدَ الْفَرِیضَۃِ أَحَبُّ إلَیَّ مِنْ إطْعَامِ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 13352","","","كتاب الحج"
"13353","(۱۳۳۵۳) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ (ح) وَعَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُعَاذِ بْنِ سَعْوَۃَ ، عَنْ سِنَانِ بْنِ سَلَمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْہَدْیُ التَّطَوُّعُ لاَ یُؤْکَلُ مِنْہُ ، فَإِنْ أَکَلَ غَرِمَ۔ (احمد ۷)","Da'if","Musannaf Ibn Abi Shaybah 13353","","","كتاب الحج"
"13354","(۱۳۳۵۴) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ ذَکْوَانَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ قَالاَ : إِنْ أَکَلَ مِنْہُ غَرِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 13354","","","كتاب الحج"
"13355","(۱۳۳۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُمَرَ ، قَالَ : مَنْ أَہْدَی ہَدْیًا تَطَوُّعًا ، فَعَطِبَ نَحَرَہُ دُونَ الْحَرَمِ ، وَلَمْ یَأْکُلْ مِنْہُ ، فَإِنْ أَکَلَ فَعَلَیْہِ الْبَدَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 13355","","","كتاب الحج"
"13356","(۱۳۳۵۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : بَعَثَ مَعِی عَبْدُ اللہِ بِہَدْیِہِ ، قَالَ : وَأَمَرَنِی إِذَا نَحَرْتُہُ أَنْ أَتَصَدَّقَ بِثُلُثٍ ، وَآکُلَ ثُلُثًا ، وَأَبْعَثَ إلَی أَہْلِ أَخِیہِ عُتْبَۃ بِثُلُثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13356","","","كتاب الحج"
"13357","(۱۳۳۵۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الْبَدَنَۃِ لَیْسَ عَلَیْہِ شَیْئٌ فِی التَّطَوُّعِ ، إِلاَّ أَنْ یَأْمُرَ فِیہَا بِأَمْرٍ ، أَوْ یَأْکُلَ ، أَوْ یُطْعِمَ ، فَإِنْ فَعَلَ أَبْدَلَ۔","","Musannaf Ibn Abi Shaybah 13357","","","كتاب الحج"
"13358","(۱۳۳۵۸) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : إذَا أَکَلْتَ مِنْ ہَدْیِ التَّطَوُّعِ غَرِمْتَ۔","","Musannaf Ibn Abi Shaybah 13358","","","كتاب الحج"
"13359","(۱۳۳۵۹) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، قَالَ : کَانَ مَعِی ہَدْیٌ صَدَقَۃٌ لِلْمَسَاکِینِ ، فَأَمَرَنِی أَنْ آکُلَ مِنْہُ وَأَدَّخِرَ۔","","Musannaf Ibn Abi Shaybah 13359","","","كتاب الحج"
"13360","(۱۳۳۶۰) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یَأْکُلُونَ مِنْ شَیْئٍ جَعَلُوہُ لِلَّہِ ، ثُمَّ رُخِّصَ لَہُمْ أَنْ یَأْکُلُوا مِنَ الْہَدْیِ وَالأَضَاحِیِّ وَأَشْبَاہِہِ۔","","Musannaf Ibn Abi Shaybah 13360","","","كتاب الحج"
"13361","(۱۳۳۶۱) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوسٍ ، وَمُجَاہِدٍ ؛ أَنَّہُمْ قَالُوا : لاَ یُؤْکَلُ مِنَ الْفِدْیَۃِ ، وَلاَ مِنْ جَزَائِ الصَّیْدِ۔","","Musannaf Ibn Abi Shaybah 13361","","","كتاب الحج"
"13362","(۱۳۳۶۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : إذَا عَطِبَتِ الْبَدَنَۃُ ، أَوْ کُسِرَتْ أَکَلَ مِنْہَا صَاحِبُہَا وَأَطْعَمَ ، وَلَمْ یُبَدِّلْہَا ، إِلاَّ أَنْ تَکُونَ نَذْرًا ، أَوْ جَزَائَ صَیْدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13362","","","كتاب الحج"
"13363","(۱۳۳۶۳) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : مَا کَانَ مِنْ جَزَائِ صَیْدٍ ، أَوْ نُسُکٍ ، أَوْ نَذْرٍ لِلْمَسَاکِینِ ، فَإِنَّہُ لاَ یَأْکُلُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13363","","","كتاب الحج"
"13364","(۱۳۳۶۴) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَأْکُلُ مِنْ جَزَائِ الصَّیْدِ۔","","Musannaf Ibn Abi Shaybah 13364","","","كتاب الحج"
"13365","(۱۳۳۶۵) حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ یُؤْکَلُ مِنَ النَّذْرِ ، وَلاَ مِنَ الْکَفَّارَۃِ ، وَلاَ مِمَّا جُعِلَ لِلْمَسَاکِینِ۔","","Musannaf Ibn Abi Shaybah 13365","","","كتاب الحج"
"13366","(۱۳۳۶۶) حدَّثَنَا شَرِیکٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ : لاَ یُؤْکَلُ مِنَ النَّذْرِ ، وَلاَ مِنْ جَزَائِ الصَّیْدِ ، وَلاَ مِمَّا جُعِلَ لِلْمَسَاکِینِ۔","Da'if","Musannaf Ibn Abi Shaybah 13366","","","كتاب الحج"
"13367","(۱۳۳۶۷) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَأْکُلُ مِنْ جَزَائِ الصَّیْدِ۔","Sahih","Musannaf Ibn Abi Shaybah 13367","","","كتاب الحج"
"13368","(۱۳۳۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی حَسَّانَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشْعَرَ الْہَدْیَ فِی السَّنَامِ الأَیْمَنِ ، مَاطَ عَنْہُ الدَّمَ۔ (مسلم ۲۰۵۔ ترمذی ۹۰۶)","Sahih","Musannaf Ibn Abi Shaybah 13368","","","كتاب الحج"
"13369","(۱۳۳۶۹) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، وَمَرْوَانَ بْنِ الْحَکَمِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ الْحُدَیْبِیَۃِ قَلَّدَ الْہَدْیَ وَأَشْعَرَہُ۔ (بخاری ۱۶۹۴۔ احمد ۴/۳۲۳)","Sahih","Musannaf Ibn Abi Shaybah 13369","","","كتاب الحج"
"13370","(۱۳۳۷۰) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ قَالُوا : لَیْسَ الإِشْعَارُ بِوَاجِبٍ۔","","Musannaf Ibn Abi Shaybah 13370","","","كتاب الحج"
"13371","(۱۳۳۷۱) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ قَالُوا : أَشْعِرِ الْہَدْیَ إِنْ شِئْتَ ، وَإِنْ شِئْتَ فَلاَ تُشْعِرہُ۔","","Musannaf Ibn Abi Shaybah 13371","","","كتاب الحج"
"13372","(۱۳۳۷۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَد ، عَنْ عائِشَۃَ ؛ أَنَّہُ أَرْسَلَ إلَیْہَا أَیُشْعَرُ ، یَعْنِی الْبَدَنَۃَ ؟ فَقَالَتْ : إِنْ شِئْتَ ، إنَّمَا تُشْعَرُ لِیُعْلَمَ أَنَّہَا بَدَنَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 13372","","","كتاب الحج"
"13373","(۱۳۳۷۳) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ ہَدْیَ إِلاَّ مَا قُلِّدَ وَأُشْعِرَ وَوَقَفَ بِہِ بِعَرَفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 13373","","","كتاب الحج"
"13374","(۱۳۳۷۴) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَد أَنَّہُمَا قَالاَ : یُجَلِّلُ ، ثُمَّ یُشْعِرُ۔","","Musannaf Ibn Abi Shaybah 13374","","","كتاب الحج"
"13375","(۱۳۳۷۵) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشْعَرَ۔n(بخاری ۱۶۹۶۔ مسلم ۹۵۷)","Sahih","Musannaf Ibn Abi Shaybah 13375","","","كتاب الحج"
"13376","(۱۳۳۷۶) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الإِبِلُ تُقَلَّدُ وَتُشْعَرُ ، وَالْبَقَرُ تُقَلَّدُ وَلاَ تُشْعَرُ ، وَالْغَنَمُ لاَ تُقَلَّدُ وَلاَ تُشْعَرُ۔","","Musannaf Ibn Abi Shaybah 13376","","","كتاب الحج"
"13377","(۱۳۳۷۷) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنْ شِئْتَ فَأَشْعِرِ الْہَدْیَ ، وَإِنْ شِئْتَ فَلاَ تُشْعِرْ ۔","Sahih","Musannaf Ibn Abi Shaybah 13377","","","كتاب الحج"
"13378","(۱۳۳۷۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ عَطَائٍ (ح) وَیُوسُفَ بْنِ مَاہَکٍ ، وَمَنْصُورٍ ، عَنْ عَطَائٍ ؛ أَنَّ رَجُلاً أَغْلَقَ بَابَہُ عَلَی حَمَامَۃٍ وَفَرْخَیْہَا ، ثُمَّ انْطَلَقَ إلَی عَرَفَاتٍ وَمِنًی ، فَرَجَعَ وَقَدْ مُوِّتَتْ ، فَأَتَی ابْنَ عُمَرَ فَذَکَرَ ذَلِکَ لَہُ ، فَجَعَلَ عَلَیْہِ ثَلاَثًا مِنَ الْغَنَمِ ، وَحَکَمَ مَعَہُ رَجُلٌ۔","","Musannaf Ibn Abi Shaybah 13378","","","كتاب الحج"
"13379","(۱۳۳۷۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : نَزَلْنَا مَنْزِلاً ، فَأَغْلَقْنَا بَابَ الْمَنْزِلِ عَلَی حَمَامَۃٍ فَمَاتَتْ ، فَسَأَلْنَا عَطَائً ؟ فَقَالَ : فِیہَا شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13379","","","كتاب الحج"
"13380","(۱۳۳۸۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : عَلَیْہِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13380","","","كتاب الحج"
"13381","(۱۳۳۸۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : مَنْ قَتَلَ حَمَامَۃً مِنْ حَمَامِ مَکَّۃَ فَعَلَیْہِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13381","","","كتاب الحج"
"13382","(۱۳۳۸۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : عَلَیْہِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13382","","","كتاب الحج"
"13383","(۱۳۳۸۳) حدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ مُحْرِزٍ ، قَالَ : أَغْلَقْتُ بَابِی بِمَکَّۃَ ثُمَّ فَتَحْتُہُ ، فَإِذَا طَیْرَانِ قَدْ مَاتَا ، فَسَأَلْتُ طَاوُوسًا ؟ فَقَالَ : اذْبَحْ شَاتَیْنِ۔","","Musannaf Ibn Abi Shaybah 13383","","","كتاب الحج"
"13384","(۱۳۳۸۴) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی طَیْرِ الْحَرَمِ : شَاۃٌ شَاۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 13384","","","كتاب الحج"
"13385","(۱۳۳۸۵) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ؛ فِی الدّبْسِیِّ وَالْقُمْرِیِّ وَالأَخْضَرِ : شَاۃٌ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13385","","","كتاب الحج"
"13386","(۱۳۳۸۶) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ شَیْخٍ مِنْ أَہْلِ مَکَّۃَ ؛ أَنَّ حَمَامًا کَانَ عَلَی الْبَیْتِ ، فَخَرَّ عَلَی یَدِ عُمَرَ ، فَأَشَارَ بِیَدِہِ ، فَطَارَ فَوَقَعَ عَلَی بَعْضِ بُیُوتِ أَہْلِ مَکَّۃَ ، فَجَائَتْ حَیَّۃٌ فَأَکَلَتْہُ ، فَحَکَمَ عُمَرُ عَلَی نَفْسِہِ شَاۃً۔","Da'if","Musannaf Ibn Abi Shaybah 13386","","","كتاب الحج"
"13387","(۱۳۳۸۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، عَنْ صَالِحِ بْنِ الْمَہْدِیِّ ، أَنَّ أَبَاہُ أَخْبَرَہُ ، قَالَ : حجَجْتُ مَعَ عُثْمَانَ فَقَدِمْنَا بِمَکَّۃَ ، فَفَرَشْتُ لَہُ فِی بَیْتٍ فَرَقَدَ ، فَجَائَتْ حَمَامَۃٌ فَوَقَعَتْ فِی کُوَّۃٍ عَلَی فِرَاشِہِ ، فَجَعَلَتْ تَبْحَثُ بِرِجْلَیْہَا ، فَخَشِیتُ أَنْ تَنْثُرَ عَلَی فِرَاشِہِ فَیَسْتَیْقِظَ ، فَأَطَرْتُہَا فَوَقَعَتْ فِی کُوَّۃٍ أُخْرَی ، فَخَرَجَتْ حَیَّۃٌ فَقَتَلَتْہَا ، فَلَمَّا اسْتَیْقَظَ عُثْمَانُ أَخْبَرْتُہُ ، فَقَالَ : أَدِّ عَنْکَ شَاۃً ، فَقُلْتُ : إنَّمَا أَطَرْتُہَا مِنْ أَجْلِکَ ، قَالَ : وَعَنِّی شَاۃً۔","Da'if","Musannaf Ibn Abi Shaybah 13387","","","كتاب الحج"
"13388","(۱۳۳۸۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، قَالَ : أَوَّلُ مَنْ فَدَی طَیْرَ الْحَرَمِ بِشَاۃٍ عُثْمَانُ۔","Da'if","Musannaf Ibn Abi Shaybah 13388","","","كتاب الحج"
"13389","(۱۳۳۸۹) حدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یَقُولُ فِی حَمَامِ الْحَرَمِ إذَا قُتِلَ بِمَکَّۃَ ، فَفِیہِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13389","","","كتاب الحج"
"13390","(۱۳۳۹۰) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالاَ : سَأَلْنَا إِبْرَاہِیمَ عَن رَجُلٍ أَخَذَ بِیَدِہِ فَرْخًا ، وَہُوَ مُحْرِمٌ ، فَأَرَادَ أَنْ یَرُدَّہُ فَمَاتَ ؟ فَقَالَ : ہُوَ ضَامِنٌ۔","","Musannaf Ibn Abi Shaybah 13390","","","كتاب الحج"
"13391","(۱۳۳۹۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ خُصَیْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : (لاَ رَفَثَ) الْجِمَاعُ (وَلاَ فُسُوقَ) الْمَعَاصِی (وَلاَ جِدَالَ فِی الْحَجِّ) قَالَ : تُمَارِی صَاحِبَک حَتَّی تُغْضِبَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 13391","","","كتاب الحج"
"13392","(۱۳۳۹۲) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ {وَلاَ جِدَالَ فِی الْحَجِّ} قَالَ : قدْ صَارَ الْحَجُّ فِی ذِی الْحِجَّۃِ لاَ شَہْرَ یُنْسَأُ ، وَلاَ شَکَّ فِی الْحَجِّ ، لأَنَّ أَہْلَ الْجَاہِلِیَّۃِ کَانُوا یُحِطُّونَ فَیَحُجُّونَ فِی غَیْرِ ذِی الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13392","","","كتاب الحج"
"13393","(۱۳۳۹۳) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : {لاَ جِدَالَ فِی الْحَجِّ} قَالَ : لَیْسَ لَکَ أَنْ تُمَارِیَ صَاحِبَک حَتَّی تُغْضِبَہُ۔","","Musannaf Ibn Abi Shaybah 13393","","","كتاب الحج"
"13394","(۱۳۳۹۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الرَّفَثُ إتْیَانُ النِّسَائِ ، وَالْفُسُوقُ السِّبَابُ ، وَالْجِدَالُ الْمُمَارَاۃُ أَنْ تُمَارِیَ صَاحِبَک۔","","Musannaf Ibn Abi Shaybah 13394","","","كتاب الحج"
"13395","(۱۳۳۹۵) حدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : الرَّفَثُ الْجِمَاعُ ، وَالْفُسُوقُ الْمَعَاصِی ، وَالْجِدَالُ أَنْ تُجَادِلَ صَاحِبَک حَتَّی تُغْضِبَہُ","","Musannaf Ibn Abi Shaybah 13395","","","كتاب الحج"
"13396","(۱۳۳۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ نَضْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ: الرَّفَثُ الْجِمَاعُ، وَالْفُسُوقُ الْمَعَاصِی، وَالْجِدَالُ الْمِرَائُ۔","","Musannaf Ibn Abi Shaybah 13396","","","كتاب الحج"
"13397","(۱۳۳۹۷) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ عَاصِمٍ، عَنْ بَکْرٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: الرَّفَثُ الْجِمَاعُ، وَلَکِنَّ اللَّہَ کَنَّی۔","Sahih","Musannaf Ibn Abi Shaybah 13397","","","كتاب الحج"
"13398","(۱۳۳۹۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الرَّفَثُ الْغِشْیَانُ ، وَالْفُسُوقُ السِّبَابُ ، وَالْجِدَالُ الاخْتِلاَفُ فِی الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13398","","","كتاب الحج"
"13399","(۱۳۳۹۹) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ وُہَیبٍ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ؛ أنَّہُ سَأَلَ عَطَائَ بْنَ یَسَارٍ عَنْ قَوْلِہِ : (فَلاَ رَفَثَ وَلاَ فُسُوقَ وَلاَ جِدَالَ فِی الْحَجِّ) ؟ قَالَ : الرَّفَثُ وِقَاعُ النِّسَائِ ، وَالْفُسُوقُ الْمَعَاصِی ، وَالْجِدَالُ السِّبَابُ۔","","Musannaf Ibn Abi Shaybah 13399","","","كتاب الحج"
"13400","(۱۳۴۰۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : الرَّفَثُ : الجماع ، وَالْفُسُوقُ الْمَعَاصِی ، وَالْجِدَالُ أَنْ تُجَادِلَ صَاحِبَک حَتَّی تُغْضِبَہُ وَیُغْضِبَک۔","","Musannaf Ibn Abi Shaybah 13400","","","كتاب الحج"
"13401","(۱۳۴۰۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ : (وَلاَ جِدَالَ فِی الْحَجِّ) قَالَ : قَدِ اسْتَقَامَ أَمْرُ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13401","","","كتاب الحج"
"13402","(۱۳۴۰۲) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، عَنِ النُّعْمَانِ بْنِ عَمْرِو بْنِ مُقَرِّنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سِبَابُ الْمُؤْمِنِ فُسُوقٌ ، وَقِتَالُہُ کُفْرٌ۔ (طبرانی ۸۰)","","Musannaf Ibn Abi Shaybah 13402","","","كتاب الحج"
"13403","(۱۳۴۰۳) حدَّثَنَا عَبیدَۃُ بْنِ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، عَنْ النُّعْمَانِ بْنِ عَمْرِو بْنِ مُقَرِّنٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 13403","","","كتاب الحج"
"13404","(۱۳۴۰۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شَرِیکٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الرَّفَثُ الْجِمَاعُ ، وَالْفُسُوقُ السِّبَابُ ، وَالْجِدَالُ الْمِرَائُ أَنْ تُمَارِیَ صَاحِبَک حَتَّی تُغْضِبَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 13404","","","كتاب الحج"
"13405","(۱۳۴۰۵) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الرَّفَثُ الْجِمَاعُ ، وَالْفُسُوقُ الْمَعَاصِی ، وَالْجِدَالُ الْمِرَائُ۔","","Musannaf Ibn Abi Shaybah 13405","","","كتاب الحج"
"13406","(۱۳۴۰۶) حدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ (فَلاَ رَفَثَ) قَالَ : جِمَاعُ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 13406","","","كتاب الحج"
"13407","(۱۳۴۰۷) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : حدَّثَنَا أَبُو عَمْرٍو الشَّیْبَانِیُّ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ مَسْعُودٍ یَقُولُ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: سِبَابُ الْمُؤْمِنِ فُسُوقٌ، وَقِتَالُہُ کُفْرٌ۔ (ابویعلی ۴۹۷۰)","Sahih","Musannaf Ibn Abi Shaybah 13407","","","كتاب الحج"
"13408","(۱۳۴۰۸) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِ حَدِیثِ مُعْتَمِرٍ۔ (بخاری ۴۸۔ مسلم ۱۱۶)","Sahih","Musannaf Ibn Abi Shaybah 13408","","","كتاب الحج"
"13409","(۱۳۴۰۹) حدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سِبَابُ الْمُؤْمِنِ فُسُوقٌ ، وَقِتَالُہُ کُفْرٌ۔ (نسائی ۳۵۶۷۔ احمد ۱/۱۷۸)","Da'if","Musannaf Ibn Abi Shaybah 13409","","","كتاب الحج"
"13410","(۱۳۴۱۰) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ بَابَاہُ ، عَنْ جُبَیْرِ بْنِ مُطْعِمٍ ، أنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : یَا بَنِی عَبْدِ مَنَافٍ لاَ تَمْنَعُوا أَحَدًا طَافَ بِہَذَا الْبَیْتِ وَصَلَّی ، أَیَّ سَاعَۃٍ مِنْ لَیْلٍ ، أَوْ نَہَارٍ۔ (ترمذی ۶۸۶۔ ابوداؤد ۱۸۸۹)","Sahih","Musannaf Ibn Abi Shaybah 13410","","","كتاب الحج"
"13411","(۱۳۴۱۱) حدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ، وَابْنَ عَبَّاسٍ طَافَا بَعْدَ الْعَصْرِ وَصَلَّیَا۔","Da'if","Musannaf Ibn Abi Shaybah 13411","","","كتاب الحج"
"13412","(۱۳۴۱۲) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ طَافَ بِالْبَیْتِ بَعْدَ الْفَجْرِ ، وَصَلَّی الرَّکْعَتَیْنِ قَبْلَ طُلُوعِ الشَّمْسِ۔","Sahih","Musannaf Ibn Abi Shaybah 13412","","","كتاب الحج"
"13413","(۱۳۴۱۳) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ أبی شُعْبَۃَ ؛ أَنَّہُ رَأَی الْحَسَنَ ، وَالْحُسَیْنَ قَدِمَا مَکَّۃَ ، فَطَافَا بِالْبَیْتِ بَعْدَ الْعَصْرِ وَصَلَّیَا۔","Da'if","Musannaf Ibn Abi Shaybah 13413","","","كتاب الحج"
"13414","(۱۳۴۱۴) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ التَّیْمِیُّ ، عَنْ لَیْثٍ ؛ أَنَّ الْحَسَنَ ، وَعَطَائً ، وَمُجَاہِدًا کَانُوا یَطُوفُونَ بِالْبَیْتِ بَعْدَ الْعَصْرِ ، وَیُصَلُّونَ فِی دُبُرِ طَوَافِہِمْ۔","","Musannaf Ibn Abi Shaybah 13414","","","كتاب الحج"
"13415","(۱۳۴۱۵) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ سُلَیْمِ بْنِ حَیَّانَ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ بْنَ خَالِدٍ عَنْہُ ؟ فَقَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 13415","","","كتاب الحج"
"13416","(۱۳۴۱۶) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا بِالطَّوَافِ بَعْدَ الْفَجْرِ وَبَعْدَ الْعَصْرِ وَالصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 13416","","","كتاب الحج"
"13417","(۱۳۴۱۷) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنْ أَبِی الطُّفَیْلِ ؛ أَنَّہُ کَانَ یَطُوفُ بِالْبَیْتِ بَعْدَ الْعَصْرِ ، وَیُصَلِّی حَتَّی تَصْفَرُّ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 13417","","","كتاب الحج"
"13418","(۱۳۴۱۸) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنِ الأَجْلَحِ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ ، وَابْنَ الزُّبَیْرِ طَافَا بِالْبَیْتِ بَعْدَ صَلاَۃِ الْفَجْرِ ، ثُمَّ صَلَّیَا رَکْعَتَیْنِ قَبْلَ طُلُوعِ الشَّمْسِ۔","Hasan","Musannaf Ibn Abi Shaybah 13418","","","كتاب الحج"
"13419","(۱۳۴۱۹) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : طُفْ وَصَلِّ بَعْدَ الْعَصْرِ وَبَعْدَ الْفَجْرِ مَا کُنْتَ فِی وَقْتٍ۔","","Musannaf Ibn Abi Shaybah 13419","","","كتاب الحج"
"13420","(۱۳۴۲۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ بْنِ عُرْوَۃَ بْنِ الزُّبَیْرِ ؛ أَنَّ ثَابِتَ بْنَ عَبْدِ اللہِ بْنِ الزُّبَیْرِ طَافَ بِالْبَیْتِ سَبْعًا بَعْدَ صَلاَۃِ الصُّبْحِ ، فَجَلَسَ وَلَمْ یُصَلِّ ، فَجَائَہُ أَبُوہُ عَبْدُ اللہِ بْنُ الزُّبَیْرِ ، فَقَالَ : یَا بُنَیَّ ، إِذَا کُنْتَ طَائِفًا فَصَلِّ ، وَإِنْ لَمْ تُصَلِّ فَلاَ تَطُفْ۔","Sahih","Musannaf Ibn Abi Shaybah 13420","","","كتاب الحج"
"13421","(۱۳۴۲۱) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إبْرَاہِیمَ بْنِ طَہْمَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ بَابَاہُ ، قَالَ : رَأَیْتُ أَبَا الدَّرْدَائِ طَافَ بَعْدَ الْعَصْرِ وَصَلَّی رَکْعَتَیْنِ ، فَقِیلَ لَہُ ؟ فَقَالَ : إِنَّہَا لَیْسَتْ کَسَائِرِہَا مِنَ الْبُلْدَانِ۔","","Musannaf Ibn Abi Shaybah 13421","","","كتاب الحج"
"13422","(۱۳۴۲۲) حدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ الْمِسْوَرُ بْنُ مَخْرَمَۃَ یَطُوفُ بَعْدَ الْغَدَاۃِ ثَلاَثَۃَ أَسَابِیعَ ، فَإِذَا طَلَعَتِ الشَّمْسُ صَلَّی لِکُلِّ سُبُوعٍ رَکْعَتَیْنِ ، وَبَعْدَ الْعَصْرِ یَفْعَلُ ذَلِکَ ، فَإِذَا غَابَتِ الشَّمْسُ صَلَّی لِکُلِّ سُبُوعٍ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 13422","","","كتاب الحج"
"13423","(۱۳۴۲۳) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَمُجَاہِدًا یَطُوفَانِ بِالْبَیْتِ حَتَّی تَصْفَارَّ الشَّمْسُ ، وَیَجْلِسَانِ۔","","Musannaf Ibn Abi Shaybah 13423","","","كتاب الحج"
"13424","(۱۳۴۲۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : إذَا أَرَدْتَ الطَّوَافَ بِالْبَیْتِ بَعْدَ صَلاَۃِ الْفَجْرِ ، أَوْ بَعْدَ صَلاَۃِ الْعَصْرِ فَطُفْ وَأَخِّرِ الصَّلاَۃَ حَتَّی تَغِیبَ الشَّمْسُ أَوْ حَتَّی تَطْلُعَ ، فَصَلِّ لِکُلِّ أُسْبُوعٍ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 13424","","","كتاب الحج"
"13425","(۱۳۴۲۵) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعدِ بْنِ إِبْرَاہِیمَ ، عَن نَصْرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جَدِّہِ مُعَاذٍ الْقُرَشِیِّ ؛ أَنَّہُ طَافَ بِالْبَیْتِ مَعَ مُعَاذِ بْنِ عَفْرَائَ بَعْدَ الْفَجْرِ وَبَعْدَ الْعَصْرِ فَلَمْ یُصَلِّ۔","Da'if","Musannaf Ibn Abi Shaybah 13425","","","كتاب الحج"
"13426","(۱۳۴۲۶) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : طَافَ عُمَرُ بْنُ الْخَطَّابِ بَعْدَ الْفَجْرِ ، ثُمَّ رَکِبَ حَتَّی إذَا أَتَی ذَاتَ طُوَی نَزَلَ ، فَلَمَّا طَلَعَتِ الشَّمْسُ وَارْتَفَعَتْ صَلَّی رَکْعَتَیْنِ ، ثُمَّ قَالَ : رَکْعَتَان مَکَانَ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 13426","","","كتاب الحج"
"13427","(۱۳۴۲۷) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْنَا الصُّبْحَ ثُمَّ جَلَسْنَا نَنْتَظِرُ بِالطَّوَافِ ، قَالَ : فَطَافَ أَبُو سَعِیدٍ الْخُدْرِیِّ ، ثُمَّ جَلَسَ وَلَمْ یُصَلِّ۔","Sahih","Musannaf Ibn Abi Shaybah 13427","","","كتاب الحج"
"13428","(۱۳۴۲۸) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رُبَّمَا أَخَذْتُ النَّمْلَۃَ بِعَرَفَۃَ قَدْ عَضَّتْ بَطْنِی ، فَأَقْطَعُ رَأْسَہَا وَیَبْقَی سَائِرُہَا فِی بَطْنِی۔","","Musannaf Ibn Abi Shaybah 13428","","","كتاب الحج"
"13429","(۱۳۴۲۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنِ الْوَلِیدِ الْبَجَلِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی مُحْرِمٍ أَصَابَ ذَرًّا کَثِیرًا ، قَالَ : یَتَصَدَّقُ۔","","Musannaf Ibn Abi Shaybah 13429","","","كتاب الحج"
"13430","(۱۳۴۳۰) حدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سُئِلَ عَطَائٌ عَنْ رَجُلٍ قَتَلَ ذَرًّا کَثِیرًا ، لاَ یَدْرِی مَا یُحَدِّدُہُ ، قَالَ: یَتَصَدَّقُ بِتَمْرٍ کَثِیرٍ۔","","Musannaf Ibn Abi Shaybah 13430","","","كتاب الحج"
"13431","(۱۳۴۳۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ طَاوُوسًا وَسَأَلَہُ رَجُلٌ ، قَالَ : أَہْلَلْتُ فَقَتَلْتُ ذَرًّا کَثِیرًا ؟ قَالَ : تَصَدَّقْ بِقَبَضَاتٍ مِنْ قَمْحٍ۔","","Musannaf Ibn Abi Shaybah 13431","","","كتاب الحج"
"13432","(۱۳۴۳۲) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ؛ فِی النَّمْلِ یَقْتُلُہُ الْمُحْرِمُ ؟ قَالَ : یُطْعِمُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 13432","","","كتاب الحج"
"13433","(۱۳۴۳۳) حدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : سَأَلْتُ طَاوُوسًا عَنْ قَتْلِ الذَّرِّ فِی الْحَرَمِ ؟ فَقَالَ : إذَا آذَاکَ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13433","","","كتاب الحج"
"13434","(۱۳۴۳۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ الْقَاسِمَ ، وَمُجَاہِدًا ، وَسَالِمًا ، وَعَطَائً ، وَطَاوُوسًا عَنِ النَّمْلِ وَالْجَنَادِبِ وَالْعِظَائِ ؟ فَقَالُوا : إِنْ کَانَ خَطَأً فَلَیْسَ عَلَیْہِ شَیْئٌ ، وَإِنْ کَانَ عَمْدًا فَفِیہِ کَفٌّ مِنْ طَعَامٍ ، وَقَالَ عَامِرٌ : ہُوَ کَفٌّ مِنْ طَعَامٍ خَطَأً کَانَ ، أَمْ عَمْدًا۔","","Musannaf Ibn Abi Shaybah 13434","","","كتاب الحج"
"13435","(۱۳۴۳۵) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، قَالَ : قُلْتُ: أَقْتُلُ الْبَعُوضَ ؟ قَالَ : وَمَا عَلَیْک ؟۔","Sahih","Musannaf Ibn Abi Shaybah 13435","","","كتاب الحج"
"13436","(۱۳۴۳۶) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ سَالِمًا قَتَلَ بَعُوضَۃً بِمَکَّۃَ ، فَقُلْتُ لَہُ؟ فَقَالَ : إِنَّہُ قَدْ أُمِرَ بِقَتْلِ الْحَیَّۃِ وَالْعَقْرَبِ ، قُلْتُ : إِنَّہُمَا عَدُوٌّ ، قَالَ : فَہَذِہِ عَدُوٌّ۔","","Musannaf Ibn Abi Shaybah 13436","","","كتاب الحج"
"13437","(۱۳۴۳۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَقْتُلَ الذُّبَابَ وَالْبَعُوضَ۔","","Musannaf Ibn Abi Shaybah 13437","","","كتاب الحج"
"13438","(۱۳۴۳۸) حدَّثَنَا جَرِیرٌ ، عَنْ مَرْزُوقٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی مُحْرِمٍ قَتَلَ ذُبَابًا ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 13438","","","كتاب الحج"
"13439","(۱۳۴۳۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ نُبَیْہ بْنِ وَہْبٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ، أَنَّہُ أَخْبَرَہُ ؛ أَنَّ عُثْمَانَ حَدَّثَ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ فِی الرَّجُلِ إذَا اشْتَکَی عَیْنُہُ وَہُوَ مُحْرِمٌ ، ضَمَّدَہُمَا بِالصَّبِرِ۔ (ترمذی ۹۵۲۔ ابوداؤد ۱۸۳۴)","Sahih","Musannaf Ibn Abi Shaybah 13439","","","كتاب الحج"
"13440","(۱۳۴۴۰) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنْ نَافِعٍ ، عَنِ ابن عُمَرَ ، أَنَّہُ فَعَلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13440","","","كتاب الحج"
"13441","(۱۳۴۴۱) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا اشْتَکَی عَیْنُہُ وَہُوَ مُحْرِمٌ ، أَقْطَرَ فِیہَا الصَّبِرَ إقْطَارًا۔","Da'if","Musannaf Ibn Abi Shaybah 13441","","","كتاب الحج"
"13442","(۱۳۴۴۲) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ (ح) وَعَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، کِلاَہُمَا عَنْ جَابِرٍ ، عَنْ عَامِرٍ، عَنْ عَلْقَمَۃَ ، قَالَ : لاَ بَأْسَ أَنْ یَکْتَحِلَ الْمُحْرِمُ بِالصَّبِرِ۔","","Musannaf Ibn Abi Shaybah 13442","","","كتاب الحج"
"13443","(۱۳۴۴۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ شُمَیْسَۃَ الأَزْدِیَّۃِ ، قَالَتْ : دَخَلْتُ عَلَی عَائِشَۃَ وَأَنَا مُحْرِمَۃٌ ، وَأَنَا أَشْتَکِی عَیْنِی ، فَقَالَتْ : ہَلُمِّی أُکَحِّلْکِ وَمَعَہَا مَحَارَۃٌ فِیہَا صَبِرٌ ، فَأَبَیْتُ عَلَیْہَا ، فَنَدِمْتُ بَعْدُ ، أَنْ لاَ أَکُونَ تَرَکْتُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 13443","","","كتاب الحج"
"13444","(۱۳۴۴۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِلاَلِ بْنِ مَیْمُونٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13444","","","كتاب الحج"
"13445","(۱۳۴۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ عَطَائٍ ، قَالَ : إذَا اشْتَکَی الْمُحْرِمُ عَیْنَیْہِ فَلْیُکَحِّلْہُمَا بِالصَّبِرِ وَالْحُضَضِ ، وَلاَ یَکْتَحِلْ بِکُحْلٍ فِیہِ طِیبٌ۔","","Musannaf Ibn Abi Shaybah 13445","","","كتاب الحج"
"13446","(۱۳۴۴۶) حدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ زَیدٍ ، قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ ، فَقَالَ : یَا أَبَا سَعِیدٍ ، بِمَ یَکْتَحِلُ الْمُحْرِمُ ؟ وَجَابِرُ بْنُ زَیْدٍ إلَی جَنْبِہِ ، قَالَ : فَسَکَتَ الْحَسَنُ ، وَقَالَ جَابِرٌ : یَکْتَحِلُ بِالْعَسَلِ ، فَلَمْ یُنْکِرْ ذَلِکَ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 13446","","","كتاب الحج"
"13447","(۱۳۴۴۷) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ، عَنْ أَبِی الْعَلاَئِ، عَنْ قَتَادَۃَ، وَأَبِی ہَاشِمٍ قَالاَ: یَکْتَحِلُ بِالصَّبِرِ وَالْحُضَضِ والْمُرِّ۔","","Musannaf Ibn Abi Shaybah 13447","","","كتاب الحج"
"13448","(۱۳۴۴۸) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ الْکُحْلَ الأَسْوَد لِلْمُحْرِمِ ، قَالَ : فَذَکَرْتُ ذَلِکَ لإِبْرَاہِیمَ ، فَقَالَ : یَکْتَحِلُ بِالذَّرُورِ الأَحْمَر۔","","Musannaf Ibn Abi Shaybah 13448","","","كتاب الحج"
"13449","(۱۳۴۴۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمَّارٍ ، قَالَ : رَأَی سَعِیدُ بْنُ جُبَیْرٍ مُحْرِمًا ، قَدْ عَصَّبَ رَأْسَہُ بِسَیْرٍ فَقَطَعَہُ۔","","Musannaf Ibn Abi Shaybah 13449","","","كتاب الحج"
"13450","(۱۳۴۵۰) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یَعْصِّبُ الْمُحْرِمُ رَأْسَہُ بِسَیْرٍ ، وَلاَ خِرْقَۃٍ۔","","Musannaf Ibn Abi Shaybah 13450","","","كتاب الحج"
"13451","(۱۳۴۵۱) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الْمُحْرِمِ یُصَدَّعُ ، قَالَ : یَعْصِبُ رَأْسَہُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 13451","","","كتاب الحج"
"13452","(۱۳۴۵۲) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَسَارٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ زَمَانَ نَجْدِہِ ، قَدْ شَدَّ شَعْرَہُ بِشِرَاکٍ ، وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 13452","","","كتاب الحج"
"13453","(۱۳۴۵۳) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ یَعْقُوبَ بْنِ خَالِدٍ ، قَالَ : حدَّثَنِی أَبُو أَسْمَائَ مَوْلَی عَبْدِ اللہِ بْنِ جَعْفَرٍ ، قَالَ : خَرَجَ الْحُسَیْنُ بْنُ عَلِیٍّ حَاجًّا فَاشْتَکَی بِبَعْضِ الطَّرِیقِ ، فَأَشَارَ إلَی رَأْسِہِ ، فَقَالُوا لِعَلِیٍّ : إنَّ الْحُسَیْنَ یُشِیرُ إلَی رَأْسِہِ ، فَأَمَرَ بِجَزُورٍ یَتَصَدَّقُ بِہَا عَلَی أَہْلِ الْمَائِ ، وَحَلَقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 13453","","","كتاب الحج"
"13454","(۱۳۴۵۴) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : اجْعَلِ الْفِدْیَۃَ حَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13454","","","كتاب الحج"
"13455","(۱۳۴۵۵) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : مَا کَانَ دَمٌ ، أَوْ صَدَقَۃٌ ، أَوْ جَزَائُ صَیْدٍ فَبِمَکَّۃَ ، وَالصَّوْمُ حَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13455","","","كتاب الحج"
"13456","(۱۳۴۵۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : مَا کَانَ مِنْ دَمٍ فَبِمَکَّۃَ ، وَمَا کَانَ مِنْ صِیَامٍ ، أَوْ صَدَقَۃٍ فَحَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13456","","","كتاب الحج"
"13457","(۱۳۴۵۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ قَالاَ: کُلُّ دَمٍ وَاجِبٍ فَلَیْسَ لَہُ أَنْ یَذْبَحَہُ إِلاَّ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13457","","","كتاب الحج"
"13458","(۱۳۴۵۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا کَانَ مِنْ جَزَائٍ فَبِمَکَّۃَ ، وَالصَّدَقَۃُ وَالصِّیَامُ حَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13458","","","كتاب الحج"
"13459","(۱۳۴۵۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الْمَلِکِ ، وَأَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : الدَّمُ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13459","","","كتاب الحج"
"13460","(۱۳۴۶۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا اسْتَکْرَہَ الْمُحْرِمُ امْرَأَتَہُ وَہِیَ مُحْرِمَۃٌ فَعَلَیْہِ بَدَنَتَانِ ؛ بَدَنَۃٌ عَنْہُ وَبَدَنَۃٌ عَنْہَا ، وَإِنْ طَاوَعَتْہُ فَعَلَی کُلِّ وَاحِدٍ مِنْہُمَا بَدَنَۃٌ وَالْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 13460","","","كتاب الحج"
"13461","(۱۳۴۶۱) حدَّثَنَا عَبْدُالأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَعَطَائٍ قَالاَ فِی الْمُحْرِمِ: إِذَا اسْتَکْرَہَ امْرَأَتَہُ فَعَلَیْہِ کَفَّارَتُہَا، فَإِنْ طَاوَعَتْہُ فَعَلَی کُلِّ وَاحِدٍ مِنْہُمَا کَفَّارَۃٌ۔","","Musannaf Ibn Abi Shaybah 13461","","","كتاب الحج"
"13462","(۱۳۴۶۲) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ فِی الْمُحْرِمَۃِ یَسْتَکْرِہُہَا زَوْجُہَا حَتَّی یُوَاقِعَ ، قَالَ : یُحِجُّہَا مِنْ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 13462","","","كتاب الحج"
"13463","(۱۳۴۶۳) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حُمَیْدٍ ، قَالَ : سَأَلْتُ السَّائِبَ : مَاذَا سَمِعْتَ فِی سُکْنَی مَکَّۃَ ؟ فَقَالَ : سَمِعْتُ الْعَلاَئَ بْنَ الْحَضْرَمِیِّ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثٌ لِلْمُہَاجِرِ بَعْدَ الصَّدَرِ۔ (مسلم ۴۴۴۔ احمد ۵۲)","Sahih","Musannaf Ibn Abi Shaybah 13463","","","كتاب الحج"
"13464","(۱۳۴۶۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ عَامِرًا یَقُولُ : مَا جَاوَرَ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ عَامِرٌ یَقُولُ : مَا الْجِوَارُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 13464","","","كتاب الحج"
"13465","(۱۳۴۶۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ أَبِی سُفْیَانَ، قَالَ: جَاوَرْتُ مَعَ جَابِرِ بْنِ عَبْدِاللہِ بِمَکَّۃَ سِتَّۃَ أَشْہُرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 13465","","","كتاب الحج"
"13466","(۱۳۴۶۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : جَاوَرَ عِنْدَنَا جَابِرُ بْنُ عَبْدِ اللہِ ، وَابْنُ عُمَرَ ، وَابْنُ عَبَّاسٍ ، وَأَبُو ہُرَیْرَۃَ ، وَأَبُو سَعِیدٍ الْخُدْرِیِّ۔","","Musannaf Ibn Abi Shaybah 13466","","","كتاب الحج"
"13467","(۱۳۴۶۷) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ ابن الزُّبَیْرِ ، قَالَ : کَانَ یُقِیمُ بِمَکَّۃَ السَّنَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 13467","","","كتاب الحج"
"13468","(۱۳۴۶۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ عَبْدِالْمَلِکِ، قَالَ: جَاوَرْتُ بِمَکَّۃَ، وَثَمَّ عَلِیُّ بْنُ الْحُسَیْنِ، وَسَعِیدُ بْنُ جُبَیْرٍ۔","","Musannaf Ibn Abi Shaybah 13468","","","كتاب الحج"
"13469","(۱۳۴۶۹) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : أَتَیْتُ أَنَا ، وَعُبَیْدُ بْنُ عُمَیْرٍ اللَّیْثِیُّ عَائِشَۃَ وَہِیَ مُجَاوِرَۃٌ بِثَبِیرٍ ، قَالَ : وَکَانَ عَلَیْہَا نَذْرٌ أَنْ تُجَاوِرَ شَہْرًا ، قَالَ : وَکَانَ عَبْدُ الرَّحْمَنِ أَخُوہَا یَمْنَعُہَا مِنْ ذَلِکَ وَیَقُولُ : جِوَارُ الْبَیْتِ وَطَوَافٌ بِہِ أَحَبُّ إلَیَّ وَأَفْضَلُ ، قَالَ : فَلَمَّا مَاتَ عَبْدُ الرَّحْمَنِ خَرَجَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 13469","","","كتاب الحج"
"13470","(۱۳۴۷۰) حدَّثَنَا وَکِیعٌ، عَنْ عُمَرَ بْنِ أَبِی مَعْرُوفٍ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ، قَالَ: قَالَ عُمَرُ: لاَ تُقِیمُوا بَعْدَ النَّفْرِ إلاَّ ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 13470","","","كتاب الحج"
"13471","(۱۳۴۷۱) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، قَالَ : کَانَ الشَّعْبِیُّ إذَا سُئِلَ عَنِ الْجُوَارِ جَائَ بِکِتَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی خُزَاعَۃَ : إنِّی قَدْ أَخَذْتُ بِمَنْ ہَاجَرَ مِنْکُمْ کَمَا أَخَذْت لِنَفْسِی ، وَلَوْ کَانَ بِأَرْضِہِ غَیرَ سَاکِنِ مَکَّۃَ ، إِلاَّ حَاجًّا ، أَوْ مُعْتَمِرًا۔ (ابن سعد ۲۷۲)","","Musannaf Ibn Abi Shaybah 13471","","","كتاب الحج"
"13472","(۱۳۴۷۲) حدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہ قَالَ : مَکَّۃُ لَیْسَتْ بِدَارِ إقَامَۃٍ ، وَلاَ مُکْثٍ۔","","Musannaf Ibn Abi Shaybah 13472","","","كتاب الحج"
"13473","(۱۳۴۷۳) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنِ الأَجْلَحِ، عَنْ عَامِرٍ، قَالَ: لاَ یَصْلُحُ لِلْمُہَاجِرِ أَنْ یُجَاوِرَ فَوْقَ ثَلاَثَۃِ أَیَّامٍ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13473","","","كتاب الحج"
"13474","(۱۳۴۷۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ خُصَیْفٍ ، قَالَ : أَخَذْتُ مِنْ شَارِبِ مُحَمَّدِ بْنِ مَرْوَانَ وَأَنَا مُحْرِمٌ ، فَسَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ؟ فَأَمَرَنِی أَنْ أَتَصَدَّقَ بِدِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 13474","","","كتاب الحج"
"13475","(۱۳۴۷۵) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ فِی حَرَامٍ قَصَّ شَارِبَ حَلاَلٍ ؟ قَالَ : یَتَصَدَّقُ بِدِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 13475","","","كتاب الحج"
"13476","(۱۳۴۷۶) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ یَکْرَہُ أَنْ یَأْخُذَ الْمُحْرِمُ مِنْ رَأْسِ الْحَلاَلِ، یَعْنِی مِنْ شَعْرِہِ أَوْ یَقْلِمَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 13476","","","كتاب الحج"
"13477","(۱۳۴۷۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی بَعْضَ أَصْحَابِنَا حَرَامًا یقصِّر عَنْ جَابِرِ بْنِ زَیْدٍ یُحَلِّلُہُ۔","","Musannaf Ibn Abi Shaybah 13477","","","كتاب الحج"
"13478","(۱۳۴۷۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، قَالَ : الْمَرْأَۃُ الْمُحْرِمَۃُ تُمَشِّطُ الْمَرْأَۃَ الْحَلاَلَ ، إنَّمَا تَقْتُلُ قَمْلَ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 13478","","","كتاب الحج"
"13479","(۱۳۴۷۹) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنْ مَوْلاَہُ السَّائِبِ بْنِ عَبْدِ اللہِ ، قَالَتْ : کَانَ السَّائِبُ بْنُ عَبْدِ اللہِ یَأْمُرُنِی أَنْ أَشْرَبَ مِنْ سِقَایَۃِ آلِ عَبَّاسٍ ، وَیَقُولُ : إِنَّہُ مِنْ تَمَامِ الْحَجِّ۔","Hasan","Musannaf Ibn Abi Shaybah 13479","","","كتاب الحج"
"13480","(۱۳۴۸۰) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ قَالَ : اشْرَبْ مِنْ سِقَایَۃِ آلِ عَبَّاسٍ ، وَقَدْ شَرِبَ مِنْہَا الْمُسْلِمُونَ ، وَہُوَ سُنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 13480","","","كتاب الحج"
"13481","(۱۳۴۸۱) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ لِی مَوْلَی بَنِی عَبْدِ اللہِ بْنِ السَّائِبِ : اشْرَبْ مِنْ سِقَایَۃِ آلِ عَبَّاسٍ ، وَقَدْ شَرِبَ مِنْہَا الْمُسْلِمُونَ۔","","Musannaf Ibn Abi Shaybah 13481","","","كتاب الحج"
"13482","(۱۳۴۸۲) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ طَافَ بِالْبَیْتِ ، ثُمَّ أَتَی زَمْزَمَ ، فَأُتِیَ بِنَبِیذٍ مِنْ نَبِیذِ السِّقَایَۃِ فَشَرِبَ نِصْفًا ، وَأَعْطَی جَعْفَرًا نِصْفًا۔","","Musannaf Ibn Abi Shaybah 13482","","","كتاب الحج"
"13483","(۱۳۴۸۳) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، قَالَ : أَحَبَّ لِلرَّجُلِ أَنْ یَشْرَبَ مِنْ نَبِیذِ السِّقَایَۃِ۔","","Musannaf Ibn Abi Shaybah 13483","","","كتاب الحج"
"13484","(۱۳۴۸۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، قَالَ : خَرَجَ سَعِیدُ بْنُ جُبَیْرٍ مِنْ مِنًی بِالْہَجِیرِ ، فَطَافَ أُسْبُوعًا بِالْبَیْتِ وَصَلَّی رَکْعَتَیْنِ ، ثُمَّ أَتَی السِّقَایَۃَ ، فَسَقَانَا مُحَمَّدُ بْنُ عَلِیٍّ نَبِیذًا ، فَشَرِبَ مِنْہُ سَعِیدُ بْنُ جُبَیْرٍ وَسَقَانِی۔","","Musannaf Ibn Abi Shaybah 13484","","","كتاب الحج"
"13485","(۱۳۴۸۵) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : اشْرَبْ مِنْ نَبِیذِ السِّقَایَۃِ۔","","Musannaf Ibn Abi Shaybah 13485","","","كتاب الحج"
"13486","(۱۳۴۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ رَجُلٍ ، عَنْ مُجَاہِدٍ ، قَالَ : شَرِبْتُ مَعَہُ مِنْ نَبِیذِ السِّقَایَۃِ نَبِیذٍ صُدِّعْتُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13486","","","كتاب الحج"
"13487","(۱۳۴۸۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَمْ أَرَ ابْنَ عُمَرَ فِیمَا کَانَ یُفِیضُ شَرِبَ مِنَ النَّبِیذِ قَطُّ۔","","Musannaf Ibn Abi Shaybah 13487","","","كتاب الحج"
"13488","(۱۳۴۸۸) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ؛ أَنَّہُ حَجَّ مَعَ سَالِمٍ مَا لاَ یُحْصَی ، فَلَمْ یَرَہُ شَرِبَ مِنْ نَبِیذِ السِّقَایَۃِ۔","","Musannaf Ibn Abi Shaybah 13488","","","كتاب الحج"
"13489","(۱۳۴۸۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ ألنَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَی بَنِی عَبْدِ الْمُطَّلِبِ وَہُمْ یَنْزِعُونَ عَلَی زَمْزَمَ ، فَقَالَ : انْزِعُوا بَنِی عَبْدِ الْمُطَّلِبِ ، فَلَوْلاَ أَنْ یَغْلِبَکُمُ النَّاسُ عَلَی سِقَایَتِکُمْ لَنَزَعْتُ مَعَکُمْ ، فَنَاوَلُوہُ دَلْوًا فَشَرِبَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13489","","","كتاب الحج"
"13490","(۱۳۴۹۰) حدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَان بْنِ خُثَیْمٍ قَالَ : أَفَضْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، فَأَتَی حَوْضًا فِیہِ مَائُ زَمْزَمَ ، فَغَرَفَ بِیَدِہِ فَشَرِبَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13490","","","كتاب الحج"
"13491","(۱۳۴۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا وَدَّعُوا الْبَیْتَ ، أَنْ یَأْتُوا زَمْزَمَ فَیَشْرَبُوا مِنْہَا۔","","Musannaf Ibn Abi Shaybah 13491","","","كتاب الحج"
"13492","(۱۳۴۹۲) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : أحبَّ لِلرَّجُلِ أَنْ یَشْرَبَ ، وَأَنْ یَسْتَقِی مِنْ زَمْزَمَ إنِ اسْتَطَاعَ۔","","Musannaf Ibn Abi Shaybah 13492","","","كتاب الحج"
"13493","(۱۳۴۹۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، قَالَ : لَمْ أَرَ عَبْدَ اللہِ بْنَ عُمَرَ فِیمَنْ کَانَ یُفِیضُ یَشْرَبُ مِنْ زَمْزَمَ قَطُّ۔","","Musannaf Ibn Abi Shaybah 13493","","","كتاب الحج"
"13494","(۱۳۴۹۴) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ؛ أَنَّہُ لَمْ یَرَ سَالِمًا یَشْرَبُ مِنْ مَائِ زَمْزَمَ۔","","Musannaf Ibn Abi Shaybah 13494","","","كتاب الحج"
"13495","(۱۳۴۹۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ اعْتَمَرَ عام الْقِتَالَ فِی شَوَّالٍ وَرَجَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13495","","","كتاب الحج"
"13496","(۱۳۴۹۶) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَتْ عَائِشَۃُ تَعْتَمِرُ فِی آخِرِ ذِی الْحِجَّۃِ ، وَتَعْتَمِرُ مِنَ الْمَدِینَۃِ فِی رَجَبٍ ، تُہِلُّ مِنْ ذِی الْحُلَیْفَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13496","","","كتاب الحج"
"13497","(۱۳۴۹۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، قَالَ : کَانَ الأَسْوَدُ یَعْتَمِرُ فِی رَجَبٍ ثُمَّ یَرْجِعُ۔","","Musannaf Ibn Abi Shaybah 13497","","","كتاب الحج"
"13498","(۱۳۴۹۸) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : سَمِعْتُ یَحْیَی بْنَ عَبْدِ الرَّحْمَنِ یُحَدِّثُ ، عَنْ أَبِیہِ ؛ أَنَّہُ اعْتَمَرَ مَعَ عُثْمَانَ فِی رَجَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13498","","","كتاب الحج"
"13499","(۱۳۴۹۹) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ یَعْلَی بْنِ الْحَارِثِ ، قَالَ : سَمِعْتُ أَبَا إِسْحَاقَ وَسُئِلَ عَنْ عُمْرَۃِ رَمَضَانَ ؟ فَقَالَ : أَدْرَکْتُ أَصْحَابَ عَبْدِ اللہِ لاَ یَعْدِلُونَ بِعُمْرَۃِ رَجَبٍ ، ثُمَّ یَسْتَقْبِلُونَ الْحَجَّ۔","","Musannaf Ibn Abi Shaybah 13499","","","كتاب الحج"
"13500","(۱۳۵۰۰) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، قَالَ : کَانَ الْقَاسِمُ یَعْتَمِرُ فِی رَجَبٍ۔","","Musannaf Ibn Abi Shaybah 13500","","","كتاب الحج"
"13501","(۱۳۵۰۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ یَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنْ أَبِیہِ ، قَالَ : اعْتَمَرْتُ مَعَ عُمَرَ وَعُثْمَانَ فِی رَجَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13501","","","كتاب الحج"
"13502","(۱۳۵۰۲) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : أَدْلَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَیْلَۃَ النَّفْرِ مِنَ الْبَطْحَائِ إِدْلاَجًا۔n(ابن ماجہ ۳۰۶۸۔ احمد ۶/۷۸)","Hasan","Musannaf Ibn Abi Shaybah 13502","","","كتاب الحج"
"13503","(۱۳۵۰۳) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ صَالِحِ بْنِ کَیْسَانَ ، قَالَ : سَمِعْتُ سُلَیْمَانَ بْنَ یَسَارٍ یَقُولُ : إنَّ أَبَا رَافِعٍ کَانَ عَلَی ثَقَلِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَنَا جِئْتُ فَضَرَبْتُ قُبَّتَہُ بِالأَبْطَحِ ، فَجَائَ فَنَزَلَ۔n(مسلم ۳۴۲۔ ابوداؤد ۲۰۰۲)","Sahih","Musannaf Ibn Abi Shaybah 13503","","","كتاب الحج"
"13504","(۱۳۵۰۴) حدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَامَ نَوْمَۃً بِالأَبْطَحِ، ثُمَّ أَدْلَجَ۔","","Musannaf Ibn Abi Shaybah 13504","","","كتاب الحج"
"13505","(۱۳۵۰۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنِ الْمَعْرُورِ بْنِ سُوَیْد ، قَالَ : قَالَ عُمَرُ : یَا آلَ خُزَیْمَۃَ ، حَصِّبُوا لَیْلَۃَ النَّفْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 13505","","","كتاب الحج"
"13506","(۱۳۵۰۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ مُرَّۃَ ، قَالَ : نَزَلَ الأَسْوَدُ بِالأَبْطَحِ ، قَالَ : فَسَمِعَ رُغَائً ، قَالَ : فَنَظَرَ مَا ہُوَ ؟ فَإِذَا ہُوَ ابْنُ عُمَرَ یَرْتَحِلُ۔","","Musannaf Ibn Abi Shaybah 13506","","","كتاب الحج"
"13507","(۱۳۵۰۷) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : جِئْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، فَلَمَّا نَفَرْنَا أَتَیْنَا الأَبْطَحَ حِینَ أَقْبَلْنَا مِنْ مِنًی۔","","Musannaf Ibn Abi Shaybah 13507","","","كتاب الحج"
"13508","(۱۳۵۰۸) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا انْتَہَی إِلَی الأَبْطَحِ فَلْیَضَعْ رَحْلَہُ ، ثُمَّ لِیَزُرِ الْبَیْتَ وَیَضْطَجِعْ فِیہِ ہُنَیْہَۃً ، ثُمَّ لِیَنْفِرْ۔","","Musannaf Ibn Abi Shaybah 13508","","","كتاب الحج"
"13509","(۱۳۵۰۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ؛ أَنَّ أَبَاہُ کَانَ یُحَصِّبُ فِی شِعْبِ الْخَوْزِ۔","","Musannaf Ibn Abi Shaybah 13509","","","كتاب الحج"
"13510","(۱۳۵۱۰) حدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ وَعُمَرَ کَانُوا یُحَصِّبُونَ۔ (مسلم ۹۵۱۔ ترمذی ۹۲۱)","","Musannaf Ibn Abi Shaybah 13510","","","كتاب الحج"
"13511","(۱۳۵۱۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ التَّحْصِیبُ بِشَیْئٍ ، إِنَّمَا ہُوَ مَنْزِلٌ نَزَلَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۱۷۶۶۔ مسلم ۹۵۲)","Sahih","Musannaf Ibn Abi Shaybah 13511","","","كتاب الحج"
"13512","(۱۳۵۱۲) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَنْزِلُ الأَبْطَحَ ، وَقَالَ : إنَّمَا فَعَلَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَنَّہُ انْتَظَرَ عَائِشَۃَ۔ (احمد ۱/۳۵۱)","","Musannaf Ibn Abi Shaybah 13512","","","كتاب الحج"
"13513","(۱۳۵۱۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : إنَّمَا نَزَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الأَبْطَحَ لأَنَّہُ أَسْمَحُ لِخُرُوجِہِ ، وَإِنَّہُ لَیْسَ بِسُنَّۃٍ۔ (بخاری ۱۷۶۵۔ ابوداؤد ۲۰۰۱)","Sahih","Musannaf Ibn Abi Shaybah 13513","","","كتاب الحج"
"13514","(۱۳۵۱۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 13514","","","كتاب الحج"
"13515","(۱۳۵۱۵) حدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنْ لَیْثٍ؛ أَنَّ عَطَائً، وَطَاوُسًا، وَمُجَاہِدًا، وَسَعِیدَ بْنَ جُبَیْرٍ کَانُوا لاَیُحَصِّبُونَ۔","","Musannaf Ibn Abi Shaybah 13515","","","كتاب الحج"
"13516","(۱۳۵۱۶) حدَّثَنَا عَبْدَۃُ بْنِ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ ؛ أَنَّ أَسْمَائَ کَانَتْ لاَ تُحَصِّبُ۔","Sahih","Musannaf Ibn Abi Shaybah 13516","","","كتاب الحج"
"13517","(۱۳۵۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إنَّمَا الْحَصْبَۃُ فِی السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 13517","","","كتاب الحج"
"13518","(۱۳۵۱۸) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ أَنْکَرَہُ۔","","Musannaf Ibn Abi Shaybah 13518","","","كتاب الحج"
"13519","(۱۳۵۱۹) حدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ لاَ یُحَصِّبُ۔","","Musannaf Ibn Abi Shaybah 13519","","","كتاب الحج"
"13520","(۱۳۵۲۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَرَجَ إلَی الصَّفَا مِنْ بَابِ بَنِی مَخْزُومٍ۔","","Musannaf Ibn Abi Shaybah 13520","","","كتاب الحج"
"13521","(۱۳۵۲۱) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إِذَا قَدِمَ فَطَافَ بِالْبَیْتِ وَصَلَّی رَکْعَتَیْنِ ، خَرَجَ إلَی الصَّفَا مِنَ الْبَابِ الَّذِی یَلِی السِّقَایَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 13521","","","كتاب الحج"
"13522","(۱۳۵۲۲) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا مِنْ أَیِّ أَبْوَابِ الْمَسْجِدِ خَرَجَ إلَی الصَّفَا۔","","Musannaf Ibn Abi Shaybah 13522","","","كتاب الحج"
"13523","(۱۳۵۲۳) حدَّثَنَا أَبُو خَالِدٍ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: إذَا صَلَّیْتَ فَاخْرُجْ مِنْ أَیِّ الأَبْوَابِ شِئْتَ، یَعْنِی إلَی الصَّفَا۔","","Musannaf Ibn Abi Shaybah 13523","","","كتاب الحج"
"13524","(۱۳۵۲۴) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا طُفْتَ بِالْبَیْتِ فَلَمْ تَدْرِ أَأَتْمَمْتَ ، أَمْ لَمْ تُتِمْ ، فَأَتِمَّ مَا شَکَکْتَ ، فَإِنَّ اللَّہَ لاَ یُعَذِّبُ عَلَی الزِّیَادَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 13524","","","كتاب الحج"
"13525","(۱۳۵۲۵) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إذَا شَکَّ الرَّجُلُ فِی الطَّوَافِ فَلَمْ یَدْرِ أَطَافَ ، أَمْ لَمْ یَطُفْہُ ؟ فَلْیَسْتَقْبِلْ۔","","Musannaf Ibn Abi Shaybah 13525","","","كتاب الحج"
"13526","(۱۳۵۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : رَمَیْتُ الْجِمَارَ فَلَمْ أَدْرِ بِکَمْ رَمَیْتُ ؟ فَسَأَلْتُ ابْنَ عُمَرَ فَلَمْ یُجِبْنِی ، فَمَرَّ بِی ابْنُ الْحَنَفِیَّۃِ فَسَأَلْتُہُ ؟ فَقَالَ : یَا عَبْدَ اللہِ ، لَیْسَ شَیْئٌ أَعْظَمَ عَلَیْنَا مِنَ الصَّلاَۃِ ، وَإِذَا نَسِیَ أَحَدُنَا أَعَادَ ، فَأَخْبَرْتُ ابْنَ عُمَرَ ، فَقَالَ : إنَّہُمْ أَہْلُ بَیْتٍ مُفَہَّمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 13526","","","كتاب الحج"
"13527","(۱۳۵۲۷) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ، عَنِ ابْنِ عَبَّاسٍ؛ {فَجَزَائٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ} إلَی قَوْلِہِ : {أَوْ عَدْلُ ذَلِکَ صِیَامًا} قَالَ : إذَا أَصَابَ الْمُحْرِمُ الصَّیْدَ حُکِمَ عَلَیْہِ بِجَزَائِہِ مِنَ النَّعَمِ ، فَإِنْ لَمْ یَجِدْ نَظَرَ کَمْ ثَمَنُہُ ، ثُمَّ قَوَّمَ ثَمَنَہُ طَعَامًا ، فَصَامَ مَکَانَ کُلِّ نِصْفِ صَاعٍ یَوْمًا ، {أَوْ کَفَّارَۃٌ طَعَامُ مَسَاکِینَ ، أَوْ عَدْلُ ذَلِکَ صِیَامًا} قَالَ : إنَّمَا أُرِیدَ بِالطَّعَامِ الصِّیَامَ ، إِنَّہُ إذَا وَجَدَ الطَّعَامَ وَجَدَ جَزَائَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13527","","","كتاب الحج"
"13528","(۱۳۵۲۸) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ فِی قَوْلِہِ تَعَالَی : (وَمَنْ قَتَلَہُ مِنْکُمْ مُتَعَمِّدًا فَجَزَائٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ یَحْکُمُ بِہِ ذَوَا عَدْلٍ مِنْکُمْ ہَدْیًا بَالِغَ الْکَعْبَۃِ) فَإِنْ لَمْ یَجِدْ قُوِّمَ عَلَیْہِ طَعَامٌ ، ثُمَّ قِیلَ لَہُ : صُمْ لِکُلِّ نِصْفِ صَاعٍ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 13528","","","كتاب الحج"
"13529","(۱۳۵۲۹) حدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ ، وَإِبْرَاہِیمَ ؛ أَنَّہُمْ قَالُوا : إذَا أَصَابَ الْمُحْرِمُ الصَّیْدَ فَعَلَیْہِ ثَمَنُہُ فَاشْتَرَی دَمًا ، فَإِنْ لَمْ یَجِدْ دَمًا قَوَّمَ طَعَامًا فَتَصَدَّقَ عَلَی کُلِّ مِسْکِینٍ نِصْفَ صَاعٍ ، فَإِنْ لَمْ یَجِدْ صَامَ لِکُلِّ صَاعٍ یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 13529","","","كتاب الحج"
"13530","(۱۳۵۳۰) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : ذَکَرَ مَیْمُونُ بْنُ مِہْرَانَ فِی قَتْلِ الرَّجُلِ الصَّیْدَ وَہُوَ مُحْرِمٌ ، قَالَ : {جَزَائٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ یَحْکُمُ بِہِ ذَوَا عَدْلٍ مِنْکُمْ ہَدْیًا بَالِغَ الْکَعْبَۃِ} إِنْ وَجَدَ الرَّجُلُ جَزَائَ الصَّیْدِ أَہْدَی ، وَإِنْ لَمْ یَجِدْ فقیمۃ ثَمَنِہِ ، فَیَجْعَلُہُ طَعَامًا یَتَصَدَّقُ بِہِ عَلَی الْمَسَاکِینِ ، فَإِنْ لَمْ یَجِدْ صَامَ عَنْ طَعَامِ کُلِّ مِسْکِینٍ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 13530","","","كتاب الحج"
"13531","(۱۳۵۳۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مِقْسِمٍ قَالَ : یُقَوَّم عَلَیْہِ دَرَاہِمَ ، ثُمَّ یُقَوَّم بِالدَّرَاہِمِ الطَّعَامَ ، ثُمَّ یَصُومُ لِکُلِّ نِصْفِ صَاعٍ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 13531","","","كتاب الحج"
"13532","(۱۳۵۳۲) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : کَانَتْ ہَذِہِ الآیَۃُ نَزَلَتْ : {لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَّبِّکُمْ} قَالَ : فِی مَوَاسِمِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13532","","","كتاب الحج"
"13533","(۱۳۵۳۳) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ عَبَّاسٍ ۔(ح) وَعَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنِ ابْنِ الزُّبَیْرِ ؛ (لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَبِّکُمْ) قَالَ : فِی مَوَاسِمِ الْحَجِّ۔","Sahih","Musannaf Ibn Abi Shaybah 13533","","","كتاب الحج"
"13534","(۱۳۵۳۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی أُمَیْمَۃَ ؛ أَنَّہُ سَأَلَ ابْنَ عُمَرَ عَنِ الرَّجُلِ یَحُجُّ ، وَیَحْمِلُ مَعَہُ تِجَارَۃً ؟ فَقَالَ ابْنُ عُمَرَ : لاَ بَأْسَ بِہِ ، وَتَلاَ ہَذِہِ الآیَۃَ : {یَبْتَغُونَ فَضْلاً مِنْ رَبِّہِمْ وَرِضْوَانًا}۔","Sahih","Musannaf Ibn Abi Shaybah 13534","","","كتاب الحج"
"13535","(۱۳۵۳۵) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَحُجَّ الرَّجُلُ وَمَعَہُ تِجَارَۃٌ۔قَالَ : وَقَالَ مُحَمَّدٌ : إِنَّ اللہ قَادِرٌ عَلَی أَنْ یَجْمَعَہُمَا لَہُ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 13535","","","كتاب الحج"
"13536","(۱۳۵۳۶) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا لاَ یَتَّجِرُونَ حَتَّی نَزَلَتْ : {لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَبِّکُمْ}۔","","Musannaf Ibn Abi Shaybah 13536","","","كتاب الحج"
"13537","(۱۳۵۳۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدٍ ، عَنْ مُجَاہِدٍ ، عَنْ ابْنِ عَبَّاسٍ، قَالَ : {لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَبِّکُمْ} قَالَ : کَانُوا لاَ یَبِیعُونَ وَلاَ یَشْتَرُونَ فِی أَیَّامِ مِنًی ، فَأَنْزَلَ اللَّہُ تَعَالَی : {لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَبِّکُمْ}۔","Da'if","Musannaf Ibn Abi Shaybah 13537","","","كتاب الحج"
"13538","(۱۳۵۳۸) حدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ (لَیْسَ عَلَیْکُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلاً مِنْ رَبِّکُمْ) التِّجَارَۃُ فِی الْمَوَاسِمِ أُحِلَّتْ لَہُمْ ، کَانُوا لاَ یَتَبَایَعُونَ فِی الْجَاہِلِیَّۃِ بِعَرَفَۃَ ، وَلاَ مِنًی۔","","Musannaf Ibn Abi Shaybah 13538","","","كتاب الحج"
"13539","(۱۳۵۳۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَقُولُ: لَبَّیْکَ عَنْ شُبْرُمَۃَ ، فَقَالَ : إِنْ کُنْتَ حَجَجْتَ فَلَبِّ عَنْ شُبْرُمَۃَ ، وَإِلاَّ فَلَبِّ عَنْ نَفْسِکَ۔ (دارقطنی ۱۵۶)","Da'if","Musannaf Ibn Abi Shaybah 13539","","","كتاب الحج"
"13540","(۱۳۵۴۰) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِہِ۔ (ابوداؤد ۱۸۰۷۔ ابن ماجہ ۲۹۰۳)","","Musannaf Ibn Abi Shaybah 13540","","","كتاب الحج"
"13541","(۱۳۵۴۱) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ ابْنَ عَبَّاسٍ سَمِعَ رَجُلاً یَقُولُ : لَبَّیْکَ عَنْ شُبْرُمَۃَ ، قَالَ : وَیْحَکَ ، وَمَا شُبْرُمَۃُ ؟ فَذَکَرَ رَجُلاً بَیْنَہُ وَبَیْنَہُ قَرَابَۃٌ ، قَالَ : حَجَجْتَ قَطُّ ؟ قَالَ : لاَ ، قَالَ : فَاجْعَلْ ہَذِہِ عَنْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 13541","","","كتاب الحج"
"13542","(۱۳۵۴۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدُ بْنُ الأَسْوَدِ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ لاَ یَرَی بَأْسًا أَنْ یَحُجَّ الصَّرُورَۃُ عَنِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 13542","","","كتاب الحج"
"13543","(۱۳۵۴۳) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَحُجُّ عَنِ الرَّجُلِ وَلَمْ یَکُنْ حَجَّ قَطُّ ؟ قَالَ : یُجْزِء عَنْہُ وَعَنْ صَاحِبِہِ الأَوَّلِ ۔ قَالَ أَبُو بَکْرٍ : الصَّرُورَۃُ الَّذِی لَمْ یَحُجَّ قَطُّ۔","","Musannaf Ibn Abi Shaybah 13543","","","كتاب الحج"
"13544","(۱۳۵۴۴) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَحُجَّ الصَّرُورَۃُ عَنِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 13544","","","كتاب الحج"
"13545","(۱۳۵۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إنَّ اللَّہَ لَوَاسِعٌ لَہُمَا جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 13545","","","كتاب الحج"
"13546","(۱۳۵۴۶) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَکُونُ مُحْرِمًا بِحَجَّۃٍ وَعُمْرَۃٍ ، وَامْرَأَتُہُ مُحْرِمَۃٌ بِحَجَّۃٍ وَعُمْرَۃٍ فَیَقَعُ عَلَیْہَا ، قَالَ : یَمْضِیَانِ لِحَجِّہِمَا وَلِعُمْرَتِہِمَا ، وَیُہْرِیقُ کُلُّ وَاحِدٍ مِنْہُمَا دَمًا ، وَعَلَیْہِمَا عمْرَۃٌ وَالْحَجُّ مِنْ قَابِلٍ ، وَلاَ یَمُرَّانِ بِالْمَکَانِ الَّذِی أَصَابَا فِیہِ مَا أَصَابَا۔","","Musannaf Ibn Abi Shaybah 13546","","","كتاب الحج"
"13547","(۱۳۵۴۷) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ؛ فِی الَّذِی یَقَعُ بِأَہْلِہِ وَقَدْ أَہَلَّ بِہِمَا، قَالَ: عَلَیْہِ بَدَنَتَانِ۔","","Musannaf Ibn Abi Shaybah 13547","","","كتاب الحج"
"13548","(۱۳۵۴۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ ، قَالَ: الْقَارِنُ وَغَیْرُ الْقَارِنِ سَوَائٌ فِی جَزَائِ الصَّیْدِ۔","","Musannaf Ibn Abi Shaybah 13548","","","كتاب الحج"
"13549","(۱۳۵۴۹) حدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الْمُحْرِمِ یُوَاقِعُ ، ثُمَّ یَعُودُ ؟ قَالَ : عَلَیْہِ ہَدْیٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 13549","","","كتاب الحج"
"13550","(۱۳۵۵۰) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی مُحْرِمٍ غَشِیَ امْرَأَتَہُ مِرَارًا ، قَالَ : إذَا فَعَلَ ذَلِکَ قَبْلَ أَنْ یَنْسُکَ وَیَعْلَمَ مَا عَلَیْہِ ، فَعَلَیْہِ ہَدْیٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 13550","","","كتاب الحج"
"13551","(۱۳۵۵۱) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ أَبِیہِ، قَالَ: سُئِلَ ابْنُ عُمَرَ عَنْ صَوْمِ یَوْمِ عَرَفَۃَ؟ فَقَالَ: حجَجْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یَصُمْہُ، وَحَجَجْتُ مَعَ أَبِی بَکْرٍ فَلَمْ یَصُمْہُ، وَحَجَجْتُ مَعَ عُمَرَ فَلَمْ یَصُمْہُ ، وَحَجَجْتُ مَعَ عُثْمَانَ فَلَمْ یَصُمْہُ ، وَأَنَا لاَ أَصُومُہُ ، وَلاَ آمُرُ بِہِ ، وَلاَ أَنْہَی عَنْہُ۔n(ترمذی ۷۵۱۔ ابن حبان ۳۶۰۴)","Sahih","Musannaf Ibn Abi Shaybah 13551","","","كتاب الحج"
"13552","(۱۳۵۵۲) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْفَضْلِ بْنِ عَبَّاسٍ قَالَ : دَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِلَبَنٍ یَوْمَ عَرَفَۃَ مِنْ رَحْلِ أُمِّ الْفَضْلِ ، فَشَرِبَ مِنْہُ وَہُوَ بِالْمَوْقِفِ۔","","Musannaf Ibn Abi Shaybah 13552","","","كتاب الحج"
"13553","(۱۳۵۵۳) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الْفَضْلِ بْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَرِبَ یَوْمَ عَرَفَۃَ۔ (ابویعلی ۶۶۹۷۔ طبرانی ۱۸)","","Musannaf Ibn Abi Shaybah 13553","","","كتاب الحج"
"13554","(۱۳۵۵۴) حدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَفْطَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَرَفَۃَ ، وَبَعَثَتْ إِلَیْہِ أُمُّ الْفَضْلِ بِلَبَنٍ فَشَرِبَہُ۔ (ترمذی ۷۵۰۔ نسائی ۲۸۲۰)","Sahih","Musannaf Ibn Abi Shaybah 13554","","","كتاب الحج"
"13555","(۱۳۵۵۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : لاَ أَدْرِی سَمِعْتُہُ مِنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَوْ حُدِّثْتُ عَنْہُ ، قَالَ : أَتَیْتُ عَلَی ابْنِ عَبَّاسٍ بِعَرَفَۃَ وَہُوَ یَأْکُلُ رُمَّانًا ، وَقَالَ : أَفْطَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَرَفَۃَ ، وَسَقَتْہُ أُمُّ الْفَضْلِ لَبَنًا فَشَرِبَہُ ، وَقَالَ : لَعَنَ اللَّہُ فُلاَنًا ، عَمَدُوا إلَی أَیَّامِ الْحَجِّ فَمَحَوْا زِینَتَہُ ، وَقَالَ : زِینَۃُ الْحَجِّ التَّلْبِیَۃُ۔n(نسائی ۲۸۱۵۔ احمد ۱/۳۴۹)","","Musannaf Ibn Abi Shaybah 13555","","","كتاب الحج"
"13556","(۱۳۵۵۶) حدَّثَنَا وَکِیعٌ ، عَنْ حَوْشَبِ بْنِ عَقِیلٍ ، قَالَ : حدَّثَنِی مَہْدِیٌّ الْعَبْدِیُّ ، عَنْ عِکْرِمَۃَ ، قَالَ : دَخَلْتُ إلَی أَبِی ہُرَیْرَۃَ فِی بَیْتِہِ فَسَأَلْتُہُ عَنْ صَوْمِ یَوْمِ عَرَفَۃَ بِعَرَفَاتٍ ؟ فَقَالَ أَبُو ہُرَیْرَۃَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صَوْمِ یَوْمِ عَرَفَۃَ بِعَرَفَاتٍ۔ (ابوداؤد ۲۴۳۲۔ احمد ۲/۳۰۴)","Da'if","Musannaf Ibn Abi Shaybah 13556","","","كتاب الحج"
"13557","(۱۳۵۵۷) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، عَنْ أَبِیہِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَوْمُ عَرَفَۃَ وَیَوْمُ النَّحْرِ وَأَیَّامُ مِنَی أَیَّامُ أَکْلٍ وَشُرْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13557","","","كتاب الحج"
"13558","(۱۳۵۵۸) حدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ صَوْمِ یَوْمِ عَرَفَۃَ ؟ فَقَالَ : کَانَ عَبْدُ اللہِ بْنُ عُمَرَ لاَ یَصُومُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13558","","","كتاب الحج"
"13559","(۱۳۵۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنْ سُلَیْمَانَ الأَحْوَلِ ، قَالَ : ذَکَرْتُ لِطَاوُوسٍ صَوْمَ عَرَفَۃَ أَنَّہُ یَعْدِلُ بِصَوْمِ سَنَتَیْنِ ؟ فَقَالَ : أَیْنَ کَانَ أَبُو بَکْرٍ ، وَعُمَرُ عَنْ ذَلِکَ ؟۔","","Musannaf Ibn Abi Shaybah 13559","","","كتاب الحج"
"13560","(۱۳۵۶۰) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ سَالِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ؛ أَنَّہُ أَفْطَرَ یَوْمَ عَرَفَۃَ، وَقَالَ: أَتَقَوَّی عَلَی الدُّعَائِ۔","","Musannaf Ibn Abi Shaybah 13560","","","كتاب الحج"
"13561","(۱۳۵۶۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ، قَالَ: رَأَیْتُ عُمَرَ شَرِبَ یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 13561","","","كتاب الحج"
"13562","(۱۳۵۶۲) حدَّثَنَا یَحْیَی بْنُ مُحَمَّدِ بْنِ الْبَہِیِّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ ، وَابْنَ الزُّبَیْرِ یَتَعَاوَرَانِ إدَاوَۃً عَشِیَّۃَ عَرَفَۃَ ، یَشْرَبَانِ مِنْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13562","","","كتاب الحج"
"13563","(۱۳۵۶۳) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ صَوْمَ یَوْمَ عَرَفَۃَ إذَا کَانَ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13563","","","كتاب الحج"
"13564","(۱۳۵۶۴) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ؛ أَنَّہُ أَمَرَہُ أَبُوہُ عُبَیْدُ بْنُ عُمَیْرٍ أَنْ یُفْطِرَ یَوْمَ عَرَفَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 13564","","","كتاب الحج"
"13565","(۱۳۵۶۵) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، قَالَ : سَأَلْتُ سَالِمًا عَنْ صَوْمِ یَوْمِ عَرَفَۃَ ؟ فَقَالَ : لَمْ یَصُمْہُ عُمَرُ ، وَلاَ أَحَدٌ مِنْ آلِ عُمَرَ ، یَا بُنَیَّ۔","","Musannaf Ibn Abi Shaybah 13565","","","كتاب الحج"
"13566",") حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَصُومُ یَوْمَ عَرَفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 13566","","","كتاب الحج"
"13567","(۱۳۵۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَصُومُ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 13567","","","كتاب الحج"
"13568","(۱۳۵۶۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَدْعُو بِشَرَابٍ فَتُفْطِرُ ، ثُمَّ تُفِیضُ۔","Hasan","Musannaf Ibn Abi Shaybah 13568","","","كتاب الحج"
"13569","(۱۳۵۶۹) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ مِسْعَرٍ، عَنْ عَبْدِاللہِ بْنِ شَرِیکٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یُفْطِرُ قَبْلَ أَنْ یُفِیضَ۔","Hasan","Musannaf Ibn Abi Shaybah 13569","","","كتاب الحج"
"13570","(۱۳۵۷۰) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یُفِیضَ دَعَا بِإِنَائٍ ، ثُمَّ شَرِبَ ، ثُمَّ أَفَاضَ۔","Sahih","Musannaf Ibn Abi Shaybah 13570","","","كتاب الحج"
"13571","(۱۳۵۷۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَتْ عَائِشَۃُ لاَ تُفِیضُ حَتَّی یَبْیَضَّ مَا بَیْنَہَا وَبَیْنَ النَّاسِ مِنَ الأَرْضِ۔","Hasan","Musannaf Ibn Abi Shaybah 13571","","","كتاب الحج"
"13572","(۱۳۵۷۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : یَقِفُ الإِنْسَان عَشِیَّۃَ عَرَفَۃَ بَعْدَ مَا یَدْفَعُ الإِمَامُ ، حَتَّی یَذْہَبَ زِحَامُ النَّاسِ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13572","","","كتاب الحج"
"13573","(۱۳۵۷۳) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ وَقَفَ مَعَ الإِمَامِ ، أَیَحْبِسُ رَاحِلَتَہُ وَقَدْ نَفَرَ الإِمَامُ حَتَّی یَذْہَبَ الزِّحَامُ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 13573","","","كتاب الحج"
"13574","(۱۳۵۷۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَی جَمْرَۃَ الْعَقَبَۃِ فَرَمَاہَا ، وَلَمْ یَقِفْ عِنْدَہَا۔ (احمد ۲/۱۹۰)","","Musannaf Ibn Abi Shaybah 13574","","","كتاب الحج"
"13575","(۱۳۵۷۵) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَرْمِی الْجَمْرَتَیْنِ وَیَقِفُ عِنْدَہُمَا ، وَلاَ یَقِفُ عِنْدَ الثَّالِثَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 13575","","","كتاب الحج"
"13576","(۱۳۵۷۶) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ ہَارُونَ بْنِ أَبِی عَائِشَۃَ ، عَنْ عَدِیِّ بْنِ عَدِیِّ ، عَنْ سَلْمَانَ بْنِ رَبِیعَۃَ ، قَالَ : نَظَرْنَا عُمَرَ فَأَتَی الْجَمْرَۃَ الثَّالِثَۃَ فَرَمَاہَا ، وَلَمْ یَقِفْ عِنْدَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13576","","","كتاب الحج"
"13577","(۱۳۵۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ مُجَاہِدٍ بْنِ رَاشِدٍ ، عَنْ سَعِیدِ بْنُ جُبَیْر ؛ أَنَّہ لَمْ یَقِفْ عِنْدَہَا۔","","Musannaf Ibn Abi Shaybah 13577","","","كتاب الحج"
"13578","(۱۳۵۷۸) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ فُضَیْلٍ ، وَعَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَمْرِو بْنِ الأَحْوَص ، عَنْ أُمِّہِ ، قَالَتْ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ النَّحْرِ أَتَی جَمْرَۃَ الْعَقَبَۃِ فَرَمَاہَا ، ثُمَّ انْصَرَفَ ، وَقَالَ بَعْضُہُمْ : لَمْ یَقِفْ ۔ زَادَ ابْنُ مُسْہِرٍ : فَرَمَاہَا سَبْعَ حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ۔ (ابوداؤد ۱۹۶۱۔ ابن ماجہ ۳۰۲۸)","Da'if","Musannaf Ibn Abi Shaybah 13578","","","كتاب الحج"
"13579","(۱۳۵۷۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یُقَامُ یَوْمَ النَّفْرِ عِنْدَ الْجِمَارِ۔","","Musannaf Ibn Abi Shaybah 13579","","","كتاب الحج"
"13580","(۱۳۵۸۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : یُقَامُ عِنْدَہَا قِیَامًا خَفِیفًا۔","","Musannaf Ibn Abi Shaybah 13580","","","كتاب الحج"
"13581","(۱۳۵۸۱) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ، عَنْ أَفْلَحَ ، قَالَ: رَأَیْتُ الْقَاسِمَ یَقُومُ عِنْدَ الْجِمَارِ یَوْمَ النَّفْرِ ، فَیَدْعُو وَیُخَفِّفُ، وَقَدْ کَانَ قَبْلَ ذَلِکَ یُطِیلُ۔","","Musannaf Ibn Abi Shaybah 13581","","","كتاب الحج"
"13582","(۱۳۵۸۲) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قیلَ لِعَبْدِ اللہِ : إِنَّ أُنَاسًا یَرْمُونَ الْجَمْرَۃَ مِنْ فَوْقِہَا ، فَاسْتَبْطَنَ الْوَادِیَ ثُمَّ قَالَ : مِنْ ہَاہُنَا ، وَالَّذِی لاَ إلَہَ غَیْرُہُ رَمَی الَّذِی أُنْزِلَتْ عَلَیْہِ سُورَۃُ الْبَقَرَۃِ۔ (بخاری ۱۷۴۷۔ مسلم ۳۰۷)","Sahih","Musannaf Ibn Abi Shaybah 13582","","","كتاب الحج"
"13583","(۱۳۵۸۳) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : حجَجْتُ مَعَ عُمَرَ سَنَتَیْنِ ، إحْدَاہُمَا فِی السَّنَۃِ الَّتِی أُصِیبَ فِیہَا ، کُلُّ ذَلِکَ یُلَبِّی حَتَّی یَرْمِیَ جَمْرَۃَ الْعَقَبَۃِ مِنْ بَطْنِ الْوَادِی۔","Sahih","Musannaf Ibn Abi Shaybah 13583","","","كتاب الحج"
"13584","(۱۳۵۸۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إذَا رَمَیْتَ الْجَمْرَۃَ فَتَقَدَّمَ إلَی بَطْنِ الْمَسِیلِ۔","","Musannaf Ibn Abi Shaybah 13584","","","كتاب الحج"
"13585","(۱۳۵۸۵) حدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ اسْتَبْطَنَ الْوَادِیَ۔","","Musannaf Ibn Abi Shaybah 13585","","","كتاب الحج"
"13586","(۱۳۵۸۶) حدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَعَطَائٍ، قَالا: کَانَ أَحَبَّ إلَیْہِمَا أَنْ یَرْمِیَاہَا مِنْ بَطْنِ الْوَادِی۔","","Musannaf Ibn Abi Shaybah 13586","","","كتاب الحج"
"13587","(۱۳۵۸۷) حدَّثَنَا ابْنُ مُسْہِرٍ ، وَابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَمْرِو بْنِ الأَحْوَصِ ، عَنْ أُمِّہِ، قَالَتْ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَی جَمْرَۃَ الْعَقَبَۃِ مِنْ بَطْنِ الْوَادِی۔","Da'if","Musannaf Ibn Abi Shaybah 13587","","","كتاب الحج"
"13588","(۱۳۵۸۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ وَبَرَۃَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ یَرْمِی جَمْرَۃَ الْعَقَبَۃِ مِنْ فَوْقِہَا۔","","Musannaf Ibn Abi Shaybah 13588","","","كتاب الحج"
"13589","(۱۳۵۸۹) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : کَیْفَ أَرْمِی الْجَمْرَتَیْنِ الْقُصْوَیَیْنِ ؟ قَالَ : اعلُہمَا عُلْوًا ، ثُمَّ تَفْرَعُہُمَا۔","","Musannaf Ibn Abi Shaybah 13589","","","كتاب الحج"
"13590","(۱۳۵۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ شَیْخٍ مِنْ أَہْلِ الْبَصْرَۃِ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَرْمِی الْجَمْرَۃَ مِنْ فَوْقِہَا۔","","Musannaf Ibn Abi Shaybah 13590","","","كتاب الحج"
"13591","(۱۳۵۹۱) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنْ زُہَیْرٍ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ، عَن أَصْحَابِ عَبْدِ اللہِ ؛ أَنَّہُمْ کَانُوا یَرْمُونَ الْجَمْرَتَیْنِ الأُوْلَیَیْنِ مِنْ فَوْقِہَا ، یَرْمُونَ أَعْلَی شَیْئٍ مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 13591","","","كتاب الحج"
"13592","(۱۳۵۹۲) حدَّثَنَا وَکِیعٌ، عَنْ مَالِکِ بْنِ أَنَسٍ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ، عَنْ أَبِیہِ، قَالَ: اِرْمِہمَا مِنْ حَیْثُ تَیَسَّرَ۔","","Musannaf Ibn Abi Shaybah 13592","","","كتاب الحج"
"13593","(۱۳۵۹۳) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ الْقَاسِمَ ، وَسَالِمًا ، وَنَافِعًا یَرْمُونَ مِنَ الشَّجَرَۃِ ، فَأَمَّا الْقَاسِمُ فَکَانَ یَقُومُ بَیْنَہَا وَبَیْنَ مَکَّۃَ ، یَجْعَلُ مَکَّۃَ خَلْفَ ظَہْرِہِ مُسْتَقْبِلَہَا ، وَأَمَّا سَالِمٌ وَنَافِعٌ فَکَانَا یَقُومَانِ أَدْنَی مِنْ مَقَامِہِ۔","","Musannaf Ibn Abi Shaybah 13593","","","كتاب الحج"
"13594","(۱۳۵۹۴) حدَّثَنَا وَکِیعٌ ، عَنِ الْبَرَائِ بْنِ سُلَیْمٍ ، قَالَ : سَأَلْتُ الْحَکَمَ أَیْنَ أَرْمِی مِنَ الْجَمْرَۃِ ؟ قَالَ : أَصْلَہَا۔","","Musannaf Ibn Abi Shaybah 13594","","","كتاب الحج"
"13595","(۱۳۵۹۵) حدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ اسْتَقْبَلَہَا وَرَمَی سَاقَہَا۔","","Musannaf Ibn Abi Shaybah 13595","","","كتاب الحج"
"13596","(۱۳۵۹۶) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَبْدَأُ فَیَرْمِی رَأْسَ الْجَمْرَۃِ الأُولَی ، وَیَرْمِی الوسطی یَرْمِی رَأْسَہَا ، وَیَرْمِی الْعَقَبَۃَ حَیْثُ دَنَا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 13596","","","كتاب الحج"
"13597","(۱۳۵۹۷) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : إذَا جَاوَزَ الشَّجَرَۃَ رَمَی جَمْرَۃَ الْعَقَبَۃِ مِنْ تَحْتِ غُصْنٍ مِنْ أَغْصَانِہَا۔","","Musannaf Ibn Abi Shaybah 13597","","","كتاب الحج"
"13598","(۱۳۵۹۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أّنَّہُ کَانَ یَقُولُ فِی الْمَرْأَۃِ إذَا حَاضَتْ بَعْدَ مَا تَطُوفُ بِالْبَیْتِ أَشْوَاطًا : فَإِنَّہَا تُقِیمُ حَتَّی تَطْہُرَ وَتَسْتَقْبِلَ الطَّوَافَ۔","","Musannaf Ibn Abi Shaybah 13598","","","كتاب الحج"
"13599","(۱۳۵۹۹) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا طَافَتِ الْمَرْأَۃُ ثَلاَثَۃَ أَطْوَافٍ فَصَاعِدًا ثُمَّ حَاضَتْ ، أَجْزَأَ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 13599","","","كتاب الحج"
"13600","(۱۳۶۰۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ قَالَ فِی الْمَرْأَۃِ تَطُوفُ ثَلاَثَۃَ أَشْوَاطٍ ثُمَّ تَحِیضُ، قَالَ : تَعْتَدُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 13600","","","كتاب الحج"
"13601","(۱۳۶۰۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ إِیَاسٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن رَجُلٍ طَافَ بِالْبَیْتِ ، فَبَقِیَ عَلَیْہِ مِنْ طَوَافِہِ فَأَحْدَثَ ، أَوِ امْرَأَۃٍ طَافَتْ فَحَاضَتْ ، وَقَدْ بَقِیَ عَلَیْہَا مِنْ طَوَافِہَا ، مِنْ أَیْنَ تَسْتَقْبِلُ ؟ قَالَ : مِنْ حَیْثُ حَاضَتْ۔","","Musannaf Ibn Abi Shaybah 13601","","","كتاب الحج"
"13602","(۱۳۶۰۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : تَسْتَقْبِلُ الطَّوَافَ أَحَبَّ إلَیَّ ، وَإِنْ فَعَلَتْ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13602","","","كتاب الحج"
"13603","(۱۳۶۰۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَنْتِفُ مِنْ عَیْنَیْہِ الشَّعَرَ وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 13603","","","كتاب الحج"
"13604","(۱۳۶۰۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ أَنَّہُمْ قَالُوا فِی الْمُحْرِمِ : إذَا نَتَفَ إبِطَہُ ، أَوْ قَلَّمَ أَظْفَارَہُ فَإِنَّ عَلَیْہِ الْفِدْیَۃَ۔","","Musannaf Ibn Abi Shaybah 13604","","","كتاب الحج"
"13605","(۱۳۶۰۵) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، رَفَعَہُ ، قَالَ : مَنْ کَانَ أَہْلُہُ دُونَ الْمِیقَاتِ أَہَلَّ مِنْ حَیْثُ یُنْشِیئُ ، حَتَّی یَأْتِیَ ذَلِکَ عَلَی أَہْلِ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13605","","","كتاب الحج"
"13606","(۱۳۶۰۶) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوس ، وَعَطَائٍ ، وَمُجَاہِدٍ قَالُوا : إِنْ کَانَ أَہْلُہُ بَیْنَ الْوَقْتِ وَبَیْنَ مَکَّۃَ ، أَہَلَّ مِنْ أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 13606","","","كتاب الحج"
"13607","(۱۳۶۰۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إذَا کَانَ أَہْلُہُ دُونَ الْمِیقَاتِ أَنْ یُحْرِمَ مِنْ أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 13607","","","كتاب الحج"
"13608","(۱۳۶۰۸) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ أَہْلُہُ دُونَ الْمِیقَاتِ أَہَلَّ مِنْ حَیْثُ یُنْشِیئُ۔","","Musannaf Ibn Abi Shaybah 13608","","","كتاب الحج"
"13609","(۱۳۶۰۹) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ الرَّجُلُ أَنْ یَرْمِیَ جَمْرَۃَ الْعَقَبَۃِ یَوْمَ النَّحْرِ حَتَّی یُمْسِیَ ، رَمَاہَا مِنَ الْغَدِ ، وَأَہْرَاقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 13609","","","كتاب الحج"
"13610","(۱۳۶۱۰) حدَّثَنَا جَرِیرٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَقُولُ : إذَا تَرَکَ جَمْرَۃَ الْعَقَبَۃِ إلَی اللَّیْلِ مُتَعَمِّدًا ، فَعَلَیْہِ دَمٌ ، وَقَالَ : یَرْمِی مِنَ الْغَدِ۔","","Musannaf Ibn Abi Shaybah 13610","","","كتاب الحج"
"13611","(۱۳۶۱۱) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ رَجُلٍ نَسِیَ حَصَاۃً ، أَوْ حَصَاتَیْنِ ، أَوْ جَمْرَۃً ، أَوْ جَمْرَتَیْنِ ؟ قَالاَ : یُہْرِیقُ دَمًا۔","","Musannaf Ibn Abi Shaybah 13611","","","كتاب الحج"
"13612","(۱۳۶۱۲) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ فِی الرَّجُلِ یَتْرُکُ رَمْیَ جَمْرَۃٍ وَاحِدَۃٍ ، قَالَ: یُطْعِمُ مِسْکِینًا۔","","Musannaf Ibn Abi Shaybah 13612","","","كتاب الحج"
"13613","(۱۳۶۱۳) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : مَا أُبَالِی رَمَیْتُ الْجِمَارَ بِسِتٍّ ، أَوْ سَبْعٍ۔وَقَالَ ابْنُ عَبَّاسٍ : رَمَیْنَا فِی الْجَاہِلِیَّۃِ بِسَبْعٍ ، وَفِی الإِسْلاَمِ بِسَبْعٍ۔","","Musannaf Ibn Abi Shaybah 13613","","","كتاب الحج"
"13614","(۱۳۶۱۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ فِیمَنْ رَمَی سِتًّا ، قَالَ طَاوُوسٌ: یَتَصَدَّقُ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 13614","","","كتاب الحج"
"13615","(۱۳۶۱۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 13615","","","كتاب الحج"
"13616","(۱۳۶۱۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَأَلْتُ عَطَائً عَنْ رَجُلٍ رَمَی بِخَمْسِ حَصَیَاتٍ ؟ قَالَ : یَرْمِی بِمَا بَقِیَ ، إِلاَّ أَنْ تَکُونَ ذَہَبَتْ أَیَّامُ التَّشْرِیقِ ، فإِن کَانَ ذَہَبَتْ أَیَّامُ التَّشْرِیقِ أَہْرَاقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 13616","","","كتاب الحج"
"13617","(۱۳۶۱۷) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَرْمِی الْجِمَارَ بِسِتٍّ ، قَالَ : یَسْتَأْنِفُ۔","","Musannaf Ibn Abi Shaybah 13617","","","كتاب الحج"
"13618","(۱۳۶۱۸) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنِ ابْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَرْمِیَ بِحَصَی قَدْ رُمِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13618","","","كتاب الحج"
"13619","(۱۳۶۱۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : ارْمِ إِنْ شِئْتَ بِمَا رُمِیَ بِہِ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 13619","","","كتاب الحج"
"13620","(۱۳۶۲۰) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ یَکْرَہُ ، أَوْ یُکْرَہُ ، أَنْ یَرْمِیَ بِحَصَی بِالْجِمَارِ الَّذِی قَدْ رُمِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13620","","","كتاب الحج"
"13621","(۱۳۶۲۱) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ : سَقَطَتْ حَصَاۃٌ ، أَوْ حَصَیَاتٌ ؟ قَالَ : خُذْہَا مِنْ تَحْتِ رِجْلَیْک۔","","Musannaf Ibn Abi Shaybah 13621","","","كتاب الحج"
"13622","(۱۳۶۲۲) حدَّثَنَا مَحْبُوبٌ الْقَوَارِیرِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ الأَسْلَمِیِّ ، عنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَمَّا بَلَغْنَا وَادِیَ مُحَسِّرٍ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذُوا حَصَی الْجِمَارِ مِنْ وَادِی مُحَسِّرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13622","","","كتاب الحج"
"13623","(۱۳۶۲۳) حدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ مُجَاہِدٍ، قَالَ: کَانَ یُحْمَلُ الْحَصَی مِنَ الْمُزْدَلِفَۃِ لِرَمْیِ الْجِمَارِ۔","","Musannaf Ibn Abi Shaybah 13623","","","كتاب الحج"
"13624","(۱۳۶۲۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : قَالَ لَنَا سَعِیدُ بْنُ جُبَیْرٍ : خُذُوا الْحَصَی مِنْ حَیْثُ شِئْتُمْ۔","","Musannaf Ibn Abi Shaybah 13624","","","كتاب الحج"
"13625","(۱۳۶۲۵) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : الَّذِی یَرْمِی یَأْخُذُ الْحَصَی مِنْ جَمْعٍ۔","","Musannaf Ibn Abi Shaybah 13625","","","كتاب الحج"
"13626","(۱۳۶۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ مَکْحُولٍ ، قَالَ : خُذْہُ مِنَ الْمُزْدَلِفَۃِ۔","","Musannaf Ibn Abi Shaybah 13626","","","كتاب الحج"
"13627","(۱۳۶۲۷) حدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ حُمَیْدٍ، عَنْ بَکْرٍ؛ أَنَّہُ کَانَ یَحْمِلُ حَصَی الْجِمَارِ مِنَ الْمُزْدَلِفَۃِ۔","","Musannaf Ibn Abi Shaybah 13627","","","كتاب الحج"
"13628","(۱۳۶۲۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : خُذْہُ مِنْ حَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13628","","","كتاب الحج"
"13629","(۱۳۶۲۹) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَانَ یَأْخُذُ حَصَی الْجِمَارِ مِنَ الْمُزْدَلِفَۃِ۔","","Musannaf Ibn Abi Shaybah 13629","","","كتاب الحج"
"13630","(۱۳۶۳۰) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : کُنَّا نَلْتَقِطُ لِلأَسْوَدِ حَصَی وَنَحْنُ مُنْطَلِقُونَ إلَی عَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 13630","","","كتاب الحج"
"13631","(۱۳۶۳۱) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ أَبِیہِ ، قَالَ : أَفَضْتُ مَعَ عَبْدِ اللہِ ، فَلَمَّا انْتَہَیْنَا إلَی الْجَمْرَۃِ ، قَالَ : اُلْقُطْ لِی ، فَنَاوَلْتُہُ سَبْعَ حَصَیَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13631","","","كتاب الحج"
"13632","(۱۳۶۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : خُذْ حَصَی الْجِمَارِ مِنْ حَیْثُ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13632","","","كتاب الحج"
"13633","(۱۳۶۳۳) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنْ زِیَادِ بْنِ الْحُصَیْنِ، قَالَ: حدَّثَنَا أَبُو الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَدَاۃَ الْعَقَبَۃِ : اُلْقُطْ لِی حَصَیَاتٍ ، قَالَ : فَلَقَطْتُ لَہُ حَصَیَاتٍ مِثْلَ حَصَی الْخَذْفِ ، فَقَالَ : بِمِثْلِ ہَؤُلاَئِ فَارْمُوا۔ (نسائی ۴۰۶۵۔ احمد ۱/۳۴۷)","Sahih","Musannaf Ibn Abi Shaybah 13633","","","كتاب الحج"
"13634","(۱۳۶۳۴) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُلَبِّی فَیَقُولُ : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إِنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ وَالْمُلْکَ ، لاَ شَرِیکَ لَکَ۔ (بخاری ۱۵۴۹۔ ابوداؤد ۱۸۰۸)","Sahih","Musannaf Ibn Abi Shaybah 13634","","","كتاب الحج"
"13635","(۱۳۶۳۵) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ ، وَیَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (مسلم ۸۴۲)","Sahih","Musannaf Ibn Abi Shaybah 13635","","","كتاب الحج"
"13636","(۱۳۶۳۶) حدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَہَلَّ بِالتَّوْحِیدِ : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ وَالْمُلْکَ ، لاَ شَرِیکَ لَک۔","Sahih","Musannaf Ibn Abi Shaybah 13636","","","كتاب الحج"
"13637","(۱۳۶۳۷) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی عَطِیَّۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ: حفِظْت مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَمَا کَانَ یُلَبِّی : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ۔ (بخاری ۱۵۵۰۔ احمد ۶/۲۳۰)","Sahih","Musannaf Ibn Abi Shaybah 13637","","","كتاب الحج"
"13638","(۱۳۶۳۸) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی التَّلْبِیَۃِ بِمِثْلِ ہَذَا ، یَعْنِی مِثْلَ قَوْلِ جَابِرٍ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : انْتَہِ إِلَیْہَا ، فَإِنَّہَا تَلْبِیَۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 13638","","","كتاب الحج"
"13639","(۱۳۶۳۹) حدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَبَانَ بْنِ تَغْلِبَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ عَبْدِ الرَّحْمَنِ بن یزید قَالَ : کَانَ عَبْدُ اللہِ یَقُولُ فِی تَلْبِیَتِہِ : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ وَالْمُلْکَ ، وَیَقُولُ ہَکَذَا کَانَتْ تَلْبِیَۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(مسلم ۲۷۰۔ احمد ۱/۴۱۰)","Sahih","Musannaf Ibn Abi Shaybah 13639","","","كتاب الحج"
"13640","(۱۳۶۴۰) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی سَلَمَۃَ ، قَالَ : سَمِعَ سَعْدُ بْنُ أَبِی وَقَّاصٍ رَجُلاً یَقُولُ : لَبَّیْکَ ذَا الْمَعَارِجِ ، فَقَالَ : سَعْدٌ : لَبَّیْکَ ذَا الْمَعَارِجِ ، إِنَّہُ ذُو الْمَعَارِجِ ، وَلَمْ نَکُنْ نَقُولُ ہَذَا عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۱/۱۷۲۔ ابویعلی ۷۲۰)","","Musannaf Ibn Abi Shaybah 13640","","","كتاب الحج"
"13641","(۱۳۶۴۱) حدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْفَضْلِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ فِی تَلْبِیَتِہِ : لَبَّیْکَ إلَہَ الْحَقِ لَبَّیْکَ۔ n(احمد ۲/۷۷۶۔ طیالسی ۲۳۷۷)","Sahih","Musannaf Ibn Abi Shaybah 13641","","","كتاب الحج"
"13642","(۱۳۶۴۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ عَبْدُ اللہِ یُعَلِّمُنَا ہَذِہِ التَّلْبِیَۃَ : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ۔","Sahih","Musannaf Ibn Abi Shaybah 13642","","","كتاب الحج"
"13643","(۱۳۶۴۳) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانُوا یَقُولُونَ ہَذِہِ الثَّلاَث ، قَالَ : وَکَانَ الأَسْوَدُ یَقُولُہَا ، وَیَزِیدُ : وَالْمُلْکَ ، لاَشَرِیک لَک۔","","Musannaf Ibn Abi Shaybah 13643","","","كتاب الحج"
"13644","(۱۳۶۴۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : أَفَاضَ عُمَرُ عَشِیَّۃَ یَوْمِ عَرَفَۃَ عَلَی جَمَلٍ أَحْمَرَ ، وَقَدْ قَصُرَ رَأْسُ رَاحِلَتِہِ حَتَّی کَادَتْ تُصِیبُ وَاسِطَۃَ الرَّحْلِ ، قَالَ : وَہُوَ یُلَبِّی بِثَلاَثٍ ؛ لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَشَرِیکَ لَکَ لَبَّیْکَ ، إِنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ ، وَکَانَ یَسِیرُ الْعَنَقَ ، وَإِذَا مَرَّ بِحَبْلٍ مِنَ الْحِبَالِ رَفَعَ یَدَیْہِ فَکَبَّرَ۔","Sahih","Musannaf Ibn Abi Shaybah 13644","","","كتاب الحج"
"13645","(۱۳۶۴۵) حدَّثَنَا عَبْدَۃُ ، وَأَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ، قَالَ : کَانَتْ تَلْبِیَۃُ عُمَرَ : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَشَرِیکَ لَکَ لَبَّیْکَ ، إِنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ وَالْمُلْکَ ، لاَشَرِیکَ لَکَ لَبَّیْکَ، مَرْغُوبًا ، وَمَرْہُوبًا إِلَیْکَ ، لَبَّیْکَ ذَا النَّعْمَائِ وَالْفَضْلِ الْحَسَنِ۔n قَالَ عَبْدَۃُ : قَالَ ہِشَامٌ : یُبْدِئُ ذَلِکَ وَیُعِیدُہُ۔n زَادَ أَبُو خَالِدٍ الأحمر : قَالَ : وَکَانَ أَبِی - یَعْنِی ہِشَامًا عَنْ أَبِیہِ - یُلَبِّی کَذَلِکَ إِلاَّ أَنَّ أَبَا خَالِدٍ لَمْ یَقُلْ : یُبْدِئُ ذَلِکَ وَیُعِیدُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13645","","","كتاب الحج"
"13646","(۱۳۶۴۶) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَزِیدُ مِنْ عِنْدِہِ : لَبَّیْکَ وَالرَّغْبَائُ إلَیْک وَالْعَمَلُ ، لَبَّیْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 13646","","","كتاب الحج"
"13647","(۱۳۶۴۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَحْیَی ، وَعُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : تَلَقَّفْتُہُنََّ مِنْ فِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إِنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ وَالْمُلْکَ، لاَشَرِیکَ لَکَ ، قَالَ : وَکَانَ ابْنُ عُمَرَ یَزِیدُ : وَالرَّغْبَائُ إلَیْکَ وَالْعَمَلُ ، لَبَّیْکَ وَسَعْدَیْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 13647","","","كتاب الحج"
"13648","(۱۳۶۴۸) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : لَکَأَنِّی أَنْظُرُ إلَی وَبِیصِ الطِّیبِ مِنْ رَأْسِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَہُوَ محرم۔ (بخاری ۲۷۱۔ مسلم ۸۴۷)","Sahih","Musannaf Ibn Abi Shaybah 13648","","","كتاب الحج"
"13649","(۱۳۶۴۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَأَنِّی أَنْظُرُ إلَی وَبِیصِ الطِّیبِ فِی مَفَارِقِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَہُوَ یُہِلُّ۔ (مسلم ۸۴۸)","Sahih","Musannaf Ibn Abi Shaybah 13649","","","كتاب الحج"
"13650","(۱۳۶۵۰) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَطَیَّبُ قَبْلَ أَنْ یُحْرِمَ ، فَیُرَی أَثَرُ الطِّیبِ فِی مَفْرِقِہِ بَعْدَ ذَلِکَ بِثَلاَثٍ۔ (نسائی ۳۶۸۳۔ ابن ماجہ ۲۹۲۸)","Hasan","Musannaf Ibn Abi Shaybah 13650","","","كتاب الحج"
"13651","(۱۳۶۵۱) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَرَادَ أَنْ یُحْرِمَ ادَّہَنَ بِأَطْیَبِ دُہْنٍ یَجِدُہُ، حَتَّی أَرَی وَبِیصَہُ فِی لِحْیَتِہِ وَرَأْسِہِ۔ (نسائی ۳۶۸۰)","Sahih","Musannaf Ibn Abi Shaybah 13651","","","كتاب الحج"
"13652","(۱۳۶۵۲) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُثْمَانَ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ عَائِشَۃَ : بِأَیِّ شَیْئٍ طَیَّبْتِ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَتْ : بِأَطْیَبِ الطِّیبِ ، وَقَالَتْ : عِنْدَ إِحْلاَلِہِ قَبْلَ أَنْ یُحْرِمَ۔n(بخاری ۵۹۳۰۔ مسلم ۳۷)","Sahih","Musannaf Ibn Abi Shaybah 13652","","","كتاب الحج"
"13653","(۱۳۶۵۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : رَأَیْتُ بَصِیصَ الطِّیبِ فِی مَفَارِقِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ ثَلاَثٍ ، وَہُوَ مُحْرِمٌ۔ (نسائی ۳۶۸۲)","Da'if","Musannaf Ibn Abi Shaybah 13653","","","كتاب الحج"
"13654","(۱۳۶۵۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ بَسَطَتْ یَدَیْہَا وَقَالَتْ : طَیَّبْتُہُ بِیَدَیَّ ہَاتَیْنِ مُحْرَمہ حِینَ أَحْرَمَ ، وَمَحِلَّہ قَبْلَ أَنْ یَطُوفَ بِالْبَیْتِ۔ (بخاری ۱۵۳۹۔ ترمذی ۹۱۷)","Sahih","Musannaf Ibn Abi Shaybah 13654","","","كتاب الحج"
"13655","(۱۳۶۵۵) حدَّثَنَا شَرِیکٌ ، عَنْ عَمَّارٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ؛ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ إذَا أَحْرَمَ ادَّہَنَ بِالزَّیْتِ ، وَدَہَنَ أَصْحَابَہُ بِالطِّیبِ أوْ بِدُہْنِ الطِّیبَ۔","","Musannaf Ibn Abi Shaybah 13655","","","كتاب الحج"
"13656","(۱۳۶۵۶) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہَاشِمِ بْنِ ہَاشِمٍ ، عَنْ عَائِشَۃَ ابْنَۃِ سَعْدٍ ، قَالَتْ : کَانَ سَعْدٌ یَتَطَیَّبُ عِنْدَ الإِحْرَامِ بِالذَّرِیرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13656","","","كتاب الحج"
"13657","(۱۳۶۵۷) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ جَعْفَرٍ یَمُوثُ الْمِسْکَ ، ثُمَّ یَجْعَلُہُ عَلَی یَافُوخِہِ قَبْلَ أَنْ یُحْرِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 13657","","","كتاب الحج"
"13658","(۱۳۶۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ کَثِیرِ بْنِ سَامٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ؛ أَنَّہُ کَانَ یُغَلِّفُ رَأْسَہُ بِالْغَالِیَۃِ الْجَیِّدَۃِ ، إِذَا أَرَادَ أَنْ یُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 13658","","","كتاب الحج"
"13659","(۱۳۶۵۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أُمِّہِ قَالَتْ : رَأَیْتُ عَائِشَۃَ تَنْکُتُ فِی مَفَارِقِہَا الطیِّبَ قَبْلَ أَنْ تُحْرِمَ ، ثُمَّ تُحْرِمُ۔","Da'if","Musannaf Ibn Abi Shaybah 13659","","","كتاب الحج"
"13660","(۱۳۶۶۰) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مُسْلِمِ بْنِ أَبِی مَرْیَمَ ، عْن عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّہُ کَانَ یَدَّہِنُ بِالسَّلِیخَۃِ عِنْدَ الإِحْرَامِ۔","","Musannaf Ibn Abi Shaybah 13660","","","كتاب الحج"
"13661","(۱۳۶۶۱) حدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ عِیسَی بْنِ حَفْصٍ ، عَنْ عُثْمَانَ بْنِ عُرْوَۃَ ، قَالَ : کَانَ عُرْوَۃُ یُجَمِّرُ ثِیَابَہُ عِشائً ، فَلاَ یَزَالُ حَتَّی یَرُوحَ فِیہَا الْمَسْجِدَ وَیُحْرِمَ فِیہَا ، قَالَ : وَکَانَ یَرَی لِحَانَا تَقْطُرُ مِنَ الْغَالِیَۃِ وَنَحْنُ مُحْرِمُونَ ، فَلاَ یُنْکِرُ ذَلِکَ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 13661","","","كتاب الحج"
"13662","(۱۳۶۶۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ الزُّبَیْرِ وَفِی رَأْسِہِ وَلِحْیَتِہِ مِنَ الطِّیبِ وَہُوَ مُحْرِمٌ ، مَا لَوْ کَانَ لِرَجُلٍ لاَتَّخَذَ مِنْہُ رَأْسَ مَالٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13662","","","كتاب الحج"
"13663","(۱۳۶۶۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ ابْنَ الزُّبَیْرِ کَانَ یَدَّہِنُ عِنْدَ إحْرَامِہِ بِالْغَالِیَۃِ الْجَیِّدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13663","","","كتاب الحج"
"13664","(۱۳۶۶۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی یَتَطَیَّبُ عِنْدَ الإِحْرَامِ بِالذَّرِیرَۃِ وَالْبَانِ۔","","Musannaf Ibn Abi Shaybah 13664","","","كتاب الحج"
"13665","(۱۳۶۶۵) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ ابْنَ عَبَّاسٍ کَانَ لاَ یَرَی بَأْسًا بِالطَّیِّبِ عِنْدَ إحْرَامِہِ، وَیَوْمَ النَّحْرِ قَبْلَ أَنْ یَزُورَ۔","Sahih","Musannaf Ibn Abi Shaybah 13665","","","كتاب الحج"
"13666","(۱۳۶۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنِّی لأصَغْصِغُہُ فِی رَأْسِی قَبْلَ أَنْ أُحْرِمَ، وَأَحَبَّ بَقَائَہُ ، وَقَالَ ابْنُ الزُّبَیْرِ: لاَ أَرَی بِہِ بَأْسًا ، وَقَالَ ابْنُ عُمَرَ : لاَ آمُرُ بِہِ ، وَلاَ أَنْہَی عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13666","","","كتاب الحج"
"13667","(۱۳۶۶۷) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یدَّہنُ الرَّجُلُ بِکُلِّ شَیْئٍ عِنْدَ الإِحْرَامِ ، إِلاَّ الْمُؤَنَّثَ ، الْمُؤَنَّث السَّاہِرَیۃُ وَالْمَلاَبُ۔","Sahih","Musannaf Ibn Abi Shaybah 13667","","","كتاب الحج"
"13668","(۱۳۶۶۸) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَأَنِّی أَنْظُرُ إلَی وَبِیصِ الطِّیبِ فِی مَفَارِقِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَہُوَ یُلَبِّی۔ (مسلم ۴۱۔ احمد ۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 13668","","","كتاب الحج"
"13669","(۱۳۶۶۹) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنْتُ أُطَیِّبُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِنْدَ إحْرَامِہِ ، بِأَطْیَبِ مَا أَجِدُ۔ (احمد ۶/۲۰۷۔ ابن حبان ۳۷۷۲)","Sahih","Musannaf Ibn Abi Shaybah 13669","","","كتاب الحج"
"13670","(۱۳۶۷۰) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِیہِ ، عَنْ عَلْقَمَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : طَیَّبْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِحرمہِ حِینَ أَحْرَمَ ، وَلِحِلِّہِ حِینَ حَلَّ ، قَبْلَ أَنْ یَطُوفَ بِالْبَیْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 13670","","","كتاب الحج"
"13671","(۱۳۶۷۱) حدَّثَنَا أَبُو أُسَامَۃَ ، وَوَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ کَانَ یَتَطَیَّبُ بِالْغَالِیَۃِ الْجَیِّدَۃِ عِنْدَ إحْرَامِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 13671","","","كتاب الحج"
"13672","(۱۳۶۷۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، أَنَّ عَلْقَمَۃَ ، وَالأَسْوَدَ کَانَا یَحُجَّانِ مَعَ عَبْدِ اللہِ بْنِ الْحَارِثِ أَخِی الأَشْتَرِ ، فَکَانَ یَکْفِیہِمْ نَفَقَتَہُمْ۔","","Musannaf Ibn Abi Shaybah 13672","","","كتاب الحج"
"13673","(۱۳۶۷۳) حدَّثَنَا الْبَکْرَاوِیُّ ، عَنْ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا مُحَمَّدٌ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَحُجُّ بَعْضُہُمْ بِبَعْضٍ ، فَیُجْزِئُ ذَلِکَ عَنْہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 13673","","","كتاب الحج"
"13674","(۱۳۶۷۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ ؛ أَنَّ عُمَرَ وَجَدَ رِیحَ طِیبٍ وَہُوَ بِذِی الْحُلَیْفَۃِ ، فَقَالَ : مِمَّنْ ہَذَا ؟ فَقَالَ مُعَاوِیَۃُ : مِنِّی ، فَقَالَ : أَمِنْکَ لَعَمْرِی ؟ قَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، لاَ تَعْجَلْ عَلَیَّ ، فَإِنَّ أُمَّ حَبِیبَۃَ طَیَّبَتْنِی وَأَقْسَمَتْ عَلَیَّ ، قَالَ : وَأَنَا أُقْسِمُ عَلَیْک لَتَرْجِعَنَّ إلَیْہَا ، فَلْتَغْسِلَنَّہُ عَنْکَ کَمَا طَیَّبَتْکَ ، قَالَ : فَرَجَعَ إلَیْہَا حَتَّی لَحِقَہُمْ بِبَعْضِ الطَّرِیقِ۔","Sahih","Musannaf Ibn Abi Shaybah 13674","","","كتاب الحج"
"13675","(۱۳۶۷۵) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ عُمَرَ دَعَا بِثَوْبٍ ، فَأُتِیَ بِثَوْبٍ فِیہِ رِیحُ طِیْبٍ فَرَدَّہُ۔","","Musannaf Ibn Abi Shaybah 13675","","","كتاب الحج"
"13676","(۱۳۶۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ؛ أَنَّ إبْرَاہِیمَ رَأَی رَجُلاً قَدْ تَطَیَّبَ عِنْدَ الإِحْرَامِ ، فَأَمَرَہُ أَنْ یَغْسِلَ رَأْسَہُ بِطِینٍ۔","","Musannaf Ibn Abi Shaybah 13676","","","كتاب الحج"
"13677","(۱۳۶۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : حجَجْتُ مَرَّۃً فَوَافَقْتُ عَبْدَ الرَّحْمَن بْنَ عَمْرِو بْنَ الْعَاصِ ، فَلَمَّا کَانَ عِنْدَ الإِحْرَامِ أَصَبْنَا شَیْئًا مِنَ الطِّیبِ ، فَقَالَ لِی عَبْدُ الرَّحْمَنِ : وَدِدْتُ أَنَّکَ لَمْ تَفْعَلْ ، إنِّی حَجَجْتُ مَرَّۃً مَعَ عُثْمَانَ بْنِ أَبِی الْعَاصِ فَأَحْرَمَ مِنَ المَنْجَشانیۃ ، وَہِیَ قَرِیبَۃٌ مِنَ الْبَصْرَۃِ ، وَقَالَ لَنَا : عَلَیْکُمْ بِہَذَا الطِّینِ الأَبْیَضِ ، فَاغْسِلُوا بِہِ رُؤُوسَکُمْ عِنْدَ الإِحْرَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 13677","","","كتاب الحج"
"13678","(۱۳۶۷۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَطَیَّبَ الرَّجُلُ عِنْدَ إحْرَامِہِ۔","","Musannaf Ibn Abi Shaybah 13678","","","كتاب الحج"
"13679","(۱۳۶۷۹) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ مِثْلَ ذَلِکَ ، وَیُحِبُّ أَنْ یَجِیئَ أَشْعَثَ أَغْبَرَ۔","","Musannaf Ibn Abi Shaybah 13679","","","كتاب الحج"
"13680","(۱۳۶۸۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ الطِّیبَ عِنْدَ الإِحْرَامِ ، وَقَالَ : إِنْ کَانَ بِہِ شَیْئٌ مِنْہُ فَلْیَغْسِلْہُ وَلِیُنْقِہِ۔","","Musannaf Ibn Abi Shaybah 13680","","","كتاب الحج"
"13681","(۱۳۶۸۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یُحْرِمَ تَرَکَ إجْمَارَ ثِیَابِہِ قَبْلَ ذَلِکَ بِخَمْسۃَ عَشَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 13681","","","كتاب الحج"
"13682","(۱۳۶۸۲) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَکْرَہُ لِلْمُحْرِمِ حِینَ یُحْرِمُ أَنْ یَدَّہِنَ بِدُہْنٍ فِیہِ مِسْکٌ ، أَوْ أَفْوَاہٌ ، أَوْ عَبِیرٍ۔","","Musannaf Ibn Abi Shaybah 13682","","","كتاب الحج"
"13683","(۱۳۶۸۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، أَنَّ سَعِیدَ بْنَ جُبَیْرٍ کَانَ یَتَّقِی الطِّیبَ إذَا أَرَادَ أَنْ یُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 13683","","","كتاب الحج"
"13684","(۱۳۶۸۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ وَبَرَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وَجَدَ عُمَرُ بْنُ الْخَطَّابِ رِیحًا عِنْدَ الإِحْرَامِ ، فَتَوَعَّدَ صَاحِبَہَا ، فَرَجَعَ مُعَاوِیَۃُ فَأَلْقَی مِلْحَفَۃً کَانَتْ عَلَیْہِ ، یَعْنِی مُطَیَّبَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 13684","","","كتاب الحج"
"13685","(۱۳۶۸۵) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، وَسُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : لأَنْ أُصْبِحَ ، یَعْنِی مَطْلِیًا بِقَطِرَانٍ أَحَبَّ إلَیَّ مِنْ أَنْ أُصْبِحَ مُحْرِمًا ، أَنْضَخُ طِیبًا۔","Sahih","Musannaf Ibn Abi Shaybah 13685","","","كتاب الحج"
"13686","(۱۳۶۸۶) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنْ بُشَیْرِ بْنِ یَسَارٍ الأَنْصَارِیِّ ، قَالَ : لَمَّا أَحْرَمُوا وَجَدَ عُمَرُ رِیحَ طِیبٍ ، فَقَالَ : مِمَّنْ ہَذَہِ الرِّیحُ ؟ فَقَالَ الْبَرَائُ بْنُ عَازِبٍ : مِنِّی ، یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : قَدْ عَلِمْنَا أَنَّ امْرَأَتَکَ عَطِرَۃٌ ، أَوْ عَطَّارَۃٌ ، إِنَّمَا الْحَاجُّ الأَذْفَرُ الأَغْبَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 13686","","","كتاب الحج"
"13687","(۱۳۶۸۷) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الرَّجُلِ یُصِیبُہُ مِنْ طِیبِ الْکَعْبَۃِ ؟ فَقَالَ : لاَ یَضُرُّہُ۔","","Musannaf Ibn Abi Shaybah 13687","","","كتاب الحج"
"13688","(۱۳۶۸۸) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ صَالِحِ بْنِ حَیَّانَ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ أَصَابَ ثَوْبَہُ مِنْ خَلُوقِ الْکَعْبَۃِ وَہُوَ مُحْرِمٌ ، فَلَمْ یَغْسِلْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 13688","","","كتاب الحج"
"13689","(۱۳۶۸۹) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ خَارِجًا مِنَ الْکَعْبَۃِ ، وَقَدْ تَلَطَّخَ صَدْرُہُ مِنْ طِیبِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13689","","","كتاب الحج"
"13690","(۱۳۶۹۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، قَالَ : رَأَیْتُ فِی ثَوْبِ عَمْرِو بْنِ شُعَیْبٍ رَدْعًا مِنْ خَلُوقِ الْکَعْبَۃِ ، فَقُلْتُ لَہُ : مَا ہَذَا فِی ثَوْبِکَ وَأَنْتَ مُحْرِمٌ ؟ فَقَالَ : إنَّ ہَذَا لاَ یُکْرَہُ ہَاہُنَا ، إنَّمَا سُمِّیَتْ بَکَّۃُ لأَنَّ النَّاسَ یَتَبَاکَّوْنَ بِہَا۔","","Musannaf Ibn Abi Shaybah 13690","","","كتاب الحج"
"13691","(۱۳۶۹۱) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَوَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَدْخُلُ مَکَّۃَ أَحَدٌ بِغَیْرِ إحْرَامٍ ، إِِلاَّ الْحَطَّابُونَ وَالعَمَّالونَ وَأَصْحَابُ مَنَافِعِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13691","","","كتاب الحج"
"13692","(۱۳۶۹۲) حدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ ثَوْرٍ، عَنْ أَبِی جَعْفَرٍ، عَنْ عَلِیٍّ، قَالَ: لاَ تَدْخُلُہَا إِلاَّ بِإِحْرَامٍ، یَعْنِی مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13692","","","كتاب الحج"
"13693","(۱۳۶۹۳) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدْخُلَ مَکَّۃَ بِغَیْرِ إحْرَامٍ۔","","Musannaf Ibn Abi Shaybah 13693","","","كتاب الحج"
"13694","(۱۳۶۹۴) حدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یُحِبُّونَ أَنْ لاَ یَدْخُلُوا مَکَّۃَ إِلاَّ مُحْرِمِینَ۔","","Musannaf Ibn Abi Shaybah 13694","","","كتاب الحج"
"13695","(۱۳۶۹۵) حدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ لأَحَدٍ أَنْ یَدْخُلَ مَکَّۃَ إِلاَّ بِإِحْرَامٍ ، وَکَانَ عَبْدُ الْمَلِکِ یُرَخِّصُ فِیہِ لِلْحَطَّابِینَ۔","","Musannaf Ibn Abi Shaybah 13695","","","كتاب الحج"
"13696","(۱۳۶۹۶) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَدْخُلُ مَکَّۃَ بِغَیْرِ إحْرَامٍ ؟ فَکَرِہَہُ الْحَکَمُ ، وَلَمْ یَرَ بِہِ حَمَّادٌ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 13696","","","كتاب الحج"
"13697","(۱۳۶۹۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ ہِشَامِ بْنِ حُجَیرٍ ، عَنْ طَاوُوسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَدْخُلْ مَکَّۃَ قَطُّ إِلاَّ مُحْرِمًا ، إِلاَّ یَوْمَ فَتْحِ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 13697","","","كتاب الحج"
"13698","(۱۳۶۹۸) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَدْخُلُ مَکَّۃَ إِلاَّ مُحْرِمًا۔","","Musannaf Ibn Abi Shaybah 13698","","","كتاب الحج"
"13699","(۱۳۶۹۹) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ تَدْخُلُ مَکَّۃَ إِلاَّ مُحْرِمًا۔","","Musannaf Ibn Abi Shaybah 13699","","","كتاب الحج"
"13700","(۱۳۷۰۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أَقَامَ بِمَکَّۃَ ، ثُمَّ خَرَجَ یُرِیدُ الْمَدِینَۃَ ، حَتَّی إذَا کَانَ بِقَدِیدٍ بَلَغَہُ أَنَّ جَیْشًا مِنْ جُیُوشِ الْفِتْنَۃِ دَخَلُوا الْمَدِینَۃَ ، فَکَرِہَ أَنْ یَدْخُلَ عَلَیْہِمْ ، فَرَجَعَ إلَی مَکَّۃَ فَدَخَلَہَا بِغَیْرِ إحْرَامٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13700","","","كتاب الحج"
"13701","(۱۳۷۰۱) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، قَالَ : خَرَجَ أَبِی ، وَعَمْرُو بْنُ دِینَارٍ إلَی أَرْضِہِمَا خَارِجًا مِنَ الْحَرَمِ ، ثُمَّ دَخَلاَ مَکَّۃَ بِغَیْرِ إحْرَامٍ۔","","Musannaf Ibn Abi Shaybah 13701","","","كتاب الحج"
"13702","(۱۳۷۰۲) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 13702","","","كتاب الحج"
"13703","(۱۳۷۰۳) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : طَافَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَجَّتِہِ أُسْبُوعًا وَصَلَّی رَکْعَتَیْنِ ، وَکَذَلِکَ فَعَلَ فِی عُمَرِہِ ، قَالَ : فَإِنْ طَافَ رَجُلٌ فَلاَ أُحِبُّ أَنْ یَزِیدَ عَلَی رَکْعَتَیْنِ ، فَإِنْ زَادَ فَلاَ بَأْسَ بِہِ ، وَإِنْ وَجَدَ الْکَعْبَۃَ مَفْتُوحَۃً فَلاَ یَدْخُلُہَا حَتَّی یَطُوفَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 13703","","","كتاب الحج"
"13704","(۱۳۷۰۴) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا سَلیْم بْنُ حَیَّانَ ، قَالَ : حدَّثَنَا مُوسَی بْنُ قَطَنٍ ، عَنْ مَیَّۃَ بِنْتِ مُحْرِزٍ ، قَالَتْ : سَمِعْت عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : أَحِجُّوا ہَذِہِ الذُّرِّیَّۃَ ، وَلاَ تَأْکُلُوا أَرْزَاقَہَا ، وَتَدَعُوا أَرْبَاقِہَا فِی أَعْنَاقِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13704","","","كتاب الحج"
"13705","(۱۳۷۰۵) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی الرَّجُلِ أَنْ یَحُجَّ بِامْرَأَتِہِ إِلاَّ أَنْ یَشَائَ ۔ قَالَ الأَوْزَاعِیُّ : قَالَ یَحْیَی بْنُ أَبِی کَثِیرٍ : ہُوَ عَلَیْہِ إِنْ کَانَتْ لَمْ تَحُجَّ ، قَالَ مَکْحُولٌ : عَلَیْکُمْ إحْجَاجُ نِسَائِکُمْ۔","","Musannaf Ibn Abi Shaybah 13705","","","كتاب الحج"
"13706","(۱۳۷۰۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسْنِد فِی الصَّفَا وَالْمَرْوَۃِ ، یَقُومُ عِنْدَ الْمَرْوَۃِ الْبَیْضَائِ۔","","Musannaf Ibn Abi Shaybah 13706","","","كتاب الحج"
"13707","(۱۳۷۰۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ أَبِیہِ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی عُثْمَانَ بْنَ عَفَّانَ وَاقِفًا عِنْدَ الْحَوْضِ الأَسْفَلِ مِنَ الصَّفَا۔","Da'if","Musannaf Ibn Abi Shaybah 13707","","","كتاب الحج"
"13708","(۱۳۷۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ سَابِطٍ ؛ أَنَّ عُمَرَ کَانَ یَجْعَلُ الْذی کَأَنَّہُ مَبْرَکُ بَعِیرٍ عَلَی فَخِذِہِ الأَیْمَنِ ، یَعْنِی فِی الْمَرْوَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 13708","","","كتاب الحج"
"13709","(۱۳۷۰۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّ أَبَاہُ کَانَ یَقُومُ عِنْدَ الْمَرْوَۃِ عِنْدَ الْذی کَأَنَّہُ مَبْرَکُ بَعِیرٍ ، وَفِی الصَّفَا فِی الْمَکَانِ الْمُنْحَفِرِ۔","","Musannaf Ibn Abi Shaybah 13709","","","كتاب الحج"
"13710","(۱۳۷۱۰) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ یَقُومُ دُونَ الْذی کَأَنَّہُ مَبْرَکُ بَعِیرٍ ، وَیَقُومُ مِنَ الصَّفَا أَسْفَلَ مِنَ الْمَکَانِ الْمُنْحَفِرِ۔","","Musannaf Ibn Abi Shaybah 13710","","","كتاب الحج"
"13711","(۱۳۷۱۱) حدَّثَنَا حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : یَصْعَدُ عَلَی الصَّفَا حَتَّی یَنْظُرَ إلَی الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 13711","","","كتاب الحج"
"13712","(۱۳۷۱۲) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَ قِیَامَ الرَّجُلِ عَلَی بَابِ الْمَسْجِدِ ، إِذَا أَرَادَ الانْصِرَافَ إلَی أَہْلِہِ مُنْحَرِفًا نَحْوَ الْکَعْبَۃِ ، یَنْظُرُ إلَیْہَا وَیَدْعُو ، وَقَالَ : الْیَہُودُ یَفْعَلُونَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 13712","","","كتاب الحج"
"13713","(۱۳۷۱۳) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : سَمِعْتُہُ وَرَأَی رَجُلاً یَلْتَفِتُ إلَی الْکَعْبَۃِ عِنْدَ بَابِ الْمَسْجِدِ فَنَہَاہُ ، وَقَالَ : الْیَہُودُ یَفْعَلُونَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 13713","","","كتاب الحج"
"13714","(۱۳۷۱۴) حدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُقَلِّدُ وَیُشْعِرُ بِذِی الْحُلَیْفَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 13714","","","كتاب الحج"
"13715","(۱۳۷۱۵) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، قَالَ: کَانَ أَبِیٌّ یَقُولُ: إذَا أَہْدَی الرَّجُلُ ہَدْیًا أَشْعَرَہُ حَیْثُ یُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 13715","","","كتاب الحج"
"13716","(۱۳۷۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُشْعِرُونَ یَوْمَ التَّرْوِیَۃِ ، وَقَبْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 13716","","","كتاب الحج"
"13717","(۱۳۷۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُشْعِرُ بَدَنَتَہُ بِعَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 13717","","","كتاب الحج"
"13718","(۱۳۷۱۸) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ، عَنْ زُہَیْرٍ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: أَحَبُّ إلَیَّ أَنْ أُشْعِرَ بِعَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 13718","","","كتاب الحج"
"13719","(۱۳۷۱۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَابْنِ الأَسْوَدِ ؛ أَنَّہُمَا قَالاَ : یُشْعِرُ ، ثُمَّ یُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 13719","","","كتاب الحج"
"13720","(۱۳۷۲۰) حدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُشْعِرُ البُدْنَ حَتَّی یُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 13720","","","كتاب الحج"
"13721","(۱۳۷۲۱) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ فُضَیْلٍ ، عن إبْرَاہِیمَ ، قَالَ : إذَا قَالَ : یَوْمَ یَفْعَلُ کَذَا وَکَذَا فَہُوَ مُحْرِمٌ بِحَجَّۃٍ ، قَالَ : إِنْ حَنِثَ فَہُوَ مُحْرِمٌ ، وَإِنْ قَالَ : إِنْ فَعَلْتُ کَذَا وَکَذَا فَأَنَا مُحْرِمٌ بِحَجَّۃٍ ، فَدَخَلَ شَوَّالٌ فَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13721","","","كتاب الحج"
"13722","(۱۳۷۲۲) حدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا قَالَ : إِنْ فَعَلْتُ کَذَا وَکَذَا فَأَنَا مُحْرِمٌ بِحَجَّۃٍ ، قَالَ: یَحُجُّ مَعَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 13722","","","كتاب الحج"
"13723","(۱۳۷۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنِ الشَّعْبِیِّ ؛ نَحْوًا مِنْ حَدِیثِ مُجَالِدٍ۔","","Musannaf Ibn Abi Shaybah 13723","","","كتاب الحج"
"13724","(۱۳۷۲۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحُکْمِ ؛ فِی الرَّجُلِ یَقُولُ : یَوْمَ یَفْعَلُ کَذَا وَکَذَا فَہُوَ یَوْمَئِذٍ مُحْرِمٌ بِحَجَّۃٍ ، فَإِنْ حَنِثَ فَہُوَ یَوْمَئِذٍ مُحْرِمٌ بِحَجَّۃٍ ، وَإِنْ قَالَ : إِنْ لَمْ أَفْعَلْ کَذَا وَکَذَا فَأَنَا مُحْرِمٌ بِحَجَّۃٍ ، قَالَ : إِذَا حَجَّ مَعَ النَّاسِ أَجْزَأَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 13724","","","كتاب الحج"
"13725","(۱۳۷۲۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ قَالَ : تَکْفِیہ مَرَّۃً وَاحِدَۃً یَقُولُ : لَبَّیْکَ عَنْ فُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 13725","","","كتاب الحج"
"13726","(۱۳۷۲۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ؛ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 13726","","","كتاب الحج"
"13727","(۱۳۷۲۷) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یَرَوْنَ أَنَّ الْمَغْفِرَۃَ تَنْزِلُ عِنْدَ الدَّفْعَۃِ مِنْ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 13727","","","كتاب الحج"
"13728","(۱۳۷۲۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ أَنَّہُمَا قَالاَ : إِذَا حَجَّ الرَّجُلُ عَنِ الرَّجُلِ فَنَسِیَ أَنْ یُسَمِّیَہُ ، فَقَدْ أَجْزَأَ عَنْہُ الْحَجُّ ، فَإِنَّ اللَّہَ تعالی قَدْ عَلِمَ عَمَّنْ حَجَّ۔","","Musannaf Ibn Abi Shaybah 13728","","","كتاب الحج"
"13729","(۱۳۷۲۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَلَ فِی عُمْرَۃٍ ، وَأَبُو بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ، وَالْخُلَفَائُ کَذَلِکَ ، وَقَالَ عَطَائٌ : رَمَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَجَّتِہِ۔","","Musannaf Ibn Abi Shaybah 13729","","","كتاب الحج"
"13730","(۱۳۷۳۰) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : نُبِّئْت عَنِ الْقَاسِمِ ، وَسَالِمٍ أَنَّہُمَا کَانَا یَقُولاَنِ : أَہْلُ مَکَّۃَ إِذَا خَرَجُوا إلَی مِنًی قَصَرُوا ، قَالَ : وَکَانَ عَطَائٌ ، وَالزُّہْرِیُّ یَقُولاَنِ : یُتِمُّونَ۔","","Musannaf Ibn Abi Shaybah 13730","","","كتاب الحج"
"13731","(۱۳۷۳۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عمَرَ ؛ أَنَّہُ کَانَ یُقِیمُ بِمَکَّۃَ ، فَإِذَا خَرَجَ إلَی مِنًی قَصَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 13731","","","كتاب الحج"
"13732","(۱۳۷۳۲) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ حَنْظَلَۃَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ الصَّلاَۃِ مَعَ الإِمَامِ بِعَرَفَۃَ ؟ فَقَالَ : صَلِّ بِصَلاَتِہِ ، فَقُلْتُ : إِنِّی مَکِّیٌّ ، قَالَ : قَدْ عَرَفْتُ ، قَالَ : وَسَأَلْتُ سَالِمًا ، وَطَاوُسًا ، فَقَالاَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 13732","","","كتاب الحج"
"13733","(۱۳۷۳۳) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ؛ قَالاَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ قَصْرُ صَلاَۃٍ فِی الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13733","","","كتاب الحج"
"13734","(۱۳۷۳۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ إِحْصَارَ إِلاَّ مَنْ حَبَسَہُ عَدُوٍّ ، قَالَ : وَقَالَ أَبِی : لَیْسَ الْیَوْمَ إحْصَارٌ۔","","Musannaf Ibn Abi Shaybah 13734","","","كتاب الحج"
"13735","(۱۳۷۳۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: لاَ إحْصَارَ إِلاَّ مِنْ مَرَضٍ، أَوْ عَدُوٍّ، أَوْ أَمْرٍ حَابِسٍ۔","","Musannaf Ibn Abi Shaybah 13735","","","كتاب الحج"
"13736","(۱۳۷۳۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: لاَ إحْصَارَ إِلاَّ مِنْ عَدُوٍّ۔","Sahih","Musannaf Ibn Abi Shaybah 13736","","","كتاب الحج"
"13737","(۱۳۷۳۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کُلُّ شَیْئٍ حَبَسَ الْمُحْرِمَ فَہُوَ إحْصَارٌ۔","","Musannaf Ibn Abi Shaybah 13737","","","كتاب الحج"
"13738","(۱۳۷۳۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ابْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ قَالَ : لاَ إِحْصَارَ إِلاَّ مِنَ الحرب۔","","Musannaf Ibn Abi Shaybah 13738","","","كتاب الحج"
"13739","(۱۳۷۳۹) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ ، قَالَ : إنَّمَا التَّمَتُّعُ بِالْعُمْرَۃِ إلَی الْحَجِّ ، أَنْ یُہِلَّ الرَّجُلُ بِالْحَجِّ فَیَحْصُرُہُ إمَّا مَرَضٌ ، أَوْ عَدوٌ ، أَوْ أَمْرٌ یَحْبِسُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 13739","","","كتاب الحج"
"13740","(۱۳۷۴۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ سَابِطٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَصْحَابَہُ کَانُوا یَعْقِلُونَ یَدَ الْبَدَنَۃِ الْیُسْرَی ، وَیَنْحَرُونَہَا قَائِمَۃً عَلَی مَا بَقِیَ مِنْ قَوَائِمِہَا۔ (ابوداؤد ۱۷۶۴)","","Musannaf Ibn Abi Shaybah 13740","","","كتاب الحج"
"13741","(۱۳۷۴۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ حَجَّاجٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَنْحَرُہَا وَہِیَ مَعْقُولَۃٌ یَدُہَا الْیُمْنَی۔","","Musannaf Ibn Abi Shaybah 13741","","","كتاب الحج"
"13742","(۱۳۷۴۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : اِعْقِلْ أَیَّ الْیَدَیْنِ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13742","","","كتاب الحج"
"13743","(۱۳۷۴۳) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَعْقِلُ الْیُسْرَی۔","","Musannaf Ibn Abi Shaybah 13743","","","كتاب الحج"
"13744","(۱۳۷۴۴) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْبَدَنَۃِ کَیْفَ تُنْحَرُ ؟ قَالَ : تَعْقِلُ یَدَہَا الْیُسْرَی ، وَتَنْحرُہَا مِنْ قِبَلِ یَدِہَا الْیُمْنَی۔","","Musannaf Ibn Abi Shaybah 13744","","","كتاب الحج"
"13745","(۱۳۷۴۵) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَعْقِلُ یَدَہَا الْیُسْرَی إذَا أَرَادَ أَنْ یَنْحَرَہَا۔","","Musannaf Ibn Abi Shaybah 13745","","","كتاب الحج"
"13746","(۱۳۷۴۶) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَخْرُجُ مِنَ الْمَسْجِدِ حَتَّی یَسْتَلِمَ ، کَانَ فِی طَوَافٍ ، أَوْ فی غَیْرِ طَوَافٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13746","","","كتاب الحج"
"13747","(۱۳۷۴۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أبیہ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلَّمَا دَخَلْتَ الْمَسْجِدَ الْحَرَامَ طُفْتَ بِالْبَیْتِ ، أَوْ لَمْ تَطُفْ فَاسْتَلِمَ الْحَجَرَ حِینَ تُرِیدُ أَنْ تَخْرُجَ مِنَ الْمَسْجِدِ ، أَوِ اسْتَقْبِلْہُ فَکَبِّرْ وَادْعُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 13747","","","كتاب الحج"
"13748","(۱۳۷۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی حَفْصَۃَ ، قَالَ : طُفْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ فَکَانَ إِذَا مَرَّ بِالْحَجَرِ الْتَفَتَ إلَیْہِ ، وَلَمْ یَسْتَلِمْہُ۔","","Musannaf Ibn Abi Shaybah 13748","","","كتاب الحج"
"13749","(۱۳۷۴۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : طُفْتُ مَعَ طَاوُوسٍ فَرُبَّمَا لَمْ یَسْتَلِمْ شَیْئًا مِنَ الأَرْکَانِ ، حَتَّی یَنْصَرِفَ۔","","Musannaf Ibn Abi Shaybah 13749","","","كتاب الحج"
"13750","(۱۳۷۵۰) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ؛ أَنَّہُ کَانَ یَطُوفُ بِالْبَیْتِ ، وَلاَ یَسْتَلِمُ۔","","Musannaf Ibn Abi Shaybah 13750","","","كتاب الحج"
"13751","(۱۳۷۵۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، وَیَزِیدُ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : رَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یُہَادَی بَیْنَ رَجُلَیْنِ - وَقَالَ یَزِیدُ : بَیْنَ ابْنَیْہِ - فَقَالَ : مَا ہَذَا ؟ فَقَالُوا : نَذَرَ أَنْ یَمْشِیَ ، فَقَالَ : إِنَّ اللَّہَ عَزَّ وَجَلَّ عَنْ تَعْذِیبِ ہَذَا لَغَنِیٌّ ، مُرُوہُ فَلْیَرْکَبْ ۔ إِِلاَ أَنَّ یَزِیدَ قَالَ : عَنْ حُمَیْدٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ۔n(ترمذی ۱۵۳۷)","","Musannaf Ibn Abi Shaybah 13751","","","كتاب الحج"
"13752","(۱۳۷۵۲) حدَّثَنَا أَبُو خَالِدٍ ، وَابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ زَحْرٍ ، عَنْ أَبِی سَعِیدٍ الرُّعَیْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَالِکٍ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، قَالَ : نَذَرَتْ أُخْتِی أَنْ تَمْشِیَ إلَی بَیْتِ اللہِ حَافِیَۃً غَیْرَ مُخْتَمِرَۃٍ ، فَسَأَلْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : مُرْ أُخْتَکَ فَلْتَخْتَمِرْ وَلْتَرْکَبْ ، وَلْتَصُمْ ثَلاَثَۃَ أَیَّامٍ۔n(ترمذی ۱۵۴۴۔ ابوداؤد ۳۲۸۶)","Hasan","Musannaf Ibn Abi Shaybah 13752","","","كتاب الحج"
"13753","(۱۳۷۵۳) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ (ح) وَعَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا جَعَلَ عَلَیْہِ الْمَشْیَ فَلَمْ یَسْتَطِعْ ، فَلْیُہْدِ بَدَنَۃً وَلِیَرْکَبْ۔","","Musannaf Ibn Abi Shaybah 13753","","","كتاب الحج"
"13754","(۱۳۷۵۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی رَجُلٍ مَشَی نِصْفَ الطَّرِیقِ فِی نَذْرٍ ، ثُمَّ رَکِبَ ، قَالَ : یَجیء مِن قَابِلٍ فَیَرْکَبُ مَا مَشَی ، وَیَمْشِی مَا رَکِبَ ، وَیَنْحَرُ بَدَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 13754","","","كتاب الحج"
"13755","(۱۳۷۵۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَذَرَ أَنْ یَحُجَّ مَاشِیًا ، قَالَ : یَمْشِی حَتَّی إِذَا أَعْیَا رَکِبَ ، وَأَہْدَی۔","","Musannaf Ibn Abi Shaybah 13755","","","كتاب الحج"
"13756","(۱۳۷۵۶) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یَمْشِی ، فَإِنَ انْقَطَعَ رَکِبَ ، وَأَہْدَی بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 13756","","","كتاب الحج"
"13757","(۱۳۷۵۷) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنِ الأَجْلَحِ ، عَنْ عَمْرِو بْنِ سَعِیدٍ الْبَجَلِی ، قَالَ : کُنْتُ تَحْتَ مِنْبَرِ ابْنِ الزُّبَیْرِ وَہُوَ عَلَیْہِ ، فَجَائَ رَجُلٌ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنِّی نَذَرْت أَنْ أَحُجَّ مَاشِیًا ، حَتَّی إذَا کَانَ کَذَا وَکَذَا خَشِیتُ أَنْ یَفُوتَنِی الْحَجُّ فَرَکِبْت ، قَالَ: لاَ خَطَأَ عَلَیْکَ، ارْجِعْ عَامَ قَابِلٍ فَامْشِ مَا رَکِبْتَ ، وَارْکَبْ مَا مَشَیْت۔","Da'if","Musannaf Ibn Abi Shaybah 13757","","","كتاب الحج"
"13758","(۱۳۷۵۸) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ خُصَیْفٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ جَعَلَ عَلَیْہِ الْمَشْیَ فَمَشَی بَعْضَ الطَّرِیقِ ، وَرَکِبَ بعضًا ، فَقَالَ : یَنْظُرُ مَا رَکِبَ ، ثُمَّ یُقَوِّمُ جَزَائَہُ ، فَإِنْ بَلَغَ بَدَنَۃً اشْتَرَاہَا وَأَہْدَاہَا ، قَالَ : فَإِنْ لَمْ یَبْلُغْ تَصَدَّقَ بِہِ عَلَی الْمَسَاکِینِ۔","","Musannaf Ibn Abi Shaybah 13758","","","كتاب الحج"
"13759","(۱۳۷۵۹) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : سَمِعْتُ یَزِیدَ بْنَ عَبْدِ اللہِ بْنِ قُسَیْطٍ یَقُولُ : یَرْکَبُ وَیُہْدِی بَدَنَۃً ، وَقَالَ الْقَاسِمُ : إذَا کَانَ قَابِلُ فَلْیَمْشِ مَا رَکِبَ۔","","Musannaf Ibn Abi Shaybah 13759","","","كتاب الحج"
"13760","(۱۳۷۶۰) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، وَمَالِکِ بْنِ أَنَسٍ ، عَنْ عُرْوَۃَ بْنِ أُذَیْنَۃَ ، قَالَ مَالِکٌ : جَدَّتُہُ، وَقَالَ عُبَیْدُ اللہِ : أُمَّہُ ، جَعَلَتْ عَلَیْہَا الْمَشْیَ ، فَمَشَتْ حَتَّی إذَا انْتَہَتْ إلَی السُّقْیَا عَجَزَتْ ، فَسُئل ابْنَ عُمَرَ؟ فَقَالَ : مُرُوہَا أَنْ تَعُودَ مِنَ الْعَامِ الْمُقْبِلِ ، فَتَمْشِی مِنْ حَیْثُ عَجَزَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 13760","","","كتاب الحج"
"13761","(۱۳۷۶۱) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، عَنْ عَطَائٍ ، قَالَ : أَیُّمَا امْرَأَۃٍ جَعَلَتْ عَلَیْہَا الْمَشْیَ إلَی الْبَیْتِ فَلَمْ تَسْتَطِعْ ، فَلْتَرْکَبْ وَلِتُہْدِ بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 13761","","","كتاب الحج"
"13762","(۱۳۷۶۲) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا إذَا أَقْبَلَ مِنْ عَرَفَاتٍ ، أَنْ یَأْخُذَ غَیْرَ طَرِیقِ مِنًی شِمَالاً ، وَیَمِینًا۔","","Musannaf Ibn Abi Shaybah 13762","","","كتاب الحج"
"13763","(۱۳۷۶۳) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، أَوِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْخُذَ غَیْرَ طَرِیقِ مِنًی، إذَا أَفَاضَ مِنْ عَرَفَاتٍ ، طَرِیقِ ضَبٍّ۔","","Musannaf Ibn Abi Shaybah 13763","","","كتاب الحج"
"13764","(۱۳۷۶۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ أَنَّہُمَا قَالاَ : فِی ثَلاَثِ شَعَرَاتٍ دَمٌ ، النَّاسِی وَالْمُتَعَمِّدُ سَوَائٌ۔","Hasan","Musannaf Ibn Abi Shaybah 13764","","","كتاب الحج"
"13765","(۱۳۷۶۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَنْزِعُ جِلاَلَہَا لاَ تَتَمَرَّغُ فِیہِ ، یَعْنِی الْبُدْنَ۔","","Musannaf Ibn Abi Shaybah 13765","","","كتاب الحج"
"13766","(۱۳۷۶۶) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَنْحَرُہَا وَعَلَیْہَا جِلاَلُہَا۔","Hasan","Musannaf Ibn Abi Shaybah 13766","","","كتاب الحج"
"13767","(۱۳۷۶۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، قَالَ : أَمَرَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ أَقُومَ عَلَی بُدْنِہِ ، وَأَمَرَنِی أَنْ لاَ أُعْطِیَ الْجَازِرَ مِنْہَا شَیْئًا ، وَقَالَ : نَحْنُ نُعْطِیہِ مِنْ عِنْدِنَا۔ (بخاری ۱۷۱۶۔ مسلم ۹۵۴)","Sahih","Musannaf Ibn Abi Shaybah 13767","","","كتاب الحج"
"13768","(۱۳۷۶۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، قَالَ : لاَ تُعْطِ مَسْکَ الْہَدْیِ الْجَزَّارُ ، وَإِنْ وَجَدْت بِہِ شَاۃً فَاشْتَرِ بِہِ شَاۃً ، فَاذْبَحْہَا۔","","Musannaf Ibn Abi Shaybah 13768","","","كتاب الحج"
"13769","(۱۳۷۶۹) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یُعْطَی مَسْکَ الْہَدْیِ الْجَزَّارُ۔","","Musannaf Ibn Abi Shaybah 13769","","","كتاب الحج"
"13770","(۱۳۷۷۰) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ الطَّوِیلِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : لاَ بَأْسَ أَنْ یُعْطَی الْجَزَّارُ جِلْدَہَا۔","","Musannaf Ibn Abi Shaybah 13770","","","كتاب الحج"
"13771","(۱۳۷۷۱) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سَیْفٍ ، قَالَ : بَلَغَنِی عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُعْطَی الْجَزَّارُ مِنْہَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 13771","","","كتاب الحج"
"13772","(۱۳۷۷۲) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ بْنِ أَبِی مُسْلِمٍ ، عَنْ طَاوُوسٍ ، قَالَ بَعْضُ أَصْحَابِنَا : ہُوَ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ النَّاسُ یَنْصَرِفُونَ کُلَّ وَجْہٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَنْفِرُ أَحَدٌ حَتَّی یَکُونَ آخِرُ عَہْدِہِ بِالْبَیْتِ۔ (مسلم ۹۶۳۔ ابوداؤد ۱۹۹۵)","Sahih","Musannaf Ibn Abi Shaybah 13772","","","كتاب الحج"
"13773","(۱۳۷۷۳) حدَّثَنَا حَفْصٌ، عَنْ لَیْثٍ، عَنْ طَاوُوس، وَعَطَائٍ؛ أَنَّ عُمَرَ کَانَ یَرُدُّ مَنْ خَرَجَ، وَلَمْ یَکُنْ آخِرَ عَہْدِہِ بِالْبَیْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 13773","","","كتاب الحج"
"13774","(۱۳۷۷۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ، قَالَ : لاَ یَنْفِرُ أَحَدٌ حَتَّی یَطُوفَ بِالْبَیْتِ ، فَإِنَّ آخِرَ النُّسُکِ الطَّوَافُ بِالْبَیْتِ۔","Hasan","Musannaf Ibn Abi Shaybah 13774","","","كتاب الحج"
"13775","(۱۳۷۷۵) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أُمِرَ النَّاسُ أَنْ یَکُونَ آخِرَ عَہْدِہِمْ بِالْبَیْتِ ، وَخُفِّفَ عَنِ الْحُیَّضِ۔ (مسلم ۳۸۰)","Sahih","Musannaf Ibn Abi Shaybah 13775","","","كتاب الحج"
"13776","(۱۳۷۷۶) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، قَالَ : کَانُوا یَنْفِرُونَ مِنْ مِنًی ، فَقِیلَ لَہُمْ : یَکُونُ آخِرَ عَہْدِکُمْ بِالْبَیْتِ ، وَرُخِّصَ لِلْحُیَّضِ۔","","Musannaf Ibn Abi Shaybah 13776","","","كتاب الحج"
"13777","(۱۳۷۷۷) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ کِلاَبِ بْنِ عَلِیّ ، عَنْ مَنْصُورِ بْنِ أَبِی سُلَیْمَانَ ، عَنِ ابْنِ أَخِی جُبَیْرِ بْنِ مُطْعِمٍ ، عَنْ جُبَیْرِ بْنِ مُطْعِمٍ ، قَالَ : قامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی الْمَرْوَۃِ وَبِیَدِہِ مشِقَصٌّ ، یُقَصِّرُ بِہِ مِنْ شَعْرِہِ وَہُوَ یَقُولُ : دَخَلَتِ الْعُمْرَۃُ فِی الْحَجِّ إلَی یَوْمِ الْقِیَامَۃِ ، لاَ صَرُورَۃَ فِی الإِسْلاَمِ ، وَتُثَجُّ الإِبِلُ ثَجًّا ، وَعُجُّوا بِالتَّکْبِیرِ عَجًّا۔","Da'if","Musannaf Ibn Abi Shaybah 13777","","","كتاب الحج"
"13778","(۱۳۷۷۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : أَحَلَّ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَصَّرُوا ، وَلَمْ یَحْلِقُوا۔","","Musannaf Ibn Abi Shaybah 13778","","","كتاب الحج"
"13779","(۱۳۷۷۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کُنْتُ أَحُجُّ مَعَ أَبِی وَأَعْتَمِرُ وَلِی جُمَّۃٌ إلَی مَنْکِبِی، فَمَا أَمَرَنِی بِحَلْقِہَا قَطُّ فَکُنْت أُقَصِّرُ۔","","Musannaf Ibn Abi Shaybah 13779","","","كتاب الحج"
"13780","(۱۳۷۸۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا حَجَّ الرَّجُلُ أَوَّلَ حَجَّۃٍ ، حَلَقَ وَإِنْ حَجَّ مَرَّۃً أُخْرَی ، إِنْ شَائَ حَلَقَ ، وَإِنْ شَائَ قَصَّرَ ، وَالْحَلْقُ أَفْضَلُ ، وَإِذَا اعْتَمَرَ الرَّجُلُ وَلَمْ یَحُجَّ قَطُّ ، فَإِنْ شَائَ حَلَقَ ، وَإِنْ شَائَ قَصَّرَ ، فَإِنْ کَانَ مُتَمَتِّعًا قَصَّرَ ثُمَّ حَلَقَ۔","","Musannaf Ibn Abi Shaybah 13780","","","كتاب الحج"
"13781","(۱۳۷۸۱) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنْ عطاء ؛ سُئِلَ عَنِ الصَّرُورَۃِ : أَیَحْلِقُ ، أَوْ یُقَصِّرُ ؟ قَالَ : أَیُّ ذَلِکَ شَائَ ، إِنْ شَائَ حَلَقَ ، وَإِنْ شَائَ قَصَّرَ۔","","Musannaf Ibn Abi Shaybah 13781","","","كتاب الحج"
"13782","(۱۳۷۸۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الَّذِی لَمْ یَحُجَّ قَطُّ : إِنْ شَائَ حَلَقَ ، وَإِنْ شَائَ قَصَّرَ۔","","Musannaf Ibn Abi Shaybah 13782","","","كتاب الحج"
"13783","(۱۳۷۸۳) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ؛ أَنَّ عَلْقَمَۃَ ، وَالأَسْوَدَ حَجَّا ، أَوْ حَجَّ أَحَدُہُمَا ، أَوِ اعْتَمَرَ الآخَرُ ، فَحَلَقَ أَحَدُہُمَا وَقَصَّرَ الآخَرُ۔","","Musannaf Ibn Abi Shaybah 13783","","","كتاب الحج"
"13784","(۱۳۷۸۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یَحْلِقُوا فِی أَوَّلِ حَجَّۃٍ ، وَأَوَّلِ عُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 13784","","","كتاب الحج"
"13785","(۱۳۷۸۵) حدَّثَنَا وَکِیعٌ ، عَنْ حَسَن ، عَنْ جَعْفَرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَلَقَ فِی عُمْرَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 13785","","","كتاب الحج"
"13786","(۱۳۷۸۶) حدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ سَہْلٍ ، قَالَ : قدْ رَأَیْتُ عُثْمَانَ یَقْدَمُ مَکَّۃَ وَنَحْنُ مَعَہُ ، فَمَا یُحِلُّ بِہَا عُقْدَۃً حَتَّی یَخْرُجَ ، فَمَا یَزِیدُ عَلَی أَنْ یَطُوفَ بِالْبَیْتِ ، وَیَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، وَیَحْلِقَ رَأْسَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 13786","","","كتاب الحج"
"13787","(۱۳۷۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ حَلَقَ فِی عُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 13787","","","كتاب الحج"
"13788","(۱۳۷۸۸) حدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: إِذَا اعْتَمَرَ وَلَمْ یَحُجَّ قَطُّ، فَإِنْ شَائَ قَصَّرَ، وَإِنْ شَائَ حَلَقَ۔","","Musannaf Ibn Abi Shaybah 13788","","","كتاب الحج"
"13789","(۱۳۷۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ لِلرَّجُلِ أَوَّلَ مَا یَحُجُّ أَنْ یَحْلِقَ ، وَأَوَّلَ مَا یَعْتَمِرُ أَنْ یَحْلِقَ۔","","Musannaf Ibn Abi Shaybah 13789","","","كتاب الحج"
"13790","(۱۳۷۹۰) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ اغْفِرْ لِلْمُحَلِّقِینَ ، قَالُوا : یَا رَسُولَ اللہِ ، وَلِلْمُقَصِّرِینَ ؟ قَالَ : اللَّہُمَّ اغْفِرْ لِلْمُحَلِّقِینَ ثَلاَثًا ، فَقَالُوا : یَا رَسُولَ اللہِ ، وَلِلمُقَصِّرِینَ ؟ قَالَ : وَلِلمُقَصِّرِینَ۔ (بخاری ۱۷۲۸۔ مسلم ۳۲۰)","Sahih","Musannaf Ibn Abi Shaybah 13790","","","كتاب الحج"
"13791","(۱۳۷۹۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ وَہْبِ بْنِ عَبْدِ اللہِ ، أَرَاہُ عَنْ أَبِیہِ ، قَالَ : کُنْتُ مَعَ أَبِی فَرَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ بِیَدِہِ : یَرْحَمُ اللَّہُ الْمُحَلِّقِینَ ، فَقَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، وَالْمُقَصِّرِینَ ؟ قَالَ فِی الثَّالِثَۃِ : وَالْمُقَصِّرِینَ۔ (احمد ۶/۳۹۳۔ حمیدی ۹۳۱)","Da'if","Musannaf Ibn Abi Shaybah 13791","","","كتاب الحج"
"13792","(۱۳۷۹۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی إِبْرَاہِیمَ ، عَن أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ نَحْوَہُ۔ (احمد ۳/۲۰۔ طیالسی ۲۲۲۴)","Da'if","Musannaf Ibn Abi Shaybah 13792","","","كتاب الحج"
"13793","(۱۳۷۹۳) حدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ اغْفِرْ لِلْمُحَلِّقِینَ ، قَالَہَا ثَلاَثًا ، قَالَ : فَقَالُوا : یَا رَسُولَ اللہِ ، مَا بَالُ الْمُحَلِّقِینَ ظَاہَرْتَ لَہُمُ التَّرَحُّمَ ؟ قَالَ : إِنَّہُمْ لَمْ یَشُکُّوا۔ (ابن ماجہ ۳۰۴۵۔ احمد ۱/۳۵۳)","Hasan","Musannaf Ibn Abi Shaybah 13793","","","كتاب الحج"
"13794","(۱۳۷۹۴) أَخْبَرَنَا أَبُو أُسَامَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَرْحَمُ اللَّہُ الْمُحَلِّقِینَ ، قَالُوا : یَا رَسُولَ اللہِ ، وَالْمُقَصِّرِینَ ؟ قَالَ فِی الثَّالِثَۃِ : وَالْمُقَصِّرِینَ۔n(بخاری ۱۷۲۷۔ مسلم ۳۱۶)","Sahih","Musannaf Ibn Abi Shaybah 13794","","","كتاب الحج"
"13795","(۱۳۷۹۵) حدَّثَنَا وَکِیعٌ ، وَأَبُو دَاوُد الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ الْحُصَیْنِ ، عَنْ جَدَّتِہِ ؛ أَنَّہَا سَمِعَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَعَا لِلْمُحَلِّقِینَ ثَلاَثًا ، وَلِلْمُقَصِّرِینَ مَرَّۃً ۔ وَلَمْ یَقُلْ وَکِیعٌ : فِی حَجَّۃِ الْوَدَاعِ۔n(مسلم ۹۴۶۔ احمد ۴/۷۰)","Sahih","Musannaf Ibn Abi Shaybah 13795","","","كتاب الحج"
"13796","(۱۳۷۹۶) حدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حُبْشِی بْنِ جُنَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ اغْفِرْ لِلْمُحَلِّقِینَ ، قَالُوا : یَا رَسُولَ اللہِ وَلِلْمُقَصِّرِینَ ؟ قَالَ : اللَّہُمَّ اغْفِرْ لِلْمُحَلِّقِینَ ، قَالُوا : یَا رَسُولَ اللہِ ، وَلِلْمُقَصِّرِینَ ؟ قَالَ : اغْفِرْ لِلْمُقَصِّرِینَ۔ (احمد ۴/۱۶۵۔ طبرانی ۳۵۱۰)","Sahih","Musannaf Ibn Abi Shaybah 13796","","","كتاب الحج"
"13797","(۱۳۷۹۷) حدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ: حدَّثَنَا أَوْسُ بْنُ عُبَیْدُ اللہِ ، عَنْ بُرَیْد بْنِ أَبِی مَرْیَمَ، عَنْ مَالِکِ بْنِ رَبِیعَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اللَّہُمَّ اغْفِرْ لِلْمُحَلِّقِینَ ثَلاَثًا ، قَالُوا: یَا رَسُولَ اللہِ ، وَالْمُقَصِّرِینَ؟ قَالَ: وَالْمُقَصِّرِینَ۔ وَکُنْتُ یَوْمَئِذٍ مَحْلُوقَ الرَّأْسِ، فَمَا سَرَّنِی بِحَلْقِ رَأْسِی حُمْرُ النَّعَمِ، أَوْ قَالَ: خَطَرٌ عَظِیمٌ۔ حدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنُ أَبِی شَیْبَۃَ الْعَبْسِیُّ ، قَالَ : (احمد ۴/۱۷۷۔ طبرانی ۶۰۴)","Hasan","Musannaf Ibn Abi Shaybah 13797","","","كتاب الحج"
"13798","(۱۳۷۹۸) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنِ اعْتَمَرَ بَعْدَ الْحَجِّ أَجْرَی عَلَی رَأْسِہِ الْمُوسَی۔","","Musannaf Ibn Abi Shaybah 13798","","","كتاب الحج"
"13799","(۱۳۷۹۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ اعْتَمَرَ فَحَلَقَ ، ثُمَّ حَجَّ ؟ قَالَ : یُمِرُّ عَلَی رَأْسِہِ الْمُوسَی۔","","Musannaf Ibn Abi Shaybah 13799","","","كتاب الحج"
"13800","(۱۳۸۰۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَیَّاشٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُمِرُّ عَلَی رَأْسِہِ الْمُوسَی۔","","Musannaf Ibn Abi Shaybah 13800","","","كتاب الحج"
"13801","(۱۳۸۰۱) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : سَمِعْتُہُ سُئِلَ عَنِ الَّذِی یَعْتَمِرُ بَعْدَ الْحَجِّ؟ قَالَ : یُمِرُّ عَلَی رَأْسِہِ الْمُوسَی۔","","Musannaf Ibn Abi Shaybah 13801","","","كتاب الحج"
"13802","(۱۳۸۰۲) حدَّثَنَا حَفْصٌ ، عَنْ مُثَنَّی ، عَنْ عَطَائٍ ؛ فِی الشَّیْخِ الْکَبِیرِ یَحُجُّ وَہُوَ أَصْلَعُ ؟ قَالَ : یُمِرُّ الْمُوسَی عَلَی رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 13802","","","كتاب الحج"
"13803","(۱۳۸۰۳) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ نَافِعٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ ابْنُ عُمَرَ رَجُلاً أَصْلَعَ ، فَکَانَ إذَا حَجَّ ، أَوِ اعْتَمَرَ أَمَرَّ عَلَی رَأْسِہِ الْمُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 13803","","","كتاب الحج"
"13804","(۱۳۸۰۴) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ؛ {الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ} قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَعَشْرٌ مِنْ ذِی الْحِجَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 13804","","","كتاب الحج"
"13805","(۱۳۸۰۵) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَذُو الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13805","","","كتاب الحج"
"13806","(۱۳۸۰۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابن طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَذُو الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13806","","","كتاب الحج"
"13807","(۱۳۸۰۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ خُصَیْفٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 13807","","","كتاب الحج"
"13808","(۱۳۸۰۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ہِشَامٍ ، عَنْ الْحَسَن ، قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَصَدْرُ ذِی الْحِجَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 13808","","","كتاب الحج"
"13809","(۱۳۸۰۹) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّد ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13809","","","كتاب الحج"
"13810","(۱۳۸۱۰) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ عَبْدُ اللہِ : {الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ} قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَعَشْرُ ذِی الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13810","","","كتاب الحج"
"13811","(۱۳۸۱۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی قَوْلِہِ تَعَالَی : {الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ} قَالَ : شَوَّالُ، وَذُو الْقَعْدَۃِ ، وَذُو الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13811","","","كتاب الحج"
"13812","(۱۳۸۱۲) حدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ؛ (الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ) قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَذُو الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13812","","","كتاب الحج"
"13813","(۱۳۸۱۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَعَشْرُ ذِی الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 13813","","","كتاب الحج"
"13814","(۱۳۸۱۴) حدَّثَنَا وَکِیعٌ ، وَیَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ عَبَّاسٍ ؛ {الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ} قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَعَشْرُ ذِی الْحِجَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 13814","","","كتاب الحج"
"13815","(۱۳۸۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ بَیْہَسِ بْنِ فَہْدَانِ ، عَنْ أَبِی شَیْخٍ الْہُنَائِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ قَوْلِہِ تَعَالَی : {الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ} ؟ قَالَ : شَوَّالُ ، وَذُو الْقَعْدَۃِ ، وَذُو الْحِجَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 13815","","","كتاب الحج"
"13816","(۱۳۸۱۶) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ عَبَّاسٍ : (فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ) قَالَ : التَّلْبِیَۃَ۔","","Musannaf Ibn Abi Shaybah 13816","","","كتاب الحج"
"13817","(۱۳۸۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ؛ قَالَ : الإِحْرَامَ۔","Hasan","Musannaf Ibn Abi Shaybah 13817","","","كتاب الحج"
"13818","(۱۳۸۱۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ؛ {فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ} قَالَ: مَنْ أَہَلَّ فِیہِنَّ بِالْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13818","","","كتاب الحج"
"13819","(۱۳۸۱۹) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَطَائٍ ، قَالَ : الْفَرْضُ التَّلْبِیَۃُ۔","","Musannaf Ibn Abi Shaybah 13819","","","كتاب الحج"
"13820","(۱۳۸۲۰) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الإِہْلاَلُ فَرِیضَۃُ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13820","","","كتاب الحج"
"13821","(۱۳۸۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ {فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ} قَالَ : التَّلْبِیَۃُ۔","","Musannaf Ibn Abi Shaybah 13821","","","كتاب الحج"
"13822","(۱۳۸۲۲) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ {فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ} قَالَ: التَّلْبِیَۃُ۔","","Musannaf Ibn Abi Shaybah 13822","","","كتاب الحج"
"13823","(۱۳۸۲۳) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأحوص ، عَنْ عَبْدِ اللہِ ؛ (فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ) قَالَ : التَّلْبِیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 13823","","","كتاب الحج"
"13824","(۱۳۸۲۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ {فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ} قَالَ : الإِہْلاَلُ۔","","Musannaf Ibn Abi Shaybah 13824","","","كتاب الحج"
"13825","(۱۳۸۲۵) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِید بن مَرْزُبَان ، عَنْ أَبِی عَوْنِ ، عَنِ ابْنِ الزُّبَیْر ؛ (فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ) قَالَ : الإِہْلاَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 13825","","","كتاب الحج"
"13826","(۱۳۸۲۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَخْبِرْنِی عَنِ الْعُمْرَۃِ ، وَاجِبَۃٌ ہِیَ ؟ قَالَ : لاَ ، وَأَنْ تَعْتَمِرَ خَیْرٌ لَک۔ (ترمذی ۹۳۱۔ احمد ۳/۳۱۶)","","Musannaf Ibn Abi Shaybah 13826","","","كتاب الحج"
"13827","(۱۳۸۲۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُعَاوِیَۃَ بْنِ إِسْحَاقَ ، عَنْ أَبِی صَالِحٍ مَاہَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَجُّ جِہَادٌ ، وَالْعُمْرَۃُ تَطَوُّعٌ۔ (طبرانی ۱۱)","","Musannaf Ibn Abi Shaybah 13827","","","كتاب الحج"
"13828","(۱۳۸۲۸) حدَّثَنَا ابْنُ إدْرِیسَ ، وَأَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : الْحَجُّ فَرِیضَۃٌ ، وَالْعُمْرَۃُ تَطَوُّعٌ۔","","Musannaf Ibn Abi Shaybah 13828","","","كتاب الحج"
"13829","(۱۳۸۲۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنِ الشَّعْبِیِّ ، قَالَ : ہِیَ تَطَوُّعٌ۔","","Musannaf Ibn Abi Shaybah 13829","","","كتاب الحج"
"13830","(۱۳۸۳۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الْعُمْرَۃِ ، وَاجِبَۃٌ ہِیَ ؟ قَالَ : قَدْ اُخْتُلِفَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 13830","","","كتاب الحج"
"13831","(۱۳۸۳۱) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْعُمْرَۃُ سُنَّۃٌ ، وَلَیْسَتْ بِفَرِیضَۃٍ۔","","Musannaf Ibn Abi Shaybah 13831","","","كتاب الحج"
"13832","(۱۳۸۳۲) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ قَرَأَہَا {وَأَتِمُّوا الْحَجَّ} ، ثُمَّ قَطَعَ ، ثُمَّ قَالَ : {وَالْعُمْرَۃُ لِلَّہِ}۔","","Musannaf Ibn Abi Shaybah 13832","","","كتاب الحج"
"13833","(۱۳۸۳۳) حدَّثَنَا عَبْدُاللہِ بْنُ إدْرِیسَ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوسٍ، وَمُجَاہِدٍ؛ قَالُوا: الْحَجُّ وَالْعُمْرَۃُ فَرِیضَتَانِ۔","","Musannaf Ibn Abi Shaybah 13833","","","كتاب الحج"
"13834","(۱۳۸۳۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ قَالُوا : وَاجِبَۃٌ۔","","Musannaf Ibn Abi Shaybah 13834","","","كتاب الحج"
"13835","(۱۳۸۳۵) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ مِنْ خَلْقِ اللہِ تَعَالَی أَحَدٌ إِلاَّ وَعَلَیْہِ حَجَّۃٌ وَعُمْرَۃٌ ، وَاجِبَتَانِ۔","","Musannaf Ibn Abi Shaybah 13835","","","كتاب الحج"
"13836","(۱۳۸۳۶) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ عَنِ الْعُمْرَۃِ ، وَاجِبَۃٌ ہِیَ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 13836","","","كتاب الحج"
"13837","(۱۳۸۳۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ ، وَعَلِیُّ بْنُ حُسَیْنٍ ، عَنِ الْعُمْرَۃِ ، أَوَاجِبَۃٌ ہِیَ ؟ فَتَلَوْا ہَذِہِ الآیَۃَ : {وَأَتِمُّوا الْحَجَّ وَالْعُمْرَۃَ}۔","","Musannaf Ibn Abi Shaybah 13837","","","كتاب الحج"
"13838","(۱۳۸۳۸) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، قَالَ : سَأَلْتُ عَطَائً ، قُلْتُ : الْعُمْرَۃُ فَرِیضَۃٌ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 13838","","","كتاب الحج"
"13839","(۱۳۸۳۹) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ، وَوَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: الْعُمْرَۃُ، الْحَجّۃُ الصُغْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 13839","","","كتاب الحج"
"13840","(۱۳۸۴۰) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ؛ فِی الَّذِی یَعْتَمِرُ قَبْلَ أَنْ یَحُجَّ ، قَالَ : نُسُکَانِ لِلَّہِ عَلَیْک ، لاَ یَضُرُّک بِأَیِّہِمَا بَدَأْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 13840","","","كتاب الحج"
"13841","(۱۳۸۴۱) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَسْرُوقٍ ، قَالَ : أُمِرْتُم بِإِقَامَۃِ الْحَجِّ وَالْعُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 13841","","","كتاب الحج"
"13842","(۱۳۸۴۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ قَالاَ : الْحَجُّ وَالْعُمْرَۃُ فَرِیضَتَانِ۔","","Musannaf Ibn Abi Shaybah 13842","","","كتاب الحج"
"13843","(۱۳۸۴۳) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالاَ : الْعُمْرَۃُ وَاجِبَۃٌ۔","","Musannaf Ibn Abi Shaybah 13843","","","كتاب الحج"
"13844","(۱۳۸۴۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ شَدَّادٍ عَنِ الْحَجِّ الأَکْبَرِ ؟ فَقَالَ : الْحَجُّ الأَکْبَرُ یوم النحر ، والْحَجُّ الأَصْغَرُ الْعُمْرَۃُ۔","","Musannaf Ibn Abi Shaybah 13844","","","كتاب الحج"
"13845","(۱۳۸۴۵) حدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ، قَالَ: کَانَ یُقَالُ: الْعُمْرَۃُ ہِیَ الْحَجَّۃُ الصُّغْرَی۔","","Musannaf Ibn Abi Shaybah 13845","","","كتاب الحج"
"13846","(۱۳۸۴۶) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ التَّیْمِیِّ ، عَنْ حَیَّانَ بْنِ عُمَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نُسُکَانِ لِلَّہِ عَلَیْک ، وَلاَ یَضُرُّک بِأَیِّہِمَا بَدَأْت۔","Sahih","Musannaf Ibn Abi Shaybah 13846","","","كتاب الحج"
"13847","(۱۳۸۴۷) حدَّثَنَا یَحْیَی بْنِ یَعْلَی ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْعُمْرَۃُ الْحَجُّ الأَصْغَرُ۔","","Musannaf Ibn Abi Shaybah 13847","","","كتاب الحج"
"13848","(۱۳۸۴۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ یَقُولُ : تُجْزِء الْمُتْعَۃُ مِنَ العُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 13848","","","كتاب الحج"
"13849","(۱۳۸۴۹) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، قَالَ : قُلْتُ لِعَطَائٍ : ہَلْ یُجْزِء عَنَّا مِمَّا افْتُرِضَ عَلَیْنَا مِنْہَا ، یَعْنِی الْعُمْرَۃَ ، التَّمَتُّعُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 13849","","","كتاب الحج"
"13850","(۱۳۸۵۰) حدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ؛ قَالُوا: الْعُمْرَۃُ وَاجِبَۃٌ، وَتُجْزِء مِنْہَا الْمُتْعَۃُ۔","","Musannaf Ibn Abi Shaybah 13850","","","كتاب الحج"
"13851","(۱۳۸۵۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، وَابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : مَنْ أَدْرَکَ عَرَفَۃَ قَبْلَ أَنْ یَطْلُعَ الْفَجْرُ فَقَدْ أَدْرَکَ الْحَجَّ ، وَمَنْ فَاتَتْہُ عَرَفَۃُ فَاتَہُ الْحَجُّ۔","","Musannaf Ibn Abi Shaybah 13851","","","كتاب الحج"
"13852","(۱۳۸۵۲) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ مِثْلَہُ۔ (دارقطنی ۲۱)","Da'if","Musannaf Ibn Abi Shaybah 13852","","","كتاب الحج"
"13853","(۱۳۸۵۳) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ الزُّبَیْرِ قَالاَ : مَنْ وَطِئَ عَرَفَۃَ بِلَیْلٍ ، فَقَدْ أَدْرَکَ الْحَجَّ۔","","Musannaf Ibn Abi Shaybah 13853","","","كتاب الحج"
"13854","(۱۳۸۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُسَیْنِ بْنِ عَبْدِ اللہِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ وَقَفَ بِعَرَفَاتٍ بِلَیْلٍ فَقَدْ أَدْرَکَ الْحَجَّ ، إِنَ اتَّقَی وَبَرَّ۔","Da'if","Musannaf Ibn Abi Shaybah 13854","","","كتاب الحج"
"13855","(۱۳۸۵۵) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : إذَا وَقَفَ الرَّجُلُ بِعَرَفَۃَ بِلَیْلٍ فَقَدْ تَمَّ حَجُّہُ ، وَإِنْ لَمْ یُدْرِکِ النَّاسَ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 13855","","","كتاب الحج"
"13856","(۱۳۸۵۶) حدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَسُلَیْمَانَ بْنِ یَسَارٍ ، وَعَطَائِ بْنِ أَبِی رَبَاحٍ، وَسَالِمِ بْنِ عَبْدِاللہِ؛ قَالُوا: إذَا وَقَفَ بِلَیْلٍ بِعَرَفَاتٍ فَقَدْ أَدْرَکَ الْحَجَّ، وَإِنْ لَمْ یُدْرِکِ النَّاسَ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 13856","","","كتاب الحج"
"13857","(۱۳۸۵۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ بَکْرٍ ، عَنْ سَالِمٍ ، قَالَ : مَنْ وَقَفَ بِعَرَفَۃَ بِلَیْلٍ فَقَدْ أَدْرَکَ الْحَجَّ ، وَإِنْ لَمْ یُدْرِکَ النَّاسَ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 13857","","","كتاب الحج"
"13858","(۱۳۸۵۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : مَنْ وَقَفَ بِعَرَفَۃَ بِلَیْلٍ قَبْلَ أَنْ یَطْلُعَ الْفَجْرُ فَقَدْ أَدْرَکَ الْحَجَّ ، وَمَنْ لاَ فَقَدْ فَاتَہُ ، فَلْیَطُفْ بِالْبَیْتِ وَلْیَسْعَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، وَیَحْلِقُ رَأْسَہُ ، وَیُحِلُّ ، وَیَحُجُّ مِنَ الْعَامِ الْمُقْبِلِ وَیُہْدِی ، فَإِنْ لَمْ یَجِدْ فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ فِی الْحَجِّ وَسَبْعَۃٍ إذَا رَجَعَ۔","","Musannaf Ibn Abi Shaybah 13858","","","كتاب الحج"
"13859","(۱۳۸۵۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ أَنَّہُمَا قَالاَ : إذَا وَقَفَ الرَّجُلُ بِعَرَفَاتٍ قَبْلَ طُلُوعِ الْفَجْرِ لَیْلَۃَ النَّحْرِ ، فَقَدْ أَدْرَکَ الْحَجَّ ، وَإِنْ لَمْ یُدْرِکِ النَّاسَ بِجَمْعٍ۔","","Musannaf Ibn Abi Shaybah 13859","","","كتاب الحج"
"13860","(۱۳۸۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ فَاتَتْہُ عَرَفَۃُ ، أَوْ جَمْعٌ فَاتَہُ الْحَجُّ۔","","Musannaf Ibn Abi Shaybah 13860","","","كتاب الحج"
"13861","(۱۳۸۶۱) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَنْ أَدْرَکَ عَرَفَۃَ قَبْلَ طُلُوعِ الْفَجْرِ، فَقَدْ أَدْرَکَ الْحَجَّ۔","","Musannaf Ibn Abi Shaybah 13861","","","كتاب الحج"
"13862","(۱۳۸۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عُرْوَۃَ بْنِ مُضَرِّسٍ الطَّائِیِّ ؛ أَنَّہُ حَجَّ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یُدْرِکِ النَّاسَ إِلاَّ وَہُمْ بِجَمْعٍ ، قَالَ : فَأَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقُلْتُ : یَا رَسُولَ اللہِ ، أَتْعَبْتُ نَفْسِی وَأَنْضَیْتُ رَاحِلَتِی ، وَاللَّہِ مَا تَرَکْتُ حَبْلاً مِنَ الْحِبَالِ إِلاَّ وَقَد وَقَفْت عَلَیْہِ ، فَہَلْ لِی مِنْ حَجٍّ ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی مَعَنَا ہَذِہِ الصَّلاَۃَ ، وَقَدْ أفَاضَ قَبْلَ ذَلِکَ مِنْ عَرَفَاتٍ لَیْلاً ، أَوْ نَہَارًا ، فَقَدْ قَضَی تَفَثَہُ وَتَمَّ حَجُّہُ۔ (ترمذی ۸۹۱۔ ابوداؤد ۱۹۴۵)","Sahih","Musannaf Ibn Abi Shaybah 13862","","","كتاب الحج"
"13863","(۱۳۸۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ بُکَیْرِ بْنِ عَطَائٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَعْمُرَ ، قَالَ : سَمِعْتُہُ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ وَاقِفٌ بِعَرَفَۃَ ، وَأَتَاہُ نَاسٌ مِنْ أَہْلِ مَکَّۃَ فَقَالُوا : یَا رَسُولَ اللہِ ، کَیْفَ الْحَجُّ ؟ قَالَ : الْحَجُّ عَرَفَۃُ ، فَمَنْ جَائَ قَبْلَ طُلُوعِ الْفَجْرِ لَیْلَۃَ جَمْعٍ فَقَدْ تَمَّ حَجُّہُ ، مِنًی ثَلاَثَۃُ أَیَّامٍ ، فَمَنْ تَعَجَّلَ فِی یَوْمَیْنِ فَلاَ إِثْمَ عَلَیْہِ ، وَمَنْ تَأَخَّرَ فَلاَ إِثْمَ عَلَیْہِ ، ثُمَّ أَرْدَفَ رَجُلاً خَلْفَہُ یُنَادِی بہِنَّ۔n(ترمذی ۸۸۹۔ ابوداؤد ۱۹۴۴)","Sahih","Musannaf Ibn Abi Shaybah 13863","","","كتاب الحج"
"13864","(۱۳۸۶۴) حدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، وَزَیْدٍ ؛ قَالاَ : فِی الرَّجُلِ یَفُوتُہُ الْحَجُّ : یُحِلُّ بِعُمْرَۃٍ ، وَعَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13864","","","كتاب الحج"
"13865","(۱۳۸۶۵) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ لَمْ یُدْرِکْ فَعَلَیْہِ دَمٌ ، وَیَجْعَلُہَا عُمْرَۃً ، وَعَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13865","","","كتاب الحج"
"13866","(۱۳۸۶۶) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 13866","","","كتاب الحج"
"13867","(۱۳۸۶۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ فِی الَّذِی یَفُوتُہُ الْحَجُّ ، قَالَ : تَعُودُ حَجَّتُہُ عُمْرَۃً۔","","Musannaf Ibn Abi Shaybah 13867","","","كتاب الحج"
"13868","(۱۳۸۶۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ؛ فِی الَّذِی یَفُوتُہُ الْحَجُّ ، قَالَ : یَجْعَلُہَا عُمْرَۃً ، وَعَلَیْہِ الْحَجُّ مِنَ الْعَامِ التَّابِعِ وَیُہْدِی ، فَإِنْ لَمْ یَجِدْ صَامَ ثَلاَثَۃَ أَیَّامٍ فِی الْحَجِّ ،وَسَبْعَۃً إذَا رَجَعَ۔","","Musannaf Ibn Abi Shaybah 13868","","","كتاب الحج"
"13869","(۱۳۸۶۹) حدّ[corrupt]ثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْہَیْثُمِ ، عَنْ طلحۃ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہ قَالَ : إذَا فَاتَہ الْحَجُّ جَعَلَہا عُمْرَۃً، وَعَلَیْہِ الْہَدْیُ أَحَبُّ إِلَیَّ۔","","Musannaf Ibn Abi Shaybah 13869","","","كتاب الحج"
"13870","(۱۳۸۷۰) حدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یَجْعَلُہَا عُمْرَۃً ، وَعَلَیْہِ الْہَدْیُ والْحَجّ من قابل۔","","Musannaf Ibn Abi Shaybah 13870","","","كتاب الحج"
"13871","(۱۳۸۷۱) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، قَالَ : یُحِلُّ بِعُمْرَۃٍ ، وَعَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13871","","","كتاب الحج"
"13872","(۱۳۸۷۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ مِہْرَانٍ أَبِی صَفْوَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَرَاْدَ مِنْکُمُ الْحَجَّ فَلْیَتَعَجَّلْ۔ (ابوداؤد ۱۷۲۹۔ احمد ۱/۲۲۵)","Da'if","Musannaf Ibn Abi Shaybah 13872","","","كتاب الحج"
"13873","(۱۳۸۷۳) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ حَبِیبٌ وَأَصْحَابُہُ یَتَأَخَّرُونَ حَتَّی یَدْخُلَ مِنْ ذِی الْقَعْدَۃِ مَا شَائَ اللَّہُ ، فَکَرِہَ ذَلِکَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 13873","","","كتاب الحج"
"13874","(۱۳۸۷۴) حدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : کَانَ طَاوُوس یَقْدُمُ فِی أَوَّلِ النَّاسِ ، وَیَنْفِرُ فِی آخِرِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 13874","","","كتاب الحج"
"13875","(۱۳۸۷۵) حدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ لاَ یَرَی بَأْسًا أَنْ یَشْتَرِیَ الرَّجُلُ الْبَعِیرَ یَتَعَجَّلُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 13875","","","كتاب الحج"
"13876","(۱۳۸۷۶) حدَّثَنَا أَبُو أُسَامَۃَ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ، عَنْ جَدِّہِ أَبِی بُرْدَۃَ ، قَالَ: أَہْلَلْتُ ہِلالَ ذِی الْحِجَّۃِ بِالْکُوفَۃِ، ثُمَّ وَافَیْتُ النَّاسَ بِالْمَوْقِفِ عَشِیَّۃَ عَرَفَۃَ ، فَلَمْ یَعِبْ ذَلِکَ أَبُو مُوسَی۔","Sahih","Musannaf Ibn Abi Shaybah 13876","","","كتاب الحج"
"13877","(۱۳۸۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ بُرْجَانٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ سَارَ مِنَ الْبَصْرَۃِ إلَی مَکَّۃَ فِی اثْنَتَیْ عَشَرَۃ ، أَوْ ثَلاَثَ عَشْرَۃَ ۔ الشَّکُّ مِنِّی۔","","Musannaf Ibn Abi Shaybah 13877","","","كتاب الحج"
"13878","(۱۳۸۷۸) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ ، قَالَ : سَارَ إلَیْنَا عَبْدُ اللہِ مِنَ الْمَدِینَۃِ حِینَ قُتِلَ عُمَرُ فِی سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 13878","","","كتاب الحج"
"13879","(۱۳۸۷۹) حدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سَارَ مِنْ مَکَّۃَ إلَی الْمَدِینَۃِ فِی ثَلاَثٍ ، حِینَ اُسْتُصْرِخَ عَلَی صَفِیَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 13879","","","كتاب الحج"
"13880","(۱۳۸۸۰) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَمَتَّعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ ، وَعُثْمَانُ ، وَأَوَّلُ مَنْ نَہَی عَنْہَا مُعَاوِیَۃُ۔ (ترمذی ۸۲۲۔ احمد ۱/۲۹۲)","Da'if","Musannaf Ibn Abi Shaybah 13880","","","كتاب الحج"
"13881","(۱۳۸۸۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : لَوِ اعْتَمَرْت ، ثُمَّ اعْتَمَرْت ، ثُمَّ حَجَجْت ، لَتَمَتَّعْت۔","Sahih","Musannaf Ibn Abi Shaybah 13881","","","كتاب الحج"
"13882","(۱۳۸۸۲) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ، عَنْ عُمَرَ بْنِ ذَرٍّ، عَنْ مُجَاہِدٍ، قَالَ: کَانَ ابْنُ عُمَرَ، وَابْنُ عَبَّاسٍ یَقْدَمَانِ مُتَمَتِّعَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 13882","","","كتاب الحج"
"13883","(۱۳۸۸۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ التَّیْمِیِّ، عَنْ غُنَیْمِ بْنِ قَیْسٍ، قَالَ: سَأَلْتُ سَعْدًا عَنِ الْمُتْعَۃِ، أَوْ عَنِ الْجَمْعِ بَیْنَہُمَا ؟ فَقَالَ : فَعَلْنَا ہَذَا ، وَہَذَا کَافِرٌ بِرَبِّ الْکَعْبَۃِ ، أَوْ بِرَبِّ الْعَرْشِ ۔ یَعْنِی مُعَاوِیَۃَ۔ (مسلم ۸۹۸)","Sahih","Musannaf Ibn Abi Shaybah 13883","","","كتاب الحج"
"13884","(۱۳۸۸۴) حدَّثَنَا معتمر بن سُلَیْمَانَ ، عَنْ أَبِی مَعْنٍ ، قَالَ : سمِعْتُ ابْنَ عَمَرَ ، وَابْنَ الزُّبَیْرِ ، وَجَابِرَ بْنَ زَیْدٍ ، وَأَبَا الْعَالِیَۃِ ، وَالْحَسَنَ یَأْمُرُونَ بِمُتْعَۃِ الْحَجِّ۔","Da'if","Musannaf Ibn Abi Shaybah 13884","","","كتاب الحج"
"13885","(۱۳۸۸۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ الْعَوَّامِ ، عَنْ طَاوُوسٍ ، قَالَ : إِنَّ تَمَامَ الْحَجِّ الْعُمْرَۃُ قَبْلَہُ۔","","Musannaf Ibn Abi Shaybah 13885","","","كتاب الحج"
"13886","(۱۳۸۸۶) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ شُعَیْبِ بْنِ الْحَبْحَابِ ، قَالَ : أَمَرَنِی أَبُو الْعَالِیَۃِ بِمُتْعَۃِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13886","","","كتاب الحج"
"13887","(۱۳۸۸۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : سَمِعْتُ عَطَائً یَأْمُرُ بِمُتْعَۃِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 13887","","","كتاب الحج"
"13888","(۱۳۸۸۸) حدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ بْنِ أَبِی الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : أَیْنَ أَنْتَ مِنَ الْمُتْعَۃِ ؟ تَجْعَلُ غُرْزَتَیْنِ فِی غُرْزَۃٍ۔","","Musannaf Ibn Abi Shaybah 13888","","","كتاب الحج"
"13889","(۱۳۸۸۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : قَالَ مُجَاہِدٌ : لَوْ حَجَجْت مِنْ أَرْضِکَ ہَذِہِ ، یَعْنِی الْکُوفَۃَ ، سَبْعِینَ حَجَّۃً ، لَجَعَلْت مَعَ کُلِّ حَجَّۃٍ عُمْرَۃً ، قَالَ : فَقُلْتُ : أَقْرِنُ ؟ قَالَ : لاَ ، قَالَ : اجْعَلْہَا عُمْرَۃً بَتْلاً۔","","Musannaf Ibn Abi Shaybah 13889","","","كتاب الحج"
"13890","(۱۳۸۹۰) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَرَاہَا قَبْلَ أَنْ یَحُجَّ ، وَلَوْ حَجَّ الرَّجُلُ عِشْرِینَ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 13890","","","كتاب الحج"
"13891","(۱۳۸۹۱) حدَّثَنَا یَعْلَی ، عَنْ أَبِی بِسْطَامٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لَوْ حَجَجْتُ ثَمَانِینَ حَجَّۃً ، لَجَعَلْتُ مَعَ کُلِّ حَجَّۃٍ مُتْعَۃً۔","","Musannaf Ibn Abi Shaybah 13891","","","كتاب الحج"
"13892","(۱۳۸۹۲) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: حجَجْتُ أَرْبَعِینَ حَجَّۃً، مَا خَرَجْت إِلاَّ مُتَمَتِّعًا۔","","Musannaf Ibn Abi Shaybah 13892","","","كتاب الحج"
"13893","(۱۳۸۹۳) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ ثَمَانیَۃَ نَفَرٍ عَنِ الْمُتْعَۃِ ؟ فَکُلُّہُمْ أَمَرَنِی بِہَا ، الْحَسَنُ ، وَعَطَائٌ ، وَطَاوُوسٌ ، وَجَابِرُ بْنُ زَیْدٍ ، وَسَالِمُ بْنُ عَبْدِ اللہِ ، وَعِکْرِمَۃُ ، وَمُجَاہِدٌ ، وَالْقَاسِمُ۔","","Musannaf Ibn Abi Shaybah 13893","","","كتاب الحج"
"13894","(۱۳۸۹۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : کَانَتِ الْمُتْعَۃُ لأَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاصَّۃً۔ (مسلم ۱۶۰۔ ابن ماجہ ۲۹۸۵)","Sahih","Musannaf Ibn Abi Shaybah 13894","","","كتاب الحج"
"13895","(۱۳۸۹۵) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَیَّاشِ الْعَامِرِیِّ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : کَانَتْ لَنَا رخصۃ ، یَعْنِی الْمُتْعَۃَ فِی الْحَجِّ۔","Sahih","Musannaf Ibn Abi Shaybah 13895","","","كتاب الحج"
"13896","(۱۳۸۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، قَالَ : سَأَلْتُ عَلْقَمَۃَ عَنِ الْمُتْعَۃِ فِی الْحَجِّ؟ فَقَالَ : مَا شَعَرْتُ أَن أَحَدًا یَفْعَلُہَا۔","","Musannaf Ibn Abi Shaybah 13896","","","كتاب الحج"
"13897","(۱۳۸۹۷) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ لاَ یَرَی الْمُتْعَۃَ قَبْلَ الْحَجِّ ، وَیَقُولُ : ابْدَأْ بِالْحَجِّ وَاعْتَمِرْ۔","","Musannaf Ibn Abi Shaybah 13897","","","كتاب الحج"
"13898","(۱۳۸۹۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامِ بْنِ حَسَّانٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : إنَّمَا الْمُتْعَۃُ لِلْمُحْصَرِ، وَتَلاَ ہَذِہِ الآیَۃَ : {فَإِذَا أَمِنْتُمْ فَمَنْ تَمَتَّعَ بِالْعُمْرَۃِ إلَی الْحَجِّ فَمَا اسْتَیْسَرَ مِنَ الْہَدْیِ}۔","","Musannaf Ibn Abi Shaybah 13898","","","كتاب الحج"
"13899","(۱۳۸۹۹) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُزَاحِمِ بْنِ أَبِی مُزَاحِمٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عَبْدِ اللہِ بْنِ خَالِدِ بْنِ أُسَیْدٍ ، عَنْ مُحَرِّشٍ الْکَعْبِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اعْتَمَرَ مِنَ الْجِعْرَانَۃِ ، ثم أصبح بِالْجِعْرَانَۃِ کَبَائِتٍ۔ (ترمذی ۹۳۵۔ نسائی ۳۸۴۶)","Hasan","Musannaf Ibn Abi Shaybah 13899","","","كتاب الحج"
"13900","(۱۳۹۰۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقَامَ فِی عُمْرَتِہِ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 13900","","","كتاب الحج"
"13901","(۱۳۹۰۱) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ شَیْخٍ مِنْ بَنِی غِفَارٍ مِنْ أَہْلِ مَکَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی حَیَّۃَ ، قَالَ : کَانَ أَبُو ذَرٍّ إذَا دَخَلَ مَکَّۃَ لَمْ یَقُمْ بِہَا إِلاَّ ثَلاَثًا ، حَتَّی یَخْرُجَ ، یَعْنِی لِحَجٍّ ، أَوْ بِعُمْرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 13901","","","كتاب الحج"
"13902","(۱۳۹۰۲) حدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ سَہلٍ ، قَالَ : لَقَدْ رَأَیْت عُثْمَانَ یَقْدُمُ مَکَّۃَ وَنَحْنُ مَعَہُ ، فَمَا یَحِلُّ بِہَا عُقْدَۃً حَتَّی یَخْرُجَ ، مَا یَزِیدُ عَلَی أَنْ یَطُوفَ بِالْبَیْتِ ، وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 13902","","","كتاب الحج"
"13903","(۱۳۹۰۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ یُقِیمَ الْمُحْرِمُ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 13903","","","كتاب الحج"
"13904","(۱۳۹۰۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13904","","","كتاب الحج"
"13905","(۱۳۹۰۵) حدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَدِمَ لَیْلاً وَہُوَ مُعْتَمِرٌ ، فَقَضَی عُمْرَتَہُ مِنْ لَیْلَتِہِ ، ثُمَّ نَفَرَ قَبْلَ أَنْ یُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 13905","","","كتاب الحج"
"13906","(۱۳۹۰۶) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یُقِیمُوا فِی الْعُمْرَۃِ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 13906","","","كتاب الحج"
"13907","(۱۳۹۰۷) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ جَعْفَرِ بْنِ سُلَیْمَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یُقِیمُونَ مُعْتَمِرِینَ ، فَیَقْضُونَ الطَّوَافَ ، ثُمَّ یَخْرُجُونَ مِنْ لَیْلَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 13907","","","كتاب الحج"
"13908","(۱۳۹۰۸) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقْدُمُ حَاجًّا ، أَوْ مُعْتَمِرًا فَلاَ یُقِیمُ إِلاَّ ثَلاَثًا حَتَّی یَخْرُجَ۔","","Musannaf Ibn Abi Shaybah 13908","","","كتاب الحج"
"13909","(۱۳۹۰۹) حدَّثَنَا الْفَضْلُ ، عَنْ أَفْلَحَ ، قَالَ : أَقَمْتُ مَعَ الْقَاسِمِ بْنِ مُحَمَّدٍ فِی الْعُمْرَۃِ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 13909","","","كتاب الحج"
"13910","(۱۳۹۱۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَفْلَحَ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ أَقَامَ فِی الْعُمْرَۃِ ثَلاَث لیال۔","","Musannaf Ibn Abi Shaybah 13910","","","كتاب الحج"
"13911","(۱۳۹۱۱) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : سَمِعْتُ مَشْیَخَتَنَا یَذْکُرُونَ أَنَّ عَاصِمَ بْنَ عُمَرَ بْنِ الْخَطَّابِ کَانَ یَأْتِی مَکَّۃَ مُعْتَمِرًا ، فَلاَ یَحِلُّ رَحْلَہُ حَتَّی یَرْجِعَ۔","","Musannaf Ibn Abi Shaybah 13911","","","كتاب الحج"
"13912","(۱۳۹۱۲) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مُزَاحِمِ بْنِ أَبِی مُزَاحِمٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عَبْدِ اللہِ بْنِ خَالِدِ بْنِ أُسَیْدٍ ، عَنْ مُحَرِّشٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اعْتَمَرَ مِنَ الْجِعْرَانَۃِ ، ثُمَّ أَصْبَحَ بِہَا کَبَائِتٍ۔ قَالَ : وَرَأَیْتُ ظَہْرَہُ کَأَنَّہُ سَبِیکَۃُ فِضَّۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 13912","","","كتاب الحج"
"13913","(۱۳۹۱۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ تُرْکَبُ الْبَدَنَۃُ إِلاَّ مَزْمُومَۃً ، أَوْ مَخْطُومَۃً ، أَوْ مَخْشُوشَۃً۔","","Musannaf Ibn Abi Shaybah 13913","","","كتاب الحج"
"13914","(۱۳۹۱۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : تُقَطَّرُ وَتُخْطِمُ إذَا خَافَ عَلَیْہَا أَنْ تَہْلکَ۔","","Musannaf Ibn Abi Shaybah 13914","","","كتاب الحج"
"13915","(۱۳۹۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَخْطِمُ بَدَنَتَہُ ، وَکَانَ ابْنُ الزُّبَیْرِ یَفْعَلُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 13915","","","كتاب الحج"
"13916","(۱۳۹۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : اخْطِمِ الْبَدَنَۃَ وَاضْرِبْہَا۔","","Musannaf Ibn Abi Shaybah 13916","","","كتاب الحج"
"13917","(۱۳۹۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلْقَمَۃَ ، وَالأَسْوَدَ ، وَعَمْرَو بْنَ مَیْمُونٍ کَانُوا لاَ یَزُمُّونَ رَوَاحِلَہُمْ۔","","Musannaf Ibn Abi Shaybah 13917","","","كتاب الحج"
"13918","(۱۳۹۱۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَبَا بَکْرٍ ، وَعُمَرَ ، کَانُوا یَمْشُونَ إلَی الْجِمَارِ ۔ قَالَ : وَکَانَ عَلِیُّ بْنُ حُسَیْنٍ یَمْشِی إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 13918","","","كتاب الحج"
"13919","(۱۳۹۱۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنِ ابْنِ جُرَیْجٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَمْشِی إلَیْہَا مُقْبِلاً وَمُدْبِرًا۔","","Musannaf Ibn Abi Shaybah 13919","","","كتاب الحج"
"13920","(۱۳۹۲۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : أَدْرَکْتُ النَّاسَ یَمْشُونَ مُقْبِلِینَ وَمُدْبِرِینَ۔","","Musannaf Ibn Abi Shaybah 13920","","","كتاب الحج"
"13921","(۱۳۹۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ یَرْمِی الْجِمَارَ مَاشِیًا۔","Sahih","Musannaf Ibn Abi Shaybah 13921","","","كتاب الحج"
"13922","(۱۳۹۲۲) حدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ عُبِیدَۃَ ابْنَۃِ نَابِلٍ، قَالَتْ: رَأَیْت عَائِشَۃَ ابنۃ سَعْدٍ تَرْمِی الْجِمَارَ وَہِیَ مَاشِیَۃٌ۔","","Musannaf Ibn Abi Shaybah 13922","","","كتاب الحج"
"13923","(۱۳۹۲۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَرْمِی الْجِمَارَ مَاشِیًا ، ذَاہِبًا وَرَاجِعًا۔","Sahih","Musannaf Ibn Abi Shaybah 13923","","","كتاب الحج"
"13924","(۱۳۹۲۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَمْ یَکُنْ یُوجِبُ الْمَشْیَ إلَیْہَا ، وَکَانَ یَقُولُ: وَلَمْ یَرْکَبْ وَہُوَ صَحِیحٌ؟!","","Musannaf Ibn Abi Shaybah 13924","","","كتاب الحج"
"13925","(۱۳۹۲۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ؛ أَنَّہُ کَانَ لاَ یَرْکَبُ إلَی الْجِمَارِ ، إِلاَّ مِنْ ضَرُورَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13925","","","كتاب الحج"
"13926","(۱۳۹۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ السَّائِبِ ، عَنْ مُحَمَّدِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ رَأَی رَجُلاً یَقُودُ بِامْرَأَتِہِ عَلَی بَعِیرٍ یَرْمِی الْجَمْرَۃَ ، قَالَ : فَعَلاَہُ بِالدِّرَّۃِ ، إنْکَارًا لِرُکُوبِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 13926","","","كتاب الحج"
"13927","(۱۳۹۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنَ بْنِ نَابِلٍ ، عَنْ قُدَامَۃَ بْنِ عَبْدِ اللہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَی جَمْرَۃَ الْعَقَبَۃِ یَوْمَ النَّحْرِ عَلَی نَاقَۃٍ لَہُ صَہْبَائَ ، لاَ ضَرْبَ ، وَلاَ طَرْدَ ، وَلاَ إلَیْکَ إلَیْکَ۔n(ترمذی ۹۰۳۔ احمد ۳/۴۱۲)","Hasan","Musannaf Ibn Abi Shaybah 13927","","","كتاب الحج"
"13928","(۱۳۹۲۸) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَی الْجَمْرَۃَ عَلَی رَاحِلَتِہِ۔ (ترمذی ۸۹۹)","","Musannaf Ibn Abi Shaybah 13928","","","كتاب الحج"
"13929","(۱۳۹۲۹) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ الْفَزَارِیُّ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، قَالَ : رَأَیْتُ ابْنَ الْحَنَفِیَّۃِ یَرْمِی الْجِمَارَ عَلَی بِرْذَوْنٍ۔","","Musannaf Ibn Abi Shaybah 13929","","","كتاب الحج"
"13930","(۱۳۹۳۰) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ ہَارُونَ بْنِ أَبِی إِبْرَاہِیمَ ، عَن عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَاقِفًا عِنْدَ الْجَمْرَۃِ عَلَی حِمَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13930","","","كتاب الحج"
"13931","(۱۳۹۳۱) حدَّثَنَا وَکِیعٌ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ عَطَائٍ، قَالَ: رُکُوبُ یَوْمَیْنِ، وَمَشْیُ یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 13931","","","كتاب الحج"
"13932","(۱۳۹۳۲) حدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ حَجَّاجٍ، قَالَ: رَأَیتُ عَطَائً یَرْمِی الْجَمْرَۃَ عَلَی دَابَّۃٍ، فَقُلْتُ لَہُ؟ فَقَالَ: إِنِّی شَیْخٌ کَبِیرٌ۔","","Musannaf Ibn Abi Shaybah 13932","","","كتاب الحج"
"13933","(۱۳۹۳۳) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إبْرَاہِیمَ بْنِ نافع ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنََّہُ کَانَ یَرْمِی الْجَمْرَۃَ وَہُوَ رَاکِبٌ۔","","Musannaf Ibn Abi Shaybah 13933","","","كتاب الحج"
"13934","(۱۳۹۳۴) حدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ عَبَایَۃَ ، قَالَ : رَأَیْتُ سَالِمًا یَرْمِی الْجِمَارَ وَہُوَ عَلَی حِمَارٍ۔","","Musannaf Ibn Abi Shaybah 13934","","","كتاب الحج"
"13935","(۱۳۹۳۵) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ یَجِیئُ فَیَرْمِی الْجَمْرَۃَ یَوْمَ النَّحْرِ ، وَہُوَ رَاکِبٌ۔","","Musannaf Ibn Abi Shaybah 13935","","","كتاب الحج"
"13936","(۱۳۹۳۶) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، قَالَ : حدَّثَنَا عَمْرٌو ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُنْتُ مِمَّنْ قَدَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ضَعَفَۃِ أَہْلِہِ۔ (مسلم ۳۰۳۔ ابن ماجہ ۳۰۲۶)","Sahih","Musannaf Ibn Abi Shaybah 13936","","","كتاب الحج"
"13937","(۱۳۹۳۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، قَالَ : أَخْبَرَنَا عُبَیْدُ اللہِ بْنُ أَبِی یَزِیدَ ؛ أَنَّہُ سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : أَنَا مِمَّنْ قَدَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ضَعَفَۃِ أَہْلِہِ۔ (بخاری ۱۶۷۸۔ ابوداؤد ۱۹۳۴)","Sahih","Musannaf Ibn Abi Shaybah 13937","","","كتاب الحج"
"13938","(۱۳۹۳۸) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قدَّمَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أُغَیْلِمَۃَ بَنِی عَبْدِ الْمُطَّلِبِ عَلَی حُمُرَاتٍ مِنْ جَمْعٍ ، وَجَعَلَ یَلْطَحُ أَفْخَاذَنَا وَیَقُولُ : أُبَیْنِیَّ ، لاَ تَرْمُوا الْجَمْرَۃَ حَتَّی تَطْلُعَ الشَّمْسُ۔n زَادَ سُفْیَانُ فِیہِ : وَلاَ إِخَالُ أَحَدًا یَرْمِیہَا حَتَّی تَطْلُعَ الشَّمْسُ۔ (ابوداؤد ۱۹۳۵۔ طحاوی ۲۱۷)","Hasan","Musannaf Ibn Abi Shaybah 13938","","","كتاب الحج"
"13939","(۱۳۹۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ أُمَّ سَلَمَۃَ أَنْ تُوَافِیَہُ صَلاَۃَ الصُّبْحِ بِمِنًی۔","","Musannaf Ibn Abi Shaybah 13939","","","كتاب الحج"
"13940","(۱۳۹۴۰) حدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَدَّمَ ضَعَفَۃَ أَہْلِہِ ، وَقَالَ : لاَ تَرْمُوا الْجَمْرَۃَ حَتَّی تَطْلُعَ الشَّمْسُ۔ (ترمذی ۸۹۳۔ احمد ۱/۳۴۴)","","Musannaf Ibn Abi Shaybah 13940","","","كتاب الحج"
"13941","(۱۳۹۴۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ دِینَارٍ ، عَنْ سَالِمِ بْنِ شَوَّالٍ ، عَنْ أُمِّ حَبِیبَۃَ قَالَتْ : کُنَّا نَفْعَلُہُ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۲۹۹۔ احمد ۴۲۶)","Sahih","Musannaf Ibn Abi Shaybah 13941","","","كتاب الحج"
"13942","(۱۳۹۴۲) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ الشَّوَّالِ ، قَالَ : قَالَ عَبْدُ اللہِ بن عُمَرَ ؛ إنَّمَا جَمْعٌ مَنْزِلٌ تَرْتَحِلُ مِنْہُ مَتی شِئْتَ۔","","Musannaf Ibn Abi Shaybah 13942","","","كتاب الحج"
"13943","(۱۳۹۴۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَبْدِ اللہِ مَوْلَی أَسْمَائَ ؛ أَنَّہَا کَانَتْ تُصَلِّی الصُّبْحَ بِمِنًی۔","Sahih","Musannaf Ibn Abi Shaybah 13943","","","كتاب الحج"
"13944","(۱۳۹۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ؛ أَنَّ عَبْدَ الرَّحْمَن بْنَ عَوْفٍ کَانَ یُعَجِّلُ النِّسَائَ وَالصِّبْیَانَ مِنْ جَمْعٍ بِلَیْلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 13944","","","كتاب الحج"
"13945","(۱۳۹۴۵) حدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تُقَدِّمُ ضَعَفَۃَ أَہْلِہَا مِنْ جَمْعٍ بِلَیْلٍ ، قَالَ عَطَائٌ : وَإنِّی لأَفْعَلُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 13945","","","كتاب الحج"
"13946","(۱۳۹۴۶) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُرَخِّصُ لِلْکَبِیرِ وَالْمَرِیضِ أَنْ یُفِیضُوا مِنْ جَمْعٍ بِلَیْلٍ، وَلَکِنْ لاَ یَرْمِی جَمْرَۃَ الْعَقَبَۃِ حَتَّی تَطْلُعَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 13946","","","كتاب الحج"
"13947","(۱۳۹۴۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، قَالَ : رُخِّصَ لِلْمَرِیضِ وَالْحُبْلَی وَمَنْ کَانَتْ بِہِ عِلَّۃٌ أَنْ یُفِیضُوا مِنْ جَمْعٍ بِلَیْلٍ ، وَلاَ یَرْمُوا الْجِمَارَ حَتَّی تَطْلُعَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 13947","","","كتاب الحج"
"13948","(۱۳۹۴۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ ابْنُ عُمَرَ یَبْعَثُ بِصِبْیَانِہِ لَیْلَۃَ الْمُزْدَلِفَۃِ ، فَیُصَلُّوانَ الصُّبْحَ بِمِنًی ، وَیَرْمُوانَ الْجَمْرَۃَ قَبْلَ أَنْ یَأْتِیَ النَّاسُ۔","Sahih","Musannaf Ibn Abi Shaybah 13948","","","كتاب الحج"
"13949","(۱۳۹۴۹) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی الزِّناد ؛ أَنَّ ابْنَ عَوْفٍ کَانَ یُصَلِّی بِأُمَّہَاتِ الْمُؤْمِنِینَ الْفَجْرَ بِمِنًی۔","","Musannaf Ibn Abi Shaybah 13949","","","كتاب الحج"
"13950","(۱۳۹۵۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَہَانِیِّ ، قَالَ : حدَّثَنَا ابْنُ مَعْقِلٍ ، قَالَ : حدَّثَنِی کَعْبُ بْنُ عُجْرَۃَ ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ ہَوَامُّ رَأْسِہِ آذَیْنَہُ ، قَالَ لِی : اذْبَحْ شَاۃً نُسُکًا ، أَوْ صُمْ ثَلاَثَۃَ أَیَّامٍ ، أَوْ أَطْعِمْ سِتَّۃَ مَسَاکِینَ ، بَیْنَ کُلِّ مِسْکِینَیْنِ صَاعٌ مِنْ تَمْرٍ۔ (بخاری ۱۸۱۶۔ مسلم ۸۵)","Sahih","Musannaf Ibn Abi Shaybah 13950","","","كتاب الحج"
"13951","(۱۳۹۵۱) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَمُجَاہِدٍ ؛ فِی قَوْلِہِ تَعَالَی : {فَفِدْیَۃٌ مِنْ صِیَامٍ ، أَوْ صَدَقَۃٍ ، أَوْ نُسُکٍ} قَالاَ : الصِّیَامُ ثَلاَثَۃُ أَیَّامٍ ، وَالصَّدَقَۃُ ثَلاَثَۃُ آصُعٍ ، وَالنُّسُکُ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13951","","","كتاب الحج"
"13952","(۱۳۹۵۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الْفِدْیَۃُ صِیَامُ عَشَرَۃِ أَیَّامٍ ،وَالصَّدَقَۃُ عَشَرَۃُ مَسَاکِینَ ، وَالنُّسُکُ ذَبِیحَۃٌ۔","","Musannaf Ibn Abi Shaybah 13952","","","كتاب الحج"
"13953","(۱۳۹۵۳) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : الصِّیَامُ ثَلاَثَۃُ أَیَّامٍ ، وَالصَّدَقَۃُ سِتَّۃُ مَسَاکِینَ ، وَالنُّسُکُ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13953","","","كتاب الحج"
"13954","(۱۳۹۵۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13954","","","كتاب الحج"
"13955","(۱۳۹۵۵) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : الصِّیَامُ ثَلاَثَۃُ أَیَّامٍ ، وَالصَّدَقَۃُ ثَلاَثَۃُ آصُعٍ بَیْنَ سِتَّۃِ مَسَاکِینَ ، وَالنُّسُکُ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 13955","","","كتاب الحج"
"13956","(۱۳۹۵۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلَنِی سَعِیدُ بْنُ جُبَیْرٍ فَأَخْبَرْتُہُ ، فَقَالَ : ہَکَذَا قَالَ ابْنُ عَبَّاسٍ۔","","Musannaf Ibn Abi Shaybah 13956","","","كتاب الحج"
"13957","(۱۳۹۵۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: حدَّثَتْہُ سَعِیدَ بْنَ جُبَیْرٍ، فَقَالَ: ہَکَذَا قَالَ ابْنُ عَبَّاسٍ","","Musannaf Ibn Abi Shaybah 13957","","","كتاب الحج"
"13958","(۱۳۹۵۸) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، قَالَ : صِیَامٌ ثَلاَثَۃُ أَیَّامٍ ، وَنُسُکٌ شَاۃٌ ، وَصَدَقَۃٌ سِتَّۃُ مَسَاکِینَ۔","","Musannaf Ibn Abi Shaybah 13958","","","كتاب الحج"
"13959","(۱۳۹۵۹) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 13959","","","كتاب الحج"
"13960","(۱۳۹۶۰) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَمِعْتُہُ یَقُولُ فِیمَنْ حَجَّ فَأَصَابَہُ مَرَضٌ ، أَوْ أَذًی مِنْ رَأْسِہِ : فَعَلَیْہِ صِیَامُ عَشَرَۃِ أَیَّامٍ ، أَوْ إطْعَامُ عَشَرَۃِ مَسَاکِینَ ، أَوْ نُسُکُ شَاۃٍ۔","","Musannaf Ibn Abi Shaybah 13960","","","كتاب الحج"
"13961","(۱۳۹۶۱) حدَّثَنَا وَکِیعٌ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْمُلْتَزَمُ مَا بَیْنَ الرُّکْنِ وَالْبَابِ۔","Hasan","Musannaf Ibn Abi Shaybah 13961","","","كتاب الحج"
"13962","(۱۳۹۶۲) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الشَّیْبَانِیِّ، قَالَ: رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ وَہُوَ مُلْتَزِمٌ مَا بَیْنَ الرُّکْنِ وَالْبَابِ۔","","Musannaf Ibn Abi Shaybah 13962","","","كتاب الحج"
"13963","(۱۳۹۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یَلْتَزِمُونَ مَا بَیْنَ الرُّکْنِ وَالْبَابِ ، وَیَدْعُونَ۔","","Musannaf Ibn Abi Shaybah 13963","","","كتاب الحج"
"13964","(۱۳۹۶۴) حدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِیِّ ، قَالَ : رَأَیْتُ عِکْرِمَۃَ بْنَ خَالِدٍ ، وَأَبَا جَعْفَرٍ، وَعِکْرِمَۃَ مَوْلَی ابْنِ عَبَّاسٍ یَلْتَزِمُونَ مَا بَیْنَ الرُّکْنِ وَبَابِ الْکَعْبَۃِ ، وَرَأَیْتُہُمْ یَلْتَزِمُونَ مَا تَحْتَ الْمِیزَابِ فِی الْحِجْرِ۔","","Musannaf Ibn Abi Shaybah 13964","","","كتاب الحج"
"13965","(۱۳۹۶۵) حدَّثَنَا أَبُو یَحْیَی الرَّازِیّ إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَنْظَلَۃَ ، قَالَ : رَأَیْتُ سَالِمًا ، وَعَطَائً ، وَطَاوُسًا یَلْتَزِمُونَ مَا بَیْنَ الرُّکْنِ وَالْبَابِ۔","","Musannaf Ibn Abi Shaybah 13965","","","كتاب الحج"
"13966","(۱۳۹۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ یَلْتَزِمُ دُبُرَ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 13966","","","كتاب الحج"
"13967","(۱۳۹۶۷) حدَّثَنَا وَکِیعٌ، عَنْ نَافِعِ بْنِ عُمَرَ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ؛ أَنَّہُ أَتَی دُبَرَ الْکَعْبَۃِ یَسْتَعِیذُ۔","","Musannaf Ibn Abi Shaybah 13967","","","كتاب الحج"
"13968","(۱۳۹۶۸) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ صَالِحٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَلْتَزِمُ جَانِب الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 13968","","","كتاب الحج"
"13969","(۱۳۹۶۹) حدَّثَنَا أَبُو یَحْیَی الرَّازِیّ ، عَنْ حَنْظَلَۃَ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَتَعَوَّذُ فِی دُبُرِ الْکَعْبَۃِ ،وَیَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ بَأْسِکَ ، وَنِقْمَتِکَ ، وَسُلْطَانِک۔","","Musannaf Ibn Abi Shaybah 13969","","","كتاب الحج"
"13970","(۱۳۹۷۰) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ ثَابِتِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ یَلْتَزِمُ مَا بَیْنَ الْبَابِ وَالْحَجَرِ ، وَخَلْفَ الْکَعْبَۃِ ، کُلاَّ قَدْ رَأَیْتُہُ یَفْعَل۔","","Musannaf Ibn Abi Shaybah 13970","","","كتاب الحج"
"13971","(۱۳۹۷۱) حدَّثَنَا مَعن بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ یَلْتَزِمُ خَلْفَ الْکَعْبَۃِ مِمَّا یَلِی الْمَغْرِبَ ، یُلْصِقُ بِہَا صَدْرَہُ۔","","Musannaf Ibn Abi Shaybah 13971","","","كتاب الحج"
"13972","(۱۳۹۷۲) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ قَدِ الْتَزَمَ الْکَعْبَۃَ ، وَأَلْصَقَ بَطْنَہُ مِنْ مُؤَخِّرِہَا ، مِنَ الْجَانِبِ الَّذِی یَلِی الرُّکْنَ الْیَمَانِیَّ۔","","Musannaf Ibn Abi Shaybah 13972","","","كتاب الحج"
"13973","(۱۳۹۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّ أَبَاہُ کَانَ یَلْتَزِمُ دُبُرَ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 13973","","","كتاب الحج"
"13974","(۱۳۹۷۴) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ یَلْتَزِمُ مُؤَخِّرَ الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 13974","","","كتاب الحج"
"13975","(۱۳۹۷۵) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَصُومُ فِی الْمُتْعَۃَ ، ثُمَّ یَجِدُ الْہَدْیَ قَبْلَ أَنْ یُتِمَّ صَوْمَہُ ، قَالَ : یَتْرُکُ الصَّوْمَ۔","","Musannaf Ibn Abi Shaybah 13975","","","كتاب الحج"
"13976","(۱۳۹۷۶) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ صَامَ الثَّلاَثَۃَ الأَیَّام فِی الْحَجِّ ، ثُمَّ أَیْسَرَ وَہُوَ بِمَکَّۃَ ، أَنَّ عَلَیْہِ الْہَدْیَ۔","","Musannaf Ibn Abi Shaybah 13976","","","كتاب الحج"
"13977","(۱۳۹۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَعِکْرِمَۃَ ؛ قَالاَ : إذَا أَیْسَرَ قَبْلَ أَنْ یَحْلِقَ فَلْیَذْبَحْ۔","","Musannaf Ibn Abi Shaybah 13977","","","كتاب الحج"
"13978","(۱۳۹۷۸) حدَّثَنَا ابْنُ أَبِی رَوَّادٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَقُولُ فِی فِدْیَۃِ الصِّیَامِ : {أَوْ صَدَقَۃٍ ، أَوْ نُسُکٍ} ، فِی یُسْرِہِ ذَلِکَ ، فِی حَجِّہ وَعُمْرَتِہِ۔","","Musannaf Ibn Abi Shaybah 13978","","","كتاب الحج"
"13979","(۱۳۹۷۹) حدَّثَنَا ابْنُ أَبِی رَوَّادٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : إِنْ کَانَ فِی الْحَجِّ فَحَتَّی یُحِلَّ ، وَإِنْ کَانَ فِی الْعُمْرَۃِ فَحَتَّی یَطُوفَ بِالْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 13979","","","كتاب الحج"
"13980","(۱۳۹۸۰) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنْ عَطَائٍ ، وَابْنِ سِیرِینَ ، وَالْحَسَنِ قَالُوا: إذَا صُمْتَ فِی مُتْعَۃِ الْحَجِّ ، ثُمَّ وَجَدْتَ قَبْلَ أَنْ تَفْرُغَ مِنْ صِیَامِکَ فَکَفِّرْ ، وَإِنْ وَجَدْتَ وَقَدْ فَرَغْتَ مِنْ صِیَامِکَ ، فَلَیْسَ عَلَیْک کَفَّارَۃٌ۔","","Musannaf Ibn Abi Shaybah 13980","","","كتاب الحج"
"13981","(۱۳۹۸۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَقُولُ : لَقَدْ کَانَ ہَذَا الْبَیْتُ یَحُجُّہُ سَبْعُ مِئَۃٍ مِنْ بَنِی إسْرَائِیلَ ، یَضَعُونَ نِعَالَہُمْ بِالتَّنْعِیمِ ، وَیَدْخُلُونَ حُفَاۃً ، تَعْظِیمًا لِلْبَیْتِ۔ (فاکھیی ۲۶۷)","Hasan","Musannaf Ibn Abi Shaybah 13981","","","كتاب الحج"
"13982","(۱۳۹۸۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَدْخُلُوا الْبَیْتَ بِالْخُفِّ ، وَالنَّعْلِ ، وَالْقَصَبِ ، تَعْظِیمًا لِلْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 13982","","","كتاب الحج"
"13983","(۱۳۹۸۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَطُوفُ وَعَلَیْہِ نَعْلاَہُ ، وَرَأَیْتُ ابْنَ الزُّبَیْرِ لاَ یَفْعَلُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 13983","","","كتاب الحج"
"13984","(۱۳۹۸۴) حدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، قَالَ: رَأَیْتُ طَاوُوسًا ، وَمُجَاہِدًا ، وَعَطَائً ؛یَطُوفُونَ فِی نِعَالِہِمْ۔","","Musannaf Ibn Abi Shaybah 13984","","","كتاب الحج"
"13985","(۱۳۹۸۵) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرِ ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : کَانَتِ الأُمَّۃُ مِنْ بَنِی إسْرَائِیلَ إذَا أَتَوْا ذَا طُوًی خَلَعُوا نِعَالَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 13985","","","كتاب الحج"
"13986","(۱۳۹۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَتِ الأَنْبِیَائُ إذَا أَتَتْ عَلَم الْحَرَمِ نَزَعُوا نِعَالَہُمْ۔","","Musannaf Ibn Abi Shaybah 13986","","","كتاب الحج"
"13987","(۱۳۹۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا رَمَیْتُمَ الْجَمْرَۃَ فَقَدْ حَلَّ لَکُمْ کُلُّ شَیْئٍ إِلاَّ النِّسَائُ ، وَقَالَ : أَمَّا أَنَا فَقَدْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُضَمِّخاً رَأْسَہُ بِالْمِسْکِ ، أَفَطِیبٌ ذَلِکَ ، أَمْ لاَ ؟۔ (احمد ۱/۳۶۹۔ ابویعلی ۲۶۸۸)","Hasan","Musannaf Ibn Abi Shaybah 13987","","","كتاب الحج"
"13988","(۱۳۹۸۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا رَمَی الْجَمْرَۃَ وَذَبَحَ وَحَلَقَ ، حَلَّ لَہُ کُلُّ شَیْئٍ إِلاَّ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 13988","","","كتاب الحج"
"13989","(۱۳۹۸۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ بْنِ أَبِی الْجَہْمِ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔ (ابوداؤد ۱۹۷۲۔ احمد ۶/۱۴۳)","","Musannaf Ibn Abi Shaybah 13989","","","كتاب الحج"
"13990","(۱۳۹۹۰) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ الْمُنْکَدِرِ ، سَمِعَ ابْنَ الزُّبَیْرِ یَقُولُ : إذَا رَمَیْتَ الْجَمْرَۃَ مِنْ یَوْمِ النَّحْرِ ، فَقَدْ حَلَّ لَکَ مَا وَرَائَ النِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 13990","","","كتاب الحج"
"13991","(۱۳۹۹۱) حدَّثَنَا وَکِیعٌ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، عَنْ عَائِشَۃَ، قَالَتْ: إذَا رَمَی حَلَّ لَہُ کُلُّ شَیْئٍ إِلاَّ النِّسَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 13991","","","كتاب الحج"
"13992","(۱۳۹۹۲) حدَّثَنَا جَرِیرٌ ، قَالَ : حدَّثَنَا مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا حَلَقَ المُحْرِمُ حَلَّ لَہُ کُلُّ شَیْئٍ إِلاَّ النِّسَائَ ، حَتَّی یَطُوفَ بِالْبَیْتِ ، فَإِذَا طَافَ بِالْبَیْتِ حَلَّ لَہُ النِّسَائُ۔","","Musannaf Ibn Abi Shaybah 13992","","","كتاب الحج"
"13993","(۱۳۹۹۳) حدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : إذَا رَمَی الْجَمْرَۃَ حلَّ لَہُ کُلُّ شَیْئٍ ، إِلاَّ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 13993","","","كتاب الحج"
"13994","(۱۳۹۹۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، وَعُمَر ؛ أَنَّہُما قَالاَ : إذَا نَحَرَ الرَّجُلُ وَحَلَقَ ، حَلَّ لَہُ کُلُّ شَیْئٍ إِلاَّ النِّسَائَ وَالطِّیبَ۔","Da'if","Musannaf Ibn Abi Shaybah 13994","","","كتاب الحج"
"13995","(۱۳۹۹۵) حدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنْ عَطَائٍ ، قَالَ : إذَا رَمَی الْجَمْرَۃَ حَلَّ لَہُ کُلُّ شَیْئٍ ، إِلاَّ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 13995","","","كتاب الحج"
"13996","(۱۳۹۹۶) حدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَمَی جَمْرَۃَ الْعَقَبَۃِ حَلَّ لَہُ کُلُّ شَیْئٍ ، إِلاَّ الطِّیبَ ، وَالنِّسَائَ ، وَالصَّیْدَ۔","","Musannaf Ibn Abi Shaybah 13996","","","كتاب الحج"
"13997","(۱۳۹۹۷) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : إذَا قَضَیْتُمَ الْمَنَاسِکَ کُلَّہَا فَقَدْ حَلَّ لَکُمْ کُلُّ شَیْئٍ ، إِلاَّ النِّسَائَ ، وَالصَّیْدَ۔","","Musannaf Ibn Abi Shaybah 13997","","","كتاب الحج"
"13998","(۱۳۹۹۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ ، قَالَ : قبَّلْتُ امْرَأَتِی بَعْدَ مَا رَمَیْتُ الْجَمْرَۃَ فَسَأَلْتُ عَطَائً ؟ فَأَمَرَنِی أَنْ أَذْبَحَ شَاۃً۔","","Musannaf Ibn Abi Shaybah 13998","","","كتاب الحج"
"13999","(۱۳۹۹۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : إذَا رَمَی الْجَمْرَۃَ حَلَّ لَہُ کُلُّ شَیْئٍ ، إِلاَّ النِّسَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 13999","","","كتاب الحج"
"14000","(۱۴۰۰۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَہْدَی فِی بُدْنِہِ جَمَلاً لأَبِی جَہْلٍ بُرَّتُہُ مِنْ فِضَّۃٍ۔ (ابن ماجہ ۳۱۰۰۔ احمد ۱/۲۳۴)","Da'if","Musannaf Ibn Abi Shaybah 14000","","","كتاب الحج"
"14001","(۱۴۰۰۱) حدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی بُدْنِہِ جَمَل۔ (ابن ماجہ ۳۱۰۱)","Da'if","Musannaf Ibn Abi Shaybah 14001","","","كتاب الحج"
"14002","(۱۴۰۰۲) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ زَیْدِ بْنِ جُبَیر ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ : مَا تَرَی فِی بَدَنَۃٍ ، أَنْحَرُ مَکَانَہَا جَمَلاً ؟ قَالَ : مَا رَأَیْتُ أَحَدًا فَعَلَ ذَلِکَ ، وَلأَنْ أَنْحَرَ أُنْثَی أَحَبُّ إلَیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 14002","","","كتاب الحج"
"14003","(۱۴۰۰۳) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ یَحْیَی الْغَسَّانِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ، قَالَ : لاَ بَأْسَ بِالْہَدْیِ الذَّکَرِ مِنَ الإِبِلِ۔","Sahih","Musannaf Ibn Abi Shaybah 14003","","","كتاب الحج"
"14004","(۱۴۰۰۴) حدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : مَا رَأَیْتُ أَحَدًا أَہْدَی جَمَلاً إِلاَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، فَإِنَّہُ أَہْدَی بُخْتِیًّا۔","","Musannaf Ibn Abi Shaybah 14004","","","كتاب الحج"
"14005","(۱۴۰۰۵) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : تُہْدَی الإِنَاثُ وَالذُّکُورُ ، وَالإِنَاثُ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 14005","","","كتاب الحج"
"14006","(۱۴۰۰۶) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، قَالَ : حدَّثَنِی أَبُو جَعْفَرٍ مَوْلَی ابْنِ عَیَّاشٍ ، قَالَ : رَأَیْتُ ابْنَ عَیَّاشٍ أَہْدَی مَرَّۃَ بَدَنَتَیْنِ ، إِحْدَاہُمَا بُخْتِیَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14006","","","كتاب الحج"
"14007","(۱۴۰۰۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ مَوْلًی لِابْنِ عُمَرَ ؛ أَنَّ ابْنَ عُمَرَ أَہْدَی بُخْتِیَّۃً۔","Da'if","Musannaf Ibn Abi Shaybah 14007","","","كتاب الحج"
"14008","(۱۴۰۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَامٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ أَہْدَی عَنْ مُتْعَتِہِ جَمَلاً۔","","Musannaf Ibn Abi Shaybah 14008","","","كتاب الحج"
"14009","(۱۴۰۰۹) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، قَالَ : قیلَ لِعَطَائٍ : إنَّ عِکْرِمَۃَ بْنَ خَالِدٍ أَہْدَی جَمَلاً ، قَالَ عَطَائٌ : وَمَا بَأْسُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14009","","","كتاب الحج"
"14010","(۱۴۰۱۰) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ فِیمَا أَہْدَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمَلٌ لأَبِی جَہْلٍ فِی أَنْفِہِ بُرَّۃٌ مِنْ فِضَّۃٍ۔ (ترمذی ۸۱۵۔ ابوداؤد ۱۷۴۶)","Da'if","Musannaf Ibn Abi Shaybah 14010","","","كتاب الحج"
"14011","(۱۴۰۱۱) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أَہْدَی جَمَلاً۔","Da'if","Musannaf Ibn Abi Shaybah 14011","","","كتاب الحج"
"14012","(۱۴۰۱۲) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : عُمْرَتُہُ فِی الشَّہْرِ الَّذِی یُحِلُّ فِیہِ۔","","Musannaf Ibn Abi Shaybah 14012","","","كتاب الحج"
"14013","(۱۴۰۱۳) حدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ مُثَنَّی ، عَنْ طاوُوسٍ قَالَ : عُمْرَتُہُ فِی الشَّہْرِ الَّذِی دَخَلَ فِیِہِ الْحَرَمَ۔","","Musannaf Ibn Abi Shaybah 14013","","","كتاب الحج"
"14014","(۱۴۰۱۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَطَرٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، وَالْحَکَمِ ؛ قَالُوا : مَنِ اعْتَمَرَ فِی شَہْرٍ ، ثُمَّ طَافَ فِی شَہْرٍ آخَرَ ، فَعُمْرَتُہُ فِی الشَّہْرِ الَّذِی طَافَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 14014","","","كتاب الحج"
"14015","(۱۴۰۱۵) حدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ قَالَ : عُمْرَتُہُ فِی الشَّہْرِ الَّذِی أَحْرَمَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 14015","","","كتاب الحج"
"14016","(۱۴۰۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : عُمْرَتُہُ فِی الشَّہْرِ الَّذِی یُہلُّ فِیہِ۔","","Musannaf Ibn Abi Shaybah 14016","","","كتاب الحج"
"14017","(۱۴۰۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : عُمْرَتُہُ فِی الشَّہْرِ الَّذِی أَحْرَمَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 14017","","","كتاب الحج"
"14018","(۱۴۰۱۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، قَالَ : حَدَّثَتْنَا حَفْصَۃُ بِنْتُ سِیرِینَ قَالَتْ : خَرَجْتُ أَنَا وَإِخْوَتِی ، فَأَہْلَلْنَا فِی رَمَضَانَ بِالْعُمْرَۃِ ، فَعَرَضَ لَنَا حَبْس حَتَّی دَخَلَ شَوَّالُ ، فَسَأَلْنَا أَہْلَ مَکَّۃَ ؟ فَکُلُّہُمْ قَالَ لِی: ہِیَ مُتْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 14018","","","كتاب الحج"
"14019","(۱۴۰۱۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ قَالَ : عُمْرَتُہُ فِی الشَّہْرِ الَّذِی أَحْرَمَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 14019","","","كتاب الحج"
"14020","(۱۴۰۲۰) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُشْہَدُ بِالْمَرِیضِ الْمَنَاسِکُ کُلُّہَا ، وَیُطَافُ بِہِ عَلَی مَحْمَلٍ ، فَإِذَا رَمَی الْجِمَارَ وُضِعَ فِی کَفِّہِ ، ثُمَّ رُمِیَ بِہِ مِنْ کَفِّہِ۔","","Musannaf Ibn Abi Shaybah 14020","","","كتاب الحج"
"14021","(۱۴۰۲۱) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : یُرْمَی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 14021","","","كتاب الحج"
"14022","(۱۴۰۲۲) حدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : الْمَرِیضُ یُرْمَی عَنْہُ ، وَیُطَافُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 14022","","","كتاب الحج"
"14023","(۱۴۰۲۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عن ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ قَالاَ : یُرْمَی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 14023","","","كتاب الحج"
"14024","(۱۴۰۲۴) حدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ وَرْدٍ ، قَالَ : أَرْسَلَنِی أَبِی إلَی مُجَاہِدٍ وَہُوَ مَرِیضٌ أَسْأَلُہُ عَنْ رَمْیِ الْجِمَارِ ؟ قَالَ : یَرْمِی عَنہ أَوْلَی أَہْلِہِ بِہِ۔","","Musannaf Ibn Abi Shaybah 14024","","","كتاب الحج"
"14025","(۱۴۰۲۵) حدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ عَطَائٍ ؛ قَالَ : یَسْتَأْجِرُ الْمَرِیضُ مَنْ یَطُوفُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 14025","","","كتاب الحج"
"14026","(۱۴۰۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، قَالَ : سُئِلَ طَاوُوس عَنِ امْرَأَۃٍ مَرِیضَۃٍ ؟ قَالَ : یَرْمِی عَنْہَا بَعْضُ أَہْلِہَا۔","","Musannaf Ibn Abi Shaybah 14026","","","كتاب الحج"
"14027","(۱۴۰۲۷) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : حجَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَنَا النِّسَائُ وَالصِّبْیَانُ ، فَلَبَّیْنَا عَنِ الصِّبْیَانِ وَرَمَیْنَا عَنْہُمْ۔ (احمد ۳/۳۱۴۔ بیہقی ۱۵۶)","Da'if","Musannaf Ibn Abi Shaybah 14027","","","كتاب الحج"
"14028","(۱۴۰۲۸) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ ابْنًا لِعَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، فَقُلْتُ : کَیْفَ تَصْنَعُونَ بِہَذَا ؟ فَقَالُوا : نَضَعُ الْحَصَاۃَ فِی کَفِّہِ ، فَإِنْ عَجَزَ رُمِیَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 14028","","","كتاب الحج"
