"2042","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ اسْمَ الضَّحِيَّةِ قَدْ يَقَعُ عَلَى الْهَدْيِ الْوَاجِبِاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ اسْمَ الضَّحِيَّةِ قَدْ يَقَعُ عَلَى الْهَدْيِ الْوَاجِبِاس","","","","","","","بات کی دلیل کا بیان کہ اضحیہ (قربانی) کا لفظ واجب ھدی (قربانی) پر بولا جاتا ہے،","2905","2905","2905","2905"
"2043","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ لَا حَظْرَ فِي إِخْبَارِ جَابِرٍ: نَحَرْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْبَدَنَةَ عَنْ سَبْعَةٍ أَنْ لَا تُجْزِئُ الْبَدَنَةُ عَنْ أَكْثَرِ مِنْ سَبْعَةٍ.اس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ لَا حَظْرَ فِي إِخْبَارِ جَابِرٍ: نَحَرْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْبَدَنَةَ عَنْ سَبْعَةٍ أَنْ لَا تُجْزِئُ الْبَدَنَةُ عَنْ أَكْثَرِ مِنْ سَبْعَةٍ.اس","","","","","","","بات کی دلیل کا بیان کہ سیدنا جابر رضی اللہ عنہ کی اس روایت ”ہم نے رسول اللہ صلی اللہ علیہ وسلم کے ساتھ سات افراد کی طرف سے ایک اونٹ نحرکیا“ میں ایک اونٹ کی قربانی میں سات سے زیادہ افراد کی شرکت کی ممانعت نہیں ہے۔","2906","2909","2906","2909"
"2044","بَابُ اسْتِحْبَابِ الْمُغَالَاةِ بِثَمَنِ الْهَدْيِ وَكَرَائِمِهِزیادہ","بَابُ اسْتِحْبَابِ الْمُغَالَاةِ بِثَمَنِ الْهَدْيِ وَكَرَائِمِهِزیادہ","","","","","","","قیمتی اور اعلیٰ جانور قربانی کرنا مستحب ہے","2910","2911","2910","2911"
"2045","بَابُ ذِكْرِ الْعُيُوبِ الَّتِي تَكُونُ فِي الْأَنْعَامِ فَلَا تُجْزِئُ هَدْيًا وَلَا ضَحَايَا إِذَا كَانَ بِهَا بَعْضُ تِلْكَ الْعُيُوبِ.جانوروں کے ان عیوب کا بیان جن کی وجہ سے ان کی قربانی کرنا یا مکّہ مکرّمہ","بَابُ ذِكْرِ الْعُيُوبِ الَّتِي تَكُونُ فِي الْأَنْعَامِ فَلَا تُجْزِئُ هَدْيًا وَلَا ضَحَايَا إِذَا كَانَ بِهَا بَعْضُ تِلْكَ الْعُيُوبِ.جانوروں کے ان عیوب کا بیان جن کی وجہ سے ان کی قربانی کرنا یا مکّہ مکرّمہ","","","","","","","میں قربانی کے لئے بھیجنا درست نہیں ہے","2912","2912","2912","2912"
"2046","بَابُ الزَّجْرِ عَنْ ذَبْحِ الْعَضْبَاءِ فِي الْهَدْيِ وَالْأَضَاحِي زَجْرَ اخْتِيَارِ، أَنَّ صَحِيحَ الْقَرْنِ وَالْأُذُنِ أَفْضَلُ مِنَ الْعَضْبَاءِ، لَا أَنَّ الْعَضْبَاءَ غَيْرُ مُجْزِيَةٍ،حج","بَابُ الزَّجْرِ عَنْ ذَبْحِ الْعَضْبَاءِ فِي الْهَدْيِ وَالْأَضَاحِي زَجْرَ اخْتِيَارِ، أَنَّ صَحِيحَ الْقَرْنِ وَالْأُذُنِ أَفْضَلُ مِنَ الْعَضْبَاءِ، لَا أَنَّ الْعَضْبَاءَ غَيْرُ مُجْزِيَةٍ،حج","","","","","","","کی قربانی اور عید کی قربانی پر کٹے کان والا جانور ذبح کرنے کی ممانعت صرف اس لئے ہے کہ صحیح سلامت کان اور سینگ والا جانور ذبح کرنا افضل واعلیٰ ہے یہ مطلب نہیں کہ کٹے کان اور ٹوٹے سینگ والا جانور قربان کرنا جائز نہیں","2913","2913","2913","2913"
"2047","بَابُ النَّهْيِ عَنْ ذَبْحِ ذَاتِ النَّقْصِ فِي الْعُيُونِ وَالْآذَانِ فِي الْهَدْيِ وَالضَّحَايَا نَهْيُ نَدْبٍ وَإِرْشَادٍ؛حج","بَابُ النَّهْيِ عَنْ ذَبْحِ ذَاتِ النَّقْصِ فِي الْعُيُونِ وَالْآذَانِ فِي الْهَدْيِ وَالضَّحَايَا نَهْيُ نَدْبٍ وَإِرْشَادٍ؛حج","","","","","","","اور عید کی قربانی میں آنکھوں اور کانوں میں نقص والے جانور ذبح نہ کرنا، یہی ہے کہ ایسے جانور ذبح نہ کرنا بہتر ہے۔","2914","2915","2914","2915"
"2048","بَابُ الرُّخْصَةِ فِي ذَبْحِ الْجَذَعَةِ مِنَ الضَّأْنِ فِي الْهَدْيِ وَالضَّحَايَا بِلَفْظٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍ.بھیڑ","بَابُ الرُّخْصَةِ فِي ذَبْحِ الْجَذَعَةِ مِنَ الضَّأْنِ فِي الْهَدْيِ وَالضَّحَايَا بِلَفْظٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍ.بھیڑ","","","","","","","کا ایک سالہ بچہ قربان کیا جا سکتا ہے حج اور عید کی قربانی میں۔ اس سلسلے میں ایک مجمل غیر مفسر روایت کا بیان","2916","2916","2916","2916"
"2049","بَابُ الرُّخْصَةِ فِي اقْتِطَاعِ لُحُومِ الْهَدْيِ بِإِذْنِ صَاحِبِهَاحج","بَابُ الرُّخْصَةِ فِي اقْتِطَاعِ لُحُومِ الْهَدْيِ بِإِذْنِ صَاحِبِهَاحج","","","","","","","کی قربانی کا گوشت اس کے مالک کی اجازت سے کاٹ لینا درست ہے","2917","2917","2917","2917"
"2050","بَابُ الدَّلِيلِ عَلَى أَنَّ الْجَذَعَةَ إِنَّمَا تُجْزِئُ عِنْدَ الْإِعْسَارِ مِنَ الْمُسِنِّاس بات کی دلیل کا بیان کہ بھیڑ کا ایک سالہ بچّہ","بَابُ الدَّلِيلِ عَلَى أَنَّ الْجَذَعَةَ إِنَّمَا تُجْزِئُ عِنْدَ الْإِعْسَارِ مِنَ الْمُسِنِّاس بات کی دلیل کا بیان کہ بھیڑ کا ایک سالہ بچّہ","","","","","","","دونتا بکرا وغیرہ نہ ملنے کی صورت میں کفائت کرجائیگا","2918","2918","2918","2918"
"2051","بَابُ الصَّدَقَةِ بِلُحُومِ الْهَدْيِ، وَجُلُودِهَا، وَجِلَالِ الْبُدْنِ، بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍایک","بَابُ الصَّدَقَةِ بِلُحُومِ الْهَدْيِ، وَجُلُودِهَا، وَجِلَالِ الْبُدْنِ، بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍایک","","","","","","","مجمل غیر مفسرروایت کے ساتھ حج کی قربانی کا گوشت، اس کا چمڑا اور جھول سب کچھ صدقہ کرنے کا بیان","2919","2919","2919","2919"
"2052","بَابُ قَسْمِ لُحُومِ الْهَدْيِ وَجُلُودِهِ وَجِلَالِهِ فِي الْمَسَاكِينِحج","بَابُ قَسْمِ لُحُومِ الْهَدْيِ وَجُلُودِهِ وَجِلَالِهِ فِي الْمَسَاكِينِحج","","","","","","","کی قربانی کا گوشت، ان کے چمڑے اور جھولیں مساکین میں صدقہ کرنے کا بیان","2920","2920","2920","2920"
"2053","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ اسْمَ الْكُلِّ قَدْ يَقَعُ عَلَى الْبَعْضِاس بات کی دلیل کا بیان کہ کل کا اطلاق بعض پر بھی ہوتا ہے اور اس بات کی دلیل کا بیان کہ سیدنا علی بن ابی طالب رضی اللہ عنہ کا یہ فرمان کہ رسول اللہ صلی اللہ علیہ وسلم نے مجھے اپنی قربانی کے اونٹوں کا سارا گوشت تقسیم کرنے کا حُکم دیا، اس سے ان کی مراد یہ ہے کہ اس گوشت کے علاوہ تقسیم کردیں جو آپ نے ہر اونٹ سے کچھ گوشت لیکر پکانے کا حُکم","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ اسْمَ الْكُلِّ قَدْ يَقَعُ عَلَى الْبَعْضِاس بات کی دلیل کا بیان کہ کل کا اطلاق بعض پر بھی ہوتا ہے اور اس بات کی دلیل کا بیان کہ سیدنا علی بن ابی طالب رضی اللہ عنہ کا یہ فرمان کہ رسول اللہ صلی اللہ علیہ وسلم نے مجھے اپنی قربانی کے اونٹوں کا سارا گوشت تقسیم کرنے کا حُکم دیا، اس سے ان کی مراد یہ ہے کہ اس گوشت کے علاوہ تقسیم کردیں جو آپ نے ہر اونٹ سے کچھ گوشت لیکر پکانے کا حُکم","","","","","","","دیا تھا۔ پھر آپ صلی اللہ علیہ وسلم نے اور سیدنا علی رضی اللہ عنہ نے اس کا شوربہ پیا تھا اور گوشت نوش فرمایا تھا","2921","2921","2921","2921"
"2054","بَابُ النَّهْيِ عَنْ إِعْطَاءِ الْجَازِرِ أَجْرَهُ مِنَ الْهَدْيِ بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍ.قصاب","بَابُ النَّهْيِ عَنْ إِعْطَاءِ الْجَازِرِ أَجْرَهُ مِنَ الْهَدْيِ بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسَّرٍ.قصاب","","","","","","","کو قربانی کے جانور میں سے اجرت نہ دینے کا بیان، اس سلسلے میں ایک مجمل غیر مفسر روایت کا بیان","2922","2922","2922","2922"
"2055","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَا،گزشتہ","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَا،گزشتہ","","","","","","","مجمل روایت کی مفسر روایت کا بیان۔","2923","2923","2923","2923"
"2056","بَابُ الْأَكْلِ مِنْ لَحْمِ الْهَدْيِ إِذَا كَانَ تَطَوُّعًا.حج","بَابُ الْأَكْلِ مِنْ لَحْمِ الْهَدْيِ إِذَا كَانَ تَطَوُّعًا.حج","","","","","","","کی قربانی میں سے گوشت کھانے کا بیان جبکہ وہ نفلی قربانی ہو","2924","2924","2924","2924"
"2057","بَابُ الْهَدْيِ يَضِلُّ فَيُنْحَرُ مَكَانَهُ آخَرُ، ثُمَّ يُوجَدُ الْأَوَّلُ.حج","بَابُ الْهَدْيِ يَضِلُّ فَيُنْحَرُ مَكَانَهُ آخَرُ، ثُمَّ يُوجَدُ الْأَوَّلُ.حج","","","","","","","کی قربانی کا جانور گم ہو جائے، پھر اس جگہ دوسرا جانور ذبح کرنے کے بعد وہ بھی مل جائے تو اس کا کیا کیا جائے","2925","2925","2925","2925"
"2058","بَابُ صِيَامِ الْمُتَمَتِّعِ إِذَا لَمْ يَجِدِ الْهَدْيَ.حج","بَابُ صِيَامِ الْمُتَمَتِّعِ إِذَا لَمْ يَجِدِ الْهَدْيَ.حج","","","","","","","تمتع کرنے والے کو قربانی کا جانور نہ ملے تو وہ روزے رکھے گا","2926","2927","2926","2927"
"2059","بَابُ حَلْقِ الرَّأْسِ بَعْدَ الْفَرَاغِ مِنَ النَّحْرِ أَوِ الذَّبْحِ، وَاسْتِحْبَابِ التَّيَامُنِ فِي الْحَلْقِ،اونٹ","بَابُ حَلْقِ الرَّأْسِ بَعْدَ الْفَرَاغِ مِنَ النَّحْرِ أَوِ الذَّبْحِ، وَاسْتِحْبَابِ التَّيَامُنِ فِي الْحَلْقِ،اونٹ","","","","","","","نحر کرنے یا کوئی دوسرا جانور ذبح کرنے کے بعد سر منڈوانے کا بیان اور سر منڈواتے وقت دائیں جانب سے شروع کرنا مستحب ہے۔","2928","2928","2928","2928"
"2060","بَابُ فَضْلِ الْحَلْقِ فِي الْحَجِّ وَالْعُمْرَةِ وَاخْتِيَارِ الْحَلْقِ عَلَى التَّقْصِيرِ وَإِنْ كَانَ التَّقْصِيرُ جَائِزًا.حج","بَابُ فَضْلِ الْحَلْقِ فِي الْحَجِّ وَالْعُمْرَةِ وَاخْتِيَارِ الْحَلْقِ عَلَى التَّقْصِيرِ وَإِنْ كَانَ التَّقْصِيرُ جَائِزًا.حج","","","","","","","اور عمرے میں سر منڈوانا افضل ہے اگرچہ بال کتروانا بھی جائز ہے","2929","2929","2929","2929"
"2061","بَابُ تَسْمِيَةِ مَنْ حَلَقَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّتِهِ.حجتہ","بَابُ تَسْمِيَةِ مَنْ حَلَقَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّتِهِ.حجتہ","","","","","","","الوداع میں نبی صلی اللہ علیہ وسلم کے جن صاحب نے بال مونڈھے ان کا نام","2930","2930","2930","2930"
"2062","بَابُ اسْتِحْبَابِ تَقْلِيمِ الْأَظْفَارِ مَعَ حَلْقِ الرَّأْسِ،سر","بَابُ اسْتِحْبَابِ تَقْلِيمِ الْأَظْفَارِ مَعَ حَلْقِ الرَّأْسِ،سر","","","","","","","کے بال منڈوانے کے ساتھ ناخن ترشوانا بھی مستحب ہے","2931","2932","2931","2932"
"2063","بَابُ إِبَاحَةِ التَّطَيُّبِ يَوْمَ النَّحْرِ بَعْدَ الْحَلْقِ وَقَبْلَ زِيَارَةِ الْبَيْتِ،دس","بَابُ إِبَاحَةِ التَّطَيُّبِ يَوْمَ النَّحْرِ بَعْدَ الْحَلْقِ وَقَبْلَ زِيَارَةِ الْبَيْتِ،دس","","","","","","","ذوالحجہ یوم النحر کو سر منڈوانے کے بعد اور طواف افاضہ کرنے سے پہلے خوشبو لگانا جائز ہے۔","2933","2934","2933","2934"
"2064","بَابُ إِبَاحَةِ التَّطَيُّبِ يَوْمَ النَّحْرِ قَبْلَ الزِّيَارَةِ بِالطِّيبِ الَّذِي فِيهِ مِسْكٌ.یوم","بَابُ إِبَاحَةِ التَّطَيُّبِ يَوْمَ النَّحْرِ قَبْلَ الزِّيَارَةِ بِالطِّيبِ الَّذِي فِيهِ مِسْكٌ.یوم","","","","","","","النحر دس ذوالحجہ کو طواف زیارہ سے پہلے کستوری والی خوشبو لگانا جائز ہے","2935","2935","2935","2935"
"2065","بَابُ الرُّخْصَةِ لِلْحَائِضِ أَنْ تَنْسُكَ الْمَنَاسِكَ كُلَّهَا فِي حَيْضِهَا خَلَا الطَّوَافِ بِالْبَيْتِ وَالصَّلَاةِ.حائضہ","بَابُ الرُّخْصَةِ لِلْحَائِضِ أَنْ تَنْسُكَ الْمَنَاسِكَ كُلَّهَا فِي حَيْضِهَا خَلَا الطَّوَافِ بِالْبَيْتِ وَالصَّلَاةِ.حائضہ","","","","","","","عورت کو رخصت ہے کہ وہ بیت اللہ کے طواف اور نماز کے علاوہ تمام مناسک ادا کرسکتی ہے","2936","2936","2936","2936"
"2066","بَابُ الرُّخْصَةِ فِي الِاصْطِيَادِ وَجَمِيعِ مَا حُرِّمَ عَلَى الْمُحْرِمِ بَعْدَ رَمْيِ الْجَمْرَةِ يَوْمَ النَّحْرِ قَبْلَ زِيَارَةِ الْبَيْتِ،یوم","بَابُ الرُّخْصَةِ فِي الِاصْطِيَادِ وَجَمِيعِ مَا حُرِّمَ عَلَى الْمُحْرِمِ بَعْدَ رَمْيِ الْجَمْرَةِ يَوْمَ النَّحْرِ قَبْلَ زِيَارَةِ الْبَيْتِ،یوم","","","","","","","النحر دس ذوالحجہ کو جمرہ عقبہ پر رمی کرنے کے بعد طواف زیادت سے پہلے شکار کرنا اور جو چیزیں محرم کے لئے حرام تھیں وہ سب جائز ہو جاتی ہیں","2937","2939","2937","2939"
"2067","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ التَّطَيُّبَ بَعْدَ رَمْيِ الْجِمَارِ وَالنَّحْرِ وَالذَّبْحِ وَالْحِلَاقِاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ التَّطَيُّبَ بَعْدَ رَمْيِ الْجِمَارِ وَالنَّحْرِ وَالذَّبْحِ وَالْحِلَاقِاس","","","","","","","بات کی دلیل کا بیان کہ رمی کرنے، قربانی کرنے اور سرمنڈوانے کے بعد بعض علماء کے نزدیک طواف زیارہ سے پہلے خوشبو لگانا","2940","2940","2940","2940"
"2068","بَابُ اسْتِحْبَابِ طَوَافِ الزِّيَارَةِ يَوْمَ النَّحْرِ اسْتِنَانًا بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمُبَادَرَةً بِقَضَاءِ الْوَاجِبِ عَنِ الطَّوَافِنبی صلی اللہ علیہ وسلم کی سنّت","بَابُ اسْتِحْبَابِ طَوَافِ الزِّيَارَةِ يَوْمَ النَّحْرِ اسْتِنَانًا بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمُبَادَرَةً بِقَضَاءِ الْوَاجِبِ عَنِ الطَّوَافِنبی صلی اللہ علیہ وسلم کی سنّت","","","","","","","کی تعمیل میں طواف زیارہ یوم النحر دس ذوالحجہ ہی کو کرنا مستحب ہے۔","2941","2941","2941","2941"
"2069","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْوَطْءَ يَحِلُّ بَعْدَ رَكْعَتَيْ طَوَافِ الزِّيَارَةِ، وَإِنْ كَانَ الطَّائِفُ بِمَكَّةَ قَبْلَ أَنْ يَرْجِعَ إِلَى مِنًى.اس بات کی دلیل کا بیان کہ طواف زیارہ کی دو رکعات ادا کرنے کے بعد حاجی کے لئے اپنی بیوی سے ہمبستری کرنا حلال ہوجاتا ہے اگرچہ حاجی طواف کرنے کے بعد مکّہ مکرّمہ","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْوَطْءَ يَحِلُّ بَعْدَ رَكْعَتَيْ طَوَافِ الزِّيَارَةِ، وَإِنْ كَانَ الطَّائِفُ بِمَكَّةَ قَبْلَ أَنْ يَرْجِعَ إِلَى مِنًى.اس بات کی دلیل کا بیان کہ طواف زیارہ کی دو رکعات ادا کرنے کے بعد حاجی کے لئے اپنی بیوی سے ہمبستری کرنا حلال ہوجاتا ہے اگرچہ حاجی طواف کرنے کے بعد مکّہ مکرّمہ","","","","","","","میں ہی ہو اور ابھی منیٰ واپس نہ لوٹا ہو","2942","2942","2942","2942"
"2070","بَابُ تَرْكِ الرَّمَلِ فِي طَوَافِ الزِّيَارَةِ لِلْقَارِنِ، وَحُكْمُ الْمُفْرِدِ فِي هَذَا كَحُكْمِ الْقَارِنِ.حج قران کرنے والا طواف زیارہ میں رمل نہیں کریگا۔ حج افراد کرنے والے کا حُکم","بَابُ تَرْكِ الرَّمَلِ فِي طَوَافِ الزِّيَارَةِ لِلْقَارِنِ، وَحُكْمُ الْمُفْرِدِ فِي هَذَا كَحُكْمِ الْقَارِنِ.حج قران کرنے والا طواف زیارہ میں رمل نہیں کریگا۔ حج افراد کرنے والے کا حُکم","","","","","","","بھی یہی ہے","2943","2943","2943","2943"
