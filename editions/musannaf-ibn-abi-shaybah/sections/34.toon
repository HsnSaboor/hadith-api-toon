hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"33067","(۳۳۰۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، قَالَ : حَدَّثَنَا سَعْدُ بْنُ إبْرَاہِیمَ أَنَّہُ بَلَغَہُ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : النَّاسُ تَبَعٌ لِقُرَیْشٍ ، بَرُّہُمْ لِبَرِّہِمْ وَفَاجِرُہُمْ لِفَاجِرِہِمْ۔","","Musannaf Ibn Abi Shaybah 33067","","","كتاب الفضائل"
"33068","(۳۳۰۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ نِسَائٍ رَکِبْنَ الإِبِلَ نِسَائُ قُرَیْشٍ ، أَحْنَاہُ عَلَی وَلَدٍ فِی صِغَرِہِ وَأَرْعَاہُ عَلَی بَعْلٍ فِی ذَاتِ یَدِہِ۔ (احمد ۵۰۲)","Hasan","Musannaf Ibn Abi Shaybah 33068","","","كتاب الفضائل"
"33069","(۳۳۰۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ نِسَائٍ رَکِبْنَ الإِبِلَ نِسَائُ قُرَیْشٍ ، أَحْنَاہُ عَلَی وَلَدٍ فِی صِغَرِہِ ، وَأَرْعَاہُ عَلَی بَعْلٍ فِی ذَاتِ یَدِہِ ، وَلَوْ عَلِمْت أَنَّ مَرْیَمَ ابْنَۃَ عِمْرَانَ رَکِبَتْ بَعِیرًا مَا فَضَّلْت عَلَیْہَا أَحَدًا۔ (ابن سعد ۱۵۲)","","Musannaf Ibn Abi Shaybah 33069","","","كتاب الفضائل"
"33070","(۳۳۰۷۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ نِسَائٍ رَکِبْنَ الإِبِلَ صَالِحُ نِسَائِ قُرَیْشٍ أَرْعَاہُ عَلَی زَوْجٍ فِی ذَاتِ یَدِہِ ، وَأَحْنَاہُ عَلَی وَلَدٍ فِی صِغَرِہِ۔","","Musannaf Ibn Abi Shaybah 33070","","","كتاب الفضائل"
"33071","(۳۳۰۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسُبُّوا أَصْحَابِی فَوَالَّذِی نَفْسِی بِیَدِہِ لَوْ أَنَّ أَحَدَکُمْ أَنْفَقَ مِثْلَ أُحُدٍ ذَہَبًا مَا أَدْرَکَ مُدَّ أَحَدِہِمْ ، وَلاَ نَصِیفَہُ۔ (مسلم ۱۹۶۷۔ ابن حبان ۶۹۹۴)","Sahih","Musannaf Ibn Abi Shaybah 33071","","","كتاب الفضائل"
"33072","(۳۳۰۷۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَصْحَابِہِ : أَنْتُمْ فِی النَّاسِ کَالْمِلْحِ فِی الطَّعَامِ ، قَالَ : ثُمَّ قَالَ الْحَسَنُ : وَلاَ یَطِیبُ الطَّعَامُ إلاَّ بِالْمِلْحِ ، ثُمَّ یَقُولُ الْحَسَنُ : کَیْفَ بِقَوْمٍ ذَہَبَ مِلْحُہُمْ۔ (ابویعلی ۲۷۵۴۔ عبدالرزاق ۲۰۳۷۷)","Hasan","Musannaf Ibn Abi Shaybah 33072","","","كتاب الفضائل"
"33073","(۳۳۰۷۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُجَمِّعِ بْنِ یَحْیَی ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَصْحَابِی أَمَنَۃٌ لأُمَّتِی ، فَإِذَا ذَہَبَ أَصْحَابِی أَتَی أُمَّتِی مَا یُوعَدُونَ۔n(مسلم ۱۹۶۱۔ احمد ۳۹۹)","Sahih","Musannaf Ibn Abi Shaybah 33073","","","كتاب الفضائل"
"33074","(۳۳۰۷۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ أُمَّتِی الْقَرْنُ الَّذِینَ یَلُونِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ یَجِیئُ قَوْمٌ تَسْبِقُ شَہَادَۃُ أَحَدِہِمْ یَمِینَہُ وَیَمِینُہُ شَہَادَتَہُ۔ (بخاری ۲۶۵۲۔ مسلم ۱۹۶۲)","Sahih","Musannaf Ibn Abi Shaybah 33074","","","كتاب الفضائل"
"33075","(۳۳۰۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ جَعْدَۃَ بْنِ ہُبَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ النَّاسِ قَرْنِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الآخَرُ أَرْدَی۔ n(طبرانی ۲۱۸۸۔ حاکم ۱۹۱)","Hasan","Musannaf Ibn Abi Shaybah 33075","","","كتاب الفضائل"
"33076","(۳۳۰۷۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ اللہِ الْبَہِیِّ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَأَلَ رَجُلٌ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَیُّ النَّاسِ خَیْرٌ، قَالَ: الْقَرْنُ الَّذِی أَنَا فِیہِ، ثُمَّ الثَّانِی، ثُمَّ الثَّالِثُ۔(مسلم ۱۹۶۵)","Hasan","Musannaf Ibn Abi Shaybah 33076","","","كتاب الفضائل"
"33077","(۳۳۰۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : حَدَّثَنَا ہِلاَلُ بْنُ یَسَافَ ، قَالَ : سَمِعْتُ عِمْرَانَ بْنَ حُصَیْنٍ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ النَّاسِ قَرْنِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ۔ (ترمذی ۲۲۲۱۔ ابن حبان ۷۲۲۹)","Sahih","Musannaf Ibn Abi Shaybah 33077","","","كتاب الفضائل"
"33078","(۳۳۰۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، قَالَ : حدَّثَنِی زَہْدَمُ بْنُ مُضَرِّبٍ ، قَالَ : سَمِعْتُ عِمْرَانَ بْنَ حُصَیْنٍ یُحَدِّثُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : إنَّ خَیْرَکُمْ قَرْنِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، قَالَ : فَلاَ أَدْرِی ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ قَرْنِہِ مَرَّتَیْنِ ، أَوْ ثَلاَثًا۔n(مسلم ۱۹۶۴۔ طبرانی ۵۸۲)","Sahih","Musannaf Ibn Abi Shaybah 33078","","","كتاب الفضائل"
"33079","(۳۳۰۷۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ قَبِیصَۃَ بْنِ جَابِرٍ ، قَالَ : خَطَبَنَا عُمَرُ بِبَابِ الْجَابِیَۃِ ، فَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَامَ فِینَا کَمَقَامِی فِیکُمْ ، ثُمَّ قَالَ : أَیُّہَا النَّاسُ : اتَّقُوا اللَّہَ فِی أَصْحَابِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ یَفْشُو الْکَذِبُ وَشَہَادَۃُ الزُّورِ۔n(ابن ماجہ ۲۳۶۲۔ طبرانی ۲۴۵)","","Musannaf Ibn Abi Shaybah 33079","","","كتاب الفضائل"
"33080","(۳۳۰۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ خَیْثَمَۃ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : خَیْرُ النَّاسِ قَرْنِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ یَأْتِی قَوْمٌ تَسْبِقُ شَہَادَتُہُمْ أَیْمَانَہُمْ وَأَیْمَانُہُمْ شَہَادَتَہُمْ۔ (احمد ۲۷۶۔ بزار ۲۷۶۷)","Sahih","Musannaf Ibn Abi Shaybah 33080","","","كتاب الفضائل"
"33081","(۳۳۰۸۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنِ الْجَرِیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مَوَلَۃَ ، قَالَ : کُنْتُ أَسِیرُ مَعَ بُرَیْدَۃَ الأَسْلَمِیِّ ، فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : خَیْرُ ہَذِہِ الأُمَّۃِ الْقَرْنُ الَّذِی بُعِثْت فِیہِمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ یَکُونُ فِیہِمْ قَوْمٌ تَسْبِقُ شَہَادَتُہُمْ أَیْمَانَہُمْ وَأَیْمَانُہُمْ شَہَادَتَہُمْ۔ (احمد ۳۵۰)","Da'if","Musannaf Ibn Abi Shaybah 33081","","","كتاب الفضائل"
"33082","(۳۳۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ نُسَیْرِ بْنِ ذُعْلُوقٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : لاَ تَسُبُّوا أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمَقَامُ أَحَدِہِمْ سَاعَۃً خَیْرٌ مِنْ عَمَلِ أَحَدِکُمْ عُمْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33082","","","كتاب الفضائل"
"33083","(۳۳۰۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ النَّاسِ قَرْنِی ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ الَّذِینَ یَلُونَہُمْ ، ثُمَّ یَجِیئُ أَقْوَامٌ یُعْطُونَ الشَّہَادَۃَ قَبْلَ أَنْ یُسْأَلُوہَا۔","","Musannaf Ibn Abi Shaybah 33083","","","كتاب الفضائل"
"33084","(۳۳۰۸۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْعَلاَئِ أَبُو الزَّبْرِ الدِّمَشْقِیُّ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ عَامِرٍ ، عَنْ وَاثِلَۃَ بْنِ الأَسْقَعِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَزَالُونَ بِخَیْرٍ مَا دَامَ فِیکُمْ مَنْ رَآنِی [corrupt]َصَاحَبَنِی ، وَاللہِ لاَ تَزَالُونَ بِخَیْرٍ ، مَا دَامَ فِیکُمْ مَنْ رَأَی مَنْ رَآنِی ، وَصَاحَبَ مَنْ صَاحَبَنِی ، وَاللہِ لاَ تَزَالُونَ بِخَیْرٍ ، مَا دَامَ فِیکُمْ مَنْ رَأَی مَنْ رَأَی مَنْ رَآنِی ، وَصَاحَبَ مَنْ صَاحَبَ مَنْ صَاحَبَنِی ۔n(طبرانی ۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 33084","","","كتاب الفضائل"
"33085","(۳۳۰۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ ، أُمِرُوا بِالاِسْتِغْفَارِ لأَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَبُّوہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33085","","","كتاب الفضائل"
"33086","(۳۳۰۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ خَالِدٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَبَّ أَصْحَابِی فَعَلَیْہِ لَعَنْۃُ اللہِ۔ (احمد ۱۷۳۳)","","Musannaf Ibn Abi Shaybah 33086","","","كتاب الفضائل"
"33087","(۳۳۰۸۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : إنِّی لَقَائِمٌ مَعَ الشَّعْبِیِّ ذَاتَ یَوْمٍ فَأَتَاہُ رَجُلٌ ، فَقَالَ : مَا تَقُولُ فِی عَلِیٍّ وَعُثْمَانَ ، فَقَالَ : إنِّی لَغَنِیٌّ أَنْ یَطْلُبَنِی عَلِیٌّ وَعُثْمَان یَوْمَ الْقِیَامَۃِ بِمَظْلِمَۃٍ۔","","Musannaf Ibn Abi Shaybah 33087","","","كتاب الفضائل"
"33088","(۳۳۰۸۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ عن أیوب ، قَالَ نُبِّئْت عَنْ نَافِعٍ أَنَّہُ حَدَّثَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ : مَنِ اسْتَطَاعَ أَنْ یَمُوتَ بِالْمَدِینَۃِ فَلْیَمُتْ بِہَا ، فَإِنِّی أَشْفَعُ لِمَنْ مَاتَ بِہَا۔n(ترمذی ۳۹۱۷۔ ابن حبان ۳۷۴۱)","","Musannaf Ibn Abi Shaybah 33088","","","كتاب الفضائل"
"33089","(۳۳۰۸۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ سَمَّی الْمَدِینَۃَ طَابَۃَ۔ (مسلم ۱۰۰۷۔ احمد ۱۰۱)","Hasan","Musannaf Ibn Abi Shaybah 33089","","","كتاب الفضائل"
"33090","(۳۳۰۹۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أبی یَحْیَی ، عَنِ الْحَارِثِ بْنِ أَبِی یَزِیدَ سَمِعَ جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمَدِینَۃُ کَالْکِیرِ تَنْفِی الْخَبَثَ کَمَا یَنْفِی الْکِیرُ خَبَثَ الْحَدِیدِ۔ (احمد ۳۸۵)","Da'if","Musannaf Ibn Abi Shaybah 33090","","","كتاب الفضائل"
"33091","(۳۳۰۹۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ فَاطِمَۃَ بِنْتِ قَیْسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : ہَذِہِ طِیبَۃُ ، یَعْنِی الْمَدِینَۃَ ، وَالَّذِی نَفْسُ مُحَمَّدٍ بِیَدِہِ ، مَا فِیہَا طَرِیقٌ وَاسِعٌ ، وَلاَ ضَیِّقٌ إلاَّ عَلَیْہِ مَلَکٌ شَاہِرٌ بِالسَّیْفِ إلَی یَوْمِ الْقِیَامَۃِ۔ (ابوداؤد ۴۳۲۷۔ احمد ۳۷۳)","Da'if","Musannaf Ibn Abi Shaybah 33091","","","كتاب الفضائل"
"33092","(۳۳۰۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، عَنْ أَبِی بَکْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَنْ یَدْخُلَ الْمَدِینَۃَ رُعْبُ الْمَسِیحِ الدَّجَّالِ ، لَہَا یَوْمَئِذٍ سَبْعَۃُ أَبْوَابٍ، لِکُلِّ بَابٍ مَلَکَانِ۔ (بخاری ۱۸۷۹۔ احمد ۴۷)","Sahih","Musannaf Ibn Abi Shaybah 33092","","","كتاب الفضائل"
"33093","(۳۳۰۹۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : سَمِعْتُ جَابِر بن عبد اللہ یحدث عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْمَدِینَۃُ کَالْکِیرِ تَنْفِی خَبَثَہَا وَتُنْصِعُ طَیِّبَہَا۔n(احمد ۳۹۲۔ بخاری ۱۸۸۳)","Sahih","Musannaf Ibn Abi Shaybah 33093","","","كتاب الفضائل"
"33094","(۳۳۰۹۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہَاشِمُ بْنِ ہَاشِمٍ ، عَنْ عَبْدِ اللہِ بْنِ نسطاس عْن جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَخَافَ أَہْلَ الْمَدِینَۃِ فَعَلَیْہِ لَعَنْۃُ اللہِ وَالْمَلاَئِکَۃِ وَالنَّاسِ أَجْمَعِینَ ، لاَ یَقْبَلُ اللَّہُ مِنْہُ صَرْفًا ، وَلاَ عَدْلا ، مَنْ أَخَافَہَا فَقَدْ أَخَافَ مَا بَیْنَ ہَذَیْنِ : مَا بَیْنَ جَنْبَیْہِ۔n(ابوداؤد ۱۷۶۰۔ احمد ۳۵۷)","Sahih","Musannaf Ibn Abi Shaybah 33094","","","كتاب الفضائل"
"33095","(۳۳۰۹۵) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بن أبی طلحۃ ، عَنْ أَنَسٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الدَّجَّالُ یَطْوِی الأَرْضَ کُلَّہَا إلاَّ مَکَّۃَ وَالْمَدِینَۃَ ، قَالَ : فَیَأْتِی الْمَدِینَۃَ فَیَجِدُ بِکُلِّ نَقْبٍ مِنْ أَنْقَابِہَا صُفُوفًا مِنَ الْمَلاَئِکَۃِ ، فَیَأْتِی سَبْخَۃَ الْجُرُفِ فَیَضْرِبُ رِوَاقَہُ ، ثُمَّ تَرْجُفُ الْمَدِینَۃُ ثَلاَثَ رَجَفَاتٍ فَیَخْرُجُ إلَیْہِ کُلُّ مُنَافِقٍ وَمُنَافِقَۃٍ۔ (بخاری ۱۸۸۱۔ مسلم ۲۲۶۶)","Sahih","Musannaf Ibn Abi Shaybah 33095","","","كتاب الفضائل"
"33096","(۳۳۰۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ خُبَیْبِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَفْصِ بْنِ عَاصِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الإِیمَانَ لَیَأْرِزُ إلَی الْمَدِینَۃِ کَمَا تَأْرِزُ الْحَیَّۃُ إلَی جُحْرِہَا۔ (بخاری ۱۸۷۶۔ مسلم ۲۳۳)","Sahih","Musannaf Ibn Abi Shaybah 33096","","","كتاب الفضائل"
"33097","(۳۳۰۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہَا طَابَۃُ وَإِنَّہَا تَنْفِی الْخَبَثَ ، یَعْنِی الْمَدِینَۃَ۔n(بخاری ۱۸۸۴۔ مسلم ۱۰۰۶)","Sahih","Musannaf Ibn Abi Shaybah 33097","","","كتاب الفضائل"
"33098","(۳۳۰۹۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یُسَیْرِ بْنِ عَمْرٍو ، عَنْ سَہْلِ بْنِ حُنَیْفٍ ، قَالَ : أَہْوَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہِ إلَی الْمَدِینَۃِ ، فَقَالَ : إِنَّہَا حَرَمٌ آمِنٌ۔ (مسلم ۱۰۰۳۔ احمد ۴۸۶)","Sahih","Musannaf Ibn Abi Shaybah 33098","","","كتاب الفضائل"
"33099","(۳۳۰۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَتَاکُمْ أَہْلُ الْیَمَنِ ، ہُمْ أَلْیَنُ قُلُوبًا وَأَرَقُّ أَفْئِدَۃً ، الإِیمَانُ یَمَانٍ وَالْحِکْمَۃُ یَمَانِیَّۃٌ ، وَرَأْسُ الْکُفْرِ قِبَلَ الْمَشْرِقِ۔ (مسلم ۷۳۔ احمد ۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 33099","","","كتاب الفضائل"
"33100","(۳۳۱۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : أَشَارَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہِ نَحْوَ الْیَمَنِ ، فَقَالَ : إنَّ الإیمان ہَاہُنَا ، وَإِنَّ الْقَسْوَۃَ وَغِلَظَ الْقُلُوبِ فِی الْفَدَّادِینَ عِنْدَ أُصُولِ أَذْنَابِ الإِبِلِ فِی رَبِیعَۃَ وَمُضَرَ۔ (بخاری ۳۳۰۲۔ مسلم ۷۱)","Sahih","Musannaf Ibn Abi Shaybah 33100","","","كتاب الفضائل"
"33101","(۳۳۱۰۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ أَبِی الأَحْوَصِ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِیمَانُ فِی أَہْلِ الْحِجَازِ ، وَالْقَسْوَۃُ وَغِلَظُ الْقُلُوبِ قِبَلَ الْمَشْرِقِ فِی رَبِیعَۃَ وَمُضَرَ۔ (مسلم ۷۳۔ احمد ۳۳۵)","Hasan","Musannaf Ibn Abi Shaybah 33101","","","كتاب الفضائل"
"33102","(۳۳۱۰۲) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِیمَانُ یَمَانٍ وَالْحِکْمَۃُ یَمَانِیَّۃٌ وَہُمْ قَوْمٌ فِیہِمْ حَیَائٌ وَضَعْفٌ وربما قَالَ : عِی۔ (بخاری ۳۴۹۹۔ مسلم ۸۲)","","Musannaf Ibn Abi Shaybah 33102","","","كتاب الفضائل"
"33103","(۳۳۱۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسِیرٍ لَہُ ، فَقَالَ : یَطْلُعُ عَلَیْکُمْ أَہْلُ الْیَمَنِ کَأَنَّہُمَ السَّحَابُ ، ہُمْ خَیْرُ مَنْ فِی الأَرْضِ ، فَقَالَ رَجُلٌ مِنَ الأَنْصَارِ : إلاَّ نَحْنُ یَا رَسُولَ اللہِ ، فَقَالَ کَلِمَۃً ضَعِیفَۃً : إلاَّ أَنْتُمْ۔ (ابوداؤد ۹۴۵۔ احمد ۸۲)","Hasan","Musannaf Ibn Abi Shaybah 33103","","","كتاب الفضائل"
"33104","(۳۳۱۰۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ جَبَلَۃَ بْنِ عَطِیَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَوْفٍ الدِّمَشْقِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِیمَانُ یَمَانٍ فِی خندف وَجُذَامَ۔ (طبرانی ۸۵۷)","","Musannaf Ibn Abi Shaybah 33104","","","كتاب الفضائل"
"33105","(۳۳۱۰۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ إمَامِ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ خَیْثَمَۃ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّ النَّاسِ خَیْرٌ ، فَقَالَ : أَہْلُ الْیَمَنِ۔ (احمد ۱۶۵۱)","Da'if","Musannaf Ibn Abi Shaybah 33105","","","كتاب الفضائل"
"33106","(۳۳۱۰۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : قَالَ عَبْدُ اللہِ : الإِیمَانُ یَمَانٌ۔","Sahih","Musannaf Ibn Abi Shaybah 33106","","","كتاب الفضائل"
"33107","(۳۳۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ بَیْتِ عَائِشَۃَ ، فَقَالَ : رَأْسُ الْکُفْرِ من ہَاہُنَا مِنْ حَیْثُ یَطْلُعُ قَرْنُ الشَّیْطَانِ ، یَعْنِی الْمَشْرِقَ۔n(مسلم ۲۲۲۹۔ احمد ۲۳)","Sahih","Musannaf Ibn Abi Shaybah 33107","","","كتاب الفضائل"
"33108","(۳۳۱۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، عَنْ جُنْدُبٍ الأَزْدِیِّ ، قَالَ : خَرَجْنَا مَعَ سَلْمَانَ إلَی الْحِیرَۃِ فَالْتَفَتَ إلَی الْکُوفَۃِ ، فَقَالَ : قُبَّۃُ الإسْلاَمِ ، مَا مِنْ أَخْصَاصٍ یُدْفَعُ عنہا مَا یُدْفَعُ ، عَنْ ہَذِہِ الأخصاص إلاَّ أَخْصَاص کَانَ بِہَا مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ تَذْہَبُ الدُّنْیَا حَتَّی یَجْتَمِعَ کُلُّ مُؤْمِنٍ فِیہَا ، أَوْ رَجُلٌ ہَوَاہُ إلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 33108","","","كتاب الفضائل"
"33109","(۳۳۱۰۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، قَالَ : حدَّثَنِی جُنْدُبٌ ، قَالَ : کُنَّا مَعَ سَلْمَانَ وَنَحْنُ جَاؤُونَ مِنَ الْحِیرَۃِ ، فَقَالَ : الْکُوفَۃُ قُبَّۃُ الإسْلاَمِ مَرَّتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 33109","","","كتاب الفضائل"
"33110","(۳۳۱۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَالِمٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : مَا یُدْفَعُ عَنْ أَخْبِیَۃٍ مَا یَدْفَعُ عَنْ أَخْبِیَۃٍ کَانَتْ بِالْکُوفَۃِ لَیْسَ أَخْبِیَۃٌ کَانَتْ مَعَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 33110","","","كتاب الفضائل"
"33111","(۳۳۱۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ رَبِیعِ بْنِ عُمَیْلَۃَ ، عَنْ حُذَیْفَۃَ ، قَالَ : اخْتَلَفَ رَجُلٌ مِنْ أَہْلِ الْکُوفَۃِ وَرَجُلٌ مِنْ أَہْلِ الشَّامِ فَتَفَاخَرَا ، فَقَالَ الْکُوفِیُّ : نَحْنُ أَصْحَابُ یَوْمِ الْقَادِسِیَّۃِ، وَیَوْمِ کَذَا وَیَوْمِ کَذَا وَیَوْمِ کَذَا ، وَقَالَ الشَّامِیُّ : نَحْنُ أَصْحَابُ الْیَرْمُوکِ وَیَوْمِ کَذَا وَیَوْمِ کَذَا ، فَقَالَ حُذَیْفَۃُ : کِلاَہُمَا لَمْ یَشْہَدْہُ اللَّہُ ، ہُلْکَ عَادٌ وَثَمُودُ لَمْ یُؤَامِرْہُ اللَّہُ فِیہِمَا لَمَّا أَہْلَکَہُمَا ، وَمَا مِنْ قَرْیَۃٍ أَحْرَی أَنْ تدفع عنہا عَظِیمَۃً ، یَعْنِی الْکُوفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 33111","","","كتاب الفضائل"
"33112","(۳۳۱۱۲) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حَبَّۃَ الْعُرَنِیِّ أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : یَا أَہْلَ الْکُوفَۃِ ، أَنْتُمْ رَأْسُ الْعَرَبِ وَجُمْجُمَتُہَا وَسَہْمِی الَّذِی أَرْمِی بِہِ إِنْ أَتَانِی شَیْئٌ مِنْ ہَاہُنَا وَہَاہُنَا ، وَإِنِّی بَعَثْت إلَیْکُمْ بِعَبْدِ اللہِ بْنِ مَسْعُودٍ وَاخْتَرْتہ لَکُمْ وَآثَرْتُکُمْ بِہِ عَلَی نَفْسِی إثْرَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 33112","","","كتاب الفضائل"
"33113","(۳۳۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ الْخَطَّابِ إلَی أَہْلِ الْکُوفَۃِ إلَی وُجُوہِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 33113","","","كتاب الفضائل"
"33114","(۳۳۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنِ الشَّعْبِیِّ أَنَّ عُمَرَ کَتَبَ إلَی أَہْلِ الْکُوفَۃِ : إلَی رَأْسِ الْعَرَبِ۔","","Musannaf Ibn Abi Shaybah 33114","","","كتاب الفضائل"
"33115","(۳۳۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : کَتَبَ عُمَرُ إلَیْہِمْ : إلَی رَأْسِ أَہْلِ الإسْلاَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 33115","","","كتاب الفضائل"
"33116","(۳۳۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ أَبِی الْہُذَیْلِ ، قَالَ : یَأْتِی عَلَی النَّاسِ زَمَانٌ یُخَیِّمُ کُلُّ مُؤْمِنٍ بِالْکُوفَۃِ۔","","Musannaf Ibn Abi Shaybah 33116","","","كتاب الفضائل"
"33117","(۳۳۱۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ شِمْرٍ ، قَالَ : قَالَ عُمَرُ : الْکُوفَۃُ رُمْحُ اللہِ وَکَنْزُ الإِیمَانِ وَجُمْجُمَۃُ الْعَرَبِ یجزون ثُغُورَہُمْ وَیَمُدُّونَ الأَمْصَارَ۔","","Musannaf Ibn Abi Shaybah 33117","","","كتاب الفضائل"
"33118","(۳۳۱۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنِ الرُّکَیْنِ بْنِ الرَّبِیعِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ حُذَیْفَۃُ : مَا أَخْبِیَۃٍ بَعْدَ أَخْبِیَۃٍ کَانَتْ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِبَدْرٍ یُدْفَعُ عنہا مَا یُدْفَعُ عَنْ ہَذِہِ ، یَعْنِی الْکُوفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 33118","","","كتاب الفضائل"
"33119","(۳۳۱۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، عَنْ جُنْدُبٍ ، عَنْ سَلْمَانَ ، قَالَ : الْکُوفَۃُ قُبَّۃُ الإسْلاَمِ ، یَأْتِی عَلَی النَّاسِ زَمَانٌ لاَ یَبْقَی فِیہَا مُؤْمِنٌ إلاَّ بِہَا ، أَوْ قَلْبُہُ یَہْوَی إلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 33119","","","كتاب الفضائل"
"33120","(۳۳۱۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ : سَأَلْتُ الْحَسَنَ : أَہْلُ الْکُوفَۃِ أَشْرَفُ ، أَوْ أَہْلُ الْبَصْرَۃِ ، قَالَ : کَانَ یُبْدَأُ بِأَہْلِ الْکُوفَۃِ۔","","Musannaf Ibn Abi Shaybah 33120","","","كتاب الفضائل"
"33121","(۳۳۱۲۱) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنِ الأَجْلَحِ ، عَنْ عَمَّارٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : یَا أَہْلَ الْکُوفَۃِ ، أَنْتُمْ أَسْعَدُ النَّاسِ بِالْمَہْدِیِّ۔","Hasan","Musannaf Ibn Abi Shaybah 33121","","","كتاب الفضائل"
"33122","(۳۳۱۲۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ لِی : مِمَّنْ أَنْتَ ، فَقُلْتُ : مِنْ أَہْلِ الْکُوفَۃِ ، فَقَالَ : وَالَّذِی نَفْسِی بِیَدِہِ ، لَیُسَافَرُ مِنْہَا إلَی أَرْضِ الْعَرَبِ لاَ تَمْلِکُونَ قَفِیزًا ، وَلاَ دِرْہَمًا ، ثُمَّ لاَ یُنْجِیکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33122","","","كتاب الفضائل"
"33123","(۳۳۱۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ رَبِّہِ بْنِ أَبِی رَاشِدٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : الْبَصْرَۃُ خَیْرٌ مِنَ الْکُوفَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 33123","","","كتاب الفضائل"
"33124","(۳۳۱۲۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : طُفْت الأَمْصَارَ فَمَا رَأَیْت مِصْرًا أکثر مُتَہَجَّدًا مِنْ أَہْلِ الْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 33124","","","كتاب الفضائل"
"33125","(۳۳۱۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، قَالَ قَالَ حُذَیْفَۃُ : إنَّ أَہْلَ الْبَصْرَۃِ لاَ یَفْتَحُونَ بَابَ ہُدَی ، وَلاَ یترکون بَابَ ضَلاَلَۃٍ ، وَإِنَّ الطُّوفَانَ قَدْ رُفِعَ عَنِ الأَرْضِ کُلِّہَا إلاَّ الْبَصْرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 33125","","","كتاب الفضائل"
"33126","(۳۳۱۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : جَائَ رَجُلٌ إلَی حُذَیْفَۃَ ، فَقَالَ : إنِّی أُرِیدُ الْخُرُوجَ إلَی الْبَصْرَۃِ ، فَقَالَ : لاَ تَخْرُجْ إلَیْہَا ، قَالَ : إنَّ لِی بِہَا قَرَابَۃً ؟ قَالَ : لاَ تَخْرُجْ ، قَالَ : لاَ بُدَّ مِنَ الْخُرُوجِ قَالَ : فَانْزِلْ عَدْوَتَہَا ، وَلاَ تَنْزِلْ سُرَّتَہا۔","Sahih","Musannaf Ibn Abi Shaybah 33126","","","كتاب الفضائل"
"33127","(۳۳۱۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا فَسَدَ أَہْلُ الشَّامِ فَلاَ خَیْرَ فِیکُمْ۔ (ابن حبان ۷۳۰۳۔ احمد ۴۳۶)","","Musannaf Ibn Abi Shaybah 33127","","","كتاب الفضائل"
"33128","(۳۳۱۲۸) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ أَبِی زید عن أبی أَیُّوبَ الأَنْصَارِیِّ ، قَالَ : لَیُہَاجِرَنَّ الرَّعْدُ وَالْبَرْقُ والبرکات إلَی الشَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 33128","","","كتاب الفضائل"
"33129","(۳۳۱۲۹) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : مَدَّ الفُرات عَلَی عَہْدِ عَبْدِ اللہِ فَکَرِہَ النَّاسُ ذَلِکَ ، فقَالَ : أَیُّہَا النَّاسُ ، لاَ تَکْرَہُوا مَدَّہُ فَإِنَّہُ یُوشِکُ أَنْ یُلْمَسَ فِیہِ طَسْتٌ مِنْ مَائٍ فَلاَ یُوجَدُ ، وَذَاکَ حِینَ یَرْجِعُ کُلُّ مَائٍ إلَی عُنْصُرِہِ ، فَیَکُونُ الْمَائُ وَبَقِیَّۃُ الْمُؤْمِنِینَ یَوْمَئِذٍ بِالشَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 33129","","","كتاب الفضائل"
"33130","(۳۳۱۳۰) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : {وَآوَیْنَاہُمَا إِلَی رَبْوَۃٍ ذَاتِ قَرَارٍ وَمَعِینٍ} قَالَ : دِمَشْقُ۔","","Musannaf Ibn Abi Shaybah 33130","","","كتاب الفضائل"
"33131","(۳۳۱۳۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرٍ الْغَسَّانِیِّ ، عَنْ حَبِیبٍ ، قَالَ : قَالَ کَعْبٌ : أَحَبُّ الْبِلاَدِ إلَی اللہِ الشَّامُ وَأَحَبُّ الشَّامِ إلَیْہِ الْقُدْسُ ، وَأَحَبُّ الْقُدْسِ إلَیْہِ جَبَلٌ بِنَابُلُسَ ، لَیَأْتِیَنَّ عَلَی النَّاسِ زَمَانٌ یَتَمَاسُّونَہُ ، أَوْ یَتَمَاسَحُونَہُ بِالْحِبَالِ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 33131","","","كتاب الفضائل"
"33132","(۳۳۱۳۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَعْقِلُ الْمُسْلِمِینَ مِنَ الْمَلاَحِمِ دِمَشْقُ ، وَمَعْقِلُہُمْ مِنَ الدَّجَّالِ بَیْتُ الْمَقْدِسِ ، وَمَعْقِلُہُمْ مِنْ یَأْجُوجَ وَمَأْجُوجَ بَیْتُ الطُّورِ۔","Da'if","Musannaf Ibn Abi Shaybah 33132","","","كتاب الفضائل"
"33133","(۳۳۱۳۳) حَدَّثَنَا یَحْیَی بْنُ إِسْحَاقَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ أَیُّوبَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ أَنَّ عَبْدَ الرَّحْمَن بْنَ شِمَاسَۃَ الْمُہْرِیَّ أَخْبَرَہُ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : بَیْنَمَا نَحْنُ حَوْلَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نُؤَلِّفُ الْقُرْآنَ مِنَ الرِّقَاعِ إذْ قَالَ : طُوبَی لِلشَّامِ ، قِیلَ : یَا رَسُولَ اللہِ ، وبم ذَاکَ وَلِمَ ذَاکَ ، قَالَ : إنَّ مَلاَئِکَۃَ الرَّحْمَن بَاسِطَۃٌ أَجْنِحَتَہَا عَلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 33133","","","كتاب الفضائل"
"33134","(۳۳۱۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ {الأَرْضِ الَّتِی بَارَکْنَا فِیہَا} قَالَ : الشَّامُ۔","","Musannaf Ibn Abi Shaybah 33134","","","كتاب الفضائل"
"33135","(۳۳۱۳۵) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ عَوْفٍ ، عَنْ خُلَیْدٍ الْعَصْرِیِّ ، قَالَ : لَمَّا وَرَدَ عَلَیْنَا سَلْمَانُ أَتَیْنَاہُ لِنَسْتَقْرِئَہُ ، فَقَالَ : إنَّ الْقُرْآنَ عَرَبِیٌّ فَاسْتَقْرِئُوہُ عَرَبِیًّا ، فَکَانَ زَیْدُ بْنُ صُوحَانَ یُقْرِئُنَا ، فَإِذَا أَخَطَأَ أَخَذَ عَلَیْہِ سَلْمَانُ ، وَإِذَا أَصَابَ ، قَالَ : أَیْمُ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 33135","","","كتاب الفضائل"
"33136","(۳۳۱۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِدَائَ الْعَرَبِیِّ یَوْمَ بَدْرٍ أَرْبَعِینَ أُوقِیَّۃً ، وَجَعَلَ فِدَائَ الْمَوْلَی عِشْرِینَ أُوقِیَّۃً ، وَالأُوقِیَّۃُ أَرْبَعُونَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 33136","","","كتاب الفضائل"
"33137","(۳۳۱۳۷) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ وَبَرَۃَ، عَنْ خَرَشَۃَ، قَالَ: قَالَ عُمَرُ: ہَلاَکُ الْعَرَبِ إذَا بَلَغَ أَبْنَائُ بَنَاتِ فَارِسَ۔","Sahih","Musannaf Ibn Abi Shaybah 33137","","","كتاب الفضائل"
"33138","(۳۳۱۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ ، عَنْ حُصَیْنِ بْنِ عُمَرَ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ عُثْمَانَ بْنِ عَفَّانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ غَشَّ الْعَرَبَ لَمْ یَدْخُلْ فِی شَفَاعَتِی وَلَمْ تَنَلْہُ مَوَدَّتِی۔ (ترمذی ۳۹۲۸)","Da'if","Musannaf Ibn Abi Shaybah 33138","","","كتاب الفضائل"
"33139","(۳۳۱۳۹) حَدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ، عَنِ الْمُسْتَظِلِّ بْنِ حُصَیْنٍ، قَالَ خَطَبَنَا عُمَرُ بْنُ الْخَطَّابِ، فَقَالَ : قدْ عَلِمْت وَرَبِّ الْکَعْبَۃِ مَتَی تَہْلِکُ الْعَرَبُ ، فَقَامَ إلَیْہِ رَجُلٌ مِنَ الْمُسْلِمِینَ ، فَقَالَ : مَتَی یَہْلِکُونَ یَا أَمِیرَ الْمُؤْمِنِینَ، قَالَ: حِینَ یَسُوسُ أَمَرَہُمْ مَنْ لَمْ یُعَالِجْ الْجَاہِلِیَّۃِ وَلَمْ یَصْحَبِ الرَّسُولَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 33139","","","كتاب الفضائل"
"33140","(۳۳۱۴۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ حُصَیْنٍ الْمُزَنِیّ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : إنَّمَا مَثَلُ الْعَرَبِ مِثْلُ جَمَلٍ أَنِفٍ اتَّبَعَ قَائِدَہُ فَلْیَنْظُرْ قَائِدُہُ حَیْثُ یَقُودُ ، فَأَمَّا أَنَا فَوَرَبِّ الْکَعْبَۃِ لأَحْمِلَنَّہُمْ عَلَی الطَّرِیقِ۔","Da'if","Musannaf Ibn Abi Shaybah 33140","","","كتاب الفضائل"
"33141","(۳۳۱۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : کَانَ عَمْرُو بْنُ مَعْدِی کَرِبَ یَمُرُّ عَلَیْنَا أَیَّامَ الْقَادِسِیَّۃِ وَنَحْنُ صُفُوفٌ فَیَقُولُ : یَا مَعْشَرَ الْعَرَبِ کُونُوا أسودا أشداء ، فإنما الأسد من أَغْنَی شَأْنَہُ ، إِنَّمَا الْفَارِسِیُّ تَیْسٌ بَعْدَ أَنْ یَلْقَی نَیْزَکَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33141","","","كتاب الفضائل"
"33142","(۳۳۱۴۲) حَدَّثَنَا سُوَیْد الْکَلْبِیُّ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ أَبِی سَلَمَۃَ أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بن کَثِیرَ بْنِ الصَّلْتِ ، قَالَ : نکح مَوْلَی لَنَا عَرَبِیَّۃٌ ، فَأَتَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ فَاسْتَعْدَی عَلَیْہِ ، فَقَالَ : وَاللہِ قَدْ عَدَا مَوْلَی آلِ کَثِیرٍ طَوْرَہُ۔","","Musannaf Ibn Abi Shaybah 33142","","","كتاب الفضائل"
"33143","(۳۳۱۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ الأَسَدِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ أَنَّہُ نَہَی أَنْ یَتَزَوَّجَ الْعَرَبِیُّ الأَمَۃَ ، وَأَنَّہُ قَضَی فِی الْعَرَبِ یَتَزَوَّجُونَ الإِمَائَ وَأَوْلاَدُہُمْ بِالْفِدَائِ : سِتُّ قَلاَئِصَ ، الرِّجَالُ وَالنِّسَائُ سَوَائٌ ، وَالْمَوَالِی مِثْلُ ذَلِکَ إذَا لَمْ یَعْلَمْ ، قَالَ الزُّہْرِیُّ : الْعَرَبِیُّ وَالْمَوْلَی لاَ یَسْتَوِیَانِ فِی النَّسَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 33143","","","كتاب الفضائل"
"33144","(۳۳۱۴۴) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ أَبِی رَزِینٍ ، قَالَ حَدَّثَتْنِی أُمِّی ، قَالَتْ : کَانَتْ أُمُّ الْحُرَیْرِ إذَا مَاتَ رَجُلٌ مِنَ الْعَرَبِ اشْتَدَّ عَلَیْہَا ذَلِکَ ، فَقِیلَ لَہَا : یَا أُمَّ الحُرَیْرِ ، إنَّا نَرَاک إذَا مَاتَ رَجُلٌ مِنَ الْعَرَبِ اشْتَدَّ عَلَیْک ، قَالَتْ : سَمِعْت مَوْلاَیَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنَ اقْتِرَابِ السَّاعَۃِ ہَلاَکُ الْعَرَبِ۔n وَکَانَ مَوْلاَہَا طَلْحَۃُ بْنُ مَالِکٍ۔ (ترمذی ۳۹۲۹)","Da'if","Musannaf Ibn Abi Shaybah 33144","","","كتاب الفضائل"
"33145","(۳۳۱۴۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَعْقُوبَ، قَالَ سَمِعْت عَبْدَ الرَّحْمَن بْنَ أَبِی بَکْرَۃَ یُحَدِّثُ، عَنْ أَبِیہِ أَنَّ الأَقْرَعَ بْنَ حَابِسٍ جَائَ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّمَا بَایَعَک سُرَّاقُ الْحَاجِّ مِنْ أَسْلَمَ وَغِفَارٍ وَمُزَیْنَۃَ وَأَحْسِبُ جُہَیْنَۃَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرَأَیْت إِنْ کَانَ أَسْلَمُ وَغِفَارٌ وَأَحْسِبُ جُہَیْنَۃَ خَیْرًا مِنْ بَنِی تَمِیمٍ وَمِنْ بَنِی عَامِرٍ وَأَسَدٍ وَغَطَفَانَ أخَابُوا وَخَسِرُوا ، قَالَ : نَعَمْ ، قَالَ : فَوَالَّذِی نَفْسِی بِیَدِہِ إنَّہُمْ لأَخْیَرُ مِنْہُمْ۔ (بخاری ۳۵۱۶۔ مسلم ۱۹۵۵)","Sahih","Musannaf Ibn Abi Shaybah 33145","","","كتاب الفضائل"
"33146","(۳۳۱۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرَأَیْتُمْ إِنْ کَانَتْ جُہَیْنَۃُ وَأَسْلَمُ وَغِفَارٌ خَیْرًا مِنْ بَنِی تَمِیمٍ وَمِنْ بَنِی عَبْدِ اللہِ بْنِ غَطَفَانَ وَعَامِرِ بْنِ صَعْصَعَۃَ وَمَدَّ بِہَا صَوْتَہُ ، قَالُوا : یَا رَسُولَ اللہِ ، فَقَدْ خَابُوا وَخَسِرُوا ، قَالَ : فَإِنَّہُمْ خَیْرٌ۔ (بخاری ۳۵۱۵۔ مسلم ۱۹۵۶)","Sahih","Musannaf Ibn Abi Shaybah 33146","","","كتاب الفضائل"
"33147","(۳۳۱۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ أَبَا سَلَمَۃَ یُحَدِّثُ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : أَسْلَمُ وَغِفَارٌ وَمُزَیْنَۃُ وَمَنْ کَانَ مِنْ جُہَیْنَۃَ ، أَوْ جُہَیْنَۃُ ، خَیْرٌ مِنْ بَنِی تَمِیمٍ وَمِنْ بَنِی عَامِرٍ وَالْحَلِیفَیْنِ : أَسَدٍ وَغَطَفَانَ۔ (مسلم ۱۹۵۵۔ احمد ۴۶۸)","Sahih","Musannaf Ibn Abi Shaybah 33147","","","كتاب الفضائل"
"33148","(۳۳۱۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ ہُرْمُزَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : قرَیْشٌ وَالأَنْصَارُ وَأَسْلَمُ وَغِفَارٌ مَوَالٍ لِلَّہِ وَلِرَسُولِہِ ، وَلاَ مَوْلَی لَہُمْ غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33148","","","كتاب الفضائل"
"33149","(۳۳۱۴۹) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عُمَرَ بْنِ رَاشِدٍ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَسْلَمُ سَالَمَہَا اللَّہُ وَغِفَارٌ غَفَرَ اللَّہُ لَہَا۔ (احمد ۴۸)","Da'if","Musannaf Ibn Abi Shaybah 33149","","","كتاب الفضائل"
"33150","(۳۳۱۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ إِسْحَاقَ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، عَنْ حَنْظَلَۃَ بْنِ عَلِیٍّ الأَسْلَمِیِّ ، عَنْ خُفَافِ بْنِ إیمَائِ بْنِ رَحَضَۃَ الْغِفَارِیِّ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا رَفَعَ رَأْسَہُ مِنَ الرَّکْعَۃِ الآخِرَۃِ ، قَالَ : أَسْلَمُ سَالَمَہَا اللَّہُ وَغِفَارٌ غَفَرَ اللَّہُ لَہَا ، ثُمَّ أَقْبَلَ ، فَقَالَ : إنِّی لَسْتُ أَنَا قُلْتُ ہَذَا ، وَلَکِنَّ اللَّہَ قَالَہُ۔","","Musannaf Ibn Abi Shaybah 33150","","","كتاب الفضائل"
"33151","(۳۳۱۵۱) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا ، عَنْ سَعْدِ بْنِ طَارِقٍ ، قَالَ : حَدَّثَنِی سَالِمُ بْنُ أَبِی الْجَعْدِ أَنَّ أَبَا الدَّرْدَائِ کَانَ یَحْلِفُ بِاللہِ : لاَ تَبْقَی قَبِیلَۃٌ إلاَّ ضَارَعَتِ النَّصْرَانِیَّۃَ غَیْرَ قَیْسٍ ، یَا مَعْشَرَ الْمُسْلِمِینَ فَأَحِبُّوا قَیْسًا ، یَا مَعْشَرَ الْمُسْلِمِینَ فَأَحِبُّوا قَیْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 33151","","","كتاب الفضائل"
"33152","(۳۳۱۵۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا أَبُو الْحریشِ ، عَنْ زَیْدِ بْنِ مُحَمَّدٍ ، قَالَ : کُنْتُ فِی غَزَاۃٍ مَعَ مَسْلَمَۃَ بْنِ عَبْدِ الْمَلِکِ بِالتُّرْک فَہَدَّدَہُ رَسُولُ خَاقَانَ وَکَتَبَ إلَیْہِ : لأَلْقَیَنَّکَ بِحَزَاوَرَۃِ التُّرْک ، فَکَتَبَ إلَیْہِ مَسْلَمَۃُ : إنَّک تَلْقَانِی بِحَزَاوَرَۃِ التُّرْکِ وَأَنَا أَلْقَاک بِحَزَاوَرَۃِ الْعَرَبِ ، یَعْنِی قَیْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 33152","","","كتاب الفضائل"
"33153","(۳۳۱۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، قَالَ: حَدَّثَنِی مَنْصُورٌ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ، عَنْ حُذَیْفَۃَ، قَالَ : ادْنُوا یَا مَعْشَرَ مُضَرَ إنَّ مِنْکُمْ سَیِّدَ وَلَدِ آدَمَ ، وَمِنْکُمْ سَوَابِقُ کَسَوَابِقِ الْخَیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 33153","","","كتاب الفضائل"
"33154","(۳۳۱۵۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمَّلِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا اخْتَلَفَ النَّاسُ فَالْحَقُّ فِی مُضَرَ۔ (ابو یعلی ۲۵۱۳۔ طبرانی ۱۱۴۱۸)","","Musannaf Ibn Abi Shaybah 33154","","","كتاب الفضائل"
"33155","(۳۳۱۵۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، قَالَ : قَالَ عُمَرُ : قَیْسٌ مَلاَحِمُ الْعَرَبِ۔","","Musannaf Ibn Abi Shaybah 33155","","","كتاب الفضائل"
"33156","(۳۳۱۵۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالأَبْطَحِ فِی قُبَّۃٍ لَہُ حَمْرَائَ ، فَقَالَ : مَنْ أَنْتُمْ قُلْنَا : بَنُو عَامِرٍ ، قَالَ : مَرْحَبًا أَنْتُمْ مِنِّی۔n(طبرانی ۲۶۴۔ بزار ۲۸۳۱)","","Musannaf Ibn Abi Shaybah 33156","","","كتاب الفضائل"
"33157","(۳۳۱۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ النَّزَّالِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّا کُنَّا وَأَنْتُمْ فِی الْجَاہِلِیَّۃِ بَنِی عَبْدِ مَنَافٍ فَنَحْنُ الْیَوْمَ بَنُو عَبْدِ اللہِ وأنتم بنو عبد اللہ۔ n(بخاری ۱۲)","","Musannaf Ibn Abi Shaybah 33157","","","كتاب الفضائل"
"33158","(۳۳۱۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أبی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ اکْفِنِی عَامِرًا وَاہْدِ بَنِی عَامِرٍ۔ (عبدالرزاق ۱۹۸۸۴)","","Musannaf Ibn Abi Shaybah 33158","","","كتاب الفضائل"
"33159","(۳۳۱۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ خَشْرَمٍ الْجَعْفَرِیِّ أَنَّ مُلاَعِبَ الأَسِنَّۃِ عَامِرَ بْنَ مَالِکٍ بَعَثَ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْأَلُہُ الدَّوَائَ أو الشِّفَائَ مِنْ دَائٍ نَزَلَ بِہِ فَبَعَثَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَسَلٍ، أَوْ بعُکَّۃٍ مِنْ عَسَلٍ۔","","Musannaf Ibn Abi Shaybah 33159","","","كتاب الفضائل"
"33160","(۳۳۱۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : جَائَتِ ابْنَۃُ خَالِدِ بْنِ سِنَانٍ الْعَبْسِیِّ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : مَرْحَبًا بِابْنَۃِ أَخِی مَرْحَبًا بِابْنَۃِ نَبِیٍّ ضَیَّعَہُ قَوْمُہُ۔n(بزار ۲۳۶۱۔ طبرانی ۱۲۲۵۰)","","Musannaf Ibn Abi Shaybah 33160","","","كتاب الفضائل"
"33161","(۳۳۱۶۱) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا بَنِی عَبْسٍ ، مَا شِعَارُکُمْ ، قَالُوا : حَرَامٌ ، قَالَ : بَلْ شِعَارُکُمْ حَلاَلٌ۔","","Musannaf Ibn Abi Shaybah 33161","","","كتاب الفضائل"
"33162","(۳۳۱۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الضَّرِیسِ عُقْبَۃُ بْنُ عَمَّارٍ الْعَبْسِیُّ ، عَنْ مَسْعُودِ بْنِ حِرَاشٍ أَخٍ لِرِبْعِیِّ بْنِ حِرَاشٍ أَنَّ عُمَرَ بْنَ الْخَطَّابِ سَأَلَ الْعَبْسِیِّینَ : أَیُّ الْخَیْلِ وَجَدْتُمُوہُ أَصْبَرُ فِی حَرْبِکُمْ ، قَالُوا : الْکُمَیْتُ۔","Hasan","Musannaf Ibn Abi Shaybah 33162","","","كتاب الفضائل"
"33163","(۳۳۱۶۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَاصَرَ أَہْلَ الطَّائِفِ فَجَائَہُ أَصْحَابُہُ فَقَالُوا : یَا رَسُولَ اللہِ ، أَحْرَقَتْنَا نِبَالُ ثَقِیفٍ ، فَادْعُ اللَّہَ عَلَیْہِمْ ، فَقَالَ : اللَّہُمَّ اہْدِ ثَقِیفًا۔ (احمد ۳۴۳)","","Musannaf Ibn Abi Shaybah 33163","","","كتاب الفضائل"
"33164","(۳۳۱۶۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ ہَمَمْت أَنْ لاَ أَقْبَلَ إلاَّ مِنْ قُرَشِیٍّ ، أَوْ أَنْصَارِیٍّ ، أَوْ ثَقَفِیٍّ۔n(عبدالرزاق ۱۶۵۲۱۔ ابن حبان ۶۳۸۴)","","Musannaf Ibn Abi Shaybah 33164","","","كتاب الفضائل"
"33165","(۳۳۱۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مِسْعَرٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ ہَمَمْت أَنْ لاَ أَقْبَلَ ہَدِیَّۃً إلاَّ مِنْ قُرَشِیٍّ ، أَوْ أَنْصَارِیٍّ ، أَوْ ثَقَفِیٍّ ، أَوْ دَوْسِیٍّ۔ (ترمذی ۳۹۴۶)","Sahih","Musannaf Ibn Abi Shaybah 33165","","","كتاب الفضائل"
"33166","(۳۳۱۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ وَفْدَ عَبْدِ الْقَیْسِ أَتَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ الْوَفْدُ ، أَوْ مَنِ الْقَوْمُ ، قَالَ : قَالُوا : رَبِیعَۃُ ، قَالَ : مَرْحَبًا بِالْوَفْدِ ، أَوْ بِالْقَوْمِ غَیْرَ خَزَایَا ، وَلاَ النَّدَامَی۔","Sahih","Musannaf Ibn Abi Shaybah 33166","","","كتاب الفضائل"
"33167","(۳۳۱۶۷) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ ، قَالَ : حدَّثَنِی شِہَابُ بْنُ عَبَّادٍ الْعَصَرِیُّ أَنَّ أَبَاہُ حَدَّثَہُ أَنَّ عُمَرَ بْنَ الْخَطَّابِ وَقَفَ عَلَیْہِمْ بِعَرَفَاتٍ ، فَقَالَ : لِمَنْ ہَذِہِ الأَخْبِیَۃُ ؟ فَقَالُوا : لِعَبْدِ الْقَیْسِ ، فَدَعَا لَہُمْ وَاسْتَغْفَرَ لَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33167","","","كتاب الفضائل"
"33168","(۳۳۱۶۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ ذَکَرَ عَبْدُ الرَّحْمَن بْنُ أَبِی بَکْرَۃَ ، قَالَ : قَالَ أَشَجُّ بَنِی عَصَرَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ فِیک لِخُلُقَیْنِ یُحِبُّہُمَا اللَّہُ ، فَقُلْتُ : مَا ہُمَا قَالَ : الْحِلْمُ وَالْحَیَائُ ، قَالَ : قُلْتُ : قَدِیمًا ، کَانَ فِیَّ أَوْ حَدِیثًا ؟ قَالَ : بَلْ قَدِیمًا ، قَالَ : قُلْتُ : الْحَمْدُ لِلَّہِ الَّذِی جَبَلَنِی عَلَی خُلُقَیْنِ یُحِبُّہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 33168","","","كتاب الفضائل"
"33169","(۳۳۱۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ الْمَازِنِیِّ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : جَائَتْ بَنُو تَمِیمٍ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَبْشِرُوا یَا بَنِی تَمِیمٍ ، فَقَالُوا : یَا رَسُولَ اللہِ ، بَشَّرْتَنَا فَأَعْطِنَا۔ (بخاری ۳۱۹۰۔ احمد ۴۳۳)","Sahih","Musannaf Ibn Abi Shaybah 33169","","","كتاب الفضائل"
"33170","(۳۳۱۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنِ الْمَعْرُورِ بْنِ سُوَیْد ، عَنِ ابْنِ فَاتِکٍ ، قَالَ : قَالَ لِی کَعْبٌ : إنَّ أَشَدَّ أَحْیَائِ الْعَرَبِ عَلَی الدَّجَّالِ لَقَوْمُک ، یَعْنِی بَنِی تَمِیمٍ۔","","Musannaf Ibn Abi Shaybah 33170","","","كتاب الفضائل"
"33171","(۳۳۱۷۱) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ مُسَافِرٍ الْجَصَّاصِ ، عَنْ فَصِیلِ بْنِ عَمْرٍو ، وَقَالَ : ذَکَرُوا بَنِی تَمِیمٍ عِنْدَ حُذَیْفَۃَ ، فَقَالَ : إنَّہُمْ أَشَدُّ النَّاسِ عَلَی الدَّجَّالِ۔","","Musannaf Ibn Abi Shaybah 33171","","","كتاب الفضائل"
"33172","(۳۳۱۷۲) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ مِنْدَلٍ ، عَنْ ثَوْرٍ ، عَنْ رَجُلٍ ، قَالَ : خَطَبَ رَجُلٌ مِنَ الأَنْصَارِ امْرَأَۃً ، فَقَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا یَضُرُّک إذَا کَانَتْ ذَاتَ دِینٍ وَجَمَالٍ أَنْ لاَ تَکُونَ مِنْ آلِ حَاجِبِ بْنِ زُرَارَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 33172","","","كتاب الفضائل"
"33173","(۳۳۱۷۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : قرَأَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ کُلِّ خَمْسٍ رَجُلٌ، فَاخْتَلَفُوا فِی اللُّغَۃِ فَرَضِیَ قِرَائَتَہُمْ کُلَّہُمْ، فَکَانَ بَنُو تَمِیمٍ أَعْرَبَ الْقَوْمِ۔(ابن جریر ۱۹)","","Musannaf Ibn Abi Shaybah 33173","","","كتاب الفضائل"
"33174","(۳۳۱۷۴) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنِ ابْنِ سِیرِینَ أَنَّ أَبَا مُوسَی کَتَبَ إلَی عُمَرَ فِی ثَمَانیَۃَ عَشَرَ تِجْفَافًًا فَأَصَابَہَا ، فَکَتَبَ إلَیْہِ عُمَرُ أَنْ ضَعْہَا فِی أَشْجَعِ حَیٍّ مِنَ الْعَرَبِ ، قَالَ : فَوَضَعَہَا فِی بَنِی رِیَاحٍ حَیٍّ مِنْ بَنِی تَمِیمٍ۔","","Musannaf Ibn Abi Shaybah 33174","","","كتاب الفضائل"
"33175","(۳۳۱۷۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ مَنْ بَایَعَ یَوْمَ الْحُدَیْبِیَۃِ أَبُو سِنَانٍ الأَسَدِیُّ۔ (ابن سعد ۱۰۰)","","Musannaf Ibn Abi Shaybah 33175","","","كتاب الفضائل"
"33176","(۳۳۱۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، عَنْ أبِی وَائِلٍ أَنَّ وَفْدَ بَنِی أَسَدٍ أَتَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَقَالَ: مَنْ أَنْتُمْ فَقَالُوا: نَحْنُ بَنُو زِنْیَۃَ، فَقَالَ: أَنْتُمْ بَنُو رِشْدَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 33176","","","كتاب الفضائل"
"33177","(۳۳۱۷۷) حَدَّثَنَا مُحَمَّدُ بْنِ الْحَسَنِ ، قَالَ : حدَّثَنَا الْوَلِیدُ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، قَالَ أَدْرَکْت أَلْفَیْنِ مِنْ بَنِی أَسَدٍ قَدْ شَہِدُوا الْقَادِسِیَّۃَ فِی أَلْفَیْنِ ، وَکَانَتْ رَایَاتُہَا فِی یَدِ سِمَاکٍ صَاحِبِ الْمَسْجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 33177","","","كتاب الفضائل"
"33178","(۳۳۱۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، قَالَ : جَائَ عَلِیٌّ بِسَیْفِہِ ، فَقَالَ : خُذِیہِ حَمِیدًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ کُنْتَ أَحْسَنْت الْقِتَالَ الْیَوْمَ فَقَدْ أَحْسَنَہُ سَہْلُ بْنُ حُنَیْفٍ وَعَاصِمُ بْنُ ثَابِتٍ وَالْحَارِثُ بْنُ صِمَّۃَ ، وَأَبُو دُجَانَۃَ ، وعن عکرمۃ قَالَ قال رسول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یوم أحد : مَنْ یَأْخُذُ ہَذَا السَّیْفَ بِحَقِّہِ ، فَقَالَ أَبُو دُجَانَۃَ أَنَا وَأَخَذَ السَّیْفَ فَضَرَبَ بِہِ حَتَّی جَائَ بِہِ قَدْ حَنَاہُ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَعْطَیْتُہُ حَقَّہُ ، قَالَ نَعَمْ۔ (طبرانی ۶۵۰۷۔ حاکم ۲۴)","","Musannaf Ibn Abi Shaybah 33178","","","كتاب الفضائل"
"33179","(۳۳۱۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِبِلاَلٍ : مَا صَنَعْت فِی رَکْبِ الْبَجَلِیِّینَ ابْدَأْ بِالأَحْمَسِیِّینَ قَبْلَ الْقَسْرِیِّینَ۔ (احمد ۱۶۶۸)","","Musannaf Ibn Abi Shaybah 33179","","","كتاب الفضائل"
"33180","(۳۳۱۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقٍ ، قَالَ : جَائَتْ وُفُودُ قَسْرٍ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۳۱۵۔ ۸۲۱۱)","Sahih","Musannaf Ibn Abi Shaybah 33180","","","كتاب الفضائل"
"33181","(۳۳۱۸۱) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: شَہِدَ بَدْرًا سِتَّۃٌ مِنَ الأَعَاجِمِ مِنْہُمْ بِلاَلٌ وَتَمِیمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33181","","","كتاب الفضائل"
"33182","(۳۳۱۸۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عن أبیہ ، عَنْ قَیْسِ بْنِ سَعْدٍ رِوَایَۃٌ ، قَالَ : لَوْ کَانَ الدِّینُ مُعَلَّقًا بِالثُّرَیَّا لَتَنَاوَلَہُ نَاسٌ مِنْ أَبْنَائِ فَارِسَ۔ (ابویعلی ۱۴۳۴۔ طبرانی ۹۰۱)","","Musannaf Ibn Abi Shaybah 33182","","","كتاب الفضائل"
"33183","(۳۳۱۸۳) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، عَنْ شَہْرٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کَانَ الدِّینُ مُعَلَّقًا بِالثُّرَیَّا لَتَنَاوَلَہُ نَاسٌ مِنْ أَبْنَائِ فَارِسَ۔ (بخاری ۴۸۹۷۔ مسلم ۲۳۱)","Da'if","Musannaf Ibn Abi Shaybah 33183","","","كتاب الفضائل"
"33184","(۳۳۱۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسٍ أَنَّ عُمَرَ بْنَ الْخَطَّابِ فَرَضَ لأَہْلِ بَدْرٍ لعربیہم وَمَوْلاَہُمْ فِی خَمْسَۃِ آلاَفٍ خَمْسَۃَ آلاَفٍ ، وَقَالَ : لأُفَضِّلَنَّہُمْ عَلَی مَنْ سِوَاہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33184","","","كتاب الفضائل"
"33185","(۳۳۱۸۵) حَدَّثَنَا أَحْمَدُ بْنُ الْمُفَضَّلِ ، قَالَ : حدَّثَنَا أَسْبَاطُ بْنُ نَصْرٍ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی سَعِیدٍ الأَزْدِیِّ ، عَنْ أَبِی الْکَنُودِ ، عَنْ خَبَّابِ بْنِ الأَرَتِّ : (وَلاَ تَطْرُدَ الَّذِینَ یَدْعُونَ رَبَّہُمْ بِالْغَدَاۃِ وَالْعَشِیِّ یُرِیدُونَ وَجْہَہُ) قَالَ : جَائَ الأَقْرَعُ بْنُ حَابِسٍ التَّمِیمِیُّ وَعُیَیْنَۃُ بْنُ حِصْنٍ الْفَزَارِیّ فَوَجَدُوا النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَاعِدًا مَعَ بِلاَلٍ وَعَمَّارٍ وَصُہَیْبٍ وَخَبَّابِ بْنِ الأَرَتِّ فِی نَاسٍ مِنَ الضُّعَفَائِ مِنَ الْمُؤْمِنِینَ ، فَلَمَّا رَأَوْہُمْ حَقَّرُوہُمْ فَأَتَوْہُ فَخَلَوْا بِہِ فَقَالُوا : إنا نُحِبُّ أَنْ تَجْعَلَ لَنَا مِنْک مَجْلِسًا تَعْرِفُ لَنَا بِہِ الْعَرَبُ فَضْلَنَا ، فَإِنَّ وُفُودَ الْعَرَبِ تَأْتِیک فَنَسْتَحِی أَنْ تَرَانَا مَعَ ہَذِہِ الأَعْبُد ، فَإِذَا نَحْنُ جِئْنَاک فَأَقِمْہُمْ عَنَّا ، وَإِذَا نَحْنُ فَرَغْنَا فَاقْعُدْ مَعَہُمْ إِنْ شِئْتَ ، قَالَ : نَعَمْ ، قَالُوا : فَاکْتُبْ لَنَا کِتَابًا ، فَدَعَا بِالصَّحِیفَۃِ لِتُکْتَبَ وَدَعَا عَلِیًّا لِیَکْتُبَ ، فَلَمَّا أَرَادَ ذَلِکَ وَنَحْنُ قُعُودٌ فِی نَاحِیَۃٍ إذْ نَزَلَ عَلَیْہِ جِبْرِیلُ ، فَقَالَ : {وَلاَ تَطْرُدَ الَّذِینَ یَدْعُونَ رَبَّہُمْ بِالْغَدَاۃِ وَالْعَشِیِّ یُرِیدُونَ وَجْہَہُ} إلَی قَوْلِہِ {فَتَطْرُدَہُمْ فَتَکُونَ مِنَ الظَّالِمِینَ}۔ (ابن ماجہ ۴۱۲۷۔ طبرانی ۳۶۹۳)","Da'if","Musannaf Ibn Abi Shaybah 33185","","","كتاب الفضائل"
"33186","(۳۳۱۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْمِقْدَامِ ، عَنْ حَبَّۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عَلِیِّ بْنِ أَبِی طَالِبٍ ، فَقَالَ : إنِّی اشْتَرَیْت بَعِیرًا وَتَجَہَّزْت وَأُرِیدُ الْمَقْدِسَ ، فَقَالَ : بِعْ بَعِیرَک وَصَلِّ فِی ہَذَا الْمَسْجِدِ ، قَالَ أَبُو بَکْرٍ : یَعْنِی مَسْجِدَ الْکُوفَۃِ فَمَا مِنْ مَسْجِدٍ بَعْدَ مَسْجِدِ الْحَرَامِ أَحَبُّ إلَیَّ مِنْہُ ، لَقَدْ نَقَصَ مِمَّا أُسِّسَ خَمْسُ مِئَۃِ ذِرَاعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33186","","","كتاب الفضائل"
"33187","(۳۳۱۸۷) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ، قَالَ : لَقِیَنِی کَعْبٌ بِبَیْتِ الْمَقْدِسِ ، فَقَالَ : مِنْ أَیْنَ جِئْتَ ؟ قُلْتُ : مِنْ مَسْجِدِ الْکُوفَۃِ ، فَقَالَ : لأَنْ أَکُونَ جِئْتُ مِنْ حَیْثُ جِئْتَ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِأَلْفَیْ دِینَارٍ ، أَضَعُ کُلَّ دِینَارٍ مِنْہَا فِی یَدِ کُلِّ مِسْکِینٍ ، ثُمَّ حَلَفَ : إِنَّہُ لَوَسَطُ الأَرْضِ کَقَعْرِ الطَّسْتِ۔","","Musannaf Ibn Abi Shaybah 33187","","","كتاب الفضائل"
"33188","(۳۳۱۸۸) حَدَّثَنَا حَاتِمٌ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ جَائَ مَسْجِدِی ہَذَا ، قَالَ أَبُو بَکْرٍ : یَعْنِی مَسْجِدَ الْمَدِینَۃِ ، لَمْ یَأْتِہِ إلاَّ لِخَیْرٍ یُعَلِّمُہُ ، أَوْ یَتَعَلَّمُہُ فَہُوَ بِمَنْزِلَۃِ الْمُجَاہِدِ فِی سَبِیلِ اللہِ ، وَمَنْ جَائَ لِغَیْرِ ذَلِکَ فَہُوَ بِمَنْزِلَۃِ الرَّجُلِ یَنْظُرُ إلَی مَتَاعِ غَیْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 33188","","","كتاب الفضائل"
"33189","(۳۳۱۸۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ نَافِعٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ ، عن بْنِ مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ قَالَتْ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : صَلاَۃٌ فِیہِ ، یَعْنِی مَسْجِدَ الْمَدِینَۃِ أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ إلاَّ مَسْجِدَ مَکَّۃَ۔n قَالَ أَبُو بَکْرٍ : وَرُوَاۃُ أَہْلِ مِصْرَ لاَ یُدْخِلُونَ فِیہِ ابْنَ عَبَّاسٍ۔","Sahih","Musannaf Ibn Abi Shaybah 33189","","","كتاب الفضائل"
"33190","(۳۳۱۹۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْمَسْجِدُ الَّذِی أُسِّسَ عَلَی التَّقْوَی ہُوَ مَسْجِدِی۔","Da'if","Musannaf Ibn Abi Shaybah 33190","","","كتاب الفضائل"
"33191","(۳۳۱۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، قَالَ : حدَّثَنَا أَبُو الأَبْرَدِ مَوْلَی بَنِی خَطْمَۃَ أَنَّہُ سَمِعَ أُسَیْدَ بْنَ ظَہِیرٍ الأَنْصَارِیَّ وَکَانَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحَدِّثُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : صَلاَۃٌ فِی مَسْجِدِ قُبَائَ کَعُمْرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33191","","","كتاب الفضائل"
"33192","(۳۳۱۹۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : أَخْبَرَنِی یُوسُفُ بْنُ طَہْمَانَ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلِ بْنِ حُنَیْفٍ ، عَنْ أَبِیہِ سَہْلِ بْنِ حُنَیْفٍ ، فَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَوَضَّأَ فَأَحْسَنَ وُضُوئَہُ ، ثُمَّ جَائَ مَسْجِدَ قُبَائَ فَرَکَعَ فِیہِ أَرْبَعَ رَکَعَاتٍ کَانَ ذَلِکَ کَعَدْلِ عُمْرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33192","","","كتاب الفضائل"
"33193","(۳۳۱۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْتِی قُبَائَ رَاکِبًا وَمَاشِیًا۔","Sahih","Musannaf Ibn Abi Shaybah 33193","","","كتاب الفضائل"
"33194","(۳۳۱۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ بْنِ رُکَانَۃَ الْمُطَّلِبِیَّ ، عَنْ جُبَیْرِ بْنِ مُطْعِمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ صَلاَۃً فِی مَسْجِدِی ہَذَا أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ إلاَّ الْمَسْجِدَ الْحَرَامَ۔","","Musannaf Ibn Abi Shaybah 33194","","","كتاب الفضائل"
"33195","(۳۳۱۹۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ دَاوُدَ بْنِ مُدْرِکٍ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃٌ فِی مَسْجِدِی ہَذَا أَفْضَلُ مِنْ أَلْفِ صَلاَۃٍ فِیمَا سِوَاہُ مِنَ الْمَسَاجِدِ إلاَّ الْمَسْجِدَ الْحَرَامَ۔","Da'if","Musannaf Ibn Abi Shaybah 33195","","","كتاب الفضائل"
"33196","حدثنا أبو عبد الرحمن قَالَ حدثنا أبو بکر بن أبی شیبۃ قال:n(۳۳۱۹۶) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّم[corrupt] : مَنْ أَطَاعَنِی فَقَدْ أَطَاعَ اللَّہَ وَمَنْ أَطَاعَ الإِمَامَ فَقَدْ أَطَاعَنِی ، وَمَنْ عَصَانِی فَقَدْ عَصَی اللَّہَ وَمَنْ عَصَی الإِمَامَ فَقَدْ عَصَانِی۔ (ابن ماجہ ۲۸۵۹۔ احمد ۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 33196","","","كتاب الجهاد"
"33197","(۳۳۱۹۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَطَاعَنِی فَقَدْ أَطَاعَ اللَّہَ ، وَمَنْ أَطَاعَ أَمِیرِی فَقَدْ أَطَاعَنِی۔ (بخاری ۲۹۵۷۔مسلم ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 33197","","","كتاب الجهاد"
"33198","(۳۳۱۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : {أَطِیعُوا اللَّہَ وَأَطِیعُوا الرَّسُولَ وَأُولِی الأَمْرِ مِنْکُمْ} قَالَ : الأُمَرَائُ۔","Sahih","Musannaf Ibn Abi Shaybah 33198","","","كتاب الجهاد"
"33199","(۳۳۱۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ مُصْعَبَ بْنَ سَعْدٍ یَقُولُ : قَالَ عَلِیُّ بْنُ أَبِی طَالِبٍ : کَلِمَاتٌ أَصَابَ فِیہِنَّ : حَقٌّ عَلَی الإِمَامِ أَنْ یَحْکُمَ بِمَا أَنْزَلَ اللَّہُ وَأَنْ یُؤَدِّیَ الأَمَانَۃَ ، فَإِذَا فَعَلَ ذَلِکَ کَانَ حَقًّا عَلَی الْمُسْلِمِینَ أَنْ یَسْمَعُوا وَیُطِیعُوا وَیُجِیبُوا إذَا دُعُوا۔","Sahih","Musannaf Ibn Abi Shaybah 33199","","","كتاب الجهاد"
"33200","(۳۳۲۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : {وَأُولِی الأَمْرِ مِنْکُمْ} قَالَ : أُولُوا الْفِقْہِ أُولُو الْخَیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 33200","","","كتاب الجهاد"
"33201","(۳۳۲۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {أَطِیعُوا اللَّہَ وَأَطِیعُوا الرَّسُولَ وَأُولِی الأَمْرِ مِنْکُمْ} قَالَ : کَانَ مُجَاہِدٌ یَقُولُ : أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرُبَّمَا قَالَ : أُولُو الْعَقْلِ وَالْفِقْہِ فِی دِینِ اللہِ۔","","Musannaf Ibn Abi Shaybah 33201","","","كتاب الجهاد"
"33202","(۳۳۲۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : الْعُلَمَائُ۔","","Musannaf Ibn Abi Shaybah 33202","","","كتاب الجهاد"
"33203","(۳۳۲۰۳) حَدَّثَنَا وَکِیعٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ رَبِّ الْکَعْبَۃِ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَایَعَ إمَامًا فَأَعْطَاہُ صَفْقَۃَ یَدِہِ وَثَمَرَۃَ قَلْبِہِ فَلْیُطِعْہُ مَا اسْتَطَاعَ۔ (مسلم ۱۴۷۳۔ احمد۱۶۱)","Sahih","Musannaf Ibn Abi Shaybah 33203","","","كتاب الجهاد"
"33204","(۳۳۲۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ یَحْیَی بْنِ الْحُصَیْنِ ، عَنْ جَدَّتِہِ أُمِّ الْحُصَیْنِ ، قَالَتْ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَخْطُبُ بِعَرَفَۃَ وَہُوَ یَقُولُ : إِنْ أُمِّرَ عَلَیْکُمْ عَبْدٌ حَبَشِیٌّ فَاسْمَعُوا لَہُ وَأَطِیعُوا مَا قَادَکُمْ بِکِتَابِ اللہِ۔ (مسلم ۱۴۶۸۔ احمد ۷۰)","Sahih","Musannaf Ibn Abi Shaybah 33204","","","كتاب الجهاد"
"33205","(۳۳۲۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ الْعَبْدِیِّ ، عَنْ أُمِّ الْحُصَیْنِ الأَحْمَسِیَّۃِ ، قَالَتْ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَخْطُبُ بِعَرَفَۃَ وَعَلَیہ بُرْدٍ مُتَلَفِّعًا بِہِ وَہُوَ یَقُولُ : إِنْ أُمِّرَ عَلَیْکُمْ عَبْدٌ حَبَشِیٌّ مُجَدَّعٌ فَاسْمَعُوا لَہُ وَأَطِیعُوا مَا قَادَکُمْ بِکِتَابِ اللہِ۔ (احمد ۴۰۳)","Sahih","Musannaf Ibn Abi Shaybah 33205","","","كتاب الجهاد"
"33206","(۳۳۲۰۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ {أَطِیعُوا اللَّہَ وَأَطِیعُوا الرَّسُولَ وَأُولِی الأَمْرِ مِنْکُمْ} ، قَالَ : أُمَرَائُ السَّرَایَا۔","Sahih","Musannaf Ibn Abi Shaybah 33206","","","كتاب الجهاد"
"33207","(۳۳۲۰۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ أَنَّ الْحَارِثَ بْنَ یَزِیدَ الْحَضْرَمِیَّ أَخْبَرَہُ أَنَّ أَبَا ذَرٍّ سَأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الإِمَارَۃَ ، وَأَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّک ضَعِیفٌ وَإِنَّہَا أَمَانَۃٌ ، وَإِنَّہَا یَوْمَ الْقِیَامَۃِ خِزْیٌ وَنَدَامَۃٌ ، إِلاَّ مَنْ أَخَذَہَا بِحَقِّہَا وَأَدَّی الَّذِی عَلَیْہِ فِیہَا۔n(مسلم ۱۴۵۷۔ طیالسی ۴۸۵)","","Musannaf Ibn Abi Shaybah 33207","","","كتاب الجهاد"
"33208","(۳۳۲۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا بُرَیْدُ بْنُ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : دَخَلْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَا وَرَجُلاَنِ مِنْ بَنِی عَمِّی ، فَقَالَ أَحَدُ الرَّجُلَیْنِ : یَا رَسُولَ اللہِ ، أَمِّرْنَا عَلَی بَعْضِ مَا وَلاَک اللَّہُ ، وَقَالَ الآخَرُ مِثْلَ ذَلِکَ ، قَالَ : فَقَالَ : إنَّا وَاللہِ لاَ نُوَلِّی ہَذَا الْعَمَلَ أَحَدًا سَأَلَہُ وَلاَ أَحَدًا حَرَصَ عَلَیْہِ۔ (بخاری ۷۱۴۹۔ ابوداؤد ۲۹۲۳)","Sahih","Musannaf Ibn Abi Shaybah 33208","","","كتاب الجهاد"
"33209","(۳۳۲۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّکُمْ سَتَحْرِصُونَ عَلَی الإِمَارَۃِ ، وَسَتَصِیرُ حَسْرَۃً وَنَدَامَۃً ، فَنِعْمَت الْمُرْضِعَۃُ وَبِئْسَتِ الْفَاطِمَۃُ۔ (بخاری ۷۱۲۸۔ احمد ۴۴۸)","Sahih","Musannaf Ibn Abi Shaybah 33209","","","كتاب الجهاد"
"33210","(۳۳۲۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا عَلِیُّ بْنُ زَیْدِ بْنِ جُدْعَانَ ، قَالَ : حَدَّثَنَا الْحَسَنُ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَن بْنُ سَمُرَۃَ ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسْأَلَ الإِمَارَۃَ فَإِنَّک إِنْ أُوتِیتَہَا عَنْ مَسْأَلَۃٍ وُکِلْتَ إلَیْہَا ، وَإِنْ أُوتِیتَہَا عَنْ غَیْرِ مَسْأَلَۃٍ أُعِنْتَ عَلَیْہَا۔n(بخاری ۶۶۲۲۔ ابوداؤد ۲۹۲۲)","Da'if","Musannaf Ibn Abi Shaybah 33210","","","كتاب الجهاد"
"33211","(۳۳۲۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : قَالَ الْعَبَّاسُ یَا رَسُولَ اللہِ ، أَلاَ تَسْتَعْمِلُنِی ، فَقَالَ : یَا عَبَّاسُ یَا عَمَّ رَسُولِ اللہِ نَفْسٌ تُنَجِّیہَا خَیْرٌ مِنْ إمَارَۃٍ لاَ تُحْصِیہَا۔ n(ابن سعد ۲۷۔ بیہقی ۹۶)","","Musannaf Ibn Abi Shaybah 33211","","","كتاب الجهاد"
"33212","(۳۳۲۱۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنْ عامر ، عن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ: مَا مِنْ حَکَمٍ یَحْکُمُ بَیْنَ النَّاسِ إِلاَّ حُشِرَ یَوْمَ الْقِیَامَۃِ وَمَلَکٌ آخِذٌ بِقَفَاہُ حَتَّی یَقِفَ بِہِ عَلَی جَہَنَّمَ ، ثُمَّ یَرْفَعُ رَأْسَہُ إلَی الرَّحْمَان ، فَإِنْ قَالَ لَہُ : اطْرَحْہُ ، طَرَحَہُ فِی مَہْوَی أَرْبَعِینَ خَرِیفًا ، قَالَ : وَقَالَ مَسْرُوقٌ : لأَنْ أَقْضِیَ یَوْمًا وَاحِدًا بِعَدْلٍ وَحَقٍّ أَحَبُّ إلَیَّ مِنْ سَنَۃٍ أَغْزُوہَا فِی سَبِیلِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33212","","","كتاب الجهاد"
"33213","(۳۳۲۱۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ مُحَمَّدٍ الرَّاسِبِیِّ ، عَنْ بِشْرِ بْنِ عَاصِمٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ الْخَطَّابِ عَہْدَہُ ، فَقَالَ : لاَ حَاجَۃَ لِی فِیہِ ، إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ الْوُلاَۃَ یُجَائُ بِہِمْ یَوْمَ الْقِیَامَۃِ فَیَقِفُونَ عَلَی شَفِیرِ جَہَنَّمَ ، فَمَنْ کَانَ مِطْوَاعًا لِلَّہِ تَنَاوَلَہُ اللَّہُ بِیَمِینِہِ حَتَّی یُنَجِّیَہُ ، وَمَنْ عَصَی اللَّہَ انْخَرَقَ بِہِ الْجِسْرُ إلَی وَادٍ مِنْ نَارٍ یَلْتَہِبُ الْتِہَابًا قَالَ : فَأَرْسَلَ عُمَرُ إلَی أَبِی ذَرٍّ وَإِلَی سَلْمَانَ ، فَقَالَ لأَبِی ذَرٍّ : أَنْتَ سَمِعْت ہَذَا الْحَدِیثَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ وَاللہِ ، وَبَعْدَ الْوَادِی وَادٍ آخَرُ مِنْ نَارٍ ، قَالَ : وَسَأَلَ سَلْمَانَ فَکَرِہَ أَنْ یُخْبِرَ بِشَیْئٍ ، فَقَالَ عُمَرُ : مَنْ یَأْخُذُہَا بِمَا فِیہَا ، فَقَالَ أَبُو ذَرٍّ : مَنْ سَلَتَ اللَّہُ أَنْفَہُ وَعَیْنَیْہِ ، وَأَضْرَعَ خَدَّہُ إلَی الأَرْضِ۔ (مسند ۵۸۷)","Da'if","Musannaf Ibn Abi Shaybah 33213","","","كتاب الجهاد"
"33214","(۳۳۲۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ خَیْثَمَۃ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِمَارَۃُ بَابُ ، عَتٍ إِلاَّ مَنْ رَحِمَ اللَّہُ۔ (طبرانی ۳۶۰۳)","","Musannaf Ibn Abi Shaybah 33214","","","كتاب الجهاد"
"33215","(۳۳۲۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : مَا حَرَصَ رَجُلٌ کُلَّ الْحِرْصِ عَلَی الإِمَارَۃِ فَعَدَلَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 33215","","","كتاب الجهاد"
"33216","(۳۳۲۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہَارُونَ الْحَضْرَمِیِّ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ أَنَّ عُمَرَ بْنَ الْخَطَّابِ اسْتَعْمَلَ رَجُلاً ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَشر عَلَیَّ ، قَالَ : اجْلِسْ وَاکْتُمْ عَلَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 33216","","","كتاب الجهاد"
"33217","(۳۳۲۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ جَعْفَرُ بْنُ حَیَّانٍ ، عَنِ الأَعْمَشِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَعْمَلَ رَجُلاً ، فَقَالَ : یَا رَسُولَ اللہِ ، خِرْ لِی ، قَالَ : اجْلِسْ۔ (طبرانی ۴۹۳)","Hasan","Musannaf Ibn Abi Shaybah 33217","","","كتاب الجهاد"
"33218","(۳۳۲۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّفٍ الْیَامِیِّ ، قَالَ : قَالَ خَالِدُ بْنُ الْوَلِیدِ : لاَ تَرْزَأَنَّ مُعَاہِدًا إبرۃ ، وَلاَ تَمْشِ ثَلاَثَ خُطًی تَتَأَمَّرُ عَلَی رَجُلَیْنِ ، وَلاَ تَبْغِ لإِمَامِ الْمُسْلِمِینَ غَائِلَۃً۔","","Musannaf Ibn Abi Shaybah 33218","","","كتاب الجهاد"
"33219","(۳۳۲۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزوق ، عَنْ مَیْمُونٍ ، عَنْ رَجُلٍ مِنْ عَبْدِ الْقَیْسِ ، قَالَ : رَأَیْتُ سَلْمَانَ عَلَی حِمَارٍ فِی سَرِیَّۃٍ ہُوَ أَمِیرُہَا وَخَدَمَتَاہُ تُذَبْذِبَانِ وَالْجُنْدُ یَقُولُونَ : جَائَ الأَمِیرُ جَائَ الأَمِیرُ ، قَالَ : فَقَالَ سَلْمَانُ : إنَّمَا الْخَیْرُ وَالشَّرُّ فِیمَا بَعْدَ الْیَوْمِ ، فَإِنَ اسْتَطَعْت أَنْ تَأْکُلَ مِنَ التُّرَابِ ، وَلاَ تُؤَمَّرَ عَلَی رَجُلَیْنِ فَافْعَلْ ، وَاتَّقِ دَعْوَۃَ الْمَظْلُومِ فَإِنَّہَا لاَ تُحْجَبُ۔","Da'if","Musannaf Ibn Abi Shaybah 33219","","","كتاب الجهاد"
"33220","(۳۳۲۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عِیسَی بْنِ فَائِدٍ ، قَالَ : حدَّثَنِی فُلاَنٌ ، عَنْ سَعْدِ بْنِ عُبَادَۃَ ، قَالَ : حَدَّثَنَا عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا مِنْ أَمِیرِ عَشَرَۃٍ إِلاَّ یُؤْتَی بِہِ یَوْمَ الْقِیَامَۃِ مَغْلُولاً لاَ یَفُکُّہُ مِنْ غُلِّہِ ذَلِکَ إِلاَّ الْعَدْلُ۔ (احمد ۲۸۴۔ طبرانی ۵۳۸۸)","Da'if","Musannaf Ibn Abi Shaybah 33220","","","كتاب الجهاد"
"33221","(۳۳۲۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ أَمِیرِ ثَلاَثَۃٍ إِلاَّ یُؤْتَی بِہِ یَوْمَ الْقِیَامَۃِ مَغْلُولَۃٌ یَدَاہُ إلَی عُنُقِہِ أَطْلَقَہُ الْحَقُّ ، أَوْ أَوْثَقَہُ۔ (احمد ۴۳۱۔ دارمی ۲۵۱۵)","Hasan","Musannaf Ibn Abi Shaybah 33221","","","كتاب الجهاد"
"33222","(۳۳۲۲۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ إسْمَاعِیلَ الأَوْدِیِّ ، قَالَ أَخْبَرَتْنِی بِنْتُ مَعْقِلِ بْنِ یَسَارٍ أَنَّ أَبَاہَا ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لَیْسَ مِنْ وَالٍ یَلِی أُمَّۃً قَلَّتْ ، أَوْ کَثُرَتْ لاَ یَعْدِلُ فِیہَا إِلاَّ کَبَّہُ اللَّہُ عَلَی وَجْہِہِ فِی النَّارِ۔ (بخاری ۱۰۷۲۔ احمد ۲۵)","Da'if","Musannaf Ibn Abi Shaybah 33222","","","كتاب الجهاد"
"33223","(۳۳۲۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ یَسَارٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَا مِنْ أَمِیرِ عَشْرَۃٍ إِلاَّ یُؤْتَی بِہِ یَوْمَ الْقِیَامَۃِ أَطْلَقَہُ الْحَقُّ ، أَوْ أَوْثَقَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33223","","","كتاب الجهاد"
"33224","(۳۳۲۲۴) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ حَازِمٍ ، قَالَ : حَدَّثَنَا عُثْمَان بْنُ مُحَمَّدِ بْنِ الأَخْنَسِ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ، قَالَ : قَالَ سَعْدٌ : کفیتم إنَّ الإِمْرَۃَ لاَ تَزِیدُ الإِنْسَاْن فِی دِینِہِ خَیْرًا۔","","Musannaf Ibn Abi Shaybah 33224","","","كتاب الجهاد"
"33225","(۳۳۲۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعْدَانُ الْجُہَنِیُّ ، عَنْ سَعْدٍ أَبِی مُجَاہِدٍ الطَّائِیِّ ، عَنْ أَبِی مُدِلَّۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الإِمَامُ الْعَادِلُ لاَ تُرَدُّ دَعْوَتُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 33225","","","كتاب الجهاد"
"33226","(۳۳۲۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ قَیْسِ بْنِ عُبَادٍ قَالَ : لَعَمَلُ إمَامٍ عَادِلٍ یَوْمًا خَیْرٌ مِنْ عَمَلِ أَحَدِکُمْ سِتِّینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 33226","","","كتاب الجهاد"
"33227","(۳۳۲۲۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ سَابِطٍ ، عَنْ عَبْدِ اللہِ بْنِ عمرو ، قَالَ فِی الْجَنَّۃِ قَصْرٌ یُدْعَی عَدَنًا حَوْلَہُ الْمُرُوجُ الْبُرُوجُ لَہُ خَمْسَۃُ آلاَفِ بَابٍ لاَ یَسْکُنُہُ ، أَوْ لاَ یَدْخُلُہُ إِلاَّ نَبِیٌّ ، أَوْ صِدِّیقٌ ، أَوْ شَہِیدٌ ، أَوْ إمَامٌ عَادِلٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33227","","","كتاب الجهاد"
"33228","(۳۳۲۲۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ: إنَّ مِنْ إجْلاَلِ اللہِ إکْرَامَ ذِی الشَّیْبَۃِ الْمُسْلِمِ وَحَامِلِ الْقُرْآنِ غَیْرِ الْغَالِی فِیہِ ، وَلاَ الْجَافِی عَنْہُ وَإِکْرَامَ ذِی السُّلْطَانِ الْمُقْسِطِ۔","Da'if","Musannaf Ibn Abi Shaybah 33228","","","كتاب الجهاد"
"33229","(۳۳۲۲۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عَمَّارٌ : ثَلاَثٌ لاَ یَسْتَخِفُّ بِحَقِّہِنَّ إِلاَّ مُنَافِقٌ بَیِّنٌ نِفَاقُہُ : الإِمَامُ الْمُقْسِطُ وَمُعَلِّمُ الْخَیْرِ وَذُو الشَّیْبَۃِ فِی الإِسْلاَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 33229","","","كتاب الجهاد"
"33230","(۳۳۲۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو مَکِینٍ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ أَسْلَمَ یَقُولُ {إنَّ اللَّہَ یَأْمُرُکُمْ أَنْ تُؤَدُّوا الأَمَانَاتِ إلَی أَہْلِہَا وَإِذَا حَکَمْتُمْ بَیْنَ النَّاسِ أَنْ تَحْکُمُوا بِالْعَدْلِ} ، قَالَ : أُنْزِلَتْ فِی وُلاَۃِ الأَمْرِ۔","","Musannaf Ibn Abi Shaybah 33230","","","كتاب الجهاد"
"33231","(۳۳۲۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ {إنَّ اللَّہَ یَأْمُرُکُمْ أَنْ تُؤَدُّوا الأَمَانَاتِ إلَی أَہْلِہَا} ، قَالَ : ہَذِہِ مُبْہَمَۃٌ لِلْبَرِّ وَالْفَاجِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 33231","","","كتاب الجهاد"
"33232","(۳۳۲۳۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی مَرْزُوقٍ مَوْلَی تُجِیب ، قَالَ : غَزَوْنَا مَعَ رُوَیْفِعِ بْنِ ثَابِتٍ الأَنْصَارِیِّ نَحْوَ الْمَغْرِبِ فَفَتَحْنَا قَرْیَۃً ، یُقَالَ لَہَا جَرْبَۃُ ، قَالَ : فَقَامَ فِینَا خَطِیبًا ، فَقَالَ : إنِّی لاَ أَقُولُ فِیکُمْ إِلاَّ مَا سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِینَا یَوْمَ خَیْبَرَ : مَنْ کَانَ یُؤْمِنُ بِاللہِ وَالْیَوْمِ الآخِرِ فَلاَ یَرْکَبَنَّ دَابَّۃً مِنْ فَیْئِ الْمُسْلِمِینَ حَتَّی إذَا أَعْجَفَہَا رَدَّہَا فِیہِ، وَلاَ یَلْبَسْ ثَوْبًا مِنْ فَیْئِ الْمُسْلِمِینَ حَتَّی إذَا أَخْلَقَہُ رَدَّہُ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 33232","","","كتاب الجهاد"
"33233","(۳۳۲۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ سَلْمَانُ عَلَی قَبْضٍ مِنْ قَبْضِ الْمُہَاجِرِینَ ، فَجَائَ إلَیْہِ رَجُلٌ بِقَبْضٍ کَانَ مَعَہُ فَدَفَعَہُ إلَیْہِ ، ثُمَّ أَدْبَرَ فَرَجَعَ إلَیْہِ فَقَالَ : یَا سَلْمَانُ ، إِنَّہُ کَانَ فِی ثَوْبِی خَرْقٌ فَأَخَذْت خَیْطًا مِنْ ہَذَا الْقَبْضِ فَخِطْت بِہِ ، قَالَ : کُلُّ شَیْئٍ وَقَدْرُہُ ، قَالَ : فَجَائَ الرَّجُلُ فَنَشَرَ الْخَیْطَ مِنْ ثَوْبِہِ ، ثُمَّ قَالَ : إنِّی غَنِیٌّ عَنْ ہَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 33233","","","كتاب الجهاد"
"33234","(۳۳۲۳۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ بَعْضِ أَصْحَابِہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إیَّایَ وَرِبَا الْغُلُولِ أَنْ یَرْکَبَ الرَّجُلُ الدَّابَّۃَ حَتَّی تُحْسَرَ قَبْلَ أَنْ تُؤَدَّی إلَی الْمَغْنَمِ ، أَوْ یَلْبَسَ الثَّوْبَ حَتَّی یَخْلَق قَبْلَ أَنْ یُؤَدَّی إلَی الْمَغْنَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 33234","","","كتاب الجهاد"
"33235","(۳۳۲۳۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : غَزَوْنَا مَعَ سَلْمَانَ بْنِ رَبِیعَۃَ بَلَنْجَرَ فَحَرَّجَ عَلَیْنَا أَنْ نَحْمِلَ عَلَی دَوَابِّ الْغَنِیمَۃِ ، وَرَخَّصَ لَنَا فِی الْغِرْبَالِ وَالْمُنْخُلِ وَالْحَبْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 33235","","","كتاب الجهاد"
"33236","(۳۳۲۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ النَّخَعِیِّ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرِو بن جَرِیرٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْرَہُ الشِّکَالَ مِنَ الْخَیْلِ۔n(مسلم ۱۴۹۴۔ ابوداؤد ۲۵۴۰)","Hasan","Musannaf Ibn Abi Shaybah 33236","","","كتاب الجهاد"
"33237","(۳۳۲۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الضُّرَیْسِ عُقْبَۃُ بْنُ عَمَّارٍ الْعَبْسِیُّ ، عَنْ مَسْعُودِ بْنِ حِرَاشٍ أَخِی رِبْعِیٍّ أَنَّ عُمَرَ بْنَ الْخَطَّابِ سَأَلَ الْعَبْسِیِّینَ : أَیُّ الْخَیْلِ وَجَدْتُمُوہُ أَصْبَرَ فِی حَرْبِکُمْ ، قَالُوا : الْکُمَیْتُ۔","Hasan","Musannaf Ibn Abi Shaybah 33237","","","كتاب الجهاد"
"33238","(۳۳۲۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا طَلْحَۃُ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَیْرُ الْخَیْلِ الْحُوُّ۔","Da'if","Musannaf Ibn Abi Shaybah 33238","","","كتاب الجهاد"
"33239","(۳۳۲۳۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیٍّ ، قَالَ سَمِعْت أَبِی یُحَدِّثُ أَنَّ رَجُلاً أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی أُرِیدُ أَنْ أُقَیِّدَ فَرَسًا ، أَوْ أَبْتَاعَ فَرَسًا ، قَالَ : فَقَالَ : فَعَلَیْک بِہِ أَقْرَحَ أَرْثَمَ کُمَیْتًا ، أَوْ أَدْہَمَ مُحَجَّلاً طَلْقَ الْیُمْنَی۔ (ترمذی ۱۶۹۷۔ ابن حبان ۴۶۷۶)","","Musannaf Ibn Abi Shaybah 33239","","","كتاب الجهاد"
"33240","(۳۳۲۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ الشَّامِیُّ ، عَنِ الْوَضِینِ بْنِ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحْذِفُوا أَذْنَابَ الْخَیْلِ فَإِنَّہَا مَذَابُّہَا ، وَلاَ تَقُصُّوا أَعْرَافَہَا فَإِنَّہَا دِفَاؤُہَا۔","","Musannaf Ibn Abi Shaybah 33240","","","كتاب الجهاد"
"33241","(۳۳۲۴۱) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ أَنَّ عُمَرَ نَہَی عَنْ خِصَائِ الْخَیْلِ ، قَالَ : وَأُرَاہُ قَالَ: وَعَنْ حَذْفِ أَذْنَابِہَا۔","","Musannaf Ibn Abi Shaybah 33241","","","كتاب الجهاد"
"33242","(۳۳۲۴۲) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ تُہْلَبَ الْخَیْلُ۔","","Musannaf Ibn Abi Shaybah 33242","","","كتاب الجهاد"
"33243","(۳۳۲۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إبْرَاہِیمَ ، أَوْ غَیْرِہِ ، عَنْ عُمَرَ أَنَّہُ قَالَ : لاَ تَحْذِفُوا أَذْنَابَ الْخَیْلِ۔","","Musannaf Ibn Abi Shaybah 33243","","","كتاب الجهاد"
"33244","(۳۳۲۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ نَافِعٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ خِصَائِ الْخَیْلِ وَالْبَہَائِمِ ، وَقَالَ ابْنُ عُمَرَ فِیہِ نَمَائُ الْخَلْقِ۔ (احمد ۲۴)","Da'if","Musannaf Ibn Abi Shaybah 33244","","","كتاب الجهاد"
"33245","(۳۳۲۴۵) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ أَنَّ عُمَرَ کَتَبَ یَنْہَی عَنْ خِصَائِ الْخَیْلِ۔","","Musannaf Ibn Abi Shaybah 33245","","","كتاب الجهاد"
"33246","(۳۳۲۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ الْبَجَلِیِّ ، قَالَ : کَتَبَ عُمَرُ أَنْ لاَ یُخْصَی فَرَسٌ ، وَلاَ یَجْرِی من أَکْثَرَ مِنْ مِئَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 33246","","","كتاب الجهاد"
"33247","(۳۳۲۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی أَہْلِ مِصْرَ یَنْہَاہُمْ عَنْ خِصَائِ الْخَیْلِ ، وَأَنْ یُجْرِی الصِّبْیَانُ الْخَیْلَ۔","","Musannaf Ibn Abi Shaybah 33247","","","كتاب الجهاد"
"33248","(۳۳۲۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ : {وَلآمُرَنَّہُمْ فَلَیُغَیِّرُنَّ خَلْقَ اللہِ} قَالَ : الْخِصَائُ۔","Hasan","Musannaf Ibn Abi Shaybah 33248","","","كتاب الجهاد"
"33249","(۳۳۲۴۹) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی صَالِحٍ ، قَالَ : الْخِصَائُ۔","","Musannaf Ibn Abi Shaybah 33249","","","كتاب الجهاد"
"33250","(۳۳۲۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو مَکِین ، عَنْ عِکْرِمَۃَ أَنَّہُ کَرِہَ خِصَائَ الدَّوَابِّ۔","","Musannaf Ibn Abi Shaybah 33250","","","كتاب الجهاد"
"33251","(۳۳۲۵۱) حَدَّثَنَا حَفْصُ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ وَطَاوُسٍ ، وَمُجَاہِدٍ ، وَالْحَسَنِ ، وَشَہْرٍ أَنَّہُمْ کَرِہُوا الْخِصَائَ۔","","Musannaf Ibn Abi Shaybah 33251","","","كتاب الجهاد"
"33252","(۳۳۲۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ أَنَّ عُمَرَ نَہَی عَنِ الْخِصَائِ ، وَقَالَ : النَّمَائُ مَعَ الذَّکَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 33252","","","كتاب الجهاد"
"33253","(۳۳۲۵۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ وَابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : خِصَائُ الْبَہَائِمِ مُثْلَۃٌ ، ثُمَّ تَلاَ : {وَلآمُرَنَّہُمْ فَلَیُغَیِّرُنَّ خَلْقَ اللہِ}۔","Da'if","Musannaf Ibn Abi Shaybah 33253","","","كتاب الجهاد"
"33254","(۳۳۲۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ہِشَامٌ أَنَّ أَبَاہُ خَصَی بَغْلاً لَہُ۔","","Musannaf Ibn Abi Shaybah 33254","","","كتاب الجهاد"
"33255","(۳۳۲۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، قَالَ : سَأَلْتُ عَطَائً ، عَنْ خِصَائِ الْخَیْلِ ، قَالَ : مَا خِیفَ عَضَاضُہُ وَسُوئُ خُلُقِہِ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 33255","","","كتاب الجهاد"
"33256","(۳۳۲۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیرٍ الْمَدَائِنِیِّ ، عَنِ الْحَسَنِ ، قَالَ : لا[corrupt] بَأْسَ بِخِصَائِ الدَّوَابِّ۔","","Musannaf Ibn Abi Shaybah 33256","","","كتاب الجهاد"
"33257","(۳۳۲۵۷) حدَّثَنَا بَعْضُ الْبَصْرِیِّینَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِخِصَائِ الْخَیْلِ ، لَوْ تَرَکْت الْفُحُولَ لأَکَلَ بَعْضُہَا بَعْضًا۔","","Musannaf Ibn Abi Shaybah 33257","","","كتاب الجهاد"
"33258","(۳۳۲۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ سَالِمٍ ، عَنْ أَبِی الْجَرَّاحِ ، عَنْ أُمِّ حَبِیبَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تَصْحَبُ الْمَلاَئِکَۃُ رُفْقَۃً فِیہَا جَرَسٌ۔n(احمد ۳۲۶۔ دارمی ۲۶۷۵)","Da'if","Musannaf Ibn Abi Shaybah 33258","","","كتاب الجهاد"
"33259","(۳۳۲۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَصْحَبُ الْمَلاَئِکَۃُ رُفْقَۃً فِیہَا جَرَسٌ ، وَلاَ کَلْبٌ۔n(احمد ۲۶۲۔ مسلم ۱۶۷۲)","Hasan","Musannaf Ibn Abi Shaybah 33259","","","كتاب الجهاد"
"33260","(۳۳۲۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ ثَابِتٍ مَوْلَی أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : الْمَلاَئِکَۃُ لاَ تَصْحَبُ رُفْقَۃً فِیہَا جُلْجُلٌ۔ (طبرانی ۲۳)","Da'if","Musannaf Ibn Abi Shaybah 33260","","","كتاب الجهاد"
"33261","(۳۳۲۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، قَالَ : کَانَتْ عَائِشَۃُ تَکْرَہُ صَوْتَ الْجَرَسِ۔","Sahih","Musannaf Ibn Abi Shaybah 33261","","","كتاب الجهاد"
"33262","(۳۳۲۶۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَتَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی بِتِبْرٍ ، فَقَالَ: ہَلْ عَسَیْت أَنْ تَجْعَلَہَا أَجْرَاسًا فَإِنَّہَا تُکْرَہُ۔","","Musannaf Ibn Abi Shaybah 33262","","","كتاب الجهاد"
"33263","(۳۳۲۶۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : لِکُلِّ جَرَسٍ تَبَعٌ مِنَ الْجِنِّ۔","","Musannaf Ibn Abi Shaybah 33263","","","كتاب الجهاد"
"33264","(۳۳۲۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : الْمَلاَئِکَۃُ لاَ تَصْحَبُ رُفْقَۃً فِیہَا جَرَسٌ۔","Sahih","Musannaf Ibn Abi Shaybah 33264","","","كتاب الجهاد"
"33265","(۳۳۲۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ عَامِرٍ الأَسْلَمِیُّ ، قَالَ : سَمِعْتُ مَکْحُولاً یَقُولُ : إنَّ الْمَلاَئِکَۃَ تَمْسَحُ دَوَابَّ الْغُزَاۃِ إِلاَّ دَابَّۃً عَلَیْہَا جَرَسٌ۔","","Musannaf Ibn Abi Shaybah 33265","","","كتاب الجهاد"
"33266","(۳۳۲۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : مَرُّوا عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَاقَۃٍ فِی عُنُقِہَا جَرَسٌ ، قَالَ : ہَذِہِ مَطِیَّۃُ شَیْطَانٍ۔","","Musannaf Ibn Abi Shaybah 33266","","","كتاب الجهاد"
"33267","(۳۳۲۶۷) حَدَّثَنَا رَیْحَانُ بْنُ سَعِیدٍ ، عَنْ مَرْزُوقِ بْنِ عَمْرٍو ، قَالَ : قَالَ أَبُو فَرْقَدٍ : رَأَیْت عَلَی تَجَافِیفِ أَبِی مُوسَی الدیباج والْحَرِیرَ۔","Da'if","Musannaf Ibn Abi Shaybah 33267","","","كتاب الجهاد"
"33268","(۳۳۲۶۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی لَہُ یَلْمَقُ مِنْ دِیبَاجٍ یَلْبَسُہُ فِی الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 33268","","","كتاب الجهاد"
"33269","(۳۳۲۶۹) حَدَّثَنَا حَفْصُ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ إذَا کَانَ جُبَّۃً ، أَوْ سِلاَحًا۔","","Musannaf Ibn Abi Shaybah 33269","","","كتاب الجهاد"
"33270","(۳۳۲۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِلُبْسِ الْحَرِیرِ فِی الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 33270","","","كتاب الجهاد"
"33271","(۳۳۲۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمُنْذِرُ بْنُ ثَعْلَبَۃَ الْعَبْدِیُّ ، عَنْ عِلْبَائَ بْنِ أَحْمَرَ الْیَشْکرِیِّ ، أَوِ ابْنِ بُرَیْدَۃَ شَکَّ الْمُنْذِرُ ، قَالَ : قَالَ نَاسٌ مِنَ الْمُہَاجِرِینَ لِعُمَرَ : إذَا رَأَیْنَا الْعَدُوَّ وَرَأَیْنَاہُمْ قَدْ کَفَّرُوا سِلاَحَہُمْ بِالْحَرِیرِ فَرَأَیْنَا لِذَلِکَ ہَیْبَۃً ، فَقَالَ عُمَرُ : أَنْتُمْ إِنْ شِئْتُمْ فَکَفِّرُوا عَلَی سِلاَحِکُمْ بِالْحَرِیرِ وَالدِّیبَاجِ۔","","Musannaf Ibn Abi Shaybah 33271","","","كتاب الجهاد"
"33272","(۳۳۲۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا ، عَنْ لُبْسِ الدِّیبَاجِ فِی الْحَرْبِ ، فَقَالَ : مِنْ أَیْنَ کَانُوا یَجِدُونَ الدِّیبَاجَ۔","","Musannaf Ibn Abi Shaybah 33272","","","كتاب الجهاد"
"33273","(۳۳۲۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو مَکِینِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَرِہَ لُبْسَ الْحَرِیرِ وَالدِّیبَاجِ فِی الْحَرْبِ ، وَقَالَ : أَرْجَی مَا یَکُونُ لِلشَّہَادَۃِ یَلْبَسُہُ۔","","Musannaf Ibn Abi Shaybah 33273","","","كتاب الجهاد"
"33274","(۳۳۲۷۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ یُونُسَ بْنِ عُبَیْدٍ، عَنِ الْحَسَنِ أَنَّہُ کَرِہَ لُبْسَ الْحَرِیرِ فِی الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 33274","","","كتاب الجهاد"
"33275","(۳۳۲۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الْوَلِیدِ بْنِ ہِشَامٍ ، قَالَ : کَتَبْتُ إلَی ابْنِ مُحَیْرِیزٍ أَسْأَلُہُ عَنْ لُبْسِ الْحَرِیرِ وَالْیَلاَمِقِ فِی دَارِ الْحَرْبِ ؟ قَالَ : فَکَتَبَ : أَنْ کُنْ أَشَدَّ مَا کُنْتَ کَرَاہَۃً لِمَا یُکْرَہُ عِنْدَ الْقِتَالِ حِینَ تَعْرِضُ نَفْسُک لِلشَّہَادَۃِ۔","","Musannaf Ibn Abi Shaybah 33275","","","كتاب الجهاد"
"33276","(۳۳۲۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو الأَوْزَاعِیِّ ، عَنِ الْوَلِیدِ بْنِ ہِشَامٍ ، عَنِ ابْنِ مُحَیْرِیزٍ أَنَّہُ کَرِہَ لُبْسَہُ فِی الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 33276","","","كتاب الجهاد"
"33277","(۳۳۲۷۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : شَہِدْنَا الْیَرْمُوکَ ، قَالَ : فَاسْتَقْبَلَنَا عُمَرُ وَعَلَیْنَا الدِّیبَاجُ والحریر ، فَأَمَرَ فَرُمِینَا بِالْحِجَارَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 33277","","","كتاب الجهاد"
"33278","(۳۳۲۷۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ أبی الأَشْہَبِ ، قَالَ : قلْت لِلْحَسَنِ : یَا أَبَا سَعِیدٍ : الرَّجُلُ یَکُونُ عَارِیًّا یَلْبَسُ الثَّوْبَ ، أَوْ یَکُونُ أَعْزَلَ یَلْبَسُ مِنَ السِّلاَحِ ، قَالَ : یَفْعَلُ ، فَإِذَا حَضَرَ الْقَسْمُ فَلْیُحْضِرْہُ۔","","Musannaf Ibn Abi Shaybah 33278","","","كتاب الجهاد"
"33279","(۳۳۲۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ سَمِعْت سُفْیَانَ یَقُولُ : إذَا أَصَابَ الْمُسْلِمُونَ السِّلاَحَ وَالدَّوَابَّ فَأَرَادُوا أَنْ یَسْتَعِینُوا بِہِ وَاحْتَاجُوا فَلاَ بَأْسَ بِہِ وَلو لَمْ یَسْتَأْذِنُوا الإِمَامَ۔","","Musannaf Ibn Abi Shaybah 33279","","","كتاب الجهاد"
"33280","(۳۳۲۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُبَیٌّ وَإِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : انْتَہَیْت إلَی أَبِی جَہْلٍ یَوْمَ بَدْرٍ وَقَدْ ضُرِبَتْ رِجْلُہُ وَہُوَ صَرِیعٌ وَہُوَ یَذُبُّ النَّاسَ عَنْہُ بِسَیْفِہِ ، فَقُلْتُ : الْحَمْدُ لِلَّہِ الَّذِی أَخْزَاک یَا عَدُوَّ اللہِ ، فَقَالَ : ہَلْ ہُوَ إِلاَّ رَجُلٌ قَتَلَہُ قَوْمُہُ ، فَجَعَلْتُ أَتَنَاوَلُہُ بِسَیْفٍ لِی غَیْرِ طَائِلٍ ، فَأصبت یَدہُ فَنَدَرَ سَیْفُہُ فَأَخَذْتہ فَضَرَبْتہ بِہِ حَتَّی بَرَدَ۔","","Musannaf Ibn Abi Shaybah 33280","","","كتاب الجهاد"
"33281","(۳۳۲۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، عَنْ عَلِیٍّ ، قَالَ : لَقَدْ رَأَیْتُنَا یَوْمَ بَدْرٍ وَنَحْنُ نَلُوذُ بِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ أَقْرَبُنَا إلَی الْعَدُوِّ ، وَکَانَ مِنْ أَشَدِّ النَّاسِ یَوْمَئِذٍ بَأْسًا۔ (احمد ۱۲۶۔ ابویعلی ۲۹۷)","Sahih","Musannaf Ibn Abi Shaybah 33281","","","كتاب الجهاد"
"33282","(۳۳۲۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : کُنَّا إذَا احْمَرَّ الْبَأْسُ نَتَّقِی بِہِ ، وَإِنَّ الشُّجَاعَ لَلَّذِی یُحَاذِی بِہِ۔ (مسلم ۱۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 33282","","","كتاب الجهاد"
"33283","(۳۳۲۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَسَّانِ بْنِ فَائِدٍ الْعَبْسِیِّ ، قَالَ : قَالَ عُمَرُ : الشَّجَاعَۃُ وَالْجُبْنُ غَرَائِزُ فِی الرِّجَالِ ، فَیُقَاتِلُ الشُّجَاعُ عَمَّنْ یَعْرِفُ وَمَنْ لاَ یَعْرِفُ ، وَیَفِرُّ الْجَبَانُ ، عَنْ أَبِیہِ وَأُمِّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33283","","","كتاب الجهاد"
"33284","(۳۳۲۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ وَمِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ قَبِیصَۃَ بْنِ جَابِرٍ ، قَالَ : قَالَ عُمَرُ : الشَّجَاعَۃُ وَالْجُبْنُ شِیمَۃٌ ، أَوْ خُلُقٌ فِی الرِّجَالِ فَیُقَاتِلُ الشُّجَاعُ عَمَّنْ لاَ یُبَالِی أَنْ لاَ یَؤوبَ إلَی أَہْلِہِ وَیَفِرُّ الْجَبَانُ ، عَنِ ابن أَبِیہِ وَأُمِّہِ۔","Sahih","Musannaf Ibn Abi Shaybah 33284","","","كتاب الجهاد"
"33285","(۳۳۲۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَشْعَثُ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشْجَعَ النَّاسِ وَأَسْخَی النَّاسِ۔ (بخاری ۲۸۲۰۔ مسلم ۴۸)","","Musannaf Ibn Abi Shaybah 33285","","","كتاب الجهاد"
"33286","(۳۳۲۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَدِیدَ الْبَطْشِ۔ (ابن سعد ۴۱۹)","Da'if","Musannaf Ibn Abi Shaybah 33286","","","كتاب الجهاد"
"33287","(۳۳۲۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : سَمِعْتُ خَالِدَ بْنَ الْوَلِیدِ یَقُولُ : لَقَدِ انْقَطَعَ فِی یَدِی یَوْمَ مُؤْتَۃَ تِسْعَۃُ أَسْیَافٍ وَصَبَرَتْ صَفِیحَۃٌ یَمَانِیَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 33287","","","كتاب الجهاد"
"33288","(۳۳۲۸۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہَاشِمِ بن ہَاشِمِ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : کَانَ سَعْدُ بْنُ مَالِکٍ أَشَدَّ الْمُسْلِمِینَ بَأْسًا یَوْمَ أُحُدٍ۔","","Musannaf Ibn Abi Shaybah 33288","","","كتاب الجهاد"
"33289","(۳۳۲۸۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ جَلَبَ ، وَلاَ جَنَبَ۔","Hasan","Musannaf Ibn Abi Shaybah 33289","","","كتاب الجهاد"
"33290","(۳۳۲۹۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ بِمِثْلِہِ وَلَمْ یَرْفَعْہُ۔","","Musannaf Ibn Abi Shaybah 33290","","","كتاب الجهاد"
"33291","(۳۳۲۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَعْقِلُ بْنُ عُبَیْدِ اللہِ الْعَبْسِیُّ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ جَلَبَ ، وَلاَ جَنَبَ فِی الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 33291","","","كتاب الجهاد"
"33292","(۳۳۲۹۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ جَلَبَ ، وَلاَ جَنَبَ۔ (ابوداؤد ۱۵۸۷۔ احمد ۱۸۰)","Hasan","Musannaf Ibn Abi Shaybah 33292","","","كتاب الجهاد"
"33293","(۳۳۲۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہمام ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلْجَبَانِ أَجْرَانِ۔","","Musannaf Ibn Abi Shaybah 33293","","","كتاب الجهاد"
"33294","(۳۳۲۹۴) حَدَّثَنَا مُحَمَّدُ ، عَنِ ابْنِ جُرَیْجٍ عَنْ عَبْدِ الْکَرِیمِ قَالَ : قَالَتْ عَائِشَۃَ : إذَا أَحَسَّ أَحَدُکُمْ مِنْ نَفْسِہِ جُبْنًا ؛ فَلاَ یَغْزُوَنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 33294","","","كتاب الجهاد"
"33295","(۳۳۲۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنْ أَبِی بَکْرٍ ، عَنِ الْفُضَیْلِ بْنِ فَضَالَۃَ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : لاَ نَامَتْ عُیُونُ الْجُبَنَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 33295","","","كتاب الجهاد"
"33296","(۳۳۲۹۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَبْیِ الْجَاہِلِیَّۃِ فِی الْغُلاَمِ ثَمَانِیًا مِنَ الإِبِلِ ، وَفِی الْمَرْأَۃِ عَشْرًا مِنَ الإِبِلِ ، أَوْ غُرَّۃَ عَبْدٍ ، أَوْ أَمَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33296","","","كتاب الجهاد"
"33297","(۳۳۲۹۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ : لَیْسَ عَلَی عَرَبِیٍّ مِلْک ، وَلَسْنَا بِنَازِعِی مِنْ أَحَدٍ شیئا أَسْلَمَ عَلَیْہِ ، وَلَکِنَّا نُقَوِّمُہُمْ للملۃ : خَمْسٌ مِنَ الإِبِلِ خَمْسٌ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 33297","","","كتاب الجهاد"
"33298","(۳۳۲۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ صَدَقَۃَ ، عَنْ رَبَاحِ بْنِ الْحَارِثِ ، قَالَ : کَانَ عُمَرُ یَقْضِی فِیمَا سَبَتِ الْعَرَبُ بَعْضُہَا علی بَعْضٍ قَبْلَ الإِسْلاَمِ وَقَبْلَ أَنْ یُبْعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ مَنْ عَرَفَ أَحَدًا مِنْ أَہْلِ بَیْتِہِ مَمْلُوکًا مِنْ حَیٍّ مِنْ أَحْیَائِ الْعَرَبِ فَفِدَاہُ الْعَبْدِ بِالْعَبْدَیْنِ وَالأَمَۃِ بِالأَمَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 33298","","","كتاب الجهاد"
"33299","(۳۳۲۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : لَمَّا غَزَا سَلْمَانُ الْمُشْرِکِینَ مِنْ أَہْلِ فَارِسَ ، قَالَ : کُفُّوا حَتَّی أَدْعُوَہُمْ کَمَا کُنْتُ أَسْمَعُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُوہُمْ ، فَأَتَاہُمْ ، فَقَالَ : إنِّی رَجُلٌ مِنْکُمْ وقَدْ تَدْرُونَ مَنْزِلِی مِنْ ہَؤُلاَئِ الْقَوْمِ ، وَإِنَّا نَدْعُوکُمْ إلَی الإِسْلاَمِ، فَإِنْ أَسْلَمْتُمْ فَلَکُمْ مِثْلُ مَا لَنَا ، وَعَلَیْکُمْ مِثْلُ الَّذِی عَلَیْنَا ، وَإِنْ أَبَیْتُمْ فَأَعْطُوا الْجِزْیَۃَ عَنْ یَدٍ وَأَنْتُمْ صَاغِرُونَ ، وَإِنْ أَبَیْتُمْ قَاتَلْنَاکُمْ فَأَبَوْا عَلَیْہِ ، فَقَالَ لِلنَّاسِ : انْہَدُوا إلَیْہِمْ۔ (احمد ۴۴۰)","Da'if","Musannaf Ibn Abi Shaybah 33299","","","كتاب الجهاد"
"33300","(۳۳۳۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا بَعَثَ أَمِیرًا عَلَی سَرِیَّۃٍ ، أَوْ جَیْشٍ أَوْصَاہُ فَقَالَ : إذَا لَقِیتَ عَدُوَّک مِنَ الْمُشْرِکِینَ فَادْعُہُمْ إلَی إحْدَی ثَلاَثِ خِصَالٍ ، أَوْ خِلاَلٍ ، فَأَیَّتُہُنَّ مَا أَجَابُوک إلَیْہَا فَاقْبَلْ مِنْہُمْ وَکُفَّ عَنْہُمْ: ادْعُہُمْ إلَی الإِسْلاَمِ فَإِنْ أَجَابُوک فَکُفَّ عَنْہُمْ وَاقْبَلْ مِنْہُمْ ، ثُمَّ ادْعُہُمْ إلَی التَّحَوُّلِ مِنْ دَارِہِمْ إلَی دَارِ الْمُہَاجِرِینَ ، وَأَعْلِمْہُمْ أَنَّہُمْ إِنْ فَعَلُوا ذَلِکَ أَنَّ لَہُمْ مَا لِلْمُہَاجِرِینَ ، وَأَنَّ عَلَیْہِمْ مَا عَلَی الْمُہَاجِرِینَ ، وَإِنْ أَبَوْا وَاخْتَارُوا دَارَہُمْ فَأَعْلِمْہُمْ أَنَّہُمْ یَکُونُونَ کَأَعْرَابِ الْمُسْلِمِینَ یَجْرِی عَلَیْہِمْ حُکْمُ اللہِ الَّذِی یَجْرِی عَلَی الْمُؤْمِنِینَ ، وَلاَ یَکُونُ لَہُمْ فِی الْفَیْئِ وَالْغَنِیمَۃِ نَصِیبٌ إِلاَّ أَنْ یُجَاہِدُوا مَعَ الْمُسْلِمِینَ ، فَإِنْ أَبَوْا فَادْعُہُمْ إلَی إعْطَائِ الْجِزْیَۃِ ، فَإِنْ أَجَابُوا فَاقْبَلْ مِنْہُمْ وَکُفَّ عَنْہُمْ ، وَإِنْ أَبَوْا فَاسْتَعِنْ بِاللہِ وَقَاتِلْہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33300","","","كتاب الجهاد"
"33301","(۳۳۳۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : قَاتَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَہْلَ ہَذِہِ الْجَزِیرَۃِ مِنَ الْعَرَبِ عَلَی الإِسْلاَمِ وَلَمْ یَقْبَلْ مِنْہُمْ غَیْرَہُ ، وَکَانَ أَفْضَلَ الْجِہَاد ، وَکَانَ بَعْدَہُ جِہَادٌ آخَرُ عَلَی ہَذِہِ الطُّغْمَۃِ فِی أَہْلِ الْکِتَابِ : {قَاتِلُوا الَّذِینَ لاَ یُؤْمِنُونَ بِاللہِ وَلاَ بِالْیَوْمِ الآخِرِ} إلَی آخِرِ الآیَۃِ ، قَالَ الْحَسَنُ : مَا سِوَاہُمَا بِدْعَۃٌ وَضَلاَلَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 33301","","","كتاب الجهاد"
"33302","(۳۳۳۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أَہْلِ الْیَمَنِ : مَنْ صَلَّی صَلاَتَنَا وَاسْتَقْبَلَ قِبْلَتَنَا وَأَکَلَ ذَبِیحَتَنَا فَذَلِکُمَ الْمُسْلِمُ ، لَہُ ذِمَّۃُ اللہِ وَذِمَّۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَمَنْ أَبَی فَعَلَیْہِ الْجِزْیَۃُ۔ (بخاری ۳۹۱)","Hasan","Musannaf Ibn Abi Shaybah 33302","","","كتاب الجهاد"
"33303","(۳۳۳۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ وَإِبْرَاہِیمَ ، قَالاَ : بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا إلَی الْیَمَنِ وَأَمَرَہُ أَنْ یَأْخُذَ الْجِزْیَۃَ مِنْ کُلِّ حَالِمٍ دِینَارًا ، أَوْ عِدْلَہُ مَعَافِرَ۔","","Musannaf Ibn Abi Shaybah 33303","","","كتاب الجهاد"
"33304","(۳۳۳۰۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ ، قَالَ : کَتَبَ عُمَرُ إلَی أُمَرَائِ الْجِزْیَۃِ : لاَ تَضَعُوا الْجِزْیَۃَ إِلاَّ عَلَی مَنْ جَرَتْ عَلَیْہِ الْمُوسَی ، وَلاَ تَضَعُوا الْجِزْیَۃَ عَلَی النِّسَائِ ، وَلاَ عَلَی الصِّبْیَانِ ، قَالَ : وَکَانَ عُمَرُ یَخْتِمُ أَہْلَ الْجِزْیَۃِ فِی أَعْنَاقِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33304","","","كتاب الجهاد"
"33305","(۳۳۳۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یُقَاتَلُ أَہْلُ الأَدْیَانِ عَلَی الإِسْلاَمِ وَیُقَاتَلُ أَہْلُ الْکِتَابِ عَلَی الْجِزْیَۃِ۔","","Musannaf Ibn Abi Shaybah 33305","","","كتاب الجهاد"
"33306","(۳۳۳۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، قَالَ : لَمَّا بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا إلَی الْیَمَنِ أَمَرَہُ أَنْ یَأْخُذَ مِنْ کُلِّ حَالِمٍ دِینَارًا ، أَوْ عَدْلَہُ مَعَافِرَ۔ (ابوداؤد۳۰۳۳)","","Musannaf Ibn Abi Shaybah 33306","","","كتاب الجهاد"
"33307","(۳۳۳۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ أَنَّ عُمَرَ جَعَلَ عَلَی کُلِّ رَأْسٍ فِی السَّنَۃِ أَرْبَعًا وَعِشْرِینَ ، وَعَطَّلَ النِّسَائَ وَالصِّبْیَانَ۔","","Musannaf Ibn Abi Shaybah 33307","","","كتاب الجهاد"
"33308","(۳۳۳۰۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ أَنَّ عُمَرَ کَتَبَ إلَی عُمَّالِہِ : لاَ تَضْرِبُوا الْجِزْیَۃَ عَلَی النِّسَائِ وَالصِّبْیَانِ ، وَلاَ تَضْرِبُوہَا إِلاَّ عَلَی مَنْ جَرَتْ عَلَیْہِ الْمُوسَی ، وَیَخْتِمُ فِی أَعْنَاقِہِمْ ، وَجَعَلَ جِزْیَتَہُمْ عَلَی رُؤُوسِہِمْ : عَلَی أَہْلِ الْوَرِقِ أَرْبَعِینَ دِرْہَمًا ، وَمَعَ ذَلِکَ أَرْزَاقُ الْمُسْلِمِینَ ، وَعَلَی أَہْلِ الذَّہَبِ أَرْبَعَۃُ دَنَانِیرَ ، وَعَلَی أَہْلِ الشَّامِ مِنْہُمْ مُدَّیْ حِنْطَۃٍ وَثَلاَثَۃُ أَقْسَاطِ زَیْتٍ وَعَلَی أَہْلِ مِصْرَ إرْدَبُّ حِنْطَۃٍ وَکِسْوَۃٌ وَعَسَلٌ لاَ یَحْفَظُ نَافِعٌ کَمْ ذَلِکَ وَعَلَی أَہْلِ الْعِرَاقِ خَمْسَۃَ عَشَرَ صَاعًا حِنْطَۃً ، قَالَ : قَالَ عُبَیْدُ اللہِ : وَذَکَرَ کِسْوَۃً لاَ أَحْفَظُہَا۔ (بیہقی ۱۹۵)","Sahih","Musannaf Ibn Abi Shaybah 33308","","","كتاب الجهاد"
"33309","(۳۳۳۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ أَنَّ إبْرَاہِیمَ بْنِ سَعْدٍ سَأَلَ ابْنَ عَبَّاسٍ : مَا یُؤْخَذُ مِنْ أَمْوَالِ أَہْلِ الذِّمَّۃِ ، قَالَ : الْعَفْوُ۔","Sahih","Musannaf Ibn Abi Shaybah 33309","","","كتاب الجهاد"
"33310","(۳۳۳۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ بْنُ سِنَانٍ أَبُو سِنَانٍ ، عَنْ عَنْتَرَۃَ أَبِی وَکِیعٍ أَنَّ عَلِیًّا کَانَ یَأْخُذُ الْعُرُوضَ فِی الْجِزْیَۃِ ، مِنْ أَہْلِ الإِبَرِ الإِبَرَ ، وَمِنْ أَہْلِ الْمَسَالِّ الْمَسَالَّ وَمِنْ أَہْلِ الْحِبَالِ الْحِبَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 33310","","","كتاب الجهاد"
"33311","(۳۳۳۱۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : وَضَعَ عُمَرُ بْنُ الْخَطَّابِ یعنی فِی الْجِزْیَۃِ عَلَی رُؤُوسِ الرِّجَالِ : عَلَی الْغَنِیِّ ثَمَانِیَۃً وَأَرْبَعِینَ ، دِرْہَمًا وَعَلَی الْوَسَطِ أَرْبَعَۃً وَعِشْرِینَ ، وَعَلَی الْفَقِیرِ اثْنَیْ عَشَرَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 33311","","","كتاب الجهاد"
"33312","(۳۳۳۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ مَعْقِلٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : لاَ یُؤْخَذُ مِنْ أَہْلِ الْکِتَابِ إِلاَّ صلب الْجِزْیَۃِ ، وَلاَ یُؤْخَذُ مِنْ فَارٍّ ، وَلاَ مِنْ مَیِّتٍ ، وَلاَ یُؤْخَذُ أَہْلُ الأَرْضِ بِالْفَارِّ۔","","Musannaf Ibn Abi Shaybah 33312","","","كتاب الجهاد"
"33313","(۳۳۳۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی مَجُوسِ ہَجَرَ یَعْرِضُ عَلَیْہِمَ الإِسْلاَمَ فَمَنْ أَسْلَمَ قَبِلَ مِنْہُ وَمَنْ أَبَی ضُرِبَتْ عَلَیْہِ الْجِزْیَۃُ عَلَی أَنْ لاَ تُؤْکَلَ لَہُمْ ذَبِیحَۃٌ ، وَلاَ تُنْکَحَ لَہُمُ امْرَأَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 33313","","","كتاب الجهاد"
"33314","(۳۳۳۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خُصَیْفٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَذَ الْجِزْیَۃَ مِنْ مَجُوسِ الْبَحْرَیْنِ۔ (ابن زنجویہ ۱۲۵)","Da'if","Musannaf Ibn Abi Shaybah 33314","","","كتاب الجهاد"
"33315","(۳۳۳۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ أَنَسٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَذَ الْجِزْیَۃَ مِنْ مَجُوسِ الْبَحْرَیْنِ ، وَأَخَذَہَا عُمَرُ مِنْ مَجُوسِ أَہْلِ فَارِسَ ، وَأَخَذَہَا عُثْمَان مِنْ مَجُوسِ بَرْبَرَ۔n(مالک ۲۷۸۔ بیہقی ۱۹۵)","","Musannaf Ibn Abi Shaybah 33315","","","كتاب الجهاد"
"33316","(۳۳۳۱۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ بَجَالَۃَ ، قَالَ : لَمْ یَکُنْ عُمَرُ یَأْخُذُ الْجِزْیَۃَ مِنَ الْمَجُوسِ حَتَّی شَہِدَ عَبْدُ الرَّحْمَن بْنُ عَوْفٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَذَہَا مِنْ مَجُوسِ ہَجَرَ۔n(بخاری ۳۱۵۷۔ ابوداؤد ۳۰۳۸)","Sahih","Musannaf Ibn Abi Shaybah 33316","","","كتاب الجهاد"
"33317","(۳۳۳۱۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْجِزْیَۃَ مِنْ مَجُوسِ أَہْلِ ہَجَرَ وَمِنْ یَہُودِ الْیَمَنِ وَنَصَارَاہُمْ مِنْ کُلِّ حَالِمٍ دِینَارًا ، وَأَخَذَ عُمَرُ الْجِزْیَۃَ مِنْ مَجُوسِ السَّوَادِ ، وَأَخَذَ عُثْمَان مِنْ مَجُوسِ مِصْرَ الْبَرْبَرِ الْجِزْیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 33317","","","كتاب الجهاد"
"33318","(۳۳۳۱۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ سَأَلَ عَنْ جِزْیَۃِ الْمَجُوسِ ، فَقَالَ عَبْدُ الرَّحْمَن بْنُ عَوْفٍ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سُنُّوا بِہِمْ سُنَّۃَ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 33318","","","كتاب الجهاد"
"33319","(۳۳۳۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ وَمَالِکُ بْنُ أَنَسٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ اسْتَشَارَ النَّاسَ فِی الْمَجُوسِ فِی الْجِزْیَۃِ ، فَقَالَ عَبْدُ الرَّحْمَن بْنُ عَوْفٍ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سُنُّوا بِہِمْ سُنَّۃَ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 33319","","","كتاب الجهاد"
"33320","(۳۳۳۲۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ أَنَّہُ سَمِعَ بَجَالَۃَ یُحَدِّثُ عَمْرَو بْنَ أَوْسٍ وَأَبَا الشَّعْثَائِ ، قَالَ : کُنْتُ کَاتِبًا لِجَزْئِ بْنِ مُعَاوِیَۃَ : فَأَتَانَا کِتَابُ عُمَرَ أَنِ اقْتُلُوا کُلَّ سَاحِرٍ وَسَاحِرَۃٍ ، وَفَرِّقُوا بَیْنَ کُلِّ ذِی مَحْرَمٍ مِنَ الْمَجُوسِ ، وَانْہَوْہُمْ ، عَنِ الزَّمْزَمَۃِ فَقَتَلْنَا ثَلاَثَ سَوَاحِرَ ، وَجَعَلْنَا نُفَرِّقُ بَیْنَ الْمَرْئِ وَبَیْنَ حَرِیمِہِ فِی کِتَابِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 33320","","","كتاب الجهاد"
"33321","(۳۳۳۲۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ قُشَیْرِ بْنِ عَمْرٍو ، عَنْ بَجَالَۃَ بْنِ عَبْدَۃَ الْعَنْبَرِی ، وَکَانَ کَاتِبًا لجَزْئِ بْنِ مُعَاوِیَۃَ وَکَانَ عَلَی طَائِفَۃِ الأَہْوَازِ فَحَدَّثَ أَنَّ أَبَا مُوسَی وَہُوَ أَمِیرُ الْبَصْرَۃِ کَتَبَ إلَیْنَا أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَتَبَ إلَیْہِ یَأْمُرُہُ بِقَتْلِ الزَّمَازِمَۃِ حَتَّی یَتَکَلَّمُوا ، وَأَنْ تُنْزَعَ کُلُّ امْرَأَۃٍ مِنْ حَرِیمِہَا ، وَأَنْ یُقْتَلَ کُلُّ سَاحِرٍ ، فَکَتَبَ بِہَذَا أَبُو مُوسَی إلَی جَزْئِ بْنِ مُعَاوِیَۃَ ، فَدَعَا الزَّمَازِمَۃَ فَتَکَلَّمُوا ، قَالَ : وَکُنَّا إذَا کَانَتِ الْمَرْأَۃُ شَابَّۃً نَزَعَنَاہَا مِنْ حَرِیمِہَا وَأَنْکَحْنَاہَا آخَرَ ، وَإِذَا کَانَتْ عَجُوزًا نَہَیْنَا عنہا وَزَجَرْنَا عنہا۔","Da'if","Musannaf Ibn Abi Shaybah 33321","","","كتاب الجهاد"
"33322","(۳۳۳۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفَ قَالَ : حدَّثَنِی عَبَّادٌ ، عَنْ بَجَالَۃَ بْنِ عَبْدَۃَ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی أَنَ اعْرِضُوا عَلَی مَنْ قِبَلَکُمْ مِنَ الْمَجُوسِ أَنْ یَدَعُوا نِکَاحَ أُمَّہَاتِہِمْ وَبَنَاتِہِمْ وَأَخَوَاتِہِمْ وَیَأْکُلُوا جَمِیعًا کیما یَلْحَقُوا بِأَہْلِ الْکِتَابِ وَاقْتُلُوا کُلَّ سَاحِرٍ وَکَاہِنٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33322","","","كتاب الجهاد"
"33323","(۳۳۳۲۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، قَالَ : سَأَلْتُ مُرَّۃَ عَنِ الرَّجُلِ یَشْتَرِی ، أَوْ یَسْبِی الْمَجُوسِیَّۃَ ، ثُمَّ یَقَعُ عَلَیْہَا قَبْلَ أَنْ تُعَلَّمَ الإِسْلاَمَ ؟ قَالَ : لاَ یَصْلُحُ ، قَالَ : وَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : مَا ہُوَ بِخَیْرٍ مِنْہَا إذَا فَعَلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33323","","","كتاب الجهاد"
"33324","(۳۳۳۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، قَالَ : سَأَلْتُ مُرَّۃَ بْنِ شَرَاحِیلَ الْہَمْدَانِیَّ وَسَعِیدَ بْنَ جُبَیْرٍ ، عَنِ الأَمَۃِ الْمَجُوسِیَّۃِ یُصِیبُہَا الرَّجُلُ ، أَیَطَؤُہَا ؟ قَالَ : لاَ یُجَامِعُہَا حَتَّی تُسْلِمَ ، وَقَالَ سَعِیدُ بْنُ جُبَیْرٍ ، إِنْ عَادَ إلَیْہَا فَہُوَ شَرٌّ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 33324","","","كتاب الجهاد"
"33325","(۳۳۳۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ بُرْدٍ، عَنْ مَکْحُولٍ، قَالَ: إذَا کَانَتْ وَلِیدَۃً مَجُوسِیَّۃً فَإِنَّہُ لاَ یَنْکِحُہَا حَتَّی تُسْلِمَ۔","","Musannaf Ibn Abi Shaybah 33325","","","كتاب الجهاد"
"33326","(۳۳۳۲۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عن الأوزاعی عَنِ الزُّہْرِیِّ سَمِعَہُ یَقُولُ : لاَ تَقْرَبُ الْمَجُوسِیَّۃَ حَتَّی تَقُولَ : لاَ إلَہَ إِلاَّ اللَّہُ ، فَإذَا قَالَتْ ذَلِکَ فَہُوَ مِنْہَا إسْلاَمٌ۔","","Musannaf Ibn Abi Shaybah 33326","","","كتاب الجهاد"
"33327","(۳۳۳۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : لاَ یَطَؤُہَا حَتَّی تُسْلِمَ۔","","Musannaf Ibn Abi Shaybah 33327","","","كتاب الجهاد"
"33328","(۳۳۳۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی مَجُوسِ ہَجَرَ یَعْرِضُ عَلَیْہِمَ الإِسْلاَمَ فَمَنْ أَسْلَمَ منہم قَبِلَ مِنْہُ ، وَمَنْ أَبَی ضُرِبَتْ عَلَیْہِ الْجِزْیَۃُ غَیْرَ أَنْ لاَ یُؤْکَلَ لَہُمْ ذَبِیحَۃٌ ، وَلاَ تُنْکَحَ لہم امْرَأَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 33328","","","كتاب الجهاد"
"33329","(۳۳۳۲۹) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْمَجُوسِیَّۃِ تَکُونُ عِنْدَ الرَّجُلِ ؟ قَالَ : لاَ یَتَطِیہَا۔","","Musannaf Ibn Abi Shaybah 33329","","","كتاب الجهاد"
"33330","(۳۳۳۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سُبِیَتِ الْمَجُوسِیَّاتُ وَعَبَدَۃُ الأَوْثَانِ عُرِضَ عَلَیْہِنَّ الإِسْلاَمُ وَجُبِرْنَ عَلَیْہِ ، فَإِنْ أَسْلَمْنَ وُطِئْنَ وَاسْتُخْدِمْنَ ، وَإِنْ أَبَیْنَ أَنْ یُسْلِمْنَ اسْتُخْدِمْنَ وَلَمْ یُوطَأْنَ۔","","Musannaf Ibn Abi Shaybah 33330","","","كتاب الجهاد"
"33331","(۳۳۳۳۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ مُثَنًّی ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ أَنْ یَشْتَرِیَ الرَّجُلُ الْجَارِیَۃَ الْمَجُوسِیَّۃَ فَیَتَسَرَّاہَا۔","","Musannaf Ibn Abi Shaybah 33331","","","كتاب الجهاد"
"33332","(۳۳۳۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سُبِیَتِ الْیَہُودِیَّاتُ وَالنَّصْرَانِیَّات عُرِضَ عَلَیْہِنَّ الإِسْلاَمُ وَأُجْبِرْنَ عَلَیْہِ ، فَإِنْ أَسْلَمْنَ ، أَوْ لَمْ یُسْلِمْنَ وُطِئْنَ وَاسْتُخْدِمْنَ۔","","Musannaf Ibn Abi Shaybah 33332","","","كتاب الجهاد"
"33333","(۳۳۳۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا أَصَابَ الرَّجُلُ الْجَارِیَۃَ الْمُشْرِکَۃَ فَلْیُقْرِرْہَا بِشَہَادَۃِ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، فَإِنْ أَبَتْ أَنْ تُقِرَّ لَمْ یَمْنَعْہُ ذَلِکَ أَنْ یَقَعَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 33333","","","كتاب الجهاد"
"33334","(۳۳۳۳۴) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ بُرْدٍ، عَنْ مَکْحُولٍ؛ فِی الرَّجُلِ إذَا کَانَتْ لَہُ أَمَۃٌ یَہُودِیَّۃٌ، أَوْ نَصْرَانِیَّۃٌ فَإِنَّہُ یَتطِیہَا۔","","Musannaf Ibn Abi Shaybah 33334","","","كتاب الجهاد"
"33335","(۳۳۳۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا کَانَتْ لَہُ أَمَۃٌ مِنْ أَہْلِ الْکِتَابِ فَلَہُ أَنْ یَغْشَاہَا إِنْ شَائَ وَیُکْرِہَہَا عَلَی الْغُسْلِ۔","","Musannaf Ibn Abi Shaybah 33335","","","كتاب الجهاد"
"33336","(۳۳۳۳۶) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الْیَہُودِیَّۃُ وَالنَّصْرَانِیَّۃ یَتطِیہُمَا۔","","Musannaf Ibn Abi Shaybah 33336","","","كتاب الجهاد"
"33337","(۳۳۳۳۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ، قَالَ: کَانَ عَبْدُاللہِ یَکْرَہُ أَمَتہ مُشْرِکَۃً۔","","Musannaf Ibn Abi Shaybah 33337","","","كتاب الجهاد"
"33338","(۳۳۳۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : أَکْرَہُ أَنْ أَطَأَ أمۃ مُشْرِکَۃً حَتَّی تُسْلِمَ۔","Hasan","Musannaf Ibn Abi Shaybah 33338","","","كتاب الجهاد"
"33339","(۳۳۳۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنِ الرَّجُلِ یَشْتَرِی الجَارِیَۃ مِنَ السَّبْیِ فَیَقَعُ عَلَیْہَا ؟ قَالَ : لاَ ، حَتَّی یُعَلِّمَہَا الصَّلاَۃَ وَالْ[corrupt]ُسْلَ مِنَ الْجَنَابَۃِ وَحَلْقَ الْعَانَۃِ۔","","Musannaf Ibn Abi Shaybah 33339","","","كتاب الجهاد"
"33340","(۳۳۳۴۰) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، عَنْ رَبِیعِ بْنِ خُثَیْمٍ قَالَ : إذَا أَصَبْت الأَمَۃَ الْمُشْرِکَۃَ فَلاَ تَأْتِہَا حَتَّی تُسْلِمَ وَتَغْتَسِلَ۔","","Musannaf Ibn Abi Shaybah 33340","","","كتاب الجهاد"
"33341","(۳۳۳۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ أَنَّ امْرَأَۃً سَأَلَتْ عَائِشَۃَ ، فَقَالَتْ : إنَّ لَنَا أظارًا مِنَ الْمَجُوسِ وَإِنَّہُمْ یَکُونُ لَہُمَ الْعِیدُ فَیُہْدُونَ لَنَا ، فَقَالَتْ : أَمَّا مَا ذُبِحَ لِذَلِکَ الْیَوْمِ فَلاَ تَأْکُلُوا ، وَلَکِنْ کُلُوا مِنْ أَشْجَارِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33341","","","كتاب الجهاد"
"33342","(۳۳۳۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ حَکِیمٍ ، عَنْ أُمِّہِ ، عَنْ أَبِی بَرْزَۃَ الأَسْلَمِیِّ ، أَنَّہُ کَانَ لَہُ سُکَّانٌ مَجُوسٌ فَکَانُوا یُہْدُونَ لَہُ فِی النَّیْرُوزِ وَالْمِہْرَجَانِ ، فَیَقُولُ لأَہْلِہِ : مَا کَانَ مِنْ فَاکِہَۃٍ فَاقْبَلُوہُ ، وَمَا کَانَ سِوَی ذَلِکَ فَرُدُّوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33342","","","كتاب الجهاد"
"33343","(۳۳۳۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : کُنَّا فِی غَزَاۃٍ لَنَا فَلَقِینَا أُنَاسًا مِنَ الْمُشْرِکِینَ فَأَجْہَضْنَاہُمْ عَنْ مَلَّۃٍ لَہُمْ ، فَوَقَعْنَا فِیہَا فَجَعَلْنَا نَأْکُلُ مِنْہَا وَکُنَّا نَسْمَعُ فِی الْجَاہِلِیَّۃِ أنَّہُ مَنْ أَکَلَ الْخُبْزَ سَمِنَ ، قَالَ : فَلَمَّا أَکَلْنَا تِلْکَ الْخُبْزَۃَ جَعَلَ أَحَدُنَا یَنْظُرُ فِی عِطْفَیْہِ ہَلْ سَمِنَ۔","","Musannaf Ibn Abi Shaybah 33343","","","كتاب الجهاد"
"33344","(۳۳۳۴۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی وَائِلٍ وَإِبْرَاہِیمَ ، قَالاَ : لَمَّا قَدِمَ الْمُسْلِمُونَ أَصَابُوا مِنْ أَطْعِمَۃِ الْمَجُوسِ مِنْ جُبْنِہِمْ وَخُبْزِہِمْ فَأَکَلُوا وَلَمْ یَسْأَلُوا عَنْ شَیْئٍ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33344","","","كتاب الجهاد"
"33345","(۳۳۳۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: کَانَ یَکْرَہُ أَنْ یَأْکُلَ مِمَّا طَبَخَ الْمَجُوسُ فِی قُدُورِہِمْ، وَلَمْ یَکُنْ یَرَی بَأْسًا أَنْ یُؤْکَلَ مِنْ طَعَامِہِمْ مِمَّا سِوَی ذَلِکَ سَمْنٌ ، أَوْ جبن ، أَوْ کَامَخٌ ، أَوْ شیراز، أَوْ لَبَنٌ۔","","Musannaf Ibn Abi Shaybah 33345","","","كتاب الجهاد"
"33346","(۳۳۳۴۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ بِخَلِّہِمْ وَکَامَخِہِمْ وَأَلْبَانِہِمْ۔","","Musannaf Ibn Abi Shaybah 33346","","","كتاب الجهاد"
"33347","(۳۳۳۴۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا شَرِیکٌ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: لاَ تَأْکُلْ مِنْ طَعَامِ الْمَجُوسِیِّ إِلاَّ الْفَاکِہَۃَ۔","","Musannaf Ibn Abi Shaybah 33347","","","كتاب الجهاد"
"33348","(۳۳۳۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : کَانَ الْمُشْرِکُونَ یَجِیئُونَ بِالسَّمْنِ فِی ظُرُوفِہِمْ فَیَشْتَرِیہ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمُونَ فَیَأْکُلُونَہُ وَنَحْنُ نَأْکُلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33348","","","كتاب الجهاد"
"33349","(۳۳۳۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کُنَّا نَأْکُلُ السَّمْنَ ، وَلاَ نَأْکُلُ الْوَدَکَ ، وَلاَ نَسْأَلُ عَنِ الظُّرُوفِ۔","","Musannaf Ibn Abi Shaybah 33349","","","كتاب الجهاد"
"33350","(۳۳۳۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ السَّمْنِ الْجَبَلِیِّ ، فَقَالَ : الْعَرَبِیُّ أَحَبُّ إلَیَّ مِنْہُ ، وَإِنِّی لآکُلُ مِنَ الْجَبَلِیِّ۔","","Musannaf Ibn Abi Shaybah 33350","","","كتاب الجهاد"
"33351","(۳۳۳۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ أَبِی إدْرِیسَ ، عَنْ أَبِی ثَعْلَبَۃَ الْخُشَنِیِّ ، قَالَ : قلْت : یَا رَسُولَ اللہِ ، إنَّا نَغْزُو أَرْضَ الْعَدُوِّ فَنَحْتَاجُ إلَی آنِیَتِہِمْ ، فَقَالَ : اسْتَغْنُوا عنہا مَا اسْتَطَعْتُمْ ، فَإِنْ لَمْ تَجِدُوا غَیْرَہَا فَاغْسِلُوہَا وَکُلُوا فِیہَا وَاشْرَبُوا۔","","Musannaf Ibn Abi Shaybah 33351","","","كتاب الجهاد"
"33352","(۳۳۳۵۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ بُرْدٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَغْزُو مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْضَ الْمُشْرِکِینَ ، فَلاَ نَمْتَنِعُ أَنْ نَأْکُلَ فِی آنِیَتِہِمْ وَنَشْرَبَ فِی أَسْقِیَتِہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 33352","","","كتاب الجهاد"
"33353","(۳۳۳۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْنِ نُجَیٍّ الْحَضْرَمِیِّ أَنَّ حُذَیْفَۃَ اسْتَسْقَی فَأَتَاہُ دِہْقَانُ بِبَاطِیَۃٍ فِیہَا خَمْرٌ فَغَسَلَہَا حُذَیْفَۃُ ، ثُمَّ شَرِبَ فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 33353","","","كتاب الجهاد"
"33354","(۳۳۳۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُرْوَۃَ بْنِ عَبْدِ اللہِ بْنِ قُشَیْرٍ أَبِی الْمُہَلِّ ، عَنِ ابْنِ سِیرِینَ ، قَالَ: کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَظْہَرُونَ عَلَی الْمُشْرِکِینَ فَیَأْکُلُونَ مِنْ أَوْعِیَتِہِمْ وَیَشْرَبُونَ فِی أَسْقِیَتِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33354","","","كتاب الجهاد"
"33355","(۳۳۳۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ بُرْدٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَأْکُلُ مِنْ أَوْعِیَتِہِمْ وَنَشْرَبُ فِی أَسْقِیَتِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33355","","","كتاب الجهاد"
"33356","(۳۳۳۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَکْرَہُونَ آنِیَۃَ الْکُفَّارِ ، فَإِنْ لَمْ یَجِدُوا مِنْہَا بُدًّا غَسَلُوہَا وَطَبَخُوا فِیہَا۔","","Musannaf Ibn Abi Shaybah 33356","","","كتاب الجهاد"
"33357","(۳۳۳۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا احْتَجْتُمْ إلَی قُدُورِ الْمُشْرِکِینَ وَآنِیَتِہِمْ فَاغْسِلُوہَا وَاطْبُخُوا فِیہَا۔","","Musannaf Ibn Abi Shaybah 33357","","","كتاب الجهاد"
"33358","(۳۳۳۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ الْوَلِیدِ الشَّنِّیُّ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، عَنْ قُدُورِ الْمَجُوسِ، فَقَالَ : اغْسِلْہَا وَاطْبُخْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 33358","","","كتاب الجهاد"
"33359","(۳۳۳۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ فِی بُرَمہم وصحافہم : اغْسِلْہَا ، وَاطْبُخْ فِیہَا، وَائْتَدِمْ۔","","Musannaf Ibn Abi Shaybah 33359","","","كتاب الجهاد"
"33360","(۳۳۳۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ قَبِیصَۃَ بْنِ ہُلْبٍ ، عَنْ أبِیہِ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ طَعَامِ النَّصَارَی ، فَقَالَ : لاَ یَخْتَلِجَنَّ فِی صَدْرِکَ طَعَامٌ ضَارَعَتْ فِیہِ نَصْرَانِیَّۃٌ۔ (ابن ماجہ ۲۸۳۰۔ مسند ۸۵۹)","Da'if","Musannaf Ibn Abi Shaybah 33360","","","كتاب الجهاد"
"33361","(۳۳۳۶۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ لَمْ یَرَ بِطَعَامِہِمْ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 33361","","","كتاب الجهاد"
"33362","(۳۳۳۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ قَیْسِ بْنِ سَکَنٍ الأَسَدِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّکُمْ نَزَلْتُمْ بَیْنَ فَارِسَ وَالنَّبَطِ ، فَإِذَا اشْتَرَیْتُمْ لَحْمًا ، فَإِنْ کَانَ ذَبِیحَۃَ یَہُودِیٍّ ، أَوْ نَصْرَانِیٍّ فَکُلُوہُ ، وَإِنْ ذَبَحَہُ مَجُوسِیٌّ فَلاَ تَأْکُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33362","","","كتاب الجهاد"
"33363","(۳۳۳۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : {وَطَعَامُ الَّذِینَ أُوتُوا الْکِتَابَ حِلٌّ لَکُمْ} قَالاَ : الذَّبَائِحُ۔","","Musannaf Ibn Abi Shaybah 33363","","","كتاب الجهاد"
"33364","(۳۳۳۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ الضُّرَیْسِ الأَسَدِیُّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ ، قُلْتُ : إنَّا نَغْزُو أَرْضَ أَرْمِینِیَۃَ أَرْضَ نَصْرَانِیَّۃَ ، فَمَا تَرَی فِی ذَبَائِحِہِمْ وَطَعَامِہِمْ ؟ قَالَ : کُنَّا إذَا غَزَوْنَا أَرْضًا سَأَلْنَا عَنْ أَہْلِہَا ، فَإذَا قَالُوا : یَہُودٌ ، أَوْ نَصَارَی ، أَکَلْنَا مِنْ ذَبَائِحِہِمْ وطعامہم وَطَبَخْنَا فِی آنِیَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 33364","","","كتاب الجهاد"
"33365","(۳۳۳۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا وُجِدَ الْکَنْزُ فِی أَرْضِ الْعَدُوِّ فَفِیہِ الْخُمُسُ ، وَإِذَا وُجِدَ فِی أَرْضِ الْعَرَبِ فَفِیہِ الزَّکَاۃُ۔","","Musannaf Ibn Abi Shaybah 33365","","","كتاب الجهاد"
"33366","(۳۳۳۶۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ عَمَّنْ شَہِدَ الْقَادِسِیَّۃَ ، قَالَ : بَیْنَا رَجُلٌ یَغْتَسِلُ إذَا فَحَصَ لَہُ الْمَائُ التُّرَابَ عَنْ لَبِنَۃٍ مِنْ ذَہَبٍ ، فَأَتَی سَعْدَ بْنَ أَبِی وَقَّاصٍ فَأَخْبَرَہُ ، فَقَالَ : اجْعَلْہَا فِی غَنَائِمِ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33366","","","كتاب الجهاد"
"33367","(۳۳۳۶۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ أَبِی قَیْسٍ عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ، عَنْ ہُزَیْلٍ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ ، فَقَالَ : إنِّی وَجَدْت مِئَتَیْ دِرْہَمٍ ، فَقَالَ عَبْدُ اللہِ : إنِّی لاَ أَرَی الْمُسْلِمِینَ بلغت أَمْوَالُہُمْ ہَذَا ، أُرَاہُ زَکَاۃَ مَالٍ عادیٍّ ، فَأَدِّ خُمُسَہ فِی بَیْتِ الْمَالِ وَلَک مَا بَقِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 33367","","","كتاب الجهاد"
"33368","(۳۳۳۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، قَالَ : حَدَّثَنِی عَمْرُو بْنُ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِی الرِّکَازِ الْخُمُسُ۔","Hasan","Musannaf Ibn Abi Shaybah 33368","","","كتاب الجهاد"
"33369","(۳۳۳۶۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ وَزَکَرِیَّا ، عَنِ الشَّعْبِیِّ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِی الرِّکَازِ الْخُمُسُ۔","","Musannaf Ibn Abi Shaybah 33369","","","كتاب الجهاد"
"33370","(۳۳۳۷۰) حَدَّثَنَا عَبْدُالرَّحِیمِ، عَنْ أَشْعَثَ، عَنِ ابْنِ سِیرِینَ، عَنْ أَبِی ہُرَیْرَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33370","","","كتاب الجهاد"
"33371","(۳۳۳۷۱) حَدَّثَنَا الثَّقَفِیُّ، عَنْ أَیُّوبَ وَوَکِیعٍ، عَنِ ابْنِ عَوْنٍ کِلاَہُمَا، عَنِ ابْنِ سِیرِینَ، عَنْ أبِی ہُرَیْرَۃَ بِمِثْلِہِ وَلَمْ یَرْفَعْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33371","","","كتاب الجهاد"
"33372","(۳۳۳۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ أَنَّ غُلاَمًا مِنَ الْعَرَبِ وَجَدَ سَتُّوقَۃً فِیہَا عَشْرَۃُ آلاَفِ دِرْہَمٍ، فَأَتَی بِہَا عُمَرَ فَأَخَذَ مِنْہَا خُمُسَہَا أَلْفَیْنِ وَأَعْطَاہُ ثَمَانیَۃَ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33372","","","كتاب الجهاد"
"33373","(۳۳۳۷۳) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ، عَنِ الشَّعْبِیِّ أَنَّ رَجُلاً وَجَدَ فِی خَرِبَۃٍ أَلْفًا وَخَمْسَمِئَۃِ دِرْہَمٍ ، فَأَتَی عَلِیًّا، فَقَالَ : أَدِّ خُمُسَہَا وَلَک ثَلاَثَۃُ أَخْمَاسِہَا وَسَنُطَیِّبُ لَکَ الْخُمُسَ الْبَاقِیَ۔","Sahih","Musannaf Ibn Abi Shaybah 33373","","","كتاب الجهاد"
"33374","(۳۳۳۷۴) حَدَّثَنَا عَبَّادٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الرِّکَازُ الْکَنْزُ الْعَادِی ، وفِیہِ الْخُمُسُ۔","Hasan","Musannaf Ibn Abi Shaybah 33374","","","كتاب الجهاد"
"33375","(۳۳۳۷۵) حَدَّثَنَا مُعْتَمِرٌ بن سُلَیْمَانَ ، عَنْ عُمَرَ الضَّبِّیِّ ، قَالَ : بَیْنَمَا رِجَالٌ بسابور یلینون ، أَوْ یُثِیرُونَ الأَرْضَ إذْ أَصَابُوا کَنْزًا وَعَلَیْہَا مُحَمَّدُ بْنُ جَابِرٍ الرَّاسِبِی ، فَکَتَبَ فِیہِ إلَی عَدِیٍّ فَکَتَبَ عَدِیٌّ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ عُمَرُ أَنْ خُذُوا مِنْہُ الْخُمُسَ۔","","Musannaf Ibn Abi Shaybah 33375","","","كتاب الجهاد"
"33376","(۳۳۳۷۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِی الرِّکَازِ الْخُمُسُ۔","Sahih","Musannaf Ibn Abi Shaybah 33376","","","كتاب الجهاد"
"33377","(۳۳۳۷۷) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ کَثِیرِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِی الرِّکَازِ الْخُمُسُ۔","Da'if","Musannaf Ibn Abi Shaybah 33377","","","كتاب الجهاد"
"33378","(۳۳۳۷۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرِّکَازِ الْخُمُسَ۔","","Musannaf Ibn Abi Shaybah 33378","","","كتاب الجهاد"
"33379","(۳۳۳۷۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرِّکَازِ الْخُمُسُ۔ (بخاری ۱۴۹۹۔مسلم ۱۳۳۲)","Hasan","Musannaf Ibn Abi Shaybah 33379","","","كتاب الجهاد"
"33380","(۳۳۳۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ أَنَّ عُمَرَ جَعَلَ عَلَی أَہْلِ السَّوَادِ عَلَی کُلِّ جَرِیبٍ قَفِیزًا وَدِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 33380","","","كتاب الجهاد"
"33381","(۳۳۳۸۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : وَضَعَ عُمَرُ عَلَی أَہْلِ السَّوَادِ عَلَی کُلِّ جَرِیبٍ عَامِرٍ ، أَوْ غَامِرٍ قَفِیزًا وَدِرْہَمًا ، وَعَلَی جَرِیبِ الرُّطَبَۃِ خَمْسَۃَ دَرَاہِمَ وَخَمْسَۃَ أَقْفِزَۃٍ ، وَعَلَی جَرِیبِ الشَّجَرِ عَشَرَۃَ دَرَاہِمَ وَعَشْرَۃَ أَقْفِزَۃٍ ، وَعَلَی جَرِیبِ الْکَرْمِ عَشَرَۃَ دَرَاہِمَ وَعَشْرَۃَ أَقْفِزَۃٍ ، وَلَمْ یَذْکُرِ النَّخْلَ۔","","Musannaf Ibn Abi Shaybah 33381","","","كتاب الجهاد"
"33382","(۳۳۳۸۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : وَضَعَ عُمَرُ بْنُ الْخَطَّابِ عَلَی السَّوَادِ عَلَی کُلِّ جَرِیبِ أَرْضٍ یَبْلُغُہُ الْمَائُ عَامِرٍ ، أَوْ غَامِرٍ دِرْہَمًا وَقَفِیزًا مِنْ طَعَامٍ وعَلَی الْبَسَاتِینِ عَلَی کُلِّ جَرِیبٍ عَشَرَۃَ دَرَاہِمَ وَعَشْرَۃَ أَقْفِزَۃٍ مِنْ طَعَامٍ ، وَعَلَی الرِّطَابِ عَلَی کُلِّ جَرِیبِ أَرْضٍ خَمْسَۃَ دَرَاہِمَ وَخَمْسَۃَ أَقْفِزَۃٍ مِنْ طَعَامٍ وَعَلَی الْکُرُومِ عَلَی کُلِّ جَرِیبِ أَرْضٍ عَشَرَۃَ دَرَاہِمَ وَعَشْرَۃَ أَقْفِزَۃٍ، وَلَمْ یَضَعْ عَلَی النَّخْلِ شَیْئًا جَعَلَہُ تَبَعًا لِلأَرْضِ۔","","Musannaf Ibn Abi Shaybah 33382","","","كتاب الجهاد"
"33383","(۳۳۳۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : بَعَثَ عُمَرُ عُثْمَانَ بْنَ حُنَیْفٍ عَلَی مِسَاحَۃِ الأَرْضِ ، قَالَ : فَوَضَعَ عُثْمَان عَلَی الْجَرِیبِ مِنَ الْکَرْمِ عَشَرَۃَ دَرَاہِمَ ، وَعَلَی جَرِیبِ النَّخْلِ ، ثَمَانیَۃَ دَرَاہِمَ ، وَعَلَی جَرِیبِ الْقَصَبِ سِتَّۃَ دَرَاہِمَ ، یَعْنِی الرَّطْبَۃَ ، وَعَلَی جَرِیبِ الْبُرِّ أَرْبَعَۃَ دَرَاہِمَ ، وَعَلَی جَرِیبِ الشَّعِیرِ دِرْہَمَیْنِ۔","","Musannaf Ibn Abi Shaybah 33383","","","كتاب الجهاد"
"33384","(۳۳۳۸۴) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ أَنَّ عُمَرَ جَعَلَ عَلَی جَرِیبِ النَّخْلِ ثَمَانیَۃَ دَرَاہِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 33384","","","كتاب الجهاد"
"33385","(۳۳۳۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الْحَکَمِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ بَعَثَ عُثْمَانَ بْنَ حُنَیْفٍ عَلَی السَّوَاد ، فَوَضَعَ عَلَی کُلِّ جَرِیبٍ عَامِرٍ ، أَوْ غَامِرٍ یَنَالُہُ الْمَائُ دِرْہَمًا وَقَفِیزًا ، یَعْنِی الْحِنْطَۃَ وَالشَّعِیرَ ، وَعَلَی کل جَرِیبِ الْکَرْمِ عَشْرَۃً وَعَلَی جَرِیبِ الرِّطَابِ خَمْسَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 33385","","","كتاب الجهاد"
"33386","(۳۳۳۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبَانَ بْنِ تَغْلِبَ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ أَنَّہُ وَضَعَ عَلَی النَّخْلِ عَلَی الرِّقلَّتَیْنِ دِرْہَمًا ، وَعَلَی الْفَارِسِیَّۃِ دِرْہَمًا۔","Da'if","Musannaf Ibn Abi Shaybah 33386","","","كتاب الجهاد"
"33387","(۳۳۳۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : جِئْت وَإِذَا عُمَرُ وَاقِفٌ عَلَی حُذَیْفَۃَ وَعُثْمَانَ بْنِ حُنَیْفٍ ، فَقَالَ : تَخَافَانِ أَنْ تَکُونَا حَمَّلْتُمَا الأَرْضَ مَا لاَ تُطِیقُ ، فَقَالَ حُذَیْفَۃُ : لَوْ شِئْت لأَضْعَفْت أَرْضِی ، قَالَ : وَقَالَ عُثْمَان بْنُ حُنَیْفٍ : لَقَدْ حَمَّلْت أَرْضِی أَمْرًا ہِیَ لَہُ مُطِیقَۃٌ ، وَمَا فِیہَا کَثِیرُ فَضْلٍ ، فَقَالَ : انْظُرا مَا لَدَیْکُمَا أَنْ تَکُونَا حَمَّلْتُمَا الأَرْضَ مَا لاَ تُطِیقُ۔ (بخاری ۳۷۰۰)","Sahih","Musannaf Ibn Abi Shaybah 33387","","","كتاب الجهاد"
"33388","(۳۳۳۸۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ سَمِعْت عَمْرَو بْنَ مَیْمُونٍ ، قَالَ : دَخَلَ عُثْمَان بْنُ حُنَیْفٍ عَلَی عُمَرَ فَسَمِعْتہ یَقُولُ : لأَنْ زِدْت عَلَی کُلِّ رَأْسٍ دِرْہَمَیْنِ وَعَلَی کُلِّ جَرِیبِ أَرْضٍ دِرْہَمًا وَقَفِیزًا مِنْ طَعَامٍ لاَ یَضُرُّہُمْ ذَلِکَ ، وَلاَ یُجْہِدُہُمْ ، أَوْ کَلِمَۃً نَحْوَہَا ، قَالَ : نَعَمْ ، قَالَ : فَکَانَ عَلَی کُلِّ رَأْسٍ ثَمَانِیَۃٌ وَأَرْبَعُونَ ، فَجَعَلَہَا خَمْسِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 33388","","","كتاب الجهاد"
"33389","(۳۳۳۸۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ طَلْحَۃَ ، عَنْ دَاوُدَ بْنِ سُلَیْمَانَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی عَبْدِ الْحَمِیدِ بْنِ عَبْدِ الرَّحْمَنِ : آمُرُک أَنْ تُطَرِّزَ أَرْضَہُمْ ، یَعْنِی أَہْلَ الْکُوفَۃِ ، وَلاَ تَحْمِلْ خَرَابًا عَلَی عَامِرٍ ، وَلاَ عَامِرًا عَلَی خَرَابٍ ، وَانْظُرَ الْخَرَابَ فَخُذْ مِنْہُ مَا أَطَاقَ وَأَصْلِحْہُ حَتَّی یَعْمَُرَ ، وَلاَ تَأْخُذْ مِنَ الْعَامِرِ إِلاَّ وَظِیفَۃَ الْخَرَاجِ فِی رِفْقٍ وَتَسْکِینٍ لأَہْلِ الأَرْضِ ، وَآمُرُک أَنْ لاَ تَأْخُذَ فِی الْخَرَاجِ إِلاَّ وَزْنَ سَبْعَۃٍ لَیْسَ لَہَا آس ، وَلاَ أُجُورَ الضَّرَّابِینَ ، وَلاَ إذابۃ الْفِضَّۃَ ، وَلاَ ہَدِیَّۃَ النَّیْرُوزِ وَالْمِہْرَجَانِ ، وَلا ثَمَنَ الْصُحُفِ ، وَلاَ أُجُورَ الْفُسُوحِ ، وَلاَ أُجُورَ الْبُیُوتِ ، وَلاَ دِرْہَمَ النِّکَاحِ ، وَلاَ خَرَاجَ عَلَی مَنْ أَسْلَمَ مِنْ أَہْلِ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 33389","","","كتاب الجهاد"
"33390","(۳۳۳۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شِبْلٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَوْلَہُ {مُسَوِّمِینَ} مُعَلَّمِینَ مجزوزۃ أَذْنَابُ خُیُولِہِمْ عَلَیْہَا الْعِہْنُ وَالصُّوفُ۔","","Musannaf Ibn Abi Shaybah 33390","","","كتاب الجهاد"
"33391","(۳۳۳۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عُمَیْرِ بْنِ إِسْحَاقَ ، قَالَ : قیلَ لَہُمْ یَوْمَ بَدْرٍ تَسَوَّمُوا فَإِنَّ الْمَلاَئِکَۃَ قَدْ تَسَوَّمَتْ ، قَالُوا : فَأَوَّلُ مَا جُعِلَ الصُّوفُ لَیَوْمَئِذٍ۔","","Musannaf Ibn Abi Shaybah 33391","","","كتاب الجهاد"
"33392","(۳۳۳۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ الْعَبْدِیِّ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ سِیمَا أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ بَدْرٍ الصُّوفُ الأَبْیَضُ۔","Sahih","Musannaf Ibn Abi Shaybah 33392","","","كتاب الجهاد"
"33393","(۳۳۳۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ رَجُلٍ مِنْ وَلَدِ الزُّبَیْرِ ، یُقَالَ لَہُ : یَحْیَی بْنُ عَبَّادٍ ، قَالَ : کَانَ عَلَی الزُّبَیْرِ یَوْمَ بَدْرٍ عِمَامَۃٌ صَفْرَائُ مُعْتَجِرًا بِہَا فَنَزَلَتِ الْمَلاَئِکَۃُ عَلَیْہِمْ عَمَائِمُ صُفْرٌ۔","","Musannaf Ibn Abi Shaybah 33393","","","كتاب الجهاد"
"33394","(۳۳۳۹۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبَّادِ بْنِ حَمْزَۃَ ، عَنِ الزُّبَیْرِ بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 33394","","","كتاب الجهاد"
"33395","(۳۳۳۹۵) حَدَّثَنَا ہُشَیم ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، قَالَ : حدَّثَنَا أَنَسُ بْنُ مَالِکٍ ، قَالَ قَدِمَ نَاسٌ مِنْ عُرَیْنَۃَ الْمَدِینَۃَ فَاجْتَوَوْہَا ، فَقَالَ لَہُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ شِئْتُمْ أَنْ تَخْرُجُوا إلَی إبِلِ الصَّدَقَۃِ فَتَشْرَبُوا مِنْ أَبْوَالِہَا وَأَلْبَانِہَا فَفَعَلُوا وَاسْتَصَحُّوا ، قَالَ : فَمَالُوا عَلَی الرُِّاعَاء فَقَتَلُوہُمْ وَاسْتَاقُوا ذَوْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَفَرُوا بَعْدَ إسْلاَمِہِمْ ، فَبَعَثَ فِی آثَارِہِمْ فَأُتِیَ بِہِمْ فَقَطَّعَ أَیْدِیَہُمْ وَأَرْجُلَہُمْ وَسَمَلَ أَعْیُنَہُمْ وَتُرِکُوا بِالْحَرَّۃِ حَتَّی مَاتُوا۔ (مسلم ۱۲۹۶۔ ابویعلی ۳۹۸۲)","Sahih","Musannaf Ibn Abi Shaybah 33395","","","كتاب الجهاد"
"33396","(۳۳۳۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَ ذَلِکَ۔n(مسلم ۱۲۹۶۔ ترمذی ۷۲)","Sahih","Musannaf Ibn Abi Shaybah 33396","","","كتاب الجهاد"
"33397","(۳۳۳۹۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ مَنْ بَدَّلَ دِینَہُ فَاقْتُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33397","","","كتاب الجهاد"
"33398","(۳۳۳۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ أَنَّ مُعَاذَ بْنَ جَبَلٍ أَتَی أَبَا مُوسَی ، وَعِنْدَہُ رَجُلٌ یَہُودِیٌّ ، فَقَالَ : مَا ہَذَا ، قَالَ : ہَذَا یَہُودِیٌّ أَسْلَمَ ، ثُمَّ ارْتَدَ ، وَقَدِ اسْتَتَابَہُ أَبُو مُوسَی شَہْرَیْنِ ، فَقَالَ مُعَاذٌ : لاَ أَجْلِسُ حَتَّی أَضْرِبَ عُنُقَہُ قَضَاء اللَّہُ وَقَضَاء رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 33398","","","كتاب الجهاد"
"33399","(۳۳۳۹۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : ارْتَدَّ عَلْقَمَۃُ بْنُ عُلاَثَۃَ ، عَنْ دِینِہِ بَعْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَاتَلَہُ الْمُسْلِمُونَ ، قَالَ : فَأَبَی أَنْ یَجْنَحَ لِلسَّلْمِ ، فَقَالَ أَبُو بَکْرٍ : لاَ یُقْبَلُ مِنْک إِلاَّ سَلْمٌ مُخْزِیَۃٌ ، أَوْ حَرْبٌ مُجْلِیَۃٌ ، قَالَ ، فَقَالَ : وَمَا سَلْمٌ مُخْزِیَۃٌ ، قَالَ : تَشْہَدُونَ عَلَی قَتْلاَنَا أَنَّہُمْ فِی الْجَنَّۃِ ، وَأَنَّ قَتْلاَکُمْ فِی النَّارِ ، وَتَدُونَ قَتْلاَنَا ، وَلاَ نَدِی قَتْلاَکُمْ ، فَاخْتَارُوا سِلْمًا مُخْزِیَۃً۔","","Musannaf Ibn Abi Shaybah 33399","","","كتاب الجهاد"
"33400","(۳۳۴۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عْن طَارِقِ بْنِ شِہَابٍ ، قَالَ : جَائَ وَفْدُ بُزَاخَۃَ أَسَدٍ وَغَطَفَانَ إلَی أَبِی بَکْرٍ یَسْأَلُونَہُ الصُّلْحَ ، فَخَیَّرَہُمْ أَبُو بَکْرٍ بَیْنَ الْحَرْبِ الْمُجْلِیَۃِ ، وَالسَّلْمِ الْمُخْزِیَۃِ ، قَالَ : فَقَالُوا : ہَذَا الْحَرْبُ الْمُجْلِیَۃُ قَدْ عَرَفْنَاہَا ، فَمَا السَّلْمُ الْمُخْزِیَۃُ ، قَالَ : قَالَ أَبُو بَکْرٍ : تُؤَدُّونَ الْحَلْقَۃَ وَالْکُرَاعَ ، وَتَتْرُکُونَ أَقْوَامًا یَتْبِعُونَ أَذْنَابَ الإِبِلِ حَتَّی یُرِی اللَّہُ خَلِیفَۃَ نَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمِینَ أَمْرًا یَعْذِرُونَکُمْ بِہِ ، وَتَدُونَ قَتْلاَنَا ، وَلاَ نَدِی قَتْلاَکُمْ ، وَقَتْلاَنَا فِی الْجَنَّۃِ وَقَتْلاَکُمْ فِی النَّارِ ، وَتَرُدُّونَ مَا أَصَبْتُمْ مِنَّا وَنَغْنَمُ مَا أَصَبْنَا مِنْکُمْ ، فَقَالَ عُمَرُ ، فَقَالَ : قَدْ رَأَیْت رَأْیًا ، وَسَنُشِیرُ عَلَیْک ، أَمَّا أَنْ یُؤَدُّوا الْحَلْقَۃَ وَالْکُرَاعَ فَنِعْمَ مَا رَأَیْت ، وَأَمَّا أَنْ یَتْرُکُوا أَقْوَامًا یَتَّبِعُونَ أَذْنَابَ الإِبِلِ حَتَّی یَرَی اللَّہُ خَلِیفَۃَ نَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمِینَ أَمْرًا یَعْذِرُونَہُمْ بِہِ فَنِعْمَ مَا رَأَیْت وَأَمَّا أَنْ نَغْنَمَ مَا أَصَبْنَا مِنْہُمْ وَیَرُدُّونَ مَا أَصَابُوا مِنَّا فَنِعْمَ مَا رَأَیْت ، وَأَمَّا أَنَّ قَتْلاَہُمْ فِی النَّارِ وَقَتْلاَنَا فِی الْجَنَّۃِ فَنِعْمَ مَا رَأَیْت ، وَأَمَّا أَنْ لاَ نَدِیَ قَتْلاَہُمْ فَنِعْمَ مَا رَأَیْت ، وَأَمَّا أَنْ یَدُوا قَتْلاَنَا فَلا ، قَتْلاَنَا قُتِلُوا عَنْ أَمْرِ اللہِ فَلاَ دِیَاتٍ لَہُمْ ، فَتَتَابَعَ النَّاسُ عَلَی ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 33400","","","كتاب الجهاد"
"33401","(۳۳۴۰۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ارْتَدَّ عَلْقَمَۃُ بْنُ عُلاَثَۃَ فَبَعَثَ أَبُو بَکْرٍ إلَی امْرَأَتِہِ وَوَلَدِہِ ، فَقَالَتْ : إِنْ کَانَ عَلْقَمَۃُ کَفَرَ فَإِنِّی لَمْ أَکْفُرْ أَنَا ، وَلاَ وَلَدِی ، فَذَکَرَ ذَلِکَ لِلشَّعْبِیِّ ، فَقَالَ: ہَکَذَا فَعَلَ بِہِمْ ، یَعْنِی بِأَہْلِ الرِّدَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 33401","","","كتاب الجهاد"
"33402","(۳۳۴۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ نَحْوَہُ وَزَادَ فِیہِ : ثُمَّ إِنَّہُ جَنَحَ لِلسَّلْمِ فِی زَمَانِ عُمَرَ فَأَسْلَمَ فَرَجَعَ إلَی امْرَأَتِہِ کَمَا کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 33402","","","كتاب الجهاد"
"33403","(۳۳۴۰۳) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ أَنَّ أَبَا بَکْرٍ ، قَالَ : لَوْ مَنَعُونِی عَقَاْلاً مِمَّا أَعْطَوْا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَجَاہَدْتُہُمْ ، ثُمَّ تَلاَ : (وَمَا مُحَمَّدٌ إِلاَّ رَسُولٌ قَدْ خَلَتْ مِنْ قَبْلِہِ الرُّسُلُ) إلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 33403","","","كتاب الجهاد"
"33404","(۳۳۴۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ عُمَرُ : وَالَّذِی نَفْسِی بِیَدِہِ لَوْ أَطَاعَنَا أَبُو بَکْرٍ لَکَفَرْنَا فِی صَبِیحَۃٍ وَاحِدَۃٍ إذْ سَأَلُوا التَّخْفِیفَ من الزَّکَاۃِ ، فَأَبَی عَلَیْہِمْ ، وقَالَ : لَوْ مَنَعُونِی عَقَاْلاً لَجَاہَدْتُہُمْ۔","","Musannaf Ibn Abi Shaybah 33404","","","كتاب الجهاد"
"33405","(۳۳۴۰۵) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یُسَاکِنُکُمَ الْیَہُودُ وَالنَّصَارَی فِی أَمْصَارِکُمْ ، فَمَنْ أَسْلَمَ مِنْہُمْ ، ثُمَّ ارْتَدَّ فَلاَ تَضْرِبُوا إِلاَّ عُنُقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33405","","","كتاب الجهاد"
"33406","(۳۳۴۰۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، قَالَ : حدَّثَنَا عَامِرٌ أَنَّ أَنَسَ بْنَ مَالِکٍ حَدَّثَہُ أَنَّ نَفَرًا مِنْ بَکْرِ بْنِ وَائِلٍ ارْتَدُّوا عَنِ الإِسْلاَمِ وَلَحِقُوا بِالْمُشْرِکِینَ فَقُتِلُوا فِی الْقِتَالِ ، فَلَمَّا أَتَیْتُ عُمَرَ بْنَ الْخَطَّابِ بِفَتْحِ تُسْتَرَ ، قَالَ : مَا فَعَلَ النَّفَرُ مِنْ بَکْرِ بْنِ وَائِلٍ ، قَالَ : قُلْتُ عَرَضْت فِی حَدِیثٍ آخَرَ لأَشْغَلَہُ عَنْ ذِکْرِہِمْ ، قَالَ : مَا فَعَلَ النَّفَرُ مِنْ بَکْرِ بْنِ وَائِلٍ، قَالَ: قُلْتُ: قُتِلُوا یَا أَمِیرَ الْمُؤْمِنِینَ، قَالَ: لَوْ کُنْتُ أَخَذْتہم سِلْمًا کَانَ أَحَبُّ إلَیَّ مِمَّا طَلَعَتْ عَلَیْہِ الشَّمْسُ مِنْ صَفْرَائَ وَبَیْضَائَ، قَالَ: قُلْتُ: یَا أَمِیرَ الْمُؤْمِنِینَ، وَمَا کَانَ سَبِیلُہُمْ لَوْ أَخَذْتہمْ إِلاَّ الْقَتْلَ، قَوْمٌ ارْتَدُّوا عَنِ الإِسْلاَمِ وَلَحِقُوا بِالشِّرْکِ، قَالَ: کُنْتُ أَعْرِضُ أَنْ یَدْخُلُوا فِی الْبَابِ الَّذِی خَرَجُوا مِنْہُ، فَإِنْ فَعَلُوا قبِلْت ذَلِکَ مِنْہُمْ، وَإِنْ أَبَوْا اسْتَوْدَعْتہمَ السِّجْنَ۔","Sahih","Musannaf Ibn Abi Shaybah 33406","","","كتاب الجهاد"
"33407","(۳۳۴۰۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدِ بْنِ حَیَّانَ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، قَالَ : حدَّثَنِی أَبُو الطُّفَیْلِ ، قَالَ : کُنْتُ فِی الْجَیْشِ الَّذِینَ بَعَثَہُمْ عَلِیُّ بْنُ أَبِی طَالِبٍ إلَی بَنِی نَاجِیَۃَ ، فَانْتَہَیْنَا إلَیْہِمْ فَوَجَدْنَاہُمْ عَلَی ثَلاَثِ فِرَقٍ ، قَالَ : فَقَالَ : أَمِیرُنَا لِفِرْقَۃٍ مِنْہُمْ : مَا أَنْتُمْ ؟ قَالُوا : نَحْنُ قَوْمٌ نَصَارَی وَأَسْلَمْنَا ، فثبتنا علی إسلامنا ، قَالَ اعتزلوا ، ثم قَالَ للثانیۃ : ما أنتم ؟ قالوا نحن قوم من النصاری لم نر دینا أَفْضَلَ مِنْ دِینِنَا فثبتنا علیہ فقال اعتزلو ، ثم قَالَ لفرقۃ أخری : ما أنتم ؟ قالوا نحن قوم من النصاری فَأَبَوْا ، فَقَالَ لأَصْحَابِہِ : إذَا مَسَحْت رَأْسِی ثَلاَثَ مَرَّاتٍ فَشُدُّوا عَلَیْہِمْ فَفَعَلُوا فَقَتَلُوا الْمُقَاتِلَۃَ وَسَبَوْا الذَّرَارِی ، فَجِئْت بِالذَّرَارِیِّ إلَی عَلِیٍّ وَجَائَ مِصْقَلَۃُ بْنُ ہُبَیْرَۃَ فَاشْتَرَاہُمْ بِمِائَتَیْ أَلْفٍ فَجَائَ بِمِئَۃِ أَلْفٍ إلَی عَلِی ، فَأَبَی أَنْ یَقْبَلَ ، فَانْطَلَقَ مِصْقَلَۃُ بِدَرَاہِمِہِ وَعَمَدَ إلَیْہِمْ مِصْقَلَۃُ فَأَعْتَقَہُمْ وَلَحِقَ بِمُعَاوِیَۃَ فَقِیلَ لِعَلِیٍّ : إِلاَّ تَأْخُذُ الذُّرِّیَّۃَ ، فَقَالَ : لاَ ، فَلَمْ یَعْرِضْ لَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 33407","","","كتاب الجهاد"
"33408","(۳۳۴۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی عُلاَقَۃَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ بَعَثَ سَرِیَّۃً فَوَجَدُوا رَجُلاً مِنَ الْمُسْلِمِینَ تَنَصَّرَ بَعْدَ إسْلاَمِہِ فَقَتَلُوہُ ، فَأُخْبِرَ عُمَرُ بِذَلِکَ ، فَقَالَ : ہَلْ دَعَوْتُمُوہُ إلَی الإِسْلاَمِ ، قَالُوا : لاَ قَالَ : فَإِنِّی أَبْرَأُ إلَی اللہِ مِنْ دَمِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33408","","","كتاب الجهاد"
"33409","(۳۳۴۰۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ ابن عَبِیدِ بْنِ الأَبْرَصِ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ أَنَّہُ أَتَی بِرَجُلٍ کَانَ نَصْرَانِیًّا فَأَسْلَمَ ، ثُمَّ تَنَصَّرَ ، فَسَأَلَہُ عُمَرُ عَنْ کَلِمَۃٍ ، فَقَالَ لَہُ ، فَقَامَ إلَیْہِ عَلِیٌّ فَرَفَسَہُ بِرِجْلِہِ ، قَالَ : فَقَامَ النَّاسُ إلَیْہِ فَضَرَبُوہُ حَتَّی قَتَلُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33409","","","كتاب الجهاد"
"33410","(۳۳۴۱۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ قَابُوسَ بْنِ الْمُخَارِقِ ، عَنْ أَبِیہِ ، قَالَ : بَعَثَ عَلِیٌّ مُحَمَّدَ بْنَ أَبِی بَکْرٍ أَمِیرًا عَلَی مِصْرَ فَکَتَبَ إلَی عَلِیٍّ یَسْأَلُہُ عَنْ زَنَادِقَۃٍ ، مِنْہُمْ مَنْ یَعْبُدُ الشَّمْسَ وَالْقَمَرَ ، وَمِنْہُمْ مَنْ یَعْبُدُ غَیْرَ ذَلِکَ وَمِنْہُمْ مَنْ یَدَّعِی الإِسْلاَمَ فَکَتَبَ إلَیْہِ وَأَمَرَہُ فِی الزَّنَادِقَۃِ أَنْ یَقْتُلَ مَنْ کَانَ یَدَّعِی الإِسْلاَمَ ، وَیَتْرُکَ سَائِرَہُمْ یَعْبُدُونَ مَا شَاؤُوا۔","Hasan","Musannaf Ibn Abi Shaybah 33410","","","كتاب الجهاد"
"33411","(۳۳۴۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، حَدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، قَالَ : خَرَجَ رَجُلٌ یَطْرُقُ فَرَسًا لَہُ فَمَرَّ بِمَسْجِدِ بَنِی حَنِیفَۃَ فَصَلَّی فِیہِ فَقَرَأَ لَہُمْ إمَامُہُمْ بِکَلاَمِ مُسَیْلِمَۃَ الْکَذَّابِ ، فَأَتَی ابْنُ مَسْعُودٍ فَأَخْبَرَہُ فَبَعَثَ إلَیْہِمْ فَجَائَ بِہِمْ ، فَاسْتَتَابَہُمْ فَتَابُوا إِلاَّ عَبْدَ اللہِ ابْنَ النَّوَّاحَۃِ فَأَنَّہُ قَالَ لَہُ : یَا عَبْدَ اللہِ لولا أَنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لَوْلاَ أَنَّکَ رَسُولٌ لَضَرَبْت عُنُقَک ، فَأَمَّا الْیَوْمَ فَلَسْت بِرَسُولٍ ، یَا خَرَشَۃُ قُمْ فَاضْرِبْ عُنُقَہُ فَقَامَ فَضَرَبَ عُنُقَہُ۔ (ابوداؤد ۲۷۵۶۔ احمد ۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 33411","","","كتاب الجهاد"
"33412","(۳۳۴۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ مَسْعُودٍ ، فَقَالَ: إنِّی مَرَرْت بِمَسْجِدِ بَنِی حَنِیفَۃَ فَسَمِعْت إمَامَہُمْ یَقْرَأُ بِق[corrupt]رَائَۃٍ مَا أَنْزَلَہَا اللَّہُ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمِعْتہ یَقُولُ : الطَّاحِنَاتُ طَحْنًا فَالْعَاجِنَاتُ عَجْنًا فَالْخَابِزَاتُ خَبْزًا فَالثَّارِدَاتُ ثَرْدًا فَاللاَقِمَاتُ لَقْمًا قَالَ : فَأَرْسَلَ عَبْدُ اللہِ فَأَتَی بِہِمْ سَبْعِینَ وَمِئَۃَ رَجُلٍ عَلَی دِینِ مُسَیْلِمَۃَ إمَامُہُمْ عبْدُ اللہِ ابْنِ النَّوَّاحَۃِ ، فَأَمَرَ بِہِ فَقُتِلَ ، ثُمَّ نَظَرَ إلَی بَقِیَّتِہِمْ ، فَقَالَ : مَا نَحْنُ بِمُجْزِرِی الشَّیْطَانِ ہَؤُلاَئِ ، سَائِرُ الْقَوْمِ رَحِّلُوہُمْ إلَی الشَّامِ لَعَلَّ اللَّہَ أَنْ یفنیہم بِالطَّاعُونِ۔ (عبدالرزاق ۱۸۷۰۸)","Sahih","Musannaf Ibn Abi Shaybah 33412","","","كتاب الجهاد"
"33413","(۳۳۴۱۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : کَتَبَ عَمْرُو بْنُ الْعَاصِ إلَی عُمَرَ بْنِ الْخَطَّابِ أَنَّ رَجُلاً تَبَدَّلَ بِالْکُفْرِ بَعْدَ الإِیمَانِ ، فَکَتَبَ إلَیْہِ عُمَرُ : اسْتَتِبْہُ ، فَإِنْ تَابَ فَاقْبَلْ مِنْہُ ، وَإِلاَّ فَاضْرِبْ عُنُقَہُ۔","","Musannaf Ibn Abi Shaybah 33413","","","كتاب الجهاد"
"33414","(۳۳۴۱۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُبَیْدٍ الْعَامِرِیِّ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أُنَاسٌ یَأْخُذُونَ الْعَطَائَ وَالرِّزْقَ وَیُصَلُّونَ مَعَ النَّاسِ ، وَکَانُوا یَعْبُدُونَ الأَصْنَامَ فِی السِّرِ ، فَأَتَی بِہِمْ عَلِیُّ بْنُ أَبِی طَالِبٍ فَوَضَعَہُمْ فِی الْمَسْجِدِ ، أَوَ قَالَ فِی السِّجْنِ ، ثُمَّ قَالَ : یَا أَیُّہَا النَّاسُ ، مَا تَرَوْنَ فِی قَوْمٍ کَانُوا یَأْخُذُونَ مَعَکُمَ الْعَطَائَ وَالرِّزْقَ وَیَعْبُدُونَ ہَذِہِ الأَصْنَامَ ؟ قَالَ النَّاسُ : اقْتُلْہُمْ ، قَالَ : لاَ ، وَلَکِنْ أَصْنَعُ بِہِمْ کَمَا صَنَعُوا بِأَبِینَا إبْرَاہِیمَ ، فَحَرَّقَہُمْ بِالنَّارِ۔","","Musannaf Ibn Abi Shaybah 33414","","","كتاب الجهاد"
"33415","(۳۳۴۱۵) حَدَّثَنَا الْبَکْرَاوِیُّ ، عَنْ عُبیدِ اللہِ بْنِ عُمَرَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی قَوْمٍ نَصَارَی ارْتَدُّوا فَکَتَبَ أَنَ اسْتَتِیبُوہُمْ ، فَإِنْ تَابُوا وَإِلاَّ فَاقْتُلُوہُمْ۔","","Musannaf Ibn Abi Shaybah 33415","","","كتاب الجهاد"
"33416","(۳۳۴۱۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی الْمُرْتَدِّ یُسْتَتَابُ ، فَإِنْ تَابَ تُرِکَ وَإِنْ أَبِی قُتِلَ۔","","Musannaf Ibn Abi Shaybah 33416","","","كتاب الجهاد"
"33417","(۳۳۴۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ دِینَارٍ ؛ فِی الرَّجُلِ یَکْفُرَ بَعْدَ إیمَانِہِ ، قَالَ : سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ یَقُولُ : یُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 33417","","","كتاب الجهاد"
"33418","(۳۳۴۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ فِی الإِنْسَاْن یَکْفُرُ بَعْدَ إیمَانِہِ : یُدْعَی إلَی الإِسْلاَمِ ، فَإِنْ أَبَی قُتِلَ۔","","Musannaf Ibn Abi Shaybah 33418","","","كتاب الجهاد"
"33419","(۳۳۴۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی مُوسَی قَالَ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَا وَمُعَاذٌ إلَی الْیَمَنِ ، قَالَ : فَأَتَانِی ذات یَوْمٍ ، وَعِنْدِی یَہُودِیٌّ قَدْ کَانَ مُسْلِمًا فَرَجَعَ عَنِ الإِسْلاَمِ إلَی الْیَہُودِیَّۃِ ، فَقَالَ : لاَ أَنْزِلُ حَتَّی تَضْرِبَ عُنُقَہُ قَالَ حَجَّاجٌ : وَحَدَّثَنِی قَتَادَۃُ أَنَّ أَبَا مُوسَی قَدْ کَانَ دَعَاہُ أَرْبَعِینَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 33419","","","كتاب الجهاد"
"33420","(۳۳۴۲۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ شَیْبَانَ النَّحْوِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِی آخِرِ خُطْبَۃٍ خَطَبَہَا : إنَّ ہَذِہِ الْقَرْیَۃَ ، یَعْنِی الْمَدِینَۃَ لاَ یَصْلُحُ فِیہَا مِلَّتَانِ ، فَأَیُّمَا نَصْرَانِیٌّ أَسْلَمَ ، ثُمَّ تَنَصَّرَ فَاضْرِبُوا عُنُقَہُ۔","","Musannaf Ibn Abi Shaybah 33420","","","كتاب الجهاد"
"33421","(۳۳۴۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ قَیْسٍ عَمَّنْ سَمِعَ إبْرَاہِیمَ یَقُولُ : یُسْتَتَابُ الْمُرْتَدُّ کُلَّمَا ارْتَدَّ۔","","Musannaf Ibn Abi Shaybah 33421","","","كتاب الجهاد"
"33422","(۳۳۴۲۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا بَعْضِ أَصْحَابِنَا، عَنْ مُطَرِّفٍ، عَنِ الحکم قَالَ: یُسْتَتَابُ الْمُرْتَدُّ کُلَّمَا ارْتَدَّ۔","","Musannaf Ibn Abi Shaybah 33422","","","كتاب الجهاد"
"33423","(۳۳۴۲۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ابْنِ عُتْبَۃَ ، قَالَ : کَانَ نَاسٌ مِنْ بَنِی حَنِیفَۃَ مِمَّنْ کَانَ مَعَ مُسَیْلِمَۃَ الْکَذَّابِ یُفْشُونَ أَحَادِیثَہُ وَیَتْلُونَہُ فَأَخَذَہُمَ ابْنُ مَسْعُودٍ فکتب ابن مسعود إلَی عُثْمَانَ فَکَتَبَ إلَیْہِ عُثْمَان أَنَ ادْعُہُمْ إلَی الإِسْلاَمِ فَمَنْ شَہِدَ مِنْہُمْ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاخْتَارَ الإِیمَانَ عَلَی الْکُفْرِ فَاقْبَلْ ذَلِکَ مِنْہُمْ وَخَلِّ سَبِیلَہُمْ ، فَإِنْ أَبَوْا فَاضْرِبْ أَعْنَاقَہُمْ، فَاسْتَتَابَہُمْ، فَتَابَ بَعْضُہُمْ وَأَبَی بَعْضُہُمْ، فَضَرَبَ أَعْنَاقَ الَّذِینَ أَبَوْا۔ (عبدالرزاق ۱۸۷۰۷)","","Musannaf Ibn Abi Shaybah 33423","","","كتاب الجهاد"
"33424","(۳۳۴۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ :لَمَّا قَدِمَ عَلَی عُمَرَ فَتْحُ تُسْتَرَ وَتُسْتَرُ مِنْ أَرْضِ الْبَصْرَۃِ سَأَلَہُمْ : ہَلْ مِنْ مُغَرِّبَۃٍ ، قَالُوا : رَجُلٌ مِنَ الْمُسْلِمِینَ لَحِقَ بِالْمُشْرِکِینَ فَأَخَذْنَاہُ ، قَالَ : مَا صَنَعْتُمْ بِہِ ، قَالُوا : قَتَلْنَاہُ ، قَالَ : أَفَلاَ أَدْخَلْتُمُوہُ بَیْتًا وَأَغْلَقْتُمْ عَلَیْہِ بَابًا وَأَطْعَمْتُمُوہُ کُلَّ یَوْمٍ رَغِیفًا ، ثُمَّ اسْتَتَبْتُمُوہُ ثَلاَثًا فَإِنْ تَابَ وَإِلاَّ قَتَلْتُمُوہُ ، ثُمَّ قَالَ : اللَّہُمَّ لَمْ أَشْہَدْ وَلَمْ آمُرْ وَلَمْ أَرْضَ إذَا بَلَغَنِی ، أَوَ قَالَ : حِینَ بَلَغَنِی۔","Da'if","Musannaf Ibn Abi Shaybah 33424","","","كتاب الجهاد"
"33425","(۳۳۴۲۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا ابْنُ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ عُثْمَانَ ، قَالَ : یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 33425","","","كتاب الجهاد"
"33426","(۳۳۴۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ حَیَّانَ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُدْعَی إلَی الإِسْلاَمِ ثَلاَثَ مِرَارٍ ، فَإِنْ أَبَی ضُرِبَتْ ، عنُقُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33426","","","كتاب الجهاد"
"33427","(۳۳۴۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، قَالَ : یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 33427","","","كتاب الجهاد"
"33428","(۳۳۴۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَلِیٌّ : یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا ، فَإِنْ عَادَ قُتِلَ۔","Da'if","Musannaf Ibn Abi Shaybah 33428","","","كتاب الجهاد"
"33429","(۳۳۴۲۹) حَدَّثَنَا وَکِیعٌ ، عن سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ عَمَّنْ سَمِعَ ابْنَ عُمَرَ یَقُولُ : یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 33429","","","كتاب الجهاد"
"33430","(۳۳۴۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، قَالَ : کَتَبَ عَامِلٌ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ مِنَ الْیَمَنِ أَنَّ رَجُلاً کَانَ یَہُودِیًّا فَأَسْلَمَ ، ثُمَّ تَہَوَّدَ ، وَرَجَعَ عَنِ الإِسْلاَمِ ، فَکَتَبَ إلَیْہِ عُمَرُ أَنَ ادْعُہُ إلَی الإِسْلاَمِ ، فَإِنْ أَسْلَمَ فَخ[corrupt]لِّ سَبِیلَہُ ، وَإِنْ أَبِی فَادْعُ بالخشبۃ ، ثُمَّ ادْعُہُ فَإِنْ أَبَی فَأَضْجِعْہُ عَلَیْہَا ، ثُمَّ ادْعُہُ فَإِنْ أَبَی فَأَوْثِقْہُ ، ثُمَّ ضَعَ الحربۃ عَلَی قَلْبِہِ ، ثُمَّ ادْعُہُ ، فَإِنْ رَجَعَ فَخَلِّ سَبِیلَہُ ، وَإِنْ أَبَی فَاقْتُلْہُ ، فَلَمَّا جَائَ الْکِتَابُ فَعَلَ بِہِ ذَلِکَ حَتَّی وَضَعَ الْحَرْبَۃَ عَلَی قَلْبِہِ ، ثُمَّ دَعَاہُ فَأَسْلَمَ فَخَلَّی سَبِیلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 33430","","","كتاب الجهاد"
"33431","(۳۳۴۳۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ : یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا فَإِنْ رَجَعَ وَإِلاَّ قُتِلَ۔","","Musannaf Ibn Abi Shaybah 33431","","","كتاب الجهاد"
"33432","(۳۳۴۳۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ وَالْحَکَمِ ، قَالاَ ؛ فِی الرَّجُلِ الْمُسْلِمِ یَرْتَدُّ عَنِ الإِسْلاَمِ وَیَلْحَقُ بِأَرْضِ الْعَدُوِّ قالا : تَعْتَدُّ امْرَأَتُہُ ثَلاَثَۃَ قُرُوئٍ إِنْ کَانَتْ تَحِیضُ ، وَإِنْ کَانَتْ لاَ تَحِیضُ فَثَلاَثَۃُ أَشْہُرٍ ، وَإِنْ کَانَتْ حَامِلاً أَنْ تَضَعَ حَمْلَہَا ، وَیُقَسَّمُ مِیرَاثُہُ بَیْنَ امْرَأَتِہِ وَوَرَثَتِہِ مِنَ الْمُسْلِمِینَ ، ثُمَّ تُزَوَّجُ إِنْ شَائَتْ ، وَإِنْ ہُوَ رَجَعَ فَتَابَ مِنْ قَبْلِ أَنْ تَنْقَضِیَ عِدَّتُہَا ثَبَتَا عَلَی نِکَاحِہِمَا۔","","Musannaf Ibn Abi Shaybah 33432","","","كتاب الجهاد"
"33433","(۳۳۴۳۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ أَشْرَکَ وَلَحِقَ بِأَرْضِ الشرک ، قَالَ : لاَ تُزَوَّجُ امْرَأَتُہُ وَقَالَ حَمَّادٌ : تُزَوَّجُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 33433","","","كتاب الجهاد"
"33434","(۳۳۴۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ عَلِیٍّ أَنَّہُ أَتَی بِمُسْتَوْرِدٍ الْعِجْلِیّ وَقَدِ ارْتَدَّ فَعَرَضَ عَلَیْہِ الإِسْلاَمَ فَأَبَی ، قَالَ : فَقَتَلَہُ وَجَعَلَ مِیرَاثَہُ بَیْنَ وَرَثَتِہِ الْمُسْلِمِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 33434","","","كتاب الجهاد"
"33435","(۳۳۴۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ أَنَّ عَلِیًّا قَسَمَ مِیرَاثَ الْمُرْتَدِّ بَیْنَ وَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33435","","","كتاب الجهاد"
"33436","(۳۳۴۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ جُمَیْعٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا ارتد الْمُرْتَدُّ وَرِثَہُ وَلَدُہُ۔","","Musannaf Ibn Abi Shaybah 33436","","","كتاب الجهاد"
"33437","(۳۳۴۳۷) حَدَّثَنَا عَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی مِیرَاثِ الْمُرْتَدِّ لِوَرَثَتِہِ مِنَ الْمُسْلِمِینَ وَلَیْسَ لأَہْلِ دِینِہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33437","","","كتاب الجهاد"
"33438","(۳۳۴۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ وَسُفْیَانَ ، عَنْ أَبِی الصَّبَّاحِ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : الْمُرْتَدُّ نَرِثُہُمْ ، وَلاَ یَرِثُونَا۔","","Musannaf Ibn Abi Shaybah 33438","","","كتاب الجهاد"
"33439","(۳۳۴۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَنْ مِیرَاثِ الْمُرْتَدِّ ہَلْ یُوَصَّلُ إذَا قُتِلَ ، قَالَ : وَمَا یُوَصَّلُ ، قَالَ : یَرِثُہُ وَرَثَتُہُ ، قَالَ : نَرِثُہُمْ ، وَلاَ یَرِثُونَا۔","","Musannaf Ibn Abi Shaybah 33439","","","كتاب الجهاد"
"33440","(۳۳۴۴۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : یُقْتَلُ وَمِیرَاثُہُ بَیْنَ وَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33440","","","كتاب الجهاد"
"33441","(۳۳۴۴۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ ، قَالاَ : یُقَسَّمُ مِیرَاثُہُ بَیْنَ امْرَأَتِہِ وَوَرَثَتِہِ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33441","","","كتاب الجهاد"
"33442","(۳۳۴۴۲) حَدَّثَنَا عَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ فِی الْمُرْتَدَّۃِ : تستأمی ، وَقَالَ حَمَّادٌ : تُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 33442","","","كتاب الجهاد"
"33443","(۳۳۴۴۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ وَوَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی رَزِینٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُقْتَلُ النِّسَائُ إذَا ارْتَدَدْنَ عَنِ الإِسْلاَمِ ، وَلَکِنْ یُحْبَسْنَ وَیُدْعَیْنَ إلَی الإِسْلاَمِ وَیُجْبَرْنَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33443","","","كتاب الجهاد"
"33444","(۳۳۴۴۴) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ فِی الْمُرْتَدَّۃِ ، قَالَ : لاَ تُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 33444","","","كتاب الجهاد"
"33445","(۳۳۴۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 33445","","","كتاب الجهاد"
"33446","(۳۳۴۴۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُقْتَلُ النِّسَائُ إذَا ہُنَّ ارْتَدَدْنَ عَنِ الإِسْلاَمِ ، وَلَکِنْ یُدْعَیْنَ إلَی الإِسْلاَمِ ، فَإِنْ ہُنَّ أَبَیْنَ سُبِینَ وَجُعِلْنَ إمَائً لِلْمُسْلِمِینَ ، وَلاَ یُقْتَلْنَ۔","","Musannaf Ibn Abi Shaybah 33446","","","كتاب الجهاد"
"33447","(۳۳۴۴۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حَرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَرْتَدُّ عَنِ الإِسْلاَمِ ؟ قَالَ : لاَ تُقْتَلُ ، تُحْبَسُ۔","","Musannaf Ibn Abi Shaybah 33447","","","كتاب الجهاد"
"33448","(۳۳۴۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 33448","","","كتاب الجهاد"
"33449","(۳۳۴۴۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمُرْتَدَّۃِ : تُسْتَتَابُ ، فَإِنْ تَابَتْ وَإِلاَّ قُتِلَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 33449","","","كتاب الجهاد"
"33450","(۳۳۴۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّ أُمَّ وَلَدِ رَجُلٍ مِنَ الْمُسْلِمِینَ ارْتَدَّتْ ، فَبَاعَہَا بِدَوْمَۃِ الْجَنْدَلِ مِنْ غَیْرِ أَہْلِ دِینِہَا۔","","Musannaf Ibn Abi Shaybah 33450","","","كتاب الجهاد"
"33451","(۳۳۴۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الْمَرْأَۃِ تَرْتَدُّ عَنِ الإِسْلاَمِ ، قَالَ : تُسْتَتَابُ ، فَإِنْ تَابَتْ وَإِلاَّ قُتِلَتْ۔","","Musannaf Ibn Abi Shaybah 33451","","","كتاب الجهاد"
"33452","(۳۳۴۵۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 33452","","","كتاب الجهاد"
"33453","(۳۳۴۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ أَہْلُ الْعِلْمِ یَقُولُونَ : إذَا أُمِّنَ الْمُحَارِبُ لَمْ یُؤْخَذْ بِشَیْئٍ کَانَ أَصَابَہُ فِی حَالِ حَرْبِہِ إِلاَّ أَنْ یَکُونَ شَیْئًا أَصَابَہُ قَبْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33453","","","كتاب الجهاد"
"33454","(۳۳۴۵۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ فِی الرَّجُلِ یُصِیبُ الْحُدُودَ ، ثُمَّ یَجِیئُ تَائِبًا ، قَالَ : تُقَامُ عَلَیْہِ الْحُدُودُ۔","","Musannaf Ibn Abi Shaybah 33454","","","كتاب الجهاد"
"33455","(۳۳۴۵۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَجْنِی الْجِنَایَۃَ فَیَلْحَقُ بِالْعَدُوِّ فَیُصِیبُہُمْ أَمَانٌ ، قَالَ : یُؤَمَّنُونَ إِلاَّ أَنْ یُعْرَفَ شَیْئٌ بِعَیْنِہِ فَیُؤْخَذُ مِنْہُمْ ، فَیُرَدُّ عَلَی أَصْحَابِہِ ، وَأَمَّا ہُوَ فَیُؤْخَذُ بِمَا کَانَ جَنَی قَبْلَ أَنْ یَلْحَقَ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 33455","","","كتاب الجهاد"
"33456","(۳۳۴۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ أَصَابَ حَدًّا ، ثُمَّ خَرَجَ مُحَارِبًا ، ثُمَّ طَلَبَ أَمَانًا فَأُمِّنَ ، قَالَ : یُقَامُ عَلَیْہِ الْحَدُّ الَّذِی کَانَ أَصَابَہُ۔","","Musannaf Ibn Abi Shaybah 33456","","","كتاب الجهاد"
"33457","(۳۳۴۵۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ إذَا قَطَعَ الطَّرِیقَ وَأَغَارَ ، ثُمَّ رَجَعَ تَائِبًا أُقِیمَ عَلَیْہِ الْحَدُ ، وَتَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ رَبِّہِ۔","","Musannaf Ibn Abi Shaybah 33457","","","كتاب الجهاد"
"33458","(۳۳۴۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حَدَّثَنِی قَیْسُ بْنُ سَعْدٍ أَنَّ عَطَائً کَانَ یَقُولُ : لَوْ أَنَّ رَجُلاً مِنَ الْمُسْلِمِینَ قَتَلَ رَجُلاً ، ثُمَّ کَفَرَ فَلَحِقَ بِالْمُشْرِکِینَ ، فَکَانَ فِیہِمْ ، ثُمَّ رَجَعَ تَائِبًا قُبِلَتْ تَوْبَتُہُ مِنْ شِرْکِہِ ، وَأُقِیمَ عَلَیْہِ الْقِصَاصُ ، وَلَوْ أَنَّہُ لَحِقَ بِالْمُشْرِکِینَ وَلَمْ یُقْتَلْ فَکَفَرَ ، ثُمَّ قَاتَلَ الْمُسْلِمِینَ فَقَتَلَ مِنْہُمْ ، ثُمَّ جَائَ تَائِبًا قُبِلَ مِنْہُ وَلَمْ یَکُنْ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33458","","","كتاب الجهاد"
"33459","(۳۳۴۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ حَارِثَۃُ بْنُ بَدْرٍ التَّمِیمِیُّ مِنْ أَہْلِ الْبَصْرَۃِ قَدْ أَفْسَدَ فِی الأَرْضِ وَحَارَبَ ، فَکَلَّمَ الْحَسَنَ بْنَ عَلِیٍّ ، وَابْنَ جَعْفَرٍ ، وَابْنَ عَبَّاسٍ وَغَیْرَہُمْ مِنْ قُرَیْشٍ ، فَکَلَّمُوا عَلِیًّا فَلَمْ یُؤَمِّنْہُ ، فَأَتَی سَعِیدَ بْنَ قَیْسٍ الْہَمْدَانِیَّ فَکَلَّمَہُ ، فَانْطَلَقَ سَعِیدٌ إلَی عَلِیٍّ وَخَلَفَہُ فِی مَنْزِلِہِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، کَیْفَ تَقُولُ فِیمَنْ حَارَبَ اللَّہَ وَرَسُولَہُ وَسَعَی فِی الأَرْضِ فَسَادًا فَقَرَأَ (إنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ) حَتَّی قَرَأَ الآیَۃَ کُلَّہَا ، فَقَالَ سَعِید ، أَفَرَأَیْت مَنْ تَابَ قَبْلَ أَنْ نَقْدِرَ عَلَیْہِ ، فَقَالَ عَلِیٌّ : أَقُولُ کَمَا قَالَ وَیُقْبَلُ مِنْہُ ، قَالَ : فَإِنَّ حَارِثَۃَ بْنَ بَدْرٍ قَدْ تَابَ قَبْلَ أَنْ یُقْدِرَ عَلَیْہِ ، فَبَعَثَ إلَیْہِ فَأَدْخَلَہُ عَلَیْہِ فَأَمَّنَہُ وَکَتَبَ لَہُ کِتَابًا ، فَقَالَ حَارِثَۃُ :nأَلاَ أُبَلِّغَنْ ہَمْدَانَ إمَّا لَقِیتہَاnلَعَمْرُ أَبِیک إنَّ ہَمْدَانَ تَتَّقِیnشیب رَأْسِی وَاسْتَخَفَّ حُلُومَنَاnnسَلاَمًا فَلاَ یَسْلَمْ عَدُوٌّ یَعِیبُہَاnالإِلَہَ وَیَقْضِی بِالْکِتَابِ خَطِیبُہَاnرُعُودُ الْمَنَایَا حَوْلَنَا وَبُرُوقُہَاnوَإِنَّا لَتَسْتَحْلِی الْمَنَایَا نُفُوسُنَاnnوَنَتْرُکُ أُخْرَی مُرَّۃً مَا نَذُوقُہَاnقالَ ابْنُ عَامِرٍ : فَحَدَّثْت بِہَذَا الْحَدِیثِ ابْنُ جَعْفَرٍ ، فَقَالَ : نَحْنُ کُنَّا أَحَقَّ بِہَذِہِ الأَبْیَاتِ مِنْ ہَمْدَانَ۔","","Musannaf Ibn Abi Shaybah 33459","","","كتاب الجهاد"
"33460","(۳۳۴۶۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنْ عَلَیَّ: بنحوہ منہ، ولم یذکر فیہ الشعر۔","Da'if","Musannaf Ibn Abi Shaybah 33460","","","كتاب الجهاد"
"33461","(۳۳۴۶۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ زَعَمَ أَنَّ رَجُلاً مِنْ مُرَادٍ صلَّی ، فَلَمَّا سَلَّمَ أَبُو مُوسَی قَامَ ، فَقَالَ : ہَذَا مَقَامُ التَّائِبِ الْعَائِذِ ، فَقَالَ : وَیْلَک مَا لَکَ ، قَالَ : أَنَا فُلاَنُ بْنُ فُلاَنٍ الْمُرَادِی ، وَإِنِّی کُنْتُ حَارَبْت اللَّہَ وَرَسُولَہُ وَسَعَیْت فِی الأَرْضِ فَسَادًا ، فَہَذَا حِینَ جِئْت وَقَدْ تُبْت مِنْ قَبْلِ أَنْ یُقْدَرَ عَلَیَّ ، قَالَ : فَقَامَ أَبُو مُوسَی الْمَقَامَ الَّذِی قَامَ فِیہِ ، ثُمَّ قَالَ : إنَّ ہَذَا فُلاَنُ بْنُ فُلاَنٍ الْمُرَادِیُّ : وَإِنَّہُ کَانَ حَارَبَ اللَّہَ وَرَسُولَہُ وَسَعَی فِی الأَرْضِ فَسَادًا ، وَإِنَّہُ قَدْ تَابَ مِنْ قَبْلِ أَنْ یُقْدَرَ عَلَیْہِ ، فَإِنْ یَکُ صَادِقًا فَسَبِیلُ مَنْ صَدَقَ ، وَإِنْ کَانَ کَاذِبًا یَأْخُذُہُ اللَّہُ بِذَنْبِہِ ، قَالَ : فَخَرَجَ فِی النَّاسِ فَذَہَبَ ونجا ، ثُمَّ عَادَ فَقُتِلَ۔","Da'if","Musannaf Ibn Abi Shaybah 33461","","","كتاب الجهاد"
"33462","(۳۳۴۶۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {إنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ وَیَسْعَوْنَ فِی الأَرْضِ فَسَادًا أَنْ یُقَتَّلُوا أَوْ یُصَلَّبُوا أَوْ تُقَطَّعَ أَیْدِیہِمْ وَأَرْجُلُہُمْ مِنْ خِلاَفٍ} حَتَّی خَتَمَ الآیَۃَ ، فَقَالَ : إذَا حَارَبَ الرَّجُلُ وَقَتَلَ وَأَخَذَ الْمَالَ قُطِعَتْ یَدُہُ وَرِجْلُہُ مِنْ خِلاَفٍ وَصُلِبَ وَإِذَا قَتَلَ وَلَمْ یَأْخُذَ الْمَالَ قُتِلَ ، وَإِذَا أَخَذَ الْمَالَ وَلَمْ یَقْتُلْ قُطِعَتْ یَدُہُ وَرِجْلُہُ مِنْ خِلاَفٍ وَإِذَا لَمْ یَقْتُلْ وَلَمْ یَأْخُذَ الْمَالَ نُفِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 33462","","","كتاب الجهاد"
"33463","(۳۳۴۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ فِی ہَذِہِ الآیَۃِ : {إنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ} قَالَ : إذَا قَتَلَ وَأَخَذَ الْمَالَ قُتِلَ ، وَإِذَا أَخَذَ الْمَالَ وَأَخَافَ السَّبِیلَ صُلِبَ ، وَإِذَا قَتَلَ وَلَمْ یُعِدْ ذَلِکَ قُتِلَ ، وَإِذَا أَخَذَ الْمَالَ لَمْ یُعِدْ ذَلِکَ قُطِعَ وَإِذَا أَفْسَدَ نُفِیَ۔","","Musannaf Ibn Abi Shaybah 33463","","","كتاب الجهاد"
"33464","(۳۳۴۶۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : {إنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ} قَالَ : إذَا خَرَجَ وَأَخَافَ السَّبِیلَ وَأَخَذَ الْمَالَ قُطِعَتْ یَدُہُ وَرِجْلُہُ مِنْ خِلاَفٍ ، وَإِذَا أَخَافَ السَّبِیلَ وَلَمْ یَأْخُذَ الْمَالَ نُفِی ، وَإِذَا قَتَلَ قُتِلَ ، وَإِذَا أَخَافَ السَّبِیلَ وَأَخَذَ الْمَالَ وَقَتَلَ صُلِبَ۔","","Musannaf Ibn Abi Shaybah 33464","","","كتاب الجهاد"
"33465","(۳۳۴۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ حُدِّثْت ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَنْ حَارَبَ فَہُوَ مُحَارِبٌ ، فقَالَ سَعِیدٌ : وَإِنْ أَصَابَ دَمًا قُتِلَ ، وَإِنْ أَصَابَ دَمًا وَمَالاً صُلِبَ ، فَإِنَّ الصَّلْبَ ہُوَ أَشَدُ ، وَإِذَا أَصَابَ مَالاً وَلَمْ یُصِبْ دَمًا قُطِعَتْ یَدُہُ وَرِجْلُہُ لِقَوْلِہِ {أَوْ تُقَطَّعَ أَیْدِیہِمْ وَأَرْجُلُہُمْ مِنْ خِلاَفٍ} فَإِنْ تاب فَتَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ ، وَیُقَامُ عَلَیْہِ الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 33465","","","كتاب الجهاد"
"33466","(۳۳۴۶۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ مُوَرِّقٍ الْعِجْلِیّ ، قَالَ : إذَا أَخَذَ الْمُحَارِبُ فَرُفِعَ إلَی الإِمَامِ ، فَإِنْ کَانَ أَخَذَ الْمَالَ وَلَمْ یَقْتُلْ قُطِعَ وَلَمْ یُقْتَلْ ، وَإِنْ کان أَخَذَ الْمَالَ وَقَتَلَ قُتِلَ وَصُلِبَ ، وَإِنْ کَانَ لَمْ یَأْخُذَ الْمَالَ وَلَمْ یَقْتُلْ لَمْ یُقْطَعْ ، وَإِنْ کَانَ لَمْ یَأْخُذَ الْمَالَ وَلَمْ یَقْتُلْ وَشَاقَّ الْمُسْلِمِینَ نُفِیَ۔","","Musannaf Ibn Abi Shaybah 33466","","","كتاب الجهاد"
"33467","(۳۳۴۶۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْمُحَارَبَۃُ الشِّرْکُ۔","","Musannaf Ibn Abi Shaybah 33467","","","كتاب الجهاد"
"33468","(۳۳۴۶۸) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ وَعَنِ الْقَاسِمِ بْنِ أَبِی بَزَّۃَ ، عَنْ مُجَاہِدٍ ، وَعَنْ لَیْثٍ ، عَنْ عَطَائٍ، عَنْ مُجَاہِدٍ، وَعَنْ أَبِی حُرَّۃَ، عَنِ الْحَسَنِ، وَجُوَیْبِرٍ، عَنِ الضَّحَّاکِ ، قَالُوا: الإِمَامُ مُخَیَّرٌ فِی الْمُحَارِبِ۔","","Musannaf Ibn Abi Shaybah 33468","","","كتاب الجهاد"
"33469","(۳۳۴۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، قَالَ : تَلاَ ہَذِہِ الآیَۃَ {إنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ} ، قَالَ : ذَلِکَ إلَی الإِمَامِ۔","","Musannaf Ibn Abi Shaybah 33469","","","كتاب الجهاد"
"33470","(۳۳۴۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : السُّلْطَانُ وَلِیُّ قَتْلِ مَنْ حَارَبَ الدِّینَ وَإِنْ قَتَلَ أَخَا امْرِئٍ وَأَبَاہُ ، فَلَیْسَ إلَی مَنْ یُحَارِبُ الدِّینَ وَیَسْعَی فِی الأَرْضِ فَسَادًا سَبِیلٌ ، یَعْنِی دُونَ السُّلْطَانِ ، وَلاَ یُقَصَّرْ عَنِ الْحُدُودِ بَعْدَ أَنْ تَبْلُغَ إلَی الإِمَامِ ، فَإِنَّ إقَامَتَہَا مِنَ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 33470","","","كتاب الجهاد"
"33471","(۳۳۴۷۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْمُحَارِبِ : إذَا رُفِعَ إلَی الإِمَامِ یَصْنَعُ بِہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 33471","","","كتاب الجهاد"
"33472","حدثنا أبو عبد الرحمن بقی بن مخلد قَالَ حدثنا أبو بکر عبد اللہ بن محمد بن أبی شیبۃ قَالَ :n(۳۳۴۷۲) حَدَّثَنَا سَعِیدُ بْنُ عَامِرٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی حَرَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لأَنْ یَذْہَبَ وَیَرْجِعَ أَحَبُّ إلَیْہِ ، وَسَالَہُ وأراد أَخٌ لَہُ یَغْزُو۔","Da'if","Musannaf Ibn Abi Shaybah 33472","","","كتاب الجهاد"
"33473","(۳۳۴۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُدْفَنُ مَعَ الْقَتِیلِ خُفٌّ ، وَلاَ نَعْلٌ۔","","Musannaf Ibn Abi Shaybah 33473","","","كتاب الجهاد"
"33474","(۳۳۴۷۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُنْزَعُ ، عَنِ الْقَتِیلِ الْفَرْوُ وَالْجَوْرَبَانِ وَالْمَوْزَجَانُ والأفراہیجان إِلاَّ أَنْ یَکُونَ الْجَوْرَبَانِ یُکَمِّلاَنِ فَیُتْرَکَانِ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 33474","","","كتاب الجهاد"
"33475","(۳۳۴۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُخَوَّلٍ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ العبدی ، قَالَ : قَالَ زَیْدُ بْنُ صُوحَانَ : لاَ تَنْزِعُوا عَنِّی ثَوْبًا إِلاَّ الْخُفَّیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 33475","","","كتاب الجهاد"
"33476","(۳۳۴۷۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، قَالَ : کَانَ مُحَمَّدٌ إِذَا سُئِلَ عَنِ الشَّہِیدِ یُغَسَّلُ حَدَّثَ عَنْ حُجْرِ بْنِ عَدِیٍّ إذْ قَتَلَہُ مُعَاوِیَۃُ ، قَالَ : قَالَ حُجْرٌ : لاَ تَطْلِقُوا عَنِّی حَدِیدًا وَلاَ تَغْسِلُوا عَنِّی دَمًا ، ادْفِنُونِی فِی وِثَاقِی وَدَمِی ، فَإنِّی أَلْقَی مُعَاوِیَۃَ علی الْجَادَّۃِ غَدًا۔","","Musannaf Ibn Abi Shaybah 33476","","","كتاب الجهاد"
"33477","(۳۳۴۷۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ یَحْیَی بْنَ عَابِسٍ یُخْبِرُ قَیْسَ بْنَ أَبِی حَازِمٍ ، عَنْ عَمَّارِ بْنِ یَاسِرٍ أَنَّہُ قَالَ : ادْفِنُونِی فِی ثِیَابِی فَإِنِّی مُخَاصِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33477","","","كتاب الجهاد"
"33478","(۳۳۴۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ یَحْیَی بْنِ عَابِسٍ ، عَنْ عَمَّارِ بْنِ یَاسِرٍ نَحْوَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33478","","","كتاب الجهاد"
"33479","(۳۳۴۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُخَوَّلِ بْنِ رَاشِدٍ النَّہْدِیِّ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ الْعَبْدِیِّ ، قَالَ : قَالَ زَیْدُ بْنُ صُوحَانَ یَوْمَ الْجَمَلِ : أَرْمِسُونِی فِی الأَرْضِ رَمْسًا ، وَلاَ تَغْسِلُوا عَنِّی دَمًا ، وَلاَ تَنْزِعُوا عَنِّی ثَوْبًا إِلاَّ الْخُفَّیْنِ ، فَإِنِّی مُحَاجٌّ أُحَاجُّ۔","Sahih","Musannaf Ibn Abi Shaybah 33479","","","كتاب الجهاد"
"33480","(۳۳۴۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ وَسُفْیَانُ ، عَنْ مُصْعَبِ بْنِ الْمُثَنَّی الْعَبْدِیِّ ، قَالَ سُفْیَانُ : عَنْ رَجُلٍ ، عَنْ زَیْدِ بْنِ صُوحَانَ ، وَقَالَ مِسْعَرٌ ، عَنْ مُصْعَبٍ ، عَنْ زَیْدِ بْنِ صُوحَانَ أَنَّہُ قَالَ یَوْمَ الْجَمَلِ : ادْفِنُونَا ، وَمَا أَصَابَ الثَّرَی مِنْ دِمَائِنَا۔","Da'if","Musannaf Ibn Abi Shaybah 33480","","","كتاب الجهاد"
"33481","(۳۳۴۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : قَالَ سَعْدُ بْنُ عُبَیْدٍ الْقَارِئُ یَوْمَ الْقَادِسِیَّۃِ : إنَّا لاَقُوا الْعَدُوِّ غَدًا إِنْ شَائَ اللَّہُ وَإِنَّا مُسْتَشْہِدُونَ فَلاَ تَغْسِلُوا عَنَّا دَمًا ، وَلاَ نُکَفَّنُ إِلاَّ فِی ثَوْبٍ کَانَ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 33481","","","كتاب الجهاد"
"33482","(۳۳۴۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ثَابِتُ بْنُ عُمَارَۃَ ، قَالَ سَمِعْت غُنَیْمَ بْنَ قَیْسٍ یَقُولُ : یقال : الشَّہِیدُ یُدْفَنُ فِی ثِیَابِہِ وَلاَ یُغَسَّلُ۔","","Musannaf Ibn Abi Shaybah 33482","","","كتاب الجهاد"
"33483","(۳۳۴۸۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ أَنَّ رَجُلاً مِنْ أَصْحَابِ عَبْدِ اللہِ قَتَلَہُ الْعَدُوُّ فَدَفَنَّاہُ فِی ثِیَابِہِ۔","","Musannaf Ibn Abi Shaybah 33483","","","كتاب الجهاد"
"33484","(۳۳۴۸۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا رُفِعَ الْقَتِیلُ دُفِنَ فِی ثِیَابِہِ ، وَإِذَا رُفِعَ وَبِہِ رَمَقٌ صُنِعَ بِہِ مَا یُصْنَعُ بِغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 33484","","","كتاب الجهاد"
"33485","(۳۳۴۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ قَتَلَتْہُ اللُّصُوصُ ، قَالَ : یُدْفَنُ فِی ثِیَابِہِ ، وَلاَ یُغَسَّلُ۔","","Musannaf Ibn Abi Shaybah 33485","","","كتاب الجهاد"
"33486","(۳۳۴۸۶) حَدَّثَنَا شَبَابَۃُ ، قَالَ : أَخْبَرَنا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ أَنَّ جَابِرَ بْنَ عَبْدِ اللہِ أَخْبَرَہُ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یُصَلِّ عَلَی قَتْلَی أُحُدٍ وَلَمْ یُغَسَّلُوا۔","Sahih","Musannaf Ibn Abi Shaybah 33486","","","كتاب الجهاد"
"33487","(۳۳۴۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الشَّہِیدُ إذَا کَانَ فِی الْمَعْرَکَۃِ دُفِنَ فِی ثِیَابِہِ وَلَمْ یُغَسَّلْ۔","","Musannaf Ibn Abi Shaybah 33487","","","كتاب الجهاد"
"33488","(۳۳۴۸۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِحَمْزَۃَ حِینَ اسْتُشْہِدَ فَغُسِّلَ۔","Hasan","Musannaf Ibn Abi Shaybah 33488","","","كتاب الجهاد"
"33489","(۳۳۴۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ أَنَّ حَنْظَلَۃَ بْنَ الرَّاہِبِ طَہَّرَتْہُ الْمَلاَئِکَۃُ۔","","Musannaf Ibn Abi Shaybah 33489","","","كتاب الجهاد"
"33490","(۳۳۴۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی القَتِیل إذَا کَانَ عَلَیْہِ مَہْلٌ غُسِّلَ۔","Hasan","Musannaf Ibn Abi Shaybah 33490","","","كتاب الجهاد"
"33491","(۳۳۴۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : الشَّہِیدُ یُغَسَّلُ ، مَا مَاتَ مَیِّتٌ إِلاَّ أَجْنَبَ۔","","Musannaf Ibn Abi Shaybah 33491","","","كتاب الجهاد"
"33492","(۳۳۴۹۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : غُسِّلَ عُمَرُ وَکُفِّنَ وَحُنِّطَ۔","Sahih","Musannaf Ibn Abi Shaybah 33492","","","كتاب الجهاد"
"33493","(۳۳۴۹۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عن حصین ، عَنْ أَبِی مَالِکٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی حَمْزَۃَ۔ (ابوداؤد ۴۲۷۔ دارقطنی ۷۸)","","Musannaf Ibn Abi Shaybah 33493","","","كتاب الجهاد"
"33494","(۳۳۴۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی حَمْزَۃَ وَکَبَّرَ عَلَیْہِ تِسْعًا۔ (بزار ۱۷۹۶۔ حاکم ۱۹۷)","Da'if","Musannaf Ibn Abi Shaybah 33494","","","كتاب الجهاد"
"33495","(۳۳۴۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ عَطَائٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی قَتْلَی بَدْرٍ۔","","Musannaf Ibn Abi Shaybah 33495","","","كتاب الجهاد"
"33496","(۳۳۴۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، قَالَ : سُئِلَ عَامِرٌ : أَیُصَلَّی عَلَی الشَّہِیدِ ؟ قَالَ : أَحَقُّ مَنْ صُلِّیَ عَلَیْہِ الشَّہِیدُ۔","","Musannaf Ibn Abi Shaybah 33496","","","كتاب الجهاد"
"33497","(۳۳۴۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الشَّیْبَانِیِّ ، عَنْ أَبِیہِ ، قَالَ : حَدَّثَنِی عَمْرُو بْنُ أَبِی قُرَّۃَ ، قَالَ : جَائَنَا کِتَابُ عُمَرَ بْنِ الْخَطَّابِ أَنَّ أُنَاسًا یَأْخُذُونَ مِنْ ہَذَا الْمَالِ یُجَاہِدُونَ فِی سَبِیلِ اللہِ ، ثُمَّ یُخَالِفُونَ ، وَلاَ یُجَاہِدُونَ ، فَمَنْ فَعَلَ ذَلِکَ مِنْہُمْ فَنَحْنُ أَحَقُّ بِمَالِہِ حَتَّی نَأْخُذَ مِنْہُ مَا أَخَذَ ، قَالَ أبو إِسْحَاقُ: فَقُمْت إلَی یسیر بْنِ عَمْرٍو ، فَقُلْتُ : أَلاَ تَرَی إلَی مَا حَدَّثَنِی بِہِ عَمْرُو بْنُ أَبِی قُرَّۃَ وَحَدَّثْت بِہِ ، فَقَالَ : صَدَقَ ، جَائَ بِہِ کِتَابُ عُمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 33497","","","كتاب الجهاد"
"33498","(۳۳۴۹۸) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُوقَفُ مَالُ الأَسِیرِ وَامْرَأَتُہُ حَتَّی یُسْلِمَا ، أَوْ یَمُوتَا۔","","Musannaf Ibn Abi Shaybah 33498","","","كتاب الجهاد"
"33499","(۳۳۴۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنِی الأَوْزَاعِیُّ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ ، عَنِ الأَسِیرِ فِی أَرْضِ الْعَدُوِّ مَتَی تُزَوَّجُ امْرَأَتُہُ ، فَقَالَ : لاَ تُزَوَّجُ مَا عَلِمَتْ أَنَّہُ حَیٌّ۔","","Musannaf Ibn Abi Shaybah 33499","","","كتاب الجهاد"
"33500","(۳۳۵۰۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الأَسِیرِ فِی أَیْدِی الْعَدُوِّ إِنْ أَعْطَی عَطِیَّۃً ، أَوْ نَحَلَ نُحْلاً وَأَوْصَی بِثُلُثِہِ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 33500","","","كتاب الجهاد"
"33501","(۳۳۵۰۱) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَجُوزُ لِلأَسِیرِ فِی مَالِہِ إِلاَّ الثُّلُثُ۔","","Musannaf Ibn Abi Shaybah 33501","","","كتاب الجهاد"
"33502","(۳۳۵۰۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، قَالَ: أَحْوَجُ مَا یَکُونُ إلَی مِیرَاثِہِ وَہُوَ أَسِیرٌ۔","","Musannaf Ibn Abi Shaybah 33502","","","كتاب الجهاد"
"33503","(۳۳۵۰۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ ہَمَّامٍ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ؛ فِی مِیرَاثِ الأَسِیرِ، قَالَ: إِنَّہُ مُحْتَاجٌ إلَی مِیرَاثِہِ۔","","Musannaf Ibn Abi Shaybah 33503","","","كتاب الجهاد"
"33504","(۳۳۵۰۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یَرِثُ الأَسِیرُ۔","","Musannaf Ibn Abi Shaybah 33504","","","كتاب الجهاد"
"33505","(۳۳۵۰۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَرِثُ۔","","Musannaf Ibn Abi Shaybah 33505","","","كتاب الجهاد"
"33506","(۳۳۵۰۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ عَمَّنْ سَمِعَ إبْرَاہِیمَ یَقُولُ : لاَ یَرِثُ الأَسِیرُ۔","","Musannaf Ibn Abi Shaybah 33506","","","كتاب الجهاد"
"33507","(۳۳۵۰۷) حَدَّثَنَا ابْنُ الْحَارِثِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ یَرِثُ الأَسِیرُ فِی أَیْدِی الْعَدُوِّ۔","","Musannaf Ibn Abi Shaybah 33507","","","كتاب الجهاد"
"33508","(۳۳۵۰۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَانَ لاَ یُوَرَّثُ الأَسِیرُ۔","","Musannaf Ibn Abi Shaybah 33508","","","كتاب الجهاد"
"33509","(۳۳۵۰۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یُؤْخَذُ بِمَا أحْدَثَ ہُنَاکَ ، یَعْنِی الأَسِیرَ یُؤْسَرُ فَیُحْدِثُ۔","","Musannaf Ibn Abi Shaybah 33509","","","كتاب الجهاد"
"33510","(۳۳۵۱۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ، عَنْ زَیْدِ بْنِ أَسْلَمَ، عْن أَبِیہِ، قَالَ: بُشِّرَ عُمَرُ بِفَتْحٍ فَسَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 33510","","","كتاب الجهاد"
"33511","(۳۳۵۱۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مِسْعَرٍ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ أَنَّ أَبَا بَکْرٍ أَتَاہُ فَتْحٌ فَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 33511","","","كتاب الجهاد"
"33512","(۳۳۵۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ : أَنَّ أَبَا بَکْرٍ لَمَّا أَتَاہُ فَتْحُ الْیَمَامَۃِ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 33512","","","كتاب الجهاد"
"33513","(۳۳۵۱۳) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِی مُوسَی ، قَالَ : رَأَیْتُ عَلِیًّا حِینَ أُتِیَ بِالْمُخَدَّجِ سَجَدَ سَجْدَۃَ شُکْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33513","","","كتاب الجهاد"
"33514","(۳۳۵۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ الْہَمْدَانِیِّ ، عَنْ شَیْخٍ لَہُمْ یُکْنَی أَبَا مُوسَی ، قَالَ : شَہِدْت عَلِیًّا لَمَّا أُتِیَ بِالْمُخَدَّجِ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 33514","","","كتاب الجهاد"
"33515","(۳۳۵۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عُبَیْدٍ الْعِجْلِیّ ، عَنْ أَبِی مؤمن الواثلی، قَالَ : شَہِدْت عَلِیًّا أُتِیَ بِالْمُخَدَّجِ فَسَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 33515","","","كتاب الجهاد"
"33516","(۳۳۵۱۶) حَدَّثَنَا وَکِیعٌ قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ الثَّقَفِیِّ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِہِ رَجُلٌ وَبِہِ زَمَانَۃٌ فَسَجَدَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ۔","","Musannaf Ibn Abi Shaybah 33516","","","كتاب الجهاد"
"33517","(۳۳۵۱۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : مَرَّ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ قَصِیرٌ ، قَالَ : فَسَجَدَ سَجْدَۃَ الشُّکْرِ ، وَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی لَمْ یَجْعَلْنِی مَثَل زُنَیم۔","Da'if","Musannaf Ibn Abi Shaybah 33517","","","كتاب الجهاد"
"33518","(۳۳۵۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِنُغَاشٍ فَسَجَدَ ، وَقَالَ : سَلُوا اللَّہَ الْعَافِیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 33518","","","كتاب الجهاد"
"33519","(۳۳۵۱۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : حَدَّثْت أَنَّ أَبَا بَکْرٍ سَجَدَ سَجْدَۃَ الشُّکْرِ ، وَکَانَ إبْرَاہِیمُ یَکْرَہُہَا۔","","Musannaf Ibn Abi Shaybah 33519","","","كتاب الجهاد"
"33520","(۳۳۵۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمِ ، قَالَ : سَجْدَۃُ الشُّکْرِ بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 33520","","","كتاب الجهاد"
"33521","(۳۳۵۲۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا الْکَلْبِیُّ ، عَنْ أَبِی صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمَّا نَزَلَ نِکَاحُ زَیْنَبَ انْطَلَقَ زَیْدُ بْنُ حَارِثَۃَ حَتَّی اسْتَأْذَنَ عَلَی زَیْنَبَ ، قَالَ : فَقَالَتْ زَیْنَبُ : مَا لِی وَلِزَیْدٍ ، قَالَ : فَأَرْسَلَ إلَیْہَا إِنِّی رَسُولُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَأَذِنَتْ لَہُ فَبَشَّرَہَا أَنَّ اللَّہَ زَوَّجَہَا مِنْ نَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَخَرَّتْ سَاجِدَۃً شُکْرًا لِلَّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33521","","","كتاب الجهاد"
"33522","(۳۳۵۲۲) حَدَّثَنَا ہُشَیمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ سَجْدَۃَ الْفَرَحِ وَیَقُولُ : لَیْسَ فِیہَا رُکُوعٌ ، وَلاَ سُجُودٌ۔","","Musannaf Ibn Abi Shaybah 33522","","","كتاب الجهاد"
"33523","(۳۳۵۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ زَرْبِیٍّ ، قَالَ : حَدَّثَنا الرَّیَّانُ بْنُ صَبِرَۃَ الْحَنَفِیُّ أَنَّہُ شَہِدَ یَوْمَ النَّہْرَوَانِ ، قَالَ : وَکُنْت فِیمَنَ اسْتَخْرَجَ ذَا الثُّدَیَّۃِ فَبُشِّرَ بِہِ عَلِیٌّ قَبْلَ أَنْ یَنْتَہِیَ إلَیْہِ ، قَالَ : فَانْتَہَینا إلَیْہِ وَہُوَ سَاجِدٌ فَرَحًا بہ۔","Da'if","Musannaf Ibn Abi Shaybah 33523","","","كتاب الجهاد"
"33524","(۳۳۵۲۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ قَیْسِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أبی صَعْصَعَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عَلِیٍّ ، عَنْ جَدِّہِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : انْتَہَیْت إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ سَاجِدٌ ، فَلَمَّا انْصَرَفَ قُلْتُ : یَا رَسُولَ اللہِ : أَطَلْتَ السُّجُودَ ، قَالَ : إنِّی سَجَدْتُ شُکْرًا لِلَّہِ فِیمَا أَبْلاَنِی فی أُمَّتِی۔","Da'if","Musannaf Ibn Abi Shaybah 33524","","","كتاب الجهاد"
"33525","(۳۳۵۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، قَالَ : سَأَلَ رَجُلٌ عَطَائً ، عَنْ رَجُلٍ أَسَرَتْہُ الدَّیْلَمُ فَأَخَذُوا مِنْہُ عَہْدَ اللہِ وَمِیثَاقَہُ عَلَی أَنْ یُرْسِلُوہُ ، فَإِنْ بُعِثَ إلَیْہِمْ بفداء قد سموہ فَہُوَ بَرِیئٌ ، وَإِنْ لَمْ یُبْعَثْ إلَیْہِمْ کَانَ عَلَیْہِ الْعَہْدُ وَالْمِیثَاقُ أَنْ یَرْجِعَ إلَیْہِمْ فَلَمْ یَجِد ، وَکَانَ مُعْسِرًا ، قَالَ یفی بِالْعَہْدِ ، فَقَالَ : إنَّہُمْ أَہْلُ شِرْک ، فَأَبَی عَطَائٌ إِلاَّ أَنْ یَفِیَ بِالْعَہْدِ۔","","Musannaf Ibn Abi Shaybah 33525","","","كتاب الجهاد"
"33526","(۳۳۵۲۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ جَامِعِ بْنِ أَبِی رَاشِدٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : ثَلاَثٌ یُؤَدَّیْنَ إلَی الْبَرِّ وَالْفَاجِرِ : الرَّحِمُ یُوصَلُ بَرَّۃً کَانَتْ ، أَوْ فَاجِرَۃً ، وَالأَمَانَۃُ تُؤَدِّیہَا إلَی الْبَرِّ وَالْفَاجِرِ ، وَالْعَہْدُ یُوَفَّی بِہِ لِلْبَرِّ وَالْفَاجِرِ۔","","Musannaf Ibn Abi Shaybah 33526","","","كتاب الجهاد"
"33527","(۳۳۵۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، قَالَ : حدَّثَنَا أَبُو الطُّفَیْلِ ، قَالَ : حَدَّثَنَا حُذَیْفَۃُ بْنُ الْیَمَانِ ، قَالَ : مَا مَنَعَنِی أَنْ أَشْہَدَ بَدْرًا إِلاَّ أَنِّی خَرَجْت أَنَا ، وَأَبِی حُسَیْلٍ ، قَالَ : فَأَخَذَنَا کُفَّارُ قُرَیْشٍ فَقَالُوا : إنَّکُمْ تُرِیدُونَ مُحَمَّدًا فَقُلْنَا : مَا نُرِیدُہُ ، مَا نُرِیدُ إِلاَّ الْمَدِینَۃَ ، فَأَخَذُوا مِنَّا عَہْدَ اللہِ وَمِیثَاقَہُ لَنَنْصَرِفَنَّ إلَی الْمَدِینَۃِ، وَلاَ نُقَاتِلُ مَعَہُ ، فَأَتَیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْنَاہُ الْخَبَرَ ، فَقَالَ : انْصَرِفَا ، نَفِی لَہُمْ وَنَسْتَعِینُ اللَّہَ عَلَیْہِمْ۔ (مسلم ۱۴۱۴۔ احمد ۳۹۵)","Hasan","Musannaf Ibn Abi Shaybah 33527","","","كتاب الجهاد"
"33528","(۳۳۵۲۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدَۃُ بْنِ أَبِی لُبَابَۃَ أَنَّہُ قَالَ فِی الْعَبْدِ إذَا أَبَقَ إلَی أَرْضِ الْعَدُوِّ : لاَ یقبل حَتَّی یَأْوِیَ إلَی حِرْزٍ ، وَیُرَدُّ إلَی مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 33528","","","كتاب الجهاد"
"33529","(۳۳۵۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنِ الْمُغِیرَۃِ بْنِ شِبْلٍ ، عَنْ جَرِیرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَبَقَ الْعَبْدُ إلَی أرض الْعَدُوِّ بَرِئَتْ مِنْہُ الذِّمَّۃُ۔n(احمد ۳۵۷۔ حمیدی ۸۰۶)","Sahih","Musannaf Ibn Abi Shaybah 33529","","","كتاب الجهاد"
"33530","(۳۳۵۳۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، عَنِ الشَّعْبِیِّ، عَنْ جَرِیرٍ، قَالَ: مَعَ کُلِّ أَبْقَۃٍ کَفْرَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 33530","","","كتاب الجهاد"
"33531","(۳۳۵۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ عَامِرٍ ، عَنْ جَرِیرٍ ، قَالَ : إذَا أَبَقَ إلَی الْعَدُوِّ فَقَدْ حَلَّ دَمُہُ ، یَعْنِی إلَی دَارِ الْحَرْبِ۔","Sahih","Musannaf Ibn Abi Shaybah 33531","","","كتاب الجهاد"
"33532","(۳۳۵۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنْ جَرِیرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : أَیُّمَا عَبْدٍ أَبَقَ إلَی أَرْضِ الْعَدُوِّ فَقَدْ بَرِئَتْ مِنْہُ الذِّمَّۃُ۔ (طبرانی ۲۳۶۰۔ احمد ۳۶۵)","Da'if","Musannaf Ibn Abi Shaybah 33532","","","كتاب الجهاد"
"33533","(۳۳۵۳۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سُئِلَ عَلِیٌّ ، عَنْ مُکَاتَبٍ سَبَاہُ الْعَدُوُّ ، ثُمَّ اشْتَرَاہُ رَجُلٌ مِنَ الْمُسْلِمِینَ ، قَالَ : فَقَالَ : إِنْ أَحَبَّ مَوْلاَہُ أَنْ یَفتکَّہُ فَیَکُونَ عِنْدَہُ عَلَی مَا بَقِیَ مِنْ مُکَاتَبَتِہِ وَیَکُونُ لَہُ الْوَلاَئُ ، وَإِنْ کَرِہَ ذَلِکَ کَانَ عِنْدَ الَّذِی اشْتَرَاہُ عَلَی ہَذِہ الْحَالِ۔","","Musannaf Ibn Abi Shaybah 33533","","","كتاب الجهاد"
"33534","(۳۳۵۳۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا عَبَّادٌ ، قَالَ : أَخْبَرَنِی مَکْحُولٌ ، قَالَ فِی مُکَاتَبٍ أَسَرَہُ الْعَدُوُّ فَاشْتَرَاہُ رَجُلٌ مِنَ التُّجَّارِ فکَاتَبَہُ ، قَالَ : یُؤَدِّی مُکَاتَبَۃَ الأَوَّلِ ، ثُمَّ یُؤَدِّی مُکَاتَبَۃَ الآخَرِ۔","","Musannaf Ibn Abi Shaybah 33534","","","كتاب الجهاد"
"33535","(۳۳۵۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ أَنَّہُ قَدِمَ عَلَی عُمَرَ مِنَ الْبَحْرَیْنِ ، قَالَ : فَقَدِمْت عَلَیْہِ فَصَلَّیْت مَعَہُ الْعِشَائَ ، فَلَمَّا رَآنِی سَلَّمْت عَلَیْہِ ، فَقَالَ : مَا قَدِمْت بِہِ قُلْتُ : قَدِمْت بِخَمْسِمِئَۃِ أَلْفٍ ، قَالَ : تَدْرِی مَا تَقُولُ ، قَالَ : قَدِمْت بِخَمْسِمِئَۃِ أَلْفٍ ، قَالَ : قُلْتُ : مِئَۃَ أَلْفٍ ومِئَۃَ أَلْفٍ ومِئَۃَ أَلْفٍ ومِئَۃَ أَلْفٍ ومِئَۃَ أَلْفٍ حَتَّی عَدَّ خَمْسًا ، قَالَ : إنَّک نَاعِسٌ ، ارْجِعْ إلَی بَیْتِکَ فَنَمْ ، ثُمَّ اغْدُ عَلَیَّ ، قَالَ : فَغَدَوْت عَلَیْہِ ، فَقَالَ : مَا جِئْت بِہِ قُلْتُ : بِخَمْسِمِئَۃِ أَلْفٍ ، قَالَ : طَیِّبٌ ، قُلْتُ : طَیِّبٌ ، لاَ أَعْلَمُ إِلاَّ ذَاکَ ، قَالَ : فَقَالَ لِلنَّاسِ : إِنَّہُ قَدِمَ عَلَیَّ مَالٌ کَثِیرٌ فَإِنْ شِئْتُمْ أَنْ نَعُدَّہُ لَکُمْ عَدًّا ، وَإِنْ شِئْتُمْ أَنْ نَکِیلَہُ لَکُمْ کَیْلاً ، فَقَالَ رَجُلٌ : یَا أَمِیرَ الْمُؤْمِنِینَ إنِّی رَأَیْت ہَؤُلاَئِ الأَعَاجِمَ یُدَوِّنُونَ دِیوَانًا وَیُعْطُونَ النَّاسَ عَلَیْہِ ، قَالَ : فَدَوَّنَ الدِّیوان وَفَرَضَ لِلْمُہَاجِرِینَ فِی خَمْسَۃِ آلاَفٍ خَمْسَۃَ آلاَفٍ وَلِلأَنْصَارِ فِی أَرْبَعَۃِ آلاَفٍ أَرْبَعَۃَ آلاَفٍ ، وَفَرَضَ لأَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی اثْنَیْ عَشَرَ أَلْفًا اثْنَیْ عَشَرَ أَلْفًا۔","Hasan","Musannaf Ibn Abi Shaybah 33535","","","كتاب الجهاد"
"33536","(۳۳۵۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : فَرَضَ عُمَرُ لأَہْلِ بَدْرٍ عَرِبیہِمْ وَمَوْلاَہُمْ فِی خَمْسَۃِ آلاَفٍ خَمْسَۃَ آلاَفٍ ، وَقَالَ : لأُفَضِّلَنَّہُمْ عَلَی مَنْ سِوَاہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33536","","","كتاب الجهاد"
"33537","(۳۳۵۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ أَنَّ عُمَرَ بْنَ الْخَطَّابِ فَرَضَ لأہل بدر فِی سِتَّۃِ آلاَفٍ سِتَّۃَ آلاَفٍ ، وَفَرَضَ لأُمَّہَاتِ الْمُؤْمِنِینَ فِی عَشْرَۃِ آلاَفٍ عَشْرَۃَ آلاَفٍ ، فَفَضَّلَ عَائِشَۃَ بِأَلْفَیْنِ لِحُبِّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إیَّاہَا إِلاَّ السَّبِیَّتَیْنِ صَفِیَّۃَ بِنْتَ حُیَیٍّ وَجُوَیْرِیَۃَ بِنْتَ الْحَارِثِ فَرَضَ لَہما سِتَّۃَ آلاَفٍ ، وَفَرَضَ لِنِسَائٍ مِنْ نِسَائِ الْمُؤْمِنِینَ فِی أَلْفٍ أَلْفٍ مِنْہُمْ أُمُّ عَبْدٍ۔","","Musannaf Ibn Abi Shaybah 33537","","","كتاب الجهاد"
"33538","(۳۳۵۳۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ بْنِ قَیْسٍ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ عَلِیًّا بِابْنِ عَمٍّ لِی ، فَقُلْتُ: یَا أَمِیرَ الْمُؤْمِنِینَ ، افْرِضْ لِہَذَا ، قَالَ : أَرْبَعٌ ، یَعْنِی أَرْبَعَمِئَۃٍ ، قَالَ : قُلْتُ : إنَّ أَرْبَعَمِئَۃٍ لاَ تُغْنِی شَیْئًا ، زِدْہُ الْمِائَتَیْنِ الَّتِی زِدْت النَّاسَ ، قَالَ : فَذَاکَ لَہُ ، قَالَ : وَقَدْ کَانَ زَادَ النَّاسَ مِئَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 33538","","","كتاب الجهاد"
"33539","(۳۳۵۳۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی أَبُو مَعْشَرٍ ، قَالَ : حَدَّثَنِی عُمَرُ مَوْلَی غُفْرَۃَ وَغَیْرُہُ ، قَالَ : لَمَّا تُوُفِّیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَائَہُ مَالٌ مِنَ الْبَحْرَیْنِ ، فَقَالَ أَبُو بَکْرٍ : مَنْ کَانَ لَہُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَیْئٌ ، أَوْ عِدَّۃٌ فَلْیَقُمْ فَلْیَأْخُذْ ، فَقَامَ جَابِرٌ ، فَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إِنْ جَائَنِی مَالٌ مِنَ الْبَحْرَیْنِ لأعْطَیْتُک ہَکَذَا وَہَکَذَا ثَلاَثَ مِرَارٍ وَحَثَی بِیَدِہِ ، فَقَالَ لَہُ أَبُو بَکْرٍ : قُمْ فَخُذْ بِیَدِکَ فَأَخَذَ فَإِذَا ہِیَ خَمْسُمِئَۃِ دِرْہَمٍ فَقَالَ : عُدُّوا لَہُ أَلْفًا ، وَقَسَمَ بَیْنَ النَّاسِ عَشَرَۃَ دَرَاہِمَ عَشَرَۃَ دَرَاہِمَ ، وَقَالَ : إنَّمَا ہَذِہِ مَوَاعِیدُ وَعَدَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّاسَn۲۔ حَتَّی إذَا کَانَ عَامٌ مُقْبِلٌ ، جَائَہُ مَالٌ أَکْثَرُ مِنْ ذَلِکَ الْمَالِ ، فَقَسَمَ بَیْنَ النَّاسِ عِشْرِینَ دِرْہَمًا عِشْرِینَ دِرْہَمًا، وَفَضَلَتْ مِنْہُ فَضْلَۃٌ، فَقَسَمَ لِلْخَدَمِ خَمْسَۃَ دَرَاہِمَ خَمْسَۃَ دَرَاہِمَ، وَقَالَ: إنَّ لَکُمْ خُدَّامًا یَخْدُمُونَکُمْ وَیُعَالِجُونَ لَکُمْ، فَرَضَخْنَا لَہُمْ، فَقَالُوا: لَوْ فَضَّلْت الْمُہَاجِرِینَ وَالأَنْصَارَ لِسَابِقَتِہِمْ، وَلِمَکَانِہِمْ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَقَالَ: أَجْرُ أُولَئِکَ عَلَی اللہِ ، إنَّ ہَذَا الْمَعَاشَ للأُسْوَۃُ فِیہِ خَیْرٌ مِنَ الأَثَرَۃِ ، قَالَ: فَعَمِلَ بِہَذَا وِلاَیَتَہُ حَتَّی إذَا کَانَتْ سَنَۃُ ثَلاَثَ عَشْرَۃَ فِی جُمَادَی الآخِرَۃِ فی لَیَالٍ بَقِینَ مِنْہُ مَاتَ رضی اللَّہُ عَنْہُ۔n۳۔ فَعَمِلَ عُمَرُ بْنُ الْخَطَّابِ فَفَتَحَ الْفُتُوحَ وَجَائَتْہُ الأَمْوَالُ ، فَقَالَ : إنَّ أَبَا بَکْرٍ رَأَی فِی ہَذَا الأَمْرِ رَأْیًا ، وَلِی فِیہِ رَأْیٌ آخَرُ لاَ أَجْعَلُ مَنْ قَاتَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَمَنْ قَاتَلَ مَعَہُ ، فَفَرَضَ لِلْمُہَاجِرِینَ وَالأَنْصَارِ مِمَّنْ شَہِدَ بَدْرًا خَمْسَۃَ آلاَفٍ خَمْسَۃَ آلاَفٍ ، وَفَرَضَ لِمَنْ کَانَ لَہُ الإِسْلاَمُ کَإِسْلاَمِ أَہْلِ بَدْرٍ وَلَمْ یَشْہَدْ بَدْرًا أَرْبَعَۃَ آلاَفٍ أَرْبَعَۃَ آلاَفٍ۔n۴۔ وَفَرَضَ لأَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اثْنَیْ عَشَرَ أَلْفًا اثْنَیْ عَشَرَ أَلْفًا إِلاَّ صَفِیَّۃَ وَجُوَیْرِیَۃَ ، فَرَضَ لَہُمَا سِتَّۃَ آلاَفٍ سِتَّۃَ آلاَفٍ ، فَأَبَتَا أَنْ تَقْبَلا فَقَالَn لَہُمَا : إنَّمَا فَرَضْت لَہُنَّ لِلْہِجْرَۃِ ، فَقَالَتَا : إنَّمَا فَرَضْت لَہُنَّ لِمَکَانِہِنَّ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَانَ لَنَا مِثْلُہُ ، فَعَرَفَ ذَلِکَ عُمَرُ فَفَرَضَ لَہُمَا اثْنَیْ عَشَرَ أَلْفًا اثْنَیْ عَشَرَ أَلْفًا۔n۵۔ وَفَرَضَ لِلْعَبَّاسِ اثْنَیْ عَشَرَ أَلْفًا ، وَفَرَضَ لأسَامَۃَ بْنَ زَیْدٍ أَرْبَعَۃَ آلاَفٍ ، وَفَرَضَ لِعَبْدِ اللہِ بْنِ عُمَرَ ثَلاَثَۃَ آلاَفٍ ، فَقَالَ : یَا أَبَتِ ، لِمَ زِدْتہ عَلَیَّ أَلْفًا مَا کَانَ لأَبِیہِ مِنَ الْفَضْلِ مَا لَمْ یَکُنْ لأَبِی ، وَمَا کَانَ لَہُ لَمْ یَکُنْ لِی، فَقَالَ : إنَّ أَبَا أُسَامَۃَ کَانَ أَحَبَّ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ أَبِیک وَکَانَ أُسَامَۃُ أَحَبَّ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْک وَفَرَضَ لِحَسَنٍ وَحُسَیْنٍ خَمْسَۃَ آلاَفٍ خَمْسَۃَ آلاَفٍ ، أَلْحَقَہُمَا بِأَبِیہِمَا لِمَکَانِہِمَا مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n۶۔ وَفَرَضَ لأَبْنَائِ الْمُہَاجِرِینَ وَالأَنْصَارِ أَلْفَیْنِ أَلْفَیْنِ ، فَمَرَّ بِہِ عُمَرُ بْنُ أَبِی سَلَمَۃَ ، فَقَالَ : زِیدُوہُ أَلْفًا ، فَقَالَ لَہُ مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ جَحْشٍ : مَا کَانَ لأَبِیہِ مَا لَمْ یَکُنْ لأبِینا ، وَمَا کَانَ لَہُ مَا لَمْ یَکُنْ لَنَا ، فَقَالَ : إنِّی فَرَضْت لَہُ بِأَبِیہِ أَبِی سَلَمَۃَ أَلْفَیْنِ ، وَزِدْتہ بِأُمِّہِ أُمِّ سَلَمَۃَ أَلْفًا ، فَإِنْ کَانَتْ لَکَ أُمٌّ مِثْلُ أُمِّہِ زِدْتُک الْفًا ۔n۷۔ وَفَرَضَ لأَہْلِ مَکَّۃَ وَلِلنَّاسِ ثَمَانِمِئَۃٍ ثَمَانِمِئَۃٍ ، فَجَائَہُ طَلْحَۃُ بْنُ عُبَیْدِ اللہِ بِأَخِیہِ عُثْمَانَ ، فَفَرَضَ لَہُ ثَمَانِمِئَۃٍ ، فَمَرَّ بِہِ النَّضْرُ بْنُ أَنَسٍ ، فَقَالَ عُمَرُ : افْرِضُوا لَہُ فِی أَلْفَیْنِ ، فَقَالَ طَلْحَۃُ : جِئْتُک بِمِثْلِہِ فَفَرَضْت لَہُ ، ثَمَانِمِئَۃِ دِرْہَمٍ وَفَرَضْت لِہَذَا أَلْفَیْنِ ، فَقَالَ : إنَّ أَبَا ہَذَا لَقِیَنِی یَوْمَ أُحُدٍ فَقَالَ لِی : مَا فَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقُلْتُ : مَا أُرَاہُ إِلاَّ قَدْ قُتِلَ ، فَسَلَّ سَیْفَہُ فَکَسَرَ غِمْدَہُ وَقَالَ : إِنْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَدْ قُتِلَ فَإِنَّ اللَّہَ حَیٌّ لاَ یَمُوتُ ، فَقَاتَلَ حَتَّی قُتِلَ ، وَہَذَا یَرْعَی الشَّائَ فِی مَکَانِ کَذَا وَکَذَا۔n۸۔ فَعَمِلَ عُمَرُ بَدَء خِلاَفَتِہِ حَتَّی کَانَتْ سَنَۃُ ثَلاَثٍ وَعِشْرِینَ حَجَّ تِلْکَ السَّنَۃَ فَبَلَغَہُ أَنَّ النَّاسَ یَقُولُونَ : لَوْ مَاتَ أَمِیرُ الْمُؤْمِنِینَ قُمْنَا إلَی فُلاَنٍ فَبَایَعْنَاہُ ، وَإِنْ کَانَتْ بَیْعَۃُ أَبِی بَکْرٍ فَلْتَۃً ، فَأَرَادَ أَنْ یَتَکَلَّمَ فِی أَوْسَطِ أَیَّامِ التَّشْرِیقِ ، فَقَالَ لَہُ عَبْدُ الرَّحْمَن بْنُ عَوْفٍ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنَّ ہَذَا مَکَانٌ یَغْلِبُ عَلَیْہِ غَوْغَائُ النَّاسِ وَدَہْمُہُمْ وَمَنْ لاَ یَحْمِلُ کَلاَمُک مَحْمَلَہُ ، فَارْجِعْ إلَی دَارِ الْہِجْرَۃِ وَالإِیمَانِ ، فَتَکَلَّمْ فَیُسْتَمَعُ کَلاَمُک ، فَأَسْرَعَ فَقَدِمَ الْمَدِینَۃَ فَخَطَبَ النَّاسَ ، وَقَالَ :n۹۔ أَیُّہَا النَّاسُ ، أَمَّا بَعْدُ فَقَدْ بَلَغَنِی قَالَۃُ قَائِلُکُمْ : لَوْ مَاتَ أَمِیرُ الْمُؤْمِنِینَ قُمْنَا إلَی فُلاَنٍ فَبَایَعْنَاہُ وَإِنْ کَانَتْ بَیْعَۃُ أَبِی بَکْرٍ فَلْتَۃً ، وَایْمُ اللہِ إِنْ کَانَتْ لَفَلْتَۃً وَقَانَا اللَّہُ شَرَّہَا فَمِنْ أَیْنَ لَنَا مِثْلُ أَبِی بَکْرٍ نَمُدُّ أَعْنَاقَنَا إلَیْہِ کَمَدِّنَا إلَی أَبِی بَکْرٍ ، إنَّمَا ذَاکَ تَغِرَّۃٌ لِیُقْتَلَ ، مَنْ انتزع أُمُورِ الْمُسْلِمِینَ مِنْ غَیْرِ مَشُورَۃٍ فَلاَ بَیْعَۃَ لَہُ۔n۱۰۔ أَلاَ وَإِنِّی رَأَیْت رُؤْیَا ، وَلاَ أَظُنُّ ذَاکَ إِلاَّ عِنْدَ اقْتِرَابِ أَجَلِی ، رَأَیْت دِیکًا تراء ی لِی فَنَقَرَنِی ثَلاَثَ نَقَرَاتٍ ، فَتَأَوَّلَتْ لِی أَسْمَائُ بِنْتُ عُمَیْسٍ ، قَالَتْ : یَقْتُلُک رَجُلٌ مِنْ أَہْلِ ہَذِہِ الْحَمْرَائِ ، فَإِنْ أَمُتْ فَأَمْرُکُمْ إلَی ہَؤُلاَئِ السِّتَّۃِ الَّذِینَ تُوُفِّیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ عَنْہُمْ رَاضٍ : إلَی عُثْمَانَ وَعَلِیٍّ وَطَلْحَۃَ وَالزُّبَیْرِ ، وَعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَسَعْدِ بْنِ أَبِی وَقَّاصٍ ، فَإِنَ اخْتَلَفُوا فَأَمْرُہُمْ إلَی عَلِی ، وَإِنْ أَعِشْ فَسَأُوصِی۔n۱۱۔ وَنَظَرْت فِی الْعَمَّۃِ وَبِنْتِ الأَخِ مَا لَہُمَا ، تُورِثَانِ ، وَلاَ تَرِثَانِ ، وَإِنْ أَعِشْ فَسَأَفْتَحُ لَکُمْ أَمْرًا تَأْخُذُونَ بِہِ ، وَإِنْ أَمُتْ فَسَتَرَوْنَ رَأْیَکُمْ ، وَاللَّہُ خَلِیفَتِی فِیکُمْ ، وَقَدْ دَوَّنْت لَکُمْ الدَّوَاوِینَ ، وَمَصَّرْت لَکُمُ الأَمْصَارَ ، وَأَجْرَیْت لَکُمُ الطَّعَامَ إِلَی الْخَان وَتَرَکْتُکُمْ عَلَی وَاضِحَۃٍ ، وَإِنَّمَا أَتَخَوَّفُ عَلَیْکُمْ رَجُلَیْنِ رَجُلاً قَاتَلَ عَلَی تَأْوِیلِ ہَذَا الْقُرْآنِ یُقْتَلُ ، وَرَجُلاً رَأَی أَنَّہُ أَحَقُّ بِہَذَا الْمَالِ مِنْ أَخِیہِ فَقَاتَلَ عَلَیْہِ حَتَّی قُتِلَ۔n۱۲۔ فَخَطَبَ نَہَارَ الْجُمُعَۃِ وَطُعِنَ یَوْمَ الأَرْبِعَائِ۔ (بیہقی ۳۵۰۔ بزار ۱۷۳۶)","Da'if","Musannaf Ibn Abi Shaybah 33539","","","كتاب الجهاد"
"33540","(۳۳۵۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ الْمَسْعُودِیِّ، عَنِ الْقَاسِمِ بْنِ عَبْدِالرَّحْمَنِ، قَالَ: کَانَ عَطَائُ عَبْدِاللہِ سِتَّۃَ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33540","","","كتاب الجهاد"
"33541","(۳۳۵۴۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ مُجَاہِدٍ ، قَالَ : فَرَضَ عُمَرُ لأَہْلِ بَدْرٍ فِی سِتَّۃِ آلاَفٍ سِتَّۃَ آلاَفٍ ، وَفَرَضَ لأَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 33541","","","كتاب الجهاد"
"33542","(۳۳۵۴۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ أَنَّ عُمَرَ جَعَلَ عَطَائَ سَلْمَانَ سِتَّۃَ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 33542","","","كتاب الجهاد"
"33543","(۳۳۵۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَحْیَی بْنِ عَمْرِو بْنِ سَلِمَۃَ الْہَمْدَانِیِّ ، عَنْ أَبِیہِ ، عنْ عَبِیْدَۃَ السَّلْمَانِیِّ ، قَالَ : قَالَ لِی عُمَرُ : کَمْ تَرَی الرَّجُلَ یَکْفِیہِ مِنْ عَطَائِہِ ، قَالَ : قُلْتُ : کَذَا وَکَذَا ، قَالَ : لأَنْ بَقِیتُ لأَجْعَلَنَّ عَطَائَ الرَّجُلِ أَرْبَعَۃَ آلاَفٍ : أَلْفًا لِسِلاَحِہِ ، وَأَلْفًا لِنَفَقَتِہِ ، وَأَلْفًا یَجْعَلُہَا فِی بَیْتِہِ وَأَلْفًا لِکَذَا وَکَذَا أَحْسِبُہُ قَالَ لِفَرَسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 33543","","","كتاب الجهاد"
"33544","(۳۳۵۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ شَیْخٍ لَہُمْ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : لَئِنْ بَقِیت إلَی قَابِلٍ لألْحِقَنَّ سِفْلَۃ الْمُہَاجِرِینَ فِی أَلْفَیْنِ أَلْفَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 33544","","","كتاب الجهاد"
"33545","(۳۳۵۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ سَمِعْت عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : لَئِنْ بَقِیت إلَی قَابِلٍ لأُلْحِقَنَّ أُخْرَی النَّاسِ بِأُولاَہُمْ وَلأَجْعَلَنہُمْ بَیَانًا وَاحِدًا۔","Hasan","Musannaf Ibn Abi Shaybah 33545","","","كتاب الجهاد"
"33546","(۳۳۵۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، قَالَ حَدَّثَتْنِی وَالِدَتِی أُمُّ الْحَکَمِ أَنَّ عَلِیًّا أَلْحَقَہَا فِی مِئَۃ مِنَ الْعَطَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 33546","","","كتاب الجهاد"
"33547","(۳۳۵۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الْحُوَیْرِثِ أَنَّ عُمَرَ فَرَضَ لِلْعَبَّاسِ سَبْعَۃَ آلاَفٍ ، وَلِعَائِشَۃَ وَحَفْصَۃَ عَشْرَۃَ آلاَفٍ ، وَلأمِّ سَلَمَۃَ وَأُمِّ حَبِیبَۃَ وَمَیْمُونَۃَ وَسَوْدَۃَ ، ثَمَانیَۃَ آلاَفٍ ، ثَمَانیَۃَ آلاَفٍ ، وَفَرَضَ لِجُوَیْرِیَۃَ وَصَفِیَّۃَ سِتَّۃَ آلاَفٍ سِتَّۃَ آلاَفٍ ، وَفَرَضَ لِصَفِیَّۃَ بِنْتِ عَبْدِ الْمُطَّلِبِ نِصْفَ مَا فَرَضَ لَہُنَ ، فَأَرْسَلَتْ أُمُّ سَلَمَۃَ وَصَوَاحِبُہَا إلَی عُثْمَانَ بْنِ عَفَّانَ فَقُلْنَ لَہُ : کَلِّمْ عُمَرَ فِینَا فَإِنَّہُ قَدْ فَضَّلَ عَلَیْنَا عَائِشَۃَ وَحَفْصَۃَ فَجَائَ عُثْمَان إلَی عُمَرَ ، فَقَالَ : إنَّ أُمَّہَاتِکَ یَقُلْنَ لَکَ : سَوِّ بَیْنَنَا ، لاَ تُفَضِّلْ بَعْضَنَا عَلَی بَعْضٍ ، فَقَالَ : إِنْ عِشْت إلَی الْعَامِ الْقَابِلِ زِدْتہنَّ لِقَابِلٍ أَلْفَیْنِ أَلْفَیْنِ فَلَمَّا کَانَ الْعَامُ الْقَابِلُ جَعَلَ عَائِشَۃَ وَحَفْصَۃَ فِی اثْنَیْ عَشَرَ أَلْفًا اثْنَیْ عَشَرَ أَلْفًا ، وَجَعَلَ أُمَّ سَلَمَۃَ وَأُمَّ حَبِیبَۃَ فِی عَشْرَۃِ آلاَفٍ ، عَشْرَۃِ آلاَفٍ ، وَجَعَلَ صَفِیَّۃَ وَجُوَیْرِیَۃَ فِی ثَمَانِیَۃِ آلاَفٍ ، ثَمَانِیَۃِ آلاَفٍ ، فَلَمَّا رَأَیْنَ ذَلِکَ سَکَتْنَ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33547","","","كتاب الجهاد"
"33548","(۳۳۵۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبِی أَنَّ عُمَرَ بْنَ الْخَطَّابِ فَرَضَ لِجُبَیْرِ بْنِ مُطْعِمٍ وَضُرَبَائِہِ أَرْبَعَۃَ آلاَفٍ أَرْبَعَۃَ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 33548","","","كتاب الجهاد"
"33549","(۳۳۵۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ عن ابْنَ جُرَیْجٍ ، قَالَ : قَالَ أَبُوبَکْرٍ: أُرَاہُ قَدْ ذَکَرَ لَہُ إسْنَادًا: أَنَّ عُمَرَ بْنَ الْخَطَّابِ فَرَضَ لأسَامَۃَ بْنِ زَیْدٍ ثَلاَثَۃَ آلاَفٍ وَخَمْسَمِئَۃٍ وَلِعَبْدِ اللہِ بْنِ عُمَرَ ثَلاَثَۃَ آلاَفٍ ، فَقَالَ عَبْدُ اللہِ لِعُمَرَ : فَرَضْت لأسَامَۃَ ثَلاَثَۃَ آلاَفٍ وَخَمْسَمِئَۃٍ ، وَمَا ہُوَ بِأَقْدَمَ مِنِّی إسْلاَمًا ، وَلاَ شَہِدَ مَا لَمْ أَشْہَدْ ، قَالَ : فَقَالَ : عُمَرُ : لأَنَّ زَیْدَ بْنَ حَارِثَۃَ کَانَ أَحَبَّ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ أَبِیک وَکَانَ أُسَامَۃُ بْنُ زَیْدٍ أَحَبَّ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْک فَلِذَلِکَ زِدْتہ عَلَیْک خَمْسَمِئَۃٍ۔ (بزار ۱۵۰۔ ابویعلی ۱۵۷)","","Musannaf Ibn Abi Shaybah 33549","","","كتاب الجهاد"
"33550","(۳۳۵۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمِ بْنِ سُلَیْمَانَ ، عَنْ أَبِی الزِّنَادِ ، قَالَ : أَعْطَانَا عُمَرُ دِرْہَمًا دِرْہَمًا ، ثُمَّ أَعْطَانَا دِرْہَمَیْنِ دِرْہَمَیْنِ ، یَعْنِی قَسَمَ بَیْنَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33550","","","كتاب الجهاد"
"33551","(۳۳۵۵۱) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ، عَنْ أَنَسِ بْنِ مَالِکٍ، وَسَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَتَبَ الْمُہَاجِرِینَ عَلَی خَمْسَۃِ آلاَفٍ وَالأَنْصَارَ عَلَی أَرْبَعَۃِ آلاَفٍ ، وَمَنْ لَمْ یَشْہَدْ بَدْرًا مِنْ أَوْلاَدِ الْمُہَاجِرِینَ عَلَی أَرْبَعَۃِ آلاَفٍ ، وَکَانَ مِنْہُمْ أُسَامَۃُ بْنُ زَیْدٍ وَمُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ جَحْشٍ ، وَعُمَرُ بْنُ أَبِی سَلَمَۃَ ، وَعَبْدُ اللہِ بْنُ عُمَرَ ، قَالَ عَبْدُ الرَّحْمَن بْنُ عَوْفٍ : إنَّ عَبْدَ اللہِ لَیْسَ مِثْلَ ہَؤُلاَئِ ، إنَّ عَبْدَ اللہِ مَنْ أَمْرِہ مَنْ أَمْرِہ ، فَقَالَ عَبْدُ اللہِ بْنُ عُمَرَ لِعُمَرَ : إِنْ کَانَ حَقًّا لِی فَأَعْطِنِیہِ ، وَإِلاَّ فَلاَ تُعْطِنِیہِ فَقَالَ عُمَرُ لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ : فَاکْتُبْنِی عَلَی أَرْبَعَۃِ آلاَفٍ ، وَعَبْدَ اللہِ عَلَی خَمْسَۃِ آلاَفٍ ، وَاللہِ لاَ یَجْتَمِعُ أَنَا وَأَنْتَ عَلَی خَمْسَۃِ آلاَفٍ ، فَقَالَ عَبْدُ اللہِ بْنُ عُمَرَ : إِنْ کَانَ حَقًّا فَأَعْطِنِیہِ وَإِلاَّ فَلاَ تُعْطِنِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33551","","","كتاب الجهاد"
"33552","(۳۳۵۵۲) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرٍ ، قَالَ : لَمَّا وَلِیَ عُمَرُ الْخِلاَفَۃَ فَرَضَ الْفَرَائِضَ وَدَوَّنَ الدَّوَاوِینَ وَعَرَّفَ الْعُرَفَائَ ، قَالَ جَابِرٌ : فَعَرَّفَنِی عَلَی أَصْحَابِی۔","Sahih","Musannaf Ibn Abi Shaybah 33552","","","كتاب الجهاد"
"33553","(۳۳۵۵۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ ، عَنْ مَخْلَدٍ الْغِفَارِی أَنَّ ثَلاَثَۃً مَمْلُوکِینَ شَہِدُوا بَدْرًا ، فَکَانَ عُمَرُ یُعْطِی کُلَّ رَجُلٍ مِنْہُمْ کُلَّ سَنَۃٍ ثَلاَثَۃَ آلاَفٍ ثَلاَثَۃَ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33553","","","كتاب الجهاد"
"33554","(۳۳۵۵۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ، عَنْ أَبِیہِ، قَالَ: شَہِدْتُ عُثْمَانَ وَعَلِیًّا یَرْزُقَانِ أَرِقَّائَ النَّاسِ۔","Hasan","Musannaf Ibn Abi Shaybah 33554","","","كتاب الجهاد"
"33555","(۳۳۵۵۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ دَاوُدَ ، عَنْ یُوسُفَ بْنِ سَعْدٍ ، عَنْ وُہَیْبٍ أَنَّ زَیْدَ بْنَ ثَابِتٍ کَانَ فِی إمَارَۃِ عُثْمَانَ عَلَی بَیْتِ الْمَالِ ، قَالَ : فَدَخَلَ عُثْمَان وَأَبْصَرَ وُہَیْبًا یُعِینُہُمْ ، قَالَ : مَنْ ہَذَا ؟ فَقَالَ : مَمْلُوکٌ لِی ، فَقَالَ : أَرَاہُ یُعِینُہُمْ ، افْرِضْ لَہُ أَلْفَیْنِ ، قَالَ : فَفَرَضَ لَہُ أَلْفًا۔","Da'if","Musannaf Ibn Abi Shaybah 33555","","","كتاب الجهاد"
"33556","(۳۳۵۵۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ سِمَاکٍ ، عَنْ عِیَاضٍ الأَشْعَرِیِّ أَنَّ عُمَرَ کَانَ یَرْزُقُ الْعَبِیدَ وَالإِمَائَ وَالْخَیْلَ۔","Hasan","Musannaf Ibn Abi Shaybah 33556","","","كتاب الجهاد"
"33557","(۳۳۵۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لاَ یَفْرِضُ إِلاَّ لِمَنْ قَرَأَ الْقُرْآنَ ، قَالَ : فَکَانَ أَبِی مِمَّنْ قَرَأَ الْقُرْآنَ فَفَرَضَ لَہُ۔","","Musannaf Ibn Abi Shaybah 33557","","","كتاب الجهاد"
"33558","(۳۳۵۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یُسَیْرِ بْنِ عَمْرٍو أَنَّ سَعْدَ بْنَ مَالِکٍ فَرَضَ لِمَنْ قَرَأَ الْقُرْآنَ فِی أَلْفَیْنِ أَلْفَیْنِ ، فَبَلَغَ ذَلِکَ عُمَرَ فَکَتَبَ إلَیْہِ أَنْ لاَ یُعْطِیَ عَلَی الْقُرْآنِ أَجْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 33558","","","كتاب الجهاد"
"33559","(۳۳۵۵۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ کَانَ یَفْرِضُ لِلصَّبِیِّ إذَا اسْتَہَلَّ۔","Sahih","Musannaf Ibn Abi Shaybah 33559","","","كتاب الجهاد"
"33560","(۳۳۵۶۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْت عُثْمَانَ یَتَأَنَّی بِأَعْطِیَاتِ النَّاسِ ، إِنْ قِیلَ لَہُ : إنَّ فُلاَنَۃَ تَلِدُ اللَّیْلَۃَ فَیَقُولُ : کَمْ أَنْتُمَ انْظُرُوا فَإِنْ وَلَدَتْ غُلاَمًا ، أَوْ جَارِیَۃً أَخْرِجْہَا مَعَ النَّاسِ۔","Hasan","Musannaf Ibn Abi Shaybah 33560","","","كتاب الجهاد"
"33561","(۳۳۵۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُمَرَ بْنِ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّہُ لَمَّا وُلِدَ أَلْحَقَہُ عُمَرُ فِی مِئَۃٍ مِنَ الْعَطَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 33561","","","كتاب الجهاد"
"33562","(۳۳۵۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْجَحَّافِ دَاوُد بْنِ أَبِی عَوْفٍ ، عَنْ رَجُلٍ مِنْ خَثْعَمَ ، قَالَ: وُلِدَ لِی مِنَ اللَّیْلِ مَوْلُود ، فَأَتَیْت عَلِیًّا حِینَ أَصْبَحَ فَأَلْحَقَہُ فِی مِئَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33562","","","كتاب الجهاد"
"33563","(۳۳۵۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، عَنْ بِشْرِ بْنِ غَالِبٍ ، قَالَ : سَأَلَ ابْنُ الزُّبَیْرِ الْحَسَنَ بْنَ عَلِیٍّ ، عَنِ الْمَوْلُودِ ، فَقَالَ : إذَا اسْتَہَلَّ وَجَبَ عَطَاؤُہُ وَرَزْقُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 33563","","","كتاب الجهاد"
"33564","(۳۳۵۶۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، قَالَ: حدَّثَنَا فِطْرٌ، قَالَ: کُنْتُ جَالِسًا مَعَ زَیْدِ بْنِ عَلِی، قُلْتُ: کَیْفَ صَنِیعُ ہَذَا الرَّجُلُ إلَیْکُمْ ، عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، فَمَرَّ ابْنٌ لَہُ صَغِیرٌ ، فَقَالَ : جَزَاہُ اللَّہُ خَیْرًا ، فَقَدْ أَلْحَقَ ہَذَا فِی أَلْفَیْنِ۔","","Musannaf Ibn Abi Shaybah 33564","","","كتاب الجهاد"
"33565","(۳۳۵۶۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ شُعَیْبٍ السَّمَّانُ ، عَنْ أُمِّ الْعَلاَئِ أَنَّ أَبَاہَا انْطَلَقَ بِہَا إلَی عَلِیٍّ فَفَرَضَ لَہَا فِی الْعَطَائِ وَہِیَ صَغِیرَۃٌ ، قَالَ : وَقَالَ عَلِیٌّ : مَا الصَّبِیُّ الَّذِی أَکَلَ الطَّعَامَ وَعَضَّ عَلَی الْکِسْرَۃِ بِأَحَقِّ بِہَذَا الْعَطَائِ مِنَ الْمَوْلُودِ الَّذِی یَمُصُّ الثَّدْیَ۔","Da'if","Musannaf Ibn Abi Shaybah 33565","","","كتاب الجهاد"
"33566","(۳۳۵۶۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا الْقَاسِمُ بْنُ مَعْنٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ عُمَرَ أَرَادَ أَنْ یَفْرِضَ لِلنَّاسِ ، وَکَانَ رَأْیُہُ خَیْرًا مِنْ رَأْیِہِمْ ، فَقَالُوا : ابْدَأْ بِنَفْسِکَ ، فَقَالَ : لاَ ، فَبَدَأَ بِالأَقْرَبِ فَالأَقْرَبِ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَفَرَضَ لِلْعَبَّاسِ ، ثُمَّ عَلِیٍّ حَتَّی وَالَی بَیْنَ خَمْسِ قَبَائِلَ حَتَّی انْتَہَی إلَی بَنِی عَدِیِّ بْنِ کَعْبٍ۔","","Musannaf Ibn Abi Shaybah 33566","","","كتاب الجهاد"
"33567","(۳۳۵۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُلَیِّ بْنِ رَبَاحٍ ، عَنْ أَبِیہِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ خَطَبَ النَّاسَ فِی الْجَابِیَۃِ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : مَنْ أَحَبَّ أَنْ یَسْأَلَ عَنِ الْقُرْآنِ فَلْیَأْتِ أُبَیَّ بْنَ کَعْبٍ ، وَمَنْ أَحَبَّ أَنْ یَسْأَلَ ، عَنِ الْفَرَائِضِ فَلْیَأْتِ زَیْدَ بْنَ ثَابِتٍ ، وَمَنْ أَحَبَّ أَنْ یَسْأَلَ ، عَنِ الْفِقْہِ فَلْیَأْتِ مُعَاذَ بْنَ جَبَلٍ ، وَمَنْ أَحَبَّ أَنْ یَسْأَلَ ، عَنِ الْمَالِ فَلْیَأْتِنِی فَإِنَّ اللَّہَ جَعَلَنِی خَازِنًا وَقَاسِمًا أَلاَ وَإِنِّی بَادِئٌ بِالْمُہَاجِرِینَ الأَوَّلِینَ أَنَا وَأَصْحَابِی فَنُعْطِیہِمْ ، ثُمَّ بَادِئٌ بِالأَنْصَارِ الَّذِینَ تَبُوؤُوا الدَّارَ وَالإِیمَانَ فَنُعْطِیہِمْ ، ثُمَّ بَادِئٌ بِأَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنُعْطِیہِنَ ، فَمَنْ أَسْرَعَتْ بِہِ الْہِجْرَۃُ أَسْرَعَ بِہِ الْعَطَائُ ، وَمِنْ أَبْطَأَ عَنِ الْہِجْرَۃِ أَبْطَأَ بِہِ الْعَطَائُ ، فَلاَ یَلُومَن أَحَدُکُمْ إِلاَّ مُنَاخَ رَاحِلَتِہِ۔","","Musannaf Ibn Abi Shaybah 33567","","","كتاب الجهاد"
"33568","(۳۳۵۶۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی مُوسَی بْنُ عُبَیْدَۃَ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ إبْرَاہِیمَ بْنِ الْحَارِثِ التَّیْمِی ، وَکَانَ جَدُّہُ مِنَ الْمُہَاجِرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ أَنَّہُ وَفَدَ إلَی صَاحِبِ الْبَحْرَیْنِ ، قَالَ : فَبَعَثَ مَعِی بِثَمَانِمِئَۃِ أَلْفِ دِرْہَمٍ إلَی عُمَرَ بْنِ الْخَطَّابِ فَقَدِمْت عَلَیْہِ ، فَقَالَ : مَا جِئْتنَا بِہِ یَا أَبَا ہُرَیْرَۃَ ، فَقُلْتُ : بِثَمَانِمِئَۃِ أَلْفِ دِرْہَمٍ ، فَقَالَ : أَتَدْرِی مَا تَقُولُ إنَّک أَعْرَابِیٌّ ، قَالَ : فَعَدَدْتہَا عَلَیْہِ بِیَدِی حَتَّی وَفَیْتُ قَالَ : فَدَعَا الْمُہَاجِرِینَ فَاسْتَشَارَہُمْ فِی الْمَالِ فَاخْتَلَفُوا عَلَیْہِ ، فَقَالَ : ارْتَفِعُوا عَنِّی حَتَّی إذَا کَانَ عِنْدَ الظَّہِیرَۃِ أَرْسَلَ إلَیْہِمْ ، فَقَالَ : إنِّی لَقِیَتْ رَجُلاً مِنْ أَصْحَابِی فَاسْتَشَرْتہ ، فَلَمْ یَنْتَشِرْ عَلَیْہِ رَأْیُہُ ، فَقَالَ : (مَا أَفَائَ اللَّہُ عَلَی رَسُولِہِ مِنْ أَہْلِ الْقُرَی فَلِلَّہِ وَلِلرَّسُولِ وَلِذِی الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینِ وَابْنِ السَّبِیلِ) فَقَسَمَہُ عُمَرُ عَلَی کِتَابِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33568","","","كتاب الجهاد"
"33569","(۳۳۵۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ: لَمَّا وَضَعَ عُمَرُ بْنُ الْخَطَّابِ الدَّوَاوِینَ، اسْتَشَارَ النَّاسَ ، فَقَالَ : بِمِنْ أَبْدَأُ ؟ قَالَ: ابْدَأْ بِنَفْسِکَ ، قَالَ: لاَ ، وَلَکِنِّی أَبْدَأُ بِالأَقْرَبِ فَالأَقْرَبِ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَبَدَأَ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 33569","","","كتاب الجهاد"
"33570","(۳۳۵۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا حَیَّانُ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ أَنَّ عُمَرَ أُتِیَ مِنْ جَلُولاَئَ بِسِتَّۃِ آلاَفِ أَلْفٍ فَفَرَضَ الْعَطَائَ فَاسْتَشَارَ فِی ذَلِکَ ، فَقَالَ عَبْدُ الرَّحْمَن بْنُ عَوْفٍ : ابْدَأْ بِنَفْسِکَ ، فَأَنْتَ أَحَقُّ بِذَلِکَ قَالَ : لاَ ، بَلْ أَبْدَأُ بِالأَقْرَبِ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِمَّنْ شَہِدَ بَدْرًا حَتَّی یَنْتَہِیَ ذَلِکَ إلَیَّ ، قَالَ : فَبَدَأَ فَفَرَضَ لِعَلِیٍّ فِی خَمْسَۃِ آلاَفٍ ، ثُمَّ لِبَنِی ہَاشِمٍ مِمَّنْ شَہِدَ بَدْرًا ، ثُمَّ لِمَوَالِیہِمْ، ثُمَّ لِحُلَفَائِہِمْ ، ثُمَّ الأَقْرَبِ فَالأَقْرَبِ حَتَّی یَنْتَہِی ذَلِکَ إلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33570","","","كتاب الجهاد"
"33571","(۳۳۵۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَبِی صِدِّیقًا لِقَنْبَرٍ ، قَالَ : انْطَلَقْت مَعَ قَنْبَرٍ إلَی عَلِیٍّ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، قُمْ مَعِی ، قَدْ خَبَّأْت لَکَ خَبِیئَۃً ، فَانْطَلَقَ مَعَہُ إلَی بَیْتِہِ، فَإِذَا أَنَا بِسِلَّۃٍ مَمْلُوئَۃٍ جَامَاتٍ مِنْ ذَہَبٍ وَفِضَّۃٍ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إنَّک لاَ تَتْرُکُ شَیْئًا إِلاَّ قَسَمْتہ ، أَوْ أَنْفَقْتہ ، فَسَلَّ سَیْفَہُ ، فَقَالَ : وَیْلَک ، لَقَدْ أَحْبَبْت أَنْ تُدْخِلَ بَیْتِی نَارًا کَبِیرَۃً ، ثُمَّ اسْتَعْرَضَہَا بِسَیْفِہِ فَضَرَبَہَا فَانْتَثَرَتْ بَیْنَ إنَائٍ مَقْطُوعٍ نِصْفُہُ وَثُلُثُہُ ، قَالَ : عَلَیَّ بِالْعُرَفَائِ فَجَاؤُوا ، فَقَالَ : اقْسِمُوا ہَذِہِ بِالْحِصَصِ ، قَالَ فَفَعَلُوا وَہُوَ یَقُولُ : یَا صَفْرَائُ یَا بَیْضَائُ غُرِّی غَیْرِی ، قَالَ : وَجَعَلَ یَقُولُ : n ہَذَا جَنَایَ وَخِیَارُہُ فِیہِ إذْ کُلُّ جَانٍ یَدُہُ إِلَی فِیہِ۔n قالَ : فِی بَیْتِ الْمَالِ مَسَال وَإِبَرٌ ، وَکَانَ یَأْخُذُ مِنْ کُلِّ قَوْمٍ خَرَاجَہُمْ مِنْ عَمَلِ أَیْدِیہِمْ ، قَالَ : وَقَالَ لِلْعُرَفَائِ: اقْسِمُوا ہَذَا ، قَالُوا : لاَ حَاجَۃَ لَنَا فِیہِ ، قَالَ : وَالَّذِی نَفْسِی بِیَدِہِ ، لنَقْسِمُنَّہُ خَیْرَہُ مَعَ شَرِّہِ۔","Hasan","Musannaf Ibn Abi Shaybah 33571","","","كتاب الجهاد"
"33572","(۳۳۵۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْحَسَنِ بْنِ الْحَکَمِ النَّخَعِیِّ ، قَالَ : حدَّثَتْنِی أُمِّی ، عَنْ أُمِّ عَفَّانَ أُمِّ وَلَدٍ لِعَلِیٍّ ، قَالَتْ : جِئْت عَلِیًّا وَبَیْنَ یَدَیْہِ قُرُنْفُلٌ مَکْبُوبٌ فِی الرَّحْبَۃِ ، فَقُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، ہَبْ لاِبْنَتِی مِنْ ہَذَا الْقُرُنْفُلِ قِلاَدَۃً ، فَقَالَ ہَکَذَا ، وَنَقَرَ بِیَدِہِ ارْمِی دِرْہَمًا ، فَإِنَّمَا ہَذَا مَالُ الْمُسْلِمِینَ ، وَإِلاَّ فَاصْبِرِی حَتَّی یَأْتِیَ حَظُّنَا مِنْہُ لِنَہَبَ لابْنَتِکَ قِلاَدَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 33572","","","كتاب الجهاد"
"33573","(۳۳۵۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی صَالِحٍ الَّذِی کَانَ یَخْدُمُ أُمَّ کُلْثُومٍ بِنْتَ عَلِیٍّ ، قَالَ : قَالَتْ : یَا أَبَا صَالِحٍ ، کَیْفَ لَوْ رَأَیْت أَمِیرَ الْمُؤْمِنِینَ وَأُتِیَ بِأُتْرُجٍّ ، فَذَہَبَ حَسَنُ أَوْ حُسَیْنُ یَتَنَاوَلُ مِنْہُ أُتْرُجَّۃً ، فَانْتَزَعَہَا مِنْ یَدِہِ ، وَأَمَرَ بِہِ فَقَسَمَ بَیْنَ النَّاسِ۔","Sahih","Musannaf Ibn Abi Shaybah 33573","","","كتاب الجهاد"
"33574","(۳۳۵۷۴) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَبْدِ الصَّمَدِ العمی ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنِ الْحَسَنِ أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زِمَامَ شَعْرٍ مِنَ الْفَیْئِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَسْأَلُنِی زِمَامًا مِنَ النَّارِ ، مَا کَانَ یَنْبَغِی لَکَ أَنْ تَسْأَلَنِیہِ ، وَمَا یَنْبَغِی لِی أَنْ أُعْطِیَکَہُ۔ (ابو اسحاق ۴۷۶)","Hasan","Musannaf Ibn Abi Shaybah 33574","","","كتاب الجهاد"
"33575","(۳۳۵۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٍ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ الأَحْمَسِیِّ ، قَالَ : أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ بِکُبَّۃٍ مِنْ شَعْرٍ مِنَ الْغَنِیمَۃِ ، فَقَالَ : یَا رَسُولَ اللہِ ، ہَبْہَا لِی فَإِنَّا أَہْلُ بَیْتٍ یُعَالِجُ الشَّعَرَ ، قَالَ نَصِیبِی مِنْہَا لَک۔ (سعید بن منصور ۲۷۲۶)","","Musannaf Ibn Abi Shaybah 33575","","","كتاب الجهاد"
"33576","(۳۳۵۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الْعَبَّاسِ بْنِ فُضَیْلٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ جَدِّہِ أَبِی رَافِعٍ ، قَالَ : کُنْتُ خَازِنًا لِعَلِیٍّ ، قَالَ : زَیَّنْتُ ابْنَتَہُ بِلُؤْلُؤَۃٍ مِنَ الْمَالِ قَدْ عَرَفَہَا ، فَرَآہَا عَلَیْہَا ، فَقَالَ : مِنْ أَیْنَ لَہَا ہَذِہِ ؟ إنَّ لِلَّہِ عَلَیَّ أَنْ أَقْطَعَ یَدَہَا ، قَالَ : فَلَمَّا رَأَیْت ذَلِکَ قُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، زَیَّنْت بِہَا بِنْتَ أَخِی ، وَمِنْ أَیْنَ کَانَتْ تَقْدِرُ عَلَیْہَا ، فَلَمَّا رَأَی ذَلِکَ سَکَتَ۔","Da'if","Musannaf Ibn Abi Shaybah 33576","","","كتاب الجهاد"
"33577","(۳۳۵۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَن بْنُ عَجْلاَنَ الْبُرْجُمِیُّ ، عَنْ جَدَّتِہِ ، قَالَتْ : کَانَ عَلِیٌّ یَقْسِمُ فِینَا الإِبزار بِصُرَرِہ : صُرَر الْکَمُّونِ والحُرف وَکَذَا وَکَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 33577","","","كتاب الجهاد"
"33578","(۳۳۵۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا رَبِیعُ بْنُ حَسَّانَ ، عَنْ أُمِّہِ ، قَالَتْ : کَانَ عَلِیٌّ یَقْسِمُ فِینَا الْوَرْسَ وَالزَّعْفَرَانَ، قَالَ : فَدَخَلَ عَلِیَّ الْحُجْرَۃَ مَرَّۃً فَرَأَی حَبًّا مَنْثُورًا ، فَجَعَلَ یَلْتَقِطُ وَیَقُولُ : شَبِعْتُمْ یَا آلَ عَلِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 33578","","","كتاب الجهاد"
"33579","(۳۳۵۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ بن سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ شَیْخٍ لَہُمْ أَنَّ عَلِیًّا أُتِیَ بِرُمَّانٍ فَقَسَمَہُ بَیْنَ النَّاسِ ، فَأَصَابَ مَسْجِدَنَا سَبْعُ رُمَّانَاتٍ ، أَوْ ثَمَانُ رُمَّانَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33579","","","كتاب الجهاد"
"33580","(۳۳۵۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ أَبِیہِ ، قَالَ : أُتِیَ عَلِیٌّ بِدِنَانِ طِلاَئٍ مِنْ غَابَاتٍ فَقَسَمَہَا بَیْنَ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33580","","","كتاب الجهاد"
"33581","(۳۳۵۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عُیَیْنَۃُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ جَوْشَنٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، قَالَ : مَا رَزَأَ عَلِیٌّ مِنْ بَیْتِ مَالِنَا حَتَّی فَارَقَنَا إِلاَّ جُبَّۃً مَحْشُوَّۃً وَخَمِیصَۃَ دَرَابِْجِرْدِیَّۃٍ ۔","Sahih","Musannaf Ibn Abi Shaybah 33581","","","كتاب الجهاد"
"33582","(۳۳۵۸۲) حَدَّثَنَا وکیع قَالَ : حَدَّثَنَا الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : لَمَّا مَرِضَ أَبُو بَکْرٍ مَرَضَہُ الَّذِی مَاتَ فِیہِ ، قَالَ : انْظُرُوا مَا زَادَ فِی مَالِی مُنْذُ دَخَلْت الإِمَارَۃَ فَابْعَثُوا بِہِ إلَی الْخَلِیفَۃِ مِنْ بَعْدِی ، فَإِنِّی قَدْ کُنْتُ أَسْتَحِلُّہُ ، وَقَدْ کُنْتُ أُصِیبُ مِنَ الْوَدَکِ نَحْوًا مِمَّا کُنْتُ أُصِیبُ فِی التِّجَارَۃِ ، قَالَتْ : فَلَمَّا مَاتَ نَظَرْنَا فَإِذَا عَبْدٌ نُوبِیٌّ کَانَ یَحْمِلُ الصِّبْیَانَ ، وَإِذَا نَاضِحٌ کَانَ یستقی عَلَیْہِ ، فَبُعِثَ بِہِمَا إلَی عُمَرَ، قَالَتْ : فَأَخْبَرَنِی جَرِیّی تَعْنِی : وَکِیلِی أَنَّ عُمَرَ بَکَی ، وَقَالَ : رَحْمَۃُ اللہِ عَلَی أَبِی بَکْرٍ ، لَقَدْ أَتْعَبَ مَنْ بَعْدَہُ تَعَبًا شَدِیدًا۔","Sahih","Musannaf Ibn Abi Shaybah 33582","","","كتاب الجهاد"
"33583","(۳۳۵۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ ابْنِ سِیرِینَ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ، قَالَ : کُنَّا جُلُوسًا بِبَابِ عُمَرَ فَخَرَجَتْ جَارِیَۃٌ فَقُلْنَا : سُرِّیَّۃُ عُمَرَ ، فَقَالَتْ : إِنَّہَا لَیْسَتْ سُرِّیَّۃً لِعُمَرَ ، إنِّی لاَ أَحِلُّ لِعُمَرَ، إنِّی مِنْ مَالِ اللہِ فَتَذَاکَرْنَا بَیْنَنَا مَا یَحِلُّ لَہُ مِنْ مَالِ اللہِ ، قَالَ : فَرَقَی ذَلِکَ إلَیْہِ ، فَأَرْسَلَ إلَیْنَا ، فَقَالَ : مَا کُنْتُمْ تُذَاکِرُونَ فَقُلْنَا : خَرَجَتْ عَلَیْنَا جَارِیَۃٌ ، فَقُلْنَا : سُرِّیَّۃُ عُمَرَ ، فَقَالَتْ : إِنَّہَا لَیسْت سُرِّیَّۃِ عُمَرَ ، إِنَّہَا لاَ تَحِلُّ لِعُمَرَ ، إِنَّہَا مِنْ مَالِ اللہِ ، فَتَذَاکَرْنَا مَا بَیْنَنَا مَا یَحِلُّ لَکَ مِنْ مَالِ اللہِ ؟ فَقَالَ : أَنَا أُخْبِرُکُمْ بِمَا أَسْتَحِلُّ مِنْ مَالِ اللہِ : حُلَّۃُ الشِّتَائِ وَالْقَیْظِ ، وَمَا أَحُجُّ عَلَیْہِ ، وَمَا أَعْتَمِرُ مِنَ الظَّہْرِ ، وَقُوتُ أَہْلِی کَرَجُلٍ مِنْ قُرَیْشٍ ، لَیْسَ بِأَغْنَاہُمْ ، وَلاَ بِأَفْقَرِہِمْ ، أَنَا رَجُلٌ مِنَ الْمُسْلِمِینَ یُصِیبُنِی مَا أَصَابَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33583","","","كتاب الجهاد"
"33584","(۳۳۵۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ أَنَّہُمْ کَانُوا جُلُوسًا بِبَابِ عُمَرَ ، فَخَرَجَتْ عَلَیْہِمْ جَارِیَۃٌ ، فَقَالَ لَہَا بَعْضُ الْقَوْمِ : أیطأکِ أَمِیرَ الْمُؤْمِنِینَ ، قَالَتْ : إنِّی لاَ أَحِلُّ لَہُ ، یَعْنِی أَنَّہَا مِنَ الْخُمُسِ ، فَخَرَجَ عُمَرُ ، فَقَالَ : تَدْرُونَ مَا أَسْتَحِلُّ مِنْ ہَذَا الْفَیْئِ ظَہْرًا أَحُجُّ عَلَیْہِ وَأَعْتَمِرُ ، وَحُلَّتَیْنِ : حُلَّۃُ الشِّتَائِ وَالصَّیْفِ ، وَقُوتُ آلِ عُمَرَ قُوتُ أَہْلِ بَیْتِ رَجُلٍ مِنْ قُرَیْشٍ لَیْسُوا بِأَرْفَعِہِمْ ، وَلاَ بِأَخَسِّہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 33584","","","كتاب الجهاد"
"33585","(۳۳۵۸۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی إِسْحَاقَ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ الْعَبْدِیِّ، قَالَ: قَالَ عُمَرُ: إنِّی أَنْزَلَتْ نَفْسِی مِنْ مَالِ اللہِ مَنْزِلَۃَ مَالِ الْیَتِیمِ، إنِ اسْتَغْنَیْت عنہ اسْتَعْفَفْت، وَإِنِ افْتَقَرْت أَکَلْتُ بِالْمَعْرُوفِ۔","Sahih","Musannaf Ibn Abi Shaybah 33585","","","كتاب الجهاد"
"33586","(۳۳۵۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ عَبْدِ اللہِ الْبَجَلِیُّ ، قَالَ : حدَّثنِی عَمْرو بْنُ أَخِی عِلْبَائُ عن عِلْبَائَ ، قَالَ : قَالَ عَلِیٌّ : مَرَرْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِإِبِلٍ مِنْ إبِلِ الصَّدَقَۃِ ، فَأَخَذَ وَبَرَۃً مِنْ ظَہْرِ بَعِیرٍ ، فَقَالَ : مَا یَحِلُّ لِی مِنْ غَنَائِمِکُمْ مَا یَزِنُ ہَذِہِ ، إِلاَّ الْخُمُسُ ، وَہُوَ مَرْدُودٌ عَلَیْکُمْ۔ (احمد ۸۸)","Da'if","Musannaf Ibn Abi Shaybah 33586","","","كتاب الجهاد"
"33587","(۳۳۵۸۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ نُبَیْحٍ ، قَالَ : اشْتَرَی ابْنُ عُمَرَ بَعِیرَیْنِ فَأَلْقَاہُمَا فِی إبِلِ الصَّدَقَۃِ فَسَمِنَا وَعَظُمَا ، وَحَسُنَتْ ہَیْئَتُہُمَا قَالَ : فَرَآہُمَا عُمَرُ فَأَنْکَرَ ہَیْئَتَہُمَا ، فَقَالَ : لِمَنْ ہَذَانِ ، قَالُوا : لِعَبْدِ اللہِ بْنِ عُمَرَ ، فَقَالَ : بِعْہُمَا وَخُذْ رَأْسَ مَالِکَ ، وَرُدَّ الْفَضْلَ فِی بَیْتِ الْمَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 33587","","","كتاب الجهاد"
"33588","(۳۳۵۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ، عَنْ أَبِی عُثْمَانَ، قَالَ: لَمَّا قَدِمَ عُتْبَۃُ أَذْرَبِیجَانَ بِالْخَبِیصِ فَذَاقَہُ فَوَجَدَہُ حُلْوًا ، فَقَالَ : لَوْ صَنَعْتُمْ لأَمِیرِ الْمُؤْمِنِینَ مِنْ ہَذَا ، قَالَ : فَجَعَلَ لَہُ سَفَطَیْنِ عَظِیمَیْنِ ، ثُمَّ حَمَلَہُمَا عَلَی بَعِیرٍ مَعَ رَجُلَیْنِ فَبَعَثَ بِہِمَا إلَیْہِ ، فَلَمَّا قَدِمَا عَلَی عُمَرَ ، قَالَ : أَیَّ شَیْئٍ ہَذَا ، قَالَ : ہَذَا خَبِیصٌ ، فَذَاقَہُ فَإِذَا ہُوَ حُلْوٌ ، فَقَالَ : أَکُلَّ الْمُسْلِمِینَ یُشْبِعُ مَنْ ہَذَا فِی رَحْلِہِ ؟ قَالُوا : لاَ قَالَ : فَرُدَّہُمَا ، ثُمَّ کَتَبَ إلَیْہِ : أَمَّا بَعْدُ ، فَإِنَّہُ لَیْسَ مِنْ کَدِّکَ ، وَلاَ مِنْ کَدِّ أَبِیک ، وَلاَ مِنْ کَدِّ أُمِّکَ أَشْبِعِ الْمُسْلِمِینَ مِمَّا تَشْبَعُ مِنْہُ فِی رَحْلِک۔","Sahih","Musannaf Ibn Abi Shaybah 33588","","","كتاب الجهاد"
"33589","(۳۳۵۸۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ: حَدَّثَنِی عُتْبَۃُ بْنُ فَرْقَدٍ السُّلَمِیُّ ، قَالَ : قَدِمْت عَلَی عُمَرَ بْنِ الْخَطَّابِ بِسِلاَلِ خَبِیصٍ عِظَامٍ مَمْلُوئَۃٍ ، لَمْ أَرَ أَحْسَن مِنْہُ وَأَجیَد ، فَقَالَ : مَا ہَذِہِ فَقُلْت : طَعَامٌ أَتَیْتُک بِہِ ، إنَّک تَقْضِی مِنْ حَاجَاتِ النَّاسِ أَوَّلَ النَّہَارِ ، فَإِذَا رَجَعْت أَصَبْت مِنْہُ قَالَ : اکْشِفْ عَنْ سَلَّۃٍ مِنْہَا ، قَالَ : فَکَشَفْت ، قَالَ : عَزَمْت عَلَیْک إذَا رَجَعْت إِلاَّ رَزَقْت کُلَّ رَجُلٍ مِنَ الْمُسْلِمِینَ مِنْہَا سَلَّۃً ، قَالَ : قُلْتُ : وَالَّذِی یَصْلُحُک یَا أَمِیرَ الْمُؤْمِنِینَ ، لَوْ أَنْفَقْت مَالَ قَیْسٍ کُلَّہُ مَا بَلَغَ ذَلِکَ ، قَالَ : فَلاَ حَاجَۃَ لِی فِیہِ ، ثُمَّ دَعَا بِقَصْعَۃٍ فِیہَا ثَرِیدٌ مِنْ خُبْزٍ خَشِنٍ وَلَحْمٍ غَلِیظٍ وَہُوَ یَأْکُلُ مَعِی أَکْلاً شَہِیًّا ، فَجَعَلْتُ أَہْوِی إلَی الْبِضْعَۃِ الْبَیْضَائِ أَحْسِبُہَا سَنَامًا فَأَلُوکُہَا فَإِذَا ہِیَ عَصَبَۃٌ ، وَآخُذُ الْبِضْعَۃَ مِنَ اللَّحْمِ فَأَمْضُغُہَا فَلاَ أَکَادُ أَسِیغُہَا ، فَإِذَا غَفَلَ عَنِّی جَعَلْتہَا بَیْنَ الْخِوَانِ وَالْقَصْعَۃِ ، ثُمَّ قَالَ : یَا عُتْبَۃُ ، إنَّا نَنْحَرُ کُلَّ یَوْمٍ جَزُورًا ، فَأَمَّا وَدَکُہَا وَأَطْیابُہَا فَلِمَنْ حَضَرَ مِنْ آفَاقِ الْمُسْلِمِینَ ، وَأَمَّا عُنُقُہَا فَإِلَیَ عُمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 33589","","","كتاب الجهاد"
"33590","(۳۳۵۹۰) حَدَّثَنَا حُسَین بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سُلَیْمَانَ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : مَرَرْت وَالنَّاسُ یَأْکُلُونَ ثَرِیدًا وَلَحْمًا ، فَدَعَانِی عُمَرُ إلَی طَعَامِہِ ، فَإِذَا ہُوَ یَأْکُلُ خُبْزًا غَلِیظًا وَزَیْتًا ، فَقُلْتُ : مَنَعْتنِی أَنْ آکُلَ مَعَ النَّاسِ الثَّرِیدَ ، وَدَعَوْتنِی إلَی ہَذَا قَالَ : إنَّمَا دَعَوْتُک لِطَعَامِی ، وَذَاکَ لِلْمُسْلِمِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 33590","","","كتاب الجهاد"
"33591","(۳۳۵۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنِ ابْنِ خُزَیْمَۃَ بْنِ ثَابِتٍ ، قَالَ: کَانَ عُمَرُ إذَا اسْتَعْمَلَ رَجُلاً أَشْہَدَ عَلَیْہِ رَہْطًا مِنَ الأَنْصَارِ وَغَیْرِہِمْ ، قَالَ : یَقُولُ : إنِّی لَمْ أَسْتَعْمِلْک عَلَی دِمَائِ الْمُسْلِمِینَ، وَلاَ عَلَی أَعْرَاضِہِمْ، وَلَکِنِّی اسْتَعْمَلْتُک عَلَیْہِمْ لِتَقْسِمَ بَیْنَہُمْ بِالْعَدْلِ وَتُقِیمَ فِیہِمَ الصَّلاَۃَ، وَاشْتَرَطَ عَلَیْہِ أَنْ لاَ یَأْکُلَ نَقِیًّا ، وَلاَ یَلْبَسَ رَقِیقًا ، وَلاَ یَرْکَبَ بِرْذَوْنًا ، وَلاَ یَغْلِقَ بَابَہُ دُونَ حَوَائِجِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 33591","","","كتاب الجهاد"
"33592","(۳۳۵۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ الْجُرَیْرِیِّ، عَنْ أَبِی نَضْرَۃَ، عَنْ أَبِی فِرَاسٍ، قَالَ: خَطَبَ عُمَرُ بْنُ الْخَطَّابِ، فَقَالَ: أَلاَ إنِّی وَاللہِ مَا أَبْعَثُ إلَیْکُمْ عُمَّالاً لِیَضْرِبُوا أَبْشَارَکُمْ، وَلاَ لِیَأْخُذُوا أَمْوَالَکُمْ، وَلَکِنْ أَبْعَثُہُمْ إلَیْکُمْ لِیُعَلِّمُوکُمْ دِینَکُمْ وَسُنَّتَکُمْ ، فَمَنْ فُعِلَ بِہِ سِوَی ذَلِکَ فَلْیَرْفَعْہُ إِلَیَّ ، فَوَالَّذِی نَفْسِی بِیَدِہِ لاَقِصَّنَّہُ مِنْہُ ، فَوَثَبَ عَمْرُو بْنُ الْعَاصِ فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَرَأَیْتُک إِنْ کَانَ رَجُلٌ مِنَ الْمُسْلِمِینَ عَلَی رَعِیَّۃٍ فَأَدَّبَ بَعْضَ رَعِیَّتِہِ إنَّک لَمُقِصُّہُ مِنْہُ ؟ قَالَ : إِیْ وَالَّذِی نَفْسُ عُمَرَ بِیَدِہِ لأَقِصَّنَّہُ مِنْہُ ، أَنَّی لاَ أُقِصُّہُ مِنْہُ وَقَدْ رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقِصُّ مِنْ نَفْسِہِ أَلاَ لاَ تَضْرِبُوا الْمُسْلِمِینَ فَتُذِلُّوہُمْ ، وَلاَ تَمْنَعُوہُمْ مِنْ حُقُوقِہِمْ فَتُکَفِّرُوہُمْ ، وَلاَ تَجْمُرُوہُمْ فَتَفْتِنُوہُمْ ، وَلاَ تُنْزِلُوہُمَ الْغِیَاضَ فَتُضَیِّعُوہُمْ۔ (ابوداؤد ۴۵۲۵۔ طیالسی ۵۴)","Da'if","Musannaf Ibn Abi Shaybah 33592","","","كتاب الجهاد"
"33593","(۳۳۵۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ، عَنْ أَبِی عُثْمَانَ، قَالَ: کَتَبَ عُمَرُ إلَی أَبِی مُوسَی الأَشْعَرِیِّ أَنَ اقْطَعُوا الرُّکُب، وَانْزُوا عَلَی الْخَیْلِ نَزْوًا وَأَلْقَوُا الْخِفَافَ، واحتزوا النِّعَالَ، وَأَلْقَوُا السَّرَاوِیلاَتِ، وَاتَّزَرُوا وَارْمُوا الأَغْرَاضَ، وَعَلَیْکُمْ بِلِبْسِ الْمُعَدِّیَۃِ ، وَإِیَّاکُمْ وَہَدْیِ الْعَجَمِ ، فَإِنَّ شَرَّ الْہَدْیِ ہَدْیُ الْعَجَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 33593","","","كتاب الجهاد"
"33594","(۳۳۵۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا بَعَثَ أَمِیرًا عَلَی سَرِیَّۃٍ ، أَوْ جَیْشٍ أَوْصَاہُ فِی خَاصَّۃِ نَفْسِہِ بِتَقْوَی اللہِ وَبِمَنْ مَعَہُ مِنَ الْمُسْلِمِینَ خَیْرًا ، قَالَ : اغْزُوا فِی سَبِیلِ اللہِ ، قَاتِلُوا مَنْ کَفَرَ بِاللہِ ، اغْزُوا ، وَلاَ تَغُلُّوا ، وَلاَ تَغْدِرُوا ، وَلاَ تُمَثِّلُوا ، وَلاَ تَقْتُلُوا وَلِیْدًا۔","Sahih","Musannaf Ibn Abi Shaybah 33594","","","كتاب الجهاد"
"33595","(۳۳۵۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ أَسْلَمَ یَذْکُرُ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ اسْتَعْمَلَ مَوْلاَہُ ہُنَیَّا عَلَی الْحِمَی ، قَالَ : فَرَأَیْتہ یَقُولُ ہَکَذَا : وَیْحُک یَا ہُنَی، ضُمَّ جَنَاحَک عَنِ النَّاسِ ، وَاتَّقِ دَعْوَۃَ الْمَظْلُومِ ، فَإِنَّ دَعْوَۃَ الْمَظْلُومِ مُجَابَۃٌ أَدْخِلْ رَبَّ الصَّرِیمَۃِ وَالْغَنِیمَۃِ، وَدَعْنِی مِنْ نَعَمِ ابْنِ عَفَّانَ ، وَابْنِ عَوْفٍ ، فَإِنَّ ابْنَ عَوْفٍ ، وَابْنَ عَفَّانَ إِنْ ہَلَکَتْ مَاشِیَتُہُمَا رَجَعَا إلَی الْمَدِینَۃِ إلَی نَخْلٍ وَزَرْعٍ ، وَإِنَّ ہَذَا الْمِسْکِینَ إِنْ ہَلَکَتْ مَاشِیَتُہُ جَائَنِی یَصِیحُ ، یَا أَمِیرَ الْمُؤْمِنِینَ یَا أَمِیرَ الْمُؤْمِنِینَ ، فَالْمَائُ وَالْکَلأُ أَہْوَنُ عَلَیَّ مِنْ أَنْ أَغْرَمَ ذَہَبًا وَوَرِقًا ، وَاللہِ وَاللہِ وَاللہِ إِنَّہَا لَبِلاَدِہُمْ فِی سَبِیلِ اللہِ قَاتَلُوا عَلَیْہَا فِی الْجَاہِلِیَّۃِ وَأَسْلَمُوا عَلَیْہَا فِی الإِسْلاَمِ ، وَلَوْلاَ ہَذَا النَّعَمُ الَّذِی یُحْمَلُ عَلَیْہِ فِی سَبِیلِ اللہِ مَا حَمَیْت عَلَی النَّاسِ مِنْ بِلاَدِہِمْ شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 33595","","","كتاب الجهاد"
"33596","(۳۳۵۹۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ إیَادِ بْنِ لَقِیطٍ ، عَنِ الْبَرَائِ بْنِ قَیْسٍ ، قَالَ : أَرْسَلَنِی عُمَرُ بْنُ الْخَطَّابِ إلَی سَلْمَانَ بْنِ رَبِیعَۃَ آمُرُہُ أَنْ یُفْطِرَ وَہُوَ مُحَاصَرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33596","","","كتاب الجهاد"
"33597","(۳۳۵۹۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی رَبِیعَۃُ بْنُ یَزِیدَ الدِّمَشْقِیِّ ، عَنْ قَزَعَۃَ ، قَالَ : سَأَلْتُ أَبَا سَعِیدٍ ، عَنِ الصَّوْمِ فِی السَّفَرِ ، فَقَالَ : سَافَرْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَصُومُ وَنَصُومُ حَتَّی نَزَلْنَا مَنْزِلاً ، فَقَالَ : إنَّکُمْ قَدْ دَنَوْتُمْ مِنْ عَدُوِّکُمْ وَالْفِطْرُ أَقْوَی لَکُمْ۔n(مسلم ۱۰۲۔ ابوداؤد ۲۳۹۸)","Sahih","Musannaf Ibn Abi Shaybah 33597","","","كتاب الجهاد"
"33598","(۳۳۵۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : دَخَلَ الزُّبَیْرُ عَلَی عَمَّارٍ ، أَوْ عُثْمَانَ بَعْدَ وَفَاۃِ عَبْدِ اللہِ ، فَقَالَ : أَعْطِنِی عَطَائَ عَبْدِ اللہِ فَعِیَالُ عَبْدِ اللہِ أَحَقُّ بِہِ مِنْ بَیْتِ الْمَالِ ، قَالَ : فَأَعْطَاہُ خَمْسَۃَ عَشَرَ أَلْفًا۔","Sahih","Musannaf Ibn Abi Shaybah 33598","","","كتاب الجهاد"
"33599","(۳۳۵۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ صَالِحٍ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ أَشْیَاخِ الْحَیِّ ، قَالُوا : مَاتَ رَجُلٌ وَقَدْ مَضَی لَہُ ثُلُثَا السَّنَۃِ فَأَمَرَ لَہُ عُمَرُ بْنُ الْخَطَّابِ بِثُلُثِی عَطَائِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33599","","","كتاب الجهاد"
"33600","(۳۳۶۰۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَبَّاسٌ أَنَّ الْمُطَّلِبَ بْنَ عَبْدِ اللہِ بْنِ قَیْسِ بْنِ مَخْرَمَۃَ أَخْبَرَہُ أَنَّ امْرَأَۃً شکت إلی عَائِشَۃَ الْحَاجَۃَ ، قَالَتْ : وَمَا لَکَ ؟ قَالَتْ : کُنَّا نَأْخُذُ عَطَائَ إنْسَانٍ مَیِّتٍ فَرَفَعْنَاہُ ، فَقَالَتْ عَائِشَۃُ : لِمَ فَعَلْتُمْ ، أَخَرَجتم سَہمًا مِنْ فَیْئِ اللہِ کَانَ یَدْخُلُ عَلَیْکُمْ أَخْرَجْتُمُوہُ مِنْ بَیْنِکُمْ، وذَلِکَ فِی زَمَانِ عُمَرَ بْنِ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 33600","","","كتاب الجهاد"
"33601","(۳۳۶۰۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا أَبُو الْمِقْدَامِ ہِشَامُ بْنُ زِیَادٍ مَوْلَی لِعُثْمَانَ، عَنْ أَبِیہِ أَنَّ عُثْمَانَ کَانَ یُوَرِّثُ الْعَطَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 33601","","","كتاب الجهاد"
"33602","(۳۳۶۰۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِیہِ، عَنْ أَبِی حَیَّانَ ، عَنْ عَامِرٍ ، قَالَ: لاَ بَأْسَ أَنْ یُؤْخَذَ لِلْمَیِّتِ عَطَاؤُہُ۔","","Musannaf Ibn Abi Shaybah 33602","","","كتاب الجهاد"
"33603","(۳۳۶۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قَیْسٌ ، عَنْ جَابِرٍ ، عَنْ مَوْلَی لِعَلِیِّ بْنِ حُسَیْنٍ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، قَالَ : لاَ بَأْسَ أَنْ یُؤْخَذَ لِلْمَیِّتِ عَطَاؤُہُ۔","","Musannaf Ibn Abi Shaybah 33603","","","كتاب الجهاد"
"33604","(۳۳۶۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ مَعْقِلٍ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إذَا مَاتَ الرَّجُلُ وَقَدِ اسْتَکْمَلَ السَّنَۃَ أَعْطَی وَرَثَتَہُ عَطَائَہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 33604","","","كتاب الجهاد"
"33605","(۳۳۶۰۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَوْصَی عَامِلَہُ فِی الْغَزْوِ أَنْ لاَ یَرْکَبَ دَابَّۃً إِلاَّ دَابَّۃً یکون سَیْرَہَا أَضْعَفَ دَابَّۃٍ فِی الْجَیْشِ۔","","Musannaf Ibn Abi Shaybah 33605","","","كتاب الجهاد"
"33606","(۳۳۶۰۶) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ أُمَیَّۃَ الشَّامِیَّ، قَالَ: کَانَ مَکْحُولٌ وَرَجَائُ بْنُ حَیْوَۃَ یَخْتَارَانِ السَّاقَۃَ لاَ یُفَارِقَانِہَا۔","","Musannaf Ibn Abi Shaybah 33606","","","كتاب الجهاد"
"33607","(۳۳۶۰۷) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ جُمَیْعِ بْنِ عَبْدِ اللہِ الْمُقْرِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ نَہَی الْبَرِیدَ أَنْ یَجْعَلَ فِی طَرَفِ السَّوْطِ حَدِیدَۃً أَنْ یَنْخُسَ بِہَا الدَّابَّۃَ ، قَالَ : وَنَہَی عَنِ اللُّجُمِ۔","","Musannaf Ibn Abi Shaybah 33607","","","كتاب الجهاد"
"33608","(۳۳۶۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ زُہَیْرِ بْنِ أَبِی ثَابِتٍ ، عَنْ ذُہْلِ بْنِ أَوْسٍ ، عَنْ تَمِیمِ بْنِ مُسَیْحٍ ، قَالَ : خَرَجْت مِنَ الدَّارِ وَلَیْسَ لِی وَلَدٌ فَأَصَبْت لَقِیطًا فَأَخْبَرْت بِہِ عُمَرَ ، فَأَلْحَقَہُ فِی مِئَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33608","","","كتاب الجهاد"
"33609","(۳۳۶۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ زُہَیْرٍ الَعَنَسِیّ أَنَّ رَجُلاً الْتَقَطَ لَقِیطًا فَأَتَی بِہِ عَلِیًّا ، فَأَعْتَقَہُ وَأَلْحَقَہُ فِی مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 33609","","","كتاب الجهاد"
"33610","(۳۳۶۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی الْجُہَنِیِّ ، قَالَ : رَأَیْتُ وَلَدَ زِنًا أَلْحَقَہُ عَلِیٌّ فِی مِئَۃٍ۔","","Musannaf Ibn Abi Shaybah 33610","","","كتاب الجهاد"
"33611","(۳۳۶۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ أَنَّ رَجُلَیْنِ مِنْ أَہْلِ أُلَّیْسِ أَسْلَمَا فِی عَہْدِ عُمَرَ ، قَالَ : فَأَتَیَا عُمَرَ فَأَخْبَرَاہُ بِإِسْلاَمِہِمَا فَکَتَبَ لَہُمَا إلَی عُثْمَانَ بْنِ حُنَیْفٍ أَنْ یَرْفَعَ الْجِزْیَۃَ عَنْ رُؤُوسِہِمَا، وَیَأْخُذَ الطُّسْقَ مِنْ أَرْضَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 33611","","","كتاب الجهاد"
"33612","(۳۳۶۱۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ الْیَامِیِّ أَنْ دِہْقَانًا أَسْلَمَ عَلَی عَہْدِ عَلِیٍّ ، فَقَالَ لَہُ عَلِیٌّ : إِنْ أَقَمْت فِی أَرْضِکَ رَفَعْنَا الْجِزْیَۃَ عَنْ رَأْسِکَ وَأَخَذْنَاہَا مِنْ أَرْضِکَ ، وَإِنْ تَحَوَّلْتَ عنہا فَنَحْنُ أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 33612","","","كتاب الجهاد"
"33613","(۳۳۶۱۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِی عَوْنٍ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، عَنْ عُمَرَ وَعَلِیٍّ ، قَالاَ : إذَا أَسْلَمَ وَلَہُ أَرْضٌ وَضَعْنَا عَنْہُ الْجِزْیَۃَ وَأَخَذْنَا خَرَاجَہَا۔","","Musannaf Ibn Abi Shaybah 33613","","","كتاب الجهاد"
"33614","(۳۳۶۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ أَنَّ دِہْقَانَۃً مِنْ أَہْلِ نَہْرِ الْمَلِکِ أَسْلَمَتْ ، فَقَالَ عُمَرُ : ادْفَعُوا إلَیْہَا أَرْضَہَا تُؤَدِّی عنہا الْخَرَاجَ۔","Sahih","Musannaf Ibn Abi Shaybah 33614","","","كتاب الجهاد"
"33615","(۳۳۶۱۵) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ أَنَّ دِہْقَانَۃً أَسْلَمَتْ فَکَتَبَ عُمَرُ أَنْ خَیِّرُوہَا۔","Sahih","Musannaf Ibn Abi Shaybah 33615","","","كتاب الجهاد"
"33616","(۳۳۶۱۶) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّ الرَّفِیلَ دِہْقَانُ النَّہْرَیْنِ أَسْلَمَ ، فَعَرَضَ لَہُ عُمَرُ فِی أَلْفَیْنِ ، وَرَفَعَ عَنْ رَأْسِہِ الْجِزْیَۃَ ، وَدَفَعَ إلَیْہِ أَرْضَہُ یُؤَدِّی عنہا الْخَرَاجَ۔","Da'if","Musannaf Ibn Abi Shaybah 33616","","","كتاب الجهاد"
"33617","(۳۳۶۱۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَسْلَمَ الرَّجُلُ مِنْ أَہْلِ السَّوَادِ ، ثُمَّ أَقَامَ بِأَرْضِہِ أُخِذَ مِنْہُ الْخَرَاجُ ، فَإِنْ خَرَجَ مِنْہَا لَمْ یُؤْخَذْ مِنْہُ الْخَرَاجُ۔","","Musannaf Ibn Abi Shaybah 33617","","","كتاب الجهاد"
"33618","(۳۳۶۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ ، عَنْ عَامِرٍ ، قَالَ : لَمْ یَکُنْ لأَہْلِ السَّوَادِ عَہْدٌ ، فَلَمَّا رَضُوا مِنْہُمْ بِالْجِزْیَۃِ صَارَ لَہُمْ عَہْدٌ۔","","Musannaf Ibn Abi Shaybah 33618","","","كتاب الجهاد"
"33619","(۳۳۶۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ لأَہْلِ السَّوَادِ عَہْد ، إنَّمَا نَزَلُوا عَلَی الْحُکْمِ۔","","Musannaf Ibn Abi Shaybah 33619","","","كتاب الجهاد"
"33620","(۳۳۶۲۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : السَّوَادُ بَعْضُہُ صُلْحٌ وَبَعْضُہُ عُنْوَۃٌ۔","","Musannaf Ibn Abi Shaybah 33620","","","كتاب الجهاد"
"33621","(۳۳۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : لَمَّا أَسْلَمَ الْہُرْمُزَانُ والفیرزان ، قَالَ لَہُمَا عُمَرُ : إنَّمَا بِکُمَا الْجِزْیَۃُ ، إنَّ الإِسْلاَمَ لَحَقِیقٌ أَنْ یُعِیذَ مِنَ الْجِزْیَۃِ۔","","Musannaf Ibn Abi Shaybah 33621","","","كتاب الجهاد"
"33622","(۳۳۶۲۲) حَدَّثَنَا شَرِیکٌ ، عَنِ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَبْدُو إلَی ہَذِہِ التِّلاَعِ۔","Shadh","Musannaf Ibn Abi Shaybah 33622","","","كتاب الجهاد"
"33623","(۳۳۶۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : خَرَجَ عَلْقَمَۃُ ، وَعَبْدُ الرَّحْمَن بْنُ أَبِی لَیْلَی إلَی بَدْوٍ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 33623","","","كتاب الجهاد"
"33624","(۳۳۶۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ یَتَبَدَّی إلَی النَّجَفِ۔","","Musannaf Ibn Abi Shaybah 33624","","","كتاب الجهاد"
"33625","(۳۳۶۲۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، قَالَ : خَرَجَ مَسْرُوقٌ وَعُرْوَۃُ بْنُ الْمُغِیرَۃِ إلَی بَدْوٍ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 33625","","","كتاب الجهاد"
"33626","(۳۳۶۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ السَّائِبِ الطَّائِفِیُّ ، عَنْ صَالِحِ بْنِ سَعْدٍ ، قَالَ : خَرَجْت مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ إلَی السُّوَیْدَائِ مُتَبَدِّیًا۔","","Musannaf Ibn Abi Shaybah 33626","","","كتاب الجهاد"
"33627","(۳۳۶۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : کَانَ یُقَالُ: الْبَدَاوَۃُ شَہْرَانِ ، فَمَنْ زَادَ فَہُوَ تعَرُّبٌ۔","","Musannaf Ibn Abi Shaybah 33627","","","كتاب الجهاد"
"33628","(۳۳۶۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی مُوسَی ، عَنِ ابْنِ مُنَبَّہٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَدَا جَفَا ، وَمَنَ تَبِعَ الصَّیْدَ غَفَلَ۔ (ابوداؤد ۲۸۵۳۔ ترمذی ۲۲۵۶)","Da'if","Musannaf Ibn Abi Shaybah 33628","","","كتاب الجهاد"
"33629","(۳۳۶۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَدَوْنَا مَعَ عَلْقَمَۃَ وَکَانَ عَبْدُ الرَّحْمَن بْنُ أَبِی لَیْلَی قَرِیبًا مِنَّا۔","","Musannaf Ibn Abi Shaybah 33629","","","كتاب الجهاد"
"33630","(۳۳۶۳۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ أَنَّ رَجُلاً اشْتَرَی أَمَۃً یَوْمَ الْقَادِسِیَّۃِ مِنَ الْفَیْئِ ، فَأَتَتْہُ بِحَلْیٍّ کَانَ مَعَہَا ، فَأَتَی سَعْدَ بْنَ أَبِی وَقَّاصٍ فَأَخْبَرَہُ ، فَقَالَ : اجْعَلْہُ فِی غَنَائِمِ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33630","","","كتاب الجهاد"
"33631","(۳۳۶۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، قَالَ : اشْتَرَیْت جَارِیَۃً فِی خُمْسٍ فَوَجَدْت مَعَہَا خَمْسَۃَ عَشَرَ دِینَارًا ، فَأَتَیْت بِہَا عَبْدَ الرَّحْمَن بْنِ خَالِدِ بْنِ الْوَلِیدِ ، فَقَالَ : ہِیَ لَک۔","Da'if","Musannaf Ibn Abi Shaybah 33631","","","كتاب الجهاد"
"33632","(۳۳۶۳۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ اشْتَرَی سَبِیَّۃً مِنَ الْمَغْنَمِ ، فَوَجَدَ مَعَہَا فِضَّۃً ، قَالَ : یَرُدُّہ۔","","Musannaf Ibn Abi Shaybah 33632","","","كتاب الجهاد"
"33633","(۳۳۶۳۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِبَیْعِ مِنْ یَزِیدُ کَذَلِکَ کَانَتْ تُبَاعُ الأَخْمَاسُ۔","","Musannaf Ibn Abi Shaybah 33633","","","كتاب الجهاد"
"33634","(۳۳۶۳۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بَعَثَ عَمِیرَۃَ بْنَ زَیْدِ الْفِلَسْطِینِیِّ یَبِیعُ السَّبْیَ فِیمَنْ یَزِیدُ۔","","Musannaf Ibn Abi Shaybah 33634","","","كتاب الجهاد"
"33635","(۳۳۶۳۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا بَیْعَ مَنْ یَزِیدُ إِلاَّ بَیْعَ الْمَوَارِیثِ وَالْغَنَائِمِ۔","","Musannaf Ibn Abi Shaybah 33635","","","كتاب الجهاد"
"33636","(۳۳۶۳۶) حَدَّثَنَا عِیسی بْنُ یُونُسَ وَمُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الأَخْضَرِ بْنِ عَجْلاَنَ ، عَنْ أَبِی بَکْرٍ الْحَنَفِیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَاعَ حِلْسًا وَقَدَحًا فِیمَنْ یَزِیدُ ، إِلاَّ أَنَّ مُعْتَمِرًا ، قَالَ : عَنْ أَنَسٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 33636","","","كتاب الجهاد"
"33637","(۳۳۶۳۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ أَنَّ الْمُغِیرَۃَ بْنَ شُعْبَۃَ بَاعَ الْمَغَانِمَ فِیمَنْ یَزِیدُ۔","Sahih","Musannaf Ibn Abi Shaybah 33637","","","كتاب الجهاد"
"33638","(۳۳۶۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حِزَامُ بْنُ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْت عُمَرَ بَاعَ إبِلاً مِنْ إبِلِ الصَّدَقَۃِ فِیمَنْ یَزِیدُ۔","Hasan","Musannaf Ibn Abi Shaybah 33638","","","كتاب الجهاد"
"33639","(۳۳۶۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِبَیْعِ الْمُزَایَدَۃِ۔","","Musannaf Ibn Abi Shaybah 33639","","","كتاب الجهاد"
"33640","(۳۳۶۴۰) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَکْرَہُ بَیْعَ مَنْ یَزِیدُ إِلاَّ الشُّرَکَائَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 33640","","","كتاب الجهاد"
"33641","(۳۳۶۴۱) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ، قَالَ: لاَ بَأْسَ بِبَیْعِ مَنْ یَزِیدُ: أَنْ تَزِیدَ فِی السَّوْمِ إذَا أَرَدْت أَنْ تَشْتَرِیَ۔","","Musannaf Ibn Abi Shaybah 33641","","","كتاب الجهاد"
"33642","(۳۳۶۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ عَمَّنْ سَمِعَ مُجَاہِدًا وَعَطَائً یَقُولاَنِ : لاَ بَأْسَ بِبَیْعِ مَنْ یَزِیدُ۔","","Musannaf Ibn Abi Shaybah 33642","","","كتاب الجهاد"
"33643","(۳۳۶۴۳) حَدَّثَنَا عَثام بْنُ عَلِیٍّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ مُضَرِّبٍ ، قَالَ : قسَمَ عُمَرُ السَّوَادَ بَیْنَ أَہْلِ الْکُوفَۃِ فَأَصَابَ کُلُّ رَجُلٍ مِنْہُمْ ثَلاَثَۃَ فَلاَّحِینَ ، فَقَالَ لَہُ عُمَرُ : فَمَنْ یَکُونُ لَہُمْ بَعْدَہُمْ ، فَتَرَکَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33643","","","كتاب الجهاد"
"33644","(۳۳۶۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، قَالَ : کَانَ لِبُجَیْلَۃَ رُبْعُ السَّوَادِ ، فَقَالَ عُمَرُ : لَوْلاَ أَنِّی قَاسِمٌ مَسْئُولٌ مَا زِلْتُمْ عَلَی الَّذِی قُسِمَ لَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33644","","","كتاب الجهاد"
"33645","(۳۳۶۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیْرِ بْنِ یَسَارٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ ظَہَرَ عَلَی خَیْبَرَ ، وَصَارَتْ خَیْبَرُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمِینَ ، ضَعُفُوا عن عَمَلِہَا فَدَفَعُوہَا إلَی الْیَہُودِ یَعْمَلُونَہا وَینفقون عَلَیْہَا عَلَی أَنَّ لَہُمْ نِصْفَ مَا خَرَجَ مِنْہَا فَقَسَمَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی سِتَّۃٍ وَثَلاَثِینَ سَہْمًا ، لِکُلِّ سَہْمٍ مِئَۃُ سَہْمٍ ، فَجَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نِصْفَ ذَلِکَ کُلِّہِ للمسلمین ، فَکَانَ فِی ذَلِکَ النِّصْفِ سِہَامُ الْمُسْلِمِینَ وَسَہْمُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَعَہُمْ وَجَعَلَ النِّصْفَ الآخَرَ لِمَنْ یَنْزِلُ بِہِ الْوُفُودُ وَالأُمُورُ وَنَوَائِبُ النَّاسِ۔ (ابوداؤد ۳۰۰۴)","Sahih","Musannaf Ibn Abi Shaybah 33645","","","كتاب الجهاد"
"33646","(۳۳۶۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : قَالَ عُمَرُ : لَئِنْ بَقِیْتُ لآخُذَنَّ فَضْلَ مَالِ الأَغْنِیَائِ ، وَلأَقْسِمَنَّہُ فِی فُقَرَائِ الْمُہَاجِرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 33646","","","كتاب الجهاد"
"33647","(۳۳۶۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ وَاصِلٍ الأَحْدَبِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَلَسْت إلَی شَیْبَۃَ بْنِ عُثْمَانَ ، فَقَالَ لِی ، جَلَسَ عُمَرُ بْنُ الْخَطَّابِ مَجْلِسَک ہَذَا ، فَقَالَ : لِی : لَقَدْ ہَمَمْت أَنْ لاَ أَدَعَ فِی الْکَعْبَۃِ صَفْرَائَ ، وَلاَ بَیْضَائَ إِلاَّ قَسَمْتہَا بَیْنَ النَّاسِ ، قَالَ : قُلْتُ لَہُ : لَیْسَ ذَلِکَ إلَیْک ، قَدْ سَبَقَک صَاحِبَاک فَلَمْ یَفْعَلاَ ذَلِکَ ، قَالَ : ہُمَا الْمَرْآنِ یُقْتَدَی بِہِمَا۔ (بخاری ۱۵۹۴۔ احمد ۴۱۰)","Sahih","Musannaf Ibn Abi Shaybah 33647","","","كتاب الجهاد"
"33648","(۳۳۶۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَسْلَمَ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : وَالَّذِی نَفْسُ عُمَرَ بِیَدِہِ ، لَوْلاَ أَنْ یُتْرَکَ آخِرُ النَّاسِ لاَ شَیْئَ لَہُمْ مَا افْتُتِحَ عَلَی الْمُسْلِمِینَ قَرْیَۃٌ مِنْ قُرَی الْکُفَّارِ إِلاَّ قَسَمْتُہَا سُہْمَانًا کَمَا قَسَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَیْبَرَ سُہْمَانًا ، وَلَکِنْ أَرَدْت أَنْ یَکُونَ جِرْیَۃً تَجْرِی عَلَیْہِمْ وَکَرِہْتُ أَنْ یُتْرَکَ آخِرُ النَّاسِ لاَ شَیْئَ لَہُمْ۔ (بخاری ۲۳۳۴۔ احمد ۴۰)","Sahih","Musannaf Ibn Abi Shaybah 33648","","","كتاب الجهاد"
"33649","(۳۳۶۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الشُّعَیْثِیُّ ، عَنْ لَیْثٍ أَبِی الْمُتَوَکِّلِ ، عَنْ مَالِکِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : مَا مِنْ أَحَدٍ مِنَ الْمُسْلِمِینَ إِلاَّ لَہُ فِی ہَذَا الْفَیْئِ نَصِیبٌ إِلاَّ عَبْدٌ مَمْلُوک ، وَلَئِنْ بَقِیت لَیَبْلُغَنَّ الرَّاعِیَ نَصِیبُہُ مِنْ ہَذَا الْفَیْئِ فِی جِبَالِ صَنْعَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 33649","","","كتاب الجهاد"
"33650","(۳۳۶۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ الزُّہْرِیِّ ، عَنْ مَالِکِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ ، عَنْ عُمَرَ ، قَالَ : کَانَتْ أَمْوَالُ بَنِی النَّضِیرِ مِمَّا أَفَائَ اللَّہُ عَلَی رَسُولِہِ مِمَّا لَمْ یُوجِفْ عَلَیْہِ الْمُسْلِمُونَ بِخَیْلٍ ، وَلاَ رِکَابٍ ، فَکَانَتْ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاصَّۃً ، فَکَانَ یَحْبِسُ مِنْہَا نَفَقَۃَ سَنَۃٍ ، وَمَا بَقِیَ جَعَلَہُ فِی الْکُرَاعِ وَالسِّلاَحِ عُدَّۃً فِی سَبِیلِ اللہِ۔ (بخاری ۲۹۰۴۔ مسلم ۱۳۷۶)","Sahih","Musannaf Ibn Abi Shaybah 33650","","","كتاب الجهاد"
"33651","(۳۳۶۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : أُتِیَ عُمَرُ بْنُ الْخَطَّابِ بِغَنَائِمَ مِنْ غَنَائِمِ جَلُولاَئَ فِیہَا ذَہَبٌ وَفِضَّۃٌ ، فَجَعَلَ یَقْسِمُہُمَا بَیْنَ النَّاسِ ، فَجَائَ ابْنٌ لَہُ ، یُقَالَ لَہُ : عَبْدُ الرَّحْمَن ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، اکْسُنِی خَاتَمًا ، قَالَ : اذْہَبْ إلَی أُمِّکَ تَسْقِیک شَرْبَۃً مِنْ سَوِیقٍ ، قَالَ : فَوَاللہِ مَا أَعْطَاہُ شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 33651","","","كتاب الجهاد"
"33652","(۳۳۶۵۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ ، قَالَ : حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ : حَدَّثَنَا أَبُو حَنْظَلَۃَ بْنُ نُعَیم أَنَّ سَعْدًا کَتَبَ إلَی عُمَرَ أَنَّا أَخَذْنَا أَرْضًا لَمْ یُقَاتِلْنَا أَہْلُہَا ، قَالَ : فَکَتَبَ إلَیْہِ عُمَرُ : إِنْ شِئْتُمْ أَنْ تَقْسِمُوہَا بَیْنَکُمْ فَاقْسِمُوہَا ، وَإِنْ شِئْتُمْ أَنْ تَدَعُوہَا فَیَعْمُرُہَا أَہْلُہَا وَمَنْ دَخَلَ فِیکُمْ بَعْدُ کَانَ لَہُ فِیہَا نَصِیبٌ ، فَإِنِّی أَخَافُ أَنْ تَشَاحُّوا فیہا وَفِی شُرْبِہَا فَیَقْتُلُ بَعْضُکُمْ بَعْضًا ، فَکَتَبَ إلَیْہِ سَعْدٌ : إِنَّ الْمُسْلِمِینَ قَدْ أَجْمَعُوا عَلَی أَنَّ رَأْیَہُمْ لِرَأْیِکَ تَبَعٌ ، فَکَتَبَ إلَیْہِ أَنْ یَرُدُّوا الرَّقِیقَ إلَی امْرَأَۃٍ حَمَلَتْ مِنْ رَجُلٍ مِنَ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33652","","","كتاب الجهاد"
"33653","(۳۳۶۵۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ حَنَشٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : قیلَ لاِبْنِ عَبَّاسٍ : أَلِلْعَجَمِ أَنْ یُحْدِثُوا فِی أَمْصَارِ الْمُسْلِمِینَ بِنَائً ، أَوْ بِیعَۃً ، فَقَالَ : أَمَّا مِصْرٍ مَصَّرَتْہُ الْعَرَبُ فَلَیْسَ لِلْعَجَمِ أَنْ یَبْنُوا فِیہِ بِنَائً ، أَوَ قَالَ : بِیعَۃً ، وَلاَ یَضْرِبُوا فِیہِ نَاقُوسًا ، وَلاَ یَشْرَبُوا فِیہِ خَ[corrupt]ْرًا ، وَلاَ یَتَّخِذُوا فِیہِ خِنْزِیرًا ، أَوْ یُدْخِلُوا فِیہِ ، وَأَمَّا مِصْرٍ مَصَّرَتْہُ الْعَجَمُ یَفْتَحُہُ اللَّہُ عَلَی الْعَرَبِ وَنَزَلُوا ، یَعْنِی عَلَی حُکْمِہِمْ فَلِلْعَجَمِ مَا فِی عَہْدِہِمْ، وَلِلْعَجَمِ عَلَی الْعَرَبِ أَنْ یُوَفُّوا بِعَہْدِہِمْ ، وَلاَ یُکَلِّفُوہُمْ فَوْقَ طَاقَتِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33653","","","كتاب الجهاد"
"33654","(۳۳۶۵۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أُبَیِّ بْنِ عَبْدِ اللہِ ، قَالَ : جَائَنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ لاَ تَہْدِمْ بِیعَۃً ، وَلاَ کَنِیسَۃً ، وَلاَ بَیْتَ نَارٍ صُولِحُوا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 33654","","","كتاب الجهاد"
"33655","(۳۳۶۵۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الْکَنَائِسِ ، تُہْدَمُ ، قَالَ : لاَ إِلاَّ مَا کَانَ مِنْہَا فِی الحَرَم۔","","Musannaf Ibn Abi Shaybah 33655","","","كتاب الجهاد"
"33656","(۳۳۶۵۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، أَنَّہُ کَانَ یَکْرَہُ أَنْ تُتْرَکَ الْبِیَعُ فِی أَمْصَارِ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33656","","","كتاب الجهاد"
"33657","(۳۳۶۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : قدْ صُولِحُوا عَلَی أَنْ یُخْلَی بَیْنَہُمْ وَبَیْنَ النِّیرَانِ وَالأَوْثَانِ فِی غَیْرِ الأَمْصَارِ۔","","Musannaf Ibn Abi Shaybah 33657","","","كتاب الجهاد"
"33658","(۳۳۶۵۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حدَّثَنِی ابْنُ سُرَاقَۃَ أَنَّ أَبَا عُبَیْدَۃَ بْنَ الْجَرَّاحِ کَتَبَ لأَہْلِ دَیْرِ طَیَایَا إنِّی أَمَّنْتُکُمْ عَلَی دِمَائِکُمْ وَأَمْوَالِکُمْ وَکَنَائِسِکُمْ أَنْ تُہْدَمَ۔","Hasan","Musannaf Ibn Abi Shaybah 33658","","","كتاب الجهاد"
"33659","(۳۳۶۵۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، أَنَّہُ کَانَ لاَ یَتْرُکُ لأَہْلِ فَارِسَ صَنَمًا إِلاَّ کُسِرَ ، وَلاَ نَارًا إِلاَّ أُطْفِئَتْ۔","","Musannaf Ibn Abi Shaybah 33659","","","كتاب الجهاد"
"33660","(۳۳۶۶۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ عَوْفَ قَالَ : شَہِدْت عَبْدَ اللہِ بْنَ عُبَیْدِ بْنِ مَعْمَرٍ أُتِیَ بِمَجُوسِیٍّ بَنَی بَیْتَ نَارٍ بِالْبَصْرَۃِ فَضَرَبَ عُنُقَہُ۔","","Musannaf Ibn Abi Shaybah 33660","","","كتاب الجهاد"
"33661","(۳۳۶۶۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ الأَحْوَلِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ رَفَعَہُ ، قَالَ : أَخْرِجُوا الْمُشْرِکِینَ مِنْ جَزِیرَۃِ الْعَرَبِ۔ (بخاری ۳۰۵۳۔ مسلم ۱۲۵۷)","Sahih","Musannaf Ibn Abi Shaybah 33661","","","كتاب الجهاد"
"33662","(۳۳۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ مَیْمُونَ ، عَنْ إِسْحَاقَ بْنِ سَعدِ بْنِ سَمُرَۃَ بْنِ جُنْدُبٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ قَالَ : إنَّ آخِرَ کَلاَمُ تَکَلَّمَ بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ ، قَالَ : أَخْرِجُوا الْیَہُودَ مِنْ أَرْضِ الْحِجَازِ وَأَہْلَ نَجْرَانَ مِنْ جَزِیرَۃِ الْعَرَبِ۔ (احمد ۱۹۵۔ دارمی ۲۴۹۸)","Sahih","Musannaf Ibn Abi Shaybah 33662","","","كتاب الجهاد"
"33663","(۳۳۶۶۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : لاَ تَتْرُکُوا الْیَہُودَ وَالنَّصَارَی بِالْمَدِینَۃِ فَوْقَ ثَلاَثٍ قَدْرَ مَا یَبِیعُون سِلْعَتَہُمْ ، وَقَالَ : لاَ یَجْتَمِعُ دِینَانِ فِی جَزِیرَۃِ الْعَرَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 33663","","","كتاب الجهاد"
"33664","(۳۳۶۶۴) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُسَاکِنُوا الْیَہُودَ وَلا النَّصَارَی إِلاَّ أَنْ یُسْلِمُوا۔","Da'if","Musannaf Ibn Abi Shaybah 33664","","","كتاب الجهاد"
"33665","(۳۳۶۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ أَنَّہُ شَہِدَ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ فِی خِلاَفَتِہِ أَخْرَجَ أَہْلَ الذِّمَّۃِ مِنَ الْمَدِینَۃِ ، وَبَاعَ أَرِقَّائَہُمْ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33665","","","كتاب الجهاد"
"33666","(۳۳۶۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا حَجَّاجٌ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَئِنْ بَقِیت لأُخْرِجَنَّ الْمُشْرِکِینَ مِنْ جَزِیرَۃِ الْعَرَبِ ، فَلَمَّا وَلِیَ عُمَرُ أَخْرَجَہُمْ۔n(مسلم ۱۳۸۸۔ ابوداؤد ۳۰۲۴)","","Musannaf Ibn Abi Shaybah 33666","","","كتاب الجهاد"
"33667","(۳۳۶۶۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، قَالَ : قلْنَا لِجَابِرِ بْنِ عَبْدِ اللہِ : أَیَدْخُلُ الْمَجُوسُ الْحَرَمَ ، قَالَ : أَمَّا أَہْلُ ذِمَّتِنَا فَنَعَمْ۔","","Musannaf Ibn Abi Shaybah 33667","","","كتاب الجهاد"
"33668","(۳۳۶۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَیْشًا ، ثُمَّ قَالَ : أَلاَ إنِّی بَرِیئٌ مِنْ کُلِّ مُسْلِمٍ مُقِیمٍ مَعَ مُشْرِکَ ، لاَ تَتَرَاء ی نَارَاہُمَا۔ (ابوداؤد ۲۶۳۸۔ترمذی ۱۶۰۴)","","Musannaf Ibn Abi Shaybah 33668","","","كتاب الجهاد"
"33669","(۳۳۶۶۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ أَنَّ عُمَرَ کَانَ یَخْتِمُ فِی أَعْنَاقِہِمْ ، یَعْنِی أَہْلَ الذِّمَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 33669","","","كتاب الجهاد"
"33670","(۳۳۶۷۰) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا مَیْمُونُ بْنُ مِہْرَانَ ، قَالَ : بَعَثَ عُمَرُ حُذَیْفَۃَ بْنَ الْیَمَانِ ، وَابْنَ حُنَیْفٍ فَفَلَجَا الْجِزْیَۃَ عَلَی أَہْلِ السَّوَادِ فَقَالاَ : مَنْ لَمْ یَجِئْ مِنْ أَہْلِ السَّوَادِ فَیُخْتِمُ فِی عُنُقِہِ بَرِئَتْ مِنْہُ الذِّمَّۃُ۔","","Musannaf Ibn Abi Shaybah 33670","","","كتاب الجهاد"
"33671","(۳۳۶۷۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی الْمَنِیَّۃِ ، قَالَ : أَوْصَی رَجُلٌ مِنْ أَہْلِ الْیَمَامَۃِ بِفَرَسٍ فِی سَبِیلِ اللہِ ، فَقَدِمَ ابْنُ عَمٍّ لِی ، فَقُلْتُ : أَحْمِلُ عَلَیْہِ أَخِی ، فَإِنَّ أَخِی رَجُلٌ صَالِحٌ ، قَالَ : حَتَّی أَسْأَلَ الْحَسَنَ ، فَسَأَلَ الْحَسَنَ ، فَقَالَ : احْمِلْ عَلَیْہِ رَجُلاً ، وَلاَ تَحَابی فِیہِ أَحَدًا ، قَالَ : قُلْتُ لِلْحَسَنِ : فَإِنْ أَحْتَاجُ إلَیْہِ ، قَالَ : فَلْیَبِعْہُ مِنَ الْجُنْدِ ، وَلاَ تُعْطِہِ ہَذِہِ الْمَوَالِیَ فَیَتْرُکُہُ أَحَدُہُمْ نَفَقَۃً لأَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 33671","","","كتاب الجهاد"
"33672","(۳۳۶۷۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَأْتِی مِنْ أَہْلِ الْحَرْبِ ، قَالَ : إمَّا أَنْ یُقِرَّہُ ، وَإِمَّا أَنْ یُبْلِغَہُ مَأْمَنَہُ۔","","Musannaf Ibn Abi Shaybah 33672","","","كتاب الجهاد"
"33673","(۳۳۶۷۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَزَوَّجَ الرَّجُلُ فِی أَرْضِ الْحَرْبِ وَیَدْعُ وَلَدَہُ فِیہِمْ۔","","Musannaf Ibn Abi Shaybah 33673","","","كتاب الجهاد"
"33674","(۳۳۶۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سُئِلَ عَطَائٌ ، عَنِ الرَّجُلِ مِنْ أَہْلِ الذِّمَّۃِ یُؤْخَذُ فِی أَہْلِ الشِّرْک ، فَیَقُولُ : لَمْ أُرِدْ عَوْنَہُمْ عَلَیْکُمْ وَقَدِ اشْتَرَطُوا عَلَیْہِ أَنْ لاَ یَأْتِیَہُمْ فَکَرِہَ قَتْلَہُ إِلاَّ بِبَیِّنَۃٍ ، قَالَ : وَقَالَ حِینَئِذٍ لِعَطَائٍ بَعْضُ أَہْلِ الْعِلْمِ : إذَا نَقَضَ شَیْئًا وَاحِدًا مِمَّا عَلَیْہِ فَقَدْ نَقَضَ الصُّلْحَ۔","","Musannaf Ibn Abi Shaybah 33674","","","كتاب الجهاد"
"33675","(۳۳۶۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی أَہْلِ الذِّمَّۃِ إذَا نَقَضُوا الْعَہْدَ فَلَیْسَ عَلَی الذُّرِّیَّۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33675","","","كتاب الجهاد"
"33676","(۳۳۶۷۶) حَدَّثَنَا یَعْمَرُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا ابْنُ مُبَارَکٍ ، قَالَ : أَخْبَرَنَا صَفْوَانُ بْنُ عَمْرٍو ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ ، عَنْ عَوْفِ بْنِ مَالِکٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا جَائَ الْفَیْئُ قَسَمَہُ مِنْ یَوْمِہِ فَأَعْطَی الآہِلَ حَظَّیْنِ وَأَعْطَی الأَعْزَبَ حَظًّا۔ (ابوداؤد ۲۹۴۶۔ احمد ۲۹)","Sahih","Musannaf Ibn Abi Shaybah 33676","","","كتاب الجهاد"
"33677","(۳۳۶۷۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنْ صَدَقَۃِ بْنِ یَسَارٍ، عَنِ الْقَاسِمِ، قَالَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُبْرِدُ۔","","Musannaf Ibn Abi Shaybah 33677","","","كتاب الجهاد"
"33678","(۳۳۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یُبْرِدُ قَالَ : فَحَمَلَ مَوْلًی لَہُ رَجُلاً عَلَی الْبَرِیدِ بِغَیْرِ إذْنِہِ ، قَالَ : فَدَعَاہُ ، فَقَالَ : لاَ تبرح حَتَّی نُقَوِّمَہُ ، ثُمَّ تَجْعَلَہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 33678","","","كتاب الجهاد"
"33679","(۳۳۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لأُمَرَائِہِ : إذَا أَبَرَدْتُمْ إلَیَّ بَرِیدًا فَأَبْرِدُوہُ حَسَنَ الْوَجْہِ حَسَنَ الاِسْمِ۔ (بزار ۱۹۸۵)","","Musannaf Ibn Abi Shaybah 33679","","","كتاب الجهاد"
"33680","(۳۳۶۸۰) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ أَنَّ مُعَاوِیَۃَ کَتَبَ إلَی عَبْدِ الرَّحْمَنِ بْنِ خَالِدٍ أَنِ احْمِلْ إلَیَّ جَرِیرًا عَلَی الْبَرِیدِ فَحَمَلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33680","","","كتاب الجهاد"
"33681","(۳۳۶۸۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ سَعِیدِ بْنِ جَبَلَۃَ ، عَنْ طَاوُوسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ اللَّہَ بَعَثَنِی بِالسَّیْفِ بَیْنَ یَدَیِ السَّاعَۃِ ، وَجَعَلَ رِزْقِی تَحْتَ ظِلِّ رُمْحِی ، وَجَعَلَ الذُّلَّ وَالصَّغَارَ عَلَی مَنْ خَالَفَنِی ، وَمَنْ تَشَبَّہَ بِقَوْمٍ فَہُوَ مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 33681","","","كتاب الجهاد"
"33682","(۳۳۶۸۲) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنِ الأَوْزَاعِیِّ ، عَنْ سَعِیدِ بْنِ جَبَلَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ ذَکَرَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 33682","","","كتاب الجهاد"
"33683","(۳۳۶۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْخَلِیلِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ إذَا غَزَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَمَلَ مَعَہُ رُمْحًا ، فَإِذَا رَجَعَ طَرَحَہُ کَیْ یُحْمَلَ لَہُ ، فَقَالَ عَلِیٌّ : لأَذْکُرَنَّ ہَذَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لاَ تَفْعَلْ فَإِنَّک إِنْ فَعَلْت لَمْ تُرْفَعْ ضَالَّۃً۔n(ابن ماجہ ۲۸۰۹۔ نسائی ۵۸۰۷)","Hasan","Musannaf Ibn Abi Shaybah 33683","","","كتاب الجهاد"
"33684","(۳۳۶۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُصْعَبُ بْنُ سُلَیْمٍ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ : إنَّ أَبَا مُوسَی أَرَادَ أَنْ یَسْتَعْمِلَ الْبَرَائَ بْنَ مَالِکٍ فَأَبَی ، فَقَالَ لَہُ الْبَرَائُ بْنُ مَالِکٍ : أَعْطِنِی سَیْفِی وَتِرْسِی وَرُمْحِی۔","Sahih","Musannaf Ibn Abi Shaybah 33684","","","كتاب الجهاد"
"33685","(۳۳۶۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مَکْحُولٍ ، قَالَ : إنَّمَا کَانَتِ الْحَرْبَۃُ تُحْمَلُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُصَلِّیَ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 33685","","","كتاب الجهاد"
"33686","(۳۳۶۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُصْعَبُ بْنُ سُلَیْمٍ الزُّہْرِیُّ ، قَالَ : حَدَّثَنَا أَنَسُ بْنُ مَالِکٍ ، قَالَ : لَمَّا بُعِثَ أَبُو مُوسَی عَلَی الْبَصْرَۃِ کَانَ مِمَّنْ بُعِثَ الْبَرَائُ بْنُ مَالِکٍ وَکَانَ مِنْ وَزرَائِہِ ، فَکَانَ یَقُولُ لَہُ : اخْتَرْ عَمَلاً ، فَقَالَ : الْبَرَائُ وَمُعْطِیَّ أَنْتَ مَا سَأَلْتُک ، قَالَ : نَعَمْ ، قَالَ : أَمَا إنِّی لاَ أَسْأَلُک إمَارَۃَ مِصْرٍ ، وَلاَ جِبَایَۃَ خَرَاجٍ ، وَلَکِنْ أَعْطِنِی قَوْسِی وَفَرَسِی وَرُمْحِی وَسَیْفِی وَذَرْنِی إلَی الْجِہَادِ فِی سَبِیلِ اللہِ ، فَبَعَثَہُ عَلَی جَیْشٍ ، فَکَانَ أَوَّلَ مَنْ قُتِلَ۔","Hasan","Musannaf Ibn Abi Shaybah 33686","","","كتاب الجهاد"
"33687","(۳۳۶۸۷) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَن بْنُ ثَابِتٍ ، قَالَ : حَدَّثَنَا حَسَّانُ بْنُ عَطِیَّۃَ ، عَنْ أَبِی مُنِیبٍ الْجُرَشِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ جَعَلَ رِزْقِی تَحْتَ ظل رُمْحِی وَجَعَلَ الذِّلَّۃَ وَالصَّغَارَ عَلَی مَنْ خَالَفَ أَمْرِی ، مَنْ تَشَبَّہَ بِقَوْمٍ فَہُوَ مِنْہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33687","","","كتاب الجهاد"
"33688","(۳۳۶۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ، قَالَ : قَالَ عُمَرُ : اجْتَمِعُوا لِہَذَا الْفَیْئِ حَتَّی نَنْظُرَ فِیہِ ، فَإِنِّی قَرَأْت آیَاتٍ مِنْ کِتَابِ اللہِ اسْتَغْنَیْت بِہَا ، قَالَ اللَّہُ : {مَا أَفَائَ اللَّہُ عَلَی رَسُولِہِ مِنْ أَہْلِ الْقُرَی فَلِلَّہِ وَلِلرَّسُولِ وَلِذِی الْقُرْبَی وَالْیَتَامَی وَالْمَسَاکِینِ وَابْنِ السَّبِیلِ} إلَی قَوْلِہِ : {إنَّ اللَّہَ شَدِیدُ الْعِقَابِ} وَاللہِ مَا ہُوَ لِہَؤُلاَئِ وَحْدَہُمْ ، ثُمَّ قَرَأَ : {لِلْفُقَرَائِ الْمُہَاجِرِینَ الَّذِینَ أُخْرِجُوا مِنْ دِیَارِہِمْ وَأَمْوَالِہِمْ} إلَی قَوْلِہِ {ہُمُ الصَّادِقُونَ} وَاللہِ مَا ہُوَ لِہَؤُلاَئِ وَحْدَہُمْ ، ثُمَّ قَرَأَ : {وَالَّذِینَ جَاؤُوا مِنْ بَعْدِہِمْ} إلَی آخِرِ الآیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 33688","","","كتاب الجهاد"
"33689","(۳۳۶۸۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنِ السُّدِّیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : وَجَدْت الْمَالَ قُسِمَ بَیْنَ ہَذِہِ الثَّلاَثَۃِ الأَصْنَافِ الْمُہَاجِرِینَ وَالأَنْصَارِ وَالَّذِینَ جَاؤُوا مِنْ بَعْدِہِمْ۔","","Musannaf Ibn Abi Shaybah 33689","","","كتاب الجهاد"
"33690","(۳۳۶۹۰) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنِ السُّدِّیِّ ، عَنِ الْحَسَنِ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33690","","","كتاب الجهاد"
"33691","(۳۳۶۹۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، عَنْ أَبِی طَلْحَۃَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا غَلَبَ قَوْمًا أَحَبَّ أَنْ یُقِیمَ بِعَرْصَتِہِمْ ثَلاَثًا۔(احمد ۲۹۔ دارمی ۲۴۵۹)","Da'if","Musannaf Ibn Abi Shaybah 33691","","","كتاب الجهاد"
"33692","(۳۳۶۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، عَنْ أَبِی طَلْحَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (مسلم ۲۲۰۴۔ ابن ابی عاصم ۱۸۹۱)","Sahih","Musannaf Ibn Abi Shaybah 33692","","","كتاب الجهاد"
"33693","(۳۳۶۹۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِیَادِ بْنِ أَنْعُمٍ ، عَنْ خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : قلْت لِلْقَاسِمِ بْنِ مُحَمَّدٍ وَسَالِمِ بْنِ عَبْدِ اللہِ : إنَّ لَنَا غُلاَمًا یَعْمَلُ الْفَخَّارَ بِأَرْضِ الْعَدُوِّ ، ثُمَّ یَبِیعُ فَتَجْتَمِعُ لہ النَّفَقَۃُ وَیُنْفِقُ عَلَیْنَا ، قَالَ : لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33693","","","كتاب الجهاد"
"33694","(۳۳۶۹۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِیَادٍ ، عَنْ خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : قلْت لِلْقَاسِمِ بْنِ مُحَمَّدٍ وَسَالِمِ بْنِ عَبْدِ اللہِ : الرَّجُلُ یَکُونُ مِنَّا فِی أَرْضِ الْعَدُوِّ فَیَصِیدُ الْحِیتَانَ وَیَبِیعُ فَتَجْتَمِعُ لَہُ الدَّرَاہِمُ ، قَالَ : لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33694","","","كتاب الجهاد"
"33695","(۳۳۶۹۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَقْطَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْضًا مِنْ أَرْضِ بَنِی النَّضِیرِ فِیہَا نَخْلٌ وَشُجَیْرٌ ، وَأَقْطَعَ أَبُو بَکْرٍ ، وَعُمَرُ۔","","Musannaf Ibn Abi Shaybah 33695","","","كتاب الجهاد"
"33696","(۳۳۶۹۶) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقْطَعَ الزُّبَیْرَ أَرْضًا مِنْ أَرْضِ بَنِی النَّضِیرِ فِیہَا نَخْلٌ ، وَأَنَّ أَبَا بَکْرٍ أَقْطَعَ الزُّبَیْرَ الْجَرْفَ ، وَأَنَّ عُمَرَ أَقْطَعَہُ الْعَقِیقَ أَجْمَعَ۔","","Musannaf Ibn Abi Shaybah 33696","","","كتاب الجهاد"
"33697","(۳۳۶۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقْطَعَ الزُّبَیْرَ أَرْضًا فِیہَا نَخْلٌ۔","","Musannaf Ibn Abi Shaybah 33697","","","كتاب الجهاد"
"33698","(۳۳۶۹۸) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، قَالَ : سَأَلْتُ مُوسَی بْنَ طَلْحَۃَ فَحَدَّثَنِی أَنَّ عُثْمَانَ أَقْطَعَ خَبَّابًا أَرْضًا وَعَبد اللہ أَرْضًا وَسَعْدًا أَرْضًا وَصُہَیْبًا أَرْضًا۔","Hasan","Musannaf Ibn Abi Shaybah 33698","","","كتاب الجهاد"
"33699","(۳۳۶۹۹) حَدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُوسَی بْنِ طَلْحَۃَ أَنَّ عُثْمَانَ أَقْطَعَ خَمْسَۃً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْنَ مَسْعُودٍ وَسَعْدًا وَالزُّبَیْرَ وَخَبَّابًا وَأُسَامَۃَ بْنَ زَیْدٍ۔","","Musannaf Ibn Abi Shaybah 33699","","","كتاب الجهاد"
"33700","(۳۳۷۰۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ عُمَرَ أَقْطَعَ عَلِیًّا یَنْبُعَ وَأَضَافَ إلَیْہَا غَیْرَہَا۔","","Musannaf Ibn Abi Shaybah 33700","","","كتاب الجهاد"
"33701","(۳۳۷۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الشَّیْبَانِیِّ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ، قَالَ: أَتَی عُمَرَ رَجُلٌ مِنْ ثَقِیفٍ، یُقَالَ لَہُ : نَافِعٌ أَبُو عَبْدِ اللہِ ، قَالَ : فَکَانَ أَوَّلَ مِنَ افْتَلَی الْفَلاَ بِالْبَصْرَۃِ ، قَالَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنْ قِبَلَنَا أَرْضًا بِالْبَصْرَۃِ لَیْسَتْ مِنْ أَرْضِ الْخَرَاجِ ، وَلاَ تَضُرُّ بِأَحَدٍ مِنَ الْمُسْلِمِینَ فَإِنْ رَأَیْت أَنْ تُقْطِعَنِیہَا أَتَّخِذُہَا قَضْبًا لِخَیْلِی فَافْعَلْ ، قَالَ : فَکَتَبَ عُمَرُ إلَی أَبِی مُوسَی : إِنْ کَانَ کَمَا قَالَ فَأَقْطِعْہَا إیَّاہُ۔ (ابوعبید ۶۸۷)","","Musannaf Ibn Abi Shaybah 33701","","","كتاب الجهاد"
"33702","(۳۳۷۰۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : حَدَّثَنَا رَجُلٌ مِنْ بَنِی زُرَیْقٍ ، قَالَ : أَقْطَعَ أَبُو بَکْرٍ طَلْحَۃَ أَرْضًا وَکَتَبَ لَہُ بِہَا کِتَابًا وَأَشْہَدَ بِہِ شُہُودًا فیہم عُمَرُ ، فَأَتَی طَلْحَۃَ عُمَرُ بِالْکِتَابِ ، فَقَالَ : اخْتِمْ عَلَی ہَذَا ، قَالَ : لاَ أَخْتِمُ عَلَیْہِ ، ہَذَا لَکَ دُونَ النَّاسِ قَالَ : فَانْطَلَقَ طَلْحَۃُ وَہُوَ مُغْضَبٌ ، فَأَتَی أَبَا بَکْرٍ ، فَقَالَ : وَاللہِ مَا أَدْرِی أَنْتَ الْخَلِیفَۃُ ، أَوْ عُمَرُ ، قَالَ : لاَ بَلْ عُمَرُ لَکِنَّہُ أَبَی۔","Da'if","Musannaf Ibn Abi Shaybah 33702","","","كتاب الجهاد"
"33703","(۳۳۷۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ جَعْفَرٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَقْطَعَ عَلِیًّا الفقیرین ، وبئر قَیْسٌ ، وَالشَّجَرَۃُ۔","","Musannaf Ibn Abi Shaybah 33703","","","كتاب الجهاد"
"33704","(۳۳۷۰۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی بْنِ قَیْسٍ الْمَأْرِبِیِّ ، عَنْ رَجُلٍ ، عَنْ أَبْیَضَ بْنِ حَمَّالٍ أَنَّہُ اسْتَقْطَعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمِلْحَ الَّذِی بِمَأْرِبَ ، فَأَرَادَ أَنْ یُقْطِعَہُ ، فَقَالَ رَجُلٌ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِنَّہُ کَالْمَائِ الْعِدِّ فَأَبَی أَنْ یُقْطِعَہُ۔ (بخاری ۱۶۸۲۔ ابوداؤد ۳۰۵۹)","Da'if","Musannaf Ibn Abi Shaybah 33704","","","كتاب الجهاد"
"33705","(۳۳۷۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَمْ یُقْطِعْ أَبُو بَکْرٍ ، وَلاَ عُمَرُ ، وَلاَ عَلِی ، وَأَوَّلُ مَنْ أَقْطَعَ الْقَطَائِعَ عُثْمَان ، وَبِیعَتْ أَرَضُونَ فِی إمَارَۃِ عُثْمَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 33705","","","كتاب الجهاد"
"33706","(۳۳۷۰۶) حَدَّثَنَا عَبْدُ الرَّحْمَن بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ حَجَّاجِ بْنِ دِینَارٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ ، أَنَّ أَبَا بَکْرٍ أَقْطَعَ الأَقْرَعَ بْنَ حَابِسٍ وَعُیَیْنَۃَ بْنَ حِصْنٍ أرضا ، وَکَتَبَ لہما عَلَیْہَا کِتَابًا۔","Sahih","Musannaf Ibn Abi Shaybah 33706","","","كتاب الجهاد"
"33707","(۳۳۷۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ الْمُزَنِیّ ، قَالَ : أَخْبَرَنِی رَجُلٌ کَانَ أَبُوہُ أَخْبَرَ النَّاسَ بِہَذَا السَّوَادِ ، یُقَالَ لَہُ : عَبْدُ الْمَلِکِ بْنُ أَبِی حَرَّۃَ ، عَنْ أَبِیہِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ اصْطَفَی عَشْرَ أَرَضِینَ مِنْ أَرْضِ السَّوَادِ ، قَالَ : أَحْصَیْت سَبْعًا وَنَسِیت ثَلاَثًا : الآجَامُ ، ومَغِیضُ الْمَائِ ، وَأَرْضُ آل کِسْرَی ، وَدَیْرُ الْبَرِید ، وَأَرْضُ مَنْ قُتِلَ فِی الْمَعْرَکَۃِ ، وَأَرْضُ مَنْ ہَرَبَ ، قَالَ : فَلَمْ تَزَلْ فِی الدِّیوَانِ کَذَلِکَ صافیۃ حَتَّی أَحْرَقَ الدِّیوَانَ الْحَجَّاجُ ، فَأَخَذَ کُلُّ قَوْمٍ مَا یَلِیہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33707","","","كتاب الجهاد"
"33708","(۳۳۷۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّ عُیُونًا لِمُسَیْلِمَۃَ أَخَذُوا رَجُلَیْنِ مِنَ الْمُسْلِمِینَ فَأَتَوْہُ بِہِمَا ، فَقَالَ لأَحَدِہِمَا : أَتَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ؟ قَالَ : نَعَمْ ، فَقَالَ : أَتَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ؟ قَالَ : نَعَمْ ، قَالَ : أَتَشْہَدُ أَنِّی رَسُولُ اللہِ ؟ قَالَ : فَأَہْوَی إلَی أُذُنَیْہِ ، فَقَالَ : إنِّی أَصَمُّ ، قَالَ : مَا لَکَ إذَا قُلْتُ لَکَ : تَشْہَدُ أَنِّی رَسُولُ اللہِ ، قُلْتُ إنِّی أَصَمُ ، فَأَمَرَ بِہِ فَقُتِلَ ، وَقَالَ لِلآخَرِ : أَتَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، قَالَ : نَعَمْ ، فَقَالَ : أَتَشْہَدُ أَنِّی رَسُولُ اللہِ ، قَالَ : نَعَمْ ، فَأَرْسَلَہُ ، فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ : ہَلَکْت ، قَالَ : وَمَا شَأْنُک فَأَخْبَرُوہُ بِقِصَّتِہِ وَقِصَّۃِ صَاحِبِہِ ، فَقَالَ : أَمَّا صَاحِبُک فَمَضَی عَلَی إیمَانِہِ ، وَأَمَّا أَنْتَ فَأَخَذْتَ بِالرُّخْصَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 33708","","","كتاب الجهاد"
"33709","(۳۳۷۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُخَارِقِ بْنِ خَلِیفَۃَ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ سَلْمَانَ ، قَالَ : دَخَلَ رَجُلٌ الْجَنَّۃَ فِی ذُبَابٍ وَدَخَلَ رَجُلٌ النَّارَ فِی ذُبَابٍ ، مَرَّ رَجُلاَنِ عَلَی قَوْمٍ قَدْ عَکَفُوا عَلَی صَنَمٍ لَہُمْ وَقَالُوا : لاَ یَمُرُّ عَلَیْنَا الْیَوْمَ أَحَدٌ إِلاَّ قَدَّمَ شَیْئًا ، فَقَالُوا لأَحَدِہِمَا : قَدِّمْ شَیْئًا ، فَأَبَی فَقُتِلَ ، وَقَالُوا : لِلآخَرِ : قَدِّمْ شَیْئًا ، فَقَالُوا : قَدِّمْ وَلَوْ ذُبَابًا ، فَقَالَ : وَأَیْشٍ ذُبَابٌ ، فَقَدَّمَ ذُبَابًا فَدَخَلَ النَّارَ ، فَقَالَ سَلْمَانُ : فَہَذَا دَخَلَ الْجَنَّۃَ فِی ذُبَابٍ ، وَدَخَلَ ہَذَا النَّارَ فِی ذُبَابٍ۔ (بیہقی ۷۳۴۳۔ ابو نعیم ۲۰۳)","Sahih","Musannaf Ibn Abi Shaybah 33709","","","كتاب الجهاد"
"33710","(۳۳۷۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ فِی رَجُلٍ أَخَذَہُ الْعَدُوُّ فَأَکْرَہُوہُ عَلَی شُرْبِ الْخَمْرِ وَأَکْلِ الْخِنْزِیرِ ، قَالَ : إِنْ أَکَلَ وَشَرِبَ فَرُخْصَۃٌ ، وَإِنْ قُتِلَ أَصَابَ خَیْرًا۔","","Musannaf Ibn Abi Shaybah 33710","","","كتاب الجهاد"
"33711","(۳۳۷۱۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ بُرْدٍ، عَنْ مَکْحُولٍ، قَالَ: لَیْسَ فِی الْخَمْرِ رُخْصَۃٌ لأَنَّہَا لاَ تَرْوِی۔","","Musannaf Ibn Abi Shaybah 33711","","","كتاب الجهاد"
"33712","(۳۳۷۱۲) حَدَّثَنَا عَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ عُمَرَ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ أَبَا جَعْفَرٍ یَقُولُ : التَّقِیَّۃُ لاَ تَحِلُّ إِلاَّ کَمَا تَحِلُّ الْمَیْتَۃُ لِلْمُضْطَرِّ۔","","Musannaf Ibn Abi Shaybah 33712","","","كتاب الجهاد"
"33713","(۳۳۷۱۳) حَدَّثَنَا مَرْوَانُ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : التَّقِیَّۃُ جَائِزَۃٌ لِلْمُؤْمِنِ إِلَی یَوْمِ الْقِیَامَۃِ إِلاَّ أَنَّہُ کَانَ لاَ یَجْعَلُ فِی الْقَتْلِ تَقِیَّۃً۔","","Musannaf Ibn Abi Shaybah 33713","","","كتاب الجهاد"
"33714","(۳۳۷۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : التَّقِیَّۃُ إنَّمَا ہِیَ بِاللِّسَانِ لَیْسَتْ بِالْیَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 33714","","","كتاب الجهاد"
"33715","(۳۳۷۱۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ (إِلاَّ أَنْ تَتَّقُوا مِنْہُمْ تُقَاۃً) ، قَالَ : التَّقِیَّۃُ بِاللِّسَانِ وَلَیْسَ بِالْعَمَلِ۔","","Musannaf Ibn Abi Shaybah 33715","","","كتاب الجهاد"
"33716","(۳۳۷۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : سَمِعْتہ یَقُولُ : لاَ إیمَانَ لِمَنْ لاَ تَقِیَّۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 33716","","","كتاب الجهاد"
"33717","(۳۳۷۱۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، عَنْ عَبْدِ اللہِ ، قَالَ : مَا مِنْ کَلاَمٍ أَتَکَلَّمُ بِہِ بَیْنَ یَدَیْ سُلْطَانٍ یَدْرَأُ عَنِّی بِہِ مَا بَیْنَ سَوْطٍ إلَی سَوْطَیْنِ إِلاَّ کُنْتُ مُتَکَلِّمًا بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33717","","","كتاب الجهاد"
"33718","(۳۳۷۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : التَّقِیَّۃُ أَوْسَعُ مَا بَیْنَ السَّمَائِ إلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 33718","","","كتاب الجهاد"
"33719","(۳۳۷۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ مَرْزُوقٍ ، عَنِ الْحَسَنِ بْنِ أَبِی الْحَسَنِ ، قَالَ : إنَّمَا التَّقِیَّۃُ رُخْصَۃٌ ، وَالْفَضْلُ الْقِیَامُ بِأَمْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 33719","","","كتاب الجهاد"
"33720","(۳۳۷۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ حُذَیْفَۃُ : إنِّی أَشْتَرِی دِینِی بَعْضَہُ بِبَعْضٍ مَخَافَۃَ أَنْ یَذْہَبَ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 33720","","","كتاب الجهاد"
"33721","(۳۳۷۲۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، قَالَ : دَخَلَ ابْنُ مَسْعُودٍ وَحُذَیْفَۃُ عَلَی عُثْمَانَ ، فَقَالَ عُثْمَان لِحُذَیْفَۃَ : بَلَغَنِی أَنَّک قُلْتَ کَذَا وَکَذَا ، قَالَ : لاَ وَاللہِ مَا قُلْتہ ، فَلَمَّا خَرَجَ ، قَالَ لَہُ عَبْدُ اللہِ : سألک فَلَمْ تقر لہ ما سَمِعَتُکَ تَقُولُ ، فقَالَ : إنِّی أَشْتَرِی دِینِی بَعْضَہُ بِبَعْضٍ مَخَافَۃَ أَنْ یَذْہَبَ کُلُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33721","","","كتاب الجهاد"
"33722","(۳۳۷۲۲) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ عُمَرُ یُغْزِی الْعَزَبَ وَیَأْخُذُ فَرَسَ الْمُقِیمِ فَیُعْطِیہ الْمُسَافِرَ۔","","Musannaf Ibn Abi Shaybah 33722","","","كتاب الجهاد"
"33723","(۳۳۷۲۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ أَبِی سَعد ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : کَانَ لِعُمَرَ أَرْبَعَۃُ آلاَفِ فَرَسٍ عَلَی آرِیّ بِالْکُوفَۃِ مَوْسُومَۃً عَلَی أَفْخَاذِہَا فِی سَبِیلِ اللہِ فَإِنْ کَانَ فِی عَطَائِ الرَّجُلِ حَقُّہُ ، أَوْ کَانَ مُحْتَاجًا أَعْطَاہُ الْفَرَسَ ، ثُمَّ قَالَ : إِنْ أَجْرَیْتہ فَأَعْیَیْتہ ، أَوْ ضَیَّعْتہ مِنْ عَلَفٍ فَأَنْتَ ضَامِنٌ ، وَإِنْ قَاتَلْت عَلَیْہِ فَأُصِیبَ ، أَوْ أُصِبْت فَلَیْسَ عَلَیْک شَیْئٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33723","","","كتاب الجهاد"
"33724","حدثنا أبو عبد الرحمن بقی بن مخلد قَالَ حدثنا عبد اللہ بن محمد بن أبی شیبۃ قَالَ :n(۳۳۷۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : لَمَّا غَزَا سَلْمَانُ الْمُشْرِکِینَ مِنْ أَہْلِ فَارِسَ ، قَالَ : کُفُّوا حَتَّی أَدْعُوَہُمْ کَمَا کُنْتُ أَسْمَعُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُوہُمْ فَأَتَاہُمْ ، فَقَالَ : إنِّی رَجُلٌ مِنْکُمْ وَقَدْ تَرَوْنَ مَنْزِلَتِی مِنْ ہَؤُلاَئِ الْقَوْمِ وَإِنَّا نَدْعُوکُمْ إلَی الإِسْلاَمِ ، فَإِنْ أَسْلَمْتُمْ فَلَکُمْ مِثْلُ مَا لَنَا وَعَلَیْکُمْ مِثْلُ مَا عَلَیْنَا ، وَإِنْ أَبَیْتُمْ فَأَعْطُوا الْجِزْیَۃَ ، عَنْ یَدٍ وَأَنْتُمْ صَاغِرُونَ ، وَإِنْ أَبَیْتُمْ قَاتَلْنَاکُمْ ، قَالُوا : أَمَّا الإِسْلاَمُ فَلاَ نُسْلِمُ ، وَأَمَّا الْجِزْیَۃُ فَلاَ نُعْطِیہَا ، وَأَمَّا الْقِتَالُ فَإِنَّا نُقَاتِلُکُمْ ، قَالَ: فَدَعَاہُمْ کذَلِکَ ثَلاَثَۃَ أَیَّامٍ فَأَبَوْا عَلَیْہِ ، فَقَالَ لِلنَّاسِ : انْہَدُوا إلَیْہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33724","","","كتاب الجهاد"
"33725","(۳۳۷۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَان رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا بَعَثَ أَمِیرًا عَلَی سَرِیَّۃٍ ، أَوْ جَیْشٍ أَوْصَاہُ فِی خَاصَّۃِ نَفْسِہِ بِتَقْوَی اللہِ وَمَنْ مَعَہُ مِنَ الْمُسْلِمِینَ خَیْرًا ، وَقَالَ : اغْزُوا بِاسْمِ اللہِ فِی سَبِیلِ اللہِ تُقَاتِلُونَ مَنْ کَفَرَ بِاللہِ ، اغْزُوا فَلاَ تَغُلُّوا ، وَلاَ تَغْدِرُوا ، وَلاَ تُمَثِّلُوا ، وَلاَ تَقْتُلُوا وَلِیَدًا ، وَإِذَا لَقِیتَ عَدُوَّک مِنَ الْمُشْرِکِینَ فَادْعُہُمْ إلَی إحْدَی ثَلاَثِ خِصَالٍ ، أَوْ خِلاَلٍ ، فَأَیَّتُہُنَّ مَا أَجَابُوک فَاقْبَلْ مِنْہُمْ وَکُفَّ عَنْہُمْ ، ثُمَّ ادْعُہُمْ إلَی الإِسْلاَمِ فَإِنْ أَجَابُوک فَاقْبَلْ وَکُفَّ عَنْہُمْ ، ثُمَّ ادْعُہُمْ إلَی التَّحَوُّلِ مِنْ دَارِہِمْ إلَی دَارِ الْمُہَاجِرِینَ وَأَعْلِمْہُمْ أَنَّہُمْ إذَا فَعَلُوا ذَلِکَ أَنَّ لَہُمْ مَا لِلْمُہَاجِرِینَ ، وَأَنَّ عَلَیْہِمْ مَا عَلَی الْمُہَاجِرِینَ ، فَإِنْ أَبَوْا وَاخْتَارُوا دِیَارَہُمْ فَأَعْلِمْہُمْ أَنَّہُمْ یَکُونُونَ کَأَعْرَابِ الْمُسْلِمِینَ ، یَجْرِی عَلَیْہِمْ حُکْمُ اللہِ الَّذِی یَجْرِی عَلَی الْمُؤْمِنِینَ ، وَلاَ یَکُونُ لَہُمْ فِی الْفَیْئِ وَالْغَنِیمَۃِ نَصِیبٌ إِلاَّ أَنْ یَغْزُوا مَعَ الْمُسْلِمِینَ ، فَإِنْ أَبَوْا فَادْعُہُمْ إلَی إعْطَائِ الْجِزْیَۃِ فَإِنْ أَجَابُوا فَاقْبَلْ مِنْہُمْ وَکُفَّ عَنْہُمْ ، وَإِنْ أَبَوْا فَاسْتَعِنْ بِاللہِ ، ثُمَّ قَاتِلْہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33725","","","كتاب الجهاد"
"33726","(۳۳۷۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ الْحَکَمِ النَّخَعِیِّ ، قَالَ : حَدَّثَنَا أَبُو سَبْرَۃَ النَّخَعِیُّ ، عَنْ فَرْوَۃَ بْنِ مُسَیْکٍ الْمُرَادِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَتَیْتَ الْقَوْمَ فَادْعُہُمْ ، فَمَنْ أَجَابَک فَاقْبَلْ ، وَمَنْ أَبَی فَلاَ تعجل حَتَّی تحدث إِلَیَّ بِہِ۔ (ابوداؤد ۳۹۸۴۔ طبرانی ۸۳۶)","Hasan","Musannaf Ibn Abi Shaybah 33726","","","كتاب الجهاد"
"33727","(۳۳۷۲۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا عُمَرُ بْنُ ذَرٍّ، عَنْ إِسْحَاقَ بْنِ عَبْدِاللہِ بْنِ أَبِی طَلْحَۃَ، عَنْ عَلِیٍّ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَہُ فِی سَرِیَّۃٍ، فَقَالَ لِرَجُلٍ عِنْدَہُ: الْحَقْہُ وَلاَ تَدْعُہُ مِنْ خَلْفِہِ فَقُلْ: إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُک أَنْ تَنْتَظِرَہُ، قَالَ: فَانْتَظَرَہُ حَتَّی جَائَ، فَقَالَ: لاَ تُقَاتِلِ الْقَوْمَ حَتَّی تَدْعُوَہُمْ۔ (طبرانی ۸۲۶۱)","","Musannaf Ibn Abi Shaybah 33727","","","كتاب الجهاد"
"33728","(۳۳۷۲۸) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا شُعْبَۃُ ، عَنْ غَالِبٍ الْعَبْدِیِّ ، عَنْ رَجُلٍ مِنْ بَنِی نُمَیْرٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَوْ جَدِّ أَبِیہِ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لہ : لاَ تُقَاتِلَ الْقَوْمَ حَتَّی تَدْعُوَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33728","","","كتاب الجهاد"
"33729","(۳۳۷۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا لَقِیتُمَ الْعَدُوَّ فَادْعُوہُمْ۔","","Musannaf Ibn Abi Shaybah 33729","","","كتاب الجهاد"
"33730","(۳۳۷۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ، أَنَّہُ کَانَ یُحِبُّ أَنْ یَدْعُوَہُمْ۔","","Musannaf Ibn Abi Shaybah 33730","","","كتاب الجهاد"
"33731","(۳۳۷۳۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِالرَّحْمَنِ، عَنْ أَبِی صَخْرٍ، قَالَ: کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی أَہْلِ دَیْلَمٍ یَدْعُوہُمْ۔","","Musannaf Ibn Abi Shaybah 33731","","","كتاب الجهاد"
"33732","(۳۳۷۳۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَاتَلْتُمَ الْمُشْرِکِینَ فَادْعُوہُمْ۔","","Musannaf Ibn Abi Shaybah 33732","","","كتاب الجهاد"
"33733","(۳۳۷۳۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنِ الأَجْلَحِ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، عَنْ أَبِی الطُّفَیْلِ ، قَالَ : بَعَثَ عَلِیٌّ مَعْقِلاً التَّیْمِیَّ إلَی بَنِی نَاجِیَۃَ ، فَقَالَ : إذَا أَتَیْتَ الْقَوْمَ فَادْعُوہُمْ ثَلاَثًا۔","Hasan","Musannaf Ibn Abi Shaybah 33733","","","كتاب الجهاد"
"33734","(۳۳۷۳۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ أَنَّ عَلِیًّا بَعَثَ الْبَرَائَ بْنَ عَازِبٍ إلَی الْحَرُورِیَّۃِ فَدَعَاہُمْ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 33734","","","كتاب الجهاد"
"33735","(۳۳۷۳۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ أَنَّہُ قَالَ فِی دُعَائِ الْمُشْرِکِینَ قَبْلَ الْقِتَالِ : کُنَّا نَدْعُوا وَنَدَعُ۔","","Musannaf Ibn Abi Shaybah 33735","","","كتاب الجهاد"
"33736","(۳۳۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کُنَّا نَدْعُوا وَنَدَعُ۔","","Musannaf Ibn Abi Shaybah 33736","","","كتاب الجهاد"
"33737","(۳۳۷۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یَدْعُوَہُمْ۔","","Musannaf Ibn Abi Shaybah 33737","","","كتاب الجهاد"
"33738","(۳۳۷۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا قَاتَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَوْمًا قط حَتَّی یَدْعُوَہُمْ۔ (احمد ۲۳۱۔ دارمی ۲۴۴۴)","Hasan","Musannaf Ibn Abi Shaybah 33738","","","كتاب الجهاد"
"33739","(۳۳۷۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفیَان ، عَنْ مَنْصُورُ ، عَنْ إبْرَاہِیمَ ،َقَالَ : سَأَلْتُہ عَنِ الدَّیْلَمِ فَقَالَ : قَدْ عَلِمُوا مَا یَدْعُونَ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 33739","","","كتاب الجهاد"
"33740","(۳۳۷۴۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ لاَ یَدْعُوَ الْمُشْرِکِینَ إذَا لَقِیَہُمْ ، وَقَالَ : إنَّہُمْ قَدْ عَرَفُوا دِینَکُمْ ، وَمَا تَدْعُونَہُمْ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 33740","","","كتاب الجهاد"
"33741","(۳۳۷۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنِ الْعَدُوِّ : ہَلْ یُدْعَوْنَ قَبْلَ الْقِتَالِ ، قَالَ: قَدْ بَلَغَہُمُ الإِسْلاَمُ مُنْذُ بَعَثَ اللَّہُ مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 33741","","","كتاب الجهاد"
"33742","(۳۳۷۴۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْت إلَی نَافِعٍ أَسْأَلُہُ عَنْ دُعَائِ الْمُشْرِکِینَ ، قَالَ : فَکَتَبَ إلَیَّ : أَخْبَرَنِی ابْنُ عُمَرَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَغَارَ عَلَی بَنِی الْمُصْطَلِقِ وَہُمْ غَارُّونَ وَنَعَمُہُمْ تُسْقَی عَلَی الْمَائِ ، وَکَانَتْ جُوَیْرِیَۃُ بِنْتُ الْحَارِثِ مِمَّا أَصَابَ ، قَالَ : وَکُنْت فِی الْخَیْلِ۔n(بخاری ۲۵۴۱۔ مسلم ۱۳۵۶)","Sahih","Musannaf Ibn Abi Shaybah 33742","","","كتاب الجهاد"
"33743","(۳۳۷۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ الْیَمَامِیِّ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ بْنِ الأَکْوَعِ ، عَنْ أَبِیہِ ، قَالَ : غَزَوْنَا مَعَ أَبِی بَکْرٍ ہَوَازِنَ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَیْنَا مَائً لِبَنِی فَزَارَۃَ فَعَرَّسْنَا حَتَّی إذَا کان عِنْدَ الصَّبَاحِ شَنَنَّاہا عَلَیْہِمْ غَارَۃً۔ (مسلم ۱۳۷۵۔ ابوداؤد ۲۵۸۹)","Sahih","Musannaf Ibn Abi Shaybah 33743","","","كتاب الجهاد"
"33744","(۳۳۷۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا صَالِحُ بْنُ أَبِی الأَخْضَرِ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : بَعَثَنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی قَرْیَۃٍ ، یُقَالَ لَہَا یُبْنَی ، فَقَالَ : ائْتِہَا صَبَاحًا ، ثُمَّ حَرِّقْ۔n(ابوداؤد ۲۶۰۹۔ احمد ۲۰۵)","Da'if","Musannaf Ibn Abi Shaybah 33744","","","كتاب الجهاد"
"33745","(۳۳۷۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ، قَالَ : غَزَوْنَا مَعَ أَبِی بَکْرٍ ہَوَازِنَ فَأَتَیْنَا أَہْلَ مَائٍ فَبَیَّتْنَاہُمْ فَقَتَلْنَا مِنْہُمْ تِسْعَۃً ، أَوْ سَبْعَۃً أَہْلَ أَبْیَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 33745","","","كتاب الجهاد"
"33746","(۳۳۷۴۶) حَدَّثَنَا عَلِیُّ بْنُ حَفْصٍ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَارَ إلَی خَیْبَرَ فَانْتَہَی إلَیْہَا لَیْلا ، وَکَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا طَرَقَ قَوْمًا لَمْ یُغِرْ عَلَیْہِمْ حَتَّی یُصْبِحَ۔ (بخاری ۳۷۱۔ مسلم ۱۰۴۴)","Hasan","Musannaf Ibn Abi Shaybah 33746","","","كتاب الجهاد"
"33747","(۳۳۷۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ رَجُلٍ ، قَالَ : کُنَّا نُغِیرُ عَلَیْہِمْ فَنُصِیبُ مِنْہُمْ ، وَأَبُو مُوسَی یَسْمَعُ أَصْوَاتَنَا۔","Da'if","Musannaf Ibn Abi Shaybah 33747","","","كتاب الجهاد"
"33748","(۳۳۷۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ النَّضْرِ بْنِ عَرَبیٍّ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَکْتُبُ إلَی أُمَرَائِ الأَجْنَادِ یَنْہَاہُمْ عَنْ إغَارَۃِ الشِّتَائِ۔","","Musannaf Ibn Abi Shaybah 33748","","","كتاب الجهاد"
"33749","(۳۳۷۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ نَوْفَلِ بْنِ مُسَاحِقٍ ، عَنْ رَجُلٍ مِنْ مُزَیْنَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا بَعَثَ سَرِیَّۃً ، قَالَ لَہُمْ : إذَا رَأَیْتُمْ مَسْجِدًا ، أَوْ سَمِعْتُمْ مُؤَذِّنًا فَلاَ تَقْتُلُوا أَحَدًا۔ (ابوداؤد ۲۶۲۸۔ ترمذی ۱۵۴۹)","Da'if","Musannaf Ibn Abi Shaybah 33749","","","كتاب الجهاد"
"33750","(۳۳۷۵۰) حَدَّثَنَا عَلِیُّ بْنُ حَفْصٍ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا طَرَقَ قَوْمًا فإنْ سَمِعَ أَذَانًا أَمْسَکَ۔ (بخاری ۶۱۰۔ احمد ۲۳۶)","Hasan","Musannaf Ibn Abi Shaybah 33750","","","كتاب الجهاد"
"33751","(۳۳۷۵۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ، عَنْ أَبِی جَعْفَرٍ، عَنِ الرَّبِیعِ، عَنْ أَبِی الْعَالِیَۃِ أَنَّ أَبَا بَکْرٍ کَانَ إذَا بَعَثَ جَیْشًا إلَی أَہْلِ الرِّدَّۃِ ، قَالَ : اجْلِسُوا قَرِیبًا ، فَإِنْ سَمِعْتُمَ النِّدَائَ إلَی أَنْ تَطْلُعَ الشَّمْسُ وَإِلاَّ فَأَغِیرُوا عَلَیْہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33751","","","كتاب الجهاد"
"33752","(۳۳۷۵۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا أَبُو حَیَّانَ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : کَانَ بَیْنِی وَبَیْنَ کَاتِبِ عُبَیْدِ اللہِ صَدَاقَۃٌ وَمَعْرِفَۃٌ ، فَکَتَبْتُ إلَیْہِ أَنْ یَنْسَخَ لِی رِسَالَۃَ عَبْدِ اللہِ بْنِ أَبِی أَوْفَی ، فَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسْأَلُوا لِقَائَ الْعَدُوِّ ، وَإِذَا لَقِیتُمُوہُمْ فَاصْبِرُوا وَاعْلَمُوا أَنَّ الْجَنَّۃَ تَحْتَ ظِلاَلِ السُّیُوفِ ، وَکَانَ یَنْتَظِرُ ، فَإِذَا زَالَتِ الشَّمْسُ نَہَدَ إلَی عَدُوِّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33752","","","كتاب الجهاد"
"33753","(۳۳۷۵۳) حَدَّثَنَا عَفَّانُ وَزَیْدُ بْنُ الْحُبَابِ ، قَالاَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ عَلْقَمَۃَ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ ، عَنِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، قَالَ : شہدت رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ عِنْدَ الْقِتَالِ لَمْ یُقَاتِلْ أَوَّلَ النَّہَارِ وَآخِرَہُ إلَی أَنْ تَزُولَ الشَّمْسُ وَتَہُبَّ الرِّیَاحُ وَیَتَنَزَّلَ النَّصْرُ۔ (ابوداؤد ۲۶۴۸۔ ترمذی ۱۶۱۳)","Sahih","Musannaf Ibn Abi Shaybah 33753","","","كتاب الجهاد"
"33754","(۳۳۷۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ نُعَیْمِ بْنِ أَبِی ہِنْدٍ ، عَنِ ابْنِ سَمُرَۃَ بْنِ جُنْدُبٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ فَلَہُ السَّلَبُ۔ (ابن ماجہ ۲۸۳۸۔ احمد ۱۲)","Da'if","Musannaf Ibn Abi Shaybah 33754","","","كتاب الجهاد"
"33755","(۳۳۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ بْنِ الأَکْوَعِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ فَلَہُ السَّلَبُ۔ (بخاری ۳۰۵۱۔ ابوداؤد ۲۶۴۶)","Sahih","Musannaf Ibn Abi Shaybah 33755","","","كتاب الجهاد"
"33756","(۳۳۷۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ أَنَسٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ یَوْمَ حُنَیْنٍ : مَنْ قَتَلَ قَتِیلاً فَلَہُ سَلَبُہُ ، فَقَتَلَ أَبُو طَلْحَۃَ یَوْمَئِذٍ عِشْرِینَ رَجُلاً فَأَخَذَ أَسْلاَبَہُمْ۔ (ابوداؤد ۲۷۱۲۔ احمد ۱۱۴)","Sahih","Musannaf Ibn Abi Shaybah 33756","","","كتاب الجهاد"
"33757","(۳۳۷۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ ، عَنْ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، قَالَ : لَمَّا کَانَ یَوْمُ بَدْرٍ قَتَلْتُ سَعِیدَ بْنَ الْعَاصِ وَأَخَذْت سَیْفَہُ ، وَکَانَ سَیْفَہُ یُسَمَّی ذَا الْکَتِیفَۃِ ، قَالَ : وَقُتِلَ أَخِی عُمَیْرٌ ، فَجِئْت بِالسَّیْفِ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اذْہَبْ فَاطْرَحْہُ فِی الْقَبَضِ : فَرَجَعْت وَبِی مَا لاَ یَعْلَمُہُ إِلاَّ اللَّہُ مِنْ قَتْلِ أَخِی وَأَخْذِ سَلَبِی ، فَمَا لَبِثْت إِلاَّ قَلِیلاً حَتَّی نَزَلَتْ سُورَۃُ الأَنْفَالِ ، فَدَعَانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَقَالَ : اذْہَبْ فَخُذْ سَیْفَک۔ (احمد ۱۸۰)","","Musannaf Ibn Abi Shaybah 33757","","","كتاب الجهاد"
"33758","(۳۳۷۵۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : غَزَا ابْنُ عُمَرَ الْعِرَاقَ ، فَقَالَ لَہُ عُمَرُ : بَلَغَنِی أَنَّک بَارَزْت دِہْقَانًا ، قَالَ : نَعَمْ ، فَأَعْجَبَہُ ذَلِکَ فَنَفَّلَہُ سَلَبَہُ۔","","Musannaf Ibn Abi Shaybah 33758","","","كتاب الجهاد"
"33759","(۳۳۷۵۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ شَبْرِ بْنِ عَلْقَمَۃَ ، قَالَ : بَارَزْت رَجُلاً یَوْمَ الْقَادِسِیَّۃِ مِنَ الأَعَاجِمِ فَقَتَلْتہ وَأَخَذْت سَلَبَہُ ، فَأَتَیْت سَعْدًا ، فَخَطَبَ سَعْدٌ أَصْحَابَہُ ، ثُمَّ قَالَ : ہَذَا سَلَبُ شَبْرٍ ، لَہُوَ خَیْرٌ مِنَ اثْنَیْ عَشَرَ أَلْفَ دِرْہَمٍ ، وَإِنَّا قَدْ نَفَّلْنَاہُ إیَّاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33759","","","كتاب الجهاد"
"33760","(۳۳۷۶۰) حَدَّثَنَا عیِسیَ بْنُ یُونُسَ ، عَنِ ابْنِ عَوْنٍ وَہِشَامٌ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ ابْنُ عَوْنٍ : بَارَزَ الْبَرَائُ بْنُ مَالِکٍ ، وَقَالَ ہِشَامٌ : حَمَلَ الْبَرَائُ بْنُ مَالِکٍ عَلَی مَرْزُبَانِ الزَّارَۃِ یَوْمَ الزَّارَۃِ ، وَطَعَنَہُ طَعْنَۃً ، دَقَّ قَرْبُوسَ سَرْجِہِ فَقَتَلَہُ وَسَلَبَہُ سِوَارَیْہِ وَمِنْطَقَتَہُ ، فَلَمَّا قَدِمْنَا صَلَّی عُمَرُ الصُّبْحَ ، ثُمَّ أَتَانَا ، فَقَالَ : أَثَمَّ أَبُو طَلْحَۃَ ؟ فَخَرَجَ إلَیْہِ ، فَقَالَ : إنَّا کُنَّا لاَ نُخَمِّسُ السَّلَبَ ، وَإِنَّ سَلَبَ الْبَرَائِ مَالٌ فَخُمُسُہُ فَبَلَغَ سِتَّۃَ آلاَفٍ ، بَلَغَ ثَلاَثِینَ أَلْفًا ، قَالَ مُحَمَّدُ : فَحَدَّثَنِی أَنَسُ بْنُ مَالِکٍ أَنَّہُ أَوَّلُ سَلَبٍ خُمِّسَ فِی الإِسْلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 33760","","","كتاب الجهاد"
"33761","(۳۳۷۶۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : کَانَ السَّلَبُ لاَ یُخَمَّسُ ، فَکَانَ أَوَّلُ سَلَبٍ خُمِّسَ فِی الإِسْلاَمِ سَلَبُ الْبَرَائِ بْنِ مَالِکَ ، وَکَانَ حَمَلَ عَلَی مَرْزُبَانِ الزَّارَۃِ فَطَعَنَہُ بِالرُّمْحِ حَتَّی دَقَّ قَرْبُوسَ السَّرْجِ ، ثُمَّ نَزَلَ إلَیْہِ فَقَطَعَ مِنْطَقَتَہُ وَسِوَارَیْہِ ، قَالَ : فَلَمَّا قَدِمْنَا الْمَدِینَۃَ صَلَّی عُمَرُ بْنُ الْخَطَّابِ صَلاَۃَ الْغَدَاۃِ ، ثُمَّ أَتَانَا ، فَقَالَ : السَّلاَمُ عَلَیْکُمْ أَثَمَّ أَبُو طَلْحَۃَ ، فَقَالَ : نَعَمْ ، فَخَرَجَ إلَیْہِ ، فَقَالَ عُمَرُ : إنَّا کُنَّا لاَ نُخَمِّسُ السَّلَبَ ، وَإِنَّ سَلَبَ الْبَرَائِ بْنِ مَالِکٍ مَالٌ وَإِنِّی خَامِسُہُ ، فَدَعَا الْمُقَوِّمِینَ فَقُومُوا ثَلاَثِینَ أَلْفًا فَأَخَذَ مِنْہَا سِتَّۃَ آلاَفٍ۔","Sahih","Musannaf Ibn Abi Shaybah 33761","","","كتاب الجهاد"
"33762","(۳۳۷۶۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، قَالَ : حدِّثْتُ ، عَنْ أَبِی قَتَادَۃَ الأَنْصَارِیِّ أَنَّہُ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ قَتِیلاً فَلَہُ سَلَبُہُ قَالَ ، فَقُلْتُ: یَا رَسُولَ اللہِ، قَدْ قَتَلْت قَتِیلاً ذا سلب، ثُمَّ أَجْہَضَتْنِی عَنْہُ الْقِتَالُ فَمَا أَدْرِی مَنْ سَلَبَہُ، قَالَ رَجُلٌ مِنْ أَہْلِ مَکَّۃَ: صَدَقَ یَا رَسُولَ اللہِ ، قَدْ قَتَلَ قَتِیلاً فَسَلَبْتُہُ فَأرْضِہِ عَنِّی ، قَالَ أَبُو بَکْرٍ: لاَ وَاللہِ لاَ تَفْعَلْ ، تَنْطَلِقُ إلَی أَسَدٍ مِنْ أُسْدِ اللہِ یُقَاتِلُ عَنْہُ تُقَاسِمُہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَدَقَ ادْفَعْ إلَیْہِ سَلَبَہُ۔n(بخاری ۲۱۰۰۔ ملم ۱۳۷۰)","","Musannaf Ibn Abi Shaybah 33762","","","كتاب الجهاد"
"33763","(۳۳۷۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ بْنِ الأَکْوَعِ ، عَنْ أَبِیہِ ، قَالَ : بَارَزْت رَجُلاً فَقَتَلْتہ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ ہَذَا ؟ قَالُوا ابْنُ الأَکْوَعِ ، قَالَ : لَہُ سَلَبُہُ۔ (مسلم ۱۳۷۴۔ ابوداؤد ۲۶۴۷)","Sahih","Musannaf Ibn Abi Shaybah 33763","","","كتاب الجهاد"
"33764","(۳۳۷۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ الزُّبَیْرَ بَارَزَ رَجُلاً فَقَتَلَہُ ، قَالَ : فَنَفَلَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَلَبَہُ۔ (عبدالرزاق ۹۴۷۷۔ طحاوی ۲۲۶)","","Musannaf Ibn Abi Shaybah 33764","","","كتاب الجهاد"
"33765","(۳۳۷۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أبیہ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : نَفَّلَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَیْفَہُ ، یَعْنِی أَبَا جَہْلٍ۔ (ابوداؤد ۲۷۱۶۔ ابویعلی ۵۲۰۹)","","Musannaf Ibn Abi Shaybah 33765","","","كتاب الجهاد"
"33766","(۳۳۷۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ الْعَبْدِیِّ ، عَنْ شَبْرِ بْنِ عَلْقَمَۃَ ، قَالَ : لَمَّا کَانَ یَوْمُ الْقَادِسِیَّۃِ قَامَ رَجُلٌ مِنْ أَہْلِ فَارِسَ فَدَعَا إلی المبارزۃ فذکر من عظمہ فقام إلیہ رجل قصیر یقال لہ شبر بن علقمۃ قَالَ : فقال بہ الفارسی ہَکَذَا ، یَعْنِی احْتَمَلَہُ ، ثُمَّ ضَرَبَ بِہِ الأَرْضَ فَصَرَعَہُ ، قَالَ : فَأَخَذَ شَبْرٌ خِنْجَرًا کَانَ مَعَ الْفَارِسِیِّ ، فَقَالَ بہ فِی بَطْنِہِ ہکذا ، یَعْنِی فَخَضخَضَہُ ، ثُمَّ انْقَلَبَ عَلَیْہِ فَقَتَلَہُ ، ثُمَّ جَائَ بِسَلَبِہِ إلَی سَعْدٍ فَقُوِّمَ اثْنَیْ عَشَرَ أَلْفًا فَنَفَّلَہُ إیَّاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33766","","","كتاب الجهاد"
"33767","(۳۳۷۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعَتْ نَافِعًا یَقُولُ : لَمْ نَزَلْ نَسْمَعُ مُنْذُ قَطُّ إذَا الْتَقَی الْمُسْلِمُونَ وَالْکُفَّارُ فَقَتَلَ رَجُلٌ مِنَ الْمُسْلِمِینَ رَجُلاً مِنَ الْکُفَّارِ فَإِنَّ سَلَبَہُ لَہُ إِلاَّ أَنْ یَکُونَ فِی مَعْمَعَۃِ الْقِتَالِ فَإِنَّہُ لاَ یُدْرَی مَنْ قَتَلَ قَتِیلاً۔","","Musannaf Ibn Abi Shaybah 33767","","","كتاب الجهاد"
"33768","(۳۳۷۶۸) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ ابْنِ شِہَابٍ ، عَنِ الْقَاسِمِ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنِ السَّلَبِ ، قَالَ : لاَ سَلَبَ إِلاَّ مِنَ النَّفْلِ ، وَفِی النَّفْلِ الْخُمُسُ۔","Sahih","Musannaf Ibn Abi Shaybah 33768","","","كتاب الجهاد"
"33769","(۳۳۷۶۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، وَعَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إلَہَ إِلاَّ اللَّہُ ، فَإذَا قَالَوہا : عَصَمُوا بِہَا أَمْوَالَہُمْ وَدِمَائَہُمْ ، وَحِسَابُہُمْ عَلَی اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 33769","","","كتاب الجهاد"
"33770","(۳۳۷۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ سَعْدِ بْنِ طَارِقٍ ، قَالَ : سَمِعْتُ أَبِی یَقُولُ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ وَحَّدَ اللَّہَ وَکَفَرَ بِمَا یُعْبَدُ مِنْ دُونِہِ حَرُمَ مَالُہُ وَدَمُہُ ، وَحِسَابُہُ عَلَی اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 33770","","","كتاب الجهاد"
"33771","(۳۳۷۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : بَعَثَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْحُرَقَاتِ مِنْ جُہَیْنَۃَ ، قَالَ : فَصَبَّحْنَا الْقَوْمَ وَقَدْ نَُذروا بِنَا ، قَالَ : فَخَرَجْنَا فِی آثَارِہِمْ فَأَدْرَکْت رَجُلاً مِنْہُمْ فَجَعَلْتُ إذَا لَحِقْتہ قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، قَالَ : فَظَنَنْت أنہ إنَّمَا یَقُولُہَا فَرَقًا ، قَالَ : فَحَمَلْت عَلَیْہِ فَقَتَلْتہ فَعَرَضَ فِی نَفْسِی مِنْ أَمْرِہِ ، فَذَکَرْت ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، ثُمَّ قَتَلْتَہُ قُلْتُ : یَا رَسُولَ اللہِ ، لَمْ یَقُلْہَا مِنْ قِبَلِ نَفْسِہِ ، إنَّمَا قَالَہَا فَرَقًا مِنَ السِّلاَحِ ، قَالَ : فَقَالَ : قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، ثُمَّ قَتَلْتَہُ فَہَلاَّ شَقَقْتَ عَنْ قَلْبِہِ حَتَّی تَعْلَمَ أَنَّہُ إنَّمَا قَالَہَا فَرَقًا مِنَ السِّلاَحِ ، قَالَ أُسَامَۃُ : فَمَا زَالَ یُکَرِّرُہَا عَلَیَّ : قَالَ : لاَ إلَہ إِلاَّ اللَّہُ ، ثُمَّ قَتَلْتہ حَتَّی وَدِدْت أَنِّی لَمْ أَکُنْ أَسْلَمْت إِلاَّ یَوْمَئِذٍ۔","Sahih","Musannaf Ibn Abi Shaybah 33771","","","كتاب الجهاد"
"33772","(۳۳۷۷۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانِ ، عَنْ أُسَامَۃَ ، قَالَ : بَعَثْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ ذَکَر نَحْوَ حَدِیثِ أَبِی مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ۔","Hasan","Musannaf Ibn Abi Shaybah 33772","","","كتاب الجهاد"
"33773","(۳۳۷۷۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، قَالَ : حدَّثَنَا حَاتِمُ بْنُ أَبِی صَغِیرَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ أَنَّ عَمْرَو بْنَ أَوْسٍ أَخْبَرَہُ ، أن أباہ أوسًا أَخْبَرَہُ قَالَ : إنَّا لَقُعُودٌ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَقُصُّ عَلَیْنَا وَیُذَکِّرُنَا إذْ أَتَاہُ رَجُلٌ فَسَأَلَہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اذْہَبُوا فَاقْتُلُوہُ ، فَلَمَّا وَلَّی الرَّجُلُ دَعَاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَقَالَ : ہَلْ تَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، قَالَ : نَعَمْ ، قَالَ : اذْہَبُوا فَخَلُّوا سَبِیلَہُ ، وَإِنَّمَا أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إلَہَ إِلاَّ اللَّہُ ، فَإِذَا فَعَلُوا ذَلِکَ حَرُمَ عَلَیَّ دِمَائَہُمْ وَأَمْوَالَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 33773","","","كتاب الجهاد"
"33774","(۳۳۷۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إلَہَ إِلاَّ اللَّہُ ، فَإذَا قَالُوا : لاَ إلَہَ إِلاَّ اللَّہُ ، عَصَمُوا مِنِّی دِمَائَہُمْ وَأَمْوَالَہُمْ إِلاَّ بِحَقِّہَا ، وَحِسَابُہُمْ عَلَی اللہِ ، ثُمَّ قَرَأَ : (إنَّمَا أَنْتَ مُذَکِّرٌ لَسْتَ عَلَیْہِمْ بِمُسَیْطِرٍ)۔","Sahih","Musannaf Ibn Abi Shaybah 33774","","","كتاب الجهاد"
"33775","(۳۳۷۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إلَہَ إِلاَّ اللَّہُ ، فَإذَا قَالُوا : لاَ إلَہَ إِلاَّ اللَّہُ ، حَرُمَتْ عَلَیَّ دِمَائَہُمْ وَأَمْوَالَہُمْ إِلاَّ بِحَقِّہَا ، وَحِسَابُہُمْ عَلَی اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 33775","","","كتاب الجهاد"
"33776","(۳۳۷۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : خَرَجَ الْمِقْدَادُ بْنُ الأَسْوَدِ فِی سَرِیَّۃٍ ، قَالَ : فَمَرُّوا بِرَجُلٍ فِی غَنِیمَۃٍ لَہُ فَأَرَادُوا قَتْلَہُ ، فَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ ، فَقَتَلَہُ مِقْدَادٌ ، فَقِیلَ لَہُ : قَتَلْتَہُ وَہُوَ یَقُولُ : لاَ إلَہَ إِلاَّ اللَّہُ ، فَقَالَ : الْمِقْدَادُ : وَدَّ لَوْ فَرَّ بِأَہْلِہِ وَمَالِہِ ، قَالَ : فَلَمَّا قَدِمُوا ذَکَرُوا ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَزَلَتْ : {یَا أَیُّہَا الَّذِینَ آمَنُوا إذَا ضَرَبْتُمْ فِی سَبِیلِ اللہِ فَتَبَیَّنُوا وَلاَ تَقُولُوا لِمَنْ أَلْقَی إلَیْکُمَ السَّلاَمَ لَسْتَ مُؤْمِنًا تَبْتَغُونَ عَرَضَ الْحَیَاۃِ الدُّنْیَا} قَالَ : الْغَنِیمَۃُ {فَعِنْدَ اللہِ مَغَانِمُ کَثِیرَۃٌ کَذَلِکَ کُنْتُمْ مِنْ قَبْلُ} ، قَالَ : تَکْتُمُونَ إیمَانَکُمْ مِنَ الْمُشْرِکِینَ {فَمَنَّ اللَّہُ عَلَیْکُمْ} فَأَظْہَرُوا الإِسْلاَمَ {فَتَبَیَّنُوا} وَعِیدَ اللہِ {إنَّ اللَّہَ کَانَ بِمَا تَعْمَلُونَ خَبِیرًا}۔","","Musannaf Ibn Abi Shaybah 33776","","","كتاب الجهاد"
"33777","(۳۳۷۷۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَرَّ رَجُلٌ مِنْ بَنِی سُلَیْمٍ عَلَی نَفَرٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ غَنَمٌ لَہُ فَسَلَّمَ عَلَیْہِمْ فَقَالُوا : مَا سَلَّمَ عَلَیْکُمْ إِلاَّ لِیَتَعَوَّذَ مِنْکُمْ فَعَمَدُوا إلَیْہِ فَقَتَلُوہُ وَأَخَذُوا غَنَمَہُ فَأَتَوْا بِہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَنْزَلَ اللَّہُ تَعَالَی : {یَا أَیُّہَا الَّذِینَ آمَنُوا إذَا ضَرَبْتُمْ فِی سَبِیلِ اللہِ فَتَبَیَّنُوا وَلاَ تَقُولُوا لِمَنْ أَلْقَی إلَیْکُمَ السَّلاَمَ لَسْتَ مُؤْمِنًا تَبْتَغُونَ عَرَضَ الْحَیَاۃِ الدُّنْیَا فَعِنْدَ اللہِ مَغَانِمُ کَثِیرَۃٌ} إلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 33777","","","كتاب الجهاد"
"33778","(۳۳۷۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ بِمِثْلِہِ وَلَمْ یَذْکُرْ فَأَتَوْا بِہَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 33778","","","كتاب الجهاد"
"33779","(۳۳۷۷۹) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابَ ، عَنْ عَطَائِ بْنِ یَزِیدَ اللَّیْثِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَدِیِّ بْنِ الْخِیَارِ ، عَنِ الْمِقْدَادِ أَنَّہُ أَخْبَرَہُ أَنَّہُ قَالَ : یَا رَسُولَ اللہِ أَرَأَیْت إِنْ لَقِیت رَجُلاً مِنَ الْکُفَّارِ فَقَاتَلَنِی فَضَرَبَ إحْدَی یَدَیَّ بِالسَّیْفِ فَقَطَعَہَا ، ثُمَّ لاَذَ مِنِّی بِشَجَرَۃٍ ، فَقَالَ : أَسْلَمْت لِلَّہِ ، أَقْتُلُہُ یَا رَسُولَ اللہِ بَعْدَ أَنْ قَالَہَا ، فَقَالَ : صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقْتُلْہُ ، فَقُلْتُ : یَا رَسُولَ اللہِ قَطَعَ یَدِی ، ثُمَّ قَالَ ذَلِکَ بَعْدَ أَنْ قَطَعَہَا أَفَأَقْتُلُہُ ، قَالَ : لاَ تَقْتُلْہُ فَإِنْ قَتَلْتہ فَإِنَّہُ بِمَنْزِلَتِکَ قَبْلَ أَنْ تَقْتُلَہُ وَأَنْتَ بِمَنْزِلَتِہِ قَبْلَ أَنْ یَقُولَ الْکَلِمَۃَ الَّتِی قَالَ۔","Sahih","Musannaf Ibn Abi Shaybah 33779","","","كتاب الجهاد"
"33780","(۳۳۷۸۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ قَالَ : جَائَ أَبُو الْعَالِیَۃِ إلَیَّ وَإِلَی صَاحِبٍ لِی ، فَقَالَ: ہَلُمَّا فَإِنَّکُمَا أَشَبُّ مِنِّی وَأَوْعَی لِلْحَدِیثِ مِنِّی ، قَالَ: فَانْطَلَقْنَا حَتَّی أَتَیْنَا بِشْرَ بْنَ عَاصِمٍ اللَّیْثِیَّ ، فَقَالَ أَبُو الْعَالِیَۃِ : حَدَّثَ ہَذَیْنِ حَدِیثَک ، فقَالَ: حَدَّثَنِی عُقْبَۃُ بْنُ مَالِکٍ اللَّیْثِیُّ قَالَ: بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَرِیَّۃً فَأَغَارَتْ عَلَی الْقَوْمِ فَشَذَّ رَجُلٌ مِنَ الْقَوْمِ وَاتَّبَعَہُ رَجُلٌ مِنَ السَّرِیَّۃِ مَعَہُ سَیْفٌ شَاہِرہ، فَقَالَ: الشَّاذُّ مِنَ الْقَوْمِ، إنِّی مُسْلِمٌ فَلَمْ یَنْظُرْ فِیمَا قَالَ، قَالَ: فَضَرَبَہُ فَقَتَلَہُ، فَنُمِیَ الْحَدِیثُ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَوْلاً شَدِیدًا فَبَلَغَ الْقَاتِلَ فَبَیْنَمَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ إذْ ، قَالَ الْقَاتِلُ : وَاللہِ یَا نَبِیَّ اللہِ مَا قَالَ الَّذِی ، قَالَ إِلاَّ تَعَوُّذًا مِنَ الْقَتْلِ فَأَعْرَضَ عَنْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعَمَّنْ یَلِیہِ مِنَ النَّاسِ ، فَعَلَ ذَلِکَ مَرَّتَیْنِ کُلُّ ذَلِکَ یُعْرِضُ عَنْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یَصْبِرْ أَنْ قَالَ الثَّالِثَۃَ مِثْلَ ذَلِکَ فَأَقْبَلَ عَلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوَجْہِہِ تُعْرَفُ الْمَسَائَۃُ فِی وَجْہِہِ ، فَقَالَ : إنَّ اللَّہَ أَبَی عَلَیَّ فِیمَنْ قَتَلَ مُؤْمِنًا ثَلاَثَ مَرَّاتٍ یَقُولُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 33780","","","كتاب الجهاد"
"33781","(۳۳۷۸۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ عَبْدِ اللہِ ، قَالَ : حَدَّثَنِی إبْرَاہِیمُ بْنُ جَرِیرٍ ، عَنْ جَرِیرٍ ، قَالَ : إِنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَنِی إلَی الْیَمَنِ أُقَاتِلُہُمْ وَأَدْعُوہُمْ ، فَإذَا قَالُوا : لاَ إلَہَ إِلاَّ اللَّہُ حَرُمَتْ عَلَیْکُمْ أَمْوَالُہُمْ وَدِمَاؤُہُمْ۔","","Musannaf Ibn Abi Shaybah 33781","","","كتاب الجهاد"
"33782","(۳۳۷۸۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : لَمَّا ارْتَدَّ مَنِ ارْتَدَّ عَلَی عَہْدِ أَبِی بَکْرٍ أَرَادَ أَبُو بَکْرٍ أَنْ یُجَاہِدَہُمْ ، فَقَالَ عُمَرُ : أَتُقَاتِلُہُمْ وَقَدْ سَمِعْتَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ شَہِدَ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ حَرُمَ مَالُہُ إِلاَّ بِحَقِّہِ وَحِسَابُہُ عَلَی اللہِ ، فَقَالَ أَبُو بَکْرٍ : لأُقَاتِلَ مَنْ فَرَّقَ بَیْنَ الصَّلاَۃِ وَالزَّکَاۃِ ، وَاللہِ لأَقَاتِلَنَّ مَنْ فَرَّقَ بَیْنَہُمَا حَتَّی أَجْمَعَہُمَا قَالَ عُمَرُ : فَقَاتَلْنَا مَعَہُ ، فَکَانَ رُشْدًا ، فَلَمَّا ظَفِرَ بِمَنْ ظَفِرَ بِہِ مِنْہُمْ ، قَالَ : اخْتَارُوا مِنِّی خَصْلَتَیْنِ : إمَّا حَرْبًا مُجَلِّیَۃً وَإِمَّا الْخِطَّۃَ الْمُخْزِیَۃَ ، فَقَالُوا : ہَذِہِ الْحَرْبُ الْمُجَلِّیَۃُ قَدْ عَرَفْنَاہَا فَمَا الْحِطَّۃُ الْمُخْزِیَۃُ ؟ قَالَ : تَشْہَدُونَ عَلَی قَتْلاَنَا أَنَّہُمْ فِی الْجَنَّۃِ وَعَلَی قَتَلاَکُمْ أَنَّہُمْ فِی النَّارِ فَفَعَلُوا۔","Hasan","Musannaf Ibn Abi Shaybah 33782","","","كتاب الجهاد"
"33783","(۳۳۷۸۳) حَدَّثَنَا یَعْمَرٌ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إلَہَ إِلاَّ اللَّہُ۔ (بخاری ۳۹۲۔ ابوداؤد ۲۶۳۴)","Sahih","Musannaf Ibn Abi Shaybah 33783","","","كتاب الجهاد"
"33784","(۳۳۷۸۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، قَالاَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وُجِدَتِ امْرَأَۃٌ مَقْتُولَۃً فِی بَعْضِ مَغَازِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ قَتْلِ النِّسَائِ وَالصِّبْیَانِ۔ (بخاری ۳۰۱۴۔ مسلم ۳)","Sahih","Musannaf Ibn Abi Shaybah 33784","","","كتاب الجهاد"
"33785","(۳۳۷۸۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، وَعَبْدِ الرَّحیم بْنِ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ قَتْلِ النِّسَائِ۔ (احمد ۲۵۶۔ طبرانی ۱۲۰۸۲)","","Musannaf Ibn Abi Shaybah 33785","","","كتاب الجهاد"
"33786","(۳۳۷۸۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ سَمِعْت رَجُلاً یُحَدِّثُ بِمنًی ، عَنْ أَبِیہِ ، قَالَ : بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَرِیَّۃً کُنْتُ فِیہَا ، قَالَ : فَنَہَانَا أَنْ نَقْتُلَ الْعُسَفَائَ وَالْوُصَفَائَ۔n(احمد ۱۳۔ سعید ۲۶۲۸)","Da'if","Musannaf Ibn Abi Shaybah 33786","","","كتاب الجهاد"
"33787","(۳۳۷۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبٍ ، عَنْ عَمِّہِ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا بَعَثَ إِلَی ابْنِ أَبِی الْحُقَیْقِ نَہَاہُ عَنْ قَتْلِ النِّسَائِ وَالْوِلْدَانِ۔ (عبدالرزاق ۹۳۸۵۔ مالک ۴۴۷)","Sahih","Musannaf Ibn Abi Shaybah 33787","","","كتاب الجهاد"
"33788","(۳۳۷۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا بَعَثَ سَرِیَّۃً ، أَوْ جَیْشًا ، قَالَ : لاَ تَقْتُلُوا وَلِیَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 33788","","","كتاب الجهاد"
"33789","(۳۳۷۸۹)حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی الزِّنَادِ، عَنِ الْمُرَقِّعِ بْنِ عَبْدِاللہِ بْنِ صَیْفِیٍّ، عَنْ حَنْظَلَۃَ الْکَاتِبِ، قَالَ: غَزَوْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَرَرْنَا بِامْرَأَۃٍ مَقْتُولَۃٍ ، وَقَدِ اجْتَمَعَ عَلَیْہَا النَّاسُ، قَالَ فَأَفْرَجُوا لَہُ ، فَقَالَ : مَا کَانَتْ ہَذِہِ تُقَاتِلُ فِیمَنْ یُقَاتِلُ ، ثُمَّ قَالَ لِرَجُلٍ : انْطَلِقْ إلَی خَالِدِ بْنِ الْوَلِیدِ فَقُلْ لَہُ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُک یَقُولُ : لاَ تَقْتُلَنَّ ذُرِّیَّۃً ، وَلاَ عَسِیفًا۔ (ابوداؤد ۲۶۶۲۔ احمد ۴۸۸)","Hasan","Musannaf Ibn Abi Shaybah 33789","","","كتاب الجهاد"
"33790","(۳۳۷۹۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ خَالِدِ بْنِ الْفَِرْزِ ، قَالَ : حَدَّثَنِی أَنَسُ بْنُ مَالِکٍ ، قَالَ : کُنْتُ أَحْمِلُ سَفْرَۃَ أَصْحَابِی ، وَکُنَّا إذَا اسْتُنفِرْنَا نَزَلْنَا بِظَہْرِ الْمَدِینَۃِ ، حَتَّی یَخْرُجَ إلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَقُولَ : انْطَلِقُوا بِسْمِ اللہِ ، وَفِی سَبِیلِ اللہِ تُقَاتِلُونَ أَعْدَائَ اللہِ فِی سَبِیلِ اللہِ ، لاَ تَقْتُلُوا شَیْخًا فَانِیًا ، وَلاَ طِفْلاً صَغِیرًا ، وَلاَ امْرَأَۃً ، وَلاَ تَغُلُّوا۔ (ابوداؤد ۲۶۰۷)","Da'if","Musannaf Ibn Abi Shaybah 33790","","","كتاب الجهاد"
"33791","(۳۳۷۹۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَتَبَ عُمَرُ إلَی أُمَرَائِ الأَجْنَادِ أَنْ لاَ تَقْتُلُوا امْرَأَۃً ، وَلاَ صَبِیًّا ، وَأَنْ تَقْتُلُوا مَنْ جَرَتْ عَلَیْہِ الْمَواسِی۔","Sahih","Musannaf Ibn Abi Shaybah 33791","","","كتاب الجهاد"
"33792","(۳۳۷۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : أَتَانَا کِتَابُ عُمَرَ : لاَ تَغُلُّوا، وَلاَ تَغْدِرُوا ، وَلاَ تَقْتُلُوا وَلَیَدًا وَاتَّقُوا اللَّہَ فِی الْفَلاَّحِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33792","","","كتاب الجهاد"
"33793","(۳۳۷۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : حدِّثْتُ أَنَّ أَبَا بَکْرٍ بَعَثَ جُیُوشًا إلَی الشَّامِ فَخَرَجَ یَتْبَعُ یَزِیدَ بْنَ أَبِی سُفْیَانَ ، فَقَالَ : إنِّی أُوصِیک بِعَشْرٍ : لاَ تَقْتُلَنَّ صَبِیًّا ، وَلاَ امْرَأَۃً ، وَلاَ کَبِیرًا ہَرِمًا ، وَلاَ تَقْطَعَنَّ شَجَرًا مُثْمِرًا ، وَلاَ تُخَرِّبَنَّ عَامِرًا ، وَلاَ تَعْقِرَنَّ شَاۃً ، وَلاَ بقرۃ إِلاَّ لِمَأْکَلَۃٍ ، وَلاَ تُغْرِقَنَّ نَخْلاً ، وَلاَ تَحْرِقَنَّہُ وَلاَ تَغُلّ ، وَلاَ تَجْبُنْ۔","","Musannaf Ibn Abi Shaybah 33793","","","كتاب الجهاد"
"33794","(۳۳۷۹۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُقْتَلُ فِی الْحَرْبِ الصَّبِیُّ ، وَلاَ الْمَرْأَۃٌ، وَلاَ الشَّیْخُ الْفَانِی ، وَلاَ یُحْرَقُ الطَّعَامُ ، وَلاَ النَّخْلُ ، وَلاَ تُخَرَّبُ الْبُیُوتُ ، وَلاَ یُقْطَعُ الشَّجَرُ الْمُثْمِرُ۔","","Musannaf Ibn Abi Shaybah 33794","","","كتاب الجهاد"
"33795","(۳۳۷۹۵) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ أَنْ یُقْتَلَ فِی دَارِ الْحَرْبِ الشَّیْخُ الْکَبِیرُ وَالصَّغِیرُ وَالْمَرْأَۃُ وَکَانَ یَکْرَہُ لِلرَّجُلِ إِنْ حَمَلَ مِنْ ہَؤُلاَئِ شَیْئًا مَعَہُ فَثَقُلَ عَلَیْہِ أَنْ یُلْقِیَہُ فِی الطَّرِیقِ۔","","Musannaf Ibn Abi Shaybah 33795","","","كتاب الجهاد"
"33796","(۳۳۷۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : سَمِعْتُ عَطِیَّۃَ الْقُرَظِیَّ یَقُولُ : عُرِضْنَا عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ قُرَیْظَۃَ ، فَکَانَ مَنْ أَنْبَتَ قُتِلَ ، وَمَنْ لَمْ یُنْبِتْ خَلِّیَ سَبِیلَہُ۔n(ابن ماجہ ۲۵۴۱)","Sahih","Musannaf Ibn Abi Shaybah 33796","","","كتاب الجهاد"
"33797","(۳۳۷۹۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَمْرَۃَ الأَنْصَارِیِّ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی امْرَأَۃٍ مَقْتُولَۃٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ ہَذِہِ ، فَقَالَ رَجُلٌ : أَنَا یَا رَسُولَ اللہِ ، أَرْدَفْتہَا خَلْفِی فَأَرَادَتْ قَتْلِی فَقَتَلْتہَا ، فَأَمَرَ بِہَا فَدُفِنَتْ۔ (ابوداؤد ۳۳۳)","","Musannaf Ibn Abi Shaybah 33797","","","كتاب الجهاد"
"33798","(۳۳۷۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا صَدَقَۃُ الدِّمَشْقِیُّ ، عَنْ یَحْیَی بْنِ یَحْیَی الْغَسَّانِیِّ ، قَالَ : کَتَبْت إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَسْأَلُہُ عَنْ ہَذِہِ الآیَۃِ : {وَقَاتِلُوا فِی سَبِیلِ اللہِ الَّذِینَ یُقَاتِلُونَکُمْ وَلاَ تَعْتَدُّوا إنَّ اللَّہَ لاَ یُحِبُّ الْمُعْتَدِینَ} قَالَ : فَکَتَبَ إلَیَّ إِنَّ ذَلِکَ فِی النِّسَائِ وَالذُّرِّیَّۃِ وَمَنْ لَمْ یَنْصِبِ الْحَرْبَ مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 33798","","","كتاب الجهاد"
"33799","(۳۳۷۹۹) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، قَالَ : حَدَّثَنَا ثَابِتُ بْنُ الْحَجَّاجِ الْکِلاَبِیُّ ، قَالَ : قَامَ أَبُو بَکْرٍ فِی النَّاسِ فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : أَلاَ لاَ یُقْتَلُ الرَّاہِبُ فِی الصَّوْمَعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 33799","","","كتاب الجهاد"
"33800","(۳۳۸۰۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ وَمُحَمَّدُ بْنُ عَلِیٍّ ، عَنْ یَزِیدَ بْنِ ہُرْمُزَ ، قَالَ : کَتَبَ نَجْدَۃُ إلَی ابْنِ عَبَّاسٍ یَسْأَلُہُ عَنْ قَتْلِ الْوِلْدَانِ وَیَقُولُ فِی کِتَابِہِ : إِنَّ الْعَالِمَ صَاحِبَ مُوسَی قَدْ قَتَلَ الْوَلِیدَ ، قَالَ : فَقَالَ یَزِیدُ : أَنَا کَتَبْت کِتَابَ ابْنِ عَبَّاسٍ بِیَدِی إلَی نَجْدَۃَ : إنَّک کَتَبْت تَسْأَلُ عَنْ قَتْلِ الْوِلْدَانِ وَتَقُولُ فِی کِتَابِکَ : إنَّ الْعَالِمَ صَاحِبَ مُوسَی قَدْ قَتَلَ الْوَلِیدَ ، وَلَوْ کُنْتَ تَعْلَمُ مِنَ الْوِلْدَانِ مَا عَلِمَ ذَلِکَ الْعَالِمُ مِنْ ذَلِکَ الْوَلِیدِ قَتَلْتَہُ ، وَلَکِنَّک لاَ تَعْلَمُ ، قَدْ نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ قَتْلِہِمْ فَاعْتَزَلَہُمْ۔ (ترمذی ۱۵۵۶۔ مسلم ۱۴۴۴)","","Musannaf Ibn Abi Shaybah 33800","","","كتاب الجهاد"
"33801","(۳۳۸۰۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ أَسْلَمَ مَوْلَی عُمَرَ أَنَّ عُمَرَ کَتَبَ إلَی عُمَّالِہِ یَنْہَاہُمْ عَنْ قَتْلِ النِّسَائِ وَالصِّبْیَانِ وَأَمَرَہُمْ بِقَتْلِ مَنْ جَرَتْ عَلَیْہِ الْمَوَاسِی۔","Sahih","Musannaf Ibn Abi Shaybah 33801","","","كتاب الجهاد"
"33802","(۳۳۸۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانُوا لاَ یَقْتُلُونَ تُجَّارَ الْمُشْرِکِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33802","","","كتاب الجهاد"
"33803","(۳۳۸۰۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، عَنِ الأَسْوَدِ بْنِ سَرِیعٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا بَالُ أَقْوَامٍ بَلَغُوا فِی الْقَتْلِ ، حَتَّی قَتَلُوا الْوِلْدَانَ ؟ ! قَالَ : فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : إنَّمَا ہُمْ أَوْلاَدُ الْمُشْرِکِینَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَلَیْسَ أَخْیَارُکُمْ إنَّمَا ہُمْ أَوْلاَدُ الْمُشْرِکِینَ ؟! إِنَّہُ لَیْسَ مَوْلُودٌ یُولَدُ ، إِلاَّ عَلَی الْفِطْرَۃِ ، حَتَّی یَبْلُغَ فَیُعَبِّرَ عَنْ نَفْسِہِ ، أَوْ یُہَوِّدَہُ أَبَوَاہُ ، أَوْ یُنَصِّرَانِہِ۔ (احمد ۴۳۵۔ دارمی ۲۴۶۳)","Hasan","Musannaf Ibn Abi Shaybah 33803","","","كتاب الجهاد"
"33804","(۳۳۸۰۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ مَوْلَی لِبَنِی عَبْدِ الأَشْہَلِ ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا بَعَثَ جُیُوشَہُ ، قَالَ : لاَ تَقْتُلُوا أَصْحَابَ الصَّوَامِعِ۔ (احمد ۳۰۰۔ بزار ۱۶۷۷)","Da'if","Musannaf Ibn Abi Shaybah 33804","","","كتاب الجهاد"
"33805","(۳۳۸۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : کَانَ یُنْہَی عَنْ قَتْلِ الْمَرْأَۃِ وَالشَّیْخِ الْکَبِیرِ۔","","Musannaf Ibn Abi Shaybah 33805","","","كتاب الجهاد"
"33806","(۳۳۸۰۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجِ بْنِ أَرْطَاۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ یَحْیَی بْنِ أَبِی مُطِیعٍ أَنَّ أَبَا بَکْرٍ الصِّدِّیقَ بَعَثَ جَیْشًا ، فَقَالَ : اغْزُوا بِسْمِ اللہِ اللَّہُمَّ اجْعَلْ وَفَاتَہُمْ شَہَادَۃً فِی سَبِیلِکَ ، ثُمَّ قَالَ : إنَّکُمْ تَأْتُونَ قَوْمًا فِی صَوَامِعَ لَہُمْ فَدَعَوْہُمْ ، وَمَا أَعْمَلُوا أَنْفُسَہُمْ لَہُ ، وَتَأْتُونَ إلَی قَوْمٍ قَدْ فَحَصُوا عَنْ أَوْسَاطِ رُؤُوسِہِمْ أَمْثَالَ الْعَصْبِ فَاضْرِبُوا مَا فَحَصُوا عَنْہُ مِنْ أَوْسَاطِ رُؤُوسِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33806","","","كتاب الجهاد"
"33807","(۳۳۸۰۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَحْوَصِ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ قَتْلِ النِّسَائِ وَالذُّرِّیَّۃِ وَالشَّیْخِ الْکَبِیرِ الَّذِی لاَ حَرَاکَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33807","","","كتاب الجهاد"
"33808","(۳۳۸۰۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ عَطِیَّۃُ بْنُ الْحَارِثِ ، قَالَ : حَدَّثَنَا أَبُو الغَرِیفِ عُبَیْدُ اللہِ بْنُ خَلِیفَۃَ ، عَنْ صَفْوَانَ بْنِ عَسَّالٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا بَعَثَ سَرِیَّۃً ، قَالَ : لاَ تَقْتُلُوا وَلِیَدًا۔ (ابن ماجہ ۲۸۵۷۔ احمد ۲۴۰)","Da'if","Musannaf Ibn Abi Shaybah 33808","","","كتاب الجهاد"
"33809","(۳۳۸۰۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَخْبَرَنِی الصَّعْبُ بْنُ جَثَّامَۃَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنِ الدَّارِ مِنْ دُورِ الْمُشْرِکِینَ یُبَیَّتُونَ وَفِیہِمُ النِّسَائُ وَالْوِلْدَانُ ، فَقَالَ : ہُمْ مِنْہُمْ۔ (بخاری ۳۰۱۲۔ مسلم ۱۳۶۴)","Sahih","Musannaf Ibn Abi Shaybah 33809","","","كتاب الجهاد"
"33810","(۳۳۸۱۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَ بْنِ جُنْدُبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اقْتُلُوا الشُّیُوخَ الْمُشْرِکِینَ وَاسْتَحْیُوا شَرْخَہُمْ۔n(ابوداؤد ۲۶۶۳۔ احمد ۱۲)","Hasan","Musannaf Ibn Abi Shaybah 33810","","","كتاب الجهاد"
"33811","(۳۳۸۱۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْتُلُونَ مِنَ النِّسَائِ وَالصِّبْیَانُ مَا أَعَانَ عَلَیْہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33811","","","كتاب الجهاد"
"33812","(۳۳۸۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ ، عَنِ الْعَدُوِّ إذَا ظُہِرَ عَلَیْہِمْ أَیَقْتُلُ عُلُوجَہُمْ ، قَالَ : کَانَ عُمَرُ یَقْتُلُ الْعُلُوجَ إذَا ظُہِرَ عَلَیْہِمْ وَیُسْبَوْنَ مَعَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33812","","","كتاب الجهاد"
"33813","(۳۳۸۱۳) حَدَّثَنَا یَزِیدُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا خَرَجَتِ الْمَرْأَۃُ مِنَ الْمُشْرِکِینَ تُقَاتِلُ فَلْتُقْتَلْ۔","","Musannaf Ibn Abi Shaybah 33813","","","كتاب الجهاد"
"33814","(۳۳۸۱۴) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ أَبِی إِسْحَاقَ إبْرَاہِیمَ الدَّوْسِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ الدَّوْسِیِّ ، قَالَ : بَعَثَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَرِیَّۃٍ ، وَقَالَ : إِنْ ظَفِرْتُمْ بِفُلاَنٍ وَفُلاَنٍ فَأَحْرِقُوہُمَا بِالنَّارِ ، حَتَّی إذَا کَانَ الْغَدُ بَعَثَ إلَیْنَا ، إنِّی کُنْتُ أَمَرْتُکُمْ بِتَحْرِیقِ ہَذَیْنِ الرَّجُلَیْنِ وَرَأَیْت أَنَّہُ لاَ یَنْبَغِی أَنْ یُعَذِّبَ بِالنَّارِ إِلاَّ اللَّہُ فَإِنْ ظَفِرْتُمْ بِہِمَا فَاقْتُلُوہُمَا۔ (بخاری ۳۰۱۶۔ دارمی ۲۴۶۱)","Da'if","Musannaf Ibn Abi Shaybah 33814","","","كتاب الجهاد"
"33815","(۳۳۸۱۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّہُ ذَکَرَ نَاسًا أَحْرَقَہُمْ عَلِیٌّ ، فَقَالَ : لَوْ کُنْتُ أَنَا لَمْ أَحْرِقْہُمْ بِالنَّارِ لِقَوْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ تُعَذِّبُوا بِعَذَابِ اللہِ ، وَلَوْ کُنْتُ أَنَا لَقَتَلْتُہُمْ لِقَوْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَنْ بَدَّلَ دِینَہُ فَاقْتُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 33815","","","كتاب الجهاد"
"33816","(۳۳۸۱۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حَدَّثَنَا عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُعَذِّبُوا بِالنَّارِ فَإِنَّہُ لاَ یُعَذِّبُ بِالنَّارِ إِلاَّ رَبُّہَا۔ (ابوداؤد ۲۶۶۸۔ حاکم ۲۳۹)","Sahih","Musannaf Ibn Abi Shaybah 33816","","","كتاب الجهاد"
"33817","(۳۳۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَرِیَّۃً فَطَلَبُوا رَجُلاً فَصَعِدَ شَجَرَۃً فَأَحْرَقُوہَا بِالنَّارِ ، فَلَمَّا قَدِمُوا عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخْبَرُوہُ بِذَلِکَ ، فَتَغَیَّر[corrupt] وَجْہُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَالَ : إنِّی لَمْ أُبْعَثْ لأُعَذِّبَ بِعَذَابِ اللہِ ، إنَّمَا بُعِثْت بِضَرْبِ الرِّقَابِ وَشَدِّ الْوَثَاقِ۔","","Musannaf Ibn Abi Shaybah 33817","","","كتاب الجهاد"
"33818","(۳۳۸۱۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ، عَنْ سَعِیدٍ البزَّازِ، عَنْ عُثْمَانَ بْنِ حِیَّانَ، عنْ أُمّ الدَّرْدَائِ أَنَّہَا أَبْصَرَتْ إنْسَانًا أَخَذَ قملۃ، أَوْ بُرْغُوثًا فَأَلْقَاہُ فِی النَّارِ، فَقَالَتْ: إِنَّہُ لاَ یَنْبَغِی لأَحَدٍ أَنْ یُعَذِّبَ بِعَذَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 33818","","","كتاب الجهاد"
"33819","(۳۳۸۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ تُحْرَقَ الْعَقْرَبُ بِالنَّارِ ، وَیَقُولُونَ : مُثْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 33819","","","كتاب الجهاد"
"33820","(۳۳۸۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حُرَیث ، عَنْ یَحْیَی بْنِ عَبَّادٍ أَبِی ہُبَیْرَۃَ أَنَّہُ کَرِہَ أَنْ تُحْرَقَ الْعَقْرَبُ بِالنَّارِ۔","","Musannaf Ibn Abi Shaybah 33820","","","كتاب الجهاد"
"33821","(۳۳۸۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ وَعُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَطَعَ نَخْلَ بَنِی النَّضِیرِ وَحَرَّقَ۔ (احمد ۸۔ بخاری ۳۰۲۱)","Sahih","Musannaf Ibn Abi Shaybah 33821","","","كتاب الجهاد"
"33822","(۳۳۸۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا صَالِحُ بْنُ أَبِی الأَخْضَرِ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ أُسَامَۃَ ، قَالَ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أَرْضٍ یُقَالَ لَہَا أُبْنَی ، فَقَالَ : ائْتِہَا صَبَاحًا ، ثُمَّ حَرِّقْ۔","Da'if","Musannaf Ibn Abi Shaybah 33822","","","كتاب الجهاد"
"33823","(۳۳۸۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانَ قَالَ : بَلَغَنِی عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّہُ أَمَرَ بِالتَّحْرِیقِ ، أَوْ حَرَّقَ۔","","Musannaf Ibn Abi Shaybah 33823","","","كتاب الجهاد"
"33824","(۳۳۸۲۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ أَنَّ عَلِیًّا حَرَّقَ زَنَادِقَۃً بِالسُّوقِ ، فَلَمَّا رَمَی عَلَیْہِمْ بِالنَّارِ ، قَالَ : صَدَقَ اللَّہُ وَرَسُولُہُ ، ثُمَّ انْصَرَفَ فَاتَّبَعْتہ ، فَالْتَفَتَ إلَیَّ ، قَالَ سُوَیْد قُلْتُ : نَعَمْ ، فَقُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ سَمِعْتُک تَقُولُ شَیْئًا ، فَقَالَ : یَا سُوَیْد ، إنِّی مع قَوْمٍ جُہَّالٍ ، فَإِذَا سَمِعْتَنِی أَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَہُوَ حَقٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 33824","","","كتاب الجهاد"
"33825","(۳۳۸۲۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُبَیْدٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أُنَاسٌ یَأْخُذُونَ الْعَطَائَ وَالرِّزْقَ وَیُصَلُّونَ مَعَ النَّاسِ ، وَکَانُوا یَعْبُدُونَ الأَصْنَامَ فِی السِّرِ ، فَأَتَی بِہِمْ عَلِیُّ بْنُ أَبِی طَالِبٍ فَوَضَعَہُمْ فِی الْمَسْجِدِ ، أَوَ قَالَ فِی السِّجْنِ ، ثُمَّ قَالَ : یَا أَیُّہَا النَّاسُ ، مَا تَرَوْنَ فِی قَوْمٍ کَانُوا یَأْخُذُونَ مَعَکُمَ الْعَطَائَ وَالرِّزْقَ وَیَعْبُدُونَ ہَذِہِ الأَصْنَامَ ، قَالَ النَّاسُ : اقْتُلْہُمْ ، قَالَ : لاَ ، وَلَکِنْ أَصْنَعُ بِہِمْ کَمَا صَنَعُوا بِأَبِینَا إبْرَاہِیمَ ، فَحَرَّقَہُمْ بِالنَّارِ۔","","Musannaf Ibn Abi Shaybah 33825","","","كتاب الجهاد"
"33826","(۳۳۸۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ تُرِیحُنِی مِنْ ذِی الْخَلَصَۃِ بَیْتٍ کَانَ لِخَثْعَمَ کَانَتْ تَعْبُدُہُ فِی الْجَاہِلِیَّۃِ ، یُسَمَّی الْکَعْبَۃَ الْیَمَانِیَّۃَ ، قَالَ : فَخَرَجْت فِی خَمْسِینَ وَمِئَۃِ رَاکِبٍ ، قَالَ : فَحَرَقْنَاہَا حَتَّی جَعَلْنَاہَا مِثْلَ الْجَمَلِ الأَجْرَبِ ، قَالَ : بَعَثَ جَرِیرٌ رَجُلاً إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُبَشِّرہ ، فَلَمَّا قَدِمَ عَلَیْہِ ، قَالَ : وَالَّذِی بَعَثَک بِالْحَقِ ، مَا أَتَیْتُک حَتَّی تَرَکْنَاہَا مِثْلَ الْجَمَلِ الأَجْرَبِ ، قَالَ : فَبَرَّکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی أَحْمَسَ خَیْلِہَا وَرِجَالِہَا خَمْسَ مَرَّاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 33826","","","كتاب الجهاد"
"33827","(۳۳۸۲۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ ابن عَبْدِ اللہِ بن الحسن ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی بِالتَّحْرِیقِ وَقَطْعِ الشَّجَرِ فِی أَرْضِ الْعَدُوِّ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 33827","","","كتاب الجهاد"
"33828","(۳۳۸۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ {مَا قَطَعْتُمْ مِنْ لِینَۃٍ} قَالَ : ہِیَ النَّخْلَۃُ دُونَ الْعَجْوَۃِ۔","","Musannaf Ibn Abi Shaybah 33828","","","كتاب الجهاد"
"33829","(۳۳۸۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أبیہ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {مَا قَطَعْتُمْ مِنْ لِینَۃٍ} ، قَالَ : ہِیَ النَّخْلَۃُ۔","","Musannaf Ibn Abi Shaybah 33829","","","كتاب الجهاد"
"33830","(۳۳۸۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ {مَا قَطَعْتُمْ مِنْ لِینَۃٍ} ، قَالَ : ہِیَ النَّخْلَۃُ۔","","Musannaf Ibn Abi Shaybah 33830","","","كتاب الجهاد"
"33831","(۳۳۸۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُسْتَلِمُ بْنُ سَعِیدٍ ، قَالَ : حَدَّثَنَا خُبَیْبُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ خُبَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُرِیدُ وَجْہًا فَأَتَیْتہ أَنَا وَرَجُلٌ مِنْ قَوْمِی فَقُلْنَا : إنَّا نستحی أن یَشْہَدَ قَوْمُنَا مَشْہَدًا لاَ نَشْہَدُہُ مَعَہُمْ ، قَالَ : أَسْلَمْتُمَا ؟ قُلْنَا : لاَ قَالَ : فَإِنَّا لاَ نَسْتَعِینُ بِالْمُشْرِکِینَ عَلَی الْمُشْرِکِینَ ، قَالَ : فَأَسْلَمْنَا وَشَہِدْنَا مَعَہُ۔ (احمد ۴۵۴۔ حاکم ۱۲۱)","Da'if","Musannaf Ibn Abi Shaybah 33831","","","كتاب الجهاد"
"33832","(۳۳۸۳۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ سَعِیدِ بْنِ الْمُنْذِرِ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی أُحُدٍ ، فَلَمَّا خَلَّفَ ثَنِیَّۃَ الْوَدَاعِ نَظَرَ خَلْفَہُ ، فَإِذَا کَتِیبَۃٌ خَشْنَائُ ، فَقَالَ : مَنْ ہَؤُلاَئِ ، قَالُوا : عَبْدُ اللہِ بْنُ أُبَیِّ ابْنُ سَلُولَ وَمَوَالِیہِ مِنَ الْیَہُودِ ، فَقَالَ : وَقَدْ أَسْلَمُوا ، قَالُوا : لاَ قَالَ : فَإِنَّا لاَ نَسْتَعِینُ بِالْکُفَّارِ عَلَی الْمُشْرِکِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 33832","","","كتاب الجهاد"
"33833","(۳۳۸۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ الْقَاسِمَ یَذْکُرُ عَنْ سَلْمَانَ بْنِ رَبِیعَۃَ الْبَاہِلِیِّ أَنَّہُ غَزَا بَلَنْجَرَ وَکَانَ غَزَا فَاسْتَعَانَ بِنَاسٍ مِنَ الْمُشْرِکِینَ عَلَی الْمُشْرِکِینَ ، وَقَالَ : لِیَحْمِلْ أَعْدَائُ اللہِ عَلَی أَعْدَائِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33833","","","كتاب الجهاد"
"33834","(۳۳۸۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنِ ابن نِیَارٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّا لاَ نَسْتَعِینُ بِمُشْرِکٍ۔ (مسلم ۱۴۴۹۔ ابوداؤد ۲۷۲۶)","","Musannaf Ibn Abi Shaybah 33834","","","كتاب الجهاد"
"33835","(۳۳۸۳۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَزَا بِنَاسٍ مِنَ الْیَہُودِ فَأَسْہَمَ لَہُمْ۔ (بیہقی ۵۳)","","Musannaf Ibn Abi Shaybah 33835","","","كتاب الجهاد"
"33836","(۳۳۸۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَغْزُو بِالْیَہُودِ فَیُسْہِمُ لَہُمْ کَسِہَامِ الْمُسْلِمِینَ۔ (ابوداؤد ۲۸۲)","","Musannaf Ibn Abi Shaybah 33836","","","كتاب الجهاد"
"33837","(۳۳۸۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَغْزُو بِالْیَہُودِ فَیُسْہِمُ لَہُمْ۔ (ابوداؤد ۲۸۱۔ ترمذی ۱۵۵۸)","","Musannaf Ibn Abi Shaybah 33837","","","كتاب الجهاد"
"33838","(۳۳۸۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنِ الشَّیْبَانِیِّ أَنَّ سَعْدَ بْنَ مَالِکٍ غَزَا بِقَوْمٍ مِنَ الْیَہُودِ فَرَضَخَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 33838","","","كتاب الجهاد"
"33839","(۳۳۸۳۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ جَابِرٍ، قَالَ: سَأَلْتُ عَامِرًا، عَنِ الْمُسْلِمِینَ یَغْزُونَ بِأَہْلِ الکتاب؟ فقال عامر: أدرکت الأئمۃ الفقیہ منہم وغیر الفقیہ یغزون بأہل الذِّمَّۃِ فَیَقْسِمُونَ لَہُمْ وَیَضَعُونَ عَنْہُمْ من جِزْیَتِہِمْ ، فَذَلِکَ لَہُمْ نَفْلٌ حَسَنٌ۔","","Musannaf Ibn Abi Shaybah 33839","","","كتاب الجهاد"
"33840","(۳۳۸۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : أَدْرَکْت الأَئِمَّۃَ ۔۔۔۔ ثُمَّ ذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 33840","","","كتاب الجهاد"
"33841","(۳۳۸۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَعَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالاَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ لِلْفَرَسِ سَہْمَیْنِ وَلِلرَّجُلِ سَہْمًا۔ (بخاری ۲۸۶۳۔ مسلم ۱۳۸۳)","Sahih","Musannaf Ibn Abi Shaybah 33841","","","كتاب الجهاد"
"33842","(۳۳۸۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، وَوَکِیعٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ لِلْفَارِسِ ثَلاَثَۃَ أَسْہُمٍ ؛ سَہْمًا لَہُ ، وَاثْنَیْن لِفَرَسِہِ۔ (ابویعلی ۲۵۲۲)","","Musannaf Ibn Abi Shaybah 33842","","","كتاب الجهاد"
"33843","(۳۳۸۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ قَسَمَ لِلْفَرَسِ سَہْمَیْنِ ، وَلِلرَّجُلِ سَہْمًا ، فَکَانَ لِلرَّجُلِ وَلِفَرَسِہِ ثَلاَثَۃُ أَسْہُمٍ۔ (دارقطنی ۱۰۶)","Da'if","Musannaf Ibn Abi Shaybah 33843","","","كتاب الجهاد"
"33844","(۳۳۸۴۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ صَالِحِ بْنِ کَیْسَانَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَسْہَمَ یَوْمَ خَیْبَرَ لِمِئَتَیْ فَرَسٍ ، لِکُلِّ فَرَسٍ سَہْمَیْنِ۔ (سعید بن منصور ۲۷۶۴۔ عبدالرزاق ۹۳۲۳)","","Musannaf Ibn Abi Shaybah 33844","","","كتاب الجهاد"
"33845","(۳۳۸۴۵) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : حدَّثَنَا أَصْحَابُنَا ، عَنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُمْ قَالُوا : لِلْفَرَسِ سَہْمَانِ ، وَلِلرَّجُلِ سَہْمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33845","","","كتاب الجهاد"
"33846","(۳۳۸۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : أَسْہَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْفَرَسِ سَہْمَیْنِ ، وَلِلرَّجُلِ سَہْمًا۔ (سعید بن منصور ۲۷۶۹۔ عبدالرزاق ۹۳۱۹)","","Musannaf Ibn Abi Shaybah 33846","","","كتاب الجهاد"
"33847","(۳۳۸۴۷) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْفَرَسِ سَہْمَیْنِ ، وَلِلْفَارِسِ سَہْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 33847","","","كتاب الجهاد"
"33848","(۳۳۸۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، قَالَ : أَوَّلُ مَنْ جَعَلَ لِلْفَرَسِ سَہْمَیْنِ عُمَرُ ، أَشَارَ عَلَیْہِ رَجُلٌ مِنْ بَنِی تَمِیمٍ۔ (سعید بن منصور ۲۷۷۰)","Da'if","Musannaf Ibn Abi Shaybah 33848","","","كتاب الجهاد"
"33849","(۳۳۸۴۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، قَالَ : أَسْہَمَ لِلزُّبَیْرِ أَرْبَعَۃَ أَسْہُمٍ ؛ سَہْمَیْنِ لِفَرَسِہِ وَسَہْمًا لَہُ ، وَسَہْمًا لأُمِّہِ وَلِذِی الْقُرْبَی۔ (نسائی ۴۴۳۴۔ طحاوی ۲۸۳)","","Musannaf Ibn Abi Shaybah 33849","","","كتاب الجهاد"
"33850","(۳۳۸۵۰) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ جُوَیْبِرٍ، قَالَ: کَتَبَ إِلَیْنَا عُمَرُ بْنُ عَبْدِالْعَزِیزِ وَنَحْنُ بِخُرَاسَانَ: بَلَّغَنَا الثِّقَۃُ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ أَسْہَمَ لِلْفَارِسِ ثَلاَثَۃَ أَسْہُمٍ ؛ سَہْمَیْنِ لِفَرَسِہِ ، وَسَہْمًا لَہُ ، وَأَسْہَمَ لِلرَّاجِلِ سَہْمًا ، وَقَالَ فِی الْخَیْلِ : الْعِرَابُ وَالْمُقَارِفُ وَالْبَرَاذِینُ سَوَائٌ۔ (سعید بن منصور ۲۷۷۳)","Da'if","Musannaf Ibn Abi Shaybah 33850","","","كتاب الجهاد"
"33851","(۳۳۸۵۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قالاَ : کَانُوا إذَا غَزَوْا فَأَصَابُوا الْغَنَائِمَ ، قَسَمُوا لِلْفَارِسِ مِنَ الْغَنِیمَۃِ حِینَ تُقْسَمُ ثَلاَثَۃَ أَسْہُمٍ ؛ سَہْمَیْنِ لِفَرَسِہِ ، وَسَہْمًا لَہُ ، وَلِلرَّاجِلِ سَہْمًا۔","","Musannaf Ibn Abi Shaybah 33851","","","كتاب الجهاد"
"33852","(۳۳۸۵۲) حَدَّثَنَا وَکِیعٌ ، حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، قَالَ : أَسْہَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْفَارِسِ سَہْمَیْنِ ، وَلِلرَّاجِلِ سَہْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 33852","","","كتاب الجهاد"
"33853","(۳۳۸۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الشَّعَیْثیُّ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : أَسْہَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْفَرَسِ سَہْمَیْنِ ، وَلِلرَّاجِلِ سَہْمًا۔ (بیہقی ۵۳)","","Musannaf Ibn Abi Shaybah 33853","","","كتاب الجهاد"
"33854","(۳۳۸۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَمْرُو بْنُ مَیْمُونٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی أَہْلِ الْجَزِیرَۃِ : أَمَّا بَعْدُ ، فَإِنَّ السِّہَامَ کَانَتْ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَہْمَیْنِ لِلْفَرَسِ وَسَہْمًا لِلرَّجُلِ ، فَلَمْ أَظُنَّ أَنَّ أَحَدًا ہَمَّ بِانْتِقَاصِ فَرِیضَۃٍ مِنْہَا ، حَتَّی فَعَلَ ذَلِکَ رِجَالٌ مِمَّنْ یُقَاتِلُ ہَذِہِ الْحُصُونَ ، فَأَعِیدُوا سُہْمَانَہَا عَلَی مَا کَانَتْ عَلَیْہِ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ سَہْمَیْنِ لِلْفَرَسِ وَسَہْمًا لِلرَّجُلِ ، وَکَیْفَ تُوضَعُ سُہْمَانُ الْخَیْلِ وَہِیَ بِإِذْنِ اللہِ لِمَسْرَحِہِمْ بِاللَّیْلِ ، وَلِمَسَالِحِہِمْ بِالنَّہَارِ وَلِطَلَبِ مَا یَطْلُبُونَ۔ (سعید بن منصور ۲۷۶۱)","","Musannaf Ibn Abi Shaybah 33854","","","كتاب الجهاد"
"33855","(۳۳۸۵۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ؛ أَسْہَمَ لِلزُّبَیْرِ أَرْبَعَۃَ أَسْہُمٍ : سَہْمَیْنِ لِفَرَسِہِ ، وَسَہْمًا لأُمِّہِ ، وَسَہْمًا لِذِی الْقُرْبَی۔","","Musannaf Ibn Abi Shaybah 33855","","","كتاب الجهاد"
"33856","(۳۳۸۵۶) حَدَّثَنَا مُحَاضِرٌ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنْ عَامِرٍ ، قَالَ : لَمَّا فَتَحَ سَعْدُ بْنُ أَبِی وَقَّاصٍ جَلُولاَئَ أَصَابَ الْمُسْلِمُونَ ثَلاَثِینَ أَلْفَ أَلْفٍ ، فَقَسَمَ لِلْفَارِسِ ثَلاَثَۃَ آلاَفِ مِثْقَالَ ، وَلِلرَّجلِ أَلْفَ مِثْقَالٍ۔","Da'if","Musannaf Ibn Abi Shaybah 33856","","","كتاب الجهاد"
"33857","(۳۳۸۵۷) حَدَّثَنَا مُعَاذٌ ، قَالَ : أَخْبَرَنَا حَبِیبُ بْنُ شِہَابٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی مُوسَی ؛ أَنَّہُ أَسْہَمَ لِلْفَارِسِ سَہْمَیْنِ ، وَأَسْہَمَ لِلرَّاجِلِ سَہْمًا۔","Sahih","Musannaf Ibn Abi Shaybah 33857","","","كتاب الجهاد"
"33858","(۳۳۸۵۸) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا مُجَمِّعُ بْنُ یَعْقُوبَ ، قَالَ : أَخْبَرَنِی أَبِی ، عَنْ عَمِّہِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ مُجَمِّعِ بْنِ جَارِیَۃَ ، قَالَ : شَہِدْنَا الْحُدَیْبِیَۃَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقُسِمَتْ عَلَی ثَمَانیَۃَ عَشَرَ سَہْمًا ، وَکَانَ الْجَیْشُ أَلْفًا وَخَمْس مِئَۃٍ : ثَلاَثُ مِئَۃَ فَارِسٍ ، فَکَانَ لِلْفَارِسِ سَہْمَانِ۔n(ابوداؤد ۲۷۳۰۔ احمد ۴۲۰)","Da'if","Musannaf Ibn Abi Shaybah 33858","","","كتاب الجهاد"
"33859","(۳۳۸۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہَانِئِ بْنِ ہَانِئٍ ، عَنْ عَلِیٍّ ، قَالَ : لِلْفَارِسِ سَہْمَانِ۔ قَالَ شُعْبَۃُ : وَجَدْتُہُ مَکْتُوبًا عِنْدَ۔","Hasan","Musannaf Ibn Abi Shaybah 33859","","","كتاب الجهاد"
"33860","(۳۳۸۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَمْرُو بْنُ مَیْمُونٍ ، قَالَ : کَتَبَ جَعْوَنَۃُ بْنُ الْحَارِثِ ، وَکَانَ یَلِی ثَغْرَ مَلَطْیَۃَ ، إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : إِنَّ رِجَالاً یَغْزُونَ بِخَیْلٍ ضِعَافٍ جَذَعٍ ، أَوْ ثَنِی ، لَیْسَ فِیہَا رَدٌّ عَنِ الْمُسْلِمِینَ ، وَیَغْزُو الرَّجُلُ بِالْبِرْذَوْنِ الْقَوِیِّ الَّذِی لَیْسَ دُونَ الْفَرَسِ ، إِلاَّ أَنَّہُ یُقَالَ : بِرْذَوْنٌ ، فَمَا یَرَی أَمِیرُ الْمُؤْمِنِینَ فِیہَا ؟ فَکَتَبَ إلَیْہِ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أَنَ انْظُرْ مَا کَانَ مِنْ تِلْکَ الْخَیْلِ الضِّعَافِ الَّتِی لَیْسَ فِیہَا رَدٌّ عَنِ الْمُسْلِمِینَ ، فَأَعْلِمْ أَصْحَابَہَا أَنَّک غَیْرُ مُسْہِمَہَا ، انْطَلَقُوا بِہَا أمْ تَرَکُوا ، وَمَا کَانَ مِنْ تِلْکَ الْبَرَاذِینِ رَائِعَ الْجَرْیِ وَالْمَنْظَرِ ، فَأَسْہِمْہُ إسْہَامَک لِلْخَیْلِ الْعِرَابِ۔","","Musannaf Ibn Abi Shaybah 33860","","","كتاب الجهاد"
"33861","(۳۳۸۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْبِرْذَوْنُ بِمَنْزِلَۃِ الْفَرَسِ۔","","Musannaf Ibn Abi Shaybah 33861","","","كتاب الجهاد"
"33862","(۳۳۸۶۲) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لِصَاحِبِ الْبِرْذَوْنِ فِی الْغَنِیمَۃِ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 33862","","","كتاب الجهاد"
"33863","(۳۳۸۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الشُّعَیْثِیُّ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : أَسْہَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْعِرَابِ سَہْمَیْنِ ، وَلِلْہَجِینِ سَہْمًا۔ (ابوداؤد ۲۸۶)","","Musannaf Ibn Abi Shaybah 33863","","","كتاب الجهاد"
"33864","(۳۳۸۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : کَتَبَ أَبُو مُوسَی إلَی عُمَرَ: إنَّا لَمَّا فَتَحْنَا تُسْتَرَ أَصَبْنَا خَیْلاً عِرَاضًا ، فَکَتَبَ إلَیْہِ : أَنَّ تِلْکَ الْبَرَاذِینُ ، مَا قرَف مِنْہَا الْعِتَاقَ فَأْسِہِمْ، وَأَلْغِ مَا سِوَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33864","","","كتاب الجهاد"
"33865","(۳۳۸۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، وَإِبْرَاہِیمَ بْنِ الْمُنْتَشِرِ ، عَنِ ابْنِ الأَقْمَرِ ، قَالَ : أَغَارَتِ الْخَیْلُ بِالشَّامِ ، فَأَدْرَکَتِ الْعِرَابُ مِنْ یَوْمِہَا ، وَأَدْرَکْتِ الْکَوَادِنُ ضُحَی الْغَدِ ، فَقَالَ ابْنُ أَبِی خَمِیصَۃٍ : لاَ أَجْعَلُ مَنْ أَدْرَکَ کَمَنْ لَمْ یُدْرِکَ ، فَکَتَبَ إلَی عُمَرَ ، فَقَالَ عُمَرُ : ہَبِلَتِ الْوَادِعِیَّ أُمُّہُ ، لَقَدْ أَذْکَرَتْ بِہِ ، أَمْضُوہَا عَلَی مَا قَالَ۔ (فزاری ۲۴۴)","Da'if","Musannaf Ibn Abi Shaybah 33865","","","كتاب الجهاد"
"33866","(۳۳۸۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الصَّبَّاحُ بْنُ ثَابِتٍ الْبَجَلِیُّ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ ، یَقُولُ : إِنَّ الْمُنْذِرَ بْنَ الدَّہْرِ بْنَ حَمِیصَۃَ خَرَجَ فِی طَلَبِ الْعَدُوِّ ، فَلَحِقَتِ الْخَیْلُ الْعِتَاقُ ، وَتَقَطَّعَتِ الْبَرَاذِینُ ، فَأَسْہَمَ لِلْعِراب سَہْمَیْنِ ، وَلِلْبَرَاذِینِ سَہْمًا ، ثُمَّ کَتَبَ بِذَلِکَ إِلَی عُمَرَ ، فَأَعْجَبَہُ ذَلِکَ ، فَجَرَتْ سُنَّۃً لِلْخَیْلِ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 33866","","","كتاب الجهاد"
"33867","(۳۳۸۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ (ح) وَشَرِیکٌ ، عَنِ الأََسْوَدِ بْنِ قَیْسٍ ، عَنْ کُلْثُومِ بْنِ الأََقْمَرِ ؛ أَنَّ الْمُنْذِرَ بْنَ الدَّہْرُ بْن حَمِیصَۃَ خَرَجَ فِی طَلَبِ الْعَدُوِّ ، فَلَحِقَتِ الْخَیْلُ الْعِتَاقُ ، وَتَقَطَّعَتِ الْبَرَاذِینُ ، فَأَسْہَمَ لِلْخَیْلِ ، وَلَمْ یُسْہِمْ لَلْبَرَاذِینِ ، فَکَتَبَ بِذَلِکَ إِلَی عُمَرَ ، فَأَعْجَبَ عُمَرَ ذَلِکَ ، فَقَالَ عُمَرُ فِی حَدِیثِ أَحَدِہِمَا : ثَکِلَتِ الْوَدَاعِیَّ أُمُّہُ ، لَقَدْ أَذکَرَتْ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 33867","","","كتاب الجهاد"
"33868","(۳۳۸۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لِلْمُقْرَفِ سَہْمٌ ، وَہُوَ الْہَجِینُ ، وَلِصَاحِبِہِ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 33868","","","كتاب الجهاد"
"33869","(۳۳۸۶۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ أَشْیَاخِ ہَمْدَانَ ، عَنْ عُمَرَ ؛ بِنَحْوِ حَدِیثِ وَکِیعٍ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 33869","","","كتاب الجهاد"
"33870","(۳۳۸۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ ، قَالَ : لِلْہَجِینِ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 33870","","","كتاب الجهاد"
"33871","(۳۳۸۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، قَالَ : الْفَرَسُ وَالْبِرْذَوْنُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 33871","","","كتاب الجهاد"
"33872","(۳۳۸۷۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : لَمْ یَکُنْ أَحَدٌ مِنْ عُلَمَائِنَا یُسْہِمُ لِلْبِرْذَوْنِ۔","","Musannaf Ibn Abi Shaybah 33872","","","كتاب الجهاد"
"33873","(۳۳۸۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْبَغْلِ سَہْمًا ، وَلِلرَّاجِلِ سَہْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 33873","","","كتاب الجهاد"
"33874","(۳۳۸۷۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْبِغَالُ رَاجِلُ۔","","Musannaf Ibn Abi Shaybah 33874","","","كتاب الجهاد"
"33875","(۳۳۸۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ ، قَالَ : کَانُوا لاَ یُسْہِمُونَ لِبَغْلٍ ، وَلاَ لِبِرْذَوْنٍ ، وَلاَ لِحِمَارٍ۔","","Musannaf Ibn Abi Shaybah 33875","","","كتاب الجهاد"
"33876","(۳۳۸۷۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَکُونُ فِی الْغَزْوِ ، فَیَکُونُ مَعَہُ الأَفْرَاسُ : لاَ یُقْسَمُ لَہُ عِنْدَ الْمَغْنَمِ ، إِلاَّ لِفَرَسَیْنِ۔","","Musannaf Ibn Abi Shaybah 33876","","","كتاب الجهاد"
"33877","(۳۳۸۷۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بن جَابِرٍ ، عَنْ مَکْحُولٍ ، قَالَ: لاَ یُسْہَمُ لأَکْثَرِ مِنْ فَرَسَیْنِ إِذَا کَانَا لِرَجُلٍ وَاحِدٍ ، وَمَا کَانَ سِوَی ذَلِکَ فَہُوَ جَنَائِبُ۔","","Musannaf Ibn Abi Shaybah 33877","","","كتاب الجهاد"
"33878","(۳۳۸۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، وَإِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : شَہِدْنَا غَزَاۃً مَعَ سَعِیدِ بْنِ عُثْمَانَ ، وَمَعِی ہَانِئُ بْنُ ہَانِئٍ ، وَمَعِی فَرَسَانِ ، وَمَعَ ہَانِئٍ فَرَسَانِ ، فَأَسْہَمَ لِی وَلِلْفَرَسَیْنِ خَمْسَۃَ أَسْہُمٍ ، وَأَسْہَمَ لِہَانِئٍ وَلِفَرَسَیْہِ خَمْسَۃَ أَسْہُمٍ۔","","Musannaf Ibn Abi Shaybah 33878","","","كتاب الجهاد"
"33879","(۳۳۸۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ سَہْمَ لأَکْثَرَ مِنْ فَرَسَیْنِ ، فَإِنْ کَانَ مَعَ الرَّجُلِ فَرَسَانِ أُسْہِمَ لَہُ خَمْسَۃُ أَسْہُمٍ ؛ أَرْبَعَۃٌ لِفَرَسَیْہِ ، وَسَہْمًا لَہُ۔","","Musannaf Ibn Abi Shaybah 33879","","","كتاب الجهاد"
"33880","(۳۳۸۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : إِنْ أَدْرَبَ رَجُلٌ بِأَفْرَاسٍ ، کَانَ لِکُلِّ فَرَسٍ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 33880","","","كتاب الجهاد"
"33881","(۳۳۸۸۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ عُمَیْرٍ مَوْلَی آبِی اللَّحْمِ ، قَالَ : شَہِدْتُ خَیْبَرَ وَأَنَا عَبْدٌ مَمْلُوکٌ ، فَلَمَّا فَتَحُوہَا ، أَعْطَانِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَیْفًا ، فَقَالَ : تَقَلَّدْ ہَذَا ، وَأَعْطَانِی مِنْ خُرْثِیِّ الْمَتَاعِ ، وَلَمْ یَضْرِبْ لِی بِسَہْمٍ۔ (ابوداؤد ۲۷۲۴۔ احمد ۲۲۳)","Sahih","Musannaf Ibn Abi Shaybah 33881","","","كتاب الجهاد"
"33882","(۳۳۸۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدِ بْنِ مُہَاجِرِ بْنِ قُنْفُذٍ ، عَنْ عُمَیْرٍ مَوْلَی آبِی اللَّحْمِ ، قَالَ : شَہِدْتُ مَعَ مَوْلاَیَ خَیْبَرَ وَأَنَا مَمْلُوک ، فَلَمْ یَقْسِمْ لِی مِنَ الْغَنِیمَۃِ شَیْئًا ، وَأَعْطَانِی مِنْ خُرْثِیِّ الْمَتَاعِ سَیْفًا کُنْت أَجُرَّہُ إذَا تَقَلَّدْتہ۔ (ابن ماجہ ۲۸۵۵)","Hasan","Musannaf Ibn Abi Shaybah 33882","","","كتاب الجهاد"
"33883","(۳۳۸۸۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، قَالَ : لَیْسَ لِلْعَبْدِ مِنَ الْغَنِیمَۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33883","","","كتاب الجهاد"
"33884","(۳۳۸۸۴) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ لَہُ فِی الْمَغْنَمِ نَصِیبٌ۔","","Musannaf Ibn Abi Shaybah 33884","","","كتاب الجهاد"
"33885","(۳۳۸۸۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَالْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالُوا : مَنْ شَہِدَ الْبَأْسَ مِنْ حُرٍّ ، أَوْ عَبْدٍ ، أَوْ أَجِیرٍ فَلَہُ سَہْمٌ۔","","Musannaf Ibn Abi Shaybah 33885","","","كتاب الجهاد"
"33886","(۳۳۸۸۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، وَالْحَکَمِ ، قَالُوا : الْعَبْدُ وَالأَجِیرُ إِذَا شَہِدُوا الْقِتَالَ أُعْطُوا مِنَ الْغَنِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 33886","","","كتاب الجهاد"
"33887","(۳۳۸۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا شَہِدَ التَّاجِرُ وَالْعَبْدُ ، قُسِمَ لَہُ ، وَقُسِمَ لِلْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 33887","","","كتاب الجهاد"
"33888","(۳۳۸۸۸) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : یُسْہَمُ لِلْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 33888","","","كتاب الجهاد"
"33889","(۳۳۸۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ خَالِہِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی قُرَّۃَ ، قَالَ : قَسَمَ لِی أَبُو بَکْرٍ الصِّدِّیقُ کَمَا قَسَمَ لِسَیِّدِی۔","Hasan","Musannaf Ibn Abi Shaybah 33889","","","كتاب الجهاد"
"33890","(۳۳۸۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْغَنَائِمِ یُصِیبُہَا الْجَیْشُ ، قَالَ : إِنْ أَعَانَہُمَ التَّاجِرُ وَالْعَبْدُ ، ضُرِبَ لَہُمَا بِسِہَامِہِمَا مَعَ الْجَیْشِ۔","","Musannaf Ibn Abi Shaybah 33890","","","كتاب الجهاد"
"33891","(۳۳۸۹۱) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : أَسْہَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلنِّسَائِ وَالصِّبْیَانِ وَالْخَیْلِ۔ (ابوداؤد ۲۸۹۔ بیہقی ۵۳)","","Musannaf Ibn Abi Shaybah 33891","","","كتاب الجهاد"
"33892","(۳۳۸۹۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، وَمُحَمَّدُ بْنُ عَلِیٍّ ، عَنْ یَزِیدَ بْنِ ہُرْمُزَ ، قَالَ : کَتَبَ نَجْدَۃُ إِلَی ابْنِ عَبَّاسٍ یَسْأَلُہُ عَنِ النِّسَائِ ، ہَلْ کُنَّ یَحْضُرْنَ الْحَرْبَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ وَہَلْ یَضْرِبُ لَہُنَّ بِسَہْمٍ ؟ قَالَ : فَقَالَ یَزِیدُ : أَنَا کَتَبْتُ کِتَابَ ابْنِ عَبَّاسٍ بِیَدِی إلَی نَجْدَۃَ ، کَتَبْتَ تَسْأَلُنِی عَنِ النِّسَائِ ، ہَلْ کُنَّ یَحْضُرْنَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْحَرْبَ ؟ وَہَلْ کَانَ یَضْرِبُ لَہُنَّ بِسَہْمٍ ؟ وَقَدْ کُنَّ یَحْضُرْنَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَمَّا أَنْ یَضْرِبَ لَہُنَّ بِسَہْمٍ فَلاَ ، وَقَدْ کَانَ یَرْضَخُ لَہُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 33892","","","كتاب الجهاد"
"33893","(۳۳۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْعَوَّامِ بْنِ مُزَاحِمٍ ، عَنْ خَالِدِ بْنِ سَیْحَانَ ، قَالَ : شُہِدَتْ مَعَ أَبِی مُوسَی أَرْبَعُ نِسْوَۃٍ ، أَوْ خَمْسٌ ، مِنْہُنَّ أُمُّ مَجْزَأَۃَ بْنِ ثَوْرٍ، فَکُنَّ یَسْقِینَ الْمَائَ ، وَیُدَاوِینَ الْجَرْحَی ، فَأَسْہَمَ لَہُنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 33893","","","كتاب الجهاد"
"33894","(۳۳۸۹۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ سُفْیَانَ بْنِ وَہْبٍ الْخَوْلاَنِیِّ ، قَالَ : قسَمَ عُمَرُ بَیْنَ النَّاسِ غَنَائِمَہُمْ ، فَأَعْطَی کُلَّ إنْسَانٍ دِینَارًا ، وَجَعَلَ سَہْمَ الْمَرْأَۃِ وَالرَّجُلِ سَوَائً ، فَإِذَا کَانَ الرَّجُلُ مَعَ امْرَأَتِہِ أَعْطَاہُ دِینَارًا ، وَإِذَا کَانَ وَحْدَہُ أَعْطَاہُ نِصْفَ دِینَارٍ۔","Hasan","Musannaf Ibn Abi Shaybah 33894","","","كتاب الجهاد"
"33895","(۳۳۸۹۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی ابْنُ أَبِی ذِئْبٍ ، عَنِ الْقَاسِمِ بْنِ عَبَّاسٍ ، عَنْ عَبْدِ اللہِ بْنِ نِیَارٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِظَبْیَۃِ خَرَزٍ ، فَقَسَمَہَا لِلْحُرَّۃِ وَالأَمَۃِ ، وَقَالَتْ عَائِشَۃُ : کَانَ أَبِی یَقْسِمُ لِلْحُرِّ وَالْعَبْدِ۔ (ابوداؤد ۲۹۴۵۔ احمد ۱۵۶)","Sahih","Musannaf Ibn Abi Shaybah 33895","","","كتاب الجهاد"
"33896","(۳۳۸۹۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : قدِمْنَا عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ فَتْحِ خَیْبَرَ بِثَلاَثٍ ، فَقَسَمَ لَنَا ، وَلَمْ یَقْسِمْ لأَحَدٍ لَمْ یَشْہَدَ الْفَتْحَ غَیْرَنَا۔ (بخاری ۳۱۳۶۔ مسلم ۱۹۴۶)","Sahih","Musannaf Ibn Abi Shaybah 33896","","","كتاب الجهاد"
"33897","(۳۳۸۹۷) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ، عَنْ مُجَالِدٍ، عَنْ عَامِرٍ، قَالَ: کَتَبَ عُمَرُ إلَی سَعْدٍ یَوْمَ الْقَادِسِیَّۃِ: إِنِّی قَدْ بَعَثْتُ إِلَیْک أَہْلَ الْحِجَازِ ، وَأَہْلَ الشَّامِ ، فَمَنْ أَدْرَکَ مِنْہُمَ الْقِتَالَ قَبْلَ أَنْ یَتَفَقَؤُوا فَأَسْہِمْ لَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33897","","","كتاب الجهاد"
"33898","(۳۳۸۹۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ ، یَعْنِی ابْنَ أَبِی حَبِیبٍ ؛ أَنَّ أَبَا بَکْرٍ بَعَثَ عِکْرِمَۃَ بْنَ أَبِی جَہْلٍ مُمِدًّا لِلْمُہَاجِرِ بْنِ أَبِی أُمَیَّۃِ ، وَزِیَادِ بْنِ لَبِیَدٍ البَیَاضِیِّ ، فَانْتَہَوْا إلَی الْقَوْمِ وَقَدْ فُتِحَ عَلَیْہِمْ ، وَالْقَوْمُ فِی دِمَائِہِمْ ، قَالَ : فَأُشْرَکُوہُم فِی غَنِیمَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 33898","","","كتاب الجهاد"
"33899","(۳۳۸۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْحَکَمِ ؛ أَنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَسَمَ لِجَعْفَرٍ وَأَصْحَابِہِ یَوْمَ خَیْبَرَ ، وَلَمْ یَشْہَدُوا الْوَقْعَۃَ۔ (ابوداؤد ۲۷۷)","","Musannaf Ibn Abi Shaybah 33899","","","كتاب الجهاد"
"33900","(۳۳۹۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ الأَحْمَسِیِّ ، قَالَ : غَزَتْ بَنُو عُطَارِدٍ مِئَۃً مِنْ أَہْلِ الْبَصْرَۃِ ، وَأَمَدُّوا عَمَّارًا مِنَ الْکُوفَۃِ ، فَخَرَجَ عَمَّارٌ قَبْلَ الْوَقْعَۃِ ، فَقَالَ : نَحْنُ شُرَکَاؤُکُمْ فِی الْغَنِیمَۃِ ، فَقَامَ رَجُلٌ مِنْ بَنِی عُطَارِدٍ ، فَقَالَ : أَیُّہَا الْعَبْدُ الْمَجْدُوعُ ، وَکَانَتْ أُذُنُہُ قَدْ أُصِیبَتْ فِی سَبِیلِ اللہِ ، أَتُرِیدُ أَنْ نَقْسِمَ لَکَ غَنِیمَتَنَا ؟ فَقَالَ عَمَّارٌ : عَیَّرْتُمُونِی بِأَحَبِّ ، أَوْ بِخَیْرِ أُذُنَی ، قَالَ : وَکَتَبَ فِی ذَلِکَ إِلَی عُمَرَ ، فَکَتَبَ عُمَرُ : إِنَّ الْغَنِیمَۃَ لِمَنْ شَہِدَ الْوَقْعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 33900","","","كتاب الجهاد"
"33901","(۳۳۹۰۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : قَالَ عُمَرُ : إنَّمَا الْغَنِیمَۃُ لِمَنْ شَہِدَ الْوَقْعَۃَ۔ (بیہقی ۵۰۔ عبدالرزاق ۹۶۸۹)","Sahih","Musannaf Ibn Abi Shaybah 33901","","","كتاب الجهاد"
"33902","(۳۳۹۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ قَوْمًا قَدِمُوا عَلَی عَلِیٍّ یَوْمَ الْجَمَلِ بَعْدَ الْوَقْعَۃِ ، فَقَالَ : ہَؤُلاَئِ الْمَحْرُومُونَ فَاقْسِمْ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 33902","","","كتاب الجهاد"
"33903","(۳۳۹۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْس بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ ، قَالَ : بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَرِیَّۃً ، فَأَصَابُوا غَنِیمَۃً فَجَائَ بَعْدَہُمْ قَوْمٌ ، فَنَزَلَتْ : {فِی أَمْوَالِہِمْ حَقٌّ مَعْلُومٌ لِلسَّائِلِ وَالْمَحْرُومِ}۔ (طبری ۸۲)","Hasan","Musannaf Ibn Abi Shaybah 33903","","","كتاب الجهاد"
"33904","(۳۳۹۰۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ قَیْسِ بْنِ کُرْکُمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ {لِلسَّائِلِ وَالْمَحْرُومِ} ، قَالَ : الْمُحَارَفُ۔ (طبری ۲۹)","Da'if","Musannaf Ibn Abi Shaybah 33904","","","كتاب الجهاد"
"33905","(۳۳۹۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ قَیْسِ بْنِ کُرْکُمٍ ، عَنِ ابْنِ عَبَّاسٍ؛ {لِلسَّائِلِ وَالْمَحْرُومِ} ، قَالَ : الْمَحْرُومُ الْمُحَارَفُ الَّذِی لَیْسَ لَہُ فِی الإِسْلاَمِ سَہْمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 33905","","","كتاب الجهاد"
"33906","(۳۳۹۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ ، قَالَ : بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَلاَئِعَ ، فَغَنِمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَنِیمَۃً ، فَقَسَمَ بَیْنَ النَّاسِ ، وَلَمْ یَقْسِمْ لِلطَّلاَئِعِ شَیْئًا ، فَلَمَّا قَدِمَتِ الطَّلاَئِعُ ، قَالُوا : قَسَمَ الْفَیْئَ وَلَمْ یَقْسِمْ لَنَا ، فَنَزَلَتْ : {وَمَا کَانَ لِنَبِیٍّ أَنْ یَغُلَّ}۔ (طبری ۱۵۶)","","Musannaf Ibn Abi Shaybah 33906","","","كتاب الجهاد"
"33907","(۳۳۹۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْمَحْرُومُ الَّذِی لَیْسَ لَہُ فِی الْغَنِیمَۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33907","","","كتاب الجهاد"
"33908","(۳۳۹۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمَحْرُومُ الَّذِی لَیْسَ لَہُ فِی الْغَنِیمَۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33908","","","كتاب الجهاد"
"33909","(۳۳۹۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْتُ إِلَی نَافِعٍ أَسْأَلُہُ عَنِ الرَّجُلِ یَکُونُ فِی السَّرِیَّۃٍ ، یَحْمِلُ بِغَیْرِ إِذْنِ أَمِیرِہِ ؟ فَکَتَبَ : إِنَّہُ لاَ یُغَیِّرُہُ إُذْنُ أَمِیرِہِ۔","","Musannaf Ibn Abi Shaybah 33909","","","كتاب الجهاد"
"33910","(۳۳۹۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، قَالَ : إِذَا الْتَقَی الزَّحْفَانِ ، فَلَیْسَ لِلرَّجُلِ أَنْ یَحْمِلَ بِغَیْرِ إِذْنِ إِمَامِہِ۔","","Musannaf Ibn Abi Shaybah 33910","","","كتاب الجهاد"
"33911","(۳۳۹۱۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَشْعَثِ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُسْرَی فِی سَرِیَّۃٍ ، إِلاَّ بِإِذْنِ أَمِیرِہَا ، وَلَہُمْ مَا نَفَّلَہُمْ مِنْ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 33911","","","كتاب الجهاد"
"33912","(۳۳۹۱۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا تَسَرَّت السَّرِیَّۃِ مَا أَصَابُوا ، أَوْ غَنِمُوا ، إِنْ شَائَ الإِمَامُ نَفَّلَہُمْ ، وَإِنْ شَائَ خَمَّسَہُ۔","","Musannaf Ibn Abi Shaybah 33912","","","كتاب الجهاد"
"33913","(۳۳۹۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا خَرَجَتْ سَرِیَّۃٌ بِإِذْنِ الإِمَامِ فَغَنِمُوا ، أَخَذَ الإِمَامُ الْخُمُسَ ، وَسَائِرُہُ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 33913","","","كتاب الجهاد"
"33914","(۳۳۹۱۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : ذَکَرْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : غَزَوْتُ الدَّرْبَ ، فَلَمَّا وَجَّہْنَا قَافِلِینَ بِہِ ، بَعَثُوا السَّرَایَا بَعْدَ أَنْ وَجَّہْنَا قَافِلِینَ ، فَقِیلَ : لَکُمْ مَا غَنِمْتُمْ إِلاَّ الْخُمُسَ ، فَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : مَا کَانَ النَّاسُ یُنَفَّلُونَ إِلاَّ مِنَ الْخُمُسِ۔","","Musannaf Ibn Abi Shaybah 33914","","","كتاب الجهاد"
"33915","(۳۳۹۱۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا سَرِیَّۃٍ أَغَارَتْ بِغَیْرِ إِذْنِ أَمِیرِہَا فَہُوَ غَلُولٌ۔","Hasan","Musannaf Ibn Abi Shaybah 33915","","","كتاب الجهاد"
"33916","(۳۳۹۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَنِ الإِمَامِ یَبْعَثُ السَّرِیَّۃَ فَتَغْنَمُ؟ قَالَ : إِنْ شَائَ نَفَّلَہُمْ إِیَّاہُ کُلَّہُ ، وَإِنْ شَائَ خَمَّسَہُ۔","","Musannaf Ibn Abi Shaybah 33916","","","كتاب الجهاد"
"33917","(۳۳۹۱۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا رَحَلُوا بِإِذْنِ الإِمَامِ أَخَذَ الْخُمُسَ ، وَکَانَ لَہُمْ مَا بَقِیَ ، وَإِذَا رَحَلُوا بِغَیْرِ إِذْنِ الإِمَامِ فَہُوَ أُسْوَۃُ الْجَیْشِ۔","","Musannaf Ibn Abi Shaybah 33917","","","كتاب الجهاد"
"33918","(۳۳۹۱۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، عَنْ عَلِیِّ بْنِ ثَابِتٍ ، قَالَ : سَأَلْتُ مَکْحُولاً ، وَعَطَائً عَنِ الإِمَامِ یُنَفِّلُ الْقَوْمَ مَا أَصَابُوا ؟ قَالَ : ذَلِکَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 33918","","","كتاب الجهاد"
"33919","(۳۳۹۱۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ سُئِلَ عَنِ الْنَّہبَۃِ فِی الْغَنِیمَۃِ إِذَا أَذِنَ لَہُمْ أَمِیرُہُمْ ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33919","","","كتاب الجهاد"
"33920","(۳۳۹۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَی رَجُلَیْنِ مِنَ الْمُسْلِمِینَ بِرَجُلٍ مِنَ الْمُشْرِکِینَ مِنْ بَنِی عُقَیْلٍ۔ n(ترمذی ۱۵۶۸۔ مسلم ۱۲۶۲)","Sahih","Musannaf Ibn Abi Shaybah 33920","","","كتاب الجهاد"
"33921","(۳۳۹۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، عَنْ إِیَاسِ بْنِ سَلَمَۃَ بْنِ الأَکْوَعِ ، عَنْ أَبِیہِ ، قَالَ : غَزَوْنَا مَعَ أَبِی بَکْرٍ ہَوَازِنَ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَنَفَّلَنِی جَارِیَۃً مِنْ بَنِی فَزَارَۃَ ، مِنْ أَجْمَلِ الْعَرَبِ ، عَلَیْہَا قَِشْعٌ لَہَا ، فَمَا کَشَفْتُ لَہَا عَنْ ثَوْبٍ حَتَّی قَدِمْتُ الْمَدِینَۃَ ، فَلَقِیَنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ بِالسُّوقِ ، فَقَالَ : لِلَّہِ أَبُوکَ ، ہَبْہَا لِی ، فَوَہَبْتُہَا لَہُ ، قَالَ : فَبَعَثَ بِہَا ، فَفَادَی بِہَا أُسَارَی مِنَ الْمُسْلِمِینَ کَانُوا بِمَکَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 33921","","","كتاب الجهاد"
"33922","(۳۳۹۲۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ فِی الأَسِیرِ مِنَ الْمُشْرِکِینَ : یُمَنَّ عَلَیْہِ ، أَوْ یُفَادَی۔","","Musannaf Ibn Abi Shaybah 33922","","","كتاب الجهاد"
"33923","(۳۳۹۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْجُوَیْرِیَۃِ ، وَعَاصِمِ بْنِ کُلَیْبٍ الْجَرْمِیُّ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ فَدَی رَجُلاً مِنَ الْمُسْلِمِینَ مِنْ جَرْمٍ مِنْ أَہْلِ الْحَرْبِ بِمِئَۃِ أَلْفٍ۔","","Musannaf Ibn Abi Shaybah 33923","","","كتاب الجهاد"
"33924","(۳۳۹۲۴) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : إِذَا سُبِیَتِ الْجَارِیَۃُ ، أَوِ الْغُلاَمُ مِنَ الْعَدُوِّ ، فَلاَ بَأْسَ أَنْ یُفَادُوہُمْ۔","","Musannaf Ibn Abi Shaybah 33924","","","كتاب الجهاد"
"33925","(۳۳۹۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الأَسِیرِ : یُمَنَّ عَلَیْہِ ، أَوْ یُفَادَی بِہِ۔","","Musannaf Ibn Abi Shaybah 33925","","","كتاب الجهاد"
"33926","(۳۳۹۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَمَّا کَانَ یَوْمُ بَدْرٍ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا تَقُولُونَ فِی ہَؤُلاَئِ الأُسَارَی ؟ قَالَ : ثُمَّ قَالَ : لاَ یُفْلِتَنَّ أَحَدٌ مِنْہُمْ إِلاَّ بِفِدَائٍ ، أَوْ ضَرْبَۃِ عُنُقٍ۔ (ترمذی ۱۷۱۴۔ احمد ۳۸۳)","","Musannaf Ibn Abi Shaybah 33926","","","كتاب الجهاد"
"33927","(۳۳۹۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَتَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کِتَابًا بَیْنَ الْمُہَاجِرِینَ وَالأَنْصَارِ : أَنْ یَعْقِلُوا مُعَاقِلَہُمْ ، وَأَنْ یُفْدُوا عَانِیَہُمْ بِالْمَعْرُوفِ وَالإِصْلاَحِ بَیْنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 33927","","","كتاب الجهاد"
"33928","(۳۳۹۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عُمَرُ: لأَنْ أَسْتَنْقِذَ رَجُلاً مِنَ الْمُسْلِمِینَ مِنْ أَیْدِی الْکُفَّارِ أَحَبَّ إلَیَّ مِنْ جِزیَۃِ الْعَرَبِ۔","","Musannaf Ibn Abi Shaybah 33928","","","كتاب الجهاد"
"33929","(۳۳۹۲۹) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، وَمُجَاہِدٍ ، قَالاَ : قَالَ أَبُو بَکْرٍ : إِنْ أَخَذْتُمْ أَحَدًا مِنَ الْمُشْرِکِینَ، فَأُعْطِیتُمْ بِہِ مُدَّیْ دَنَانِیرَ ، فَلاَ تُفَادُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33929","","","كتاب الجهاد"
"33930","(۳۳۹۳۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ حُمَیْدٍ ، عَنْ حَبِیبٍ بْن أَبِی یَحْیَی ؛ أَنَّ خَالِدَ بْنَ زَیْدٍ ،وَکَانَتْ عَیْنَہُ أُصِیبَتْ بِالسَّوسِ ، قَالَ : حاصَرْنَا مَدِینَتَہَا ، فَلَقِینَا جَہْدًا ، وَأَمِیرُ الْمُسْلِمِینَ أَبُو مُوسَی ، وَأَخَذَ الدِّہْقَانُ عَہْدَہُ وَعَہْدَ مَنْ مَعَہُ ، فَقَالَ أَبُو مُوسَی : اعْزِلْہُمْ ، فَجَعَلَ یَعْزِلُہُمْ ، وَجَعَلَ أَبُو مُوسَی یَقُولُ لأَصْحَابِہِ : إِنِّی أَرْجُو أَنْ یَخْدَعَہُ اللَّہُ عَنْ نَفْسِہِ ، فَعَزَلَہُمْ وَبَقِیَ عَدُوُّ اللہِ ، فَأَمَرَ بِہِ أَبُو مُوسَی ، فَفَادَی وَبَذَلَ مَالاً کَثِیرًا ، فَأَبَی وَضَرَبَ عُنُقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 33930","","","كتاب الجهاد"
"33931","(۳۳۹۳۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قُتِلَ قَتِیلٌ یَوْمَ الْخَنْدَقِ ، فَغَلَبَ الْمُسْلِمُونَ الْمُشْرِکِینَ عَلَی جِیفَتِہِ ، فَقَالُوا : ادْفَعُوا إِلَیْنَا جِیفَتَہُ وَنُعْطِیکُمْ عَشَرَۃَ آلاَف دِرْہَم ، فَذُکِرَ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لاَ حَاجَۃَ لَنَا فِی جِیفَتِہِ ، وَلاَ دِیَتِہِ ، إِنَّہُ خَبِیثُ الدِّیَۃِ خَبِیثُ الْجِیفَۃِ۔ (احمد ۲۴۸۔ بیہقی ۱۳۳)","","Musannaf Ibn Abi Shaybah 33931","","","كتاب الجهاد"
"33932","(۳۳۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ؛ أَنَّ رَجُلاً مِنَ الْمُشْرِکِینَ أُصِیبَ یَوْمَ الْخَنْدَقِ ، فَأَعْطَوُا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِیفَتِہِ حَتَّی بَلَغُوا الدِّیَۃَ ، فَأَبَی۔ (احمد ۲۴۸)","Da'if","Musannaf Ibn Abi Shaybah 33932","","","كتاب الجهاد"
"33933","(۳۳۹۳۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِنَحْوِہِ۔ (ترمذی ۱۷۱۵۔ احمد ۳۲۶)","Da'if","Musannaf Ibn Abi Shaybah 33933","","","كتاب الجهاد"
"33934","(۳۳۹۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : نَسَخَتْ : {وَاقْتُلُوہُمْ حَیْثُ وَجَدْتُمُوہُمْ} مَا کَانَ قَبْلَ ذَلِکَ مِنْ فِدَائٍ ، أَوْ مَنٍّ۔","","Musannaf Ibn Abi Shaybah 33934","","","كتاب الجهاد"
"33935","(۳۳۹۳۵) حَدَّثَنَا ابْنُ إِدْرِیسَ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ؛ فِی قَوْلِہِ: {فَإِمَّا مَنًّا بَعْدُ وَإِمَّا فِدَائً} قَالَ: لاَ مَنٍّ، وَلاَ فِدَائٍ۔","","Musannaf Ibn Abi Shaybah 33935","","","كتاب الجهاد"
"33936","(۳۳۹۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ مُجَاہِدٍ ، قَالَ : اسْتَشَارَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الأُسَارَی یَوْمَ بَدْرٍ ، فَقَالَ أَبُو بَکْرٍ : یَا رَسُولَ اللہِ ، قَوْمُک وَعَشِیرَتُک بَنُو عَمِّکَ ، فَخُذْ مِنْہُمَ الْفِدْیَۃَ ، وَقَالَ عُمَرُ : اُقْتُلْہُمْ ، فَنَزَلَتْ : {مَا کَانَ لِنَبِیٍّ أَنْ یَکُونَ لَہُ أَسْرَی حَتَّی یُثْخِنَ فِی الأَرْضِ} قَالَ مُجَاہِدٌ : وَالإِثْخَانُ : ہُوَ الْقَتْلُ۔ (ابن جریر ۴۳)","","Musannaf Ibn Abi Shaybah 33936","","","كتاب الجهاد"
"33937","(۳۳۹۳۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی سَلَمَۃَ بْن أَبِی حَفْصَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ یُوسُفَ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عُمَرُ : کُلَّ أَسِیرٍ کَانَ فِی أَیْدِی الْمُشْرِکِینَ مِنَ الْمُسْلِمِینَ ، فَفِکَاکُہُ مِنْ بَیْتِ مَالِ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33937","","","كتاب الجهاد"
"33938","(۳۳۹۳۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ ، عَنْ بِشْرِ بْنِ غَالِبٍ ، قَالَ : سَأَلَ ابْنُ الزُّبَیْرِ الْحَسَنَ بْنَ عَلِیٍّ عَنِ الرَّجُلِ یُقَاتِلُ عَنْ أَہْلِ الذِّمَّۃِ ، فَیُؤْسَرُ ؟ قَالَ : فَفِکَاکُہُ مِنْ خَرَاجِ أُولَئِکَ الْقَوْمِ الَّذِینَ قَاتَلَ عَنْہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33938","","","كتاب الجهاد"
"33939","(۳۳۹۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی أَہْلِ الْعَہْدِ إِذَا سَبَاہُمَ الْمُشْرِکُونَ ، ثُمَّ ظَہَرَ عَلَیْہِمَ الْمُسْلِمُونَ ، قَالَ : لاَ یُسْتَرَقُّونَ۔","","Musannaf Ibn Abi Shaybah 33939","","","كتاب الجهاد"
"33940","(۳۳۹۴۰) حَدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : لاَ یُفَادَی الْعَبْدُ ، وَلاَ الْمُعَاہَدُ۔","","Musannaf Ibn Abi Shaybah 33940","","","كتاب الجهاد"
"33941","(۳۳۹۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ قَتْلَ الأَسْرَی۔","","Musannaf Ibn Abi Shaybah 33941","","","كتاب الجهاد"
"33942","(۳۳۹۴۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَقُولُ : لاَ یُقْتَلُ الأَسِیرُ۔","","Musannaf Ibn Abi Shaybah 33942","","","كتاب الجهاد"
"33943","(۳۳۹۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ قَتْلَ الأَسِیرِ۔","","Musannaf Ibn Abi Shaybah 33943","","","كتاب الجهاد"
"33944","(۳۳۹۴۴) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ عَلِیٌّ إِذَا أُتِیَ بِأَسِیرٍ یَوْمَ صِفِّینَ ، أَخَذَ دَابَّتَہُ ، وَأَخَذَ سِلاَحَہُ ، وَأَخَذَ عَلَیْہِ أَنْ لاَ یَعُودَ ، وَخَلَّی سَبِیلَہُ۔","","Musannaf Ibn Abi Shaybah 33944","","","كتاب الجهاد"
"33945","(۳۳۹۴۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی فَاخِتَۃَ ، قَالَ : أَخْبَرَنِی جَارٌ لِی ، قَالَ : أَتَیْتُ علِیًّا بِأَسِیرٍ یَوْمَ صِفِّینَ ، فَقَالَ : لَنْ أَقْتُلَک صَبْرًا ، إِنِّی أَخَافُ اللَّہَ رَبَّ الْعَالَمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 33945","","","كتاب الجهاد"
"33946","(۳۳۹۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ خُلَیْدِ بْنِ جَعْفَرٍ ، عَنِ الْحَسَنِ ؛ أَنَّ الْحَجَّاجَ أُتِیَ بِأَسِیرٍ ، فَقَالَ لِعَبْدِ اللہِ بْنِ عُمَرَ : قُمْ فَاقْتُلْہُ ، فَقَالَ ابْنُ عُمَرَ : مَا بِہَذَا أُمِرْنَا ، یَقُولُ اللَّہُ : {حَتَّی إِذَا أَثْخَنْتُمُوہُمْ فَشُدُّوا الْوَثَاقَ فَإِمَّا مَنًّا بَعْدُ وَإِمَّا فِدَائً}۔","Sahih","Musannaf Ibn Abi Shaybah 33946","","","كتاب الجهاد"
"33947","(۳۳۹۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنِ الْحَسَنِ ، قَالَ : بَعَثَ ابْنُ عَامِرٍ إلَی ابْنِ عُمَرَ بِأَسِیرٍ وَہُوَ بِفَارِسَ ، أَوْ بِإِصْطَخْرَ لِیَقْتُلَہُ ، فَقَالَ ابْنُ عُمَرَ : أَمَّا وَہُوَ مَصْرُورٌ فَلاَ۔nقَالَ وَکِیعٌ : یَعْنِی مَوْثُوقًا۔","Sahih","Musannaf Ibn Abi Shaybah 33947","","","كتاب الجهاد"
"33948","(۳۳۹۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أُتِیَ بِسَبِی فَأَعْتَقَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 33948","","","كتاب الجهاد"
"33949","(۳۳۹۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَصْحَابُنَا ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الإِمَامُ فِی الأُسَارَی بِالْخِیَارِ ، إِنْ شَائَ فَادَی ، وَإِنْ شَائَ مَنَّ ، وَإِنْ شَائَ قَتَلَ۔","","Musannaf Ibn Abi Shaybah 33949","","","كتاب الجهاد"
"33950","(۳۳۹۵۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، قَالَ: أَمَرَ عَلِیٌّ مُنَادِیَہُ، فَنَادَی یَوْمَ الْبَصْرَۃِ: لاَ یُقْتَلُ أَسِیرٌ۔","","Musannaf Ibn Abi Shaybah 33950","","","كتاب الجهاد"
"33951","(۳۳۹۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ فَتْحِ مَکَّۃَ : أَلاَ لاَ یُقْتَلُ مُدْبِرٌ ، وَلاَ یُجْہَزُ عَلَی جَرِیحٍ ، وَمَنْ أَغْلَقَ بَابَہُ فَہُوَ آمِنٌ۔ (ابوعبید ۱۵۹)","","Musannaf Ibn Abi Shaybah 33951","","","كتاب الجهاد"
"33952","(۳۳۹۵۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا أَمَرَ مُنَادِیَہُ فَنَادَی یَوْمَ الْبَصْرَۃِ : أَلاَ لاَ یُتْبَعُ مُدْبِرٌ ، وَلاَ یُذْفَفُ عَلَی جَرِیحٍ ، وَلاَ یُقْتَلُ أَسِیرٌ ، وَمَنْ أَغْلَقَ بَابَہُ فَہُوَ آمِنٌ ، وَمَنْ أَلْقَی السِّلاَحَ فَہُوَ آمِنٌ ، وَلاَ یَؤْخُذُ مِنْ مَتَاعِہِمْ شَیئٌ۔","","Musannaf Ibn Abi Shaybah 33952","","","كتاب الجهاد"
"33953","(۳۳۹۵۳) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا مَیْمُونٌ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : شَہِدْتُ صِفِّینَ ، فَکَانُوا لاَ یُجْہِزُونَ عَلَی جَرِیحٍ ، وَلاَ یَطْلُبُونَ مُوَلِّیًا ، وَلاَ یَسْلُبُونَ قَتِیلاً۔","Sahih","Musannaf Ibn Abi Shaybah 33953","","","كتاب الجهاد"
"33954","(۳۳۹۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ الزُّبَیْرُ یَتَتَبَّعُ الْقَتْلَی یَوْمَ الْیَمَامَۃِ ، فَإِذَا رَأَی رَجُلاً بِہِ رَمَقٌ أَجْہَزَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 33954","","","كتاب الجهاد"
"33955","(۳۳۹۵۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّ النِّسَائُ یُجْہِزْنَ عَلَی الْجَرْحَی یَوْمَ أُحُدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 33955","","","كتاب الجهاد"
"33956","(۳۳۹۵۶) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَبْدُ اللہِ : النَّفَلُ مَا لَمْ یَلْتَقِ الصَّفَّانِ ، أَوِ الزَّحْفَانِ ، فَإِذَا الْتَقَی الزَّحْفَانِ ، أَوِ الصَّفَّانِ ، فَالْمَغْنَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 33956","","","كتاب الجهاد"
"33957","(۳۳۹۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو الْعُمَیْسِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مَسْرُوقٍ ، قَالَ : إِذَا الْتَقَی الزَّحْفَانِ ، أَوِ الصَّفَّانِ فَلاَ نَفْلُ ، إِنَّمَا ہِیَ الْغَنِیمَۃُ ، إِنَّمَا النَّفَلُ قَبْلُ وَبَعْدُ۔","","Musannaf Ibn Abi Shaybah 33957","","","كتاب الجهاد"
"33958","(۳۳۹۵۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ثَوْرٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : قَالَ عُمَرُ : لاَ نَفْلَ فِی أَوَّلِ غَنِیمَۃٍ ، وَلاَ نَفْلَ بَعْدَ الْغَنِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 33958","","","كتاب الجهاد"
"33959","(۳۳۹۵۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ زُہَیْرٍ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، عَنِ الْحَکَمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ، عَنْ جَدِّہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُنَفِّلُ قَبْلَ أَنْ تَنْزِلَ فَرِیضَۃُ الْخُمُسِ فِی الْمَغْنَمِ ، فَلَمَّا نَزَلَتْ : {مَا غَنِمْتُمْ مِنْ شَیْئٍ فَأَنَّ لِلَّہِ خُمُسَہُ} تَرَکَ النَّفَلَ الَّذِی کَانَ یُنْفَلُ ، وَصَارَ فِی ذَلِکَ خُمُسُ الْخُمُسِ ، وَہُوَ سَہْمُ اللہِ ، وَسَہْمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بیہقی ۳۱۴۔ ابن زنجویہ ۱۱۳۵)","Hasan","Musannaf Ibn Abi Shaybah 33959","","","كتاب الجهاد"
"33960","(۳۳۹۶۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدَۃَ ؛ الآیَۃَ : {یَسْأَلُونَک عَنِ الأَنْفَالِ} قَالَ : مَا شَذَّ مِنَ الْمُشْرِکِینَ مِنَ الْعَدُوِّ إِلَی الْمُسْلِمِینَ مِنْ عَبْدٍ ، أَوْ مَتَاعٍ ، أَوْ دَابَّۃٍ فَہِیَ الأَنْفَالُ الَّتِی یَقْضِی فِیہَا مَا أَحَبَّ۔","","Musannaf Ibn Abi Shaybah 33960","","","كتاب الجهاد"
"33961","(۳۳۹۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ مَکْحُولٍ ، وَعِکْرِمَۃَ ؛ {یَسْأَلُونَک عَنِ الأَنْفَالِ قُلَ الأَنْفَالُ لِلَّہِ وَالرَّسُولِ} قَالاَ : کَانَتِ الأَنْفَالُ لِلَّہِ وَرَسُولِہِ حَتَّی نَسَخَتْہَا : {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَیْئٍ فَأَنَّ لِلَّہِ خُمُسَہُ}۔ (طبری ۱۷۵۔ ابن جریر ۱۷۶)","","Musannaf Ibn Abi Shaybah 33961","","","كتاب الجهاد"
"33962","(۳۳۹۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ؛ أَنَّ رَجُلاً سَأَلَ ابْنَ عَبَّاسٍ عَنْ قَوْلِہِ : {یَسْأَلُونَک عَنِ الأَنْفَالِ} ؟ قَالَ : السَّلَبُ وَالْفَرَسُ۔","Sahih","Musannaf Ibn Abi Shaybah 33962","","","كتاب الجهاد"
"33963","(۳۳۹۶۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنٍ ، عَنْ أَبِیہِ ، عَنِ الشَّعْبِیِّ ؛ {یَسْأَلُونَک عَنِ الأَنْفَالِ} قَالَ : مَا أَصَابَتِ السَّرَایَا۔","","Musannaf Ibn Abi Shaybah 33963","","","كتاب الجهاد"
"33964","(۳۳۹۶۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ أَوَّلَ مَنْ أَوقَدَ فِی بَابِ تُسْتَرَ ، قَالَ : وَصُرِعَ الأَشْعَرِیُّ عَنْ فَرَسِہِ ، فَلَمَّا فَتَحْنَاہَا أَمَّرَنِی عَلَی عَشَرَۃٍ مِنْ قَوْمِی ، وَنَفَّلَنِی سَہْمًا سِوَی سَہْمِی ، وَسَہْمِ فَرَسِی قَبْلَ الْغَنِیمَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 33964","","","كتاب الجهاد"
"33965","(۳۳۹۶۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ أَخِی خَالِدِ بنِ الْوَلِیدِ ؛ أَنَّ الْحَارِثَ ، قَالَ لَہُ : أَعْطِنِی ، فَأَعْطَاہُ مِنَ الْخُمُسِ قَبْلَ أَنْ یَقْسِمَ ، فَکَرِہَ ذَلِکَ ، وَقَالَ : إِذَا خَمَّسْت فَأَعْطِنِی۔","","Musannaf Ibn Abi Shaybah 33965","","","كتاب الجهاد"
"33966","(۳۳۹۶۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَ[corrupt]ْ ثَوْرٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لاَ یُعْطَی مِنَ الْمَغْنَمِ شَیْئٌ حَتَّی یُقْسَمَ ، إِلاَّ لِرَاعٍ ، أَوْ حَارِسٍ ، أَوْ سَائِقٍ غَیْرِ مُوَلَّہ۔","","Musannaf Ibn Abi Shaybah 33966","","","كتاب الجهاد"
"33967","(۳۳۹۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : بُعِثَ إِلَی أَنَسٍ بِشَیْئٍ قَبْلَ أَنْ تُقْسَمَ الْغَنَائِمُ ، فَقَالَ : لاَ ، وَأَبَی حَتَّی تُقْسَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 33967","","","كتاب الجهاد"
"33968","(۳۳۹۶۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُنَفَّلُ حَتَّی یُخَمَّسَ۔","","Musannaf Ibn Abi Shaybah 33968","","","كتاب الجهاد"
"33969","(۳۳۹۶۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : النَّفَلُ بَعْدَ الْخُمُسِ۔","","Musannaf Ibn Abi Shaybah 33969","","","كتاب الجهاد"
"33970","(۳۳۹۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَا کَانُوا یُنَفِّلُونَ إِلاَّ مِنَ الْخُمُسِ۔","","Musannaf Ibn Abi Shaybah 33970","","","كتاب الجهاد"
"33971","(۳۳۹۷۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ کَہْمَسٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : غَزَا أَنَسُ بْنُ مَالِکٍ مَعَ عبیدِ اللہِ بْنِ زِیَادٍ ، قَالَ : فَأَعْطَاہُ ثَلاَثِینَ رَأْسًا مِنْ سَبْیِ الْجَاہِلِیَّۃِ ، قَالَ : فَسَأَلَہُ أَنَسٌ أَنْ یَجْعَلَہَا مِنَ الْخُمُسِ ، فَأَبَی أَنَسٌ أَنْ یَقْبَلَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 33971","","","كتاب الجهاد"
"33972","(۳۳۹۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ سُئِلَ عَنِ النُّہْبَۃِ فِی الْغَنِیمَۃِ ، إِذَا أَذِنَ لَہُمْ أَمِیرُہُمْ ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 33972","","","كتاب الجهاد"
"33973","(۳۳۹۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُؤْتَی بِالْغَنِیمَۃِ فَیَقْسِمُہَا عَلَی خَمْسَۃٍ ، فَیَکُونُ أَرْبَعَۃٌ لِمَنْ شَہِدَہَا ، وَیَأْخُذُ الْخُمُسَ ، فَیَضْرِبُ بِیَدِہِ فِیہِ ، فَمَا أَخَذَ مِنْ شَیْئٍ جَعَلَہُ لِلْکَعْبَۃِ ، وَہُوَ سَہْمُ اللہِ الَّذِی سَمَّی ، ثُمَّ یَقْسِمُ مَا بَقِیَ عَلَی خَمْسَۃٍ ، فَیَکُونُ سَہْمٌ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَسَہْمٌ لِذَوِی الْقُرْبَی ، وَسَہْمٌ لِلْیَتَامَی ، وَسَہْمٌ لِلْمَسَاکِینِ ، وَسَہْمٌ لاِبْنِ السَّبِیلِ۔ (ابوداؤد ۳۷۲۔ طبری ۱۰)","","Musannaf Ibn Abi Shaybah 33973","","","كتاب الجهاد"
"33974","(۳۳۹۷۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ صَالِحِ بْنِ أَبِی الأَخْضَرِ ، عَنِ الْوَلِیدِ بْنِ ہِشَامٍ ، عَنْ مَالِکِ بْنِ عَبْدِ اللہِ الْخَثْعَمِیِّ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ عُثْمَانَ ، فَقَالَ : مَنْ ہَاہُنَا مِنْ أَہْلِ الشَّامِ ؟ فَقُمْتُ ، فَقَالَ : أَبْلِغْ مُعَاوِیَۃَ ، إِذَا غَنِمَ غَنِیمَۃً أَنْ یَأْخُذَ خَمْسَۃَ أَسْہُمٍ، فَیَکْتُبُ عَلَی سَہْمٍ مِنْہَا: لِلَّہِ، ثُمَّ لِیُقْرعْ، فَحَیْثُمَا خَرَجَ مِنْہَا فَلْیَأْخُذْ۔","Da'if","Musannaf Ibn Abi Shaybah 33974","","","كتاب الجهاد"
"33975","(۳۳۹۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، قَالَ : سَأَلْتُ یَحْیَی بْنَ الْجَزَّارِ عَنْ سَہْمِ الرَّسُولِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : خُمُسُ الْخُمُسِ۔ (نسائی ۴۴۴۶۔ عبدالرزاق ۹۴۸۶)","","Musannaf Ibn Abi Shaybah 33975","","","كتاب الجهاد"
"33976","(۳۳۹۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ؛ بِنَحْوٍ مِنْہُ۔ (ابوعبید ۳۴)","","Musannaf Ibn Abi Shaybah 33976","","","كتاب الجهاد"
"33977","(۳۳۹۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا کَہْمَسٌ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ الْعُقَیْلِیِّ ، قَالَ : قَامَ رَجُلٌ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَخْبِرْنِی عَنِ الْغَنِیمَۃِ ؟ فَقَالَ : لِلَّہِ سَہْمٌ ، وَلِہَؤُلاَئِ أَرْبَعَۃٌ ، قَالَ : قُلْتُ: فَہَلْ أَحَدٌ أَحَقُّ بِہَا مِنْ أَحَدٍ ؟ قَالَ : فَقَالَ : إِنْ رُمِیتَ بِسَہْمٍ فِی جَنْبِکَ فَلَسْت بِأَحَقَّ بِہِ مِنْ أَخِیک۔n(طحاوی ۳۰۱۔ بیہقی ۳۳۶)","","Musannaf Ibn Abi Shaybah 33977","","","كتاب الجهاد"
"33978","(۳۳۹۷۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی قَوْلِہِ : {فَأَنَّ لِلَّہِ خُمُسَہُ} ، قَالَ: لِلَّہِ کُلُّ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 33978","","","كتاب الجهاد"
"33979","(۳۳۹۷۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : خُمُسُ اللہِ ،وَخُمُسُ الرَّسُولِ وَاحِدٌ ، کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَضَعُ ذَلِکَ الْخُمُسَ حَیْثُ أَحَبَّ ، وَیَصْنَعُ فِیہِ مَا شَائَ ، وَیَحْمِلُ فِیہِ مَنْ شَائَ۔ (ابوعبید ۸۳۷)","","Musannaf Ibn Abi Shaybah 33979","","","كتاب الجهاد"
"33980","(۳۳۹۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَیْئٍ فَأَنَّ لِلَّہِ خُمُسَہُ} ، قَالَ : سَہْمُ اللہِ ، وَسَہْمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 33980","","","كتاب الجهاد"
"33981","(۳۳۹۸۱) حَدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ، عَنِ الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِیٍّ، قَالَ: سَأَلْتُہُ عَنْ قَوْلِہِ: {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَیْئٍ فَأَنَّ لِلَّہِ خُمُسَہُ} ، قَالَ : ہَذَا مِفْتَاحُ کَلاَمُ ، لَیْسَ لِلَّہِ نَصِیبٌ ، لِلَّہِ الدُّنْیَا وَالآخِرَۃُ۔","","Musannaf Ibn Abi Shaybah 33981","","","كتاب الجهاد"
"33982","(۳۳۹۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : فِی الْمَغْنَمِ ؛ خُمُسٌ لِلَّہِ ،وَسَہْمٌ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالصَّفِیِّ۔ وَقَالَ ابْنُ سِیرِینَ : یُؤْخَذُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَیْرُ رَأْسٍ فِی السَّبْیِ ، ثُمَّ یُخْرَجُ الْخُمُسُ ، ثُمَّ یُضْرَبُ لَہُ بِسَہْمِہِ مَعَ النَّاسِ غَابَ ، أَوْ شَہِدَ۔n وَقَالَ ابْنُ سِیرِینَ : کَانَ الصَّفِیُّ یَوْمَ خَیْبَرَ صَفِیَّۃُ بِنْتُ حُیَیِّ۔n وَقَالَ الشَّعْبِیُّ : کَانَ الصَّفِیُّ یَوْمَ خَیْبَرَ صَفِیَّۃُ بِنْتُ حُیَیِّ ، اسْتَنْکَحَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(ابوداؤد ۲۹۸۵۔ سعید بن منصور ۲۶۷۹)","Da'if","Musannaf Ibn Abi Shaybah 33982","","","كتاب الجهاد"
"33983","(۳۳۹۸۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : خُمُسُ اللہِ ، وَسَہْمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالصَّفِیُّ ، کَانَ یُصْطَفَی لَہُ مِنَ الْمَغْنَمِ خَیْرُ رَأْسٍ مِنَ السَّبْیِ ، إِنْ کَانَ سَبْیٌ ، وَإِلاَّ غَیْرُہُ بَعْدَ الْخُمُسِ ، ثُمَّ یُضْرَبُ لَہُ بِسَہْمِہِ شَہِدَ ، أَوْ غَابَ مَعَ الْمُسْلِمِینَ بَعْدَ الصَّفِیِّ ، قَالَ : وَاصْطَفَی صَفِیَّۃَ بِنْتَ حُیَیِّ یَوْمَ خَیْبَرَ۔n قَالَ أَشْعَثُ : وَقَالَ أَبُو الزِّنَادِ، وَعَمْرُو بْنُ دِینَارٍ ، وَالزُّہْرِیُّ : اصْطَفَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَیْفَہُ ذَا الْفِقَارِ یَوْمَ بَدْرٍ۔ (ترمذی ۱۵۶۱۔ حاکم ۱۲۸)","Da'if","Musannaf Ibn Abi Shaybah 33983","","","كتاب الجهاد"
"33984","(۳۳۹۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزِّنَادِ ، قَالَ : کَانَ الصَّفِیُّ یَوْمَ بَدْرٍ سَیْفَ العَاصِ بْنِ مُنَبِّہِ بْنِ الْحَجَّاجِ۔","Da'if","Musannaf Ibn Abi Shaybah 33984","","","كتاب الجهاد"
"33985","(۳۳۹۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ حَجَّاجٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنِ سَہْمِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالصَّفِیِّ ؟ فَقَالَ : إِنَّمَا سَہْمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلُ سَہْمِ رَجُلٍ مِنَ الْمُسْلِمِینَ ، وَأَمَّا الصَّفِیُّ فَکَانَتْ لَہُ غُرَّۃٌ یَخْتَارُہَا مِنْ غَنِیمَۃِ الْمُسْلِمِینَ ، إِنْ شَائَ جَارِیَۃً ، وَإِنْ شَائَ فَرَسًا ، أَیَّ ذَلِکَ شَائَ۔n(ابوداؤد ۲۹۸۴۔ نسائی ۴۴۴۷)","","Musannaf Ibn Abi Shaybah 33985","","","كتاب الجهاد"
"33986","(۳۳۹۸۶) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، قَالَ : سَأَلْتُ عَطَائَ بْنَ السَّائِبِ عَنْ قَوْلِ اللہِ: {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَیْئٍ فَأَنَّ لِلَّہِ خُمُسَہُ} ، وَعَنْ ہَذِہِ الآیَۃِ : {مَا أَفَائَ اللَّہُ عَلَی رَسُولِہِ} ؟ قَالَ : قُلْتُ : مَا الْفَیْئُ ؟ وَمَا الْغَنِیمَۃُ ؟ قَالَ : إِذَا ظَہَرَ الْمُسْلِمُونَ عَلَی الْمُشْرِکِینَ وَعَلَی أَرْضِہِمْ ، فَأَخَذُوہُمْ عَنْوَۃً ، فَمَا أُخِذَ مِنْ مَالٍ ظَہَرُوا عَلَیْہِ فَہُوَ غَنِیمَۃٌ ، وَأَمَّا الأَرْضُ فَہِیَ فَیْئٌ ، وَسَوَادُنَا ہَذَا فَیْئٌ۔","","Musannaf Ibn Abi Shaybah 33986","","","كتاب الجهاد"
"33987","(۳۳۹۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : الْغَنِیمَۃُ مَا أَصَابَ الْمُسْلِمُونَ عَنْوَۃً ، فَہُوَ لِمَنْ سَمَّی اللَّہُ ، وَأَرْبَعَۃُ أَخْمَاسٍ لِمَنْ شَہِدَہَا۔","","Musannaf Ibn Abi Shaybah 33987","","","كتاب الجهاد"
"33988","(۳۳۹۸۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قرَأْتُ کِتَابَ ذِکْرِ الصَّفِیِّ ، فَقُلْتُ لِمُحَمَّدٍ : مَا الصَّفِیُّ ؟ قَالَ : رَأْسٌ کَانَ یُصْطَفَی لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَبْلَ کُلِّ شَیْئٍ ، ثُمَّ یُضْرَبْ لَہُ بَعْدُ بِسَہْمِہِ مَعَ النَّاس۔ (ابوداؤد ۲۹۸۵)","","Musannaf Ibn Abi Shaybah 33988","","","كتاب الجهاد"
"33989","(۳۳۹۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ {وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَیْئٍ} ، قَالَ: الْمِخْیَطُ مِنَ الشَّیْئِ۔","","Musannaf Ibn Abi Shaybah 33989","","","كتاب الجهاد"
"33990","(۳۳۹۹۰) حَدَّثَنَا عَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : الْخُمُسُ بِمَنْزِلَۃِ الْفَیْئِ ، یُعْطِی مِنْہُ الإِمَامُ الْغَنِیَّ وَالْفَقِیرَ۔n قَالَ : وَأَخْبَرَنِی لَیْثُ بْنُ أَبِی رُقَیَّۃَ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : إِنَّ سَبِیلَ الْخُمُسِ سَبِیلُ عَامَّۃِ الْفَیْئِ۔","","Musannaf Ibn Abi Shaybah 33990","","","كتاب الجهاد"
"33991","(۳۳۹۹۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا ثَابِتُ بْنُ الْحَجَّاجِ ، قَالَ : بَلَغَنِی أَنَّ رَجُلَیْنِ مِنْ بَنِی عَبْدِ الْمُطَّلِبِ أَتَیَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْأَلاَنَہُ مِنَ الصَّدَقَۃِ ، فَقَالَ : لاَ ، وَلَکِنْ إِذَا رَأَیْتُمَا عِنْدِی شَیْئًا مِنَ الْخُمُسِ فَأْتِیَانِی۔","","Musannaf Ibn Abi Shaybah 33991","","","كتاب الجهاد"
"33992","(۳۳۹۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ آلُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ تَحِلَّ لَہُمَ الصَّدَقَۃُ ، فَجُعِلَ لَہُمْ خُمُسَ الْخُمُسِ۔ (نسائی ۴۴۴۹۔ طبری ۱۰)","Da'if","Musannaf Ibn Abi Shaybah 33992","","","كتاب الجهاد"
"33993","(۳۳۹۹۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّ عُمَرَ أَعْطَی الرَّجُلَ مِنَ الْفَیْئِ عَشْرَۃَ آلاَفٍ ، وَتِسْعَۃً ، وَثَمَانِیَۃً ، وَسَبْعَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 33993","","","كتاب الجهاد"
"33994","(۳۳۹۹۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا حَجَّاجُ بْنُ أَرْطَاۃَ ، قَالَ : حَدَّثَنَا أَبُو الزُّبَیْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : سُئِلَ کَیْفَ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصْنَعُ بِالْخُمُسِ ؟ قَالَ : کَانَ یَحْمِلُ مِنْہُ فِی سَبِیلِ اللہِ الرَّجُلَ ، ثُمَّ الرَّجُلَ ، ثُمَّ الرَّجُلَ۔ (احمد ۳۶۵)","Hasan","Musannaf Ibn Abi Shaybah 33994","","","كتاب الجهاد"
"33995","(۳۳۹۹۵) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، قَالَ : أَخْبَرَنَا سَیَّارٌ ، قَالَ : حَدَّثَنَا یَزِیدُ الْفَقِیرُ ، قَالَ : أَخْبَرَنَا جَابِرُ بْنُ عَبْدِ اللہِ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أُحِلَّتْ لِی الْغَنَائِم ، وَلَمْ تَحِلَّ لأَحَدٍ قَبْلِی۔","Sahih","Musannaf Ibn Abi Shaybah 33995","","","كتاب الجهاد"
"33996","(۳۳۹۹۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَمْ تَحِلَّ الْمَغَانِمُ لِقَوْمٍ سُودِ الرُّؤُوسِ قَبْلَکُمْ ، کَانَتْ تَنْزِلُ نَارٌ مِنَ السَّمَائِ فَتَأْکُلُہَا ، فَلَمَّا کَانَ یَوْمُ بَدْرٍ ، أَسْرَعَ النَّاسُ فِی الْمَغَانِمُ ، فَأَنْزَلَ اللَّہُ : {لَوْلاَ کِتَابٌ مِنَ اللہِ سَبَقَ لَمَسَّکُمْ فِیمَا أَخَذْتُمْ عَذَابٌ عَظِیمٌ فَکُلُوا مِمَّا غَنِمْتُمْ حَلاَلاً طَیِّبًا}۔ (ترمذی ۳۰۸۵۔ احمد ۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 33996","","","كتاب الجهاد"
"33997","(۳۳۹۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُجَاہِدٍ ، وَمِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أُحِلَّ لِی الْمَغْنَمُ ، وَلَمْ یَحِلَّ لأَحَدٍ قَبْلِی۔","Da'if","Musannaf Ibn Abi Shaybah 33997","","","كتاب الجهاد"
"33998","(۳۳۹۹۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُحِلَّتْ لِیَ الْغَنَائِمُ ، وَلَمْ تَحِلَّ لِنَبِیٍّ کَانَ قَبْلِی۔","Sahih","Musannaf Ibn Abi Shaybah 33998","","","كتاب الجهاد"
"33999","(۳۳۹۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مُجَاہِدٍ - زَادَ فِیہِ غَیْرُ وَکِیعٍ - عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ رَسُولَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمََ: أُحِلَّتْ لِیَ الْغَنَائِمُ ، وَلَمْ تَحِلَّ لِنَبِیٍّ کَانَ قَبْلِی۔","","Musannaf Ibn Abi Shaybah 33999","","","كتاب الجهاد"
"34000","(۳۴۰۰۰) حَدَّثَنَا مُحَمد بِنِ أَبِی عُبَیْدَۃ ، قَالَ : حَدَّثَنَا أَبِی ، عَنِ الأَعْمَش ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أُحِلَّتْ لِیَ الْغَنَائِمُ ، وَلَمْ تَحِلَّ لِنَبِیٍّ کَانَ قَبْلِی۔","Sahih","Musannaf Ibn Abi Shaybah 34000","","","كتاب الجهاد"
"34001","(۳۴۰۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : حدَّثَنَا الْقَاسِمُ ، وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ؛ أَنَّ رَسُولَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ خَیْبَرَ أَنْ تُبَاعَ السِّہَامُ حَتَّی تُقْسَمَ۔ (طبرانی ۷۷۷۴)","","Musannaf Ibn Abi Shaybah 34001","","","كتاب الجهاد"
"34002","(۳۴۰۰۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ شَرِیکٍ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَبِیعَ الرَّجُلُ نَصِیبَہُ مِنَ الْمَغْنَمِ قَبْلَ أَنْ یُقْسَمَ۔","Da'if","Musannaf Ibn Abi Shaybah 34002","","","كتاب الجهاد"
"34003","(۳۴۰۰۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی مَرْزُوقٍ مَوْلَی تُجِیبٍ ، قَالَ : غَزَوْنَا مَعَ رُوَیْفِعِ بْنِ ثَابِتٍ الأَنْصَارِیِّ نَحْوَ الْمَغْرِبِ ، فَفَتَحْنَا قَرْیَۃً یُقَالَ لَہَا : جَرْبَۃُ ، فَقَامَ فِینَا خَطِیبًا ، فَقَالَ : إِنِّی لاَ أَقُولُ لَکُمْ إِلاَّ مَا سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِینَا یَوْمَ خَیْبَرَ : مَنْ کَانَ یُؤْمِنُ بِاللہِ وَالْیَوْمِ الآخِرِ ، فَلاَ یَبِیعَنَّ مَغْنَمًا حَتَّی یُقْسَمَ۔","Hasan","Musannaf Ibn Abi Shaybah 34003","","","كتاب الجهاد"
"34004","(۳۴۰۰۴) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَہْضَمِ بْنِ عَبْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ شِرَائِ الْمَغَانِمِ حَتَّی تُقْسَمَ۔ (ابویعلی ۱۰۸۸)","Da'if","Musannaf Ibn Abi Shaybah 34004","","","كتاب الجهاد"
"34005","(۳۴۰۰۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الْمَغَانِمِ حَتَّی تُقْسَمَ۔ (عبدالرزاق ۹۴۸۹)","","Musannaf Ibn Abi Shaybah 34005","","","كتاب الجهاد"
"34006","(۳۴۰۰۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عروبۃ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْتَرِیَ مِنَ الْمَغْنَمِ شَیْئًا ، وَیَقُولُ : فِیہِ ذَہَبٌ وَفِضَّۃٌ ، یَعْنِی قَبْلَ أَنْ یُقْسَمَ۔","","Musannaf Ibn Abi Shaybah 34006","","","كتاب الجهاد"
"34007","(۳۴۰۰۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدِ بْنِ سِیرِینَ ؛ أَنَّہُمَا کَرِہَا بَیْعَ الْمَغَانِمِ حَتَّی تُقْسَمَ۔","","Musannaf Ibn Abi Shaybah 34007","","","كتاب الجهاد"
"34008","(۳۴۰۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : نَہَی یَوْمَ خَیْبَرَ عَنْ ۔۔۔","","Musannaf Ibn Abi Shaybah 34008","","","كتاب الجهاد"
"34009","(۳۴۰۰۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ،رَفَعَہُ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ نَہَی عَنْ بَیْعِ الْمَغْنَمِ حَتَّی یُقْسَمَ۔ (نسائی ۶۲۴۱۔ ابویعلی ۲۴۱۰)","Hasan","Musannaf Ibn Abi Shaybah 34009","","","كتاب الجهاد"
"34010","(۳۴۰۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ مَوْلَی لِقُرَیْشٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یُحَدِّثُ مُعَاوِیَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الْمَغَانِمِ حَتَّی تُقْسَمَ ۔ قَالَ شُعْبَۃُ مَرَّۃً أُخْرَی : وَتُعْلَمَ مَا ہِیَ۔ (ابوداؤد ۳۳۶۲۔ احمد ۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 34010","","","كتاب الجهاد"
"34011","(۳۴۰۱۱) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ أُسَید بْنِ عَبْدِ الرَّحْمَنِ الْخَثْعَمِیِّ ، عَنْ مُقْبِلِ بْنِ عبْدِ اللہِ ، عَنْ ہَانِئِ بْنِ کُلْثُومٍ الْکِنَانِیِّ ، قَالَ : کُنْتُ صَاحِبَ الْجَیْشِ الَّذِی فَتَحَ الشَّامَ ، فَکَتَبْتُ إِلَی عُمَرَ : إِنَّا فَتَحْنَا أَرْضًا کَثِیرَۃَ الطَّعَامِ وَالْعَلَفِ ، فَکَرِہْتُ أَنْ أَتَقَدَّمَ إِلَی شَیْئٍ مِنْ ذَلِکَ إِلاَّ بِأَمْرِکَ وَإِذْنِکَ ، فَاکْتُبْ إِلَیَّ بِأَمْرِکَ فِی ذَلِکَ ، فَکَتَبَ إِلَیَّ عُمَرُ : أَنْ دَعَ النَّاسَ یَأْکُلُونَ وَیَعْلِفُونَ ، فَمَنْ بَاعَ شَیْئًا بِذَہَبٍ ، أَوْ فِضَّۃٍ فَقَدْ وَجَبَ فِیہِ خُمُسُ اللہِ وَسِہَامُ الْمُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 34011","","","كتاب الجهاد"
"34012","(۳۴۰۱۲) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ أُسَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ خَالِدِ بْنِ دُرَیْکِ ، عَنْ عَبْدِ اللہِ بْنِ مُحَیْرِیزٍ ، قَالَ : سُئِلَ فَضَالَۃُ بْنُ عُبَیْدٍ صَاحِبُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الطَّعَامِ وَالْعَلَفِ فِی أَرْضِ الرُّومِ ؟ فَقَالَ فَضَالَۃَ : إِنَّ أَقْوَامًا یُرِیدُونَ أَنْ یَسْتَزِلُّونِی عَنْ دِینِی ، وَاللہِ إِنِّی لأَرْجُوَ أَنْ لاَ یَکُونَ ذَلِکَ حَتَّی أَلْقَی مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَاعَ طَعَامًا بِذَہَبٍ ، أَوْ فِضَّۃٍ فَقَدْ وَجَبَ فِیہِ خُمُسُ اللہِ وَسِہَامُ الْمُسْلِمِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 34012","","","كتاب الجهاد"
"34013","(۳۴۰۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنْ خَالِدِ بْنِ الدَّرَیْکِ ، عَنِ ابْنِ مُحَیْرِیزٍ ، عَنْ فَضَالَۃَ بْنِ عُبَیْدٍ الأَنْصَارِیِّ ، قَالَ : إِنَّ قَوْمًا یُرِیدُونَ أَنْ یَسْتَنْزِلُونِی عَنْ دِینِی ، أَمَا وَاللہِ إِنِّی لأَرْجُو أَنْ أَمُوتَ وَأَنَا عَلَیْہِ ، مَا کَانَ مِنْ شَیْئٍ بِیْعَ بِذَہَبٍ ، أَوْ فِضَّۃٍ فَفِیہِ خُمُسُ اللہِ وَسِہَامُ الْمُسْلِمِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 34013","","","كتاب الجهاد"
"34014","(۳۴۰۱۴) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُونَ مِنَ الْغَنَائِمِ إِذَا أَصَابُوہَا مِنَ الْجَزَائِرِ وَالْبَقَرِ ، وَیَعْلِفُونَ دَوَابَّہُمْ ، وَلاَ یَبِیعُونَ ، فَإِنْ بِیْعَ رَدَّوہُ إِلَی الْمَقَاسِمِ۔","Hasan","Musannaf Ibn Abi Shaybah 34014","","","كتاب الجهاد"
"34015","(۳۴۰۱۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : دُلِّیَ لِی جِرَابٌ مِنْ شَحْمٍ یَوْمَ خَیْبَرَ ، قَالَ : فَالْتَزَمْتُہُ ، وَقُلْتُ : ہَذَا لِی ، لاَ أُعْطِی أَحَدًا مِنْہُ شَیْئًا ، فَالْتَفَتُّ فَإِذَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَبَسَّمُ ، فَاسْتَحْیَیْتُ۔ (بخاری ۳۱۵۳۔ مسلم ۱۳۹۳)","Sahih","Musannaf Ibn Abi Shaybah 34015","","","كتاب الجهاد"
"34016","(۳۴۰۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنَّا نَغْزُو فَنُصِیبُ الطَّعَامَ ، وَالثِّمَارَ ،وَالْعَسَلَ ، وَالْعَلَفَ ، فَنُصِیبُ مِنْہُ مِنْ غَیْرِ قِسْمَۃٍ۔","","Musannaf Ibn Abi Shaybah 34016","","","كتاب الجهاد"
"34017","(۳۴۰۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَأْکُلُونَ مِنَ الطَّعَامِ فِی أَرْضِ الْحَرْبِ، وَیَعْتَلِفُونَ قَبْلَ أَنْ یُخَمِّسُوا۔","","Musannaf Ibn Abi Shaybah 34017","","","كتاب الجهاد"
"34018","(۳۴۰۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا افْتَتَحُوا الْمَدِینَۃَ ، أَوِ الْقَصْرَ أَکَلُوا مِنَ السَّوِیقِ ، وَالدَّقِیقِ ، وَالسَّمْنِ ، وَالْعَسَلِ۔","Sahih","Musannaf Ibn Abi Shaybah 34018","","","كتاب الجهاد"
"34019","(۳۴۰۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ، عَنْ عَطَائٍ ؛ فِی الْقَوْمِ یَکُونُونَ غُزَاۃً، فَیَکُونُونَ فِی السَّرِیَّۃِ، فَیُصِیبُونَ أَنْحَائَ السَّمْنِ، وَالْعَسَلِ، وَالطَّعَامِ؟ قَالَ: یَأْکُلُونَ، وَمَا بَقِیَ رَدَّوہُ إِلَی إِمَامِہِمْ۔","","Musannaf Ibn Abi Shaybah 34019","","","كتاب الجهاد"
"34020","(۳۴۰۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُرَخِّصُونَ فِی الطَّعَامِ وَالْعَلَفِ ، مَا لَمْ یَعْتَقِدُوا مَالاً۔","","Musannaf Ibn Abi Shaybah 34020","","","كتاب الجهاد"
"34021","(۳۴۰۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ غُلاَمٍ لِسَلْمَانَ ، یُقَالَ لَہُ : سُوَیْد ، وَأَثْنَی عَلَیْہِ خَیْرًا ، قَالَ : لَمَّا افْتَتَحَ النَّاسُ الْمَدَائِنَ ، وَخَرَجُوا فِی طَلَبِ الْعَدُوِّ ، أَصَبْتُ سَلَّۃً ، فَقَالَ لِی سَلْمَانُ : ہَلْ عِنْدَکَ مِنْ طَعَامٌ ؟ قَالَ : قُلْتُ : سَلَّۃً أَصَبْتہَا ، قَالَ : ہَاتِہَا ، فَإِنْ کَانَ مَالاً دَفَعْنَاہُ إِلَی ہَؤُلاَئِ ، وَإِنْ کَانَ طَعَامًا أَکَلْنَاہُ۔","Hasan","Musannaf Ibn Abi Shaybah 34021","","","كتاب الجهاد"
"34022","(۳۴۰۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُقْبَۃُ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ بُرَیْدَۃَ ؛ سُئِلَ عَنِ الطَّعَامِ یُصَابُ فِی أَرْضِ الْعَدُوِّ ؟ فَقَالَ : إِنْ کَانَ بَاعَ مِنْہُ بِدِرْہَمٍ رَدَّہُ ، وَإِلاَّ کَانَ غُلُولاً۔","","Musannaf Ibn Abi Shaybah 34022","","","كتاب الجهاد"
"34023","(۳۴۰۲۳) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ یَحْیَی بْنِ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مُحَیْرِیزٍ ، وَخَالِدِ بْنِ الدَّرَیْکِ ، وَغَیْرِہِمْ ؛ أَنَّہُمْ کَانُوا یَقُولُونَ فِی الرَّجُلِ یُصِیبُ الطَّعَامَ وَالْعَلَفَ فِی أَرْضِ الرُّومِ ، فَقَالُوا : یَأْکُلُ وَیُطْعَمُ وَیَعْلِفُ ، فَإِنْ بَاعَ شَیْئًا مِنْ ذَلِکَ بِذَہَبٍ وَفِضَّۃٍ رَدَّہُ إِلَی غَنَائِمِ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 34023","","","كتاب الجهاد"
"34024","(۳۴۰۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ بِالطَّعَامِ وَالْعَلَفِ یُوجَدُ فِی أَرْضِ الْعَدُوِّ ، أَنْ یَأْکُلُوا مِنْہُ ، وَأَنْ یَعْلِفُوا دَوَابَّہُمْ ، فَمَا بِیعَ مِنْہُ فَہُوَ بَیْنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 34024","","","كتاب الجهاد"
"34025","(۳۴۰۲۵) حَدَّثَنَا عَائِذُ بْنُ حَبَیْبٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إِذَا خَرَجَتِ السَّرِیَّۃُ ،فَأَصَابُوا غَنِیمَۃً مِنْ بَقَرٍ، أَوْ غَنَمٍ فَلَہُمْ أَنْ یَأْکُلُوا بِقَدْرٍ ، وَلاَ یُسْرِفُوا ، فَإِذَا انْتُہِیَ بِہِ إِلَی الْعَسْکَرِ کَانَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 34025","","","كتاب الجهاد"
"34026","(۳۴۰۲۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا نُصِیبُ فِی مَغَازِینَا الْفَاکِہَۃَ وَالْعَسَلَ ، فَنَأْکُلُہُ وَلاَ نَرْفَعُہُ۔ (بخاری ۳۱۵۴۔ بیہقی ۵۹)","Sahih","Musannaf Ibn Abi Shaybah 34026","","","كتاب الجهاد"
"34027","(۳۴۰۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ مُجَالِدٍ، عَنْ عَامِرٍ، قَالَ: لَیْسَ فِی الطَّعَامِ خُمُسٌ، إِنَّمَا الْخُمُسُ فِی الذَّہَبِ وَالْفِضَّۃِ۔","","Musannaf Ibn Abi Shaybah 34027","","","كتاب الجهاد"
"34028","(۳۴۰۲۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلْحَسَنِ : إِنَّا نُصِیبُ فِی بِلاَدِ الْعَدُوِّ الْعَسَلَ وَالسَّمْنَ وَالْجُبْنَ ، أَفَنُخَمِّسُ ؟ قَالَ : قَدْ کُنَّا نُصِیبُہُ فَنَأْکُلُہُ۔","","Musannaf Ibn Abi Shaybah 34028","","","كتاب الجهاد"
"34029","(۳۴۰۲۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، شَیْخٍ مِنْ أَہْلِ وَاسِطَ ؛ أَنَّ عَبْدَ اللہِ بْنَ عَبَّاسٍ لَمْ یَرَ بَأْسًا أَنْ یَأْکُل الرَّجُلِ الطَّعَامَ فِی أَرْضِ الشِّرْکِ ، حَتَّی یَدْخُلَ أَہْلُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 34029","","","كتاب الجهاد"
"34030","(۳۴۰۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَنِ بْنِ أَبِی الْحَسَنِ ، وَأَبِی إِسْحَاقَ ؛أَنَّہُمَا قَالاَ فِی الْقَوْمِ یُصِیبُونَ الْغَنِیمَۃَ : یَأْکُلُونَ ، وَلاَ یَحْمِلُونَ۔","","Musannaf Ibn Abi Shaybah 34030","","","كتاب الجهاد"
"34031","(۳۴۰۳۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الإِفْرِیقِیِّ ، عَنْ خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : سَأَلْتُ الْقَاسِمَ ، وَسَالِمًا عَنِ الرَّجُلِ یُصِیبُ الطَّعَامَ فِی أَرْضِ الْعَدُوِّ ، فَیُصِیبُ مِنْہُ ، وَیَکْسِبُ مِنْہُ الدَّرَاہِمَ ؟ فَقَالاَ : یَجْعَلُہُ فِی طَعَامٍ یَأْکُلُہُ ، وَلاَ یَکْسِبُ مِنْہُ عُقْدَۃَ مَالٍ۔","","Musannaf Ibn Abi Shaybah 34031","","","كتاب الجهاد"
"34032","(۳۴۰۳۲) حَدَّثَنَا ہُشَیْمٌ، عَنِ ابْنِ عَوْنٍ، عَنْ رَجَائِ بْنِ حَیْوَۃَ؛ أَنَّ أَبَا عُبَیْدَۃَ کَتَبَ إِلَی عُمَرَ بْنِ الْخَطَّابِ فِی عَبْدٍ أَسَرَہُ الْمُشْرِکُونَ، ثُمَّ ظَہَرَ عَلَیْہِ الْمُسْلِمُونَ بَعْدَ ذَلِکَ؟ قَالَ: صَاحِبُہُ أَحَقُّ بِہِ مَا لَمْ یُقْسَمْ ، فَإِذَا قُسِمَ حَقَّہ مَضَی۔","","Musannaf Ibn Abi Shaybah 34032","","","كتاب الجهاد"
"34033","(۳۴۰۳۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، قَالَ : قَالَ عُمَرُ : مَا أَحْرَزَ الْمُشْرِکُونَ مِنْ أَمْوَالِ الْمُسْلِمِینَ فَغَزَوْہُمْ بَعْدُ وَظَہَرُوا عَلَیْہِمْ ، فَوَجَدَ رَجُلٌ مَالَہُ بِعَیْنِہِ قَبْلَ أَنْ تُقْسَمَ السِّہَامُ فَہُوَ أَحَقُّ بِہِ ، وَإِنْ کَانَ قُسِمَ فَلاَ شَیْئَ لَہُ۔","","Musannaf Ibn Abi Shaybah 34033","","","كتاب الجهاد"
"34034","(۳۴۰۳۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، قَالَ: قَالَ عَلِیٌّ: ہُوَ لِلْمُسْلِمِینَ عَامَّۃً، لأَنَّہُ کَانَ لَہُمْ مَالاً۔","","Musannaf Ibn Abi Shaybah 34034","","","كتاب الجهاد"
"34035","(۳۴۰۳۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ یَقُولُ فِیمَا أَحْرَزَ الْعَدُوُّ مِنْ أَمْوَالِ الْمُسْلِمِینَ ، إِنَّہُ بِمَنْزِلَۃِ أَمْوَالِہِمْ ، قَالَ : وَکَانَ الْحَسَنُ یَقْضِی بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 34035","","","كتاب الجهاد"
"34036","(۳۴۰۳۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ثَوْرٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ زُہْرَۃَ بْنِ یَزِیدَ الْمُرَادِیِّ ؛ أَنَّ أَمَۃً لِرَجُلٍ مِنَ الْمُسْلِمِینَ أَبْقَتْ ، وَلَحِقَتْ بِالْعَدُوِّ ، فَغَنِمَہَا الْمُسْلِمُونَ ، فَعَرَفَہَا أَہْلُہَا ، فَکَتَبَ فِیہَا أَبُو عُبَیْدَۃَ إِلَی عُمَرَ ، فَکَتَبَ عُمَرُ : إِنْ کَانَتِ الأَمَۃَ لَمْ تُخَمَّسْ وَلَمْ تُقْسَمْ فَہِیَ رَدٌّ عَلَی أَہْلِہَا ، وَإِنْ کَانَتْ قَدْ خُمِّسَتْ وَقُسِمَتْ فَأَمْضِہَا لِسَبِیلِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 34036","","","كتاب الجهاد"
"34037","(۳۴۰۳۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عَبْدًا لَہُ أَبَقَ ، وَذَہَبَ لَہُ بِفَرَسٍ ، فَدَخَلَ أَرْضَ الْعَدُوِّ ، فَظَہَرَ عَلَیْہِ خَالِدُ بْنُ الْوَلِیدِ فَرُدَّ أَحَدُہُمَا عَلَیْہِ فِی حَیَاۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَرُدَّ الآخَرُ بَعْدَ وَفَاۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۳۰۶۹)","Sahih","Musannaf Ibn Abi Shaybah 34037","","","كتاب الجهاد"
"34038","(۳۴۰۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَلْمَانَ بْنِ رَبِیعَۃَ ؛ فِیمَا أَحْرَزَ الْعَدُوُّ ، قَالَ : صَاحِبُہُ أَحَقُّ بِہِ مَا لَمْ یُقْسَمْ ، فَإِذَا قُسِمَ فَلاَ شَیْئَ۔","","Musannaf Ibn Abi Shaybah 34038","","","كتاب الجهاد"
"34039","(۳۴۰۳۹) حَدَّثَنَا شَرِیک ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، أَوْ عَنْ عَمِّہِ ، قَالَ : حَسَرَ لِی فَرَسٌ فَأَخَذَہُ الْعَدُوُّ ، قَالَ : فَظَہَرَ عَلَیْہِ الْمُسْلِمُونَ ، قَالَ : فَوَجَدْتُہُ فِی مَرْبِطِ سَعْدٍ ، قَالَ : فَقُلْتُ : فَرَسِی ، قَالَ : فَقَالَ : بَیِّنَتُک ، قُلْتُ : أَنَا أَدْعُوہُ فَیُحَمْحِمُ ، قَالَ : إِنْ أَجَابَک فَلاَ أُرِیدُ مِنْک بَیِّنَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 34039","","","كتاب الجهاد"
"34040","(۳۴۰۴۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ أَمَۃً أَحْرَزَہَا الْعَدُوُّ ،فَاشْتَرَاہَا رَجُلٌ ، فَخَاصَمَہُ سَیِّدُہَا إِلَی شُرَیْحٍ ، فَقَالَ: الْمُسْلِمُ أَحَقُّ مَنْ رَدَّ عَلَی أَخِیہِ بِالثَّمَنِ ، فَقَالَ : إِنَّہَا وَلَدَتْ مِنْ سَیِّدِہَا، قَالَ : أَعْتَقَہَا ، قَضَائُ الأَمِیرِ ، فَإِنْ کَانَتْ کَذَا وَکَذَا ، وَإِنْ کَانَتْ کَذَا وَکَذَا ، قَالَ : یَقُولُ رَجُلٌ : لَہُو أَعْلَمَ بِالْقَضَائِ مِنْ زَیْدِ بْنِ خَلْدَۃَ۔","","Musannaf Ibn Abi Shaybah 34040","","","كتاب الجهاد"
"34041","(۳۴۰۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالاَ : مَا أَحْرَزَ الْعَدُوُّ مِنْ مَالِ الْمُسْلِمِینَ فَعَرَفَہُ صَاحِبُہُ فَہُوَ أَحَقُّ بِہِ ، وَإِنْ قُسِمَ فَقَدْ مَضَی۔","","Musannaf Ibn Abi Shaybah 34041","","","كتاب الجهاد"
"34042","(۳۴۰۴۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا أَصَابَ الْمُسْلِمُونَ مِمَّا أَصَابَہُ الْعَدُوُّ قَبْلَ ذَلِکَ ، فَإِنْ أَصَابَہُ صَاحِبُہُ قَبْلَ أَنْ یُقْسَمَ فَہُوَ أَحَقُّ بِہِ ، وَإِنْ قُسِمَ فَہُوَ أَحَقُّ بِہِ بِالثَّمَنِ۔","","Musannaf Ibn Abi Shaybah 34042","","","كتاب الجهاد"
"34043","(۳۴۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ ، قَالَ : مَا أَحْرَزَ الْعَدُوُّ فَہُوَ جَائِزٌ۔","Sahih","Musannaf Ibn Abi Shaybah 34043","","","كتاب الجهاد"
"34044","(۳۴۰۴۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا ظَہَرَ عَلَیْہِ الْمُشْرِکُونَ مِنْ مَتَاعِ الْمُسْلِمِینَ ، ثُمَّ ظَہَرَ عَلَیْہِ الْمُسْلِمُونَ ، إِنْ قُسِمَ فَہُوَ أَحَقُّ بِہِ بِالثَّمَنِ ، وَإِنْ کَانَ لَمْ یُقْسَمْ رُدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 34044","","","كتاب الجهاد"
"34045","(۳۴۰۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ تَمِیمِ بْنِ طَرَفَۃَ ، قَالَ : أَصَابَ الْمُسْلِمُونَ نَاقَۃً لِرَجُلٍ مِنَ الْمُسْلِمِینَ ، فَاشْتَرَاہَا رَجُلٌ مِنَ الْعَدُوِّ ، فَخَاصَمَہُ صَاحِبُہَا إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَقَامَ الْبَیِّنَۃَ ، فَقَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْ یَدْفَعَ إِلَیْہِ الثَّمَنَ الَّذِی اشْتَرَی بِہِ مِنَ الْعَدُوِّ ، وَإِلاَّ خُلِّیَ بَیْنَہُ وَبَیْنَہَا۔ (ابوداؤد ۳۳۹۔ بیہقی ۱۱۱)","","Musannaf Ibn Abi Shaybah 34045","","","كتاب الجهاد"
"34046","(۳۴۰۴۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَحِلُّ لِمُسْلِمٍ أَنْ یَحْمِلَ إِلَی عَدُوِّ الْمُسْلِمِینَ طَعَامًا ، وَلاَ سِلاَحًا یُقَوِّیہِمْ بِہِ عَلَی الْمُسْلِمِینَ ، فَمَنْ فَعَلَ ذَلِکَ فَہُوَ فَاسِقٌ۔","","Musannaf Ibn Abi Shaybah 34046","","","كتاب الجهاد"
"34047","(۳۴۰۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنْ ابْنُ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ حَمْلَ السِّلاَحِ إِلَی الْعَدُوِّ ، قَالَ : قُلْتُ لَہُ : تُحْمَلُ الْخَیْلُ إِلَیْہِمْ ؟ قَالَ : فَأَبَی ذَلِکَ ، وَقَالَ : أَمَّا مَا یُقَوِّیہِمْ لِلْقِتَالِ فَلاَ ، وَأَمَّا غَیْرُہُ فَلاَ بَأْسَ۔n وَقَالَہُ عَمْرُو بْنُ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 34047","","","كتاب الجهاد"
"34048","(۳۴۰۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: نَہَی عُمَرُ بْنُ عَبْدِالْعَزِیزِ أَنْ تُحْمَلَ الْخَیْلُ إِلَی أَرْضِ الْہِنْدِ۔","","Musannaf Ibn Abi Shaybah 34048","","","كتاب الجهاد"
"34049","(۳۴۰۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یُحْمَلَ السِّلاَحُ ، أَوْ الْکُرَاعُ إِلَی أَرْضِ الْعَدُوِّ لِلتِّجَارَۃِ۔","","Musannaf Ibn Abi Shaybah 34049","","","كتاب الجهاد"
"34050","(۳۴۰۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُکْرَہُ أَنْ یُحْمَلَ إِلَی عَدُوِّ الْمُسْلِمِینَ سِلاَحٌ ، أَوْ مَنْفَعَۃٌ۔","","Musannaf Ibn Abi Shaybah 34050","","","كتاب الجهاد"
"34051","(۳۴۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَرِہَا بَیْعَ السِّلاَحِ فِی الْفِتْنَۃِ۔","","Musannaf Ibn Abi Shaybah 34051","","","كتاب الجهاد"
"34052","(۳۴۰۵۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا أَبُو حَیَّانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَرِہَا بَیْعَ السِّلاَحِ فِی الْفِتْنَۃِ۔","","Musannaf Ibn Abi Shaybah 34052","","","كتاب الجهاد"
"34053","(۳۴۰۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یُبْعَثُ إِلَی أَہْلِ الْحَرْبِ شَیْئٌ مِنَ السِّلاَحِ وَالْکُرَاعِ ، وَلاَ مَا یُسْتَعَانُ بِہِ عَلَی السِّلاَحِ وَالْکُرَاعِ۔","Hasan","Musannaf Ibn Abi Shaybah 34053","","","كتاب الجهاد"
"34054","(۳۴۰۵۴) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ یُکْرَہُ بَیْعُ السِّلاَحِ فِی الْقِتَالِ۔","","Musannaf Ibn Abi Shaybah 34054","","","كتاب الجهاد"
"34055","(۳۴۰۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَغْزُونَ زَمَانَ الْحَجَّاجِ : عَبْدُ الرَّحْمَن بْنُ یَزِیدَ ، وَأَبُو سِنَانٍ ، وَأَبُو جُحَیْفَۃَ۔","","Musannaf Ibn Abi Shaybah 34055","","","كتاب الجهاد"
"34056","(۳۴۰۵۶) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، قَالَ : سَمِعْتُہُمْ یَذْکُرُونَ : أَنَّ عَبْدَ الرَّحْمَن بْنَ یَزِیدَ کَانَ یَغْزُو الْخَوَارِجَ فِی زَمَانِ الْحَجَّاجِ ، یُقَاتِلُہُمْ۔","","Musannaf Ibn Abi Shaybah 34056","","","كتاب الجهاد"
"34057","(۳۴۰۵۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ غَزَا الرَّیَّ فِی زَمَانِ الْحَجَّاجِ۔","","Musannaf Ibn Abi Shaybah 34057","","","كتاب الجهاد"
"34058","(۳۴۰۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُثَنَّی بْنُ سَعِیدٍ ، عَنْ أَبِی جَمْرَۃَ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْغَزْوِ مَعَ الأُمَرَائِ وَقَدْ أَحْدَثُوا ؟ فَقَالَ : تُقَاتِلُ عَلَی نَصِیبِکَ مِنَ الآخِرَۃِ ، وَیُقَاتِلُونَ عَلَی نَصِیبِہِمْ مِنَ الدُّنْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 34058","","","كتاب الجهاد"
"34059","(۳۴۰۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنِ الْجَعْدِ أَبِی عُثْمَانَ ، عَنْ سُلَیْمَانَ الْیَشْکُرِیِّ، عَنْ جَابِرٍ، قَالَ: قُلْتُ لَہُ: أَغْزُو أَہْلَ الضَّلاَلَۃِ مَعَ السُّلْطَانِ؟ قَالَ: اُغْزُوا ، فَإِنَّمَا عَلَیْک مَا حُمِّلْتَ، وَعَلَیْہِمْ مَا حُمِّلُوا۔","Sahih","Musannaf Ibn Abi Shaybah 34059","","","كتاب الجهاد"
"34060","(۳۴۰۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنِ الْفَزَارِیِّ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ سُئِلاَ عَنِ الْغَزْوِ مَعَ أَئِمَّۃِ السُّوئِ؟ فَقَالاَ : لَکَ شَرَفُہُ ، وَأَجْرُہُ ، وَفَضْلُہُ ، وَعَلَیْہِمْ إِثْمَہُمْ۔","","Musannaf Ibn Abi Shaybah 34060","","","كتاب الجهاد"
"34061","(۳۴۰۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : مَالِکُ بْنُ مِغْوَلٍ ، عَنْ طَلْحَۃَ بْنِ مُصَرِّفٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْن یَزِیدَ النَّخَعِیِّ ، قَالَ : قُلْتُ لأَبِی : یَا أَبَۃِ ، فِی إِمَارَۃِ الْحَجَّاجِ ، أَتَغْزُو ؟ قَالَ : یَا بُنَی ، لَقَدْ أَدْرَکْتُ أَقْوَامًا أَشَدَّ بُغْضًا مِنْکُمْ لِلْحَجَّاجِ ، وَکَانُوا لاَ یَدَعُونَ الْجِہَادَ عَلَی حَالٍ ، وَلَوْ کَانَ رَأْیُ النَّاسِ فِی الْجِہَادِ مِثْلَ رَأْیِکَ مَا أُدِّی الإِتَاوَۃَ ، یَعْنِی الْخَرَاجَ۔","","Musannaf Ibn Abi Shaybah 34061","","","كتاب الجهاد"
"34062","(۳۴۰۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْمُغِیرَۃِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : ذُکِرَ لَہُ أَنَّ قَوْمًا یَقُولُونَ : لاَ جِہَادَ ، فَقَالَ : ہَذَا شَیْئٌ عَرَضَ بِہِ الشَّیْطَانُ۔","","Musannaf Ibn Abi Shaybah 34062","","","كتاب الجهاد"
"34063","(۳۴۰۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ صَبِیْحٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الْغَزْوِ مَعَ أَئِمَّۃِ الْجَوْرِ ، وَقَدْ أَحْدَثُوا ؟ فَقَالَ : اُغْزُوا۔","Da'if","Musannaf Ibn Abi Shaybah 34063","","","كتاب الجهاد"
"34064","(۳۴۰۶۴) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، قَالَ : کَانَ مُجَاہِدٌ یَغْزُو مَعَ بَنِی مَرْوَانَ ، وَکَانَ عَطَائٌ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 34064","","","كتاب الجهاد"
"34065","(۳۴۰۶۵) حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : خَرَجَ عَلَی النَّاسِ بَعْثٌ زَمَنَ الْحَجَّاجِ ، فَخَرَجَ فِیہِ عَبْدُ الرَّحْمَن بْنُ یَزِیدَ۔","","Musannaf Ibn Abi Shaybah 34065","","","كتاب الجهاد"
"34066","(۳۴۰۶۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَن ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : کَانَ یُکْرَہُ الْجِہَادُ مَعَ ہَؤُلاَئِ ، یَعْنِی السُّلْطَانَ الْجَائِرَ۔","","Musannaf Ibn Abi Shaybah 34066","","","كتاب الجهاد"
"34067","(۳۴۰۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : خَرَجَ عَلَی النَّاسِ بَعْثٌ زَمَنَ الْحَجَّاجِ ، فَخَرَجَ فِیہِ إِبْرَاہِیمُ التَّیْمِیُّ ، وَإِبْرَاہِیمُ النَّخَعِیُّ ، فَقَالَ إِبْرَاہِیمُ النَّخَعِیُّ : إِلَی مَنْ تَدْعُوہُمْ ؟ إِلَی الْحَجَّاجِ ؟۔","","Musannaf Ibn Abi Shaybah 34067","","","كتاب الجهاد"
"34068","(۳۴۰۶۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ حَجَّاجٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی مَالِکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مَسْلَمَۃَ؛ أَنَّ رَجُلاً أَمَّنَ قَوْمًا وَہُوَ مَعَ عَمْرِو بْنِ الْعَاصِ ، وَخَالِدِ بْنِ الْوَلِیدِ ، وَأَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ ، فَقَالَ عَمْرٌو ، وَخَالِدٌ : لاَ نُجِیرُ مَنْ أَجَارَ ، فَقَالَ أَبُو عُبَیْدَۃَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : یُجِیرُ عَلَی الْمُسْلِمِینَ بَعْضُہُمْ۔","","Musannaf Ibn Abi Shaybah 34068","","","كتاب الجهاد"
