hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"5401","432 - (  5398  ) - قَالَ :  وَكُنَّا نُسَلِّمُ فِي الصَّلَاةِ ، فَقِيلَ لَنَا : إِنَّ فِي الصَّلَاةِ لَشُغْلًا  .","","Musnad Abi Ya'la al-Mawsili 5398","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن النضر بن شميل عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5402","433 - (  5399  ) -  حَدَّثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِيُّ ،  حَدَّثَنَا  بَشِيرُ بْنُ سَلْمَانَ ،  عَنْ  سَيَّارٍ أَبِي الْحَكَمِ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،         [9/276]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ نَزَلَتْ بِهِ  فَاقَةٌ  فَأَنْزَلَهَا بِالنَّاسِ لَمْ تُسَدَّ  فَاقَتُهُ  ، وَمَنْ أَنْزَلَهَا بِاللهِ أَوْشَكَ لَهُ بِالْغِنَى إِمَّا عَاجِلًا ، وَإِمَّا آجِلًا آجِلًا  .","","Musnad Abi Ya'la al-Mawsili 5399","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن سيار بن أبي سيار العنزي عن بشير بن سلمان عن محمد بن بشر بن الفرافصة عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5403","434 - (  5400  ) -  وَعَنْ  مُحَمَّدِ بْنِ بِشْرٍ ، وَالْعَبَّاسِ بْنِ الْفَضْلِ ، قَالَا :  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَعْضِ أَسْفَارِهِ إِذْ سَمِعْنَا مُنَادِيًا يُنَادِي : اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : عَلَى الْفِطْرَةِ ،  فَقَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ النَّبِيُّ : خَرَجَ مِنَ النَّارِ  ، فَابْتَدَرْنَاهُ ، فَإِذَا هُوَ صَاحِبُ مَاشِيَةٍ أَدْرَكَتْهُ الصَّلَاةُ فَنَادَى لَهَا  .","","Musnad Abi Ya'la al-Mawsili 5400","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عباس بن الفضل الواقفي عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5404","435 - (  5401  ) -  حَدَّثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  حَدَّثَنَا  الْعَبَّاسُ         [9/277]      بْنُ الْفَضْلِ ،  حَدَّثَنِي  عُمَرُ بْنُ عَامِرٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  يَحْيَى الْجَابِرِ ،  عَنْ  أَبِي مَاجِدَةَ الْعِجْلِيِّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَتَعَافَى النَّاسُ بَيْنَهُمْ فِي الْحُدُودِ مَا لَمْ تُرْفَعْ إِلَى الْحُكَّامِ  ، فَإِذَا رُفِعَتْ إِلَى الْحَاكِمِ ، حَكَمَ بَيْنَهُمْ بِكِتَابِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 5401","","عبد الله بن مسعود عن عائذ بن نضلة الحنفي عن يحيى بن عبد الله بن الحارث الجابر عن حجاج بن أرطاة عن عمر بن عامر عن عباس بن عبد الله الباكسائي عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5405","436 - (  5402  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَخْرُجُ قَوْمٌ فِي آخِرِ الزَّمَانِ حُدَثَاءُ الْأَسْنَانِ ، سُفَهَاءُ الْأَحْلَامِ ، يَقُولُ مِنْ خَيْرِ قَوْلٍ  ، يَقْرَؤُونَ الْقُرْآنَ لَا يَعْدُو حَنَاجِرَهُمْ ،  يَمْرُقُونَ  مِنَ الْإِسْلَامِ كَمَا         [9/278]      يَمْرُقُ  السَّهْمُ مِنَ  الرَّمِيَّةِ ،  فَمَنْ لَقِيَهُمْ فَلْيُقَاتِلْهُمْ ، فَإِنَّ قَتْلَهُمْ عِنْدَ اللهِ أَجْرٌ لِمَنْ قَتَلَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5402","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5406","437 - (  5403  ) -  حَدَّثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ،  حَدَّثَنَا  ابْنُ أَبِي أُوَيْسٍ ،  عَنْ  أَخِيهِ  ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  أُنْزِلَ الْقُرْآنُ عَلَى سَبْعَةِ  أَحْرُفٍ  ، لِكُلِّ حَرْفٍ مِنْهَا  ظَهْرٌ  وَبَطْنٌ  .","","Musnad Abi Ya'la al-Mawsili 5403","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سليمان بن بلال القرشي عن عبد الحميد بن أبي أويس الأعشى عن إسماعيل بن أبي أويس عن سهل بن أبي سهل الأشتر عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5407","438 - (  5404  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو         [9/279]      عَوَانَةَ ،  عَنْ  يَحْيَى الْجَابِرِ ،  عَنْ  أَبِي مَاجِدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  سَأَلْنَا نَبِيَّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْمَشْيِ مَعَ الْجِنَازَةِ ، فَقَالَ : مَا دُونَ  الْخَبَبِ  ، فَإِنْ يَكُنْ خَيْرًا يُعَجَّلْ إِلَيْهِ ، وَإِنْ يَكُ غَيْرَ ذَلِكَ فَبُعْدًا لِأَهْلِ النَّارِ ،  الْجِنَازَةُ مَتْبُوعَةٌ وَلَا تَتْبَعُ ، لَيْسَ مِنْهَا مَنْ تَقَدَّمَهَا  .","","Musnad Abi Ya'la al-Mawsili 5404","","عبد الله بن مسعود عن عائذ بن نضلة الحنفي عن يحيى بن عبد الله بن الحارث الجابر عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5408","439 - (  5405  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبَانَ بْنِ تَغْلِبَ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  ابْنَ مَسْعُودٍ بَاعَ مِنَ  الْأَشْعَثِ  رَقِيقًا مِنْ رَقِيقِ الْإِمَارَةِ ، فَأَتَاهُ يَتَقَاضَاهُ ، فَاخْتَلَفَا فِي الثَّمَنِ ، فَقَالَ  ابْنُ مَسْعُودٍ  : تَرْضَى أَنْ أَقْضِيَ بَيْنِي وَبَيْنَكَ بِقَضَاءِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  إِذَا اخْتَلَفَ  الْبَيِّعَانِ  فَالْقَوْلُ مَا قَالَ الْبَائِعُ ، أَوْ يَتَرَادَّانِ  .","","Musnad Abi Ya'la al-Mawsili 5405","","عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن أبان بن تغلب بن رياح عن حماد بن زيد عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5409","440 - (  5406  ) -  حَدَّثَنَا  أَبُو يَاسِرٍ عَمَّارُ بْنُ نَصْرٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ عَابِسٍ النَّخَعِيُّ أَبُو الْحَسَنِ ،  حَدَّثَنَا  الْعَلَاءُ بْنُ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ ،         [9/280]      عَنْ  عَبْدِ اللهِ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  .","","Musnad Abi Ya'la al-Mawsili 5406","","عبد الله بن مسعود عن المسيب بن رافع الكاهلي عن علاء بن المسيب عن علي بن عابس الملائي عن عمار بن نصر الخراساني عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5410","441 - (  5407  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَّامٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنَّهُ قَالَ :  لَمَّا نَزَلَتْ :         {      إِذَا جَاءَ نَصْرُ اللهِ وَالْفَتْحُ         }      إِلَى آخِرِ السُّورَةِ  ، كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُكْثِرُ أَنْ يَقُولَ : سُبْحَانَكَ رَبَّنَا  وَبِحَمْدِكَ  ، اللَّهُمَّ اغْفِرْ لِي ، إِنَّكَ أَنْتَ التَّوَّابُ  .","","Musnad Abi Ya'la al-Mawsili 5407","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن إبراهيم بن طهمان عن عبد الرحمن بن سلام الطرسوسي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5411","442 - (  5408  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَّامٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ قَالَ :  مَنْ أَتَى  عَرَّافًا ،  أَوْ سَاحِرًا ، أَوْ  كَاهِنًا ،  فَسَأَلَهُ فَصَدَّقَهُ بِمَا يَقُولُ  ، فَقَدْ كَفَرَ بِمَا أُنْزِلَ عَلَى  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [9/281]","","Musnad Abi Ya'la al-Mawsili 5408","","عبد الله بن مسعود عن هبيرة بن يريم الشبامي عن أبو إسحاق السبيعي عن إبراهيم بن طهمان عن عبد الرحمن بن سلام الطرسوسي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5412","443 - (  5409  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مِهْرَانَ السَّبَّاكُ ،  حَدَّثَنَا  عَلِيُّ بْنُ عَابِسٍ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  بُورِكَ لِأُمَّتِي فِي بُكُورِهَا  .","","Musnad Abi Ya'la al-Mawsili 5409","","عبد الله بن مسعود عن المسيب بن رافع الكاهلي عن علاء بن المسيب عن علي بن عابس الملائي عن جعفر بن مهران السباك عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5413","444 - (  5410  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ بْنِ عَطِيَّةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،         [9/282]      عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَعِدَ الْمِنْبَرَ اسْتَقْبَلْنَاهُ بِوُجُوهِنَا  .         [9/283]","","Musnad Abi Ya'la al-Mawsili 5410","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن محمد بن الفضل بن عطية العبسي عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5414","445 - (  5411  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ كُوفِيٌّ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  حَجَّاجٍ ،  عَنْ  فُضَيْلٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  نَامَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى نَفَخَ ثُمَّ قَامَ فَصَلَّى  ، قَالَ :  فَذَكَرْتُهُ لِعَطَاءٍ ، فَقَالَ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَكُنْ كَغَيْرِهِ  .         [9/284]","","Musnad Abi Ya'la al-Mawsili 5411","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن فضيل بن عمرو الفقيمي عن حجاج بن أرطاة عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5415","446 - (  5412  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُمَرُ بْنُ عُبَيْدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَرُدُّوا الْهَدِيَّةَ ، وَأَجِيبُوا الدَّاعِيَ ، وَلَا تَضْرِبُوا الْمُسْلِمِينَ  .","","Musnad Abi Ya'la al-Mawsili 5412","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن عمر بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5416","447 - (  5413  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  بَكْرُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  عِيسَى ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أَبِي قَيْسٍ الْأَوْدِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَجْمَعُ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ  .         [9/285]","","Musnad Abi Ya'la al-Mawsili 5413","","عبد الله بن مسعود عن عبد الرحمن بن ثروان الأودي عن محمد بن عبد الرحمن بن أبي ليلى عن عيسى بن المختار الأنصاري عن بكر بن عبد الرحمن الأنصاري عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5417","448 - (  5414  ) -  حَدَّثَنَا  قَاسِمُ بْنُ أَبِي عُبَيْدٍ ،  حَدَّثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  أَوَّلُ مَا يُحَاسَبُ بِهِ الْعَبْدُ الصَّلَاةُ ، وَأَوَّلُ مَا يُقْضَى بَيْنَ النَّاسِ يَوْمَ الْقِيَامَةِ الدِّمَاءُ  .","","Musnad Abi Ya'la al-Mawsili 5414","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن قاسم بن أبي عبيد عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5418","[9/286]      مُسْنَدُ  عَبْدِ اللهِ بْنِ عُمَرَ  1 - (  5415  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى ،         [9/287]      حَدَّثَنَا  أَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  حَدَّثَنَا  الزُّهْرِيُّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ بَيْعِ  الثَّمَرِ  حَتَّى         [9/288]      يَبْدُوَ صَلَاحُهُ  ، وَنَهَى عَنْ بَيْعِ  الثَّمَرِ  بِالتَّمْرِ  .         [9/289]","","Musnad Abi Ya'la al-Mawsili 5415","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5419","2 - (  5416  ) -  قَالَ  ابْنُ عُمَرَ :  حَدَّثَنَا  زَيْدُ بْنُ ثَابِتٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي الْعَرَايَا  .         [9/290]             [9/291]","","Musnad Abi Ya'la al-Mawsili 5416","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5420","3 - (  5417  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  الزُّهْرِيُّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ الْقُرْآنَ ، فَهُوَ يَقُومُ بِهِ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ ، وَرَجُلٍ آتَاهُ اللهُ مَالًا ، فَهُوَ يُنْفِقُهُ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 5417","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5421","4 - (  5418  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنِ اقْتَنَى كَلْبًا إِلَّا كَلْبَ صَيْدٍ أَوْ مَاشِيَةٍ ، نَقَصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ  .         [9/292]             [9/293]","","Musnad Abi Ya'la al-Mawsili 5418","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5422","5 - (  5419  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَى  رَجُلٌ  أَنَّ لَيْلَةَ الْقَدْرِ لَيْلَةُ سَبْعٍ وَعِشْرِينَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَرَى رُؤْيَاكُمْ فِي الْعَشْرِ الْأَوَاخِرِ ، فَاطْلُبُوهَا فِي  الْوِتْرِ  مِنْهَا  .         [9/294]             [9/295]","","Musnad Abi Ya'la al-Mawsili 5419","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5423","6 - (  5420  ) -  وَعَنْ  أَبِيهِ ، قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ  حَذْوَ  مَنْكِبَيْهِ  ، وَإِذَا رَكَعَ ، وَإِذَا رَفَعَ ، وَلَا يَرْفَعُ بَيْنَ السَّجْدَتَيْنِ  .         [9/296]             [9/297]","","Musnad Abi Ya'la al-Mawsili 5420","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5424","7 - (  5421  ) -  وَعَنْ  أَبِيهِ ،  أَنَّهُ  رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  يَمْشُونَ أَمَامَ الْجِنَازَةِ  .         [9/298]","","Musnad Abi Ya'la al-Mawsili 5421","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5425","8 - (  5422  ) -  وَعَنْ  أَبِيهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ كَانَ إِذَا  جَدَّ  بِهِ السَّيْرُ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  .         [9/299]             [9/300]","","Musnad Abi Ya'la al-Mawsili 5422","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5426","9 - (  5423  ) -  وَعَنْ  أَبِيهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَقَّتَ  لِأَهْلِ  الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ، وَلِأَهْلِ  الشَّامِ  الْجُحْفَةَ  ، وَلِأَهْلِ  نَجْدٍ  قَرْنًا  ،         [9/301]      وَذُكِرَ  لِابْنِ عُمَرَ  وَلَمْ يَسْمَعْهُ ، وَلِأَهْلِ  الْيَمَنِ  يَلَمْلَمَ  .         [9/302]","","Musnad Abi Ya'la al-Mawsili 5423","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5427","10 - (  5424  ) -  وَعَنْ  أَبِيهِ ،  سَمِعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلًا  يَعِظُ أَخَاهُ فِي  الْحَيَاءِ ،  فَقَالَ :  الْحَيَاءُ  مِنَ الْإِيمَانِ  .         [9/303]","","Musnad Abi Ya'la al-Mawsili 5424","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5428","11 - (  5425  ) -  وَعَنِ  الزُّهْرِيِّ ،  سَمِعَ  سَالِمًا  يُحَدِّثُ ،         [9/304]      عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ : مَا يَلْبَسُ الْمُحْرِمُ مِنَ الثِّيَابِ ؟  قَالَ : لَا يَلْبَسُ الْقَمِيصَ ، وَلَا الْعِمَامَةَ ، وَلَا  الْبُرْنُسَ  ، وَلَا السَّرَاوِيلَ ، وَلَا ثَوْبًا مَسَّهُ زَعْفَرَانٌ ، وَلَا وَرْسٌ ، وَلَا خُفَّيْنِ إِلَّا لِمَنْ لَمْ يَجِدْ نَعْلَيْنِ ، فَمَنْ لَمْ يَجِدْ نَعْلَيْنِ فَلْيَقْطَعْهُمَا أَسْفَلَ مِنَ  الْكَعْبَيْنِ  .         [9/305]             [9/306]","","Musnad Abi Ya'la al-Mawsili 5425","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5429","12 - (  5426  ) -  وَعَنِ  الزُّهْرِيِّ ،  سَمِعَ  سَالِمًا  يُحَدِّثُ ، عَنْ  أَبِيهِ ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا اسْتَأْذَنَتْ أَحَدَكُمُ امْرَأَتُهُ إِلَى الْمَسْجِدِ ، فَلَا يَمْنَعْهَا         [9/307]      قَالَ  سُفْيَانُ  : يَرَوْنَ أَنَّهُ بِاللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 5426","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5430","13 - (  5427  ) -  وَعَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  سَالِمٌ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ بَاعَ عَبْدًا لَهُ         [9/308]      مَالٌ ، فَمَالُهُ لِلْبَائِعِ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  ، وَمَنْ بَاعَ نَخْلًا بَعْدَ أَنْ  تُؤَبَّرَ  فَثَمَرَتُهَا  لِلْبَائِعِ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .         [9/309]             [9/310]             [9/311]","","Musnad Abi Ya'la al-Mawsili 5427","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5431","14 - (  5428  ) -  وَعَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  خَمْسٌ لَا جُنَاحَ عَلَى مَنْ قَتَلَهُنَّ فِي  الْحَرَمِ  وَالْإِحْرَامِ  :  الْفَأْرَةُ  ، وَالْغُرَابُ ،  وَالْحِدَأَةُ  ، وَالْعَقْرَبُ ، وَالْكَلْبُ  الْعَقُورُ  .         [9/312]","","Musnad Abi Ya'la al-Mawsili 5428","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5432","15 - (  5429  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ، قَالَ :  سَمِعْنَا  الزُّهْرِيَّ ،  عَنْ  سَالِمٍ ،         [9/313]      عَنْ  أَبِيهِ  ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  اقْتُلُوا الْحَيَّاتِ ، وَذَا  الطُّفْيَتَيْنِ ،  وَالْأَبْتَرَ  ، فَإِنَّهُمَا يَطْمِسَانِ الْبَصَرَ ، وَيَسْتَسْقِطَانِ الْحَبَلَ ، قَالَ :  وَكَانَ  عَبْدُ اللهِ  يَقْتُلُ كُلَّ حَيَّةٍ وَجَدَهَا  .         [9/314]","","Musnad Abi Ya'la al-Mawsili 5429","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5433","16 - (  5430  ) -  وَعَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ اللهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ  ، قَالَ  عُمَرُ  : فَوَاللهِ مَا حَلَفْتُ بِهَا  آثِرًا  وَلَا  ذَاكِرًا  .         [9/315]             [9/316]             [9/317]","","Musnad Abi Ya'la al-Mawsili 5430","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5434","17 - (  5431  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خِفْتَ الصُّبْحَ  فَأَوْتِرْ  بِوَاحِدَةٍ  .","","Musnad Abi Ya'la al-Mawsili 5431","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5435","18 - (  5432  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  بِلَالٌ  يُؤَذِّنُ بِلَيْلٍ ، فَكُلُوا وَاشْرَبُوا حَتَّى يُؤَذِّنَ  ابْنُ أُمِّ مَكْتُومٍ  .         [9/318]             [9/319]","","Musnad Abi Ya'la al-Mawsili 5432","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5436","19 - (  5433  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قِيلَ لَهُ :  تَبْلُغُ بِهِ  ؟ قَالَ : نَعَمْ ، قَالَ :  الشُّؤْمُ فِي ثَلَاثٍ  : فِي الْفَرَسِ ، وَالْمَرْأَةِ ، وَالدَّارِ  .         [9/320]             [9/321]","","Musnad Abi Ya'la al-Mawsili 5433","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5437","20 - (  5434  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَتْرُكُوا النَّارَ فِي بُيُوتِكُمْ حِينَ تَنَامُونَ  .         [9/322]","","Musnad Abi Ya'la al-Mawsili 5434","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5438","21 - (  5435  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  عَمْرٌو ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي بَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ  .         [9/323]","","Musnad Abi Ya'la al-Mawsili 5435","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5439","22 - (  5436  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،         [9/324]      عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  تَجِدُونَ النَّاسَ  كَالْإِبِلِ  الْمِائَةِ لَيْسَ فِيهَا  رَاحِلَةٌ  .         [9/325]","","Musnad Abi Ya'la al-Mawsili 5436","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5440","23 - (  5437  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  غَيْلَانَ بْنَ سَلَمَةَ الثَّقَفِيَّ  أَسْلَمَ وَتَحْتَهُ عَشْرُ نِسْوَةٍ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اخْتَرْ مِنْهُنَّ أَرْبَعًا  ، فَلَمَّا كَانَ فِي عَهْدِ  عُمَرَ  طَلَّقَ نِسَاءَهُ ، وَقَسَمَ مَالَهُ بَيْنَ بَنِيهِ ، فَبَلَغَ ذَلِكَ  عُمَرَ  فَلَقِيَهُ ، فَقَالَ : إِنِّي أَظُنُّ الشَّيْطَانَ فِيمَا  يَسْتَرِقُ  مِنَ السَّمْعِ سَمِعَ بِمَوْتِكَ ، فَقَذَفَهُ فِي نَفْسِكَ ، وَلَعَلَّكَ أَنْ لَا تَمْكُثَ إِلَّا قَلِيلًا ، وَايْمُ اللهِ لَتُرْجِعَنَّ نِسَاءَكَ وَلَتَرْجِعَنَّ فِي مَالِكَ ، أَوْ لَأُوَرِّثُهُنَّ ، وَلَآمُرَنَّ بِقَبْرِكَ فَيُرْجَمُ كَمَا رُجِمَ قَبْرُ  أَبِي رِغَالٍ  .         [9/326]","","Musnad Abi Ya'la al-Mawsili 5437","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5441","24 - (  5438  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمِنًى  رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5438","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5442","25 - (  5439  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ         [9/327]      أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَمَعَ بَيْنَهُمَا  بِالْمُزْدَلِفَةِ  ، وَصَلَّى كُلُّ وَاحِدٍ مِنْهُمَا بِإِقَامَةٍ  ، وَلَمْ يَتَطَوَّعْ قَبْلَ وَاحِدَةٍ مِنْهُمَا وَلَا بَعْدَهَا  .         [9/328]             [9/329]","","Musnad Abi Ya'la al-Mawsili 5439","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5443","26 - (  5440  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ  ،  أَنَّهُ طَلَّقَ امْرَأَتَهُ فِي الْحَيْضِ ، فَسَأَلَ  عُمَرُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ، فَقَالَ : مُرْهُ فَلْيُرَاجِعْهَا ، ثُمَّ لِيُطَلِّقْهَا وَهِيَ طَاهِرٌ ، أَوْ حَامِلٌ  .         [9/330]             [9/331]","","Musnad Abi Ya'la al-Mawsili 5440","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن عبد الرحمن بن المغيرة عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5444","27 - (  5441  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  حَنْظَلَةُ ،  عَنْ  سَالِمٍ ،         [9/332]      عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اقْتَنَى كَلْبًا إِلَّا كَلْبًا  ضَارِيًا - أَوْ مَاشِيَةٍ  - نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ  ، قَالَ : وَقَالَ  سَالِمٌ  :  قَالَ  أَبُو هُرَيْرَةَ : أَوْ كَلْبَ حَرْثٍ ، قَالَ : وَكَانَ صَاحِبَ حَرْثٍ  .","","Musnad Abi Ya'la al-Mawsili 5441","","أبو هريرة الدوسي عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5445","28 - (  5442  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كَانَتْ يَمِينُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا وَمُقَلِّبِ الْقُلُوبِ  .         [9/333]","","Musnad Abi Ya'la al-Mawsili 5442","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5446","29 - (  5443  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  حَنْظَلَةُ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا اسْتَأْذَنَكُمْ نِسَاؤُكُمْ إِلَى الْمَسَاجِدِ فَأْذَنُوا لَهُنَّ  .","","Musnad Abi Ya'la al-Mawsili 5443","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5447","30 - (  5444  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  أَبِي بَكْرِ بْنِ سَالِمٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الَّذِي يَكْذِبُ عَلَيَّ يُبْنَى لَهُ بَيْتٌ فِي النَّارِ  .         [9/334]","","Musnad Abi Ya'la al-Mawsili 5444","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن محمد بن عبيد بن أبي أمية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5448","31 - (  5445  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيَأْمُرُنَا بِالتَّخْفِيفِ  ، وَإِنْ كَانَ لَيَؤُمُّنَا بِالصَّافَّاتِ فِي صَلَاةِ الْفَجْرِ  .","","Musnad Abi Ya'la al-Mawsili 5445","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5449","32 - (  5446  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  نَافِعُ بْنُ عُمَرَ الْجُمَحِيُّ ،  عَنْ  أَبِي بَكْرِ بْنِ مُوسَى ، قَالَ :         [9/335]      كُنْتُ مَعَ  سَالِمِ بْنِ عَبْدِ اللهِ  فِي سَفَرٍ ، فَمَرَّتْ رُفْقَةٌ  لِأُمِّ الْبَنِينَ  فِيهَا أَجْرَاسٌ  ،  فَحَدَّثَ  سَالِمٌ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : لَا تَصْحَبُ الْمَلَائِكَةُ رُفْقَةً فِيهَا  جُلْجُلٌ ،  فَكَمْ فِي هَذِهِ مِنْ  جُلْجُلٍ  ؟ ! .","","Musnad Abi Ya'la al-Mawsili 5446","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن أبي شيخ السهمي عن نافع بن عمر بن عبد الله بن جميل الجمحي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5450","33 - (  5447  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْعُمَرِيُّ ، قَالَ :  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ فَاتَتْهُ صَلَاةُ         [9/336]      الْعَصْرِ فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .         [9/337]","","Musnad Abi Ya'la al-Mawsili 5447","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5451","34 - (  5448  ) -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْعُمَرِيُّ ، قَالَ :  حَدَّثَنِي  إِبْرَاهِيمُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَيْتُمُ الْهِلَالَ فَصُومُوا ، وَإِذَا رَأَيْتُمُوهُ فَأَفْطِرُوا  ، فَإِنْ  غُمَّ  عَلَيْكُمْ  فَاقْدُرُوا  لَهُ  ،         [9/338]      قَالَ : قَالَ سَالِمٌ :  كَانَ عَبْدُ اللهِ يَصُومُ قَبْلَ الْهِلَالِ بِيَوْمٍ إِذَا  غُمَّ  عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 5448","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد العزيز بن أبي سلمة الماجشون عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5452","35 - (  5449  ) -  حَدَّثَنَا  أَبُو عَامِرٍ حَوْثَرَةُ بْنُ أَشْرَسَ ،  حَدَّثَنَا  عُقْبَةُ بْنُ أَبِي الصَّهْبَاءِ أَبُو خُرَيْمٍ الْبَاهِلِيُّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الصُّبْحَ ، ثُمَّ اسْتَقْبَلَ         [9/339]      مَطْلِعَ الشَّمْسِ  ، فَقَالَ : أَلَا إِنَّ الْفِتَنَ مِنْ هَاهُنَا ، ثَلَاثَ مَرَّاتٍ ، وَمِنْ ثَمَّ يَطْلُعُ قَرْنُ الشَّيْطَانِ  .         [9/340]","","Musnad Abi Ya'la al-Mawsili 5449","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عقبة بن أبي الصهباء البصري عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5453","36 - (  5450  ) -  حَدَّثَنَا  أَبُو عَامِرٍ ،  أَخْبَرَنِي  عُقْبَةُ - يَعْنِي ابْنَ أَبِي الصَّهْبَاءِ - ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ فِي نَفَرٍ مِنْ أَصْحَابِهِ ، فَأَقْبَلَ عَلَيْهِمْ رَسُولُ اللهِ ، فَقَالَ : أَلَسْتُمْ تَعْلَمُونَ أَنِّي رَسُولُ اللهِ إِلَيْكُمْ ؟  قَالُوا : بَلَى ، نَشْهَدُ أَنَّكَ رَسُولُ اللهِ ، قَالَ : أَلَسْتُمْ تَعْلَمُونَ أَنَّهُ مَنْ أَطَاعَنِي فَقَدْ أَطَاعَ اللهَ ، وَمِنْ طَاعَةِ اللهِ طَاعَتِي ؟ قَالُوا : بَلَى ، نَشْهَدُ أَنَّهُ مَنْ أَطَاعَكَ فَقَدْ أَطَاعَ اللهَ ، وَمِنْ طَاعَةِ اللهِ طَاعَتُكَ ، قَالَ : فَإِنَّ مِنْ طَاعَةِ اللهِ أَنْ تُطِيعُونِي ، وَمِنْ طَاعَتِي أَنْ تُطِيعُوا أُمَرَاءَكُمْ ، أَطِيعُوا أُمَرَاءَكُمْ ، وَإِنْ صَلَّوْا قُعُودًا فَصَلُّوا قُعُودًا  .         [9/341]","","Musnad Abi Ya'la al-Mawsili 5450","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عقبة بن أبي الصهباء البصري عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5454","37 - (  5451  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  جَلَسَ رَجُلٌ مِنْ أَهْلِ  الشَّامِ  إِلَى عَبْدِ اللهِ بْنِ عُمَرَ وَأَنَا مَعَهُ ، فَقَالَ لَهُ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، مَا تَرَى فِي التَّمَتُّعِ بِالْعُمْرَةِ إِلَى  الْحَجِّ  ؟         [9/342]      فَقَالَ لَهُ  عَبْدُ اللهِ  : حَسَنٌ جَمِيلٌ لِمَنْ صَنَعَ ذَلِكَ ، فَقَالَ لَهُ الرَّجُلُ : فَإِنَّ أَبَاكَ قَدْ كَانَ يَنْهَى عَنْهَا فَغَضِبَ  عَبْدُ اللهِ  ، ثُمَّ قَالَ : وَيْلَكَ  أَرَأَيْتَ إِنْ كَانَ أَبِي نَهَى عَنْهَا ، وَكَانَ رَسُولُ اللهِ عَمِلَ بِهَا ، أَمْرَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَأْخُذُ أَمْ بِأَمْرِ أَبِي ؟ قَالَ : لَا ، بَلْ بِأَمْرِ رَسُولِ اللهِ  ، قَالَ : فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ فَعَلَ ذَلِكَ ، فَقُمْ لِشَأْنِكَ  .","","Musnad Abi Ya'la al-Mawsili 5451","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5455","38 - (  5452  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا رَأَيْتُمُ الْهِلَالَ فَصُومُوا ، وَإِذَا رَأَيْتُمُوهُ فَأَفْطِرُوا  ، فَإِنْ  غُمَّ  عَلَيْكُمْ  فَاقْدُرُوا  ،  وَكَانَ عَبْدُ اللهِ يَصُومُ قَبْلَ الْهِلَالِ بِيَوْمٍ  .         [9/343]","","Musnad Abi Ya'la al-Mawsili 5452","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5456","39 - (  5453  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَنْ فَاتَتْهُ صَلَاةُ الْعَصْرِ ، فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 5453","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5457","40 - (  5454  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  أَلَا إِنَّمَا بَقَاؤُكُمْ فِيمَا سَلَفَ قَبْلَكُمْ مِنَ الْأُمَمِ كَمَا بَيْنَ صَلَاةِ الْعَصْرِ إِلَى غُرُوبِ الشَّمْسِ  : أُوتِيَ أَهْلُ التَّوْرَاةِ التَّوْرَاةَ فَعَمِلُوا حَتَّى انْتَصَفَ النَّهَارُ ثُمَّ عَجَزُوا ، فَأُعْطُوا قِيرَاطًا ، ثُمَّ أُوتِيَ أَهْلُ الْإِنْجِيلِ الْإِنْجِيلَ فَعَمِلُوا إِلَى صَلَاةِ الْعَصْرِ ، ثُمَّ عَجَزُوا فَأُعْطُوا قِيرَاطًا ، ثُمَّ أُوتِينَا الْقُرْآنَ ، فَعَمِلْنَا إِلَى غُرُوبِ الشَّمْسِ ، فَأُعْطِينَا قِيرَاطَيْنِ قِيرَاطَيْنِ ، فَقَالَ أَهْلُ الْكِتَابَيْنِ : أَيْ رَبَّنَا ، لِمَ أَعْطَيْتَ هَؤُلَاءِ قِيرَاطَيْنِ قِيرَاطَيْنِ ، وَأَعْطَيْتَنَا قِيرَاطًا قِيرَاطًا ، وَنَحْنُ كُنَّا أَكْثَرَ عَمَلٍ مِنْهُمْ ؟ قَالَ اللهُ : هَلْ ظَلَمْتُكُمْ مِنْ أَجْرِكُمْ شَيْئًا ؟ قَالُوا : لَا ، قَالَ : فَهُوَ فَضْلِي أُوتِيهِ مَنْ أَشَاءُ  .         [9/344]","","Musnad Abi Ya'la al-Mawsili 5454","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5458","41 - (  5455  ) -  وَعَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  عَبْدِ اللهِ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَبَايَعُوا  الثَّمَرَ  بِالتَّمْرِ ، وَلَا تَبَايَعُوا  الثَّمَرَ  حَتَّى يَبْدُوَ صَلَاحُهُ  ، قَالَ :  وَمَا اتَّخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَاضِيًا ، وَلَا  أَبُو بَكْرٍ  ، وَلَا         [9/345]      عُمَرُ  ، حَتَّى كَانَ فِي آخِرِ زَمَانِهِ ، فَقَالَ  لِيَزِيدَ ابْنِ أُخْتِ نَمِرٍ  : اكْفِنِي بَعْضَ الْأُمُورِ ، يَعْنِي : صِغَارَهَا  .","","Musnad Abi Ya'la al-Mawsili 5455","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5459","42 - (  5456  ) -  وَعَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّهُ قَالَ :  مَفَاتِيحُ الْغَيْبِ خَمْسٌ  :         {      إِنَّ اللهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَـزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللهَ عَلِيمٌ خَبِيرٌ         }      .         [9/346]","","Musnad Abi Ya'la al-Mawsili 5456","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5460","43 - (  5457  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّمَا النَّاسُ  كَالْإِبِلِ  الْمِائَةِ لَا تَكَادُ تَجِدُ فِيهَا  رَاحِلَةً  .","","Musnad Abi Ya'la al-Mawsili 5457","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5461","44 - (  5458  ) -  وَعَنْ  سَالِمٍ ،  سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ  ، يَقُولُ :  مَا قَالَ رَسُولُ اللهِ  لِعِيسَى  أَحْمَرَ ، وَلَكِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  بَيْنَمَا أَنَا نَائِمٌ أَرَانِي أَطُوفُ  بِالْكَعْبَةِ  ، فَإِذَا رَجُلٌ آدَمُ سَبْطُ الشَّعَرِ  ، بَيْنَ الرَّجُلَيْنِ  يَنْطِفُ  رَأْسُهُ مَاءً - أَوْ يُهَرَاقُ رَأْسُهُ  - ، فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا : هَذَا  ابْنُ مَرْيَمَ  ، فَذَهَبْتُ أَلْتَفِتُ ، فَإِذَا رَجُلٌ أَحْمَرُ جَسِيمٌ ،  جَعْدُ  الرَّأْسِ ،  أَعْوَرُ  الْعَيْنِ الْيُمْنَى ، كَأَنَّ عَيْنَهُ عِنَبَةٌ  طَافِيَةٌ ،  فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا :  الدَّجَّالُ ،  أَقْرَبُ النَّاسِ بِهِ شَبَهًا رَجُلٌ مِنْ  خُزَاعَةَ  يُقَالُ لَهُ :  ابْنُ قَطَنٍ  ،         [9/347]      قَالَ  مُحَمَّدٌ  : وَهُوَ مِنْ  بَنِي الْمُصْطَلِقِ  ، هَلَكَ فِي الْجَاهِلِيَّةِ .","","Musnad Abi Ya'la al-Mawsili 5458","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5462","45 - (  5459  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُوتِرُ عَلَى رَاحِلَتِهِ  .         [9/348]             [9/349]             [9/350]","","Musnad Abi Ya'la al-Mawsili 5459","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن عبد الله بن عمر العمري عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5463","46 - (  5460  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنِي  مُوسَى بْنُ عُقْبَةَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ وَهُوَ  بِالْمُعَرَّسِ  مِنْ  ذِي الْحُلَيْفَةِ  فِي بَطْنِ الْوَادِي  ، فَقِيلَ لَهُ : إِنَّكَ بِبَطْحَاءَ مُبَارَكَةٍ  .         [9/351]","","Musnad Abi Ya'la al-Mawsili 5460","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5464","47 - (  5461  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  وَسَالِمٍ  ،  أَنَّ  ابْنَ عُمَرَ ،  كَانَ إِذَا مَرَّ  بِذِي الْحُلَيْفَةِ  ، بَاتَ بِهَا حَتَّى يُصْبِحَ ، وَيُخْبِرُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَفْعَلُ ذَلِكَ  .         [9/352]","","Musnad Abi Ya'la al-Mawsili 5461","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5465","48 - (  5462  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  مُوسَى بْنُ عُقْبَةَ ، قَالَ :  حَدَّثَنِي  سَالِمٌ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ كَانَ يُحَدِّثُ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ أَمَّرَ  أُسَامَةَ بْنَ زَيْدٍ  ، فَبَلَغَهُ أَنَّ النَّاسَ عَابُوا عَلَى  أُسَامَةَ  وَطَعَنُوا فِي إِمَارَتِهِ ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَمَا حَدَّثَنِي  سَالِمٌ  ، فَقَالَ :  أَلَا إِنَّكُمْ تَعِيبُونَ  أُسَامَةَ  ، وَتَطْعَنُونَ فِي إِمَارَتِهِ ، وَقَدْ فَعَلْتُمْ ذَلِكَ بِأَبِيهِ مِنْ قَبْلُ  ، وَإِنْ كَانَ لَخَلِيقًا لِلْإِمَارَةِ ، وَإِنَّهُ لَأَحَبُّ النَّاسِ إِلَيَّ كُلِّهِمْ ، وَإِنَّ ابْنَهُ هَذَا لَأَحَبُّ النَّاسِ إِلَيَّ ، فَاسْتَوْصُوا بِهِ خَيْرًا ، فَإِنَّهُ مِنْ خِيَارِكُمْ  ، قَالَ سَالِمٌ :  مَا سَمِعْتُ  عَبْدَ اللهِ  يُحَدِّثُ بِهَذَا الْحَدِيثِ قَطُّ إِلَّا قَالَ : حَاشَا  فَاطِمَةَ  .         [9/353]","","Musnad Abi Ya'la al-Mawsili 5462","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5466","49 - (  5463  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  حَبَّانُ بْنُ هِلَالٍ ،  حَدَّثَنَا  شُعْبَةُ ،  قَالَ  عَاصِمُ بْنُ عُبَيْدِ اللهِ :  أَخْبَرَنِي  ، قَالَ :  سَمِعْتُ  سَالِمًا  يُحَدِّثُ  ،         [9/354]      عَنِ  ابْنِ عُمَرَ ،  أَنَّ  عُمَرَ  ، قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ مَا نَعْمَلُ فِيهِ ؟ فِي أَمْرٍ قَدْ فُرِغَ مِنْهُ أَوْ فِي أَمْرٍ  مُبْتَدَأٍ أَوْ مُبْتَدَعٍ  ؟ قَالَ : فِيمَا قَدْ فُرِغَ -  شَكَّ  شُعْبَةُ  - مِنْهُ  اعْمَلْ يَا  ابْنَ الْخَطَّابِ  فَكُلٌّ  مُيَسَّرٌ  ، أَمَّا مَنْ كَانَ مِنْ أَهْلِ السَّعَادَةِ ، فَإِنَّهُ يَعْمَلُ لِلسَّعَادَةِ ، وَمَنْ كَانَ مِنْ أَهْلِ الشَّقَاءِ ، فَإِنَّهُ يَعْمَلُ لِلشَّقَاءِ  .","","Musnad Abi Ya'la al-Mawsili 5463","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شعبة بن الحجاج عن حبان بن هلال الباهلي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5467","50 - (  5464  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ أَخِي ابْنِ شِهَابٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  ،  وَعُثْمَانَ  كَانُوا يَمْشُونَ أَمَامَ الْجِنَازَةِ  .         [9/355]","","Musnad Abi Ya'la al-Mawsili 5464","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5468","51 - (  5465  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  وَسَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ أَكْلِ لَحْمِ الْحُمُرِ  الْأَهْلِيَّةِ  .         [9/356]","","Musnad Abi Ya'la al-Mawsili 5465","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5469","52 - (  5466  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ أَبُو عَبْدِ اللهِ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .         [9/357]             [9/358]","","Musnad Abi Ya'la al-Mawsili 5466","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5470","53 - (  5467  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ الْمَدَنِيُّ ،  عَنْ  عَاصِمٍ ،  عَنْ  بِلَالِ بْنِ أَبِي بَكْرٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ مُسْكِرٍ خَمْرٌ ، وَكُلُّ مُسْكِرٍ حَرَامٌ  ، قَلِيلُهُ وَكَثِيرُهُ سَوَاءٌ  .         [9/359]","","Musnad Abi Ya'la al-Mawsili 5467","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن بلال بن أبى بكر عن عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن عبد الله بن نافع الصائغ عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5471","54 - (  5468  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  حَدَّثَنَا  أَنَسٌ - يَعْنِي : ابْنَ عِيَاضٍ - ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّهُ قَالَ :  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَنْ بَاعَ عَبْدًا فَمَالُهُ لِلَّذِي بَاعَهُ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  ، وَمَنْ بَاعَ نَخْلًا قَدْ  أُبِّرَتْ  فَثَمَرَتُهَا  لِلَّذِي بَاعَهَا ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .","","Musnad Abi Ya'la al-Mawsili 5468","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن أنس بن عياض الليثي عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5472","55 - (  5469  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ، قَالَ :  حَدَّثَنِي  مُحَمَّدٌ - يَعْنِي : ابْنَ فُلَيْحٍ - ، قَالَ :  قَالَ  مُوسَى بْنُ عُقْبَةَ ،  وَقَالَ  ابْنُ شِهَابٍ :  أَخْبَرَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  بَيْنَا أَنَا نَائِمٌ رَأَيْتُنِي أَطُوفُ  بِالْكَعْبَةِ  ، فَإِذَا رَجُلٌ سَبْطُ الشَّعَرِ بَيْنَ الرَّجُلَيْنِ  ،  يَنْطِفُ  - أَوْ يُهَرَاقُ  - رَأْسُهُ مَاءً ، فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا :  ابْنُ مَرْيَمَ  ، فَذَهَبْتُ أَلْتَفِتُ فَإِذَا رَجُلٌ أَحْمَرُ جَسِيمٌ ،  جَعْدُ  الرَّأْسِ ،  أَعْوَرُ  ، كَأَنَّ عَيْنَهُ عِنَبَةٌ  طَافِيَةٌ ،  فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا :  الدَّجَّالُ  ، أَقْرَبُ النَّاسِ بِهِ شَبَهًا  ابْنُ قَطَنٍ  .","","Musnad Abi Ya'la al-Mawsili 5469","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن موسى بن عقبة عن محمد بن فليح بن سليمان الأسلمي عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5473","56 - (  5470  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى الْخُتَّلِيُّ ،  حَدَّثَنَا         [9/360]      عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَتَبَ كِتَابَ الصَّدَقَةِ فَقَرَنَهُ بِسَيْفِهِ ، فَلَمْ يُخْرِجْهُ إِلَى عُمَّالِهِ حَتَّى قُبِضَ  ، فَعَمِلَ بِهِ  أَبُو بَكْرٍ  حَتَّى قُبِضَ ، ثُمَّ عَمِلَ بِهِ  عُمَرُ  ، فَكَانَ فِيهِ : فِي خَمْسٍ مِنَ الْإِبِلِ : شَاةٌ ، وَفِي عَشْرٍ : شَاتَانِ ، وَفِي خَمْسَ عَشْرَةَ : ثَلَاثُ  شِيَاهٍ  ، وَفِي عِشْرِينَ : أَرْبَعُ  شِيَاهٍ  ، وَفِي خَمْسٍ وَعِشْرِينَ : ابْنَةُ  مَخَاضٍ  إِلَى خَمْسٍ وَثَلَاثِينَ ، فَإِنْ زَادَتْ فَفِيهَا ابْنَةُ  لَبُونٍ  إِلَى خَمْسٍ وَأَرْبَعِينَ ، فَإِنْ زَادَتْ فَفِيهَا حِقَّةٌ إِلَى سِتِّينَ ، فَإِنْ زَادَتْ فَفِيهَا  جَذَعَةٌ  إِلَى خَمْسٍ وَسَبْعِينَ ، فَإِنْ زَادَتْ فَفِيهَا ابْنَتَا  لَبُونٍ  إِلَى تِسْعِينَ ، فَإِنْ زَادَتْ فَحِقَّتَانِ إِلَى عِشْرِينَ وَمِائَةٍ ، فَإِنْ زَادَتْ عَلَى عِشْرِينَ وَمِائَةٍ فَفِي كُلِّ خَمْسِينَ : حِقَّةٌ ، وَفِي كُلِّ أَرْبَعِينَ : بِنْتُ  لَبُونٍ  .  وَفِي صَدَقَةِ الْغَنَمِ : فِي كُلِّ أَرْبَعِينَ شَاةً : شَاةٌ إِلَى عِشْرِينَ وَمِائَةٍ ، فَإِنْ زَادَتْ فَشَاتَانِ إِلَى مِائَتَيْنِ ، فَإِنْ زَادَتْ فَثَلَاثُ  شِيَاهٍ  إِلَى         [9/361]      ثَلَاثِمِائَةٍ ، فَإِنْ زَادَتْ فَفِي كُلِّ مِائَةِ شَاةٍ : شَاةٌ ، وَلَيْسَ فِيهَا شَيْءٌ حَتَّى تَبْلُغَ مِائَةً ، وَلَا  يُفَرَّقُ  بَيْنَ مُجْتَمِعٍ ، وَلَا يُجْمَعُ بَيْنَ  مُتَفَرِّقٍ  مَخَافَةَ الصَّدَقَةِ ، وَمَا كَانَ مِنْ  خَلِيطَيْنِ  فَإِنَّهُمَا  يَتَرَاجَعَانِ  بِالسَّوِيَّةِ ، وَلَا تُؤْخَذُ فِي  الصَّدَقَةِ  هَرِمَةٌ وَلَا ذَاتُ  عَوَارٍ  .  قَالَ  سُفْيَانُ  : وَلَمْ يَذْكُرِ  الزُّهْرِيُّ  الْبَقَرَ .  قَالَ  الزُّهْرِيُّ  :  إِذَا جَاءَ الْمُصَدِّقُ قَسَمَ الْمَالَ أَثْلَاثًا : ثُلُثًا خِيَارًا ، وَثُلُثًا شِرَارًا ، وَثُلُثًا أَوْسَاطًا ، يَأْخُذُ مِنَ الْوَسَطِ  .         [9/362]","","Musnad Abi Ya'la al-Mawsili 5470","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5474","57 - (  5471  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  بِإِسْنَادِهِ  نَحْوَهُ ..","","Musnad Abi Ya'la al-Mawsili 5471","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5475","58 - (  5472  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو نُعَيْمٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كَانَتْ يَمِينُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِي يَحْلِفُ عَلَيْهَا : لَا وَمُقَلِّبِ الْقُلُوبِ  .","","Musnad Abi Ya'la al-Mawsili 5472","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن سفيان الثوري عن الفضل بن دكين عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5476","59 - (  5473  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  لَيْثٌ ،  حَدَّثَنِي  ابْنُ شِهَابٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،         [9/363]      عَنْ  أَبِيهِ  ، قَالَ :  لَمْ أَرَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمْسَحُ إِلَّا  الرُّكْنَيْنِ الْيَمَانِيَيْنِ  .         [9/364]","","Musnad Abi Ya'la al-Mawsili 5473","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن الليث بن سعد عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5477","60 - (  5474  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  وَسَالِمٍ  ،  أَنَّ  ابْنَ عُمَرَ  كَانَ إِذَا مَرَّ  بِذِي الْحُلَيْفَةِ  بَاتَ بِهَا حَتَّى أَصْبَحَ ، وَيُخْبِرُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَفْعَلُ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5474","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5478","61 - (  5475  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  يُهِلُّ أَهْلُ  الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ، وَأَهْلُ  الشَّامِ  مِنَ  الْجُحْفَةِ  ، وَأَهْلُ  نَجْدٍ  مِنْ  قَرَنٍ  ، قَالَ : وَذُكِرَ لِي ، وَلَمْ أَسْمَعْهُ ، قَالَ : وَيُهِلُّ أَهْلُ  الْيَمَنِ  مِنْ  يَلَمْلَمَ  .         [9/365]","","Musnad Abi Ya'la al-Mawsili 5475","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5479","62 - (  5476  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ بَيْعِ  الثَّمَرِ  بِالتَّمْرِ  .","","Musnad Abi Ya'la al-Mawsili 5476","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5480","63 - (  5477  ) -  قَالَ :  فَأَخْبَرَهُ  زَيْدُ بْنُ ثَابِتٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي الْعَرَايَا  .","","Musnad Abi Ya'la al-Mawsili 5477","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5481","64 - (  5478  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ مَالًا ، فَهُوَ يُنْفِقُ مِنْهُ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ ، وَرَجُلٍ آتَاهُ اللهُ الْقُرْآنَ ، فَهُوَ يَقُومُ بِهِ آنَاءَ اللَّيْلِ وَالنَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 5478","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5482","65 - (  5479  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنِ اشْتَرَى نَخْلًا بَعْدَ أَنْ  تُؤَبَّرَ  فَثَمَرَتُهَا  لِلْبَائِعِ  ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ ، وَمَنْ بَاعَ عَبْدًا وَلَهُ مَالٌ فَمَالُهُ لِلْبَائِعِ ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .         [9/366]","","Musnad Abi Ya'la al-Mawsili 5479","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5483","66 - (  5480  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  أَنَّهُ قَالَ عَلَى الْمِنْبَرِ :  مَنْ جَاءَ مِنْكُمُ الْجُمُعَةَ فَلْيَغْتَسِلْ  .         [9/367]","","Musnad Abi Ya'la al-Mawsili 5480","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5484","67 - (  5481  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَرْفَعُ يَدَيْهِ إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ إِلَى الْمَنْكِبَيْنِ  ، وَإِذَا رَكَعَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ         [9/368]      الرُّكُوعِ ، وَلَا يَرْفَعُ بَيْنَ السَّجْدَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5481","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5485","68 - (  5482  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  يَمْشُونَ أَمَامَ الْجِنَازَةِ  .","","Musnad Abi Ya'la al-Mawsili 5482","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5486","69 - (  5483  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  سَمِعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عُمَرَ  وَهُوَ يَحْلِفُ بِأَبِيهِ ، فَقَالَ :  أَلَا إِنَّ اللهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ  ، فَقَالَ  عُمَرُ  : فَوَاللهِ مَا حَلَفْتُ بِهَا بَعْدُ  ذَاكِرًا  وَلَا  آثِرًا  .","","Musnad Abi Ya'la al-Mawsili 5483","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5487","70 - (  5484  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  أَرَى رُؤْيَاكُمْ قَدْ تَوَاطَأَتْ فِي الْعَشْرِ الْأَوَاخِرِ  ، فَاطْلُبُوهَا فِي  السَّبْعِ الْبَوَاقِي أَوْ فِي  الْوِتْرِ  مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 5484","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5488","71 - (  5485  ) -  وَعَنْ  سَالِمٍ ،         [9/369]      عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَجْمَعُ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ إِذَا  جَدَّ  بِهِ السَّيْرُ  .","","Musnad Abi Ya'la al-Mawsili 5485","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5489","72 - (  5486  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَتْرُكُوا النَّارَ فِي بُيُوتِكُمْ حِينَ تَنَامُونَ  .","","Musnad Abi Ya'la al-Mawsili 5486","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5490","73 - (  5487  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ  رَجُلًا  يَعِظُ أَخَاهُ فِي  الْحَيَاءِ ،  فَقَالَ لَهُ :  الْحَيَاءُ  مِنَ الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 5487","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5491","74 - (  5488  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  سُئِلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا يَلْبَسُ الْمُحْرِمُ مِنَ الثِّيَابِ ؟ فَقَالَ : لَا تَلْبَسُوا الْقَمِيصَ ،  وَلَا السَّرَاوِيلَاتِ ، وَلَا الْعَمَائِمَ ، وَلَا الْبَرَانِسَ ، وَلَا ثَوْبًا مَسَّهُ وَرْسٌ وَلَا زَعْفَرَانٌ ، وَلَا تَلْبَسُوا الْخُفَّيْنِ ، إِلَّا رَجُلٌ لَيْسَتْ لَهُ نَعْلَانِ فَلْيَقْطَعْهُمَا أَسْفَلَ مِنَ  الْكَعْبَيْنِ  .         [9/370]","","Musnad Abi Ya'la al-Mawsili 5488","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5492","75 - (  5489  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ بَيْعِ  الثَّمَرِ  حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Musnad Abi Ya'la al-Mawsili 5489","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5493","76 - (  5490  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الشُّؤْمُ فِي ثَلَاثٍ  : فِي الدَّارِ ، وَالدَّابَّةِ ، وَالْمَرْأَةِ  .","","Musnad Abi Ya'la al-Mawsili 5490","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5494","77 - (  5491  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا اسْتَأْذَنَتْ أَحَدَكُمُ امْرَأَتُهُ إِلَى الْمَسْجِدِ فَلَا يَمْنَعْهَا  ، قَالَ  عَمْرٌو  : قَالَ  سُفْيَانُ  : قَالَ رَجُلٌ : عَنْ  نَافِعٍ  ، فَسَّرَهُ أَنَّهُ بِاللَّيْلِ .","","Musnad Abi Ya'la al-Mawsili 5491","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5495","78 - (  5492  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  بِلَالًا  يُؤَذِّنُ بِلَيْلٍ  ،         [9/371]      فَكُلُوا وَاشْرَبُوا ، حَتَّى تَسْمَعُوا أَذَانَ  ابْنِ أُمِّ مَكْتُومٍ  .","","Musnad Abi Ya'la al-Mawsili 5492","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5496","79 - (  5493  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  اقْتُلُوا الْحَيَّاتِ ، وَذَا  الطُّفْيَتَيْنِ ،  وَالْأَبْتَرَ  ، فَإِنَّهُمَا  يَلْتَمِسَانِ  الْبَصَرَ ، وَيَسْتَسْقِطَانِ الْحَبَلَ ،  وَكَانَ  ابْنُ عُمَرَ  يَقْتُلُ كُلَّ حَيَّةٍ وَجَدَهَا  ، فَأَبْصَرَهُ  أَبُو لُبَابَةَ بْنُ عَبْدِ الْمُنْذِرِ ، أَوْ زَيْدُ بْنُ الْخَطَّابِ  وَهُوَ  يُطَارِدُ  حَيَّةً ، فَقَالَ : إِنَّهُ قَدْ نَهَى عَنْ ذَوَاتِ الْبُيُوتِ  .","","Musnad Abi Ya'la al-Mawsili 5493","","أبو لبابة بن عبد المنذر الأنصاري عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5497","80 - (  5494  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ ،  فَأَوْتِرْ  بِرَكْعَةٍ تُوتِرُ لَكَ مَا مَضَى  .","","Musnad Abi Ya'la al-Mawsili 5494","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5498","81 - (  5495  ) -  وَعَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ فَاتَتْهُ صَلَاةُ الْعَصْرِ فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .         [9/372]","","Musnad Abi Ya'la al-Mawsili 5495","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5499","82 - (  5496  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  عَنِ  النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّهُ قَالَ :  إِنَّ الَّذِي تَفُوتُهُ الصَّلَاةُ - صَلَاةُ الْعَصْرِ - فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 5496","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5500","83 - (  5497  ) -  حَدَّثَنَا  عَمْرٌو ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا يَقْتُلُ الْمُحْرِمُ مِنَ الدَّوَابِّ ؟ فَقَالَ : خَمْسٌ مِنَ الدَّوَابِّ لَا جُنَاحَ عَلَى مَنْ قَتَلَهُنَّ فِي الْحَرَمِ وَالْحِلِّ  : الْغُرَابُ ،  وَالْفَأْرَةُ  ، وَالْعَقْرَبُ ،  وَالْحِدَأَةُ  ، وَالْكَلْبُ  الْعَقُورُ  .","","Musnad Abi Ya'la al-Mawsili 5497","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5501","84 - (  5498  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  اقْتُلُوا الْحَيَّاتِ ، وَاقْتُلُوا ذَا  الطُّفْيَتَيْنِ ،  وَالْأَبْتَرَ  ، فَإِنَّهُمَا يُذْهِبَانِ الْبَصَرَ ، وَيُسْقِطَانِ الْحَبَلَ ، قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  : فَبَيْنَا أَنَا  أُطَارِدُ  حَيَّةً إِذْ رَآنِي  أَبُو لُبَابَةَ  ، فَقَالَ  أَبُو لُبَابَةَ  ... فَقُلْتُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِقَتْلِهَا ،         [9/373]      فَقَالَ  أَبُو لُبَابَةَ : إِنَّهُ نَهَى بَعْدَ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5498","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5502","85 - (  5499  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مَالِكٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ رَفَعَ يَدَيْهِ  ، وَقَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، رَبَّنَا وَلَكَ الْحَمْدُ  .","","Musnad Abi Ya'la al-Mawsili 5499","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن مالك بن أنس عن إسماعيل بن أبي أويس عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5503","86 - (  5500  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ، أَنَّ عُبَيْدَ اللهِ بْنَ عَبْدِ اللهِ ، وَسَالِمَ بْنَ عَبْدِ اللهِ ،  أَخْبَرَاهُ         [9/374]      أَنَّهُمَا كَلَّمَا عَبْدَ اللهِ لَيَالِيَ نَزَلَ الْجَيْشُ  بِابْنِ الزُّبَيْرِ  قَبْلَ أَنْ يُقْتَلَ ، فَقَالَا : لَا يَضُرُّكَ أَنْ لَا تَحُجَّ الْعَامَ ، إِنَّا نَخَافُ أَنْ يُحَالَ بَيْنَكَ وَبَيْنَ  الْبَيْتِ  ، فَقَالَ :  قَدْ خَرَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَحَالَ كُفَّارُ  قُرَيْشٍ  دُونَ  الْبَيْتِ  ،  فَنَحَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَدْيَهُ ، وَحَلَقَ رَأْسَهُ ، وَأُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ عُمْرَةً ، إِنْ شَاءَ اللهُ أَنْطَلِقُ ، فَإِنْ خُلِّيَ بَيْنِي وَبَيْنَ  الْبَيْتِ  طُفْتُ ، وَإِنْ حِيلَ بَيْنِي وَبَيْنَهُ فَعَلْتُ كَمَا فَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا مَعَهُ ، فَأَهَلَّ بِالْعُمْرَةِ  بِذِي الْحُلَيْفَةِ  ، ثُمَّ سَارَ سَاعَةً ، فَقَالَ : إِنَّمَا شَأْنُهُمَا وَاحِدٌ ، وَأُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ حَجَّةً مَعَ عُمْرَتِي ، فَلَمْ يَحِلَّ مِنْهُمَا حَتَّى  أَحَلَّ  يَوْمَ النَّحْرِ ، وَكَانَ يَقُولُ : مَنْ جَمَعَ  الْحَجَّ  وَالْعُمْرَةَ فَأَهَلَّ بِهِمَا ، فَإِنَّهُ لَا يَحِلُّ حَتَّى يَحِلَّ مِنْهُمَا جَمِيعًا يَوْمَ النَّحْرِ فَيَطُوفَ عَنْهُمَا طَوَافًا وَاحِدًا  بِالْبَيْتِ  ،  وَبِالصَّفَا  ،         [9/375]      وَالْمَرْوَةِ  يَوْمَ يَدْخُلُ  مَكَّةَ  .         [9/376]","","Musnad Abi Ya'la al-Mawsili 5500","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5504","87 - (  5501  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الصَّمَدِ ، أَوْ صَالِحُ بْنُ عَبْدِ الصَّمَدِ  أَخُوهُ ،  حَدَّثَنَا  قَاسِمٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  جَاءَ  عُمَرُ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتَأْذِنُ فِي الْعُمْرَةِ ، فَقَالَ :  يَا أَخِي ادْعُ ، وَلَا تَنْسَنَا فِي صَالِحِ الدُّعَاءِ  .         [9/377]","","Musnad Abi Ya'la al-Mawsili 5501","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن القاسم بن يزيد الجرمي عن صالح بن عبد الصمد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5505","88 - (  5502  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  أَصْرَمُ بْنُ حَوْشَبٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،         [9/378]      عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كَانَ الْفَيْءُ ذِرَاعًا وَنِصْفًا إِلَى ذِرَاعَيْنِ فَصَلُّوا الظُّهْرَ  .","","Musnad Abi Ya'la al-Mawsili 5502","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن زياد بن سعد الخراساني عن أصرم بن حوشب الهمذاني عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5506","89 - (  5503  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ الْوَاسِطِيُّ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَشَارَ الْمُسْلِمِينَ فِيمَا يَجْمَعُهُمْ عَلَى الصَّلَاةِ  ، فَقَالُوا : الْبُوقُ ، فَكَرِهَهُ مِنْ أَجْلِ الْيَهُودِ ، ثُمَّ ذُكِرَ النَّاقُوسُ ، فَكَرِهَهُ مِنْ أَجْلِ النَّصَارَى ، فَأُرِيَ تِلْكَ اللَّيْلَةَ  النِّدَاءَ  رَجُلٌ مِنَ  الْأَنْصَارِ  يُقَالُ لَهُ :  عَبْدُ اللهِ بْنُ زَيْدٍ  ،  وَعُمَرُ بْنُ الْخَطَّابِ  ، فَطَرَقَهُ الْأَنْصَارِيُّ ، فَأَمَرَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِلَالًا  فَأَذَّنَ بِهِ .         [9/379]      90 - (  5504  ) - قَالَ  الزُّهْرِيُّ  : وَزَادَ  بِلَالٌ  فِي  نِدَاءِ  صَلَاةِ الْفَجْرِ ""الصَّلَاةُ خَيْرٌ مِنَ النَّوْمِ"" ، فَأَقَرَّهَا نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،         [9/380]      وَقَالَ  عُمَرُ  : أَمَا إِنِّي قَدْ رَأَيْتُ مِثْلَ الَّذِي رَأَى ، وَلَكِنَّهُ سَبَقَنِي  .","","Musnad Abi Ya'la al-Mawsili 5503","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5507","91 - (  5505  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ فَاتَتْهُ الْعَصْرُ فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 5505","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5508","92 - (  5506  ) -  حَدَّثَنَا  وَهْبٌ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  لَيْثٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ فَاتَتْهُ الْعَصْرُ فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 5506","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ليث بن أبي سليم عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5509","93 - (  5507  ) -  حَدَّثَنَا  نُعَيْمُ بْنُ هَيْصَمٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ         [9/381]      بْنُ زِيَادٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  حَدَّثَنِي  أَبُو مَطَرٍ ،  أَنَّهُ سَمِعَ  سَالِمَ بْنَ عَبْدِ اللهِ بْنِ عُمَرَ  يُحَدِّثُ عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَمِعَ الرَّعْدَ وَالصَّوَاعِقَ ، قَالَ : اللَّهُمَّ لَا تَقْتُلْنَا بِغَضَبِكَ  ، وَلَا تُهْلِكْنَا بِعَذَابِكَ ، وَعَافِنَا قَبْلَ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5507","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو مطر عن حجاج بن أرطاة عن عبد الواحد بن زياد عن نعيم بن الهيضم الخراساني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5510","94 - (  5508  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ بَاعَ عَبْدًا لَهُ مَالٌ ، فَإِنَّ مَالَهُ لِلْبَائِعِ ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  ، وَمَنْ بَاعَ نَخْلًا قَدْ         [9/382]      أُبِّرَتْ ،  فَإِنَّ  ثَمَرَهَا  لِلْبَائِعِ ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .","","Musnad Abi Ya'la al-Mawsili 5508","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5511","95 - (  5509  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  طَلْحَةُ يَعْنِي : ابْنَ يَحْيَى ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَرْفَعُوا أَبْصَارَكُمْ إِلَى السَّمَاءِ أَنْ  يُلْتَمَعَ  .         [9/383]","","Musnad Abi Ya'la al-Mawsili 5509","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن طلحة بن يحيى بن النعمان الزرقي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5512","96 - (  5510  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ الْكُوفِيُّ  ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ  حَنْظَلَةَ ، قَالَ :  سَمِعْتُ  سَالِمًا ، يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ ،  يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِذَا اسْتَأْذَنَكُمْ نِسَاؤُكُمْ إِلَى الْمَسَاجِدِ فَأْذَنُوا لَهُنَّ  .  في طبعة دار المأمون للتراث : (عبد الله بن نمير الكوفي) والمثبت من نسخة السليمانية .","","Musnad Abi Ya'la al-Mawsili 5510","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن إسحاق بن سليمان الرازي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5513","97 - (  5511  ) -  حَدَّثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى الْكُوفِيُّ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ الْفِتْنَةَ تَجِيءُ مِنْ هَاهُنَا ، وَأَوْمَأَ بِيَدِهِ نَحْوَ الْمَشْرِقِ حَيْثُ يَطْلُعُ قَرْنُ الشَّيْطَانِ  ، وَأَنْتُمْ يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ ، وَإِنَّمَا قَتَلَ  مُوسَى  الَّذِي قَتَلَ مِنْ  آلِ فِرْعَوْنَ  خَطَأً  ، قَالَ اللهُ لَهُ :         {      وَقَتَلْتَ نَفْسًا فَنَجَّيْنَاكَ مِنَ الْغَمِّ وَفَتَنَّاكَ فُتُونًا         }      .","","Musnad Abi Ya'la al-Mawsili 5511","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن فضيل بن غزوان عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5514","98 - (  5512  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُعْتَمِرٌ ،  عَنْ  بُرْدِ بْنِ سِنَانٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،         [9/384]      عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَنْبَغِي لِأَحَدٍ أَنْ يَبِيتَ ثَلَاثَ لَيَالٍ إِلَّا وَوَصِيَّتُهُ عِنْدَهُ  ، قَالَ : فَمَا بِتُّ لَيْلَةً إِلَّا وَوَصِيَّتِي عِنْدِي مَوْضُوعَةٌ ، أَوْ كَمَا قَالَ  .         [9/385]","","Musnad Abi Ya'la al-Mawsili 5512","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن برد بن سنان عن معتمر بن سليمان عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5515","99 - (  5513  ) -  حَدَّثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْمَاجِشُونُ ،  أَخْبَرَنِي  صَالِحُ بْنُ كَيْسَانَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَقْبَلَ مِنَ  الْحَجِّ  أَوِ الْعُمْرَةِ ، كُلَّمَا أَوْفَى عَلَى  فَدْفَدٍ  ، أَوْ ثَنِيَّةٍ كَبَّرَ ثَلَاثَ تَكْبِيرَاتٍ  ، ثُمَّ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، يُحْيِي وَيُمِيتُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، آيِبُونَ         [9/386]      تَائِبُونَ ، لِرَبِّنَا حَامِدُونَ ، صَدَقَ اللهُ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ  .         [9/387]","","Musnad Abi Ya'la al-Mawsili 5513","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن صالح بن كيسان الدوسي عن عبد العزيز بن عبد الله الماجشون عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5516","100 - (  5514  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ ،  عَنْ  أَبِي بَكْرِ بْنِ سَالِمٍ ،  عَنْ  سَالِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  أُرِيتُ فِي النَّوْمِ أَنِّي أَنْزِعُ بِدَلْوٍ عَلَى  قَلِيبٍ  ، فَجَاءَ  أَبُو بَكْرٍ  فَنَزَعَ ذَنُوبًا أَوْ ذَنُوبَيْنِ ، فَنَزَعَ نَزْعًا ضَعِيفًا ، وَاللهُ يَغْفِرُ لَهُ ، ثُمَّ جَاءَ  عُمَرُ  فَاسْتَقَى ،  فَاسْتَحَالَتْ  غَرْبًا  ، فَلَمْ أَرَ  عَبْقَرِيًّا  مِنَ النَّاسِ  يَفْرِي  فَرِيَّهُ ، حَتَّى رَوِيَ النَّاسُ ، وَضَرَبُوا  بِعَطَنٍ  .         [9/388]","","Musnad Abi Ya'la al-Mawsili 5514","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن محمد بن بشر بن الفرافصة عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5517","101 - (  5515  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  حَدَّثَنَا  حَنْظَلَةُ ، قَالَ :  سَمِعْتُ  سَالِمًا ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ  ، يَقُولُ :  خَرَجَ  أُسَامَةُ  وَعَلَيْهِ  حُلَّةٌ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  شَقِّقْهَا لِأَهْلِكَ خُمُرًا  .         [9/389]","","Musnad Abi Ya'la al-Mawsili 5515","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن إسحاق بن سليمان الرازي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5518","102 - (  5516  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ الرَّازِيُّ ،  حَدَّثَنَا  حَنْظَلَةُ ، قَالَ :  سَمِعْتُ  سَالِمًا ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ  ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَأَنْ يَكُونَ جَوْفُ ابْنِ آدَمَ مَمْلُوءًا  قَيْحًا  ، خَيْرٌ لَهُ مِنْ أَنْ يَكُونَ مَمْلُوءًا شِعْرًا  .         [9/390]","","Musnad Abi Ya'la al-Mawsili 5516","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن إسحاق بن سليمان الرازي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5519","103 - (  5517  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اشْتَرَى نَخْلًا بَعْدَمَا  أُبِّرَتْ  فَلَمْ يَشْتَرِطْ  ثَمَرَتَهَا  ، فَلَا شَيْءَ لَهُ  ، وَمَنِ اشْتَرَى عَبْدًا فَلَمْ يَشْتَرِطْ مَالَهُ ، فَلَا شَيْءَ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 5517","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن علي بن الجعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5520","104 - (  5518  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ الدَّوْرَقِيِّ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  فُضَيْلِ بْنِ سُلَيْمَانَ أَبِي سُلَيْمَانَ ، قَالَ :  حَدَّثَنِي  مُوسَى بْنُ عُقْبَةَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، قَالَ :  لَمَّا اسْتَعْمَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُسَامَةَ بْنَ زَيْدٍ  قَالَ النَّاسُ فِيهِ ، قَالَ : فَبَلَغَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ذَلِكَ - أَوْ شَيْءٌ مِنْ ذَلِكَ  - ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ بَلَغَنِي مَا قُلْتُمْ فِي  أُسَامَةَ  ، وَلَقَدْ قُلْتُمْ ذَلِكَ فِي أَبِيهِ قَبْلَهُ ، وَإِنَّهُ لَخَلِيقٌ لِلْإِمَارَةِ ،  وَإِنَّهُ لَخَلِيقٌ لِلْإِمَارَةِ ، وَإِنَّهُ لَخَلِيقٌ لِلْإِمَارَةِ ، وَإِنَّهُ لَأَحَبُّ النَّاسِ إِلَيَّ ،         [9/391]      قَالَ : فَمَا اسْتَثْنَى  فَاطِمَةَ  ، وَلَا غَيْرَهَا  .","","Musnad Abi Ya'la al-Mawsili 5518","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن فضيل بن سليمان النميري عن أبو عاصم النبيل عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5521","105 - (  5519  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ الْبَكْرِيُّ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  ابْنُ شِهَابٍ ،  أَخْبَرَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّهُ كَانَ يَمْشِي بَيْنَ يَدَيِ الْجِنَازَةِ ،  وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  ،  وَعُثْمَانَ  كَانُوا يَمْشُونَ أَمَامَهَا  .","","Musnad Abi Ya'la al-Mawsili 5519","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن ابن جريج عن أبو عاصم النبيل عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5522","106 - (  5520  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  عَبَّادِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَتْ يَمِينُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا وَمُصَرِّفِ الْقُلُوبِ  .         [9/392]","","Musnad Abi Ya'la al-Mawsili 5520","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الرحمن بن إسحاق العامري عن عبد الله بن رجاء البصري عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5523","107 - (  5521  ) -  حَدَّثَنَا  حُسَيْنُ بْنُ الْأَسْوَدِ الْكُوفِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِيُّ ،  حَدَّثَنَا  سُفْيَانُ بْنُ سَعِيدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كَانَتْ يَمِينُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّتِي يَحْلِفُ بِهَا : لَا وَمُقَلِّبِ الْقُلُوبِ  .","","Musnad Abi Ya'la al-Mawsili 5521","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن سفيان الثوري عن محمد بن بشر بن الفرافصة عن الحسين بن علي بن الأسود العجلي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5524","108 - (  5522  ) -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْأَسْوَدِ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  عُمَرُ بْنُ حَمْزَةَ ،  أَخْبَرَنِي  سَالِمٌ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ عُمَرَ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ  بِحَاطِبِ بْنِ أَبِي بَلْتَعَةَ  ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّكَ كَتَبْتَ هَذَا الْكِتَابَ ؟ فَقَالَ : نَعَمْ ، أَمَا وَاللهِ مَا ذَاكَ يَا رَسُولَ اللهِ أَنْ يَكُونَ بِغَيْرِ إِيمَانٍ مِنْ قَلْبِي ، وَلَكِنْ لَمْ يَكُنْ أَحَدٌ مِنْ  قُرَيْشٍ  إِلَّا وَلَهُ أَهْلٌ وَخَدَمٌ يَمْنَعُونَ لَهُ أَهْلَهُ ، فَكَتَبْتُ كِتَابًا رَجَوْتُ أَنْ يَمْنَعَ اللهُ لِي بِذَلِكَ أَهْلِي ، فَقَالَ  عُمَرُ  : ائْذَنْ لِي فِيهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَوَكُنْتَ قَاتِلَهُ ؟ قَالَ : نَعَمْ ، إِنْ أَذِنْتَ لِي فِيهِ ،         [9/393]      فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَمَا يُدْرِيكَ ، لَعَلَّ اللهَ اطَّلَعَ عَلَى  أَهْلِ بَدْرٍ  ، فَقَالَ : اعْمَلُوا مَا شِئْتُمْ  .","","Musnad Abi Ya'la al-Mawsili 5522","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن حماد بن أسامة القرشي عن الحسين بن علي بن الأسود العجلي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5525","109 - (  5523  ) -  حَدَّثَنَا  حُسَيْنُ بْنُ الْأَسْوَدِ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  عُمَرُ بْنُ حَمْزَةَ ، قَالَ :  سَمِعْتُ  سَالِمًا ، يَقُولُ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَقْتُلُونَ أَنْتُمُ الْيَهُودَ حَتَّى يَقُولَ الْحَجَرُ : يَا مُسْلِمُ هَذَا يَهُودِيٌّ وَرَائِي  ، تَعَالَ فَاقْتُلْهُ  .         [9/394]","","Musnad Abi Ya'la al-Mawsili 5523","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن حماد بن أسامة القرشي عن الحسين بن علي بن الأسود العجلي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5526","110 - (  5524  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ ،  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَأَيْتُ النَّاسَ جُمِعُوا لِلْحِسَابِ ، فَقَامَ  أَبُو بَكْرٍ  فَنَزَعَ ذَنُوبًا أَوْ ذَنُوبَيْنِ  ، وَفِي         [9/395]      نَزْعِهِ  ضَعْفٌ ، وَاللهُ يَغْفِرُ لَهُ ، ثُمَّ قَامَ  عُمَرُ  فَاسْتَحَالَتْ  غَرْبًا  ، فَلَمْ أَرَ  عَبْقَرِيًّا  مِنَ النَّاسِ  يَفْرِي  فَرِيَّهُ ، حَتَّى  ضَرَبَ  النَّاسُ  بِعَطَنٍ ،  قَالَ :  وَالْعَبْقَرِيُّ  : الْأَجِيرُ  .","","Musnad Abi Ya'la al-Mawsili 5524","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5527","111 - (  5525  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَأَيْتُ امْرَأَةً سَوْدَاءَ  ثَائِرَةَ  الرَّأْسِ ، خَرَجَتْ مِنَ  الْمَدِينَةِ  حَتَّى قَدِمَتْ  مَهْيَعَةَ  - وَهِيَ :  الْجُحْفَةُ  - فَأَوَّلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الرُّؤْيَا :  وَبَاءَ  الْمَدِينَةِ  يَنْتَقِلُ إِلَى  الْجُحْفَةِ  .         [9/396]","","Musnad Abi Ya'la al-Mawsili 5525","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5528","112 - (  5526  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  وَسَالِمٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  .","","Musnad Abi Ya'la al-Mawsili 5526","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5529","113 - (  5527  ) -  حَدَّثَنَا  أَبُو يُوسُفَ يَعْقُوبُ بْنُ إِسْحَاقَ الْجِيزِيُّ ،  حَدَّثَنَا  مُؤَمَّلٌ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  شَيْخٌ مِنْ أَهْلِ الْمَدِينَةِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي دُعَائِهِ : وَاقِيَةً كَوَاقِيَةِ  الْوَلِيدِ  ،         [9/397]      قَالَ أَبُو يَعْلَى :  يَعْنِي : الْمَوْلُودَ ، وَكَذَا فُسِّرَ لَنَا  .","","Musnad Abi Ya'la al-Mawsili 5527","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن شيخ من أهل المدينة عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن يعقوب بن إسحاق الجيزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5530","114 - (  5528  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  يَحْيَى - يَعْنِي ابْنَ زَكَرِيَّا - ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَصْلُحُ بَيْعُ  الثَّمَرِ         [9/398]      حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Musnad Abi Ya'la al-Mawsili 5528","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن زكريا بن أبي زائدة عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5531","115 - (  5529  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عَلَى الْمِنْبَرِ :  مَنْ جَاءَ مِنْكُمْ إِلَى الْجُمُعَةِ فَلْيَغْتَسِلْ  .","","Musnad Abi Ya'la al-Mawsili 5529","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5532","116 - (  5530  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  الزُّهْرِيُّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا  جَدَّ  بِهِ السَّيْرُ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  .","","Musnad Abi Ya'la al-Mawsili 5530","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5533","117 - (  5531  ) -  وَبِهِ  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَتْرُكُوا النَّارَ فِي بُيُوتِكُمْ حِينَ تَنَامُونَ  .","","Musnad Abi Ya'la al-Mawsili 5531","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5534","118 - (  5532  ) -  وَعَنْ  أَبِيهِ ،  قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  وَأَبَا بَكْرٍ  ،  وَعُمَرَ  يَمْشُونَ أَمَامَ الْجِنَازَةِ  .         [9/399]","","Musnad Abi Ya'la al-Mawsili 5532","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5535","119 - (  5533  ) -  وَعَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ : مَا يَلْبَسُ الْمُحْرِمُ مِنَ الثِّيَابِ ؟ قَالَ :  لَا يَلْبَسُ الْقَمِيصَ ، وَلَا الْعِمَامَةَ ، وَلَا  الْبُرْنُسَ  ، وَلَا السَّرَاوِيلَ ، وَلَا ثَوْبًا مَسَّهُ زَعْفَرَانٌ وَلَا وَرْسٌ ، وَلَا خُفَّيْنِ إِلَّا لِمَنْ لَمْ يَجِدِ النَّعْلَيْنِ ، فَمَنْ لَمْ يَجِدِ النَّعْلَيْنِ فَلْيَقْطَعْهُمَا حَتَّى تَكُونَا أَسْفَلَ عِنْدَ  الْكَعْبَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5533","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5536","120 - (  5534  ) -  وَعَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ  حَذْوَ  مَنْكِبَيْهِ  ، وَإِذَا أَرَادَ أَنْ يَرْكَعَ ، وَبَعْدَ الرُّكُوعِ ، وَلَا يَرْفَعُ بَيْنَ السَّجْدَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5534","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5537","121 - (  5535  ) -  وَعَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الشُّؤْمُ فِي ثَلَاثٍ  : فِي الْفَرَسِ ، وَالْمَرْأَةِ ، وَالدَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5535","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5538","122 - (  5536  ) -  وَعَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ  رَجُلًا  يَعِظُ أَخَاهُ فِي  الْحَيَاءِ ،  فَقَالَ :  إِنَّ  الْحَيَاءَ  مِنَ الْإِيمَانِ  .         [9/400]","","Musnad Abi Ya'la al-Mawsili 5536","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5539","123 - (  5537  ) -  وَعَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ  عُمَرَ  وَهُوَ يَقُولُ : وَأَبِي وَأَبِي ، فَقَالَ :  إِنَّ اللهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ  ، قَالَ  عُمَرُ  : وَاللهِ مَا حَلَفْتُ بِهَا بَعْدُ  ذَاكِرًا  وَلَا  آثِرًا  .","","Musnad Abi Ya'la al-Mawsili 5537","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5540","124 - (  5538  ) -  وَعَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنِ اقْتَنَى كَلْبًا إِلَّا كَلْبَ صَيْدٍ  ، أَوْ مَاشِيَةٍ ، نَقَصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ  .","","Musnad Abi Ya'la al-Mawsili 5538","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5541","125 - (  5539  ) -  وَعَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا اسْتَأْذَنَتْ أَحَدَكُمُ امْرَأَتُهُ إِلَى الْمَسْجِدِ فَلَا يَمْنَعْهَا  ، قَالَ  سُفْيَانُ  :  فَسَّرُوهُ بِاللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 5539","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5542","126 - (  5540  ) -  وَعَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْتُلُوا الْحَيَّاتِ  ، وَذَا  الطُّفْيَتَيْنِ ،  وَالْأَبْتَرَ ، فَإِنَّهُمَا  يَلْتَمِسَانِ  الْبَصَرَ ، وَيَسْتَسْقِطَانِ الْحَبَلَ ، وَكَانَ  ابْنُ عُمَرَ  يَقْتُلُ كُلَّ حَيَّةٍ وَجَدَهَا ، فَأَبْصَرَهُ  أَبُو لُبَابَةَ ، أَوْ         [9/401]      زَيْدُ بْنُ الْخَطَّابِ  وَهُوَ  يُطَارِدُ  حَيَّةً ، فَقَالَ :  إِنَّهُ نَهَى عَنْ ذَوَاتِ الْبُيُوتِ  .","","Musnad Abi Ya'la al-Mawsili 5540","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5543","127 - (  5541  ) -  وَعَنْ  أَبِيهِ  : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ  بِلَالًا  يُؤَذِّنُ بِلَيْلٍ  ، فَكُلُوا وَاشْرَبُوا حَتَّى تَسْمَعُوا  ابْنَ أُمِّ مَكْتُومٍ  .","","Musnad Abi Ya'la al-Mawsili 5541","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5544","128 - (  5542  ) -  وَعَنْ  أَبِيهِ  ، قَالَ :  رَأَى  رَجُلٌ  أَنَّهَا لَيْلَةُ كَذَا وَكَذَا مِنَ الْعَشْرِ -  يَعْنِي لَيْلَةَ الْقَدْرِ  - ، فَقَالَ لَهُمُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَرَى رُؤْيَاكُمْ قَدْ تَوَاطَأَتْ عَلَى أَنَّهَا فِي الْعَشْرِ الْأَوَاخِرِ  ، فَاطْلُبُوهَا فِي الْعَشْرِ الْأَوَاخِرِ فِي  الْوِتْرِ  مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 5542","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5545","129 - (  5543  ) -  وَعَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ الْقُرْآنَ ، فَهُوَ يَقُومُ بِهِ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ ، وَرَجُلٍ آتَاهُ اللهُ مَالًا ، فَهُوَ يُنْفِقُهُ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 5543","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5546","130 - (  5544  ) -  وَعَنْ  أَبِيهِ  ،  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  خَمْسٌ مِنَ الدَّوَابِّ لَا جُنَاحَ عَلَى مَنْ قَتَلَهُنَّ فِي الْإِحْرَامِ ،  وَالْحَرَمِ  : الْغُرَابُ ،  وَالْفَأْرَةُ  ، وَالْعَقْرَبُ ، وَالْكَلْبُ  الْعَقُورُ  ،         [9/402]      قَالَ  سُفْيَانُ  : وَالْأَسَدُ ، وَالذِّئْبُ ، وَالزُّنْبُورُ  الْعَقُورُ  .","","Musnad Abi Ya'la al-Mawsili 5544","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5547","131 - (  5545  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  حَدَّثَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى عَلَى  عُمَرَ  قَمِيصًا أَبْيَضَ ، فَقَالَ : جَدِيدٌ قَمِيصُكَ أَوْ غَسِيلٌ ؟ قَالَ : حَسِبْتُ أَنَّهُ قَالَ : غَسِيلٌ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْبَسْ جَدِيدًا ، وَعِشْ حَمِيدًا ، وَمُتْ شَهِيدًا  .         [9/403]","","Musnad Abi Ya'la al-Mawsili 5545","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5548","132 - (  5546  ) -  وَبِهِ  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَا  حَقُّ  امْرِئٍ يَمُرُّ عَلَيْهِ ثَلَاثُ لَيَالٍ إِلَّا وَوَصِيَّتُهُ عِنْدَهُ  ، قَالَ عَبْدُ الرَّزَّاقِ :  فَمَا مَرَّتْ عَلَيَّ ثَلَاثٌ قَطُّ إِلَّا وَوَصِيَّتِي عِنْدِي  .","","Musnad Abi Ya'la al-Mawsili 5546","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5549","133 - (  5547  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي صَلَاةِ الصُّبْحِ فُلَانًا وَفُلَانًا ، نَاسًا مِنَ الْمُنَافِقِينَ  ، فَأَنْزَلَ اللهُ تَعَالَى :         {      لَيْسَ لَكَ مِنَ الأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ         }      .         [9/404]","","Musnad Abi Ya'la al-Mawsili 5547","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد العزيز بن محمد الدراوردي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5550","134 - (  5548  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ يَمِينُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا وَمُقَلِّبِ الْقُلُوبِ  .","","Musnad Abi Ya'la al-Mawsili 5548","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5551","135 - (  5549  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ         [9/405]      مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  النَّاسُ  كَالْإِبِلِ  الْمِائَةِ  ، لَيْسَ فِيهَا  رَاحِلَةٌ  .","","Musnad Abi Ya'la al-Mawsili 5549","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5552","136 - (  5550  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ،  أَنَّ  عُمَرَ  اسْتَأْذَنَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْعُمْرَةِ ، فَأَذِنَ لَهُ ، قَالَ :  يَا أَخِي ، أَشْرِكْنَا فِي صَالِحِ دُعَائِكَ وَلَا تَنْسَنَا  .","","Musnad Abi Ya'la al-Mawsili 5550","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن بهدلة عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5553","137 - (  5551  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ أَبَا قِلَابَةَ  حَدَّثَهُ  ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  تَخْرُجُ نَارٌ  مِنْ بَحْرِ  حَضْرَمَوْتَ  - أَوْ مِنْ  حَضْرَمَوْتَ  - تَسُوقُ النَّاسَ  ، فَقُلْنَا : يَا رَسُولَ اللهِ ، فَمَا تَأْمُرُنَا ؟ قَالَ : عَلَيْكُمْ  بِالشَّامِ  .         [9/406]","","Musnad Abi Ya'la al-Mawsili 5551","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو قلابة الجرمي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5554","138 - (  5552  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  مُحَمَّدٌ - يَعْنِي : ابْنَ أَبِي حَرْمَلَةَ - ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنِ اقْتَنَى كَلْبًا إِلَّا كَلْبَ مَاشِيَةٍ  ، أَوْ كَلْبَ صَيْدٍ ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ ، قَالَ عَبْدُ اللهِ :  وَقَالَ  أَبُو هُرَيْرَةَ : أَوْ كَلْبَ حَرْثٍ  .         [9/407]","","Musnad Abi Ya'la al-Mawsili 5552","","أبو هريرة الدوسي عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن أبي حرملة القرشي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5555","139 - (  5553  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ، وَيَزِيدُ بْنُ هَارُونَ ، قَالَا :  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيَأْمُرُنَا بِالتَّخْفِيفِ  ، وَإِنْ كَانَ لَيَؤُمُّنَا فِي الْفَجْرِ بِـ: الصَّافَّاتِ  .","","Musnad Abi Ya'la al-Mawsili 5553","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5556","140 - (  5554  ) -  حَدَّثَنِي  الْفَضْلُ بْنُ الصَّبَّاحِ ،  حَدَّثَنِي  مَعْنُ بْنُ عِيسَى ،  حَدَّثَنَا  خَالِدُ بْنُ أَبِي بَكْرِ بْنِ عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَابُ أُمَّتِي الَّتِي تَدْخُلُ مِنْهُ الْجَنَّةَ عَرْضُهُ  مَسِيرَةُ  الرَّاكِبِ الْمُجَوِّدِ الْمُجَوِّدِ ، ثَلَاثًا  ؛ إِنَّهُمْ لَيُضْغَطُونَ عَلَيْهِ حَتَّى تَكَادَ مَنَاكِبُهُمْ تَزُولُ  .         [9/408]","","Musnad Abi Ya'la al-Mawsili 5554","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن خالد بن أبي بكر العمري عن معن بن عيسى عن الفضل بن الصباح النهاوندي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5557","141 - (  5555  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُحَمَّدٍ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُسَبِّحُ وَهُوَ عَلَى ظَهْرِ الدَّابَّةِ حَيْثُ كَانَ وَجْهُهُ  ،  قَالَ أَبُو يَعْلَى :  يَعْنِي : يُصَلِّي  .","","Musnad Abi Ya'la al-Mawsili 5555","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن الوليد بن محمد الموقرى عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5558","142 - (  5556  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  عُمَرُ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَسَارٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثَةٌ لَا يَدْخُلُونَ الْجَنَّةَ  ، وَثَلَاثَةٌ لَا يَنْظُرُ اللهُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ : الْعَاقُّ لِوَالِدَيْهِ ،  وَالدَّيُّوثُ  ، وَالْمَرْأَةُ الْمُتَرَجِّلَةُ ، وَثَلَاثَةٌ لَا يَنْظُرُ اللهُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ : فَثَنَّى الْعَاقَّ لِوَالِدَيْهِ ،         [9/409]      وَمُدْمِنُ  الْخَمْرِ ، وَالْمَنَّانُ بِمَا أَعْطَى  .","","Musnad Abi Ya'la al-Mawsili 5556","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن يسار الأعرج مولى ابن عمر عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5559","143 - (  5557  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  مَطَرٌ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَافَرْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَ عُمَرَ ، فَكَانَا لَا يَزِيدَانِ عَلَى رَكْعَتَيْنِ  ، وَكُنَّا ضُلَّالًا فَهَدَانَا اللهُ ، فَبِهِ نَقْتَدِي  .         [9/410]","","Musnad Abi Ya'la al-Mawsili 5557","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن مطر بن طهمان الوراق عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5560","144 - (  5558  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عُمَرَ بْنِ حَمْزَةَ قَالَ :  سَمِعْتُ  عِكْرِمَةَ يَقُولُ :  كِلْتَا يَدَيِ اللهِ يَمِينَانِ  ، فَيَطْوِي السَّمَاوَاتِ فَيَأْخُذُهُنَّ بِيَدِهِ ، ثُمَّ يَقُولُ : أَنَا الْمَلِكُ ، أَيْنَ الْجَبَّارُونَ ؟ أَيْنَ الْمُتَكَبِّرُونَ ؟ قَالَ : ثُمَّ يَأْخُذُ الْأَرَضِينَ بِيَدِهِ الْأُخْرَى ، وَيَقُولُ : أَنَا الْمَلِكُ ، أَيْنَ الْجَبَّارُونَ ؟ أَيْنَ الْمُتَكَبِّرُونَ  ؟ قَالَ عُمَرُ :  فَحَدَّثْتُ  بِهَذَا الْحَدِيثِ  سَالِمَ بْنَ عَبْدِ اللهِ  ،  فَقَالَ  سَالِمٌ :  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [9/411]      يَطْوِي اللهُ السَّمَاوَاتِ يَوْمَ الْقِيَامَةِ  ، ثُمَّ يَأْخُذُهُنَّ بِيَدِهِ الْيُمْنَى ، ثُمَّ يَقُولُ : أَنَا الْمَلِكُ ، أَيْنَ الْجَبَّارُونَ ؟ أَيْنَ الْمُتَكَبِّرُونَ ؟ ثُمَّ يَطْوِي الْأَرَضِينَ ، ثُمَّ يَأْخُذُهُنَّ بِشِمَالِهِ ، ثُمَّ يَقُولُ : أَنَا الْمَلِكُ ، أَيْنَ الْجَبَّارُونَ ؟ أَيْنَ الْمُتَكَبِّرُونَ  ؟ .         [9/412]","","Musnad Abi Ya'la al-Mawsili 5558","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن حماد بن أسامة القرشي عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5561","145 - (  5559  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ النُّكْرِيُّ ،  حَدَّثَنَا  مُبَشِّرٌ - يَعْنِي : ابْنَ إِسْمَاعِيلَ الْحَلَبِيَّ - ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا اسْتَأْذَنَتْ         [9/413]      أَحَدَكُمُ امْرَأَتُهُ إِلَى الْمَسْجِدِ فَلَا يَمْنَعْهَا  .","","Musnad Abi Ya'la al-Mawsili 5559","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5562","146 - (  5560  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ - يَعْنِي : ابْنَ دَاوُدَ ،  عَنْ  حَنْظَلَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ،  عَنِ  النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنِ اتَّخَذَ كَلْبًا إِلَّا كَلْبًا ضَارِيًا  ، أَوْ كَلْبَ مَاشِيَةٍ ، فَإِنَّهُ يَنْقُصُ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ ، فَقَالَ  أَبُو هُرَيْرَةَ  : أَوْ كَلْبَ زَرْعٍ ، قَالَ : وَكَانَ  أَبُو هُرَيْرَةَ  يَزْرَعُ  .","","Musnad Abi Ya'la al-Mawsili 5560","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن عبد الله بن داود الواسطي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5563","147 - (  5561  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  أَخْبَرَنَا  ابْنُ دَاوُدَ ،  عَنْ  حَنْظَلَةَ ،  عَنْ  سَالِمٍ  ،         [9/414]      أَنَّ  ابْنَ عُمَرَ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَأَمَرَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُرَاجِعَهَا  .","","Musnad Abi Ya'la al-Mawsili 5561","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن عبد الله بن داود الواسطي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5564","148 - (  5562  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  حَدَّثَنَا  كَثِيرُ بْنُ زَيْدٍ الْمَدَنِيُّ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ عَبْدِ اللهِ  يُحَدِّثُ ، عَنْ  أَبِيهِ ،  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَكُونُ الْمُؤْمِنُ لَعَّانًا  .         [9/415]","","Musnad Abi Ya'la al-Mawsili 5562","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن كثير بن زيد السهمي عن أبو عامر العقدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5565","149 - (  5563  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  أَبُو أُوَيْسٍ ،  عَنِ  الزُّهْرِيِّ ، أَنَّ  سَالِمَ بْنَ عَبْدِ اللهِ  حَدَّثَهُ  ،  أَنَّهُ سَمِعَ رَجُلًا مِنْ  أَهْلِ الشَّامِ  يَسْأَلُ عَبْدَ اللهِ بْنَ عُمَرَ عَنِ الْمُتَمَتِّعِ بِالْعُمْرَةِ إِلَى  الْحَجِّ  ، فَقَالَ  عَبْدُ اللهِ  : هُوَ حَلَالٌ ، قَالَ الشَّامِيُّ : فَإِنَّ أَبَاكَ قَدْ نَهَى ، قَالَ  عَبْدُ اللهِ  : أَرَأَيْتَ إِنْ كَانَ أَبِي نَهَى عَنْهَا ، وَصَنَعَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَمْرَ أَبِي تَتْبَعُ أَوْ أَمْرَ رَسُولِ اللهِ ؟ فَقَالَ الشَّامِيُّ : بَلْ أَمْرَ رَسُولِ اللهِ ، فَقَالَ :  قَدْ صَنَعَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 5563","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الله بن عبد الله بن أويس عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5566","150 - (  5564  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ الدَّوْرَقِيِّ ،  حَدَّثَنَا         [9/416]      إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا دَخَلَ فِي الصَّلَاةِ يَرْفَعُ يَدَيْهِ  ، وَإِذَا رَكَعَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، وَلَا يَفْعَلُ ذَلِكَ فِي السُّجُودِ  .","","Musnad Abi Ya'la al-Mawsili 5564","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن إسماعيل ابن علية عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5567","151 - (  5565  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  حَدَّثَنِي  يُونُسُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّ  سَالِمَ بْنَ عَبْدِ اللهِ  أَخْبَرَهُ  ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  ، قَالَ :  بَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِذِي الْحُلَيْفَةِ  مَبْدَأَهُ ، وَصَلَّى فِي مَسْجِدِهَا  .","","Musnad Abi Ya'la al-Mawsili 5565","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5568","152 - (  5566  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ إِسْمَاعِيلَ  حَدَّثَنَا         [9/417]      إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّمَا بَقَاؤُكُمْ فِيمَا سَلَفَ مِنَ الْأُمَمِ كَمَا بَيْنَ صَلَاةِ الْعَصْرِ إِلَى غُرُوبِ الشَّمْسِ  ، فَأُوتِيَ أَهْلُ التَّوْرَاةِ التَّوْرَاةَ فَعَمِلُوا إِلَى نِصْفِ النَّهَارِ ثُمَّ عَجَزُوا ، فَأُعْطُوا قِيرَاطًا قِيرَاطًا ، وَأُوتِيَ النَّصَارَى الْإِنْجِيلَ فَعَمِلُوا إِلَى صَلَاةِ الْعَصْرِ ثُمَّ عَجَزُوا ، فَأُعْطُوا قِيرَاطًا قِيرَاطًا ، فَأُوتِينَا الْقُرْآنَ فَعَمِلْنَا مِنْ صَلَاةِ الْعَصْرِ إِلَى غُرُوبِ الشَّمْسِ ، فَأُعْطِينَا قِيرَاطَيْنِ قِيرَاطَيْنِ ، فَقَالَتِ الْيَهُودُ وَالنَّصَارَى : يَا رَبَّنَا إِنَّا كُنَّا نَحْنُ أَكْثَرَ عَمَلًا مِنْهُمْ وَأَعْطَيْتَنَا قِيرَاطًا قِيرَاطًا ، فَقَالَ تَبَارَكَ وَتَعَالَى : هَلْ ظَلَمْتُكُمْ مِنْ أُجُورِكُمْ شَيْئًا ؟ قَالُوا : لَا ، قَالَ : فَهُوَ فَضْلِي أُوتِيهِ مَنْ أَشَاءُ  .","","Musnad Abi Ya'la al-Mawsili 5566","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن الحسن بن إسماعيل المجالدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5569","153 - (  5567  ) -  حَدَّثَنَا  سُلَيْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنِ  الْوَازِعِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَكَلَ مِنْ هَذَا         [9/418]      اللَّحْمِ شَيْئًا فَلْيَغْسِلْ يَدَهُ مِنْ رِيحِ وَضَرِهِ  ، لَا يُؤْذِي مَنْ حِذَاءَهُ  .","","Musnad Abi Ya'la al-Mawsili 5567","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوازع بن نافع العقيلي عن محمد بن سلمة الباهلي عن سليمان بن عمر بن خالد المخرمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5570","154 - (  5568  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  أَبُو عَقِيلٍ - يَعْنِي : يَحْيَى بْنَ الْمُتَوَكِّلِ - ،  أَخْبَرَنَا  الْقَاسِمُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ عُمَرَ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا         [9/419]      تَأْكُلُوا بِشِمَالِكُمْ  ، وَلَا تَشْرَبُوا بِهَا ، فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِهَا ، وَيَشْرَبُ بِهَا  .         [9/420]","","Musnad Abi Ya'la al-Mawsili 5568","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن القاسم بن عبيد الله بن عبد الله بن عمر عن يحيى بن المتوكل الحذاء عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5571","155 - (  5569  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُحَمَّدٍ ،  عَنِ  الزُّهْرِيِّ ،  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُسَبِّحُ وَهُوَ عَلَى ظَهْرِ الدَّابَّةِ أَيْنَ كَانَ وَجْهُهُ  ، قَالَ أَبُو يَعْلَى :  يُصَلِّي تَطَوُّعًا  .","","Musnad Abi Ya'la al-Mawsili 5569","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن الوليد بن محمد الموقرى عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5572","156 - (  5570  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا         [9/421]      مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ عَبْدِ اللهِ بْنِ عُمَرَ  ، يَقُولُ :  يَا  أَهْلَ الْعِرَاقِ  ، مَا أَسْأَلَكُمْ عَنِ الصَّغِيرِ وَأَتْرَكَكُمْ لِلْكَبِيرِ !  سَمِعْتُ  أَبِي عَبْدَ اللهِ بْنَ عُمَرَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  الْفِتْنَةُ تَجِيءُ مِنْ هَاهُنَا  ، وَأَوْمَأَ بِيَدِهِ نَحْوَ الْمَشْرِقِ ، وَأَنْتُمْ يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ ، وَإِنَّمَا قَتَلَ  مُوسَى  صَلَّى اللهُ عَلَيْهِ الَّذِي قَتَلَ مِنْ  آلِ فِرْعَوْنَ  خَطَأً  ، قَالَ اللهُ :         {      وَقَتَلْتَ نَفْسًا فَنَجَّيْنَاكَ مِنَ الْغَمِّ وَفَتَنَّاكَ فُتُونًا         }      .","","Musnad Abi Ya'la al-Mawsili 5570","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن فضيل بن غزوان عن محمد بن فضيل بن غزوان عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5573","157 - (  5571  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الزِّمَّانِيُّ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  عَاصِمُ بْنُ عُبَيْدِ اللهِ ، قَالَ :  سَمِعْتُ  ابْنَ عَبْدِ اللهِ بْنِ عُمَرَ  يُحَدِّثُ  ،  عَنْ  أَبِيهِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  ، قَالَ :  يَا رَسُولَ اللهِ ، أَرَأَيْتَ مَا نَعْمَلُ فِيهِ ، أَمْرٌ قَدْ فُرِغَ مِنْهُ ، أَمْ أَمْرٌ  مُبْتَدَعٌ - أَوْ مُبْتَدَأٌ  - ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بَلْ مَا فُرِغَ مِنْهُ ، قَالَ يَا رَسُولَ اللهِ : أَفَلَا نَتَّكِلُ ؟         [9/422]      قَالَ :  اعْمَلُوا ، فَكُلٌّ  مُيَسَّرٌ  ، إِنَّهُ مَنْ كَانَ مِنْ أَهْلِ السَّعَادَةِ عَمِلَ لِلسَّعَادَةِ ، وَمَنْ كَانَ مِنْ أَهْلِ الشَّقَاءِ ، عَمِلَ لِلشَّقَاءِ  .","","Musnad Abi Ya'la al-Mawsili 5571","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن يحيى بن فياض الزماني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5574","158 - (  5572  ) -  حَدَّثَنَا  أَبُو الْفَضْلِ شُجَاعُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  حَنْظَلَةُ بْنُ أَبِي سُفْيَانَ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ  ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  مَنْ جَرَّ ثَوْبَهُ  خُيَلَاءَ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .         [9/423]             [9/424]","","Musnad Abi Ya'la al-Mawsili 5572","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن مكي بن إبراهيم عن شجاع بن مخلد الفلاس عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5575","159 - (  5573  ) -  وَبِهِ  سَمِعْتُ  ابْنَ عُمَرَ ،  يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  لَأَنْ يَمْتَلِئَ جَوْفُ أَحَدِكُمْ  قَيْحًا  خَيْرٌ لَهُ مِنْ أَنْ يَمْتَلِئَ شِعْرًا  .","","Musnad Abi Ya'la al-Mawsili 5573","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن مكي بن إبراهيم عن شجاع بن مخلد الفلاس عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5576","160 - (  5574  ) -  حَدَّثَنَا  رَوْحُ بْنُ عَبْدِ الْمُؤْمِنِ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ مُوسَى ،  عَنْ  سُلَيْمَانَ بْنِ أَرْقَمَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَرَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ( وَمِنْ عِنْدِهِ عِلْمُ الْكِتَابِ )  .         [9/425]","","Musnad Abi Ya'la al-Mawsili 5574","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سليمان بن أرقم الانصارى عن عبد الرحيم بن موسى السامي عن روح بن عبد المؤمن عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5577","161 - (  5575  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  يُونُسَ  يُحَدِّثُ ، عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَدْخُلُوا مَسَاكِنَ الَّذِينَ ظَلَمُوا أَنْفُسَهُمْ إِلَّا أَنْ تَكُونُوا بَاكِينَ  أَنْ يُصِيبَكُمْ مِثْلُ مَا أَصَابَهُمْ  ،  يَعْنِي :  أَهْلَ الْحِجْرِ  .         [9/426]","","Musnad Abi Ya'la al-Mawsili 5575","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5578","162 - (  5576  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  أَخْبَرَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا  عَدْوَى  وَلَا  طِيَرَةَ  .         [9/427]","","Musnad Abi Ya'la al-Mawsili 5576","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5579","163 - (  5577  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  أَخْبَرَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا رَمَى  الْجَمْرَةَ الْأُولَى  الَّتِي تَلِي الْمَسْجِدَ - مَسْجِدَ  مِنًى  - رَمَاهَا بِسَبْعِ حَصَيَاتٍ  ، يُكَبِّرُ كُلَّمَا رَمَى بِحَصَاةٍ ، ثُمَّ تَقَدَّمَ أَمَامَهَا فَوَقَفَ مُسْتَقْبِلَ الْقِبْلَةِ رَافِعًا يَدَيْهِ يَدْعُو ، وَكَانَ يُطِيلُ الْوُقُوفَ ، ثُمَّ يَأْتِي  الْجَمْرَةَ الثَّانِيَةَ  فَيَرْمِيهَا بِسَبْعِ حَصَيَاتٍ يُكَبِّرُ كُلَّمَا رَمَى بِحَصَاةٍ ، ثُمَّ يَنْحَدِرُ ذَاتَ الْيَسَارِ مِمَّا يَلِي الْوَادِيَ ، فَيَقِفُ مُسْتَقْبِلَ الْقِبْلَةِ رَافِعًا يَدَيْهِ يَدْعُو ، ثُمَّ يَأْتِي  الْجَمْرَةَ الَّتِي عِنْدَ الْعَقَبَةِ  ، فَيَرْمِيهَا بِسَبْعِ حَصَيَاتٍ يُكَبِّرُ كُلَّمَا رَمَى بِحَصَاةٍ ، ثُمَّ يَنْصَرِفُ وَلَا يَقِفُ عِنْدَهَا ، قَالَ الزُّهْرِيُّ :  سَمِعْتُ  سَالِمًا  يُحَدِّثُ  بِهَذَا ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَكَانَ  ابْنُ عُمَرَ  يَفْعَلُهُ  .         [9/428]","","Musnad Abi Ya'la al-Mawsili 5577","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5580","164 - (  5578  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  حَنْظَلَةُ الْجُمَحِيُّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا اسْتَأْذَنَكُمْ نِسَاؤُكُمْ إِلَى الْمَسْجِدِ فَأْذَنُوا لَهُنَّ  .","","Musnad Abi Ya'la al-Mawsili 5578","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5581","165 - (  5579  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ عِيسَى ،  حَدَّثَنَا  لَيْثٌ ،  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُنَفِّلُ بَعْضَ مَنْ يَبْعَثُ مِنَ السَّرَايَا لِأَنْفُسِهِمْ خَاصَّةَ النَّفَلِ  ، سِوَى قِسْمَةِ عَامَّةِ الْجَيْشِ ، وَالْخُمُسُ  وَاجِبٌ  فِي ذَلِكَ كُلِّهِ  .         [9/429]","","Musnad Abi Ya'la al-Mawsili 5579","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن إسحاق بن عيسى بن نجيح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5582","166 - (  5580  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا يُصَوِّرُ عَبْدٌ صُورَةً إِلَّا قِيلَ لَهُ يَوْمَ الْقِيَامَةِ : أَحْيِ مَا خَلَقْتَ  .         [9/430]","","Musnad Abi Ya'la al-Mawsili 5580","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5583","167 - (  5581  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ، قَالَ :  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  عَبْدِ اللهِ بْنِ مُسْلِمٍ ،  عَنْ  حَمْزَةَ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَزَالُ الْمَسْأَلَةُ بِالرَّجُلِ حَتَّى يَلْقَى اللهَ وَلَيْسَ فِي وَجْهِهِ لَحْمٌ  .","","Musnad Abi Ya'la al-Mawsili 5581","","عبد الله بن عمر بن الخطاب عن حمزة بن عبد الله بن عمر بن الخطاب عن عبد الله بن مسلم أخو ابن شهاب الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5584","168 - (  5582  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ الْبُنَانِيُّ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  حَمْزَةُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ، أَنَّهُ         [9/431]      سَمِعَ  ابْنَ عُمَرَ ،  يَقُولُ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِذَا نَزَلَ بِقَوْمٍ عَذَابٌ ، أَصَابَ الْعَذَابُ مَنْ كَانَ فِيهِمْ  ، ثُمَّ بُعِثُوا عَلَى أَعْمَالِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 5582","","عبد الله بن عمر بن الخطاب عن حمزة بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن إبراهيم بن إسحاق الطالقاني عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5585","169 - (  5583  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  فُلَيْحٌ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَعَنَ اللهُ الْخَمْرَ  ، وَلَعَنَ شَارِبَهَا ، وَسَاقِيَهَا ، وَعَاصِرَهَا ، وَمُعْتَصِرَهَا ، وَحَامِلَهَا ، وَالْمَحْمُولَةَ         [9/432]      إِلَيْهِ ، وَبَائِعَهَا ، وَمُبْتَاعَهَا ، وَآكِلَ ثَمَنِهَا  .         [9/433]","","Musnad Abi Ya'la al-Mawsili 5583","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبد الله بن عمر بن الخطاب عن سعيد بن عبد الرحمن بن وائل الأنصاري عن فليح بن سليمان عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5586","170 - (  5584  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  جَدِّهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا أَكَلَ أَحَدُكُمْ فَلْيَأْكُلْ بِيَمِينِهِ  ، وَإِذَا شَرِبَ فَلْيَشْرَبْ بِيَمِينِهِ ، فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ ، وَيَشْرَبُ بِشِمَالِهِ  ،         [9/434]      قَالَ  زُهَيْرٌ  : هُوَ  ابْنُ عُمَرَ  .","","Musnad Abi Ya'la al-Mawsili 5584","","عبد الله بن عمر بن الخطاب عن أبو بكر بن عبيد الله بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5587","171 - (  5585  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  حَدَّثَنَا  عُمَرُ بْنُ مُحَمَّدٍ الْعُمَرِيُّ ، أَنَّ أَبَاهُ  حَدَّثَهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا صَارَ أَهْلُ الْجَنَّةِ إِلَى الْجَنَّةِ ، وَصَارَ أَهْلُ النَّارِ إِلَى النَّارِ ، أُتِيَ بِالْمَوْتِ حَتَّى يُجْعَلَ بَيْنَ الْجَنَّةِ وَالنَّارِ ، ثُمَّ يُذْبَحُ  ، ثُمَّ يُنَادِي مُنَادٍ : يَا أَهْلَ الْجَنَّةِ لَا مَوْتَ ، يَا أَهْلَ النَّارِ لَا مَوْتَ ، فَيَزْدَادُ أَهْلُ الْجَنَّةِ فَرَحًا إِلَى فَرَحِهِمْ ، وَأَهْلُ النَّارِ حُزْنًا إِلَى حُزْنِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 5585","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5588","172 - (  5586  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ مُحَمَّدٍ ، أَنَّ أَبَاهُ  حَدَّثَهُ  ،         [9/435]      عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  كُنَّا نَتَحَدَّثُ فِي  حَجَّةِ الْوَدَاعِ  ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ أَظْهُرِنَا ، لَا نَدْرِي مَا حَجَّةُ الْوَدَاعِ ، فَحَمِدَ اللهَ - رَسُولُهُ - وَحْدَهُ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ ذَكَرَ  الْمَسِيحَ الدَّجَّالَ  فَأَطْنَبَ فِي ذِكْرِهِ ، ثُمَّ قَالَ :  مَا بَعَثَ اللهُ مِنْ نَبِيٍّ إِلَّا قَدْ أَنْذَرَهُ أُمَّتَهُ  ، لَقَدْ أَنْذَرَهُ  نُوحٌ  ، وَالنَّبِيُّونَ مِنْ بَعْدِهِ ، وَإِنَّهُ يَخْرُجُ فِيكُمْ ، وَمَا خَفِيَ عَلَيْكُمْ مِنْ شَأْنِهِ فَلَا يَخْفَى عَلَيْكُمْ ، إِنَّهُ  أَعْوَرُ  عَيْنِ الْيُمْنَى كَأَنَّهَا عِنَبَةٌ  طَافِيَةٌ  ، ثُمَّ قَالَ : إِنَّ اللهَ حَرَّمَ عَلَيْكُمْ دِمَاءَكُمْ وَأَمْوَالَكُمْ  كَحُرْمَةِ  يَوْمِكُمْ هَذَا ، فِي بَلَدِكُمْ هَذَا ، فِي شَهْرِكُمْ هَذَا ، أَلَا هَلْ بَلَّغْتُ ؟ قَالُوا : نَعَمْ ، قَالَ : اللَّهُمَّ اشْهَدْ ، ثُمَّ قَالَ :  وَيْلَكُمْ - أَوْ وَيْحَكُمُ  - انْظُرُوا لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .         [9/436]             [9/437]","","Musnad Abi Ya'la al-Mawsili 5586","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5589","173 - (  5587  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  بَشَّارُ بْنُ كِدَامٍ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا الْيَمِينُ  حِنْثٌ  أَوْ نَدَمٌ  .","","Musnad Abi Ya'la al-Mawsili 5587","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن بشار بن كدام الهلالي عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5590","174 - (  5588  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذِ بْنِ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  خُبَيْبِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  حَفْصِ بْنِ عَاصِمٍ ،         [9/438]      عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  أَنَّهُ كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ حَيْثُمَا تَوَجَّهَتْ بِهِ  .","","Musnad Abi Ya'la al-Mawsili 5588","","عبد الله بن عمر بن الخطاب عن حفص بن عاصم بن عمر بن الخطاب عن خبيب بن عبد الرحمن الخزرجي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5591","175 - (  5589  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ،  حَدَّثَنَا  عَاصِمُ بْنُ مُحَمَّدٍ ، قَالَ :  سَمِعْتُ  أَبِي  يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَزَالُ هَذَا الْأَمْرُ فِي  قُرَيْشٍ  مَا بَقِيَ فِي النَّاسِ اثْنَانِ  .","","Musnad Abi Ya'la al-Mawsili 5589","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عاصم بن محمد بن زيد العمري عن معاذ بن معاذ بن نصر عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5592","176 - (  5590  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  ابْنِ عُمَرَ ،  قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ عَنِ         [9/439]      الْمَاءِ يَكُونُ بِأَرْضِ الْفَلَاةِ ، وَمَا يَنُوبُهُ مِنَ الدَّوَابِّ وَالسِّبَاعِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كَانَ الْمَاءُ قَدْرَ  قُلَّتَيْنِ  لَمْ  يَحْمِلِ  الْخَبَثَ  .         [9/440]             [9/441]","","Musnad Abi Ya'la al-Mawsili 5590","","عبد الله بن عمر بن الخطاب عن عبيد الله بن عبد الله بن عمر بن الخطاب عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5593","177 - (  5591  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ الْجَهْضَمِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَعَنَ الْخَمْرَ  ، وَشَارِبَهَا ،         [9/442]      وَسَاقِيَهَا ، وَبَائِعَهَا ، وَمُبْتَاعَهَا ، وَحَامِلَهَا ، وَالْمَحْمُولَةَ إِلَيْهِ ، وَعَاصِرَهَا ، وَمُعْتَصِرَهَا ، وَآكِلَ ثَمَنِهَا  .","","Musnad Abi Ya'la al-Mawsili 5591","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن عبد الله الغافقي عن عبد العزيز بن عمر بن عبد العزيز عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5594","178 - (  5592  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  عَاصِمُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 5592","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عاصم بن محمد بن زيد العمري عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5595","179 - (  5593  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ الْأَسَدِيُّ ،  عَنْ  عَاصِمِ بْنِ مُحَمَّدٍ ،  عَنْ  وَاقِدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ،  عَنِ  النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  كَيْفَ أَنْتَ يَا  عَبْدَ اللهِ بْنَ عُمَرَ  إِذَا بَقِيتَ فِي  حُثَالَةٍ  مِنَ النَّاسِ قَدْ  مَرِجَتْ  عُهُودُهُمْ وَأَمَانَاتُهُمْ  ، وَاخْتَلَفُوا وَصَارُوا هَكَذَا ؟  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ ، قَالَ : فَكَيْفَ يَا رَسُولَ اللهِ ؟ قَالَ : تَأْخُذُ مَا تَعْرِفُ ، وَتَدَعُ مَا تُنْكِرُ ، وَتُقْبِلُ عَلَى خَاصَّتِكَ ، وَتَدَعُ عَوَامَّهُمْ  .         [9/443]             [9/444]","","Musnad Abi Ya'la al-Mawsili 5593","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن واقد بن محمد بن زيد العدوي عن عاصم بن محمد بن زيد العمري عن إسحاق بن منصور بن حيان الأسدي عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5596","180 - (  5594  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ عَبْدِ اللهِ الْمَخْزُومِيِّ ،  قَالَ  :  أَتَى عَبْدَ اللهِ بْنَ عُمَرَ رَجُلٌ فَقَالَ :  كَيْفَ أُوتِرُ ؟ قَالَ :  أَوْتِرْ  بِرَكْعَةٍ وَاحِدَةً  ، فَقَالَ : إِنِّي أَخْشَى أَنْ يَقُولَ النَّاسُ : هِيَ  الْبُتَيْرَاءُ  ، فَقَالَ : سُنَّةَ اللهِ وَسُنَّةَ رَسُولِهِ تُرِيدُ ؟ هَذِهِ سُنَّةُ اللهِ وَسُنَّةُ رَسُولِهِ  .         [9/445]","","Musnad Abi Ya'la al-Mawsili 5594","","عبد الله بن عمر بن الخطاب عن عبد الله بن المطلب بن عبد الله بن حنطب المخزومي عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5597","181 - (  5595  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ ابْنُ عُمَرَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ ، قَالَ :  حَجَجْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَصُمْ  ،  وَحَجَجْتُ مَعَ  أَبِي بَكْرٍ  ،  وَعُمَرَ  فَلَمْ         [9/446]      يَصُمْهُ ، وَحَجَجْتُ مَعَ  عُثْمَانَ  فَلَمْ يَصُمْهُ  ، وَأَنَا لَا أَصُومُهُ ، وَلَا آمُرُ بِهِ ، وَلَا أَنْهَى عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 5595","","عبد الله بن عمر بن الخطاب عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5598","182 - (  5596  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  سُفْيَانُ ،         [9/447]      عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَرِيَّةٍ ، فَحُصْنَا حَيْصَةً ، فَدَخَلْنَا  الْمَدِينَةَ  فَتَخَبَّأْنَا ، قَالَ : فَقُلْنَا : هَلَكْنَا يَا رَسُولَ اللهِ ، نَحْنُ الْفَرَّارُونَ ، قَالَ :  لَا ، بَلْ أَنْتُمُ  الْعَكَّارُونَ  ، وَأَنَا  فِئَتُكُمْ  .  183 - (  5597  ) -  قَالَ أَبُو عَلِيٍّ : وَزَادَ فِيهِ ابْنُ فُضَيْلٍ ،         [9/448]      عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  وَقَبَّلْنَا يَدَهُ  ،  يَعْنِي : النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 5596","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5599","184 - (  5598  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ بَشِيرٍ الْمُذَكِّرُ  ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ الْعَمِّيُّ ،  عَنْ  أَبِي  ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  تَوَضَّأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّةً مَرَّةً ، فَقَالَ :  هَذَا الْوُضُوءُ الَّذِي لَا يَقْبَلُ اللهُ الصَّلَاةَ إِلَّا بِهِ  ، ثُمَّ تَوَضَّأَ مَرَّتَيْنِ مَرَّتَيْنِ ، فَقَالَ : هَذَا الْقَصْدُ مِنَ الْوُضُوءِ يُضَاعَفُ لِصَاحِبِهِ أَجْرُهُ مَرَّتَيْنِ ، ثُمَّ تَوَضَّأَ ثَلَاثًا ثَلَاثًا ، فَقَالَ : هَذَا وُضُوئِي ، وَوُضُوءُ  خَلِيلِ  اللهِ  إِبْرَاهِيمَ  ، وَوُضُوءُ الْأَنْبِيَاءِ قَبْلِي ، وَهُوَ وَظِيفَةُ الْوُضُوءِ ، فَمَنْ تَوَضَّأَ وُضُوئِي هَذَا ، ثُمَّ قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، فُتِحَتْ لَهُ ثَمَانِيَةُ أَبْوَابِ الْجَنَّةِ يَدْخُلُ مِنْ أَيِّهَا شَاءَ  .         [9/449]             [9/450]      كذا في طبعة دار المأمون للتراث ، ولعل الصواب (محمد).","","Musnad Abi Ya'la al-Mawsili 5598","","عبد الله بن عمر بن الخطاب عن معاوية بن قرة عن زيد بن الحواري العمي عن عبد الرحيم بن زيد بن الحواري العمي عن محمد بن بشير الدعاء عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5600","185 - (  5599  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  كُلَيْبِ بْنِ وَائِلٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي مُلَيْكَةَ ،  قَالَ  :  إِنِّي لَقَاعِدٌ عِنْدَ ابْنِ عُمَرَ ، إِذْ أَتَاهُ رَجُلٌ ، فَقَالَ : أَشَهِدَ  عُثْمَانُ  بَدْرًا  ؟ قَالَ : لَا ، قَالَ : فَشَهِدَ بَيْعَةَ الرِّضْوَانِ ؟ قَالَ : لَا ، قَالَ : فَكَانَ مِمَّنْ تَوَلَّى يَوْمَ الْتَقَى الْجَمْعَانِ ؟ قَالَ : نَعَمْ ، قَالَ : فَانْطَلَقَ ، فَقِيلَ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنَّ هَذَا سَيُخْبِرُ أَنَّكَ تَنَقَّصْتَ  عُثْمَانَ  ، قَالَ : رُدُّوهُ عَلَيَّ ، قَالَ لَهُ  ابْنُ عُمَرَ  :  أَمَّا  يَوْمَ  بَدْرٍ  ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَلَّفَهُ لِحَاجَتِهِ ، فَأَسْهَمَ لَهُ ، وَلَمْ يَكُنْ لِيُسْهِمَ لِغَائِبٍ  ، وَأَمَّا بَيْعَةُ الرِّضْوَانِ ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَهُ إِلَى  أَهْلِ مَكَّةَ  ، فَأَخْرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدَيْهِ فَمَسَحَهَا عَلَى كَفِّهِ ، قَالَ : هَذِهِ  لِعُثْمَانَ  ، فَيَدُ رَسُولِ اللهِ خَيْرٌ مِنْ يَدِ  عُثْمَانَ  ،         [9/451]      وَأَمَّا يَوْمَ الْتَقَى الْجَمْعَانِ ، فَإِنَّ اللهَ قَدْ عَفَا عَنْهُمُ ، اذْهَبْ فَاجْهَدْ عَلَيَّ  جَهْدَكَ  .","","Musnad Abi Ya'la al-Mawsili 5599","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي مليكة النهدي عن كليب بن وائل بن بيحان اليشكري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5601","186 - (  5600  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  فُضَيْلٍ ،  عَنْ  عَطِيَّةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  سَجْدَةٌ مِنْ سُجُودِكُمْ أَطْوَلُ مِنْ ثَلَاثِ         [9/452]      سَجَدَاتٍ مِنْ سُجُودِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 5600","","عبد الله بن عمر بن الخطاب عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5602","187 - (  5601  ) -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  أَخْبَرَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ  عَنْ  هِشَامِ بْنِ سَعْدٍ ،  عَنْ  عُمَرَ بْنِ أُسَيْدٍ ،         [9/453]      عَنِ  ابْنِ عُمَرَ قَالَ :  كُنَّا نَقُولُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : النَّبِيُّ ، ثُمَّ  أَبُو بَكْرٍ  ، ثُمَّ  عُمَرُ  ، وَلَقَدْ أُعْطِيَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ثَلَاثَ خِصَالٍ ؛ لَأَنْ يَكُونَ فِيَّ وَاحِدَةٌ مِنْهُنَّ أَحَبُّ إِلَيَّ مِنْ حُمْرِ النَّعَمِ : تَزَوَّجَ  فَاطِمَةَ  وَوَلَدَتْ لَهُ ، وَغَلَّقَ الْأَبْوَابَ غَيْرَ بَابِهِ ، وَدَفَعَ  الرَّايَةَ  إِلَيْهِ يَوْمَ  خَيْبَرَ  .         [9/454]","","Musnad Abi Ya'la al-Mawsili 5601","","عبد الله بن عمر بن الخطاب عن عمرو بن أبي سفيان الثقفي عن هشام بن سعد المخزومي عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5603","188 - (  5602  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  ابْنُ الْمَاجِشُونِ يُوسُفُ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا نَعْدِلُ بِهِ أَحَدًا  ، ثُمَّ نَقُولُ : خَيْرُ النَّاسِ  أَبُو بَكْرٍ  ، ثُمَّ  عُمَرُ  ، ثُمَّ  عُثْمَانُ  ، ثُمَّ لَا نُفَاضِلُ  .         [9/455]","","Musnad Abi Ya'la al-Mawsili 5602","","عبد الله بن عمر بن الخطاب عن يعقوب بن أبي سلمة الماجشون عن يوسف بن يعقوب بن أبي سلمة الماجشون عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5604","189 - (  5603  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، نَحْوَهُ .         [9/456]","","Musnad Abi Ya'la al-Mawsili 5603","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن إسماعيل بن عياش الأحول عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5605","190 - (  5604  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  لَيْثِ بْنِ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ عُمَرَ نَحْوَهُ ، قَالَ : فَيَبْلُغُ ذَلِكَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَا يُنْكِرُهُ .","","Musnad Abi Ya'la al-Mawsili 5604","","عبد الله بن عمر بن الخطاب عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن يزيد بن هارون عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5606","191 - (  5605  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَلِّمُنَا  التَّشَهُّدَ  فِي الصَّلَاةِ  كَمَا يُعَلِّمُ الْمُكْتِبُ الْوِلْدَانَ  .         [9/457]","","Musnad Abi Ya'la al-Mawsili 5605","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن هشيم بن بشير عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5607","192 - (  5606  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنِي  أَبُو عَامِرٍ الْعَقَدِيُّ ،  حَدَّثَنَا  أَيُّوبُ بْنُ ثَابِتٍ الْمَدَنِيُّ ، قَالَ :  سَمِعْتُ  خَالِدَ بْنَ كَيْسَانَ ،  قَالَ  :  كُنْتُ مَعَ ابْنِ عُمَرَ قَاعِدًا فَمَرَّ فَتًى يَجُرُّ  سَبَلَهُ  ، فَقَالَ لِي : ادْعُ هَذَا ادْعُ هَذَا ، قَالَ : فَدَعَوْتُهُ ، قَالَ : فَقَالَ لَهُ : ارْفَعْ إِزَارَكَ ، قَالَ : فَرَفَعَهُ إِلَى فَوْقِ عَقِبِهِ ، فَقَالَ  ابْنُ عُمَرَ  :  هَكَذَا أُزُرُ رَسُولِ اللهِ ، أَوْ قَالَ : هَكَذَا أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَأْتَزِرَ  .         [9/458]","","Musnad Abi Ya'la al-Mawsili 5606","","عبد الله بن عمر بن الخطاب عن خالد بن كيسان الحجازي عن أيوب بن ثابت المكي عن أبو عامر العقدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5608","193 - (  5607  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  حَدَّثَنَا  أَيُّوبُ بْنُ ثَابِتٍ ،  عَنْ  خَالِدِ بْنِ كَيْسَانَ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ شَرِبَ خَمْرًا فَسَكِرَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ يَوْمًا  ، فَإِنْ مَاتَ مِنْهَا دَخَلَ النَّارَ  .         [9/459]             [9/460]","","Musnad Abi Ya'la al-Mawsili 5607","","عبد الله بن عمر بن الخطاب عن خالد بن كيسان الحجازي عن أيوب بن ثابت المكي عن أبو عامر العقدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5609","194 - (  5608  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  قُدَامَةَ بْنِ مُوسَى ،  عَنْ  أَيُّوبَ بْنِ حَصِينٍ         [9/461]      التَّمِيمِيِّ ،  عَنْ  أَبِي عَلْقَمَةَ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  يَسَارٍ مَوْلَى ابْنِ عُمَرَ ، قَالَ :  رَآنِي  ابْنُ عُمَرَ وَأَنَا أُصَلِّي بَعْدَ طُلُوعِ الْفَجْرِ ، قَالَ : يَا  يَسَارُ  ، كَمْ صَلَّيْتَ ؟ قُلْتُ : لَا أَدْرِي ، قَالَ : لَا دَرَيْتَ ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ عَلَيْنَا وَنَحْنُ نُصَلِّي هَذِهِ الصَّلَاةَ ، فَقَالَ :  أَلَا لِيُبَلِّغْ شَاهِدُكُمْ غَائِبَكُمْ أَنْ لَا صَلَاةَ بَعْدَ الْفَجْرِ إِلَّا سَجْدَتَيْنِ  .         [9/462]","","Musnad Abi Ya'la al-Mawsili 5608","","عبد الله بن عمر بن الخطاب عن يسار المدني مولى ابن عمر عن أبو علقمة الفارسي عن محمد بن الحصين الحنظلي عن قدامة بن موسى الجمحي عن وهيب بن خالد الكرابيسي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5610","195 - (  5609  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ النُّكْرِيُّ ، قَالَ :  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ ثَابِتِ بْنِ ثَوْبَانَ ،  أَخْبَرَنِي  أَبِي  ،  عَنْ  مَكْحُولٍ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنِ  ابْنِ عُمَرَ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ اللهَ يَقْبَلُ تَوْبَةَ عَبْدِهِ مَا لَمْ  يُغَرْغِرْ  .         [9/463]","","Musnad Abi Ya'la al-Mawsili 5609","","عبد الله بن عمر بن الخطاب عن جبير بن نفير بن مالك الحضرمي عن مكحول بن أبي مسلم عن ثابت بن ثوبان العبسي عن عبد الرحمن بن ثابت العنسي عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5611","196 - (  5610  ) -  حَدَّثَنَا  الْمُعَلَّى بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ : مِنْ أَيْنَ يَجُوزُ لِي أَنْ أَعْتَمِرَ ؟ فَقَالَ :  فَرَضَهَا  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِأَهْلِ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرَنٍ  .","","Musnad Abi Ya'la al-Mawsili 5610","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5612","197 - (  5611  ) -  حَدَّثَنَا  الْمُعَلَّى بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، وَسَأَلَهُ رَجُلٌ عَنِ  الثَّمَرَةِ  ، فَقَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ  الثَّمَرَةِ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Musnad Abi Ya'la al-Mawsili 5611","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5613","198 - (  5612  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،         [9/464]      أَخْبَرَنَا  عَبْدُ الْخَالِقِ بْنُ سَلَمَةَ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ ، يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ عِنْدَ الْمِنْبَرِ - وَأَشَارَ إِلَى مِنْبَرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدِمَ وَفْدُ  عَبْدِ الْقَيْسِ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلُوهُ عَنِ الْأَشْرِبَةِ ، فَنَهَاهُمْ عَنِ :  الدُّبَّاءِ  ،  وَالنَّقِيرِ  ،  وَالْحَنْتَمِ  ، فَقُلْتُ : يَا  أَبَا مُحَمَّدٍ  ،  وَالْمُزَفَّتِ  ؟ وَظَنَنَّا أَنَّهُ نَسِيَهُ ، فَقَالَ : لَمْ أَسْمَعْهُ يَوْمَئِذٍ مِنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، وَقَدْ كَانَ يَكْرَهُهُ  .         [9/465]             [9/466]","","Musnad Abi Ya'la al-Mawsili 5612","","عبد الله بن عمر بن الخطاب عن سعيد بن المسيب عن عبد الخالق بن سلمة الشيباني عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5614","199 - (  5613  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سَالِمُ بْنُ سَالِمٍ  ،  عَنْ  عَلِيِّ بْنِ عُرْوَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ قَادَ أَعْمَى أَرْبَعِينَ خُطْوَةً ، وَجَبَتْ لَهُ الْجَنَّةُ  .  كذا في طبعة دار المأمون للتراث ، ولعل الصواب : ( سلم بن سالم )","","Musnad Abi Ya'la al-Mawsili 5613","","عبد الله بن عمر بن الخطاب عن محمد بن المنكدر عن علي بن عروة القرشي عن سلم بن سالم البلخي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5615","200 - (  5614  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُقْبَلُ صَلَاةٌ         [9/467]      بِغَيْرِ طُهُورٍ  ، وَلَا صَدَقَةٌ مِنْ غُلُولٍ  .         [9/468]","","Musnad Abi Ya'la al-Mawsili 5614","","عبد الله بن عمر بن الخطاب عن مصعب بن سعد بن أبي وقاص عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5616","201 - (  5615  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  حَدَّثَنَا  زَائِدَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 5615","","عبد الله بن عمر بن الخطاب عن مصعب بن سعد بن أبي وقاص عن سماك بن حرب البكري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5617","202 - (  5616  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 5616","","عبد الله بن عمر بن الخطاب عن مصعب بن سعد بن أبي وقاص عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5618","203 - (  5617  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ الْحَنَفِيِّ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْبَيْتِ ، وَسَيَأْتِي مَنْ يَنْهَاكَ عَنْ ذَلِكَ  ،  وَابْنُ عَبَّاسٍ  جَالِسٌ إِلَى جَنْبِهِ  .         [9/469]","","Musnad Abi Ya'la al-Mawsili 5617","","عبد الله بن عمر بن الخطاب عن سماك بن الوليد اليمامي عن شعبة بن الحجاج عن علي بن الجعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5619","204 - (  5618  ) -  حَدَّثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  عَنْ  ثَابِتٍ التَّيْمِيِّ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا  خِفْتَ أَوْ خَشِيتَ  الصُّبْحَ فَوَاحِدَةً  .","","Musnad Abi Ya'la al-Mawsili 5618","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن ثابت بن يزيد الأحول العطار عن غسان بن الربيع الأزدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5620","205 - (  5619  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،         [9/470]      قَالَ :  كُنْتُ عِنْدَ ابْنِ عُمَرَ ، فَجَاءَهُ رَجُلٌ ، فَقَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ نَبِيذِ  الْجَرِّ  وَالدُّبَّاءِ  ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 5619","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5621","206 - (  5620  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ، فَإِذَا خِفْتَ الصُّبْحَ  فَأَوْتِرْ  بِوَاحِدَةٍ .","","Musnad Abi Ya'la al-Mawsili 5620","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن سليمان بن طرخان عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5622","207 - (  5621  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  كُلُّ مُسْكِرٍ خَمْرٌ  ، وَكُلُّ مُسْكِرٍ حَرَامٌ  .","","Musnad Abi Ya'la al-Mawsili 5621","","عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن معاذ بن معاذ بن نصر عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5623","208 - (  5622  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ وَ مُعَاذٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ مُسْكِرٍ خَمْرٌ  ، وَكُلُّ مُسْكِرٍ حَرَامٌ  .         [9/471]","","Musnad Abi Ya'la al-Mawsili 5622","","عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن معاذ بن معاذ بن نصر عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5624","209 - (  5623  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي لَبِيدٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَغْلِبَنَّكُمُ الْأَعْرَابُ عَلَى اسْمِ صَلَاتِكُمْ ،  أَلَا إِنَّهَا الْعِشَاءُ وَإِنَّهُمْ يُعْتِمُونَ بِالْإِبِلِ  .","","Musnad Abi Ya'la al-Mawsili 5623","","عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن عبد الله بن أبي لبيد مولى الأخنس بن شريق عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5625","210 - (  5624  ) -  حَدَّثَنَا  أَبُو الْوَلِيدِ الْقُرَشِيُّ ،  حَدَّثَنَا  الْوَلِيدُ ، قَالَ :  حَدَّثَنِي  حَنْظَلَةُ بْنُ أَبِي سُفْيَانَ ،  أَنَّهُ سَمِعَ  الْقَاسِمَ بْنَ مُحَمَّدٍ ، قَالَ :  كُنْتُ عِنْدَ عَبْدِ اللهِ بْنِ عُمَرَ ، إِذْ جَاءَهُ رَجُلٌ يُوَدِّعُهُ ،  فَقَالَ لَهُ  ابْنُ عُمَرَ  : انْتَظِرْ أُوَدِّعْكَ كَمَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُوَدِّعُنَا :         [9/472]      أَسْتَوْدِعُ اللهَ  دِينَكَ ،  وَأَمَانَتَكَ ،  وَخَوَاتِيمَ عَمَلِكَ  .         [9/473]             [9/474]","","Musnad Abi Ya'la al-Mawsili 5624","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن حنظلة الجمحي عن الوليد بن مسلم القرشي عن هشام بن عمار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5626","211 - (  5625  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَ :  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كُنْتُمْ ثَلَاثَةً فَلَا  يَتَنَاجَى  اثْنَانِ دُونَ صَاحِبِهِ  ، فَإِنَّ ذَلِكَ يُرِيبُهُ ، قَالَ : أَفَرَأَيْتَ إِنْ كَانُوا أَرْبَعَةً ؟ قَالَ : لَا يَضُرُّكَ  .         [9/475]             [9/476]","","Musnad Abi Ya'la al-Mawsili 5625","","عبد الله بن عمر بن الخطاب عن ذكوان السمان عن الأعمش عن إسماعيل بن زكريا شقوصا عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5627","212 - (  5626  ) -  حَدَّثَنِي  أَبُو بَكْرٍ الرَّمَادِيُّ ،  حَدَّثَنَا  ابْنُ أَبِي مَرْيَمَ ،  حَدَّثَنَا  نَافِعٌ - يَعْنِي : ابْنَ عُمَرَ - ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْهَبُ لِحَاجَتِهِ إِلَى  الْمُغَمَّسِ  ، قَالَ  نَافِعٌ  : نَحْوَ مِيلَيْنِ مِنْ  مَكَّةَ  .         [9/477]","","Musnad Abi Ya'la al-Mawsili 5626","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن نافع بن عمر بن عبد الله بن جميل الجمحي عن سعيد بن الحكم الجمحي عن أحمد بن منصور الرمادي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5628","213 - (  5627  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، فَقَالَ :  سَأَلْتُ  ابْنَ عُمَرَ ، عَنْ رَجُلٍ ، قَدِمَ بِعُمْرَةٍ فَطَافَ  بِالْبَيْتِ  ، وَلَمْ يَطُفْ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، أَيَأْتِي امْرَأَتَهُ ؟ فَقَالَ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَطَافَ  بِالْبَيْتِ  سَبْعًا ، وَصَلَّى خَلْفَ  الْمَقَامِ  رَكْعَتَيْنِ  ، وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  سَبْعًا ، وَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ  .         [9/478]","","Musnad Abi Ya'la al-Mawsili 5627","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5629","214 - (  5628  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَمْرٍو ، قَالَ  حَمَّادٌ  : وَلَيْثٌ ،  عَنْ  عَمْرٍو ،  عَنِ  ابْنِ عُمَرَ ،  يَرْفَعُ إِلَى  النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تُلْحِفُوا بِالْمَسْأَلَةِ  ، فَإِنَّهُ مَنْ يَسْتَخْرِجْ مِنَّا بِهَا شَيْئًا لَا يُبَارَكْ لَهُ فِيهِ  .         [9/479]","","Musnad Abi Ya'la al-Mawsili 5628","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن ليث بن أبي سليم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5630","215 - (  5629  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَمْرُو بْنُ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَطَافَ  بِالْبَيْتِ  سَبْعًا  ، وَصَلَّى خَلْفَ  الْمَقَامِ  رَكْعَتَيْنِ ، وَطَافَ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَقَدْ كَانَتْ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ  .","","Musnad Abi Ya'la al-Mawsili 5629","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5631","216 - (  5630  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَمْرٌو ،  أَنَّ  ابْنَ عُمَرَ حَدَّثَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِقَتْلِ الْكِلَابِ ، إِلَّا كَلْبَ مَاشِيَةٍ  ، أَوْ كَلْبَ صَيْدٍ ، قِيلَ  لِابْنِ عُمَرَ  : إِنَّ  أَبَا هُرَيْرَةَ  يَقُولُ : أَوْ كَلْبَ زَرْعٍ ؟ قَالَ : إِنَّ  لِأَبِي هُرَيْرَةَ  زَرْعًا  .         [9/480]","","Musnad Abi Ya'la al-Mawsili 5630","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5632","[10/5]      [ تَابِعْ  مُسْنَدَ  عَبْدِ اللهِ بْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُ ]  217 - (  5631  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ : إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ الْهُذَلِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ اشْتَرَى إِبِلًا  هِيمًا  مِنْ شَرِيكٍ  النَّوَّاسِ  فَوَجَدَ بِهَا شَيْئًا ، فَقَالَ : رَضِينَا بِقَضَاءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  عَدْوَى  .","","Musnad Abi Ya'la al-Mawsili 5631","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5633","218 - (  5632  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا         [10/6]      عَمْرُو بْنُ مُحَمَّدٍ الْعَنْقَزِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُدَيْلِ بْنِ وَرْقَاءَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ  عُمَرَ  ، سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ اعْتِكَافٍ عَلَيْهِ ، فَأَمَرَهُ أَنْ يَعْتَكِفَ فَيَصُومَ  ، فَبَيْنَا هُوَ مُعْتَكِفٌ إِذْ كَبَّرَ النَّاسُ ، فَقَالَ : مَا هَذَا يَا  عَبْدَ اللهِ  ؟ قَالَ : سَبْيُ  هَوَازِنَ  أَعْتَقَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  عُمَرُ  : وَتِيكَ الْجَارِيَةُ فَأَرْسِلْهَا مَعَهُمْ  .         [10/7]             [10/8]","","Musnad Abi Ya'la al-Mawsili 5632","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن عبد الله بن بديل بن ورقاء الخزاعي عن عمرو بن محمد الأحمر عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5634","219 - (  5633  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،         [10/9]      عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ قَالَ لِإِنْسَانٍ كَانَ كَثِيرَ الْأَكْلِ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  الْمُؤْمِنُ يَأْكُلُ فِي مِعَاءٍ وَاحِدٍ  ، وَالْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ .  فَقَالَ الرَّجُلُ : أَمَّا أَنَا فَأُومِنُ بِاللهِ وَرَسُولِهِ  .","","Musnad Abi Ya'la al-Mawsili 5633","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5635","220 - (  5634  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  سَأَلْنَاهُ عَنْ رَجُلٍ طَافَ  بِالْبَيْتِ  وَلَمْ يَطُفْ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  فِي عُمْرَةٍ ، أَيَأْتِي امْرَأَتَهُ ؟ . قَالَ : لَا  ،  وَسَأَلُوا  ابْنَ عُمَرَ  عَنْهُ ،  فَقَالَ  ابْنُ عُمَرَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَافَ  بِالْبَيْتِ  سَبْعًا  ، وَصَلَّى خَلْفَ  الْمَقَامِ  رَكْعَتَيْنِ ، وَطَافَ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ  .","","Musnad Abi Ya'la al-Mawsili 5634","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5636","221 - (  5635  ) -  حَدَّثَنَا  غَسَّانُ ،  عَنْ  ثَابِتٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،         [10/10]      عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  سَأَلَ  رَجُلٌ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنْ صَلَاةِ اللَّيْلِ - وَأَنَا بَيْنَهُمَا - قَالَ : فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثْنَى مَثْنَى ، فَإِذَا خَشِيتَ الصُّبْحَ ، فَصَلِّ رَكْعَةً ، وَرَكْعَتَيْنِ قَبْلَ الْغَدَاةِ  .","","Musnad Abi Ya'la al-Mawsili 5635","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن عاصم بن سليمان الأحول عن ثابت بن يزيد الأحول العطار عن غسان بن الربيع الأزدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5637","222 - (  5636  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي بَكْرٍ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ يَزِيدَ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ الْأَرْبِعَاءَ ، وَالْخَمِيسَ ، كُتِبَ لَهُ بَرَاءَةٌ مِنَ النَّارِ  .         [10/11]","","Musnad Abi Ya'la al-Mawsili 5636","","عبد الله بن عباس عن حنش بن عبد الله السبائي عن محمد بن يزيد بن أبي زياد الفلسطيني عن أبو بكر العنسي عن بقية بن الوليد عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5638","223 - (  5637  ) -  حَدَّثَنَا  سُوَيْدٌ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي بَكْرٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5637","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن أبو بكر العنسي عن بقية بن الوليد عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5639","224 - (  5638  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  مَسْجِدِ قُبَاءَ  ، فَجَاءَ نَاسٌ مِنَ  الْأَنْصَارِ  يُسَلِّمُونَ عَلَيْهِ وَهُوَ فِي الصَّلَاةِ  ، وَكَانَ مَعَهُ صُهَيْبٌ ،  فَسَأَلْتُهُ  كَيْفَ كَانَ يَرُدُّ عَلَيْهِمْ ؟ قَالَ : كَانَ يُشِيرُ إِلَيْهِمْ  .         [10/12]","","Musnad Abi Ya'la al-Mawsili 5638","","صهيب بن سنان الرومي عن عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن سفيان بن عيينة عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5640","225 - (  5639  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  مَالِكٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ رَجُلَانِ مِنَ الْمَشْرِقِ ، فَخَطَبَا فَعَجِبَ النَّاسُ مِنْ ثَنَائِهِمَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ بَعْضَ         [10/13]      الْبَيَانِ  سِحْرٌ  ، أَوْ :  إِنَّ مِنَ  الْبَيَانِ  سِحْرًا  .","","Musnad Abi Ya'la al-Mawsili 5639","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5641","226 - (  5640  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَجُلَيْنِ قَدِمَا فِي زَمَنِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَخَطَبَا ، فَعَجِبَ النَّاسُ مِنْ كَلَامِهِمَا ، فَالْتَفَتَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [10/14]      فَقَالَ :  إِنَّ مِنَ  الْبَيَانِ  سِحْرًا  ، أَوْ : إِنَّ بَعْضَ  الْبَيَانِ  سِحْرٌ  .","","Musnad Abi Ya'la al-Mawsili 5640","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5642","227 - (  5641  ) -  حَدَّثَنَا  أَبُو الْوَلِيدِ الْقُرَشِيُّ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  أَخْبَرَنِي  زُهَيْرُ بْنُ مُحَمَّدٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ،  أَنَّهُ أَخْبَرَهُ  ،  أَنَّهُ كَانَ يَرَى ابْنَ عُمَرَ مَحْلُولًا زِرُّ قَمِيصِهِ  ، فَسُئِلَ عَنْ ذَلِكَ ؟ فَقَالَ : رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .         [10/15]","","Musnad Abi Ya'la al-Mawsili 5641","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن زهير بن محمد التميمي عن الوليد بن مسلم القرشي عن أحمد بن عبد الرحمن بن بكار البسري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5643","228 - (  5642  ) -  حَدَّثَنَا  أَبُو يُوسُفَ يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  أَخْبَرَنِي  زَيْدُ بْنُ أَسْلَمَ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ ، كَانَ يُصَفِّرُ لِحْيَتَهُ بِالْخَلُوقِ ، فَقِيلَ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّكَ تُصَفِّرُ لِحْيَتَكَ بِالْخَلُوقِ ؟ قَالَ :  إِنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَفِّرُ بِهَا  ، وَلَمْ يَكُنْ شَيْءٌ مِنَ الصِّبْغِ أَحَبَّ إِلَيْهِ مِنْهَا ، وَلَقَدْ كَانَ يَصْبُغُ بِهَا ثِيَابَهُ كُلَّهَا حَتَّى عِمَامَتَهُ  .","","Musnad Abi Ya'la al-Mawsili 5642","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5644","229 - (  5643  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ أَسْلَمَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَسْجِدَ قُبَاءَ - وَهُوَ مَسْجِدُ بَنِي عَمْرِو بْنِ عَوْفٍ  - يُصَلِّي فِيهِ ، فَدَخَلَتْ عَلَيْهِ رِجَالٌ مِنَ  الْأَنْصَارِ  ، فَسَلَّمُوا عَلَيْهِ وَهُوَ فِي الصَّلَاةِ ،  فَسَأَلْتُ  صُهَيْبًا -         [10/16]      وَكَانَ دَاخِلًا مَعَهُ -  كَيْفَ كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ إِذَا سُلِّمَ عَلَيْهِ ؟ قَالَ : كَانَ يُشِيرُ بِيَدِهِ  .","","Musnad Abi Ya'la al-Mawsili 5643","","صهيب بن سنان الرومي عن عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5645","230 - (  5644  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  قَالَ  : دَخَلْتُ عَلَى ابْنِ عُمَرَ ، أَرْسَلَنِي إِلَيْهِ أَبِي ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَنْظُرُ اللهُ إِلَى مَنْ جَرَّ إِزَارَهُ مِنَ  الْخُيَلَاءِ  .","","Musnad Abi Ya'la al-Mawsili 5644","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5646","231 - (  5645  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنِي  ابْنُ الدَّرَاوَرْدِيِّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّهُ كَانَ يَصْبُغُ بِالصُّفْرَةِ ، فَقِيلَ لَهُ فِي ذَلِكَ : فَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصْبُغُ بِهَا  ، فَلَقَدْ رَأَيْتُهُ يَصْبُغُ بِهَا ثِيَابَهُ حَتَّى عِمَامَتَهُ  .","","Musnad Abi Ya'la al-Mawsili 5645","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5647","232 - (  5646  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِي هِشَامٍ الْأَيْلِيِّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ،  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  كُلُّ دَابَّةٍ مِنْ دَوَابِّ الْبَرِّ وَالْبَحْرِ لَيْسَ لَهُ دَمٌ يَتَفَصَّدُ ، فَلَيْسَتْ لَهُ ذَكَاةٌ  .         [10/17]","","Musnad Abi Ya'la al-Mawsili 5646","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن كثير بن عبد الله الأنسي عن سويد بن عبد العزيز السلمي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5648","233 - (  5647  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ حَيْثُ تَوَجَّهَتْ بِهِ . وَذَكَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ حَيْثُ تَوَجَّهَتْ بِهِ  ، وَقَرَأَ  ابْنُ عُمَرَ  :         {      فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللهِ         }      .","","Musnad Abi Ya'la al-Mawsili 5647","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الملك بن أبي سليمان العرزمي عن عبد الله بن المبارك عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5649","234 - (  5648  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُعْتَمِرٌ ، قَالَ :  قَرَأْتُ عَلَى  فُضَيْلٍ ،  عَنْ  أَبِي حَرِيزٍ ، قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ جُبَيْرٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ( نَعُدُّ صَوْمَ عَرَفَةَ صَوْمَ سَنَةٍ )  .         [10/18]             [10/19]","","Musnad Abi Ya'la al-Mawsili 5648","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5650","235 - (  5649  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ صَلَّى بِهِمْ  بِجَمْعٍ  بِأَذَانٍ وَإِقَامَةٍ صَلَاةَ الْمَغْرِبِ  ، ثُمَّ قَالَ : الصَّلَاةُ ! فَصَلَّى الْعِشَاءَ ، فَقِيلَ لَهُ فِي ذَلِكَ : فَقَالَ : هَكَذَا صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي هَذَا الْمَوْضِعِ  .","","Musnad Abi Ya'la al-Mawsili 5649","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن سلمة بن كهيل الحضرمي عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5651","236 - (  5650  ) -  حَدَّثَنَا  أَبُو الْحَارِثِ سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ، فَرَدَّ عَلَيَّ رَسُولُ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى طَلَّقْتُهَا وَهِيَ طَاهِرَةٌ  .","","Musnad Abi Ya'la al-Mawsili 5650","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5652","237 - (  5651  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  سَمِعَ  سَعِيدَ بْنَ جُبَيْرٍ ، يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْمُتَلَاعِنَيْنِ : حِسَابُكُمَا عَلَى اللهِ  ؛ أَحَدُكُمَا كَاذِبٌ ، لَا سَبِيلَ لَكَ عَلَيْهَا . قَالَ : يَا رَسُولَ اللهِ مَالِي !         [10/20]      قَالَ : لَا مَالَ لَكَ ، إِنْ كُنْتَ صَدَقْتَ عَلَيْهَا ، فَهُوَ بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِهَا ، وَإِنْ كُنْتَ كَذَبْتَ ، فَذَاكَ أَبْعَدُ لَكَ  .         [10/21]","","Musnad Abi Ya'la al-Mawsili 5651","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5653","238 - (  5652  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  أَخْبَرَنَا  أَبُو بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  قَالَ  :  مَرَّ ابْنُ عُمَرَ بِفِتْيَانٍ مِنْ  قُرَيْشٍ  ، وَقَدْ نَصَبُوا طَيْرًا وَهُمْ يَرْمُونَهُ ، وَقَدْ جَعَلُوا لِصَاحِبِ الطَّيْرِ كُلَّ خَاطِئَةٍ مِنْ نَبْلِهِمْ ، فَلَمَّا رَأَوُا  ابْنَ عُمَرَ  تَفَرَّقُوا ، فَقَالَ  ابْنُ عُمَرَ  : مَنْ فَعَلَ هَذَا ؟ لَعَنَ اللهُ مَنْ فَعَلَ هَذَا !  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَعَنَ مَنِ اتَّخَذَ شَيْئًا فِيهِ الرُّوحُ غَرَضًا  .         [10/22]","","Musnad Abi Ya'la al-Mawsili 5652","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5654","239 - (  5653  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، وَنَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ  حَبَلِ  الْحَبَلَةِ  .         [10/23]             [10/24]","","Musnad Abi Ya'la al-Mawsili 5653","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5655","240 - (  5654  ) -  حَدَّثَنَا  سُوَيْدٌ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  دَاوُدَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ تَكُونُ عَلَيْهِ الْوَرِقُ فَيُعْطِي قِيمَتَهَا دَنَانِيرَ إِذَا قَامَتْ عَلَى سِعْرٍ  . وَيَكُونُ عَلَيْهِ الدَّنَانِيرُ فَيُعْطِي الْوَرِقَ بِقِيمَتِهَا  .","","Musnad Abi Ya'la al-Mawsili 5654","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن داود بن أبي هند عن يحيى بن زكريا بن أبي زائدة عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5656","241 - (  5655  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  يَحْيَى ، قَالَ :  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  سَأَلْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ، فَقَالَ :  إِذَا أَخَذْتَ أَحَدَهُمَا بِالْآخَرِ فَلَا يُفَارِقْكَ وَبَيْنَكَ وَبَيْنَهُ بَيْعٌ  .         [10/25]             [10/26]      قَالَ  يَحْيَى  : وَبِذَلِكَ نَأْخُذُ .","","Musnad Abi Ya'la al-Mawsili 5655","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن زكريا بن أبي زائدة عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5657","242 - (  5656  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى الْخُتَّلِيُّ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  سُئِلْتُ عَنِ الْمُلَاعِنَيْنِ فِي زَمَنِ  مُصْعَبٍ  : أَيُفَرَّقُ بَيْنَهُمَا ؟ فَمَا دَرَيْتُ مَا أَقُولُ ، فَغَدَوْتُ إِلَى مَنْزِلِ عَبْدِ اللهِ بْنِ عُمَرَ ، فَاسْتَأْذَنْتُ عَلَيْهِ ، فَقَالُوا : هُوَ نَائِمٌ ، فَسَمِعَ صَوْتِي ،  فَقَالَ  :  ابْنُ جُبَيْرٍ  ؟ ائْذَنُوا لَهُ ، قَالَ : فَدَخَلْتُ عَلَيْهِ ، فَقَالَ : مَا جَاءَ بِكَ هَذِهِ السَّاعَةَ إِلَّا حَاجَةٌ .  قَالَ : فَإِذَا هُوَ مُفْتَرِشٌ بَرْذَعَةَ رَاحِلَتِهِ ، مُتَوَسِّدٌ بِوِسَادَةٍ حَشْوُهَا  لِيفٌ - أَوْ سُلْتٌ  - فَقُلْتُ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، الْمُتَلَاعِنَانِ يُفَرَّقُ بَيْنَهُمَا ؟ فَقَالَ : سُبْحَانَ اللهِ ! نَعَمْ ؛ إِنَّ أَوَّلَ مَنْ سَأَلَ عَنْ هَذَا  فُلَانُ بْنُ فُلَانٍ  ، أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ لَوْ أَنَّ أَحَدَنَا رَأَى امْرَأَتَهُ عَلَى فَاحِشَةٍ كَيْفَ يَصْنَعُ ؟ إِنْ تَكَلَّمَ تَكَلَّمَ         [10/27]      بِأَمْرٍ عَظِيمٍ ، وَإِنْ سَكَتَ سَكَتَ عَلَى مِثْلِ ذَلِكَ ؟ فَلَمْ يُجِبْهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا كَانَ بَعْدُ ، أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ الَّذِي سَأَلْتُكَ عَنْهُ ابْتُلِيتُ بِهِ ، فَأَنْزَلَ اللهُ الْآيَاتِ الَّتِي فِي سُورَةِ النُّورِ :         {      وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ         }      إِلَى آخِرِ الْآيَةِ . قَالَ : فَدَعَا بِالرَّجُلِ فَتَلَاهُنَّ عَلَيْهِ وَوَعَظَهُ ، وَذَكَّرَهُ ، وَأَخْبَرَهُ أَنَّ عَذَابَ الدُّنْيَا أَهْوَنُ مِنْ عَذَابِ الْآخِرَةِ .  قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا كَذَبْتُ عَلَيْهَا . قَالَ : ثُمَّ  دَعَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْمَرْأَةِ فَتَلَاهُنَّ عَلَيْهَا وَوَعَظَهَا ، وَذَكَّرَهَا  ، وَأَخْبَرَهَا أَنَّ عَذَابَ الدُّنْيَا أَهْوَنُ مِنْ عَذَابِ الْآخِرَةِ ، قَالَتْ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا صَدَقَ ، وَلَقَدْ كَذَبَ . قَالَ : فَبَدَأَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالرَّجُلِ فَشَهِدَ أَرْبَعَ شَهَادَاتٍ بِاللهِ إِنَّهُ لَمِنَ الصَّادِقِينَ ، وَالْخَامِسَةَ أَنَّ لَعْنَةَ اللهِ عَلَيْهِ إِنْ كَانَ مِنَ الْكَاذِبِينَ ، ثُمَّ دَعَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْمَرْأَةِ فَشَهِدَتْ أَرْبَعَ شَهَادَاتٍ بِاللهِ إِنَّهُ لَمِنَ الْكَاذِبِينَ ، وَالْخَامِسَةَ أَنَّ غَضَبَ اللهِ عَلَيْهَا إِنْ كَانَ مِنَ الصَّادِقِينَ ، ثُمَّ فَرَّقَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَهُمَا  .         [10/28]","","Musnad Abi Ya'la al-Mawsili 5656","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الملك بن أبي سليمان العرزمي عن إسحاق بن يوسف الأزرق عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5658","243 - (  5657  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ الْوَاسِطِيُّ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  حُسَيْنٍ يَعْنِي : ابْنَ قَيْسٍ الرَّحَبِيَّ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، كَأَنَّ فِي يَدَيْهِ سِوَارَيْنِ مِنْ ذَهَبٍ  ، قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَنَفَخْتُهُمَا فَطَارَا وَهُمَا كَذَّابَا أُمَّتِي : صَاحِبُ  الْيَمَامَةِ  ، وَصَاحِبُ  الْيَمَنِ  ، وَلَنْ يَضُرَّا أُمَّتِي شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 5657","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5659","244 - (  5658  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  حُسَيْنٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا يَنْبَغِي         [10/29]      لِلرَّجُلِ أَنْ يَلِيَ مَمْلُوكَهُ حَرَّ طَعَامِهِ وَبَرْدَهُ ، فَإِذَا حَضَرَ عَزَلَهُ عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 5658","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5660","245 - (  5659  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ، قَالَ :  قَالَ  ابْنُ عُمَرَ :  أَتَى عَلَيْنَا زَمَانٌ وَمَا نَرَى أَنَّ أَحَدَنَا أَحَقُّ بِالدَّنَانِيرِ وَالدَّرَاهِمِ مِنْ أَخِيهِ الْمُسْلِمِ ، حَتَّى كَانَ هَاهُنَا بِأَخَرَةٍ ، فَأَصْبَحَ الدَّنَانِيرُ وَالدَّرَاهِمُ أَحَبَّ إِلَى أَحَدِنَا مِنْ أَخِيهِ الْمُسْلِمِ ، وَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِذَا ضَنَّ النَّاسُ بِالدَّرَاهِمِ وَالدَّنَانِيرِ  وَتَبَايَعُوا  بِالْعِينَةِ  ، وَاتَّبَعُوا أَذْنَابَ الْبَقَرِ ، وَتَرَكُوا  الْجِهَادَ  ، بَعَثَ اللهُ عَلَيْهِمْ ذُلًّا ، ثُمَّ لَا يَنْزِعُهُ عَنْهُمْ حَتَّى يُرَاجِعُوا دِينَهُمْ  .         [10/30]             [10/31]             [10/32]","","Musnad Abi Ya'la al-Mawsili 5659","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن ليث بن أبي سليم عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5661","246 - (  5660  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  سَعِيدُ بْنُ رَاشِدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ فِي سَفَرٍ لَهُ ، فَلَمَّا حَضَرَتِ الصَّلَاةُ نَزَلَ  الْقَوْمُ  ، فَبَصُرَ بِهِمْ رَاعٍ  ، فَنَزَلَ يَضْرِبُ بِيَدِهِ الصَّعِيدَ ، فَتَيَمَّمَ ، ثُمَّ أَذَّنَ ، قَالَ : اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عَلَى الْفِطْرَةِ ، قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ : خَرَجَ مِنَ النَّارِ  .         [10/33]","","Musnad Abi Ya'la al-Mawsili 5660","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سعيد بن راشد السماك عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5662","247 - (  5661  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  حَدَّثَنَا  حُسَامُ بْنُ مِصَكٍّ ،  حَدَّثَنَا  عَطَاءُ بْنُ أَبِي رِيَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ لَا يَتَعَارَّ مِنَ اللَّيْلِ سَاعَةً إِلَّا أَجْرَى السِّوَاكَ عَلَى فِيهِ  .         [10/34]","","Musnad Abi Ya'la al-Mawsili 5661","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن حسام بن مصك الأزدي عن عبيد الله بن عبد المجيد الحنفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5663","248 - (  5662  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  أَبُو حَيَّانَ التَّيْمِيُّ  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ  أَعْرَابِيٌّ  ، فَقَالَ : هَلْ لَكَ فِي خَيْرٍ ؟ تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ . قَالَ : وَمَنْ يَشْهَدُ لَكَ ؟ . قَالَ : هَذِهِ  السَّلَمَةُ  ، فَدَعَاهَا وَهِيَ عَلَى شَاطِئِ الْوَادِي ، فَجَاءَتْ  تَخُدُّ  الْأَرْضَ حَتَّى قَامَتْ بَيْنَ يَدَيْهِ ، فَاسْتَشْهَدَهَا فَشَهِدَتْ ثَلَاثَ مَرَّاتٍ ، ثُمَّ رَجَعَتْ إِلَى مَكَانِهَا . فَقَالَ الْأَعْرَابِيُّ : آتِي قَوْمِي ، فَإِنْ تَابَعُونِي أَتَيْتُكَ بِهِمْ ، وَإِلَّا رَجَعْتُ إِلَيْكَ فَأَكُونَ مَعَكَ  .         [10/35]","","Musnad Abi Ya'la al-Mawsili 5662","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن يحيى بن سعيد التيمي عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5664","249 - (  5663  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ يَعْلَى بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ  ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ، وَطَاوُسٍ ، وَمُجَاهِدٍ ،  عَنْ  جَابِرٍ ، وَابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَطُفْ - هُوَ وَأَصْحَابُهُ لِعُمْرَتِهِمْ وَحَجِّهِمْ - إِلَّا طَوَافًا وَاحِدًا  .","","Musnad Abi Ya'la al-Mawsili 5663","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الليث بن سعد عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5665","250 - (  5664  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  وُهَيْبٌ ،  حَدَّثَنَا  عَمْرُو بْنُ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارٍ وَهُوَ مُتَوَجِّهٌ إِلَى  خَيْبَرَ  .         [10/36]","","Musnad Abi Ya'la al-Mawsili 5664","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5666","251 - (  5665  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  حَجَّاجٌ ، قَالَ ،  قَالَ  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ يَحْيَى بْنِ عُمَارَةَ ، أَنَّ سَعِيدَ بْنَ يَسَارٍ أَبَا الْحُبَابِ ،  أَخْبَرَهُ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ ، يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي وَهُوَ مُتَوَجِّهٌ إِلَى  تَبُوكَ  .","","Musnad Abi Ya'la al-Mawsili 5665","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن ابن جريج عن حجاج بن محمد الأعور عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5667","252 - (  5666  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  مَالِكٍ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارٍ وَهُوَ مُتَوَجِّهٌ إِلَى  خَيْبَرَ  .","","Musnad Abi Ya'la al-Mawsili 5666","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5668","253 - (  5667  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  أَبِي بَكْرٍ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْتَرَ عَلَى الْبَعِيرِ  .","","Musnad Abi Ya'la al-Mawsili 5667","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن أبو بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5669","254 - (  5668  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ - يَعْنِي : الْقَسْمَلِيَّ -  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ، قَالَ :         [10/37]      سَمِعَ  ابْنُ عُمَرَ رَجُلًا يَقُولُ : وَأَبِي ، فَقَالَ  ابْنُ عُمَرَ  : لَا تَحْلِفْ بِهَا  ؛ فَإِنَّ  عُمَرَ  كَانَ يَحْلِفُ بِهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا تَحْلِفْ بِهَا  .","","Musnad Abi Ya'la al-Mawsili 5668","","عبد الله بن عمر بن الخطاب عن سعد بن عبيدة السلمي عن الأعمش عن عبد العزيز بن مسلم الخراساني عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5670","255 - (  5669  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حَزْمٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَبِي بُرْدَةَ ، قَالَ :  أَتَيْتُ  الْمَدِينَةَ  فَأَتَانِي  عَبْدُ اللهِ بْنُ عُمَرَ ، فَقَالَ : هَلْ تَدْرِي لِمَ أَتَيْتُكَ ؟ قَالَ : قُلْتُ : لَا ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَحَبَّ أَنْ يَصِلَ أَبَاهُ فِي قَبْرِهِ ، فَلْيَصِلْ إِخْوَانَ أَبِيهِ بَعْدَهُ  . وَإِنَّهُ كَانَ بَيْنَ أَبِي  عُمَرَ  ، وَبَيْنَ أَبِيكَ إِخَاءٌ وَوُدٌّ ، فَأَحْبَبْتُ أَنْ أَصِلَ ذَلِكَ  .         [10/38]","","Musnad Abi Ya'la al-Mawsili 5669","","عبد الله بن عمر بن الخطاب عن أبو بردة بن أبي موسى الأشعري عن ثابت البناني عن حزم بن أبي حزم القطعي عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5671","256 - (  5670  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ يَرْفَعُ يَدَيْهِ كُلَّمَا رَكَعَ وَكُلَّمَا رَفَعَ ، فَقُلْتُ : مَا هَذَا ؟ فَقَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَقَامَ فِي الرَّكْعَتَيْنِ كَبَّرَ وَرَفَعَ يَدَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 5670","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عاصم بن كليب الجرمي عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5672","257 - (  5671  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنِ         [10/39]      الدُّبَّاءِ  وَالْحَنْتَمِ  ، قَالَ : وَأُرَاهُ قَالَ :  وَالنَّقِيرِ  .","","Musnad Abi Ya'la al-Mawsili 5671","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن شعبة بن الحجاج عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5673","258 - (  5672  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُرَاتٍ ، قَالَ :  اخْتَصَمَ إِلَى  مُحَارِبٍ  رَجُلَانِ ، فَقَالَ : فَشَهِدَ عَلَى أَحَدِهِمَا  رَجُلٌ  ، فَقَالَ الْمَشْهُودُ عَلَيْهِ : وَاللهِ مَا عَلِمْتُ إِنَّهُ لَرَجُلُ صِدْقٍ ، وَلَئِنْ سَأَلْتَ عَنْهُ  لَيُحْمَدَنَّ - أَوْ لَيُزَكَّيَنَّ -  ، وَلَقَدْ شَهِدَ عَلَيَّ بِبَاطِلٍ ، مَا أَدْرِي مَا اجْتَرَأَهُ عَلَى ذَلِكَ ؟ . قَالَ :  فَقَالَ  مُحَارِبُ بْنُ دِثَارٍ : يَا هَذَا اتَّقِ اللهَ ! فَإِنِّي  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  شَاهِدُ  الزُّورِ  لَا تَزُولُ قَدَمَاهُ حَتَّى تَجِبَ لَهُ النَّارُ  ، وَإِنَّ الطَّيْرَ يَوْمَ الْقِيَامَةِ لَتَضْرِبُ بِأَجْنِحَتِهَا وَتَرْمِي مَا فِي أَجْوَافِهَا مَا لَهَا طَلِبَةٌ . وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَعِظُ رَجُلًا  .         [10/40]","","Musnad Abi Ya'la al-Mawsili 5672","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن محمد بن الفرات الجرمي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5674","259 - (  5673  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا إِذَا كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَكَانَتْ  لَيْلَةٌ ظَلْمَاءُ - أَوْ لَيْلَةٌ مَطِيرَةٌ -  أَذَّنَ مُؤَذِّنُ رَسُولِ اللهِ         [10/41]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْ نَادَى مُنَادِيهِ  : أَنْ  صَلُّوا فِي رِحَالِكُمْ  .         [10/42]","","Musnad Abi Ya'la al-Mawsili 5673","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5675","260 - (  5674  ) -  حَدَّثَنَا  أَبُو الْوَلِيدِ الْقُرَشِيُّ ،  حَدَّثَنَا  الْوَلِيدُ ، قَالَ :  حَدَّثَنِي  حَنْظَلَةُ بْنُ أَبِي سُفْيَانَ ،  أَنَّهُ سَمِعَ  الْقَاسِمَ بْنَ مُحَمَّدٍ ، قَالَ :  كُنْتُ عِنْدَ عَبْدِ اللهِ بْنِ عُمَرَ إِذْ جَاءَهُ رَجُلٌ يُوَدِّعُهُ ،  فَقَالَ  ابْنُ عُمَرَ  : انْتَظِرْ أُوَدِّعْكَ كَمَا  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوَدِّعُنَا : أَسْتَوْدِعُ اللهَ  دِينَكَ  ،  وَأَمَانَتَكَ  وَخَوَاتِيمَ عَمَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5674","","عبد الله بن عمر بن الخطاب عن القاسم بن محمد بن أبي بكر الصديق عن حنظلة الجمحي عن الوليد بن مسلم القرشي عن هشام بن عمار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5676","261 - (  5675  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنِ  الْقَاسِمِ بْنِ رَبِيعَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى دَرَجَةِ  الْكَعْبَةِ  يَوْمَ الْفَتْحِ  ، فَقَالَ : الْحَمْدُ لِلهِ الَّذِي صَدَقَ وَعْدَهُ  ، وَنَصَرَ عَبْدَهُ ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ ، أَلَا إِنَّ قَتِيلَ الْعَمْدِ  الْخَطَأِ  بِالسَّوْطِ  وَالْعَصَا ،  فِي الْعَمْدِ مِائَةٌ         [10/43]      مِنَ الْإِبِلِ ، مِنْهَا أَرْبَعُونَ  خَلِفَةً  فِي بُطُونِهَا أَوْلَادُهَا ، أَلَا إِنَّ كُلَّ دَمٍ  وَمَأْثُرَةٍ  فِي الْجَاهِلِيَّةِ ، فَهُوَ تَحْتَ  قَدَمَيَّ  هَاتَيْنِ ، إِلَّا مَا كَانَ مِنْ  سِدَانَةِ  الْبَيْتِ  وَسِقَايَةِ الْحَاجِّ ، فَإِنِّي أُمْضِيهِمَا لِأَهْلِهِمَا كَمَا كَانَا  .         [10/44]             [10/45]","","Musnad Abi Ya'la al-Mawsili 5675","","عبد الله بن عمر بن الخطاب عن القاسم بن ربيعة بن جوشن الغطفاني عن علي بن زيد بن جدعان عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5677","262 - (  5676  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  قَالَ  :  كَانَ عَبْدُ اللهِ بْنُ عُمَرَ إِذَا أَوَى إِلَى فِرَاشِهِ قَالَ :  اللَّهُمَّ أَنْتَ خَلَقْتَ نَفْسِي ، وَأَنْتَ تَتَوَفَّاهَا  ، لَكَ مَحْيَاهَا وَمَمَاتُهَا ، اللَّهُمَّ إِنْ تَوَفَّيْتَهَا فَاغْفِرْ لَهَا ، وَإِنْ أَحْيَيْتَهَا فَاحْفَظْهَا ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَافِيَةَ . فَقَالَ لَهُ رَجُلٌ مِنْ وَلَدِهِ : يَا أَبَهْ ، أَكَانَ  عُمَرُ  يَقُولُ هَذَا ؟ قَالَ : بَلْ خَيْرٌ مِنْ  عُمَرَ  كَانَ يَقُولُهُ ، قَالَ : فَظَنَنَّا أَنَّهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 5676","","عبد الله بن عمر بن الخطاب عن عبد الله بن الحارث الأنصاري عن خالد الحذاء عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5678","263 - (  5677  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ         [10/46]      أَبِي زَائِدَةَ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُقْبَلُ صَلَاةٌ بِغَيْرِ طُهُورٍ ، وَلَا صَدَقَةٌ مِنْ غُلُولٍ  .","","Musnad Abi Ya'la al-Mawsili 5677","","عبد الله بن عمر بن الخطاب عن مصعب بن سعد بن أبي وقاص عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5679","264 - (  5678  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ جَنَابٍ ،  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غَيِّرُوا الشَّيْبَ وَلَا تَشَبَّهُوا بِالْيَهُودِ  .","","Musnad Abi Ya'la al-Mawsili 5678","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عيسى بن يونس بن أبي إسحاق عن أحمد بن جناب المصيصي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5680","265 - (  5679  ) -  حَدَّثَنَا  الْحَكَمُ بْنُ مُوسَى السِّمْسَارُ ،  حَدَّثَنَا  هِقْلُ ،  عَنِ  الْأَوْزَاعِيِّ ، قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  عُرْوَةَ قَالَ :  قُلْتُ  لِابْنِ عُمَرَ :  يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنَّا لَنَدْخُلُ عَلَى الْإِمَامِ يَقْضِي بِالْقَضَاءِ نَرَاهُ جَوْرًا ، فَنَقُولُ  : وَفَّقَكَ اللهُ ، وَنَنْظُرُ إِلَى الرَّجُلِ مِنَّا فَنُثْنِي عَلَيْهِ ؟ ! فَقَالَ : أَمَّا نَحْنُ مَعْشَرَ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكُنَّا نَعُدُّ هَذَا نِفَاقًا ، فَمَا أَدْرِي مَا تَعُدُّونَهُ أَنْتُمْ  ؟ .         [10/47]","","Musnad Abi Ya'la al-Mawsili 5679","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن هقل بن زياد السكسكي عن الحكم بن موسى بن أبي زهير النسائي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5681","266 - (  5680  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَفَ عَلَى  قَلِيبِ بَدْرٍ  فَقَالَ : هَلْ وَجَدْتُمْ مَا وَعَدَكُمْ رَبُّكُمْ حَقًّا ؟  ثُمَّ قَالَ : إِنَّهُمْ لَيَسْتَمِعُونَ مَا أَقُولُ .  فَذُكِرَ ذَلِكَ  لِعَائِشَةَ فَقَالَتْ :  وَهِلَ  - تَعْنِي :  ابْنَ عُمَرَ  - إِنَّمَا قَالَ : الْآنَ لَيَعْلَمُونَ أَنَّ الَّذِي كُنْتُ أَقُولُ لَهُمْ هُوَ الْحَقُّ . ثُمَّ قَرَأَتْ هَذِهِ الْآيَةَ :         {      إِنَّكَ لا تُسْمِعُ الْمَوْتَى         }      حَتَّى فَرَغَتْ مِنَ الْآيَةِ  .         [10/48]","","Musnad Abi Ya'la al-Mawsili 5680","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5682","267 - (  5681  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْمَيِّتَ لَيُعَذَّبُ بِبُكَاءِ أَهْلِهِ عَلَيْهِ  .  فَذَكَرْتُ  ذَلِكَ لِعَائِشَةَ ، فَقَالَتْ :  وَهِلَ  - تَعْنِي :  ابْنَ عُمَرَ  - إِنَّمَا مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى قَبْرٍ ، فَقَالَ : إِنَّ صَاحِبَ هَذَا الْقَبْرِ لَيُعَذَّبُ وَأَهْلُهُ يَبْكُونَ عَلَيْهِ . ثُمَّ قَرَأَتْ هَذِهِ الْآيَةَ :         {      وَلا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى         }      .","","Musnad Abi Ya'la al-Mawsili 5681","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5683","268 - (  5682  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَادَى  رَجُلٌ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  أَيُّ اللَّيْلِ  أَجْوَبُ  دَعْوَةً ؟ قَالَ :  جَوْفُ  اللَّيْلِ الْآخِرُ  .         [10/49]","","Musnad Abi Ya'la al-Mawsili 5682","","عبد الله بن عمر بن الخطاب عن أبو قلابة الجرمي عن خالد الحذاء عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5684","269 - (  5683  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا بَدَا         [10/50]      حَاجِبُ الشَّمْسِ فَأَخِّرُوا الصَّلَاةَ حَتَّى تَبْرُزَ  ، وَإِذَا غَابَ حَاجِبُ الشَّمْسِ فَأَخِّرُوا الصَّلَاةَ حَتَّى تَغْرُبَ  .","","Musnad Abi Ya'la al-Mawsili 5683","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5685","270 - (  5684  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تَحَرَّوْا  بِصَلَاتِكُمْ طُلُوعَ الشَّمْسِ فَإِنَّهَا تَطْلُعُ بِقَرْنَيِ الشَّيْطَانِ  .         [10/51]","","Musnad Abi Ya'la al-Mawsili 5684","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5686","271 - (  5685  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو ،  حَدَّثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، قُلْ لِي قَوْلًا وَأَقْلِلْ لَعَلِّي أَعْقِلُهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَغْضَبْ  ، فَأَعَدْتُ مَرَّتَيْنِ ، كُلَّ ذَلِكَ يَرْجِعُ إِلَيَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا تَغْضَبْ  .","","Musnad Abi Ya'la al-Mawsili 5685","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5687","272 - (  5686  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  شَرِبَ  الْخَمْرَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ صَبَاحًا  ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، وَإِنْ عَادَ لَمْ         [10/52]      تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ صَبَاحًا ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ صَبَاحًا ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ الرَّابِعَةَ لَمْ تُقْبَلْ لَهُ أَرْبَعِينَ صَبَاحًا ، فَإِنْ تَابَ لَمْ يَتُبِ اللهُ عَلَيْهِ ، وَسَقَاهُ مِنْ نَهَرِ  الْخَبَالِ  ، فَقِيلَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، وَمَا نَهَرُ  الْخَبَالِ  ؟ قَالَ : نَهَرٌ مِنْ  صَدِيدِ  أَهْلِ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5686","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5688","273 - (  5687  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  ابْنَ عُمَرَ  كَانَ يُزَاحِمُ عَلَى  الرُّكْنَيْنِ  ، فَقُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنِّي رَأَيْتُكَ تُزَاحِمُ عَلَى  الرُّكْنَيْنِ  زِحَامًا مَا رَأَيْتُ أَحَدًا مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُزَاحِمُ عَلَيْهِ ؟ . قَالَ : إِنْ أَفْعَلْ فَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : مَسْحُهُمَا كَفَّارَةٌ لِلْخَطَايَا . وَسَمِعْتُهُ يَقُولُ :  مَنْ طَافَ  بِالْبَيْتِ  أُسْبُوعًا  فَأَحْصَاهُ ، كَانَ لَهُ كَعِتْقِ رَقَبَةٍ  .         [10/53]      وَسَمِعْتُهُ يَقُولُ : لَا يَضَعُ قَدَمًا وَلَا يَرْفَعُ أُخْرَى إِلَّا حَطَّ اللهُ عَنْهُ بِهَا خَطِيئَةً ، وَكَتَبَ لَهُ بِهَا حَسَنَةً ، وَرُفِعَتْ لَهُ بِهَا دَرَجَةٌ  .         [10/54]","","Musnad Abi Ya'la al-Mawsili 5687","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5689","274 - (  5688  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هُشَيْمٌ ،  حَدَّثَنَا  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  أَنَّهُ سَمِعَ  أَبَاهُ  ، يَقُولُ :  قُلْتُ  لِابْنِ عُمَرَ : مَا لِي أَرَاكَ لَا تَسْتَلِمُ إِلَّا هَذَيْنِ الرُّكْنَيْنِ :  الْحَجَرَ الْأَسْوَدَ  ،  وَالرُّكْنَ الْيَمَانِيَ  ؟ قَالَ :  فَقَالَ  ابْنُ عُمَرَ  : إِنْ أَفْعَلْ فَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اسْتِلَامَهُمَا يَحُطُّ الْخَطَايَا  . وَسَمِعْتُهُ يَقُولُ : مَنْ طَافَ  سُبُوعًا  يُحْصِيهِ ، وَصَلَّى رَكْعَتَيْنِ كَانَ لَهُ  كَعَدْلِ  رَقَبَةٍ . وَسَمِعْتُهُ يَقُولُ : مَا رَفَعَ رَجُلٌ  قَدَمًا ،  وَلَا وَضَعَهَا إِلَّا كُتِبَتْ لَهُ         [10/55]      عَشْرُ حَسَنَاتٍ ، وَحُطَّ عَنْهُ عَشْرُ سَيِّئَاتٍ ، وَرُفِعَ لَهُ عَشْرُ دَرَجَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 5688","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5690","275 - (  5689  ) -  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ ،  أَنَّهُ سَمِعَ  أَبَاهُ  يَقُولُ  لِابْنِ عُمَرَ :  مَا لَكَ أَرَاكَ تَسْتَلِمُ هَذَيْنِ الرُّكْنَيْنِ لَا تَسْتَلِمُ غَيْرَهُمَا ؟ يَعْنِي :  الْحَجَرَ الْأَسْوَدَ  ،  وَالرُّكْنَ الْيَمَانِيَ  .  فَقَالَ : إِنْ أَفْعَلْ فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : إِنَّ اسْتِلَامَهُمَا يَحُطُّ الْخَطَايَا ، وَمَا رَفَعَ رَجُلٌ  قَدَمًا ،  وَلَا وَضَعَهَا إِلَّا كُتِبَتْ لَهُ عَشْرُ حَسَنَاتٍ ، وَحُطَّ عَنْهُ عَشْرُ سَيِّئَاتٍ . وَسَمِعْتُهُ يَقُولُ :  مَنْ أَحْصَى  سُبُوعًا  ، وَصَلَّى رَكْعَتَيْنِ كَانَ كَعِتْقِ رَقَبَةٍ  .","","Musnad Abi Ya'la al-Mawsili 5689","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5691","276 - (  5690  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  ثَابِتٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ  :  أَفَعَلْتَ كَذَا وَكَذَا ؟ قَالَ : لَا وَالَّذِي لَا إِلَهَ إِلَّا اللهُ مَا فَعَلْتُ ، فَقَالَ لَهُ  جِبْرِيلُ  : قَدْ فَعَلَ ، وَلَكِنَّ اللهَ تَبَارَكَ وَتَعَالَى قَدْ غَفَرَ لَهُ بِقَوْلِ : لَا إِلَهَ إِلَّا اللهُ  .         [10/56]      قَالَ  حَمَّادٌ  : لَمْ يَسْمَعْ هَذَا مِنِ  ابْنِ عُمَرَ  ، بَيْنَهُمَا رَجُلٌ .","","Musnad Abi Ya'la al-Mawsili 5690","","عبد الله بن عمر بن الخطاب عن ثابت البناني عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5692","277 - (  5691  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ ، عَنِ الْأَوْعِيَةِ ؟ فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ تِلْكَ الْأَوْعِيَةِ  .         [10/57]","","Musnad Abi Ya'la al-Mawsili 5691","","عبد الله بن عمر بن الخطاب عن ثابت البناني عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5693","278 - (  5692  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  صَالِحٌ الْمُرِّيُّ ، قَالَ :  شَهِدْتُ بَكْرَ بْنَ عَبْدِ اللهِ الْمُزَنِيَّ ، وَسَأَلَهُ  رَجُلٌ  عَنْ تَلْبِيَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَحَدَّثَنَا  ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا لَبَّى ، قَالَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ ، وَالنِّعْمَةَ ، لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .  قَالَ  ابْنُ عُمَرَ  :  وَزِيدَ  :  لَبَّيْكَ  لَبَّيْكَ ،  لَبَّيْكَ  وَسَعْدَيْكَ ،  وَالْخَيْرُ فِي يَدَيْكَ ،  لَبَّيْكَ  وَالرَّغْبَاءُ إِلَيْكَ وَالْعَمَلُ .         [10/58]             [10/59]","","Musnad Abi Ya'la al-Mawsili 5692","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن صالح بن بشير المري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5694","279 - (  5693  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ، قَالَ :  حَدَّثَ  حُمَيْدٌ ،  عَنْ  بَكْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  مُلَبِّينَ بِالْحَجِّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : اجْعَلُوهَا عُمْرَةً  إِلَّا مَنْ كَانَ مَعَهُ الْهَدْيُ ، قَالُوا : يَا رَسُولَ اللهِ ، يَعْدُو أَحَدُنَا إِلَى  مِنًى  ، وَذَكَرُهُ يَقْطُرُ مَنِيًّا ؟ قَالَ : نَعَمْ . فَسَطَعَتِ  الْمَجَامِرُ  بِالْبَطْحَاءِ  وَقَدِمَ عَلِيٌّ مِنَ  الْيَمَنِ  ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : بِمَ أَهْلَلْتَ ، فَإِنَّ مَعَنَا أَهْلَكَ ؟ قَالَ : أَهْلَلْتُ بِمَا أَهَلَّ بِهِ رَسُولُ اللهِ  .  قَالَ  حُمَيْدٌ  : فَأَخْبَرْتُ بِذَلِكَ  الْقَوْمَ  ،  وَطَاوُسٌ  جَالِسٌ ، فَقَالَ : هَكَذَا الْحَدِيثُ .         [10/60]","","Musnad Abi Ya'la al-Mawsili 5693","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5695","280 - (  5694  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ،  أَخْبَرَنَا  حُمَيْدٌ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ ، وَالْعَصْرَ ، وَالْمَغْرِبَ ، وَالْعِشَاءَ  بِالْبَطْحَاءِ  ، ثُمَّ هَجَعَ هَجْعَةً  ، ثُمَّ دَخَلَ  مَكَّةَ  ،  وَكَانَ  ابْنُ عُمَرَ  يَفْعَلُهُ  .         [10/61]","","Musnad Abi Ya'la al-Mawsili 5694","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5696","281 - (  5695  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  حَدَّثَنَا  حَبِيبُ بْنُ الشَّهِيدِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَنَسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ بِهِمَا جَمِيعًا  . قَالَ  بَكْرٌ  : فَلَقِيتُ  ابْنَ عُمَرَ  فَأَخْبَرْتُهُ ، بِقَوْلِ  أَنَسٍ  .  فَقَالَ  ابْنُ عُمَرَ : إِنَّمَا أَهَلَّ بِالْحَجِّ .  فَرَجَعْتُ إِلَى  أَنَسٍ  فَأَخْبَرْتُهُ بِقَوْلِ  ابْنِ عُمَرَ  ، فَقَالَ :  مَا تَعُدُّونَنَا إِلَّا صِبْيَانًا - أَوْ كَأَنَّمَا كُنَّا صِبْيَانًا  -  شَكَّ  سَعِيدٌ  .","","Musnad Abi Ya'la al-Mawsili 5695","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حبيب بن الشهيد عن سعيد بن عامر الضبعي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5697","282 - (  5696  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ         [10/62]      بْنُ زَكَرِيَّا ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَأَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هُنَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَنْزَلَ اللهُ عَلَى قَوْمٍ الْعَذَابَ  ، أَصَابَ الْعَذَابُ مَنْ بَيْنَ أَظْهُرِهِمْ ، ثُمَّ يُبْعَثُونَ عَلَى نِيَّاتِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 5696","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن هنيدة مولى عمر بن الخطاب عن الزهري عن حجاج بن أرطاة عن إسماعيل بن زكريا شقوصا عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5698","283 - (  5697  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  بَشَّارِ بْنِ كِدَامٍ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَلِفُ  حِنْثٌ  أَوْ نَدَمٌ  .","","Musnad Abi Ya'la al-Mawsili 5697","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن بشار بن كدام الهلالي عن أبو معاوية الضرير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5699","284 - (  5698  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عُثْمَانَ بْنِ أَبِي زُرْعَةَ ،  عَنِ  الْمُهَاجِرِ الشَّامِيِّ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَبِسَ  ثَوْبَ  شُهْرَةٍ  ، أَلْبَسَهُ اللهُ يَوْمَ الْقِيَامَةِ  ثَوْبَ  مَذَلَّةٍ  .         [10/63]","","Musnad Abi Ya'la al-Mawsili 5698","","عبد الله بن عمر بن الخطاب عن مهاجر بن عمرو النبال عن عثمان بن المغيرة الأعشى عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5700","285 - (  5699  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  أَبُو بُكَيْرٍ ابْنُ عَمِّ حَفْصِ بْنِ غِيَاثٍ النَّخَعِيِّ ،  عَنْ  جَمِيلِ بْنِ زَيْدٍ الطَّائِيِّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ، قَالَ :  تَزَوَّجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  امْرَأَةً مِنْ بَنِي غِفَارٍ  ، فَلَمَّا دَخَلَتْ عَلَيْهِ رَأَى بِكَشْحِهَا وَضَحًا فَرَدَّهَا  ، وَقَالَ : دَلَّسْتُمْ لِي  .         [10/64]             [10/65]","","Musnad Abi Ya'la al-Mawsili 5699","","عبد الله بن عمر بن الخطاب عن جميل بن زيد الطائي عن الوليد بن بكير الطهوي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5701","286 - (  5700  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذِ بْنِ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَائِذِ بْنِ نُصَيْبٍ ،  سَمِعَ  ابْنَ عُمَرَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْكَعْبَةِ  .","","Musnad Abi Ya'la al-Mawsili 5700","","عبد الله بن عمر بن الخطاب عن عائذ بن نصيب الأسدي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5702","287 - (  5701  ) -  حَدَّثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  لَيْثٍ ،  عَنْ  سَعِيدِ بْنِ عَامِرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ فِي أُمَّتِي لَنَيِّفًا وَسَبْعِينَ دَاعِيًا كُلُّهُمْ دَاعٍ إِلَى النَّارِ  ، لَوْ أَشَاءُ لَأَنْبَأْتُكُمْ بِآبَائِهِمْ وَقَبَائِلِهِمْ .  قَالَ : ثُمَّ مَرَرْنَا عَلَى بِرَكٍ ، قَالَ : فَجَعَلْنَا نَكْرَعُ فِيهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا تَكْرَعُوا وَلَكِنِ اغْسِلُوا أَيْدِيَكُمْ ، ثُمَّ اشْرَبُوا فِيهَا ، فَإِنَّهُ لَيْسَ مِنْ إِنَاءٍ أَطْيَبُ مِنَ الْيَدِ  .         [10/66]","","Musnad Abi Ya'la al-Mawsili 5701","","عبد الله بن عمر بن الخطاب عن سعيد بن عامر عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5703","288 - (  5702  ) -  وَبِهِ  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَزَالُ هَذَا الْحَيُّ مِنْ  قُرَيْشٍ  آمِنِينَ حَتَّى تَرُدُّوهُمْ عَنْ دِينِهِمْ كِفَاءَ رَحِمِنَا  ، قَالَ : فَقَامَ إِلَيْهِ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، أَفِي الْجَنَّةِ أَنَا أَمْ فِي النَّارِ ؟ قَالَ : فِي الْجَنَّةِ ، ثُمَّ قَامَ إِلَيْهِ آخَرُ ، فَقَالَ : أَفِي الْجَنَّةِ أَمْ فِي النَّارِ ؟ [ قَالَ : فِي النَّارِ ] ، ثُمَّ قَالَ : اسْكُتُوا عَنِّي مَا سَكَتُّ عَنْكُمْ ، فَلَوْلَا أَنْ لَا تَدَافَنُوا لَأَخْبَرْتُكُمْ بِمَلَئِكُمْ مِنْ أَهْلِ النَّارِ حَتَّى         [10/67]      تُفَرِّقُوهُمْ ، عِنْدَ الْمَوْتِ ، وَلَوْ أُمِرْتُ أَنْ أَفْعَلَ لَفَعَلْتُ  .","","Musnad Abi Ya'la al-Mawsili 5702","","عبد الله بن عمر بن الخطاب عن سعيد بن عامر عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5704","289 - (  5703  ) -  وَبِهِ  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ قَالَ :  أَلَا أُرِيكُمُ الْمَكَانَ الَّذِي قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ دَابَّةَ الْأَرْضِ تَخْرُجُ مِنْهُ  ، فَضَرَبَ بِعَصَاهُ الشَّقَّ الَّذِي فِي  الصَّفَا  ، فَقَالَ : وَإِنَّهَا ذَاتُ رِيشٍ  وَزَغَبٍ  ، وَإِنَّهُ لَيَخْرُجُ ثُلُثُهَا حُضْرَ الْفَرَسِ الْجَوَادِ ثَلَاثَةَ أَيَّامٍ ، وَثَلَاثَ لَيَالٍ ، وَإِنَّهَا لَتَمُرُّ عَلَيْهِمْ ، وَإِنَّهُمْ لَيَفِرُّونَ مِنْهَا إِلَى الْمَسَاجِدِ ، فَتَقُولُ لَهُمْ : أَتَرَوْنَ الْمَسَاجِدَ تُنْجِيكُمْ مِنِّي ؟ فَتَخْطِمُهُمْ يُسَاقُونَ فِي الْأَسْوَاقِ ، وَتَقُولُ : يَا كَافِرُ ! يَا مُؤْمِنُ !  .         [10/68]","","Musnad Abi Ya'la al-Mawsili 5703","","عبد الله بن عمر بن الخطاب عن سعيد بن عامر عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5705","290 - (  5704  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عُبَيْدِ اللهِ [ بْنِ عَبْدِ اللهِ ] بْنِ عُمَرَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَأْكُلْ أَحَدُكُمْ بِشِمَالِهِ ؛ فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ  وَيَشْرَبُ بِشِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 5704","","عبد الله بن عمر بن الخطاب عن أبو بكر بن عبيد الله بن عبد الله بن عمر بن الخطاب عن الزهري عن عبيد الله بن عمر العمري عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5706","291 - (  5705  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عُبَيْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَأْكُلْ أَحَدُكُمْ بِشِمَالِهِ ؛ فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ  وَيَشْرَبُ بِشِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 5705","","عبد الله بن عمر بن الخطاب عن أبو بكر بن عبيد الله بن عبد الله بن عمر بن الخطاب عن الزهري عن عبيد الله بن عمر العمري عن عبدة بن سليمان الكلابي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5707","292 - (  5706  ) -  حَدَّثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ إِيَادِ بْنِ لَقِيطٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نُعَيْمٍ الْأَعْرَجِ ، قَالَ :         [10/69]      سَأَلَ رَجُلٌ ابْنَ عُمَرَ عَنْ مُتْعَةِ النِّسَاءِ - وَأَنَا عِنْدَهُ - فَغَضِبَ ،  وَقَالَ  : مَا كُنَّا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِزَنَّائِينَ وَلَا مُسَافِحِينَ ، ثُمَّ قَالَ : وَاللهِ لَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَيَكُونَنَّ قَبْلَ يَوْمِ الْقِيَامَةِ  الْمَسِيحُ الدَّجَّالُ  ، وَثَلَاثُونَ كَذَّابًا أَوْ أَكْثَرُ مِنْ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5706","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن نعم الأعرجي عن إياد بن لقيط السدوسي عن عبيد الله بن إياد بن لقيط السدوسي عن جبارة بن المغلس عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5708","293 - (  5707  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ  عَنْ  صَدَقَةَ بْنِ أَبِي عِمْرَانَ  عَنْ  إِيَادِ بْنِ لَقِيطٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نُعَيْمٍ الْأَعْرَجِ قَالَ :         [10/70]      جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ بْنِ عُمَرَ - وَأَنَا عِنْدَهُ - فَسَأَلَهُ عَنْ مُتْعَةِ النِّسَاءِ ، فَغَضِبَ  وَقَالَ  :  وَاللهِ مَا كُنَّا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ زَنَّائِينَ وَلَا مُسَافِحِينَ  .","","Musnad Abi Ya'la al-Mawsili 5707","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن نعم الأعرجي عن إياد بن لقيط السدوسي عن صدقة بن أبي عمران الكوفي عن حماد بن أسامة القرشي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5709","294 - (  5708  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  أَبِي رَجَاءٍ الْجَزَرِيِّ ،  عَنْ  فُرَاتِ بْنِ سَلْمَانَ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا صَبَرَ أَهْلُ بَيْتٍ ثَلَاثَةً عَلَى  جَهْدٍ  ، إِلَّا أَتَاهُمُ اللهُ بِرِزْقٍ  .         [10/71]","","Musnad Abi Ya'la al-Mawsili 5708","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن فرات بن سلمان الجزري عن محرز بن عبد الله الجزري عن عبدة بن سليمان الكلابي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5710","295 - (  5709  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عُمَيْرِ بْنِ أَبِي عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُفْطِرًا فِي يَوْمِ جُمُعَةٍ  .         [10/72]","","Musnad Abi Ya'la al-Mawsili 5709","","عبد الله بن عمر بن الخطاب عن عمير بن أبي عمير عن ليث بن أبي سليم عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5711","296 - (  5710  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  فُضَيْلُ بْنُ غَزْوَانَ ،  حَدَّثَنَا  أَبُو دِهْقَانَةَ ، قَالَ : كُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ ،  قَالَ  :  أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ضَيْفٌ ، فَقَالَ  لِبِلَالٍ  : ائْتِنَا بِطَعَامٍ  ، فَذَهَبَ  بِلَالٌ  فَأَبْدَلَ صَاعَيْنِ مِنْ تَمْرٍ بِصَاعٍ مِنْ تَمْرٍ خَيْرٍ ، وَكَانَ تَمْرُهُمْ رَدِيئًا ، فَأَعْجَبَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : مِنْ أَيْنَ هَذَا ؟ فَأَخْبَرَهُ أَنَّهُ أَبْدَلَ صَاعَيْنِ بِصَاعٍ .  فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : رُدَّ عَلَيْنَا تَمْرَنَا  .         [10/73]","","Musnad Abi Ya'la al-Mawsili 5710","","عبد الله بن عمر بن الخطاب عن أبو دهقانة عن فضيل بن غزوان عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5712","297 - (  5711  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ الْعَبْدِيُّ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  سَعِيدِ بْنِ عُمَيْرٍ الْأَنْصَارِيِّ ، قَالَ :         [10/74]             [10/75]      جَلَسْتُ إِلَى عَبْدِ اللهِ بْنِ عُمَرَ ، وَأَبِي سَعِيدٍ الْخُدْرِيِّ ،  فَقَالَ  أَحَدُهُمَا : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَبْلُغُ الْعَرَقُ يَوْمَ الْقِيَامَةِ مِنَ النَّاسِ  ، فَقَالَ : يَعْنِي أَحَدُهُمَا : إِلَى  شَحْمَةِ  أُذُنِهِ  ، وَقَالَ الْآخَرُ :  إِلَى أَنْ  يُلْجِمَهُ  .  فَقَالَ  ابْنُ عُمَرَ  : هَكَذَا ، وَوَصَفَ  أَبُو عَاصِمٍ  فَأَمَرَّ إِصْبَعَهُ مِنْ  شَحْمَةِ  أُذُنِهِ إِلَى فِيهِ ، هَذَا وَذَاكَ سَوَاءٌ  .         [10/76]","","Musnad Abi Ya'la al-Mawsili 5711","","أبو سعيد الخدري عن سعيد بن عمير بن نيار الحارثي عن جعفر بن عبد الله بن الحكم الأوسي عن عبد الحميد بن جعفر الأوسي عن أبو عاصم النبيل عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5713","298 - (  5712  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  حَدَّثَنَا  ثُوَيْرٌ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ -  رَفَعَ الْحَدِيثَ  - أَنَّ رَسُولَ اللهِ         [10/77]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلَةً مَنْ يَنْظُرُ إِلَى خِبَائِهِ ، وَخَدَمِهِ ، وَنَعِيمِهِ ، وَسُرُرِهِ  مَسِيرَةَ  أَلْفِ سَنَةٍ  ، وَأَكْرَمَهُمْ إِلَى اللهِ مَنْ يَنْظُرُ إِلَى اللهِ بُكْرَةً وَعَشِيًّا ، ثُمَّ تَلَا هَذِهِ الْآيَةَ :         {      وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌ             *          إِلَى رَبِّهَا نَاظِرَةٌ         }      .         [10/78]","","Musnad Abi Ya'la al-Mawsili 5712","","عبد الله بن عمر بن الخطاب عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن مؤمل بن إسماعيل العدوي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5714","299 - (  5713  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  بَكْرُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  يُوسُفُ بْنُ صُهَيْبٍ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مِنْكُمْ يُحِبُّ أَنْ تُسْتَجَابَ دَعْوَتُهُ  ، وَتُكْشَفَ كُرَبُهُ ، فَلْيُيَسِّرْ عَلَى مُعْسِرٍ  .","","Musnad Abi Ya'la al-Mawsili 5713","","عبد الله بن عمر بن الخطاب عن زيد بن الحواري العمي عن يوسف بن صهيب الكندي عن بكر بن بكار القيسي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5715","300 - (  5714  ) -  حَدَّثَنَا  هَاشِمُ بْنُ الْحَارِثِ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَسَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حُلَّةً  مِنْ حَرِيرٍ  مِنْ حُلَلِ السِّيَرَاءِ مِمَّا أَهْدَى إِلَيْهِ فَيْرُوزُ ، فَلَبِسْتُ الْإِزَارَ فَأَغْرَقَنِي         [10/79]      عَرْضًا وَطُولًا ، فَسَحَبْتُ وَلَبِسْتُ الرِّدَاءَ ، فَتَقَنَّعْتُ فِيهِ ، ثُمَّ قَالَ : يَا  عَبْدَ اللهِ  ، ارْفَعِ  الْإِزَارَ  ؛ فَإِنَّ مَا مَسَّ التُّرَابُ إِلَى أَسْفَلِ  الْكَعْبَيْنِ  فِي النَّارِ .  قَالَ  عَبْدُ اللهِ بْنُ مُحَمَّدٍ  : فَلَمْ أَرَ أَحَدًا أَشَدَّ تَشْمِيرًا لِلْإِزَارِ مِنْ  عَبْدِ اللهِ بْنِ عُمَرَ  .","","Musnad Abi Ya'la al-Mawsili 5714","","عبد الله بن عمر بن الخطاب عن عبد الله بن محمد بن عقيل بن أبي طالب عن عبيد الله بن عمرو بن أبي الوليد عن هاشم بن الحارث المروروذي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5716","301 - (  5715  ) -  حَدَّثَنَا  هَاشِمُ بْنُ الْحَارِثِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ ،  حَدَّثَنَا  أَبَانُ بْنُ عَبْدِ اللهِ الْبَجَلِيُّ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،         [10/80]      عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يُصَلِّ قَبْلَ الْعِيدِ وَلَا بَعْدَهَا  .","","Musnad Abi Ya'la al-Mawsili 5715","","عبد الله بن عمر بن الخطاب عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن أبان بن عبد الله بن أبي حازم عن محمد بن ربيعة بن سمير الرؤاسي عن هاشم بن الحارث المروروذي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5717","302 - (  5716  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  سُكَيْنٌ ،  حَدَّثَنَا  عَبْدُ الْمُؤْمِنِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الذَّهَبُ بِالذَّهَبِ ، وَالْفِضَّةُ بِالْفِضَّةِ  ، وَالْبُرُّ بِالْبُرِّ ، وَالشَّعِيرُ بِالشَّعِيرِ ، وَالْمِلْحُ         [10/81]      بِالْمِلْحِ ، وَالتَّمْرُ بِالتَّمْرِ ، مِثْلًا بِمِثْلٍ ، كَيْلًا بِكَيْلٍ فَمَنْ زَادَ أَوِ اسْتَزَادَ فَقَدْ  أَرْبَى  .","","Musnad Abi Ya'la al-Mawsili 5716","","عبد الله بن عمر بن الخطاب عن عبد المؤمن بن أبي شراعة العبدي عن سكين بن عبد العزيز بن قيس المجاشعي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5718","303 - (  5717  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  حَدَّثَنَا  ابْنُ ثَوْبَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَكْحُولٍ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ يَقْبَلُ تَوْبَةَ الْعَبْدِ مَا لَمْ  يُغَرْغِرْ  .         [10/82]","","Musnad Abi Ya'la al-Mawsili 5717","","عبد الله بن عمر بن الخطاب عن جبير بن نفير بن مالك الحضرمي عن مكحول بن أبي مسلم عن ثابت بن ثوبان العبسي عن عبد الرحمن بن ثابت العنسي عن علي بن الجعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5719","304 - (  5718  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ :  مِنْ أَيْنَ يَجُوزُ لِي أَنْ أَعْتَمِرَ ؟  .  قَالَ :  فَرَضَهَا  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَلِأَهْلِ نَجْدٍ  مِنْ  قَرَنٍ  .","","Musnad Abi Ya'la al-Mawsili 5718","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5720","305 - (  5719  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ، قَالَ :  سَمِعْتُ  رَجُلًا سَأَلَ ابْنَ عُمَرَ ، عَنْ بَيْعِ  الثَّمَرَةِ  ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنْ بَيْعِ  الثَّمَرَةِ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Musnad Abi Ya'la al-Mawsili 5719","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5721","306 - (  5720  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ أَخُو الْحَجَّاجِ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ يَعْنِي : ابْنَ زِيَادٍ ،  عَنْ  لَيْثٍ ، قَالَ :  حَدَّثَنِي  أَبُو مُحَمَّدٍ ، قَالَ :  رَمَقْتُ  ابْنَ عُمَرَ شَهْرًا فَسَمِعْتُهُ فِي الرَّكْعَتَيْنِ ، قَبْلَ صَلَاةِ         [10/83]      الصُّبْحِ يَقْرَأُ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  قَالَ : فَذَكَرْتُ لَهُ ذَلِكَ ،  فَقَالَ  :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  شَهْرًا ، أَوْ خَمْسَةً وَعِشْرِينَ يَوْمًا  يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ صَلَاةِ الصُّبْحِ  :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      ، وَقَالَ : إِنَّ إِحْدَاهُمَا تُعْدَلُ بِثُلُثِ الْقُرْآنِ ، وَالْأُخْرَى بِرُبُعِ الْقُرْآنِ ،         {      قُلْ هُوَ اللهُ أَحَدٌ         }      تُعْدَلُ بِثُلُثِ الْقُرْآنِ ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      تُعْدَلُ بِرُبُعِ الْقُرْآنِ  .         [10/84]             [10/85]","","Musnad Abi Ya'la al-Mawsili 5720","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن ليث بن أبي سليم عن عبد الواحد بن زياد عن محمد بن المنهال الأنماطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5722","307 - (  5721  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  حَدَّثَنَا  صَالِحُ بْنُ عُمَرَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  دَاوُدَ بْنِ عَاصِمِ         [10/86]      بْنِ عُرْوَةَ بْنِ مَسْعُودٍ الثَّقَفِيِّ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ  بِمِنًى  عَنِ الصَّلَاةِ هَاهُنَا ؟ قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ  ، وَمَعَ  أَبِي بَكْرٍ  رَكْعَتَيْنِ ، وَمَعَ  عُمَرَ  رَكْعَتَيْنِ ، وَمَعَ  عُثْمَانَ  صَدْرًا مِنْ خِلَافَتِهِ رَكْعَتَيْنِ ، إِذَا صَلَّيْنَا مَعَهُمْ صَلَّيْنَا كَمَا يُصَلُّونَ ، وَإِذَا صَلَّيْنَا وَحْدَنَا صَلَّيْنَا  .","","Musnad Abi Ya'la al-Mawsili 5721","","عبد الله بن عمر بن الخطاب عن داود بن أبي عاصم الطائفي عن يزيد بن أبي زياد القرشي عن صالح بن عمر الواسطي عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5723","308 - (  5722  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ الْوَلِيدُ بْنُ شُجَاعِ بْنِ الْوَلِيدِ بْنِ بِشْرٍ السَّكُونِيُّ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  حَدَّثَنَا  دَاوُدُ ،  عَنْ  رِيَاحِ بْنِ عَبِيدَةَ ،  عَنْ  أَسِيدِ بْنِ عَبْدِ الرَّحْمَنِ ابْنِ أَخِي عَبْدِ الْمَجِيدِ وَهُوَ ابْنُ سَوْدَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  لَبِسْتُ ثَوْبًا حَرِيرًا ، فَأَتَيْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ عِنْدَ حُجْرَةِ  حَفْصَةَ  - فِي لَيْلَةٍ مُظْلِمَةٍ فَسَمِعَ  قَعْقَعَةَ  الثَّوْبِ ، فَقَالَ : مَنْ هَذَا ؟  فَقُلْتُ :  عَبْدُ اللهِ بْنُ عُمَرَ  .  قَالَ : ارْفَعْ ثَوْبَكَ ،  إِنَّ الَّذِي يَجُرُّ ثَوْبَهُ  خُيَلَاءَ  لَا يَنْظُرُ اللهُ إِلَيْهِ  .  قَالَ : وَكَانَ إِزَارِي تِلْكَ اللَّيْلَةَ إِلَى نِصْفِ سَاقَيَّ  .         [10/87]","","Musnad Abi Ya'la al-Mawsili 5722","","عبد الله بن عمر بن الخطاب عن أسيد بن عبد الرحمن الخثعمي عن رياح بن عبيدة الباهلي عن داود بن أبي هند عن عبد الأعلى بن عبد الأعلى القرشي عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5724","309 - (  5723  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ ذَكْوَانَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ سُرَّ فِي ظِلِّ  سَرْحَةٍ  سَبْعُونَ نَبِيًّا  ، لَا تُسْرَفُ وَلَا تُجَرَّدُ ، وَلَا  تُعْبَلُ  .","","Musnad Abi Ya'la al-Mawsili 5723","","عبد الله بن عمر بن الخطاب عن أبو الزناد عن الأعمش عن أبو معاوية الضرير عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5725","310 - (  5724  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  نَاعِمٍ مَوْلَى أُمِّ سَلَمَةَ ،  قَالَ  :         [10/88]      خَرَجَ عَبْدُ اللهِ بْنُ عُمَرَ حَاجًّا ، حَتَّى إِذَا كَانَ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  أَتَى شَجَرَةً عَرَفَهَا فَجَلَسَ تَحْتَهَا ، ثُمَّ قَالَ : رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَحْتَ هَذِهِ الشَّجَرَةِ ، إِذْ أَقْبَلَ  رَجُلٌ  شَابٌّ مِنْ هَذِهِ الشُّعْبَةِ ، حَتَّى وَقَفَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي جِئْتُ لِأُجَاهِدَ مَعَكَ فِي  سَبِيلِ  اللهِ ، أَبْتَغِي بِذَلِكَ وَجْهَ اللهِ وَالدَّارَ الْآخِرَةَ ، قَالَ :  أَبَوَاكَ حَيَّانِ كِلَاهُمَا ؟ قَالَ : نَعَمْ ، قَالَ : فَارْجِعْ بَرَّهُمَا  .  قَالَ : انْفَتَلَ رَاجِعًا مِنْ حَيْثُ جَاءَ  .         [10/89]","","Musnad Abi Ya'la al-Mawsili 5724","","عبد الله بن عمر بن الخطاب عن ناعم بن أجيل الهمداني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبد الرحيم بن سليمان الأشل عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5726","311 - (  5725  ) -  حَدَّثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ،  حَدَّثَنَا  الصَّبَّاحُ بْنُ مُحَارِبٍ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي أَفْطَرْتُ يَوْمًا مِنْ رَمَضَانَ  ، قَالَ : مِنْ غَيْرِ عُذْرٍ وَلَا سَفَرٍ ؟ قَالَ : نَعَمْ ، قَالَ : بِئْسَ مَا صَنَعْتَ ! قَالَ : أَجَلْ ، فَمَا تَأْمُرُنِي ؟ قَالَ : أَعْتِقْ رَقَبَةً . قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا مَلَكْتُ رَقَبَةً قَطُّ . قَالَ : فَصُمْ شَهْرَيْنِ مُتَتَابِعَيْنِ ، قَالَ : فَلَا أَسْتَطِيعُ ذَلِكَ . قَالَ : فَأَطْعِمْ سِتِّينَ مِسْكِينًا ، قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا أُشْبِعُ أَهْلِي . قَالَ : فَأُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمِكْتَلٍ  فِيهِ تَمْرٌ ، فَقَالَ :  تَصَدَّقْ  بِهَذَا عَلَى سِتِّينَ مِسْكِينًا .         [10/90]      قَالَ : إِلَى مَنْ أَدْفَعُهُ ؟ قَالَ : إِلَى أَفْقَرِ مَنْ تَعْلَمُ . قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا بَيْنَ قُتْرَيْهَا أَهْلُ بَيْتٍ أَحْوَجُ مِنَّا . قَالَ : فَتَصَدَّقْ بِهِ عَلَى عِيَالِكَ .","","Musnad Abi Ya'la al-Mawsili 5725","","عبد الله بن عمر بن الخطاب عن حبيب بن أبي ثابت الكاهلي عن هارون بن عنترة الشيباني عن صباح بن محارب التيمي عن سهل بن أبي سهل الأشتر عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5727","312 - (  5726  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنْ  سَعْدٍ مَوْلَى طَلْحَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا لَوْ لَمْ أَسْمَعْهُ إِلَّا مَرَّةً أَوْ مَرَّتَيْنِ حَتَّى عَدَّ سَبْعَ مِرَارٍ ، وَإِنِّي قَدْ         [10/91]      سَمِعْتُهُ أَكْثَرَ مِنْ ذَلِكَ ، قَالَ :  كَانَ  الْكِفْلُ  مِنْ  بَنِي إِسْرَائِيلَ  لَا يَتَوَرَّعُ مِنْ ذَنْبٍ عَمِلَهُ  ، فَأَتَتِ امْرَأَةٌ ، فَأَعْطَاهَا سِتِّينَ دِينَارًا عَلَى أَنْ يَطَأَهَا ، فَلَمَّا أَنْ قَعَدَ مِنْهَا مَقْعَدَ الرَّجُلِ ارْتَعَدَتْ وَبَكَتْ ، فَقَالَ : مَا يُبْكِيكِ ؟ أَكْرَهْتُكِ ؟ قَالَتْ : لَا ، وَلَكِنْ هَذَا عَمَلٌ لَمْ أَعْمَلْهُ قَطُّ ، وَإِنَّمَا حَمَلَتْنِي عَلَيْهِ الْحَاجَةُ .  قَالَ : فَتَفْعَلِينَ هَذَا وَلَمْ تَعْمَلِيهِ قَطُّ ؟ قَالَ : ثُمَّ نَزَلَ ، فَقَالَ : اذْهَبِي وَالدَّنَانِيرُ لَكِ .  ثُمَّ قَالَ : وَاللهِ لَا يَعْصِي اللهَ  الْكِفْلُ  أَبَدًا ، قَالَ : فَمَاتَ مِنْ لَيْلَتِهِ ، فَأَصْبَحَ مَكْتُوبًا عَلَى بَابِهِ : قَدْ غَفَرَ اللهُ  لِلْكِفْلِ  .         [10/92]             [10/93]","","Musnad Abi Ya'la al-Mawsili 5726","","عبد الله بن عمر بن الخطاب عن سعد مولى طلحة عن عبد الله بن عبد الله الهاشمي عن الأعمش عن أسباط بن محمد بن ميسرة القرشي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5728","313 - (  5727  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  مُعْتَمِرٌ ، قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ أَبِي جَمِيلَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَوْهَبٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ قَاضِيًا فَقَضَى بِجَوْرٍ كَانَ مِنْ أَهْلِ النَّارِ  ، وَمَنْ كَانَ قَاضِيًا فَقَضَى بِجَهْلٍ كَانَ مِنْ أَهْلِ النَّارِ ، وَمَنْ كَانَ قَاضِيًا فَقَضَى بِعَدْلٍ  فَبِالْحَرِيِّ  أَنْ يَنْفَلِتَ كَفَافًا  .         [10/94]             [10/95]","","Musnad Abi Ya'la al-Mawsili 5727","","عبد الله بن عمر بن الخطاب عن عبد الله بن موهب الهمداني عن عبد الملك بن أبي جميلة عن معتمر بن سليمان عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5729","314 - (  5728  ) -  حَدَّثَنَا  خَلِيفَةُ بْنُ خَيَّاطٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  حَجَّاجٌ ، قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  حَدَّثَهُمْ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  بَيْنَمَا أَنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلَاةِ ، قَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  : اللهُ أَكْبَرُ  كَبِيرًا  ،  وَالْحَمْدُ لِلهِ كَثِيرًا ، وَسُبْحَانَ اللهِ بُكْرَةً وَأَصِيلًا ، فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّلَاةَ ، قَالَ : أَيُّكُمْ صَاحِبُ الْكَلِمَاتِ ؟ فَسَكَتَ  الْقَوْمُ  ، فَقَالَ رَجُلٌ مِنَ  الْقَوْمِ  : أَنَا قُلْتُهَا يَا رَسُولَ اللهِ وَمَا أَرَدْتُ بِهَا إِلَّا الْخَيْرَ .  فَقَالَ رَسُولُ اللهِ : فُتِحَتْ لَهَا أَبْوَابُ السَّمَاءِ .  قَالَ  ابْنُ عُمَرَ  : فَمَا تَرَكْتُهَا مُنْذُ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُهَا  .         [10/96]","","Musnad Abi Ya'la al-Mawsili 5728","","عبد الله بن عمر بن الخطاب عن عون بن عبد الله بن عتبة عن أبو الزبير المكي عن حجاج بن أبى عثمان الصواف الكندي عن يزيد بن زريع العيشي عن خليفة بن خياط عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5730","315 - (  5729  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبْجَرَ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلَةً لَمَنْ يَنْظُرُ فِي مُلْكِهِ أَلْفَيْ سَنَةٍ يَرَى أَقْصَاهَا  ، يَنْظُرُ         [10/97]      إِلَى أَزْوَاجِهِ وَسُرُرِهِ ، وَإِنَّ أَفْضَلَهُمْ مَنْزِلَةً لَمَنْ يَنْظُرُ إِلَى وَجْهِ اللهِ كُلَّ يَوْمٍ مَرَّتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5729","","عبد الله بن عمر بن الخطاب عن ثوير بن أبي فاختة مولى أم هانئ عن عبد الملك بن سعيد بن حيان عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5731","316 - (  5730  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  أَخْبَرَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنِ  الْقَعْقَاعِ بْنِ حَكِيمٍ ، قَالَ :  كَتَبَ  عَبْدُ الْعَزِيزِ بْنُ مَرْوَانَ  ، إِلَى ابْنِ عُمَرَ : أَنِ ارْفَعْ إِلَيَّ حَاجَتَكَ ، قَالَ :  فَكَتَبَ  ابْنُ عُمَرَ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  الْيَدُ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى ، وَابْدَأْ بِمَنْ  تَعُولُ  .  وَلَسْتُ أَسْأَلُكَ شَيْئًا وَلَا أَرُدُّ رِزْقًا رَزَقَنِيهِ اللهُ مِنْكَ  .         [10/98]","","Musnad Abi Ya'la al-Mawsili 5730","","عبد الله بن عمر بن الخطاب عن القعقاع بن حكيم الكناني عن محمد بن عجلان عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5732","317 - (  5731  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي         [10/99]      سَمِينَةَ ،  حَدَّثَنَا  مُعْتَمِرٌ ، قَالَ :  قَرَأْتُ عَلَى  فُضَيْلٍ ،  عَنْ  أَبِي حَرِيزٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ  :  أَنْتَ وَمَالُكَ لِأَبِيكَ  .         [10/100]","","Musnad Abi Ya'la al-Mawsili 5731","","عبد الله بن عمر بن الخطاب عن أبو إسحاق السبيعي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5733","318 - (  5732  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو الْمُنْذِرِ إِسْمَاعِيلُ بْنُ عُمَرَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ،  أَنَّ  ابْنَ عُمَرَ رَأَى نَاسًا ، فَقَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيَعْجِزُ أَحَدُكُمْ إِذَا جَاءَهُ رَجُلٌ يُرِيدُ قَتْلَهُ أَنْ يَكُونَ مِثْلَ ابْنَيْ آدَمَ :  الْقَاتِلُ فِي النَّارِ ، وَالْمَقْتُولُ فِي الْجَنَّةِ  .         [10/101]","","Musnad Abi Ya'la al-Mawsili 5732","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن سمير عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن إسماعيل بن عمر الواسطي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5734","319 - (  5733  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  أَبِي ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِجَرِّ فَضِيخِ بُسْرٍ - وَهُوَ فِي  مَسْجِدِ الْفَضِيخِ  - فَشَرِبَهُ  ، فَلِذَلِكَ سُمِّيَ :  مَسْجِدَ الْفَضِيخِ  .         [10/102]","","Musnad Abi Ya'la al-Mawsili 5733","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن نافع مولى عبد الله بن عمر عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5735","320 - (  5734  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  نَافِعُ بْنُ عُمَرَ الْجُمَحِيُّ ،  عَنْ  سَعِيدِ بْنِ حَسَّانَ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَنْزِلُ  بِعَرَفَةَ  فِي  وَادِي  نَمِرَةَ  .         [10/103]","","Musnad Abi Ya'la al-Mawsili 5734","","عبد الله بن عمر بن الخطاب عن سعيد بن حسان الحجازي عن نافع بن عمر بن عبد الله بن جميل الجمحي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5736","321 - (  5735  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سَعِيدُ بْنُ السَّائِبِ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَاصِمٍ الثَّقَفِيِّ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الصَّلَاةِ  بِمِنًى  ، قَالَ : فَهَلْ سَمِعْتَ  بِمُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ .  قُلْتُ : نَعَمْ ، وَآمَنْتُ بِهِ ، قَالَ :  فَإِنَّهُ كَانَ يُصَلِّي  بِمِنًى  رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5735","","عبد الله بن عمر بن الخطاب عن داود بن أبي عاصم الطائفي عن سعيد بن السائب الطائفي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5737","322 - (  5736  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  الشَّيْبَانِيُّ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْقِرَانِ  ، حَتَّى تَسْتَأْذِنَ أَصْحَابَكَ  .         [10/104]","","Musnad Abi Ya'la al-Mawsili 5736","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن سليمان بن فيروز الشيباني عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5738","323 - (  5737  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،         [10/105]      عَنِ  ابْنِ عُمَرَ  أَنَّهُ قَبَّلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 5737","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5739","324 - (  5738  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ عَلْقَمَةَ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعْفُوا اللِّحَى  وَاحْفُوا  الشَّوَارِبَ  .         [10/106]","","Musnad Abi Ya'la al-Mawsili 5738","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن علقمة المكي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5740","325 - (  5739  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنِ  ابْنِ أَبِي نُعْمٍ ،  أَنَّ رَجُلًا سَأَلَ ابْنَ عُمَرَ عَنْ دَمِ الْبَعُوضِ ، فَقَالَ : مِمَّنْ أَنْتَ ؟ .  قَالَ : مِنْ  أَهْلِ الْعِرَاقِ  .  قَالَ : انْظُرُوا إِلَى هَذَا ! يَسْأَلُنِي عَنْ دَمِ الْبَعُوضِ ، وَقَدْ قَتَلُوا ابْنَ رَسُولِ اللهِ ! وَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  هُمَا رَيْحَانَتَايَ         [10/107]      مِنَ الدُّنْيَا  .","","Musnad Abi Ya'la al-Mawsili 5739","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي نعم البجلي عن محمد بن عبد الله بن أبي يعقوب عن مهدي بن ميمون المعولي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5741","326 - (  5740  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ،  حَدَّثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُسْلِمٍ مَوْلًى لِعَبْدِ الْقَيْسِ ، قَالَ :  قَالَ رَجُلٌ لِابْنِ عُمَرَ : أَرَأَيْتَ الْوَتْرَ أَسُنَّةٌ هُوَ ؟ .  قَالَ : مَا سُنَّةٌ ؟  أَوْتَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُسْلِمُونَ  .         [10/108]      قَالَ : أَسُنَّةٌ هُوَ ؟ .  قَالَ لَهُ : أَتَعْقِلُ ؟ ! أَوْتَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُسْلِمُونَ  .","","Musnad Abi Ya'la al-Mawsili 5740","","عبد الله بن عمر بن الخطاب عن مسلم بن مخراق القطان عن عبد الله بن عون بن أرطبان عن معاذ بن معاذ بن نصر عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5742","327 - (  5741  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ، أَنَّ عَمَّهُ وَاسِعَ بْنَ حَبَّانَ ،  أَخْبَرَهُ  ،  أَنَّهُ كَانَ قَائِمًا يُصَلِّي فِي الْمَسْجِدِ  وَابْنُ عُمَرَ  مُسْتَقْبِلُهُ مُسْنِدًا ظَهْرَهُ إِلَى قِبْلَةِ الْمَسْجِدِ ، فَلَمَّا انْصَرَفَ  وَاسِعٌ  انْصَرَفَ عَنْ يَسَارِهِ إِلَى  ابْنِ عُمَرَ  ، فَجَلَسَ إِلَيْهِ .  فَقَالَ لَهُ  ابْنُ عُمَرَ  : مَا يَمْنَعُكَ أَنْ تَنْصَرِفَ عَنْ يَمِينِكَ ؟ .         [10/109]      قَالَ : لَا ، إِلَّا أَنِّي رَأَيْتُكَ فَانْصَرَفْتُ إِلَيْكَ .  قَالَ : فَقَالَ  ابْنُ عُمَرَ  : فَإِنَّكَ قَدْ أَحْسَنْتَ ، إِنَّ نَاسًا يَقُولُونَ : إِذَا كُنْتَ تُصَلِّي فَانْصَرَفْتَ ، فَانْصَرِفْ عَنْ يَمِينِكَ .  قَالَ  ابْنُ عُمَرَ  : إِذَا كُنْتَ تُصَلِّي فَانْصَرَفْتَ ، فَانْصَرِفْ إِنْ شِئْتَ عَنْ يَمِينِكَ ، وَإِنْ شِئْتَ عَنْ يَسَارِكَ .  قَالَ ابْنُ عُمَرَ : وَيَقُولُ نَاسٌ آخَرُونَ : إِذَا جَلَسَ لِلْغَائِطِ فَلَا يَسْتَقْبِلِ الْقِبْلَةَ ، وَلَا  بَيْتَ الْمَقْدِسِ  .  وَلَقَدْ صَعِدْتُ يَوْمًا عَلَى بَيْتِنَا ، فَرَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى حَاجَتِهِ  ،  شَكَّ  أَبُو يَعْلَى  ، مُسْتَقْبِلَ  بَيْتَ الْمَقْدِسِ  .         [10/110]","","Musnad Abi Ya'la al-Mawsili 5741","","عبد الله بن عمر بن الخطاب عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5743","328 - (  5742  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَّامٍ ،  عَنِ  الْحَكَمِ بْنِ مِينَاءَ ،  عَنِ  ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ،  أَنَّهُمَا شَهِدَا عَلَى رَسُولِ اللهِ         [10/111]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ وَهُوَ عَلَى الْمِنْبَرِ :  لَيَنْتَهِيَنَّ قَوْمٌ عَنْ  وَدْعِهِمُ  الْجُمُعَاتِ ، أَوْ لَيَخْتِمَنَّ اللهُ عَلَى قُلُوبِهِمْ  ، وَلَيَكُونُنَّ مِنَ الْغَافِلِينَ  .         [10/112]             [10/113]","","Musnad Abi Ya'la al-Mawsili 5742","","عبد الله بن عباس عن الحكم بن ميناء الأنصاري عن ممطور الحبشي عن يحيى بن أبي كثير عن هشام الدستوائي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5744","329 - (  5743  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  سُلَيْمَانُ التَّيْمِيُّ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَجَدَ فِي الرَّكْعَةِ الْأُولَى مِنْ صَلَاةِ الظُّهْرِ  ، فَرَأَى أَصْحَابُهُ أَنَّهُ قَرَأَ : ( تَنْزِيلُ - السَّجْدَةَ )  .  قَالَ :  وَلَمْ أَسْمَعْهُ مِنْ  أَبِي مِجْلَزٍ  .         [10/114]","","Musnad Abi Ya'la al-Mawsili 5743","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن سليمان بن طرخان عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5745","330 - (  5744  ) -  حَدَّثَنَا  صَلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  حَدَّثَنَا  عِكْرِمَةُ بْنُ خَالِدِ بْنِ سَلَمَةَ الْمَخْزُومِيُّ ، قَالَ :  سَمِعْتُ  أَبِي  يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَضْرِبُوا الرَّقِيقَ  ؛ فَإِنَّكُمْ لَا تَدْرُونَ مَا تُوَافِقُونَ  .         [10/115]","","Musnad Abi Ya'la al-Mawsili 5744","","عبد الله بن عمر بن الخطاب عن الفأفأ ، خالد بن سلمة بن العاص عن عكرمة بن خالد بن سلمة المخزومي عن الصلت بن مسعود الجحدري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5746","331 - (  5745  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي أَيُّوبَ ،  عَنْ  أَبِي عَلْقَمَةَ مَوْلَى بَنِي هَاشِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّهُ رَأَى مَوْلًى لَهُ يُقَالُ لَهُ :  يَسَارٌ  يُصَلِّي بَعْدَ الْفَجْرِ ، فَنَهَاهُ ، فَقَالَ : إِنَّمَا بَقِيَ مِنْ  حِزْبِي  ، فَقَالَ لَهُ  عَبْدُ اللهِ  : أَفَلَا أَخَّرْتَهُ حَتَّى يَكُونَ ذَلِكَ مِنَ النَّهَارِ ؟ ثُمَّ قَالَ  عَبْدُ اللهِ  : خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَالنَّاسُ يُصَلُّونَ بَعْدَ طُلُوعِ الْفَجْرِ ، فَقَالَ : إِنَّهُ  لَا صَلَاةَ بَعْدَ الْفَجْرِ إِلَّا رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5745","","عبد الله بن عمر بن الخطاب عن أبو علقمة الفارسي عن محمد بن الحصين الحنظلي عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5747","332 - (  5746  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  أَصْبَغُ بْنُ زَيْدٍ الْجُهَنِيُّ ،  حَدَّثَنَا  أَبُو بِشْرٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ الْحَضْرَمِيِّ ،         [10/116]             [10/117]      عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ  احْتَكَرَ  طَعَامًا أَرْبَعِينَ لَيْلَةً فَقَدْ بَرِئَ مِنَ اللهِ وَبَرِئَ اللهُ مِنْهُ  ، وَأَيُّمَا أَهْلِ عَرْصَةٍ أَصْبَحَ فِيهِمُ امْرُؤٌ جَائِعٌ ، فَقَدْ بَرِئَتْ مِنْهُمْ ذِمَّةُ اللهِ  .         [10/118]             [10/119]","","Musnad Abi Ya'la al-Mawsili 5746","","عبد الله بن عمر بن الخطاب عن كثير بن مرة الرهاوي عن أبو الزاهرية حدير بن كريب عن أبو بشر صاحب أبي الزاهرية عن أصبغ بن أبي منصور عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5748","333 - (  5747  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  نُهَيْكِ بْنِ يَرِيمَ ،  عَنْ  مُغِيثِ بْنِ سُمَيٍّ ، قَالَ :  صَلَّى بِنَا  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  بِغَلَسٍ  ، وَابْنُ عُمَرَ إِلَى جَنْبِي ، فَلَمَّا سَلَّمَ ، قُلْتُ : مَا هَذِهِ الصَّلَاةُ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟ قَالَ :  هَذِهِ كَانَتْ صَلَاتَنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَمَعَ  أَبِي بَكْرٍ  ،  وَعُمَرَ  ، فَلَمَّا قُتِلَ  عُمَرُ  أَسْفَرَ  بِهَا  عُثْمَانُ  .         [10/120]","","Musnad Abi Ya'la al-Mawsili 5747","","عبد الله بن عمر بن الخطاب عن مغيث بن سمي الأوزاعي عن نهيك بن يريم الأوزاعي عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5749","334 - (  5748  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ النُّكْرِيُّ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْقُرَشِيُّ ، قَالَ :  حَدَّثَنِي  جَدِّي أَبُو الْمُثَنَّى  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى قَبْلَ الْعَصْرِ أَرْبَعًا  .         [10/121]","","Musnad Abi Ya'la al-Mawsili 5748","","عبد الله بن عمر بن الخطاب عن مسلم بن المثنى القرشي عن محمد بن إبراهيم بن مسلم المؤذن عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5750","335 - (  5749  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ بْنُ الدَّوْرَقِيِّ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْقُرَشِيُّ ، قَالَ :  حَدَّثَنِي  جَدِّي  ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ لَا يَنَامُ إِلَّا وَالسِّوَاكُ عِنْدَهُ  ، إِذَا اسْتَيْقَظَ بَدَأَ بِالسِّوَاكِ  .","","Musnad Abi Ya'la al-Mawsili 5749","","عبد الله بن عمر بن الخطاب عن مسلم بن المثنى القرشي عن محمد بن إبراهيم بن مسلم المؤذن عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5751","336 - (  5750  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ، قَالَ :         [10/122]      دَخَلَ ابْنُ عُمَرَ عَلَى  عَبْدِ اللهِ بْنِ عَامِرٍ  يَعُودُهُ ، فَقَالَ : مَا يَمْنَعُكَ أَنْ تَدْعُوَ لِي ؟  قَالَ  : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ لَا يَقْبَلُ صَلَاةً بِغَيْرِ طُهُورٍ  .","","Musnad Abi Ya'la al-Mawsili 5750","","عبد الله بن عمر بن الخطاب عن مصعب بن سعد بن أبي وقاص عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5752","337 - (  5751  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  صَفْوَانَ بْنِ مُحْرِزٍ ،  أَنَّ رَجُلًا سَأَلَ ابْنَ عُمَرَ ، كَيْفَ سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  النَّجْوَى  ؟         [10/123]      قَالَ  : كَانَ يَقُولُ :  يَدْنُو الْعَبْدُ مِنْ رَبِّهِ ، فَيَضَعُ عَلَيْهِ  كَنَفَهُ  فَيُقَرِّرُهُ  ، فَيَقُولُ : عَمِلْتَ كَذَا ، وَعَمِلْتَ كَذَا ، قَالَ : يَقُولُ : نَعَمْ يَا رَبِّ . قَالَ : فَيَقُولُ : فَإِنِّي قَدْ سَتَرْتُ عَلَيْكَ فِي الدُّنْيَا وَأَنَا أَغْفِرُهَا لَكَ الْيَوْمَ . قَالَ : فَيُعْطَى صَحِيفَةَ حَسَنَاتِهِ ، فَيَقُولُ :         {      هَاؤُمُ اقْرَءُوا كِتَابِيَهْ         }      ، قَالَ : وَأَمَّا الْمُنَافِقُونَ فَيُنَادَوْنَ :         {      هَؤُلاءِ الَّذِينَ كَذَبُوا عَلَى رَبِّهِمْ أَلا لَعْنَةُ اللهِ عَلَى الظَّالِمِينَ         }      .         [10/124]","","Musnad Abi Ya'la al-Mawsili 5751","","عبد الله بن عمر بن الخطاب عن صفوان بن محرز المازني عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5753","338 - (  5752  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمُخَرِّمِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعْدٍ الْأَشْهَلِيُّ الْأَنْصَارِيُّ ، قَالَ :  حَدَّثَنِي  ابْنُ عَجْلَانَ ،  عَنْ  نُعَيْمِ بْنِ عَبْدِ اللهِ الْمُجْمِرِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الْجَمَاعَةِ تَفْضُلُ عَلَى صَلَاةِ الْفَذِّ سَبْعَةً وَعِشْرِينَ جُزْءًا  .         [10/125]","","Musnad Abi Ya'la al-Mawsili 5752","","عبد الله بن عمر بن الخطاب عن نعيم بن عبد الله المجمر عن محمد بن عجلان عن محمد بن سعد الأشهلي عن محمد بن عبد الله بن المبارك المخرمي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5754","339 - (  5753  ) -  حَدَّثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عِصْمَةَ ، قَالَ :         [10/126]      سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  أَنْبَأَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ فِي  ثَقِيفَ  مُبِيرًا  وَكَذَّابًا  .         [10/127]","","Musnad Abi Ya'la al-Mawsili 5753","","عبد الله بن عمر بن الخطاب عن عبد الله بن عصم اليمامي عن إسرائيل بن يونس بن أبي إسحاق عن يزيد بن زريع العيشي عن أمية بن بسطام عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5755","340 - (  5754  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُحَمَّدٍ الْمُوَقَّرِيُّ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  أَبِي هَرِمٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَغِبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْجِهَادِ  ذَاتَ يَوْمٍ  ، فَاجْتَمَعُوا عَلَيْهِ حَتَّى غَمُّوهُ ، وَفِي يَدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جَرِيدَةٌ  قَدْ نُزِعَ سُلَّاؤُهَا ، وَبَقِيَتْ  سُلَّاءَةٌ  لَمْ يَفْطُنْ بِهَا ، فَقَالَ : أَخِّرُوا عَنِّي - هَكَذَا - فَقَدْ غَمَمْتُمُونِي ، فَأَصَابَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَطْنَ رَجُلٍ ، فَأَدْمَى الرَّجُلَ ، فَخَرَجَ الرَّجُلُ وَهُوَ يَقُولُ : هَذَا فِعْلُ نَبِيِّكَ ، فَكَيْفَ بِالنَّاسِ ؟ فَسَمِعَهُ  عُمَرُ  ، فَقَالَ : انْطَلِقْ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِنْ كَانَ هُوَ أَصَابَكَ فَسَوْفَ يُعْطِيكَ الْحَقَّ مِنْ نَفْسِهِ ، وَإِنْ كُنْتَ كَذَبْتَ لَأُذْعِنَنَّكَ بِعِمَامَتِكَ حَتَّى تُحْدِثَ .         [10/128]      فَقَالَ الرَّجُلُ : انْطَلِقْ بِسَلَامٍ فَلَسْتُ أُرِيدُ أَنْ أَنْطَلِقَ مَعَكَ .  قَالَ : مَا أَنَا بِوَادِعِكَ .  فَانْطَلَقَ بِهِ  عُمَرُ  حَتَّى أَتَى بِهِ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّ هَذَا يَزْعُمُ أَنَّكَ أَصَبْتَهُ وَدَمَّيْتَ بَطْنَهُ ، فَمَا تَرَى ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَحَقًّا أَنَا أَصَبْتُهُ ؟  قَالَ الرَّجُلُ : نَعَمْ يَا نَبِيَّ اللهِ ، قَالَ : هَلْ رَأَى ذَلِكَ أَحَدٌ ؟  قَالَ : كَانَ هَاهُنَا نَاسٌ مِنَ الْمُسْلِمِينَ .  قَالَ : اللَّهُمَّ إِنِّي أَشْهَدُ بِشَهَادَةِ رَجُلٍ رَأَى ذَلِكَ إِلَّا أَخْبَرَنِي .  فَقَالَ نَاسٌ مِنَ الْمُسْلِمِينَ : يَا رَسُولَ اللهِ ، أَنْتَ دَمَّيْتَهُ وَلَمْ تُرِدْهُ .  فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : خُذْ لِمَا أَصَبْتُكَ مَالًا وَانْطَلِقْ ، قَالَ الرَّجُلُ : لَا . قَالَ : فَهَبْ لِي ذَلِكَ ، قَالَ : لَا أَفْعَلُ .  قَالَ : فَتُرِيدُ مَاذَا ؟ قَالَ : أُرِيدُ أَنْ أَسْتَقِيدَ مِنْكَ يَا نَبِيَّ اللهِ .         [10/129]      قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : نَعَمْ . فَقَالَ لَهُ الرَّجُلُ : اخْرُجْ مِنْ وَسَطِ هَؤُلَاءِ ، فَخَرَجَ مِنْ وَسَطِهِمْ ، وَأَمْكَنَ الرَّجُلَ مِنَ  الْجَرِيدَةِ  يَسْتَقِيدُ مِنْهُ ، فَكَشَفَ عَنْ بَطْنِهِ ، وَجَاءَ  عُمَرُ  لِيُمْسِكَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ خَلْفِهِ ، فَقَالَ :  أَرِحْنَا  عَثَرْتَ بِنَعْلِكَ وَانْكَسَرَتْ أَسْنَانُكَ .  فَلَمَّا دَنَا الرَّجُلُ لِيَطْعَنَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَلْقَى  الْجَرِيدَةَ  وَقَبَّلَ سُرَّتَهُ ، وَقَالَ : يَا نَبِيَّ اللهِ ، هَذَا الَّذِي أَرَدْتُ لِكَيْمَا نَقْمَعَ الْجَبَّارِينَ مِنْ بَعْدِكَ .  فَقَالَ  عُمَرُ  : لَأَنْتَ أَوْثَقُ عَمَلًا مِنِّي  .","","Musnad Abi Ya'la al-Mawsili 5754","","عبد الله بن عمر بن الخطاب عن أبو هرم عن ثور بن يزيد الكلاعي عن الوليد بن محمد الموقرى عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5756","341 - (  5755  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  أَبِي الصِّدِّيقِ ،         [10/130]      عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا وَضَعْتُمْ مَوْتَاكُمْ فِي اللَّحْدِ ، فَقُولُوا : بِاسْمِ اللهِ وَعَلَى سُنَّةِ رَسُولِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 5755","","عبد الله بن عمر بن الخطاب عن بكر بن عمرو الناجي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5757","342 - (  5756  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ،  حَدَّثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مِجْلَزٍ ، قَالَ :  سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ  الْوِتْرِ  ،  فَقَالَ  : سَمِعْتُ رَسُولَ اللهِ         [10/131]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 5756","","عبد الله بن عباس عن لاحق بن حميد عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5758","343 - (  5757  ) -  قَالَ  : وَسَأَلْتُ ابْنَ عُمَرَ ،  فَقَالَ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 5757","","عبد الله بن عمر بن الخطاب عن لاحق بن حميد عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5759","344 - (  5758  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  حُسَيْنٌ ،  عَنِ  ابْنِ بُرَيْدَةَ ، قَالَ :  حَدَّثَنِي  ابْنُ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقُولُ إِذَا ثَوَى مَضْجَعَهُ : الْحَمْدُ لِلهِ الَّذِي كَفَانِي وَآوَانِي وَأَطْعَمَنِي وَسَقَانِي  ، وَالَّذِي مَنَّ عَلَيَّ وَأَفْضَلَ ، وَالَّذِي أَعْطَانِي وَأَجْزَلَ .         [10/132]      الْحَمْدُ لِلهِ عَلَى كُلِّ حَالٍ ، الْحَمْدُ لِلهِ رَبِّ كُلِّ شَيْءٍ ، وَمَلِيكِ كُلِّ شَيْءٍ ، وَإِلَهِ كُلِّ شَيْءٍ ، وَلَكَ كُلُّ شَيْءٍ ، أَعُوذُ بِكَ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5758","","عبد الله بن عمر بن الخطاب عن عبد الله بن بريدة عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5760","345 - (  5759  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِئُ ،  حَدَّثَنَا  عَبْدُ الْجَبَّارِ الْأَيْلِيُّ ، قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي سُمَيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، أَنَّهُ قَالَ :  سَأَلَتْ  أُمُّ سُلَيْمٍ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَرْأَةِ تَرَى فِي الْمَنَامِ مَا يَرَى الرَّجُلُ . فَقَالَ لَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا رَأَتِ الْمَرْأَةُ ذَلِكَ وَأَنْزَلَتْ فَلْتَغْتَسِلْ  .         [10/133]","","Musnad Abi Ya'la al-Mawsili 5759","","عبد الله بن عمر بن الخطاب عن يزيد بن أبي سمية الأيلي عن عبد الجبار بن عمر الأيلي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5761","346 - (  5760  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ، قَالَ :  حَدَّثَنِي  أَبُو هَانِئٍ ،  عَنْ  عَبَّاسٍ الْحَجْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّ  رَجُلًا  أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنَّ خَادِمِي يُسِيءُ وَيَظْلِمُ أَفَأَضْرِبُهُ ؟ قَالَ : تَعْفُو عَنْهُ كُلَّ يَوْمٍ سَبْعِينَ مَرَّةً  .         [10/134]","","Musnad Abi Ya'la al-Mawsili 5760","","عبد الله بن عمر بن الخطاب عن عباس بن جليد الحجري عن حميد بن هانئ الخولاني عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5762","347 - (  5761  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُبَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  طَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَاحِلَتِهِ         [10/135]      يَوْمَ فَتْحِ مَكَّةَ  ،  يَسْتَلِمُ الْأَرْكَانَ  بِمِحْجَنٍ  مَعَهُ  .","","Musnad Abi Ya'la al-Mawsili 5761","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبيدة بن نشيط الحميري عن موسى بن عبيدة بن نشيط الحميري عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5763","348 - (  5762  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الزِّمَّانِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَارِثِ الْحَارِثِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْبَيْلَمَانِيُّ ،  عَنْ  أَبِيهِ  ،         [10/136]      عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  حَلَفَ  عَلَى يَمِينٍ فَرَأَى غَيْرَهَا  -  يَعْنِي خَيْرًا مِنْهَا  - فَكَفَّارَتُهَا تَرْكُهَا  .         [10/137]             [10/138]             [10/139]             [10/140]             [10/141]","","Musnad Abi Ya'la al-Mawsili 5762","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن محمد بن الحارث بن زياد البصري عن محمد بن يحيى بن فياض الزماني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5764","349 - (  5763  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ، قَالَ :  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَارِثِ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرْأَفُ أُمَّتِي بِأُمَّتِي  أَبُو بَكْرٍ  ، وَأَشَدُّهُمْ فِي الْإِسْلَامِ  عُمَرُ  ، وَأَصْدَقُهُمْ حَيَاءً  عُثْمَانُ بْنُ عَفَّانَ  ، وَأَقْضَاهُمْ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، وَأَفْرَضُهُمْ  زَيْدُ بْنُ ثَابِتٍ  ، وَأَعْلَمُهُمْ بِالْحَلَالِ وَالْحَرَامِ  مُعَاذُ بْنُ جَبَلٍ  ،  وَأَقْرَؤُهُمْ  أُبَيُّ بْنُ كَعْبٍ  ، وَلِكُلِّ أُمَّةٍ أَمِينٌ ، وَأَمِينُ هَذِهِ الْأُمَّةِ  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  .         [10/142]","","Musnad Abi Ya'la al-Mawsili 5763","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن البيلماني المدني عن محمد بن عبد الرحمن ابن البيلماني الكوفي عن محمد بن الحارث بن زياد البصري عن محمد بن يحيى بن فياض الزماني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5765","350 - (  5764  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  عَمِّهِ وَاسِعِ بْنِ حَبَّانَ ،  أَنَّهُ سَأَلَ  عَبْدَ اللهِ بْنَ عُمَرَ عَنْ صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَقَالَ : اللهُ أَكْبَرُ ، كُلَّمَا رَفَعَ ، وَكُلَّمَا وَضَعَ ، ثُمَّ يَقُولُ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، عَنْ يَمِينِهِ ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، عَنْ يَسَارِهِ  .         [10/143]","","Musnad Abi Ya'la al-Mawsili 5764","","عبد الله بن عمر بن الخطاب عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن عمرو بن يحيى بن عمارة المازني عن ابن جريج عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5766","351 - (  5765  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  مُحَمَّدٍ ،  عَنِ  ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، أَنَّهُمَا قَالَا :  سَمِعْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ عَلَى أَعْوَادِ مِنْبَرِهِ :  لَيَنْتَهِيَنَّ أَقْوَامٌ عَنْ  وَدْعِهِمُ  الْجُمُعَاتِ ، أَوْ لَيَخْتِمَنَّ اللهُ عَلَى قُلُوبِهِمْ  ، ثُمَّ لَيَكُونُنَّ مِنَ الْغَافِلِينَ  .","","Musnad Abi Ya'la al-Mawsili 5765","","عبد الله بن عباس عن محمد بن عبد الرحمن بن ثوبان القرشي عن يحيى بن أبي كثير عن أيوب السختياني عن إسماعيل ابن علية عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5767","352 - (  5766  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ الْعَطَّارُ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  زَيْدٍ أَبِي سَلَّامٍ ،  عَنِ  الْحَكَمِ بْنِ مِينَاءَ ،  عَنِ  ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوًا         [10/144]      مِنْ حَدِيثِ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ .","","Musnad Abi Ya'la al-Mawsili 5766","","عبد الله بن عباس عن الحكم بن ميناء الأنصاري عن زيد بن سلام الحبشي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن عفان بن مسلم الصفار عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5768","353 - (  5767  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ عَنْهُ ، فَسَأَلْتُهُ - يَعْنِي  مُسْلِمًا  -  فَحَدَّثَنِي  مُسْلِمُ بْنُ أَبِي مَرْيَمَ ،  أَنَّهُ سَمِعَ  عَلِيَّ بْنَ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيَّ - وَقَالَ أَيْضًا :  حَدَّثَنِي  عَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ الْمُعَاوِيُّ - قَالَ :  صَلَّيْتُ إِلَى جَنْبِ ابْنِ عُمَرَ ، فَجَعَلْتُ أُقَلِّبُ الْحَصَى ، فَقَالَ :  لَا تُقَلِّبِ الْحَصَى ، فَإِنَّ تَقْلِيبَ الْحَصَى مِنَ الشَّيْطَانِ  ، وَافْعَلْ كَمَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ .  فَقُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، وَكَيْفَ رَأَيْتَهُ يَفْعَلُ ؟ قَالَ : هَكَذَا ، وَوَضَعَ يَدَهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى ، وَيَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَأَشَارَ بِالَّتِي تَلِي الْإِبْهَامَ .         [10/145]             [10/146]      قَالَ  مُسْلِمٌ  :  فَبَلَغَنَا أَنَّهَا مِذَبَّةُ الشَّيْطَانِ ، وَأَنَّهُ لَا يَشْهَدُ الْإِنْسَانَ وَهُوَ قَائِلٌ بِيَدِهِ هَكَذَا  .","","Musnad Abi Ya'la al-Mawsili 5767","","عبد الله بن عمر بن الخطاب عن علي بن عبد الرحمن المعاوي عن مسلم بن أبي مريم الأنصاري عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5769","354 - (  5768  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  أَنَسُ بْنُ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي مِنَ اللَّيْلِ مَثْنَى مَثْنَى  ، وَيُوتِرُ بِرَكْعَةٍ ، وَيُصَلِّي رَكْعَتَيْنِ قَبْلَ الْغَدَاةِ  .","","Musnad Abi Ya'la al-Mawsili 5768","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5770","355 - (  5769  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  أَنَسُ بْنُ سِيرِينَ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ ، قُلْتُ : الرَّكْعَتَيْنِ قَبْلَ الْغَدَاةِ أُطِيلُ فِيهِمَا الْقِرَاءَةَ ؟ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ مَثْنَى مَثْنَى  ، وَيُوتِرُ بِرَكْعَةٍ ، قُلْتُ : إِنِّي لَسْتُ عَنْ هَذَا أَسْأَلُكَ ، قَالَ : إِنَّكَ لَضَخْمٌ ! أَلَا تَدَعُنِي أَسْتَقْرِئُ لَكَ الْحَدِيثَ ؟ .         [10/147]      كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ مَثْنَى مَثْنَى ، وَيُوتِرُ بِرَكْعَةٍ ، ثُمَّ يُصَلِّي رَكْعَتَيْنِ قَبْلَ الْغَدَاةِ كَأَنَّ الْأَذَانَ بِأُذُنَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 5769","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5771","356 - (  5770  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  أَيُّوبُ ، وَبُدَيْلٌ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَيْفَ صَلَاةُ اللَّيْلِ ؟ فَقَالَ : مَثْنَى مَثْنَى  ، فَإِذَا خَشِيتَ الصُّبْحَ فَصَلِّ رَكْعَةً وَاجْعَلْ آخِرَ صَلَاتِكَ  وِتْرًا  ، ثُمَّ سَأَلَهُ عَلَى رَأْسِ الْحَوْلِ - وَأَنَا بِذَلِكَ الْمَكَانِ مِنْ رَسُولِ اللهِ - فَلَا أَدْرِي هُوَ ذَاكَ الرَّجُلُ أَوْ رَجُلٌ آخَرُ ، فَقَالَ لَهُ مِثْلَ ذَلِكَ  .         [10/148]","","Musnad Abi Ya'la al-Mawsili 5770","","عبد الله بن عمر بن الخطاب عن عبد الله بن شقيق العقيلي عن بديل بن ميسرة العقيلي عن حماد بن زيد عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5772","357 - (  5771  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، وَسَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ صَلَّاهُمَا بِإِقَامَةٍ وَاحِدَةٍ ،  وَقَالَ : هَكَذَا صَنَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي هَذَا الْمَكَانِ  .","","Musnad Abi Ya'la al-Mawsili 5771","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5773","358 - (  5772  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَ حَدِيثِ  عُبَيْدِ اللهِ  ، عَنْ  نَافِعٍ  ، عَنِ  ابْنِ عُمَرَ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَاعَنَ بَيْنَ  امْرَأَةٍ  وَزَوْجِهَا  وَفَرَّقَ بَيْنَهُمَا  .         [10/149]","","Musnad Abi Ya'la al-Mawsili 5772","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الملك بن أبي سليمان العرزمي عن عبدة بن سليمان الكلابي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5774","359 - (  5773  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  أَبِي الْعَبَّاسِ الشَّاعِرِ الْأَعْمَى ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  حَاصَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَهْلَ         [10/150]      الطَّائِفِ  فَلَمْ يَنَلْ مِنْهُمْ شَيْئًا  ، فَقَالَ : إِنَّا قَافِلُونَ إِنْ شَاءَ اللهُ .  فَقَالَ أَصْحَابُهُ : نَرْجِعُ وَلَمْ نَفْتَتِحْ ؟ فَقَالَ لَهُمْ رَسُولُ اللهِ : اغْدُوا عَلَى الْقِتَالِ ، فَغَدَوْا عَلَيْهِ ، فَأَصَابَهُمْ جِرَاحٌ ، فَقَالَ لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّا قَافِلُونَ غَدًا ، فَأَعْجَبَهُمْ ذَلِكَ ، فَضَحِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [10/151]             [10/152]             [10/153]","","Musnad Abi Ya'la al-Mawsili 5773","","عبد الله بن عمر بن الخطاب عن السائب بن فروخ الشاعر عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5775","360 - (  5774  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سَعِيدُ بْنُ زِيَادٍ الشَّيْبَانِيُّ ،  حَدَّثَنَا  زِيَادُ بْنُ صُبَيْحٍ الْحَنَفِيُّ ، قَالَ :  كُنْتُ قَائِمًا أُصَلِّي إِلَى  الْبَيْتِ  ، وَشَيْخٌ إِلَى جَنْبِي ، فَأَطَلْتُ الصَّلَاةَ ، فَوَضَعْتُ يَدَيَّ عَلَى خَصْرِي ، فَضَرَبَ الشَّيْخُ صَدْرِي بِيَدِهِ ضَرْبَةً لَا يَأْلُو ، فَقُلْتُ فِي نَفْسِي : مَا رَابَهُ مِنِّي ؟ فَأَسْرَعْتُ الِانْصِرَافَ ، فَإِذَا غُلَامٌ خَلْفَهُ قَاعِدٌ ، فَقُلْتُ : مَنْ هَذَا الشَّيْخُ ؟ فَقَالَ : هَذَا عَبْدُ اللهِ بْنُ عُمَرَ ، فَجَلَسْتُ حَتَّى انْصَرَفَ ، فَقُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، مَا رَابَكَ مِنِّي ؟         [10/154]      قَالَ : أَنْتَ هُوَ ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ :  ذَاكَ الصَّلْبُ فِي الصَّلَاةِ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 5774","","عبد الله بن عمر بن الخطاب عن زياد بن صبيح الحنفي عن سعيد بن زياد الشيباني عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5776","361 - (  5775  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  يُونُسَ ،  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هُنَيْدَةَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَرَادَ اللهُ أَنْ يَخْلُقَ  نَسَمَةً  ، قَالَ مَلَكُ الْأَرْحَامِ مُعْرِضًا : أَيْ رَبِّ ، أَذَكَرٌ أَمْ         [10/155]      أُنْثَى ؟  فَيَقُولُ : فَيَقْضِي اللهُ أَمْرَهُ ، ثُمَّ يَقُولُ : أَيْ رَبِّ ، أَشَقِيٌّ أَمْ سَعِيدٌ ؟ فَيَقْضِي اللهُ أَمْرَهُ ، ثُمَّ يَكْتُبُ بَيْنَ عَيْنَيْهِ مَا هُوَ لَاقٍ حَتَّى النَّكْبَةَ يُنْكَبُهَا  .","","Musnad Abi Ya'la al-Mawsili 5775","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن هنيدة مولى عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5777","362 - (  5776  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ سَلْمَانَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  حَفِظْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشْرَ رَكَعَاتٍ  : رَكْعَتَيْنِ قَبْلَ صَلَاةِ الْفَجْرِ ، وَرَكْعَتَيْنِ قَبْلَ صَلَاةِ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ صَلَاةِ الظُّهْرِ ، وَرَكْعَتَيْنِ بَعْدَ صَلَاةِ الْمَغْرِبِ ، وَرَكْعَتَيْنِ بَعْدَ صَلَاةِ الْعِشَاءِ  .         [10/156]","","Musnad Abi Ya'la al-Mawsili 5776","","عبد الله بن عمر بن الخطاب عن المغيرة بن سلمان الخزاعي عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5778","363 - (  5777  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ، قَالَ :  كَانَ ابْنُ عُمَرَ يَتَوَضَّأُ ثَلَاثًا ثَلَاثًا ،  يَرْفَعُهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  وَكَانَ ابْنُ عَبَّاسٍ يَتَوَضَّأُ مَرَّةً مَرَّةً ،  يَرْفَعُهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 5777","","عبد الله بن عباس عن المطلب بن عبد الله بن حنطب المخزومي عن أبو عمرو الأوزاعي عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5779","364 - (  5778  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَمْرٍو ،  حَدَّثَنَا  عِيسَى بْنُ حَفْصٍ ،  أَخْبَرَنِي  أَبِي  ،  أَنَّهُ كَانَ مَعَ ابْنِ عُمَرَ بِطَرِيقِ  مَكَّةَ  فَصَلَّى بِهِمْ ، ثُمَّ انْصَرَفَ إِلَى رَحْلِهِ وَانْصَرَفْنَا مَعَهُ ، فَالْتَفَتَ فَرَأَى نَاسًا يُصَلُّونَ ، فَقَالَ : مَا يَصْنَعُ هَؤُلَاءِ ؟ قُلْتُ : يُسَبِّحُونَ .         [10/157]      قَالَ : لَوْ كُنْتُ مُسَبِّحًا لَأَتْمَمْتُ صَلَاتِي ، يَا ابْنَ أَخِي ،  صَحِبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَزِدْ فِي السَّفَرِ عَلَى رَكْعَتَيْنِ  ، حَتَّى قَبَضَهُ اللهُ ، ثُمَّ صَحِبْتُ  أَبَا بَكْرٍ  فَلَمْ يَزِدْ عَلَى رَكْعَتَيْنِ ، ثُمَّ صَحِبْتُ  عُمَرَ  فَلَمْ يَزِدْ عَلَى رَكْعَتَيْنِ ، ثُمَّ صَحِبْتُ  عُثْمَانَ  فَلَمْ يَزِدْ عَلَى رَكْعَتَيْنِ ، حَتَّى قَبَضَهُ اللهُ  ، وَقَالَ اللهُ :         {      لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ         }      .","","Musnad Abi Ya'la al-Mawsili 5778","","عبد الله بن عمر بن الخطاب عن جرير بن حازم عن عيسى بن حفص بن عاصم بن عمر بن الخطاب عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5780","365 - (  5779  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  سَعِيدِ بْنِ عَامِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَمَرَّ بِبِرْكَةٍ مِنْ مَاءٍ  فَكَرَعُوا  فِيهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَكْرَعُوا ، وَلَكِنِ اغْسِلُوا أَيْدِيَكُمْ وَاشْرَبُوا  ، فَإِنَّهُ لَيْسَ مِنَ الْآنِيَةِ شَيْءٌ أَنْظَفَ مِنَ الْيَدِ  .","","Musnad Abi Ya'la al-Mawsili 5779","","عبد الله بن عمر بن الخطاب عن سعيد بن عامر عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5781","366 - (  5780  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَاصِمٍ ، قَالَ :  قُلْتُ  لِعَبْدِ اللهِ بْنِ عُمَرَ - وَهُوَ  بِمِنًى  - : كَمْ تُصَلِّي هَاهُنَا ؟ قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ  ،  وَأَبُو بَكْرٍ  رَكْعَتَيْنِ ،  وَعُمَرُ         [10/158]      رَكْعَتَيْنِ ، وَصَلَّاهَا  عُثْمَانُ  سِتَّ سِنِينَ رَكْعَتَيْنِ ، ثُمَّ صَلَّوْهَا أَرْبَعًا ، فَكُنَّا إِذَا صَلَّيْنَا مَعَهُمْ صَلَّيْنَا أَرْبَعًا ، وَإِذَا صَلَّيْنَا عَلَى  حِدَةٍ  صَلَّيْنَا رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5780","","عبد الله بن عمر بن الخطاب عن داود بن أبي عاصم الطائفي عن يزيد بن أبي زياد القرشي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5782","367 - (  5781  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، قَالَ :  قَالَ  ابْنُ عُمَرَ :  كُنَّا فِي جَيْشٍ بَعَثَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَحَاصَ  النَّاسُ حَيْصَةً ، فَانْهَزَمْنَا وَكُنَّا نَفَرًا ، فَقُلْنَا : نَهَرُبُ فِي الْأَرْضِ ، وَلَا نَأْتِي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَيَاءً مِمَّا صَنَعْنَا ، ثُمَّ قَالَ بَعْضُنَا : لَوْ أَتَيْنَا  الْمَدِينَةَ  فَامْتَرَيْنَا مِنْهَا وَتَجَهَّزْنَا ، فَلَمَّا دَخَلْنَا  الْمَدِينَةَ  ، قُلْنَا : لَوْ عَرَضْنَا أَنْفُسَنَا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : فَنَظَرْنَاهُ عِنْدَ صَلَاةِ الْفَجْرِ ، فَلَمَّا خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قُلْنَا :  يَا رَسُولَ اللهِ ، نَحْنُ الْفَرَّارُونَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : بَلْ أَنْتُمُ  الْعَكَّارُونَ  ، أَنَا  فِئَةُ  الْمُسْلِمِينَ  .","","Musnad Abi Ya'la al-Mawsili 5781","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5783","368 - (  5782  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  فِرَاسٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  زَاذَانَ ،  أَنَّ  ابْنَ عُمَرَ لَطَمَ غُلَامًا لَهُ ، ثُمَّ أَعْتَقَهُ ، فَقَالَ : مَا لِي مِنْ أَجْرِهِ         [10/159]      هَذِهِ - وَأَخَذَ شَيْئًا مِنَ الْأَرْضِ - سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ ضَرَبَ عَبْدَهُ ظَالِمًا ، لَمْ يَكُنْ لَهُ كَفَّارَةٌ دُونَ عِتْقِهِ  .","","Musnad Abi Ya'la al-Mawsili 5782","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن ذكوان السمان عن فراس بن يحيى الخارفي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5784","369 - (  5783  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  النَّجْرَانِيِّ ،         [10/160]      عَنِ  ابْنِ عُمَرَ ، قَالَ :  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  يَعْنِي :  بِسَكْرَانَ  ، فَضَرَبَهُ  الْحَدَّ  ، ثُمَّ قَالَ :  مَا شَرَابُكَ ؟ قَالَ : زَبِيبٌ وَتَمْرٌ ، قَالَ : تَخْلِطُونَهَا ؟ بَلَغَ كُلُّ وَاحِدٍ مِنْ صَاحِبِهِ  .         [10/161]","","Musnad Abi Ya'la al-Mawsili 5783","","عبد الله بن عمر بن الخطاب عن النجراني عن ابن عمر عن أبو إسحاق السبيعي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5785","370 - (  5784  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  سُهَيْلٌ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نَعُدُّ - وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَيٌّ ، وَأَصْحَابُهُ مُتَوَافِرُونَ -  أَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  ، ثُمَّ نَسْكُتُ  .","","Musnad Abi Ya'la al-Mawsili 5784","","عبد الله بن عمر بن الخطاب عن ذكوان السمان عن سهيل بن أبي صالح السمان عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5786","371 - (  5785  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  حَجَّاجٌ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ يُهِلُّ إِذَا اسْتَوَتْ بِهِ رَاحِلَتُهُ ، وَيُهِلُّ دُبُرَ الصَّلَاةِ  ، وَكَانَ يَقُولُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَفْعَلُ ذَلِكَ  .         [10/162]             [10/163]","","Musnad Abi Ya'la al-Mawsili 5785","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن حجاج بن أرطاة عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5787","372 - (  5786  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عُمَرَ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْتَرَ عَلَى الْبَعِيرِ  .","","Musnad Abi Ya'la al-Mawsili 5786","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن أبو بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب عن مالك بن أنس عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5788","373 - (  5787  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  عَبْدُ الْمَلِكِ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ  مِنَ الْمَسَاجِدِ ، إِلَّا  الْمَسْجِدَ الْحَرَامَ  .         [10/164]","","Musnad Abi Ya'la al-Mawsili 5787","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5789","374 - (  5788  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ مُحَمَّدًا رَسُولُ اللهِ ، وَإِقَامُ الصَّلَاةِ ، وَإِيتَاءُ الزَّكَاةِ ، وَحَجُّ الْبَيْتِ ، وَصَوْمُ رَمَضَانَ  .         [10/165]             [10/166]","","Musnad Abi Ya'la al-Mawsili 5788","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عاصم بن محمد بن زيد العمري عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5790","375 - (  5789  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  وَهْبِ بْنِ قَطَنٍ ،  أَنَّ مَوْلَاةً  لِابْنِ عُمَرَ  أَتَتْهُ لِتُسَلِّمَ عَلَيْهِ لِتَخْرُجَ مِنَ  الْمَدِينَةِ  ، وَقَالَتْ : أَخْرُجُ إِلَى الرِّيفِ فَقَدِ اشْتَدَّ عَلَيْنَا الزَّمَانُ .  فَقَالَ  ابْنُ عُمَرَ : اجْلِسِي  لَكَاعِ  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَبَرَ عَلَى  لَأْوَائِهَا  وَشِدَّتِهَا  ، كُنْتُ لَهُ  شَفِيعًا - أَوْ شَهِيدًا -  يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 5789","","عبد الله بن عمر بن الخطاب عن قطن بن وهب الخزاعي عن عبيد الله بن عمر العمري عن عبيد الله بن عبد المجيد الحنفي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5791","376 - (  5790  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عُمَرَ ،  حَدَّثَنَا  مَالِكٌ ،  عَنْ  قَطَنِ بْنِ وَهْبٍ ،  عَنْ  يُحَنَّسَ ،  أَنَّ  مَوْلَاةً لِابْنِ عُمَرَ  أَتَتْهُ ، فَقَالَتْ :         [10/167]      عَلَيْكَ السَّلَامُ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، فَقَالَ : مَا شَأْنُكِ ؟ فَقَالَتْ : أَرَدْتُ الْخُرُوجَ إِلَى الرِّيفِ وَذَكَرَتِ السِّعْرَ ، فَقَالَ لَهَا : اقْعُدِي  لَكَاعِ  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَصْبِرُ عَلَى  لَأْوَائِهَا  وَشِدَّتِهَا أَحَدٌ إِلَّا كُنْتُ لَهُ  شَفِيعًا - أَوْ شَهِيدًا -  يَوْمَ الْقِيَامَةِ  .         [10/168]","","Musnad Abi Ya'la al-Mawsili 5790","","عبد الله بن عمر بن الخطاب عن يحنس بن أبي موسى الزبيري عن قطن بن وهب الخزاعي عن مالك بن أنس عن إسماعيل بن عمر الواسطي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5792","377 - (  5791  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ صَلَّى الْمَغْرِبَ وَالْعِشَاءَ بِجَمْعٍ ، بِإِقَامَةٍ وَاحِدَةٍ ،  ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Musnad Abi Ya'la al-Mawsili 5791","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5793","378 - (  5792  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سُفْيَانُ بْنُ سَعِيدٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَالِكٍ ، قَالَ :  صَلَّيْتُ مَعَ ابْنِ عُمَرَ الْمَغْرِبَ وَالْعِشَاءَ  بِالْمُزْدَلِفَةِ  ، فَصَلَّى الْمَغْرِبَ ثَلَاثًا  ، وَالْعِشَاءَ رَكْعَتَيْنِ بِإِقَامَةٍ ، فَلَمَّا فَرَغَ ، قَالَ لَهُ رَجُلٌ : مَا هَذِهِ الصَّلَاةُ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟  قَالَ  : صَلَّيْتُهَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 5792","","عبد الله بن عمر بن الخطاب عن عبد الله بن مالك بن الحارث الهمداني عن أبو إسحاق السبيعي عن سفيان الثوري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5794","379 - (  5793  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ عِيسَى ، قَالَ :  حَدَّثَنِي  لَيْثٌ ، قَالَ :  حَدَّثَنِي  ابْنُ شِهَابٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،         [10/169]      عَنِ  ابْنِ عُمَرَ ،  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ وَهُوَ قَائِمٌ عَلَى الْمِنْبَرِ :  مَنْ جَاءَ مِنْكُمْ إِلَى الْجُمُعَةِ فَلْيَغْتَسِلْ  .","","Musnad Abi Ya'la al-Mawsili 5793","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبد الله بن عمر بن الخطاب عن الزهري عن الليث بن سعد عن إسحاق بن عيسى بن نجيح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5795","380 - (  5794  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ، قَالَ :  حَدَّثَنِي  مَالِكٌ ، عَنْ نَافِعٍ ، وَعَبْدِ اللهِ بْنِ دِينَارٍ ، وَزَيْدِ بْنِ أَسْلَمَ ، كُلُّهُمْ  يُخْبِرُونَهُ ، عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَنْظُرُ اللهُ يَوْمَ الْقِيَامَةِ إِلَى مَنْ جَرَّ إِزَارَهُ  خُيَلَاءَ  .","","Musnad Abi Ya'la al-Mawsili 5794","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن مالك بن أنس عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5796","381 - (  5795  ) -  حَدَّثَنَا  مُصْعَبٌ ،  أَخْبَرَنِي  مَالِكٌ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الشِّغَارِ  .         [10/170]             [10/171]","","Musnad Abi Ya'la al-Mawsili 5795","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5797","382 - (  5796  ) -  حَدَّثَنَا  مُصْعَبٌ ، وَسُوَيْدُ بْنُ سَعِيدٍ ، قَالَ  مُصْعَبٌ  :  حَدَّثَنِي  ، وَقَالَ  سُوَيْدٌ  : مَالِكٌ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  النَّجْشِ  .         [10/172]","","Musnad Abi Ya'la al-Mawsili 5796","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5798","383 - (  5797  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ بَاعَ نَخْلًا قَدْ  أُبِّرَتْ  فَثَمَرَتُهَا  لِلْبَائِعِ ، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .         [10/173]","","Musnad Abi Ya'la al-Mawsili 5797","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5799","384 - (  5798  ) -  وَعَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ ابْتَاعَ طَعَامًا فَلَا يَبِعْهُ ، حَتَّى يَسْتَوْفِيَهُ  .         [10/174]","","Musnad Abi Ya'la al-Mawsili 5798","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5800","384 - (  5798  ) -  وَعَنِ  ابْنِ عُمَرَ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ الثِّمَارِ حَتَّى يَبْدُوَ صَلَاحُهَا  ، نَهَى الْبَائِعَ وَالْمُشْتَرِيَ  .         [10/175]","","Musnad Abi Ya'la al-Mawsili 5798","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5801","385 - (  5799  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5799","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5802","386 - (  5800  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ قَالَ :  كُنَّا فِي زَمَانِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَبْتَاعُ الطَّعَامَ  ، فَيَبْعَثُ إِلَيْنَا مَنْ يَأْمُرُنَا بِانْتِقَالِهِ مِنَ الْمَكَانِ الَّذِي ابْتَعْنَاهُ فِيهِ إِلَى مَكَانٍ سِوَاهُ قَبْلَ أَنْ نَبِيعَهُ  .         [10/176]","","Musnad Abi Ya'la al-Mawsili 5800","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5803","387 - (  5801  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا  يَبِعْ  بَعْضُكُمْ عَلَى بَيْعِ بَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 5801","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5804","388 - (  5802  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،         [10/177]      عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَعْتَقَ  شِرْكًا  لَهُ فِي عَبْدٍ ، فَكَانَ لَهُ مَالٌ يَبْلُغُ ثَمَنَ الْعَبْدِ قُوِّمَ عَلَيْهِ قِيمَةَ الْعَدْلِ  ، فَأَعْطَى شُرَكَاءَهُ حِصَصَهُمْ  وَأُعْتِقَ  عَلَيْهِ ، وَإِلَّا عَتَقَ مِنْهُ مَا عَتَقَ  .         [10/178]             [10/179]             [10/180]","","Musnad Abi Ya'la al-Mawsili 5802","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5805","389 - (  5803  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ، قَالَ :  قَرَأْتُ عَلَى  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُهِلُّ  أَهْلُ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَأَهْلُ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَأَهْلُ نَجْدٍ  مِنْ  قَرَنٍ  .  قَالَ  عَبْدُ اللهِ  : وَبَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : وَيُهِلُّ  أَهْلُ الْيَمَنِ  مِنْ  يَلَمْلَمَ  .","","Musnad Abi Ya'la al-Mawsili 5803","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5806","390 - (  5804  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ تَلْبِيَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ         [10/181]      وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .  قَالَ : فَكَانَ عَبْدُ اللهِ يَزِيدُ فِيهَا :  لَبَّيْكَ  لَبَّيْكَ  لَبَّيْكَ ،  وَسَعْدَيْكَ ،  وَالْخَيْرُ فِي يَدَيْكَ ، وَالرَّغْبَاءُ إِلَيْكَ وَالْعَمَلُ  .","","Musnad Abi Ya'la al-Mawsili 5804","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5807","391 - (  5805  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  مَالِكٌ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَنَّ  رَجُلًا  سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا يَلْبَسُ الْمُحْرِمُ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا يَلْبَسُ الْقَمِيصَ  ، وَلَا الْعِمَامَةَ ، وَلَا السَّرَاوِيلَاتِ ، وَلَا الْخِفَافَ ، إِلَّا أَحَدٌ لَا يَجِدُ نَعْلَيْنِ فَلْيَلْبَسْ خُفَّيْنِ ، وَلْيَقْطَعْهُمَا أَسْفَلَ مِنَ  الْكَعْبَيْنِ  ، وَلَا يَلْبَسُ مِنَ الثِّيَابِ مَا مَسَّهُ الزَّعْفَرَانُ ، وَلَا الْوَرْسُ  .","","Musnad Abi Ya'la al-Mawsili 5805","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5808","392 - (  5806  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنِي  صَخْرُ بْنُ جُوَيْرِيَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الَّذِي تَفُوتُهُ صَلَاةُ الْعَصْرِ ، فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .         [10/182]","","Musnad Abi Ya'la al-Mawsili 5806","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن صخر بن جويرية الهلالي عن علي بن الجعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5809","393 - (  5807  ) -  حَدَّثَنَا  عَلِيٌّ ،  أَخْبَرَنِي  صَخْرُ بْنُ جُوَيْرِيَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَبِيعُ  حَاضِرٌ  لِبَادٍ  ، وَقَالَ : لَا تَلَقَّوُا الْبُيُوعَ ، وَلَا  يَبِعْ  بَعْضُكُمْ عَلَى بَيْعِ بَعْضٍ ، وَلَا  يَخْطُبْ  أَحَدُكُمْ عَلَى خِطْبَةِ أَخِيهِ ، حَتَّى يَتْرُكَ الْخَاطِبُ الْأَوَّلُ ، أَوْ يَأْذَنَ لَهُ فَيَخْطُبَ  .         [10/183]","","Musnad Abi Ya'la al-Mawsili 5807","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن صخر بن جويرية الهلالي عن علي بن الجعد عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5810","394 - (  5808  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَعْتَقَ نَصِيبًا لَهُ فِي عَبْدٍ ، وَكَانَ لَهُ مِنَ الْمَالِ قَدْرُ مَا يَبْلُغُ ثَمَنَهُ ، قُوِّمَ عَلَيْهِ قِيمَةَ عَدْلٍ  ، وَإِلَّا فَقَدْ عَتَقَ مِنْهُ مَا عَتَقَ  .","","Musnad Abi Ya'la al-Mawsili 5808","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5811","395 - (  5809  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ  رَجُلًا  نَادَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ عَلَى الْمِنْبَرِ - فَقَالَ :  يَا رَسُولَ اللهِ ، كَيْفَ صَلَاةُ اللَّيْلِ ؟  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَكَذَا - بِأُصْبُعِهِ يَصِفُهَا - مَثْنَى مَثْنَى ، فَإِذَا خَشِيتَ الصُّبْحَ فَصَلِّ رَكْعَةً تُوتِرُ لَكَ صَلَاتَكَ  .","","Musnad Abi Ya'la al-Mawsili 5809","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5812","396 - (  5810  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  نَافِعٍ ،         [10/184]      عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَالَ  رَجُلٌ  وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ :  يَا رَسُولَ اللهِ ، مَا يَقْتُلُ الْمُحْرِمُ مِنَ الدَّوَابِّ ؟ قَالَ : الْغُرَابَ ،  وَالْحِدَأَةَ  ، وَالْكَلْبَ  الْعَقُورَ  .  قَالَ  جَرِيرٌ  : وَقَالَ لِي  أَيُّوبُ  :  قُلْتُ  لِنَافِعٍ  : فَالْحَيَّةُ ؟ قَالَ : تِلْكَ لَا يَخْتَلِفُ فِيهَا اثْنَانِ  .","","Musnad Abi Ya'la al-Mawsili 5810","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5813","397 - (  5811  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَلِمُ الْحَجَرَ  ، فَمَا مَرَرْتُ بِهِ مُنْذُ رَأَيْتُهُ إِلَّا  اسْتَلَمْتُهُ  .         [10/185]      قَالَ نَافِعٌ :  كَانَ ابْنُ عُمَرَ يُزَاحِمُ عَلَيْهِ ، فَإِذَا رَأَوْهُ وَسَّعُوا لَهُ ،  فَلَقَدْ وَقَعْتُ يَوْمًا فِي زِحَامِ النَّاسِ ، فَوَضَعَ رَجُلٌ مِرْفَقَهُ مِنْ خَلْفِي ، وَوَقَعَ الرَّجُلُ مِنْ أَمَامِهِ ، وَوَقَعْتُ مِنْ خَلْفِي ، فَمَا ظَنَنْتُ أَنْ أَنْفَلِتَ حَتَّى يَقْتُلُونِي وَأَبَى هُوَ إِلَّا أَنْ يَتَقَدَّمَ  .","","Musnad Abi Ya'la al-Mawsili 5811","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5814","398 - (  5812  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَالَ  رَجُلٌ  - وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ - : مَا يَلْبَسُ الْمُحْرِمُ ؟  قَالَ :  لَا يَلْبَسُ الْقَمِيصَ ، وَلَا الْعِمَامَةَ ، وَلَا السَّرَاوِيلَ  ، وَلَا  الْبُرْنُسَ  ، وَلَا الْخُفَّيْنِ ، إِلَّا لِأَحَدٍ لَا يَجِدُ نَعْلَيْنِ ، فَمَا أَسْفَلَ مِنَ  الْكَعْبَيْنِ  ، وَلَا شَيْءَ مِنَ الثِّيَابِ مَسَّهُ وَرْسٌ ، وَلَا زَعْفَرَانٌ  .","","Musnad Abi Ya'la al-Mawsili 5812","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5815","399 - (  5813  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  حَرْبُ بْنُ سُرَيْجٍ         [10/186]      الْمِنْقَرِيُّ ،  حَدَّثَنَا  أَيُّوبُ السَّخْتِيَانِيُّ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نُمْسِكُ عَنِ الِاسْتِغْفَارِ ، لِأَهْلِ الْكَبَائِرِ ، حَتَّى سَمِعْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :         {      إِنَّ اللهَ لا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ         }      .  قَالَ :  إِنِّي ادَّخَرْتُ دَعْوَتِي شَفَاعَةً لِأَهْلِ الْكَبَائِرِ مِنْ أُمَّتِي  .  قَالَ : فَأَمْسَكْنَا عَنْ كَثِيرٍ مِمَّا كَانَ فِي أَنْفُسِنَا ، ثُمَّ نَطَقْنَا بَعْدُ وَرَجَوْنَا  .         [10/187]","","Musnad Abi Ya'la al-Mawsili 5813","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حرب بن سريج المنقري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5816","400 - (  5814  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَى عُمَرُ بْنُ الْخَطَّابِ  عُطَارِدَ التَّمِيمِيَّ  يُقِيمُ فِي السُّوقِ  حُلَّةً  سِيَرَاءَ  ، وَكَانَ رَجُلًا يَغْشَى الْمُلُوكَ وَيُصِيبُ مِنْهُمْ .  فَقَالَ  عُمَرُ  : يَا رَسُولَ اللهِ ، إِنِّي رَأَيْتُ  عُطَارِدَ  يُقِيمُ فِي السُّوقِ  حُلَّةً  سِيَرَاءَ  فَلَوِ اشْتَرَيْتَهَا ، فَلَبِسْتَهَا لِوُفُودِ الْعَرَبِ ، إِذَا قَدِمُوا عَلَيْكَ - وَأَظُنُّهُ قَالَ : وَتَلْبَسُهَا يَوْمَ الْجُمُعَةِ - ؟ .  فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا يَلْبَسُ الْحَرِيرَ فِي الدُّنْيَا مَنْ لَا  خَلَاقَ  لَهُ فِي الْآخِرَةِ  .  فَلَمَّا كَانَ بَعْدَ ذَلِكَ ، أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِحُلَلٍ  سِيَرَاءَ  ، فَبَعَثَ إِلَى  عُمَرَ  بِحُلَّةٍ  ، وَبَعَثَ إِلَى  أُسَامَةَ  بِحُلَّةٍ  ، وَأَعْطَى  عَلِيًّا  حُلَّةً  ، وَقَالَ : شَقِّقْهَا خُمُرًا بَيْنَ نِسَائِكَ .         [10/188]      فَجَاءَ  عُمَرُ  بِحُلَّتِهِ ، فَقَالَ : يَا رَسُولَ اللهِ ، بَعَثْتَ إِلَيَّ بِهَذِهِ وَقَدْ قُلْتَ أَمْسِ فِي  حُلَّةِ  عُطَارِدَ  ، مَا قُلْتَ ؟ فَقَالَ : إِنِّي لَمْ أَبْعَثْ بِهَا إِلَيْكَ لِتَلْبَسَهَا ، وَلَكِنْ بَعَثْتُ بِهَا إِلَيْكَ لِتُصِيبَ مِنْهَا .  وَأَمَّا  أُسَامَةُ  فَرَاحَ فِي حُلَّتِهِ ، فَنَظَرَ إِلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَظَرًا ، عَرَفَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ أَنْكَرَ مَا صَنَعَ ، فَقَالَ : يَا رَسُولَ اللهِ ، مَا تَنْظُرُ إِلَيَّ ، فَأَنْتَ بَعَثْتَ بِهَا إِلَيَّ ؟ قَالَ : إِنِّي لَمْ أَبْعَثْ إِلَيْكَ لِتَلْبَسَهَا ، وَلَكِنِّي بَعَثْتُ بِهَا إِلَيْكَ لِتُشَقِّقَهَا خُمُرًا بَيْنَ نِسَائِكَ  .","","Musnad Abi Ya'la al-Mawsili 5814","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5817","401 - (  5815  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  مَالِكُ بْنُ أَنَسٍ ،  حَدَّثَنَا  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَتْ تَلْبِيَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ ،  إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .         [10/189]","","Musnad Abi Ya'la al-Mawsili 5815","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5818","402 - (  5816  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ أَبُو عَبْدِ اللهِ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .","","Musnad Abi Ya'la al-Mawsili 5816","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5819","403 - (  5817  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى الثَّقَفِيُّ ، قَالَ :  أَخْبَرَنِي  نَافِعٌ مَوْلَى عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  شَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الرَّكْعَتَيْنِ بَعْدَ الْمَغْرِبِ فِي أَهْلِهِ  ، وَالرَّكْعَتَيْنِ بَعْدَ صَلَاةِ الْعِشَاءِ فِي أَهْلِهِ  .","","Musnad Abi Ya'la al-Mawsili 5817","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن يعلى الثقفي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5820","404 - (  5818  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْمَدِينِيُّ أَبُو إِسْحَاقَ ، قَالَ :  سَمِعْتُ  نَافِعًا ،         [10/190]      عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَنْتَقِبُ الْمُحْرِمَةُ  .","","Musnad Abi Ya'la al-Mawsili 5818","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إبراهيم بن سعيد المدني عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5821","405 - (  5819  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ أَبُو الْفَضْلِ ،  حَدَّثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الشِّغَارِ  ،         [10/191]      قَالَ  مَالِكٌ  :  الشِّغَارُ  : أَنْ يُزَوِّجَ الرَّجُلُ ابْنَتَهُ عَلَى أَنْ يُزَوِّجَهُ ابْنَتَهُ  .","","Musnad Abi Ya'la al-Mawsili 5819","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5822","406 - (  5820  ) -  حَدَّثَنَا  أَبُو عَامِرٍ الْعَدَوِيُّ : يَعْنِي حَوْثَرَةَ بْنَ أَشْرَسَ ، قَالَ :  أَخْبَرَنِي  عُقْبَةُ بْنُ أَبِي الصَّهْبَاءِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الدُّبَّاءِ  وَالْمُقَيَّرِ  .","","Musnad Abi Ya'la al-Mawsili 5820","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عقبة بن أبي الصهباء البصري عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5823","407 - (  5821  ) -  حَدَّثَنَا  سُوَيْدٌ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ  حَبَلِ  الْحَبَلَةِ  ، قَالَ : وَكَانَ يَبْتَاعُهُ أَهْلُ الْجَاهِلِيَّةِ ، وَكَانَ الرَّجُلُ يَبْتَاعُ  الْجَزُورَ  إِلَى أَنْ  تُنْتَجَ  النَّاقَةُ ، ثُمَّ  تُنْتَجُ  الَّتِي فِي بَطْنِهَا  .         [10/192]","","Musnad Abi Ya'la al-Mawsili 5821","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5824","408 - (  5822  ) -  وَعَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْبَيِّعَانِ  بِالْخِيَارِ  ، كُلُّ وَاحِدٍ مِنْهُمَا عَلَى صَاحِبِهِ  بِالْخِيَارِ ،  مَا لَمْ  يَتَفَرَّقَا  إِلَّا بَيْعَ  الْخِيَارِ  .         [10/193]      قَالَ  مَالِكٌ  : وَلَيْسَ لِهَذَا عِنْدَنَا حَدٌّ مَعْرُوفٌ ، وَلَا أَمْرٌ         [10/194]      مَعْمُولٌ بِهِ فِيهِ .","","Musnad Abi Ya'la al-Mawsili 5822","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5825","409 - (  5823  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ، قَالَ :  حَدَّثَنِي  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ لَيْسَ  بِأَعْوَرَ  ،  الْمَسِيحُ الدَّجَّالُ  أَعْوَرُ  ، عَيْنُهُ الْيُمْنَى كَأَنَّهَا عِنَبَةٌ  طَافِيَةٌ  .","","Musnad Abi Ya'la al-Mawsili 5823","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن يعلى الثقفي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5826","410 - (  5824  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  جُوَيْرِيَةُ بْنُ أَسْمَاءَ بْنِ عُبَيْدِ بْنِ مُخَارِقٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الَّذِي تَفُوتُهُ صَلَاةُ الْعَصْرِ ، فَكَأَنَّمَا  وُتِرَ  أَهْلَهُ وَمَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 5824","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5827","411 - (  5825  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ، أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ  أَخْبَرَهُ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الَّذِي يَجُرُّ ثَوْبَهُ مِنَ  الْخُيَلَاءِ  ، لَا يَنْظُرُ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Musnad Abi Ya'la al-Mawsili 5825","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5828","412 - (  5826  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  حَدَّثَنَا  نَافِعٌ ،         [10/195]      أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ  أَخْبَرَهُ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ سَرِيَّةً إِلَى نَجْدٍ فِيهِمْ  عَبْدُ اللهِ  ، فَغَنِمُوا غَنَائِمَ كَثِيرَةً ، وَكَانَتْ  سُهْمَانُهُمُ  اثْنَيْ عَشَرَ بَعِيرًا ، وَنُفِّلَ كُلُّ إِنْسَانٍ مِنْهُمْ  .         [10/196]","","Musnad Abi Ya'la al-Mawsili 5826","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5829","413 - (  5827  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  حَمَلَ  عَلَيْنَا السِّلَاحَ فَلَيْسَ مِنَّا  .         [10/197]","","Musnad Abi Ya'la al-Mawsili 5827","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5830","414 - (  5828  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا  حَقُّ  امْرِئٍ         [10/198]      مُسْلِمٍ لَهُ شَيْءٌ يُوصِي فِيهِ ، يَبِيتُ فَوْقَ لَيْلَتَيْنِ ، إِلَّا وَوَصِيَّتُهُ مَكْتُوبَةٌ عِنْدَهُ  .","","Musnad Abi Ya'la al-Mawsili 5828","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5831","415 - (  5829  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَنْهَانَا ، إِذَا كَانَ نَفَرٌ ثَلَاثَةٌ ، أَنْ  يَتَنَاجَى  اثْنَانِ مِنْهُمْ دُونَ الثَّالِثِ  .","","Musnad Abi Ya'la al-Mawsili 5829","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5832","416 - (  5830  ) -  وَعَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَحَدَكُمْ إِذَا مَاتَ عُرِضَ عَلَيْهِ مَقْعَدُهُ بِالْغَدَاةِ وَالْعَشِيِّ  ، إِنْ كَانَ مِنْ أَهْلِ الْجَنَّةِ ، فَمِنْ أَهْلِ الْجَنَّةِ ، وَإِنْ كَانَ مِنْ أَهْلِ النَّارِ ، فَمِنْ أَهْلِ النَّارِ ، حَتَّى يَبْعَثَهُ اللهُ يَوْمَ الْقِيَامَةِ  .         [10/199]","","Musnad Abi Ya'la al-Mawsili 5830","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5833","417 - (  5831  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَلَا كُلُّكُمْ  رَاعٍ ،  وَكُلُّكُمْ مَسْئُولٌ عَنْ رَعِيَّتِهِ  ، أَلَا فَالْأَمِيرُ الَّذِي عَلَى النَّاسِ  رَاعٍ  عَلَيْهِمْ ، وَمَسْئُولٌ عَنْهُمْ ، وَالرَّجُلُ  رَاعٍ  عَلَى أَهْلِ بَيْتِهِ ، وَمَسْئُولٌ عَنْهُمْ ، وَامْرَأَةُ الرَّجُلِ رَاعِيَةٌ عَلَى بَيْتِ زَوْجِهَا وَوَلَدِهِ ، وَمَسْئُولَةٌ عَنْهُمْ ، وَعَبْدُ الرَّجُلِ  رَاعٍ  عَلَى مَالِ سَيِّدِهِ ، وَمَسْئُولٌ عَنْهُ ، أَلَا فَكُلُّكُمْ  رَاعٍ  وَكُلُّكُمْ مَسْئُولٌ  .         [10/200]             [10/201]","","Musnad Abi Ya'la al-Mawsili 5831","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5834","418 - (  5832  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  سَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عُمَرَ  وَهُوَ يَحْلِفُ بِأَبِيهِ - وَهُوَ فِي رَكْبٍ يَسِيرُ مَعَهُمْ - فَنَادَاهُمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ اللهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ ،  فَمَنْ كَانَ حَالِفًا ، فَلْيَحْلِفْ بِاللهِ أَوْ لِيَصْمُتْ  .","","Musnad Abi Ya'la al-Mawsili 5832","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5835","419 - (  5833  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  قَطَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَارِقًا ، فِي  مِجَنٍّ  قِيمَتُهُ ثَلَاثَةُ دَرَاهِمَ  .         [10/202]             [10/203]","","Musnad Abi Ya'la al-Mawsili 5833","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5836","420 - (  5834  ) -  وَعَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُخْرِجُ زَكَاةَ الْفِطْرِ صَاعًا مِنْ تَمْرٍ ، أَوْ صَاعًا مِنْ شَعِيرٍ  ، فَكَانَ  عَبْدُ اللهِ  يَقُولُ : جَعَلَ النَّاسُ عِدْلَهُ مُدَّيْنِ مِنْ حِنْطَةٍ  .         [10/204]","","Musnad Abi Ya'la al-Mawsili 5834","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5837","421 - (  5835  ) -  وَعَنْ  عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَنَعَ خَاتَمًا مِنْ ذَهَبٍ  ، وَكَانَ يَجْعَلُ فَصَّهُ فِي بَطْنِ كَفِّهِ ، إِذَا لَبِسَهُ فِي يَدِهِ الْيُمْنَى ، فَصَنَعَ النَّاسُ خَوَاتِيمَ مِنْ ذَهَبٍ ، فَجَلَسَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [10/205]      عَلَى الْمِنْبَرِ ، فَنَزَعَهُ وَقَالَ : إِنِّي كُنْتُ أَلْبَسُ هَذَا الْخَاتَمَ ، وَأَجْعَلُ فَصَّهُ فِي بَطْنِ كَفِّي فَرَمَى بِهِ ، وَقَالَ : وَاللهِ لَا أَلْبَسُهُ أَبَدًا ،  فَنَبَذَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْخَاتَمَ ،  فَنَبَذَ  النَّاسُ خَوَاتِيمَهُمْ  .         [10/206]","","Musnad Abi Ya'la al-Mawsili 5835","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5838","422 - (  5836  ) -  وَعَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [10/207]      قَالَ :  مَنْ أَمْسَكَ كَلْبًا ، إِلَّا كَلْبًا ضَارِيًا  ، أَوْ كَلْبَ مَاشِيَةٍ ، فَإِنَّهُ يَنْقُصُ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ .  فَقِيلَ لَهُ : إِنَّ  أَبَا هُرَيْرَةَ  ، يَقُولُ : أَوْ كَلْبَ زَرْعٍ ؟ قَالَ : إِنَّ  أَبَا هُرَيْرَةَ  رَجُلٌ زَرَّاعٌ  .","","Musnad Abi Ya'la al-Mawsili 5836","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5839","423 - (  5837  ) -  حَدَّثَنَا  عَبْدُ اللهِ ،  حَدَّثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ أَحْرَقَ نَخْلَ  بَنِي النَّضِيرِ  ، وَلَهَا يَقُولُ  حَسَّانُ  :  سَرَاةِ         [10/208]","","Musnad Abi Ya'la al-Mawsili 5837","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5840","424 - (  5838  ) -  وَعَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّمَا أَجَلُكُمْ فِي أَجَلِ مَنْ خَلَا مِنَ الْأُمَمِ ، كَمَا بَيْنَ الْعَصْرِ إِلَى مَغْرِبِ الشَّمْسِ  ، وَإِنَّمَا مَثَلُكُمْ وَمَثَلُ الْيَهُودِ وَالنَّصَارَى ، كَمَثَلِ رَجُلٍ اسْتَعْمَلَ عُمَّالًا ، فَقَالَ : مَنْ يَعْمَلُ لِي إِلَى نِصْفِ         [10/209]      النَّهَارِ عَلَى قِيرَاطٍ ؟ فَعَمِلَتِ الْيَهُودُ إِلَى نِصْفِ النَّهَارِ عَلَى قِيرَاطٍ .  ثُمَّ قَالَ : مَنْ يَعْمَلُ لِي مِنْ نِصْفِ النَّهَارِ إِلَى الْعَصْرِ عَلَى قِيرَاطٍ قِيرَاطٍ ؟ فَعَمِلَتِ النَّصَارَى .  ثُمَّ قَالَ : مَنْ يَعْمَلُ مِنْ صَلَاةِ الْعَصْرِ إِلَى مَغْرِبِ الشَّمْسِ عَلَى قِيرَاطَيْنِ قِيرَاطَيْنِ ؟ أَلَا فَأَنْتُمُ الَّذِينَ تَعْمَلُونَ مِنْ صَلَاةِ الْعَصْرِ إِلَى مَغْرِبِ الشَّمْسِ عَلَى قِيرَاطَيْنِ قِيرَاطَيْنِ ، أَلَا فَلَكُمُ الْأَجْرُ مَرَّتَيْنِ .  فَغَضِبَ الْيَهُودُ وَالنَّصَارَى ، وَقَالُوا : نَحْنُ أَكْثَرُ عَمَلًا وَأَقَلُّ عَطَاءً .  قَالَ : هَلْ ظَلَمْتُكُمْ مِنْ حَقِّكُمْ شَيْئًا ؟ قَالُوا : لَا ، قَالَ : فَإِنَّهُ فَضْلِي أُعْطِيهِ مَنْ شِئْتُ  .","","Musnad Abi Ya'la al-Mawsili 5838","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5841","425 - (  5839  ) -  وَعَنْ  عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَابَقَ بَيْنَ الْخَيْلِ  فَيُرْسِلُ مِنَ الْحَفْيَاءِ الْخَيْلَ الَّتِي أُضْمِرَتْ ، وَكَانَ أَمَدُهَا مِنْ  ثَنِيَّةِ الْوَدَاعِ  ، وَسَابَقَ بَيْنَ الْخَيْلِ الَّتِي لَمْ تُضَمَّرْ وَكَانَ أَمَدُهَا مِنْ  ثَنِيَّةِ الْوَدَاعِ  إِلَى  مَسْجِدِ بَنِي زُرَيْقٍ  .  قَالَ : وَأَخْبَرَنِي أَنَّ  عَبْدَ اللهِ  كَانَ يُسَابِقُ بِهَا  .         [10/210]             [10/211]","","Musnad Abi Ya'la al-Mawsili 5839","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5842","426 - (  5840  ) -  وَعَنْ  عَبْدِ اللهِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  جَعَلَ فَرَسًا فِي  سَبِيلِ  اللهِ ، فَحَمَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى ذَلِكَ الْفَرَسِ  رَجُلًا  ،  فَوَجَدَهُ  عُمَرُ  يَبِيعُهُ ، فَقَالَ  عُمَرُ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ الَّذِي حَمَلْتَهُ عَلَى الْفَرَسِ وَجَدْتُهُ يَبِيعُهُ ، فَأَشْتَرِيهِ يَا رَسُولَ اللهِ ؟ قَالَ : لَا تَشْتَرِهِ وَلَا تَعُدْ فِي صَدَقَتِكَ  .","","Musnad Abi Ya'la al-Mawsili 5840","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عبد الله بن عمر"
"5843","[10/212]             [10/213]      [ مُسْنَدُ  أَبِي هُرَيْرَةَ  ]  1 - (  5841  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ أَخُو حَجَّاجٍ الْأَنْمَاطِيِّ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،         [10/214]             [10/215]             [10/216]      عَنْ  أَبِي هُرَيْرَةَ ،  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنْ  فَأْرَةٍ  وَقَعَتْ فِي سَمْنٍ  ، قَالَ : فَقَالَ : إِنْ كَانَ يَابِسًا أَخَذْتَهَا وَمَا حَوْلَهَا ،  وَإِنْ كَانَ ذَائِبًا - أَوْ  مَائِعًا  -  لَا يُؤْكَلُ .         [10/217]             [10/218]","","Musnad Abi Ya'la al-Mawsili 5841","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الواحد بن زياد عن محمد بن المنهال الأنماطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5844","2 - (  5842  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،  أَخْبَرَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  يُونُسُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  عَلَيْكُمْ  بِالْحَبَّةِ  السَّوْدَاءِ  ؛ فَإِنَّ فِيهَا شِفَاءً مِنْ كُلِّ دَاءٍ ، إِلَّا  السَّامَ  .         [10/219]             [10/220]","","Musnad Abi Ya'la al-Mawsili 5842","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5845","3 - (  5843  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي أَيُّوبَ الْإِفْرِيقِيِّ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  سَيَأْتِي أَقْوَامٌ - أَوْ يَكُونُ أَقْوَامٌ -  يُصَلُّونَ لَكُمُ الصَّلَاةَ  ، فَإِنْ أَتَمُّوا فَلَهُمْ وَلَكُمْ ، وَإِنْ نَقَصُوا فَعَلَيْهِمْ وَلَكُمْ  .         [10/221]","","Musnad Abi Ya'la al-Mawsili 5843","","أبو هريرة الدوسي عن سعيد بن المسيب عن صفوان بن سليم القرشي عن عبد الله بن علي الأزرق عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5846","4 - (  5844  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنَا  فُلَيْحٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَاتَلَ  اللهُ الْيَهُودَ ، اتَّخَذُوا  قُبُورَ  أَنْبِيَائِهِمْ مَسَاجِدَ  !  .         [10/222]","","Musnad Abi Ya'la al-Mawsili 5844","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن فليح بن سليمان عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5847","5 - (  5845  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ الْمُسَيِّبِ ،  أَنَّ  أَبَا هُرَيْرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ  مَثَلَ الْمُجَاهِدِ فِي  سَبِيلِ  اللهِ - وَاللهُ أَعْلَمُ بِمَنْ يُجَاهِدُ فِي سَبِيلِهِ - كَمَثَلِ الصَّائِمِ ،  الْقَانِتِ  ، الْخَاشِعِ ، الرَّاكِعِ ، السَّاجِدِ  .         [10/223]","","Musnad Abi Ya'la al-Mawsili 5845","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الله بن المبارك عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5848","6 - (  5846  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ ،         [10/224]             [10/225]      عَنْ  أَبِي هُرَيْرَةَ .  وَعَنْ  حَدِيثِ سَعِيدِ بْنِ الْمُسَيِّبِ .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا قُلْتَ لِصَاحِبِكَ :  أَنْصِتْ  يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ فَقَدْ  لَغَوْتَ  .         [10/226]","","Musnad Abi Ya'la al-Mawsili 5846","","أبو هريرة الدوسي عن إبراهيم بن عبد الله بن قارظ الكناني عن عمر بن عبد العزيز بن مروان عن الزهري عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5849","7 - (  5847  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ جَمِيلٍ الْمَرْوَزِيُّ ،  عَنْ  مَرْوَانَ بْنِ مُعَاوِيَةَ ،  عَنْ  يَاسِينَ بْنِ مُعَاذٍ الزَّيَّاتِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،         [10/227]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَسْلَمَ عَلَى شَيْءٍ فَهُوَ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 5847","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن ياسين بن معاذ الزيات عن مروان بن معاوية الفزاري عن أحمد بن جميل المروزي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5850","8 - (  5848  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ، قَالَ :  حَدَّثَنِي  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يُونُسَ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّهُ قَالَ :  أَخْبَرَنِي  سَعِيدُ بْنُ الْمُسَيِّبِ ، وَأَبُو سَلَمَةَ ،  أَنَّ  أَبَا هُرَيْرَةَ ، سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  قَرَصَتْ نَمْلَةٌ نَبِيًّا مِنَ الْأَنْبِيَاءِ  ، فَأَمَرَ  بِقَرْيَةِ  النَّمْلِ فَأُحْرِقَتْ ، فَأَوْحَى اللهُ إِلَيْهِ : فِي أَنْ قَرَصَتْكَ نَمْلَةٌ أَهْلَكْتَ أُمَّةً مِنَ الْأُمَمِ تُسَبِّحُ ؟  .         [10/228]","","Musnad Abi Ya'la al-Mawsili 5848","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن أنس بن عياض الليثي عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5851","9 - (  5849  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عَمَّارٍ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  مُثَنَّى بْنُ الصَّبَّاحِ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad Abi Ya'la al-Mawsili 5849","","أبو هريرة الدوسي عن سعيد بن المسيب عن عمرو بن شعيب عن المثنى بن الصباح الأبناوي عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن عبد الله بن عمار الغامدي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5852","9 - (  5849  ) - ( م ) -  وَعَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمُسْتَحْجِمُ  .         [10/229]             [10/230]             [10/231]             [10/232]","","Musnad Abi Ya'la al-Mawsili 5849","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عمرو بن شعيب عن المثنى بن الصباح الأبناوي عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن عبد الله بن عمار الغامدي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5853","10 - (  5850  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  أَخْبَرَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  يَقْبِضُ  اللهُ الْأَرْضَ يَوْمَ الْقِيَامَةِ فَيَطْوِي السَّمَاءَ  بِيَمِينِهِ  ، ثُمَّ يَقُولُ : أَنَا الْمَلِكُ أَيْنَ الْمُلُوكُ ؟  .         [10/233]","","Musnad Abi Ya'la al-Mawsili 5850","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5854","11 - (  5851  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  ابْنُ         [10/234]      الْمُبَارَكِ ،  أَخْبَرَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  قَرَصَتْ نَبِيًّا مِنَ الْأَنْبِيَاءِ نَمْلَةٌ  ، فَأَمَرَ  بِقَرْيَةِ  النَّمْلِ فَأُحْرِقَتْ ، فَأَوْحَى اللهُ إِلَيْهِ : أَفِي أَنْ قَرَصَتْكَ نَمْلَةٌ أَحْرَقْتَ أُمَّةً مِنَ الْأُمَمِ تُسَبِّحُ اللهَ ؟ !  .","","Musnad Abi Ya'la al-Mawsili 5851","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5855","12 - (  5852  ) -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْأَسْوَدِ ،  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ الْعَنْقَزِيُّ ،  أَخْبَرَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  بَكْرِ بْنِ وَائِلٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا حَمَلْتُمْ فَأَخِّرُوا  ، فَإِنَّ الرِّجْلَ مُوثَقَةٌ ، وَالْيَدَ مُغْلَقَةٌ .         [10/235]","","Musnad Abi Ya'la al-Mawsili 5852","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن بكر بن وائل التيمي عن قيس بن الربيع الأسدي عن عمرو بن محمد الأحمر عن الحسين بن علي بن الأسود العجلي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5856","13 - (  5853  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ عَسْكَرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ -  رَفَعَهُ  - قَالَ :  إِنَّ فِي الْجَنَّةِ  شَجَرَةً  يَسِيرُ الرَّاكِبُ فِي  ظِلِّهَا  مِائَةَ عَامٍ لَا يَقْطَعُهَا  ، وَاقْرَءُوا إِنْ شِئْتُمْ :         {      وَظِلٍّ مَمْدُودٍ         }      .         [10/236]","","Musnad Abi Ya'la al-Mawsili 5853","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن محمد بن يوسف الفريابي عن محمد بن سهل بن عسكر عن أبو يعلى الموصلي","مسند أبي هريرة"
"5857","14 - (  5854  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ ، أَخُو كَرْخَوَيْهِ ،         [10/237]      حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  حَدَّثَنَا  زَمْعَةُ ،  عَنْ  بُدَيْلٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَقُولَنَّ أَحَدُكُمْ :  خَبُثَتْ  نَفْسِي  ، وَلَكِنْ لِيَقُلْ :  لَقِسَتْ  نَفْسِي  .         [10/238]","","Musnad Abi Ya'la al-Mawsili 5854","","أبو هريرة الدوسي عن سعيد بن المسيب عن بديل بن ميسرة العقيلي عن زمعة بن صالح الجندي عن أبو عامر العقدي عن أخو كرخوية محمد بن يزيد عن أبو يعلى الموصلي","مسند أبي هريرة"
"5858","15 - (  5855  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ أَخُو حَجَّاجٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَرَادَ اللهُ بِعَبْدٍ خَيْرًا ،  فَقَّهَهُ  فِي الدِّينِ  ، وَقَالَ : إِنَّمَا أَنَا قَاسِمٌ ، وَاللهُ يُعْطِي  .         [10/239]             [10/240]","","Musnad Abi Ya'la al-Mawsili 5855","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن معمر بن راشد عن عبد الواحد بن زياد عن محمد بن المنهال الأنماطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5859","16 - (  5856  ) -  حَدَّثَنَا  الْهُذَيْلُ بْنُ إِبْرَاهِيمَ الْجُمَّانِيُّ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الزُّهْرِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَعْمَلُ هَذِهِ الْأُمَّةُ بُرْهَةً بِكِتَابِ اللهِ  ، ثُمَّ تَعْمَلُ بُرْهَةً بِسُنَّةِ رَسُولِ اللهِ ، ثُمَّ تَعْمَلُ بِالرَّأْيِ ، فَإِذَا عَمِلُوا بِالرَّأْيِ ، فَقَدْ ضَلُّوا وَأَضَلُّوا  .         [10/241]","","Musnad Abi Ya'la al-Mawsili 5856","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن عثمان بن عبد الرحمن بن عمر الوقاصي عن الهذيل بن إبراهيم الجماني عن أبو يعلى الموصلي","مسند أبي هريرة"
"5860","17 - (  5857  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَرُزِّيُّ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ الْخَفَّافُ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ  مِنَ الْمَسَاجِدِ ، إِلَّا  الْمَسْجِدَ الْحَرَامَ  .         [10/242]             [10/243]","","Musnad Abi Ya'la al-Mawsili 5857","","أبو هريرة الدوسي عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن محمد بن عبد الله الأرزي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5861","18 - (  5858  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ سَجَّادَةُ ،  حَدَّثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  يَزِيدَ بْنِ سِنَانِ بْنِ أَبِي فَرْوَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى عَلَى جِنَازَةٍ فَكَبَّرَ  ، ثُمَّ وَضَعَ يَدَهُ الْيُمْنَى عَلَى يَدِهِ الْيُسْرَى  .","","Musnad Abi Ya'la al-Mawsili 5858","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن يزيد بن سنان الرهاوي عن يحيى بن يعلى القطواني عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5862","19 - (  5859  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا         [10/244]      رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  حَدَّثَنِي  ابْنُ شِهَابٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ ،  وَعَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا قُلْتَ لِصَاحِبِكَ :  أَنْصِتْ  - وَالْإِمَامُ يَخْطُبُ - فَقَدْ  لَغَوْتَ  .","","Musnad Abi Ya'la al-Mawsili 5859","","أبو هريرة الدوسي عن سعيد بن المسيب عن إبراهيم بن عبد الله بن قارظ الكناني عن عمر بن عبد العزيز بن مروان عن الزهري عن ابن جريج عن روح بن عبادة القيسي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند أبي هريرة"
"5863","20 - (  5860  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، وَأَبِي سَلَمَةَ ، وَعُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَلَّمَ فِي الرَّكْعَتَيْنِ  ، فَقَالَ لَهُ  ذُو الشِّمَالَيْنِ بْنُ عَبْدِ عَمْرِو بْنِ نَضْلَةَ  - وَهُوَ رَجُلٌ مِنْ         [10/245]             [10/246]             [10/247]      خُزَاعَةَ  حَلِيفٌ  لِبَنِي زُهْرَةَ  - :  أَقَصُرَتِ  الصَّلَاةُ ، أَمْ نَسِيتَ يَا رَسُولَ اللهِ ؟ .  قَالَ : لَمْ تَقْصُرْ ، وَلَمْ أَنْسَ . قَالَ  ذُو الشِّمَالَيْنِ  : قَدْ كَانَ بَعْضُ ذَلِكَ يَا رَسُولَ اللهِ ، فَأَقْبَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى مَنْ صَلَّى مَعَهُ ، فَقَالَ : أَصَدَقَ  ذُو الْيَدَيْنِ  ؟ قَالُوا : نَعَمْ ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَمَّ الصَّلَاةَ ، وَلَمْ يَسْجُدِ السَّجْدَتَيْنِ اللَّتَيْنِ تُسْجَدَانِ فِي  وَهْمِ  الصَّلَاةِ حِينَ         [10/248]      لَقَّنَهُ النَّاسُ  .         [10/249]             [10/250]             [10/251]             [10/252]","","Musnad Abi Ya'la al-Mawsili 5860","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5864","21 - (  5861  ) -  حَدَّثَنَا  أَحْمَدُ ،  حَدَّثَنَا  مُبَشِّرٌ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  أَنَّهُ ، سَمِعَ  أَبَا هُرَيْرَةَ ، قَالَ :  قَرَأَ نَاسٌ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي         [10/253]      صَلَاةٍ جَهَرَ فِيهَا بِالْقِرَاءَةِ ، فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَقْبَلَ عَلَيْهِمْ ، فَقَالَ : هَلْ قَرَأَ مَعِي أَحَدٌ ؟ قَالُوا : نَعَمْ ، قَالَ :  إِنِّي أَقُولُ مَا بَالِي  أُنَازَعُ  الْقُرْآنَ ؟  .  قَالَ  الزُّهْرِيُّ  : فَاتَّعَظَ النَّاسُ بِذَلِكَ ، وَلَمْ يَكُونُوا يَقْرَءُونَ فِيمَا جَهَرَ .         [10/254]             [10/255]","","Musnad Abi Ya'la al-Mawsili 5861","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5865","22 - (  5862  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدٍ أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ ،  عَنْ         [10/256]      حَبِيبِ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ هَرِمٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  قَالَ  : كَانَ أَبُو هُرَيْرَةَ ، يَقُولُ :  سَافَرْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَمَعَ  أَبِي بَكْرٍ  ، وَعُمَرَ  ، كُلُّهُمْ صَلَّى حِينَ خَرَجَ مِنَ  الْمَدِينَةِ  إِلَى أَنْ يَرْجِعَ إِلَيْهَا رَكْعَتَيْنِ فِي الْمَسِيرِ ، وَالْمُقَامِ  بِمَكَّةَ  .","","Musnad Abi Ya'la al-Mawsili 5862","","أبو هريرة الدوسي عن جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن حبيب بن أبي حبيب الأنماطي عن عبد الرحمن بن عبد الله بن عبيد جردقة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5866","23 - (  5863  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ دَاوُدَ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  أَخْبَرَنِي  جَابِرٌ ، أَنَّ أَبَا هُرَيْرَةَ  أَخْبَرَهُ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا اسْتَيْقَظَ أَحَدُكُمْ مِنْ مَنَامِهِ ،  فَلْيُفْرِغْ  عَلَى يَدَيْهِ ثَلَاثَ مَرَّاتٍ  قَبْلَ أَنْ         [10/257]      يُدْخِلَهُمَا ؛ فَإِنَّهُ لَا يَدْرِي فِيمَ بَاتَتْ يَدُهُ  .         [10/258]             [10/259]","","Musnad Abi Ya'la al-Mawsili 5863","","أبو هريرة الدوسي عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن موسى بن داود الخلقاني عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5867","24 - (  5864  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَدْخَلَ فَرَسًا بَيْنَ فَرَسَيْنِ وَهُوَ يُؤَمَّلُ أَنْ يُسْبَقَ ، فَلَا خَيْرَ فِيهِ  ، وَمَنْ أَدْخَلَ فَرَسًا بَيْنَ فَرَسَيْنِ وَهُوَ لَا يُؤَمَّلُ أَنْ يُسْبَقَ ، فَلَا بَأْسَ بِهِ  .         [10/260]","","Musnad Abi Ya'la al-Mawsili 5864","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن محمد بن يحيى بن أبي سمينة التمار عن أبو يعلى الموصلي","مسند أبي هريرة"
"5868","25 - (  5865  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  أَبِي رَجَاءٍ الْجَزَرِيِّ ،  عَنْ  يَزِيدَ بْنِ سِنَانٍ ، أَوْ بُرْدٍ  ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  أَبَا هُرَيْرَةَ  ،  كُنْ وَرِعًا تَكُنْ عَابِدًا  ، وَاجْتَنِبِ الْمَحَارِمَ تَكُنْ زَاهِدًا ، وَأَحْسِنْ جِوَارَ مَنْ جَاوَرَكَ ، تَكُنْ مُسْلِمًا ، وَأَحِبَّ لِلنَّاسِ مَا تُحِبُّ لِنَفْسِكَ تَكُنْ مُؤْمِنًا  .         [10/261]","","Musnad Abi Ya'la al-Mawsili 5865","","أبو هريرة الدوسي عن واثلة بن الأسقع الليثي عن برد بن سنان عن محرز بن عبد الله الجزري عن أبو معاوية الضرير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5869","26 - (  5866  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا  مَعْنُ بْنُ عِيسَى ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  عُثْمَانَ بْنِ مُحَمَّدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ وَلِيَ الْقَضَاءَ ، فَكَأَنَّمَا  ذُبِحَ  بِغَيْرِ  سِكِّينٍ  .         [10/262]             [10/263]             [10/264]","","Musnad Abi Ya'la al-Mawsili 5866","","أبو هريرة الدوسي عن سعيد بن المسيب عن عثمان بن محمد بن المغيرة الأخنسي عن محمد بن عبد الرحمن بن المغيرة عن معن بن عيسى عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5870","27 - (  5867  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبَّادِ بْنِ كَثِيرٍ ،  عَنْ  أَبِي عَبْدِ اللهِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا ابْتُلِيَ أَحَدُكُمْ بِالْقَضَاءِ بَيْنَ الْمُسْلِمِينَ ، فَلَا يَقْضِ وَهُوَ غَضْبَانُ  ، فَلْيُسَوِّ بَيْنَهُمْ بِالنَّظَرِ وَالْمَجْلِسِ وَالْإِشَارَةِ ، وَلَا يَرْفَعْ صَوْتَهُ عَلَى أَحَدِ الْخَصْمَيْنِ  .         [10/265]","","Musnad Abi Ya'la al-Mawsili 5867","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن أبو عبد الله مولى إسماعيل بن عبيد المصري عن عباد بن كثير الكاهلي عن إسماعيل بن عياش الأحول عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5871","28 - (  5868  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ ، وَذَكَرَ  الْمَدِينَةَ  :  إِنَّهَا سَتَكُونُ فُتُوحٌ ، وَسَيَكُونُ قَوْمٌ يَهِيمُونَ بِعَشَائِرِهِمْ  ،  وَالْمَدِينَةُ  خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ  .         [10/266]             [10/267]","","Musnad Abi Ya'la al-Mawsili 5868","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5872","29 - (  5869  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  سَمِعَ  سَعِيدَ بْنَ الْمُسَيِّبِ ،  سَمِعَ  أَبَا هُرَيْرَةَ ، يَقُولُ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّ امْرَأَتِي وَلَدَتْ صَبِيًّا أَسْوَدَ  .  فَقَالَ : هَلْ لَكَ مِنْ إِبِلٍ ؟  فَقَالَ : نَعَمْ .  قَالَ : مَا أَلْوَانُهَا ؟ .  قَالَ : حُمْرٌ .  قَالَ : هَلْ فِيهَا مِنْ  أَوْرَقَ  ؟ .  قَالَ : إِنَّ فِيهَا لَوُرْقًا .  قَالَ : وَأَنَّى لَهَا ذَلِكَ ؟ .  قَالَ : لَعَلَّهُ  نَزَعَهُ  عِرْقٌ  .  قَالَ : وَهَذَا لَعَلَّهُ  نَزَعَهُ  عِرْقٌ  .         [10/268]             [10/269]","","Musnad Abi Ya'la al-Mawsili 5869","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند أبي هريرة"
"5873","30 - (  5870  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  عَمْرُو بْنُ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رِجَالًا أَتَوْا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : إِنَّا أُنَاسٌ نَكُونُ بِالرَّمْلِ فَتُصِيبُنَا الْجَنَابَةُ  - وَفِينَا الْحَائِضُ وَالنُّفَسَاءُ - وَلَا نَجِدُ الْمَاءَ أَرْبَعَةَ أَشْهُرٍ ، أَوْ خَمْسَةَ أَشْهُرٍ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عَلَيْكُمْ بِالْأَرْضِ .         [10/270]","","Musnad Abi Ya'la al-Mawsili 5870","","أبو هريرة الدوسي عن سعيد بن المسيب عن عمرو بن شعيب عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5874","31 - (  5871  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  اشْتَدَّ         [10/271]      الْحَرُّ  فَأَبْرِدُوا  بِالصَّلَاةِ  ؛ فَإِنَّ شِدَّةَ الْحَرِّ مِنْ  فَيْحِ  جَهَنَّمَ  .  وَاشْتَكَتِ النَّارُ إِلَى رَبِّهَا ، فَقَالَتْ : رَبِّ أَكَلَ بَعْضِي بَعْضًا ، فَأَذِنَ لَهَا أَنْ تَنَفَّسَ نَفَسَيْنِ : نَفَسًا فِي الشِّتَاءِ ، وَنَفَسًا فِي الصَّيْفِ ، فَهُوَ أَشَدُّ مَا تَجِدُونَ مِنَ الْحَرِّ ، وَأَشَدُّ مَا تَجِدُونَ مِنَ الزَّمْهَرِيرِ  .         [10/272]             [10/273]","","Musnad Abi Ya'la al-Mawsili 5871","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5875","32 - (  5872  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدٍ .         [10/274]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَمْسٌ مِنَ  الْفِطْرَةِ  : الْخِتَانُ ،  وَالِاسْتِحْدَادُ  ، وَقَصُّ الشَّارِبِ ، وَتَقْلِيمُ الْأَظْفَارِ ، وَنَتْفُ الْآبَاطِ  .         [10/275]","","Musnad Abi Ya'la al-Mawsili 5872","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5876","33 - (  5873  ) -  وَبِهِ  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَمَّا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ الْآخِرَةِ فِي صَلَاةِ الْفَجْرِ ، قَالَ : اللَّهُمَّ أَنْجِ  الْوَلِيدَ بْنَ الْوَلِيدِ  ،  وَسَلَمَةَ بْنَ هِشَامٍ  ،  وَعَيَّاشَ بْنَ أَبِي رَبِيعَةَ  ، وَالْمُسْتَضْعَفِينَ  بِمَكَّةَ  .  اللَّهُمَّ اشْدُدْ  وَطْأَتَكَ  عَلَى  مُضَرَ  ، وَاجْعَلْهَا عَلَيْهِمْ سِنِينَ  كَسِنِي  يُوسُفَ  . ثُمَّ خَرَّ سَاجِدًا  .         [10/276]             [10/277]","","Musnad Abi Ya'la al-Mawsili 5873","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5877","34 - (  5874  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَرَأَ الْإِمَامُ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      ، فَأَمَّنَ الْإِمَامُ فَأَمِّنُوا  ؛ فَإِنَّ الْمَلَائِكَةَ تُؤَمِّنُ عَلَى دُعَائِهِ ، فَمَنْ وَافَقَ تَأْمِينُهُ تَأْمِينَ الْمَلَائِكَةِ ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذُنُوبِهِ  .         [10/278]","","Musnad Abi Ya'la al-Mawsili 5874","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5878","35 - (  5875  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  صَلَاةٌ فِي مَسْجِدِي أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ إِلَّا  الْمَسْجِدَ الْحَرَامَ  .","","Musnad Abi Ya'la al-Mawsili 5875","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5879","36 - (  5876  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ أَعْرَابِيًّا بَالَ فِي الْمَسْجِدِ  ، فَأَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَصُبَّ عَلَى بَوْلِهِ  سَجْلٌ  مِنْ مَاءٍ ، أَوْ دَلْوٌ مِنْ مَاءٍ  ، وَقَالَ : إِنَّمَا بُعِثْتُمْ مُيَسِّرِينَ ، وَلَمْ تُبْعَثُوا مُعَسِّرِينَ  .         [10/279]","","Musnad Abi Ya'la al-Mawsili 5876","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5880","37 - (  5877  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَنْزِلَ  ابْنُ مَرْيَمَ  حَكَمًا عَادِلًا  ، وَإِمَامًا مُقْسِطًا ، يَقْتُلُ الْخِنْزِيرَ ، وَيَكْسِرُ الصَّلِيبَ ، وَتُوضَعُ الْجِزْيَةُ ،  وَيَفِيضُ  الْمَالُ ، حَتَّى لَا يَقْبَلَهُ أَحَدٌ  .         [10/280]             [10/281]","","Musnad Abi Ya'la al-Mawsili 5877","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5881","38 - (  5878  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  لَا تَقُومُ السَّاعَةُ حَتَّى تُقَاتِلُوا قَوْمًا نِعَالُهُمُ الشَّعَرُ  .         [10/282]","","Musnad Abi Ya'la al-Mawsili 5878","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5882","39 - (  5879  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  لَا  فَرَعَ  ، وَلَا  عَتِيرَةَ  فِي الْإِسْلَامِ  .         [10/283]","","Musnad Abi Ya'la al-Mawsili 5879","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5883","40 - (  5880  ) -  وَعَنْ  أَبِي هُرَيْرَةَ  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  لَا تَشُدُّوا الرِّحَالَ إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ : مَسْجِدِي هَذَا ،  وَالْمَسْجِدِ الْحَرَامِ  ،  وَالْمَسْجِدِ الْأَقْصَى  .         [10/284]","","Musnad Abi Ya'la al-Mawsili 5880","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5884","41 - (  5881  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا هَلَكَ  كِسْرَى  فَلَا  كِسْرَى  ، وَإِذَا هَلَكَ  قَيْصَرُ  فَلَا  قَيْصَرَ  ، وَالَّذِي نَفْسِي بِيَدِهِ ، لَتُنْفَقَنَّ كُنُوزُهُمَا فِي  سَبِيلِ  اللهِ  .         [10/285]","","Musnad Abi Ya'la al-Mawsili 5881","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5885","42 - (  5882  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَمُوتُ لِمُسْلِمٍ ثَلَاثَةٌ مِنَ الْوَلَدِ فَيَلِجَ النَّارَ  ، إِلَّا  تَحِلَّةَ  الْقَسَمِ  .         [10/286]","","Musnad Abi Ya'la al-Mawsili 5882","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5886","43 - (  5883  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، أَيُصَلِّي الرَّجُلُ فِي ثَوْبٍ وَاحِدٍ ؟  قَالَ : أَوَكُلُّكُمْ يَجِدُ ثَوْبَيْنِ ؟ .  فَقَالَ  أَبُو هُرَيْرَةَ  لِلرَّجُلِ الَّذِي سَأَلَهُ : أَتَعْرِفُ  أَبَا هُرَيْرَةَ  ؟ فَإِنَّهُ كَانَ يُصَلِّي فِي ثَوْبٍ وَاحِدٍ ، وَثِيَابُهُ مَوْضُوعَةٌ عَلَى  الْمِشْجَبِ  .","","Musnad Abi Ya'la al-Mawsili 5883","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5887","44 - (  5884  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  لَا يَبِيعُ  حَاضِرٌ  لِبَادٍ  .         [10/289]             [10/290]","","Musnad Abi Ya'la al-Mawsili 5884","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5888","45 - (  5885  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ  عُمَرَ  ، مَرَّ بِحَسَّانَ وَهُوَ يُنْشِدُ الشِّعْرَ فِي الْمَسْجِدِ  ، فَلَحَظَ إِلَيْهِ ، فَقَالَ : قَدْ كُنْتُ أُنْشِدُ فِيهِ ، وَفِيهِ خَيْرٌ مِنْكَ ، ثُمَّ الْتَفَتَ إِلَى  أَبِي هُرَيْرَةَ  ، فَقَالَ :  أَنْشُدُكَ  بِاللهِ ، أَسَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : أَجِبْ عَنِّي ، اللَّهُمَّ أَيِّدْهُ  بِرُوحِ         [10/291]      الْقُدُسِ  ؟ فَقَالَ : اللَّهُمَّ نَعَمْ .","","Musnad Abi Ya'la al-Mawsili 5885","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5889","46 - (  5886  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ  رَجُلًا مِنْ بَنِي فَزَارَةَ  أَتَى         [10/292]      النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّ امْرَأَتِي وَلَدَتْ غُلَامًا أَسْوَدَ ؟  .  فَقَالَ : هَلْ لَكَ مِنْ إِبِلٍ ؟ .  فَقَالَ : نَعَمْ .  قَالَ : فَمَا أَلْوَانُهَا ؟ .  قَالَ : أَحْمَرُ . قَالَ : هَلْ فِيهَا مِنْ  أَوْرَقَ  ؟ قَالَ : نَعَمْ ، إِنَّ فِيهَا لَوُرْقًا .  قَالَ : فَأَنَّى أَتَاهَا ذَلِكَ ؟ قَالَ : عَسَى أَنْ يَكُونَ  نَزَعَهُ  عِرْقٌ  ؟ .  قَالَ : وَهَذَا عَسَى أَنْ يَكُونَ قَدْ  نَزَعَهُ  عِرْقٌ  .","","Musnad Abi Ya'la al-Mawsili 5886","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5890","47 - (  5887  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تَنَاجَشُوا ،  وَلَا  يَبِعْ  أَحَدُكُمْ عَلَى بَيْعِ أَخِيهِ  ، وَلَا يَخْطُبْ عَلَى خِطْبَتِهِ ، وَلَا  يَسُمِ  الرَّجُلُ عَلَى سَوْمِ أَخِيهِ ، وَلَا يَبِعْ  حَاضِرٌ  لِبَادٍ ،  وَلَا تَسْأَلِ الْمَرْأَةُ طَلَاقَ أُخْتِهَا  لِتَكْتَفِئَ  مَا فِي صَحْفَتِهَا وَلِتُنْكَحَ ؛ فَإِنَّ رِزْقَهَا عَلَى اللهِ  .         [10/293]","","Musnad Abi Ya'la al-Mawsili 5887","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5891","48 - (  5888  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  أَبُو أُوَيْسٍ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ الزُّهْرِيِّ ،  أَخْبَرَنِي  سَعِيدُ بْنُ الْمُسَيِّبِ ،  أَنَّ  أَبَا هُرَيْرَةَ ، كَانَ يَقُولُ :  سَأَلَ سَائِلٌ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، هَلْ يُصَلِّي الرَّجُلُ فِي الثَّوْبِ الْوَاحِدِ ؟  قَالَ رَسُولُ اللهِ : وَلِكُلِّكُمْ ثَوْبَانِ ؟  .","","Musnad Abi Ya'la al-Mawsili 5888","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن عبد الله بن عبد الله بن أويس عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند أبي هريرة"
"5892","49 - (  5889  ) -  حَدَّثَنَا  مَنْصُورٌ ،  حَدَّثَنَا  أَبُو أُوَيْسٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  أَبَا هُرَيْرَةَ كَانَ يَأْتِيهِ الرَّجُلُ يَسْتَفْتِيهِ فِي الصَّلَاةِ فِي الثَّوْبِ الْوَاحِدِ ، فَيَقُولُ : أَتَعْرِفُ  أَبَا هُرَيْرَةَ  ؟ .  فَيَقُولُ : هُوَ أَنْتَ .  فَيَقُولُ :  أَنَا أُصَلِّي فِي الثَّوْبِ الْوَاحِدِ ، وَإِنَّ ثَوْبِي لَمَوْضُوعٌ عَلَى  الْمِشْجَبِ  .         [10/294]","","Musnad Abi Ya'la al-Mawsili 5889","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن عبد الله بن عبد الله بن أويس عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند أبي هريرة"
"5893","50 - (  5890  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  الْحَكَمِ بْنِ عَبْدِ اللهِ بْنِ سَعْدٍ الْأَيْلِيِّ ،  أَنَّهُ سَمِعَ  الْقَاسِمَ بْنَ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ،  أَنَّهَا سَمِعَتْ  أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الضِّيَافَةُ ثَلَاثَةٌ  ، فَمَا زَادَ بَعْدَ ذَلِكَ فَهُوَ صَدَقَةٌ  .         [10/295]","","Musnad Abi Ya'la al-Mawsili 5890","","أبو هريرة الدوسي عن عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الحكم بن عبد الله بن سعد الأيلي عن يحيى بن حمزة بن البتلهي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند أبي هريرة"
"5894","51 - (  5891  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  شَرُّ الطَّعَامِ طَعَامُ الْوَلِيمَةِ  ؛ يُدْعَى الْأَغْنِيَاءُ ، وَيُتْرَكُ الْفُقَرَاءُ ، فَمَنْ لَمْ يُجِبِ الدَّعْوَةَ ، فَقَدْ عَصَى  أَبَا الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [10/296]","","Musnad Abi Ya'la al-Mawsili 5891","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن أيوب السختياني عن محمد بن عبد الرحمن الطفاوي عن يعقوب بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5895","52 - (  5892  ) -  حَدَّثَنَا  زَحْمَوَيْهِ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ .         [10/297]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  جَاءَ  عُيَيْنَةُ بْنُ حِصْنٍ الْفَزَارِيُّ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرَآهُ يُقَبِّلُ  حَسَنًا  ،  وَحُسَيْنًا  ، قَالَ : تُقَبِّلُهُ يَا رَسُولَ اللهِ ؟ لَقَدْ وُلِدَ لِي عَشْرَةٌ مَا قَبَّلْتُ أَحَدًا مِنْهُمْ .  قَالَ : فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمْ لَا يَرْحَمْ  .         [10/298]","","Musnad Abi Ya'la al-Mawsili 5892","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند أبي هريرة"
"5896","53 - (  5893  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  مَعْمَرًا  يُحَدِّثُ ، عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  مَنْ أَدْرَكَ رَكْعَةً مِنْ صَلَاةِ الْعَصْرِ  قَبْلَ أَنْ تَغْرُبَ الشَّمْسُ ، وَرَكْعَةً مِنْ صَلَاةِ الصُّبْحِ قَبْلَ طُلُوعِ الشَّمْسِ ، فَقَدْ أَدْرَكَ  .         [10/299]             [10/300]","","Musnad Abi Ya'la al-Mawsili 5893","","أبو هريرة الدوسي عن عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5897","54 - (  5894  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  أَبُو الْيَمَانِ ،  حَدَّثَنَا  شُعَيْبٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَبِي حُسَيْنٍ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَخْبَرَنِي  أَبُو هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بَيْنَمَا أَنَا نَائِمٌ ، رَأَيْتُ فِيمَا يُرَى سِوَارَيْنِ مِنْ ذَهَبٍ  ، فَهَمَّنِي شَأْنُهُمَا ، قَالَ : بَيْنَمَا أَنَا نَائِمٌ ، فَأُوحِيَ إِلَيَّ : أَنِ  انْفُخْهُمَا  ، فَنَفَخْتُهُمَا ، فَطَارَا ، فَأَوَّلْتُهُمَا كَذَّابَيْنِ يَخْرُجَانِ ، وَكَانَ أَحَدُهُمَا  الْعَنْسِيَّ  صَاحِبَ  صَنْعَاءَ  ، وَالْآخَرُ  مُسَيْلِمَةَ .         [10/301]","","Musnad Abi Ya'la al-Mawsili 5894","","أبو هريرة الدوسي عن عبد الله بن عباس عن نافع بن جبير بن مطعم النوفلي عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن شعيب بن أبي حمزة الحمصي عن أبو اليمان الحكم بن نافع عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5898","55 - (  5895  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَرْعَرَةَ ،  حَدَّثَنَا  مَعْنُ بْنُ عِيسَى ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  عُتْبَةَ بْنِ عَمْرِو بْنِ عَيَّاشٍ .         [10/302]      عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْمَيِّتَ لَيُعَذَّبُ بِبُكَاءِ الْحَيِّ  .","","Musnad Abi Ya'la al-Mawsili 5895","","أبو هريرة الدوسي عن عتبة بن عمرو بن عياش عن محمد بن عبد الرحمن بن المغيرة عن معن بن عيسى عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5899","56 - (  5896  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ ، قَالَ :  حَدَّثَنِي  أَبُو النَّضْرِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَدْخُلُ         [10/303]      الْجَنَّةَ أَقْوَامٌ أَفْئِدَتُهُمْ مِثْلُ أَفْئِدَةِ الطَّيْرِ  .","","Musnad Abi Ya'la al-Mawsili 5896","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن هاشم بن القاسم بن مسلم عن أبو بكر بن النضر بن أبي النضر البغدادي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5900","57 - (  5897  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ يَعْلَى التَّيْمِيُّ ،  حَدَّثَنَا  مَنْصُورٌ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جِدَالٌ فِي الْقُرْآنِ كُفْرٌ  .         [10/304]","","Musnad Abi Ya'la al-Mawsili 5897","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن منصور بن المعتمر عن يحيى بن يعلى بن حرملة التيمي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5901","58 - (  5898  ) -  حَدَّثَنَا  مَنْصُورٌ ،  حَدَّثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  دَيْنُ الْمَرْءِ ، إِذَا مَاتَ مُعَلَّقٌ بِهِ  ، حَتَّى يُقْضَى عَنْهُ  .         [10/305]","","Musnad Abi Ya'la al-Mawsili 5898","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن صالح بن كيسان الدوسي عن مسلم بن خالد الزنجي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند أبي هريرة"
"5902","59 - (  5899  ) -  حَدَّثَنَا  عَمْرُو بْنُ الضَّحَّاكِ ،  حَدَّثَنَا  أَبِي  ،  أَخْبَرَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  نُعْمَانُ ، عَنِ ابْنِ شِهَابٍ ،  أَنَّهُ أَخْبَرَهُ  ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِذَا أَكَلَ أَحَدُكُمْ ، فَلْيَأْكُلْ بِيَمِينِهِ  ، وَلْيَشْرَبْ بِيَمِينِهِ ؛ فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ ، وَيَشْرَبُ بِشِمَالِهِ  .         [10/306]","","Musnad Abi Ya'la al-Mawsili 5899","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن النعمان بن راشد الجزري عن ابن جريج عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن أبو يعلى الموصلي","مسند أبي هريرة"
"5903","60 - (  5900  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  أَخْبَرَنَا  يَزِيدُ بْنُ زِيَادٍ الشَّامِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَعَانَ عَلَى قَتْلِ مُسْلِمٍ  بِشَطْرِ  كَلِمَةٍ  لَقِيَ اللهَ يَوْمَ يَلْقَاهُ ، مَكْتُوبٌ عَلَى         [10/307]      جَبْهَتِهِ : آيِسٌ مِنْ رَحْمَةِ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 5900","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن يزيد بن زياد الدمشقي عن مروان بن معاوية الفزاري عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5904","61 - (  5901  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ .         [10/308]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ  وَالٍ - أَوْ قَالَ : نَبِيٍّ -  إِلَّا وَلَهُ  بِطَانَتَانِ  :  بِطَانَةٌ  تَأْمُرُهُ بِالْمَعْرُوفِ وَتَنْهَاهُ عَنِ الْمُنْكَرِ ،  وَبِطَانَةٌ  لَا  تَأْلُوهُ  خَبَالًا ،  فَمَنْ وُقِيَ شَرَّهَا فَقَدْ وُقِيَ  .","","Musnad Abi Ya'la al-Mawsili 5901","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5905","62 - (  5902  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ زَنْجُوَيْهِ ،  حَدَّثَنَا  أَبُو الْمُغِيرَةِ عَبْدُ الْقُدُّوسِ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيَكُونُ بَعْدِي خُلَفَاءُ يَعْمَلُونَ بِمَا يَعْلَمُونَ  ، وَيَفْعَلُونَ مَا يُؤْمَرُونَ ،         [10/309]      وَسَيَكُونُ بَعْدِي خُلَفَاءُ يَعْمَلُونَ بِمَا لَا يَعْلَمُونَ ، وَيَفْعَلُونَ بِمَا لَا يُؤْمَرُونَ ، فَمَنْ أَنْكَرَ عَلَيْهِمْ بَرِئَ ، وَمَنْ أَمْسَكَ يَدَهُ سَلِمَ ، وَلَكِنْ مَنْ رَضِيَ وَتَابَعَ !  .","","Musnad Abi Ya'la al-Mawsili 5902","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن أبو عمرو الأوزاعي عن عبد القدوس بن الحجاج عن محمد بن عبد الملك بن زنجويه الغزال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5906","63 - (  5903  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا حَكَمَ الْحَاكِمُ فَاجْتَهَدَ فَأَصَابَ فَلَهُ أَجْرَانِ  ، وَإِذَا حَكَمَ فَاجْتَهَدَ فَأَخْطَأَ ، فَلَهُ أَجْرٌ  .         [10/310]","","Musnad Abi Ya'la al-Mawsili 5903","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن أبو بكر بن محمد الخزرجي عن يحيى بن سعيد الأنصاري عن سفيان الثوري عن معمر بن راشد عن عبد الرزاق الصنعاني عن محمد بن مهدي الأبلي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5907","64 - (  5904  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  .         [10/311]      عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ثَلَاثَةٌ كُلُّهُمْ حَقٌّ عَلَى الْمُسْلِمِ  : عِيَادَةُ الْمَرِيضِ ، وَشُهُودُ الْجَنَائِزِ ، وَتَشْمِيتُ الْعَاطِسِ إِذَا حَمِدَ اللهَ .","","Musnad Abi Ya'la al-Mawsili 5904","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5908","65 - (  5905  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا  اسْتَجْمَرَ  أَحَدُكُمْ فَلْيُوتِرْ  .         [10/312]","","Musnad Abi Ya'la al-Mawsili 5905","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5909","66 - (  5906  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  .         [10/313]      عَنْ  أَبِي هُرَيْرَةَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا سَرَقَ الْعَبْدُ فَبِعْهُ وَلَوْ بِأُوقِيَّةٍ  .  وَالْأُوقِيَّةُ : أَرْبَعُونَ دِرْهَمًا  .","","Musnad Abi Ya'la al-Mawsili 5906","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5910","67 - (  5907  ) -  وَعَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيَنْظُرْ أَحَدُكُمْ مَا يَتَمَنَّى  ؛ فَإِنَّهُ لَا يَدْرِي مَا الَّذِي يُكْتَبُ عَلَيْهِ فِي أُمْنِيَّتِهِ  .         [10/314]","","Musnad Abi Ya'la al-Mawsili 5907","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5911","68 - (  5908  ) -  وَعَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعَنَ اللهُ زَوَّارَاتِ الْقُبُورِ  .         [10/315]","","Musnad Abi Ya'la al-Mawsili 5908","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5912","69 - (  5909  ) -  حَدَّثَنَا  يَعْقُوبُ بْنُ مَاهَانَ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا جُعِلَ الْإِمَامُ لِيُؤْتَمَّ بِهِ  ، فَإِذَا كَبَّرَ فَكَبِّرُوا ، وَإِذَا رَكَعَ فَارْكَعُوا ، وَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : رَبَّنَا لَكَ الْحَمْدُ ، وَإِنْ صَلَّى قَائِمًا فَصَلُّوا قِيَامًا ، وَإِنْ صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا أَجْمَعِينَ  .         [10/316]             [10/317]","","Musnad Abi Ya'la al-Mawsili 5909","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن هشيم بن بشير عن يعقوب بن ماهان البغدادي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5913","70 - (  5910  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  افْتَرَقَتِ الْيَهُودُ عَلَى إِحْدَى وَسَبْعِينَ فِرْقَةً  ، وَافْتَرَقَتِ النَّصَارَى عَلَى  إِحْدَى - أَوْ ثِنْتَيْنِ - وَسَبْعِينَ فِرْقَةً  ، وَتَفْتَرِقُ أُمَّتِي عَلَى ثَلَاثٍ وَسَبْعِينَ فِرْقَةً  .         [10/318]","","Musnad Abi Ya'la al-Mawsili 5910","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن النضر بن شميل عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5914","71 - (  5911  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ  أَبَا هِنْدٍ  حَجَمَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْيَافُوخِ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا مَعْشَرَ  الْأَنْصَارِ  ، أَنْكِحُوا  أَبَا هِنْدٍ  وَانْكِحُوا إِلَيْهِ .  وَقَالَ :  إِنْ كَانَ فِي شَيْءٍ مِمَّا تَدَاوَوْنَ خَيْرٌ ، فَالْحِجَامَةُ  .         [10/319]","","Musnad Abi Ya'la al-Mawsili 5911","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5915","72 - (  5912  ) -  حَدَّثَنَا  مَحْمُودُ بْنُ خِدَاشٍ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ الْبَلَاءُ بِالْمُؤْمِنِ وَالْمُؤْمِنَةِ : فِي جَسَدِهِ ، وَمَالِهِ ، وَوَلَدِهِ  ، حَتَّى يَلْقَى اللهَ ، وَمَا عَلَيْهِ خَطِيئَةٌ  .         [10/320]","","Musnad Abi Ya'la al-Mawsili 5912","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عباد بن العوام الكلابي عن محمود بن خداش الطالقاني عن أبو يعلى الموصلي","مسند أبي هريرة"
"5916","73 - (  5913  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ  ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيَّامُ مِنًى أَيَّامُ أَكْلٍ  وَشُرْبٍ  .         [10/321]      كذا في طبعة دار المأمون للتراث ، والصواب : ( عبد الرحيم )","","Musnad Abi Ya'la al-Mawsili 5913","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5917","74 - (  5914  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، إِنَّا لَنَجِدُ فِي أَنْفُسِنَا أَشْيَاءَ مَا نُحِبُّ أَنْ نَتَكَلَّمَ بِهَا  ، وَإِنَّ لَنَا مَا طَلَعَتْ عَلَيْهِ الشَّمْسُ .  قَالَ : قَدْ وَجَدْتُمْ ذَلِكَ ؟  قَالُوا : نَعَمْ .  فَقَالَ : ذَاكَ  صَرِيحُ  الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 5914","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5918","75 - (  5915  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،         [10/322]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَا :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  لَا تَمْنَعُوا إِمَاءَ اللهِ مَسَاجِدَ اللهِ  ، وَلْيَخْرُجْنَ  تَفِلَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 5915","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5919","76 - (  5916  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  حَدَّثَنِي  أَبُو سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  وَجَدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رِيحَ ثُومٍ فِي         [10/323]      الْمَسْجِدِ ، فَقَالَ :  مَنْ أَكَلَ مِنْ هَذِهِ الشَّجَرَةِ فَلَا يَقْرَبَنَّ مَسْجِدَنَا  .","","Musnad Abi Ya'la al-Mawsili 5916","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5920","77 - (  5917  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  حَدَّثَنِي  أَبُو سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْجَنِينِ :  غُرَّةَ  عَبْدٍ ، أَوْ أَمَةٍ  ، قَالَ : فَقَالَ الَّذِي قَضَى عَلَيْهِ : أَيُعْقَلُ مَنْ لَا أَكَلَ ، وَلَا         [10/324]      شَرِبَ ، وَلَا صَاحَ فَاسْتَهَلَّ ، فَمِثْلُ ذَلِكَ يُطَلُّ ؟ .  فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ هَذَا يَقُولُ بِقَوْلِ شَاعِرٍ ، فِيهِ  غُرَّةٌ  : عَبْدٌ أَوْ أَمَةٌ  .         [10/325]","","Musnad Abi Ya'la al-Mawsili 5917","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5921","78 - (  5918  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ .         [10/326]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَبَّةُ  السَّوْدَاءُ  شِفَاءٌ مِنْ كُلِّ دَاءٍ ، إِلَّا  السَّامَ  .  قَالُوا : وَمَا  السَّامُ  ؟ قَالَ : الْمَوْتُ  .","","Musnad Abi Ya'la al-Mawsili 5918","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5922","79 - (  5919  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَجَدَ فِي         {      ص         }      .","","Musnad Abi Ya'la al-Mawsili 5919","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حفص بن غياث النخعي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند أبي هريرة"
"5923","80 - (  5920  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ الْوَاسِطِيُّ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  ، فَمَنْ قَطَعْتُ لَهُ         [10/327]      مِنْ مَالِ أَخِيهِ شَيْئًا ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ .","","Musnad Abi Ya'la al-Mawsili 5920","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5924","81 - (  5921  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرْبَعَةُ أَنْهَارٍ فُجِّرَتْ مِنَ الْجَنَّةِ  :  الْفُرَاتُ  ،  وَالنِّيلُ : نِيلُ مِصْرَ  ،  وَسَيْحَانُ  ،  وَجَيْحَانُ  .         [10/328]","","Musnad Abi Ya'la al-Mawsili 5921","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن أسامة القرشي عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند أبي هريرة"
"5925","82 - (  5922  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ الْهُذَلِيُّ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَعِدَ الْمِنْبَرَ ، فَقَالَ : آمِينَ ، آمِينَ ، آمِينَ  ، فَقِيلَ : يَا رَسُولَ اللهِ ، إِنَّكَ حِينَ صَعِدْتَ الْمِنْبَرَ ، قُلْتَ : آمِينَ ، آمِينَ ، آمِينَ ؟ .  قَالَ : إِنَّ  جِبْرِيلَ  أَتَانِي ، فَقَالَ : مَنْ أَدْرَكَ شَهْرَ رَمَضَانَ فَلَمْ يُغْفَرْ لَهُ فَدَخَلَ النَّارَ ،  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ .  وَمَنْ أَدْرَكَ أَبَوَيْهِ - أَوْ أَحَدَهُمَا - فَلَمْ يَبَرَّهُمَا ، فَمَاتَ ، فَدَخَلَ النَّارَ ،  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ .  وَمَنْ ذُكِرْتَ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيْكَ ، فَمَاتَ فَدَخَلَ النَّارَ ،  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ  .         [10/329]             [10/330]","","Musnad Abi Ya'la al-Mawsili 5922","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حفص بن غياث النخعي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند أبي هريرة"
"5926","83 - (  5923  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قَالَ أَصْحَابُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا رَسُولَ اللهِ ، إِنَّا نَجِدُ فِي أَنْفُسِنَا شَيْئًا مَا نُحِبُّ أَنْ نَتَكَلَّمَ بِهِ  ، وَإِنَّ لَنَا مَا طَلَعَتْ عَلَيْهِ الشَّمْسُ .  فَقَالَ : قَدْ وَجَدْتُمْ ذَلِكَ ؟ .  قَالُوا : نَعَمْ .  قَالَ : ذَاكَ  صَرِيحُ  الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 5923","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحيم بن سليمان الأشل عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند أبي هريرة"
"5927","84 - (  5924  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  قُرَيْشُ بْنُ أَنَسٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُكُمْ خَيْرُكُمْ لِأَهْلِي مِنْ بَعْدِي  .         [10/331]      قَالَ  أَبُو خَيْثَمَةَ  : النَّاسُ يَقُولُونَ : لِأَهْلِهِ ، وَقَالَ هَذَا : لِأَهْلِي .","","Musnad Abi Ya'la al-Mawsili 5924","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن قريش بن أنس عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5928","85 - (  5925  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ يَوْمٍ طَلَعَتْ فِيهِ الشَّمْسُ يَوْمُ الْجُمُعَةِ  : فِيهِ خُلِقَ  آدَمُ  ، وَفِيهِ أُدْخِلَ         [10/332]      الْجَنَّةَ ، وَفِيهِ أُهْبِطَ مِنْهَا  .","","Musnad Abi Ya'la al-Mawsili 5925","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5929","[10/333]      86 - (  5926  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْضَلُ الْمُؤْمِنِينَ إِيمَانًا أَحْسَنُهُمْ  خُلُقًا  ، وَخِيَارُكُمْ خِيَارُكُمْ لِنِسَائِهِمْ  .         [10/334]","","Musnad Abi Ya'la al-Mawsili 5926","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5930","87 - (  5927  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، بِنَحْوِهِ .","","Musnad Abi Ya'la al-Mawsili 5927","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند أبي هريرة"
"5931","88 - (  5928  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِفَاطِمَةَ  : انْتَقِلِي إِلَى  أُمِّ شَرِيكٍ  ،  وَلَا تُفَوِّتِينَا بِنَفْسِكِ  .         [10/335]      قَالَ  أَبُو خَيْثَمَةَ  :  يَعْنِي  فَاطِمَةَ بِنْتَ قَيْسٍ  .","","Musnad Abi Ya'la al-Mawsili 5928","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5932","89 - (  5929  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ الْعَلَاءِ الرَّازِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُسَمُّوا الْعِنَبَ  الْكَرْمَ  ؛ فَإِنَّ  الْكَرْمَ  قَلْبُ الْمُؤْمِنِ  .         [10/336]","","Musnad Abi Ya'la al-Mawsili 5929","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن العلاء الفوراردي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5933","90 - (  5930  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ رَمَضَانَ إِيمَانًا ،  وَاحْتِسَابًا ،  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .         [10/337]","","Musnad Abi Ya'la al-Mawsili 5930","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن سعيد الأنصاري عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5934","91 - (  5931  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اشْتَدَّ غَضَبُ         [10/338]      اللهِ عَلَى قَوْمٍ هَشَّمُوا  الْبَيْضَةَ  عَلَى رَأْسِ نَبِيِّهِمْ ، وَهُوَ يَدْعُوهُمْ إِلَى اللهِ  .","","Musnad Abi Ya'la al-Mawsili 5931","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند أبي هريرة"
"5935","92 - (  5932  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  سَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  يَقُولُ : أَنَا ابْنُ أَشْيَاخِ الْكِرَامِ .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  الْكَرِيمَ  ابْنَ  الْكَرِيمِ  ابْنِ  الْكَرِيمِ  ابْنِ  الْكَرِيمِ  يُوسُفُ بْنُ يَعْقُوبَ بْنِ إِسْحَاقَ بْنِ إِبْرَاهِيمَ  .         [10/339]             [10/340]","","Musnad Abi Ya'la al-Mawsili 5932","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن هدبة بن خالد عن أبو يعلى الموصلي","مسند أبي هريرة"
"5936","93 - (  5933  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَمْنَعُوا إِمَاءَ اللهِ مَسَاجِدَ اللهِ ، وَلْيَخْرُجْنَ  تَفِلَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 5933","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5937","94 - (  5934  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مِنْ حَقِّ الْمُسْلِمِ عَلَى الْمُسْلِمِ : شُهُودُ الْجِنَازَةِ  ، وَرَدُّ التَّحِيَّةِ ، وَعِيَادَةُ الْمَرِيضِ ، وَتَشْمِيتُ الْعَاطِسِ إِذَا حَمِدَ اللهَ ، وَإِجَابُ دَعْوَةٍ  .         [10/341]","","Musnad Abi Ya'la al-Mawsili 5934","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5938","95 - (  5935  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَخَلَتِ امْرَأَةٌ النَّارَ فِي هِرَّةٍ رَبَطَتْهَا ، فَلَمْ تُطْعِمْهَا  ، وَلَمْ تَدَعْهَا تَأْكُلُ مِنْ  خَشَاشِ  الْأَرْضِ .         [10/342]","","Musnad Abi Ya'la al-Mawsili 5935","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5939","96 - (  5936  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  حَفْصٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَغَرِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، وَأَبِي سَعِيدٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا مَضَى  شَطْرُ  اللَّيْلِ - أَوْ ثُلُثُ اللَّيْلِ  - أَمَرَ مُنَادِيًا فَنَادَى : هَلْ مِنْ دَاعٍ فَيُسْتَجَابَ لَهُ ؟  هَلْ مِنْ سَائِلٍ فَيُعْطَى سُؤْلَهُ ؟ هَلْ مِنْ مُسْتَغْفِرٍ فَأَغْفِرَ لَهُ ؟ هَلْ مِنْ تَائِبٍ فَيُتَابَ عَلَيْهِ ؟  .","","Musnad Abi Ya'la al-Mawsili 5936","","أبو سعيد الخدري عن الأغر المديني مولى أبي هريرة وأبي سعيد الخدري عن أبو إسحاق السبيعي عن الأعمش عن حفص بن غياث النخعي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5940","[10/343]      97 - (  5937  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ ، وَزَادَ فِيهِ :  حَتَّى يَطْلُعَ الْفَجْرُ  .","","Musnad Abi Ya'la al-Mawsili 5937","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حفص بن غياث النخعي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5941","98 - (  5938  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْفَجْرِ فَغَلَّسَ بِهَا ، ثُمَّ صَلَّى الْغَدَ  فَأَسْفَرَ  بِهَا قَلِيلًا ، ثُمَّ قَالَ :  أَيْنَ السَّائِلُ عَنْ وَقْتِ الصَّلَاةِ ؟ الْوَقْتُ فِيمَا بَيْنَ هَاتَيْنِ : أَمْسِ ، وَصَلَاتِي الْيَوْمَ  .         [10/344]","","Musnad Abi Ya'la al-Mawsili 5938","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5942","99 - (  5939  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ الْوَاسِطِيُّ ،  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلَةً مَنْ يَتَمَنَّى عَلَى اللهِ  ، فَيَقُولُ : لَكَ ذَلِكَ وَمِثْلُهُ مَعَهُ ، إِلَّا أَنَّهُ عِنْدَمَا يُقَالُ لَهُ : لَكَ كَذَا وَكَذَا ، يَقُولُ : أَلِي كُلُّ ذَلِكَ ؟ قَالَ : وَمِثْلُهُ مَعَهُ  .         [10/345]","","Musnad Abi Ya'la al-Mawsili 5939","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5943","100 - (  5940  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمَّا خَلَقَ اللهُ الْجَنَّةَ وَالنَّارَ أَرْسَلَ  جِبْرِيلَ  إِلَى الْجَنَّةِ ، فَقَالَ : اذْهَبْ فَانْظُرْ إِلَيْهَا وَإِلَى مَا أَعْدَدْتُ لِأَهْلِهَا فِيهَا  .  قَالَ : فَذَهَبَ ، فَنَظَرَ إِلَيْهَا ، ثُمَّ رَجَعَ ، فَقَالَ : وَعِزَّتِكَ ، لَقَدْ خَشِيتُ أَنْ لَا يَدْخُلَهَا أَحَدٌ .  ثُمَّ أَرْسَلَهُ إِلَى النَّارِ ، فَقَالَ : اذْهَبْ ، فَانْظُرْ إِلَيْهَا وَإِلَى مَا أَعْدَدْتُ لِأَهْلِهَا فِيهَا .  قَالَ : فَذَهَبَ ، فَإِذَا هِيَ يَرْكَبُ بَعْضُهَا بَعْضًا ، قَالَ : وَعِزَّتِكَ لَا يَدْخُلُهَا أَحَدٌ سَمِعَ بِهَا .  قَالَ : فَأَمَرَ بِهَا ، فَحُفَّتْ بِالشَّهَوَاتِ ، ثُمَّ قَالَ : عُدْ ، فَانْظُرْ إِلَيْهَا وَإِلَى مَا أَعْدَدْتُ لِأَهْلِهَا .  قَالَ : فَنَظَرَ إِلَيْهَا ، فَقَالَ : وَعِزَّتِكَ ، لَقَدْ خَشِيتُ أَنْ لَا يَنْجُوَ أَحَدٌ إِلَّا دَخَلَهَا  .         [10/346]","","Musnad Abi Ya'la al-Mawsili 5940","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5944","101 - (  5941  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  حَدَّثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَكُمْ أَنْ يَكُونَ  أَلْحَنَ  بِحُجَّتِهِ مِنْ بَعْضٍ  ، مَنْ قَطَعْتُ لَهُ مِنْ مَالِ أَخِيهِ شَيْئًا ، فَإِنَّمَا أَقْطَعُ لَهُ قِطْعَةً مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5941","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5945","102 - (  5942  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  دَخَلَتِ امْرَأَةٌ النَّارَ فِي هِرَّةٍ رَبَطَتْهَا  ، فَلَمْ تُطْعِمْهَا ، وَلَمْ تَسْقِهَا ، وَلَمْ تُرْسِلْهَا تَأْكُلُ مِنْ  خَشَاشِ  الْأَرْضِ  .         [10/347]","","Musnad Abi Ya'la al-Mawsili 5942","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5946","103 - (  5943  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَصْبِرُ عَلَى  لَأْوَائِهَا  وَجَهْدِهَا  إِلَّا كُنْتُ لَهُ  شَفِيعًا - أَوْ شَهِيدًا  - يَوْمَ الْقِيَامَةِ  .  وَلَا يَخْرُجُ مِنْهَا أَحَدٌ رَغْبَةً عَنْهَا ، إِلَّا أَبْدَلَهَا اللهُ مَا هُوَ خَيْرٌ مِنْهُ ،  وَالْمَدِينَةُ  خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ  .         [10/348]","","Musnad Abi Ya'la al-Mawsili 5943","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5947","104 - (  5944  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يُنْتَبَذَ فِي  الْمُزَفَّتِ  ،  وَالدُّبَّاءِ  ،  وَالْحَنْتَمَةِ  ،  وَالنَّقِيرِ  . وَقَالَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .         [10/349]             [10/350]","","Musnad Abi Ya'la al-Mawsili 5944","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5948","105 - (  5945  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَقُومُ السَّاعَةُ ، حَتَّى يَخْرُجَ ثَلَاثُونَ كَذَّابًا  دَجَّالًا  ، كُلُّهُمْ يَكْذِبُ عَلَى اللهِ ، وَعَلَى رَسُولِهِ .         [10/351]","","Musnad Abi Ya'la al-Mawsili 5945","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5949","106 - (  5946  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَلْبُ الْكَبِيرِ شَابَ عَلَى حُبِّ اثْنَتَيْنِ : حُبِّ الْحَيَاةِ ، وَحُبِّ الْمَالِ  .         [10/352]             [10/353]","","Musnad Abi Ya'la al-Mawsili 5946","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5950","107 - (  5947  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ عَمَلِ ابْنِ آدَمَ لَهُ : الْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا إِلَى سَبْعِمِائَةِ ضِعْفٍ  ، إِلَّا الصَّوْمَ فَهُوَ لِي ، وَأَنَا  أَجْزِي  بِهِ ؛ يَتْرُكُ الطَّعَامَ وَالشَّهْوَةَ ، وَيَتْرُكُ الشَّرَابَ لِشَهْوَتِهِ مِنْ أَجْلِي ، هُوَ لِي ، وَأَنَا  أَجْزِي  بِهِ  .         [10/354]             [10/355]","","Musnad Abi Ya'la al-Mawsili 5947","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5951","108 - (  5948  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ تَرَكَ مَالًا فَلِأَهْلِهِ ، وَمَنْ تَرَكَ  ضَيَاعًا  فَإِلَيَّ  .         [10/356]             [10/357]","","Musnad Abi Ya'la al-Mawsili 5948","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5952","109 - (  5949  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  أَنَّهُ كَانَ يُصَلِّي بِهِمْ فَيُكَبِّرُ كُلَّمَا وَضَعَ رَأْسَهُ وَرَفَعَ  ، فَإِذَا انْصَرَفَ ، قَالَ : أَنَا أَشْبَهُكُمْ صَلَاةً بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [10/358]","","Musnad Abi Ya'la al-Mawsili 5949","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5953","110 - (  5950  ) -  وَعَنْ  أَبِي سَلَمَةَ ، قَالَ :  رَأَيْتُ  أَبَا هُرَيْرَةَ يَسْجُدُ فِي :         {      إِذَا السَّمَاءُ انْشَقَّتْ         }      ، فَلَمَّا انْصَرَفَ ، قُلْتُ لَهُ : سَجَدْتَ فِي سُورَةٍ مَا يُسْجَدُ فِيهَا ؟  فَقَالَ : رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَجَدَ فِيهَا  .         [10/359]             [10/360]","","Musnad Abi Ya'la al-Mawsili 5950","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5954","111 - (  5951  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ  :  اعْتَرَضَ لِيَ الشَّيْطَانُ فِي مُصَلَّايَ هَذَا فَأَخَذْتُهُ فَخَنَقْتُهُ  ، حَتَّى إِنِّي لَأَجِدُ بَرْدَ لِسَانِهِ عَلَى ظَهْرِ كَفِّي ، وَلَوْلَا  دَعْوَةُ  أَخِي  سُلَيْمَانَ  لَأَصْبَحَ مَرْبُوطًا تَنْظُرُونَ إِلَيْهِ  .         [10/361]","","Musnad Abi Ya'la al-Mawsili 5951","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5955","112 - (  5952  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  حَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كُلَّ ذِي نَابٍ مِنَ  السِّبَاعِ  ،  وَالْمُجَثَّمَةَ  ، وَالْحِمَارَ الْإِنْسِيَّ  .","","Musnad Abi Ya'la al-Mawsili 5952","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5956","113 - (  5953  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ         [10/362]      قَالَ : قَالَ اللهُ :  أَنَا الرَّحْمَنُ ، وَهِيَ الرَّحِمُ ، شَقَقْتُ لَهَا مِنَ اسْمِي  ، فَمَنْ وَصَلَهَا أَصِلُهُ ، وَمَنْ قَطَعَهَا أَقْطَعُهُ فَأَبُتُّهُ  .","","Musnad Abi Ya'la al-Mawsili 5953","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5957","114 - (  5954  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَفَ عَلَى  الْحَجُونِ  عَامَ الْفَتْحِ ، فَقَالَ :  وَاللهِ إِنَّكِ لَخَيْرُ أَرْضِ اللهِ  ، وَلَوْ لَمْ أُخْرَجْ مِنْكِ مَا خَرَجْتُ ، وَإِنَّهَا لَمْ تَحِلَّ لِأَحَدٍ كَانَ قَبْلِي ، وَإِنَّمَا  أُحِلَّتْ  لِي سَاعَةً مِنْ نَهَارٍ ، ثُمَّ هِيَ مِنْ سَاعَتِي هَذِهِ حَرَامٌ ؛ لَا  يُعْضَدُ  شَجَرُهَا ، وَلَا  يُحْتَشُّ  خَلَاهَا  وَلَا يُلْتَقَطُ إِلَّا  لِمُنْشِدٍ  .  فَقَالَ رَجُلٌ يُقَالُ لَهُ :  شَاهٌ  - وَزَعَمَ النَّاسُ أَنَّهُ  الْعَبَّاسُ  -         [10/363]      فَقَالَ : يَا رَسُولَ اللهِ ، إِلَّا  الْإِذْخِرَ  ، فَإِنَّهُ لِبُيُوتِنَا وَقُبُورِنَا .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِلَّا  الْإِذْخِرَ  .         [10/364]","","Musnad Abi Ya'la al-Mawsili 5954","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5958","115 - (  5955  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  التَّسْبِيحُ لِلرِّجَالِ ، وَالتَّصْفِيقُ لِلنِّسَاءِ  .         [10/365]","","Musnad Abi Ya'la al-Mawsili 5955","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5959","116 - (  5956  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَمَّا مَاتَ  النَّجَاشِيُّ  ، أَخْبَرَهُمْ أَنَّهُ مَاتَ ، فَاسْتَغْفَرُوا لَهُ  .         [10/366]","","Musnad Abi Ya'la al-Mawsili 5956","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5960","117 - (  5957  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ، وَسُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  يَبْلُغُ بِهِ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِنَّ الْيَهُودَ وَالنَّصَارَى لَا يَصْبُغُونَ فَخَالِفُوهُمْ  .         [10/367]","","Musnad Abi Ya'la al-Mawsili 5957","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5961","118 - (  5958  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ، وَالْمُقَدَّمِيُّ ، قَالَا :  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ .         [10/368]      عَنْ  أَبِي هُرَيْرَةَ  يَبْلُغُ بِهِ  ، قَالَ :  يَأْتِي الشَّيْطَانُ أَحَدَكُمْ وَهُوَ فِي صَلَاتِهِ ، فَيَلْبِسُ عَلَيْهِ ، حَتَّى لَا يَدْرِي كَمْ صَلَّى  ، فَمَنْ وَجَدَ مِنْ ذَلِكَ شَيْئًا فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  .         [10/369]","","Musnad Abi Ya'la al-Mawsili 5958","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5962","119 - (  5959  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا  أَذِنَ  اللهُ         [10/370]      لِشَيْءٍ مَا  أَذِنَ  لِنَبِيٍّ  يَتَغَنَّى  بِالْقُرْآنِ  .         [10/371]","","Musnad Abi Ya'la al-Mawsili 5959","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5963","120 - (  5960  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  رِوَايَةً  :  مَنْ صَامَ رَمَضَانَ إِيمَانًا  وَاحْتِسَابًا ،  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .  وَمَنْ قَامَ لَيْلَةَ الْقَدْرِ إِيمَانًا  وَاحْتِسَابًا ،  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .         [10/372]","","Musnad Abi Ya'la al-Mawsili 5960","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5964","121 - (  5961  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  رِوَايَةً  :  إِذَا اسْتَيْقَظَ أَحَدُكُمْ مِنْ نَوْمِهِ ، فَلَا يَغْمِسْ يَدَهُ فِي إِنَائِهِ ، حَتَّى يَغْسِلَهَا ثَلَاثًا  ؛ فَإِنَّهُ لَا يَدْرِي حَيْثُ بَاتَتْ يَدُ أَحَدِكُمْ  .","","Musnad Abi Ya'la al-Mawsili 5961","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5965","122 - (  5962  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  رِوَايَةً  :  مَنْ أَدْرَكَ مِنْ صَلَاةٍ رَكْعَةً ، فَقَدْ أَدْرَكَ  .         [10/373]","","Musnad Abi Ya'la al-Mawsili 5962","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5966","123 - (  5963  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  :  عَلَيْكُمْ  بِالْحَبَّةِ  السَّوْدَاءِ  ؛ فَإِنَّ فِيهَا شِفَاءً مِنْ كُلِّ دَاءٍ ، إِلَّا  السَّامَ  .  وَالسَّامُ : الْمَوْتُ  .","","Musnad Abi Ya'la al-Mawsili 5963","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند أبي هريرة"
"5967","124 - (  5964  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ، قَالَ :  حَدَّثَنِي  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ، أَنَّهُ قَالَ :  أَخْبَرَنِي  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الشَّيْطَانَ يَأْتِي عَلَى أَحَدِكُمْ ، حَتَّى لَا يَدْرِي كَمْ صَلَّى ، فَإِذَا فَعَلَ ذَلِكَ ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  .","","Musnad Abi Ya'la al-Mawsili 5964","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن أنس بن عياض الليثي عن محمد بن إسحاق المسيبي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5968","125 - (  5965  ) -  حَدَّثَنَا  وَهْبٌ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَتَكُونُ فِتَنٌ كَرِيَاحِ الصَّيْفِ ، الْقَاعِدُ فِيهَا خَيْرٌ مِنَ الْقَائِمِ  ، وَالْقَائِمُ خَيْرٌ مِنَ         [10/374]      الْمَاشِي ، مَنِ اسْتَشْرَفَ لَهَا اسْتَشْرَفَتْهُ .","","Musnad Abi Ya'la al-Mawsili 5965","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5969","126 - (  5966  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مَنْ أَدْرَكَ رَكْعَةً مِنَ الصَّلَاةِ فَقَدْ أَدْرَكَ الصَّلَاةَ  .","","Musnad Abi Ya'la al-Mawsili 5966","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5970","127 - (  5967  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْأَشَجُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ الْأَوْدِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،         [10/375]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَدْرَكَ مِنَ الصَّلَاةِ رَكْعَةً ، فَقَدْ أَدْرَكَهَا كُلَّهَا  .","","Musnad Abi Ya'la al-Mawsili 5967","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن عبيد الله بن عمر العمري عن عبد الله بن إدريس الأودي عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند أبي هريرة"
"5971","128 - (  5968  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  أَبُو أُوَيْسٍ ،  عَنِ  الزُّهْرِيِّ ، أَنَّ سَعِيدَ بْنَ الْمُسَيِّبِ ، وَأَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ  حَدَّثَاهُ  ، أَنَّ أَبَا هُرَيْرَةَ  حَدَّثَهُمَا  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَعَى لَهُمُ  النَّجَاشِيَّ  فِي الْيَوْمِ الَّذِي مَاتَ ، فَقَالَ : اسْتَغْفِرُوا لِأَخِيكُمْ  .","","Musnad Abi Ya'la al-Mawsili 5968","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن عبد الله بن عبد الله بن أويس عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند أبي هريرة"
"5972","129 - (  5969  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُرَغِّبُ فِي قِيَامِ رَمَضَانَ مِنْ غَيْرِ عَزِيمَةٍ  .","","Musnad Abi Ya'la al-Mawsili 5969","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن معمر بن راشد عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5973","130 - (  5970  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تَنَاجَشُوا  .         [10/376]","","Musnad Abi Ya'la al-Mawsili 5970","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن معمر بن راشد عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند أبي هريرة"
"5974","131 - (  5971  ) -  حَدَّثَنَا  الْأَشَجُّ ،  حَدَّثَنَا  إِسْحَاقُ يَعْنِي الرَّازِيَّ ،  حَدَّثَنَا  مُعَاوِيَةُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ مَوْلُودٍ يُولَدُ إِلَّا مَسَّهُ الشَّيْطَانُ  ،  فَيَسْتَهِلُّ  صَارِخًا مِنْ مَسِّ الشَّيْطَانِ إِيَّاهُ ، إِلَّا  عِيسَى ابْنَ مَرْيَمَ  وَأُمَّهُ ؛ فَإِنَّ اللهَ يَقُولُ :         {      أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ         }      .         [10/377]","","Musnad Abi Ya'la al-Mawsili 5971","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند أبي هريرة"
"5975","132 - (  5972  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ لَيْلَةِ الْقَدْرِ ، فَقَالَ :  أُرِيتُهَا ثُمَّ أُنْسِيتُهَا ، وَعَسَى أَنْ يَكُونَ خَيْرًا لَهُمْ  ، وَلَكِنِ اطْلُبُوهَا فِي الْعَشْرِ الْأَوَاخِرِ مِنْ رَمَضَانَ  .","","Musnad Abi Ya'la al-Mawsili 5972","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن معاوية بن يحيى الصدفي عن إسحاق بن سليمان الرازي عن عبد الله بن سعيد الأشج عن أبو يعلى الموصلي","مسند أبي هريرة"
"5976","133 - (  5973  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو اللَّيْثِيِّ ،  حَدَّثَنَا  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَامَ         [10/378]      أَحَدُكُمْ مِنْ نَوْمِهِ ،  فَلْيُفْرِغْ  عَلَى يَدَيْهِ مِنْ إِنَائِهِ ؛ فَإِنَّهُ لَا يَدْرِي أَيْنَ بَاتَتْ يَدُهُ  .  فَقَالَ  قَيْنٌ الْأَشْجَعِيُّ  : كَيْفَ إِذَا جِئْنَا  مِهْرَاسَكُمْ  هَذَا ؟ قَالَ : أَعُوذُ بِاللهِ مِنْ شَرِّكَ يَا  قَيْنُ  "" .","","Musnad Abi Ya'la al-Mawsili 5973","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحيم بن سليمان الأشل عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند أبي هريرة"
"5977","134 - (  5974  ) -  حَدَّثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ، قَالَ :  حَدَّثَنِي  قُرَّةُ ، قَالَ :  حَدَّثَنِي  الزُّهْرِيُّ ، قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ ، قَالَ :  حَدَّثَنِي  أَبُو هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ أَحَبِّ عِبَادِي إِلَيَّ أَعْجَلُهُمْ فِطْرًا  .         [10/379]","","Musnad Abi Ya'la al-Mawsili 5974","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن قرة بن عبد الرحمن المعافري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن سهل بن أبي سهل الأشتر عن أبو يعلى الموصلي","مسند أبي هريرة"
"5978","135 - (  5975  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ،  حَدَّثَنَا  عَبْدُ السَّلَامِ بْنُ أَبِي الْجَنُوبِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قَرَأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ         [10/380]      الْفَجْرِ ، ثُمَّ قَرَأَ سِتَّ رَكَعَاتٍ يَلْتَفِتُ فِي كُلِّ رَكْعَتَيْنِ يَمِينًا وَشِمَالًا  ، فَظَنَنَّا أَنَّهُ لِكُلِّ  سُبُوعٍ  رَكْعَتَيْنِ وَلَمْ يُسَلِّمْ  .","","Musnad Abi Ya'la al-Mawsili 5975","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عبد السلام بن أبي الجنوب المدني عن محمد بن عثمان بن صفوان الجمحي عن محمد بن جامع العطار عن أبو يعلى الموصلي","مسند أبي هريرة"
"5979","136 - (  5976  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  ابْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  يَهْبِطُ  الدَّجَّالُ         [10/381]      ""  خُوزَ  "" ، وَ ""  كَرْمَانَ  "" فِي ثَمَانِينَ أَلْفًا يَنْتَعِلُونَ الشَّعَرَ  ، وَيَلْبَسُونَ الطَّيَالِسَةَ ، كَأَنَّ وُجُوهَهُمُ  الْمَجَانُّ  الْمُطْرَقَةُ  .","","Musnad Abi Ya'la al-Mawsili 5976","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5980","137 - (  5977  ) -  حَدَّثَنَا  وَهْبٌ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  مُحَمَّدٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غَيِّرُوا الشَّيْبَ وَلَا تَشَبَّهُوا بِالْيَهُودِ وَلَا بِالنَّصَارَى  .","","Musnad Abi Ya'la al-Mawsili 5977","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5981","138 - (  5978  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  تَفَرَّقَتِ الْيَهُودُ عَلَى إِحْدَى وَسَبْعِينَ فِرْقَةً  ، وَتَفَرَّقَتِ النَّصَارَى عَلَى  إِحْدَى - أَوْ ثِنْتَيْنِ  - وَسَبْعِينَ فِرْقَةً ، قَالَ : إِحْدَى         [10/382]      الطَّائِفَتَيْنِ : إِحْدَى وَسَبْعِينَ ، وَالْأُخْرَى : ثِنْتَيْنِ وَسَبْعِينَ ، وَتَفْتَرِقُ أُمَّتِي عَلَى ثَلَاثٍ وَسَبْعِينَ فِرْقَةً  .  مُحَمَّدُ بْنُ عَمْرٍو  يَشُكُّ  .","","Musnad Abi Ya'la al-Mawsili 5978","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5982","139 - (  5979  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مَرَّتْ بِهِ جِنَازَةٌ فَأَثْنَوْا عَلَيْهَا خَيْرًا فِي مَنَاقِبِ الْخَيْرِ ، قَالَ : فَقَالَ : وَجَبَتْ ، ثُمَّ مَرَّتْ بِهِ أُخْرَى ، فَأَثْنَوْا عَلَيْهَا شَرًّا فِي مَنَاقِبِ الشَّرِّ ، فَقَالَ : وَجَبَتْ ، ثُمَّ قَالَ :  أَنْتُمْ شُهَدَاءُ اللهِ فِي الْأَرْضِ  .         [10/383]","","Musnad Abi Ya'la al-Mawsili 5979","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5983","140 - (  5980  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ  :  غِفَارُ  ،  وَأَسْلَمُ  ،  وَمُزَيْنَةُ  ، وَمَنْ كَانَ مِنْ  جُهَيْنَةَ  خَيْرٌ مِنَ الْحَلِيفَيْنِ :  غَطَفَانَ  ،  وَأَسَدٍ  ،  وَهَوَازِنُ  ،  وَتَمِيمٌ  وَدُونَهُمْ فَإِنَّهُمْ أَهْلُ الْخَيْلِ وَالْوَبَرِ .","","Musnad Abi Ya'la al-Mawsili 5980","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5984","141 - (  5981  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :         [10/384]      اخْتَتَنَ  إِبْرَاهِيمُ  عَلَى رَأْسِ ثَمَانِينَ سَنَةً ، وَاخْتَتَنَ  بِالْقَدُومِ  .         [10/385]","","Musnad Abi Ya'la al-Mawsili 5981","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5985","142 - (  5982  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَامِعٍ الْعَطَّارُ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ،  حَدَّثَنَا  عَبْدُ السَّلَامِ بْنُ أَبِي الْجَنُوبِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَقُّ الْجِوَارِ أَرْبَعُونَ دَارًا هَكَذَا ، وَهَكَذَا ، وَهَكَذَا ، يَمِينًا وَشِمَالًا  ، وَقُدَّامًا وَخَلْفًا  .","","Musnad Abi Ya'la al-Mawsili 5982","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عبد السلام بن أبي الجنوب المدني عن محمد بن عثمان بن صفوان الجمحي عن محمد بن جامع العطار عن أبو يعلى الموصلي","مسند أبي هريرة"
"5986","143 - (  5983  ) -  حَدَّثَنَا  نُوحُ بْنُ حَاتِمٍ ، بَغْدَادِيٌّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  دَخَلَ  عُيَيْنَةُ بْنُ حِصْنٍ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَآهُ يُقَبِّلُ  الْحَسَنَ  ،  وَالْحُسَيْنَ  ، فَقَالَ : أَتُقَبِّلُهُمَا يَا رَسُولَ اللهِ ؟ !         [10/386]      قَالَ  عُيَيْنَةُ  : وَإِنَّ لِي عَشَرَةً فَمَا قَبَّلْتُ أَحَدًا مِنْهُمْ .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمُ لَا يُرْحَمُ  .","","Musnad Abi Ya'la al-Mawsili 5983","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن هشيم بن بشير عن نوح بن حاتم بغدادي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5987","144 - (  5984  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  حَدَّثَنِي  يَزِيدُ بْنُ عَبْدِ اللهِ بْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِشَارِبٍ ، فَقَالَ : اضْرِبُوهُ ، فَمِنَّا الضَّارِبُ بِثَوْبِهِ ، وَمِنَّا الضَّارِبُ بِنَعْلِهِ .  فَقَالَ بَعْضُ  الْقَوْمِ  : أَخْزَاكَ اللهُ ! .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُولُوا هَكَذَا ، لَا تُعِينُوا الشَّيْطَانَ عَلَيْهِ  .         [10/387]","","Musnad Abi Ya'la al-Mawsili 5984","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن أنس بن عياض الليثي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند أبي هريرة"
"5988","145 - (  5985  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  يُصَلِّي وَالْمُؤَذِّنُ يُقِيمُ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَصَلَاتَانِ مَعًا ؟  .         [10/388]","","Musnad Abi Ya'la al-Mawsili 5985","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5989","146 - (  5986  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  نَشَلْتُ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَتِفًا مِنْ قِدْرِ  الْعَبَّاسِ  فَأَكَلَهَا وَقَامَ يُصَلِّي وَلَمْ يَتَوَضَّأْ  .         [10/389]","","Musnad Abi Ya'la al-Mawsili 5986","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5990","147 - (  5987  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ وَقَعَ عَلَى بَهِيمَةٍ ، فَاقْتُلُوهُ وَاقْتُلُوهَا مَعَهُ  .  قَالَ أَبُو يَعْلَى :  ثُمَّ بَلَغَنِي أَنَّهُ رَجَعَ عَنْهُ .","","Musnad Abi Ya'la al-Mawsili 5987","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5991","148 - (  5988  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مَعْمَرٍ ، وَيُونُسَ ، وَمَالِكٍ ، وَالْأَوْزَاعِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَدْرَكَ مِنَ الصَّلَاةِ رَكْعَةً فَقَدْ أَدْرَكَهَا  .  قَالَ  مَعْمَرٌ  : قَالَ  الزُّهْرِيُّ  :  فَنَرَى أَنَّ الْجُمُعَةَ مِنَ الصَّلَاةِ  .         [10/390]","","Musnad Abi Ya'la al-Mawsili 5988","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5992","149 - (  5989  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَلْبُ الْكَبِيرِ شَابَ عَلَى حُبِّ اثْنَتَيْنِ : حُبِّ الْحَيَاةِ ، وَحُبِّ الْمَالِ  .  قَالَ  ابْنُ عَرَفَةَ  : فَأَنَا وَاحِدٌ مِنْهُمْ .","","Musnad Abi Ya'la al-Mawsili 5989","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الله بن إدريس الأودي عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5993","150 - (  5990  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعْمَارُ أُمَّتِي مَا بَيْنَ السِّتِّينَ إِلَى السَّبْعِينَ ، وَأَقَلُّهُمْ مَنْ يَجُوزُ ذَلِكَ  .         [10/391]      قَالَ  ابْنُ عَرَفَةَ  : وَأَنَا مِنَ الْأَقَلِّ .","","Musnad Abi Ya'la al-Mawsili 5990","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الرحمن بن محمد المحاربي عن الحسن بن عرفة العبدي عن أبو يعلى الموصلي","مسند أبي هريرة"
"5994","151 - (  5991  ) -  حَدَّثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَرَادَ  أَهْلَ الْمَدِينَةِ  بِشَرٍّ أَذَابَهُ اللهُ كَمَا يَذُوبُ الْمِلْحُ فِي الْمَاءِ  .         [10/392]","","Musnad Abi Ya'la al-Mawsili 5991","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبدة بن سليمان الكلابي عن هناد بن السري عن أبو يعلى الموصلي","مسند أبي هريرة"
"5995","152 - (  5992  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ الْحَلَبِيُّ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  رَأَيْتُ  أَبَا هُرَيْرَةَ يُكَبِّرُ هَذَا التَّكْبِيرَ الَّذِي تَرَى ، فَقُلْتُ لَهُ : يَا  أَبَا هُرَيْرَةَ  ، مَا هَذَا التَّكْبِيرُ  ؟  فَقَالَ : إِنَّهَا لَصَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad Abi Ya'la al-Mawsili 5992","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5996","153 - (  5993  ) -  وَعَنْ  أَبِي سَلَمَةَ .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا نَادَى الْمُنَادِي أَدْبَرَ الشَّيْطَانُ وَلَهُ  ضُرَاطٌ  ، فَإِذَا قَضَى أَقْبَلَ ، فَإِذَا  ثُوِّبَ  أَدْبَرَ ، وَإِذَا قَضَى أَقْبَلَ ، حَتَّى يَخْطِرَ بَيْنَ الرَّجُلِ وَبَيْنَ نَفْسِهِ ، فَيَقُولُ : اذْكُرْ كَذَا وَكَذَا مَا لَمْ يَذْكُرْ ، حَتَّى لَا يَدْرِيَ أَثَلَاثًا صَلَّى أَمْ أَرْبَعًا ، فَإِذَا لَمْ يَدْرِ أَحَدُكُمْ أَثَلَاثًا صَلَّى أَمْ أَرْبَعًا ، فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  .         [10/393]","","Musnad Abi Ya'la al-Mawsili 5993","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5997","154 - (  5994  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُعَجِّلُ إِلَى الْجُمُعَةِ كَالْمُهْدِي بَدَنَةً  ، وَالَّذِي يَلِيهِ كَالْمُهْدِي شَاةً ، وَالَّذِي يَلِيهِ كَالْمُهْدِي طَيْرًا  .         [10/394]","","Musnad Abi Ya'la al-Mawsili 5994","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5998","155 - (  5995  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَنَتَ فِي صَلَاةِ  الْعَتَمَةِ  - بَعْدَمَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ - شَهْرًا فِي  قُنُوتِهِ  ،  اللَّهُمَّ نَجِّ  الْوَلِيدَ بْنَ الْوَلِيدِ  ، اللَّهُمَّ أَنْجِ  سَلَمَةَ بْنَ هِشَامٍ  ، اللَّهُمَّ أَنْجِ  عَيَّاشَ بْنَ أَبِي رَبِيعَةَ  ، اللَّهُمَّ أَنْجِ الْمُسْتَضْعَفِينَ مِنَ الْمُؤْمِنِينَ ، اللَّهُمَّ اشْدُدْ  وَطْأَتَكَ  عَلَى  مُضَرَ  ، اللَّهُمَّ اجْعَلْهَا عَلَيْهِمْ سِنِينَ  كَسِنِي  يُوسُفَ  .","","Musnad Abi Ya'la al-Mawsili 5995","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"5999","156 - (  5996  ) -  وَعَنْ  أَبِي سَلَمَةَ ، قَالَ :  رَأَيْتُ  أَبَا هُرَيْرَةَ يَسْجُدُ فِي         {      إِذَا السَّمَاءُ انْشَقَّتْ         }      ، فَقُلْتُ : يَا  أَبَا هُرَيْرَةَ  ، أَرَاكَ تَسْجُدُ فِي         {      إِذَا السَّمَاءُ انْشَقَّتْ         }      ؟ قَالَ :  لَوْ لَمْ أَرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْجُدُ فِيهَا مَا سَجَدْتُ  .","","Musnad Abi Ya'la al-Mawsili 5996","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
"6000","157 - (  5997  ) -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ رَمَضَانَ إِيمَانًا  وَاحْتِسَابًا ،  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .  وَمَنْ قَامَ لَيْلَةَ الْقَدْرِ إِيمَانًا  وَاحْتِسَابًا ،  غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .         [10/395]","","Musnad Abi Ya'la al-Mawsili 5997","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن مبشر بن إسماعيل الحلبي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","مسند أبي هريرة"
