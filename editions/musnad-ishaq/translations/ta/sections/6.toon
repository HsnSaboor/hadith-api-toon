hadiths[10]{hadithnumber,text}:
"221","[AI-translation] ((உம்மு அதிய்யா (ரழியல்லாஹு அன்ஹா) கூறினார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) ஃபித்ரு மற்றும் அழ்ஹா பெருநாள் நாட்களில் இளம் பெண்கள், திரையிட்ட பெண்கள், மாதவிடாயுள்ள பெண்கள் ஆகியோரைத் தொழுகைத் திடலுக்கு அழைத்துவருமாறு எங்களுக்குக் கட்டளையிட்டார்கள். மாதவிடாயுள்ள பெண்கள் தொழும் இடத்திலிருந்து விலகியிருந்து முஸ்லிம்களின் நன்மையிலும் துஆவிலும் கலந்துகொள்ளட்டும்.))"
"222","[AI-translation] ((ஹிஷாம் இதே இஸ்னாதுடன் இதுபோன்று அறிவித்தார்கள்.))"
"223","[AI-translation] ((உம்மு அதிய்யா (ரழியல்லாஹு அன்ஹா) கூறினார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) இரு பெருநாட்களிலும் திரையிட்ட இளம் பெண்களையும் மாதவிடாயுள்ள பெண்களையும் (தொழுகைத் திடலுக்கு) அழைத்துவருமாறு எங்களுக்குக் கட்டளையிட்டார்கள் — அவர்கள் முஸ்லிம்களுடன் துஆவிலும் தொழுகையிலும் கலந்துகொள்ளட்டும்; மாதவிடாயுள்ள பெண்கள் தொழுகையிலிருந்து விலகியிருக்கட்டும்.))"
"224","[AI-translation] ((உம்மு அதிய்யா (ரழியல்லாஹு அன்ஹா) கூறினார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) இரு பெருநாட்களிலும் இளம் பெண்கள், மாதவிடாயுள்ள பெண்கள், திரையிட்ட பெண்கள் ஆகியோரைத் தொழுகைத் திடலுக்கு அழைத்துவருமாறு எங்களுக்குக் கட்டளையிட்டார்கள். மாதவிடாயுள்ள பெண்கள் தொழுகைத் திடலுக்கு அருகில் இருந்து முஸ்லிம்களின் துஆவில் கலந்துகொள்வார்கள்.))"
"225","[AI-translation] ((உம்மு அதிய்யா (ரழியல்லாஹு அன்ஹா) கூறினார்கள்: நான் கேட்டேன்: அல்லாஹ்வின் தூதரே! எங்களில் ஒருத்திக்கு ஜில்பாப் இல்லாவிட்டால்? அவர்கள் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) கூறினார்கள்: ""அவளுடைய சகோதரி தன் ஜில்பாபில் ஒரு பகுதியை அவளுக்கு அணிவிக்கட்டும்."" அபூ யஅகூப் கூறினார்கள்: அதாவது இரு பெருநாட்களிலும் வெளியே செல்வதில்.))"
"226","[AI-translation] ((ஹிஷாம் இதே இஸ்னாதுடன் முந்தைய ஹதீஸ் போன்று அறிவித்தார்கள்.))"
"227","[AI-translation] ((ஸய்யிதுனா அப்துல்லாஹ் பின் ரவாஹா அவர்களின் சகோதரி (உம்ரா பின்த் ரவாஹா, ரழியல்லாஹு அன்ஹா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""இடுப்புக் கச்சை கட்டும் ஒவ்வொரு பெண்ணும் இரு பெருநாட்களிலும் (தொழுகைத் திடலுக்குச்) செல்வது கடமை.""))"
"228","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) கூறினார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) இரு பெருநாள் தொழுகைகளைத் தொழுவித்து, பின்னர் உரை நிகழ்த்தினார்கள். ஸய்யிதுனா அபூபக்கர் (ரழியல்லாஹு அன்ஹு) அவர்களும் அவ்வாறே தொழுவித்துப் பின்னர் உரை நிகழ்த்தினார்கள். ஸய்யிதுனா உமர் (ரழியல்லாஹு அன்ஹு) அவர்களும் அவ்வாறே தொழுவித்துப் பின்னர் உரை நிகழ்த்தினார்கள்; ஸய்யிதுனா உஸ்மான் (ரழியல்லாஹு அன்ஹு) அவர்களும் அவ்வாறே தொழுவித்துப் பின்னர் உரை நிகழ்த்தினார்கள். அதில் பாங்கோ இகாமத்தோ இல்லை. முஅம்மல் கூறினார்கள்: இவர்கள் அனைவரும் பாங்கு இகாமத் இன்றி இரு பெருநாள் தொழுகைகளைத் தொழுவித்தனர் என்று கூறுவோம்.))"
"229","[AI-translation] ((அம்ர் பின் தீனாரிடமிருந்து அறிவிக்கப்பட்டது — அவர் ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அவர்கள் பெருநாள் நாட்களில் தக்பீர் (அல்லாஹு அக்பர், அல்லாஹு அக்பர்) கூறுவதைக் கேட்டார்கள். அம்ர் (பின் தீனார்) கூறினார்கள்: இரண்டு விஷயங்களில் எதை அவர் நாடினார் என்று எனக்குத் தெரியாது: கண்ணியமிக்க அல்லாஹ்வின் கூற்று: ""ஹஜ் கிரியைகளை நிறைவேற்றியதும் அல்லாஹ்வை நினைவுகூருங்கள்."" அல்லது அவனது கூற்று: ""எண்ணப்பட்ட நாட்களில் அல்லாஹ்வை நினைவுகூருங்கள்."" என்பதா.))"
"230","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) கூறுகிறார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) பெருநாள் அன்று (தொழுகைத் திடலுக்கு) வெளியே சென்று, தொழுவித்துப் பின்னர் உரை நிகழ்த்தினார்கள்; பெண்கள் அதைக் கேட்கவில்லை என்று எண்ணினார்கள். மூன்று (நாட்கள்) கழித்து அவர்களிடம் சென்று, அவர்களுக்கு உபதேசம் செய்து நல்லுரை கூறி, தர்மம் செய்யத் தூண்டினார்கள். பெண்கள் தங்கள் காதணிகளையும் மோதிரங்களையும் கழற்றி எறியத் தொடங்கினர்; ஸய்யிதுனா பிலால் (ரழியல்லாஹு அன்ஹு) அவற்றை எடுத்துத் தம் ஆடையில் சேகரிக்கத் தொடங்கினார்கள்.))"
