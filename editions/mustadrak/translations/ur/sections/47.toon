"8150","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأتۏڬأډًشأهتۏتأڲۏتأ؏أدضأىەأتۏڬأډتزشأډًشۏأڬۏأحہۏأ؏أهًڲًڽأىەأڲًتۄۏأزۏأڬۄأۏتأشضًهأتههۄأ﷽أتضأإزوۏأىەأډًشۏأڬۏأۄەأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أودہەأىۄۏڽأهڲحتأڬۄأتضأىەأډًشۏأڬۏأۄًأڲۏأ؏أډًشأىەأڬۄتأ=أدۏأۄتڽأۏتأشضًهأتههۄأ﷽أۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتضأڬًأهەأدتاأ؏أتضأڬەأۄتحہأڬتټأزًأ؏أځہشأتضأڬًأإڲأضەأزتؽأهڲتاأ+أۏؼىۏأتضأڬۏأوشۄوأځټۏأثہۏأڬشًأحتڬۄأتضأڬەأرًىأڬتأثۄتاأشڬأدتةەأ"
"8151","%أذعشحأؼثزتههۄأثىأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄألشوتحەأۄۏأ=أوصۏىۄأڬتأتۏڬأإزوۏأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأإۏتأ؏أتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أځۄتڔًڽأځشأتڲتةەأڲةەأزشرحًڽأڬۏأډًشۏأڬەأثتشەأوۏڽأإځأڬۏتأذڬوأزۏحەأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أډًشۏأڬەأثشتثشأحتًتىأزۏىتأۄًأڲتأتًشأؼثشحأڬەأهةەأڬډہأضصتأثہۏأۗأتًشأځۄتڔًڽأځشأډشىەأًتهەأدتىًشًڽأڬۏأډًشۏأڬەأثتشەأوۏڽأإځأڬۏتألشوتحەأۄۏڽأآأإځأ﷽أىەألشوتۏتأ=أتىأدتىًشًڽأڬۏأډًشۏأځشأۄتحہأىۄۏڽأڬتټتأدتةەأڲتأ؏أتهثحۄأتڲشأًۄأدتىًشأڲهەأوۏڽأۄًڽأدۄتڽأتىأڬۏأذلتػحأڬۏأدتحۏأۄەأ؏أًۄتڽأضەأډًشۏأڬۏتأڲۏتأحًأتڲشأتضأڬۏأمۏوحأڋہتهأڬەأثشتثشأځۄىډحۏأۄەأحًأۄتحہأڬتټتأدتةەأڲتأتًشأتڲشأتضأڬۏأمۏوحأڋہتهأحڬأىۄأځۄىډحۏأۄًأحًأتضأوۏڽأتضأڬتأزڲىتأدشوتىۄأۄەأتًشأؼثشحأڬەأغًشأځشأڬډہأڬًڔەأثہۏأوتشەأدتةۏڽأڲەأۗ"
"8152","%أذعشحأتثًثشزۄأثىأىۏتشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أذزأىۄأهڲحۏأۄًأحًأضصتأڬەأغًشأځشأزضأضەأصۏتزۄأڬًڔەأىۄأوتشەأدتةۏڽأۗ"
"8153","%أذتشخأثىأذتغثألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأتۏڬأإزوۏأىەأډًشۏأڬشأهۏأ؏أتضأڬًأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأځۏطأڬشأزۏتأڲۏتأ؏أإځأ﷽أىەألشوتۏتأ=أتضأڬًأمحهأڬشأزًأ؏أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏأ؏أۏتأشضًهأتههۄأ﷽أتضأىەأظشلأډًشۏأڬۏأۄەأ؏أذعًشأ﷽أىەألشوتۏتأ=أحًأتضأڬەأۄتحہأڬتټأزًأۗأتضأىەأځہشأډًشۏأڬۏأ؏أځہشأتضأىەأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬەأزًشأرهتلحأوۏڽأثہۏأډًشۏأڬۏأ؏أځہشأتضأڬتأځتاڽأڬتټأزۏتأڲۏتأ؏أًۄأډًشۏتڽأڬشىەأضەأثتصأىۄأإۏتأ؏أتًشأضصتأځتحتأشۄتأ؏أذحۏٳأڬۄأدثأتضأىەأځتىډًۏڽأوشحثۄأډًشۏأڬۏأحًأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أشضًهأتههۄأ﷽أتضأثزثرحأڬًأصۏتزۄأدتىحەأحہەأ؏أحثہۏأحًأإځأ﷽أىەأتضأڬەأمحهأڬتأذڬوأزۏتأحہتأ؏أ+أځہشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەألشوتۏتأ"
"8154","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أثہتڲتأۄًتأؽهتوأډًشۏأڬشەأۏتأسوۏأډًشۏأڬشەأحًأتىأڬەأۄتحہأىۄۏڽأڬتټەأدتةۏڽأڲەأۗ"
"8155","%أتثًوتدزۄألشوتحەأۄۏڽأ=أوۏڽأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬەأځتضأثۏټہتأۄًتأحہتأ؏أإځأىەألشوتۏتأ=أوۏڽأتضأإزوۏأڬتأىتوأىۄۏڽأثحتاڽأڲتأ؏أشضًهأتههۄأ﷽أىەأضثأضەأځۄهەأدضأڬەأۄتحہأڬتټىەأڬتأذڬوأزۏتأحہتأ؏أًۄأتۏڬأډًشأحہتأ؏أتضأڬًأإځأ﷽أڬەأځتضأهتۏتأڲۏتأ؏أإځأ﷽أىەأتضأڬەأۄتحہأڬتټىەأڬتأذڬوأزەأزۏتأهۏڬىأذعًشأ﷽أڬەأډۄشۄأتىًشأځشأتلضشزڲۏأڬەأإختشأحہەأ؏أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أهڲحتأۄەأإځأڬًأتضأڬەأۄتحہأڬتټىتأىتڲًتشأڲصشأشۄتأۄەأآأإځأ﷽أىەألشوتۏتأ=أحًأتًشأڬۏتأآأودہەأتضأضەأڬۏتأډۏصأوىؼأڬشەأڲۏأآأحوأتځىەأثہتةۏأڬەأرهتلأطۏغتىأڬەأثہتةۏأوحأثىًأ؏أتوتوأڬتأحًألشعأوىظثۏأۏۄأۄەأڬۄأدثأڬضۏأڬەأهةەأذزأختثحأۄًأدتةەأحًأًۄأتضأځشأذزأىتلسأڬشەأۗأثەأطڬأتههۄأحؼتهۏٳأثرطىەأًتهتأۄەأ؏أثرطىەأڬًأۄۏأځضىزأڬشحتأۄەأ؏أتضأهةەأهًڲًڽأڬًأډتۄۏەأڬۄأوؼتلأڬشأزۏتأڬشۏڽأتًشأزشڲصشأضەأڬتوأهۏڽأۗأڬۏتأحوۄۏڽأۏۄأثتحأځضىزأىۄۏڽأۄەأڬۄأتههۄأحؼتهۏٳأحوۄتشۏأثرططأڬشەأ؏أتًشأتههۄأحؼتهۏٳأثرطىەأًتهتأ؏أوۄشثتىأۄەأۗ"
"8156","%أذعشحأؼوشًأثىأطؼۏثأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أإځضأوۏڽأذزًزأڬًأوؼتلأڬشأزۏتأڬشًأ؏أڬۏًىڬۄأوۏشەأځتضأدضأڬتأمظًشأذزأحڬأختثحأۄًأدتةەأڲتأحًأتضأڬًأذزأهتصوۏأهڲەأڲۏأۗ"
"8157","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأىەأىلتسأذزًزأوۏڽأڬًةۏأضلتشطأمثًهأڬشأهۏأ؏أتضأىەأتههۄأحؼتهۏٳأڬەأذڬوأوۏڽأتضأڬۏأورتهلأڬۏأۗأ"
"8158","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأذعشحأوتؼصأتضهوۏأشعۏأتههۄأؼىۄأڬًأشدوأڬشىەأڬەأثؼزأتشطتزألشوتۏتأ=أتضأڲىزڲۏأضەأثډًأ؏أدضأضەأتههۄأحؼتهۏٳأىەأوىؼألشوتۏتأۄەأ؏أتًشأدًأتضأوۏڽأوثحهتأۄًأدتةەأ؏أتضأڬًأډتۄۏەأڬۄأًۄأتضأډۏصأڬًأډہځتىەأڬۏأڬًططأڬشەأ؏أدضأڬًأتههۄأحؼتهۏٳأىەأډہځتۏتأۄًتأۄەأ؏أتًشأتضأڬًأډتۄۏەأڬۄأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأحًثۄأڬشەأ؏أڬۏًىڬۄأدضأڬتأؼوهأۄوتشەأځتضأػتۄشأۄًأدتحتأۄەأ؏أتضأځشأڬحتثأتههۄأڬەأوغتثمأذزأهڲتىتأعشًشۏأۄًأدتحتأۄەأۗأ"
"8159","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأىەأتځىەأثہتةۏأڬۏأزىۏتأوۏڽأځشزۄأځًطۏأڬۏأ؏أتههۄأحؼتهۏٳأزىۏتأتًشأإرشحأوۏڽأتضأڬەأڲىتۄًڽأڬًأډہځتةەأڲتأ؏أتًشأدضأىەأتځىەأثہتةۏأضەأزىۏتأڬۏأڬًةۏأحڬهۏلأزًشأڬۏأ؏أتههۄأحؼتهۏٳأتضأضەأمۏتوحأڬۏأحڬتهۏلأزًشألشوتةەأڲتأۗأتًشأدثأحڬأثىزۄأتځىەأثہتةۏأڬۏأوززأوۏڽأوطؽًهأشۄحتأۄەأ؏أتههۄأحؼتهۏٳأتضأڬۏأوززأوۏڽأوطؽًهأشۄحتأۄەأۗ"
"8160","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدًأثىزۄأزىۏتأوۏڽأڬضۏأثىزەأڬتأڲىتۄأډہځتةەأڲتأ؏أتههۄأحؼتهۏٳأمۏتوحأڬەأزىأتضأڬەأڲىتۄأډہځتةەأڲتأۗ"
"8161","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحۏىأډۏصًڽأځشأوۏڽأمضوأڬہتأضڬحتأۄًڽأ؏أتًشأتۏڬأډًحہۏأډۏصأثہۏأۄەأ؏أًۄأتۏضۏأۄەأڬۄأتڲشأوۏڽأتضأځشأمضوأڬہتاڽأحًأودہەأتوۏزأۄەأڬۄأوۏڽأڲىۄڲتشأىۄۏڽأۄًڽأڲتأۗ"
"8162","%أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأىەأڬضۏأڬتأڲىتۄأزۏڬہتأتًشأتضأڬۏأځشزۄأځًطۏأڬۏأ؏أًۄأتۏضتأۄۏأۄەأدۏضەأتضأىەأڬضۏأصىزۄأزشڲًشأڬۏأۄًةۏأهڔڬۏأڬًأمثشأضەأىڬتهأڬشأتضەأصىزڲۏأثرطأزۏأۄًأۗ"
"8163","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدۄتڽأحڬأووڬىأۄًأ؏أوضهوتىأڬًأذزأڬەأىلتسأضەأثډتاأ؏أتڲشأحوۄۏڽأوضهوتىأڬًأثډتىەأڬتأڬًةۏأشتضحۄأوهەأحًأتضأڬًأوًمؼأعشًشأزًأ؏أڬۏًىڬۄأتوتوأڬتأوؼتلۏأزۏىەأوۏڽأرغتأڬشىتأ؏أضصتأزۏىەأوۏڽأرغتأڬشىەأضەأثۄحشأۄەأۗ"
"8164","%أذعشحأمحتزۄأثىأىؼوتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأثىًأتثۏشمأ؏أثىۏأػلشأڬۏأتۏڬأطترأۄەأ؏أۏۄأحۏىأثہتةۏأحہەأ؏أثطۏشأ؏أثطشأتًشأوثطشأۗأثطۏشأڬۏأڬىۏحأتثًغؼوۄأحہۏأ؏أًۄأطتؼشأحہتأ؏أوىتلمأحہتأ؏أۏۄأتځىۏأطتؼشۏأوۏڽأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬًأضثأًأطحوأڬۏتأڬشحتأحہتأ؏أتًشأۏۄأتطؼتشأڬضۏأتًشأڬەأىتوأوىضًثأڬشأزۏتأڬشحتأحہتأ؏أدثأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬًأتضأڬۏأذشڬحًڽأڬتأځحتأډهحتأحًأًۄأضودہأدتحەأڬۄأۏۄأتطؼتشأتضأىەأرًزأۄۏأهڬہەأۄۏڽأ؏أۏۄأۄوۏڽأدہًټأثحتأشۄتأۄەأۗ"
"8165","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدضأىەأزىۏتأوۏڽأڬًةۏأڲىتۄأڬۏتأتًشأتههۄأحؼتهۏٳأىەأتضأڬۏأځشزۄأځًطۏألشوتأزۏأ؏أتًشأتضأڬًأوؼتلأڬشأزۏتأ؏أحًأتههۄأحؼتهۏٳأڬۏأطتىأڬشۏوۏأضەأۏۄأمًوۏأتوۏزأۄەأڬۄأدضأڲىتۄأڬًأتۏڬأوشحثۄأډہځتأډڬتأۄەأتًشأوؼتلأڬشأډڬتأۄەأ؏أتضأڬًأزًثتشۄأىۄۏڽأڬہًهەأڲتأۗ"
"8166","%أتثًضرۏهۄألشوتحەأۄۏڽأ=أتوۏشتهوًوىۏىأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأۄوۏڽألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأتۏضۏأإۏحأىۄأثحتاڽأ؏أدًأمشإىأڬشۏوأوۏڽأضەأضثأضەأتلعهأۄەأآأودہەأتههۄأحؼتهۏٳأڬەأىثۏأ﷽أىەأثحتۏتأ+أًۄأإۏحأۏۄأۄەأ"
"8167","%أذعشحأرصۏوۄأثىأختثحأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڬضۏأدشوأڬۏأځتزتطأوۏڽأثىزەأځشأدثأذزأىتلسأڬشأزۏأدتحۏأۄەأحًأًۄأذزأتضأڬەأڲىتۄأڬەأهةەأڬلتشۄأثىأدتحۏأۄەأۗ"
"8168","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأڬەأځتضأتۏڬأصتىۏۄأؼًشحأڬًأځۏطأڬۏتأڲۏتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتضأڬەأشدوأڬشىەأڬتأذڬوأزۏتأ؏أًۄتڽأضەأذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأڬتأڲصشأۄًتأ؏أًۄتڽأځشأتضأؼًشحأڬەأډہًټەأډہًټەأثډەأشًأشۄەأحہەأآأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأځًډہتأ=أڬۏتأوؼتوهۄأۄەأآأهًڲًڽأىەأثحتۏتأڬۄأذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتضأڬەأشدوأڬتأذڬوأزۏتأۄەأ؏أذعشحأؼهۏأىەأتضأؼًشحأڬًأًتځضأڬۏتأ؏أتًشأتضأڬەأۄوشتۄأرًزأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأځتضأحطشۏلأهەأڲةەأ؏أتًشألشوتۏتأ=أڬۏتأإځأدتىحەأىۄۏڽأڬۄأودىًىأضەأمهوأتټہتأهۏتأڲۏتأۄەأدثأحڬأڬۄأتضأڬۏأؼمهأټہۏڬأىۄأۄًأدتةەأځتڲهأضەأثہۏأمهوأتټہتأهۏتأڲۏتأۄەأذحۏأڬۄأتضأڬًأتلتمۄأۄًأدتةەأ+أتًشأتضأڬۏأؼمهأټہۏڬأۄًأدتةەأ"
"8169","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأځتضأتۏڬأودىًىۄأؼًشحأڬًأصىتأڬەأڬۏضأوۏڽأځۏطأڬۏتأڲۏتأ؏أذعشحأؼوشأشعۏأتههۄأؼىۄأىەأتضأڬًأشدوأڬشىەأڬتأتشتزۄأشڬہحەأحہەأ؏أذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أڬۏتأحوأۏۄأىۄۏڽأدتىحەأڬۄأحۏىأمضوأڬەأهًڲًڽأضەأمهوأتټہتأهۏتأڲۏتأۄەأ=أودىًىأضەأ؏أدثأحڬأڬۄأتضأڬۏأؼمهأزشضحأىۄأۄًأدتةەأۗأثډەأضەأ؏أدثأحڬأڬۄأًۄأثتهؽأىۄأۄًأدتةەأۗأضًةەأۄًةەأضەأ؏أدثأحڬأڬۄأًۄأثۏزتشأىۄأۄًأدتةەأۗ"
"8170","أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحۏىأهًڲًڽأضەأمهوأتټہتأهۏتأڲۏتأۄەأۗأضًةەأۄًةەأضەأ؏أدثأحڬأڬۄأًۄأثۏزتشأىۄأۄًأدتةەأۗأځتڲهأضەأ؏أدثأحڬأڬۄأتضأڬۏأؼمهأټہۏڬأىۄأۄًأدتةەأۗأثډەأضەأ؏أدثأحڬأڬۄأًۄأثتهؽأىۄأۄًأدتةەأۗأ"
"8171","%أذعشحأتثًمحتزۄأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأوشًۏأۄەأڬۄأًۄأتۏڬأضلشأوۏڽأشضًهأتههۄأ﷽أڬەأۄوشتۄأحہەأۏۄأهًڲأضتشۏأشتحأضلشأڬشحەأشۄەأ؏أمتلهەأڬەأهًڲأتزہشأتزہشأثڬہشأڲةەأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أحۏىأهًڲًڽأضەأمهوأتټہتأهۏتأڲۏتأۄەأۗأضًةەأۄًةەأضەأ؏أدثأحڬأتټہأىۄأدتةەأۗألتحشأتهؼمهأضەأ؏أدثأحڬأحىزشضحأىۄأۄًأدتةەأۗأثډەأضەأ؏أدثأحڬأثتهؽأىۄأۄًأدتةەأۗ"
"8172","%أؼغۏۄأڬۄحەأۄۏڽأ=أثىۏأمشۏػۄأڬەأتۏڬأإزوۏأىەأثۏتىأڬۏتأۄەأڬۄأظذتثۄأڬشتوأىەأمشۏػۄأڬەأزىأودہەأىىڲتأڬشأزۏتأ؏أتىۄًڽأىەأزۏڬہتأڬۄأوۏشۏأثؽهًڽأڬەأثتهًڽأځشأتثہۏأتضحشتأىۄۏڽأهڲتأحہتأ+أۏؼىۏأوۏڽأتثہۏأىتثتهؽأحہتأحًأتىۄًڽأىەأودہەأډہًڔأزۏتأۗ"
"8173","أؼثزتهوهڬأثىأؼوۏشألشوتحەأۄۏڽأ=أؼغۏۄأمشػۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأضؼزأثىأوؼتسأڬًأذڬوأوهتأڬۄأثىۏأمشۏػۄأڬەأدىڲدًاڽأڬًأمحهأڬشأزًأ؏أتًشأتىأڬەأثډًڽأڬًأڲشلحتشأڬشأهًأ؏أتىأزىًڽأوۏڽأډہًټتأثډۄأحہتأ؏أذعشحأضؼزأڬەأضتحہۏًڽأڬًأوۏشەأثتشەأوۏڽأطڬأۄًتأ؏أتىۄًڽأىەأ+أوۏشەأڬځڔەأتحشًتأڬشأزۏڬہتأحًأ"
