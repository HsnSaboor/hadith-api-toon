"15621","(۱۵۶۲۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِنَافِعٍ ، کَانَ ابْنُ عُمَرَ یَسْتَقْبِلُ الْبَیْتَ فِی الْمَوْقِفِ یعمدہ ؟ قَالَ : نَعَمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 15621","","","كتاب الحج"
"15622","(۱۵۶۲۲) حَدَّثَنَا حَاتِمٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکِبَ حَتَّی أَتَی الْمَوْقِفَ فَجَعَلَ بطن نَاقَتِہِ الْقُصْوَاء إلَی الصَّخَرَاتِ ، وَجَعَلَ جَبَلَ الْمُشَاۃِ بَیْنَ یَدَیْہِ ، وَاسْتَقْبَلَ الْقِبْلَۃَ فَلَمْ یَزَلْ وَاقِفًا حَتَّی غَرَبَتِ الشَّمْسُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15622","","","كتاب الحج"
"15623","(۱۵۶۲۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّ عَبْدَ اللہِ لَمَّا أَتَی جَمْرَۃَ الْعَقَبَۃِ اسْتَبْطَنَ الْوَادِیَ ، وَاسْتَقْبَلَ الْکَعْبَۃَ وَجَعَلَہَا عَلَی حَاجِبِہِ الأَیْمَنِ ، ثُمَّ رَمَاہَا بِسَبْعِ حَصَیَاتٍ یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15623","","","كتاب الحج"
"15624","(۱۵۶۲۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّہُ حَجَّ مَعَ عَبْدِ اللہِ وَأَنَّہُ رَمَی الْجَمْرَ بِسَبْعِ حَصَیَاتٍ وَجَعَلَ الْبَیْتَ ، عَنْ یَسَارِہِ وَمِنًی ، عَنْ یَمِینِہِ ، ثُمَّ قَالَ : ہَذَا مَقَامُ الَّذِی أُنْزِلَتْ عَلَیْہِ سُورَۃُ الْبَقَرَۃِ۔ (بخاری ۱۷۴۷۔ مسلم ۳۰۷)",": Sahih","Musannaf Ibn Abi Shaybah 15624","","","كتاب الحج"
"15625","(۱۵۶۲۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ أَنَّہُمْ کَانُوا إذَا رَمَوُا الْجِمَارَ اسْتَقْبَلُوا الْبَیْتَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15625","","","كتاب الحج"
"15626","(۱۵۶۲۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : رَأَیْتُ عَطَائً ، وَعَبْدَ الرَّحْمَن بْنَ الأَسْوَدِ وَعَمْرَو بْنَ دِینَارٍ یَقُومُونَ ، عَنْ یَسَارِ الْجَمْرَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15626","","","كتاب الحج"
"15627","(۱۵۶۲۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، قَالَ : قَالَ عُمَرُ : مَنْ قَدَّمَ ثِقَلَہُ لَیْلَۃَ یَنْفِرُ فَلاَ حَجَّ لَہُ۔","","Musannaf Ibn Abi Shaybah 15627","","","كتاب الحج"
"15628","(۱۵۶۲۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : إذَا أَنْتَ ارْتَحَلْت فَلاَ یَسْبِقُک ثِقَلُک، فَإِنَّ ذَلِکَ یُکْرَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15628","","","كتاب الحج"
"15629","(۱۵۶۲۹) حَدَّثَنَا أَبُو الْحُسَیْنِ، عَنْ شَرِیکٍ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، قَالَ: إذَا حَلَّ لَکَ النَّفْرُ فَلاَ بَأْسَ أَنْ تُقَدِّمَ ثِقَلَک۔",": No Data Available","Musannaf Ibn Abi Shaybah 15629","","","كتاب الحج"
"15630","(۱۵۶۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن عَمْرِو بْنِ شُرَحْبِیلَ ، عَنْ عُمَرَ ، قَالَ : مَنْ قَدَّمَ ثِقَلُہُ قَبْلَ النَّفْرِ فَلاَ حَجَّ لَہُ۔","","Musannaf Ibn Abi Shaybah 15630","","","كتاب الحج"
"15631","(۱۵۶۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ عَمَّارِ بْنِ یَاسِرٍ ، عَنْ عَمَّارٍ ، قَالَ : إذَا حَلَّ لَکَ النَّفْرُ فَقَدِّمْ ثِقَلَک إِنْ شِئْت۔",": Da'if","Musannaf Ibn Abi Shaybah 15631","","","كتاب الحج"
"15632","(۱۵۶۳۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابْنِ طَاوُوس، عَنْ أَبِیہِ، قَالَ: إذَا خَرَجَ الْمَکِّیُّ إلَی وَقْتٍ فَتَمَتَّعَ فَعَلَیْہِ الْہَدْیُ۔","","Musannaf Ibn Abi Shaybah 15632","","","كتاب الحج"
"15633","(۱۵۶۳۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ طَاوُوسٍ ، قَالَ عَلَیْہِ الْہَدْیُ ، وَقَالَ عَطَائٌ: لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 15633","","","كتاب الحج"
"15634","(۱۵۶۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : إذَا تَمَتَّعَ الْمَکِّیُّ فَلاَ ہَدْیَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15634","","","كتاب الحج"
"15635","(۱۵۶۳۵) حَدَّثَنَا عَبْدَۃَ، عَنْ وِقَائِ بْنِ إیَاسٍ ، عَنْ قُرَیْشٍ ، عَنْ صَعْصَعَۃَ ، قَالَ: سَمِعْتُ رَجُلاً سَأَلَ ابْنَ عُمَرَ ، فَقَالَ: حَلَفْت ، أَوْ جُعِلَتْ عَلَیَّ بَدَنَۃٌ ، أَنْحَرُہَا بِأَرْضِ الَّتِی أَنَا بِہَا ؟ فَقَالَ : لاَ تَنْحَرْہَا دُونَ مَحَلِّ الْبُدْنِ ، فَقَالَ: الرَّجُلُ : إنَّمَا قُلْتُ أَنْحَرُہَا بِأَرْضِ الَّتِی أَنَا بِہَا ؟ فَأَبَی عَبْدُ اللہِ بْنُ عُمَرَ ، فَقَالَ : مَنْ شَائَ زَیَّنَ لَہُ الشَّیْطَانُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15635","","","كتاب الحج"
"15636","(۱۵۶۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وِقائٍ ، عَنْ سَعِیدِ بْنُ جُبَیْرٍ ، قَالَ ذَکَرْتُ لَہُ قَوْلَ ابْنِ عُمَرَ انْحَرْہَا بِمَکَّۃَ ، فَقَالَ : مَا شَعَرْت۔","","Musannaf Ibn Abi Shaybah 15636","","","كتاب الحج"
"15637","(۱۵۶۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ وَإِسْمَاعِیلُ بْنُ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، وَعَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ، قَالُوا : مَنْ جُعِلَ عَلَیْہِ بَدَنَۃٌ فَبِمَکَّۃَ ، وَإذَا قَالَ : جَزُورٌ ، أَوْ بَقَرَۃٌ فَحَیْثُ شَائَ وحَیْثُ نَوَی۔",": No Data Available","Musannaf Ibn Abi Shaybah 15637","","","كتاب الحج"
"15638","(۱۵۶۳۸) حَدَّثَنَا سَلاَّمٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا جَعَلَ الرَّجُلُ عَلَیْہِ بَدَنَۃً فَلْیَنْحَرْہَا حَیْثُ سَمَّی ، فَإِنْ لَمْ یُسَمِّ فَلْیَنْحَرْہَا بِمَکَّۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15638","","","كتاب الحج"
"15639","(۱۵۶۳۹) حَدَّثَنَا مَحبُوبٌ الْقَوَارِیرِیُّ ، عَنْ مَالِکِ بْنِ حَبِیبٍ ، قَالَ : سَمِعْتُ سَالِمَ بْنَ عَبْدِ اللہِ وَسُئِلَ عَنِ الْبُدْنِ ، فَقَالَ : لاَ تفی بَدَنَۃٌ إِلاَّ بِہَذَا الْبَلَدِ یَعْنِی مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 15639","","","كتاب الحج"
"15640","(۱۵۶۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَعِکْرِمَۃَ ، قَالاَ : لاَ مَحَلَّ لِلْبُدْنِ دُونَ الْبَیْتِ الْعَتِیقِ۔","","Musannaf Ibn Abi Shaybah 15640","","","كتاب الحج"
"15641","(۱۵۶۴۱) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الرَّجُلِ یَجْعَلُ عَلَیْہِ بَدَنَۃً ، قَالَ : یَنْحَرُہَا حَیْثُ شَائَ ، وحَیْثُ نَوَی۔","","Musannaf Ibn Abi Shaybah 15641","","","كتاب الحج"
"15642","(۱۵۶۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ جَابِرٍ ، عَنْ جَہْمٍ الْبَکْرِیِّ ، أَنَّ رَجُلاً نَذَرَ أَنْ یَنْحَرَ بدنۃ بِالْکُوفَۃِ فَسَأَلَ ابْنَ مَسْعُودٍ ، فَقَالَ : انْحَرْہَا حَیْثُ شِئْت۔",": Da'if","Musannaf Ibn Abi Shaybah 15642","","","كتاب الحج"
"15643","(۱۵۶۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَبَلَۃَ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : مَنْ سَمَّی ، أَوْ نَذَرَ بَدَنَۃً فَلاَ مَحَلَّ لَہَا دُونَ الْبَیْتِ ، وَمَنْ سَمَّی جَزُورًا أوْ بَقَرَۃً فَحَیْثُ شَائَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15643","","","كتاب الحج"
"15644","(۱۵۶۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَعَنْ أَنَسٍ ، عَنِ الْحَسَنِ ، قَالاَ : نِیَّتُہُ ؟۔",": No Data Available","Musannaf Ibn Abi Shaybah 15644","","","كتاب الحج"
"15645","(۱۵۶۴۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ نَذَرَ بَدَنَۃً فَلاَ یَنْحَرْہَا إِلاَّ بِمِنًی ، أَوْ مَکَّۃَ ، وَمَنْ نَذَرَ جَزُورًا فَلْیَنْحَرْہَا حَیْثُ شَائَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15645","","","كتاب الحج"
"15646","(۱۵۶۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : إذَا قَالَ عَلَیَّ ہَدْیٌ فَبِمَکَّۃَ ، وَإذَا قَالَ : بَدَنَۃٌ ، فَحَیْثُ شَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15646","","","كتاب الحج"
"15647","(۱۵۶۴۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : مَنْ جَعَلَ عَلَیْہِ بَدَنَۃً ، فَإِنَّہُ لاَ یَنْحَرُہَا إِلاَّ بِمَکَّۃَ ، وَمَنْ جَعَلَ عَلَیْہِ جَزُورًا نَحَرَہَا حَیْثُ شَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15647","","","كتاب الحج"
"15648","(۱۵۶۴۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی حنیفۃ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَہَلَّتْ بِعُمْرَۃٍ فَخَافَتْ فَوْتَ الْحَجِّ أَہَلَّتْ بِالْحَجِّ ، وَقَضَتِ الْعُمْرَۃَ ، وَعَلَیْہَا دَمٌ ، وَالْعُمْرَۃُ۔","","Musannaf Ibn Abi Shaybah 15648","","","كتاب الحج"
"15649","(۱۵۶۴۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالَ : سَأَلْتُہُمَا ، عَنِ امْرَأَۃٍ قَدِمَتْ مَکَّۃَ مُعْتَمِرَۃً ، فَحَاضَتْ فَخَشِیَتْ أَنْ یَفُوتَہَا الْحَجُّ ، فَقَالاَ : تُہِلُّ بِالْحَجِّ وَتَقْضِی۔","","Musannaf Ibn Abi Shaybah 15649","","","كتاب الحج"
"15650","(۱۵۶۵۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ أَہَلَّ بِعُمْرَۃٍ فَجَائَ وَالنَّاسُ وُقُوفٌ بِعَرَفَۃَ ، فَقَالَ : إِنْ عَلِمَ ، أَنَّہُ یُدْرِکُ مَکَّۃَ أَتَاہَا فَحَلَّ مِنْ عُمْرَتِہِ ، وَإِلاَّ أَہَلَّ بِالْحَجِّ وَطَافَ طَوَافَیْنِ۔","","Musannaf Ibn Abi Shaybah 15650","","","كتاب الحج"
"15651","(۱۵۶۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : تَکُونُ رَافِضَۃً لِلْعُمْرَۃِ ، وَعَلَیْہَا دَمٌ ، وَعُمْرَۃٌ مَکَانَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15651","","","كتاب الحج"
"15652","(۱۵۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَسْتَحِبُّ عُمْرَۃَ الْمُحَرَّمِ۔","","Musannaf Ibn Abi Shaybah 15652","","","كتاب الحج"
"15653","(۱۵۶۵۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، قَالَ : قُلْتُ لِسَالِمِ بْنِ عَبْدِ اللہِ : عُمْرَۃُ الْمُحَرَّمِ أبت ہی ، قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 15653","","","كتاب الحج"
"15654","(۱۵۶۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ ابْنِ عَوْنٍ، قَالَ: قُلْتُ لِلْقَاسِمِ: الْعُمْرَۃُ فِی الْمُحَرَّمِ؟ قَالَ: کَانُوا یَرَوْنَہَا تَامَّۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15654","","","كتاب الحج"
"15655","(۱۵۶۵۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلْتُ سُلَیْمَانَ بْنَ یَسَارٍ وَسَالِمَ بْنَ عَبْدِ اللہِ ، عَنْ عُمْرَۃِ الْمُحَرَّمِ ، فَقَالاَ : تَامَّۃٌ تُقْضَی۔","","Musannaf Ibn Abi Shaybah 15655","","","كتاب الحج"
"15656","(۱۵۶۵۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، قَالَ : سُئِلَ طَاوُوس ، عَنْ عُمْرَۃِ الْمُحَرَّمِ ؟ فَقَالَ : لاَ وَرَبِّ ہَذِہِ مَا أَدْرِی مَا ہِیَ۔","","Musannaf Ibn Abi Shaybah 15656","","","كتاب الحج"
"15657","(۱۵۶۵۷) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ لاَ یَخْرُجَ مِنْ طَوَافِہِ إِلاَّ عَلَی وِتْرٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15657","","","كتاب الحج"
"15658","(۱۵۶۵۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ حَسَنِ بْنِ یَزِیدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : طَوَافَانِ أَحَبُّ إلَیَّ مِنْ طَوَافٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15658","","","كتاب الحج"
"15659","(۱۵۶۵۹) حَدَّثَنَا وَکِیعٌ، عَنِ الْعُمَرِیِّ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّہُ کَانَ یَنْصَرِفُ اللَّیْلَ وَالنَّہَارَ عَلَی وِتْرٍ مِنْ طَوَافِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15659","","","كتاب الحج"
"15660","(۱۵۶۶۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یُحِبُّ أَنْ یَنْصَرِفَ عَلَی وِتْرٍ مِنْ طَوَافِہِ ، وَکَانَ الْحَسَنُ یَقُولُ : عَشْرَۃٌ أَحَبُّ إلَیَّ مِنْ تِسْعَۃٍ ، وَثَمَانِیَۃٌ أَحَبُّ إلَیَّ مِنْ سَبْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 15660","","","كتاب الحج"
"15661","(۱۵۶۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ یَزِیدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یَقُولُ : طَوَافَانِ أَحَبُّ إلَیَّ مِنْ طَوَافٍ۔","","Musannaf Ibn Abi Shaybah 15661","","","كتاب الحج"
"15662","(۱۵۶۶۲) حَدَّثَنَا أَبُو سَعد ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّ عَبْدَ الرَّحْمَن بْنَ أَبِی بَکْرٍ طَافَ فِی إمَارَۃِ سَعِیدٍ فَخَرَجَ إلَی الصَّلاَۃِ ، فَقَالَ عَبْدُ الرَّحْمَنِ : انْتَظِرْ حَتَّی أَنْصَرِفَ عَلَی وتر ، قَالَ فانتظرہ قَالَ فَانْصَرَفَ عَلَی ثَلاَثَۃِ أَطْوَافٍ ، ثُمَّ لَمْ یَعُدْ لِذَلِکَ السَّبْعِ۔","","Musannaf Ibn Abi Shaybah 15662","","","كتاب الحج"
"15663","(۱۵۶۶۳) حَدَّثَنَا عُمَر بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : ثَلاَثَۃُ أَسْبَاعٍ أَحَبُّ إلَیَّ مِنْ أَرْبَعٍ۔","","Musannaf Ibn Abi Shaybah 15663","","","كتاب الحج"
"15664","(۱۵۶۶۴) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ طَافَ بِالْبَیْتِ وَنَسِیَ أَنْ یَرْمُلَ، قَالَ: یُہَرِیقُ دَمًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15664","","","كتاب الحج"
"15665","(۱۵۶۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ نَسِیَ أَنْ یَرْمُلَ الثَلاَثَۃَ أَشْوَاطٍ رَمَلَ فِیمَا بَقِیَ ، وَإِنْ لَمْ یَبْقَ إِلاَّ شَوْطٌ وَاحِدٌ رَمَلَ فِیہِ ، وَلاَ شَیْئَ عَلَیْہِ ، فَإِنْ لَمْ یَرْمُلْ فِی شَیْئٍ مِنْہُنَّ فَلاَ شَیْئَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 15665","","","كتاب الحج"
"15666","(۱۵۶۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ أَنْ یُسْنِدَ الْإِنْسَان ظَہْرَہُ إلَی الْکَعْبَۃِ یَسْتَدْبِرُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15666","","","كتاب الحج"
"15667","(۱۵۶۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ خَلِیفَۃَ بْنِ خَیَّاطٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ وَہُوَ مُسْنِدٌ ظَہْرَہُ إلَی الْکَعْبَۃِ۔ (احمد ۲/۱۹۱)",": Hasan","Musannaf Ibn Abi Shaybah 15667","","","كتاب الحج"
"15668","(۱۵۶۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ فِی قَوْلِہِ : {ذَلِکَ لِمَنْ لَمْ یَکُنْ أَہْلُہُ حَاضِرِی الْمَسْجِدِ الْحَرَامِ} قَالَ : لَیْسَ حَاضِرِی الْمَسْجِدِ الْحَرَامِ إِلاَّ أَہْلُ الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 15668","","","كتاب الحج"
"15669","(۱۵۶۶۹) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : أَہْلُ فَخٍّ وَأَہْلُ ضَجَنَانَ وَأَہْلُ عَرَفَۃَ ہُمْ أَہْلُہُ۔","","Musannaf Ibn Abi Shaybah 15669","","","كتاب الحج"
"15670","(۱۵۶۷۰) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، قَالَ: إذَا اسْتَعْصَی عَلَیْک الْہَدْیُ حِینَ تُرِیدُ أَنْ تَنْحَرَہُ فَعَرْقِبْہُ۔","","Musannaf Ibn Abi Shaybah 15670","","","كتاب الحج"
"15671","(۱۵۶۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا اسْتَعْصَتْ عَلَیْک الْبَدَنَۃُ فَعَرْقِبْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15671","","","كتاب الحج"
"15672","(۱۵۶۷۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ عُثْمَانَ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُعَرْقَبُ الْبُدْنُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15672","","","كتاب الحج"
"15673","(۱۵۶۷۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ تُعَرْقَبُ الْبُدْنُ۔","","Musannaf Ibn Abi Shaybah 15673","","","كتاب الحج"
"15674","(۱۵۶۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی یَحْزمُ عَلَی بَطْنِہِ الثَّوْبَ ، وَلاَ ی??عْقِدُہ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 15674","","","كتاب الحج"
"15675","(۱۵۶۷۵) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوس، قَالاَ: رَأَیْنَا ابْنَ عُمَرَ وَہُوَ مُحْرِمٌ وَقَدْ شَدَّ حَقْوَیْہِ بِعِمَامَۃٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15675","","","كتاب الحج"
"15676","(۱۵۶۷۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مُسْلِمِ بْنِ جُنْدُبٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : لاَ تَعْقِدْ عَلَیْک شَیْئًا وَأَنْتَ مُحْرِمٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15676","","","كتاب الحج"
"15677","(۱۵۶۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَعْقِدَ عَلَی الْقَرْحَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15677","","","كتاب الحج"
"15678","(۱۵۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ صَالِحِ بْنِ أَبِی حَسَّانَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبْصَرَ رَجُلاً محتزما بِحَبْلٍ أَبْرَقَ وَہُوَ مُحْرِمٌ ، فَقَالَ : یَا صَاحِبَ الْحَبْلِ أَلْقِہِ۔ (ابوداؤد ۱۵۸)","","Musannaf Ibn Abi Shaybah 15678","","","كتاب الحج"
"15679","(۱۵۶۷۹) حَدَّثَنَا الْعُکْلِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ أَنْ یَعْقِدَ الْمُحْرِمُ عَلَی الْجُرْحِ۔","","Musannaf Ibn Abi Shaybah 15679","","","كتاب الحج"
"15680","(۱۵۶۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ ، عَن عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَعْصِبَ عَلَی الْجُرْحِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15680","","","كتاب الحج"
"15681","(۱۵۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 15681","","","كتاب الحج"
"15682","(۱۵۶۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا کُسِرَتْ یَدُ الْمُحْرِمِ ، وَإِذَا شُجَّ عَصَبَ عَلَیْہَا ، قَالَ مَنْصُور : وَلَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 15682","","","كتاب الحج"
"15683","(۱۵۶۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الْمُحْرِمِ تَنْکَسِرُ یَدُہُ أَیُدَاوِیہَا ؟ قَالَ : نَعَمْ ، وَیَعْصِبُ عَلَیْہَا بِخِرْقَۃٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15683","","","كتاب الحج"
"15684","(۱۵۶۸۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : قلْت لِجَابِرِ بْنِ زَیْدٍ : یَنْحَلُّ إزَارِی بِعَرَفَۃَ فَأَعْقِدُہُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 15684","","","كتاب الحج"
"15685","(۱۵۶۸۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ ہِشَامِ بْنِ حُجَیْرٍ ، قَالَ رَأَی طَاوُوس ابْنَ عُمَرَ یَطُوفُ وَقَدْ شَدَّ حَقْوَہُ بِعِمَامَۃٍ۔","","Musannaf Ibn Abi Shaybah 15685","","","كتاب الحج"
"15686","(۱۵۶۸۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، أَنَّہَا سُئِلَتْ ، عَنِ الْہِمْیَانِ لِلْمُحْرِمِ ، فَقَالَتْ : أَوْثِقْ نَفَقَتِکَ فِی حَقْوَیک۔",": Sahih","Musannaf Ibn Abi Shaybah 15686","","","كتاب الحج"
"15687","(۱۵۶۸۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ وَعَطَائً ، عَنِ الْہِمْیَانِ لِلْمُحْرِمِ ، فَقَالاَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 15687","","","كتاب الحج"
"15688","(۱۵۶۸۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ بِالمَنْطِقَۃ للِمُحْرِم۔","","Musannaf Ibn Abi Shaybah 15688","","","كتاب الحج"
"15689","(۱۵۶۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ مُحَمَّدٍ ، قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ ، عَنِ الْمِنْطَقَۃِ لِلْمُحْرِمِ ، فَقَالَ : لاَ بَأْسَ بِہَا وَرَأَیْت عَلَیْہِ ثَوْبًا مُوَرَّدًا۔","","Musannaf Ibn Abi Shaybah 15689","","","كتاب الحج"
"15690","(۱۵۶۹۰) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ ، وَإِنْ کَانَ عَرِیضًا۔","","Musannaf Ibn Abi Shaybah 15690","","","كتاب الحج"
"15691","(۱۵۶۹۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ یَحْیَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَرِہَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15691","","","كتاب الحج"
"15692","(۱۵۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ بَأْسَ بِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15692","","","كتاب الحج"
"15693","(۱۵۶۹۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ صَالِحِ بْنِ جُبَیْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ سُئِلَ عَنِ الرَّجُلِ تَکُونُ مَعَہُ الدَّرَاہِمُ یَشُدُّہَا عَلَی حَقْوَیْہِ ، قَالَ : نَعَمْ ، وَلاَ یَشُدُّہَا عَلَی عَقْدِ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 15693","","","كتاب الحج"
"15694","(۱۵۶۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، أَنَّہُ کَرِہَ الْہِمْیَانَ لِلْمُحْرِمِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15694","","","كتاب الحج"
"15695","(۱۵۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی بکیر ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ بِالْہِمْیَانِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 15695","","","كتاب الحج"
"15696","(۱۵۶۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15696","","","كتاب الحج"
"15697","(۱۵۶۹۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یَلْبَسُ الْہِمْیَانَ : یَعْنِی الْمُحْرِمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15697","","","كتاب الحج"
"15698","(۱۵۶۹۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، أَنَّ ابن الزُّبَیْرَ قَدِمَ حَاجًّا فَرَمَلَ فِی الثَلاَثَۃِ الأَطْوَافٍ حَتَّی رَأَیْت مِنْطَقَتہ عَلَی بَطْنِہِ انْقَطَعَتْ۔",": Sahih","Musannaf Ibn Abi Shaybah 15698","","","كتاب الحج"
"15699","(۱۵۶۹۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامِ بْنِ حَسَّانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَلْبَسَ الْمُحْرِمُ الْہِمْیَانَ إِنْ کَانَ یُحْرِزُ فِیہِ نَفَقَتَہُ۔","","Musannaf Ibn Abi Shaybah 15699","","","كتاب الحج"
"15700","(۱۵۷۰۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : سَأَلْتُ عَنْہُ مُحَمَّدَ بْنَ کَعْبٍ ، فَقَالَ : اخْتَلَفَ فِیہِ الْفُقَہَائُ ، فَإِنْ شَدَّدْتَ فَحَسَنٌ ، وَإِنْ رَخَّصْتَ فَحَسَنٌ۔","","Musannaf Ibn Abi Shaybah 15700","","","كتاب الحج"
"15701","(۱۵۷۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِالْہِمْیَانِ لِلْمُحْرِمِ ، وَلَکِنْ لاَ یَعْقِدُ عَلَیْہِ السَّیْرَ وَلَکِنَّہ یَلُفُّہُ لَفًّا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15701","","","كتاب الحج"
"15702","(۱۵۷۰۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یُجَاوِزُ أَحَدٌ الْوَقْتَ إِلاَّ الْمُحْرِمُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15702","","","كتاب الحج"
"15703","(۱۵۷۰۳) حَدَّثَنَا شَرِیکٌ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ یُجَاوِزْ أَحَدٌ ذَاتَ عِرْقٍ حَتَّی یُحْرِمَ۔",": Hasan","Musannaf Ibn Abi Shaybah 15703","","","كتاب الحج"
"15704","(۱۵۷۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ دَاوُدَ، عَنْ مُجَاہِدٍ، أَنَّہُ قَالَ لہ: إذَا جِئْت مِنْ بَلَدٍ آخَرَ فَلاَ تُجَاوِزَ الْحَدَّ حَتَّی تُحْرِمَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15704","","","كتاب الحج"
"15705","(۱۵۷۰۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدِ ، أَنَّہُ کَانَ یَقُولُ : لاَ یُجَاوِزَ الْوَقْتَ حَتَّی تُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 15705","","","كتاب الحج"
"15706","(۱۵۷۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، قَالَ : کَانَ عَطَائٌ یُرَخِّصُ فِی الْقَضِیبِ وَالسِّوَاکِ وَالسَّنَا مِنَ الْحَرَمِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15706","","","كتاب الحج"
"15707","(۱۵۷۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15707","","","كتاب الحج"
"15708","(۱۵۷۰۸) حَدَّثَنَا جریر ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَخْرُجُ الْمُحْرِمُ مِنَ الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 15708","","","كتاب الحج"
"15709","(۱۵۷۰۹) حَدَّثَنَا شَرِیکٌ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ مَوْلًی لابْنِ عَبَّاسٍ ، قَالَ : تَمَتَّعْت فَنَسِیت أَنْ أَنْحَرَ وَأَخَّرْت ہَدْیِی حَتَّی مَضَتِ الأَیَّامُ فَسَأَلْت ابْنَ عَبَّاسٍ ، فَقَالَ : اہْدِ ہَدْیًا لِہَدْیِکَ وَہَدْیًا لِمَا أَخَّرْت۔",": Hasan","Musannaf Ibn Abi Shaybah 15709","","","كتاب الحج"
"15710","(۱۵۷۱۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنِ الصَّلْتِ بْنِ راشد ، قَالَ : سَأَلْتُ طَاوُوسًا ، عَنْ رَجُلٍ تَمَتَّعَ فَلَمْ یَصُمْ ، وَلَمْ یَذْبَحْ حَتَّی مَضَتِ الأَیَّامُ ، قَالَ : فَقَالَ : یَذْبَحُ ، قُلْتُ : لاَ یَجِدُ ، قَالَ : یَبِیعُ ثَوْبَہُ ، قُلْتُ : لاَ یَجِدُ ، قَالَ : فَلْیَسْتَسْلِفْ مِنْ أَصْحَابِہِ ، قُلْتُ : لاَ یُعْطُونَہُ ، قَالَ : کَذَبْت۔","","Musannaf Ibn Abi Shaybah 15710","","","كتاب الحج"
"15711","(۱۵۷۱۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ فِی الرَّجُلِ تَمَتَّعَ فَلَمْ یَذْبَحْ ، وَلَمْ یَصُمْ ، قَالَ فَقَالاَ : أَوْجَبَ عَلَیْہِ الدَّمَ۔","","Musannaf Ibn Abi Shaybah 15711","","","كتاب الحج"
"15712","(۱۵۷۱۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثقفی عن حبیب ، قَالَ : سُئِلَ عَطَائٌ ، عَنِ الْعُمْرَۃِ فِی غَیْرِ أَشْہُرِ الْحَجِّ ، فِیہَا ہَدْیٌ وَاجِبٌ ؟ قَالَ : لَیْسَ فِیہَا ہَدْیٌ وَاجِبٌ ، وَقَدْ کَانُوا یُہْدُونَ ، وَقَدْ أَہْدَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ صَدَّہُ الْمُشْرِکُونَ فَہَلْ کَانَ أَحْرَمَ بِالْعُمْرَۃِ ؟ قَالَ : نَعَمْ وَصَالَحَہُمْ أَنْ یَأْتِیَہُمْ فِی الْعَامِ الْمُقْبِلِ ، وَقَدْ رَأَیْت مُعَاوِیَۃَ یَنْحَرُ جَزُورًا فِی الْعُمْرَۃِ فِی غَیْرِ أَشْہُرِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 15712","","","كتاب الحج"
"15713","(۱۵۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ ، عن مجاہد ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا أُحْصِرَ فَنَحَرَ الْہَدْیَ حَلَقَ رَأْسَہُ۔","","Musannaf Ibn Abi Shaybah 15713","","","كتاب الحج"
"15714","(۱۵۷۱۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَقْتُلُ الْمُحْرِمُ الذِّئْبَ۔ (ابوداؤد ۱۳۷۔ عبدالرزاق ۸۳۸۴)","","Musannaf Ibn Abi Shaybah 15714","","","كتاب الحج"
"15715","(۱۵۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَقْتُلُ الْمُحْرِمُ الذِّئْبَ۔","","Musannaf Ibn Abi Shaybah 15715","","","كتاب الحج"
"15716","(۱۵۷۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، عَنِ ابْنٍ عُمَرَ قَالَ : یَقْتُلُ الْمُحْرِمُ الذِّئْبَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15716","","","كتاب الحج"
"15717","(۱۵۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ ، عَنْ وَبَرَۃَ، عَنِ ابْنِ عُمَرَ قَالَ: یَقْتُلُ الْمُحْرِمُ الذِّئْبَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15717","","","كتاب الحج"
"15718","(۱۵۷۱۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ سَالِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: اُطْرُدِ الذِّئْبَ، عَنْ رَحْلِکَ وَأَنْتَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 15718","","","كتاب الحج"
"15719","(۱۵۷۱۹) حَدَّثَنَا حَاتِمٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَقْتُلُ الْمُحْرِمُ الذِّئْبَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15719","","","كتاب الحج"
"15720","(۱۵۷۲۰) حَدَّثَنَا ابن الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، قَالَ : یُقْتَلُ الذِّئْبُ فِی الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 15720","","","كتاب الحج"
"15721","(۱۵۷۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، وَعَطَائٍ فِی الْمُحْرِمِ یَقْتُلُ الذِّئْبَ وَالأَسَدَ ، قَالاَ: اُقْتُلْہُ ، فَإِنَّہُ عَدُوٌّ۔","","Musannaf Ibn Abi Shaybah 15721","","","كتاب الحج"
"15722","(۱۵۷۲۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، عَنْ عُمَرَ، قَالَ: یَقْتُلُ الْمُحْرِمُ الذِّئْبَ وَالْحَیَّۃَ۔","","Musannaf Ibn Abi Shaybah 15722","","","كتاب الحج"
"15723","(۱۵۷۲۳) حَدَّثَنَا ابْنُ إدْرِیسُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : اُقْتُلِ الذِّئْبَ وَکُلَّ عَدُوٍّ لَمْ یُذْکَرْ فِی الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 15723","","","كتاب الحج"
"15724","(۱۵۷۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بْنِ نَافِعٍ ، أَنَّ امْرَأَۃً أَعْجَمِیَّۃً قَدِمَتْ فَقَضَتِ الْمَنَاسِکَ کُلَّہَا ، غَیْرَ أَنَّہَا لَمْ تُہِلَّ بِشَیْئٍ ، فَقَالَ عَطَائٌ : لاَ یُجْزِئُہَا۔\n وَقَالَ طَاوُوس : یُجْزِئُہَا ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَسِّرُوا ، وَلاَ تُعَسِّرُوا۔\n(بخاری ۶۹۔ ابوداؤد ۴۸۰۲)","","Musannaf Ibn Abi Shaybah 15724","","","كتاب الحج"
"15725","(۱۵۷۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، أَنَّ رَجُلاً أَعْجَمِیًّا حَجَّ فَلَمْ یُسَمِّ حَجًّا ، وَلاَ عُمْرَۃً، وَقَالَ : أَنَا مَعَ النَّاسِ ، فَقَالَ : إنِّی لأَرْجُو أَنْ یَکُونَ قَدْ دَخَلَ فِی أَحْسَنِ مَا عَمِلُوا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15725","","","كتاب الحج"
"15726","(۱۵۷۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ نَافِعٍ ، أَنَّ کَعْبًا أَہْدَی بَقَرَۃً مُقَلَّدَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15726","","","كتاب الحج"
"15727","(۱۵۷۲۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْبَقَرُ تُقَلَّدُ ، وَلاَ تُشْعَرُ۔","","Musannaf Ibn Abi Shaybah 15727","","","كتاب الحج"
"15728","(۱۵۷۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُقَلِّدُ الْبَقَرَۃَ وَیُشْعِرُہَا فِی أَسْنِمَتِہَا ، فَإِنْ لَمْ یَکُنْ لَہَا سَنَامٌ فَمَوْضِعُہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15728","","","كتاب الحج"
"15729","(۱۵۷۲۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ أَنَّہُمْ ، قَالُوا : لاَ عُمْرَۃَ إلاَّ عُمْرَۃٌ ابْتَدَأْتَہَا مِنْ أَہْلِکَ ، وَلاَ عُمْرَۃَ بَعْدَ الصَّدَرِ ، وَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : إِنْ رَجَعَ إلَی مِیقَاتِ أَرضَۃٍ مُتَمَتِّعٌ رجوت أَنْ تَکُونَ عُمْرَۃً۔","","Musannaf Ibn Abi Shaybah 15729","","","كتاب الحج"
"15730","(۱۵۷۳۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کُنَّا نَبْلُغُ الْمَدِینَۃَ بِلُحُومِ الأَضَاحِیِّ۔",": Sahih","Musannaf Ibn Abi Shaybah 15730","","","كتاب الحج"
"15731","(۱۵۷۳۱) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا لاَ نَأْکُلُ مِنَ الْبُدْنِ إِلاَّ أَیَّامَ مِنًی ، فَرَخَّصَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : کُلُوا وَتَزَودوا فَأَکَلْنَا وَتَزَوَّدْنَا ، قَالَ : قُلْنَا لِعَطَائٍ : أَتَرَاہُ خُصَّ ہَدْیَ الْمُتْعَۃِ وَحْدَہُ ؟ قَالَ : لاَ وَلَکِنْ لاَ أَرَاہُ إِلاَّ الْہَدْیَ کُلَّہُ۔ (بخاری ۲۹۸۰۔ مسلم ۳۰)",": Sahih","Musannaf Ibn Abi Shaybah 15731","","","كتاب الحج"
"15732","(۱۵۷۳۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ کَانَ لاَ یَأْکُلُ فَوْقَ ثَلاَثٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15732","","","كتاب الحج"
"15733","(۱۵۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ، أَنَّہُ قَالَ : لاَ یَأْکُلُ أَحَدٌ مِنْ أُضْحِیَّتِہِ فَوْقَ ثَلاَثٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15733","","","كتاب الحج"
"15734","(۱۵۷۳۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الْبَخْتَرِیِّ بْنِ الْمُخْتَارِ ، عَنِ ابْنِ معقل ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: کُنْت نَہَیْتُکُمْ ، عَنْ لُحُومِ الأَضَاحِیِّ فَکُلُوا وَتَزَوَّدُوا فِی أَسْفَارِکُمْ۔","","Musannaf Ibn Abi Shaybah 15734","","","كتاب الحج"
"15735","(۱۵۷۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَتَزَوَّدُہَا إلَی الْمَدِینَۃِ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۲۹۸۰۔ مسلم ۱۵۶۲)",": Sahih","Musannaf Ibn Abi Shaybah 15735","","","كتاب الحج"
"15736","(۱۵۷۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُنَّا نَہْبِطُ بِہَا الأَمْصَارَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15736","","","كتاب الحج"
"15737","(۱۵۷۳۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ أَنَسٍ ، قَالَ : کُنَّا نَذْبَحُ مَا شَائَ اللَّہُ مِنْ أَضَاحِینَا وَنَأْکُلُ بَقِیَّتَہَا بِالْبَصْرَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15737","","","كتاب الحج"
"15738","(۱۵۷۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَحُجُّ ، عَنِ الرَّجُلِ الَّذِی لَمْ یَحُجَّ ، قَالَ : یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 15738","","","كتاب الحج"
"15739","(۱۵۷۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إنَّ اللَّہَ لَوَاسِعٌ لَہُمَا جَمِیعًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15739","","","كتاب الحج"
"15740","(۱۵۷۴۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَحُجُّ ، عَنِ الرَّجُلِ ، قَالَ : یُرْجَی لَہُ مِثْلُ أَجْرِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15740","","","كتاب الحج"
"15741","(۱۵۷۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنْ سَعِیدِ بْنِ حَسَّانَ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْزِلُ وَادِیَ نَمِرَۃَ ، فَلَمَّا قَاتَلَ الْحَجَّاجُ ابْنَ الزُّبَیْرِ أَرْسَلَ إلَیَّ أَی سَاعَۃٍ کَانَ یَرُوحُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ہَذَا الْیَوْمِ ، فَقَالَ : إذَا کَانَ ذَلِکَ رُحْنَا ، فَأَرْسَلَ الْحَجَّاجُ رَجُلاً ، فَقَالَ : إذَا رَاحَ فَأَعْلِمْنِی ، فَأَرَادَ ابْنُ الزُّبَیْرِ أَنْ یَرُوحَ فَقَالُوا : لَمْ تَزِغِ الشَّمْسُ فَجَلَسَ ، ثُمَّ أَرَادَ أَنْ یَرُوحَ فَقَالُوا : لَمْ تَزِغِ الشَّمْسُ فَجَلَسَ ، فَلَمَّا ، قَالُوا : قَدْ زَاغَتْ ، رَاحَ۔ (احمد ۲۵۔ ابوداؤد ۱۹۰۹)",": Da'if","Musannaf Ibn Abi Shaybah 15741","","","كتاب الحج"
"15742","(۱۵۷۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَلْقٍ ، قَالَ : قَالَ عُمَرُ لِزَیْدِ بْنِ صُوحَانَ أَیْنَ مَنْزِلُک بِمِنًی ؟ قَالَ فِی الشِّقِّ الأَیْسَرِ ، قَالَ : قَالَ ذَلِکَ مَنْزِلُ الدَّاجِ فَلا تَنْزِلْہُ ، قَالَ عَمْرو : وَمَنْزِلِی فِیہِ۔","","Musannaf Ibn Abi Shaybah 15742","","","كتاب الحج"
"15743","(۱۵۷۴۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ بِنْتِ سِیرِینَ ، قَالَتْ : کَانُوا یَسْتَحِبُّونَ أَنْ یَنْزِلُوا الْجَانِبَ الأَیْمَنَ مِنْ مِنًی۔","","Musannaf Ibn Abi Shaybah 15743","","","كتاب الحج"
"15744","(۱۵۷۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْزِلُ الشِّقَّ الأَیْمَنَ مِنْ مِنًی۔",": Da'if","Musannaf Ibn Abi Shaybah 15744","","","كتاب الحج"
"15745","(۱۵۷۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ فِی قَوْلِہِ : {فَمَنْ تَعَجَّلَ فِی یَوْمَیْنِ فَلاَ إِثْمَ عَلَیْہِ} قَالَ : مَغْفُورٌ لَہُ {وَمَنْ تَأَخَّرَ فَلاَ إِثْمَ عَلَیْہِ} قَالَ : مَغْفُورٌ لَہُ۔","","Musannaf Ibn Abi Shaybah 15745","","","كتاب الحج"
"15746","(۱۵۷۴۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : (فمَنْ تَعَجَّلَ فِی یَوْمَیْنِ فَلاَ إِثْمَ عَلَیْہِ وَمَنْ تَأَخَّرَ فَلاَ إِثْمَ عَلَیْہِ) قَالَ فِی تَعْجِیلِہِ ، قَالَ (وَمَنْ تَأَخَّرَ) ، قَالَ فِی تَأْخِیرِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15746","","","كتاب الحج"
"15747","(۱۵۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سَوَادَۃُ بْنُ أَبِی الأَسْوَدِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ، قَالَ: خَرَجَ مِنْ ذُنُوبِہِ کَیَوْمِ وَلَدَتْہُ أُمُّہُ۔","","Musannaf Ibn Abi Shaybah 15747","","","كتاب الحج"
"15748","(۱۵۷۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْحَاقَ بْن یَحْیَی ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : {فمَنْ تَعَجَّلَ فِی یَوْمَیْنِ فَلاَ إِثْمَ عَلَیْہِ} قَالَ : إلَی قَابِلٍ {وَمَنْ تَأَخَّرَ فَلاَ إِثْمَ عَلَیْہِ} قَالَ : إلَی قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 15748","","","كتاب الحج"
"15749","(۱۵۷۴۹) حَدَّثَنَا ابْنُ أُبَیٍّ عَدِیٌّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : {فمَنْ تَعَجَّلَ فِی یَوْمَیْنِ فَلاَ إِثْمَ عَلَیْہِ وَمَنْ تَأَخَّرَ فَلاَ إِثْمَ عَلَیْہِ} قَالَ فِی تَعْجِیلِہِ۔","","Musannaf Ibn Abi Shaybah 15749","","","كتاب الحج"
"15750","(۱۵۷۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا إذَا طَافَ الرَّجُلُ بِالْبَیْتِ أَنْ یُثَنِّیَ ، ثُمَّ یُثَلِّثَ قَبْلَ أَنْ یَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15750","","","كتاب الحج"
"15751","(۱۵۷۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ إذَا اشْتَرَی بَدَنَۃً قَلَّدَہَا حَیْثُ ابْتَاعَہَا بِمَکَّۃَ ، أَوْ بِمِنًی۔",": No Data Available","Musannaf Ibn Abi Shaybah 15751","","","كتاب الحج"
"15752","(۱۵۷۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُقَلِّدُونَ یَوْمَ التَّرْوِیَۃِ وَقَبْلَ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15752","","","كتاب الحج"
"15753","(۱۵۷۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ نُسیر ، أَنَّ ابْنَ الزُّبَیْرِ رَأَی قَوْمًا یَمْسَحُونَ الْمَقَامَ ، فَقَالَ : لَمْ تُؤْمَرُوا بِہَذَا ، إنَّمَا أُمِرْتُمْ بِالصَّلاَۃِ عِنْدَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15753","","","كتاب الحج"
"15754","(۱۵۷۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُقَبِّلَ الْمَقَامَ ، وَلاَ تَلْمِسْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15754","","","كتاب الحج"
"15755","(۱۵۷۵۵) حَدَّثَنَا وَکِیعُ ، عَنْ ابن نَافِعٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ دَخَلَ فَلَمْ یُصَلِّ یَعْنِی فی الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15755","","","كتاب الحج"
"15756","(۱۵۷۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ الْکَعْبَۃَ فَقَامَ عِنْدَ سَارِیَۃٍ فَدَعَا ، وَلَمْ یُصَلِّ۔ (بخاری ۳۹۸۔ احمد ۱/۲۳۷)",": Sahih","Musannaf Ibn Abi Shaybah 15756","","","كتاب الحج"
"15757","(۱۵۷۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی الطُّفَیْلِ ، قَالَ : دَخَلْت مَعَ عَلِیٍّ ، وَالْحَسَنِ وَالْحُسَیْنِ ، وَابْنِ الْحَنَفِیَّۃِ الْکَعْبَۃَ فَلَمْ یُصَلُّوا فِیہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 15757","","","كتاب الحج"
"15758","(۱۵۷۵۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : دَخَلْت مَعَ عُمَرَ بْنِ مُحَمَّدِ ابْنِ الْحَنَفِیَّۃِ الْبَیْتَ فَقَامَ فَدَعَا ، ثُمَّ اسْتَلَمَ الْبَیْتَ ، ثُمَّ خَرَجَ ، وَلَمْ یُصَلِّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15758","","","كتاب الحج"
"15759","(۱۵۷۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عن ہشام ، عَنِ الْحَسَنِ ، وَعَطَائٍ فِی الْمُحْرِمِ أَشَارَ إلَی صَیْدٍ فَأَصَابَہُ مُحْرِمٌ ، قَالاَ : عَلَیْہِ الْجَزَائُ۔","","Musannaf Ibn Abi Shaybah 15759","","","كتاب الحج"
"15760","(۱۵۷۶۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی الْمُشِیرِ والدال وَالْقَاتِلِ عَلَی کُلِّ إنْسَانٍ مِنْہُمْ جَزَائٌ۔","","Musannaf Ibn Abi Shaybah 15760","","","كتاب الحج"
"15761","(۱۵۷۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَتَی رَجُلٌ ابْنَ عَبَّاسٍ ، فَقَالَ : إنِّی أَشَرْت بِظَبْیٍ وَأَنَا مُحْرِمٌ فَأَصِیدُ ، قَالَ : ضَمِنْت۔",": Da'if","Musannaf Ibn Abi Shaybah 15761","","","كتاب الحج"
"15762","(۱۵۷۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ لَیْثٍ، قَالَ: قَالَ رَجُلٌ لِطَاوُوس إنِّی أَشَرْت إلَی حَلاَلِ صَیْدٍ وَأَنَا مُحْرِمٌ؟ قَالَ: ضَمِنْت۔","","Musannaf Ibn Abi Shaybah 15762","","","كتاب الحج"
"15763","(۱۵۷۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یُشِیرُ الْمُحْرِمُ إلَی الصَیْدِ ، وَلاَ یَدُلُّ عَلَیْہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15763","","","كتاب الحج"
"15764","(۱۵۷۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ مِثْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15764","","","كتاب الحج"
"15765","(۱۵۷۶۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا أَشَارَ الْمُحْرِمُ إلَی الصَّیْدِ فَعَنِتَ ، فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 15765","","","كتاب الحج"
"15766","(۱۵۷۶۶) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : إذَا أَمَرَ الْمُحْرِمُ الْحَلاَلَ بِقَتْلِ الصَّیْدِ فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 15766","","","كتاب الحج"
"15767","(۱۵۷۶۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، أَنَّ ہَبَّارًا رَجُلاً مِنْ أَہْلِ الشَّامِ ، قَالَ : قدِمْت عَلَی عُمَرَ بْنِ الْخَطَّابِ وَہُوَ یَنْحَرُ الْبُدْنَ فِی دَارِ المَنْحر۔",": Sahih","Musannaf Ibn Abi Shaybah 15767","","","كتاب الحج"
"15768","(۱۵۷۶۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْمَنْحَرُ بِمَکَّۃَ وَلَکِنَّہَا نُزِّہَتْ ، عَنِ الدِّمَائِ ، قَالَ : قُلْتُ لِعَطَائٍ : أَیْنَ تَنْحَرُ أَنْتَ ؟ قَالَ فِی رَحْلی۔",": Sahih","Musannaf Ibn Abi Shaybah 15768","","","كتاب الحج"
"15769","(۱۵۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَنْحَرُ بَدَنَتَہُ فِی رَحْلِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15769","","","كتاب الحج"
"15770","(۱۵۷۷۰) حَدَّثَنَا خَالِدٌ بن الحَارِث ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَنْحَرُ فِی الْمَنْحَرِ ، قَالَ عُبَیْدُ اللہِ : مَنْحَرُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15770","","","كتاب الحج"
"15771","(۱۵۷۷۱) حَدَّثَنَا خَالِدٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، أَنَّ سَالِمًا کَانَ یَنْحَرُ فِی أَہْلِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15771","","","كتاب الحج"
"15772","(۱۵۷۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : یَنْحَرُ الْبَدَنَۃُ حَیْثُ تَیَسَّرَ عَلَیْہِ مِنْ مِنًی۔","","Musannaf Ibn Abi Shaybah 15772","","","كتاب الحج"
"15773","(۱۵۷۷۳) حَدَّثَنَا وَکِیعُ ، عَنْ أُسَامَۃَ ، عَنْ عَطَائٍ ، عَنْ جابرٍ قَالَ : قَالَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنًی کُلہا مَنحَر ، وکُل فِجَاج مَکَۃَ طَرِیق مَنحَر۔",": Hasan","Musannaf Ibn Abi Shaybah 15773","","","كتاب الحج"
"15774","(۱۵۷۷۴) حَدَّثَنَا معْنُ بْنُ عِیسَی ، عَنْ مُخْتَارِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ نَحَرَ بَدَنَاتٍ بِمِنًی بِالْمَنْحَرِ ، وَلَمْ یُعَرِّفْ۔","","Musannaf Ibn Abi Shaybah 15774","","","كتاب الحج"
"15775","(۱۵۷۷۵) حَدَّثَنَا معَنْ بْنُ عِیسَی ، عَنْ زِیدَ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ خَارِجَۃَ بْنَ یَزِیدَ یَنْحَرُ فِی مَنْزِلِہِ بِمِنًی ، وَلَمْ یَنْحَرْ فِی الْمَنْحَرِ۔","","Musannaf Ibn Abi Shaybah 15775","","","كتاب الحج"
"15776","(۱۵۷۷۶) حَدَّثَنَا معَنْ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ یَنْحَرُ فِی الْمَنْحَرِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15776","","","كتاب الحج"
"15777","(۱۵۷۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأحمر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَنْحَرُ بِمَکَّۃَ ، قَالَ : وَکَانَ ابْنُ عُمَرَ یَنْحَرُ بِمِنَی۔",": Hasan","Musannaf Ibn Abi Shaybah 15777","","","كتاب الحج"
"15778","(۱۵۷۷۸) حَدَّثَنَا محمد بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِط ، قَالَ : ذَبَحَ إبْرَاہِیمُ الْخَلِیلُ خَلْفَ الْعَقَبَۃِ۔","","Musannaf Ibn Abi Shaybah 15778","","","كتاب الحج"
"15779","(۱۵۷۷۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَیْنَ أَنْحَرُ ہَدْیِی بِأَعْلَی مَکَّۃَ ، وَفِی أَسْفَلِہَا ؟ قَالَ : نَعَمْ ، قُلْتُ : بِالأَبْطَحِ ؟ قَالَ : نَعَمْ ، قُلْتُ : فِی بَیْتِی ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 15779","","","كتاب الحج"
"15780","(۱۵۷۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَنْحَرُ ہَدْیَہُ خَلْفَ الْعَقَبَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15780","","","كتاب الحج"
"15781","(۱۵۷۸۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عَیَّاشٍ ، عَنْ زَیْدِ بْنِ عَلِیٍّ، عَنْ أَبِیہِ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مِنًی کُلُّہَا مَنْحَرٌ۔",": Hasan","Musannaf Ibn Abi Shaybah 15781","","","كتاب الحج"
"15782","(۱۵۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ فِی امْرَأَۃٍ نَسِیَتْ أَنْ تُقَصِّرَ حَتَّی خَرَجَتْ ، فَقَالَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ وَعَامِرٌ : تُقَصِّرُ وَتُہْرِیقُ دَمًا۔","","Musannaf Ibn Abi Shaybah 15782","","","كتاب الحج"
"15783","(۱۵۷۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ فِی رَجُلٍ نَسِیَ أَنْ یَحْلِقَ ، أَوْ یُقَصِّرَ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 15783","","","كتاب الحج"
"15784","(۱۵۷۸۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ وَالْقَاسِمِ ، وَعَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ فِی الْمَرْأَۃِ تَمُرُّ بِالْمَوْقِفِ رَاجِعَۃً مِنْ مَکَّۃَ فَلَمْ تُقَصِّرْ ، قَالُوا : لاَ یُؤَاخِذُہَا اللَّہُ بِالنِّسْیَانِ ، وَقَالَ ابْنُ الأَسْوَدِ وَالشَّعْبِیُّ : تُقَصِّرُ وَعَلَیْہَا دَمٌ ، وَتَمَّ حَجُّہَا۔","","Musannaf Ibn Abi Shaybah 15784","","","كتاب الحج"
"15785","(۱۵۷۸۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ رْفَعَہُ ، قَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : مَسْجِدِ الْحَرَامِ وَمَسْجِدِ الرَّسُولِ وَمَسْجِدِ الأَقْصَی۔",": Sahih","Musannaf Ibn Abi Shaybah 15785","","","كتاب الحج"
"15786","(۱۵۷۸۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ طَلْقٍ ، عَنْ قَزَعَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ آتِیَ الطُّورَ ؟ قَالَ : دَعِ الطُّورَ ، لاَ تَأْتِہِ ، وَقَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15786","","","كتاب الحج"
"15787","(۱۵۷۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : الْمَسْجِدِ الْحَرَامِ وَمَسْجِدِ الرَّسُولِ وَبَیْتِ الْمَقْدِسِ۔","","Musannaf Ibn Abi Shaybah 15787","","","كتاب الحج"
"15788","(۱۵۷۸۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : أَتَی رَجُلٌ عُمَرَ ، فَقَالَ : إنِّی أُرِیدُ بَیْتَ الْمَقْدِسِ ، فَقَالَ : اذْہَبْ فَتَجَہَّزْ فَإِذَا تَجَہَّزْت فَآذِنِّی ، فَلَمَّا تَجَہَّزَ أَتَاہُ ، قَالَ : اجْعَلْہَا عُمْرَۃً۔",": Sahih","Musannaf Ibn Abi Shaybah 15788","","","كتاب الحج"
"15789","(۱۵۷۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدٍ ، قَالَ : بَیْنَا عُمَرُ یَعْرِضُ إبل الصَّدَقَۃِ إذْ أَقْبَلَ رَاکِبَانِ ، فَقَالَ : مِنْ أَیْنَ ؟ فَقَالاَ : مِنْ بَیْتِ الْمَقْدِسِ ، فَعَلاَہُمَا عُمَرُ بِالدِّرَّۃِ ، قَالَ : حَجٌّ کَحَجِّ الْبَیْتِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15789","","","كتاب الحج"
"15790","(۱۵۷۹۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ لَیْثٍ ، عَنْ شَہر ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : الْمَسْجِدِ الْحَرَامِ وَمَسْجِدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَسْجِدِ الأَقْصَی۔",": Da'if","Musannaf Ibn Abi Shaybah 15790","","","كتاب الحج"
"15791","(۱۵۷۹۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی الْہُذَیْلِ ، قَالَ : لاَ تَشُدُّوا الرِّحَالَ إِلاَّ إلَی الْبَیْتِ الْعَتِیقِ۔","","Musannaf Ibn Abi Shaybah 15791","","","كتاب الحج"
"15792","(۱۵۷۹۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ قَزَعَۃَ ، عَنْ أَبِی سَعِیدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تُشَدُّ الرِّحَالُ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : مَسْجِدِ الْحَرَامِ وَمَسْجِدِ الرَّسُولِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالمَسْجِدِ الأَقْصَی۔",": Sahih","Musannaf Ibn Abi Shaybah 15792","","","كتاب الحج"
"15793","(۱۵۷۹۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَشُدُّوا الرِّحَالَ إِلاَّ إلَی ثَلاَثَۃِ مَسَاجِدَ : مَسْجِدِ الْحَرَامِ ، مَسْجِدِ الأَقْصَی ، وَمَسْجِدِی ہَذَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15793","","","كتاب الحج"
"15794","(۱۵۷۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی حَسَّانَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَلَّدَ نَعْلَیْنِ۔ (ترمذی ۹۰۶۔ ابوداؤد ۱۷۵۰)",": Sahih","Musannaf Ibn Abi Shaybah 15794","","","كتاب الحج"
"15795","(۱۵۷۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَجْمَعُ نَعْلَہُ مِنَ السَّنَۃِ فَیُقَلِّدُہَا بُدْنَہُ ، فَإِذَا عَجَزَتِ اشْتَرَی نِعَالاً جُدُدًا فَقَلَّدَہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15795","","","كتاب الحج"
"15796","(۱۵۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُقَلِّدُ بَدَنَتَہُ نَعْلَیْنِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15796","","","كتاب الحج"
"15797","(۱۵۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ أَبِی مَخْلَدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قلَّدَہَا خُرَّابَۃَ أُذُنِ مَزَادَۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15797","","","كتاب الحج"
"15798","(۱۵۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّاد ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَلَّدَ مَرَّۃً زَوْجًا جَدِیدًا مَحْزُوًّا مُشَرَّکًا۔",": Hasan","Musannaf Ibn Abi Shaybah 15798","","","كتاب الحج"
"15799","(۱۵۷۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی مجلز ، عَنِ ابْنِ عُمَرَ بِنَحْوٍ مِنْ حَدِیثِ سُفْیَانَ ، عَنْ عَاصِمٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15799","","","كتاب الحج"
"15800","(۱۵۸۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّہُ أَخْبَرَہُ مَنْ رَأَی عُمَرَ یَغْتَسِلُ بِعَرَفَۃَ وَہُوَ یُلَبِّی۔",": Da'if","Musannaf Ibn Abi Shaybah 15800","","","كتاب الحج"
"15801","(۱۵۸۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ اغْتَسَلَ ، ثُمَّ رَاحَ إلَی عَرَفَۃَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15801","","","كتاب الحج"
"15802","(۱۵۸۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا رَاحَ إلَی المعرَّف اغْتَسَلَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15802","","","كتاب الحج"
"15803","(۱۵۸۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، قَالَ : اغْتَسَلَ مُجَاہِدٌ یَوْمَ عَرَفَۃَ وَأَنَا مَعَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15803","","","كتاب الحج"
"15804","(۱۵۸۰۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، أَنَّ أَبَاہُ کَانَ یَغْتَسِلُ یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15804","","","كتاب الحج"
"15805","(۱۵۸۰۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : امْضِ إلَی عَرَفَاتٍ ، فَإِذَا کَانَ عِنْدَ زَوَالِ الشَّمْسِ فَاغْتَسِلْ إِنْ وَجَدْت مَائً ، وَإِلاَّ فَتَوَضَّأْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15805","","","كتاب الحج"
"15806","(۱۵۸۰۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : الْغُسْلُ یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 15806","","","كتاب الحج"
"15807","(۱۵۸۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا سَعَی فِی بَطْنِ الْوَادِی ، قَالَ : رَبِّ اغْفِرْ وَارْحَمْ إنَّک أَنْتَ الأَعَزُّ الأَکْرَمُ۔",": Sahih","Musannaf Ibn Abi Shaybah 15807","","","كتاب الحج"
"15808","(۱۵۸۰۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ مِثْلَہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 15808","","","كتاب الحج"
"15809","(۱۵۸۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَر إذَا مَرَّ بِالْوَادِی بَیْنَ الصَّفَا وَالْمَرْوَۃِ سَعَی فِیہِ حَتَّی یُجَاوِزَہُ وَیَقُولُ : رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ الأَعَزُّ الأَکْرَمُ۔","","Musannaf Ibn Abi Shaybah 15809","","","كتاب الحج"
"15810","(۱۵۸۱۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، أَنَّ أَبَاہُ کَانَ یَقُولُ وَہُوَ یَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ : اللَّہُمَّ إنَّ ہَذَا وَاحِدٌ إِنْ تَمَّا أَتَمَّہُ اللَّہُ وَقَدْ أَتَمَّا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15810","","","كتاب الحج"
"15811","(۱۵۸۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ بُدَیْلٍ ، عَنْ مَیْسَرَۃَ ، عَنْ صَفِیَّۃَ بِنْتِ شَیْبَۃَ ، عَنْ أُمِّ وَلَدِ شَیْبَۃَ، قَالَتْ: رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ وَہُوَ یَقُولُ : لاَ یُقْطَعُ الأَبْطَحُ إِلاَّ شَدًّا۔ (ابن ماجہ ۲۹۸۷۔ احمد ۶/۴۰۴)",": Sahih","Musannaf Ibn Abi Shaybah 15811","","","كتاب الحج"
"15812","(۱۵۸۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ الأَعَزُّ الأَکْرَمُ۔","","Musannaf Ibn Abi Shaybah 15812","","","كتاب الحج"
"15813","(۱۵۸۱۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : رَبِّ اغْفِر وَارْحَمْ وَأَنْتَ الأَعَزُّ الأَکْرَمُ۔","","Musannaf Ibn Abi Shaybah 15813","","","كتاب الحج"
"15814","(۱۵۸۱۴) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ الحَجَّاجِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ الہیثم بن حنشٍ، عَنِ ابْنِ عُمَرَ، أَنَّہُ کَانَ یَفْعَلُہُ۔\n(بیہقی ۹۵)",": Da'if","Musannaf Ibn Abi Shaybah 15814","","","كتاب الحج"
"15815","(۱۵۸۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَدْخُلَ مَکَّۃَ لَیْلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15815","","","كتاب الحج"
"15816","(۱۵۸۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَضُرُّک دَخَلْت مَکَّۃَ لَیْلاً ، أَوْ نَہَارًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15816","","","كتاب الحج"
"15817","(۱۵۸۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : دَخَلْت مَکَّۃَ مَعَ الْقَاسِمِ لَیْلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15817","","","كتاب الحج"
"15818","(۱۵۸۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یَخْرُجُوا مِنَ الْکُوفَۃِ لَیْلاً وَأَنْ یَدْخُلُوا مَکَّۃَ نَہَارًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15818","","","كتاب الحج"
"15819","(۱۵۸۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ دَخَلَ مَکَّۃَ لَیْلاً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15819","","","كتاب الحج"
"15820","(۱۵۸۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُصَن ، عَنْ سَالِمٍ أَنَّہُ دَخَلَ مَکَّۃَ نَہَارًا۔","","Musannaf Ibn Abi Shaybah 15820","","","كتاب الحج"
"15821","(۱۵۸۲۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ دَخَلَ مَکَّۃَ نَہَارًا۔",": Da'if","Musannaf Ibn Abi Shaybah 15821","","","كتاب الحج"
"15822","(۱۵۸۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، قَالَ : دَخَلْت مَعَ سَعِیدِ بْنِ جُبَیْرٍ مَکَّۃَ لَیْلاً۔","","Musannaf Ibn Abi Shaybah 15822","","","كتاب الحج"
"15823","(۱۵۸۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، أَنَّ أَبَاہُ کَانَ یَدْخُلُ مَکَّۃَ لَیْلاً۔","","Musannaf Ibn Abi Shaybah 15823","","","كتاب الحج"
"15824","(۱۵۸۲۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، قَالَ : سَأَلْتُ طَاوُوسًا ، عَنْ رَجُلٍ دَخَلَ مَکَّۃَ لَیْلاً ، فَقَالَ : أَوَلَیْسَ تِلْکَ الْغَنِیمَۃَ الْبَارِدَۃَ ؟ فَسَأَلْت الْقَاسِمَ وَعَطَائً ، عَنْ ذَلِکَ فَلَمْ یَرَیَا بِہِ بَأْسًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15824","","","كتاب الحج"
"15825","(۱۵۸۲۵) وَحَدَّثَنِی یَعْلَی بْنُ حَکِیمٍ ، أَنَّ سَعِیدَ بْنَ جُبَیْرٍ قَدِمَ مَکَّۃَ لَیْلاً فَطَافَ فَمَا عَلِمْنَا بِہِ ، وَفَعَلَ ذَلِکَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 15825","","","كتاب الحج"
"15826","(۱۵۸۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادٍ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، قَالَ : کُنْتُ أُصَلِّی بِالنَّاسِ فِی رَمَضَانَ فَبَیْنَا أَنَا أُصَلِّی سَمِعْت تَکْبِیرَ عُمَرَ عَلَی بَابِ الْمَسْجِدِ قَدِمَ مُعْتَمِرًا فَدَخَلَ فَصَلَّی خَلْفِی۔",": Sahih","Musannaf Ibn Abi Shaybah 15826","","","كتاب الحج"
"15827","(۱۵۸۲۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ مزاحم بْنِ أَبِی مُزَاحِمٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عَبْدِ اللہِ بْنِ خَالِدِ بْنِ أَسِیدٍ ، عَنْ مُحَرِّشٍ الْکَعْبِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اعْتَمَرَ مِنَ الْجِعْرَانَۃِ ، ثُمَّ أَصْبَحَ بِالْجِعْرَانَۃِ کَبَائِتٍ ، فَلَمَّا زَالَتِ الشَّمْسُ رَاحَ فِی بَطْنِ سَرَفٍ حَتَّی جَامَعَ الطَّرِیقَ۔",": Hasan","Musannaf Ibn Abi Shaybah 15827","","","كتاب الحج"
"15828","(۱۵۸۲۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ صَالِحِ بْنِ أَبِی الأَخْضَرِ ، عَنْ رَجُلٍ یُقَالَ لَہُ : خَالِدٌ ، عَنْ مَوْلاَۃٍ لَہُمْ ، عَنْ جَدَّتِہَا، أَنَّ الْحَسَنَ وَالْحُسَیْنَ قَدِمَا مَکَّۃَ لَیْلاً فَطَافَا ، ثُمَّ خَرَجَا۔",": Da'if","Musannaf Ibn Abi Shaybah 15828","","","كتاب الحج"
"15829","(۱۵۸۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مُزَاحِمِ بْنِ أَبِی مُزَاحِمٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عَبْدِ اللہِ بْنِ خَالِدِ بْنِ أَسِیدٍ ، عَنْ مُحَرِّشٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اعْتَمَرَ مِنَ الْجِعْرَانَۃِ ، ثُمَّ رَجَعَ إلَیْہَا کَبَائِتٍ ، قَالَ : وَرَأَیْت ظَہْرَہُ کَأَنَّہُ سَبِیکَۃُ فِضَّۃٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 15829","","","كتاب الحج"
"15830","(۱۵۸۳۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَوْ مُجَاہِدٍ ، قَالَ : الْقَانِعُ الَّذِی یَقْنَعُ بِمَا بُعِثَ إلَیْہِ ، وَالْمُعْتَرُّ الَّذِی یَتَعَرَّضُ لَکَ یَسْأَلُک۔",": No Data Available","Musannaf Ibn Abi Shaybah 15830","","","كتاب الحج"
"15831","(۱۵۸۳۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ ابْنَ عُمَرَ وَہُوَ بِمِنًی ، وَتَلاَ ہَذِہِ الآیَۃَ : {فَکُلُوا مِنْہَا وَأَطْعِمُوا الْقَانِعَ وَالْمُعْتَرَّ} قَالَ : قَالَ لِغُلاَمٍ لَہُ مَعَہُ : ہَذَا الْقَانِعُ الَّذِی یَقْنَعُ بِمَا آتَیْتہ۔",": Da'if","Musannaf Ibn Abi Shaybah 15831","","","كتاب الحج"
"15832","(۱۵۸۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ خُصَیْفٍ، عَنْ مُجَاہِدٍ، قَالَ: الْقَانِعُ أَہْلُ مَکَّۃَ، وَالْمُعْتَرُّ الَّذِی یَعْتَرِیک فَیَسْأَلُک۔",": No Data Available","Musannaf Ibn Abi Shaybah 15832","","","كتاب الحج"
"15833","(۱۵۸۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الْقَانِعُ الَّذِی یَقْنَعُ إلَیْک ، وَالْمُعْتَرُّ الَّذِی یَعْتَرِیک یُرِیک نَفْسَہُ ، وَلاَ یَسْأَلُک۔","","Musannaf Ibn Abi Shaybah 15833","","","كتاب الحج"
"15834","(۱۵۸۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْقَانِعُ السَّائِلُ وَالْمُعْتَرُّ : مُعْتَر البَدن۔","","Musannaf Ibn Abi Shaybah 15834","","","كتاب الحج"
"15835","(۱۵۸۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ فِی رَجُلٍ رَمَی صَیْدًا فِی الْحِلِّ وَہُوَ فِی الْحَرَمِ ، أَوْ ہُوَ فِی الْحِلِّ ، وَالصَّیْدُ فِی الْحَرَمِ ؟ قَالَ : عَلَیْہِ فِدَاؤُہُ۔","","Musannaf Ibn Abi Shaybah 15835","","","كتاب الحج"
"15836","(۱۵۸۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، سُئِلَ عَنِ الرَّجُلِ إذَا رَمَی الصَّیْدَ وَہُوَ فِی الْحَرَمِ فَخَرَجَ مِنَ الْحَرَمِ فَمَاتَ ، أَنَّہُ قَالَ : یَضْمَنُ ، وَإِذَا رَمَاہُ فِی الْحِلِّ وَالصَیدُ فِی الْحِلِّ ، ثُمَّ دَخَلَ الْحَرَمَ فَمَاتَ، أَنَّہُ قَالَ : لاَ یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 15836","","","كتاب الحج"
"15837","(۱۵۸۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ فِی رَجُلٍ رَمَی صَیْدًا فِی الْحِلِّ فَوَقَعَ فِی الْحَرَمِ فَمَاتَ، قَالَ : أَعْجَبُ إلَیَّ أَنْ لاَ یَأْکُلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15837","","","كتاب الحج"
"15838","(۱۵۸۳۸) حَدَّثَنَا حَفص ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا أُصِیبَ الصَّیْدُ فِی الْحِلِّ فَدَخَلَ الْحَرَمَ فَمَاتَ ، فَقَالَ : لاَ یُؤْکَلُ لأَنَّہُ مَاتَ فِی الْحَرَمِ ، وَلاَ یُودَی لأَنَّہُ أُصِیبَ فِی الْحِلِّ۔","","Musannaf Ibn Abi Shaybah 15838","","","كتاب الحج"
"15839","(۱۵۸۳۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَعَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إذَا رَمَی فِی الْحِلِّ وَأَصَابَ فِی الْحَرَمِ کَفَّرَ ، وَإِذَا رَمَی فِی الْحِلِّ وَأَصَابَ فِی الْحِلِّ کَفَّرَ۔","","Musannaf Ibn Abi Shaybah 15839","","","كتاب الحج"
"15840","(۱۵۸۴۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: خَرَجْت مَعَ عَلْقَمَۃَ إلَی مَکَّۃَ فَلَمْ یَغْتَسِلْ حَتَّی دَخَلَہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 15840","","","كتاب الحج"
"15841","(۱۵۸۴۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ، عَنْ إسْمَاعِیلَ، عَنِ الْحَسَنِ، قَالَ: إِنْ شَائَ الْمُحْرِمُ اغْتَسَلَ، وَإِنْ شَائَ لَمْ یَغْتَسِلْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15841","","","كتاب الحج"
"15842","(۱۵۸۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ سُفْیَانَ التَّمَّارِ ، عَنْ أَبِی صَالِحٍ ، قَالَ : یَغْتَسِلُ عِنْدَ الإِحْرَامِ وَیُصَلِّی رَکْعَتَیْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15842","","","كتاب الحج"
"15843","(۱۵۸۴۳) حَدَّثَنَا أَبُو نُعَیْمٍ، عَنْ سُفْیَانَ، عَنْ الزُّبَیْرِ بن عَدِیٍّ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا إذَا أَرَادُوا أَنْ یُحْرِمُوا اغْتَسَلُوا۔","","Musannaf Ibn Abi Shaybah 15843","","","كتاب الحج"
"15844","(۱۵۸۴۴) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنِ الرَّبِیعِ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یُعْجِبُہُ أَن یَغْتَسِلُ عِنْدَ الإِحْرَامِ ، وَإِذَا دَخَلَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 15844","","","كتاب الحج"
"15845","(۱۵۸۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا أَرَادُوا أَنْ یُحْرِمُوا أَنْ یَغْتَسِلُوا۔","","Musannaf Ibn Abi Shaybah 15845","","","كتاب الحج"
"15846","(۱۵۸۴۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّہُ نَزَعَ قَمِیصَہُ عَامَ الْفِتْنَۃِ، ثُمَّ لَبَّی، وَلَمْ یَغْتَسِلْ۔",": Sahih","Musannaf Ibn Abi Shaybah 15846","","","كتاب الحج"
"15847","(۱۵۸۴۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عنْ بَکْرِ ، عنْ ابْنِ عمر قَالَ : مِنَ السُّنَّۃِ أَنْ یَغْتَسِلَ الرَّجُلُ إذَا أَرَادَ أَنْ یُحْرِمَ۔ (ترمذی ۸۳۰۔ ابن خزیمۃ ۲۵۹۵)",": Sahih","Musannaf Ibn Abi Shaybah 15847","","","كتاب الحج"
"15848","(۱۵۸۴۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ یَعْقُوبَ بْنِ قَیْسٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا أَحْرَمْتَ فَاغْتَسِلْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15848","","","كتاب الحج"
"15849","(۱۵۸۴۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَدَعُ الْغُسْلَ عِنْدَ الإِحْرَامِ وَیَأْمُرُ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 15849","","","كتاب الحج"
"15850","(۱۵۸۵۰) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ نَافِعًا أَکَانَ ابْنُ عُمَرَ یَغْتَسِلُ عِنْدَ الإِحْرَامِ ؟ فَقَالَ : کَانَ رُبَّمَا یَغْتَسِلُ ، وَرُبَّمَا تَوَضَّأَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15850","","","كتاب الحج"
"15851","(۱۵۸۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، أَنَّہُ اغْتَسَلَ حِینَ دَخَلَ مَکَّۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15851","","","كتاب الحج"
"15852","(۱۵۸۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : الْغُسْلُ یَوْمَ دُخُولِ مَکَّۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15852","","","كتاب الحج"
"15853","(۱۵۸۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ وَالأَسْوَدُ وَأَصْحَابُنَا إذَا انْتَہَوْا إلَی بِئْرِ مَیْمُونٍ اغْتَسَلُوا مِنْہَا وَلَبِسُوا أحسن ثِیَابَہُمْ۔","","Musannaf Ibn Abi Shaybah 15853","","","كتاب الحج"
"15854","(۱۵۸۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَدْخُلُ مَکَّۃَ فِی حَجٍّ ، وَلاَ عُمْرَۃٍ حَتَّی یَغْتَسِلَ بِذِی طُوًی۔",": Sahih","Musannaf Ibn Abi Shaybah 15854","","","كتاب الحج"
"15855","(۱۵۸۵۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَغْتَسِلُ إذَا دَخَلَ مَکَّۃَ وَیَأْمُرُہُمْ بِذَلِکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15855","","","كتاب الحج"
"15856","(۱۵۸۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ یَرْمِی الْجِمَارَ یَوْمَ النَّفْرِ ، ثُمَّ یَرْجِعُ إلَی ثَقَلِہِ بِمِنًی۔",": No Data Available","Musannaf Ibn Abi Shaybah 15856","","","كتاب الحج"
"15857","(۱۵۸۵۷) حَدَّثَنَا أَسْبَاطٌ ، عَنْ أَبِی بَکْرٍ الْہُذَلِیِّ ، قَالَ : قُلْتُ لِلزُّہْرِیِّ : ہَلْ لِلرَّجُلِ أَنْ یَرْمِیَ جَمْرَۃَ الْعَقَبَۃِ ، ثُمَّ یَرْجِعَ إلَی مَنْزِلِہِ ، ثُمَّ یَسِیرَ إلَی مَکَّۃَ ؟ فَقَالَ : مَا کَانُوا یَرْجِعُونَ إلَی مَنَازِلِہِمْ إذَا رَمَوْا الْجَمْرَۃَ ، وَإِنْ رَجَعَ رَجُلٌ إلَی مَنْزِلِہِ لِمِرْفَقٍ ، أَوْ لِضَیْعَۃٍ ، أَوْ حَاجَۃٍ إنِّی لأَرْجُو أَنْ لاَ یَکُونَ بِہِ بَأْسٌ إِنْ شَائَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 15857","","","كتاب الحج"
"15858","(۱۵۸۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ أَبِیْ نَجِیحٍ، عَنْ مُجَاہِدٍ، عَنْ عَبْدِاللہِ فِی الضَّبِّ یُصِیبُہُ الْمُحْرِمُ جَفْنَۃٌ مِنْ طَعَامٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15858","","","كتاب الحج"
"15859","(۱۵۸۵۹) حَدَّثَنَا سَلاَّمٌ ، عَنْ مُخَارِقٍ ، عَنْ طَارِقٍ ، قَالَ : خَرَجْنَا حُجَّاجًا حَتَّی إذَا کُنَّا بِبَعْضِ الطَّرِیقِ أَوْطَأَ رَجُلٌ مِنَّا ضَبًّا فَقَتَلَہُ وَہُوَ مُحْرِمٌ ، فَأَتَی عُمَرَ بْنَ الْخَطَّابِ لِیَحْکُمَ عَلَیْہِ ، فَقَالَ لَہُ : عُمَرُ : احْکُمْ مَعِی فَحَکَمَا فِیہِ جَدْیًا قَدْ جَمَعَ الْمَائَ وَالشَّجَرَ ، ثُمَّ قَالَ : عُمَرُ : یَحْکُمُ بِہِ ذَوَا عَدْلٍ مِنْکُمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 15859","","","كتاب الحج"
"15860","(۱۵۸۶۰) حَدَّثَنَا أَسْبَاطٌ ، عَنْ مُطَرِّفٍ ، عَنْ عَطَائٍ ، قَالَ فِی الضَّبِّ شَاۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15860","","","كتاب الحج"
"15861","(۱۵۸۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّ عُمَرَ قَضَی فِی الضَّبُعِ کَبْشًا۔","","Musannaf Ibn Abi Shaybah 15861","","","كتاب الحج"
"15862","(۱۵۸۶۲) حَدَّثَنَا شَبَابَۃُ عن ہشام بن الغاز، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: مَنْ قَتَلَ ضَبُعًا وَہُوَ مُحْرِمٌ فَعَلَیْہِ الْفِدَائ۔",": Sahih","Musannaf Ibn Abi Shaybah 15862","","","كتاب الحج"
"15863","(۱۵۸۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ فِی الضَّبُعِ إذَا عَدَا عَلَی الْمُحْرِمِ فَلْیَقْتُلْہُ ، فَإِنْ قَتَلَہُ من قَبْلِ أَنْ یَعْدُوَ عَلَیْہِ فَعَلَیْہِ شَاۃٌ مُسِنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 15863","","","كتاب الحج"
"15864","(۱۵۸۶۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ ابن أَبِی فَرْوَۃَ ، عَنْ عَطَائٍ ، قَالَ : یُعْقَل الضَّبُعُ فِی الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 15864","","","كتاب الحج"
"15865","(۱۵۸۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنِ ابْنِ أبی عَمَّارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ الضَّبُعَ مِنَ الصَّیْدِ ، وَجَعَلَ فِیہِ إذَا أَصَابَہُ الْمُحْرِمُ کَبْشًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15865","","","كتاب الحج"
"15866","(۱۵۸۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عِکْرِمَۃَ فِی الْمُحْرِمِ أَصَابَ جَرَادَۃً ، قَالَ : یَتَصَدَّقُ بِکِسْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 15866","","","كتاب الحج"
"15867","(۱۵۸۶۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی الْجَرَادَۃِ : قبْضَۃٌ ، أَوْ لُقْمَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15867","","","كتاب الحج"
"15868","(۱۵۸۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ عن إِبْرَاہِیمَ ، عَن کَعْبٍ ، أَنَّہُ مَرَّتْ بِہِ جَرَادَۃٌ فَضَرَبَہَا بِسَوْطِہِ فَأَخَذَہَا فَشَوَاہَا ، فَقَالُوا لَہُ ، فَقَالَ : ہَذَا خَطَأٌ ، وَأَنَا أَحْکُمُ عَلَی نَفْسِی فِی ہَذَا دِرْہَمًا ، فَأَتَی عُمَرَ ، فَقَالَ : إِنَّکُمْ أَہْلُ حِمْصَ أَکْثَرُ شَیْئٍ دَرَاہِمَ ، تَمْرَۃٌ خَیْرٌ مِنْ جَرَادَۃٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15868","","","كتاب الحج"
"15869","(۱۵۸۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ بِمِثْلِہِ ، أَوْ نَحْوِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15869","","","كتاب الحج"
"15870","(۱۵۸۷۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ شُعَیْبٍ ، عَنْ عَلِیِّ بْنِ عَبْدِ اللہِ الْبَارِقِیِّ ، قَالَ : کَانَ عبد اللہِ بْنُ عُمَرَ یَقُولُ فِی الْجَرَادَۃِ : قَبْضَۃٌ مِنْ طَعَامٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 15870","","","كتاب الحج"
"15871","(۱۵۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرائیل ، عَنْ جَابِرٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، وعَطَائٍ ، وَمُجَاہِدٍ ، وَطَاوُوسٍ أَنَّہُمْ ، قَالُوا : فِی الْجَنَادِبِ وَالْعَظَاء وَالْجَرَادِ وَالذَّرِّ : قَالُوا : إِنْ قَتَلَہُ عَمْدًا أَطْعَمَ شَیْئًا ، وَإِنْ کَانَ خَطَأً فَلَیْسَ عَلَیْہِ شَیْئٌ ، وَقَالَ : عَامِرٌ ، وَعَبْدُ الرحمن بْنُ الأَسْوَدِ : یُطْعِمُ شَیْئًا خَطَأً کَانَ ، أَوْ عَمْدًا۔","","Musannaf Ibn Abi Shaybah 15871","","","كتاب الحج"
"15872","(۱۵۸۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ مُحْرِمًا أَصَابَ جَرَادَۃً فَحَکَمَ عَلَیْہِ عَبْدُ اللہِ بْنُ عُمَرَ وَرَجُلٌ آخَرُ ، فَحَکَمَ عَلَیْہِ أَحَدُہُمَا تَمْرَۃً وَالآخَرُ کِسْرَۃً۔",": Hasan","Musannaf Ibn Abi Shaybah 15872","","","كتاب الحج"
"15873","(۱۵۸۷۳) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنِ الْقَاسِمِ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنِ الْمُحْرِمِ یُصِیبُ الْجَرَادَۃَ ، فَقَالَ: تَمْرَۃٌ خَیْرٌ مِنْ جَرَادَۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15873","","","كتاب الحج"
"15874","(۱۵۸۷۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ عَقِیلٍ ، عَنِ الضَّحَّاکِ قَالَ : فِی الْجَرَادَۃِ وَنَحْوِہَا ، وَمَا ہُوَ دُونَہَا قَبْضَۃٌ مِنْ طَعَامٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 15874","","","كتاب الحج"
"15875","(۱۵۸۷۵) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: قبْضَۃٌ مِنْ طَعَامٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15875","","","كتاب الحج"
"15876","(۱۵۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی الْمُحْرِمِ یَقْتُلُ الْقَمْلَۃَ ، قَالَ : یَتَصَدَّقُ بِشَیْئٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15876","","","كتاب الحج"
"15877","(۱۵۸۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، وَأَبِیْ ہَاشِمٍ ، قَالاَ : یَتَصَدَّقُ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 15877","","","كتاب الحج"
"15878","(۱۵۸۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحُرِّ بْنِ صَیَّاحٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَر ، وَسُئِلَ عَنِ الْمُحْرِمِ یَقْتُلُ الْقَمْلَۃَ ، قَالَ : یَتَصَدَّقُ بِکِسْرَۃٍ ، أَوْ بِقَبْضَۃٍ مِنْ طَعَامٍ۔","","Musannaf Ibn Abi Shaybah 15878","","","كتاب الحج"
"15879","(۱۵۸۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی قَوْلِہِ سَوَائَ نِالْعَاکِفُ فِیہِ وَالْبَادِ ، قَالَ : خَلْقُ اللہِ فِیہِ سَوَائٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15879","","","كتاب الحج"
"15880","(۱۵۸۸۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَہْلُ مَکَّۃَ وَغَیْرُہُمْ فِی الْمَنَازِلِ سَوَائٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15880","","","كتاب الحج"
"15881","(۱۵۸۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ سَابِطٍ : {سَوَائَ نِالْعَاکِفُ فِیہِ وَالْبَادِ} قَالَ : الْبَادِی الَّذِی یَجِیئُ مِنَ الْحَجِّ وَالْمُقِیمُونَ سَوَائٌ فِی الْمَنَازِلِ یَنْزِلُونَ حَیْثُ شَاؤُوا لاَ یَخْرُجُ رَجُلٌ مِنْ بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 15881","","","كتاب الحج"
"15882","(۱۵۸۸۲) حَدَّثَنَا عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : النَاس فِی البَیت سَوَاء ۔","","Musannaf Ibn Abi Shaybah 15882","","","كتاب الحج"
"15883","(۱۵۸۸۳) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : أَہْلُہُ وَغَیْرُہُ فِیہِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 15883","","","كتاب الحج"
"15884","(۱۵۸۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، أَنَّ عَائِشَۃَ کَانَتْ تُسْرِعُ فِی وَادِی مُحَسِّرٍ۔","","Musannaf Ibn Abi Shaybah 15884","","","كتاب الحج"
"15885","(۱۵۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ زَید بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ ابْنَ عُمَرَ لَمَّا أَتَی وَادِیَ مُحَسِّرٍ ضَرَبَ رَاحِلَتَہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15885","","","كتاب الحج"
"15886","(۱۵۸۸۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّ عَبْدَ اللہِ بْنَ مَسْعُودٍ أَوْضَعَ فِی وَادِی مُحَسِّرٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15886","","","كتاب الحج"
"15887","(۱۵۸۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ لَمْ یَرَ بَأْسًا بِالإِیضَاعِ فِی وَادِی مُحَسِّرٍ وَکَرِہَہُ فِی جِبَالِ عَرَفَاتٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 15887","","","كتاب الحج"
"15888","(۱۵۸۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْحَارِثِ ، عَنْ عُقْبَۃَ مَوْلَی أَدْلَمَ بْنِ نَاعِمَۃَ الْحَضْرَمِیِّ ، أَنَّہُ دَفَعَ مَعَ الْحُسَیْنِ بْنِ عَلِیٍّ مِنْ جَمْعٍ فَلَمْ یَزِدْ عَلَی السَّیْرِ ، فَلَمَّا أَتَی وَادِیَ مُحَسِّرٍ ، قَالَ : اُرْجُزْ بِصَوْتِکَ وَارْکُضْ بِرِجْلِکَ وَاضْرِبْ بِسَوْطِکَ ، وَدَفَعَ فِی الْوَادِی حَتَّی اسْتَوَتْ بِہِ الأَرْضُ ، وَخَرَجَ مِنَ الْوَادِی۔",": Da'if","Musannaf Ibn Abi Shaybah 15888","","","كتاب الحج"
"15889","(۱۵۸۸۹) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عُمَرُ یُوضِعُ یَقُولُ :\nإلَیْکَ تَعْدُو قَلِقٌ وَضِینُہَا ۔۔۔ مُعْتَرِضٌ فِی بَطْنِہَا جَنِینُہَا\n مُخَالِفٌ دِینَ النَّصَارَی دِینُہَا\n قَالَ : وَکَانَ ابْنُ الزُّبَیْرِ یُوضِعُ أَشَدَّ الإِیضَاعِ۔","","Musannaf Ibn Abi Shaybah 15889","","","كتاب الحج"
"15890","(۱۵۸۹۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ خَالِدِ بْنِ أَبِی عُثْمَانَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُوضِعُ فِی وَادِی مُحَسِّرٍ وَہُوَ عَلَی بِرْذَوْنٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15890","","","كتاب الحج"
"15891","(۱۵۸۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُعَاذٍ أَبِی الْعَلاَئِ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یُوضِعُ فِی وَادِی مُحَسِّرٍ۔","","Musannaf Ibn Abi Shaybah 15891","","","كتاب الحج"
"15892","(۱۵۸۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْضَعَ فِی وَادِی مُحَسِّرٍ۔ (ترمذی ۸۸۶۔ احمد ۳/۳۳۲)",": Sahih","Musannaf Ibn Abi Shaybah 15892","","","كتاب الحج"
"15893","(۱۵۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَفَاضَ وَعَلَیْہِ السَّکِینَۃُ ، وَأَمَرَہُمْ بِالسَّکِینَۃِ ، وَأَوْضَعَ فِی وَادِی مُحَسِّرٍ۔ (احمد ۵/۲۰۸)",": Sahih","Musannaf Ibn Abi Shaybah 15893","","","كتاب الحج"
"15894","(۱۵۸۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ مِسْوَرِ بْنِ مَخْرَمَۃَ ، عَنْ عُمَرَ ، أَنَّہُ أَوْضَعَ فِی وَادِی مُحَسِّرٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15894","","","كتاب الحج"
"15895","(۱۵۸۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ أَوْضَعَ فِی وَادِی مُحَسِّرٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 15895","","","كتاب الحج"
"15896","(۱۵۸۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَبِیْدَۃَ ، أَنَّہُ أَوْضَعَ فِی وَادِی مُحَسِّرٍ۔","","Musannaf Ibn Abi Shaybah 15896","","","كتاب الحج"
"15897","(۱۵۸۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی یَنْحَرُ بَدَنَتَہُ وَہِیَ قَائِمَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15897","","","كتاب الحج"
"15898","(۱۵۸۹۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَعَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالاَ : الصَّوَافُّ عَلَی أَرْبَعَۃٍ ، وَالصَّوَافِنُ عَلَی ثَلاَثَۃٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15898","","","كتاب الحج"
"15899","(۱۵۸۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا أَرَادَ أَنْ یَنْحَرَ ہَدْیَہُ عَقَلَہَا فَقَامَتْ عَلَی ثَلاَثٍ ، ثُمَّ نَحَرَہَا۔","","Musannaf Ibn Abi Shaybah 15899","","","كتاب الحج"
"15900","(۱۵۹۰۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ أَیْمَنَ بْنِ نَابِلٍ أَبِی عِمْرَانَ ، قَالَ : سَأَلْتُ طَاوُوسًا ، عَنْ قَوْلِ اللہِ (صَوَاف) قَالَ : تُنْحَرُ قِیَامًا۔","","Musannaf Ibn Abi Shaybah 15900","","","كتاب الحج"
"15901","(۱۵۹۰۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ ، عَنْ مُجَاہِدٍ فِی قولہ تعالی : {وَالْبُدْنَ جَعَلْنَاہَا لَکُمْ مِنْ شَعَائِرِ اللہِ لَکُمْ فِیہَا خَیْرٌ فَاذْکُرُوا اسْمَ اللہِ عَلَیْہَا صَوَافَّ} قَالَ : إذَا نَحَرَہَا قِیَامًا۔","","Musannaf Ibn Abi Shaybah 15901","","","كتاب الحج"
"15902","(۱۵۹۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنْ عَمْرِو بْنِ دِینَارٍ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ بَعْدَ مَا کَبِرَ یَنْحَرُہَا بَارِکَۃً۔",": Sahih","Musannaf Ibn Abi Shaybah 15902","","","كتاب الحج"
"15903","(۱۵۹۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ شَائَ قِیَامًا ، وَإِنْ شَائَ بَارِکَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 15903","","","كتاب الحج"
"15904","(۱۵۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، أَنَّہُ نَحَرَہَا وَہِیَ قَائِمَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15904","","","كتاب الحج"
"15905","(۱۵۹۰۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ ابن أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی آیَۃِ : {فَاذْکُرُوا اسْمَ اللہِ عَلَیْہَا صَوَافَّ} قَالَ : قِیَامٌ۔","","Musannaf Ibn Abi Shaybah 15905","","","كتاب الحج"
"15906","(۱۵۹۰۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَمَّنْ یَذْکُرُ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : رَأَی رَجُلاً یَنْحَرُ بَدَنَتَہُ بَارِکَۃً : فقال : قِیَامًا سُنَّۃُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15906","","","كتاب الحج"
"15907","(۱۵۹۰۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّ ابْنَ عُمَرَ کَانَ یَنْحَرُہَا شَابًّا قِیَامًا ، فَلَمَّا کَبِرَ نَحَرَہَا وَہِیَ بَارِکَۃٌ۔","","Musannaf Ibn Abi Shaybah 15907","","","كتاب الحج"
"15908","(۱۵۹۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: یَنْحَرُہَا وَہِیَ بَارِکَۃٌ أَہْوَنُ عَلَیْہَا وَعَلَی مَنْ یَنْحَرُہَا۔","","Musannaf Ibn Abi Shaybah 15908","","","كتاب الحج"
"15909","(۱۵۹۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، أَنَّ ابْنَ عُمَرَ أَتَی عَلَی رَجُلٍ قَدْ أَنَاخَ بَدَنَتَہُ ، فَقَالَ: انْحَرْہَا قِیَامًا سُنَّۃُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۱۷۱۳۔ ابوداؤد ۱۷۶۵)",": Sahih","Musannaf Ibn Abi Shaybah 15909","","","كتاب الحج"
"15910","(۱۵۹۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ نَحَرَ ثَلاَثَ بُدْنٍ لَہُ قِیَامًا۔",": Sahih","Musannaf Ibn Abi Shaybah 15910","","","كتاب الحج"
"15911","(۱۵۹۱۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ورقَائُ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ یَنْحَرُہَا وَہِیَ قِیَامٌ مَعْقُولَۃٌ إحْدَی یَدَیْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15911","","","كتاب الحج"
"15912","(۱۵۹۱۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْحَلْقُ وَأَخْذٌ مِنَ الشَّوَارِبِ وَتَقْلِیمُ الأَظْفَارِ وَنَتْفُ الإِبْطِ۔","","Musannaf Ibn Abi Shaybah 15912","","","كتاب الحج"
"15913","(۱۵۹۱۳) حَدَّثَنَا الْعُکْلِیُّ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ الْقُرَظِیِّ ، قَالَ : التَّفَثُ : حَلْقُ الْعَانَۃِ ، وَنَتْف الإِبْطِ ، وَالأَخْذُ مِنَ الشَّارِبِ ، وَتَقْلِیمُ الأَظْفَارِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15913","","","كتاب الحج"
"15914","(۱۵۹۱۴) حَدَّثَنَا أَبُو خَالِدٍ ، عن حجاج ، عَنْ عَطَائٍ ، قَالَ : الْحَلْقُ وَالذَّبْحُ وَتَقْلِیمُ الأَظْفَارِ وَمَنَاسِکُ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 15914","","","كتاب الحج"
"15915","(۱۵۹۱۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَا عَلَیْہِمْ فِی الْمَنَاسِکِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15915","","","كتاب الحج"
"15916","(۱۵۹۱۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الشَّعْرُ وَالظُّفْرُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15916","","","كتاب الحج"
"15917","(۱۵۹۱۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : التَّفَثُ : الرَّمْیُ وَالذَّبْحُ وَالْحَلْقُ وَالتَّقْصِیرُ ، وَالأَخْذُ مِنَ الشَّارِبِ ، وَالأَظْفَارِ ، وَاللِّحْیَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15917","","","كتاب الحج"
"15918","(۱۵۹۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سِنَانٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ الأَقْرَعَ بْنَ حَابِسٍ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، الْحَجُّ فِی کُلِّ عَامٍ ، أَوْ مَرَّۃً وَاحِدَۃً؟ قَالَ : لاَ ، بَلْ مَرَّۃٌ ، فَمَنْ زَادَ فَتَطَوُّعٌ۔ (ابوداؤد ۱۷۱۸۔ دارمی ۱۷۸۹)",": Da'if","Musannaf Ibn Abi Shaybah 15918","","","كتاب الحج"
"15919","(۱۵۹۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عُبَیْدَۃَ ، قَالَ : حدَّثَنَا أَبِی ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ أَنَسٍ ، أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَجُّ فِی کُلِّ عَامٍ ، أَوْ مَرَّۃً ؟ فَقَالَ : مَرَّۃً ، أَوْ کَلاَمًا نَحْوَ ہَذَا۔\n(ابن ماجہ ۲۸۸۵)",": Hasan","Musannaf Ibn Abi Shaybah 15919","","","كتاب الحج"
"15920","(۱۵۹۲۰) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَرَوْنَ ، أَنَّ أَعْلَمَ النَّاسِ بِالْمَنَاسِکِ ابْنُ عَفَّانَ ، ثُمَّ بَعْدَہُ ابْنُ عُمَرَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15920","","","كتاب الحج"
"15921","(۱۵۹۲۱) حَدَّثَنَا الْفَضْلُ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ سَیْفٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : ابْنُ عَبَّاسٍ أَعْلَمُ مَنْ بَقِیَ بِالْحَجِّ۔",": Da'if","Musannaf Ibn Abi Shaybah 15921","","","كتاب الحج"
"15922","(۱۵۹۲۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، قَالَ : کُنْتُ جَالِسًا مَعَ أَبِی جَعْفَرٍ فَمَرَّ عَطَائٌ ، فَقَالَ أَبُو جَعْفَرٍ : مَا بَقِیَ مَا بَقِیَ عَلَی ظَہْرِ الأَرْضِ أَحَدٌ أَعْلَمُ بِمَنَاسِکَ الْحَجِّ مِنْ عَطَائٍ۔","","Musannaf Ibn Abi Shaybah 15922","","","كتاب الحج"
"15923","(۱۵۹۲۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : مِنَ السُّنَّۃِ أَنْ تَصْعَدَ عَلَی الصَّفَا حَتَّی یَبْدُوَ لَکَ الْبَیْتُ فَتَسْتَقْبِلَہُ۔","","Musannaf Ibn Abi Shaybah 15923","","","كتاب الحج"
"15924","(۱۵۹۲۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ حُسَیْنِ بْنِ عُقَیلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : یَصْعَدُ عَلَی الصَّفَا حَتَّی یَسْتَقْبِلَ الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15924","","","كتاب الحج"
"15925","(۱۵۹۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا صَعِدَ عَلَی الصَّفَا اسْتَقْبَلَ الْبَیْتَ وَکَبَّرَ ثَلاَثًا ، وَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، یَرْفَعُ بِہَا صَوْتَہُ ، ثُمَّ یَدْعُو طَوِیلاً۔",": Sahih","Musannaf Ibn Abi Shaybah 15925","","","كتاب الحج"
"15926","(۱۵۹۲۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَامَ عَلَی الصَّفَا قَامَ عَلَیْہِ مَقَامًا یَرَی مِنْہُ الْبَیْتَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15926","","","كتاب الحج"
"15927","(۱۵۹۲۷) حَدَّثَنَا حَاتِمٌ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، عَنْ جَابِرٍ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَقَیَ عَلَیْہِ حَتَّی رَأَی الْبَیْتَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15927","","","كتاب الحج"
"15928","(۱۵۹۲۸) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ وَہَیب ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَقِفُ عَلَی الصَّفَا وَالْمَرْوَۃِ حَیْثُ یَرَی الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15928","","","كتاب الحج"
"15929","(۱۵۹۲۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَاب ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ ، أَنَّ سَالِمًا صَعِدَ الصَّفَا مَکَانًا یَرَی مِنْہُ الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 15929","","","كتاب الحج"
"15930","(۱۵۹۳۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُثْمَانَ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالاَ : لاَ یُحْرِمُ بِالْحَجِّ یَوْمَ التَّرْوِیَۃِ حَتَّی یَتَوَجَّہَ إلَی مِنًی۔","","Musannaf Ibn Abi Shaybah 15930","","","كتاب الحج"
"15931","(۱۵۹۳۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : خَرَجَ سَعِیدُ بْنُ جُبَیْرٍ یَوْمَ التَّرْوِیَۃِ مَاشِیًا وَخَرَجْت مَعَہُ ، فَدَخَلَ الْمَسْجِدَ فَصَلَّی رَکْعَتَیْنِ ، ثُمَّ خَرَجَ مِنَ الْمَسْجِدِ وَلَبَّی حِینَ تَوَجَّہَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15931","","","كتاب الحج"
"15932","(۱۵۹۳۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ ابْنِ کَیْسَانَ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : لاَ یَضُرُّکُمْ یَا أَہْلَ مَکَّۃَ أَنْ لاَ تَعْتَمِرُوا ، فَإِنْ أَبَیْتُمْ فَاجْعَلُوا بَیْنَکُمْ وَبَیْنَ الْحَرَمِ بَطْنَ الْوَادِی۔",": Sahih","Musannaf Ibn Abi Shaybah 15932","","","كتاب الحج"
"15933","(۱۵۹۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَہْلُ مَکَّۃَ یَخْرُجُونَ لِلْعُمْرَۃِ وَیُہِلُّونَ بِالْحَجِّ مِنْ مَکَانِہِمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15933","","","كتاب الحج"
"15934","(۱۵۹۳۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ خَالِدِ بْنِ مُسْلِمٍ ، عَنْ سَالِمٍ ، قَالَ : لَوْ کُنْت مِنْ أَہْلِ مَکَّۃَ مَا اعْتَمَرْت۔","","Musannaf Ibn Abi Shaybah 15934","","","كتاب الحج"
"15935","(۱۵۹۳۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ عُمْرَۃٌ ، إنَّمَا یَعْتَمِرُ مَنْ زَارَ الْبَیْتَ لِیَطُوفَ بِہِ وَأَہْلُ مَکَّۃَ یَطُوفُونَ مَتَی شَاؤُوا۔","","Musannaf Ibn Abi Shaybah 15935","","","كتاب الحج"
"15936","(۱۵۹۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ عُمْرَۃٌ ، قَالَ ابْنُ عَبَّاسٍ : أَنْتُمْ یَا أَہْلَ مَکَّۃَ لاَ عُمْرَۃَ لَکُمْ إنَّمَا عُمْرَتُکُمَ الطَّوَافُ بِالْبَیْتِ فَمَنْ جَعَلَ بَیْنَہُ وَبَیْنَ الْحَرَمِ بَطْنَ ْوَادٍ فَلاَ یَدْخُلُ مَکَّۃَ إِلاَّ بِإِحْرَامٍ ، فَقَالَ: فَقُلْتُ لِعَطَائٍ: یُرِیدُ ابْنُ عَبَّاسٍ بطن وَادٍ مِنَ الْحِلِّ؟ قَالَ: بَطْنُ وَادٍ مِنَ الْحِلِّ۔","","Musannaf Ibn Abi Shaybah 15936","","","كتاب الحج"
"15937","(۱۵۹۳۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ وَہَیب ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ عُمْرَۃٌ۔","","Musannaf Ibn Abi Shaybah 15937","","","كتاب الحج"
"15938","(۱۵۹۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ عَلَی أَحَدٍ مِنْ أَہْلِ مَکَّۃَ مُتْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 15938","","","كتاب الحج"
"15939","(۱۵۹۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ مُتْعَۃٌ وَلَیْسَ عَلَیْہِمْ إحْصَارٌ ، إنَّمَا إحْصَارُہُمْ أَنْ یَطُوفُوا بِالْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 15939","","","كتاب الحج"
"15940","(۱۵۹۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ لَیْسَ عَلَی أَہْلِ مَکَّۃَ مُتْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 15940","","","كتاب الحج"
"15941","(۱۵۹۴۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ ہِشَامِ بْنِ حُجَیْرٍ ، عَنْ طَاوُوسٍ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ مُتْعَۃٌ ، ثُمَّ قَرَأَ : {ذَلِکَ لِمَنْ لَمْ یَکُنْ أَہْلُہُ حَاضِرِی الْمَسْجِدِ الْحَرَامِ} ، فَإِنْ فَعَلُوا ، ثُمَّ حَجُّوا فَعَلَیْہِمْ مِثْلُ مَا عَلَی النَّاسِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15941","","","كتاب الحج"
"15942","(۱۵۹۴۲) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیُّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ ، وَلاَ مَنْ نَظَرَ إلَی مَکَّۃَ مُتْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 15942","","","كتاب الحج"
"15943","(۱۵۹۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : الْمُتْعَۃُ لِلنَّاسِ أَجْمَعِینَ إِلاَّ أَہْلَ مَکَّۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15943","","","كتاب الحج"
"15944","(۱۵۹۴۴) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ عَلَی أَہْلِ مَکَّۃَ مُتْعَۃٌ ، وَلاَ إحْصَارٌ ، إنَّمَا یُغْشون حَتَّی یَقْضُوا حَجَّہُمْ۔","","Musannaf Ibn Abi Shaybah 15944","","","كتاب الحج"
"15945","(۱۵۹۴۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی قَوْلِہِ {مَنَ اسْتَطَاعَ إلَیْہِ سَبِیلاً} قَالَ : مَنْ وَجَدَ زَادًا وَرَاحِلَۃً فَقَدْ وَجَبَ عَلَیْہِ الْحَجُّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15945","","","كتاب الحج"
"15946","(۱۵۹۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ زَیْدٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قامَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا یُوجِبُ الْحَجَّ ؟ قَالَ : زَادٌ وَرَاحِلَۃٌ ، قَالَ : یَا رَسُولَ اللہِ ، فَمَا الْحَاجُّ ؟ قَالَ : الشَّعِثُ التَّفِلُ ، قَالَ : فَقَالَ : یَا رَسُولَ اللہِ ، فَمَا أَفْضَلُ الْحَجِّ ؟ قَالَ : الْعَجُّ وَالثَّجُّ ، قَالَ : الْعَجُّ الْعَجِیجُ بِالتَّلْبِیَۃِ ، وَالثَّجُّ نَحْرُ الْبُدْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15946","","","كتاب الحج"
"15947","(۱۵۹۴۷) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ زَکَرِیَّا بْنِ إِسْحَاقَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {مَنِ اسْتَطَاعَ إلَیْہِ سَبِیلاً} قَالَ : زَادٌ وَرَاحِلَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15947","","","كتاب الحج"
"15948","(۱۵۹۴۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ أَبِی کَرِیمَۃَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ الزُّبَیْرِ قَالَ : القوۃ عَلَی قَدْرِ الْقُوَّۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 15948","","","كتاب الحج"
"15949","(۱۵۹۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {مَنِ اسْتَطَاعَ إلَیْہِ} قَالَ : الزَّادُ وَالْبَعِیرُ۔",": Da'if","Musannaf Ibn Abi Shaybah 15949","","","كتاب الحج"
"15950","(۱۵۹۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الزَّادُ وَالرَّاحِلَۃُ۔(ابن جریر ۱۶)",": Hasan","Musannaf Ibn Abi Shaybah 15950","","","كتاب الحج"
"15951","(۱۵۹۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 15951","","","كتاب الحج"
"15952","(۱۵۹۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ؛ فِی قَوْلِہِ: {مَنِ اسْتَطَاعَ إلَیْہِ سَبِیلاً} قَالَ: السَّبِیلُ: زَادٌ وَرَاحِلَۃٌ۔","","Musannaf Ibn Abi Shaybah 15952","","","كتاب الحج"
"15953","(۱۵۹۵۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ عُمَرُ : {مَنِ أسْتَطَاعَ إلَیْہِ سَبِیلاً} قَالَ : زَادٌ وَرَاحِلَۃٌ ، وَقَالَ ابْنُ عَبَّاسٍ : مَنْ وَجَدَ سَعَۃً ، وَلَمْ یُحَلْ بَیْنَہُ وبینہ ، وَقَالَ عَطَائٌ : سَبِیلاً کَمَا قَالَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 15953","","","كتاب الحج"
"15954","(۱۵۹۵۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، عَنْ عَطَائٍ ، قَالَ : زَادٌ وَرَاحِلَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15954","","","كتاب الحج"
"15955","(۱۵۹۵۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ سُوقَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : زَادٌ وَرَاحِلَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15955","","","كتاب الحج"
"15956","(۱۵۹۵۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ سُوقَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، بِمِثْلِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15956","","","كتاب الحج"
"15957","(۱۵۹۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ رَجُلٌ: یَا رَسُولَ اللہِ، مَا السَّبِیلُ إلَیْہِ؟ قَالَ: الزَّادُ وَالرَّاحِلَۃُ۔",": Hasan","Musannaf Ibn Abi Shaybah 15957","","","كتاب الحج"
"15958","(۱۵۹۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ ، یُقَالَ لَہُ : خَالِدٌ ، عَنِ ابْنِ الزُّبَیْرِ : {مَنِ اسْتَطَاعَ إلَیْہِ سَبِیلاً} قَالَ : عَلَی قَدْرِ الْقُوَّۃِ۔","","Musannaf Ibn Abi Shaybah 15958","","","كتاب الحج"
"15959","(۱۵۹۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنِ النَّزَّالِ بْنِ عَمَّارٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ مَلَکَ ثَلاَثَ مِئَۃِ دِرْہَمٍ وَجَبَ عَلَیْہِ الْحَجُّ وَحَرُمَ عَلَیْہِ نِکَاحُ الإِمَائِ۔","","Musannaf Ibn Abi Shaybah 15959","","","كتاب الحج"
"15960","(۱۵۹۶۰) حَدَّثَنَا سَعِیدُ بْنُ خُثیم ، عَنْ أَخِیہِ مَعْمَرِ بْنِ خُثیم ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : قُلْتُ لَہُ : یَرْحَمُک اللَّہُ {مَنِ اسْتَطَاعَ إلَیْہِ سَبِیلاً} فَمَا السَّبِیلُ ؟ قَالَ : أَنْ یَکُونَ لَکَ رَاحِلَۃٌ وبتات مِنْ زَادٍ تَمْشِی عُقْبَۃً وَتَرْکَبُ عُقْبَۃً۔","","Musannaf Ibn Abi Shaybah 15960","","","كتاب الحج"
"15961","(۱۵۹۶۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ، فِی الرَّجُلِ یَقْدُمُ مَکَّۃَ یَوْمَ عَرَفَۃَ مُعْتَمِرًا فَیَطُوفُ بِالْبَیْتِ وَیَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، قَالَ : لاَ یَأْتِی النِّسَائَ وَالنَّاسُ وُقُوفٌ بِعَرَفَۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15961","","","كتاب الحج"
"15962","(۱۵۹۶۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 15962","","","كتاب الحج"
"15963","(۱۵۹۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَلْبَسُ الْمُحْرِمَۃُ الْخُفَّیْنِ وَالسَّرَاوِیلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15963","","","كتاب الحج"
"15964","(۱۵۹۶۴) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سُئِلَ عَطَائٌ أَتَلْبَسُ الْمُحْرِمَۃُ السَّرَاوِیلَ ؟ قَالَ : نَعَمْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15964","","","كتاب الحج"
"15965","(۱۵۹۶۵) حَدَّثَنَا ابْنٌ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ أَنْ تَلْبَسَ الْمُحْرِمَۃُ الْخُفَّیْنِ وَالسَّرَاوِیلَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15965","","","كتاب الحج"
"15966","(۱۵۹۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَلْبَسُ الْمُحْرِمَۃُ السَّرَاوِیلَ۔",": Da'if","Musannaf Ibn Abi Shaybah 15966","","","كتاب الحج"
"15967","(۱۵۹۶۷) حَدَّثَنَا الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : تَلْبَسُ الْمُحْرِمَۃُ الْخُفَّیْنِ والسَّرَاوِیلَ وَالْقُفَّازَیْنِ ، وَتُخَمِّرُ وَجْہَہَا کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 15967","","","كتاب الحج"
"15968","(۱۵۹۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : تَلْبَسُ الْمُحْرِمَۃُ السَّرَاوِیلَ۔","","Musannaf Ibn Abi Shaybah 15968","","","كتاب الحج"
"15969","(۱۵۹۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُرَخِّصُ فِی الْخُفَّیْنِ وَالسَّرَاوِیلِ لِلْمُحْرِمَۃِ ، قَالَ : وَکَانَتْ صَفِیَّۃُ تَلْبَسُ وَہِیَ مُحْرِمَۃٌ خُفَّیْنِ إلَی رُکْبَتَیْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 15969","","","كتاب الحج"
"15970","(۱۵۹۷۰) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَلْبَسَ الْمُحْرِمَۃُ الْخُفَّیْنِ الْمَسُوقَیْنِ۔","","Musannaf Ibn Abi Shaybah 15970","","","كتاب الحج"
"15971","(۱۵۹۷۱) حَدَّثَنَا عَفَّانَ ، قَالَ : حدَّثَنَا عَبْدُ الْوَارِثِ ، قَالَ : حدَّثَنَا حُمَیْدٌ الأَعْرَجُ ، عَنْ مُجَاہِدٍ ، أَنَّ عَبْدَ اللہِ بْنَ عَمْرٍو ، وَعَبْدَ اللہِ بْنَ عَبَّاسٍ ، وَعَبْدَ اللہِ بْنَ عُمَرَ کَانُوا إذَا قَضَوْا طَوَافَہُمْ فَأَرَادُوا أَنْ یَخْرُجُوا اسْتَعَادُوا بَیْنَ الرُّکْنِ وَالْبَابِ ، أَوْ بَیْنَ الْحَجَرِ وَالْبَابِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15971","","","كتاب الحج"
"15972","(۱۵۹۷۲) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنِ الْحَارِثِ بْنِ أَبِی ذُبَاب ، قَالَ : حدَّثَنِی عِکْرِمَۃُ ، قَالَ : کُلُّ صَیْدٍ یُصِیبُہُ الْمُحْرِمُ دُونَ الْحَمَامَۃِ فَفِیہِ ثَمَنُہُ۔","","Musannaf Ibn Abi Shaybah 15972","","","كتاب الحج"
"15973","(۱۵۹۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَعَطَائٍ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا أَنْ یَرْتَدِیَ الْمُحْرِمُ بِالْقَمِیصِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15973","","","كتاب الحج"
"15974","(۱۵۹۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15974","","","كتاب الحج"
"15975","(۱۵۹۷۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مجلز ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَرْمِی الْجِمَارَ وَہُوَ صَائِمٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15975","","","كتاب الحج"
"15976","(۱۵۹۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّہَا کَانَتْ تَصُومُ أَیَّامَ التَّشْرِیقِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15976","","","كتاب الحج"
"15977","(۱۵۹۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ الأَسْوَدِ ، أَنَّہُ کَانَ یَصُومُ أَیَّامَ التَّشْرِیقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15977","","","كتاب الحج"
"15978","(۱۵۹۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ قَیْسِ بْنِ عَبَایَۃَ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ ، عَنْ صِیَامِ الْیَوْمِ بَعْدَ النَّحْرِ ، فَقَالَ : صُمْ إِنْ شِئْت۔",": Sahih","Musannaf Ibn Abi Shaybah 15978","","","كتاب الحج"
"15979","(۱۵۹۷۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، أَنَّہُ کَانَ یَصُومُ أَیَّامَ التَّشْرِیقِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15979","","","كتاب الحج"
"15980","(۱۵۹۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، قَالَ : مَا مِنْ یَوْمٍ أَصُومُہُ أَحَبَّ إلَیَّ مِنْ صَوْمِ یَوْمِ الرُّؤُوسِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 15980","","","كتاب الحج"
"15981","(۱۵۹۸۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ مَا یَقْتُلُ الْمُحْرِمُ ؟ فَقَالَ : حَدَّثَتْنِی إحْدَی نِسْوَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الْغُرَابِ۔",": Sahih","Musannaf Ibn Abi Shaybah 15981","","","كتاب الحج"
"15982","(۱۵۹۸۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : یَقْتُلُ الْمُحْرِمُ الْغُرَابَ۔","","Musannaf Ibn Abi Shaybah 15982","","","كتاب الحج"
"15983","(۱۵۹۸۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی عَمَّارٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَرْمِی غُرَابًا ، عَنْ ظَہْرِ بَعِیرِہِ وَہُوَ مُحْرِمٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 15983","","","كتاب الحج"
"15984","(۱۵۹۸۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ إِبْرَاہِیمَ بن عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : أَمَرَنَا عُمَرُ بِقَتْلِ الْغُرَابِ وَالزُّنْبُورِ وَنَحْنُ مُحْرِمُونَ۔",": Sahih","Musannaf Ibn Abi Shaybah 15984","","","كتاب الحج"
