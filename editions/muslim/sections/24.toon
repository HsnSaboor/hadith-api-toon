hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4163","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، حَدَّثَنَا مَالِكُ بْنُ أَنَسٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ: \\"" حَمَلْتُ عَلَى فَرَسٍ عَتِيقٍ فِي سَبِيلِ اللَّهِ، فَأَضَاعَهُ صَاحِبُهُ، فَظَنَنْتُ أَنَّهُ بَائِعُهُ بِرُخْصٍ، فَسَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ، فَقَالَ: لَا تَبْتَعْهُ وَلَا تَعُدْ فِي صَدَقَتِكَ، فَإِنَّ الْعَائِدَ فِي صَدَقَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ \""\""،nصحیح مسلم حدیث: 4163 عربی حدیث: 1620""","Sahih","Sahih Muslim 4163","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔جس نے مال چھوڑا وہ اس کے وارثوں کا ہےChapter: Whoever Leaves Behind Wealth, It Is For His Heirs"
"4164","وحَدَّثَنِيهِ زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ يَعْنِي ابْنَ مَهْدِيٍّ ، عَنْ مَالِكِ بْنِ أَنَسٍ بِهَذَا الْإِسْنَادِ وَزَادَ لَا تَبْتَعْهُ وَإِنْ أَعْطَاكَهُ بِدِرْهَمٍ.nصحیح مسلم حدیث: 4164 عربی حدیث: 1620","Sahih","Sahih Muslim 4164","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4165","حَدَّثَنِي أُمَيَّةُ بْنُ بِسْطَامَ ، حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ ، حَدَّثَنَا رَوْحٌ وَهُوَ ابْنُ الْقَاسِمِ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ ، عَنْ عُمَرَ \\"" أَنَّهُ حَمَلَ عَلَى فَرَسٍ فِي سَبِيلِ اللَّهِ، فَوَجَدَهُ عِنْدَ صَاحِبِهِ وَقَدْ أَضَاعَهُ وَكَانَ قَلِيلَ الْمَالِ، فَأَرَادَ أَنْ يَشْتَرِيَهُ فَأَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ ذَلِكَ لَهُ، فَقَالَ: لَا تَشْتَرِهِ وَإِنْ أُعْطِيتَهُ بِدِرْهَمٍ، فَإِنَّ مَثَلَ الْعَائِدِ فِي صَدَقَتِهِ كَمَثَلِ الْكَلْبِ يَعُودُ فِي قَيْئِهِ \""\""،nصحیح مسلم حدیث: 4165 عربی حدیث: 1620""","Sahih","Sahih Muslim 4165","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4166","وحَدَّثَنَاه ابْنُ أَبِي عُمَرَ ، حَدَّثَنَا سُفْيَانُ ، عَنْ زَيْدِ بْنِ أَسْلَمَ بِهَذَا الْإِسْنَادِ غَيْرَ أَنَّ حَدِيثَ مَالِكٍ، وَرَوْحٍ أَتَمُّ وَأَكْثَرُ.nصحیح مسلم حدیث: 4166 عربی حدیث: 1620","Sahih","Sahih Muslim 4166","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4167","حَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ \\"" أَنَّ عُمَرَ بْنَ الْخَطَّابِ، حَمَلَ عَلَى فَرَسٍ فِي سَبِيلِ اللَّهِ، فَوَجَدَهُ يُبَاعُ، فَأَرَادَ أَنْ يَبْتَاعَهُ فَسَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ، فَقَالَ: لَا تَبْتَعْهُ وَلَا تَعُدْ فِي صَدَقَتِكَ \""\""،nصحیح مسلم حدیث: 4167 عربی حدیث: 1621""","Sahih","Sahih Muslim 4167","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4168","وحَدَّثَنَاه قُتَيْبَةُ بْنُ سَعِيدٍ ، وَابْنُ رُمْحٍ جَمِيعًا، عَنْ اللَّيْثِ بْنِ سَعْدٍ . ح وحَدَّثَنَا الْمُقَدَّمِيُّ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَا: حَدَّثَنَا يَحْيَى وَهُوَ الْقَطَّانُ . ح وحَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنَا أَبِي . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا أَبُو أُسَامَةَ كُلُّهُمْ، عَنْ عُبَيْدِ اللَّهِ كِلَاهُمَا، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِ حَدِيثِ مَالِكٍ.nصحیح مسلم حدیث: 4168 عربی حدیث: 1621","Sahih","Sahih Muslim 4168","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4169","حَدَّثَنَا ابْنُ أَبِي عُمَرَ ، وَعَبْدُ بْنُ حُمَيْدٍ وَاللَّفْظُ لِعَبْدٍ، قَالَ: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ ابْنِ عُمَرَ \\"" أَنَّ عُمَرَ حَمَلَ عَلَى فَرَسٍ فِي سَبِيلِ اللَّهِ ثُمَّ رَآهَا تُبَاعُ، فَأَرَادَ أَنْ يَشْتَرِيَهَا فَسَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: لَا تَعُدْ فِي صَدَقَتِكَ يَا عُمَرُ \""\"".nصحیح مسلم حدیث: 4169 عربی حدیث: 1621""","Sahih","Sahih Muslim 4169","","","1. باب: جس کو جو چیز صدقہ دے پھر اس سے وہی چیز خریدنا مکروہ ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4170","حَدَّثَنِي إِبْرَاهِيمُ بْنُ مُوسَى الرَّازِيُّ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ ، قَالَا: أَخْبَرَنَا عِيسَى بْنُ يُونُسَ ، حَدَّثَنَا الْأَوْزَاعِيُّ ، عَنْ أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ ، عَنْ ابْنِ الْمُسَيَّبِ ، عَنْ ابْنِ عَبَّاسٍ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" مَثَلُ الَّذِي يَرْجِعُ فِي صَدَقَتِهِ، كَمَثَلِ الْكَلْبِ يَقِيءُ ثُمَّ يَعُودُ فِي قَيْئِهِ فَيَأْكُلُهُ \""\""،nصحیح مسلم حدیث: 4170 عربی حدیث: 1622""","Sahih","Sahih Muslim 4170","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔انسان نے جو کچھ صدقہ کیا اس کو اس شخص سے خریدنا مکروہ ہے جس پر وہ صدقہ کیا گیاتھاChapter: It Is Disliked For A Man To Buy What He Gave In Charity From The One To Whom He Gave It"
"4171","وحَدَّثَنَاه أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، أَخْبَرَنَا ابْنُ الْمُبَارَكِ ، عَنْ الْأَوْزَاعِيِّ ، قَالَ: سَمِعْتُ مُحَمَّدَ بْنَ عَلِيِّ بْنِ الْحُسَيْنِ يَذْكُرُ بِهَذَا الْإِسْنَادِ نَحْوَهُ،nصحیح مسلم حدیث: 4171 عربی حدیث: 1622","Sahih","Sahih Muslim 4171","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4172","وحَدَّثَنِيهِ حَجَّاجُ بْنُ الشَّاعِرِ ، حَدَّثَنَا عَبْدُ الصَّمَدِ ، حَدَّثَنَا حَرْبٌ ، حَدَّثَنَا يَحْيَى وَهُوَ ابْنُ أَبِي كَثِيرٍ ، حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو : أَنَّ مُحَمَّدَ ابْنَ فَاطِمَةَ بِنْتِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَدَّثَهُ بِهَذَا الْإِسْنَادِ نَحْوَ حَدِيثِهِمْ.nصحیح مسلم حدیث: 4172 عربی حدیث: 1622","Sahih","Sahih Muslim 4172","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4173","وحَدَّثَنِي هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ، وَأَحْمَدُ بْنُ عِيسَى ، قَالَا: حَدَّثَنَا ابْنُ وَهْبٍ ، أَخْبَرَنِي عَمْرٌو وَهُوَ ابْنُ الْحَارِثِ ، عَنْ بُكَيْرٍ : أَنَّهُ سَمِعَ سَعِيدَ بْنَ الْمُسَيِّبِ ، يَقُولُ: سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ: \\"" إِنَّمَا مَثَلُ الَّذِي يَتَصَدَّقُ بِصَدَقَةٍ ثُمَّ يَعُودُ فِي صَدَقَتِهِ، كَمَثَلِ الْكَلْبِ يَقِيءُ ثُمَّ يَأْكُلُ قَيَاهُ \""\"".nصحیح مسلم حدیث: 4173 عربی حدیث: 1622""","Sahih","Sahih Muslim 4173","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4174","وحَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، سَمِعْتُ قَتَادَةَ ، يُحَدِّثُ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ قَالَ: \\"" الْعَائِدُ فِي هِبَتِهِ كَالْعَائِدِ فِي قَيْئِهِ \""\""،nصحیح مسلم حدیث: 4174 عربی حدیث: 1622""","Sahih","Sahih Muslim 4174","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4175","وحَدَّثَنَاه مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا ابْنُ أَبِي عَدِيٍّ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ بِهَذَا الْإِسْنَادِ مِثْلَهُ.nصحیح مسلم حدیث: 4175 عربی حدیث: 1622","Sahih","Sahih Muslim 4175","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4176","وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا الْمَخْزُومِيُّ ، حَدَّثَنَا وُهَيْبٌ ، حَدَّثَنَا عَبْدُ اللَّهِ بْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، عَنْ ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَقِيءُ ثُمَّ يَعُودُ فِي قَيْئِهِ \""\"".nصحیح مسلم حدیث: 4176 عربی حدیث: 1622""","Sahih","Sahih Muslim 4176","","","2. باب: صدقہ دے کر لوٹانا حرام ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4177","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَعَنْ مُحَمَّدِ بْنِ النُّعْمَانِ بْنِ بَشِيرٍ يُحَدِّثَانِهِ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، أَنَّهُ قَالَ: إِنَّ أَبَاهُ أَتَى بِهِ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \\"" إِنِّي نَحَلْتُ ابْنِي هَذَا غُلَامًا كَانَ لِي، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَكُلَّ وَلَدِكَ نَحَلْتَهُ مِثْلَ هَذَا، فَقَالَ: لَا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: فَارْجِعْهُ \""\"".nصحیح مسلم حدیث: 4177 عربی حدیث: 1623""","Sahih","Sahih Muslim 4177","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔قبضے میں دینے کے بعد صدقہ واپس لینا حرام ہے‘سوائے اس کے جو اپنی اولاد کو دے ‘وہ (اولاد)خواہ نیچے (مثلاً:بوتا وغیرہ )ہوChapter: The Prohibition Of Taking Back One's Charity After It Has Been Accepted, Except In The Case Of What A Father Gives To A Son Or Grandson"
"4178","وحَدَّثَنَا يَحْيَي بْنُ يَحْيَي ، أَخْبَرَنَا إِبْرَاهِيمُ بْنُ سَعْدٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، وَمُحَمَّدِ بْنِ النُّعْمَانِ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: أَتَى بِي أَبِي إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \\"" إِنِّي نَحَلْتُ ابْنِي هَذَا غُلَامًا، فَقَالَ: أَكُلَّ بَنِيكَ نَحَلْتَ، قَالَ: لَا قَالَ: فَارْدُدْهُ \""\""،nصحیح مسلم حدیث: 4178 عربی حدیث: 1623""","Sahih","Sahih Muslim 4178","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4179","وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاق بْنُ إِبْرَاهِيمَ ، وَابْنُ أَبِي عُمَرَ ، عَنْ ابْنِ عُيَيْنَةَ . ح وحَدَّثَنَا قُتَيْبَةُ ، وَابْنُ رُمْحٍ ، عَنْ اللَّيْثِ بْنِ سَعْدٍ . ح وحَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَي ، أَخْبَرَنَا ابْنُ وَهْبٍ ، قَالَ: أَخْبَرَنِي يُونُسُ . ح وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، وَعَبْدُ بْنُ حُمَيْدٍ ، قَالَا: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ كُلُّهُمْ، عَنْ الزُّهْرِيِّ بِهَذَا الْإِسْنَادِ أَمَّا يُونُسُ، وَمَعْمَرٌ، فَفِي حَدِيثِهِمَا أَكُلَّ بَنِيكَ، وَفِي حَدِيثِ اللَّيْثِ، وَابْنِ عُيَيْنَةَ أَكُلَّ وَلَدِكَ وَرِوَايَةُ اللَّيْثِ، عَنْ مُحَمَّدِ بْنِ النُّعْمَانِ، وَحُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ أَنَّ بَشِيرًا جَاءَ بِالنُّعْمَانِ.nصحیح مسلم حدیث: 4179 عربی حدیث: 1623","Sahih","Sahih Muslim 4179","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4180","حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، قَالَ: حَدَّثَنَا النُّعْمَانُ بْنُ بَشِيرٍ ، قَالَ: \\"" وَقَدْ أَعْطَاهُ أَبُوهُ غُلَامًا، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: مَا هَذَا الْغُلَامُ؟ قَالَ: أَعْطَانِيهِ أَبِي، قَالَ: فَكُلَّ إِخْوَتِهِ أَعْطَيْتَهُ كَمَا أَعْطَيْتَ هَذَا، قَالَ: لَا، قَالَ: فَرُدَّهُ \""\"".nصحیح مسلم حدیث: 4180 عربی حدیث: 1623""","Sahih","Sahih Muslim 4180","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4181","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَيْنٍ ، عَنْ الشَّعْبِيِّ ، قَالَ: سَمِعْتُ النُّعْمَانَ بْنَ بَشِيرٍ . ح وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى وَاللَّفْظُ لَهُ، أَخْبَرَنَا أَبُو الْأَحْوَصِ ، عَنْ حُصَيْنٍ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: \\"" تَصَدَّقَ عَلَيَّ أَبِي بِبَعْضِ مَالِهِ، فَقَالَتْ أُمِّي عَمْرَةُ بِنْتُ رَوَاحَةَ: لَا أَرْضَى حَتَّى تُشْهِدَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَانْطَلَقَ أَبِي إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُشْهِدَهُ عَلَى صَدَقَتِي، فَقَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَفَعَلْتَ هَذَا بِوَلَدِكَ كُلِّهِمْ؟ قَالَ: لَا، قَالَ: اتَّقُوا اللَّهَ وَاعْدِلُوا فِي أَوْلَادِكُمْ \""\"" فَرَجَعَ أَبِي فَرَدَّ تِلْكَ الصَّدَقَةَ.nصحیح مسلم حدیث: 4181 عربی حدیث: 1623""","Sahih","Sahih Muslim 4181","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4182","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا عَلِيُّ بْنُ مُسْهِرٍ ، عَنْ أَبِي حَيَّانَ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ . ح وحَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ وَاللَّفْظُ لَهُ، حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا أَبُو حَيَّانَ التَّيْمِيُّ ، عَنْ الشَّعْبِيِّ ، حَدَّثَنِي النُّعْمَانُ بْنُ بَشِيرٍ : \\"" أَنَّ أُمَّهُ بِنْتَ رَوَاحَةَ سَأَلَتْ أَبَاهُ بَعْضَ الْمَوْهِبَةِ مِنْ مَالِهِ لِابْنِهَا، فَالْتَوَى بِهَا سَنَةً ثُمَّ بَدَا لَهُ، فَقَالَتْ: لَا أَرْضَى حَتَّى تُشْهِدَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى مَا وَهَبْتَ لِابْنِي، فَأَخَذَ أَبِي بِيَدِي وَأَنَا يَوْمَئِذٍ غُلَامٌ، فَأَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: يَا رَسُولَ اللَّهِ، إِنَّ أُمَّ هَذَا بِنْتَ رَوَاحَةَ أَعْجَبَهَا أَنْ أُشْهِدَكَ عَلَى الَّذِي وَهَبْتُ لِابْنِهَا، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: يَا بَشِيرُ أَلَكَ وَلَدٌ سِوَى هَذَا؟ قَالَ: نَعَمْ، فَقَالَ: أَكُلَّهُمْ وَهَبْتَ لَهُ مِثْلَ هَذَا؟ قَالَ: لَا، قَالَ: فَلَا تُشْهِدْنِي إِذًا فَإِنِّي لَا أَشْهَدُ عَلَى جَوْرٍ \""\"".nصحیح مسلم حدیث: 4182 عربی حدیث: 1623""","Sahih","Sahih Muslim 4182","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4183","حَدَّثَنَا ابْنُ نُمَيْرٍ ، حَدَّثَنِي أَبِي ، حَدَّثَنَا إِسْمَاعِيل ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" أَلَكَ بَنُونَ سِوَاهُ؟، قَالَ: نَعَمْ، قَالَ: فَكُلَّهُمْ أَعْطَيْتَ مِثْلَ هَذَا؟ قَالَ: لَا، قَالَ: فَلَا أَشْهَدُ عَلَى جَوْرٍ \""\"".nصحیح مسلم حدیث: 4183 عربی حدیث: 1623""","Sahih","Sahih Muslim 4183","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4184","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، أَخْبَرَنَا جَرِيرٌ ، عَنْ عَاصِمٍ الْأَحْوَلِ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" لِأَبِيهِ لَا تُشْهِدْنِي عَلَى جَوْرٍ \""\"".nصحیح مسلم حدیث: 4184 عربی حدیث: 1623""","Sahih","Sahih Muslim 4184","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4185","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا عَبْدُ الْوَهَّابِ ، وَعَبْدُ الْأَعْلَى . ح وحَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، وَيَعْقُوبُ الدَّوْرَقِيُّ جميعا، عَنْ ابْنِ عُلَيَّةَ وَاللَّفْظُ لِيَعْقُوبَ، قَالَ: حَدَّثَنَا إِسْمَاعِيل بْنُ إِبْرَاهِيمَ، عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: انْطَلَقَ بِي أَبِي يَحْمِلُنِي إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: \\"" يَا رَسُولَ اللَّهِ، اشْهَدْ أَنِّي قَدْ نَحَلْتُ النُّعْمَانَ كَذَا وَكَذَا مِنْ مَالِي، فَقَالَ: أَكُلَّ بَنِيكَ قَدْ نَحَلْتَ مِثْلَ مَا نَحَلْتَ النُّعْمَانَ؟ قَالَ: لَا، قَالَ: فَأَشْهِدْ عَلَى هَذَا غَيْرِي، ثُمَّ قَالَ: أَيَسُرُّكَ أَنْ يَكُونُوا إِلَيْكَ فِي الْبِرِّ سَوَاءً؟ قَالَ: بَلَى، قَالَ: فَلَا إِذًا \""\"".nصحیح مسلم حدیث: 4185 عربی حدیث: 1623""","Sahih","Sahih Muslim 4185","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4186","حَدَّثَنَا أَحْمَدُ بْنُ عُثْمَانَ النَّوْفَلِيُّ ، حَدَّثَنَا أَزْهَرُ ، حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ الشَّعْبِيِّ ، عَنْ النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ: نَحَلَنِي أَبِي نُحْلًا ثُمَّ أَتَى بِي إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِيُشْهِدَهُ، فَقَالَ: \\"" أَكُلَّ وَلَدِكَ أَعْطَيْتَهُ هَذَا؟، قَالَ: لَا، قَالَ: أَلَيْسَ تُرِيدُ مِنْهُمُ الْبِرَّ مِثْلَ مَا تُرِيدُ مِنْ ذَا؟ قَالَ: بَلَى، قَالَ: فَإِنِّي لَا أَشْهَدُ، قَالَ ابْنُ عَوْنٍ: فَحَدَّثْتُ بِهِ مُحَمَّدًا، فَقَالَ: إِنَّمَا تَحَدَّثْنَا، أَنَّهُ قَالَ: قَارِبُوا بَيْنَ أَوْلَادِكُمْ \""\"".nصحیح مسلم حدیث: 4186 عربی حدیث: 1623""","Sahih","Sahih Muslim 4186","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4187","حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ بْنِ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: قَالَتِ امْرَأَةُ بَشِيرٍ: \\"" انْحَلِ ابْنِي غُلَامَكَ وَأَشْهِدْ لِي رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَأَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: إِنَّ ابْنَةَ فُلَانٍ سَأَلَتْنِي أَنْ أَنْحَلَ ابْنَهَا غُلَامِي، وَقَالَتْ أَشْهِدْ لِي رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، فَقَالَ: أَلَهُ إِخْوَةٌ؟ قَالَ: نَعَمْ، قَالَ: أَفَكُلَّهُمْ أَعْطَيْتَ مِثْلَ مَا أَعْطَيْتَهُ؟، قَالَ: لَا، قَالَ: فَلَيْسَ يَصْلُحُ هَذَا وَإِنِّي لَا أَشْهَدُ إِلَّا عَلَى حَقٍّ \""\"".nصحیح مسلم حدیث: 4187 عربی حدیث: 1624""","Sahih","Sahih Muslim 4187","","","3. باب: بعض لڑکوں کو کم دینا اور بعض کو زیادہ دینا مکروہ ہے۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4188","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، قَالَ: قَرَأْتُ عَلَى مَالِكٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" أَيُّمَا رَجُلٍ أُعْمِرَ عُمْرَى لَهُ وَلِعَقِبِهِ، لِلَّذِي أُعْطِيَهَا لَا تَرْجِعُ إِلَى الَّذِي أَعْطَاهَا، لِأَنَّهُ أَعْطَى عَطَاءً وَقَعَتْ فِيهِ الْمَوَارِيثُ \""\"".nصحیح مسلم حدیث: 4188 عربی حدیث: 1625""","Sahih","Sahih Muslim 4188","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔اولاد میں سے کسی کو تحفہ دینے میں فوقیت دینا نا پسندیدہ ہےChapter: It Is Disliked To Favor Some Of One's Children Over Others In Gift-Giving"
"4189","حَدَّثَنَا يَحْيَى بْنُ يَحْيَى ، وَمُحَمَّدُ بْنُ رُمْحٍ ، قَالَا: أَخْبَرَنَا اللَّيْثُ . ح وحَدَّثَنَا قُتَيْبَةُ ، حَدَّثَنَا لَيْثٌ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنَّهُ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: \\"" مَنْ أَعْمَرَ رَجُلًا عُمْرَى لَهُ وَلِعَقِبِهِ فَقَدْ قَطَعَ قَوْلُهُ حَقَّهُ فِيهَا وَهِيَ لِمَنْ أُعْمِرَ وَلِعَقِبِهِ \""\""، غَيْرَ أَنَّ يَحْيَى قَالَ فِي أَوَّلِ حَدِيثِهِ: أَيُّمَا رَجُلٍ أُعْمِرَ عُمْرَى فَهِيَ لَهُ وَلِعَقِبِهِ.nصحیح مسلم حدیث: 4189 عربی حدیث: 1625""","Sahih","Sahih Muslim 4189","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4190","حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ بِشْرٍ الْعَبْدِيُّ ، أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي ابْنُ شِهَابٍ ، عَنِ الْعُمْرَى وَسُنَّتِهَا، عَنْ حَدِيثِ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ جَابِرَ بْنَ عَبْدِ اللَّهِ الْأَنْصَارِيَّ أَخْبَرَهُ: أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" أَيُّمَا رَجُلٍ أَعْمَرَ رَجُلًا عُمْرَى لَهُ وَلِعَقِبِهِ \""\""، فَقَالَ: قَدْ أَعْطَيْتُكَهَا وَعَقِبَكَ مَا بَقِيَ مِنْكُمْ أَحَدٌ، فَإِنَّهَا لِمَنْ أُعْطِيَهَا وَإِنَّهَا لَا تَرْجِعُ إِلَى صَاحِبِهَا مِنْ أَجْلِ أَنَّهُ أَعْطَى عَطَاءً وَقَعَتْ فِيهِ الْمَوَارِيثُ.nصحیح مسلم حدیث: 4190 عربی حدیث: 1625""","Sahih","Sahih Muslim 4190","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4191","حَدَّثَنَا إِسْحَاق بْنُ إِبْرَاهِيمَ ، وَعَبْدُ بْنُ حُمَيْدٍ وَاللَّفْظُ لِعَبْدٍ، قَالَا: أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ الزُّهْرِيِّ ، عَنْ أَبِي سَلَمَةَ ، عَنْ جَابِرٍ ، قَالَ: \\"" إِنَّمَا الْعُمْرَى الَّتِي أَجَازَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ، يَقُولَ: هِيَ لَكَ وَلِعَقِبِكَ، فَأَمَّا إِذَا قَالَ: هِيَ لَكَ مَا عِشْتَ \""\""، فَإِنَّهَا تَرْجِعُ إِلَى صَاحِبِهَا، قَالَ: مَعْمَرٌ، وَكَانَ الزُّهْرِيُّ يُفْتِي بِهِ.nصحیح مسلم حدیث: 4191 عربی حدیث: 1625""","Sahih","Sahih Muslim 4191","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4192","حَدَّثَنَا مُحَمَّدُ بْنُ رَافِعٍ ، حَدَّثَنَا ابْنُ أَبِي فُدَيْكٍ ، عَنْ ابْنِ أَبِي ذِئْبٍ ، عَنْ ابْنِ شِهَابٍ ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ جَابِرٍ وَهُوَ ابْنُ عَبْدِ اللَّهِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \\"" قَضَى فِيمَنْ أُعْمِرَ عُمْرَى لَهُ وَلِعَقِبِهِ، فَهِيَ لَهُ بَتْلَةً لَا يَجُوزُ لِلْمُعْطِي، فِيهَا شَرْطٌ وَلَا ثُنْيَا \""\"" قَالَ أَبُو سَلَمَةَ: لِأَنَّهُ أَعْطَى عَطَاءً وَقَعَتْ فِيهِ الْمَوَارِيثُ، فَقَطَعَتِ الْمَوَارِيثُ شَرْطَهُ.nصحیح مسلم حدیث: 4192 عربی حدیث: 1625""","Sahih","Sahih Muslim 4192","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4193","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، حَدَّثَنَا هِشَامٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ: سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" الْعُمْرَى لِمَنْ وُهِبَتْ لَهُ \""\""،nصحیح مسلم حدیث: 4193 عربی حدیث: 1625""","Sahih","Sahih Muslim 4193","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4194","وحَدَّثَنَاه مُحَمَّدُ بْنُ الْمُثَنَّى ، حَدَّثَنَا مُعَاذُ بْنُ هِشَامٍ ، حَدَّثَنِي أَبِي ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنَا أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ : أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: بِمِثْلِهِ،nصحیح مسلم حدیث: 4194 عربی حدیث: 1625","Sahih","Sahih Muslim 4194","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4195","حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا زُهَيْرٌ ، حَدَّثَنَا أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.nصحیح مسلم حدیث: 4195 عربی حدیث: 1625","Sahih","Sahih Muslim 4195","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4196","وحَدَّثَنَا يَحْيَى بْنُ يَحْيَى وَاللَّفْظُ لَهُ، أَخْبَرَنَا أَبُو خَيْثَمَةَ ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَمْسِكُوا عَلَيْكُمْ أَمْوَالَكُمْ وَلَا تُفْسِدُوهَا، فَإِنَّهُ مَنْ أَعْمَرَ عُمْرَى، فَهِيَ لِلَّذِي أُعْمِرَهَا حَيًّا وَمَيِّتًا وَلِعَقِبِهِ \""\""،nصحیح مسلم حدیث: 4196 عربی حدیث: 1625""","Sahih","Sahih Muslim 4196","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4197","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا حَجَّاجُ بْنُ أَبِي عُثْمَانَ . ح وحَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحاقُ بْنُ إِبْرَاهِيمَ ، عَنْ وَكِيعٍ ، عَنْ سُفْيَانَ . ح وحَدَّثَنَا عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ، حَدَّثَنِي أَبِي ، عَنْ جَدِّي ، عَنْ أَيُّوبَ كُلُّ هَؤُلَاءِ، عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، بِمَعْنَى حَدِيثِ أَبِي خَيْثَمَةَ وَفِي حَدِيثِ أَيُّوبَ مِنَ الزِّيَادَةِ قَالَ: جَعَلَ الْأَنْصَارُ يُعْمِرُونَ الْمُهَاجِرِينَ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: \\"" أَمْسِكُوا عَلَيْكُمْ أَمْوَالَكُمْ \""\"".nصحیح مسلم حدیث: 4197 عربی حدیث: 1625""","Sahih","Sahih Muslim 4197","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4198","وحَدَّثَنِي مُحَمَّدُ بْنُ رَافِعٍ ، وَإِسْحَاقُ بْنُ مَنْصُورٍ وَاللَّفْظُ لِابْنِ رَافِعٍ، قَالَا: حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا ابْنُ جُرَيْجٍ ، أَخْبَرَنِي أَبُو الزُّبَيْرِ ، عَنْ جَابِرٍ ، قَالَ: \\"" أَعْمَرَتِ امْرَأَةٌ بِالْمَدِينَةِ حَائِطًا لَهَا ابْنًا لَهَا ثُمَّ تُوُفِّيَ وَتُوُفِّيَتْ بَعْدَهُ، وَتَرَكَتْ وَلَدًا وَلَهُ إِخْوَةٌ بَنُونَ لِلْمُعْمِرَةِ، فَقَالَ: وَلَدُ الْمُعْمِرَةِ رَجَعَ الْحَائِطُ إِلَيْنَا، وَقَالَ بَنُو الْمُعْمَرِ: بَلْ كَانَ لِأَبِينَا حَيَاتَهُ وَمَوْتَهُ، فَاخْتَصَمُوا إِلَى طَارِقٍ مَوْلَى عُثْمَانَ، فَدَعَا جَابِرًا فَشَهِدَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْعُمْرَى لِصَاحِبِهَا، فَقَضَى بِذَلِكَ طَارِقٌ ثُمَّ كَتَبَ إِلَى عَبْدِ الْمَلِكِ، فَأَخْبَرَهُ ذَلِكَ وَأَخْبَرَهُ بِشَهَادَةِ جَابِرٍ، فَقَالَ عَبْدُ الْمَلِكِ: صَدَقَ جَابِرٌ، فَأَمْضَى ذَلِكَ طَارِقٌ، فَإِنَّ ذَلِكَ الْحَائِطَ لِبَنِي الْمُعْمَرِ حَتَّى الْيَوْمِ \""\"".nصحیح مسلم حدیث: 4198 عربی حدیث: 1625""","Sahih","Sahih Muslim 4198","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4199","حَدَّثَنَا أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ وَاللَّفْظُ لِأَبِي بَكْرٍ، قَالَ إِسْحاقُ أَخْبَرَنَا وَقَالَ أَبُو بَكْرٍ حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عَمْرٍو ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ \\"" أَنَّ طَارِقًا قَضَى بِالْعُمْرَى لِلْوَارِثِ لِقَوْلِ جَابِرِ بْنِ عَبْدِ اللَّهِ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \""\"".nصحیح مسلم حدیث: 4199 عربی حدیث: 1625""","Sahih","Sahih Muslim 4199","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4200","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، قَالَ: سَمِعْتُ قَتَادَةَ يُحَدِّثُ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" الْعُمْرَى جَائِزَةٌ \""\"".nصحیح مسلم حدیث: 4200 عربی حدیث: 1625""","Sahih","Sahih Muslim 4200","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4201","حَدَّثَنَا يَحْيَى بْنُ حَبِيبٍ الْحَارِثِيُّ ، حَدَّثَنَا خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ ، حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، أَنَّهُ قَالَ: \\"" الْعُمْرَى مِيرَاثٌ لِأَهْلِهَا \""\"".nصحیح مسلم حدیث: 4201 عربی حدیث: 1625""","Sahih","Sahih Muslim 4201","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4202","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَابْنُ بَشَّارٍ ، قَالَا: حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، حَدَّثَنَا شُعْبَةُ ، عَنْ قَتَادَةَ ، عَنْ النَّضْرِ بْنِ أَنَسٍ ، عَنْ بَشِيرِ بْنِ نَهِيكٍ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: \\"" الْعُمْرَى جَائِزَةٌ \""\""،nصحیح مسلم حدیث: 4202 عربی حدیث: 1626""","Sahih","Sahih Muslim 4202","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
"4203","وحَدَّثَنِيهِ يَحْيَى بْنُ حَبِيبٍ ، حَدَّثَنَا خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ ، حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ بِهَذَا الْإِسْنَادِ غَيْرَ، أَنَّهُ قَالَ: مِيرَاثٌ لِأَهْلِهَا أَوَ قَالَ جَائِزَةٌ.nصحیح مسلم حدیث: 4203 عربی حدیث: 1626","Sahih","Sahih Muslim 4203","","","4. باب: عمریٰ (تاحیات ہبہ) کا بیان۔کسی کو عمر بھر کےلیے(عطیہ )دیناChapter: The 'Umra (Lifelong Gift)"
