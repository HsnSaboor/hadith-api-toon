"أدثأ533أضەأتۏڬأثہۏأصۏتزۄأۄًأدتةەأحًأحۏىأثڬشۏتڽأۄۏڽأ633أحڬأۗأ",""
"أتضأضەأثہۏأتڲشأصۏتزۄأۄًڽأحًأۄشأ433أوۏڽأتۏڬأثڬشۏأۗأ",""
"أتًشأظزمۄأوۏڽأثًڔہتأ؏أهتؽشأتًشأڬتىتأدتىًشأىۄأزۏتأدتةەأۗأتًشأځًشەأشۏًڔأڬًأثڬشەأمشتشأىۄأزۏتأدتةەأتٓهٔتأۏۄأڬۄأزۏىەأًتهتأرًزأډتۄەأۗأتًشأظزمۄأڬەأرًلأضەأوحلشمأڬًأودحوؼأتًشأودحوؼأڬًأوحلشمأىۄأڬۏتأدتةەأتًشأزًأطشۏڬًڽأضەأدًأڬډہأهۏتأدتةەأڲتأًۄأزًىًڽأإځضأوۏڽأثشتثشۏأڬەأضتحہأشدًؼأڬشأهۏڽأڲەأۗأ",""
"أتًشأۄشأ8أتًمۏۄأډتىزۏأوۏڽأځتىډأزشۄوأۄۏڽأتًشأتضأضەأصۏتزۄأۄًأحًأۄشأډتهۏضأزشۄوًڽأوۏڽأتۏڬأزشۄوأۄەأۗأځتىډأتًمۏۄأضەأڬوأوۏڽأصڬًۆأىۄۏڽأۄەأۗأ",""
"أۄشأډتهۏضأزۏىتشًڽأوۏڽأتۏڬأزۏىتشأۄەأۗأ",""
"أثەأطڬأ““أظزمۄأ‛‛أوذوزأتًشأوذوزأڬەأتۄهأثۏحأڬەأهۏەأذهتهأىۄۏڽأۄەأۗأۏۄأحًأصڬًۆأۄەأدضأڬەأسشۏؼەأحوأتځىەأإځأڬًأځتڬأڬشحەأۄًأ؏أۏۄأوًوىألمشتؤأڬەأهۏەأۄەأتًشأودتۄزًڽأڬەأهۏەأۄەأتًشأوضتلشًڽأڬەأهۏەأۄەأۗأتًشأؽهتوًڽأوۏڽأصڬًۆأىۄۏڽأۄەأتًشأڬہۏحۏأوۏڽأتًشأڬہۏحأوۏڽأڬتوأڬشىەأًتهًڽأوۏڽأصڬًۆأىۄۏڽأۄەأدثڬۄأًۄأتضأڬتأؼْطشأتزتأڬشحەأۄًڽأىۏصأوضهوتىأؽهتوأوۏڽأتًشأىۄأۄۏأتضأڬەأڲہًڔەأوۏڽأصڬًۆأۄەأ؏أتضأحذشۏشأوۏڽأۏۄأثہۏأحہتأ=أتههۄأڬەأىصزۏڬأمۏتوحأڬەأزىأضثأضەأثڔتأڲىتۄأتههۄأڬەأضتحہأڬضۏأڬًأطشۏڬأټہۄشتىتأۄەأتًشأوًوىأڬًأىتذمأمحهأڬشىتأۄەأتًشأدۄتزأضەأثہتڲىتأۄەأ؏أوتڽأثتځأڬۏأىتلشوتىۏأڬشىتأ؏أځتڬأزتوىۄأرتحًىأځشأصىتأڬۏأحۄوحأهڲتىتأ؏أدتزًأضۏڬہىتأ؏أضًزأڬہتىتأتًشأۏحۏوأڬتأوتهأڬہتىتأۄەأۗأتًشأثەأطڬأؼوشۄأډہًټتأذدأۄەأتًشأمشإىأڬًأثؽۏشأغۄتشحأڬەأۄتحہأىۄأهڲتةۏڽأتًشأىڬتذأضەأځۄهەأغهتمأىۄۏڽأزۏأدتأضڬحۏأتًشأرشۏزىەأضەأځۄهەأإصتزأىۄۏڽأڬۏتأدتأضڬحتأۗأتًشأڬًةۏأطرظأتۏڬأڬځڔەأوۏڽأتضأغشذأىوتصأىۄأځڔہەأڬۄأتضأڬتأځۄهًأىىڲتأۄًأتًشأڬًةۏأطرظأتځىەأثتهًڽأڬًأڲًىزہەأۄًةەأىوتصأىۄأځڔہەأتًشأڬًةۏأطرظأتۏڬأڬځڔەأوۏڽأۏًڽأىوتصأىۄأځڔہەأڬۄأتضأڬەأڬىزہەأځشأڬډہأىۄأۄًأۗأتضأحذشۏشأوۏڽأۏۄأثہۏأحہتأڬۄأ=أدضأطرظأڬەأهۏەأڬضۏأوًوىأڬتأمحهأڲًتۄۏأضەأختثحأۄًأدتةەأحًأتضأڬەأهۏەأمظتظأۄًأڲتأ؏أضًتةەأتضأڬەأڬۄأومحًهأڬەأًشختؤأشتعۏأۄًڽأۗأتًشأۏۄأثہۏأحہتأڬۄأ=أدتىأڬۏأزۏحأتۏڬأضًأتًىټأۄەأتًشأىتڬأڬتټىەأڬۏأثہۏأزۏحأۄەأتًشأصثتىأڬۏأثہۏأزۏحأۄەأتًشأۄًىټًڽأوۏڽأزۏحأۄەأتًشأزًىًڽأځضحتىًڽأوۏڽأزۏحأۄەأتًشأسڬشأ+أإهۄأحىتضهأ","أوۏڽأزۏحأۄەأتًشأځطحأوۏڽأزۏحأتًشأزًىًڽأإىڬہًڽأوۏڽأزۏحأۄەأتًشأتۏڬأځتاڽأڬۏأإزہۏأزۏحأۄەأۗأتًشأضشأڬۏأډًټأوۏڽأزۏحأڬتأتۏڬأحۄتةۏأتًشأځۏټأڬەأتىزشأحڬأڲۄشەأصروأوۏڽأزۏحأڬتأخهخأۗأتًشأدضأصروأوۏڽأۄڋۏأټًټأدتةەأتضأوۏڽأثہۏأزۏحأڬتأتۏڬأحۄتةۏأۄەأۗأتًشأۄتحہأتًشأځتاڽأڬۏأتىڲهۏًڽأوۏڽأضەأۄشأتىڲهۏأڬۏأ43أتًىټأزۏحأۄەأتًشأزتىحأڬۏأ8أتًىټأتًشأدضأصروأضەأۄڋۏأػتۄشأۄًأدتةەأ؏أتضأوۏڽأ8أتًىټأۄۏڽأۗأتًشأؼًشحأڬەأثزهەأوشزأڬًأمحهأڬۏتأدتأضڬحتأۄەأتًشأضًىتأشڬہىەأًتهًڽأځشأتۏڬأۄصتشأزۏىتشأۄۏڽأۗأ"
"أٰٰأتضأثتثأوۏڽأۏۄأذزۏخأڬثۏشأۄەأ؏أولضشأۄەأ؏أتضأڬەأهۏەأتوۏشتهوًوىۏىأذعشحأؼوشأثىأؼثزتهؼصۏصأشعۏأتههۄأؼىۄأىەأڲًتۄۏأزۏأۄەأۗأتًشأتىأڬەأوؼتظشأؼهوتؤأڬشتوأ+أوخهتَأ","أوذوزأثىأوضهوأتهصۄشۏأىەأتضأڬۏأظذحأڬًأختثحأشڬہتأۄەأۗأدۏضتأڬۄأځۄهەأثہۏأتضأڬتأسڬشأڲصشتأۄەأۗأتًشأضهۏوتىأثىأزتازأتهزوطمۏأتهرًهتىۏأصۄشۏأڬەأ+أهمثأڬەأ"
"1448","%أذعشحأثۄصأثىأذڬۏوأشعۏأتههۄأؼىۄأتځىەأًتهزأضەأًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأوۏڽأىەأشضًهأتههۄأ﷽أڬًألشوتحەأضىتأۄەأرًزشًأڲہتضأډشىەأًتهەأۄشأډتهۏضأتًىټًڽأوۏڽأتًىټىۏأڬتأتۏڬأزًأضتهۄأثډۄأۄەأۗأڬًةۏأتًىټأتىأڬەأذضتثأضەأتهڲأىۄأڬۏتأدتةەأۗأدًأطرظأۏۄأظزمۄأزەأڲتأ؏أتضأڬەأهۏەأتدشأۄەأتًشأدًأطرظأتضأڬًأشًڬەأڲتأحًأۄوأتضأضەأ+أصثشزضحۏأ"
