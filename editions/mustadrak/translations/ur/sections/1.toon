"1623","%أذعشحأصۏزأثىأًۄثألشوتحەأۄۏڽأ=أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أدثأحۏىأإزوۏأۄًڽأحًأًۄأتىأوۏڽأضەأڬضۏأتۏڬأڬًأتوۏشأثىتأهۏڽأحًأًۄأتوۏشأۄًأڲتأ؏أتضأڬًأشضًهأتههۄأ﷽أىەأتوۏشأثىتۏتأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1624","%أذعشحأتثًهتضأرصتؼۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأۄوۏڽأذدأڬەأهۏەأحۏتشأڬۏەأڲةەأظزمەأڬەأتًىټًڽأځشأضًتشأۄًىەأڬتألشوتۏتأ؏أۄوأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أڬۏتأًتمؼۏأۄوأتىأځشأضًتشأۄًڽأڲەأآأإځأ﷽أىەألشوتۏتأ=أۄشأتًىټأڬۏأڬًۄتىأځشأطۏغتىأۄًحتأۄەأ؏أتضأهۏەأدثأحوأتىأځشأضًتشأۄًىەأهڲًأحًأتههۄأڬتأىتوأځڔہأهۏتأڬشًأدۏضتأڬۄأتههۄأىەأحوأڬًأذڬوأزۏتأۄەأځہشأتىأڬًأتځىەأهۏەأحۏتشأڬشأهًأحًأتههۄأحوۄۏڽأضًتشأڬشًتأزەأڲتأۗأ"
"أٰۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأتًشأتۏڬأظذۏذأذزۏخأتضأڬۏأطتۄزأثہۏأۄەأ+أدًأڬۄأزشدأسۏهأۄەأ","أۗ%أ"
"1625","أذعشحأوؼتسأثىأتىضأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتىأډًځتۏًڽأځشأتذحۏتغأڬەأضتحہأضًتشأۄًتأڬشًأتًشأتذحۏتغأڬەأضتحہأتىأڬًأډہًڔتأڬشًأتًشأتىأڬًأڬشضۏتڽأوحأثىتاأۗأ"
"1626","%أذعشحأوذوزأثىأذوصۄأثىأؼوشًأتضهوۏأتځىەأًتهزأڬتأثۏتىأىمهأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أۄشأتًىټأڬۏأځۏټہأځشأتۏڬأطۏغتىأۄًحتأۄەأتضأهۏەأدثأتىأځشأضًتشۏأڬشًأحًأتههۄأڬتأىتوأځڔہأهۏتأڬشًأتًشأتځىۏأذتدحأضەأڬًحتۄۏأوحأڬشًأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأتًشأتۏڬأذزۏخأتضأڬۏأطتۄزأثہۏأۄەأدًأڬۄأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأځشأۄەأۗ%أ",""
"1627","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أۄشأتًىټأڬۏأڬًۄتىأځشأتۏڬأطۏغتىأۄًحتأۄەأ؏أتىأڬًأضًتشۏأوۏڽأتضحؼوتهأڬۏتأڬشًأ؏أثەأطڬأتههۄأحؼتهۏٳأوززأڬشحتأۄەأۗأ"
"1628","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأوطڬۏصەأوىۄأهڲتأڬشأځتىۏأځۏىەأضەأوىؼأڬۏتأۄەأۗأتًشأدهتهۄأ+أًۄأدتىًشأدًأذهتهأًأذشتوأډۏصۏڽأڬہتحتأۄەأ"
"أٰٰأۏۄأذزۏخأظذۏذأۄەأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأؼڬضشأضشڬۏأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأذوتزأثىأضهوۄأڬۏأشًتۏتحأىمهأڬۏأۄەأۗ%أ",""
"1629","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أڲہىټۏأطۏغتىأڬتأثتدتأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1630","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أشتحأڬەأًمحأضلشأڬۏتأڬشًأڬۏًىڬۄأشتحأڬەأًمحأوضتلشأڬەأهۏەأصوۏىأهځۏټأزۏأدتحۏأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1632","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدثأهًڲأضًأشۄەأۄًڽأ؏أتضأًمحأثتۄشأوحأىڬهتأڬشًأڬۏًىڬۄأتههۄأحؼتهۏٳأشتحأڬەأًمحأدحىۏأډتۄحتأۄەأتځىۏأورهًمتحأڬًأځہۏهتحتأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1633","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأتۏڬأطرظأشضًهأتههۄأ﷽أڬەأځتضأإۏتأ؏أًۄأضلشأڬتأتشتزۄأشڬہحتأحہتأ؏أتضأىەأڬۄتأ=أۏتأشضًهأتههۄأ﷽أ$أودہەأڬًةۏأًظۏحألشوتةۏەأۗأإځأ﷽أىەألشوتۏتأ=أوۏڽأحوۄۏڽأًظۏحأڬشحتأۄًڽأڬۄأتههۄأضەأڋشحەأشۄًأتًشأثهىزۏأځشأډڔہحەأۄًةەأحڬثۏشأڬۄًأۗأدثأًۄأډهتأڲۏتأإځأ﷽أىەأتضأڬەأهۏەأۏًڽأزؼتأوتىڲۏأ=““أۏتتههۄأ$أتضأڬەأهۏەأصوۏىأهځۏټأزەأتًشأضلشأإضتىألشوتأۗأ‛‛أ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1634","%أذعشحأظۄۏثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أدثأڬضۏأثضحۏأوۏڽأزترهأۄًىتأډتۄحەأحًأدۏضەأۄۏأتضأځشأىػشأځڔحۏأحًأۏًڽأزؼتأوتىڲحەأ=““أ®تههٔٳہْؤأشثأتهضوتًتحأتهضثؼأًوتأتػههىأ؏أًشثٔأتهتشّعٓۏىأتهضّٔثؼٓأًوتأتمههىّأ؏أًشثأتهطۏتغۏىأًوتأتعههىأ؏أًشثٔأتهشۏتذأًوتأسشۏٕىّأ؏ألّتٓىّٔتأىضتٗهڬأرۏشأہسۄأتهمشۏۆأًرۏشأتہهہتأ؏أًىؼًسثڬأوىأطشٓٔہتأًطشٓٔأتّہهٓہتأ؏أًطشٓٔأوّتلۏہت¾أۗ““أتەأتههۄأ$أتەأضتحًڽأإضوتىًڽأتًشأضتحًڽأصوۏىًڽأڬەأشثأ$أتًشأًۄأصوۏىۏڽأڬوأىۄأۄًڽأڲۏأ؏أتًشأتەأطۏغتىًڽأڬەأشثأ$أتًشأًۄأطۏغتىأڲوشتۄأىۄأڬشأضڬۏڽأڲەأتًشأتەأإىزہۏًڽأڬەأشثأ$أتًشأتىزہۏشۏتڽأحثتۄۏأىۄأڬشأضڬۏڽأڲۏأ؏أۄوأحدہأضەأتضأثضحۏأڬۏأتًشأثضحۏأًتهًڽأڬۏأرۏشۏحأوتىڲحەأۄۏڽأۗأتًشأتضأثضحۏأڬەأطشأ؏أتضأڬەأشۄىەأًتهًڽأڬەأطشأتًشأدًأڬډہأتضأوۏڽأۄەأ؏أتضأحوتوأڬەأطشأضەأحۏشۏأځىتۄأوتىڲحەأۄۏڽأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1635","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أدۄتڽأثہۏأمۏتوأڬشحەأ؏أًۄتڽأضەأشرظحأۄًىەأضەأځۄهەأزًأشڬؼحأىًتلهأتزتأڬشحەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1636","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬضۏأضلشأوۏڽأۄًحەأتًشألدشأڬتأًمحأۄًحتأ؏أحًأإځألشوتحەأ=أضىىەأًتهەأىەأتههۄأڬۏأذوزأتًشأتضأڬۏأىؼوحأضىۏأۄەأتًشأتەأتههۄأ$أۄوأځشأتځىتألعهألشوتأ؏أدۄىوأضەأتههۄأڬۏأځىتۄأوتىڲحەأۄًةەأ؏أإځأحۏىأوشحثۄأثهىزأإًتصأضەأۏۄأڬهوتحأزۄشتحەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1637","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أدثأڬضۏأؽصًۄأۏتأڬضۏأضلشأوۏڽأۄًحەأتًشأشتحأۄًأدتحۏأحًأإځألشوتحەأ““أتەأصوۏىأ$أحۏشتأتًشأوۏشتأشثأتههۄأۄەأ؏أوۏڽأتههۄأڬۏأځىتۄأوتىڲحتأۄًڽأ؏أۄشأطۏشأتًشأڬتهەأڬەأطشأضەأتًشأضتىځأتًشأثډہًأتًشأتضأطۄشأڬەأثتضۏًڽأڬەأطشأضەأتًشأځۏزتأڬشىەأًتهەأتًشأځۏزتأۄًىەأًتهەأڬەأطشأضەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1638","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأؽضهأڬۏتأ؏أځہشأڬځڔەأځۄىەأځہشأدثأإځأسًتهذهۏلۄأځۄىډەأحًأزًأشڬؼحۏڽأتزتأڬۏڽأځہشأإځأ﷽أتځىەأتًىټأځشأثۏټہأڲةەأځہشأدثأإځأومتوٓأثۏزتؤأوۏڽأځۄىډأڲةەأحًأذدأڬتأتذشتوأثتىزہتأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأۏؼمًثأثىأؼغتأثىأتثۏأشثتذأڬۏأتذتزۏخأتّةوۄأتضهتوأدوؼأڬشحەأۄۏڽأۗأتًشأتضأذزۏخأڬۏأتۏڬأطتۄزأثہۏأۄەأدًأڬۄأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأڬەأوؼۏتشأځشأظذۏذأۄەأۗأ+أًۄأذزۏخأزشدأسۏهأۄەأ","أۗ%أ"
"1801","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأڬًةۏأډۏصأزؼتأضەأصۏتزۄأؼصۏصأىۄۏڽأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتځىۏأڬحتثأوۏڽأؼوشتىأتهمغتىأڬۏأشًتۏتحأىمهأىۄۏڽأڬۏأۄۏڽأۗأذتهتىڬۄأًۄأتځىۏأشًتۏحأوۏڽأظزًمأۄۏڽأۗأدثڬۄأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأ““أدتوؼأظذۏذأ‛‛أوۏڽأتىأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأتًشأدًأشًتۏتحأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأضەأڬحتثأتهزؼًتحأوۏڽأسڬشأڬشىەأضەأشۄأڲةۏأۄۏڽأ؏أتىأڬًأمثًهأڬشىەأوۏڽأتثًضؼۏزأؼثزتهشذوىأثىأوۄزۏأڬەأوسۄثأځشأډهحەأۄًةەأوۏڽأثۏتىأڬشًڽأڲتأۗأتىأطتؤأتههۄأحؼتهۏٳأۗأڬۏًىڬۄأودہەأتثًصڬشۏتأۏذۏۏأثىأوذوزأتهؼىثشۏأىەأثحتۏتأۄەأڬۄأوۏڽأىەأتثًتهذضىأوذوزأثىأتضذتمأثىأتثشتۄۏوأتهذىػهۏأڬًألشوتحەأۄًةەأضىتأۄەأڬۄأوۏشەأًتهزأ؏أؼثزتهشذوىأثىأوۄزۏأڬەأذًتهەأضەأذهتهأًأذشتوأتذڬتوأڬەأوحؼهمأتذتزۏخأشًتۏحأڬشحەأۄۏڽأحًأتىأڬۏأثۄحأطزۏزأډہتىأثۏىأڬشحەأۄۏڽأتًشأتضأڬەأشتًۏًڽأځشأثۄحأصۏتزۄأدشذأًأمزذأڬشحەأۄۏڽأهۏڬىأدثأتؼوتهأڬەألعتةهأ؏أخًتثأ؏أؼمتثأ؏أوثتذتحأتًشأزؼتاڽأڬەأوحؼهمأتذتزۏخأىمهأڬشحەأۄۏڽأحًأضىزأڬەأذًتهەأضەأتحىۏأصۏتزۄأضرحۏأىۄۏڽأڬشحەأۄۏڽأۗ%أ",""
