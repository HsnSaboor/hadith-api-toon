hadiths[33]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2872","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو، عَنْ أَبِي سَلَمَةَ، عَنْ أَبِي هُرَيْرَةَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ فِي الْجَنَّةِ شَجَرَةً يَسِيرُ الرَّاكِبُ فِي ظِلِّهَا مِائَةَ عَامٍ لَا يَقْطَعُهَا، وَاقْرَءُوا إِنْ شِئْتُمْ: وَظِلٍّ مَمْدُودٍ سورة الواقعة آية 30"".""","Hasan","Sunan al-Darimi 2872","","","113. جنت کے درختوں کا بیان"
"2873","(حديث مرفوع) أَخْبَرَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ، حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي الضَّحَّاكِ، قَالَ: سَمِعْتُ أَبَا هُرَيْرَةَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: إِنَّ فِي الْجَنَّةِ شَجَرَةً يَسِيرُ الرَّاكِبُ فِي ظِلِّهَا مِائَةَ عَامٍ لَا يَقْطَعُهَا، هِيَ شَجَرَةُ الْخُلْدِ"".""","Sahih","Sunan al-Darimi 2873","","","113. جنت کے درختوں کا بیان"
"2874","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَخْبَرَنَا عَبَّادٌ هُوَ: ابْنُ مَنْصُورٍ، قَالَ: سَمِعْتُ شَهْرَ بْنَ حَوْشَبٍ، يَقُولُ: سَمِعْتُ أَبَا هُرَيْرَةَ، يَقُولُ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: الْعَجْوَةُ مِنَ الْجَنَّةِ، وَهِيَ شِفَاءٌ مِنَ السُّمِّ"".""","Sahih","Sunan al-Darimi 2874","","","114. عجوہ کہجور کا بیان"
"2875","(حديث مرفوع) أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَخْبَرَنَا حُمَيْدٌ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ:إِنَّ فِي الْجَنَّةِ لَسُوقًا"". قَالُوا: وَمَا هِيَ، قَالَ: ""كُثْبَانٌ مِنْ مِسْكٍ يَخْرُجُونَ إِلَيْهَا فَيَجْتَمِعُونَ فِيهَا، فَيَبْعَثُ اللَّهُ عَلَيْهِمْ رِيحًا فَتُدْخِلُهُمْ بُيُوتَهُمْ، فَيَقُولُ لَهُمْ أَهْلُوهُمْ: لَقَدْ ازْدَدْتُمْ بَعْدَنَا حُسْنًا، وَيَقُولُونَ لِأَهْلِيهِمْ مِثْلَ ذَلِكَ"".""","Sahih","Sunan al-Darimi 2875","","","115. جنت کے بازار کا بیان"
"2876","(حديث مرفوع) حَدَّثَنَا سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ، عَنْ حَمَّادِ بْنِ سَلَمَةَ، عَنْ ثَابِتٍ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ.","Sahih","Sunan al-Darimi 2876","","","115. جنت کے بازار کا بیان"
"2877","(حديث مرفوع) أَخْبَرَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ ثَابِتٍ، عَنْ أَنَسٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: حُفَّتْ الْجَنَّةُ بِالْمَكَارِهِ، وَحُفَّتْ النَّارُ بِالشَّهَوَاتِ"".""","Sahih","Sunan al-Darimi 2877","","","116. جنت تکالیف کے ساتھ گھیر دی گئی ہے"
"2878","(حديث مرفوع) حَدَّثَنَا عَبْدُ اللَّهِ بْنُ صَالِحٍ، قَالَ: حَدَّثَنِي مُعَاوِيَةُ: أَنَّ عَبْدَ الرَّحْمَنِ بْنَ جُبَيْرٍ حَدَّثَهُ، عَنْ أَبِيهِ جُبَيْرِ بْنِ نُفَيْرٍ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو، قَالَ: بَيْنَا أَنَا قَاعِدٌ فِي الْمَسْجِدِ وَحَلْقَةٌ مِنْ فُقَرَاءِ الْمُهَاجِرِينَ قُعُودٌ إِذْ دَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَعَدَ إِلَيْهِمْ، فَقُمْتُ إِلَيْهِمْ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَهُمْ: لِيُبْشِرْ فُقَرَاءُ الْمُهَاجِرِينَ بِمَا يَسُرُّ وُجُوهَهُمْ، فَإِنَّهُمْ يَدْخُلُونَ الْجَنَّةَ قَبْلَ الْأَغْنِيَاءِ بِأَرْبَعِينَ عَامًا"". قَالَ: فَلَقَدْ رَأَيْتُ أَلْوَانَهُمْ أَسْفَرَتْ، قَالَ عَبْدُ اللَّهِ بْنُ عَمْرٍو: حَتَّى تَمَنَّيْتُ أَنْ أَكُونَ مَعَهُمْ.""","Da'if","Sunan al-Darimi 2878","","","117. جنت میں فقراء کے اغنیاء سے پہلے داخل ہونے کا بیان"
"2879","(حديث مرفوع) أَخْبَرَنَا الْحَكَمُ بْنُ نَافِعٍ، أَخْبَرَنَا شُعَيْبٌ، عَنْ الزُّهْرِيِّ، قَالَ: أَخْبَرَنِي أَبُو سَلَمَةَ، عَنْ أَبِي هُرَيْرَةَ: أَنَّهُ سَمِعَهُ يَقُولُ: قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: اشْتَكَتِ النَّارُ إِلَى رَبِّهَا، فَقَالَتْ: يَا رَبِّ أَكَلَ بَعْضِي بَعْضًا، فَأَذِنَ اللَّهُ لَهَا بِنَفَسَيْنِ: نَفَسٍ فِي الشِّتَاءِ، وَنَفَسٍ فِي الصَّيْفِ، فَهُوَ أَشَدُّ مَا تَجِدُونَ مِنَ الْحَرِّ، وَأَشَدُّ مَا تَجِدُونَ مِنَ الزَّمْهَرِيرِ"".""","Sahih","Sunan al-Darimi 2879","","","118. جہنم کے سانس لینے کا بیان"
"2880","(حديث مرفوع) أَخْبَرَنَا حَجَّاجٌ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ عَاصِمِ بْنِ بَهْدَلَةَ، عَنْ أَبِي صَالِحٍ، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ.","Hasan","Sunan al-Darimi 2880","","","118. جہنم کے سانس لینے کا بیان"
"2881","(حديث مرفوع) أَخْبَرَنَا جَعْفَرُ بْنُ عَوْنٍ، أَخْبَرَنَا الْهَجَرِيُّ، عَنْ أَبِي عِيَاضٍ، عَنْ أَبِي هُرَيْرَةَ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: إِنَّ نَارَكُمْ هَذِهِ جُزْءٌ مِنْ سَبْعِينَ جُزْءًا مِنْ نَارِ جَهَنَّمَ"".""","Da'if","Sunan al-Darimi 2881","","","119. نبی کریم صلی اللہ علیہ وسلم کا فرمان: ”تمہاری یہ آگ جہنم کی آگ کا معمولی جزء ہے“"
"2882","(حديث مرفوع) أَخْبَرَنَا أَبُو عَاصِمٍ، عَنْ ابْنِ عَجْلَانَ، عَنْ أَبِيه، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: أَهْوَنُ النَّاسِ عَذَابًا مَنْ لَهُ نَعْلَانِ يَغْلِي مِنْهُمَا دِمَاغُهُ"".""","Hasan","Sunan al-Darimi 2882","","","120. جہنمیوں میں سے جس کو سب سے کم عذاب ہو گا"
"2883","(حديث مرفوع) أَخْبَرَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ عَمَّارِ بْنِ أَبِي عَمَّارٍ، عَنْ أَبِي هُرَيْرَةَ: أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: يُلْقَى فِي النَّارِ أَهْلُهَا، وَتَقُولُ: هَلْ مِنْ مَزِيدٍ هَلْ مِنْ مَزِيدٍ ثَلَاثًا، حَتَّى يَأْتِيَهَا رَبُّهَا تَعَالَى فَيَضَعَ قَدَمَهُ عَلَيْهَا فَتُزْوَى وَتَقُولُ: قَطْ قَطْ قَطْ"".""","Sahih","Sunan al-Darimi 2883","","","121. فرمان الٰہی: «هَلْ مِنْ مَزِيْدٍ» کا بیان"
"2884","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا عَاصِمٌ، عَنْ مُوَرِّقٍ الْعِجْلِيِّ، قَالَ: قَالَ عُمَرُ بْنُ الْخَطَّابِ: تَعَلَّمُوا الْفَرَائِضَ وَاللَّحْنَ وَالسُّنَنَ كَمَا تَعَلَّمُونَ الْقُرْآنَ"".""","Sahih","Sunan al-Darimi 2884","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2885","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عُمَرُ: تَعَلَّمُوا الْفَرَائِضَ فَإِنَّهَا مِنْ دِينِكُمْ"".""","","Sunan al-Darimi 2885","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2886","(حديث مقطوع) حَدَّثَنَا مُحَمَّدُ بْنُ عِيسَى، حَدَّثَنَا يُوسُفُ الْمَاجِشُونُ، قَالَ: قَالَ ابْنُ شِهَابٍ: لَوْ هَلَكَ عُثْمَانُ، وَزَيْدٌ فِي بَعْضِ الزَّمَانِ، لَهَلَكَ عِلْمُ الْفَرَائِضِ، لَقَدْ أَتَى عَلَى النَّاسِ زَمَانٌ، وَمَا يَعْلَمُهَا غَيْرُهُمَا"".""","Sahih","Sunan al-Darimi 2886","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2887","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا الْمَسْعُودِيُّ، عَنْ الْقَاسِمِ، قَالَ: قَالَ عَبْدُ اللَّهِ: تَعَلَّمُوا الْقُرْآنَ وَالْفَرَائِضَ، فَإِنَّهُ يُوشِكُ أَنْ يَفْتَقِرَ الرَّجُلُ إِلَى عِلْمٍ كَانَ يَعْلَمُهُ، أَوْ يَبْقَى فِي قَوْمٍ لَا يَعْلَمُونَ.""","Sahih","Sunan al-Darimi 2887","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2888","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا زِيَادُ بْنُ أَبِي مُسْلِمٍ، عَنْ أَبِي الْخَلِيلِ، قَالَ: قَالَ أَبُو مُوسَى: مَنْ عَلِمَ الْقُرْآنَ وَلَمْ يَعْلَمْ الْفَرَائِضَ، فَإِنَّ مَثَلَهُ مَثَلُ الْبُرْنُسِ لَا وَجْهَ لَهُ، أَوْ: لَيْسَ لَهُ وَجْهٌ"".""","Da'if","Sunan al-Darimi 2888","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2889","(حديث مقطوع) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا أَبُو شِهَابٍ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَال: قُلْتُ لِعَلْقَمَةَ: مَا أَدْرِي مَا أَسْأَلُكَ عَنْهُ؟ قَالَ: أَمِتْ جِيرَانَكَ"".""","Sahih","Sunan al-Darimi 2889","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2890","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا مُحَمَّدُ بْنُ طَلْحَةَ، عَنْ الْقَاسِمِ بْنِ الْوَلِيدِ الْهَمْدَانِيِّ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ، قَالَ: تَعَلَّمُوا الْفَرَائِضَ، وَالطَّلاقَ، وَالْحَجَّ، فَإِنَّهُ مِنْ دِينِكُمْ"".""","Da'if","Sunan al-Darimi 2890","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2891","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ كَثِيرٍ، عَنْ الْحَسَنِ، قَالَ: كَانُوا يُرَغِّبُونَ فِي تَعْلِيمِ الْقُرْآنِ وَالْفَرَائِضِ وَالْمَنَاسِكِ"".""","Hasan","Sunan al-Darimi 2891","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2892","(حديث موقوف) أَخْبَرَنَا مُحَمَّدُ بْنُ يُوسُفَ، عَنْ سُفْيَانَ، عَنْ أَبِي إِسْحَاق، عَنْ أَبِي عُبَيْدَةَ، عَنْ عَبْدِ اللَّهِ، قَالَ: مَنْ قَرَأَ الْقُرْآنَ، فَلْيَتَعَلَّمْ الْفَرَائِضَ، فَإِنْ لَقِيَهُ أَعْرَابِيٌّ، قَالَ: يَا مُهَاجِرُ، أَتَقْرَأُ الْقُرْآنَ؟ فَإِنْ قَالَ: نَعَمْ، قَالَ: تَفْرِضُ؟ فَإِنْ قَالَ: نَعَمْ، فَهُوَ زِيَادَةٌ وَخَيْر، وَإِنْ قَالَ: لَا، قَالَ: فَمَا فَضْلُكَ عَلَيَّ يَا مُهَاجِرُ؟!.""","","Sunan al-Darimi 2892","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2893","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ، حَدَّثَنَا عُقْبَةُ بْنُ خَالِدٍ، عَنْ الْأَعْمَشِ، عَنْ مُسْلِمٍ، قَالَ: سَأَلْنَا مَسْرُوقًا: كَانَتْ عَائِشَةُ تُحْسِنُ الْفَرَائِضَ؟ قَالَ: وَالَّذِي لَا إِلَهَ غَيْرُهُ، لَقَدْ رَأَيْتُ الْأَكَابِرَ مِنْ أَصْحَابِ مُحَمَّدٍ يَسْأَلُونَهَا عَنْ الْفَرَائِضِ"".""","Sahih","Sunan al-Darimi 2893","","","1. فرائض کی تعلیم حاصل کرنے کا بیان"
"2894","(حديث مرفوع) أَخْبَرَنَا سَعِيدُ بْنُ عَامِرٍ، عَنْ شُعْبَةَ، عَنْ عَاصِمٍ، عَنْ أَبِي عُثْمَانَ، عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ، وَعَنْ أَبِي بَكْرَةَ قَالَ شُعْبَةُ: هَذَا أَوَّلُ مَنْ رَمَى بِسَهْمٍ فِي سَبِيلِ اللَّهِ، وَهَذَا تَدَلَّى مِنْ حِصْنِ الطَّائِفِ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّم إِنَّهُمَا حَدَّثَا: أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، قَالَ: مَنْ ادَّعَى إِلَى غَيْرِ أَبِيهِ وَهُوَ يَعْلَمُ أَنَّهُ غَيْرُ أَبِيهِ، فَالْجَنَّةُ عَلَيْهِ حَرَامٌ"".""","Sahih","Sunan al-Darimi 2894","","","2. حقیقی باپ کے بجائے کسی غیر کو باپ بنانا"
"2895","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ الْأَعْمَشِ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ، عَنْ أَبِي مَعْمَرٍ، عَنْ أَبِي بَكْرٍ الصِّدِّيقِ، قَالَ: كُفْرٌ بِاللَّهِ ادِّعَاءٌ إِلَى نَسَبٍ لَا يُعْرَفُ، وَكُفْرٌ بِاللَّهِ تَبَرُّؤٌ مِنْ نَسَبٍ وَإِنْ دَقَّ.""","Sahih","Sunan al-Darimi 2895","","","2. حقیقی باپ کے بجائے کسی غیر کو باپ بنانا"
"2896","(حديث موقوف) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا سُفْيَانُ، عَنْ زَكَرِيَّا أَبِي يَحْيَى، قَالَ: سَمِعْتُ أَبَا وَائِلٍ يُحَدِّثُ، عَنْ ابْنِ مَسْعُودٍ، نَحْوًا مِنْهُ.","Sahih","Sunan al-Darimi 2896","","","2. حقیقی باپ کے بجائے کسی غیر کو باپ بنانا"
"2897","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلَاءِ، حَدَّثَنَا إِسْحَاق بْنُ مَنْصُورٍ السَّلُولِيُّ، عَنْ جَعْفَرٍ الْأَحْمَرِ، عَنْ السَّرِيِّ بْنِ إِسْمَاعِيل، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ، قَالَ: أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِأُبَايِعَهُ، فَجِئْتُ وَقَدْ قُبِض، وَأَبُو بَكْرٍ قَائِمٌ فِي مَقَامِهِ، فَأَطَالَ الثَّنَاءَ وَأَكْثَرَ الْبُكَاءَ، فَقَالَ: سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، يَقُولُ: كُفْرٌ بِاللَّهِ انْتِفَاءٌ مِنْ نَسَبٍ وَإِنْ دَقَّ، وَادِّعَاءُ نَسَبٍ لَا يُعْرَفُ"".""","","Sunan al-Darimi 2897","","","2. حقیقی باپ کے بجائے کسی غیر کو باپ بنانا"
"2898","(حديث مرفوع) حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، حَدَّثَنَا عَبْدُ الْحَمِيدِ بْنُ بَهْرَامَ، عَنْ شَهْرِ بْنِ حَوْشَبٍ، عَنْ ابْنِ عَبَّاسٍ، قَالَ: قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَيُّمَا رَجُلٍ ادَّعَى إِلَى غَيْرِ وَالِدِه، أَوْ تَوَلَّى غَيْرَ مَوَالِيهِ الَّذِينَ أَعْتَقُوهُ، فَإِنَّ عَلَيْهِ لَعْنَةَ اللَّه، وَالْمَلائِكَةِ، وَالنَّاسِ أَجْمَعِينَ إِلَى يَوْمِ الْقِيَامَة، لا يُقْبَلُ مِنْهُ صَرْفٌ وَلَا عَدْلٌ.""","Hasan","Sunan al-Darimi 2898","","","2. حقیقی باپ کے بجائے کسی غیر کو باپ بنانا"
"2899","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، أَنْبَأَنَا شَرِيكٌ، عَنْ الْأَعْمَشِ، عَنْ إِبْرَاهِيمَ، قَالَ: قَالَ عَبْدُ اللَّهِ: كَانَ عُمَرُ إِذَا سَلَكَ بِنَا طَرِيقًا وَجَدْنَاهُ سَهْلًا، وَإِنَّهُ قَالَ فِي زَوْجٍ وَأَبَوَيْنِ: لِلزَّوْجِ النِّصْفُ، وَلِلْأُمِّ ثُلُثُ مَا بَقِيَ.""","Da'if","Sunan al-Darimi 2899","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2900","(حديث موقوف) أَخْبَرَنَا أَخْبَرَنَا يَزِيدُ بْنُ هَارُونَ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا يَزِيدُ الرِّشْكُ، قَالَ: سَأَلْتُ سَعِيدَ بْنَ الْمُسَيِّبِ عَنْ رَجُلٍ تَرَكَ امْرَأَتَهُ، وَأَبَوَيْهِ، فَقَالَ: قَسَّمَهَا زَيْدُ بْنُ ثَابِتٍ مِنْ أَرْبَعَةٍ"".""","Sahih","Sunan al-Darimi 2900","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2901","(حديث موقوف) حَدَّثَنَا حَدَّثَنَا سَعِيدُ بْنُ عَامِرٍ، عَنْ شُعْبَةَ، عَنْ أَيُّوبَ، عَنْ أَبِي قِلَابَةَ، عَنْ أَبِي الْمُهَلَّبِ: أَنَّ عُثْمَانَ بْنَ عَفَّانَ قَالَ فِي امْرَأَةٍ وَأَبَوَيْنِ: لِلْمَرْأَةِ الرُّبُعُ، وَلِلْأُمِّ ثُلُثُ مَا بَقِيَ"".""","Sahih","Sunan al-Darimi 2901","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2902","(حديث موقوف) حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ، عَنْ أَيُّوبَ، عَنْ أَبِي قِلَابَةَ، عَنْ أَبِي الْمُهَلَّبِ، عَنْ عُثْمَانَ بْنِ عَفَّانَ أَنَّهُ قَالَ: لِلْمَرْأَةِ الرُّبُعُ سَهْمٌ مِنْ أَرْبَعَةٍ، وَلِلْأُمِّ ثُلُثُ مَا بَقِيَ سَهْم، وَلِلأَبِّ سَهْمَانِ"".""","Sahih","Sunan al-Darimi 2902","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2903","(حديث موقوف) أَخْبَرَنَا حَجَّاجٌ، حَدَّثَنَا حَمَّادٌ، عَنْ حَجَّاجٍ، عَنْ عُمَيْرِ بْنِ سَعِيدٍ: أَنَّهُ سَأَلَ الْحَارِثَ الْأَعْوَرَ عَنْ امْرَأَةٍ، وَأَبَوَيْنِ، فَقَالَ مِثْلَ قَوْلِ عُثْمَانَ.","Da'if","Sunan al-Darimi 2903","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
"2904","(حديث موقوف) حَدَّثَنَا أَبُو نُعَيْمٍ، حَدَّثَنَا هِشَامٌ، عَنْ قَتَادَةَ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ، عَنْ زَيْدِ بْنِ ثَابِتٍ، أَنَّهُ قَالَ فِي امْرَأَةٍ تَرَكَتْ زَوْجَهَا وَأَبَوَيْهَا: لِلزَّوْجِ النِّصْفُ، وَلِلْأُمِّ ثُلُثُ مَا بَقِيَ"".""","Sahih","Sunan al-Darimi 2904","","","3. شوہر کے ساتھ ماں باپ، اور بیوی کے ساتھ ماں باپ کے حصے کا بیان"
