"171","(۱۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حُمَیْدٍ ، قَالَ : رَأَیْتُ أَنَسًا تَوَضَّأَ ، فَجَعَلَ یَمْسَحُ ظَاہِرَ أُذُنَیْہِ وَبَاطِنَہُمَا ، فَنَظَرْتُ إلَیْہِ ، فَقَالَ : إنَّ ابْنَ مَسْعُودٍ کَانَ یَأْمُرُ بِذَلِکَ۔",": Hasan","Musannaf Ibn Abi Shaybah 171","","","كتاب الطهارة"
"172","(۱۷۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ أُذُنَیْہِ ، دَاخِلَہُمَا بِالسِّبَابَتَیْنِ ، وَخَالَفَ بِإِبْہَامَیْہِ إلَی ظَاہِرِ أُذُنَیْہِ فَمَسَحَ بَاطِنَہُمَا وَظَاہِرَہُمَا۔",": Hasan","Musannaf Ibn Abi Shaybah 172","","","كتاب الطهارة"
"173","(۱۷۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا تَوَضَّأَ أَدْخَلَ الإِصْبُعَیْنِ اللَّتَیْنِ تَلِیَانِ الإِبْہَامَیْنِ فِی أُذُنَیْہِ ، فَمَسَحَ بَاطِنَہُمَا وَخَالَفَ بِالإِبْہَامَیْنِ إلَی ظَاہِرِہِمَا۔\n(عبدالرزاق ۲۹)",": Sahih","Musannaf Ibn Abi Shaybah 173","","","كتاب الطهارة"
"174","(۱۷۴) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ ، عَنِ الْہَیْثُمِّ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، وَإِبْرَاہِیمَ ، أَنَّہُمَا قَالاَ فِی الأُذُنَیْنِ: امْسَحْ ظَاہِرَہُمَا وَبَاطِنَہُمَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 174","","","كتاب الطهارة"
"175","(۱۷۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ عُثْمَانَ ، قَالَ : وَکَانَ مِنْ غِلْمَۃِ ابْنِ الزُّبَیْرِ ، قَالَ : وَضَّأْتُ ابْنَ عُمَرَ فَرَأَیْتُہُ یَمْسَحُ ظَاہِرَ أُذُنَیْہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 175","","","كتاب الطهارة"
"176","(۱۷۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَلْعٍ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ : کُنَّا مَعَ عَلِیٍّ یَوْمًا صَلاَۃَ الْغَدَاۃِ ، فَلَمَّا انْصَرَفَ دَعَا الْغُلاَمَ بِالطَّسْتِ فَتَوَضَّأَ ، ثُمَّ أَدْخَلَ إصْبَعَیْہِ فِی أُذُنَیْہِ ، ثُمَّ قَالَ لَنَا : ہَکَذَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ۔",": Hasan","Musannaf Ibn Abi Shaybah 176","","","كتاب الطهارة"
"177","(۱۷۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ ، حَدَّثَنَا دَاوُد بْنُ أَبِی الْفُرَاتِ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ تَوَضَّأَ فَأَدْخَلَ أُصْبَعَیْہِ فِی بَاطِنِ أُذُنَیْہِ وَظَاہِرِہِمَا ، فَمَسَحَہُمَا۔",": Hasan","Musannaf Ibn Abi Shaybah 177","","","كتاب الطهارة"
"178","(۱۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ عِکْرِمَۃَ یَمْسَحُ عَلَی رِجْلَیْہِ ، وَکَانَ یَقُولُ بِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 178","","","كتاب الطهارة"
"179","(۱۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ إنَّمَا ہُوَ الْمَسْحُ عَلَی الْقَدَمَیْنِ ، وَکَانَ یَقُولُ : یَمْسَحُ ظَاہِرَہُمَا وَبَاطِنَہُمَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 179","","","كتاب الطهارة"
"180","(۱۸۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : غَسْلَتَانِ وَمَسْحَتَانِ۔ (عبدالرزاق ۵۵)",": No Data Available","Musannaf Ibn Abi Shaybah 180","","","كتاب الطهارة"
"181","(۱۸۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إنَّمَا ہُوَ الْمَسْحُ عَلَی الْقَدَمَیْنِ ، أَلاَ تَرَی أَنَّ مَا کَانَ عَلَیْہِ الْغَسْلُ جُعِلَ عَلَیْہِ التَّیَمُّمُ ، وَمَا کَانَ عَلَیْہِ الْمَسْحُ أُہْمِلَ ، فَلَمْ یُجْعَلْ عَلَیْہِ التَّیَمُّمُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 181","","","كتاب الطهارة"
"182","(۱۸۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، قَالَ : کَانَ أَنَسٌ إذَا مَسَحَ عَلَی قَدَمَیْہِ بَلَّہُمَا۔",": Da'if","Musannaf Ibn Abi Shaybah 182","","","كتاب الطهارة"
"183","(۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ خَیْرٍ ، عَنْ عَلِیٍّ ، قَالَ : لَوْ کَانَ الدِّینُ بِرَأْیٍ کَانَ بَاطِنُ الْقَدَمَیْنِ أَحَقَّ بِالْمَسْحِ مِنْ ظَاہِرِہِمَا ، وَلَکِنْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ ظَاہِرَہُمَا۔ (احمد ۱/۷۳۷)","","Musannaf Ibn Abi Shaybah 183","","","كتاب الطهارة"
"184","(۱۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ زُبَیْدٍ الْیَامِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : نَزَلَ جِبْرِیلُ بِالْمَسْحِ عَلَی الْقَدَمَیْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 184","","","كتاب الطهارة"
"185","(۱۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : نَزَلَ جِبْرِِیلُ بِالْمَسْحِ۔ (ابن جریر ۱۲۹)",": No Data Available","Musannaf Ibn Abi Shaybah 185","","","كتاب الطهارة"
"186","(۱۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُ الأَسْوَدَ : أَکَانَ عُمَرُ یَغْسِلُ قَدَمَیْہِ ؟ قَالَ : نَعَمْ ، کَانَ یَغْسِلُہُمَا غَسْلاً۔",": Da'if","Musannaf Ibn Abi Shaybah 186","","","كتاب الطهارة"
"187","(۱۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ؛ أَنَّ أَنَسًا کَانَ یَغْسِلُ قَدَمَیْہِ وَرِجْلَیْہِ حَتَّی یَسِیلَ الْمَائُ۔",": Sahih","Musannaf Ibn Abi Shaybah 187","","","كتاب الطهارة"
"188","(۱۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنِ ابْنِ غَرْبَائَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَأَی رَجُلاً غَسَلَ ظَاہِرَ قَدَمَیْہِ وَتَرَکَ بَاطِنَہُمَا فَقَالَ : لِمَ تَرَکْتَہُمَا لِلنَّارِ؟",": Da'if","Musannaf Ibn Abi Shaybah 188","","","كتاب الطهارة"
"189","(۱۸۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ قَاَلَ : اغْسِلِ الْقَدَمَیْنِ إلَی الْکَعْبَیْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 189","","","كتاب الطهارة"
"190","(۱۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِنْ کُنْتُ لأَسْکُبُ عَلَیْہِ الْمَائَ ، فَیَغْسِلُ رِجْلَیْہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 190","","","كتاب الطهارة"
"191","(۱۹۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ أَبِی الْجَحَّافِ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُہُ یَقُولُ : مَضَتِ السُّنَّۃُ مِنْ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمِینَ ، یَعْنِی بِغَسْلِ الْقَدَمَیْنِ۔","","Musannaf Ibn Abi Shaybah 191","","","كتاب الطهارة"
"192","(۱۹۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی حَیَّۃَ ، قَالَ : رَأَیْتُ عَلِیًّا تَوَضَّأَ فَغَسَلَ قَدَمَیْہِ إلَی الْکَعْبَیْنِ، وَقَالَ : أَرَدْتُ أَنْ أُرِیَکُمْ طُہُورَ نَبِیِّکُمْ صلی اللہ علیہ وسلم۔",": Hasan","Musannaf Ibn Abi Shaybah 192","","","كتاب الطهارة"
"193","(۱۹۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَرَأَ : { وَأَرْجُلَکُمْ } یَعْنِی : رَجَعَ الأَمْرُ إلَی الْغَسْلِ۔",": Sahih","Musannaf Ibn Abi Shaybah 193","","","كتاب الطهارة"
"194","(۱۹۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أنَّہُ کَانَ یَقْرَأُ : { فَاغْسِلُوا وُجُوہَکُمْ وَأَیْدِیَکُمْ إلَی الْمَرَافِقِ وَامْسَحُوا بِرُئُ وْسِکُمْ وَأَرْجُلَکُمْ } ، یَقُولُ : رَجَعَ الأَمْرُ إلَی الْغَسْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 194","","","كتاب الطهارة"
"195","(۱۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَادَ الأَمْرُ إلَی الْغَسْلِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 195","","","كتاب الطهارة"
"196","(۱۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : { فَاغْسِلُوا وُجُوہَکُمْ وَأَیْدِیَکُمْ } ، قَالَ : ذَاکَ الْغَسْلُ الدَّلْکُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 196","","","كتاب الطهارة"
"197","(۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَانَ یَغْسِلُ قَدَمَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 197","","","كتاب الطهارة"
"198","(۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ محمد بن عَقِیلٍ ، قَالَ : حدَّثَتْنِی الرُّبَیِّعُ ، قَالَتْ ، کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَأْتِینَا ، فَتَوَضَّأَ ، فَغَسَلَ رِجْلَیْہِ ثَلاَثًا۔",": Da'if","Musannaf Ibn Abi Shaybah 198","","","كتاب الطهارة"
"199","(۱۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ رَوْحِ بْنِ الْقَاسِمِ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنِ الرُّبَیِّعِ ابْنَۃِ مُعَوِّذِ بْنِ عَفْرَائَ ، قَالَتْ : أَتَانِی ابْنُ عَبَّاسٍ فَسَأَلَنِی عَنْ ہَذَا الْحَدِیثِ ، تَعْنِی حَدِیثَہَا الَّذِی ذَکَرَتْ ، أَنَّہَا رَأَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ ، وَأَنَّہُ غَسَلَ رِجْلَیْہِ ؟ قَالَتْ : فَقَالَ ابْنُ عَبَّاسٍ : أَبَی النَّاسُ إِلاَّ الْغَسْلَ ، وَلاَ أَجِدُ فِی کِتَابِ اللہِ إِلاَّ الْمَسْحَ۔ (احمد ۶/۳۵۸۔ حمیدی ۳۴۲)",": Da'if","Musannaf Ibn Abi Shaybah 199","","","كتاب الطهارة"
"200","(۲۰۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ مَحْمُودٍ ، قَالَ : رَأَی رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ رَجُلاً أَعْمَی یَتَوَضَّأُ ، فَغَسَلَ وَجْہَہُ وَیَدَیْہِ ، فَجَعَلَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : بَاطِنَ قَدَمَیْک، فَجَعَلَ یَغْسِلُ بَاطِنَ قَدَمَیْہِ۔ (عبدالرزاق ۷۷)",": Majhul","Musannaf Ibn Abi Shaybah 200","","","كتاب الطهارة"
"201","(۲۰۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : أَدْرَکْتَ أَحَدًا مِنْہُمْ یَمْسَحُ عَلَی الْقَدَمَیْنِ ؟ قَالَ : مُحْدَثٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 201","","","كتاب الطهارة"
"202","(۲۰۲) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ؛ کَانَ یَغْسِلُ قَدَمَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 202","","","كتاب الطهارة"
"203","(۲۰۳) حَدَّثَنَا إِسْحَاقِ الأَزْرَقُ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَمْسَحُ عَلَی الرَّأْسِ ثَلاَثًا ، یَأْخُذُ لِکُلِّ مَسْحَۃٍ مَائً عَلَی حِدَۃٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 203","","","كتاب الطهارة"
"204","(۲۰۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سَأَلْتُہُ ؟ فَقَالَ : کَانَ عَلِیُّ بْنُ أَبِی طَالِبٍ یَأْخُذُ لِرَأْسِہِ مَائً۔ قَالَ : وَسَأَلْتُ حَمَّادًا فَقَالَ : یَأْخُذُ لِرَأْسِہِ مَائً۔",": Da'if","Musannaf Ibn Abi Shaybah 204","","","كتاب الطهارة"
"205","(۲۰۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَرَی أَنْ یَأْخُذَ مَائً لِمَسْحِ رَأْسِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 205","","","كتاب الطهارة"
"206","(۲۰۶) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، قَالَ : رَأَیْتُ الْقَاسِمَ تَوَضَّأَ ، فَأَخَذَ لِرَأْسِہِ مَائً جَدِیدًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 206","","","كتاب الطهارة"
"207","(۲۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُجَدِّدُ لِمَسْحِ الرَّأْسِ الْمَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 207","","","كتاب الطهارة"
"208","(۲۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنِ ابْنِ عبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ غَرَفَ غَرْفَۃً ، فَمَسَحَ رَأْسَہُ وَأُذُنَیْہِ۔",": Hasan","Musannaf Ibn Abi Shaybah 208","","","كتاب الطهارة"
"209","(۲۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَأْخُذُ لِرَأْسِہِ مَائً جَدِیدًا۔",": Sahih","Musannaf Ibn Abi Shaybah 209","","","كتاب الطهارة"
"210","(۲۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ : خُذْ لِرَأْسِکَ مَائً جَدِیدًا۔",": Sahih","Musannaf Ibn Abi Shaybah 210","","","كتاب الطهارة"
"211","(۲۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرَ ، عَنْ وَاقِدٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ : خُذْ لِرَأْسِکَ مَائً جَدِیدًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 211","","","كتاب الطهارة"
"212","(۲۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، قَالَ : حدَّثَتْنِی الرُّبَیِّعُ بِنْتُ مُعَوِّذِ بْنِ عَفْرَائَ، قَالَتْ : أَتَانَا النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَتَوَضَّأَ ، وَمَسَحَ رَأْسَہُ بِمَا بَقِیَ مِنْ وَضُوئِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 212","","","كتاب الطهارة"
"213","(۲۱۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ۔ وَعَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُمَا کَانَا یَمْسَحَانِ رُؤُوسَہُمَا بِفَضْلِ أَیْدِیہِمَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 213","","","كتاب الطهارة"
"214","(۲۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ کَانَ یَمْسَحُ رَأْسَہُ بِفَضْلِ وَضُوئِہِ۔","","Musannaf Ibn Abi Shaybah 214","","","كتاب الطهارة"
"215","(۲۱۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ أَنْ یَمْسَحَ رَأْسَہُ وَفِی لِحْیَتِہِ بَلَلٌ ، فَذَکَرَ وَہُوَ فِی الصَّلاَۃِ ، فَإِنْ کَانَ فِی لِحْیَتِہِ بَلَلٌ فَلْیَمْسَحْ رَأْسَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 215","","","كتاب الطهارة"
"216","(۲۱۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إذَا نَسِیَ مَسْحَ رَأْسِہِ ، فَوَجَدَ فِی لِحْیَتِہِ بَلَلاً، أَجْزَأَہُ أَنْ یَمْسَحَ بِہِ رَأْسَہُ",": No Data Available","Musannaf Ibn Abi Shaybah 216","","","كتاب الطهارة"
"217","(۲۱۷) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ۔ وَعَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، مِثْلُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 217","","","كتاب الطهارة"
"218","(۲۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِہِ ؛ فِی الرَّجُلِ یَذْکُرُ فِی الصَّلاَۃِ أَنَّہُ لَمْ یَمْسَحْ رَأْسَہُ وَفِی لِحْیَتِہِ بَلَلٌ ، قَالَ : یَمْسَحُ رَأْسَہُ مِنْ بَلَلِ لِحْیَتِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 218","","","كتاب الطهارة"
"219","(۲۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، فِیمَا یَعْلَمُ حَمَّادٌ ، عَنْ عَلِیٍّ ، قَالَ: إذَا تَوَضَّأَ الرَّجُلُ فَنَسِیَ أَنْ یَمْسَحَ بِرَأْسِہِ فَوَجَدَ فِی لِحْیَتِہِ بَلَلاً ، أَخَذَ مِنْ لِحْیَتِہِ فَمَسَحَ رَأْسَہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 219","","","كتاب الطهارة"
"220","(۲۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، عَنْ کَعْبِ بْنِ عُجْرَۃَ ، عَنْ بِلاَلٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ عَلَی الْخُفَّیْنِ وَالْخِمَارِ۔ (طبرانی ۱۰۶۰۔ ابن خزیمۃ ۱۸۰)",": Sahih","Musannaf Ibn Abi Shaybah 220","","","كتاب الطهارة"
"221","(۲۲۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، وَابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُسَیْلَۃَ الصُّنَابِحِیِّ ، قَالَ : رَأَیْتُ أَبَا بَکْرٍ یَمْسَحُ عَلَی الْخِمَارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 221","","","كتاب الطهارة"
"222","(۲۲۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَشْعَثَ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا مُوسَی خَرَجَ مِنَ الْخَلاَئِ فَمَسَحَ عَلَی قَلَنْسُوَتِہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 222","","","كتاب الطهارة"
"223","(۲۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی غَالِبٍ ، قَالَ : رَأَیْتُ أَبَا أُمَامَۃَ یَمْسَحُ عَلَی الْعِمَامَۃِ۔",": Da'if","Musannaf Ibn Abi Shaybah 223","","","كتاب الطهارة"
"224","(۲۲۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنِ الْحَسَنِ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ؛ أَنَّہَا کَانَتْ تَمْسَحُ عَلَی الْخِمَارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 224","","","كتاب الطهارة"
"225","(۲۲۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، قَالَ : رَأَیْتُ أَنَسًا یَمْسَحُ عَلَی الْخُفَّیْنِ وَالْعِمَامَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 225","","","كتاب الطهارة"
"226","(۲۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : قَالَ عُمَرُ : إِنْ شِئْتَ فَامْسَحْ عَلَی الْعِمَامَۃِ ، وَإِنْ شِئْتَ فَانْزِعْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 226","","","كتاب الطهارة"
"227","(۲۲۷) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، عَنْ نُبَاتَۃَ ، قَالَ: سَأَلْتُ عُمَرَ بْنَ الْخَطَّابِ عَنِ الْمَسْحِ عَلَی الْعِمَامَۃِ ؟ قَالَ : إِنْ شِئْتَ فَامْسَحْ عَلَیْہَا ، وَإِنْ شِئْتَ فَلاَ۔",": Da'if","Musannaf Ibn Abi Shaybah 227","","","كتاب الطهارة"
"228","(۲۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ طَارِقٍ ، قَالَ : رَأَیْتُ حَکِیمَ بْنَ جَابِرٍ یَمْسَحُ عَلَی الْعِمَامَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 228","","","كتاب الطهارة"
"229","(۲۲۹) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ دَاوُدَ بْنِ أَبِی الْفُرَاتِ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ أَبِی شُرَیْحٍ ، عَنْ أَبِی مُسْلِمٍ مَوْلَی زَیْدِ بْنِ صُوحَانَ ، قَالَ : کُنْتُ مَعَ سَلْمَانَ فَرَأَی رَجُلاً یَنْزِعُ خُفَّیْہِ لِلْوُضُوئِ ، فَقَالَ لَہُ سَلْمَانُ : امْسَحْ عَلَی خُفَّیْک وَعَلَی خِمَارِکَ وَبِنَاصِیَتِکَ ، فَإِنِّی رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ عَلَی الْخُفَّیْنِ وَالْخِمَارِ۔ (احمد ۵/۴۳۹۔ ابن ماجہ ۵۶۳)",": No Data Available","Musannaf Ibn Abi Shaybah 229","","","كتاب الطهارة"
"230","(۲۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ بَکْرٍ ، عَنِ ابْنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ مُقَدَّمَ رَأْسِہِ ، وَمَسَحَ عَلَی الْعِمَامَۃِ۔ (مسلم ۸۳۔ ترمذی ۱۰۰)",": Sahih","Musannaf Ibn Abi Shaybah 230","","","كتاب الطهارة"
"231","(۲۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْییَ بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃ ، عَنْ جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَیَّۃَ الضَّمْرِیِّ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ عَلَی الْخُفَّیْنِ وَالْعِمَامَۃِ۔ (ابن ماجہ ۵۶۲۔ احمد ۴/۱۳۹)",": Hasan","Musannaf Ibn Abi Shaybah 231","","","كتاب الطهارة"
"232","(۲۳۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ مُحَمَّدِ بْنِ عَمَّارِ بْنِ یَاسِرٍ ، قَالَ : سَأَلْتُ جَابِرًا عَنِ الْمَسْحِ عَلَی الْعِمَامَۃِ ؟ فَقَالَ : أَمِسَّ الْمَائَ الشَّعْرَ۔",": Hasan","Musannaf Ibn Abi Shaybah 232","","","كتاب الطهارة"
"233","(۲۳۳) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ الرَّبِیعِ بْنِ سُلَیْمٍ ، عَنْ أَبِی لَبِیدٍ ، قَالَ : رَأَیْتُ عَلِیًّا أَتَی الْغَیْطَ عَلَی بَغْلَۃٍ لَہُ ، وَعَلَیْہِ إزَارٌ وَرِدَائٌ وَعِمَامَۃٌ وَخُفَّانِ ، فَرَأَیْتُہُ بَالَ ، ثُمَّ تَوَضَّأَ فَحَسَرَ الْعِمَامَۃَ ، فَرَأَیْتُ رَأْسَہُ مِثْلَ رَاحَتِی ، عَلَیْہِ مِثْلُ خَطِّ الأَصَابِعِ مِنَ الشَّعْرِ فَمَسَحَ بِرَأْسِہِ ، ثُمَّ مَسَحَ عَلَی خُفَّیْہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 233","","","كتاب الطهارة"
"234","(۲۳۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَمْسَحُ عَلَی الْعِمَامَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 234","","","كتاب الطهارة"
"235","(۲۳۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشِ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ إذَا کَانَتْ عَلَی إبْرَاہِیمَ عِمَامَۃٌ ، أَوْ قَلَنْسُوَۃٌ رَفَعَہَا ، ثُمَّ مَسَحَ عَلَی یَافُوخِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 235","","","كتاب الطهارة"
"236","(۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ تَوَضَّأَ فَحَسَرَ الْعِمَامَۃَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 236","","","كتاب الطهارة"
"237","(۲۳۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ مَالِکِ بْنِ أَنَسٍ، عَنْ ہِشَامٍ، عَنْ أَبِیہِ، أَنَّہُ کَانَ یَنْزِعُ الْعِمَامَۃَ وَیَمْسَحُ رَأْسَہُ بِالْمَائِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 237","","","كتاب الطهارة"
"238","(۲۳۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ فَرَفَعَ الْعِمَامَۃَ فَمَسَحَ مُقَدَّمَ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 238","","","كتاب الطهارة"
"239","(۲۳۹) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، قَالَ : کَانَ الْقَاسِمُ لاَ یَمْسَحُ عَلَی الْعِمَامَۃِ ، یَحْسِرُ عَنْ رَأْسِہِ فَیَمْسَحُ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 239","","","كتاب الطهارة"
"240","(۲۴۰) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الرَّجُلُ یَمْسَحُ عَلَی نَاصِیَتِہِ وَعَلَی عِمَامَتِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 240","","","كتاب الطهارة"
"241","(۲۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ عَمْرِو بْنِ وَہْبٍ الثَّقَفِیِّ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ فَمَسَحَ بِنَاصِیَتِہِ ، وَمَسَحَ عَلَی الْعِمَامَۃِ۔ (احمد ۴/۲۴۹۔ نسائی ۱۱۲)",": Sahih","Musannaf Ibn Abi Shaybah 241","","","كتاب الطهارة"
"242","(۲۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الْمَرْأَۃُ وَالرَّجُلُ فِی مَسْحِ الرَّأْسِ سَوَائٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 242","","","كتاب الطهارة"
"243","(۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ نَافِعٍ ، قَالَ : رَأَیْتُ صَفِیَّۃَ بِنْتَ أَبِی عُبَیْدٍ تَوَضَّأَتْ ، فَأَدْخَلَتْ یَدَیْہَا تَحْتَ خِمَارِہَا ، فَمَسَحَتْ بِنَاصِیَتِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 243","","","كتاب الطهارة"
"244","(۲۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : تُدْخِلُ الْمَرْأَۃُ یَدَیْہَا تَحْتَ خِمَارِہَا فَتَمْسَحُ بِنَاصِیَتِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 244","","","كتاب الطهارة"
"245","(۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، قَالَ : تَمْسَحُ عَارِضَیْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 245","","","كتاب الطهارة"
"246","(۲۴۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : تَمْسَحُ الْمَرْأَۃُ بِنَاصِیَتِہَا وَعَارِضَیْہَا ، إذَا کَانَتْ قَدْ مَسَحَتْ لِلصُّبْحِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 246","","","كتاب الطهارة"
"247","(۲۴۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ إذَا أَرَادَتْ أَنْ تَمْسَحَ رَأْسَہَا ، قَالَ : تُدْخِلُ یَدَیْہَا تَحْتَ الْخِمَارِ فَتَمْسَحُ مُقَدَّمَ رَأْسِہَا ، یُجْزِیُٔ عَنْہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 247","","","كتاب الطهارة"
"248","(۲۴۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ابْنَۃِ الْمُنْذِرِ ؛ أَنَّہَا کانَتْ تَمْسَحُ عَلَی الْعَارِضَیْنِ ، وَقَدْ کَانَتْ أَدْرَکَتْ أَزْوَاجَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 248","","","كتاب الطهارة"
"249","(۲۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَلْدَۃَ خَالِدِ بْنِ دِینَارٍ ؛ أَنَّ أَبَا الْعَالِیَۃِ سُئِلَ : کَیْفَ تَمْسَحُ الْمَرْأَۃُ رَأْسَہَا ؟ فَقَالَ لامْرَأَتِہِ : أَخْبِرِیہَا ، فَقَالَتْ : ہَکَذَا ، وَأَمَرَّتْ یَدَیْہَا عَلَی جَانِبِ رَأْسِہَا فَمَسَحَتْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 249","","","كتاب الطهارة"
"250","(۲۵۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنِ الْحَسَنِ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ؛ أَنَّہَا کَانَتْ تَمْسَحُ عَلَی الْخِمَارِ۔",": Da'if","Musannaf Ibn Abi Shaybah 250","","","كتاب الطهارة"
"251","(۲۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : سُئِلَ عَنِ الْمَرْأَۃِ تَمْسَحُ عَلَی خِمَارَہَا ؟ فَقَالَ : لاَ ، وَلَکِنْ تَمْسَحُ عَلَی رَأْسِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 251","","","كتاب الطهارة"
"252","(۲۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَوَضَّأَتِ الْمَرْأَۃُ فَلْتَنْزِعْ خِمَارَہَا وَلْتَمْسَحْ بِرَأْسِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 252","","","كتاب الطهارة"
"253","(۲۵۳) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الْمَرْأَۃُ تَمْسَحُ عَلَی نَاصِیَتِہَا وَعَلَی خِمَارِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 253","","","كتاب الطهارة"
"254","(۲۵۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : قَالَ حَمَّادٌ : تَنْزِعُ الْمَرْأَۃُ خِمَارَہَا عِنْدَ کُلِّ وُضُوئٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 254","","","كتاب الطهارة"
"255","(۲۵۵) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ؛ أَنَّ عُمَرَ کَانَ لَہُ قُمْقُمٌ یُسَخَّنُ لَہُ فِیہِ الْمَائُ۔",": Sahih","Musannaf Ibn Abi Shaybah 255","","","كتاب الطهارة"
"256","(۲۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ؛ أَنَّ عُمَرَ کَانَ لَہُ قُمْقُمٌ یُسَخَّنُ لَہُ فِیہِ الْمَائُ۔ (دار قطنی ۱)",": Da'if","Musannaf Ibn Abi Shaybah 256","","","كتاب الطهارة"
"257","(۲۵۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلْتُ نَافِعًا عَنِ الْمَائِ السُّخْنِ ؟ فَقَالَ : کَانَ ابْنُ عُمَرَ یَتَوَضَّأُ بِالْحَمِیمِ۔",": Sahih","Musannaf Ibn Abi Shaybah 257","","","كتاب الطهارة"
"258","(۲۵۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، قَالَ : یُتَطَہَّرُ بِمَائٍ یُطْبَخُ بِالنَّارِ ، وَإِذَا تَوَضَّأْتُ بِالْمَائِ السُّخْنِ مَزَجْتُہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 258","","","كتاب الطهارة"
"259","(۲۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو قَالَ : حَدَّثَنَا أَبُو سَلَمَۃَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : إنَّا نَدَّہِنُ بِالدُّہْنِ وَقَدْ طُبِخَ عَلَی النَّارِ ، وَنَتَوَضَّأُ بِالْحَمِیمِ وَقَدْ أُغْلِیَ عَلَی النَّارِ۔",": Hasan","Musannaf Ibn Abi Shaybah 259","","","كتاب الطهارة"
"260","(۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الْوُضُوئِ بِالْمَائِ السُّخْنِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 260","","","كتاب الطهارة"
"261","(۲۶۱) حَدَّثَنَا شَرِیکٌ ، عَنْ بَدْرٍ ، قَالَ : أَتَیْتُ أَبَا وَائِلٍ یَوْمَ جُمُعَۃٍ ، وَہُوَ یُسَخَّنُ لَہُ الْمَائُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 261","","","كتاب الطهارة"
"262","(۲۶۲) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ یَزِیدَ ، أَنَّ سَلَمَۃَ کَانَ یُسَخَّنُ لَہُ الْمَائُ فَیَتَوَضَّأُ بِہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 262","","","كتاب الطهارة"
"263","(۲۶۳) حَدَّثَنَا قَاسِمُ بْنُ مَالِکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْوُضُوئَ بِالْمَائِ السَُّخْنِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 263","","","كتاب الطهارة"
"264","(۲۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ أَبِی زَیْدٍ ، مَوْلَی عَمْرِو بْنِ حُرَیْثٍ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَالَ لَہُ لَیْلَۃَ الْجِنِّ : عِنْدَکَ طَہُورٌ ؟ قَالَ : لاَ ، إِلاَّ شَیْئٌ مِنْ نَبِیذٍ فِی إدَاوَۃٍ ، فَقَالَ: تَمْرَۃٌ طَیِّبَۃٌ ، وَمَائٌ طَہُورٌ۔ (احمد ۱/۴۰۲۔ ابوداؤد ۸۵)",": Da'if","Musannaf Ibn Abi Shaybah 264","","","كتاب الطهارة"
"265","(۲۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْوُضُوئِ مِنَ النَّبِیذِ۔",": Da'if","Musannaf Ibn Abi Shaybah 265","","","كتاب الطهارة"
"266","(۲۶۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ عِکْرِمَۃَ ، قَالَ : النَّبِیذُ وَضُوئٌ لِمَنْ لَمْ یَجِدِ الْمَائَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 266","","","كتاب الطهارة"
"267","(۲۶۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ کَرِہَ أَنْ یُغْتَسَلَ بِالنَّبِیذِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 267","","","كتاب الطهارة"
"268","(۲۶۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، وَأَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : رَأَتْ عَائِشَۃُ عَبْدَ الرَّحْمَنِ وَہُوَ یَتَوَضَّأُ ، فَقَالَتْ : أَسْبِغِ الْوُضُوئَ ، فَإِنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : وَیْلٌ لِلْعَراقِیبِ مِنَ النَّارِ۔ (ابن ماجہ ۴۵۲۔ احمد ۶/۱۹۱)",": Hasan","Musannaf Ibn Abi Shaybah 268","","","كتاب الطهارة"
"269","(۲۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : رَأَی النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَوْمًا تَوَضَّؤُوا ، لَمْ یَمَسَّ الْمَائُ أَعْقَابَہُمْ ، فَقَالَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : وَیْلٌ لِلأَعْقَابِ مِنَ النَّارِ۔\n(احمد ۳/۳۱۶۔ طبرانی ۷۸۱)",": Hasan","Musannaf Ibn Abi Shaybah 269","","","كتاب الطهارة"
"270","(۲۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یِسَافٍ ، عَنْ أَبِی یَحْیَی ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : رَأَی رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَوْمًا تَوَضَّؤُوا وَأَعْقَابُہُمْ تَلُوحُ ، فَقَالَ : وَیْلٌ لِلأَعْقَابِ مِنَ النَّارِ، أَسْبِغُوا الْوُضُوئَ۔ (بخاری ۶۰۔ مسلم ۲۷)",": Hasan","Musannaf Ibn Abi Shaybah 270","","","كتاب الطهارة"
"271","(۲۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ رَأَی قَوْمًا یَتَوَضَّؤُونَ مِنَ الْمِطْہَرَۃِ ، فَقَالَ : أَسْبِغُوا الْوُضُوئَ ، فَإِنِّی سَمِعْتُ أَبَا الْقَاسِمِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : وَیْلٌ لِلْعَرَاقِیبِ مِنَ النَّارِ۔\n(بخاری ۱۶۵۔ مسلم ۲۸)",": Sahih","Musannaf Ibn Abi Shaybah 271","","","كتاب الطهارة"
"272","(۲۷۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ أَبِی کَرِبٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : وَیْلٌ لِلْعَرَاقِیبِ مِنَ النَّارِ۔ (ابوداؤد طیالسی ۱۷۹۷۔ ابن ماجہ ۴۵۴)",": Sahih","Musannaf Ibn Abi Shaybah 272","","","كتاب الطهارة"
"273","(۲۷۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، عَنْ أَبِی أُمَامَۃَ ، أَوْ عَنْ أَخِیہِ ، قَالَ : أَبْصَرَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَوْمًا تَوَضَّؤُوا ، فَرَأَی عَقِبَ أَحَدِہِمْ خَارِجًا لَمْ یُصِبْہُ الْمَائُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : وَیْلٌ لِلْعَرَاقِیبِ مِنَ النَّارِ۔ (ابن ماجہ ۴۰۶۔ طحاوی ۱۲۱)",": Da'if","Musannaf Ibn Abi Shaybah 273","","","كتاب الطهارة"
"274","(۲۷۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یِسَافٍ ، عَنْ سَلَمَۃَ بْنِ قَیْسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا تَوَضَّأْتَ فَانْثُِر ، وَإِذَا اسْتَجْمَرْتَ فَأَوْتِرْ۔",": Sahih","Musannaf Ibn Abi Shaybah 274","","","كتاب الطهارة"
"275","(۲۷۵) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ إسْمَاعِیلَ بْنِ کَثِیرٍ ، عَنْ عَاصِمِ بْنِ لَقِیطِ بْنِ صَبرَۃَ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَخْبِرْنِی عَنِ الْوُضُوئِ ؟ قَالَ : أَسْبِغِ الْوُضُوئَ ، وَبَالِغْ فِی الاِسْتِنْشَاقِ إِلاَّ أَنْ تَکُونَ صَائِمًا۔",": Hasan","Musannaf Ibn Abi Shaybah 275","","","كتاب الطهارة"
"276","(۲۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، قَالَ : سَمِعْتُ عَمْرًا العَنْبَرِیَّ) ؛ أَنَّہُ أَبْصَرَ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ بْنِ عُتْبَۃَ تَوَضَّأَ فَنَسِیَ أَنْ یَسْتَنْشِقَ ، فَلَمَّا وَلَّی الْغُلاَمُ بِالْکُوزِ ، قَالَ : نَسِیتُ أَمْرَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَدَعَا بِمَائٍ فَاسْتَنْشَقَ مَرَّتَیْنِ۔",": Da'if","Musannaf Ibn Abi Shaybah 276","","","كتاب الطهارة"
"277","(۲۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : إنَّ لِلشَّیْطَانِ قَارُورَۃً فِیہَا نَفُوخٌ ، فَإِذَا قَامُوا فِی الصَّلاَۃِ أَنْشَقَہُمُوہا ، فَأُمِرُوا عِنْدَ ذَلِکَ بِالاسْتِنْثَارِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 277","","","كتاب الطهارة"
"278","(۲۷۸) حَدَّثَنَا وَکِیعٌ ، وَإِسْحَاقُ الرَّازِیّ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ قَارِظِ بْنِ شَیْبَۃَ ، عَنْ أَبِی غَطَفَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : اسْتَنْشِقُوا اثْنَتَیْنِ بَالِغَتَیْنِ ، أَوْ ثَلاَثًا ۔ قَالَ وَکِیعٌ : اسْتَنْثِرُوا۔ (ابوداؤد ۱۴۲۔ احمد ۱/۲۲۸)",": Hasan","Musannaf Ibn Abi Shaybah 278","","","كتاب الطهارة"
"279","(۲۷۹) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَکُونَ الاِسْتِنْشَاقُ بِمَنْزِلَۃِ السَّعُوطِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 279","","","كتاب الطهارة"
"280","(۲۸۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی إدْرِیسَ الْخَوْلاَنِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَوَضَّأَ فَلْیَنْتَثِرْ وَمَنِ اسْتَجْمَرَ فَلْیُوتِرْ۔ (مسلم ۲۱۲۔ احمد ۲/۲۳۶)",": Sahih","Musannaf Ibn Abi Shaybah 280","","","كتاب الطهارة"
"281","(۲۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یُمَضْمِضُونَ وَیَسْتَنْشِقُونَ وَیَنْتَثِرُونَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 281","","","كتاب الطهارة"
"282","(۲۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الاِسْتِنْشَاقُ شَطْرُ الطُّہُورِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 282","","","كتاب الطهارة"
"283","(۲۸۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الاِسْتِنْشَاقُ نِصْفُ الطُّہُورِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 283","","","كتاب الطهارة"
