hadiths[116]{hadithnumber,text}:
"7748","کوئی عورت اپنی بہن (دین میں) کے طلاق کا مطالبہ نہ کرے تاکہ اس کی تھالی میں جو کچھ ہے اسے حاصل کر لے، کیونکہ اس کا رزق اللہ تعالیٰ کے پاس ہے۔"
"7749"," حضرت عاصم بن عمر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے حضرت عمر بن خطاب رضی اللہ عنہ کی صاحبزادی سیدہ حفصہ رضی اللہ عنہا   کو طلاق دیدی تھی پھر آپ نے ان سے رجوع کر لیا تھا ۔   یہ روایت امام احمد نے اور امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال ثقہ ہیں ۔"
"7750"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے سیدہ حفصہ   رضی اللہ عنہا کو طلاق دیدی تھی پھر آپ نے ان سے رجوع کر لیا تھا ۔   یہ روایت امام بزار نے نقل کی ہے ۔"
"7751","وَعَنْ زَيْدِ بْنِ أَرْقَمَ قَالَ: «نَزَلَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - الْجُحْفَةَ، ثُمَّ أَقْبَلَ عَلَى النَّاسِ، فَحَمِدَ اللَّهَ، وَأَثْنَى عَلَيْهِ، ثُمَّ قَالَ: "" إِنِّي لَا أَجِدُ لِنَبِيٍّ إِلَّا نِصْفَ عُمُرِ الَّذِي قَبْلَهُ، وَإِنِّي أُوشِكُ أَنْ أُدْعَى فَأُجِيبَ، فَمَا أَنْتُمْ قَائِلُونَ؟ "". قَالُوا: نَصَحْتَ قَالَ: "" أَلَيْسَ تَشْهَدُونَ أَنْ لَا إِلَهَ إِلَّا اللَّهُ، وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ، وَأَنَّ الْجَنَّةَ حَقٌّ، وَأَنَّ النَّارَ حَقٌّ؟ "". قَالُوا: نَشْهَدُ، قَالَ: فَرَفَعَ يَدَهُ فَوَضَعَهَا عَلَى صَدْرِهِ، ثُمَّ قَالَ: "" أَنَا أَشْهَدُ مَعَكُمْ "". ثُمَّ قَالَ: "" أَلَا تَسْمَعُونَ؟ "". قَالُوا: نَعَمْ. قَالَ: "" فَإِنِّي فَرَطٌ عَلَى الْحَوْضِ، وَأَنْتُمْ وَارِدُونَ عَلَى الْحَوْضِ، وَإِنَّ عَرْضَهُ مَا بَيْنَ صَنْعَاءَ وَبُصْرَى، فِيهِ أَقْدَاحٌ عَدَدَ النُّجُومِ مِنْ فِضَّةٍ، فَانْظُرُوا كَيْفَ تَخْلُفُونِي فِي الثَّقَلَيْنِ "". فَنَادَى مُنَادٍ: وَمَا الثَّقَلَانِ يَا رَسُولَ اللَّهِ؟ قَالَ: "" كِتَابُ اللَّهِ، طَرَفٌ بِيَدِ اللَّهِ - عَزَّ وَجَلَّ - وَطَرَفٌ بِأَيْدِيكُمْ، فَتَمَسَّكُوا بِهِ لَا تَضِلُّوا، وَالْآخَرُ عَشِيرَتِي، وَإِنَّ اللَّطِيفَ الْخَبِيرَ نَبَّأَنِي أَنَّهُمَا لَنْ يَتَفَرَّقَا حَتَّى يَرِدَا عَلَيَّ الْحَوْضَ، فَسَأَلْتُ ذَلِكَ لَهُمَا رَبِّي، فَلَا تَقَدَّمُوهُمَا فَتَهْلَكُوا، وَلَا تَقْصِرُوا عَنْهُمَا فَتَهْلَكُوا، وَلَا تَعْلَمُوهُمَا فَهُمْ أَعْلَمُ مِنْكُمْ "". ثُمَّ أَخَذَ بِيَدِ عَلِيٍّ - رَضِيَ اللَّهُ عَنْهُ - فَقَالَ: "" مَنْ كُنْتُ أَوْلَى بِهِ مِنْ نَفْسِهِ فَعَلِيٌّ وَلِيُّهُ، اللَّهُمَّ وَالِ مَنْ وَالَاهُ، وَعَادِ مَنْ عَادَاهُ»."
"7752"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : حضرت عمر رضی اللہ عنہ "" سیدہ حفصہ رضی اللہ عنہا کے پاس تشریف لائے "" تو وہ رو رہی تھیں حضرت عمر رضی اللہ عنہ نے دریافت کیا : تم کیوں رو رہی ہو آ شاید نبی اکرم ﷽ نے تمہیں طلاق دیدی ہے ۔ نبی اکرم ﷽ پہلے بھی تمہیں ایک مرتبہ طلاق دے چکے ہیں اور میری وجہ سے آپ نے تم سے رجوع کر لیا تھا اللہ کی قسم ! اگر آپ نے دوسری مرتبہ تمہیں طلاق دیدی "" تو میں کبھی تمہارے ساتھ بات نہیں کروں گا ۔   یہ روایت امام ابویعلیٰ اور امام بزار نے نقل کی ہے ۔ امام ابویعلیٰ کے رجال صحیح کے رجال ہیں امام بزار کے رجال کا معاملہ بھی اسی طرح ہے ۔"
"7753"," حضرت عقبہ بن عامر جہنی رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے   سیدہ حفصہ رضی اللہ عنہا کو طلاق دیدی حضرت عمر بن خطاب رضی اللہ عنہ کو اس بات کی اطلاع ملی "" تو انہوں نے مٹی اپنے سر میں ڈالی اور بولے : اے خطاب کے بیٹے ! اللہ تعالیٰ اس کے بعد تمہاری کیا پروا کرے گا پھر اس کے بعد حضرت جبرائیل علیہ السلام نبی اکرم ﷽ پر نازل ہوئے "" اور بولے : اللہ تعالیٰ نے حضرت عمر رضی اللہ عنہ پر رحمت کی وجہ سے آپ کو یہ حکم دیا ہے کہ آپ رجوع کر لیں ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی عمرو بن صالح حضرمی ہے میں اس سے واقف نہیں ہوں ۔   اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7754"," حضرت جابر بن عبداللہ رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" طلاق صرف نکاح کے بعد ہوتی ہے "" اور غلام آزاد کرنا صرف ملکیت کے بعد ہوتا ہے """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ روایت کے یہ الفاظ ان کے ہیں امام بزار نے اس کی مانند روایت نقل کی ہے ۔ اور امام بزار کے رجال صحیح کے رجال ہیں ۔"
"7755","اس شخص کا طلاق نہیں جو مالک نہ ہو (یعنی جس کے پاس بیوی نہ ہو)، اور اس شخص کی عتاق (آزادی) نہیں جو مالک نہ ہو (یعنی جس کے پاس غلام نہ ہو)۔"
"7756","وَعَنْ أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - «أَنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِفَاطِمَةَ: """" ائْتِنِي بِزَوْجِكِ وَابْنَيْكِ """". فَجَاءَتْ بِهِمْ، فَأَلْقَى عَلَيْهِمْ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - كِسَاءً كَانَ تَحْتِي خَيْبَرِيًّا أَصَبْنَاهُ مِنْ خَيْبَرَ، ثُمَّ قَالَ: """" اللَّهُمَّ هَؤُلَاءِ آلُ مُحَمَّدٍ - عَلَيْهِ السَّلَامُ - فَاجْعَلْ صَلَوَاتِكَ وَبَرَكَاتِكَ عَلَى آلِ مُحَمَّدٍ كَمَا جَعَلْتَهَا عَلَى آلِ إِبْرَاهِيمَ، إِنَّكَ حَمِيدٌ مَجِيدٌ».\nقُلْتُ: رَوَاهُ التِّرْمِذِيُّ بِاخْتِصَارِ الصَّلَاةِ.\nرَوَاهُ أَبُو يَعْلَى، وَفِيهِ عُقْبَةُ بْنُ عَبْدِ اللَّهِ الرِّفَاعِيُّ وَهُوَ ضَعِيفٌ."
"7757"," حضرت علی بن ابوطالب رضی اللہ عنہ بیان کرتے ہیں : میں نے تمہارے لئے اللہ کے رسول سے چھ باتیں یاد رکھیں ہیں :"""" طلاق دینا صرف نکاح کے بعد ہوتا ہے غلام آزاد کرنا صرف ملکیت کے بعد ہوتا ہے معصیت کے بارے میں نذر کو پورا کرنا لازم نہیں ہوتا بالغ ہونے کے بعد یتیمی ثابت نہیں ہوتی رات تک خاموش رہنے + یعنی چپ کے روزے , کی کوئی حیثیت نہیں ہے "" اور روزے رکھتے ہوئے صوم وصال نہیں رکھا جائے گا """"۔ "
"7758"," حضرت عصمہ رضی اللہ عنہ نے بیان کرتے ہیں : ایک غلام نبی اکرم ﷽ کی خدمت میں حاضر ہوا اس نے عرض کی : یا رسول اللہ ! میرے آقا نے میری شادی کروائی اب وہ یہ چاہتا ہے کہ میرے اور میری بیوی کے درمیان علیحدگی کروا دے راوی بیان کرتے ہیں : نبی اکرم ﷽ منبر پر چڑھے آپ نے ارشاد فرمایا : اے لوگو ! طلاق کا اختیار اس شخص کو ہوتا ہے جو پنڈلی کو پکڑتا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کی سند میں ایک راوی فضل بن مختار ہے "" اور وہ ضعیف ہے ۔"
"7759"," ابن جریج بیان کرتے ہیں : حضرت عبداللہ بن عباس رضی اللہ عنہما کو یہ اطلاع ملی کہ حضرت عبداللہ بن مسعود رضی اللہ عنہ یہ فرماتے ہیں : اگر آدمی اس عورت کو طلاق دیدے جس کے ساتھ اس نے نکاح نہیں کیا ہوا تھا تو یہ جائز ہو گا ۔ حضرت عبداللہ بن عباس رضی اللہ عنہما نے فرمایا : انہوں نے اس مسئلے میں غلطی کی ہے اللہ تعالیٰ نے یہ ارشاد فرمایا ہے :   """" جب تم مومن عورتوں کے ساتھ نکاح کر لو پھر اس کے بعد اگر تم انہیں مس کرنے سے پہلے انہیں طلاق دیدو """" اللہ تعالیٰ نے یہ نہیں فرمایا : جب تم مومن عورتوں کو طلاق دیدو اور پھر ان سے نکاح کر لو ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کی سند منقطع ہے "" اور اس کے رجال ثقہ ہیں ۔"
"7760"," ایوب بن سلیمان جوزی بیان کرتے ہیں : میں نے عطاء بن ابی رباح سے ایسے شخص کے بارے میں دریافت کیا :   جو کسی عورت کا ذکر کرتے ہوئے یہ کہتا ہے کہ جس دن میں نے اس کے ساتھ شادی کی "" تو اسے طلاق بتہ ہو گی "" تو عطاء نے جواب دیا : آدمی جس کے عقدہ کا مالک نہ ہو اسے طلاق نہیں دے سکتا اور جس کی گردن کا مالک نہ ہو اسے آزاد نہیں کر سکتا ۔  یہ بات حضرت عبداللہ بن عباس رضی اللہ عنہما کے حوالے سے ذکر کی گئی ہے "" اور انہوں نے اس کی نسبت نبی اکرم ﷽ کی طرف کی ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ ایوب نامی راوی سے میں واقف نہیں ہوں ۔ اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7761"," حضرت ابوموسی اشعری رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا : خواتین کو صرف مشکوک صورت حال + یعنی کسی شرعی خرابی کی صورت , میں طلاق دی جائے گی "" بے شک اللہ تعالیٰ چکھنے والے مردوں اور چکھنے والی عورتوں + یعنی حلالہ کی خاطر وقتی نکاح کرنے والوں , کو پسند نہیں کرتا ہے ۔   یہ روایت امام بزار اور امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے ۔ امام بزار کی اسانید میں سے ایک سند میں ایک راوی عمران القطان ہے "" جسے امام احمد اور ابن حبان نے ثقہ قرار دیا ہے یحیی بن سعید اور دیگر حضرات نے اسے ضعیف کہا ہے ۔"
"7762"," حضرت عبادہ بن صامت رضی اللہ عنہ بیان کرتے ہیں : بے شک اللہ تعالیٰ چکھنے والے مردوں اور چکھنے والی عورتوں + یعنی حلالہ کی خاطر وقتی نکاح کرنے والوں , کو پسند نہیں کرتا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک ایسا راوی ہے جس کا نام بیان نہیں کیا گیا ہے اس کی بقیہ سند حسن ہے ۔"
"7763"," حضرت جابر رضی اللہ عنہ بیان کرتے ہیں : ایک شخص نبی اکرم ﷽ کی خدمت میں حاضر ہوا اس نے عرض کی : یا رسول اللہ ! میری بیوی کسی چھونے والے کے ہاتھ کو پرے نہیں کرتی نبی اکرم ﷽ نے فرمایا : تم اسے طلاق دیدو اس نے عرض کی : میں اس سے محبت کرتا ہوں وہ بہت خوبصورت ہے ۔ نبی اکرم ﷽ نے فرمایا "" پھر تم اس سے نفع حاصل کرو ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7764"," محمد بن سیرین بیان کرتے ہیں : حضرت امام حسن بن علی رضی اللہ عنہ نے منصور بن سیار بن ریان فزاری سے اس کی بیٹی کا رشتہ مانگا "" تو اس نے کہا میں اللہ کی قسم ! + اپنی بیٹی کی , شادی نہیں کروااں گا کیونکہ میں یہ بات جانتا ہوں کہ آپ خواتین + کے ساتھ شادی , میں دلچسپی رکھتے ہیں "" + اکثر اوقات "" اپنی ازواج کو , طلاق دیدیتے ہیں "" اور شادی کرنے کے بعد "" اپنی بیویوں سے , علیحدگی اختیار کر لیتے ہیں "" البتہ یہ ہے کہ عربوں میں ، آپ سب سے زیادہ معزز گھرانے کے مالک ہیں اور نسب کے اعتبار سے سب سے زیادہ معزز ہیں ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال ثقہ ہیں ۔"
"7765"," حضرت فضالہ بن عبید انصاری رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں : "
"7766"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : ایک شخص حضرت عمر رضی اللہ عنہ کے پاس آیا اور بولا : میں نے اپنی بیوی کو اس کے حیض کے دوران طلاق بتہ دیدی ہے حضرت عمر رضی اللہ عنہ نے فرمایا : تم نے اپنے پروردگار کی نافرمانی کی ہے "" اور تم اپنی بیوی سے جدا ہو گئے ہو اس شخص نے کہا لیکن نبی اکرم ﷽ نے "" تو حضرت عبداللہ بن عمر کو اپنی بیوی سے رجوع کرنے کی ہدایت کی تھی جب انہوں نے اپنی بیوی سے علیحدگی اختیار کی تھی ، تو حضرت عمر رضی اللہ عنہ نے فرمایا : اللہ کے رسول نے اسے اس طلاق کی صورت میں رجوع کی ہدایت کی تھی "" جو طلاق باقی رہ گئی تھی لیکن تمہارے لئے "" تو اتنی طلاق باقی ہی نہیں رہی جس کی بنیاد پر تم اپنی بیوی سے رجوع کر سکو ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں صرف اسماعیل بن ابراہیم ترجمانی کا معاملہ مختلف ہے "" اور وہ ثقہ ہے ۔"
"7767"," حضرت عبداللہ بن عمر رضی اللہ عنہما بیان کرتے ہیں : انہوں نے اپنی بیوی کو اس کے حیض کے دوران ایک طلاق دیدی پھر انہوں نے اس کے بعد باقی کی دو طلاقیں دو قروء کے دوران دینے کا ارادہ کیا جو باقی رہ گئی تھیں اس بات کی اطلاع نبی اکرم ﷽ کو ملی "" تو آپ نے ارشاد فرمایا : اے ابن عمر ! کیا اللہ تعالیٰ نے اس طرح کرنے کا حکم دیا ہے تم نے سنت کی خلاف ورزی کی ہے سنت یہ ہے کہ جب طہر کا آغاز ہو "" تو تم ہر قرء میں ایک طلاق دو پھر نبی اکرم ﷽ نے مجھے حکم دیا میں نے اس عورت سے رجوع کر لیا پھر آپ نے ارشاد فرمایا ، پھر جب اسے حیض آئے پھر جب یہ پاک ہو جائے "" تو اس وقت تم اسے طلاق دیدینا یا اپنے ساتھ روک لینا میں نے عرض کی : یا رسول اللہ ! اگر میں نے اسے تین طلاقیں دیدی ہوتیں ، تو کیا میرے لئے اس سے رجوع کا حق ہونا تھا آ نبی اکرم ﷽ نے فرمایا : اس صورت میں اس نے تم سے جدا ہو جانا تھا "" اور یہ چیز معصیت ہوئی تھی ۔ "
"7768"," ابوزبیر بیان کرتے ہیں : میں نے حضرت جابر رضی اللہ عنہ سے ایسے شخص کے بارے میں دریافت کیا : جو اپنی بیوی کو اس وقت طلاق دیدیتا ہے "" جب اس کی بیوی حیض کی حالت میں ہوتی ہے "" تو انہوں نے بتایا حضرت عبداللہ بن عمر رضی اللہ عنہما نے اپنی بیوی کو اس کے حیض کے دوران طلاق دیدی حضرت عمر رضی اللہ عنہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے "" اور آپ کو اس بارے میں بتایا تو نبی اکرم ﷽ نے ارشاد فرمایا : اسے چاہیے کہ وہ اس عورت سے رجوع کر لے کیونکہ وہ عورت ابھی اس کی بیوی ہے ۔   یہ روایت امام احمد نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں صرف ابن لہیعہ کا معاملہ مختلف ہے "" اور اس کی نقل کردہ حدیث حسن ہے ۔"
"7769"," حضرت ابوموسی اشعری رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے فرمایا : اپنی بیوی سے یہ کہنا : میں نے تمہیں طلاق دی میں نے تم سے رجوع کر لیا + اس طرح کے کلمات استعمال کرنا , مسلمانوں کا طلاق دینے کا طریقہ نہیں ہے تم لوگ عورت کو اس کے ظہر کے آغاز میں طلاق دو ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ یہ الفاظ ان کے ہیں اور معجم کبیر میں بھی نقل کی ہے ۔ تا ہم انہوں نے یہ کہا ہے کہ یہ حمید بن عبدالرحمن خمیری کے حوالے سے منقول ہے وہ بیان کرتے ہیں : حضرت ابوموسی اشعری رضی اللہ عنہ کو یہ اطلاع ملی کہ نبی اکرم نے اشعر قبیلے کے لوگوں پر ناراضگی کا اظہار کیا ہے ۔ انہوں نے عرض کی : یا رسول اللہ ! مجھے یہ بات پتہ چلی ہے کہ آپ نے اشعر قبیلے کے لوگوں پر ناراضگی کا اظہار کیا ہے ۔ نبی اکرم ﷽ نے فرمایا جی ہاں اس کی وجہ یہ ہے کہ ان میں سے کوئی ایک شخص یہ کہتا ہے کہ میں نے نکاح کر لیا میں نے طلاق دیدی ۔۔۔۔۔۔۔۔۔ اس کے بعد راوی نے حسب سابق روایت ذکر کی ہے "" اور اس کے رجال ثقہ ہیں ۔"
"7770"," حضرت عبداللہ بن عباس رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" طلاق صرف عدت کے لئے ہوتی ہے "" اور غلام آزاد کرنا صرف اللہ کی رضا کے لئے ہوتا ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی احمد بن سعید بن فرقد ہے "" اور وہ ضعیف ہے ۔"
"7771","«وَعَنْ عَلِيٍّ قَالَ: دَخَلَ عَلَيَّ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا نَائِمٌ عَلَى الْمَنَامَةِ، فَاسْتَسْقَى الْحَسَنُ وَالْحُسَيْنُ، فَقَامَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - إِلَى شَاةٍ لَنَا بَكِيءٌ، فَحَلَبَهَا فَدَرَّتْ، فَجَاءَ الْحَسَنُ فَنَحَّاهُ النَّبِيُّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ فَاطِمَةُ: كَأَنَّهُ أَحَبُّهُمَا إِلَيْكَ يَا رَسُولَ اللَّهِ؟ قَالَ: """" لَا، وَلَكِنَّهُ اسْتَسْقَى قَبْلَهُ """". ثُمَّ قَالَ: """" إِنِّي وَإِيَّاكِ وَهَذَيْنِ وَهَذَا الرَّاقِدَ فِي مَكَانٍ وَاحِدٍ يَوْمَ الْقِيَامَةِ».\nرَوَاهُ أَحْمَدُ، وَالْبَزَّارُ، إِلَّا أَنَّهُ قَالَ: «أَتَانَا رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا، وَالْحَسَنُ، وَالْحُسَيْنُ، نِيَامٌ فِي لِحَافٍ - أَوْ فِي شِعَارٍ - فَاسْتَسْقَى الْحَسَنُ، فَقَامَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - إِلَى إِنَاءٍ لَنَا، فَصَبَّ فِي الْقَدَحِ، فَجَاءَ بِهِ، فَوَثَبَ الْحُسَيْنُ، فَقَالَ بِيَدِهِ، فَقَالَتْ فَاطِمَةُ: كَأَنَّهُ أَحَبُّهُمَا إِلَيْكَ يَا رَسُولَ اللَّهِ؟ قَالَ: """" إِنَّهُ اسْتَسْقَى قَبْلَهُ، وَإِنِّي وَإِيَّاكِ، وَهَذَيْنِ، وَهَذَا الرَّاقِدَ، فِي مَكَانٍ وَاحِدٍ يَوْمَ الْقِيَامَةِ».\nرَوَاهُ الطَّبَرَانِيُّ بِنَحْوِهِ، إِلَّا أَنَّهُ قَالَ: «فَقَامَ إِلَى قِرْبَةٍ لَنَا، فَجَعَلَ يُمَصِّرُهَا فِي الْقَدَحِ، وَقَالَ: """" إِنَّهُمَا عِنْدِي بِمَنْزِلَةٍ وَاحِدَةٍ».\nوَأَبُو يَعْلَى بِاخْتِصَارٍ، وَفِي إِسْنَادِ أَحْمَدَ قَيْسُ بْنُ الرَّبِيعِ، وَهُوَ مُخْتَلَفٌ فِيهِ، وَبَقِيَّةُ رِجَالِ أَحْمَدَ ثِقَاتٌ."
"7772"," سیدہ ام سلمہ رضی اللہ عنہا بیان کرتی ہیں : ان کے ایک غلام نے اپنی بیوی کو دو طلاقیں دیدیں جو ایک آزاد عورت تھی سیدہ ام سلمہ رضی اللہ عنہا نے نبی اکرم ﷽ سے یہ مسئلہ دریافت کیا "" تو نبی اکرم ﷽ نے ارشاد فرمایا : وہ عورت اس پر حرام ہو گئی ہے + اور اس وقت"
"7773"," حضرت عبداللہ رضی اللہ عنہ فرماتے ہیں : طلاق میں مردوں کا حساب رکھا جائے گا "" اور عدت میں خواتین کی حیثیت کا خیال رکھا جائے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کی دو اسناد میں سے ایک کے رجال صحیح کے رجال ہیں ۔"
"7774"," حضرت عبداللہ رضی اللہ عنہ فرماتے ہیں : جب آدمی اپنی بیوی سے یہ کہے : تمہارا معاملہ تمہارے ہاتھ میں ہے یا تم اپنے معاملے کو کھول دو یا وہ اس عورت کو اس کے اہل خانہ کو ہبہ کر دے اور وہ لوگ اسے قبول بھی کر لیں ، تو یہ ایک بائنہ طلاق ہو گی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7775"," حضرت عبداللہ رضی اللہ عنہ ہبہ کی جانے والی عورت کے بارے میں یہ فرماتے ہیں : اگر اس کے گھر والے اسے قبول کر لیتے ہیں ، تو یہ ایک طلاق شمار ہو گی مرد اس عورت کا زیادہ حق رکھتا ہو گا "" اور اگر وہ اس عورت کو قبول نہیں کرتے ہیں ، تو پھر اس کی کوئی حیثیت نہیں ہو گی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7776"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : حرام قرار دینا اس میں قسم "" توڑنے کا کفارہ لازم ہو گا ۔ "
"7777"," ایک روایت میں یہ الفاظ ہیں :"""" یہ قسم ہے جس کا آدمی کفارہ دے گا """"۔ "
"7778"," ایک روایت میں یہ الفاظ ہیں :"""" اگر اس نے طلاق کی نیت کی تھی ""   تو ویسا ہی ہو گا ورنہ یہ قسم شمار ہو گی """"۔   یہ تمام روایات امام طبرانی نے نقل کی ہے ۔ اور اس ہے ۔ اور اس کے رجال ثقہ ہیں ، البتہ مجاہد نامی راوی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ کا زمانہ نہیں پایا ہے ۔"
"7779"," ضحاک بیان کرتے ہیں : حضرت عمر رضی اللہ عنہ اور حضرت عبداللہ بن مسعود رضی اللہ عنہ حرام قرار دینے کے بارے میں یہ فرماتے ہیں : اس میں قسم کا کفارہ لازم ہو گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی جویبر ہے "" اور وہ متروک ہے ضحاک نامی راوی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ کا زمانہ نہیں پایا ہے ۔"
"7780"," حضرت عبداللہ رضی اللہ عنہ کے بارے میں یہ بات منقول ہے کہ ایک مرتبہ وہ حضرت عمر بن خطاب رضی اللہ عنہ کے پاس موجود تھے ایک شخص اور اس کی بیوی ان کے پاس آئے اس شخص نے کہا میں نے اپنی بیوی کو طلاق دیدی تھی پھر میں نے اس سے رجوع کر لیا ہے اس عورت نے کہا : اگر آپ مجھے اجازت دیں "" تو میں آپ کو اصل صورت حال کے بارے میں بتاتی ہوں حضرت عمر رضی اللہ عنہ نے فرمایا : تم بیان کرو اس عورت نے کہا : اس شخص نے مجھے طلاق دیدی پھر اس نے مجھے ایسے ہی چھوڑ دیا یہاں تک کہ تین حیضوں کا آخری حصہ آ گیا اور میرا + تیسرے حیض کا , خون آنا بند ہو گیا میں نے غسل کا پانی رکھ دیا دروازہ بند کر دیا اور اپنے کپڑے اتار لیے "" تو اس نے دروازہ کھٹکھٹایا اور یہ کہا : میں نے تم سے رجوع کر لیا ہے میں نے تم سے رجوع کر لیا ہے "" تو میں نے غسل کو ترک کر دیا اور میں نے کپڑے پہن لئے حضرت عمر رضی اللہ عنہ نے فرمایا : اے ابن ام عبد ! تم اس کے بارے میں کیا کہتے ہو میں نے کہا :   میرا خیال ہے کہ یہ مرد اس عورت کا زیادہ حق رکھتا ہے ۔ اس سے پہلے کے عورت کے لئے نماز پڑھنا حلال ہو "" تو حضرت عمر رضی اللہ عنہ نے فرمایا : تمہاری رائے اچھی ہے میں بھی یہی سمجھتا ہوں ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7781","وَعَنْ عَمْرِو بْنِ شُعَيْبٍ: «أَنَّهُ دَخَلَ عَلَى زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ، فَحَدَّثَتْهُمْ أَنَّ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - كَانَ عِنْدَ أُمِّ سَلَمَةَ، فَدَخَلَ عَلَيْهَا الْحَسَنُ، وَالْحُسَيْنُ، وَفَاطِمَةُ، فَجَعَلَ الْحَسَنَ مِنْ شِقٍّ وَالْحُسَيْنَ مِنْ شِقٍّ، وَفَاطِمَةُ فِي حِجْرِهِ، وَقَالَ: """" رَحْمَةُ اللَّهِ وَبَرَكَاتُهُ عَلَيْكُمْ أَهْلَ الْبَيْتِ، إِنَّهُ حَمِيدٌ مَجِيدٌ """". وَأَنَا وَأُمُّ سَلَمَةَ جَالِسَتَيْنِ، فَبَكَتْ أُمُّ سَلَمَةَ، فَنَظَرَ إِلَيْهَا فَقَالَ: """" مَا يُبْكِيكِ؟ """". فَقَالَتْ: يَا رَسُولَ اللَّهِ، خَصَصْتَ هَؤُلَاءِ، وَتَرَكْتَنِي أَنَا وَابْنَتِي. فَقَالَ: """" أَنْتِ وَابْنَتُكِ مِنْ أَهْلِ الْبَيْتِ».\nرَوَاهُ الطَّبَرَانِيُّ فِي الْكَبِيرِ وَالْأَوْسَطِ بِاخْتِصَارٍ، وَفِيهِ ابْنُ لَهِيعَةَ، وَهُوَ لَيِّنٌ."
"7782"," حضرت عبادہ بن صامت رضی اللہ عنہ بیان کرتے ہیں : میرے دادا نے اپنی بیوی کو ایک ہزار طلاقیں دیدیں میں نبی اکرم ﷽ کی خدمت میں حاضر ہوا اور میں نے آپ سے اس بارے میں دریافت کیا ، تو نبی اکرم ﷽ نے فرمایا : کیا تمہارا دادا اللہ تعالیٰ سے ڈرتا نہیں ہے جہاں تک تین طلاقوں کا تعلق ہے "" تو اس کا اسے حق ہو گا + یا اس کی طرف سے تین طلاقیں ہو گئیں , اور جہاں تک نو سو ستانوے طلاقوں کا تعلق ہے "" تو یہ سرکشی اور ظلم ہے اگر اللہ تعالیٰ چاہے گا "" تو اسے عذاب دے گا "" اور اگر چاہے گا ، تو اس کی مغفرت کر دے گی ۔"
"7783"," ایک روایت میں حضرت عبادہ بن صامت رضی اللہ عنہ ہی کے حوالے سے یہ الفاظ منقول ہیں وہ بیان کرتے ہیں : میرے بڑوں میں سے ایک نے اپنی بیوی کو ایک ہزار طلاقیں دیدیں ان کے بیٹے نبی اکرم ﷽ کی خدمت میں حاضر ہوئے انہوں نے عرض کی : ہمارے والد نے ہماری والدہ کو ایک ہزار طلاقیں دیدی ہیں ، تو کیا کوئی گنجائش ہے آ نبی اکرم ﷽ نے فرمایا : تمہارا باپ اللہ تعالیٰ سے ڈرا نہیں ورنہ اللہ تعالیٰ اس کے لئے کوئی گنجائش پیدا کر دیتا تین طلاقوں کی بنیاد پر وہ عورت اس شخص سے الگ ہو گئی ہے "" اور یہ سنت کے خلاف ہے "" اور نو سو ستانوے طلاقیں اس شخص کی گردن میں گناہ ہیں ۔   یہ تمام روایات امام طبرانی نے نقل کی ہیں ۔ اس کی سند میں ایک راوی عبیداللہ بن ولید و صافی عجلی ہے "" اور وہ ضعیف ہے ۔"
"7784"," علقمہ بیان کرتے ہیں : ایک شخص حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آیا اور بولا : میں نے اپنی بیوی کو ننانوے طلاقیں دیدی ہیں میں نے اس بارے میں دریافت کیا ، تو مجھے بتایا گیا کہ وہ عورت مجھ سے جدا ہو چکی ہے حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا : لوگ اس بات کو پسند کرتے ہیں کہ تمہارے اور اس درمیان کے علیحدگی کروا دیں اس شخص نے کہا : اللہ تعالیٰ آپ پر رحم کرے پھر آپ کیا کہتے ہیں آ وہ شخص یہ سمجھا کہ حضرت عبداللہ رضی اللہ عنہ شاید اسے رخصت دیدیں گے "" تو حضرت عبداللہ رضی اللہ عنہ نے فرمایا : تین طلاقوں کی بنیاد پر وہ عورت تم سے الگ ہو گئی اور باقی تمام سرکشی شمار ہوں گی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7785"," علقمہ بیان کرتے ہیں : ایک شخص حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آیا اور بولا : میں نے اپنی بیوی کو ستاروں کی تعداد جتنی طلاقیں دیدی ہیں حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا : اہل کی خواتین ۔۔۔۔۔۔۔۔۔۔۔ اس کے بعد راوی نے ایک کلمہ ذکر کیا گیا "" جو مجھے یاد نہیں ہے ۔  ایک شخص اْن کے پاس آیا اور بولا : میں نے اپنی بیوی کو آٹھ طلاقیں دیدی ہیں حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا : کیا لوگ یہ چاہتے ہیں کہ وہ عورت تم سے جدا ہو جائے اس نے جواب دیا : جی ہاں ! حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا : اے لوگو ! اللہ تعالیٰ نے طلاق کا حکم بیان کر دیا ہے "" تو جو شخص اس طرح طلاق دیتا ہے جس طرح اللہ تعالیٰ نے حکم بیان کیا ہے "" تو وہ شخص واضح کام کرتا ہے "" اور جو شخص اس میں التباس زیادہ کرتا ہے "" تو ہم اس کے التباس کو اس پر عائد کر دیں گے اللہ کی قسم ! ایسا نہیں ہو گا کہ تم اپنی ذات کے حوالے سے التباس قائم کرو اور تمہاری طرف سے اس کا بوجھ ہم اٹھائیں ان کی مراد یہ تھی یہ اسی طرح شمار ہوں گی ، جس طرح تم نے کہا ہے ۔ "
"7786"," عروہ بن زبیر بیان کرتے ہیں : حضرت زبیر رضی اللہ عنہ سیدہ اسما بنت ابوبکر رضی اللہ عنہا کی پٹائی کر رہے تھے "" تو انہوں نے بلند آواز میں حضرت عبداللہ بن زبیر رضی اللہ عنہما کو پکارا وہ آئے "" جب حضرت زبیر رضی اللہ عنہ نے انہیں دیکھا تو کہا اگر تم اندر آئے "" تو تمہاری ماں کو طلاق ہے حضرت عبداللہ رضی اللہ عنہ نے ان سے کہا : کیا آپ میری ماں کو اپنی قسم کا ذریعہ بنا رہے ہیں پھر وہ اندر داخل ہوئے "" اور سیدہ اسماء رضی اللہ عنہا کو چھڑا لیا تو سیدہ اسماء رضی اللہ عنہا اپنے شوہر سے الگ ہو گئیں راوی کہتے ہیں : میں ان دنوں کمسن لڑکا تھا "" اور بعض اوقات حضرت زبیر رضی اللہ عنہ کے کندھوں کے بال پکڑ لیا کرتا تھا ۔ یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی عبداللہ بن محمد بن یحیی بن عروہ ہے "" اور وہ ضعیف ہے ۔"
"7787"," حضرت ابواسید رضی اللہ عنہ اور حضرت سہل بن سعد رضی اللہ عنہ روایت کرتے ہیں : ایک مرتبہ نبی اکرم ﷽ ہمارے پاس سے گزرے آپ کے ساتھ آپ کے کچھ اصحاب بھی تھے ہم لوگ بھی نبی اکرم ﷽ کے ساتھ روانہ ہوئے یہاں تک کہ ہم ایک باغ میں آ گئے جس کا نام شوط تھا یہاں تک کہ ہم دو دیواروں کے درمیان آ کر بیٹھ گئے نبی اکرم ﷽ نے ارشاد فرمایا : تم لوگ بیٹھے رہو پھر نبی اکرم ﷽ تشریف لے گئے آپ جونیہ خاتون کے پاس تشریف لے گئے جسے اس باغ میں موجود ایک گھر میں رکھا گیا تھا ان کا نام امیمہ بنت نعمان بن شرحبیل تھا ان کے ساتھ ایک دایا بھی تھی جب نبی اکرم ﷽ اس خاتون کے پاس تشریف لائے "" اور آپ آپ نے فرمایا : تم اپنا آپ مجھے ہبہ کر دو تو اس خاتون نے کہا : کیا کوئی ملکہ اپنی ذات عام لوگوں کو ہبہ کرتی ہے   راوی بیان کرتے ہیں : حضرت ابوحمید رضی اللہ عنہ کے علاوہ کسی راوی نے یہ بات بیان کی ہے کہ اس خاتون کا تعلق بنو جون سے تھا ""  اور ان کا نام امیمہ تھا "" اور اْس خاتون نے یہ کہا تھا : میں آپ سے اللہ کی پناہ مانگتی ہوں ، تو نبی اکرم ﷽ نے فرمایا : تم نے ایک زبردست پناہ حاصل کر لی ہے پھر نبی اکرم ﷽ واپس ہمارے پاس تشریف لے آئے "" اور آپ نے ارشاد فرمایا : اے ابواسید ! اسے دو لباس فراہم کر دو اور اسے اس کے گھر والوں کے پاس چھوڑ آا ۔ "
"7788"," سوید بن غفلہ بیان کرتے ہیں : عائشہ بنت خلیفہ خثعمیہ ، حضرت امام حسن بن علی رضی اللہ عنہ کی اہلیہ تھیں ، جب حضرت علی رضی اللہ عنہ شہید ہو گئے "" اور حضرت امام حسن رضی اللہ عنہ کی خلافت کے لئے بیعت کر لی گئی اس کے بعد وہ اس خاتون کے پاس تشریف لائے "" تو انہوں نے کہا : آپ کو خلافت کی مبارک ہو حضرت امام حسن رضی اللہ عنہ نے اس خاتون سے کہا : کیا تم حضرت علی رضی اللہ عنہ کی شہادت کے حوالے سے شماتت ظاہر کر رہی ہو تم چلی جاا تمہیں تین طلاقیں ہیں ، تو اس خاتون نے چادر اوڑھی اور گھر کے کونے میں بیٹھ گئیں "" اس خاتون نے کہا : اللہ کی قسم ! میں نے وہ مراد نہیں لی تھی جس کی طرف آپ گئے ہیں پھر وہ عورت ٹھہری رہی یہاں تک کہ جب اس کی عدت ختم ہو گئی "" تو وہ ان کے گھر سے چلی گئیں اس خاتون کا جتنا مہر باقی تھا وہ امام حسن رضی اللہ عنہ نے اس کی طرف بھیجوایا اور ساز و سامان"
"7789"," ابو اسحاق بیان کرتے ہیں : حضرت امام حسن بن علی رضی اللہ عنہ نے اپنے اہلیہ کو بیس ہزار + درہم یا دینار , متاع کے طور پر دیے جب میں وہ لے کر اس خاتون کے پاس آیا اور انہیں اس خاتون کے سامنے رکھا تو اس نے کہا :   """" جدا ہونے والے محبوب کے مقابلے میں یہ سب کچھ تھوڑا ہے """"۔"
"7790"," ایک روایت میں یہ الفاظ ہیں : امام حسن بن علی رضی اللہ عنہ نے متاع کے طور پر دو خواتین کو بیس ہزار + درہم یا دینار , دیے اور شہد کا ایک مٹکا دیا تو ان دو میں سے ایک نے یہ کہا میرا یہ خیال ہے وہ خاتون حنیفہ تھیں """" کہ جدا ہونے والے محبوب کے مقابلے میں یہ ساز و سامان تھوڑا ہے ۔  یہ تمام روایات امام طبرانی نے نقل کی ہیں پہلی روایت کے رجال صحیح کے رجال ہیں ۔"
"7791"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ سے ایسے شخص کے بارے میں دریافت کیا گیا : جس کی بیوی ہوتی ہے "" اور وہ اسے تین طلاقیں دیدیتا ہے اس کے بعد ایک مرد "" اْس عورت سے شادی کر لیتا ہے "" اور وہ اس کی رخصتی کروانے سے پہلے اس عورت کو طلاق دیدیتا ہے "" تو کیا وہ عورت اپنے پہلے شوہر کے لئے حلال ہو جائے گی راوی بیان کرتے ہیں ، تو نبی اکرم ﷽ نے ارشاد فرمایا :   """" جی نہیں ! جب تک دوسرا شوہر اس عورت کے شہد کو نہیں چکھ لیتا جسے پہلے نے چکھا تھا "" اور عورت مرد کے شہد کو نہیں چکھ لیتی """"۔ یہ روایت امام احمد امام بزار اور امام ابویعلیٰ نے نقل کی ہے ۔ تاہم انہوں نے یہ الفاظ نقل کیے ہیں :   """" دوسرا شوہر اس عورت کی رخصتی سے پہلے انتقال کر گیا """"۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں صرف محمد بن دینار طاحی کا معاملہ مختلف ہے ۔ ابوحاتم ابوزرعہ اور ابن حبان نے اسے ثقہ قرار دیا ہے اس کے بارے میں ایسا کلام کیا گیا ہے جو نقصان دہ نہیں ہے ۔"
"7792"," حضرت عبدالرحمن بن زبیر رضی اللہ عنہما بیان کرتے ہیں : رفاعہ بن سموال نے اپنی بیوی کو طلاق دیدی وہ خاتون نبی اکرم ﷽ کے پاس آئی اور بولی یا رسول اللہ ! عبدالرحمن نے میرے ساتھ شادی کر لی ہے "" لیکن اس کا ساتھ صرف اس کی مانند ہے  اس خاتون نے اپنے کپڑے کے کنارے کی طرف اشارہ کر کے یہ بات کہی "" "
"7793"," حضرت عبیداللہ رضی اللہ عنہ اور حضرت فضل بن عباس رضی اللہ عنہما بیان کرتے ہیں : غمیصاء + راوی کو شک ہے یا شاید یہ الفاظ ہیں : , رمیصاء نامی خاتون نبی اکرم ﷽ کی خدمت میں اپنے شوہر کی شکایت کرنے کے لئے آئیں اس نے کہا : وہ شخص اس عورت کے ساتھ قربت نہیں کرتا ہے اس کے شوہر نے کہا : یا رسول اللہ ! یہ جھوٹ بول رہی ہے میں ایسا کرتا ہوں لیکن یہ چاہتی کہ یہ اپنے پہلے شوہر کے پاس واپس چلی جائے راوی بیان کرتے ہیں ، تو نبی اکرم ﷽ نے ارشاد فرمایا : "
"7794"," حضرت عبداللہ بن عمر رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :"""" جس عورت کو تین طلاقیں دیدی گئی ہوں وہ اپنے پہلے شوہر کے لئے اس وقت تک حلال نہیں ہو گی جب تک وہ دوسری شادی نہیں کر لیتی اور دوسرا شوہر اس کے ساتھ گھل مل کر اس کا شہد نہیں چکھ لیتا """"۔   یہ روایت امام طبرانی اور امام ابویعلیٰ نے نقل کی ہے ۔ تاہم انہوں نے سیدہ عائشہ رضی اللہ عنہا کی روایت کی مانند الفاظ نقل کیے ہیں اس کی مانند ہی ہے ۔ امام ابویعلیٰ کے رجال صحیح کے رجال ہیں ۔"
"7795"," سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : بنوقریظہ سے تعلق رکھنے والی ایک خاتون جس کا نام تمیمہ تھا وہ حضرت عبدالرحمن بن زبیر رضی اللہ عنہما کی اہلیہ تھیں رفاعہ جن کا تعلق بنوقریظہ سے تھا انہوں نے اس خاتون کے ساتھ شادی کر لی پھر انہوں نے اس خاتون سے علیحدگی کر لی اس خاتون نے دوبارہ عبدالرحمن بن زبیر کے پاس واپس جانے کا ارادہ کیا + یعنی دوبارہ اس کے ساتھ شادی کا ارادہ کیا , تو اس نے عرض کی : یا رسول اللہ ! اس کا ساتھ + یعنی دوسرے شوہر کا ساتھ , میرے اس کپڑے کے کنارے کی طرح ہے ۔ نبی اکرم ﷽ نے ارشاد فرمایا : اللہ کی قسم ! اے تمیمہ تم عبدالرحمن کی طرف اس وقت تک واپس نہیں جا سکتی ہو جب تک اس کے علاوہ کوئی اور شخص + یعنی تمہارا دوسرا شوہر , تمہارا شہد نہیں چکھ لیتا اس خاتون نے عرض کی : یا رسول اللہ ! وہ میرے پاس ہبہ کے طور پر آیا ہے ۔ "
"7796"," حضرت عبداللہ بن مسعود رضی اللہ عنہ ایسی خاتون کے بارے میں فرماتے ہیں : جس کی رخصتی سے پہلے اسے تین طلاقیں دیدی جاتی ہیں کہ وہ شوہر کے لئے اس وقت تک حلال نہیں ہو گی جب تک دوسری شادی نہیں کر لیتی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں صرف عاصم بن ابونجود کا معاملہ مختلف ہے وہ ثقہ ہے "" اور اس میں ضعف پایا جاتا ہے ۔"
"7797"," حضرت عبداللہ بن مسعود رضی اللہ عنہ یہ فرماتے ہیں : ایسی عورت کے آقا کا اس کے ساتھ صحبت کرنا اسے اس کے شوہر کے لئے حلال نہیں کرے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ، البتہ ابن جریج یہ کہتے ہیں : مجھے عاصم "" مسروق اور ابراہیم نخعی کے حوالے سے یہ روایت بیان کی گئی ہے ۔ انہوں نے اس شخص کا نام نہیں بتایا کہ جس نے انہیں یہ روایت بیان کی ہے ۔"
"7798"," سیدہ عائشہ صدیقہ رضی اللہ عنہا نبی اکرم ﷽ کا یہ فرمان نقل کرتی ہیں : عسیلہ + شہد چکھنے , سے مراد صحبت کرنا ہے ۔ "
"7799"," امام ابویعلیٰ کی ایک روایت میں یہ الفاظ ہیں : سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷽ نے لفظ """" عسیلہ """" کے ذریعے نکاح مراد لیا تھا + یعنی شہد سے مراد صحبت کرنا ہے , ۔"
"7800"," حضرت عبداللہ بن عمر رضی اللہ عنہا بیان کرتے ہیں : نبی اکرم ﷽ نے "
"7801"," عمرو بن امیہ بیان کرتے ہیں : میں نے کچھ افراد کو نبی اکرم ﷽ کے حوالے سے یہ بیان کرتے ہوئے سنا کہ جب کسی کنیز کو آزاد کر دیا جائے "" تو اسے اختیار ہو گا "" جب تک اس کا شوہر اس کے ساتھ صحبت نہیں کرتا اگر وہ چاہے گی "" تو شوہر سے علیحدگی اختیار کر لے گی اگر شوہر نے اس کے ساتھ صحبت کر لی "" تو پھر عورت کے لئے اختیار نہیں رہے گا پھر وہ شوہر سے علیحدگی اختیار نہیں کر سکے گی ۔   یہ روایت امام احمد نے اسی طرح متصل روایت کے طور پر نقل کی ہے ۔ اور ایک سند کے حوالے سے مرسل روایت کے طور پر نقل کی ہے ۔ متصل روایت کی سند میں ایک راوی فضل بن عمرو بن امیہ ہے "" اور وہ مستور ہے "" اور ایک راوی ابن لہیعہ ہے جس کی نقل کردہ حدیث حسن ہوتی ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7802"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : سیدہ بریرہ رضی اللہ عنہا کے شوہر ایک غلام تھے جن کا نام مغیث تھا حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : میں نے انہیں دیکھا کہ وہ مدینہ منورہ کی گلیوں میں اس خاتون کے پیچھے جا رہے تھے اور ان کی آنکھوں سے آنسو جاری تھے ۔ حضرت عبداللہ بن عباس رضی اللہ عنہما فرماتے ہیں : نبی اکرم ﷽ نے اس خاتون کے بارے میں چار فیصلے دیے تھے آپ نے یہ فیصلہ دیا تھا کہ ولاء کا حق آزاد کرنے والے کو ملتا ہے آپ نے اس خاتون کو اختیار دیا تھا "" اور اسے یہ ہدایت کی تھی   کہ وہ آزاد عورت کی مانند عدت گزارے گی حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : کہ ایک مرتبہ اس خاتون کو صدقہ کے طور پر کوئی چیز دی گئی اس نے اس چیز میں سے کچھ سیدہ عائشہ رضی اللہ عنہا کو تحفے کے طور پر دیدیا سیدہ عائشہ رضی اللہ عنہا نے اس بات کا تذکرہ نبی اکرم ﷽ سے کیا ، تو نبی اکرم ﷽ نے ارشاد فرمایا : یہ اس کے لئے صدقہ تھا "" اور ہمارے لئے ہدیہ کے طور پر ہے ۔ "
"7803"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : سیدہ عائشہ رضی اللہ عنہا نے یہ ارادہ کیا کہ سیدہ بریرہ رضی اللہ عنہا کو خرید کر اسے آزاد کر دیں "" تو اس کے آقااں نے کہا جی نہیں آپ کو ولاء کا حق ہمارے لئے رہنے دینا ہو گا سیدہ عائشہ رضی اللہ عنہا نے اس بات کا تذکرہ نبی اکرم ﷽ سے کیا ، تو نبی اکرم ﷽ نے فرمایا : تم اسے خرید کر اسے آزاد کر دو نبی اکرم ﷽ نے ارشاد فرمایا : لوگوں کا کیا معاملہ ہے وہ ایسی شرائط طے کرتے ہیں جن کی اجازت اللہ کی کتاب میں نہیں ہے جو شخص کوئی ایسی شرط طے کرے جس کی اجازت اللہ کی کتاب میں نہ ہو "" تو وہ + شرط , باطل + یعنی کالعدم , شمار ہو گی ۔  راوی بیان کرتے ہیں : وہ خاتون ایک غلام کی بیوی تھی جن کا نام مغیث تھا وہ بنومغیرہ کے غلام تھے ۔ نبی اکرم ﷽ نے اس خاتون کو اختیار دیا تھا ۔ راوی بیان کرتے ہیں : حضرت عبداللہ بن عباس رضی اللہ عنہما نے یہ بات بیان کی ہے کہ نبی اکرم ﷽ نے اس خاتون کی عدت آزاد عورت کی عدت کی مانند قرار دی تھی ۔ "
"7804"," ابن جریج بیان کرتے ہیں : مجھے یہ بات بتائی گئی ہے کہ حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : اگر کنیز کسی غلام کی بیوی ہو اور اسے آزاد کر دیا جائے "" اور کنیز کو یہ علم نہ ہو کہ اس کو علیحدگی کا اختیار کا ہے "" اور پھر وہ + علیحدگی کو , اختیار نہ کرے یہاں "
"7805"," حضرت عبداللہ بن مسعود رضی اللہ عنہ کنیز کے بارے میں یہ فرماتے ہیں : اگر اسے فروخت کر دیا جائے "" اور اس کا شوہر موجود ہو "" تو وہ فرماتے ہیں : اس کو فروخت کرنا اس کی طلاق شمار ہو گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں "" البتہ ابراہیم نامی راوی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ سے سماع نہیں کیا ہے ۔"
"7806","وَعَنْ أَبِي هُرَيْرَةَ قَالَ: «سَمِعَتْ أُذُنَايَ هَاتَانِ، وَأَبْصَرَتْ عَيْنَايَ هَاتَانِ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ آخِذٌ بِكَفَّيْهِ جَمِيعًا حَسَنًا - أَوْ حُسَيْنًا - وَقَدَمَاهُ عَلَى قَدَمَيْ رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ: """" حُزُقَّةٌ حُزُقَّةْ تَرَقَّ عَيْنَ بَقَّةْ """".\nفَيَرْقَى الْغُلَامُ، فَيَضَعُ قَدَمَيْهِ عَلَى صَدْرِ رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ: """" افْتَحْ فَاكَ """". ثُمَّ قَبَّلَهُ، ثُمَّ قَالَ: """" اللَّهُمَّ مَنْ أَحَبَّهُ فَإِنِّي أُحِبُّهُ».\nرَوَاهُ الطَّبَرَانِيُّ، وَفِيهِ أَبُو مُزَرِّدٍ وَلَمْ أَجِدْ مَنْ وَثَّقَهُ، وَبَقِيَّةُ رِجَالِهِ رِجَالُ الصَّحِيحِ."
"7807"," حضرت ابی بن کعب رضی اللہ عنہ بیان کرتے ہیں : حضرت عمر بن خطاب رضی اللہ عنہ کا بیوہ حاملہ عورت کے بارے میں مجھ سے اختلاف ہو گیا میں نے کہا : جب وہ بچے کو جنم دے گی "" تو اس کی شادی کی جا سکتی ہے "" تو میری اْم ولد ام طفیل نے مجھے اور حضرت عمر رضی اللہ عنہ   کو یہ بات بتائی کہ نبی اکرم ﷽ نے سبیعہ اسلمیہ کو یہ ہدایت کی تھی جب سبیعہ اسلمیہ نے بچے کو جنم دیدیا تھا تو نبی اکرم ﷽ نے اسے یہ ہدایت کی تھی کہ وہ نکاح کر لے ۔   یہ روایت امام احمد نے نقل کی ہے ۔ اور اس کی سند حسن ہے "" البتہ بسر بن سعید نے حضرت ابی بن کعب رضی اللہ عنہ کا زمانہ نہیں پایا ہے ۔"
"7808"," سیدہ ام طفیل رضی اللہ عنہا جو حضرت ابی بن کعب رضی اللہ عنہ کی اہلیہ + یا اْم ولد , ہیں وہ بیان کرتی ہیں : انہوں نے حضرت عمر بن خطاب رضی اللہ عنہ اور حضرت ابی بن کعب رضی اللہ عنہ کو بحث کرتے ہوئے سنا تو سیدہ ام طفیل رضی اللہ عنہا نے کہا : حضرت عمر بن خطاب رضی اللہ عنہ سبیعہ سلمیہ سے کیوں دریافت نہیں کر لیتے جس کے شوہر کا اس وقت انتقال ہوا تھا جب وہ حاملہ تھی اور اس کے کچھ دن بعد اس نے بچے  کو جنم دیدیا تھا تو نبی اکرم ﷽ نے اس خاتون کی شادی کروا دی تھی ۔   یہ روایت امام احمد نے نقل کی ہے ۔ امام طبرانی نے اسے زیادہ مکمل روایت کے طور پر نقل کیا ہے اس کی سند میں ایک راوی ابن لہیعہ ہے ""   اور اس کی نقل کردہ یث حسن ہے "" اور اس میں ضعف پایا جاتا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7809"," حضرت عبداللہ بن مسعود رضی اللہ عنہ بیان کرتے ہیں : سبیعہ اسلمیہ بنت حارث نے اپنے شوہر کی وفات کے پندرہ دن بعد حمل کو جنم دیدیا ابوسنابل نامی صاحب اس خاتون کے پاس آئے "" اور بولے : تم شاید دوبارہ شادی کرنے کی تیاری کر رہی ہو "" تمہیں اس کا اختیار نہیں ہے "" جب تک وہ مدت پوری نہیں ہوتی جو بعد میں پوری ہو گی وہ خاتون نبی اکرم "
"7810"," حضرت عبیداللہ بن عتبہ رضی اللہ عنہ بیان کرتے ہیں : سیدہ سبیعہ اسلمیہ بنت حارث رضی اللہ عنہا ۔۔۔۔۔۔۔۔۔۔۔ اس کے بعد راوی نے حسب سابق حدیث ذکر کی ہے جس میں یہ الفاظ ہیں : "
"7811"," سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷽ کے زمانہ اقدس میں ایک خاتون کو طلاق دیدی گئی بیس دن گزرنے کے بعد اس نے اپنے حمل کو جنم دیدیا وہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئی اور آپ کو اس بارے میں بتایا تو نبی اکرم ﷽ نے ارشاد فرمایا : تم اپنے معاملے میں بہتری تلاش کرو ! یعنی تم شادی کر لو ۔   یہ روایت امام طبرانی نے معجم اوسط میں دو اسناد کے ساتھ نقل کی ہے ۔ جس میں سے ایک کے رجال ثقہ ہیں ۔"
"7812"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" اللہ تعالیٰ اور آخرت کے دن پر ایمان رکھنے والی کسی بھی عورت کے لئے یہ بات حلال نہیں ہے کہ وہ کسی کے مرنے پر تین دن سے زیادہ سوگ کرے "" البتہ شوہر کا معاملہ مختلف ہے """"۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی زمعہ بن صالح ہے "" اور وہ ضعیف ہے ویسے اس کی توثیق کی گئی ہے ۔"
"7813"," سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷽ نے بریرہ کی عدت آزاد عورت کی عدت قرار دی تھی ۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی حمید بن ربیع ہے "" جسے امام احمد اور دیگر حضرات نے ثقہ قرار دیا ہے ""   اور ایک جماعت نے اسے ضعیف کہا ہے ۔ "
"7814"," حضرت عبداللہ بن عباس رضی اللہ عنہما فرماتے ہیں : بیوہ عورت کو خوشبو لگانے اور زینت اختیار کرنے سے منع کیا گیا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7815"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : جب کسی عورت کو طلاق دیدی جائے "" اور اس کے بارے میں یہ گمان ہو کہ اب اس کا حیض آنا بند ہو گیا ہے "" اور یہ چیز اس کی طرف سے واضح نہ ہو ""   تو وہ ایک سال تک انتظار کرے گی اگر اس دوران اسے حیض نہیں آتا تو وہ ایک سال گزرنے کے بعد مزید تین ماہ تک عدت گزرے گی اگر ان تین ماہ کے دوران اسے حیض آ جاتا ہے "" تو پھر وہ حیض کے حساب سے عدت گزارے گی لیکن اگر اسے حیض آیا تھا "" اور وہ حیض مکمل نہیں ہوا اور یہ ایک سال گزرنے کے بعد تین ماہ گزرنے کے بعد ہوا تو پھر وہ عورت اپنے بارے میں جلدی نہیں کرے گی جب تک وہ یہ نہیں جان لیتی کہ اس کا حیض مکمل ہوا یا نہیں ہوا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں "" البتہ عبدالکریم جزری کا معامل مختلف ہے وہ یہ کہتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ کے شاگردوں نے یہ بات بیان کی ہے ""   اور انہوں نے ان شاگردوں میں سے کسی کا نام بیان نہیں کیا ۔"
"7816","وَعَنْ شُرَحْبِيلَ قَالَ: كُنْتُ مَعَ الْحُسَيْنِ بْنِ عَلِيٍّ، وَأُخْرِجَ بِسَرِيرِ الْحَسَنِ بْنِ عَلِيٍّ، فَأَرَادَ أَنْ يَدْفِنَهُ مَعَ النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَخَافَ أَنْ يَمْنَعَهُ بَنُو أُمَيَّةَ، فَلَمَّا انْتَهَوْا بِهِ إِلَى الْمَسْجِدِ قَامَتْ بَنُو أُمَيَّةَ، فَقَامَ عَبْدُ اللَّهِ بْنُ جَعْفَرٍ، فَقَالَ: إِنِّي سَمِعْتُهُ يَقُولُ: إِنْ مَنَعُونِي فَادْفِنُونِي مَعَ أُمِّي.\nرَوَاهُ الطَّبَرَانِيُّ، وَفِيهِ شُرَحْبِيلُ بْنُ سَعْدٍ، وَهُوَ ضَعِيفٌ."
"7817"," حضرت جابر بن عبداللہ رضی اللہ عنہ اپنی خالہ کے حوالے سے یہ بات نقل کرتے ہیں + کہ وہ عدت گزار رہی تھیں , انہوں نے گھر سے نکل کر اپنی کھجوروں کے باغ میں جانے کا ارادہ کیا تھا تاکہ اس کی دیکھ بھال کریں ایک شخص نے ان سے کہا : تمہیں اس بات کا حق حاصل نہیں ہے وہ خاتون نبی اکرم ﷽ کی خدمت میں حاضر ہوئیں ، تو نبی اکرم ﷽ نے ارشاد فرمایا : تم گھر سے نکلو اور اپنے کھجور کے باغ کی دیکھ بھال کرو ! ہو سکتا ہے کہ تم اسے صدقہ کر دو یا کسی اور اچھائی کے کام میں استعمال کرو ۔ "
"7818"," علقمہ بیان کرتے ہیں : حضرت عبداللہ بن مسعود رضی اللہ عنہ سے ایک شخص نے ہمدان کی خواتین کے بارے میں دریافت کیا : جنہیں ان کے شوہروں کے انتقال کی اطلاع مل گئی تھی "" ان خواتین نے کہا : ہمیں تنہائی میں وحشت محسوس ہوتی ہے "" تو حضرت عبداللہ رضی اللہ عنہ نے فرمایا : وہ دن کے وقت اکٹھی ہو سکتی ہیں پھر رات کے وقت ان میں سے ہر ایک اپنے گھر واپس چلی جائے گی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7819"," حضرت ابوہریرہ رضی اللہ عنہ نبی اکرم ﷽ کے بارے میں یہ بات نقل کرتے ہیں کہ اوطاس کے واقعہ میں آپ نے اس بات سے منع کر دیا تھا کہ کوئی شخص حاملہ عورت کے ساتھ صحبت کرے جب تک وہ بچے کو جنم نہیں دیدیتی ۔ یہ روایت امام طبرانی نے معجم صغیر اور معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی بقیہ اور ایک راوی حجاج بن ارطاق ہے ""   اور یہ دونوں مدلس ہیں ۔"
"7820"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے غزوہ حنین کے موقوع پر تقسیم سے پہلے خمس کو فروخت کرنے سے منع کر دیا تھا "" اور خواتین کے ساتھ صحبت کرنے سے منع کر دیا تھا جب تک وہ اپنے پیٹ میں موجود بچوں کو جنم نہیں دیدیتی ہیں ، جبکہ وہ حاملہ ہوں ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اس کی سند میں ایک راوی عصمہ بن متوکل ہے "" اور وہ ضعیف ہے ۔"
"7821"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے اس بات سے منع کر دیا تھا کہ حاملہ عورتوں کے ساتھ صحبت کی جائے ""   جب تک وہ بچے کو جنم نہیں دیدیتی ہیں ۔   یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے ۔ اور اس کے رجال ثقہ ہیں ۔ اس سے پہلے نکاح سے متعلق باب میں حاملہ عورتوں کے ساتھ صحبت کرنے سے متعلق روایات گزر چکی ہیں جب تک وہ بچے  کو جنم نہیں دیدیتی ہیں ۔"
"7822"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : کنیز کا ایک حیض کے ذریعے استبراء کیا جائے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7823"," حضرت عبداللہ بن عمرو رضی اللہ عنہ اور حضرت سہل بن ابوحثمہ رضی اللہ عنہ بیان کرتے ہیں : حبیبہ بنت سہل نامی خاتون حضرت ثابت بن قیس بن شماس رضی اللہ عنہ کی اہلیہ تھیں وہ خاتون انہیں ناپسند کرتی تھیں کیونکہ وہ ایک بدصورت شخص تھے وہ خاتون نبی اکرم ﷽ کی خدمت میں حاضر ہوئی اور بولیں میں نے انہیں دیکھا ہے اگر اللہ کا خوف نہ ہوتا تو میں نے ان کے چہرے پر تھوک دینا تھا ۔ نبی اکرم ﷽ نے فرمایا : کیا تم اسے اس کا باغ واپس کر دو گی جو اس نے تمہیں مہر میں دیا ہے اس خاتون نے جواب دیا : جی ہاں ! نبی اکرم ﷽ نے ان صاحب کو بلوایا اس خاتون نے ان کا باغ ان صاحب کو واپس کر دیا نبی اکرم ﷽ نے ان دونوں کے درمیان علیحدگی کروا دی یہ اسلام میں ہونے والا سب سے پہلا خلع تھا ۔ یہ روایت امام احمد نے امام بزار نے اور امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی حجاج بن ارطاۃ ہے "" اور وہ مدلس ہے ۔"
"7824"," حضرت انس رضی اللہ عنہ بیان کرتے ہیں : حضرت ثابت بن شماس رضی اللہ عنہ کی اہلیہ آئیں "" وہ حضرت ثابت بن قیس بن شماس رضی اللہ عنہ ہیں "" وہ خاتون نبی اکرم ﷽ کی خدمت میں حاضر ہوئی اس نے کوئی کلام کیا جس میں اس نے حضرت ثابت بن قیس رضی اللہ عنہ کو ناپسند کرنے کا اظہار کیا ، "
"7825"," حضرت عقبہ بن عامر رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" خلع لینے والی اور علیحدگی اختیار کرنے والی عورتیں ہی منافق ہیں """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کی سند میں ایک راوی قیس بن ربیع ہے "" جسے ثوری اور شعبہ نے ثقہ قرار دیا ہے   اس میں ضعف پایا جاتا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"7826"," ابن ابوملیکہ بیان کرتے ہیں : جب مکہ فتح ہوا تو عکرمہ بن ابوجہل بھاگ کر سمندری سفر پر چلے گئے سمندر میں طغیانی آ گئی تو ملاحوں اور سمندر میں موجود لوگوں نے اللہ تعالیٰ کو پکارنا شروع کیا اور اس سے مدد مانگنا شروع کی ، عکرمہ بن ابوجہل نے کہا : یہ کیا معاملہ ہے آ ان لوگوں نے کہا : یہ ایسی جگہ ہے "" جہاں صرف اللہ تعالیٰ نفع دے سکتا ہے ، تو عکرمہ نے کہا : وہ "" تو حضرت محمد ﷽ کا معبود ہے جس کی طرف وہ ہمیں دعوت دیتے ہیں ، تم لوگ ہمیں واپس بھیج دو ! پھر وہ لوگ واپس آ گئے انہوں نے واپس آ کے اسلام قبول کر لیا ان کی اہلیہ پہلے ہی اسلام قبول کر چکی تھیں ، تو وہ دونوں اپنے نکاح پر برقرار ہے ۔ یہ روایت امام طبرانی نے نقل کی ہے ۔ یہ روایت مرسل ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"7827"," امام شعبی بیان کرتے ہیں : نبی اکرم ﷽ کی صاحبزادی سیدہ زینب رضی اللہ عنہا نے اسلام قبول کر لیا تھا ان کے شوہر ابوالعاص بن ربیع مشرک تھے پھر بعد میں انہوں نے بھی اسلام قبول کر لیا تو ان دونوں نے نکاح کی تجدید نہیں کی ۔ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی جابر جعفی ہے "" اور وہ ضعیف ہے ویسے اس کی توثیق کی گئی ہے ۔"
"7828"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : زمانہ جاہلیت میں کوئی شخص اپنی بیوی سے یہ کہتا تھا : تم میرے لئے میری ماں کی پشت کی مانند ہو "" تو وہ عورت اس شخص پر حرام ہو جاتی تھی اسلام میں سب سے پہلا ظہار ایک شخص نے کیا جس کی بیوی اس کی چچازاد تھی اس کی بیوی کا نام خویلہ تھا "" اس شخص نے اس خاتون کے ساتھ ظہار کر لیا "" پھر اس سے خلاف ورزی ہو گئی "" اس نے کہا یہ عورت مجھ پر حرام ہو چکی ہے اس عورت نے بھی اس سے اس کی مانند کہا تو اس شخص نے کہا تم نبی اکرم ﷽ کے پاس جاا اور نبی اکرم ﷽ سے اس بارے میں دریافت کرو وي خاتون نبی اکرم ﷽ کی خدمت میں حاضر ہوئی اور نبی اکرم ﷽ سے اس بارے میں شکایت کی "" تو اللہ تعالیٰ نے یہ آیت نازل کی :  تو اللہ تعالیٰ نے اس عورت کی بات سن لی ہے جو تمہارے ساتھ اپنے شوہر کے بارے میں بات کر رہی ہے "" اور اللہ تعالیٰ سے شکایت کر رہی ہے """"۔  یہ آیت یہاں تک ہے :"""" تم دونوں کے ایک دوسرے کو مس کرنے سے پہلے غلام آزاد کرنا ہو گا """"۔ "
"7829"," ابوسلمہ اور محمد بن عبدالرحمن بن ثوبان بیان کرتے ہیں : سلمان بن صخر بیاضی نے اپنی بیوی کو اپنے لئے اپنی ماں کی پشت کی مانند قرار دیدیا اگر وہ اس کے ساتھ صحبت کریں + تو ان کی بیوی ان کے لئے ماں کی پشت کی مانند ہو , اور ایسا اس وقت تک رہے "" جب تک رمضان گزر نہیں جاتا جب نصف رمضان گزر گیا تو اسی دوران وہ خاتون صحت مند ہو گئی ایک دن وہ انہیں اچھی لگی "" تو انہوں نے رات کے وقت اس خاتون کے ساتھ صحبت کر لی پھر وہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے "" اور نبی اکرم ﷽ کو اس بارے میں بتایا تو نبی اکرم ﷽ نے فرمایا : تم غلام آزاد کرو اس نے کہا میرے پاس نہیں ہے ۔ نبی اکرم  ﷽ نے فرمایا : تم دو ماہ کے مسلسل روزے رکھو انہوں نے کہا میں   اس کی استطاعت نہیں رکھتا نبی اکرم ﷽ نے فرمایا : تم ساٹھ مسکینوں کو کھانا کھلاا اس نے عرض کی : مجھے اس کی گنجائش نہیں ملتی پھر نبی اکرم ﷽ کے پاس ایک برتن آیا جس میں پندرہ صاع یا شاید سولہ صاع کھجوریں تھیں نبی اکرم ﷽ نے فرمایا : تم یہ لو ! اور یہ ساٹھ مسکینوں کو صدقہ کر دو ۔ "
"7830"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : زمانہ جاہلیت میں ظہار یہ ہوتا تھا کہ عورت کو آدمی حرام قرار دیدیتا تھا اسلام میں سب سے پہلا ظہار حضرت اوس بن صامت رضی اللہ عنہ نے کیا ان کی اہلیہ خویلہ بنت خویلد تھی وہ ایک کمزور شخص تھے اور وہ خاتون مضبوط   جسم کی مالک تھیں جب ان صاحب نے ظہار کے بارے میں کلام کیا ، تو انہوں نے یہ کہا : میں یہ سجھتا ہوں کہ اب تم مجھ پر حرام ہو چکی ہو تم نبی اکرم ﷽ کی خدمت میں جاا ہو سکتا کہ تم کوئی ایسی صورت پا لو کہ نبی اکرم ﷽ تمہیں میری طرف واپس کر دیں وہ خاتون چلی گئی اور وہ صاحب کنویں کے دونوں کناروں کے پاس بیٹھ کر اس خاتون کی واپسی کا انتظار کرنے لگے وہ خاتون نبی اکرم ﷽ کی خدمت   میں حاضر ہوئی اس وقت کوئی خاتون نبی اکرم ﷽ کے سر میں کنگھی پھیر رہی تھیں اس خاتون نے عرض کی : یا رسول اللہ ! حضرت اوس بن صامت رضی اللہ عنہ کی رائے کی کمزوری اور ان کی عاجزی جس کے بارے میں آپ جانتے ہیں یا رسول اللہ ! اس کی وجہ سے انہوں نے میرے ساتھ ظہار کر لیا ہے وہ اس بات کے زیادہ حق دار ہیں کہ ان کے ساتھ بھلائی کی جائے "" لیکن یا رسول اللہ ! وہ میرے ساتھ ظہار کر چکے ہیں ، تو اب میں کوئی ایسی صورت چاہتی ہوں جس کے ذریعے میں واپس ان کے پاس چلی جااں میرے ماں باپ آپ پر قربان ہوں نبی اکرم ﷽   نے فرمایا : اے خویلہ ! تمہارے معاملے میں ہمیں کوئی حکم نہیں دیا گیا   اگر ہمیں حکم دیا جائے گا "" تو میں تمہیں بتا دوں گا ابھی وہ خاتون   نبی اکرم ﷽ کے سر کے ایک حصے کی کنگھی کر کے فارغ ہوئی تھیں   اور دوسرے حصے کی کنگھی کرنی شروع کی تھی کہ اسی دوران اللہ تعالیٰ نے نبی اکرم ﷽ پر وحی نازل کرنا شروع کی جب نبی اکرم ﷽ پر وحی نازل ہوتی تھی ، تو آپ کے چہرہ مبارک کا رنگ اس کی وجہ سے تبدیل   ہو جاتا تھا یہاں تک کہ آپ اس کی ٹھنڈک محسوس کرتے تھے جب آپ کی یہ کیفیت ختم ہوتی ، تو آپ کا چہرہ مبارک "" چاندی کے کنگن کی طرح سفید ہو جاتا اور پھر نبی اکرم ﷽ وہ کلام کرتے جو آپ کو وحی میں حکم دیا گیا ہوتا تھا کنگھی کرنے والی خاتون نے کہا : اے خویلہ ! میرا خیال ہے اس وقت نبی اکرم ﷽ پر تمہارے بارے میں وحی نازل ہو رہی ہے "" تو خویلہ پریشان ہو گئیں اور وہ گھبرا گئیں پھر انہوں نے کہا : اے اللہ ! میں اس بات سے تیری پناہ مانگتی ہوں کہ "" تو بھلائی کے علاوہ کچھ نازل کرے "" کیونکہ میں تیرے رسول سے صرف بھلائی حاصل کرنا چاہتی ہوں جب نبی اکرم ﷽ کی یہ کیفیت ختم ہوئی ، تو آپ نے ارشاد فرمایا : اے خویلہ ! اللہ تعالیٰ نے تمہارے اور تمہارے شوہر کے بارے میں حکم نازل کر دیا ہے پھر نبی اکرم ﷽ نے یہ آیت تلاوت کی :   """" اللہ تعالیٰ نے اس عورت کی بات سن لی ہے جو اپنے شوہر کے بارے میں تمہارے ساتھ بات چیت کر رہی تھی اور اللہ تعالیٰ کی بارگاہ میں شکایت کر رہی تھی اللہ تعالیٰ تم دونوں کی گفتگو کو سن رہا تھا """"۔  یہ آیت یہاں تک ہے :   """" پھر وہ پلٹنا چاہیں اس چیز سے "" جو انہوں نے کہا ہے "" تو ان دونوں کے ایک دوسرے کے مس کرنے سے پہلے غلام آزاد کرنا ہو گا """"۔  اس خاتون نے عرض کی : یا رسول اللہ ! ان صاحب کے پاس میرے علاوہ اور کوئی خدمت گزار نہیں ہے "" اور میرے پاس بھی ان کے علاوہ اور کوئی خدمت گزار نہیں ہے ۔ نبی اکرم ﷽ نے یہ آیت پڑھی :   """" تو جو شخص یہ گنجائش نہ پائے وہ دو ماہ مسلسل روزے رکھے """"۔  اس خاتون نے عرض کی : اللہ کی قسم ! یا رسول اللہ ! اگر وہ ایک دن میں دو مرتبہ کھانا نہ کھائیں ، تو ان کی بینائی کمزور ہو جاتی ہے ۔ نبی اکرم ﷽ نے یہ حصہ تلاوت کیا † جو اس کی بھی استطاعت نہیں رکھتا وہ ساٹھ مسکینوں کو کھانا کھلائے """"۔  اس خاتون نے عرض کی : اللہ کی قسم ! آج ہمارے پاس اتنی گنجائش نہیں ہے ۔ نبی اکرم ﷽ نے فرمایا : تم اس شخص سے کہو کہ وہ فلاں شخص کے پاس جائے "" اور اس سے کھجوروں کا نصف وسق وصول کر کے   اسے ساٹھ مسکینوں کو صدقہ کر دے اور پھر تم سے رجوع کر لے   وہ خاتون کہتی ہیں : میں واپس آئی جب ان صاحب نے مجھے دیکھا تو دریافت کیا : کیا بنا آ میں نے کہا : بہتر ہے "" آپ غریب ہیں ، تو آپ کو یہ حکم دیا گیا ہے آپ فلاں شخص کے پاس جائیں اور اس سے نصف وسق لے کر ساٹھ مسکینوں کو صدقہ کر دیں اور پھر مجھ سے رجوع کر لیں ، تو وہ صاحب تیزی سے چلتے ہوئے گئے "" اور وہ کھجوریں اٹھا کے لے آئے وہ خاتون بیان کرتی ہیں حالانکہ اس سے پہلے ان کی یہ صورت حال تھی کہ وہ کمزوری کی وجہ سے اپنی پشت پر کھجوروں کے پانچ صاع بھی نہیں اٹھا سکتے تھے ۔ "
"7831"," حضرت ابوہریرہ رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے اپنی ازواج کے ساتھ لاتعلقی اختیار کر لی شعبہ کہتے ہیں : میرا خیال ہے روایت میں یہ الفاظ ہیں : ایک ماہ کے لئے لاتعلقی اختیار کی حضرت عمر بن خطاب رضی اللہ عنہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے نبی اکرم ﷽ اس   وقت بالا خانے میں چٹائی پر موجود تھے اور چٹائی کا نشان آپ کی پشت پر لگا ہوا تھا حضرت عمر رضی اللہ عنہ نے عرض کی : یا رسول اللہ ! کسری سونے اور چاندی کے برتنوں میں پیتے ہیں اور آپ کی یہ حالت ہے ۔ نبی اکرم ﷽ نے ارشاد فرمایا : انہیں ان کی بہترین چیزیں دنیاوی زندگی میں دیدی گئی ہیں پھر نبی اکرم ﷽ نے ارشاد فرمایا : مہینہ اتنا اور اتنا ہوتا ہے  یعنی کبھی انتیس دن کا بھی ہوتا ہے تیسری مرتبہ میں نبی اکرم ﷽ نے انگوٹھا نیچے کر لیا ۔   یہ روایت امام احمد نے نقل کی ہے ۔ اس کی سند میں ایک راوی دااد بن فراہیج ہے "" جسے ابن حبان نے ثقہ قرار دیا ہے یحیی بن معین اور دیگر حضرات نے اسے ضعیف کہا ہے ۔"
"7832"," حضرت عبداللہ بن عباس رضی اللہ عنہما کے بارے میں یہ بات منقول ہے   وہ بیان کرتے ہیں : میں چاہتا تھا کہ میں حضرت عمر بن خطاب رضی اللہ عنہ سے اللہ تعالیٰ کے اس فرمان کے بارے میں دریافت کروں :   """" اگر ان دونوں نے اس بارے میں ایک دوسرے کی اعانت کی """"۔  لیکن میں ان سے ہیبت زدہ تھا یہاں تک کہ میں ان کے ساتھ حج کرنے کے لئے گیا میں نے سوچا کہ اگر میں نے اس حج کے دوران ان سے دریافت نہ کیا "" تو پھر ان سے کبھی نہیں پوچھ سکوں گا "" جب ہم نے حج مکمل کر لیا تو میں ایک مرتبہ ان کے پاس پہنچا وہ اس وقت """" مر ‟ کے نشیبی حصے میں موجود تھے اور قضائے حاجت کے لئے پیچھے رہ گئے تھے انہوں نے فرمایا : اے اللہ کے رسول کے چچازاد ! تمہیں خوش آمدید ہے تمہیں کیا کام ہے میں نے کہا : ایک چیز ہے جس کے بارے میں "" میں آپ سے پوچھنا چاہ رہا تھا اے امیر المامنین ! لیکن میں آپ سے ہیبت زدہ بھی تھا حضرت عمر رضی اللہ عنہ نے فرمایا : تم جو چاہو اس کے بارے میں دریافت کرو کیونکہ ہمیں بھی کسی چیز کا اس وقت تک علم نہیں ہوا جب تک ہم نے اسے سیکھا نہیں میں نے کہا : آپ مجھے اللہ تعالیٰ کے اس فرمان کے بارے میں بتائیے """" اگر ان دونوں نے """" ان دونوں خواتین سے مراد کون ہیں آ حضرت عمر رضی اللہ عنہ نے فرمایا : تم کسی ایسے شخص سے دریافت نہیں کرو گے "" جو اس بارے میں مجھ سے زیادہ بہتر جانتا ہو جب ہم لوگ مکہ میں رہا کرتے تھے "" تو ہم میں سے کوئی ایک شخص اپنی بیوی کے ساتھ کلام نہیں کیا کرتا تھا وہ عورت گھر کی نوکرانی ہوتی تھی جب آدمی کو اس سے حاجت ہوتی تھی ، تو اس کے پاس آ کر اپنی حاجت پوری کر لیتا تھا جب ہم لوگ مدینہ منورہ آئے "" تو ہماری بیویوں نے انصار کی خواتین سے سیکھنا شروع کیا انہوں نے ہمارے ساتھ بات چیت کرنا اور ہمیں جواب دینا شروع کر دیا میں نے ایک مرتبہ لڑکوں کو کوئی کام کہا تو میری بیوی نے کہا بلکہ آپ اس کو اس اس طرح کر لیں میں چھڑی لے کر اس کی طرف بڑھا میں نے وہ چھڑی اسے ماری "" تو اس نے کہا : اے خطاب کے صاحبزادے ! آپ پر حیرت ہوتی ہے آپ یہ چاہتے ہیں آپ کے ساتھ کلام نہ کیا جائے حالانکہ نبی اکرم ﷽ کی ازواج آپ ﷽ کے ساتھ کلام کر لیتی ہیں میں نکلا اور میں حفصہ کے پاس آیا اور میں نے کہا : اے میری بیٹی ! تم اس بات کا دھیان رکھنا کہ تم اللہ کے رسول کے ساتھ کلام نہ کرنا اور نبی اکرم ﷽ سے کوئی چیز نہ مانگنا کیونکہ نبی اکرم ﷽ کے پاس نہ دینار ہوتے ہیں اور نہ درہم ہوتے ہیں جو وہ تمہیں دیں اگر تمہیں کسی چیز کی ضرورت ہو یہاں تک کہ اگر سر میں لگانے کے لئے تیل کی بھی ضرورت ہو "" تو تم مجھے کہہ دینا ۔ "
"7833"," حضرت عبداللہ بن عباس رضی اللہ عنہما فرماتے ہیں : زمانہ جاہلیت کا ایلاء ایک یا دو سال کے لئے ہوتا تھا ، پھر اللہ تعالیٰ نے  اس کے لئے مدت متعین کر دی "" تو جس شخص کا ایلاء چار ماہ سے کم ہو گا وہ ایلا نہیں ہو گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7834"," حضرت ابوموسی اشعری رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے   اس شخص کے بارے میں یہ فرمایا ہے جو اپنی بیوی سے ایلاء کرتا ہے کہ اگر وہ شخص چاہے "" تو چار ماہ میں اس عورت سے رجوع کر سکتا ہے "" اور اگر وہ طلاق دینے کا پختہ ارادہ کر لیتا ہے "" تو عورت پر عدت کے حوالے سے وہ چیز لازم ہو گی جو طلاق یافتہ عورت پر لازم ہوتی ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی یوسف بن خالد سمتی ہے "" اور وہ ضعیف ہے ۔"
"7835"," ابراہیم بیان کرتے ہیں : ایک شخص جس کا نام عبداللہ بن انیس تھا اس نے اپنی بیوی کے ساتھ ایلاء کر لیا اس شخص کے اس عورت کے ساتھ صحبت کرنے سے پہلے چار ماہ گزر گئے پھر چار ماہ گزرنے کے بعد اس شخص نے اس عورت کے ساتھ صحبت کر لی اسے اپنی قسم یاد نہیں تھی پھر وہ علقمہ بن قیس کے پاس آیا اور ان کے سامنے یہ بات ذکر کی وہ دونوں حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آئے "" اور ان سے اس بارے میں دریافت کیا ، تو حضرت عبداللہ بن مسعود رضی اللہ عنہ نے فرمایا : وہ عورت تم سے بائنہ ہو چکی ہے اب تم اس عورت کو نئے سرے سے شادی کا پیغام دو اس شخص نے اس عورت کو نئے سرے سے شادی کا پیغام دیا اور اسے چاندی کا ایک رطل کے طور پر دیا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند کے رجال صحیح کے رجال ہیں ، البتہ یہ سند منقطع ہے "" کیونکہ ابراہیم نے  حضرت عبداللہ بن مسعود رضی اللہ عنہ کا زمانہ نہیں پایا ہے ۔"
"7836"," وبرہ "" اپنے خاندان کے ایک شخص کے حوالے سے یہ بات نقل کرتے ہیں کہ انہوں نے اپنی بیوی کے ساتھ دس دن کے لئے ایلاء کیا انہوں نے اس بارے میں حضرت عبداللہ بن مسعود رضی اللہ عنہ سے دریافت کیا "" تو انہوں نے فرمایا : جب چار ماہ گزر جائیں ، تو وہ ایلاء ہوتا ہے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایسا راوی ہے جس کا نام بیان نہیں کیا گیا ہے ۔"
"7837"," عبدالرحمن بن اسود بیان کرتے ہیں : ان کے ایک چازاد نے اپنی بیوی سے دس دن کے لئے ایلاء کر لیا پھر وہ کہیں ۔ چلا گیا جب وہ واپس آیا تو اس دوران چار ماہ دس دن گزر چکے تھے اس نے اس دوران اپنی بیوی کے ساتھ صحبت کر لی پھر اس کی ملاقات ایک شخص سے ہوئی اس شخص نے اسے اس کی قسم یاد دلوائی "" تو وہ حضرت عبداللہ بن مسعود رضی اللہ عنہ کے پاس آیا اور ان سے اس بارے میں دریافت کیا ، تو حضرت عبداللہ بن مسعود رضی اللہ عنہ نے اس سے حلف لیا کہ مجھے اس بات کا علم نہیں تھا پھر انہوں نے اس کی بیوی کو پیغام بھیجا اور اس سے بھی اللہ کے نام کا حلف لیا کہ اسے بھی اس بارے میں علم نہیں تھا پھر حضرت عبداللہ رضی اللہ عنہ نے اس شخص کو یہ ہدایت کی کہ وہ اس عورت کو نئے سرے سے شادی کا پیغام دے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور وبرہ بن عبدالرحمن نامی شخص نے حضرت عبداللہ بن مسعود رضی اللہ عنہ سے سماع نہیں کیا ہے ""  اور لیث بن ابوسلیم نامی راوی مدلس ہے ۔"
"7838"," ابوقلابہ بیان کرتے ہیں : نعمان نامی صاحب نے اپنی بیوی کے ساتھ ایلاء کر لیا وہ حضرت عبداللہ بن مسعود رضی اللہ عنہ کے ساتھ بیٹھے ہوئے تھے ۔ حضرت عبداللہ رضی اللہ عنہ رضی اللہ عنہ نے ان کے زانوں پر ہاتھ مارا اور بولے : جب چار ماہ گزر جائیں گے "" تو تم ایک طلاق کا اعتراف کر لینا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں "" البتہ ابوقلابہ نامی راوی نے حضرت عبداللہ بن مسعود رضی اللہ عنہ کا زمانہ نہیں پایا ہے ۔"
"7839"," قتادہ بیان کرتے ہیں : حضرت علی رضی اللہ عنہ حضرت عبداللہ بن عباس   رضی اللہ عنہما اور حضرت عبداللہ بن مسعود رضی اللہ عنہ یہ فرماتے ہیں :  جب چار ماہ گزر جائیں گے "" تو یہ طلاق دینا شمار ہو گا "" اور عورت اپنی ذات کا زیادہ حق رکھے گی ۔   حضرت علی رضی اللہ عنہ اور حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : وہ طلاق یافتہ عورت کی طرح عدت گزارے گی ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ قتادہ نامی شخص نے حضرت علی رضی اللہ عنہ کا اور حضرت عبداللہ بن مسعود رضی اللہ عنہ کا زمانہ نہیں پایا ہے اس نے حضرت عبداللہ بن عباس رضی اللہ عنہما سے سماع بھی نہیں کیا ہے اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"7840"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : جب یہ آیت نازل ہوئی :"""" اور وہ لوگ جو پاکدامن عورتوں پر الزام عائد کرتے ہیں پھر چار گواہ نہیں لے کے آتے ہیں ، تو انہیں اسی کوڑے لگاا اور ان کی گواہی کبھی قبول نہ کرنا یہی لوگ فاسق ہیں ‟۔  تو حضرت سعد بن عبادہ رضی اللہ عنہ جو انصار کے سردار تھے انہوں نے عرض کی : یا رسول اللہ ! کیا یہ اسی طرح نازل ہوئی ہے آ نبی اکرم ﷽ نے ارشاد فرمایا : اے انصار کے گروہ ! کیا تم سن رہے ہو تمہارا سردار کیا کہہ رہا ہے آ لوگوں نے عرض کی : یا رسول اللہ !   آپ انہیں ملامت نہ کریں یہ ایک غیور شخص ہیں اللہ کی قسم ! انہوں نے ہمیشہ کسی کنواری خاتون کے ساتھ ہی شادی کی اور جب بھی انہوں نے کسی خاتون کو طلاق دی "" تو ہم میں سے کوئی شخص یہ جرات نہیں کر سکا کہ اس خاتون کے ساتھ شادی کر لے ایسا ان کے مزاج کی شدت کی وجہ سے ہے حضرت سعد رضی اللہ عنہ نے عرض کی : یا رسول اللہ اللہ کی قسم ! میں یہ بات جانتا ہوں یہ بات حق ہے "" اور یہ اللہ تعالیٰ کی طرف سے ہے "" لیکن مجھے اس بات پر حیرانگی ہو رہی ہے کہ اگر میں یہ صورت حال پاتا ہوں کوئی شخص میری بیوی کے قریب جا چکا ہو ""   اور میں اسے ڈرااں گا نہیں اور میں اسے حرکت نہیں دوں گا پہلے چار گواہ لے کے آاں گا اللہ کی قسم ! جب تک میں چار گواہ لے کے آاں گا اتنی دیر میں وہ اپنی ضرورت پوری کر چکا ہو گا راوی کہتے ہیں "" پھر تھوڑا ہی عرصہ گزرنے کے بعد ہلال بن امیہ آئے جو ان تین افراد میں سے ایک تھے جن کی "" توبہ قبول ہوئی تھی وہ رات کے وقت اپنی زمین سے واپس آئے "" تو انہوں نے اپنی بیوی کے پاس ایک شخص کو پایا انہوں نے اپنی دونوں آنکھوں کے ذریعے یہ بات دیکھی اور دونوں کانوں کے ذریعے یہ بات سنی "" لیکن انہوں نے صبح ہونے تک اس شخص کو نہیں للکارا اگلے دن وہ نبی اکرم ﷽ کی خدمت میں حاضر ہوئے "" اور عرض کی : یا رسول اللہ ! رات کے وقت میں اپنی بیوی کے پاس آیا تو میں نے اس کے پاس ایک شخص کو پایا میں نے یہ چیز اپنی آنکھوں کے ذریعے دیکھی اور اپنے کانوں کے ذریعے سنی نبی اکرم ﷽   کو اس کی دی ہوئی اطلاع ناگوار گزری اور آپ کے لئے یہ بات گرانی کا باعث ہوئی انصار اکٹھے ہوئے "" اور انہوں نے کہا حضرت سعد بن عبادہ رضی اللہ عنہ نے جو کہا تھا اس کے حوالے سے اب ہم آزمائش کا   شکار ہو گئے ہیں ۔ نبی اکرم ﷽ ہلال بن امیہ کی پٹائی کروائیں گے "" اور مسلمانوں میں ان کی گواہی کو کالعدم قرار دیں گے حلال نے کہا : اللہ کی قسم ! مجھے یہ امید ہے کہ اللہ تعالیٰ میرے لئے اس سے نکلنے کی گنجائش بنا دے گا حلال نے عرض کی : یا رسول اللہ ! میں یہ سمجھتا ہوں جو میں اطلاع لے کے آیا ہوں وہ آپ پر گراں گزری ہے "" لیکن اللہ کی قسم ! میں سچا ہوں ۔ راوی کہتے ہیں : اللہ کی قسم ! نبی اکرم ﷽ نے یہ ارادہ کر لیا تھا ان کی پٹائی کرنے کا حکم دیں اسی دوران نبی اکرم ﷽ پر وحی نازل ہونا شروع ہوئی جب آپ پر وحی نازل ہونا شروع ہوتی تھی ، تو آپ کی جلد کی رنگت کی تبدیلی کی وجہ سے لوگ اس کو پہچان لیتے تھے "" تو لوگ رک گئے "" یہاں تک کہ جب وحی ختم ہوئی "" تو یہ آیت نازل ہوئی :   """" وہ لوگ جو اپنی بیویوں پر الزام عائد کرتے ہیں اور ان کے پاس گواہ کے طور پر صرف ان کا اپنا وجود ہوتا ہے """"۔  اس کے بعد راوی نے پوری حدیث ذکر کی ہے ۔ "
"7841"," حضرت حذیفہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا : اے ابوبکر ! اس بارے میں تمہارا کیا خیال ہے کہ اگر تم ام رومان کے ساتھ کسی شخص کو پاتے ہو "" تو تم کیا کرو گے آ انہوں نے کہا میں اس کے ساتھ برا سلوک کروں گا پھر نبی اکرم ﷽ نے دریافت کیا : اے عمر ! تمہارا اس بارے میں کیا خیال ہے کہ اگر تم کسی شخص کو پاتے ہو "" تو تم کیا کرو گے ۔ انہوں نے عرض کی :   اللہ کی قسم ! میں اس شخص کو قتل کر دوں گا ۔ نبی اکرم ﷽ نے فرمایا : اے سہیل بن بیضاء ! تم کیا کرو گے ۔ انہوں نے عرض کہا اللہ تعالیٰ اس نالائق پر لعنت کرے کیونکہ وہ خبیث ہے "" اور اللہ تعالیٰ اس نالائق عورت پر لعنت کرے کیونکہ وہ خبیث عورت ہے "" تو اللہ تعالیٰ تینوں میں سے پہلے پر لعنت کرے جس نے اس کا ذکر کیا ہو "" تو نبی اکرم ﷽ نے ارشاد فرمایا : اے ابن بیضاء ! تم نے قرآن کے اس حکم پر عمل کیا ہے :   """" وہ لوگ جو اپنی بیویوں پر الزام عائد کرتے ہیں ۔۔۔۔۔۔۔۔۔۔""""   یہ روایت امام طبرانی نے معجم اوسط میں اپنے استاد موسیٰ بن اسحاق کے حوالے سے نقل کی ہے ۔ میں ان سے واقف نہیں ہوں ۔  اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"7842"," حضرت عاصم بن عدی رضی اللہ عنہ بیان کرتے ہیں : وہ نبی اکرم ﷽ کے پاس موجود تھے جب یہ آیت نازل ہوئی :   """" پھر وہ چار گواہ نہیں لے کے آتے ‟۔  میں نے عرض کی : پہلے وہ چار گواہ لے کے آئے گا اس دوران "" خبیث شخص ، تو اپنی حاجت پوری کر لے گا راوی کہتے ہیں : ابھی وہ صاحب اٹھے نہیں تھے ان کے چچازاد جو ان کے والد کے بھائی کے بیٹے تھے وہ آ گئے ان کے ساتھ ان کی بیوی بھی تھی جس نے ایک بچے کو اٹھایا ہوا تھا وہ عورت یہ کہہ رہی تھی کہ یہ بچہ تمہارا ہے "" اور وہ صاحب یہ کہہ رہے تھے یہ بچہ میرا نہیں ہے "" تو لعان سے متعلق آیات نازل ہو گئیں ۔ راوی کہتے ہیں : میں اس کے بارے میں کلام کرنے والا پہلا فرد تھا "" اور میں ہی اس حوالے سے سب سے پہلے آزمائش کا شکار ہوا ۔ "
"7843"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : انصار سے تعلق رکھنے والے ایک شخص نے """" بالعجلان """" سے تعلق رکھنے والی ایک عورت کے ساتھ شادی کر لی اس نے رات اس عورت کے ساتھ گزاری اگلے دن صبح اس نے اس عورت کو پایا کہ وہ کنواری نہیں تھی ان دونوں کا معاملہ نبی اکرم ﷽ کے سامنے پیش کیا گیا نبی اکرم ﷽ نے اس لڑکی کو بلوایا   تو اس نے عرض کی : جی ہاں میں کنواری تھی پھر نبی اکرم ﷽ نے ان دونوں کے بارے میں حکم دیا ان دونوں نے لعان کیا نبی اکرم ﷽ نے اس عورت کو مہر دلوا دیا ۔   یہ روایت امام بزار نے نقل کی ہے ۔ اور اس کے رجال ثقہ ہیں ۔"
"7844"," امام طبرانی بیان کرتے ہیں : سیدہ خولہ بنت عاصم لعان کرنے والی وہ خاتون تھیں نبی اکرم ﷽ نے جس کی اس کے شوہر سے علیحدگی کروا دی تھی ۔"
"7845"," ابن جریج بیان کرتے ہیں : حضرت علی رضی اللہ عنہ اور حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : اگر عورت کا شوہر اس پر زنا کا الزام لگائے "" اور اس کو طلاق دیدے اور وہ ایسی طلاق ہو جس میں شوہر کو عورت کے ساتھ رجوع کا حق ہو "" تو پھر وہ دونوں میاں بیوی لعان کریں گے لیکن مرد نے عورت پر الزام عائد کیا ہو اور پھر اسے طلاق بتہ دیدی ہو "" تو پھر مرد عورت کے ساتھ لعان نہیں کرے گا ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کی سند منقطع ہے "" اور اس کے رجال صحیح کے رجال ہیں ۔"
"7846"," حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : لعان کرنے والے کبھی اکٹھے نہیں ہوں گے ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی قیس بن ربیع ہے "" جسے شعبہ اور دیگر حضرات نے ثقہ قرار دیا ہے اس میں ضعف پایا جاتا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔  اس سے پہلے حضرت علی رضی اللہ عنہ اور حضرت عبداللہ بن مسعود رضی اللہ عنہ کے حوالے سے یہ بات گزر چکی ہے کہ لعان کرنے والی عورت کے بیٹے کا عصبہ وہی ہو گا "" جو اس کی ماں کا عصبہ ہو گا "" اور وہ عورت ہی اس بچے کی وارث ہو گی اور وہ بچہ اس عورت کا وارث ہو گا ۔"
"7847"," سعد بن معبد بیان کرتے ہیں : یحنس اور صفیہ یہ خمس میں سے تھے اس عورت نے بچے کو جنم دیا زنا کرنے والے ایک شخص نے اور یحنس نے اس بچے کے بارے میں دعوی کر دیا ان دونوں نے اپنا مقدمہ حضرت عثمان غنی رضی اللہ عنہ کے سامنے پیش کیا حضرت عثمان رضی اللہ عنہ نے ان دونوں کو حضرت علی بن ابوطالب رضی اللہ عنہ کے حوالے کر دیا ۔ "
"7848"," حضرت سعد بن ابی وقاص رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ نے یہ فیصلہ دیا ہے : بچہ فراش والے کو ملے گا ۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی عبدالعزیز بن عمران ہے "" اور وہ متروک ہے ۔"
"7849"," حضرت عبداللہ بن عمر رضی اللہ عنہما نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :   """" بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کو محرومی ملے گی """"۔   یہ روایت امام بزار نے نقل کی ہے ۔ اس کی سند میں ایک راوی سنان بن حارث ہے جس سے میں واقف نہیں ہوں ۔ اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7850"," حسن بصری بیان کرتے ہیں : مجھ تک یہ روایت پہنچی ہے کہ نبی اکرم ﷽ نے یہ فیصلہ دیا ہے بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کے منہ میں پتھر ہوں گے ۔   یہ روایت امام احمد نے مرسل روایت کے طور پر نقل کی ہے ۔ اور اس کے رجال صحیح کے رجال ہیں ۔"
"7851"," زمعہ کی صاحبزادی بیان کرتی ہیں : میں نبی اکرم ﷽ کی خدمت میں حاضر ہوئی میں نے عرض کی : میرے والد کا انتقال ہو گیا ہے انہوں نے اپنی اْم ولد چھوڑی ہے ہم اس عورت کے بارے میں یہ سمجھتے ہیں اس عورت کے کسی شخص کے ساتھ تعلقات ہیں اس عورت نے ایک بچے کو جنم دیا تو اس کا بچہ اس شخص کے ساتھ مشابہت رکھتا ہے جس کے بارے میں ہمارا گمان تھا اس کے ساتھ اس کے تعلقات ہیں راوی کہتے ہیں : تو نبی اکرم ﷽ نے اس خاتون سے کہا : تم اس لڑکے سے پردہ کرو وہ تمہارا بھائی نہیں ہے "" البتہ اسے وارثت ملے گی ۔   یہ روایت امام احمد نے نقل کی ہے ۔ اس میں تابعی کا نام ذکر نہیں کیا گیا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7852"," سیدہ زینب اسدیہ رضی اللہ عنہا بیان کرتی ہیں : میں نبی اکرم ﷽ کی خدمت میں حاضر ہوئی میں نے عرض کی : یا رسول اللہ ! میرے والد کا انتقال ہو گیا ہے ۔ انہوں نے ایک کنیز چھوڑی تھی جس نے ایک بچے کو جنم دیا ہم اس کنیز پر تہمت عائد کرتے ہیں ۔ نبی اکرم ﷽ نے فرمایا : اسے میرے پاس لے کے آا جب وہ لوگ اس بچے کو لے کے آئے "" اور نبی اکرم ﷽ نے اس کی طرف دیکھا تو نبی اکرم ﷽ نے اس عورت سے فرمایا : اس بچے کو وراثت ملے گی لیکن تم اس سے پردہ کرنا ۔ یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی قاسم بن محمد بن ابوشیبہ ہے "" اور وہ ضعیف ہے ۔"
"7853"," محمد بن اسحاق بیان کرتے ہیں : نصر بن حجاج بن علاط سلمی نے حضرت خالد بن ولید کے غلام عبداللہ بن رباح کے بارے میں دعوی کر دیا تو حضرت خالد بن ولید رضی اللہ عنہ کے صاحبزادے عبدالرحمن اٹھے اور بولے : یہ میرا غلام ہے جو میرے والد کے فراش پر پیدا ہوا ہے نصر بن حجاج نے کہا : یہ میرے بھائی نے اس کے بارے میں مجھے تلقین کی تھی راوی کہتے ہیں : جب ان دونوں کا جھگڑا زیادہ ہو گیا تو یہ اس کو ساتھ لے کر حضرت معاویہ رضی اللہ عنہ کے پاس گئے جن کے سر کے نیچے ایک پتھر موجود تھا ، اْن دونوں نے اپنا اپنا دعویٰ پیش کیا "" تو حضرت معاویہ رضی اللہ عنہ نے بتایا کہ میں نے نبی اکرم ﷽ کو یہ ارشاد فرماتے ہوئے سنا ہے :   """" بچہ فراش والے کو ملتا ہے "" اور زنا کرنے والے کو محرومی ملتی ہے """"۔   اس پر نصر بن حجاج نے کہا : اے معاویہ ! پھر زیاد کے بارے میں آپ نے یہ فیصلہ کیوں نہیں دیا آ حضرت معاویہ رضی اللہ عنہ نے کہا :   اللہ کے رسول کا فیصلہ "" معاویہ کے فیصلے سے بہتر ہے عبداللہ بن رباح نے نسر بن حجاج کے دعوے کا کوئی جواب نہیں دیا تو نصر نے یہ اشعار کہے : "
"7854"," حضرت عبداللہ بن عباس رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کو محرومی ملے گی """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی یحیی   بن عباد سعدی ہے "" اور وہ ضعیف ہے دااد بن شبیب کہتے ہیں : وہ نیک لوگوں میں سے تھے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"7855"," حضرت براء بن عازب رضی اللہ عنہ اور حضرت زید بن ارقم رضی اللہ عنہ بیان کرتے ہیں : غدیر خم کے دن ہم نبی اکرم ﷽ کے ساتھ تھے ہم آپ کے سر سے درخت کی ٹہنیاں ہٹا رہے تھے ۔ نبی اکرم ﷽ نے ارشاد فرمایا :   """" بے شک میرے لئے "" اور میرے اہل بیت کے لئے صدقہ حلال نہیں ہے اللہ تعالیٰ اس شخص پر لعنت کرے جو اپنے باپ کے علاوہ کسی اور کی طرف خود کو منسوب کرتا ہے "" اور اللہ تعالیٰ اس شخص پر بھی لعنت کرے جو اپنے آزاد کرنے والے آقا کی بجائے کسی اور کی طرف خود کو منسوب کرتا ہے بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کو محرومی ملے گی اور وارث کے لئے وصیت نہیں ہو گی """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی موسیٰ بن عثمان حضرمی ہے "" اور وہ ضعیف ہے ۔"
"7856","وَعَنْ جَابِرٍ قَالَ: """" «مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى رَجُلٍ مِنْ أَهْلِ الْجَنَّةِ، فَلْيَنْظُرْ إِلَى الْحُسَيْنِ بْنِ عَلِيٍّ """".\nفَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَقُولُهُ».\nرَوَاهُ أَبُو يَعْلَى، وَرِجَالُهُ رِجَالُ الصَّحِيحِ غَيْرَ الرَّبِيعِ بْنِ سَعْدٍ، وَقِيلَ: ابْنُ سَعِيدٍ، وَهُوَ ثِقَةٌ."
"7857"," حضرت عبداللہ بن زبیر رضی اللہ عنہما بیان کرتے ہیں : نبی اکرم ﷽ نے زمعہ کی کنیز کے بیٹے کو وراثت دی تھی کیونکہ وہ زمعہ کے فراش پر پیدا ہوا تھا ۔ "
"7858"," حضرت عبادہ بن صامت رضی اللہ عنہ بیان کرتے ہیں : نبی اکرم ﷽ کے فیصلے میں یہ بات بھی شامل ہے کہ بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کو محرومی ملے گی ۔   یہ روایت امام طبرانی نے اور امام احمد نے ایک طویل حدیث میں نقل کی ہے ۔ اور اس کی سند منقطع ہے ۔"
"7859"," حضرت ابومسعود رضی اللہ عنہ بیان کرتے ہیں : میں حج اکبر کے دن نبی اکرم ﷽ کے سامنے موجود تھا آپ کی اونٹنی کا جھاگ میرے اوپر گر رہا تھا میں نے آپ کو یہ ارشاد فرماتے ہوئے سنا :   """" ہر حق دار کو اس کا حق ادا کر دو بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کو محرومی ملے گی جو شخص اپنے آقا کی بجائے کسی اور کی طرف نسبت ولاء قائم کرے یا اپنے باپ کے علاوہ کسی اور کی طرف نسبت کا دعوی کرے اس پر اللہ تعالی فرشتوں اور انسانوں سب کی لعنت ہو گی اس کی کوئی فرض یا نفل عبادت قبول نہیں ہو گی """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اور اس کی سند میں ایسا راوی ہے جو معروف نہیں ہے ۔"
"7860"," حضرت واثلہ بن اسقع رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :   """" بچہ فراش والے کو ملے گا زنا کرنے والے کو محرومی ملے گی عورت کو اس بات کا اختیار نہیں ہے کہ وہ اپنے مال میں سے کچھ بھی خرچ کرے البتہ اپنے شوہر کی اجازت کے ساتھ وہ ایسا کر سکتی ہے """"۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ اس کی سند میں ایک راوی جناح ہے جو ولید کا غلام ہے "" اور وہ ضعیف ہے ۔"
"7861"," ابووائل بیان کرتے ہیں : حضرت عبداللہ بن حذافہ رضی اللہ عنہ نے عرض کی : یا رسول اللہ ! میرا باپ کون ہے آ نبی اکرم ﷽ نے ارشاد فرمایا : تمہارا باپ حذافہ ہے بچہ فراش والے کو ملے گا "" اور زنا کرنے والے کو محرومی ملے گی انہوں نے عرض کی : اگر آپ نے میرے نسب کی نسبت کسی حبشی شخص کی طرف کی ہوتی "" تو میں نے اس کے پیچھے چلے جانا تھا بعد میں ان کی والدہ نے کہا :  تم نے مجھے نشانہ بنایا تھا انہوں نے کہا میں یہ چاہتا تھا کہ میں اطمینان حاصل کر لوں ۔   یہ روایت امام طبرانی نے نقل کی ہے ۔ یہ روایت مرسل ہے "" اور اس کے رجال ثقہ ہیں ۔"
"7862"," حضرت عبداللہ بن عمر رضی اللہ عنہما روایت کرتے ہیں : نبی اکرم ﷽ نے ارشاد فرمایا :"""" جو شخص اپنی اولاد کی نفی کر دے تاکہ اسے دنیا میں رسوائی کا شکار کرے "" تو اللہ تعالیٰ قیامت کے دن سب لوگوں کی موجودگی میں اسے رسوا کرے گا قصاص کا بدلہ قصاص ہو گا ‟۔   یہ روایت امام احمد نے اور امام طبرانی نے معجم کبیر اور معجم اوسط میں نقل کی ہے ۔ امام طبرانی کے رجال صحیح کے رجال ہیں صرف عبداللہ بن احمد کا معاملہ مختلف ہے وہ ثقہ اور امام ہیں ۔"
"7863"," حضرت معاذ بن انس رضی اللہ عنہ نبی اکرم ﷽ کا یہ فرمان نقل کرتے ہیں :  %% بے شک اللہ تعالیٰ کے کچھ بندے ایسے ہیں جن کے ساتھ اللہ تعالیٰ قیامت کے دن کلام نہیں کرے گا "" اور ان کا تزکیہ نہیں کرے گا "" اور ان کی طرف نظر رحمت نہیں کرے گا عرض کی گئی : یا رسول اللہ ! وہ کون لوگ ہیں آ نبی اکرم ﷽ نے فرمایا : اپنے والدین سے لاتعلقی کا اظہار   کر کے ان سے منہ موڑنے والا اپنی اولاد سے لاتعلقی کا اظہار کرنے والا اور وہ شخص جس پر کسی قوم نے انعام کیا ہو اور وہ ان کی نعمت کا انکار کرے اور ان سے لاتعلقی کا اظہار کرے """"۔   یہ روایت امام احمد اور امام طبرانی نے نقل کی ہے ۔ اور یہ الفاظ زائد   نقل کیے ہیں :   """" ان لوگوں کے لئے درد ناک عذاب ہو گا """"۔  اس روایت کی سند میں ایک راوی زبان بن فائد ہے "" جسے امام احمد اور یحیی بن معین نے ضعیف قرار دیا ہے ۔ ابوحاتم کہتے ہیں : یہ صالح ہے ۔"
