hadiths[49]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3701","«شارب الخمر كعابد وثن وشارب الخمر كعابد اللات والعزى»","صحيح","Sahih al-Jami al-Saghir 3701","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3702","«شاهت الوجوه»","صحيح","Sahih al-Jami al-Saghir 3702","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3703","«شاهداك أو يمينه»","صحيح","Sahih al-Jami al-Saghir 3703","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3704","«شرار أمتي الثرثارون المتشدقون المتفيهقون وخيار أمتي أحاسنهم أخلاقا»","حسن","Sahih al-Jami al-Saghir 3704","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3705","«شرار أمتي الذين غذوا بالنعيم الذين يأكلون ألوان الطعام ويلبسون ألوان الثياب ويتشدقون في الكلام»","حسن","Sahih al-Jami al-Saghir 3705","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3706","«شر الطعام طعام الوليمة يمنعها من يأتيها ويدعى إليها من يأباها ومن لا يجب الدعوة فقد عصى الله ورسوله»","صحيح","Sahih al-Jami al-Saghir 3706","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3707","«شر الكسب مهر البغي وثمن الكلب وكسب الحجام»","صحيح","Sahih al-Jami al-Saghir 3707","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3708","«شر الناس الذي يسأل بالله ثم لا يعطي»","صحيح","Sahih al-Jami al-Saghir 3708","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3709","«شر ما في رجل شح هالع وجبن خالع»","صحيح","Sahih al-Jami al-Saghir 3709","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3710","«شرف المؤمن صلاته بالليل وعزه استغناؤه عما في أيدي الناس»","حسن","Sahih al-Jami al-Saghir 3710","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3711","«شعبان بين رجب وشهر رمضان تغفل الناس عنه ترفع فيه أعمال العباد فأحب أن لا يرفع عملي إلا وأنا صائم»","حسن","Sahih al-Jami al-Saghir 3711","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3712","«شعبتان لا تتركهما أمتي: النياحة والطعن في الأنساب»","صحيح","Sahih al-Jami al-Saghir 3712","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3713","«شفاء عرق النسا ألية شاة أعرابية تذاب ثم تجزأ ثلاثة أجزاء ثم تشرب على الريق كل يوم جزء»","صحيح","Sahih al-Jami al-Saghir 3713","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3714","«شفاعتي لأهل الكبائر من أمتي»","صحيح","Sahih al-Jami al-Saghir 3714","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3715","«شمت أخاك ثلاثا فما زاد فإنما هي نزلة أو زكام»","حسن","Sahih al-Jami al-Saghir 3715","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3716","«شهداء الله في الأرض أمناء الله على خلقه قتلوا أو ماتوا»","صحيح","Sahih al-Jami al-Saghir 3716","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3717","«شهدت غلاما مع عمومتي حلف المطيبين فما يسرني أن لي حمر النعم وأني أنكثه»","صحيح","Sahih al-Jami al-Saghir 3717","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3718","«شهر الصبر وثلاثة أيام من كل شهر صوم الدهر»","صحيح","Sahih al-Jami al-Saghir 3718","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3719","«شهران لا ينقصان شهرا عيد: رمضان وذو الحجة»","صحيح","Sahih al-Jami al-Saghir 3719","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3720","«شيبتني هود وأخواتها»","صحيح","Sahih al-Jami al-Saghir 3720","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3721","«شيبتني هود وأخواتها قبل المشيب»","صحيح","Sahih al-Jami al-Saghir 3721","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3722","«شيبتني هود وأخواتها من المفصل»","صحيح","Sahih al-Jami al-Saghir 3722","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3723","«شيبتني هود والواقعة والمرسلات وعم يتساءلون وإذا الشمس كورت»","صحيح","Sahih al-Jami al-Saghir 3723","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3724","«شيطان يتبع شيطانة» - يعني حمامة -","صحيح","Sahih al-Jami al-Saghir 3724","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3725","«الشاة من دواب الجنة»","صحيح","Sahih al-Jami al-Saghir 3725","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3726","«الشام أرض المحشر والمنشر»","صحيح","Sahih al-Jami al-Saghir 3726","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3727","«الشؤم في ثلاثة: في المرأة والمسكن والدابة»","صحيح","Sahih al-Jami al-Saghir 3727","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3728","«الشاهد يرى ما لا يرى الغائب»","صحيح","Sahih al-Jami al-Saghir 3728","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3729","«الشرك الخفي أن يعمل الرجل لمكان الرجل»","حسن","Sahih al-Jami al-Saghir 3729","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3730","«الشرك في أمتي أخفى من دبيب النمل على الصفا»","صحيح","Sahih al-Jami al-Saghir 3730","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3731","«الشرك فيكم أخفى من دبيب النمل وسأدلك على شيء إذا فعلته أذهب عنك صغار الشرك وكباره تقول: اللهم إني أعوذ بك أن أشرك بك وأنا أعلم وأستغفرك لما لا أعلم تقولها ثلاث مرات» .","صحيح","Sahih al-Jami al-Saghir 3731","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3732","«الشريك أحق بصقبه ما كان»","صحيح","Sahih al-Jami al-Saghir 3732","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3733","«الشعر بمنزلة الكلام فحسنه كحسن الكلام وقبيحه كقبيح الكلام»","صحيح","Sahih al-Jami al-Saghir 3733","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3734","«الشفاء في ثلاثة: شربة عسل وشرطة محجم وكية نار وأنهى أمتي عن الكي»","صحيح","Sahih al-Jami al-Saghir 3734","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3735","«الشفعة في كل شرك في الأرض أو ربع أو حائط لا يصلح له أن يبيع حتى يعرض على شريكه فيأخذ أو يدع فإن أبي فشريكه أحق به حتى يؤذنه»","صحيح","Sahih al-Jami al-Saghir 3735","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3736","«الشفعة فيما لم تقع فيه الحدود فإذا وقعت الحدود فلا شفعة»","صحيح","Sahih al-Jami al-Saghir 3736","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3737","«الشمس والقمر يكوران يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3737","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3738","«الشونيز دواء من كل داء إلا السام وهو الموت»","صحيح","Sahih al-Jami al-Saghir 3738","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3739","«الشهادة سبع سوى القتل في سبيل الله المقتول في سبيل الله شهيد: والمطعون شهيد والغريق شهيد وصاحب ذات الجنب شهيد والمبطون شهيد وصاحب الحريق شهيد والذي يموت تحت الهدم شهيد والمرأة تموت بجمع شهيدة»","صحيح","Sahih al-Jami al-Saghir 3739","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3740","«الشهداء الذين يقاتلون في سبيل الله في الصف الأول ولا يلتفتون بوجوههم حتى يقتلوا فأولئك يلقون في الغرف العلا من الجنة يضحك إليهم ربك إن الله تعالى إذا ضحك إلى عبده المؤمن فلا حساب عليه»","صحيح","Sahih al-Jami al-Saghir 3740","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3741","«الشهداء خمسة: المطعون والمبطون والغريق وصاحب الهدم والشهيد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 3741","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3742","«الشهداء على بارق نهر بباب الجنة في قبة خضراء يخرج عليهم رزقهم من الجنة بكرة وعشيا»","حسن","Sahih al-Jami al-Saghir 3742","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3743","«الشهر تسع وعشرون فلا تصوموا حتى تروه ولا تفطروا حتى تروه فإن غم عليكم فأكملوا العدة ثلاثين»","صحيح","Sahih al-Jami al-Saghir 3743","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3744","الشهر يكون تسعة وعشرين ويكون ثلاثين فإذا رأيتموه فصوموا وإذا رأيتموه فأفطروا فإن غم عليكم فأكملوا العدة","صحيح","Sahih al-Jami al-Saghir 3744","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3745","«الشهيد لا يجد ألم القتل إلا كما يجد أحدكم مس القرصة»","صحيح","Sahih al-Jami al-Saghir 3745","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3746","«الشهيد لا يجد مس القتل إلا كما يجد أحدكم القرصة يقرصها»","صحيح","Sahih al-Jami al-Saghir 3746","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3747","«الشهيد يشفع في سبعين من أهل بيته»","صحيح","Sahih al-Jami al-Saghir 3747","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3748","«الشيب نور المؤمن لا يشيب رجل شيبة في الإسلام إلا كانت له بكل شيبة حسنة ورفع بها درجة»","حسن","Sahih al-Jami al-Saghir 3748","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
"3749","«الشيخ يضعف جسمه؛ وقلبه شاب على حب اثنتين؛ طول الحياة وحب المال»","حسن","Sahih al-Jami al-Saghir 3749","","","الأحاديث المبدوءة بحرف الشين Hadith Beginning with the Letter Shin (ش)"
