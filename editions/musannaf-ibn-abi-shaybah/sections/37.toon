hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"36073","(۳۶۰۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، عَن عَبْدِالرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّہُ کَانَ یَقْرَأُ الْقُرْآنَ فِی سَبْعٍ۔","","Musannaf Ibn Abi Shaybah 36073","","","كتاب الزهد"
"36074","(۳۶۰۷۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنِ الأَعْمَشِ، عَنْ شِمْرٍ، عَنْ زِیَادِ بْنِ حُدَیْرٍ، قَالَ: مَا فَقِہَ قَوْمٌ لَمْ یَبْلُغُوا التُّقَی۔","","Musannaf Ibn Abi Shaybah 36074","","","كتاب الزهد"
"36075","(۳۶۰۷۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ أَبِی صَخْرَۃَ ، قَالَ : قَالَ زِیَادُ بْنُ حُدَیْرٍ : لَوَدِدْت أَنِّی فِی حَیِّزٍ مِنْ حَدِیدٍ وَمَعِی مَا یُصْلِحُنِی لاَ أُکَلِّمُ ، وَلاَ یُکَلِّمُونِی۔","","Musannaf Ibn Abi Shaybah 36075","","","كتاب الزهد"
"36076","(۳۶۰۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، عَنِ الْحَارِثِ بْنِ قَیْسٍ ، قَالَ : إذَا کُنْتَ فِی شَیْئٍ مِنْ أَمْرِ الدُّنْیَا فَتَوحَّ ، وَإِذَا کُنْت فِی شَیْئٍ مِنْ أَمْرِ الآخِرَۃِ فَامْکُثْ مَا اسْتَطَعْت ، وَإِذَا جَائَک الشَّیْطَانُ وَأَنْتَ تُصَلِّی، فَقَالَ : إنَّک تُرَائِی ، فَزِدْ وَأَطِلْ۔","","Musannaf Ibn Abi Shaybah 36076","","","كتاب الزهد"
"36077","(۳۶۰۷۷) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الأَعْمَشِ ، قَالَ : قَالَ خَیْثَمَۃُ : تَجْلِسُ أَنْتَ وَإِبْرَاہِیمُ فِی الْمَسْجِدِ وَیُجْتَمَعُ عَلَیْکُمْ ، قَدْ رَأَیْت الْحَارِثَ بْنَ قَیْسٍ إذَا اجْتَمَعَ عِنْدَہُ رَجُلاَنِ قَامَ وَتَرَکَہُمَا۔","","Musannaf Ibn Abi Shaybah 36077","","","كتاب الزهد"
"36078","(۳۶۰۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَلِیِّ بْنِ الأَ قْمَرِ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : إنْ کَانَ الرَّجُلُ لَیَطْرُقُ الْفُسْطَاطَ ، قَالَ : فَیَجِدُ لَہُمْ دَوِیًّا کَدَوِیِّ النَّحْلِ ، فَمَا بَالُ ہَؤُلاَئِ یَأْمَنُونَ مَا کَانَ أُولَئِکَ یَخَافُونَ۔","","Musannaf Ibn Abi Shaybah 36078","","","كتاب الزهد"
"36079","(۳۶۰۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ اللہِ بْنِ رَبِیعَۃَ ، قَالَ : قَالَ عُتْبَۃُ بْنُ فَرْقَدٍ لِعَبْدِ اللہِ بْنِ رَبِیعَۃَ : یَا عَبْدَ اللہِ ، أَلاَ تُعِینُنِی عَلَی ابْنِ أَخِیک ، قَالَ : وَمَا ذَاکَ ، قَالَ : یُعِینُنِی عَلَی مَا أَنَا فِیہِ مِنْ عَمَلٍ ، فَقَالَ لَہُ عَبْدُ اللہِ : یَا عَمْرُو ، أَطِعْ أَبَاک ، قَالَ : فَنَظَرَ إِلَی مِعَضَدٍ وَہُوَ جَالِسٌ ، فَقَالَ : لاَ تُطِعْہُم {وَاسْجُدْ وَاقْتَرِبْ} قَالَ : فَقَالَ عَمْرٌو : یَا أ[corrupt]بَتِ ، إِنِی إنَّمَا أَنَا عَبْدٌ أَعْمَلُ فِی فِکَاکِ رَقَبَتِی ، قَالَ : فَبَکَی عُتْبَۃُ ، وَقَالَ : یَا بُنَیَّ إنِّی لأُحِبُّک حُبَّیْنِ : حُبًّا لِلَّہِ وَحُبَّ الْوَالِدِ وَلَدَہُ ، قَالَ : فَقَالَ : عَمْرٌو : یَا أَبَتِ ، إنَّک کُنْت أَتَیْتنِی بِمَالٍ بَلَغَ سَبْعِینَ أَلْفًا ، فَإِنْ کُنْت سَائِلِی عَنْہُ فَہُوَ ذَا فَخُذْہُ ، وَإِلاَّ فَدَعْنِی فَأَمْضِیہ ، قَالَ لَہُ : عُتْبَۃُ فَأَمْضِہِ ، قَالَ : فَأَمْضَاہُ حَتَّی مَا بَقِیَ مِنْہُ دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 36079","","","كتاب الزهد"
"36080","(۳۶۰۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : حَدَّثَنَا عُمَارَۃُ ، قَالَ : خَرَجْنَا مَعَنَا أَہْلٌ لِشُرَیْحِ بْنِ ہَانِیئٍ إِلَی مَکَّۃَ ، فَخَرَجَ مَعَنَا یُشَیِّعْنَا ، قَالَ : فَکَانَ فِیمَا قَالَ لَنَا : أَجِدُّوا السَّیْرَ فَإِنَّ رُکْبَانَکُمْ لاَ تُغْنِی عَنْکُمْ مِنَ اللہِ شَیْئًا ، وَمَا فَقَدَ الرَّجُلُ مِنَ الدُّنْیَا شَیْئًا أَہْوَنَ عَلَیْہِ مِنْ نَفْسِہِ تَرَکَہَا ، قَالَ عُمَارَۃُ : فَمَا ذَکَرْتہَا مِنْ قَوْلِہِ إِلاَّ انْتَفَعْت بِہَا۔","","Musannaf Ibn Abi Shaybah 36080","","","كتاب الزهد"
"36081","(۳۶۰۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ مَاہَانَ یَقُولُ : أَمَا یَسْتَحْیِی أحَدُکُمْ أَنْ تَکُونَ دَابَّتُہُ الَّتِی یَرْکَبُ وَثَوْبُہُ الَّذِی یَلْبَسُ أَکْثَرَ لِلَّہِ مِنْہُ ذِکْرًا ، فَکَانَ لاَ یَفْتُرُ مِنَ التَّکْبِیرِ وَالتَّہْلِیلِ۔","","Musannaf Ibn Abi Shaybah 36081","","","كتاب الزهد"
"36082","(۳۶۰۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ مُؤَذِّنِ بَنِی حَنِیفَۃَ ، قَالَ : رَأَیْتُ مَاہَانَ الْحَنَفِیَّ وَأَمَرَ بِہِ الْحَجَّاجُ أَنْ یُصْلَبَ عَلَی بَابِہِ ، قَالَ : فَنَظَرْت إلَیْہِ وَإِنَّہُ لَعَلَی الْخَشَبَۃِ وَہُوَ یُسَبِّحُ وَیُکَبِّرُ وَیُہَلِّلُ وَیَحْمَدُ اللَّہَ حَتَّی بَلَغَ تِسْعًا وَعِشْرِینَ ، فَعَقَدَ بِیَدِہِ فَطَعَنَہُ وَہُوَ عَلَی ذَلِکَ الْحَالِ ، فَلَقَدْ رَأَیْت بَعْدَ شَہْرٍ تِسْعًا وَعِشْرِینَ بِیَدِہِ، قَالَ : وَکَانَ یُرَی عِنْدَہُ الضَّوْئُ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 36082","","","كتاب الزهد"
"36083","(۳۶۰۸۳) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ أَبُو الْبَخْتَرِیِّ رَجُلاً رَقِیقًا ، وَکَانَ یَسْمَعُ النَّوْحَ وَیَبْکِی۔","","Musannaf Ibn Abi Shaybah 36083","","","كتاب الزهد"
"36084","(۳۶۰۸۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی الْبَخْتَرِیِّ فِی قَوْلِہِ : {اتَّخَذُوا أَحْبَارَہُمْ وَرُہْبَانَہُمْ أَرْبَابًا مِنْ دُونِ اللہِ} قَالَ : أَطَاعُوہُمْ فِیمَا أَمَرُوہُمْ بِہِ مِنْ تَحْلِیلِ حَرَامٍ ، وَتَحْرِیمِ حَلاَلِ اللہ فَعَبَدُوہُمْ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 36084","","","كتاب الزهد"
"36085","(۳۶۰۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنِی مِسْعَرٌ ، عَنْ أَبِی الَعَنْبَسِ ، قَالَ : قَالَ أَبُو الْبَخْتَرِیِّ : لأَنْ أَکُونَ فِی قَوْمٍ أَعْلَمَ مِنِّی أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ فِی قَوْمٍ أَنَا أَعْلَمُہُمْ۔","","Musannaf Ibn Abi Shaybah 36085","","","كتاب الزهد"
"36086","(۳۶۰۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدثنا سَعِیدُ بْنُ صَالِحٍ أُخْبِرْنَا ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ أَبُو الْبَخْتَرِیِّ : ثَلاَثَۃٌ لأَنْ أَخِرَّ مِنَ السَّمَائِ أَحَبُّ إلَیَّ مِنْ أَکُونَ أَحَدَہُمْ : قَوْمٌ اسْتَحَلُّوا أَحَادِیثَ لَہَا زِینَۃٌ وَبَہْجَۃٌ ، وَسَئِمُوا الْقُرْآنَ ، وَقَوْمٌ أَطَاعُوا الْمَخْلُوقَ فِی مَعْصِیَۃِ الْخَالِقِ ، یَعْنِی أَہْلَ الشَّامِ وَالْخَوَارِجَ۔","","Musannaf Ibn Abi Shaybah 36086","","","كتاب الزهد"
"36087","(۳۶۰۸۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، أَنَّ أَبَا الْبَخْتَرِیِّ وَأَصْحَابَہُ کَانُوا إذَا سَمِعَ أَحَدَہُمْ یُثْنِی عَلَیْہِ ، أَوْ دَخَلَہُ عُجْبٌ ثَنَی مَنْکِبَیْہِ ، وَقَالَ : خَشَعْت لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 36087","","","كتاب الزهد"
"36088","(۳۶۰۸۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : إنَّ الأَرْضَ لَتَفْقِدُ الْمُؤْمِنَ ، وَإِنَّ الْبِقَاعَ لَتُزَیَّنُ لِلْمُؤْمِنِ إذَا أَرَادَ أَنْ یُصَلِّیَ۔","","Musannaf Ibn Abi Shaybah 36088","","","كتاب الزهد"
"36089","(۳۶۰۸۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : کَانَ یُقَالَ : بَادِرُوا بِالْعَمَلِ أَرْبَعًا: بِالْحَیَاۃِ قَبْلَ الْمَمَاتِ ، وَبِالصِّحَّۃِ قَبْلَ السَّقَمِ ، وَبِالْفَرَاغِ قَبْلَ الشُّغْلِ ، وَلَمْ أَحْفَظِ الرَّابِعَۃَ۔","","Musannaf Ibn Abi Shaybah 36089","","","كتاب الزهد"
"36090","(۳۶۰۹۰) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ فِی قَوْلِہِ : {لَنْ تَنَالُوا الْبِرَّ} قَالَ : الْبِرُّ الْجَنَّۃُ۔","","Musannaf Ibn Abi Shaybah 36090","","","كتاب الزهد"
"36091","(۳۶۰۹۱) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، عَن عَمْرِو بْنِ مَیْمُونٍ، قَالَ: کَانَ یُوتَدُ لَہُ فِی حَائِطِ الْمَسْجِد، وَکَانَ إذَا سَئِمَ مِنَ الْقِیَامِ فِی الصَّلاَۃِ وَشَقَّ عَلَیْہِ أَمْسَکَ بِالْوَتِدِ یَعْتَمِدُ عَلَیْہِ ، أَوْ یُرْبَطُ لَہُ حَبْلٌ فَیَمْسِکُ بِہِ۔","","Musannaf Ibn Abi Shaybah 36091","","","كتاب الزهد"
"36092","(۳۶۰۹۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ شُعْبَۃَ، عَنْ أَبِی إِسْحَاقَ، قَالَ: حجَّ عَمْرُو بْنُ مَیْمُونٍ سِتِّینَ مِنْ بَیْنِ حَجَّۃٍ وَعُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 36092","","","كتاب الزهد"
"36093","(۳۶۰۹۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا أَبُو سِنَانٍ ، قَالَ : حَدَّثَنَا أَبُو إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ فِی قَوْلِہِ {ذَلِکَ بِأَنَّہُمْ کَرِہُوا مَا أَنْزَلَ اللَّہُ فَأَحْبَطَ أَعْمَالَہُمْ} قَالَ : الْفَرَائِضُ۔","","Musannaf Ibn Abi Shaybah 36093","","","كتاب الزهد"
"36094","(۳۶۰۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عِفَاقٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : إِنَّہُ لَیُسْمَعُ بَیْنَ جِلْدِ الْکَافِرِ وَلَحْمِہِ جَلَبَۃُ الدُّودِ کَجَلَبَۃِ الْوَحْشِ۔","","Musannaf Ibn Abi Shaybah 36094","","","كتاب الزهد"
"36095","(۳۶۰۹۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَنَشٍ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ وَلَہُ ہَمْہَمَۃٌ۔","","Musannaf Ibn Abi Shaybah 36095","","","كتاب الزهد"
"36096","(۳۶۰۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بلج ، قَالَ : کَانَ عَمْرٌو إذَا لَقِیَ الرَّجُلَ مِنْ إخْوَانِہِ ، قَالَ : رَزَقَ اللَّہُ الْبَارِحَۃَ مِنَ الصَّلاَۃِ کَذَا ، وَرَزَقَ اللَّہُ الْبَارِحَۃَ مِنَ الْخَیْرِ کَذَا وَکَذَا۔ (حاکم ۵۲۷)","","Musannaf Ibn Abi Shaybah 36096","","","كتاب الزهد"
"36097","(۳۶۰۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی السَّوْدَائِ ، عَنِ الضَّحَّاکِ ، قَالَ : لَقَدْ رَأَیْتنَا ، وَمَا نَتَعَلَّمُ إِلاَّ الْوَرَعَ۔","","Musannaf Ibn Abi Shaybah 36097","","","كتاب الزهد"
"36098","(۳۶۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عُمَرَ بْنِ قَیْسٍ النَّاصِرِ ، عَنِ الضَّحَّاکِ ، قَالَ : أَدْرَکَنَا أَصْحَابُنَا، وَمَا یَتَعَلَّمُونَ إِلاَّ الْوَرَعَ۔","","Musannaf Ibn Abi Shaybah 36098","","","كتاب الزهد"
"36099","(۳۶۰۹۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَجْلَحِ ، قَالَ : قُلْتُ لِلضَّحَّاکِ : لِمَ سُمِّیَتْ سِدْرَۃَ الْمُنْتَہَی ، قَالَ : لأَنَّہُ یَنْتَہِی إلَیْہَا کُلُّ شَیْئٍ مِنْ أَمْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36099","","","كتاب الزهد"
"36100","(۳۶۱۰۰) حَدَّثَنَا عَمْرُو بْنُ سَعْدٍ أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : الرُّوحُ بِیَدِ مَلَکٍ یَمْشِی بِہِ ، فَإِذَا دَخَلَ قَبْرَہُ جَعَلَہُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 36100","","","كتاب الزهد"
"36101","(۳۶۱۰۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی یُصَلِّی ، فَإِذَا دَخَلَ الدَّاخِلُ أَتَی فِرَاشَہُ فَاتَّکَأَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36101","","","كتاب الزهد"
"36102","(۳۶۱۰۲) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : {لاَ یَرْہَقُ وُجُوہَہُمْ قَتَرٌ وَلاَ ذِلَّۃٌ} قَالَ : بَعْدَ نَظَرِہِمْ إِلَی رَبِّہِمْ۔","","Musannaf Ibn Abi Shaybah 36102","","","كتاب الزهد"
"36103","(۳۶۱۰۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : یَقُولُ الْمُشْرِکُونَ {یَا وَیْلَنَا مَنْ بَعَثَنَا مِنْ مَرْقَدِنَا} قَالَ : یَقُولُ الْمُؤْمِنُونَ : {ہَذَا مَا وَعَدَ الرَّحْمَن وَصَدَقَ الْمُرْسَلُونَ}۔","","Musannaf Ibn Abi Shaybah 36103","","","كتاب الزهد"
"36104","(۳۶۱۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : لَمْ یَکُنْ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَحَزِّقِینَ ، وَلاَ مُتَمَاوِتِینَ ، وَکَانُوا یَتَنَاشَدُونَ الشِّعْرَ فِی مَجَالِسِہِمْ ، وَیَذْکُرُونَ أَمْرَ جَاہِلِیَّتِہِمْ ، فَإِذَا أُرِیدَ أَحَدُہُمْ عَلَی شَیْئٍ مِنْ أَمْرِ دِینِہِ دَارَتْ حَمَالِیقُ عَیْنَیْہِ کَأَنَّہُ مَجْنُونٌ۔","Sahih","Musannaf Ibn Abi Shaybah 36104","","","كتاب الزهد"
"36105","(۳۶۱۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو قَالَ : حَدَّثَنَا أَبُو سَلَمَۃَ ، أَنَّ صُبْحَ یَوْمِ الْقِیَامَۃِ یَطُولُ تِلْکَ اللَّیْلَۃُ کَطُولِ ثَلاَثِ لَیَالٍ ، فَیَقُومُ الَّذِینَ یَخْشَوْنَ رَبَّہُمْ فَیُصَلُّونَ حَتَّی إذَا فَرَغُوا مِنْ صَلاَتِہِمْ رَجَعُوا فَنَامُوا حَتَّی تَکِلَّ جُنُوبُہُمْ ، ثُمَّ قَامُوا فَصَلَّوْا حَتَّی إذَا فَرَغُوا مِنْ صَلاَتِہِمْ أَصْبَحُوا یَنْظُرُونَ إِلَی الشَّمْسِ مِنْ مَطْلَعِہَا فَإِذَا ہِیَ قَدْ طَلَعَتْ مِنْ مَغْرِبِہَا۔","","Musannaf Ibn Abi Shaybah 36105","","","كتاب الزهد"
"36106","(۳۶۱۰۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، قَالَ : إنَّ مِنْ کَمَالِ التَّقْوَی أَنْ تَبْتَغِیَ إِلَی مَا عَلِمْت مِنْہَا عِلْمَ مَا لَمْ تَعْلَمْ ، وَاعْلَمْ أَنَّ النقص فِیمَا عَلِمْت تَرْکَ ابْتِغَائِ الزِّیَادَۃِ فِیہِ ، وَإِنَّمَا یُحْمَلُ الرَّجُلُ عَلَی تَرْکِ ابْتِغَائِ الزِّیَادَۃِ فِیمَا قَدْ عَلِمَ قِلَّۃَ الاِنْتِفَاعِ بِمَا قَدْ عَلِمَ۔","","Musannaf Ibn Abi Shaybah 36106","","","كتاب الزهد"
"36107","(۳۶۱۰۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَوْنٍ ، قَالَ : بِحَسْبِکَ مِنَ الْکِبْرِ أَنْ تَأْخُذَ بِفَضْلِکَ عَلَی غَیْرِک۔","","Musannaf Ibn Abi Shaybah 36107","","","كتاب الزهد"
"36108","(۳۶۱۰۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ، عَنْ عَوْنٍ، قَالَ: الذَّاکِرُ فِی الْغَافِلِینَ کَالْمُقَاتِلِ عَنِ الْفَارِّینَ، وَإِنَّ الْغَافِلَ فِی الذَّاکِرِینَ کَالْفَارِّ ، عَنِ الْمُقَاتِلِینَ۔","","Musannaf Ibn Abi Shaybah 36108","","","كتاب الزهد"
"36109","(۳۶۱۰۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَوْنٍ ، قَالَ : أَخْبَرَہُ بِالْعَفْوِ قَبْلَ الذَّنْبِ {عَفَا اللَّہُ عَنْک لِمَ أَذِنْت لَہُمْ} ۔","Hasan","Musannaf Ibn Abi Shaybah 36109","","","كتاب الزهد"
"36110","(۳۶۱۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْمَسْعُودِیُّ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، قَالَ : مَا أَحَدٌ یُنْزِلُ الْمَوْتَ حَقَّ مَنْزِلَتِہِ إِلاَّ عَبْدٌ عَدَّ غَدًا لَیْسَ مِنْ أَجَلِہِ ، کَمْ مِنْ مُسْتَقْبِلٍ یَوْمًا لاَ یَسْتَکْمِلُہُ ، وَرَاجٍ غَدًا لاَ یَبْلُغُہُ ، إنَّک لَوْ تَرَی الأَجَلَ وَمَسِیرَہُ لأَبْغَضْت الأَمَلَ وَغُرُورَہُ۔","","Musannaf Ibn Abi Shaybah 36110","","","كتاب الزهد"
"36111","(۳۶۱۱۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَوْنٍ ، قَالَ : کَانَ ، یُقَالَ : مَنْ أَحْسَنَ اللَّہُ صُورَتَہُ وَجَعَلَہُ فِی مَنْصِبٍ صَالِحٍ ، ثُمَّ تَوَاضَعَ لِلَّہِ کَانَ مِنْ خَالِصِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36111","","","كتاب الزهد"
"36112","(۳۶۱۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ {لِلَّذِینَ أَحْسَنُوا الْحُسْنَی وَزِیَادَۃٌ} قَالَ : النَّظَرُ إِلَی وَجْہِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36112","","","كتاب الزهد"
"36113","(۳۶۱۱۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : إنَّ اللَّہَ یَقُولُ : إنَّک یَا ابْنَ آدَمَ مَا عَبَّدْتنِی وَرَجَوْتنِی فَإِنِّی غَافِرٌ لَک عَلَی مَا کَانَ ، یَسْأَلُنِی عَبْدِی الْہُدَی وَکَیْفَ أضِلُّ عَبْدِی وَہُوَ یَسْأَلُنِی الْہُدَی وَأَنَا الْحَکَمُ۔","","Musannaf Ibn Abi Shaybah 36113","","","كتاب الزهد"
"36114","(۳۶۱۱۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : بَشِّرَ الْمَشَّائِینَ فِی ظُلَمِ اللَّیْلِ إِلَی الصَّلَوَاتِ بِنُورٍ تَامٍّ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 36114","","","كتاب الزهد"
"36115","(۳۶۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ سَمِعَہُ مِنَ ابْنِ سَابِطٍ : {وَإِنَّہُ فِی أُمِّ الْکِتَابِ لَدَیْنَا لَعَلِیٌّ حَکِیمٌ} قَالَ : فِی أُمِّ الْکِتَابِ کُلُّ شَیْئٍ ہُوَ کَائِنٌ إِلَی یَوْمِ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 36115","","","كتاب الزهد"
"36116","(۳۶۱۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ سَمِعْت الأَعْمَشَ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ مُرَّۃَ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : یُدَبِّرُ أَمْرَ الدُّنْیَا أَرْبَعَۃٌ : جَبْرَائِیلُ وَمِیکَائِیلُ وَإِسْرَافِیلُ وَمَلَکُ الْمَوْتِ ، فَأَمَّا جَبْرَائِیلُ فَصَاحِبُ الْجُنُودِ وَالرِّیحِ ، وَأَمَّا مِیکَائِیلُ فَصَاحِبُ الْقَطْرِ وَالنَّبَاتِ ، وَأَمَّا مَلَکُ الْمَوْتِ فَمُوَکَّلٌ بِقَبْضِ الأَنْفُسِ ، وَإِمَّا إسْرَافِیلُ فَہُوَ یَتَنَزَّلُ بِالأَمْرِ عَلَیْہِمْ بِمَا یُؤْمَرُونَ۔","","Musannaf Ibn Abi Shaybah 36116","","","كتاب الزهد"
"36117","(۳۶۱۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَیَّانَ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ التَّیْمِیَّ یَقُولُ: مَا عَرَضْت قَوْلِی عَلَی عَمَلِی إِلاَّ لَخَشِیت أَنْ أَکُونَ مُکَذِّبًا۔","","Musannaf Ibn Abi Shaybah 36117","","","كتاب الزهد"
"36118","(۳۶۱۱۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، قَالَ: سَمِعْتُ إبْرَاہِیمَ التَّیْمِیَّ یَقُولُ: اللَّہُمَّ إنَّا ضُعَفَائُ، مِنْ ضَعْفٍ خَلَقْتَنَا وَإِلَی ضَعْفٍ مَا نَصِیرُ ، فَمَا شِئْت لاَ مَا شِئْنَا ، فَشَأْ لَنَا أَنْ نَسْتَقِیمَ۔","","Musannaf Ibn Abi Shaybah 36118","","","كتاب الزهد"
"36119","(۳۶۱۱۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کَانَ مِنْ کَلاَمُہِ أَنْ یَقُولَ : أَیُّ حَسْرَۃٍ أَکْبَرُ عَلَی امْرِئٍ مِنْ أَنْ یَرَی عَبْدًا لہ کَانَ اللَّہُ خَوَّلَہُ فِی الدُّنْیَا وَہُوَ عِنْدَ اللہِ أَفْضَلُ مَنْزِلَۃً مِنْہُ یَوْمَ الْقِیَامَۃِ ، وَأَیُّ حَسْرَۃٍ عَلَی امْرِئٍ أَکْبَرُ مِنْ أَنْ یُؤْتِیَہُ اللَّہُ مَالاً فِی الدُّنْیَا فَیَرِثَہُ غَیْرُہُ فَیَعْمَلَ فِیہِ بِطَاعَۃِ اللہِ فَیَکُونَ وِزْرُہُ عَلَیْہِ وَأَجْرُہُ لِغَیْرِہِ ، وَأَیُّ حَسْرَۃٍ عَلَی امْرِئٍ أَکْبَرُ مِنْ أَنْ یَرَی عَبْدًا کَانَ مَکْفُوفَ الْبَصَرِ فِی الدُّنْیَا قَدْ فَتَحَ اللَّہُ لَہُ ، عَنْ بَصَرِہِ وَقَدْ عَمِیَ ہُوَ ، ثُمَّ یَقُولُ : إنَّ مَنْ کَانَ قَبْلَکُمْ کَانُوا یَفِرُّونَ مِنَ الدُّنْیَا وَہِیَ مُقْبِلَۃٌ عَلَیْہِمْ ، وَلَہُمْ مِنَ الْقِدَمِ مَا لَہُمْ ، وَإِنَّکُمْ تَتَّبِعُونَہَا وَہِیَ مُدْبِرَۃٌ عَنْکُمْ وَلَکُمْ مِنَ العذاب مَا لَکُمْ ، فَقِیسُوا أَمْرَکُمْ وَأَمْرَ الْقَوْمِ۔","","Musannaf Ibn Abi Shaybah 36119","","","كتاب الزهد"
"36120","(۳۶۱۲۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ : {وَیَأْتِیہِ الْمَوْتُ مِنْ کُلِّ مَکَان} قَالَ : حَتَّی مِنْ أَطْرَافِ شَعْرِہِ۔","","Musannaf Ibn Abi Shaybah 36120","","","كتاب الزهد"
"36121","(۳۶۱۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ {إنَّا ہُدْنَا إلَیْک} قَالَ : تُبْنَا۔","","Musannaf Ibn Abi Shaybah 36121","","","كتاب الزهد"
"36122","(۳۶۱۲۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یَرْتَدِی بِالرِّدَائِ یَبْلُغُ أَلْیَتَیْہِ مِنْ خَلْفِہِ وَثَدْیَیْہِ مِنْ بَیْنِ یَدَیْہِ ، قَالَ : قُلْتُ : یَا أَبَتِ ، لَوْ أَنَّک اتَّخَذْت رِدَائً أَوْسَعَ مِنْ رِدَائِک ہَذَا ، قَالَ : یَا بُنَی ، لاَ تَقُلْ ہَذَا ، فَوَاللہِ مَا عَلَی الأَرْضِ لُقْمَۃٌ لَقَمْتہَا طَیِّبَۃً إِلاَّ لَوَدِدْت لَوْ کَانَتْ فِی أَبْغَضِ النَّاسِ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 36122","","","كتاب الزهد"
"36123","(۳۶۱۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، قَالَ : خَرَجَ إِلَی الْبَصْرَۃِ فَاشْتَرَی رَقِیقًا بِأَرْبَعَۃِ آلاَفٍ ، قَالَ : فَبَنَوْا لَہُ دَارِہِ ، ثُمَّ بَاعَہُمْ بِرِبْحٍ أَرْبَعَۃِ آلاَفٍ ، قَالَ : فَقُلْتُ لَہُ : یَا أَبَتِ لَوْ أَنَّک عَمَدْت إِلَی الْبَصْرَۃِ فَاشْتَرَیْت مِثْلَ ہَؤُلاَئِ فَرَبِحْت فِیہِمْ ، فَقَالَ : لاَ تَقُلْ لِی ہَذَا ، فَوَاللہِ مَا فَرِحْت بِہَا حِینَ أَصَبْتہَا ، وَلاَ حَدَّثْت نَفْسِی بِأَنْ أَرْجِعَ فَأُصِیبَ مِثْلَہَا۔","","Musannaf Ibn Abi Shaybah 36123","","","كتاب الزهد"
"36124","(۳۶۱۲۴) حَدَّثَنَا عَبْدُالرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، عَنْ یَزِیدَ بْنِ شَجَرَۃَ، قَالَ: مَا مِنْ مَیِّتٍ یَمُوتُ حَتَّی یُمَثَّلَ لَہُ جُلَسَاؤُہُ عِنْدَ مَوْتِہِ ، إنْ کَانُوا أَہْلَ لَہْوٍ فَأَہْلُ لَہْوٍ ، وَإِنْ کَانُوا أَہْلَ ذِکْرٍ فَأَہْلُ ذِکْرٍ۔","","Musannaf Ibn Abi Shaybah 36124","","","كتاب الزهد"
"36125","(۳۶۱۲۵) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عن مجاہد عَنِ ابْنِ شَجَرَۃَ ، قَالَ : یَقُولُ الْقَبْرُ لِلرَّجُلِ الْکَافِرِ ، أَوِ الْفَاجِرِ : أَمَا ذَکَرْت ظُلْمَتِی ؟ أَمَا ذَکَرْت وَحْشَتِی ؟ أَمَا ذَکَرْت ضِیقِی ؟ أَمَا ذَکَرْت غَمِّی ؟۔","","Musannaf Ibn Abi Shaybah 36125","","","كتاب الزهد"
"36126","(۳۶۱۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ یَزِیدَ بْنِ شَجَرَۃَ ، قَالَ : کَانَ یَقُصُّ وَکَانَ یُصَدِّقُ فِعْلُہُ قَوْلَہُ۔","","Musannaf Ibn Abi Shaybah 36126","","","كتاب الزهد"
"36127","(۳۶۱۲۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عَمِّہِ ، عَنْ کُرْدُوسٍ ، قَالَ : کَانَ یَقُصُّ عَلَیْنَا غَدْوَۃً وَعَشِیَّۃً وَیَقُولُ : إنَّ الْجَنَّۃَ لاَ تُنَالُ إِلاَّ بِعَمَلٍ لَہَا ، اخْلِطُوا الرَّغْبَۃَ بِالرَّہْبَۃِ ، وَدُومُوا عَلَی صَلاَحٍ ، وَاتَّقُوا اللَّہَ بِقُلُوبٍ سَلِیمَۃٍ وَأَعْمَالٍ صَالِحَۃٍ ، وَیُکْثِرُ أَنْ یَقُولَ : مَنْ خَافَ أَدْلَجَ۔","","Musannaf Ibn Abi Shaybah 36127","","","كتاب الزهد"
"36128","(۳۶۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِی الزِّنْبَاعِ ، عَنْ أَبِی الدِّہْقَانِ ، قَالَ : بَیْنَمَا شَابٌّ یَمْشِی مَعَ الأَحْنَفِ ، فَقَالَ لَہُ : یَا ابْنَ أَخِی ، إذَا عُرِضَ لَک الْحَقُّ فَاقْصِدْ لَہُ وَالْہَ عَمَّا سِوَاہُ۔","","Musannaf Ibn Abi Shaybah 36128","","","كتاب الزهد"
"36129","(۳۶۱۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا حَبِیبُ بْنُ أَبِی ثَابِتٍ ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : کَانَ یُقَالَ : اعْمَلْ وَأَنْتَ مُشْفِقٌ وَدَعَ الْعَمَلَ وَأَنْتَ تَشْتَہِیہِ ، عَمَلٌ صَالِحٌ قَلِیلٌ تَدُومُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36129","","","كتاب الزهد"
"36130","(۳۶۱۳۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ یَحْیَی : إذَا سَجَدَ ، وَقَالَ ابْنُ مَہْدِیٍّ : إذَا وَضَعَ الرَّجُلُ جَبْہَتَہُ فَقَدْ بَرِئَ مِنَ الْکِبْرِ۔","","Musannaf Ibn Abi Shaybah 36130","","","كتاب الزهد"
"36131","(۳۶۱۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، قَالَ : سَمِعْتہمْ یَذْکُرُونَ ، عَنْ شُرَیْحٍ ، أَنَّہُ رَأَی جِیرَانًا لَہُ تَحَوَّلُوا ، فَقَالَ : مَا لَکُمْ ؟ قَالُوا : فَرَغْنَا ، قَالَ : وَبِہَذَا أُمِرَ الفارغ۔","","Musannaf Ibn Abi Shaybah 36131","","","كتاب الزهد"
"36132","(۳۶۱۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہَارُونَ بْنِ أَبِی إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إنَّ أَیْسَرَ النُّسُکِ اللِّبَاسُ وَالْمَشْیَۃُ۔","","Musannaf Ibn Abi Shaybah 36132","","","كتاب الزهد"
"36133","(۳۶۱۳۳) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حدَّثَنَا أَبُو سِنَانٍ ، قَالَ : اشْتَکَی عَبْدُ اللہِ بْنُ أَبِی الْہُذَیْلِ یَوْمًا ذُنُوبَہُ ، فَقَالَ لَہُ رَجُلٌ : یَا أَبَا الْمُغِیرَۃِ ، أَلَسْت التَّقِیَّ ، قَالَ : فَقَالَ : اللَّہُمَّ إنَّ عَبْدَک ہَذَا أَرَادَ أَنْ یَتَقَرَّبَ إلَیَّ وَإِنِّی أُشْہِدُک عَلَی مَقْتِہِ۔","","Musannaf Ibn Abi Shaybah 36133","","","كتاب الزهد"
"36134","(۳۶۱۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ ، قَالَ : أُتِیتُ فَقِیلَ لِی : قَدْ مَاتَ أَخُوک ، فَجِئْت سَرِیعًا وَقَدْ سُجِّیَ بِثَوْبِہِ ، فَأَنَا عِنْدَ رَأْسِ أَخِی أَسْتَغْفِرُ لَہُ وَأَسْتَرْجِعُ إذْ کُشِفَ الثَّوْبُ عَنْ وَجْہِہِ ، فَقَالَ : السَّلاَمُ عَلَیْکُمْ ، فَقُلْنَا : وَعَلَیْک السَّلاَمُ سُبْحَانَ اللہِ ، قَالَ : سُبْحَانَ اللہِ إنِّی قَدِمْت عَلَی اللہِ بَعْدَکُمْ فَتُلُقِّیت بِرَوْحٍ وَرَیْحَانٍ وَرَبٍّ غَیْرِ غَضْبَانَ ، وَکَسَانِی ثِیَابًا خُضْرًا مِنْ سُنْدُسٍ وَإِسْتَبْرَقٍ ، وَوَجَدْت الأَمْرَ أَیْسَرَ مِمَّا تَظُنُّونَ ، وَلاَ تَتَّکِلُوا ، وَإِنِّی أَسْتَأْذَنْت رَبِّی أن أُخْبِرُکُمْ وَأُبَشِّرُکُمْ ، احْمِلُونِی إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَإِنَّہُ عَہِدَ إلَیَّ أَنْ لاَ أَبْرَحَ حَتَّی آتِیَہُ ، ثُمَّ طَفِئَ مَکَانُہُ ، قَالَ : وَأَخَذَ حَصَاۃً فَرَمَی بِہَا ، قَالَ : فَمَا أَدْرِی أَہُوَ کَانَ أَسْرَعَ أَمْ ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 36134","","","كتاب الزهد"
"36135","(۳۶۱۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ ، قَالَ : کَانَ أَہْلُ الْخَیْرِ إذَا الْتَقَوْا یُوصِی بَعْضُہُمْ بَعْضًا بِثَلاَثٍ ، وَإِذَا غَابُوا کَتَبَ بَعْضُہُمْ إِلَی بَعْضٍ مَنْ عَمِلَ لآخِرَتِہِ کَفَاہُ اللَّہُ دُنْیَاہُ ، وَمَنْ أَصْلَحَ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ کَفَاہُ اللَّہُ النَّاسَ ، وَمَنْ أَصْلَحَ سَرِیرَتَہُ أَصْلَحَ اللَّہُ عَلاَنِیَتَہُ۔","","Musannaf Ibn Abi Shaybah 36135","","","كتاب الزهد"
"36136","(۳۶۱۳۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا قُطْبَۃُ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ سِنَانٍ ، أَنَّہُ رَأَی صَاحِبًا لَہُ فِی النَّوْمِ ، فَقَالَ : أَیُّ شَیْئٍ رَأَیْت أَفْضَلَ حِینَ اطَّلَعْت الأَمْرَ ، قَالَ : سَجَدَاتُ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 36136","","","كتاب الزهد"
"36137","(۳۶۱۳۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ طُعْمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، قَالَ : کَانَ فِیمَنْ کَانَ قَبْلَکُمْ رَجُلٌ عَبَدَ اللَّہَ أَرْبَعِینَ سَنَۃً فِی الْبَرِّ ، ثُمَّ قَالَ : یَا رَبِّ قَدَ اشْتَقْت أَنْ أَعْبُدَک فِی الْبَحْرِ ، فَأَتَی قَوْمٌ فَاسْتَحْمَلَہُمْ فَحَمَلُوہُ ، وَجَرَتْ بِہِمْ سَفِینَتُہُمْ مَا شَائَ اللَّہُ أَنْ تَجْرِیَ ، ثُمَّ قَامَتْ فَإِذَا شَجَرَۃٌ فِی نَاحِیَۃِ الْمَائِ ، قَالَ : فَقَالَ : ضَعُونِی عَلَی ہَذِہِ الشَّجَرَۃِ ، قَالَ : فَقَالُوا : مَا یُعَیِّشُک عَلَی ہَذِہِ ، قَالَ : إنَّمَا اسْتَحْمَلْتُکُمْ فَضَعُونِی حَیْثُ أُرِیدُ ، فَوَضَعُوہُ وَجَرَتْ بِہِمْ سَفِینَتُہُمْ ، فَأَرَادَ مَلَکٌ أَنْ یَعْرُجَ إِلَی السَّمَائِ فَتَکَلَّمَ بِکَلاَمِہِ الَّذِی کَانَ یَعْرُجُ بِہِ فَلَمْ یَقْدِرْ عَلَی ذَلِکَ ، فَعَلِمَ ، أَنَّ ذَلِکَ لِخَطِیئَۃٍ کَانَتْ مِنْہُ ، فَأَتَی صَاحِبُ الشَّجَرَۃِ فَسَأَلَہُ أَنْ یَشْفَعَ لَہُ إِلَی رَبِّہِ ، قَالَ : فَصَلَّی وَدَعَا لِلْمَلَکِ ، قَالَ وَطَلَبَ إِلَی رَبِّہِ أَنْ یَکُونَ ہُوَ یَقْبِضُ نَفْسَہُ لِیَکُونَ أَہْوَنَ عَلَیْہِ مِنْ مَلَکِ الْمَوْتِ ، فَأَتَاہُ حِینَ حَضَرَ أَجَلُہُ ، فَقَالَ : إنِّی طَلَبْت إِلَی رَبِّی أَنْ یُشَفِّعَنِی فِیک کَمَا شَفَّعَک فِی ، وَأَنْ أَکُونَ أَنَا أَقْبِضُ نَفْسَک ، فَمِنْ حَیْثُ شِئْت قَبَضْتہَا ، قَالَ : فَسَجَدَ سَجْدَۃً فَخَرَجَتْ دَمْعَۃٌ مِنْ عَیْنِہِ فَمَاتَ۔","","Musannaf Ibn Abi Shaybah 36137","","","كتاب الزهد"
"36138","(۳۶۱۳۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ یَقُولُ : إذَا جَائَ الشِّتَائُ یَا أَہْلَ الْقُرْآنِ طَالَ اللَّیْلُ لِصَلاَتِکُمْ وَقَصُرَ النَّہَارُ لِصِیَامِکُمْ فَاغْتَنِمُوا۔","","Musannaf Ibn Abi Shaybah 36138","","","كتاب الزهد"
"36139","(۳۶۱۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : مَا کَانَ الْمُجْتَہِدُ فِیکُمْ إِلاَّ کَاللاَّعِبِ فِیمَنْ مَضَی۔","","Musannaf Ibn Abi Shaybah 36139","","","كتاب الزهد"
"36140","(۳۶۱۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إنَّ أَہْلَ الْقُبُورِ لیَتَوَقَّعُونَ الأَخْبَارَ ، فَإِذَا لَمْ تَأْتِہِمْ ، قَالُوا : إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، سُلِکَ بِہِ غَیْرُ طَرِیقِنَا۔","","Musannaf Ibn Abi Shaybah 36140","","","كتاب الزهد"
"36141","(۳۶۱۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : یُؤْتَی بِالرَّجُلِ الْعَظِیمِ الطَّوِیلِ یَوْمَ الْقِیَامَۃِ فَیُوضَعُ فِی الْمِیزَانِ ، فَلاَ یَزِنُ عِنْدَ اللہِ جَنَاحَ بَعُوضَۃٍ وَقَرَأَ : {فَلاَ نُقِیمُ لَہُمْ یَوْمَ الْقِیَامَۃِ وَزْنًا}۔","","Musannaf Ibn Abi Shaybah 36141","","","كتاب الزهد"
"36142","(۳۶۱۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ : {لِکُلِّ أَوَّابٍ حَفِیظٍ} قَالَ : الَّذِی لاَ یَجْلِسُ مَجْلِسًا ، ثُمَّ یَقُومُ إِلاَّ اسْتَغْفَرَ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 36142","","","كتاب الزهد"
"36143","(۳۶۱۴۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : مِنْ صِدْقِ الإِیمَانِ وَبِرِّہِ إسْبَاغُ الْوُضُوئِ فِی الْمَکَارِہِ وَمِنْ صِدْقِ الإِیمَانِ وَبِرِّہِ أَنْ یَخْلُوَ الرَّجُلُ بِالْمَرْأَۃِ الْحَسْنَائِ فَیَدَعَہَا ، لاَ یَدَعُہَا إِلاَّ لِلَّہِ۔","Hasan","Musannaf Ibn Abi Shaybah 36143","","","كتاب الزهد"
"36144","(۳۶۱۴۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ فِی قَوْلِہِ : {عُتُلٍّ بَعْدَ ذَلِکَ زَنِیمٍ} قَالَ : ہُوَ الأَکُولُ الشَّرُوبُ الْقَوی الشَّدِیدُ یُوزَنُ فَلاَ یَزِنُ شَعِیرَۃً ، یَدْفَعُ الْمَلَکُ مِنْ أُولَئِکَ سَبْعِینَ أَلْفًا دَفْعَۃً وَاحِدَۃً فِی جَہَنَّمَ۔","","Musannaf Ibn Abi Shaybah 36144","","","كتاب الزهد"
"36145","(۳۶۱۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ {لِکُلِّ أَوَّابٍ حَفِیظٍ} قَالَ : الَّذِی یَذْکُرُ ذُنُوبَہُ فِی الْخَلاَئِ فَیَسْتَغْفِرُہَا۔","","Musannaf Ibn Abi Shaybah 36145","","","كتاب الزهد"
"36146","(۳۶۱۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ {کُلَّ یَوْمٍ ہُوَ فِی شَأْنٍ} قَالَ : مِنْ شَأْنِہِ أَنْ یَفُکَّ عَانِیًا ، أَوْ یُجِیبَ دَاعِیًا ، أَوْ یَشْفِیَ سَقِیمًا ، أَوْ یُعْطِیَ سَائِلاً۔","","Musannaf Ibn Abi Shaybah 36146","","","كتاب الزهد"
"36147","(۳۶۱۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إنَّکُمْ مَکْتُوبُونَ عِنْدَ اللہِ بِأَسْمَائِکُمْ وَسِیمَاکُمْ ومجالسکم وَحُلاَکُمْ۔","","Musannaf Ibn Abi Shaybah 36147","","","كتاب الزهد"
"36148","(۳۶۱۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ فِی قَوْلِ اللہِ {مَسَّتْہُمُ الْبَأْسَائُ وَالضَّرَّائُ} قَالَ : الْبَأْسَائُ : الْبُؤْسُ ، وَالضَّرَّائُ : الضُّرُّ ، ثُمَّ قَالَ : السَّرَّائُ : الرَّخَائُ ، وَالضَّرَّائُ : الشِّدَّۃُ۔","","Musannaf Ibn Abi Shaybah 36148","","","كتاب الزهد"
"36149","(۳۶۱۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ رَجُلٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ لِرَجُلٍ ثَلاَثَۃُ أَخِلاَّئِ بَعْضُہُمْ أَخَصُّ بِہِ مِنْ بَعْضٍ ، قَالَ : فَنَزَلَتْ بِہِ نَازِلَۃٌ فَلَقِیَ أَخَصَّ الثَّلاَثَۃِ بِہِ ، فَقَالَ : یَا فُلاَنُ ، إِنَّہُ قَدْ نَزَلَ بِی کَذَا وَکَذَا ، وَإِنِّی أُحِبُّ أَنْ تُعِینَنِی ، قَالَ : مَا أَنَا بِالَّذِی أَفْعَلُ ، فَانْطَلَقَ إِلَی الَّذِی یَلِیہِ فِی الْخَاصَّۃِ ، فَقَالَ : یَا فُلاَنُ ، إِنَّہُ قَدْ نَزَلَ بِی کَذَا وَکَذَا ، فَأَنَا أُحِبُّ أَنْ تُعِینَنِی ، فَقَالَ : أَنْطَلِقُ مَعَک حَتَّی تَبْلُغَ الْمَکَانَ الَّذِی تُرِیدُ، فَإِذَا بَلَغْتَ رَجَعْتُ وَتَرَکْتُک ، فَانْطَلَقَ إِلَی أَخَسِّ الثَّلاَثَۃِ ، فَقَالَ : یَا فُلاَنُ ، إِنَّہُ قَدْ نَزَلَ بِی کَذَا وَکَذَا فَأَنَا أُحِبُّ أَنْ تُعِینَنِی ، قَالَ : أَنَا أَذْہَبُ مَعَک حَیْثُمَا ذَہَبْت ، وَأَدْخُلُ مَعَک حَیْثُمَا دَخَلْت ، قَالَ : فَأَمَّا الأَوَّلُ فَمَالُہُ ، خَلَفَہُ فِی أَہْلِہِ فَلَمْ یَتْبَعْہُ مِنْہُ شَیْئٌ ، وَالثَّانِی أَہْلُہُ وَعَشِیرَتُہُ ذَہَبُوا بِہِ إِلَی قَبْرِہِ ، ثُمَّ رَجَعُوا وَتَرَکُوہُ ، وَالثَّالِثُ عَمَلُہُ ہُوَ حَیْثُمَا ذَہَبَ وَیَدْخُلُ مَعَہُ حَیْثُ مَا دَخَلَ۔","Hasan","Musannaf Ibn Abi Shaybah 36149","","","كتاب الزهد"
"36150","(۳۶۱۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ {یَوْمَ یَأْتِی بَعْضُ آیَاتِ رَبِّک} قَالَ : طُلُوعُ الشَّمْسِ مِنْ مَغْرِبِہَا۔","","Musannaf Ibn Abi Shaybah 36150","","","كتاب الزهد"
"36151","(۳۶۱۵۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إنَّ اللَّہَ أَحَلَّ وَحَرَّمَ ، فَمَا أَحَلَّ فَاسْتَحِلُّوہُ ، وَمَا حَرَّمَ فَاجْتَنِبُوہُ وَتَرَکَ من ذَلِکَ أَشْیَائَ لَمْ یُحِلَّہَا وَلَمْ یُحَرِّمْہَا ، فَذَلِکَ عَفْوٌ مِنَ اللہِ عَفَاہُ ، ثُمَّ یَتْلُو : {یَا أَیُّہَا الَّذِینَ آمَنُوا لاَ تَسْأَلُوا عَنْ أَشْیَائَ} إِلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 36151","","","كتاب الزهد"
"36152","(۳۶۱۵۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : لاَ یَزَالُ للہ فِی الْعَبِدِ حَاجَۃ مَا کَانَتْ لِلْعَبْدِ إِلَی اللہِ حَاجَۃٌ۔","","Musannaf Ibn Abi Shaybah 36152","","","كتاب الزهد"
"36153","(۳۶۱۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إنَّ أَہْلَ الْقُبُورِ لَیَتَوکَّفُونَ لِلْمَیِّتَ کَمَا یُتَلَقَّی الرَّاکِبُ یَسْأَلُونَہُ ، فَإِذَا سَأَلُوہُ مَا فَعَلَ فُلاَنٌ مِمَّنْ قَدْ مَاتَ ، فَیَقُولُ : أَلَمْ یَأْتِکُمْ ، فَیَقُولُونَ : إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ذُہِبَ بِہِ إِلَی أُمِّہِ الْہَاوِیَۃِ۔","","Musannaf Ibn Abi Shaybah 36153","","","كتاب الزهد"
"36154","(۳۶۱۵۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدثنا مَالِکُ بْنُ مِغْوَلٍ ، عَنِ الْفَضْلِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ ، قَالَ : إنَّ الْقَبْرَ لَیَقُولُ : یَا ابْنَ آدَمَ ، مَاذَا أَعْدَدْت لِی أَلَمْ تَعْلَمْ أَنِّی بَیْتُ الْغُرْبَۃِ ، وَبَیْتُ الْوَحْدَۃِ ، وَبَیْتُ الأَکْلَۃِ ، وَبَیْتُ الدُّودِ۔","","Musannaf Ibn Abi Shaybah 36154","","","كتاب الزهد"
"36155","(۳۶۱۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ مُجَاہِدٍ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ، قَالَ: إنْ کَانَ نُوحٌ لَیَلْقَاہُ الرَّجُلُ مِنْ قَوْمِہِ فَیَخْنُقُہُ حَتَّی یَخِرَّ مَغْشِیًّا عَلَیْہِ، قَالَ: فَیفِیقُ حِینَ یَفِیقُ وَہُوَ یَقُولُ: رَبِّ اغْفِرْ لِقَوْمِی فَإِنَّہُمْ لاَ یَعْلَمُونَ۔","","Musannaf Ibn Abi Shaybah 36155","","","كتاب الزهد"
"36156","(۳۶۱۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مُجَاہِدٍ ، قَالَ : سَمِعْتہ یُحَدِّثُ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ اللَّیْثِیِّ : إنَّ قَوْمَ نُوحٍ لَمَّا أَصَابَہُمَ الْغَرَقُ ، قَالَ : وَکَانَتْ مَعَہُمَ امْرَأَۃٌ مَعَہَا صَبِیٌّ لَہَا ، قَالَ : فَرَفَعَتْہُ إِلَی حَقْوِہَا ، فَلَمَّا بَلَغَہُ الْمَائُ رَفَعَتْہُ إِلَی صَدْرِہَا ، فَلَمَّا بَلَغَہُ الْمَائُ رَفَعَتْہُ إِلَی ثَدْیِہَا ، فَقَالَ اللَّہُ : لَوْ کُنْت رَاحِمًا مِنْہُمْ أَحَدًا رَحِمْتہَا ، یَعْنِی بِرَحْمَتِہَا الصَّبِیَّ۔","","Musannaf Ibn Abi Shaybah 36156","","","كتاب الزهد"
"36157","(۳۶۱۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أبی سُفْیَانَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إذَا أَرَادَ اللَّہُ بِعَبْدٍ خَیْرًا فَقَّہَہُ فِی الدِّینِ وَأَلْہَمَہُ رُشْدَہُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 36157","","","كتاب الزهد"
"36158","(۳۶۱۵۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : إنَّ إبْرَاہِیمَ ، یُقَالَ لَہُ یَوْمَ الْقِیَامَۃِ : ادْخُلِ الْجَنَّۃَ مِنْ أَیِّ أَبْوَابِ الْجَنَّۃِ شِئْت ، قَالَ : فَیَقُولُ : یَا رَبِّ وَالِدِی فَیُقَالَ لَہُ : إِنَّہُ لَیْسَ مِنْک ، فَإِذَا أَلَحَّ فِی الْمَسْأَلَۃِ قِیلَ لَہُ : دُونَک أَبَاک ، قَالَ : فَیَلْتَفِتُ فَإِذَا ہُوَ ضَبُعٌ فَیَقُولُ : مَا لِی فِیہِ مِنْ حَاجَۃٍ، فَتَطِیبُ نَفْسُہُ عَنْہُ ، فَیُنْطَلَقُ بِإِبْرَاہِیمَ إِلَی الْجَنَّۃِ وَیُنْطَلَقُ بِأَبِیہِ إِلَی النَّارِ۔","","Musannaf Ibn Abi Shaybah 36158","","","كتاب الزهد"
"36159","(۳۶۱۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : یَجِیئُ فُقَرَائُ الْمُہَاجِرِینَ یَوْمَ الْقِیَامَۃِ تَقْطُرُ رِمَاحُہُمْ وَسُیُوفُہُمْ دَمًا ، قَالَ : فَیُقَالَ لَہُمْ : کَمَا أَنْتُمْ حَتَّی تُحَاسَبُوا عَلِیہِ ، قَالَ : فَیَقُولُونَ : وَہَلْ أَعْطَیْتُمُونَا شَیْئًا تُحَاسِبُونَا عَلَیْہِ ، قَالَ : فَیُنْظَرُ فِی ذَلِکَ فَلاَ یُوجَدُ إِلاَّ أَکْوَارُہُمُ الَّتِی ہَاجَرُوا عَلَیْہَا ، قَالَ : فَیَدْخُلُونَ الْجَنَّۃَ قَبْلَ النَّاسِ بِخَمْسِ مِئَۃِ عَام۔","","Musannaf Ibn Abi Shaybah 36159","","","كتاب الزهد"
"36160","(۳۶۱۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَاشِدٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ {إِنَّہُ کَانَ لِلأَوَّابِینَ غَفُورًا} الأَوَّابُ الَّذِی یَتَذَکَّرُ ذُنُوبَہُ فِی الْخَلاَئِ فَیَسْتَغْفِرُ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 36160","","","كتاب الزهد"
"36161","(۳۶۱۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : لَمَّا أَرَادَ اللَّہُ أَنْ یَہْلِکَ أَصْحَابَ الْفِیلِ بَعَثَ عَلَیْہِمْ طَیْرًا أُنْشِئَتْ مِنَ الْبَحْرِ أَمْثَالَ الْخَطَاطِیفِ کُلُّ طَیْرٍ مِنْہَا یَحْمِلُ ثَلاَثَۃَ أَحْجَارٍ مُجَزَّعَۃٍ : حَجَرَیْنِ فِی رِجْلَیْہِ وَحَجَرًا فِی مِنْقَارِہِ ، قَالَ فَجَائَتْ حَتَّی صَفَّتْ عَلَی رُؤُوسہمْ ، ثُمَّ صَاحَتْ وَأَلْقَتْ مَا فِی أَرْجُلِہَا وَمَنَاقِیرِہَا ، فَمَا یَقَعُ حَجَرٌ عَلَی رَأْسِ رَجُلٍ إِلاَّ خَرَجَ مِنْ دُبُرِہِ ، وَلاَ یَقَعُ عَلَی شَیْئٍ مِنْ جَسَدِہِ إِلاَّ خَرَجَ مِنَ الْجَانِبِ الآخَرِ ، قَالَ : وَبَعَثَ اللَّہُ رِیحًا شَدِیدَۃً فَضَرَبَتِ الْحِجَارَۃَ فَزَادَتْہَا شِدَّۃً فَأُہْلِکُوا جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 36161","","","كتاب الزهد"
"36162","(۳۶۱۶۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ خَیْثَمَۃ، قَالَ: کَانَ، یُقَالَ: إنَّ الشَّیْطَانَ یَقُولُ: مَا غَلَبَنِی عَلَیْہِ ابْنُ آدَمَ فَلَنْ یَغْلِبَنِی عَلَی ثَلاَثٍ : أَنْ یَأْخُذَ مَالاً مِنْ غَیْرِ حَقِّہِ ، أَوْ أَنْ یَمْنَعَہُ مِنْ حَقِّہِ ، أَوْ أَنْ یَضَعَہُ فِی غَیْرِ حَقِّہِ۔","","Musannaf Ibn Abi Shaybah 36162","","","كتاب الزهد"
"36163","(۳۶۱۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، قَالَ : کَانَ ، یُقَالُ : إنَّ الشَّیْطَانَ یَقُولُ : کَیْفَ یَغْلِبُنِی ابْنُ آدَمَ وَإِذَا رَضِیَ جِئْت حَتَّی أَکُونَ فِی قَلْبِہِ ، وَإِذَا غَضِبَ طِرْت حَتَّی أَکُونَ فِی رَأْسِہِ۔ (ھناد ۱۳۰۴۔ احمد ۴)","","Musannaf Ibn Abi Shaybah 36163","","","كتاب الزهد"
"36164","(۳۶۱۶۴) حَدَّثَنَا شَرِیکٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ خَیْثَمَۃ یَقُولُ فِی ہَذِہِ الآیَۃِ : {یَوْمًا یَجْعَلُ الْوِلْدَانَ شِیبًا} قَالَ : یُنَادِی مُنَادٍ یَوْمَ الْقِیَامَۃِ یَخْرُجُ بَعْثُ النَّارِ مِنْ کُلِّ أَلْفٍ تِسْعُمِئَۃٍ وَتِسْعَۃٌ وَتِسْعُونَ فَمِنْ ذَلِکَ یَشِیبُ الْوِلْدَانُ۔","","Musannaf Ibn Abi Shaybah 36164","","","كتاب الزهد"
"36165","(۳۶۱۶۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، قَالَ : دَعَانِی خَیْثَمَۃُ ، فَلَمَّا جِئْت إذَا أَصْحَابُ الْعَمَائِمِ وَالْمَطَارِفِ عَلَی الْخَیْلِ ، فَحَقَّرْت نَفْسِی فَرَجَعْت ، قَالَ: فَلَقِیَنِی بَعْدَ ذَلِکَ ، فَقَالَ: مَا لَک لَمْ تَجِئْ، قَالَ ، قُلْتُ : قَدْ جِئْت وَلَکِنْ قَدْ رَأَیْت أَصْحَابَ الْعَمَائِمِ وَالْمَطَارِفِ عَلَی الْخَیْلِ فَحَقَّرْت نَفْسِی ، قَالَ : فَأَنْتَ وَاللہِ أَحَبُّ إلَیَّ مِنْہُمْ ، قَالَ : وَکُنَّا إذَا دَخَلْنَا عَلَیْہِ ، قَالَ بِالسَّلَّۃِ مِنْ تَحْتِ السَّرِیرِ ، وَقَالَ : کُلُوا وَاللہِ مَا أَشْتَہِیہِ ، وَلاَ أَصْنَعُہُ إِلاَّ لَکُمْ۔","","Musannaf Ibn Abi Shaybah 36165","","","كتاب الزهد"
"36166","(۳۶۱۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، قَالَ : کَانَ قَوْمُہُ یُؤْذُونَہُ ، فَقَالَ : إنَّ ہَؤُلاَئِ یُؤْذُونَنِی ، وَلاَ وَاللہِ مَا طَلَبَنِی أَحَدٌ مِنْہُمْ بِحَاجَۃٍ إِلاَّ قَضَیْتہَا ، وَلاَ أُدْخِلُ عَلَیَّ أَحَدٌ مِنْہُمْ أَذًی ، وَلأَنَا أَبْغَضُ فِیہِمْ مِنَ الْکَلْبِ الأَسْوَد ، وَلَمْ یَرَوْنَ ذَاکَ أَلاَ إِنَّہُ وَاللہِ مَا یُحِبُّ مُنَافِقٌ مُؤْمِنًا أَبَدًا۔","","Musannaf Ibn Abi Shaybah 36166","","","كتاب الزهد"
"36167","(۳۶۱۶۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، قَالَ : تَقُولُ الْمَلاَئِکَۃُ : یَا رَبِ ، عَبْدُک الْمُؤْمِنُ تَزْوِی عَنْہُ الدُّنْیَا وَتُعَرِّضُہُ لِلْبَلاَئِ ، قَالَ : فَیَقُولُ لِلْمَلاَئِکَۃِ : اکْشِفُوا لَہُمْ عَنْ ثَوَابِہِ ، فَإِذَا رَأَوْا ثَوَابَہُ ، قَالُوا : یَا رَبِ، لاَ یَضُرُّہُ مَا أَصَابَہُ مِنَ الدُّنْیَا ، قَالَ : وَیَقُولُونَ : عَبْدُک الْکَافِرُ تَزْوِی عَنْہُ الْبَلاَئَ وَتَبْسُطُ لَہُ الدُّنْیَا ، قَالَ : فَیَقُولُ لِلْمَلاَئِکَۃِ اکْشِفُوا لَہُمْ عَنْ ثوابہ ، فَإِذَا رَأَوْا ثوابہ ، قَالُوا : یَا رَبِّ لاَ یَنْفَعُہُ مَا أَصَابَہُ مِنَ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 36167","","","كتاب الزهد"
"36168","(۳۶۱۶۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکٍ بْنِ طَلْحَۃَ ، عَنْ خَیْثَمَۃ ، قَالَ : إنَّ اللَّہَ لَیَطْرُدُ بِالرَّجُلِ الشَّیْطَانَ مِنَ الآدُرِ۔ n(ابن المبارک ۳۳۱)","","Musannaf Ibn Abi Shaybah 36168","","","كتاب الزهد"
"36169","(۳۶۱۶۹) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ خَیْثَمَۃ ، أَنَّہُ أَوْصَی أَنْ یُدْفَنَ فِی مَقْبَرَۃِ فُقَرَائِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 36169","","","كتاب الزهد"
"36170","(۳۶۱۷۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکٍ بْنِ طَلْحَۃَ ، عَنْ خَیْثَمَۃ ، قَالَ : إنِّی لأَعْلَمُ مَکَانَ رَجُلٍ یَتَمَنَّی الْمَوْتَ فِی السَّنَۃِ مَرَّتَیْنِ ، فَرَأَیْتُ أَنَّہُ یَعْنِی نَفْسَہُ۔","","Musannaf Ibn Abi Shaybah 36170","","","كتاب الزهد"
"36171","(۳۶۱۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ خَیْثَمَۃ ، قَالَ : طُوبَی لِلْمُؤْمِنِ کَیْفَ یُحْفَظُ فِی ذُرِّیَّتِہِ مِنْ بَعْدِہِ۔","","Musannaf Ibn Abi Shaybah 36171","","","كتاب الزهد"
"36172","(۳۶۱۷۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، قَالَ : مَا تَقْرَؤُونَ فِی الْقُرْآنِ : {یَا أَیُّہَا الَّذِینَ آمَنُوا} فَإِنَّ مَوْضِعَہُ فِی التَّوْرَاۃِ : یَا أَیُّہَا الْمَسَاکِینُ۔","","Musannaf Ibn Abi Shaybah 36172","","","كتاب الزهد"
"36173","(۳۶۱۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ أَقُولَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، أَحَبُّ إلَیَّ مِمَّا طَلَعَتْ عَلَیْہِ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 36173","","","كتاب الزهد"
"36174","(۳۶۱۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَلِمَتَانِ خَفِیفَتَانِ عَلَی اللِّسَانِ ثَقِیلَتَانِ فِی الْمِیزَانِ حَبِیبَتَانِ إِلَی الرَّحْمَن : سُبْحَانَ اللہِ وَبِحَمْدِہِ ، سُبْحَانَ اللہِ الْعَظِیمِ۔","Sahih","Musannaf Ibn Abi Shaybah 36174","","","كتاب الزهد"
"36175","(۳۶۱۷۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لأنْ أَقُولَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِعَدَدِہَا دَنَانِیرَ فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36175","","","كتاب الزهد"
"36176","(۳۶۱۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ أصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِنْدَ ہَذِہِ السَّارِیَۃِ ، قَ[corrupt]لَ : مَنْ قَالَ سُبْحَانَ اللہِ وَبِحَمْدِہِ وَأَسْتَغْفِرُ اللَّہَ وَأَتُوبُ إلَیْہِ کُتِبَتْ فِی رِقٍّ ، ثُمَّ طُبِعَ عَلَیْہَا طَابِعٌ مِنْ مِسْکٍ فَلَمْ تُکْسَرْ حَتَّی یُوَافِیَ بِہَا یَوْمَ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 36176","","","كتاب الزهد"
"36177","(۳۶۱۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لأَنْ أَقُولَہَا أَحَبُّ إلَیَّ مِنْ أَنْ أَحْمِلَ عَلَی عَدَدِہَا خَیْلاً بِأَرْسَانِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 36177","","","كتاب الزهد"
"36178","(۳۶۱۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : تَسْبِیحَۃٌ بِحَمْدِ اللہِ فِی صَحِیفَۃِ الْمُؤْمِنِ خَیْرٌ مِنْ أَنْ تَسِیرَ ، أَوْ تَسِیلَ مَعَہُ جِبَالُ الدُّنْیَا ذَہَبًا۔","","Musannaf Ibn Abi Shaybah 36178","","","كتاب الزهد"
"36179","(۳۶۱۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : سَمِعْتُہُ یَقُولُ : تَسْبِیحَۃٌ فِی طَلَبِ الْحَاجَۃِ خَیْرٌ مِنْ لَقُوحٍ صَفِیٍّ فِی عَامٍ أَزِبَۃَ ، أَوَ قَالَ : لَزِبَۃَ۔","","Musannaf Ibn Abi Shaybah 36179","","","كتاب الزهد"
"36180","(۳۶۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُسَبِّحَ تَسْبِیحَاتٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُنْفِقَ عَدَدَہُنَّ دَنَانِیرَ فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36180","","","كتاب الزهد"
"36181","(۳۶۱۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، وَقَالَ أَبُو أُسَامَۃَ: سَمِعْت مُصْعَبَ بْنَ سَعْدٍ یَقُولُ: إذَا قَالَ الْعَبْدُ: سُبْحَانَ اللہِ ، قَالَتِ الْمَلاَئِکَۃُ : وَبِحَمْدِہِ ، وَإذَا قَالَ: سُبْحَانَ اللہِ وَبِحَمْدِہِ صَلَّوْا عَلَیْہِ ، وَقَالَ أَبُو أُسَامَۃَ : صَلَّتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36181","","","كتاب الزهد"
"36182","(۳۶۱۸۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مِسْعَرٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : إذَا قَالَ الْعَبْدُ : الْحَمْدُ لِلَّہِ کَثِیرًا ، قَالَ الْمَلَکُ : کَیْفَ أَکْتُبُ ؟ فَیَقُولُ اکْتُبْ لَہُ رَحْمَتِی کَثِیرًا ، وَإذَا قَالَ : سُبْحَانَ اللہِ کَثِیرًا ، قَالَ الْمَلَک ، کَیْفَ أَکْتُبُ ؟ فَیَقُولُ : اکْتُبْ رَحْمَتِی کَثِیرًا ، وَإذَا قَالَ اللَّہُ أَکْبَرُ کَبِیرًا ، قَالَ الْمَلَک ، کَیْفَ أَکْتُبُ ؟ فَیَقُولُ : اکْتُبْ لَہُ رَحْمَتِی کَبِیرًا ۔","Da'if","Musannaf Ibn Abi Shaybah 36182","","","كتاب الزهد"
"36183","(۳۶۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عفاق ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : أَیَعْجِزُ أَحَدُکُمْ أَنْ یُسَبِّحَ مِئَۃَ تَسْبِیحَۃٍ فَتَکُونَ لَہُ بِأَلْفُ حَسَنَۃٍ۔","","Musannaf Ibn Abi Shaybah 36183","","","كتاب الزهد"
"36184","(۳۶۱۸۴) حَدَّثَنَا أَبُو أُسَامَۃ ، عَنْ مِسْعَرٍ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی أَوْفَی ، قَالَ : أَتَی رَجُلٌ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ أَنَّہُ لاَ یَسْتَطِیعُ أَنْ یَأْخُذَ مِنَ الْقُرْآنِ شَیْئًا ، وَسَأَلَہُ شَیْئًا یُجْزِئُ عن الْقُرْآنِ، فَقَالَ لَہُ : قُلْ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، وَلاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 36184","","","كتاب الزهد"
"36185","(۳۶۱۸۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنِ مسلم ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، أَوْ عَنْ أَخِیہِ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، قَالَ : قَالَ رَسُولُ اللَّہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الَّذِینَ یَذْکُرُونَ مِنْ جَلالِ اللَّہ مِنْ تَسْبِیحِہِ وَتَحْمِیدِہِ وَتَہْلِیلِہِ یَتَعَاطَفْنَ حَوْلَ الْعَرْشِ لَہُنَّ دَوِیٌّ کَدَوِیِّ النَّحْلِ ، یُذَکِّرْنَ بِصَاحِبِہِنَّ ، أَوَلاَ یُحِبُّ أَحَدُکُمْ أَنْ لاَ یَزَالَ عِنْدَ الرَّحْمَن شَیْئٌ یُذَکِّرُ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 36185","","","كتاب الزهد"
"36186","(۳۶۱۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : سَمِعْتُ ہَانِیئَ بْنَ عُثْمَانَ یُحَدِّثُ ، عَنْ أُمِّہِ حُمَیْضَۃَ ابْنَۃِ یَاسِرٍ ، عَنْ جَدَّتِہَا یُسَیْرَۃَ ، وَکَانَتْ إحْدَی الْمُہَاجِرَاتِ ، قَالَتْ : قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَیْکُنَّ بِالتَّسْبِیحِ وَالتَّکْبِیرِ ، والتقدیس واعقدن بالأنامل فإنہن یأتین یوم القیامۃ مسؤولات مستنطقات وَلاَ تَغْفُلْنَ فَتَنْسَیْنَ الرَّحْمَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 36186","","","كتاب الزهد"
"36187","(۳۶۱۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ سَمِعَہُ مِنْ أَبِی عُمَرَ الصینی ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ذَہَبَ الأَغْنِیَائُ بِالأَجْرِ ، یُصَلُّونَ کَمَا نُصَلِّی ، وَیَصُومُونَ کَمَا نَصُومُ ، وَیَحُجُّونَ کَمَا نَحُجُّ ، وَیَتَصَدَّقُونَ ، وَلاَ نَجِدُ مَا نَتَصَدَّقُ ، قَالَ : فَقَالَ : أَلاَ أَدُلُّکُمْ عَلَی شَیْئٍ إذَا فَعَلْتُمُوہُ أَدْرَکْتُمْ مَنْ سَبَقَکُمْ ، وَلاَ یُدْرِکُکُمْ مَنْ بَعْدَکُمْ إِلاَّ مَنْ عَمِلَ بِالَّذِی تَعْمَلُونَ بِہِ : تُسَبِّحُونَ اللَّہَ ثَلاَثًا وَثَلاَثِینَ ، وَتَحْمَدُونَہُ ثَلاَثًا وَثَلاَثِینَ ، وَتُکَبِّرُونَہُ أَرْبَعًا وَثَلاَثِینَ دُبُرَ کُلِّ صَلاَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 36187","","","كتاب الزهد"
"36188","(۳۶۱۸۸) حَدَّثَنَا جَرِیرٌ ، وَأَبُو الأَحْوَصِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی الدَّرْدَائِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 36188","","","كتاب الزهد"
"36189","(۳۶۱۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُسَبِّحَ تَسْبِیحَاتٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُنْفِقَ عِدَّتَہُنَّ دَنَانِیرَ فِی سَبِیلِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36189","","","كتاب الزهد"
"36190","(۳۶۱۹۰) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا مَہْدِیٌّ بْنُ مَیْمُون ، عَنْ وَاصِلٍ ، عَنْ یَحْیَی بْنِ عُقَیْلٍ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنْ أَبِی الأَسْوَدِ الدَّیلِیِّ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : بِکُلِّ تَسْبِیحَۃٍ صَدَقَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 36190","","","كتاب الزهد"
"36191","(۳۶۱۹۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ شُعْبَۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی عَبْدِ اللہِ الْجَسْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ أُخْبِرُک بِأَحَبِّ الْکَلاَمِ إِلَی اللہِ، قَالَ: قُلْتُ: بَلَی ، یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَخْبِرْنِی بِأَحَبِّ الْکَلاَمِ إِلَی اللہِ ، قَالَ : أَحَبُّ الْکَلاَمُ إِلَی اللہِ سُبْحَانَ اللہِ وَبِحَمْدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 36191","","","كتاب الزهد"
"36192","(۳۶۱۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَنْ کَعْبٍ ، قَالَ : إنَّ مِنْ خَیْرِ الْعَمَلِ سُبْحَۃَ الْحَدِیثِ ، وَإِنَّ مِنْ شَرِّ الْعَمَلِ التَّجْدِیفَ ، قَالَ : قُلْتُ : یَا أَبَا عَبْدَ الرَّحْمَان ، وَمَا سُبْحَۃُ الْحَدِیثِ ، قَالَ : تَسْبِیحُ الرَّجُلِ وَالْقَوْمُ یَتَحَدَّثُونَ ، قَالَ : قُلْتُ : وَمَا التَّجْدِیفَ ، قَالَ : یَکُونُ الْقَوْمُ بِخَیْرٍ فَإِذَا سُئِلُوا ، قَالُوا : بِشَرٍّ۔","","Musannaf Ibn Abi Shaybah 36192","","","كتاب الزهد"
"36193","(۳۶۱۹۳) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کُنَّا عِنْدَ سَعْدِ بْنِ مَالِکٍ فَسَکَتَ سَکْتَۃً ، فَقَالَ : لَقَدْ أَصَبْت بِسَکْتَتِی ہَذِہِ مِثْلَ مَا سَقَی النِّیلُ وَالْفُرَاتُ ، قَالَ : قُلْنَا ، وَمَا أَصَبْت ، قَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","Da'if","Musannaf Ibn Abi Shaybah 36193","","","كتاب الزهد"
"36194","(۳۶۱۹۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ طَاوُوسٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا عَمِلَ ابْنُ آدَمَ مِنْ عَمَلٍ أَنْجَی لَہُ مِنَ النَّارِ مِنْ ذِکْرِ اللہِ ، قَالُوا : یَا رَسُولَ اللہِ ، وَلاَ الْجِہَادُ فِی سَبِیلِ اللہِ ، قَالَ : وَلاَ الْجِہَادُ فِی سَبِیلِ اللہِ ، إلا أن تَضْرِبُ بِسَیْفِکَ حَتَّی یَنْقَطِعَ ، ثُمَّ تَضْرِبُ بِہِ حَتَّی یَنْقَطِعَ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 36194","","","كتاب الزهد"
"36195","(۳۶۱۹۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ بِشْرِ بْنِ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ ، ذِکْرُ اللہِ بِالْغَدَاۃِ وَالْعَشِیِّ أَفْضَلُ مِنْ حَطْمِ السُّیُوفِ فِی سَبِیلِ اللہِ وَإِعْطَائِ الْمَالِ سَحًّا۔","Da'if","Musannaf Ibn Abi Shaybah 36195","","","كتاب الزهد"
"36196","(۳۶۱۹۶) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ، عَنِ ابْنِ سَابِطٍ، عَنْ مُعَاذٍ، قَالَ: لأَنْ أَذْکُرَ اللَّہَ مِنْ غُدْوَۃٍ حَتَّی تَطْلُعَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أُحْمَلَ عَلَی الْجِھَادِ فِی سَبِیلِ اللہِ مِنْ غُدْوَۃٍ حَتَّی تَطْلُعَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 36196","","","كتاب الزهد"
"36197","(۳۶۱۹۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ ، قَالَ : لَوْ بَاتَ رَجُلٌ یُعْطِی الْقِیَانَ الْبِیضَ ، وَبَاتَ آخَرُ یَقْرَأُ الْقُرْآنَ وَیَذْکُرُ اللَّہَ ، لرَأَیْتُ أَنَّ ذَاکِرَ اللہِ أَفْضَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 36197","","","كتاب الزهد"
"36198","(۳۶۱۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ أَبِی الْوَازِعِ ، جَابِرٍ الرَّاسِبِیِّ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : لَوْ أَنَّ رَجُلَیْنِ أَحَدُہُمَا فِی حِجْرِہِ دَنَانِیرُ یُعْطِیہَا وَالآخَرُ یَذْکُرُ اللَّہَ کَانَ ذَاکِرُ اللہِ أَفْضَلَ۔","Hasan","Musannaf Ibn Abi Shaybah 36198","","","كتاب الزهد"
"36199","(۳۶۱۹۹) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : مَا مِنْ شِیمَۃٍ أَحَبُّ إِلَی اللہِ مِنَ الشُّکْرِ وَالذِّکْرِ۔","","Musannaf Ibn Abi Shaybah 36199","","","كتاب الزهد"
"36200","(۳۶۲۰۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حَدَّثَنِی عَبْدُ الرَّحْمَنِ بْنُ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ، عَنْ أَبِی الدَّرْدَائِ، أَنَّہُ قَالَ: الَّذِینَ لاَ تَزَالُ أَلْسِنَتُہُمْ رَطْبَۃً مِنْ ذِکْرِ اللہِ یَدْخُلُونَ الْجَنَّۃَ وَہُمْ یَضْحَکُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 36200","","","كتاب الزهد"
"36201","(۳۶۲۰۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ قَیْسٍ الْکِنْدِیُّ ، عَنْ عَبْدِ اللہِ بْنِ بُسْرٍ ، أَنَّ أَعْرَابِیًّا ، قَالَ : یَا رَسُولَ اللہِ ، إنَّ شَرَائِعَ الإِسْلاَمِ قَدْ کَثُرَتْ ، فَأَنْبِئْنِی مِنْہَا بِمَا أَتَشَبَّثُ بِہِ ، قَالَ : لاَ یَزَالُ لِسَانُک رَطْبًا مِنْ ذِکْرِ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 36201","","","كتاب الزهد"
"36202","(۳۶۲۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : أَنِیرُوا بِذِکْرِ اللہِ وَاجْعَلُوا لِبُیُوتِکُمْ مِنْ صَلاَتِکُمْ جُزْئًا۔","","Musannaf Ibn Abi Shaybah 36202","","","كتاب الزهد"
"36203","(۳۶۲۰۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنِ الإِفْرِیقِیِّ ، عَنْ أَبِی عَلْقَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إنَّ أَہْلَ السَّمَائِ لَیَرَوْنَ بُیُوتَ أَہْلِ الذِّکْرِ تُضِیئُ لَہُمْ کَمَا تُضِیئُ الْکَوَاکِبُ لأَہْلِ الأَرْضِ۔","Da'if","Musannaf Ibn Abi Shaybah 36203","","","كتاب الزهد"
"36204","(۳۶۲۰۴) حَدَّثَنَا شَرِیکٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ مُعَاذٌ : لَوْ أَنَّ رَجُلَیْنِ أَحَدُہُمَا یَحْمِلُ عَلَی الْجِیَادِ فِی سَبِیلِ اللہِ ، وَالآخَرُ یَذْکُرُ اللَّہَ لَکَانَ ہَذَا أَعْظَمَ ، أَوْ أَفْضَلَ أَجْرًا ، یَعْنِی الذَّاکِرَ۔","","Musannaf Ibn Abi Shaybah 36204","","","كتاب الزهد"
"36205","(۳۶۲۰۵) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قیلَ لأَبِی الدَّرْدَائِ : إنَّ أَبَا سعد بن مُنْبَہٍ جَعَلَ فِی مَالِہِ مِئَۃَ مُحَرَّرٍ ، قَالَ : أَمَا أَنَّ مِئَۃَ مُحَرَّرٍ فِی مَالِ رَجُلٍ لَکَثِیرٌ ، أَلاَ أُخْبِرُکُمْ بِأَفْضَلَ مِنْ ذَلِکَ إیمَانٌ مَلْزُومٌ بِاللَّیْلِ وَالنَّہَارِ ، وَلاَ یَزَالُ لِسَانُک رَطْبًا مِنْ ذِکْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36205","","","كتاب الزهد"
"36206","(۳۶۲۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : مَا دَامَ قلْبُ الرَّجُلِ یَذْکُرُ اللَّہَ فَہُوَ فِی صَلاَۃٍ وَإِنْ کَانَ فِی السُّوقِ ، وَإِنْ یُحَرِّکُ بِہِ شَفَتَیْہِ فَہُوَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 36206","","","كتاب الزهد"
"36207","(۳۶۲۰۷) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ اللہِ الْقَرَّاظِ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، قَالَ : قَالَ رسول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَحَبَّ أَنْ یَرْتَعَ فِی رِیَاضِ الْجَنَّۃِ فَلْیُکْثِرْ ذِکْرَ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 36207","","","كتاب الزهد"
"36208","(۳۶۲۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مَا دَامَ قَلْبُ الرَّجُلِ یَذْکُرُ اللَّہَ فَہُوَ فِی صَلاَۃٍ وَإِنْ کَانَ فِی السُّوقِ۔","","Musannaf Ibn Abi Shaybah 36208","","","كتاب الزهد"
"36209","(۳۶۲۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا سَعْدُ بْنُ إِبْرَاہِیمَ ، عَن أَبِی عُبَیْدَۃَ ، قَالَ : الْعَبْدُ مَا ذَکَرَ اللَّہَ فَہُوَ فِی صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 36209","","","كتاب الزهد"
"36210","(۳۶۲۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ رَبِیعِ بْنِ خُثَیْمٍ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : مَنْ قَالَ عَشْرَ مَرَّاتٍ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ کَانَ کَعِدْلِ أَرْبَعِ رِقَابٍ ، أُرَاہُ قَالَ : مِنْ وَلَدِ إسْمَاعِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 36210","","","كتاب الزهد"
"36211","(۳۶۲۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَۃَ ، عَنِ الْبَرَائِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ کُنَّ کَعِتْقِ رَقَبَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 36211","","","كتاب الزهد"
"36212","(۳۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ ہِلاَلٍ ، عَنْ أم الدَّرْدَائِ ، قَالَت : مَنْ قَالَ مِئَۃَ مَرَّۃٍ غُدْوَۃً ، وَمِئَۃَ مَرَّۃٍ عَشِیَّۃً لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ لَمْ یَجِئْ أَحَدٌ یَوْمَ الْقِیَامَۃِ بِمِثْلِ مَا جَائَ بِہِ إِلاَّ مَنْ قَالَ مِثْلَہُنَّ ، أَوْ زَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 36212","","","كتاب الزهد"
"36213","(۳۶۲۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ عَنْ سُوَیْد بْنِ جُہَیْلٍ ، قَالَ : مَنْ قَالَ بَعْدَ الْعَصْرِ: لاَ إلَہَ إِلاَّ اللَّہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ قَاتَلْنَ عَنْ قَائِلِہِنَّ إِلَی مِثْلِہَا مِنَ الْغَدِ۔","","Musannaf Ibn Abi Shaybah 36213","","","كتاب الزهد"
"36214","(۳۶۲۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ مُسْلِمٍ مَوْلَی سُوَیْد بْنِ جُہَیْلٍ ، عَنْ سُوَیْد وَکَانَ مِنْ أَصْحَابِ عُمَرَ ، ثُمَّ ذَکَرَ نَحْوَ حَدِیثِ وَکِیعٍ۔","","Musannaf Ibn Abi Shaybah 36214","","","كتاب الزهد"
"36215","(۳۶۲۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی أَیُّوبَ الأنصاری ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ قَالَ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ بِیَدِہِ الْخَیْرُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ عَشْرَ مَرَّاتٍ کُنَّ لَہُ کَعِدْلِ عَشْرِ رِقَابٍ ، أَوْ کَعِدْلِ رَقَبَۃٍ۔","Shadh","Musannaf Ibn Abi Shaybah 36215","","","كتاب الزهد"
"36216","(۳۶۲۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی ثَعْلَبَۃُ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ ، لَوْ أَنَّ رَجُلَیْنِ أَقْبَلَ أَحَدُہُمَا مِنَ الْمَشْرِقِ وَالآخَرُ مِنَ الْمَغْرِبِ ، مَعَ أَحَدِہِمَا ذَہَبٌ لاَ یَضَعُ مِنْہُ شَیْئًا إِلاَّ فِی حَقٍّ ، وَالآخَرُ یَذْکُرُ اللَّہَ حَتَّی یَلْتَقِیَا فِی طَرِیقٍ لَکَانَ الَّذِی یَذْکُرُ اللَّہَ أَفْضَلَہُمَا۔","","Musannaf Ibn Abi Shaybah 36216","","","كتاب الزهد"
"36217","(۳۶۲۱۷) حَدَّثَنَا یَعْلَی ، عَنْ مُوسَی الطَّحَّانِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : دُفِعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی حَلْقَۃٍ وَہُمْ یَذْکُرُونَ اللَّہَ ، فَقَالَ : إنَّ اللَّہَ لَیُبَاہِی بِمَجْلِسِکُمْ أَہْلَ السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 36217","","","كتاب الزهد"
"36218","(۳۶۲۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، قَالَ : قَالَ عُبَادَۃُ بْنُ الصَّامِتِ : لأَنْ أَکُونَ فِی قَوْمٍ یَذْکُرُونَ اللَّہَ مِنْ حِینِ یُصَلُّونَ الْغَدَاۃَ إِلَی أَنْ تَطْلُعَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَلَی مُتُونِ الْخَیْلِ أُجَاہِدُ فِی سَبِیلِ اللہِ إِلَی أَنْ تَطْلُعَ الشَّمْسُ ، وَلأَنْ أَکُونَ فِی قَوْمٍ یَذْکُرُونَ اللَّہَ مِنْ حِینِ یُصَلُّونَ الْعَصْرَ حَتَّی تَغْرُبَ الشَّمْسُ أَحَبُّ إلَیَّ مِنْ أَنْ أَکُونَ عَلَی مُتُونِ الْخَیْلِ أُجَاہِدُ فِی سَبِیلِ اللہِ حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 36218","","","كتاب الزهد"
"36219","(۳۶۲۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی لأسْتَغْفِرُ اللَّہَ وَأَتُوبُ إلَیْہِ فِی الْیَوْمِ مِئَۃَ مَرَّۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 36219","","","كتاب الزهد"
"36220","(۳۶۲۲۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : سَمِعْتُ الأَغَرَّ وَکَانَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحَدِّثُ ابْنَ عُمَرَ ، قَالَ : یَقُولُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا أَیّہَا الْنَّاسُ تُوبُوا إِلَی رَبِّکُمْ فَإِنِّی أَتُوبُ إلَیْہِ فِی الْیَوْمِ مِئَۃَ مَرَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36220","","","كتاب الزهد"
"36221","(۳۶۲۲۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إنْ کَانَ لَیُعَدُّ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَجْلِسِ الْوَاحِدِ یَقُولُ : رَبِّ اغْفِرْ لِی وَتُبْ عَلَیَّ إنَّک أَنْتَ التَّوَّابُ الْغَفُورُ مِئَۃَ مَرَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36221","","","كتاب الزهد"
"36222","(۳۶۲۲۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ زَاذَانَ ، قَالَ : حدَّثَنِی رَجُلٌ مِنَ الأَنْصَارِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی دُبُرِ الصَّلاَۃِ : اللَّہُمَّ تُبْ عَلَیَّ وَاغْفِرْ لِی إنَّک أَنْتَ التَّوَّابُ الْغَفُورُ مِئَۃَ مَرَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36222","","","كتاب الزهد"
"36223","(۳۶۲۲۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْمُغِیرَۃُ بْنُ أَبِی الْحُرِّ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ جُلُوسٌ ، فَقَالَ : مَا أَصْبَحْت غَدَاۃً قَطُّ إِلاَّ اسْتَغْفَرْت اللَّہَ فِیہَا مِئَۃَ مَرَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36223","","","كتاب الزهد"
"36224","(۳۶۲۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : کَانَ أَبُو الدَّرْدَائِ یَقُولُ : طُوبَی لِمَنْ وُجِدَ فِی صَحِیفَتِہِ نُبَذ مِنَ اسْتِغْفَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36224","","","كتاب الزهد"
"36225","(۳۶۲۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یَقْبَلُ تَوْبَۃَ عَبْدِہِ مَا لَمْ یَعُدْ۔ (ترمذی ۳۵۳۷۔ احمد ۱۳۲)","Hasan","Musannaf Ibn Abi Shaybah 36225","","","كتاب الزهد"
"36226","(۳۶۲۲۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْمُغِیرَۃِ ، عَنْ حُذَیْفَۃَ ، قَالَ : شَکَوْت إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَرَبَ لِسَانِی ، فَقَالَ : أَیْنَ أَنْتَ مِنَ الاِسْتِغْفَارِ إنِّی لأسْتَغْفِرُ اللَّہَ فِی کُلِّ یَوْمٍ مِئَۃَ مَرَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 36226","","","كتاب الزهد"
"36227","(۳۶۲۲۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا بُکَیْر بْنُ أَبِی السُّمَیْطِ ، قَالَ : مَنْصُورُ بْنُ زَاذَانَ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : مَنْ قَالَ أَسْتَغْفِرُ اللَّہَ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ وَأَتُوبُ إلَیْہِ خَمْسَ مَرَّاتٍ غُفِرَ لَہُ وَإِنْ کَانَتْ ذُنُوبُہُ مِثْلَ زَبَدِ الْبَحْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 36227","","","كتاب الزهد"
"36228","(۳۶۲۲۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَخْطُبُ بِخُنَاصِرَۃ فَسَمِعْتہ یَقُولُ : أَفْضَلُ الْعِبَادَۃِ أَدَائُ الْفَرَائِضِ وَاجْتِنَابُ الْمَحَارِمِ۔","","Musannaf Ibn Abi Shaybah 36228","","","كتاب الزهد"
"36229","(۳۶۲۲۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ أَزْہَرَ بَیَّاعِ الْخُمُرِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بِخُنَاصِرَۃ یَخْطُبُ النَّاسَ عَلَیْہِ قَمِیصٌ مَرْقُوعٌ۔","","Musannaf Ibn Abi Shaybah 36229","","","كتاب الزهد"
"36230","(۳۶۲۳۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَبِی مَخْزُومٍ ، قَالَ : حدَّثَنِی عُمَرُ بْنُ أَبِی الْوَلِیدِ ، قَالَ : خَرَجَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَوْمَ الْجُمُعَۃِ وَہُوَ نَاحِلُ الْجِسْمِ یَخَطُبُ کَمَا کَانَ یَخْطُبُ ، ثُمَّ قَالَ : یَا أَیُّہَا النَّاسُ ، مَنْ أَحْسَنَ مِنْکُمْ فَلْیَحْمَدَ اللَّہَ وَمَنْ أَسَائَ فَلْیَسْتَغْفِرَ اللَّہَ ، فَإِنَّہُ لاَ بُدَّ لأَقْوَامٍ أَنْ یَعْمَلُوا أَعْمَالاً وَضَعَہَا اللَّہُ فِی رِقَابِہِمْ وَکَتَبَہَا عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 36230","","","كتاب الزهد"
"36231","(۳۶۲۳۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُعرف ، فَقَالَ : رَأَیْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَخْطُبُ النَّاسَ بِعَرَفَۃَ وَعَلَیْہِ ثَوْبَانِ أَخْضَرَانِ ، وَذَکَرَ الْمَوْتَ ، فَقَالَ : غَنْظٌ لَیْسَ کَالْغَنْظِ وَکَظٌّ لَیْسَ کَالْکَظِّ۔","","Musannaf Ibn Abi Shaybah 36231","","","كتاب الزهد"
"36232","(۳۶۲۳۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : مَا رَأَیْت أَحَدًا أَرَی ، أَنَّہُ أَشَدُّ خَوْفًا لِلَّہِ مِنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 36232","","","كتاب الزهد"
"36233","(۳۶۲۳۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ خَطَبَ النَّاسَ بِعَرَفَۃَ ، فَقَالَ : یَا أَیُّہَا النَّاسُ ، إنَّکُمْ جِئْتُمْ مِنَ الْقَرِیبِ وَالْبَعِید ، فَأَنْضَیْتُمَ الظَّہْرَ وَأَخْلَقْتُمَ الثِّیَابَ ، وَلَیْسَ السَّعِیدُ مَنْ سَبَقَتْ دَابَّتُہُ ، أَوْ رَاحِلَتُہُ ، وَلَکِنَّ السَّعِیدَ مَنْ تُقُبِّلَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 36233","","","كتاب الزهد"
"36234","(۳۶۲۳۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنِی عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : ذِکْرُ النِّعَمِ شُکْرُہَا۔","","Musannaf Ibn Abi Shaybah 36234","","","كتاب الزهد"
"36235","(۳۶۲۳۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ قَالَ : کَانَ قَمِیصُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ وثیابہ فِیمَا بَیْنَ الْکَعْبِ وَالشِّرَاکِ۔","","Musannaf Ibn Abi Shaybah 36235","","","كتاب الزهد"
"36236","(۳۶۲۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْمُہَلَّبِ بْنِ عُقْبَۃَ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَخْطُبُ یَقُولُ : إنَّ مِنْ أَحَبِّ الأُمُورِ إِلَی اللہِ الْقَصْدَ فِی الْجِدَّۃِ ، وَالْعَفْوَ فِی الْمَقْدِرَۃِ ، وَالرِّفْقَ فِی الْوِلاَیَۃِ ، وَمَا رَفَقَ عَبْدٌ بِعَبْدٍ فِی الدُّنْیَا إِلاَّ رَفَقَ اللَّہُ بِہِ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 36236","","","كتاب الزهد"
"36237","(۳۶۲۳۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عُبَیْدِ بْنِ عَبْدِ الْمَلِکِ ، قَالَ کَانَ عُمَرُ بْنُ عبْدِ الْعَزِیزِ یَقُولُ : اللَّہُمَّ أَصْلِحْ مَنْ کَانَ فِی صَلاَحِہِ صَلاَحٌ لأُمَّۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، اللَّہُمَّ وَأَہْلِکْ مَنْ کَانَ فِی ہَلاَکِہِ صَلاَحٌ لأُمَّۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 36237","","","كتاب الزهد"
"36238","(۳۶۲۳۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عُبَیْدِ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ وَاقِفًا بِعَرَفَۃَ وَہُوَ یَدْعُو وَہُوَ یَقُولُ بِأُصْبُعِہِ ہَکَذَا ، یَعْنِی یُشِیرُ بِہَا : اللَّہُمَّ زِدْ مُحْسِنَ أُمَّۃِ مُحَمَّدٍ إحْسَانًا ، وَرَاجِعْ بِمُسِیئِہِمْ إِلَی التَّوْبَۃِ ، ثُمَّ یَقُولُ : ہَکَذَا ، ثُمَّ یُدِیرُ إصْبَعَہُ : اللَّہُمَّ وَحُطَّ مِنْ وَرَائِہِمْ بِرَحْمَتِک۔","","Musannaf Ibn Abi Shaybah 36238","","","كتاب الزهد"
"36239","(۳۶۲۳۹) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا جُوَیْرِیَۃُ بْنُ أَسْمَائَ ، قَالَ : حَدَّثَنَا نَافِعٌ ، قَالَ : قَالَ عَبْدُ الْمَلِکِ بْنُ عُمَرَ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ : یَا أَمِیرَ الْمُؤْمِنِینَ ، مَا یَمْنَعُک أَنْ تمضی لِلَّذِی تُرِیدُ ، فَوَالَّذِی نَفْسِی بِیَدِہِ ، مَا أُبَالِی لَوْ غَلَتْ بِی وَبِکَ فِیہِ الْقُدُورُ ، قَالَ : وَحَقٌّ ہَذَا مِنْک یَا بُنَیَّ ، قَالَ : نَعَمْ وَاللہِ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی جَعَلَ لِی مِنْ ذُرِّیَّتِی مَنْ یُعِینُنِی عَلَی أَمْرِ رَبِّی ، یَا بُنَی ، لَوْ بَدَہْت النَّاسَ بِالَّذِی تَقُولُ لَمْ آمَنْ أَنْ یُنْکِرُوہَا ، فَإِذَا أَنْکَرُوہَا لَمْ أَجِدْ بُدًّا مِنَ السَّیْفِ ، وَلاَ خَیْرَ فِی خَیْرٍ لاَ یَأْتِی إِلاَّ بِالسَّیْفِ ، یَا بُنَی ، إنِّی أُرَوِّضُ النَّاسَ رِیَاضَۃَ الصَّعْبِ ، فَإِنْ یَطُلْ بِی عُمْرٌ فَإِنِّی أَرْجُو أَنْ یُنْفِذَ اللَّہُ لِی شَیْئًا ، وَإِنْ تَعَدَّ عَلَیَّ مَنِیَّۃٌ فَقَدْ عَلِمَ اللَّہُ الَّذِی أُرِیدُ۔","","Musannaf Ibn Abi Shaybah 36239","","","كتاب الزهد"
"36240","(۳۶۲۴۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جُوَیْرِیَۃُ بْنُ أَسْمَائَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی حَکِیمٍ ، قَالَ : غَضِبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَوْمًا فَاشْتَدَّ غَضَبُہُ ، وَکَانَتْ فِیہِ حِدَۃٌ ، وَعَبْدُ الْمَلِکِ ابْنُہُ حَاضِرٌ ، فَلَمَّا رَأَوْہُ قَدْ سَکَنَ غَضَبُہُ ، قَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَنْتَ فِی قَدْرِ نِعْمَۃِ اللہِ عَلَیْک ، وَفِی مَوْضِعِکَ الَّذِی وَضَعَک اللَّہُ فیہ ، وَمَا وَلاَّک اللَّہُ مِنْ أَمْرِ عِبَادِہِ یَبْلُغُ بِکَ الْغَضَبُ مَا أَرَی ، قَالَ : کَیْفَ قُلْتَ ؟ فَأَعَادَ عَلَیْہِ کَلاَمُہُ ، فَقَالَ : أَمَا تَغْضَبُ یَا عَبْدَ الْمَلِکِ ، قَالَ : مَا یُغْنِی عَنِّی سَعَۃُ جَوْفِی إنْ لَمْ أُرَدِّدْ فِیہِ الْغَضَبَ حَتَّی لاَ یَظْہَرَ مِنْہُ شَیْئٌ أَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 36240","","","كتاب الزهد"
"36241","(۳۶۲۴۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أَمَّا بَعْدُ ، فَإِنَّ أُنَاسًا مِنَ النَّاسِ الْتَمَسُوا الدُّنْیَا بِعَمَلِ الآخِرَۃِ ، وَإِنَّ أُنَاسًا مِنَ الْقُصَّاصِ قَدْ أَحْدَثُوا مِنَ الصَّلاَۃِ عَلَی خُلَفَائِہِمْ وَأُمَرَائِہِمْ عِدْلَ صَلاَتِہِمْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَإِذَا أَتَاک کِتَابِی ہَذَا فَمُرْہُمْ أَنْ تَکُونَ صَلاَتُہُمْ عَلَی النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وعلی النَّبِیّینَ وَدُعَاؤُہُمْ لِلْمُسْلِمِینَ عَامَّۃً ، وَیَدَعُوا مَا سِوَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 36241","","","كتاب الزهد"
"36242","(۳۶۲۴۲) حَدَّثَنَا سَعِیدُ بْنُ عَامِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو قَالَ سَمِعْت عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَقُولُ : مَا أَنْعَمَ اللَّہُ عَلَی عَبْدٍ مِنْ نِعْمَۃٍ فَانْتَزَعَہَا مِنْہُ فَعَاضَہُ مِمَّا انْتَزَعَ مِنْہُ صَبْرًا إِلاَّ کَانَ الَّذِی عَاضَہُ خَیْرًا مِمَّا انْتَزَعَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 36242","","","كتاب الزهد"
"36243","(۳۶۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہ بْنِ مَوْہَبٍ ، عَنْ صَالِحِ بْنِ سَعِیدٍ الْمُؤَذِّنِ ، قَالَ : بَیْنَمَا أَنَا مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ بِالسُّوَیْدَائِ فَأَذَّنْت لِلْعِشَائِ ، فَصَلَّی ، ثُمَّ دَخَلَ الْقَصْرَ فَقَلَّمَا لَبِثَ أَنْ خَرَجَ ، فَصَلَّی رَکْعَتَیْنِ خَفِیفَتَیْنِ ، ثُمَّ جَلَسَ فَاحْتَبَی ، فَافْتَتَحَ الأَنْفَالَ فَمَا زَالَ یُرَدِّدُہَا وَیَقْرَأ ، کُلَّمَا مَرَّ بِآیَۃِ تَخْوِیفٍ تَضَرَّعَ ، وَکُلَّمَا مَرَّ بِآیَۃِ رَحْمَۃٍ دَعَا حَتَّی أَذَّنْتُ لِلْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 36243","","","كتاب الزهد"
"36244","(۳۶۲۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : کُنْتُ جَالِسًا عِنْدَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَدَخَلَ عَلَیْہِ عَبْدُ الأَعْلَی بْنُ ہِلاَلٍ ، فَقَالَ : أَبْقَاک اللَّہُ یَا أَمِیرَ الْمُؤْمِنِینَ مَا دَامَ الْبَقَائُ خَیْرًا لَک ، قَالَ : قَدْ فُرِغَ مِنْ ذَلِکَ یَا أَبَا النَّضْرِ ، وَلَکِنْ قُلْ : أَحْیَاک اللَّہُ حَیَاۃً طَیِّبَۃً ، وَتَوَفَّاک مَعَ الأَبْرَارِ۔","","Musannaf Ibn Abi Shaybah 36244","","","كتاب الزهد"
"36245","(۳۶۲۴۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی حَکِیمٍ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ، قَالَ: إنَّ اللَّہَ لاَ یُؤَاخِذُ الْعَامَّۃَ بِعَمَلٍ فِی الْخَاصَّۃِ ، فَإِذَا الْمَعَاصِی ظَہَرَتْ فَلَمْ تُنْکَرَ اسْتَحَقُّوا الْعُقُوبَۃَ جَمِیعًا۔ (مالک ۹۹۱)","","Musannaf Ibn Abi Shaybah 36245","","","كتاب الزهد"
"36246","(۳۶۲۴۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : مَنْ لَمْ یَعُدْ کَلاَمُہُ مِنْ عَمَلِہِ کَثُرَتْ خَطَایَاہُ ، وَمَنْ عَمِلَ بِغَیْرِ عِلْمٍ کَانَ مَا یَفْسُدُ أَکْثَرَ مِمَّا یَصْلُحُ۔","","Musannaf Ibn Abi Shaybah 36246","","","كتاب الزهد"
"36247","(۳۶۲۴۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : ذَکَرَ أَبُو إسْرَائِیلَ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، فَقَالَ : حَدَّثَنِی عَلِیُّ بْنُ بَذِیمَۃَ، قَالَ : رَأَیْتہ بِالْمَدِینَۃِ وَہُوَ أَحْسَنُ النَّاسِ لِبَاسًا وَأَطْیَبُ النَّاسِ رِیحًا وَمِنْ أَخْیَل النَّاسِ فِی مِشْیَتِہِ ، أَوْ أَخْیَلَ النَّاسِ فِی مِشْیَتِہِ ، ثُمَّ رَأَیْتہ بَعْدُ یَمْشِی مِشْیَۃَ الرُّہْبَانِ ، فَمَنْ حَدَّثَک أَنَّ الْمَشْیَ سَجِیَّۃٌ فَلاَ تُصَدِّقْہُ بَعْدَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 36247","","","كتاب الزهد"
"36248","(۳۶۲۴۸) حَدَّثَنَا سَعِیدُ بْنُ عُثْمَانَ ، عَنْ غَیْلاَنَ بْنِ مَیْسَرَۃَ ، أَنَّ رَجُلاً أَتَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، فَقَالَ : زَرَعْت زَرْعًا فَمَرَّ بِہِ جَیْشٌ مِنْ أَہْلِ الشَّامِ فَأَفْسَدُوہُ ، قَالَ : فَعَوَّضَہُ مِنْہُ عَشْرَۃَ آلاَفِ۔","","Musannaf Ibn Abi Shaybah 36248","","","كتاب الزهد"
"36249","(۳۶۲۴۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَوْصَی عَامِلَہُ فِی الْغَزْوِ أَنْ لاَ یَرْکَبَ دَابَّۃً إِلاَّ دَابَّۃً یَضْبِطُ سَیْرَہَا أَضْعَفَ دَابَّۃٍ فِی الْجَیْشِ۔","","Musannaf Ibn Abi Shaybah 36249","","","كتاب الزهد"
"36250","(۳۶۲۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ یُبْرِدُ ، قَالَ : فَحَمَلَ مَوْلًی لَہُ رَجُلاً عَلَی الْبَرِیدِ بِغَیْرِ إذْنِہِ ، قَالَ : فَدَعَاہُ ، فَقَالَ : لاَ تَبْرَحْ حَتَّی تُقَوِّمَہُ ، ثُمَّ تَجْعَلَہُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 36250","","","كتاب الزهد"
"36251","(۳۶۲۵۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جُمَیْعِ بْنِ عَبْدِ اللہِ الْمُقْرِئِ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ نَہَی الْبَرِیدَ أَنْ یَجْعَلَ فِی طَرَفِ السَّوْطِ حَدِیدَۃً یَنْخُسُ بِہَا الدَّابَّۃَ ، قَالَ : وَنَہَی عَنِ اللُّجُمِ الثِّقَالَ۔","","Musannaf Ibn Abi Shaybah 36251","","","كتاب الزهد"
"36252","(۳۶۲۵۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عَامِرُ بْنُ عَبْدِ قَیْسٍ : الْعَیْشُ فِی أَرْبَعٍ : النِّسَائِ وَاللِّبَاسِ وَالطَّعَامِ وَالنَّوْمِ ، فَأَمَّا النِّسَائُ فَوَاللہِ مَا أُبَالِی امْرَأَۃً رَأَیْت أَمْ عَنْزًا ، وَأَمَّا اللِّبَاسُ فَوَاللہِ مَا أُبَالِی بِمَا وَارَیْت بِہِ عَوْرَتِی ، وَأَمَّا الطَّعَامُ وَالنَّوْمُ فَقَدْ غَلَبَانِی ، وَاللہِ لأُضِرَّنَّ بِہِمَا جَہْدِی ، قَالَ الْحَسَنُ : فَأَضَرَّ وَاللہِ بِہِمَا۔","","Musannaf Ibn Abi Shaybah 36252","","","كتاب الزهد"
"36253","(۳۶۲۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : دَخَلَ عَلَیَّ عَامِرٌ فِی الْبَیْتِ وَلَیْسَ مَعَہُ إِلاَّ جَرَّۃٌ فِیہَا شَرَابُہُ وَطُہُورُہُ ، وَسَلَّۃٌ فِیہَا طَعَامُہُ۔","","Musannaf Ibn Abi Shaybah 36253","","","كتاب الزهد"
"36254","(۳۶۲۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ مَا یَلِی الأَرْضَ مِنْ عَامِرِ بْنِ عَبْدِ قَیْسٍ مِثْلَ ثَفِنِ الْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 36254","","","كتاب الزهد"
"36255","(۳۶۲۵۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی الأَشْیَبُ ، عَنْ شُعْبَۃَ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، قَالَ : سَمِعْتُ أَبَا بِشْرٍ یُحَدِّثُ عَنْ سَہْمِ بْنِ شَقِیقٍ ، قَالَ : أَتَیْتُ عَامِرَ بْنَ عَبْدِ قَیْسٍ فَقَعَدْت عَلَی بَابِہِ فَخَرَجَ وَقَدِ اغْتَسَلَ ، فَقُلْتُ : إنِّی أَرَی الْغُسْلَ یُعْجِبُک ، فَقَالَ : رُبَّمَا اغْتَسَلْت ، قَالَ : مَا حَاجَتُک ؟ قُلْتُ : جئت للْحَدِیثِ ، قَالَ : وَعَہْدُک بِی أُحِبُّ الْحَدِیثِ۔","","Musannaf Ibn Abi Shaybah 36255","","","كتاب الزهد"
"36256","(۳۶۲۵۶) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ سِیرِینَ ، قَالَ : قِیلَ لِعَامِرِ بْنِ عَبْدِ اللہِ : أَلاَ تَزَوَّجُ ، قَالَ : مَا عِنْدِی نَشَاطٌ ، وَمَا عِنْدِی مِنْ مَالٍ ، فَمَا أَغُرُّ امْرَأَۃً مُسْلِمَۃً۔","","Musannaf Ibn Abi Shaybah 36256","","","كتاب الزهد"
"36257","(۳۶۲۵۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : قَالَ عَامِرُ بْنُ عَبْدِ قَیْسٍ لاِبْنَیْ عَمٍّ لَہُ : فَوِّضَا أَمْرَکُمَا إِلَی اللہِ۔","","Musannaf Ibn Abi Shaybah 36257","","","كتاب الزهد"
"36258","(۳۶۲۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا بَعْضُ مَشْیَخَتِنَا ، قَالَ : قَالَ عَامِرُ بْنُ عَبْدِ اللہِ : إنَّمَا أَجِدُنِی آسَفُ عَلَی الْبَصْرَۃِ لأَرْبَعِ خِصَالٍ : تَجَاوُبُ مُؤَذِّنِیہَا ، وَظَمَأُ الْہَوَاجِرِ ، وَلأَنَّ بِہَا أَخْدَانِی ، وَلأَنَّ بِہَا وَطَنِی۔","","Musannaf Ibn Abi Shaybah 36258","","","كتاب الزهد"
"36259","(۳۶۲۵۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا سَعِیدُ الْجُرَیْرِیُّ ، قَالَ : لَمَّا سُیِّرَ عَامِرُ بْنُ عَبْدِ اللہِ ، قَالَ : شَیَّعَہُ إخْوَانُہُ ، فَقَالَ : بِظَہْرِ الْمِرْبَدِ : إنِّی دَاعٍ فَأَمِّنُوا ، فَقَالُوا : ہَاتِ فَقَدْ کُنَّا نَشْتَہِی ہَذَا مِنْک ، فَقَالَ : اللَّہُمَّ مَنْ سَائَنِی وَکَذَبَ عَلَیَّ وَأَخْرَجَنِی مِنْ مِصْرِی وَفَرَّقَ بَیْنِی وَبَیْنَ إخْوَانِی اللَّہُمَّ أَکْثِرْ مَالَہُ وَوَلَدَہُ وَأَصِحَّ جِسْمَہُ وَأَطِلْ عُمْرَہُ۔","","Musannaf Ibn Abi Shaybah 36259","","","كتاب الزهد"
"36260","(۳۶۲۶۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : حدَّثَنِی مَنْ رَأَی عَامِرَ بْنَ عَبْدِ قَیْسٍ دَعَا بِزَیْتٍ فَصَبَّہُ فِی یَدِہِ کَذَا وَصَفَ جَعْفَرٌ ، وَمَسَحَ إحْدَاہُمَا عَلَی الأُخْرَی ، ثُمَّ قَالَ : {وَشَجَرَۃً تَخْرُجُ مِنْ طُورِ سَیْنَائَ تَنْبُتُ بِالدُّہْنِ وَصِبْغٍ لِلآکِلِینَ} قَالَ فَدَہَنَ رَأْسَہُ وَلِحْیَتَہُ۔","","Musannaf Ibn Abi Shaybah 36260","","","كتاب الزهد"
"36261","(۳۶۲۶۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنِی مَالِکُ بْنُ دِینَارٍ ، قَالَ : حَدَّثَنِی فُلاَنٌ ، أَنَّ عَامِرَ بْنَ عَبْدِ اللہِ کَانَ فِی الرَّحْبَۃِ وَإِذَا ذِمِّیٌّ یُظْلَمُ ، قَالَ : فَأَلْقَی عَامِرٌ رِدَائَہُ وَقَالَ : أَلاَّ أَرَی ذِمَّۃَ اللہِ تخْفَرُون وَأَنَا حَی ، فَاسْتَنْقَذَہُ۔","","Musannaf Ibn Abi Shaybah 36261","","","كتاب الزهد"
"36262","(۳۶۲۶۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَاصِمٍ ، عَنْ فُضَیْلِ بْنِ زَیْدٍ الرَّقَاشِیِّ ، قَالَ : لاَ یہلک النَّاسُ عَنْ نَفْسِکَ ، فَإِنَّ الأَمْرَ یَصِلُ إلَیْک دُونَہُمْ ، وَلاَ تَقُلْ : اقْطَعْ عَنَّا الْیَوْمَ بِکَذَا وَکَذَا ، فَإِنَّہُ مَحْصِیٌّ عَلَیْکَ جَمِیعَ مَا عَمِلْت فِی ذَلِکَ ، وَلَمْ تَرَ شَیْئًا أَسْرَعَ إدْرَاکًا ، وَلاَ أَحْسَنَ طَلَبًا مِنْ حَسَنَۃٍ حَدِیثَۃٍ لِذَنْبٍ عَظیم۔","","Musannaf Ibn Abi Shaybah 36262","","","كتاب الزهد"
"36263","(۳۶۲۶۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، قَالَ : رَوِّحُوا الْقُلُوبَ تَعِ الذِّکْرَ۔","","Musannaf Ibn Abi Shaybah 36263","","","كتاب الزهد"
"36264","(۳۶۲۶۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی غَیْلاَنَ ، قَالَ : کَانَ مُطَرِّفُ بْنُ الشِّخِّیرِ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ السُّلْطَانِ ، وَمِنْ شَرِّ مَا تَجْرِی بِہِ أَقْلاَمُہُمْ ، وَأَعُوذُ بِکَ أَنْ أَقُولَ بِحَقٍّ أَطْلُبُ بِہِ غَیْرَ طَاعَتِکَ ، وَأَعُوذُ بِکَ أَنْ أَتَزَیَّنَ لِلنَّاسِ بِشَیْئٍ یَشِینُنِی عِنْدَکَ ، وَأَعُوذُ بِکَ أَنْ أَسْتَغِیثَ بِشَیْئٍ مِنْ مَعَاصِیک عَلَی ضُرٍّ نَزَلَ بِی، وَأَعُوذُ بِکَ أَنْ تَجْعَلَنِی عِبْرَۃً لأَحَدٍ مِنْ خَلْقِکَ ، وَأَعُوذُ بِکَ أَنْ تَجْعَلَ أَحَدًا أَسْعَدَ بِمَا عَلَّمْتہ مِنِّی ، اللَّہُمَّ لاَ تُخْزِنِی فَإِنَّک بِی عَالِمٌ ، اللَّہُمَّ لاَ تُعَذِّبْنِی فَإِنَّک عَلَیَّ قَادِرٌ۔","","Musannaf Ibn Abi Shaybah 36264","","","كتاب الزهد"
"36265","(۳۶۲۶۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ غَیْلاَنَ بْنِ جَرِیرٍ ، قَالَ : سَمِعْتُ مُطَّرِفًا یَقُولُ : کَأَنَّ الْقُلُوبَ لَیْسَتْ مِنَّا وَکَأَنَّ الْحَدِیثَ یُعْنَی بِہِ غَیْرَنَا۔","","Musannaf Ibn Abi Shaybah 36265","","","كتاب الزهد"
"36266","(۳۶۲۶۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مَہْدِیٍّ ، قَالَ : حدَّثَنَا غَیْلاَنُ ، قَالَ : سَمِعْتُ مُطَّرِفًا یَقُولُ : لَوْ أَتَانِی آتٍ مِنْ رَبِّی فَخَیَّرَنِی ، أَفِی الْجَنَّۃِ أَمْ فِی النَّارِ أَمْ أَصِیرُ تُرَابًا ، اخْتَرْت أَنْ أَصِیرَ تُرَابًا۔","","Musannaf Ibn Abi Shaybah 36266","","","كتاب الزهد"
"36267","(۳۶۲۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ الرِّشْکِ ، عَنْ مُطَرِّفٌ قَالَ : {إنَّ الَّذِینَ یَتْلُونَ کِتَابَ اللہِ وَأَقَامُوا الصَّلاَۃَ} إِلَی آخِرِ الآیَۃِ ، قَالَ : ہَذِہِ آیَۃَ الْقُرَّائِ۔","","Musannaf Ibn Abi Shaybah 36267","","","كتاب الزهد"
"36268","(۳۶۲۶۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، قَالَ : قَالَ مُطَرِّفٌ : مَا مِنَ النَّاسِ أَحَدٌ إِلاَّ وَہُوَ أَحْمَقُ فِیمَا بَیْنَہُ وَبَیْنَ رَبِّہِ ، وَلَکِنَّ بَعْضَ الْحَمَقِ أَہْوَنُ مِنْ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 36268","","","كتاب الزهد"
"36269","(۳۶۲۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : کَانَ مُطَرِّفٌ یَقُولُ : اللَّہُمَّ تَقَبَّلْ مِنِّی صَلاَۃَ یَوْمٍ ، اللَّہُمَّ تَقَبَّلْ مِنِّی صَوْمَ یَوْمٍ، اللَّہُمَّ اکْتُبْ لِی حَسَنَۃً ، ثُمَّ یَقُولُ: {إنَّمَا یَتَقَبَّلُ اللَّہُ مِنَ الْمُتَّقِینَ}۔","","Musannaf Ibn Abi Shaybah 36269","","","كتاب الزهد"
"36270","(۳۶۲۷۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتُ ، أَنَّ مُطَرِّفَ بْنَ عَبْدِ اللہِ ، قَالَ : لَوْ کَانَتْ لِی نَفْسَانِ لَقَدَّمْت إحْدَاہُمَا قبل الأُخْرَی، فَإِنْ ہَجَمَتْ عَلَی خَیْرٍ أَتْبَعْتُہَا الأُخْرَی، وَإِلاَّ أَمْسَکْتُہا، وَلَکِنْ إنَّمَا ہِیَ نَفْسٌ وَاحِدَۃٌ ، لاَ أَدْرِی عَلَی مَا تَہْجُمُ خَیْرٌ أَمْ شَرٌّ۔","","Musannaf Ibn Abi Shaybah 36270","","","كتاب الزهد"
"36271","(۳۶۲۷۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، أَنَّ مُطَّرِفًا ، قَالَ : لَوْ وُزِنَ رَجَائُ الْمُؤْمِنِ وخَوْفَہُ مَا رَجَحَ أَحَدُہُمَا صَاحِبَہُ۔","","Musannaf Ibn Abi Shaybah 36271","","","كتاب الزهد"
"36272","(۳۶۲۷۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ وَاسِعٍ الأَزْدِیُّ ، قَالَ : کُنْتُ فِی حَلْقَۃٍ فِیہَا الْحَسَنُ وَمُطَرِّفٌ ، وَفُلاَنٌ وَفُلاَنٌ ، ذَکَرَ أُنَاسًا ، فَتَکَلَّمَ سَعِیدُ بْنُ أَبِی الْحَسَنِ ، قَالَ : ثُمَّ دَعَا ، فَقَالَ فِی دُعَائِہِ : اللَّہُمَّ ارْض عَنَّا ، اللَّہُمَّ ارْض عَنَّا ، مَرَّتَیْنِ أَوْ ثَلاَثًا ، قَالَ : یَقُولُ مُطَرِّفٌ وَہُوَ فِی نَاحِیَۃِ الْحَلْقَۃِ : اللَّہُمَّ إنْ لَمْ تَرْضَ عَنَّا فَاعْفُ عَنَّا ، قَالَ : فَأَبْکَی الْقَوْمَ بِہَذِہِ الْکَلِمَۃِ۔","","Musannaf Ibn Abi Shaybah 36272","","","كتاب الزهد"
"36273","(۳۶۲۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مَہْدِیٍّ ، قَالَ : حَدَّثَنَا غَیْلاَنُ بْنُ جَرِیرٍ ، عَنْ مُطَرِّفٍ ، قَالَ : ہُمُ النَّاسُ وَہُمُ النَّسْنَاسُ ، وَأُنَاسٌ غُمِسُوا فِی مَائِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 36273","","","كتاب الزهد"
"36274","(۳۶۲۷۴) حَدَّثَنَا شَاذَانُ ، عَنْ مَہْدِیٍّ ، عَنْ غَیْلاَنَ بْنِ جَرِیرٍ ، عَنْ مُطَرِّف قَالَ : عُقُولُ النَّاسِ علَی قَدْرِ زَمَانِہِمْ۔","","Musannaf Ibn Abi Shaybah 36274","","","كتاب الزهد"
"36275","(۳۶۲۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفِ بْنِ الشِّخِّیرِ فِی قَوْلِہِ : {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : قَلَّ لَیْلَۃٍ أَتَتْ عَلَیْہِمْ ہَجَعُوہَا۔","","Musannaf Ibn Abi Shaybah 36275","","","كتاب الزهد"
"36276","(۳۶۲۷۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ مُطَرِّف قَالَ : خَیْرُ الأُمُورِ أَوْسَاطُہَا۔","","Musannaf Ibn Abi Shaybah 36276","","","كتاب الزهد"
"36277","(۳۶۲۷۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ عَنْ ثَابِتٍ ، عَنْ مُطَرِّفٍ ، أَنَّہُ أَقْبَلَ مِنْ مَبْدَئِہِ قَالَ فَجَعَلَ یَسِیرُ بِاللَّیْلِ فَأَضَائَ لَہُ سَوْطَہُ۔","","Musannaf Ibn Abi Shaybah 36277","","","كتاب الزهد"
"36278","(۳۶۲۷۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، أَنَّ مُطَرِّفًا ، قَالَ : لَوْ کَانَتْ لِی الدُّنْیَا فَأَخَذَہَا اللَّہُ مِنِّی بِشَرْبَۃٍ مِنْ مَائٍ یَسْقِینِی بِہَا یَوْمَ الْقِیَامَۃِ کَانَ قَدْ أَعْطَانِی بِہَا ثَمَنًا۔","","Musannaf Ibn Abi Shaybah 36278","","","كتاب الزهد"
"36279","(۳۶۲۷۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : کُنَّا عِنْدَ مُطَرِّفٍ فَذَکَرْنَا اللَّہَ وَدَعَوْنَاہُ ، فَقَالَ : وَاللہِ لَئِنْ کَانَ ہذا مِمَّا سَبَقَ لَکُمْ فِی الذِّکْرِ لَقَدْ أَرَادَ اللَّہُ بِکُمْ خَیْرًا ، وَإِنْ کَانَ مِمَّا یَحْدُثُ فِی اللَّیْلِ وَالنَّہَارِ لَقَدْ أَرَادَ اللَّہُ بِکُمْ خَیْرًا ، فَأَیُّ ذَلِکَ مَا کَانَ فَاحْمَدُوا اللَّہَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36279","","","كتاب الزهد"
"36280","(۳۶۲۸۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، أَنَّ مُطَرِّفًا کَانَ یَقُولُ : إنَّ الْحَدِیثَ ، وَإِنَّ الْیَمِینَ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 36280","","","كتاب الزهد"
"36281","(۳۶۲۸۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، أَنَّ مُطَرِّفًا کَانَ یَقُولُ : لَوْ کَانَ الْخَیْرُ فِی کَفِّ أَحَدِنَا مَا اسْتَطَاعَ أَنْ یُفْرِغَہُ فِی قَلْبِہِ حَتَّی یَکُونَ اللَّہُ ہُوَ الَّذِی یُفْرِغُہُ فِی قَلْبِہِ۔","","Musannaf Ibn Abi Shaybah 36281","","","كتاب الزهد"
"36282","(۳۶۲۸۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، أَنَّ مُطَرِّفًا کَانَ یَقُولُ : لَوْ أَنَّ رَجُلاً رَأَی صَیْدًا وَالصَّیْدُ لاَ یَرَاہُ فَخَتَلَہُ أَلَمْ یُوشِکْ أَنْ یَأْخُذَہُ ، قَالُوا : بَلَی ، قَالَ : فَإِنَّ الشَّیْطَانَ یَرَانَا وَنَحْنُ لاَ نَرَاہُ وَہُوَ یُصِیبُ مِنَّا۔","","Musannaf Ibn Abi Shaybah 36282","","","كتاب الزهد"
"36283","(۳۶۲۸۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، قَالَ مُطَرِّفٌ : نَظَرْت فِی بَدْئِ ہَذَا الأَمْرِ مِمَّنْ کَانَ ، فَإِذَا ہُوَ مِنَ اللہِ ، وَنَظَرْت عَلَی مَنْ تَمَامُہُ فَإِذَا تَمَامُہُ عَلَی اللہِ ، وَنَظَرْت مَا مِلاَکُہُ فَإِذَا مِلاَکُہُ الدُّعَائُ۔","","Musannaf Ibn Abi Shaybah 36283","","","كتاب الزهد"
"36284","(۳۶۲۸۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ سُلَیْمَانَ ، عَنْ ثَابِتٍ ، أَنَّ مُطَرِّفَ بْنَ الشِّخِّیرِ ، قَالَ : لَیَعْظُمُ جَلاَلُ اللہِ فِی صُدُورِکُمْ فَلاَ یُذْکَرُ اللَّہُ عِنْدَ مِثْلِ ہَذَا ، یَقُولُ أَحَدُکُمْ لِلْکَلْبِ : أَخْزَاہُ اللَّہُ وَلِلْحِمَارِ ، أَوِ الشَّاۃِ۔","","Musannaf Ibn Abi Shaybah 36284","","","كتاب الزهد"
"36285","(۳۶۲۸۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ مُطَرِّف قَالَ : کُنَّا نَتَحَدَّثُ أَنَّہُ لَمْ یَتَحَابَّ رَجُلاَنِ فِی اللہِ إِلاَّ کَانَ أَفْضَلَہُمَا أَشَدُّہُمَا حُبًّا لِصَاحِبِہِ ، قَالَ : فَلَمَّا سُیِّرَ مَذْعُورٌ ، وعَامِرُ بْنُ عَبْدِ اللہِ ، قَالَ: لَقِیَ مَذْعُورٌ مُطَرِّفًا فَجَعَلَ یُذَاکِرُہُ ، قَالَ مُطَرِّفٌ : فَجَعَلْتُ أَقُولُ : أَیْ أَخِی ، عَلاَمَ تَحْبِسُنِی وَقَدْ تَہَوَّرَتِ النُّجُومُ ، وَذَہَبَ اللَّیْلُ ، فَیَقُولُ : اللَّہُمَّ فِیک ، ثم یُذَاکِرْہُ السَّاعَۃَ فَیَقُولُ : یَا أَخِی ، عَلاَمَ تَحْبِسُنِی وَقَدْ تَہَوَّرَتِ النُّجُومُ ، وَذَہَبَ اللَّیْلُ ، فَقَالَ : اللَّہُمَّ فِیک ، فَلَمَّا أَصْبَحْنَا أُخْبِرْت أَنَّہُ قَدْ سُیِّرَ ، فَعَرَفْت لَیْلَتَہ فَضْلَہُ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 36285","","","كتاب الزهد"
"36286","(۳۶۲۸۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، قَالَ : حَدَّثَنِی غَیْلاَنُ بْنُ جَرِیرٍ ، عَنْ مُطَرِّفٍ قَالَ : مَا أَرْمَلَۃٌ جَالِسَۃٌ عَلَی ذَیْلِہَا بِأَحْوَجَ إِلَی الْجَمَاعَۃِ مِنِّی۔","","Musannaf Ibn Abi Shaybah 36286","","","كتاب الزهد"
"36287","(۳۶۲۸۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ ، عَنْ ثَابِتٍ ، قَالَ : کَانَ مُطَرِّفٌ یَقُولُ : مَا أُوتِیَ أَحَدٌ مِنَ النَّاسِ أَفْضَلَ مِنَ الْعَقْلِ۔","","Musannaf Ibn Abi Shaybah 36287","","","كتاب الزهد"
"36288","(۳۶۲۸۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مَہْدِیٌّ ، قَالَ : حَدَّثَنَا غَیْلاَنُ بْنُ جَرِیرٍ ، عَنْ مُطَرِّفَ قَالَ : رَأَیْتُ فِی الْمَنَامِ کَأَنِّی خَرَجْت أُرِیدُ الْجُمُعَۃَ ، فَأَتَیْت عَلَی مَقَابِرَ مِنَ الْحَی ، فَإِذَا أَہْلُ الْقُبُورِ جُلُوسٌ ، فَجَعَلْتُ أُسَلِّمُ وَأَمْضِی ، قَالُوا : یَا عَبْدَ اللہِ ، أَیْنَ تُرِیدُ ، قَالَ : قُلْتُ : أُرِیدُ الْجُمُعَۃَ ، قَالَ : ثُمَّ قُلْتُ : تَدْرُونَ مَا الْجُمُعَۃُ ، قَالُوا : نَعَمْ وَنَعْلَمُ مَا یَقُولُ الطَّیْرُ یَوْمَئِذٍ ، قَالَ : قُلْتُ : مَا یَقُولُ الطَّیْرُ یَوْمَئِذٍ ، قَالُوا : یَقُولُ : سَلاَمٌ سَلاَمٌ یَوْمٌ صَالِحٌ۔","","Musannaf Ibn Abi Shaybah 36288","","","كتاب الزهد"
"36289","(۳۶۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، عَنْ أَبِی الْعَلاَئِ یَزِیدَ بْنِ عَبْدِ اللہِ ، عَنْ أَخِیہِ مُطَرِّفَ قَالَ : إنَّ اللَّہَ لَیَرْحَمُ بِرَحْمَۃِ الْعُصْفُورِ۔","","Musannaf Ibn Abi Shaybah 36289","","","كتاب الزهد"
"36290","(۳۶۲۹۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، قَالَ : سَمِعْتُ مُطَرِّفًا یَقُولُ : مَا مَرَرْت بِأَہْلِ مَجْلِسٍ فَسَمِعْت أَحَدًا یُثْنِی عَلَیَّ خَیْرًا ، قَالَ : فَیَأْخُذُ ذَلِکَ فِی۔","","Musannaf Ibn Abi Shaybah 36290","","","كتاب الزهد"
"36291","(۳۶۲۹۱) حَدَّثَنَا إِسْحَاقُ الرَّازِیّ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ قَتَادَۃَ ، عَنْ مُطَّرِفٍ قَالَ : إنَّ ہَذَا الْمَوْتَ قَدْ أَفْسَدَ عَلَی أَہْلِ النَّعِیمِ نَعِیمَہُمْ فَاطْلُبُوا نَعِیمًا لاَ مَوْتَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 36291","","","كتاب الزهد"
"36292","(۳۶۲۹۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا الْمُعَلَّی بْنُ زِیَادٍ ، قَالَ : قَالَ مُوَرِّقٌ الْعِجْلِیّ : أَمْرٌ أَنَا فِی طَلَبِہِ مُنْذُ عَشْرِ سِنِینَ لَمْ أَقْدِرْ عَلَیْہِ ، وَلَسْت بِتَارِکٍ طَلَبَہُ أَبَدًا ، قَالَ ، وَمَا ہُوَ یَا أَبَا الْمُعْتَمِرِ ، قَالَ : الصَّمْتُ عَمَّا لاَ یَعْنِینِی۔","","Musannaf Ibn Abi Shaybah 36292","","","كتاب الزهد"
"36293","(۳۶۲۹۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا ہِشَامٌ ، عَنْ حَفْصَۃَ بِنْتِ سِیرِینَ ، قَالَتْ : کَانَ مُوَرِّقٌ یَزُورُنَا ، فَزَارَنَا یَوْمًا فَسَلَّمَ فَرَدَدْت عَلَیْہِ السَّلاَمَ ، قَالَتْ : ثُمَّ سَأَلَنِی وَسَأَلْتُہُ ، قُلْتُ : کَیْفَ أَہْلُک کَیْفَ وَلَدُک ؟ قَالَ : إنَّہُمْ لَمُتَوَافِرُونَ ، قُلْتُ : فَاحْمَدْ رَبَّک ، قَالَ : إنِّی وَاللہِ قَدْ خَشِیت أَنْ یَحْبِسُونِی عَلَی ہَلَکَۃٍ۔","","Musannaf Ibn Abi Shaybah 36293","","","كتاب الزهد"
"36294","(۳۶۲۹۴) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا بَعْضُ أَصْحَابِنَا ، قَالَ : کَانَ مُوَرِّقٌ الْعِجْلِیّ یَتْجُرُ فَیُصِیبُ الْمَالَ ، فَلاَ تَأْتِی عَلَیْہِ جُمُعَۃٌ وَعِنْدَہُ مِنْہُ شَیْئٌ ، قَالَ : کَانَ یَلْقَی الأَخَ مِنْ إخْوَانِہِ فَیُعْطِیہِ أَرْبَعَ مِئَۃٍ خَمْسَ مِئَۃٍ ثَلاَث مِئَۃٍ ، فَیَقُولُ : ضَعْہَا لَنَا عِنْدَکَ حَتَّی نَحْتَاجَ إلَیْہَا ، ثُمَّ یَلْقَاہُ بَعْدَ ذَلِکَ فَیَقُولُ : شَأْنُک بِہَا ، وَیَقُولُ الآخَرُ : لاَ حَاجَۃَ لِی فِیہَا ، فَیَقُولُ : إنَّا وَاللہِ مَا نَحْنُ بِآخِذِیہَا أَبَدًا ، شَأْنُک بِہَا۔","","Musannaf Ibn Abi Shaybah 36294","","","كتاب الزهد"
"36295","(۳۶۲۹۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، قَالَ : قَالَ مُوَرِّقٌ الْعِجْلِیّ : مَا وَجَدْت لِلْمُؤْمِنِ فِی الدُّنْیَا مَثَلاً إِلاَّ کَمَثَلِ رَجُلٍ عَلَی خَشَبَۃٍ فِی الْبَحْرِ وَہُوَ یَقُولُ : یَا رَبِّ یَا رَبِّ لَعَلَّ اللَّہَ أَنْ یُنْجِیَہُ۔","","Musannaf Ibn Abi Shaybah 36295","","","كتاب الزهد"
"36296","(۳۶۲۹۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا أَبُو التَّیَّاحِ ، عَنْ مُوَرِّقٍ ، قَالَ : الْمُتَمَسِّکُ بِطَاعَۃِ اللہِ إذَا جَبُنَ النَّاسُ عنہا کَالْکَارِّ بَعْدَ الْفَارِّ۔","","Musannaf Ibn Abi Shaybah 36296","","","كتاب الزهد"
"36297","(۳۶۲۹۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَاصِمٍ الأَحْوَلِ ، قَالَ : سَمِعْتُ مُوَرِّقًا الْعِجْلِیّ یَقُولُ : مَا رَأَیْت رَجُلاً أَفْقَہَ فِی وَرَعِہِ ، وَلاَ أَوْرَعَ فِی فِقْہِہِ مِنْ مُحَمَّدٍ۔","","Musannaf Ibn Abi Shaybah 36297","","","كتاب الزهد"
"36298","(۳۶۲۹۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ثَابِتُ بْنُ یَزِیدَ أَبُو زَیْدٍ ، عَنْ عَاصِمٍ ، عَنْ مُوَرِّقٍ ، قَالَ : إنَّمَا کَانَ حَدِیثُہُمْ تَعْرِیضًا۔","","Musannaf Ibn Abi Shaybah 36298","","","كتاب الزهد"
"36299","(۳۶۲۹۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا ہِشَامُ بْنُ حَسَّانَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ صَفْوَانُ بْنُ مُحْرِزٍ : إذَا أَکَلْتُ رَغِیفًا أَشُدُّ بِہِ صُلْبِی وَشَرِبْتُ کُوزًا مِنْ مَائٍ فَعَلَی الدُّنْیَا وَأَہْلِہَا الْعَفَائُ۔","","Musannaf Ibn Abi Shaybah 36299","","","كتاب الزهد"
"36300","(۳۶۳۰۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، قَالَ : حَدَّثَنَا غَیْلاَنُ بْنُ جَرِیرٍ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ ، قَالَ : وَکَانُوا یَجْتَمِعُونَ ہُوَ وَإِخْوَانُہُ وَیَتَحَدَّثُونَ فَلاَ یَرَوْنَ تِلْکَ الرِّقَّۃَ ، قَالَ : فَیَقُولُونَ : یَا صَفْوَانُ ، حَدِّثْ أَصْحَابَک ، قَالَ : فَیَقُولُ : الْحَمْدُ لِلَّہِ ، قَالَ : فَیَرِقُّ الْقَوْمُ وَتَسِیلُ دُمُوعُہُمْ کَأَنَّہَا أَفْوَاہُ الْمَزَادۃ۔","","Musannaf Ibn Abi Shaybah 36300","","","كتاب الزهد"
"36301","(۳۶۳۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ ، أَنَّہُ کَانَ إذَا قَرَأَ ہَذِہِ الآیَۃَ بَکَی ، حتی أری لقد اندق َّ قَضیض زَوْرِۃ: {وَسَیَعْلَمُ الَّذِینَ ظَلَمُوا أَیَّ مُنْقَلَبٍ یَنْقَلِبُونَ}۔","","Musannaf Ibn Abi Shaybah 36301","","","كتاب الزهد"
"36302","(۳۶۳۰۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، أَنَّ صَفْوَانَ بْنَ مُحْرِزٍ کَانَ لَہُ خُصٌّ فِیہِ جِذْعٌ ، فَانْکَسَرَ الْجِذْعُ ، فَقِیلَ لَہُ : أَلاَ تُصْلِحُہُ ؟ فَقَالَ : دَعْہُ فَإِنَّمَا أَمُوتُ غَدًا۔","","Musannaf Ibn Abi Shaybah 36302","","","كتاب الزهد"
"36303","(۳۶۳۰۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ زُرَیْعٍ ، قَالَ : حَدَّثَنَا سَعِیدٌ قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ فِی قَوْلِہِ : {إنَّا أَنْشَأْنَاہُنَّ إنْشَائً فَجَعَلْنَاہُنَّ أَبْکَارًا عُرُبًا أَتْرَابًا} قَالَ : وَاللہِ إنَّ مِنْہُنَّ الْعُجُزَ الزُّحُفَ صَیَّرَہُنَّ اللَّہُ کَمَا تَسْمَعُونَ۔","","Musannaf Ibn Abi Shaybah 36303","","","كتاب الزهد"
"36304","(۳۶۳۰۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : سَمِعْتُ الْمُعَلَّی بْنَ زِیَادٍ ، قَالَ : کَانَ لِصَفْوَانَ بْنِ مُحْرِزٍ الْمَازِنِیِّ سِرْبٌ یَبْکِی فِیہِ ، وَکَانَ یَقُولُ : قَدْ أَرَی مَکَانَ الشَّہَادَۃِ لَوْ تَشَاء ، یَعْنِی نَفْسِہ۔","","Musannaf Ibn Abi Shaybah 36304","","","كتاب الزهد"
"36305","(۳۶۳۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : قَالَ حدثنا مسعر قَالَ : حدَّثَنِی عُتْبَۃُ بْنُ قَیْسٍ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، قَالَ: أرْبَعٌ مَنْ أُوتِیَہُنَّ أُوتِیَ خَیْرَ الدُّنْیَا وَالآخِرَۃِ : مَنْ أُوتِیَ لِسَانًا ذَاکِرًا ، وَقَلْبًا شَاکِرًا ، وَجَسَدًا عَلَی الْبَلاَئِ صَابِرًا ، وَزَوْجًا مُؤْمِنَۃً لاَ تَبْغِیہِ فِی نَفْسِہَا خَوْنًا۔ (ابن ابی الدنیا ۳۴۔ طبرانی ۱۱۲۷۵)","","Musannaf Ibn Abi Shaybah 36305","","","كتاب الزهد"
"36306","(۳۶۳۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مِسْعَرٌ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن طَلْقِ بْنِ حَبِیبٍ ، قَالَ : إنَّ حُقُوقَ اللہِ أَثْقَلُ مِنْ أَنْ یَقُومَ بِہَا الْعِبَادُ ، وَإِنَّ نِعَمَ اللہِ أَکْثَرُ مِنْ أَنْ یُحْصِیَہَا الْعِبَادُ ، وَلَکِنْ أَصْبِحُوا تَوَّابِینَ وَأَمْسُوا تَوَّابِینَ۔","","Musannaf Ibn Abi Shaybah 36306","","","كتاب الزهد"
"36307","(۳۶۳۰۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا عَبْدُ الْحَمِیدِ بْنُ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، قَالَ : أَخْبَرَنَا کُلْثُومُ بْنُ جَبْرٍ ، قَالَ : کَانَ الْمُتَمَنِّی بِالْبَصْرَۃِ یَقُولُ : عِبَادَۃُ طَلْقِ بْنِ حَبِیبٍ ، وَحِلْمُ مُسْلِمِ بْنِ یَسَارٍ۔","","Musannaf Ibn Abi Shaybah 36307","","","كتاب الزهد"
"36308","(۳۶۳۰۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، قَالَ : قلْنَا لِطَلْقِ بْنِ حَبِیبٍ : صِفْ لَنَا التَّقْوَی ، قَالَ : التَّقْوَی عَمَلٌ بِطَاعَۃِ اللہِ رَجَائَ رَحْمَۃِ اللہِ عَلَی نُورٍ مِنَ اللہِ ، وَالتَّقْوَی تَرْکُ مَعْصِیَۃِ اللہِ مَخَافَۃَ اللہِ عَلَی نُورٍ مِنَ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 36308","","","كتاب الزهد"
"36309","(۳۶۳۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، قَالَ : حدَّثَنِی صَفْوَانُ بْنُ مُحْرِزٍ ، قَالَ : قَالَ جُنْدُبٌ : مَثَلُ الَّذِی یَعِظُ وَیَنْسَی نَفْسَہُ مَثَلُ الْمِصْبَاحِ یَفِیئُ لِغَیْرِہِ وَیُحْرِقُ نَفْسَہُ ، لِیُبْصِرْ أَحَدُکُمْ مَا یُجْعَلُ فِی بَطْنِہِ، فَإِنَّ الدَّابَّۃَ إذَا مَاتَتْ کَانَ أَوَّلَ مَا یَنْفَتِقُ مِنْہَا بَطْنُہَا ، وَلْیَتَّقِ أَحَدُکُمْ أَنْ یَحُولَ بَیْنَہُ وَبَیْنَ الْجَنَّۃِ مِلْئُ کَفٍّ مِنْ دَمِ مُسْلِمٍ۔ (عبدالرزاق ۱۸۲۵۰)","Sahih","Musannaf Ibn Abi Shaybah 36309","","","كتاب الزهد"
"36310","(۳۶۳۱۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ إِسْحَاقَ ، قَالَ : حَدَّثَنِی رَجُلٌ مِنْ عُرَیْنَۃَ ، قَالَ : خَرَجَ جُنْدُبٌ الْبَجَلِیُّ فِی سَفَرٍ لَہُ ، فَخَرَجَ مَعَہُ نَاسٌ مِنْ قَوْمِہِ حَتَّی إذَا کَانُوا فِی الْمَکَانِ الَّذِی یُوَدِّعُ بَعْضُہُمْ بَعْضًا ، قَالَ : أَلاَ تَرَی ، الْمَحْرُوبُ مَنْ حُرِبَ دِینُہُ وَإِنَّ الْمَسْلُوبَ مَنْ سُلِبَ دِینُہُ ، أَلاَ ، إِنَّہُ لاَ فَقْرَ بَعْدَ الْجَنَّۃِ ، وَلاَ غِنَی بَعْدَ النَّارِ ، أَلاَ إنَّ النَّارَ لاَ یُفَکُّ أَسِیرُہَا ، وَلاَ یَسْتَغْنِی فَقِیرُہَا ، ثُمَّ رَکِبَ الْجَادَّۃَ وَانْطَلَقَ۔","Da'if","Musannaf Ibn Abi Shaybah 36310","","","كتاب الزهد"
"36311","(۳۶۳۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ غَالِبِ بْنِ عَجْرَدٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ فُقَہَائِ أَہْلِ الشَّامِ فِی مَسْجِدِ مِنًی ، قَالَ : إنَّ اللَّہَ خَلَقَ الأَرْضَ ، وَخَلَقَ مَا فِیہَا مِنَ الشَّجَرِ ، وَلَمْ یَکُنْ أَحَدٌ مِنْ بَنِی آدَمَ یَأْتِی شَجَرَۃً مِنْ تِلْکَ الشَّجَرِ إِلاَّ أَصَابَ مِنْہَا خَیْرًا ، أَوْ کَانَ لَہُ خَیْرٌ ، فَلَمْ یَزَلَ الشَّجَرَ کَذَلِکَ حَتَّی تَکَلَّمَتْ فَجَرَۃُ بَنِی آدَمَ بِالْکَلِمَۃِ الْعَظِیمَۃِ قَوْلُہُمْ (اتَّخَذَ اللَّہُ وَلَدًا) فَاقْشَعَرَّتِ الأَرْضُ فَشَاکَ الشَّجَرُ۔","","Musannaf Ibn Abi Shaybah 36311","","","كتاب الزهد"
"36312","(۳۶۳۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی قَحْذَمٍ ، قَالَ : أُتِیَ ابْنُ زِیَادٍ بِصُرَّۃٍ فِیہَا حَبُّ حِنْطَۃٍ أَمْثَالُ النَّوَی وُجِدَتْ فِی بَعْضِ بُیُوتِ آل کِسْرَی مَکْتُوبٌ مَعَہَا : ہَذَا نَبْتُ زَمَانٍ کَذَا وَکَذَا ، یَعْنِی : نَبْتُ زَمَانٍ کَانَ یُعْمَلُ فِیہِ بِطَاعَۃِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36312","","","كتاب الزهد"
"36313","(۳۶۳۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ خَالِدٍ الرَّبَعِیِّ ، قَالَ : کَانَ فِی بَنِی إسْرَائِیلَ رَجُلٌ ، وَکَانَ مَغْمُورًا فِی الْعِلْمِ ، وَأَنَّہُ ابْتَدَعَ بِدْعَۃً ، فَدَعَا النَّاسَ فَاتُّبِعَ ، وَأَنَّہُ تَذَکَّرَ ذَاتَ لَیْلَۃٍ ، فَقَالَ : ہَبْ ہَؤُلاَئِ النَّاسُ لاَ یَعْلَمُونَ مَا ابْتَدَعْت ، أَلَیْسَ اللَّہُ قَدْ عَلِمَ مَا ابْتَدَعْت ، قَالَ : فَبَلَغَ مِنْ تَوْبَتِہِ أَنْ حَرَقَ تَرْقُوَتَہُ ، وَجَعَلَ فِیہَا سِلْسِلَۃً وَرَبَطَہَا بِسَارِیَۃٍ مِنْ سَوَارِی الْمَسْجِدِ ، قَالَ : لاَ أَنْزِعُہَا حَتَّی یُتَابَ عَلَیَّ ، قَالَ : فَأَوْحَی اللَّہُ إِلَی نَبِیٍّ مِنْ أَنْبِیَائِ بَنِی إسْرَائِیلَ ، وَکَانَ لاَ یَسْتَنْکِرُ بِالْوَحْیِ : أَنْ قُلْ لِفُلاَنٍ : لَوْ أَنَّ ذَنْبَک کَانَ فِیمَا بَیْنِی وَبَیْنَکَ لَغَفَرْت لَک ، وَلَکِنْ کَیْفَ بِمَنْ أَضْلَلْت مِنْ عِبَادِی ، فَدَخَلَ النَّارَ۔","","Musannaf Ibn Abi Shaybah 36313","","","كتاب الزهد"
"36314","(۳۶۳۱۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ اللہِ بْنِ مَرْوَانَ ، قَالَ : سَمِعْتُ صَالِحًا أَبَا الْخَلِیلِ یَقُولُ فِی قَوْلِ اللہِ : {إنَّمَا یَخْشَی اللَّہَ مِنْ عِبَادِہِ الْعُلَمَائُ} قَالَ : أَعْلَمُہُمْ بِہِ أَشَدُّہُمْ خَشْیَۃً لَہُ۔","","Musannaf Ibn Abi Shaybah 36314","","","كتاب الزهد"
"36315","(۳۶۳۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، قَالَ : حدَّثَنَا رَجُلٌ مِنْ أَہْلِ الصَّنْعَائِ ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ ، قَالَ : مَرَّ رَجُلٌ بِرَاہِبٍ ، فَقَالَ : یَا رَاہِبُ ، کَیْفَ ذِکْرُک لِلْمَوْتِ ، قَالَ : مَا أَرْفَعُ قَدَمًا ، وَلاَ أَضَعُ أُخْرَی إِلاَّ رَأَیْت أَنِّی مَیِّتٌ ، قَالَ : کَیْفَ دَأْبُ نَشَاطِکَ ، قَالَ : مَا کُنْت أَرَی أن أَحَدًا سَمِعَ بِذِکْرِ الْجَنَّۃِ وَالنَّارِ تَأْتِی عَلَیْہِ سَاعَۃً لاَ یُصَلِّی ، فَقَالَ الرَّجُلُ : إنِّی لأُصَلِّی فَأَبْکِی حَتَّی یَنْبُتَ الْبَقْلُ مِنْ دُمُوعِی ، فَقَالَ الرَّاہِبُ : إنَّک إنْ تَضْحَکْ وَأَنْتَ مُعْتَرِفٌ لِلَّہِ بِخَطِیئَتِکَ خَیْرٌ مِنْ أَنْ تَبْکِیَ وَأَنْتَ مُدْلٍ بِعَمَلِکَ ، إنَّ صَلاَۃَ الْمُدْلِ لاَ تَصْعَدُ فَوْقَہُ فَقَالَ الرَّجُلُ : أَوْصِنِی ، فَقَالَ الرَّاہِبُ : عَلَیْک بِالزُّہْدِ فِی الدُّنْیَا ، وَلاَ تُنَازِعُہَا أَہْلَہَا ، وَکُنْ کَالنَّحْلَۃِ إنْ أُکِلَتْ أُکِلَتْ طَیِّبًا ، وَإِنْ وَضَعَتْ وَضَعَتْ طَیِّبًا ، وَإِنْ وَقَعَتْ عَلَی شَیْئٍ لَمْ تَضُرَّہُ وَلَمْ تَکْسِرْہُ ، وَانْصَحْ لِلَّہِ کَنُصْحِ الْکَلْبِ أَہْلَہُ فإنہم یُجِیعُونہُ وَیَضْرِبُونہُ ، وَیَأْبَی إِلاَّ نُصْحًا لَہُمْ وَحِفظًا عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 36315","","","كتاب الزهد"
"36316","(۳۶۳۱۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : بَلَغَنِی أَنَّ ابْنَ مُنَبِّہٍ کَانَ یَقُولُ : أَعْوَنُ الأَخْلاَقِ عَلَی الدِّینِ الزَّہَادَۃُ فِی الدُّنْیَا ، وَأَوْشَکُہَا رَدًی اتِّبَاعُ الْہَوَی ، وَمِنَ اتِّبَاعِ الْہَوَی الرَّغْبَۃُ فِی الدُّنْیَا ، وَمِنَ الرَّغْبَۃِ فِی الدُّنْیَا حُبُّ الْمَالِ وَالشَّرَفِ ، وَمِنْ حُبِّ الْمَالِ وَالشَّرَفِ اسْتِحْلاَلُ الْمَحَارِمِ ، وَمِنَ اسْتِحْلاَلِ الْمَحَارِمِ یَغْضَبُ اللَّہُ ، وَغَضَبُ اللہِ الدَّائُ الَّذِی لاَ دَوَائَ لَہُ إِلاَّ رِضْوَانَ اللہِ ، وَرِضْوَانُ اللہِ دَوَائٌ لاَ یَضُرُّ مَعَہُ دَائٌ ، وَمَنْ یُرِیدُ أَنْ یُرْضِیَ رَبَّہُ یُسْخِطُ نَفْسَہُ ، وَمَنْ لاَ یُسْخِطُ نَفْسَہُ لاَ یُرْضِی رَبَّہُ ، إنْ کَانَ کُلَّمَا ثَقُلَ عَلَی الإِنْسَاْن شَیْئٌ مِنْ دِینِہِ تَرَکَہُ أَوْشَکَ أَنْ لاَ یَبْقَی مَعَہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 36316","","","كتاب الزهد"
"36317","(۳۶۳۱۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنِ الْقَاسِمِ بْنِ أَبِی بَزَّۃَ ، قَالَ : سَمِعْتُ ابْنَ مُنَبِّہٍ یَقُولُ : إنَّا نَجِدُ فِی الْکُتُبِ ، أَنَّ اللَّہَ یَقُولُ : یَا ابْنَ آدَمَ إنَّک مَا عَبَدْتنِی وَرَجَوْتنِی فَإِنِّی غَافِرٌ لَک عَلَی مَا کَانَ ، وَحَقٌّ عَلَیَّ أَنْ لاَ أُضِلَّ عَبْدِی وَہُوَ حَرِیصٌ عَلَی الْہُدَی وَأَنَا الْحَکَمُ۔","","Musannaf Ibn Abi Shaybah 36317","","","كتاب الزهد"
"36318","(۳۶۳۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ سِمَاکِ بْنِ الْفَضْلِ ، عَنِ ابْنِ مُنَبِّہٍ ، قَالَ : مَثَلُ الَّذِی یَدْعُو بِغَیْرِ عَمَلٍ مَثَلُ الَّذِی یَرْمِی بِغَیْرِ وَتْرٍ۔","","Musannaf Ibn Abi Shaybah 36318","","","كتاب الزهد"
"36319","(۳۶۳۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ جَعْفَرِ بْنِ سُلَیْمَانَ الضُّبَعِیِّ ، عَنِ النُّعْمَانِ بْنِ الزُّبَیْرِ ، عَنِ ابْنِ مُنَبِّہٍ ، قَالَ : أَوْحَی اللہ إِلَی عُزَیْرٍ یَا عُزَیْرُ ، لاَ تَحْلِفْ بِی کَاذِبًا فَإِنِّی لاَ أَرْضَی عَمَّنْ یَحْلِفُ بِی کَاذِبًا ، یَا عُزَیْرُ بِرَّ ، وَالِدَیْک فَإِنَّہُ مَنْ بَرَّ وَالِدَیْہِ رَضِیت ، وَإِذَا رَضِیت بَارَکْت ، وَإِذَا بَارَکْت بَلَغَت النَّسْلَ الرَّابِعَ ، یَا عُزَیْرُ ، لاَ تَعُقَّ وَالِدَیْک فَإِنَّہُ مَنْ یَعُقُّ وَالِدَیْہِ غَضِبْت وَإِذَا غَضِبْت لَعَنْت ، وَإِذَا لَعَنْت بَلَغَت النَّسْلَ الرَّابِعَ۔","","Musannaf Ibn Abi Shaybah 36319","","","كتاب الزهد"
"36320","(۳۶۳۲۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا صَالِحٌ الْفَزَارِیّ ، عَنْ إبْرَاہِیمَ بْنِ مَیْمُونٍ ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ، قَالَ : قَالَ دَاوُد : یَا رَبِ ، ابْنُ آدَمَ لَیْسَ مِنْہُ شَعْرَۃٌ إِلاَّ تَحْتَہَا مِنْک نِعْمَۃٌ ، وَفَوْقَہَا مِنْک نِعْمَۃٌ ، فَمِنْ أَیْنَ یُکَافِؤکَ بِمَا أَعْطَیْتَہُ ، قَالَ : فَأَوْحَی اللَّہُ إلَیْہِ : یَا دَاوُد ، إنِّی أُعْطِی الْکَثِیرَ وَأَرْضَی بِالْیَسِیرِ ، أداء شَکَرَ ذَلِکَ لِی أَنْ یَعْلَمَ أَنَّ مَا بِہِ مِنْ نِعْمَۃٍ مِنِّی۔","","Musannaf Ibn Abi Shaybah 36320","","","كتاب الزهد"
"36321","(۳۶۳۲۱) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ ، قَالَ : أَعْطَی اللَّہُ مُوسَی نُورًا یَکُونُ لِغَیْرِہِ نَارًا ، قَالَ : فَدَعَا مُوسَی ہَارُونَ ، فَقَالَ : إنَّ اللَّہَ وَہَبَ لِی نُورًا یَکُونُ لِغَیْرِی نَارًا ، وَإِنَّ مُوسَی وَہَبَہُ لِی ، وَإِنِّی أَہَبُہُ لَکُمَا قَالَ : فَکَانَ ابْنَا ہَارُونَ یُقَرِّبَانِ الْقُرْبَانَ لِبَنِی إسْرَائِیلَ ، قَالَ : فأحدثا شَیْئًا فَنَزَلَتِ النَّارُ فَاحْتَرَقَا ، قَالَ : فَقِیلَ لَہُمَا : یَا مُوسَی وَہَارُونُ ، کَذَا أَصْنَعُ بِمَنْ عَصَانِی مِنْ أَہْلِ طَاعَتِی فَکَیْفَ أَصْنَعُ بِمَنْ عَصَانِی مِنْ أَہْلِ مَعْصِیَتِی۔","","Musannaf Ibn Abi Shaybah 36321","","","كتاب الزهد"
"36322","(۳۶۳۲۲) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا مَہْدِیٌّ ، قَالَ : حَدَّثَنَا عَبْدُ الْحَمِیدِ صَاحِبُ الزِّیَادِیِّ ، عَنِ ابْنِ مُنَبِّہٍ ، قَالَ : کَانَ فِیمَنْ کَانَ قَبْلَکُمْ رَجُلٌ عَبَدَ اللَّہَ زَمَانًا ، ثُمَّ طَلَبَ إِلَی اللہِ حَاجَۃً وَصَامَ لِلَّہِ سَبْعِینَ سَبْتًا یَأْکُلُ کُلَّ سَبْتٍ إحْدَی عَشَرَ مَرَّۃً ، قَالَ : وَطَلَبَ إِلَی اللہِ حَاجَتَہُ فَلَمْ یُعْطَہَا ، فَأَقْبَلَ عَلَی نَفْسِہِ ، فَقَالَ : أَیَّتُہَا النَّفْسُ مِنْ قِبَلِکَ أُتِیتُ ، لَوْ کَانَ عِنْدَکِ خَیْرٌ لأُعْطِیتِ حَاجَتَکَ ، وَلَکِنْ لَیْسَ عِنْدَکِ خَیْرٌ ، قَالَ : فَنَزَلَ إلَیْہِ سَاعَتَئِذٍ مَلَکٌ ، فَقَالَ لَہُ : یَا ابْنَ آدَمَ ، إنَّ سَاعَتَکَ ہَذِہِ الَّتِی أزریت عَلَی نَفْسِکَ فِیہَا خَیْرٌ مِنْ عِبَادَتِکَ کُلِّہَا الَّتِی مَضَتْ ، وَقَدْ أَعْطَاک اللَّہُ حَاجَتَکَ الَّتِی سَأَلْت۔","","Musannaf Ibn Abi Shaybah 36322","","","كتاب الزهد"
"36323","(۳۶۳۲۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، قَالَ : حدَّثَنِی مَنْ لاَ أَتَّہِمُ ، عَنِ ابْنِ مُنَبِّہٍ ، أَنَّہُ جَلَسَ ہُوَ وَطَاوُسٌ وَنَحْوُہُمَا مِنْ أَہْلِ ذَلِکَ الزَّمَانِ فَذَکَرُوا أَیُّ أَمْرِ اللہِ أَسْرَعُ ، فَقَالَ بَعْضُہُمْ : قَوْلُ اللہِ کَلَمْحِ الْبَصَرِ ، وَقَالَ بَعْضُہُمْ : السَّرِیرُ حِینَ أُتِیَ بِہِ سُلَیْمَانُ ، فَقَالَ : ابْنُ مُنَبِّہٍ : أَسْرَعُ أَمْرِ اللہِ ، أَنَّ یُونُسَ عَلَی حَافَّۃِ السَّفِینَۃِ إذْ أَوْحَی اللَّہُ إِلَی نُونٍ فِی نِیلِ مِصْرَ ، قَالَ : فَمَا خَرَّ مِنْ حَافَّتِہَا إِلاَّ فِی جَوْفِہِ۔","","Musannaf Ibn Abi Shaybah 36323","","","كتاب الزهد"
"36324","(۳۶۳۲۴) حَدَّثَنَا الْمُحَارِبِیُّ، عَنْ عَبْدِالرَّحْمَنِ بْنِ سُلَیْمَانَ الْعَبْسِیِّ، عَنْ إدْرِیسَ بْنِ سِنَانٍ، عَنْ جَدِّہ وَہْبِ بْنِ مُنَبِّہٍ، قَالَ: کَانَ عَلَی مُوسَی یَوْمَ نَاجَی رَبَّہُ عِنْدَ الشَّجَرَۃِ جُبَّۃٌ مِنْ صُوفٍ وَتُبَّانٌ مِنْ صُوفٍ وَقَلَنْسُوَۃٌ مِنْ صُوفٍ۔","","Musannaf Ibn Abi Shaybah 36324","","","كتاب الزهد"
"36325","(۳۶۳۲۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَوْفٍ قَالَ : قَالَ ابْنُ مُنَبِّہٍ : مِنْ خِصَالِ الْمُنَافِقِ أَنْ یُحِبَّ الْحَمْدَ وَیُبْغِضَ الذَّمَّ۔","","Musannaf Ibn Abi Shaybah 36325","","","كتاب الزهد"
"36326","(۳۶۳۲۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ کِتَابِ أَبِی قِلاَبَۃَ ، قَالَ : مَثَلُ الْعُلَمَائِ مَثَلُ النُّجُومِ الَّتِی یُہْتَدَی بِہَا ، وَالأَعْلاَمِ الَّتِی یُقْتَدَی بِہَا ، إذَا تَغَیَّبَتْ عَنْہُمْ تَحَیَّرُوا ، وَإِذَا تَرَکُوہَا ضَلُّوا۔","","Musannaf Ibn Abi Shaybah 36326","","","كتاب الزهد"
"36327","(۳۶۳۲۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّہُ قَالَ فِی دُعَائِہِ : اللَّہُمَّ إنِّی أَسْأَلُک الطَّیِّبَاتِ وَتَرْکَ الْمُنْکَرَاتِ وَحُبَّ الْمَسَاکِینِ ، وَأَنْ تَتُوبَ عَلَیَّ ، وَإِذَا أَرَدْت بِعِبَادِکَ فِتْنَۃً أَنْ تَتَوَفَّانِی غَیْرَ مَفْتُونٍ۔","","Musannaf Ibn Abi Shaybah 36327","","","كتاب الزهد"
"36328","(۳۶۳۲۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إنَّ اللَّہَ لَمَّا لَعَنَ إبْلِیسَ سَأَلَہُ النَّظِرَۃَ ، فَأَنْظَرَہُ إِلَی یَوْمِ الدِّینِ ، قَالَ : وَعِزَّتِکَ لاَ أَخْرُجُ مِنْ جَوْفِ ، أَوْ مِنْ قَلْبِ ابْنِ آدَمَ مَا دَامَ فِیہِ الرُّوحُ ، قَالَ : وَعِزَّتِی لاَ أَحْجُب عَنْہُ التَّوْبَۃَ مَا دَامَ فِیہِ الرُّوحُ۔","","Musannaf Ibn Abi Shaybah 36328","","","كتاب الزهد"
"36329","(۳۶۳۲۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا أَیُّوبُ قَالَ : قَالَ مُسْلِمُ بْنُ یَسَارٍ : لَوْ کَانَ أَبُو قِلاَبَۃَ مِنَ الْعُجْمِ کَانَ موبز موبزان۔","","Musannaf Ibn Abi Shaybah 36329","","","كتاب الزهد"
"36330","(۳۶۳۳۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ سَمِعْت أَیُّوبَ وَذَکَرَ أَبَا قِلاَبَۃَ ، فَقَالَ : کَانَ وَاللہِ مِنَ الْفُقَہَائِ وَذَوِی الأَلْبَابِ۔","","Musannaf Ibn Abi Shaybah 36330","","","كتاب الزهد"
"36331","(۳۶۳۳۱) حَدَّثَنَا یَعْمُرُ ، قَالَ : حدَّثَنَا ابْنُ مُبَارَکٍ ، قَالَ : حَدَّثَنَا مَعْمَرٌ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : خَیْرُ أُمُورِکُمْ أَوْسَاطُہَا۔ (ابو نعیم ۲۸۶)","","Musannaf Ibn Abi Shaybah 36331","","","كتاب الزهد"
"36332","(۳۶۳۳۲) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی سِنَانٍ ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ ، قَالَ : مَا الْخَلْقُ فِی قَبْضَۃِ اللہِ إِلاَّ کَخَرْدَلَۃٍ ہَاہُنَا مِنْ أَحَدِکُمْ۔","","Musannaf Ibn Abi Shaybah 36332","","","كتاب الزهد"
"36333","(۳۶۳۳۳) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی یَحْیَی عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، عَنْ أَبِیہِ ، قَالَ: کَانَ أَفْضَلُہُمْ عِنْدَہُمْ ، یَعْنِی الْمَاضِینَ أَسْلَمَہُمْ صَدْرًا وَأَقَلَّہُمْ غِیبَۃً۔","","Musannaf Ibn Abi Shaybah 36333","","","كتاب الزهد"
"36334","(۳۶۳۳۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی عُقْبَۃُ بْنُ أَبِی یَزِیدَ الْقُرَشِیُّ ، قَالَ : سَمِعْتُ زَیْدَ بْنَ أَسْلَمَ یَذْکُرُ فِی قَوْلِ اللہِ : {وَالْمُسْتَغْفِرِینَ بِالأَسْحَارِ} قَالَ : مَنْ شَہِدَ صَلاَۃَ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 36334","","","كتاب الزهد"
"36335","(۳۶۳۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، قَالَ : حَدَّثَنَا أَبُو ہَمَّامٍ ، عَنِ الْحَسَنِ ، قَالَ : رَحِمَ اللَّہُ عَبْدًا وقف عِنْدَ ہَمِّہِ ، فَإِنَّہُ لَیْسَ مِنْ عَبْدٍ یَعْمَلُ حَتَّی یَہُمَّ ، فَإِنْ کَانَ خَیْرًا أَمْضَاہُ ، وَإِنْ کَانَ شَرًّا کَفَّ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 36335","","","كتاب الزهد"
"36336","(۳۶۳۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ الْقَصِیرِ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنْ شَیْئٍ ، فَقُلْتُ : إنَّ الْفُقَہَائَ یَقُولُونَ کَذَا وَکَذَا ، قَالَ : وَہَلْ رَأَیْت فَقِیہًا بِعَیْنَیْک ، إنَّمَا الْفَقِیہُ الزَّاہِدُ فِی الدُّنْیَا ، الْبَصِیرُ بِدِینِہِ ، الْمُدَاوِمُ عَلَی عِبَادَۃِ رَبِّہِ۔","","Musannaf Ibn Abi Shaybah 36336","","","كتاب الزهد"
"36337","(۳۶۳۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ، عَنْ یُونُسَ قَالَ: قَالَ الْحَسَنُ: لاَ یَزَالُ الْعَبْدُ بِخَیْرٍ مَا عَلِمَ مَا الَّذِی یُفْسِدُ عَلَیْہِ عَمَلَہُ ، قَالَ یُونُسُ : إنَّ مِنْہُمْ مَنْ یَرَی أَنَّہُ عَلَی حَقٍّ ، وَمِنْہُمْ مَنْ تَغْلِبُ شَہْوَتُہُ۔","","Musannaf Ibn Abi Shaybah 36337","","","كتاب الزهد"
"36338","(۳۶۳۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یَزِیدَ ، وَأَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُقَالَ : قَلْبُ الْمُؤْمِنِ وَرَائَ لِسَانِہِ ، فَإِذَا ہَمَّ أحدکم بِأَمْرٍ تَدَبَّرَہُ ، فَإِنْ کَانَ خَیْرًا تَکَلَّمَ بِہِ ، وَإِنْ کَانَ غَیْرَ ذَلِکَ سَکَتَ ، وَقَلْبُ الْمُنَافِقِ عَلَی طَرَفِ لِسَانِہِ ، فَإِذَا ہَمَّ بِشَیْئٍ تَکَلَّمَ بِہِ وَأَبْدَاہُ۔","","Musannaf Ibn Abi Shaybah 36338","","","كتاب الزهد"
"36339","(۳۶۳۳۹) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ الْمُؤْمِنَ أَحْسَنَ الظَّنَّ بِرَبِّہِ فَأَحْسَنَ الْعَمَلَ ، وَإِنَّ الْمُنَافِقَ أَسَائَ الظَّنَّ بِرَبِّہِ فَأَسَائَ الْعَمَلَ۔","","Musannaf Ibn Abi Shaybah 36339","","","كتاب الزهد"
"36340","(۳۶۳۴۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : أَطْلُبُ الْعِلْمَ طَلَبًا لاَ یَضُرُّ بِالْعِبَادَۃِ ، وَأَطْلُبُ الْعِبَادَۃَ طَلَبًا لاَ یَضُرُّ بِالْعِلْمِ ، فَإِنَّ مَنْ عَمِلَ بِغَیْرِ عِلْمٍ کَانَ مَا یُفْسِدُ أَکْثَرَ مِمَّا یُصْلِحُ۔","","Musannaf Ibn Abi Shaybah 36340","","","كتاب الزهد"
"36341","(۳۶۳۴۱) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، قَالَ : کَانَ الْحَسَنُ رَجُلاً مَحْزُونًا۔","","Musannaf Ibn Abi Shaybah 36341","","","كتاب الزهد"
"36342","(۳۶۳۴۲) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لَقَدْ أَدْرَکْت أَقْوَامًا لاَ یَسْتَطِیعُونَ أَنْ یُسِرُّوا من الْعَمَلَ شَیْئًا إِلاَّ أَسَرُّوہُ۔","","Musannaf Ibn Abi Shaybah 36342","","","كتاب الزهد"
"36343","(۳۶۳۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ الرَّجُلَ لَیَعْمَلُ الْحَسَنَۃَ فَتَکُونُ نُورًا فِی قَلْبِہِ وَقُوَّۃً فِی بَدَنِہِ ، وَإِنَّ الرَّجُلَ لَیَعْمَلُ السَّیِّئَۃَ فَتَکُونُ ظُلْمَۃً فِی قَلْبِہِ وَوَہْنًا فِی بَدَنِہِ۔","","Musannaf Ibn Abi Shaybah 36343","","","كتاب الزهد"
"36344","(۳۶۳۴۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا الْتَقَوْا یَقُولُ الرَّجُلُ لِصَاحِبِہِ : ہَلْ أَتَاک أَنَّک وَارِدٌ ؟ فَیَقُولُ : نَعَمْ ، فَیَقُولُ : ہَلْ أَتَاک أَنَّک خَارِجٌ مِنْہَا ؟ فَیَقُولُ : لاَ ، فَیَقُولُ : فَفِیمَ الضَّحِکُ إذًا۔","Sahih","Musannaf Ibn Abi Shaybah 36344","","","كتاب الزهد"
"36345","(۳۶۳۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : حدَّثَنِی دَاوُد صَاحِبُ الْبَصْرِیِّ ، أَنَّ الْحَسَنَ ، قَالَ : وَایْمُ اللہِ مَا مِنْ عَبْدٍ قُسِمَ لَہُ رِزْقُ یَوْمٍ بِیَوْمٍ فَلَمْ یَعْلَمْ أَنَّہُ قَدْ خُیِّرَ لَہُ إِلاَّ عَاجِزٌ ، أَوْ غَبِیُّ الرَّأْیِ۔","","Musannaf Ibn Abi Shaybah 36345","","","كتاب الزهد"
"36346","(۳۶۳۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُبَارَکٌ ، عَنِ الْحَسَنِ ، قَالَ : وَاللہِ مَا ہِیَ بِأَشَرِّ أَیَّامِ الْمُؤْمِنِ أَیَّامٌ قُرِّبَ لَہُ فِیہَا مِنْ أَجَلِہِ وَذُکِّرَ مَا نَسِیَ مِنْ مَعَادِہِ وَکُفِّرَتْ بِہَا خَطَایَاہُ۔","","Musannaf Ibn Abi Shaybah 36346","","","كتاب الزهد"
"36347","(۳۶۳۴۷) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، قَالَ : مَا رَأَیْت أَحَدًا أَشَدَّ تَوَلِّیًا مِنْ قَارِئٍ إذَا تَوَلَّی۔","","Musannaf Ibn Abi Shaybah 36347","","","كتاب الزهد"
"36348","(۳۶۳۴۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ وَثَابِتٌ وَحُمَیْدٌ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : عَلَی الصِّرَاطِ حَسَکٌ وَسَعْدَانُ ، الزَّلاَّلُونَ وَالزَّلاَّلاَتُ یَوْمَئِذٍ کَثِیرٌ۔","","Musannaf Ibn Abi Shaybah 36348","","","كتاب الزهد"
"36349","(۳۶۳۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ الرَّجُلَ لَیَطْلُبُ الْبَابَ مِنَ الْعِلْمِ فَیَعْمَلُ بِہِ فَیَکُونُ خَیْرًا لَہُ مِنَ الدُّنْیَا لَوْ کَانَتْ لَہُ فَجَعَلَہَا فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 36349","","","كتاب الزهد"
"36350","(۳۶۳۵۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی عُبَیْدُ اللہِ بْنُ شُمَیْطِ بْنِ عَجْلاَنَ ، قَالَ : أَخْبَرَنِی أَبِی ، أَنَّہُ سَمِعَ الْحَسَنَ یَقُولُ : إنَّ الْمُؤْمِنَ یُصْبِحُ حَزِینًا وَیُمْسِی حَزِینًا ، وَیَکْفِیہِ مَا یَکْفِی الْعُنَیْزَۃَ۔","","Musannaf Ibn Abi Shaybah 36350","","","كتاب الزهد"
"36351","(۳۶۳۵۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حدثنا أَیُّوبُ ، قَالَ سَمِعْت الْحَسَنَ یَقُولُ : إذَا رَأَیْت الرَّجُلَ یُنَافِسُ فِی الدُّنْیَا فَنَافِسْہُ فِی الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 36351","","","كتاب الزهد"
"36352","(۳۶۳۵۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ : {إنَّ عَذَابَہَا کَانَ غَرَامًا} قَالَ : عَلِمُوا أَنَّ کُلَّ غَرِیمٍ مُفَارِقٌ غَرِیمَہُ إِلاَّ غَرِیمَ جَہَنَّمَ۔","","Musannaf Ibn Abi Shaybah 36352","","","كتاب الزهد"
"36353","(۳۶۳۵۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ قُرَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : {ظَہَرَ الْفَسَادُ فِی الْبَرِّ وَالْبَحْرِ بِمَا کَسَبَتْ أَیْدِی النَّاسِ} قَالَ : أَفْسَدَہُمُ اللَّہُ بِذُنُوبِہِمْ فِی بَرِّ الأَرْضِ وَبَحْرِہَا بِأَعْمَالِہِمُ الْخَبِیثَۃِ لَعَلَّہُمْ یَرْجِعُونَ یَرْجِعُ مَنْ بَعْدَہُمْ۔","","Musannaf Ibn Abi Shaybah 36353","","","كتاب الزهد"
"36354","(۳۶۳۵۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : بَلَغَنِی ، أَنَّ فِی کِتَابِ اللہِ : ابْنَ آدَمَ ثِنْتَانِ جَعَلْتُہُمَا لَک وَلَمْ یَکُونَا لَک : وَصِیَّۃٌ فِی مَالِکَ بِالْمَعْرُوفِ وَقَدْ صَارَ الْمِلْکُ لِغَیْرِکَ ، وَدَعْوَۃُ الْمُسْلِمِینَ لَک وَأَنْتَ فِی مَنْزِلٍ لاَ تَسْتَعْتِبُ فِیہِ مِنْ سء ، وَلاَ تَزِیدُ فِی حَسَنٍ۔","","Musannaf Ibn Abi Shaybah 36354","","","كتاب الزهد"
"36355","(۳۶۳۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ یُونُسَ، فَقَالَ: لَمَّا تُوُفِّیَ سَعِیدُ بْنُ أَبِی الْحَسَنِ وَجَدَ عَلَیْہِ الْحَسَنُ وَجْدًا شَدِیدًا، فَکُلِّمَ فِی ذَلِکَ ، فَقَالَ: مَا سَمِعْت اللَّہَ عَابَ الْحُزْنَ عَلَی یَعْقُوبَ۔","","Musannaf Ibn Abi Shaybah 36355","","","كتاب الزهد"
"36356","(۳۶۳۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا أَبُو مُحَمَّدٍ الأَسَدِیُّ ، عَنِ الْحَسَنِ ، قَالَ : مَنْ دَخَلَ الْمَقَابِرَ ، فَقَالَ : اللَّہُمَّ رَبَّ الأَجْسَادِ الْبَالِیَۃِ وَالْعِظَامِ النَّخِرَۃِ الَّتِی خَرَجَتْ مِنَ الدُّنْیَا وَہِیَ بِکَ مُؤْمِنَۃٌ : أَدْخِلْ عَلَیْہَا رَوْحًا مِنْ عِنْدِکَ وَسَلاَمًا منی اسْتَغْفَرَ لَہُ کُلُّ مُؤْمِنٍ مَاتَ مُنْذُ خَلَقَ اللَّہُ آدَمَ۔","","Musannaf Ibn Abi Shaybah 36356","","","كتاب الزهد"
"36357","(۳۶۳۵۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی بْنِ الْمُخْتَارِ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ الْمُؤْمِنَ قَوَّامٌ عَلَی نَفْسِہِ یُحَاسِبُ نَفْسَہُ لِلَّہِ ، وَإِنَّمَا خَفَّ الْحِسَابُ یَوْمَ الْقِیَامَۃِ عَلَی قَوْمٍ حَاسَبُوا أَنْفُسَہُمْ فِی الدُّنْیَا ، وَإِنَّمَا شَقَّ الْحِسَابُ یَوْمَ الْقِیَامَۃِ عَلَی قَوْمٍ أَخَذُوا ہَذَا الأَمْرَ عن غَیْرِ مُحَاسَبَۃٍ ، إنَّ الْمُؤْمِنَ یَفْجَؤُہُ الشَّیْئُ فَیُعْجِبُہُ فَیَقُولُ : وَاللہِ إنِّی لأشْتَہِیک وَإِنَّک لَمِنْ حَاجَتِی ، وَلَکِنْ وَاللہِ مَا مِنْ وُصْلَۃٍ إلَیْک ، ہَیْہَاتَ حِیلَ بَیْنِی وَبَیْنَکَ ، وَیَفْرُطُ مِنْہُ الشَّیْئُ فَیَرْجِعُ إِلَی نَفْسِہِ فَیَقُولُ : مَا أَرَدْت إِلَی ہَذَا ، مَا لِی وَلِہَذَا ، مَا لِی عدد غیر ہذا وَاللہِ لاَ أَعُودُ إِلَی ہَذَا أَبَدًا إنْ شَائَ اللَّہُ ، إنَّ الْمُؤْمِنِینَ قَوْمٌ أَوْثَقَہُمُ الْقُرْآنُ وَحَالَ بَیْنَہُمْ وَبَیْنَ ہَلَکَتِہِمْ ، إنَّ الْمُؤْمِنَ أَسِیرٌ فِی الدُّنْیَا یَسْعَی فِی فِکَاکِ رَقَبَتِہِ ، لاَ یَأْمَنُ شَیْئًا حَتَّی یَلْقَی اللَّہَ ، یَعْلَمُ أَنَّہُ مَأْخُوذٌ عَلَیْہِ فِی ذَلِکَ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 36357","","","كتاب الزهد"
"36358","(۳۶۳۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ سَمِعْت عَبْدَ رَبِّہِ أَبَا کَعْبٍ یَقُولُ : سَمِعْت الْحَسَنَ یَقُولُ : الْمُؤْمِنُ فِی الدُّنْیَا کَالْغَرِیبِ لاَ یُنَافِسُ فِی عِزِّہَا ، وَلاَ یَجْزَعُ مِنْ ذُلِّہَا ، لِلنَّاسِ حَالٌ وَلَہُ حَالٌ ، وَجِّہُوا ہَذِہِ الْفُضُولَ حَیْثُ وَجَّہَہَا اللَّہُ۔n حدثنا أبو عَبْدُ الرَّحْمَنِ ، قَالَ : حدَّثَنَا أَبُو بَکْرِ بْنُ أَبِی شَیْبَۃَ ، قَالَ :","","Musannaf Ibn Abi Shaybah 36358","","","كتاب الزهد"
"36359","(۳۶۳۵۹) حَدَّثَنَا عَفَّان ، قَالَ : حَدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ حَدَّثَنَا زَکَرِیَّا ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : إنَّ الإِیمَانَ لَیْسَ بِالتَّحَلِّی ، وَلاَ بِالتَّمَنِّی ، إنَّ الإِیمَانَ مَا وَقَرَ فِی الْقَلْبِ وَصَدَّقَہُ الْعَمَلُ۔","","Musannaf Ibn Abi Shaybah 36359","","","كتاب الزهد"
"36360","(۳۶۳۶۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، قَالَ ، مَرَّ عَلَی الْحَسَنِ بِرْذَوْنٌ یُہَمْلِجُ ، فَقَالَ : أَوَّہُ قَدْ عَلِمْتُ أَنَّ السَّاعَۃَ إذَا أَقْبَلَتْ أَقْبَلَتْ بِغَمٍّ۔","","Musannaf Ibn Abi Shaybah 36360","","","كتاب الزهد"
"36361","(۳۶۳۶۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ الْمُؤْمِنِینَ عَجَّلُوا الْخَوْفَ فِی الدُّنْیَا فَأَمَّنَہُمَ اللَّہُ یَوْمَ الْقِیَامَۃِ ، وَإِنَّ الْمُنَافِقِینَ أَخَّرُوا الْخَوْفَ فِی الدُّنْیَا فَأَخَافَہُمَ اللَّہُ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 36361","","","كتاب الزهد"
"36362","(۳۶۳۶۲) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : عَمِلَ الْقَوْمُ وَلَمْ یَتَمَنَّوْا۔","","Musannaf Ibn Abi Shaybah 36362","","","كتاب الزهد"
"36363","(۳۶۳۶۳) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ مُبَارَکٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : إنَّ أَقْوَامًا بَکَتْ أَعْیُنُہُمْ وَلَمْ تَبْکِ قُلُوبُہُمْ، فَمَنْ بَکَتْ عَیْنَاہُ فَلْیَبْکِ قَلْبُہُ۔","","Musannaf Ibn Abi Shaybah 36363","","","كتاب الزهد"
"36364","(۳۶۳۶۴) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : أَکْیَسُہُمْ مَنْ بَکَی۔","","Musannaf Ibn Abi Shaybah 36364","","","كتاب الزهد"
"36365","(۳۶۳۶۵) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : أَدْرَکْت أَقْوَامًا یَبْذُلُونَ أَوْرَاقَہُمْ وَیَخْزُنُونَ أَلْسِنَتَہُمْ ، ثُمَّ أَدْرَکْت مِنْ بَعْدِہِمْ أَقْوَامًا خَزَّنُوا أَوْرَاقَہُمْ وَأَرْسَلُوا أَلْسِنَتَہُمْ۔","","Musannaf Ibn Abi Shaybah 36365","","","كتاب الزهد"
"36366","(۳۶۳۶۶) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : حلَمَائُ إنْ جُہِلَ عَلَیْہِمْ لَمْ یَسْفَہُوا ، ہَذَا نَہَارُہُمْ فَکَیْفَ لَیْلُہُمْ ، خَیْرُ لَیْلٍ أَجْرُوا دُمُوعَہُمْ عَلَی خُدُودِہِمْ وَصَفُّوا أَقْدَامَہُمْ یَطْلُبُونَ إِلَی اللہِ فِی فِکَاکِ رِقَابِہِمْ۔","","Musannaf Ibn Abi Shaybah 36366","","","كتاب الزهد"
"36367","(۳۶۳۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : مَا سَمِعْت الْحَسَنَ یَتَمَثَّلُ بِبَیْتِ شِعْرٍ إِلاَّ ہَذَا الْبَیْتَ : لَیْسَ مَنْ مَاتَ فَاسْتَرَاحَ بِمَیِّتٍ إنَّمَا الْمَیِّتُ مَیِّتُ الأَحْیَائِ۔n ثُمَّ قَالَ : صَدَقَ وَاللہِ ، إِنَّہُ لَیَکُونُ حَی وَہُوَ مَیِّتُ الْقَلْبِ۔","","Musannaf Ibn Abi Shaybah 36367","","","كتاب الزهد"
"36368","(۳۶۳۶۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : مَا زَالَ الْحَسَنُ یَبْتَغِی الْحِکْمَۃَ حَتَّی نَطَقَ بِہَا۔","","Musannaf Ibn Abi Shaybah 36368","","","كتاب الزهد"
"36369","(۳۶۳۶۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حدثنا أَیُّوبُ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِہِ : {لَکُمُ الْوَیْلُ مِمَّا تَصِفُونَ} قَالَ : ہِیَ وَاللہِ لِکُلِّ وَاصِفٍ کَذُوبٍ إِلَی یَوْمِ الْقِیَامَۃِ الْوَیْلُ۔","","Musannaf Ibn Abi Shaybah 36369","","","كتاب الزهد"
"36370","(۳۶۳۷۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، عَنِ الْحَسَنِ ، قَالَ لَمَّا خَلَقَ اللَّہُ آدَمَ وَذُرِّیَّتَہُ ، قَالَتِ الْمَلاَئِکَۃُ : إنَّ الأَرْضَ لاَ تَسَعُہُمْ ، فَقَالَ : إنِّی جَاعِلٌ مَوْتًا ، قَالَ : إذًا لاَ یُہَنِّئُہُمَ الْعَیْشُ ، قَالَ : إنِّی جَاعِلٌ أَمَلاً۔","Hasan","Musannaf Ibn Abi Shaybah 36370","","","كتاب الزهد"
"36371","(۳۶۳۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، عَنِ الْحَسَنِ ، قَالَ : تَفَکُّرُ سَاعَۃٍ خَیْرٌ مِنْ قِیَامِ لَیْلَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 36371","","","كتاب الزهد"
"36372","(۳۶۳۷۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سُفْیَانَ السَّعْدِیِّ ، قَالَ : سَمِعْتُ الْحَسَنَ یَتَمَثَّلُ ہَذَا الْبَیْتَ : nیَسُرُّ الْفَتَی مَا کَانَ قَدِمَ مِنْ تُقًی إذَا عَرَفَ الدَّائَ الَّذِی ہُوَ قَاتِلُہُ","","Musannaf Ibn Abi Shaybah 36372","","","كتاب الزهد"
"36373","(۳۶۳۷۳) حَدَّثَنَا الْحُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ : قَالَ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَصْحَابِہِ : أَنْتُمْ فِی النَّاسِ کَمِثْلِ الْمِلْحِ فِی الطَّعَامِ ، قَالَ : ثُمَّ یَقُولُ الْحَسَنُ : وَہَلْ یَطِیبُ الطَّعَامُ إِلاَّ بِالْمِلْحِ ، ثُمَّ یَقُولُ الْحَسَنُ : فَکَیْفَ بِقَوْمٍ قَدْ ذَہَبَ مِلْحُہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 36373","","","كتاب الزهد"
"36374","(۳۶۳۷۴) حَدَّثَنَا الْحُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : أَدْرَکْتُہُمْ وَاللہِ إنْ کَانَ أَحَدُہُمْ لَیَعِیشُ عُمْرَہُ مَا طُوِیَ لَہُ ثَوْبٌ قَطُّ ، وَلاَ أَمَرَ أَہْلَہُ بِصَنْعَۃِ طَعَامٍ لَہُ قَطُّ ، وَلاَ حَالَ بَیْنَہُ وَبَیْنَ الأَرْضِ شَیْئٌ قَطُّ۔","","Musannaf Ibn Abi Shaybah 36374","","","كتاب الزهد"
"36375","(۳۶۳۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنِی أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : لَمَّا عُرِضَ عَلَی آدَمَ ذُرِّیَّتُہُ رَأَی فَضْلَ بَعْضِہِمْ عَلَی بَعْضٍ ، فَقَالَ : رَبِّ لَوْ سَوَّیْت بَیْنَہُمْ ، قَالَ : یَا آدَم ، إنِّی أُحِبُّ أَنْ أُشْکَرَ ، یَرَی ذُو الْفَضْلِ فَضْلَہُ فَیَحْمَدُنِی وَیَشْکُرُنِی۔ (عبدالرزاق ۱۹۵۷۶)","","Musannaf Ibn Abi Shaybah 36375","","","كتاب الزهد"
"36376","(۳۶۳۷۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، عَنْ مَسْرُوقٍ ، قَالَ : مَا دَخَلَ بَیْتًا حِبَرَۃٌ إِلاَّ دَخَلَتْہُ غَبَرَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 36376","","","كتاب الزهد"
"36377","(۳۶۳۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا عُمَرُ بْنُ حَمْزَۃَ ، قَالَ : أَخْبَرَنِی الْحَارِثُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِی ذُؤَیْبٍ ، قَالَ : قَالَتْ عَائِشَۃُ : مَا أَعْلَمُ رَجُلاً سَلَّمَہُ اللَّہُ مِنْ أُمُورِ النَّاسِ وَاسْتَقَامَ عَلَی طَرِیقَۃِ مَنْ کَانَ قَبْلَہُ اسْتِقَامَۃَ عَبْدِ اللہِ بْنِ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 36377","","","كتاب الزهد"
"36378","(۳۶۳۷۸) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، قَالَ : قَالَ رَجُلٌ لِمُحَمَّدِ بْنِ وَاسِعٍ : إنِّی لأحِبُّک فِی اللہِ ، قَالَ : أَحَبَّک الَّذِی أَحْبَبْتنِی لَہُ۔","","Musannaf Ibn Abi Shaybah 36378","","","كتاب الزهد"
"36379","(۳۶۳۷۹) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُجَاہِدٍ {ذَلِکَ یَوْمُ التَّغَابُنِ} قَالَ : إذَا دَخَلَ أَہْلُ الْجَنَّۃِ الْجَنَّۃَ وَأَہْلُ النَّارِ النَّارَ۔","","Musannaf Ibn Abi Shaybah 36379","","","كتاب الزهد"
"36380","(۳۶۳۸۰) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنِ ابْنِ شُبْرُمَۃَ ، قَالَ ، مَا رَأَیْت حَیًّا أَکْثَرَ شَیْخًا فَقہًا مُتَعَبِّدًا مِنْ بَنِی ثَوْرٍ۔","","Musannaf Ibn Abi Shaybah 36380","","","كتاب الزهد"
"36381","(۳۶۳۸۱) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی یَعْلَی ، قَالَ : کَانَ فِینَا ثَلاَثُونَ رَجُلا ، مَا مِنْہُمْ رَجُلٌ دُونَ رَبِیعِ بْنِ خُثَیْمٍ۔","","Musannaf Ibn Abi Shaybah 36381","","","كتاب الزهد"
"36382","(۳۶۳۸۲) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُتْبَۃَ الأَسَدِیِّ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ أُتِیَ بِخَبِیصٍ فَلَمْ یَأْکُلْہُ وَقَالَ : ہَذَا طَعَامُ الصِّبْیَانِ۔","","Musannaf Ibn Abi Shaybah 36382","","","كتاب الزهد"
"36383","(۳۶۳۸۳) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ الأَسَدِیِّ ، عَنِ ابْنِ مُنَبِّہٍ ، قَالَ : الإِیمَانُ عُرْیَانٌ ، وَلِبَاسُہُ التَّقْوَی ، وَمَالُہُ الْفِقْہُ ، وَزِینَتُہُ الْحَیَائُ۔","","Musannaf Ibn Abi Shaybah 36383","","","كتاب الزهد"
"36384","(۳۶۳۸۴) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ عَمْرُو بْنُ مَیْمُونٍ إذَا دَخَلَ الْمَسْجِدَ ذَکَرَ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 36384","","","كتاب الزهد"
"36385","(۳۶۳۸۵) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا تَعَلَّمْت فَتَعَ[corrupt]َّمْ لِنَفْسِکَ ، فَإِنَّ النَّاسَ قَدْ ذَہَبَتْ مِنْہُمَ الأَمَانَۃُ ، قَالَ : وَکَانَ یَعُدُّ الْحَدِیثَ حَرْفًا حَرْفًا۔","","Musannaf Ibn Abi Shaybah 36385","","","كتاب الزهد"
"36386","(۳۶۳۸۶) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ عنْ شَیْخٍ لَہُمْ ، أَنَّہُ کَانَ إذَا سَمِعَ السَّائِلَ یَقُولُ : مَنْ یُقْرِضُ اللَّہَ قَرْضًا حَسَنًا قَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ ، ہَذَا الْقَرْضُ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 36386","","","كتاب الزهد"
"36387","(۳۶۳۸۷) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سُرِّیَّۃِ الرَّبِیعِ ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیْمٍ یُحِبُّ الْحَلْوَی فَیَقُولُ لَنَا : اصْنَعُوا لِی طَعَامًا فَنَصْنَعُ لَہُ طَعَامًا کَثِیرًا فَیَدْعُو فَرُّوخًا وَفُلاَنًا فَیُطْعِمُہُمْ رَبِیعٌ بِیَدِہِ وَیَسْقِیہِمْ ، وَیَشْرَبُ ہُوَ فَضْلَ شَرَابِہِمَا ، فَیُقَالَ لَہُ : مَا یَدْرِیَانِ ہَذَانِ مَا تُطْعِمُہُمَا فَیَقُولُ : لَکِنَّ اللَّہَ یَدْرِی۔","","Musannaf Ibn Abi Shaybah 36387","","","كتاب الزهد"
"36388","(۳۶۳۸۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ بختری الطَّائِیِّ ، قَالَ : کَانَ یَقُولُ : اغْبِطَ الأَحْیَائَ بِمَا تَغْبِطُ بِہِ الأَمْوَاتَ ، وَاعْلَمْ ، أَنَّ الْعِبَادَۃَ لاَ تَصْلُحُ إِلاَّ بِزُہْدٍ وَذُلِّ عِنْدَ الطَّاعَۃ وَاسْتَصْعِبْ عند مَعْصِیَۃٍ ، وَأَحِبَّ النَّاسَ عَلَی قَدْرِ تَقْوَاہُمْ۔","","Musannaf Ibn Abi Shaybah 36388","","","كتاب الزهد"
"36389","(۳۶۳۸۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ حُمَیْدٍ ، قَالَ : سَمِعْتُ أَبَا إِسْحَاقَ یَقُولُ : أَقْرَأَ أَبُو عَبْدِ الرَّحْمَنِ السُّلَمِیُّ الْقُرْآنَ فِی الْمَسْجِدِ أَرْبَعِینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 36389","","","كتاب الزهد"
"36390","(۳۶۳۹۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُوسَی بْنِ قَیْسٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : لَوْ کَانَ الْمُؤْمِنُ عَلَی قَصَبَۃٍ فِی الْبَحْرِ لَقَیَّضَ اللَّہُ لَہُ مَنْ یُؤْذِیہِ۔","","Musannaf Ibn Abi Shaybah 36390","","","كتاب الزهد"
"36391","(۳۶۳۹۱) حَدَّثَنَا غُنْدَرٌ مُحَمَّدِ بْنِ جَعْفَرٍ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِی کَثِیرٍ الزُّبَیْدِیِّ ، عَنِ ابْنِ عَمْرو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکُمْ وَالظُّلْمَ فَإِنَّ الظُّلْمَ ظُلُمَاتٌ یَوْمَ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 36391","","","كتاب الزهد"
"36392","(۳۶۳۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الظُّلْمُ ظُلُمَاتٌ یَوْمَ الْقِیَامَۃِ۔ (بخاری ۲۴۴۷۔ مسلم ۱۹۹۶)","Sahih","Musannaf Ibn Abi Shaybah 36392","","","كتاب الزهد"
"36393","(۳۶۳۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ لِی سَلْمَانُ : أَتَدْرِی مَا الظُّلُمَاتُ یَوْمَ الْقِیَامَۃِ ہُوَ ظُلْمُ النَّاسِ بَیْنَہُمْ فِی الدُّنْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 36393","","","كتاب الزهد"
"36394","(۳۶۳۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْفَزَارِیِّ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَوْحَی اللَّہُ إِلَی دَاوُد علیہ السلام : قُلْ لِلظَّلَمَۃِ : لاَ یَذْکُرُونِی فَإِنَّہُ حَقٌّ عَلَیَّ أَنْ أَذْکُرَ مَنْ ذَکَرَنِی ، وَإِنَّ ذِکْرِی إیَّاہُمْ أَنْ أَلَعَنَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 36394","","","كتاب الزهد"
"36395","(۳۶۳۹۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ثُمَامَۃَ بْنِ بِجَادٍ ، قَالَ : أَنْذَرْتُکُمْ سَوْفَ أَقُومُ سَوْفَ أُصَلِّی سَوْفَ أَصُومُ۔","","Musannaf Ibn Abi Shaybah 36395","","","كتاب الزهد"
"36396","(۳۶۳۹۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تُؤَخِّرْ عَمَلَ الْیَوْمِ لِغَدٍ فَإِنَّک لاَ تَدْرِی مَا فِی غَدٍ۔","","Musannaf Ibn Abi Shaybah 36396","","","كتاب الزهد"
"36397","(۳۶۳۹۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لَمْ یَکُنْ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَدٍ إِذَا سَمِعَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثًا أَخَذَہ لاَ یَزِیدُ فِیہِ ، وَلاَ یَنْقُصُ مِنْہُ وَلا وَلاَ مِنْ عَبْدِ اللہِ بْنِ عُمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 36397","","","كتاب الزهد"
"36398","(۳۶۳۹۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا مُوسَی بْنُ قَیْسٍ ، قَالَ : قَالَ لِی زِرٌّ : ارْحَلْ بِنَا إِلَی ہَذَا الْمَسْجِدِ نُسَبِّحُ ، یَعْنِی نُصَلِّی۔","","Musannaf Ibn Abi Shaybah 36398","","","كتاب الزهد"
"36399","(۳۶۳۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حَدَّثَنَا مُوسَی بْنُ قَیْسٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ {لَئِنْ لَمْ یَنْتَہِ الْمُنَافِقُونَ وَالَّذِینَ فِی قُلُوبِہِمْ مَرَضٌ} قَالَ : أَصْحَابُ الْفَوَاحِشِ۔","","Musannaf Ibn Abi Shaybah 36399","","","كتاب الزهد"
"36400","(۳۶۴۰۰) حَدَّثَنَا الْفَضْلُ ، قَالَ : حدَّثَنَا مُوسَی بْنُ قَیْسٍ ، عَنْ عَمْرِو بْنِ قَیْسٍ الْکِنْدِیِّ (فَإِذَا جَائَتِ الطَّامَّۃُ الْکُبْرَی) قَالَ : إذَا قِیلَ : اذْہَبُوا بِہِ إِلَی النَّارِ۔","","Musannaf Ibn Abi Shaybah 36400","","","كتاب الزهد"
"36401","(۳۶۴۰۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ صَالِحٍ ، عَنْ أَبِی حَیَّانَ ، قَالَ : مَرَّ ابْنُ مَسْعُودٍ عَلَی الَّذِینَ یَنْفُخُونَ الْکِیرَ فَسَقَطَ۔","","Musannaf Ibn Abi Shaybah 36401","","","كتاب الزهد"
"36402","(۳۶۴۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : قَالَ رَجُلٌ لِرَجُلٍ : أَوْصِنِی ، فَقَالَ : أَتْبِعِ السَّیِّئَۃَ الْحَسَنَۃَ تَمْحُہَا ، وَخَالِقَ النَّاسَ خُلُقًا حَسَنًا۔","","Musannaf Ibn Abi Shaybah 36402","","","كتاب الزهد"
"36403","(۳۶۴۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنْ مِرْدَاسٍ الأَسْلَمِیِّ ، قَالَ : یَذْہَبُ الصَّالِحُونَ الأَوَّلُ فَالأَوَّلُ حَتَّی تَبْقَی حُثَالَۃٌ کَحُثَالَۃِ التَّمْرِ وَالشَّعِیرِ لاَ یَعْبَأُ اللَّہُ بِہِمْ شَیْئًا۔ (بخاری ۴۱۵۶)","Sahih","Musannaf Ibn Abi Shaybah 36403","","","كتاب الزهد"
"36404","(۳۶۴۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ سَمِعْت زَیْدَ بْنَ أَسْلَمَ یَقُولُ فِی ہَذِہِ الآیَۃِ {لاَ تَخَافُوا وَلاَ تَحْزَنُوا} قَالَ : لاَ تَخَافُوا مَا أَمَامَکُمْ ، وَلاَ تَحْزَنُوا عَلَی مَا خَلَفْتُمْ وَأَبْشِرُوا بِالْجَنَّۃِ الَّتِی کُنْتُمْ تُوعَدُونَ ، قَالَ : الْبُشْرَی فِی ثَلاَثَۃِ مَوَاطِنَ : عِنْدَ الْمَوْتِ وَفِی الْقَبْرِ ، وَعِنْدَ الْبَعْثِ۔","","Musannaf Ibn Abi Shaybah 36404","","","كتاب الزهد"
"36405","(۳۶۴۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : إذَا أَرَادَ اللَّہُ بِعَبْدِہِ خَیْرًا فَقَّہَہُ فِی الدِّینِ وَزَہَّدَہُ فِی الدُّنْیَا وَبَصَّرَہُ عُیُوبَہُ ، وَمَنْ أُوتِیَہُنَّ فَقَدْ أُوتِیَ خَیْرَ الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 36405","","","كتاب الزهد"
"36406","(۳۶۴۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ رَجُلٍ مِنْ جُعْفِیٍّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : مَا جَائَتِ الصَّلاَۃُ قَطُّ إِلاَّ وَأَنَا إلَیْہَا بِالأَشْوَاقِ ، وَلاَ جَائَتْ قَطُّ إِلاَّ وَأَنَا مُسْتَعِدٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 36406","","","كتاب الزهد"
"36407","(۳۶۴۰۷) حَدَّثَنَا قُتَیْبَۃ بْنُ سَعِیدٍ قَالَ : حَدَّثَنَا یَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی حَازِمٍ ، أَنَّہُ قَالَ : انْظُرَ الَّذِی تُحِبُّ أَنْ یَکُونَ مَعَک فِی الآخِرَۃِ فَقَدِّمْہُ الْیَوْمَ ، وَانْظُرَ الَّذِی تَکْرَہُ أَنْ یَکُونَ مَعَک ثَمَّ فَاتْرُکْہُ الْیَوْمَ۔","","Musannaf Ibn Abi Shaybah 36407","","","كتاب الزهد"
"36408","(۳۶۴۰۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ السَّائِبِ بْنِ بَرَکَۃٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ سَمِعَ أَبَا ذَرٍّ یَقُولُ : کُنْت أَمْشِی خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَلاَ أَدُلُّک عَلَی کَنْزٍ مِنْ کُنُوزِ الْجَنَّۃِ قُلْتُ : بَلَی ، قَالَ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ۔ (ابن ماجہ ۳۸۲۵۔ احمد ۱۴۵)","Sahih","Musannaf Ibn Abi Shaybah 36408","","","كتاب الزهد"
"36409","(۳۶۴۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عن أبی موسی قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمِعَنِی وَأَنَا خَلْفَہُ ، وَأَنَا أَقُولُ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ ، فَقَالَ : یَا عَبْد اللہِ بْن قَیْس : أَلاَ أَدُلُّکَ عَلَی کَنْزٍ مِنْ کُنُوزِ الْجَنَّۃ ؟ قُلْتُ : بَلَی ، قَالَ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 36409","","","كتاب الزهد"
"36410","(۳۶۴۱۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ کَثِیرِ بْنِ زَیْدٍ الْمَدِینِیِّ ، قَالَ : حدَّثَنِی الْمُطَّلِبُ بْنُ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، عَنْ عَامِرِ بْنِ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، قَالَ : لَقِیت أَبَا أَیُّوبَ الأَنْصَارِیَّ ، فَقَالَ لِی : أَلاَ آمُرُک بِمَا أَمَرَنِی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ أُکْثِرَ مِنْ قَوْلِ لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ فَإِنَّہُ کَنْزٌ مِنْ کُنُوزِ الْجَنَّۃِ۔ (طبرانی ۳۹۰۰)","Hasan","Musannaf Ibn Abi Shaybah 36410","","","كتاب الزهد"
"36411","(۳۶۴۱۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ الأَسْلَمِیِّ ، عَنْ أَبِی الزِّنَادِ ، عَنْ سَعِیدِ بْنِ سُلَیْمَانَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : أَلاَ أَدُلُّکُمْ عَلَی کَنْزٍ مِنْ کُنُوزِ الْجَنَّۃِ تُکْثِرُونَ مِنْ لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ۔ (طبرانی ۴۸۸۵۔ عبد بن حمید ۲۴۹)","Da'if","Musannaf Ibn Abi Shaybah 36411","","","كتاب الزهد"
"36412","(۳۶۴۱۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ کُمَیْلِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ کَنْزٌ مِنْ کُنُوزِ الْجَنَّۃِ۔ (نسائی ۱۰۱۹۰۔ احمد ۵۲۰)","Sahih","Musannaf Ibn Abi Shaybah 36412","","","كتاب الزهد"
"36413","(۳۶۴۱۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی رَزِینٍ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللہِ کَنْزٌ مِنْ کُنُوزِ الْجَنَّۃِ۔n(احمد ۲۲۸۔ طبرانی ۳۷۱)","","Musannaf Ibn Abi Shaybah 36413","","","كتاب الزهد"
"36414","(۳۶۴۱۴) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا یَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی حَازِمٍ ، قَالَ : انْظُرْ کُلَّ عَمَلٍ کَرِہْت الْمَوْتَ مِنْ أَجْلِہِ فَاتْرُکْہُ ثُمَّ لاَ یَضُرُکَ مَتَی مَا مِتَّ۔","","Musannaf Ibn Abi Shaybah 36414","","","كتاب الزهد"
"36415","(۳۶۴۱۵) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا یَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی حَازِمٍ أَنَّہُ قَالَ : یَسِیرُ الدُّنْیَا یُشْغِلُ عَنْ کَثِیرِ الآخِرَۃِ ، ثُمَّ قَالَ : إنَّک تَجِدُ الرَّجُلَ یَشْغَلُ نَفْسَہُ بِہَمِّ غَیْرِہِ حَتَّی لَہُوَ أَشَدُّ اہْتِمَامًا مِنْ صَاحِبِ الْہَمِّ بِہَمِّ نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 36415","","","كتاب الزهد"
"36416","(۳۶۴۱۶) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا یَعْقُوبُ ، عَنْ أَبِی حَازِمٍ ، أَنَّہُ قَالَ : تَجِدُ الرَّجُلَ یَعْمَلُ بِالْمَعَاصِی ، فَإِذَا قِیلَ لَہُ : تُحِبُّ الْمَوْتَ ، قَالَ : لاَ ، وَکَیْفَ ، وَعِنْدِی مَا عِنْدِی ، فَیُقَالَ لَہُ : أَفَلاَ تَتْرُکُ مَا تَعْمَلُ بِہِ مِنَ الْمَعَاصِی ، فَقَالَ : مَا أُرِیدُ تَرْکَہُ ، وَمَا أُحِبُّ أَنْ أَمُوتَ حَتَّی أَتْرُکَہُ۔","","Musannaf Ibn Abi Shaybah 36416","","","كتاب الزهد"
"36417","(۳۶۴۱۷) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ ، عَنْ أَبِی سَہْلٍ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِہِ : {إنَّ جَہَنَّمَ کَانَتْ مِرْصَادًا} قَالَ : تَرْصُدُہُمْ وَاللہِ ، قَالَ : وَبَیْنَمَا رَجُلٌ یَمُرُّ إذْ اسْتَقْبَلَہُ آخَرُ ، قَالَ : أَبَلَغَکَ أَنَّ بِالطَّرِیقِ رَصَدًا ؟ قَالَ : نَعَمْ ، قَالَ : فَخُذْ حَذَرَک إذًا۔","","Musannaf Ibn Abi Shaybah 36417","","","كتاب الزهد"
"36418","(۳۶۴۱۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : رَأَیْتُ أَبَا سِنَانٍ یَوْمَ جُمُعَۃٍ وَعَیْنَاہُ تَسِیلاَنِ وَشَفَتَاہُ تَحَرَّکُ۔","","Musannaf Ibn Abi Shaybah 36418","","","كتاب الزهد"
"36419","(۳۶۴۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : لاَ یَکُونُ الرَّجُلُ تَقِیًّا حَتَّی یُحَاسِبَ نَفْسَہُ أَشَدَّ مِنْ مُحَاسَبَۃِ الرَّجُلِ شَرِیکَہُ حَتَّی یَنْظُرَ مِنْ أَیْنَ مَطْعَمُہُ وَمَشْرَبُہُ وَمَکْسَبُہُ۔","","Musannaf Ibn Abi Shaybah 36419","","","كتاب الزهد"
"36420","(۳۶۴۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی قَوْلِہِ : {مَنْ کَانَ یُرِیدُ الْحَیَاۃَ الدُّنْیَا وَزِینَتَہَا نُوَفِّ إلَیْہِمْ أَعْمَالَہُمْ فِیہَا وَہُمْ فِیہَا لاَ یُبْخَسُونَ} قَالَ : مَنْ عَمِلَ لِلدُّنْیَا وُفِّیہِ فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 36420","","","كتاب الزهد"
"36421","(۳۶۴۲۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ،قَالَ : قالَوا لاِبْنِ الْمُنْکَدِرِ : أَیُّ الْعَمَلِ أَحَبُّ إلَیْک ؟ قَالَ : إدْخَالُ السُّرُورِ عَلَی الْمُؤْمِنِ ، قَالُوا : فَمَا بَقِیَ مِمَّا تَسْتَلِذُّ ، قَالَ : الإِفْضَالُ عَلَی الإِخْوَانِ۔","","Musannaf Ibn Abi Shaybah 36421","","","كتاب الزهد"
"36422","(۳۶۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، قَالَ : دَخَلَ قَیْسُ بْنُ السَّکَنِ الْمَسْجِدَ فَجَعَلَ یَنْظُرُ وَیَقُولُ : أَجَدَبَ الْمَسْجِدُ أَجَدَبَ الْمَسْجِدُ۔","","Musannaf Ibn Abi Shaybah 36422","","","كتاب الزهد"
"36423","(۳۶۴۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : قَالَ لِی : لَوْ رَأَیْتَ قَوْمًا رَأَیْتُہُمْ لَتَقَطَّعَتْ کَبِدُک عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 36423","","","كتاب الزهد"
"36424","(۳۶۴۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی حَازِمٍ ، قَالَ : اکْتُمْ حَسَنَاتِکَ أَکْثَرَ مِمَّا تَکْتُمُ سَیِّئَاتِک۔","","Musannaf Ibn Abi Shaybah 36424","","","كتاب الزهد"
"36425","(۳۶۴۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، قَالَ : مَنْ قَرَأَ مِئَتَیْ آیَۃٍ وَہُوَ یَنْظُرُ فِی الْمُصْحَفِ لَمْ یَجِئْ أَحَدٌ فِی ذَلِکَ الْیَوْمِ بِأَفْضَلَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 36425","","","كتاب الزهد"
"36426","(۳۶۴۲۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : مَا رَأَیْت أَحَدًا أَعْلَمَ بِفُتْیَا مِنْ جَابِرِ بْنِ زَیْدٍ ، وَسَمِعْتہ یَقُولُ : مَا أَمْلِکُ مِنَ الدُّنْیَا شَیْئًا إِلاَّ حِمَارًا۔","","Musannaf Ibn Abi Shaybah 36426","","","كتاب الزهد"
"36427","(۳۶۴۲۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی الضُّحَی فِی قَوْلِہِ : {ألاَّ إنَّ أَوْلِیَائَ اللہِ لاَ خَوْفٌ عَلَیْہِمْ وَلاَ ہُمْ یَحْزَنُونَ} قَالَ : ہُمَ الَّذِینَ إذَا رُؤُوا ذُکِرَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 36427","","","كتاب الزهد"
"36428","(۳۶۴۲۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ عَمَّنْ حَدَّثَہُ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ سَرَّہُ أَنْ یَعْلَمَ مَا لَہُ عِنْدَ اللہِ فَلْیَنْظُرْ مَا لِلنَّاسِ عِنْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 36428","","","كتاب الزهد"
"36429","(۳۶۴۲۹) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ : {إِلاَّ أَنْ تَقَطَّعَ قُلُوبُہُمْ} قَالَ: الْمَوْتُ۔","","Musannaf Ibn Abi Shaybah 36429","","","كتاب الزهد"
"36430","(۳۶۴۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ طَارِقٍ ، عَنْ سَالِمٍ {وَاعْبُدْ رَبَّک حَتَّی یَأْتِیَک الْیَقِینُ} قَالَ : الْیَقِینُ : الْمَوْتُ۔","","Musannaf Ibn Abi Shaybah 36430","","","كتاب الزهد"
"36431","(۳۶۴۳۱) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ: حدَّثَنَا الرَّبِیعُ بْنُ الْمُنْذِرِ، عَنْ أَبِیہِ ، أَنَّ الرَّبِیعَ بْنَ خُثَیْمٍ جَاؤُوہُ بِرَمْلٍ، أَوِ اشْتُرِیَ لَہُ رَمْلٌ فَطُرِحَ فِی بَیْتِہِ ، أَوْ فِی دَارِہِ ، یَعْنِی یَجْلِسُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36431","","","كتاب الزهد"
"36432","(۳۶۴۳۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ سُرِّیَّۃِ الرَّبِیعِ بْنِ خُثَیْمٍ ، قَالَتْ : کَانَ عَمَلُ الرَّبِیعِ سِرًّا۔","","Musannaf Ibn Abi Shaybah 36432","","","كتاب الزهد"
"36433","(۳۶۴۳۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حَدَّثَنَا الْحَکَمُ بْنُ عَبْدِ الْمَلِکِ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفِ بْنِ الشِّخِّیرِ، عَنِ ابْنِ عَبَّاسٍ {مِنْ مَائٍ صَدِیدٍ} قَالَ : مَا یَسِیلُ بَیْنَ جِلْدِ الْکَافِرِ وَلَحْمِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 36433","","","كتاب الزهد"
"36434","(۳۶۴۳۴) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حَدَّثَنَا عَوْفٌ ، عَنِ الْحَسَنِ : {یَوْمَئِذٍ یَتَذَکَّرُ الإِنْسَان وَأَنَّی لَہُ الذِّکْرَی یَقُولُ یَا لَیْتَنِی قَدَّمْت لِحَیَاتِی} قَالَ : عُلِمَ وَاللہِ ، أَنَّہُ صَادِفٌ ہُنَاکَ حَیَاۃٌ طَوِیلَۃٌ لاَ مَوْتَ فِیہَا آخر مَا عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 36434","","","كتاب الزهد"
"36435","(۳۶۴۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ أَنَّ مَلِکًا مِنْ تِلْکَ الْمُلُوکِ حَضَرَتْہُ الْوَفَاۃُ ، فَأَطَافَ بِہِ أَہْلُ مَمْلَکَتِہِ فَقَالُوا : لِمَنْ تَدَعَ الْعِبَادَ وَالْبِلاَدَ بَعْدَکَ ؟ فَقَالَ : یَا أَیُّہَا الْقَوْمُ ، لاَ تَجْہَلُوا فَإِنَّکُمْ فِی مِلْکِ مَنْ لاَ یُبَالِی أَصَغِیرٌ أُخِذَ مِنْ مِلْکِہِ ، أَوْ کَبِیرٌ۔","","Musannaf Ibn Abi Shaybah 36435","","","كتاب الزهد"
"36436","(۳۶۴۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَبِی الأَشْہَبِ، عَنِ الْحَسَنِ، قَالَ: لاَ یَزَالُ الْعَبْدُ بِخَیْرٍ إذَا قَالَ لِلَّہِ وَإِذَا عَمِلَ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 36436","","","كتاب الزهد"
"36437","(۳۶۴۳۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : یَا ابْنَ آدَمَ ، إنَّ لَک سِرًّا ، وَإِنَّ لَک عَلاَنِیَۃً ، فَسِرُّک أَمْلَکُ بِکَ مِنْ عَلاَنِیَتِکَ ، وَإِنَّ لَک عَمَلاً وَإِنَّ لَکَ قَوْلاً فَعَمَلُک أَمْلَکُ بِکَ مِنْ قَوْلِک۔","","Musannaf Ibn Abi Shaybah 36437","","","كتاب الزهد"
"36438","(۳۶۴۳۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو الأَشْہَبِ ، قَالَ سَمِعْت الْحَسَنَ یَقُولُ : یَا ابْنَ آدَمَ ، تُبْصِرُ الْقَذَی فِی عَیْنِ أَخِیک وَتَدَعُ الْجِذْلَ مُعْتَرِضًا فِی عَیْنِک۔","","Musannaf Ibn Abi Shaybah 36438","","","كتاب الزهد"
"36439","(۳۶۴۳۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، أَنَّ أَبَا الْبَخْتَرِیِّ وَأَصْحَابَہُ کَانُوا إذَا سَمِعَ أَحَدُہُمْ یُثْنَی عَلَیْہِ ، أَوْ دَخَلَہُ عُجْبٌ ثَنَی مَنْکِبَیْہِ ، وَقَالَ : خَشَعْتُ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 36439","","","كتاب الزهد"
"36440","(۳۶۴۴۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ قِیلَ لِلْحَسَنِ : یَا أَبَا سَعِیدٍ ، أَیَنَامُ الشَّیْطَانُ ، قَالَ : لَوْ غَفَلَ لَوَجَدَہَا کُلُّ مُؤْمِنٍ مِنْ قَلْبِہِ۔","","Musannaf Ibn Abi Shaybah 36440","","","كتاب الزهد"
"36441","(۳۶۴۴۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا أَبُو الأَشْہَبِ ، قَالَ سَمِعْت الْحَسَنَ ، أَنَّہُ قَالَ : لِلشَّرِّ أَہْلٌ وَلِلْخَیْرِ أَہْلٌ وَمَنْ تَرَکَ شَیْئًا کُفِیَہُ۔","","Musannaf Ibn Abi Shaybah 36441","","","كتاب الزهد"
"36442","(۳۶۴۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ حَفْصَۃَ ، عَنِ الرَّبِیعِ بْنِ زِیَادٍ ، عَنْ کَعْبٍ ، قَالَ : وَاللہِ مَا اسْتَقَرَّ لِعَبْدٍ ثَنَائٌ فِی الأَرْضِ حَتَّی یَسْتَقِرَّ لَہُ فِی أَہْلِ السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 36442","","","كتاب الزهد"
"36443","(۳۶۴۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، قَالَ : کَتَبَ عُمَرُ بْنُ الْخَطَّابِ إِلَی أَبِی مُوسَی : أَمَّا بَعْدُ فَإِنَّ الْقُوَّۃَ فِی الْعَمَلِ أَنْ لاَ تُؤَخِّرُوا عَمَلَ الْیَوْمِ لِغَدٍ فَإِنَّکُمْ إذَا فَعَلْتُمْ ذَلِکَ تَدَارَکَتْ عَلَیْکُمَ الأَعْمَالُ فَلَمْ تَدْرُوا أَیُّہَا تَأْخُذُونَ فَأَضَعْتُمْ ، فَإِذَا خُیِّرْتُمْ بَیْنَ أَمْرَیْنِ أَحَدُہُمَا لِلدُّنْیَا وَالآخَرُ لِلآخِرَۃِ فَاخْتَارُوا أَمْرَ الآخِرَۃِ عَلَی أَمْرِ الدُّنْیَا ، فَإِنَّ الدُّنْیَا تَفْنَی ، وَإِنَّ الآخِرَۃَ تَبْقَی ، کُونُوا مِنَ اللہِ عَلَی وَجَلٍ وَتَعَلَّمُوا کِتَابَ اللہِ فَإِنَّہُ یَنَابِیعُ الْعِلْمِ وَرَبِیعُ الْقُلُوبِ۔","Da'if","Musannaf Ibn Abi Shaybah 36443","","","كتاب الزهد"
"36444","(۳۶۴۴۴) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ رَاء ی رَاء ی اللَّہُ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 36444","","","كتاب الزهد"
"36445","(۳۶۴۴۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی زَکَرِیَّا ، قَالَ : بَلَغَنِی أَنَّ الرَّجُلَ إذَا رَاء ی بِشَیْئٍ مِنْ عَمَلِہِ أُحْبِطَ مَا کَانَ قَبْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 36445","","","كتاب الزهد"
"36446","(۳۶۴۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : سَمِعْتُ جُنْدُبًا الْعَلَقِیَّ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یُسَمِّعْ یُسَمِّعُ اللَّہُ بِہِ وَمَنْ یُرَائِ یُرَائِ اللَّہُ بِہِ۔ (بخاری ۶۴۹۹۔ مسلم ۲۲۸۹)","Sahih","Musannaf Ibn Abi Shaybah 36446","","","كتاب الزهد"
"36447","(۳۶۴۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، قَالَ : سَمِعْتُ أَبَا رَزِینٍ، قَالَ: قَالَ عَبْدُ اللہِ: مَنْ یُسَمِّعْ یُسَمِّعُ اللَّہُ بِہِ ، وَمَنْ یُرَائِ یُرَائِ اللَّہُ بِہِ ، وَمَنْ تَوَاضَعَ تَخَشُّعًا رَفَعَہُ اللَّہُ ، وَمَنْ تَعَظَّمَ تَطَاوُلاً وَضَعَہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 36447","","","كتاب الزهد"
"36448","(۳۶۴۴۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ شَیْخٍ یُکَنَّی أَبَا یَزِیدَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرٍو یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یُسَمِّعَ النَّاسَ بِعَمَلِہِ سَمَّعَ اللَّہُ بِہِ سَامِعَ خَلْقِہِ یَوْمَ الْقِیَامَۃِ وَحَقَّرَہُ وَصَغَّرَہُ۔ (احمد ۲۲۳)","Sahih","Musannaf Ibn Abi Shaybah 36448","","","كتاب الزهد"
"36449","(۳۶۴۴۹) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَنْ مُحَمَّدِ بْنِ أَبِی لَیْلَی ، عَنِ الْعَوْفِیِّ ، عَنْ أَبِی سَعِیدٍ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ سَمَّعَ سَمَّعَ اللَّہُ بِہِ وَمَنْ رَاء ی رَاء ی اللَّہُ بِہِ۔ (ترمذی ۲۳۸۱۔ ابن ماجہ ۴۲۰۶)","Da'if","Musannaf Ibn Abi Shaybah 36449","","","كتاب الزهد"
"36450","(۳۶۴۵۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لَقَدْ أَدْرَکْت أَقْوَامًا مَا کَانُوا یَشْبَعُونَ ذَلِکَ الشِّبَعَ ، إنْ کَانَ أَحَدُہُمْ لَیَأْکُلُ حَتَّی إذَا رُدَّ نَفَسُہُ أَمْسَکَ ذَابِلاً نَاحِلاً مُقْبِلاً عَلَی شَأْنِہِ۔","","Musannaf Ibn Abi Shaybah 36450","","","كتاب الزهد"
"36451","(۳۶۴۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، قَالَ : کُنَّا إذَا دَخَلْنَا عَلَی الْحَسَنِ خَرَجْنَا ، وَمَا نَعُدُّ الدُّنْیَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 36451","","","كتاب الزهد"
"36452","(۳۶۴۵۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ : {وَحِیلَ بَیْنَہُمْ وَبَیْنَ مَا یَشْتَہُونَ} قَالَ : مِنَ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 36452","","","كتاب الزهد"
"36453","(۳۶۴۵۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ الْحَسَنُ : مِنْ أَشْرَاطِ ، أَوِ اقْتِرَابِ السَّاعَۃِ أَنْ یَأْتِیَ الْمَوْتُ خِیَارَکُمْ فَیَلْقُطَہُمْ کَمَا یَلْقُطُ أَحَدُکُمْ أَطَایبَ الرُّطَبِ مِنَ الطَّبَقِ۔","","Musannaf Ibn Abi Shaybah 36453","","","كتاب الزهد"
"36454","(۳۶۴۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَلاَّمِ بْنِ مِسْکِینٍ ، قَالَ : قَالَ الْحَسَنُ : أَہِینُوا الدُّنْیَا فَوَاللہِ لأَہْنَأُ مَا تَکُونُ إذَا أَہَنْتہَا۔","","Musannaf Ibn Abi Shaybah 36454","","","كتاب الزهد"
"36455","(۳۶۴۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : صَوَامِعُ الْمُؤْمِنِینَ بُیُوتُہُمْ۔","","Musannaf Ibn Abi Shaybah 36455","","","كتاب الزهد"
"36456","(۳۶۴۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِہِ : {فَضُرِبَ بَیْنَہُمْ بِسُورٍ لَہُ بَابٌ بَاطِنُہُ فِیہِ الرَّحْمَۃُ} قَالَ : الْجَنَّۃُ {وَظَاہِرُہُ مِنْ قِبَلِہِ الْعَذَابُ} قَالَ : النَّارُ۔","Hasan","Musannaf Ibn Abi Shaybah 36456","","","كتاب الزهد"
"36457","(۳۶۴۵۷) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ قَالَ : حَدَّثَنَا عَوْفٌ ، عَنِ الْحَسَنِ {یَوْمَئِذٍ یَتَذَکَّرُ الإِنْسَان وَأَنَّی لَہُ الذِّکْرَی یَقُولُ یَا لَیْتَنِی قَدَّمْت لِحَیَاتِی} قَالَ : عَلِمَ وَاللہِ أَنَّہُ صَادِف ہُنَاکَ حَیَاۃٌ طَوِیلَۃٌ لاَ مَوْتَ فِیہَا آخر ما عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 36457","","","كتاب الزهد"
"36458","(۳۶۴۵۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَازِمٍ ، عَنِ الْحَسَنِ ، قَالَ : یَأْتِی عَلَی النَّاسِ زَمَانٌ یَکُونُ حَدِیثُہُمْ فِی مَسَاجِدِہِمْ أَمْرَ دُنْیَاہُمْ ، لَیْسَ لِلَّہِ فِیہِ حَاجَۃٌ ، فَلاَ تُجَالِسُوہُمْ۔","","Musannaf Ibn Abi Shaybah 36458","","","كتاب الزهد"
"36459","(۳۶۴۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِہِ : {فَلاَ یُخْرِجَنَّکُمَا مِنَ الْجَنَّۃِ فَتَشْقَی} قَالَ : عَنَی بِہِ شَقَائَ الدُّنْیَا فَلاَ تَلْقَی ابْنَ آدَمَ إِلاَّ شَقِیًّا نَاصِبًا۔","","Musannaf Ibn Abi Shaybah 36459","","","كتاب الزهد"
"36460","(۳۶۴۶۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : قرَأَ الْحَسَنُ ہَذِہِ الآیَۃَ {وَکَانَ أَبُوہُمَا صَالِحًا} قَالَ : مَا أَسْمَعُہُ ذَکَرَ فِی وَلَدِہِمَا خَیْرًا ، حَفِظَہُمَا اللَّہُ بِحِفْظِ أَبِیہِمَا۔","","Musannaf Ibn Abi Shaybah 36460","","","كتاب الزهد"
"36461","(۳۶۴۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ وَمُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ حَبِیبِ بْنِ شَہِیدٍ، عَنِ الْحَسَنِ، قَالَ: لاَ إلَہَ إِلاَّ اللَّہُ ثَمَنُ الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 36461","","","كتاب الزهد"
"36462","(۳۶۴۶۲) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، أَنَّ الْحَسَنَ کَانَ یَقُولُ : اتَّقَوْا فِیمَا حَرَّمَ اللَّہُ عَلَیْہِمْ وَأَحْسَنُوا فِیمَا رَزَقَہُمْ۔","","Musannaf Ibn Abi Shaybah 36462","","","كتاب الزهد"
"36463","(۳۶۴۶۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ {رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً} قَالَ فِی الدُّنْیَا الْعِلْمُ وَالْعِبَادَۃُ ، وَفِی الآخِرَۃِ الْجَنَّۃُ۔","","Musannaf Ibn Abi Shaybah 36463","","","كتاب الزهد"
"36464","(۳۶۴۶۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ {وَلاَ تَنْسَ نَصِیبَک مِنَ الدُّنْیَا} قَالَ : قَدِّمَ الْفَضْلَ وَأَمْسِکْ مَا یُبَلِّغُکَ۔","","Musannaf Ibn Abi Shaybah 36464","","","كتاب الزهد"
"36465","(۳۶۴۶۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ {یَسْعَی نُورُہُمْ بَیْنَ أَیْدِیہِمْ وَبِأَیْمَانِہِمْ} قَالَ : عَلَی الصِّرَاطِ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 36465","","","كتاب الزهد"
"36466","(۳۶۴۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، قَالَ : قرَأَ الْحَسَنُ حَتَّی بَلَغَ : {وَلاَ یَذْکُرُونَ اللَّہَ إِلاَّ قَلِیلاً} قَالَ: إنَّمَا قَلَّ لأَنَّہُ کَانَ لِغَیْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36466","","","كتاب الزهد"
"36467","(۳۶۴۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، قَالَ : قرَأَ الْحَسَنُ : {التَّائِبُونَ الْعَابِدُونَ} قَالَ : تَابُوا مِنَ الشِّرْکِ وَبَرِئُوا مِنَ النِّفَاقِ۔","","Musannaf Ibn Abi Shaybah 36467","","","كتاب الزهد"
"36468","(۳۶۴۶۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ بَشِیرُ بْنُ عُقْبَۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : الْعُلَمَائُ ثَلاَثَۃٌ : مِنْہُمْ عَالِمٌ لِنَفْسِہِ وَلِغَیْرِہِ فَذَلِکَ أَفْضَلُہُمْ وَخَیْرُہُمْ ، وَمِنْہُمْ عَالِمٌ لِنَفْسِہِ فَحَسَنٌ ، وَمِنْہُمْ عالِمٌ لاَ لِنَفْسِہِ ، وَلاَ لِغَیْرِہِ فَذَلِکَ شَرُّہُمْ۔","","Musannaf Ibn Abi Shaybah 36468","","","كتاب الزهد"
"36469","(۳۶۴۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : مَنِ اسْتَطَاعَ مِنْکُمْ أَنْ یَکُونَ إمَامًا لأَہْلِہِ إمَامًا لحیہ إمَامًا لِمَنْ وَرَائَ ذَلِکَ فَلْیَفْعَلْ ، فَإِنَّہُ لَیْسَ شَیْئٌ یُؤْخَذُ عَنْک إِلاَّ کَانَ لَک فِیہِ نَصِیبٌ۔","","Musannaf Ibn Abi Shaybah 36469","","","كتاب الزهد"
"36470","(۳۶۴۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : أَدْرَکْت أَقْوَامًا یَعْزِمُونَ عَلَی أَہَالِیہِمْ أَنْ لاَ یَرُدُّوا سَائِلاً۔","","Musannaf Ibn Abi Shaybah 36470","","","كتاب الزهد"
"36471","(۳۶۴۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ ، أنَّہُ تَلاَ : {وَاسْأَلْہُمْ عَنِ الْقَرْیَۃِ الَّتِی کَانَتْ حَاضِرَۃَ الْبَحْرِ إذْ یَعْدُونَ فِی السَّبْتِ إذْ تَأْتِیہِمْ حِیتَانُہُمْ یَوْمَ سَبْتِہِمْ شُرَّعًا} الآیَۃَ ، قَالَ : کَانَ حُوتٌ حَرَّمَہُ اللَّہُ علیہم فِی یَوْمٍ وَأَحَلَّہُ لَہُمْ فِی سِوَی ذَلِکَ ، فَکَانَ یَأْتِیہِمْ فِی الْیَوْمِ الَّذِی حُرِّمَ عَلَیْہِمْ کَأَنَّہُ الْمَخَاضُ ، مَا یَمْتَنِعُ مِنْ أَحَدٍ ، فَجَعَلُوا یَہُمُّونَ وَیُمْسِکُونَ حَتَّی أَخَذُوہُ فَأَکَلُوا وَاللہِ بِہَا أَوْخَمَ أَکْلَۃً أَکَلَہَا قَوْمُ لُوطٍ أَبْقَی خِزْیًا فِی الدُّنْیَا وَأَشَدَّ عُقُوبَۃً فِی الآخِرَۃِ ، وَایْمُ اللہِ لَلْمُؤْمِنُ أَعْظَمُ حُرْمَۃً عِنْدَ اللہِ مِنْ حُوتٍ ، وَلَکِنَّ اللَّہَ جَعَلَ مَوْعِدَ قَوْمِی السَّاعَۃَ ، وَالسَّاعَۃُ أَدْہَی وَأَمَرُّ۔","","Musannaf Ibn Abi Shaybah 36471","","","كتاب الزهد"
"36472","(۳۶۴۷۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کُنَّا نَتَحَدَّثُ ، أَنَّ الْعَبْدَ إذَا أَرَادَ اللَّہُ بِہِ أَظُنُّہُ قَالَ خَیْرًا، جَعَلَ لَہُ زَاجِرًا مِنْ نَفْسِہِ یَأْمُرُہُ بِالْخَیْرِ ، وَیَنْہَاہُ عَنِ الْمُنْکَرِ۔","","Musannaf Ibn Abi Shaybah 36472","","","كتاب الزهد"
"36473","(۳۶۴۷۳) حَدَّثَنَا زَیْدُ بْنُ الحُبَابٍ ، قَالَ : حدَّثَنَا عَبْدُ الْحَمِیدِ بْنُ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، قَالَ : أَخْبَرَنَا کُلْثُومُ بْنُ جَبْرٍ ، قَالَ : کَانَ الْمُتَمَنِّی بِالْبَصْرَۃِ یَقُولُ : فِقْہُ الْحَسَنِ وَوَرَعُ مُحَمَّدِ بْنِ سِیرِینَ وَعِبَادَۃُ طَلْقِ بْنِ حَبِیبٍ وَحِلْمُ ابْنِ یَسَارٍ۔","","Musannaf Ibn Abi Shaybah 36473","","","كتاب الزهد"
"36474","(۳۶۴۷۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَاصِمٍ ، قَالَ : سَمِعْتُ مُوَرِّقًا الْعِجْلِیّ یَقُولُ : مَا رَأَیْت أَحَدًا أَفْقَہَ فِی وَرَعِہِ ، وَلاَ أَوْرَعَ فِی فِقْہِہِ مِنْ مُحَمَّدٍ ، وَقَالَ أَبُو قِلاَبَۃَ : اصْرِفُوہُ حَیْثُ شِئْتُمْ فَتَجِدُونَہُ أَشُدَّکُمْ وَرَعًا وَأَمْلَکَکُمْ لِنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 36474","","","كتاب الزهد"
"36475","(۳۶۴۷۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ أَعْلَمُ الدرن مِنَ الدِّینِ۔","","Musannaf Ibn Abi Shaybah 36475","","","كتاب الزهد"
"36476","(۳۶۴۷۶) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا سَلاَّمُ بْنُ مِسْکِینٍ ، قَالَ : حَدَّثَنَا عِمْرَانُ بْنُ عَبْدِ اللہِ بْنِ طَلْحَۃَ الْخُزَاعِیُّ ، قَالَ : إنَّ نَفْسَ سَعِیدِ بْنِ الْمُسَیَّبِ کَانَتْ أَہْوَنَ عَلَیْہِ فِی ذَاتِ اللہِ مِنْ نَفْسِ ذُبَابٍ۔","","Musannaf Ibn Abi Shaybah 36476","","","كتاب الزهد"
"36477","(۳۶۴۷۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، أَنَّ سَعِیدَ بْنَ الْمُسَیَّبِ کَانَ یُکْثِرُ أَنْ یَقُولَ فِی مَجْلِسِہِ : اللَّہُمَّ سَلِّمْ سَلِّمْ۔","","Musannaf Ibn Abi Shaybah 36477","","","كتاب الزهد"
"36478","(۳۶۴۷۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : قَالَ کَعْبٌ : مَا نَظَرَ اللَّہُ إِلَی الْجَنَّۃِ قَطُّ إِلاَّ ، قَالَ : طِبْتِ لأَہْلِکَ فَازْدَادَتْ عَلَی مَا کَانَتْ طِیبًا حَتَّی یَدْخُلَہَا أَہْلُہَا۔ (طبرانی ۷۵)","","Musannaf Ibn Abi Shaybah 36478","","","كتاب الزهد"
"36479","(۳۶۴۷۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا أَبُو عِمْرَانَ الْجَوْنِیُّ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ الأَنْصَارِیِّ ، عَنْ کَعْبٍ ، قَالَ : قَالَ إبْرَاہِیمُ : یَا رَبِ ، إنِّی لَیَحْزُنُنِی أَنْ لاَ أَرَی أَحَدًا فِی الأَرْضِ یَعْبُدُک غَیْرِی ، فَبَعَثَ اللَّہُ مَلاَئِکَۃً تُصَلِّی مَعَہُ وَتَکُونُ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 36479","","","كتاب الزهد"
"36480","(۳۶۴۸۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : الدُّنْیَا مَلْعُونَۃٌ مَلْعُونٌ مَا فِیہَا إِلاَّ مُتَعَلِّمَ خَیْرٍ ، أَوْ مُعَلِّمَہُ۔","","Musannaf Ibn Abi Shaybah 36480","","","كتاب الزهد"
"36481","(۳۶۴۸۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنِی عَلِیُّ بْنُ زَیْدٍ ، عَنْ مُطَرِّفٍ أنَّ کَعْبًا قَالَ فِی قَوْلِہِ : {وَفُرُشٍ مَرْفُوعَۃٍ} قَالَ : عَلَی مَسِیرَۃ أَرْبَعِینَ عَامًا۔","","Musannaf Ibn Abi Shaybah 36481","","","كتاب الزهد"
"36482","(۳۶۴۸۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، قَالَ : حَدَّثَنَا زَیْدُ بْنُ أَسْلَمَ عْن عَطَائِ بْنِ یَسَارٍ ، عَنْ کَعْبٍ ، قَالَ : یُؤْتَی بِالرَّئِیسِ فِی الْخَیْرِ یَوْمَ الْقِیَامَۃِ فَیُقَالَ لَہُ : أَجِبْ رَبَّک ، فَیُنْطَلَقُ بِہِ إِلَی رَبِّہِ فَلاَ یُحْجَبُ عَنْہُ ، فَیُؤْمَرُ بِہِ إِلَی الْجَنَّۃِ فَیَرَی مَنْزِلَہُ وَمَنَازِلَ أَصْحَابِہِ الَّذِینَ کَانُوا یُجَامِعُونَہُ عَلَی الْخَیْرِ وَیُعِینُونَہُ عَلَیْہِ ، فَیُقَالَ لَہُ : ہَذِہِ مَنْزِلَۃُ فُلاَنٍ وَہَذِہِ مَنْزِلَۃُ فُلاَنٍ ، فَیَرَی مَا أَعَدَّ اللَّہُ لَہُ فِی الْجَنَّۃِ مِنَ الْکَرَامَۃِ ، وَیَرَی مَنْزِلَتَہُ أَفْضَلَ مِنْ مَنَازِلِہِمْ ، وَیُکْسَی مِنْ ثِیَابِ الْجَنَّۃِ وَیُوضَعُ عَلَی رَأْسِہِ تَاجٌ ، ویغلَّفہ مِنْ رِیحِ الْجَنَّۃِ ، وَیُشْرِقُ وَجْہُہُ حَتَّی یَکُونَ مِثْلَ الْقَمَرِ ، قَالَ ہَمَّامٌ : أَحْسَبُہُ ، قَالَ : لَیْلَۃَ الْبَدْرِ ، قَالَ : فَیَخْرُجُ فَلاَ یَرَاہُ أَہْلُ مَلأ إِلاَّ قَالُوا : اللَّہُمَّ اجْعَلْہُ مِنْہُمْ ، حَتَّی یَأْتِیَ أَصْحَابَہُ الَّذِینَ کَانُوا یُجَامِعُونَہُ عَلَی الْخَیْرِ وَیُعِینُونَہُ عَلَیْہِ فَیَقُولُ : أَبْشِرْ یَا فُلاَنُ ، فَإِنَّ اللَّہَ قَدْ أَعَدَّ لَک فِی الْجَنَّۃِ کَذَا ، وَأَعَدَّ لَک فِی الْجَنَّۃِ کَذَا وَکَذَا ، فَمَا زَالَ یُخْبِرُہُمْ بِمَا أَعَدَّ اللَّہُ لَہُمْ فِی الْجَنَّۃِ مِنَ الْکَرَامَۃِ حَتَّی یَعْلُوَ وُجُوہَہُمْ مِنَ الْبَیَاضِ مِثْلُ مَا عَلاَ وَجْہَہُ ، فَیَعْرِفُہُمَ النَّاسُ بِبَیَاضِ وُجُوہِہِمْ فَیَقُولُونَ : ہَؤُلاَئِ أَہْلُ الْجَنَّۃِ ، وَیُؤْتَی بِالرَّئِیسِ فِی الشَّرِّ فَیُقَالَ لَہُ : أَجِبْ رَبَّک ، فَیُنْطَلَقُ بِہِ إِلَی رَبِّہِ فَیُحْجَبُ عَنْہُ وَیُؤْمَرُ بِہِ إِلَی النَّارِ ، فَیَرَی مَنْزِلَتہُ وَمَنَازِلَ أَصْحَابِہِ ، فَیُقَالَ : ہَذِہِ مَنْزِلَۃُ فُلاَنٍ وَہَذِہِ مَنْزِلَۃُ فُلاَنٍ ، فَیَرَی مَا أَعَدَّ اللَّہُ لَہُ فِیہَا مِنَ الْہَوَانِ ، وَیَرَی مَنْزِلَتَہُ شَرًّا مِنْ مَنَازِلِہِمْ ، قَالَ : فَیَسْوَدُّ وَجْہُہُ وَتَزْرَقُّ عَیْنَاہُ ، وَیُوضَعُ عَلَی رَأْسِہِ قَلَنْسُوَۃٌ مِنْ نَارٍ ، فَیَخْرُجُ فَلاَ یَرَاہُ أَہْلُ مَلاَ إِلاَّ تَعَوَّذُوا بِاللہِ مِنْہُ ، فَیَأْتِی أَصْحَابَہُ الَّذِینَ کَانُوا یُجَامِعُونَہُ عَلَی الشَّرِّ وَیُعِینُونَہُ عَلَیْہِ ، قَالَ : فَیَقُولُونَ : نَعُوذُ بِاللہِ مِنْک ، قَالَ : فَیَقُولُ : مَا أَعَاذَکُمَ اللَّہُ مِنِّی ، فَیَقُولُ لَہُمْ : أَمَا تَذْکُرُ یَا فُلاَنُ کَذَا وَکَذَا ، فَیُذَکِّرُہُمَ الشَّرَّ الَّذِی کَانُوا یُجَامِعُونَہُ وَیُعِینُونَہُ عَلَیْہِ ، فَمَا یزَالَ یُخْبِرُہُمْ بِمَا أَعَدَّ اللَّہُ لَہُمْ فِی النَّارِ حَتَّی یَعْلُوَ وُجُوہَہُمْ مِنَ السَّوَادِ مِثْلُ مَا عَلاَ وَجْہَہُ ، فَیَعْرِفُہُمَ النَّاسُ بِسَوَادِ وُجُوہِہِمْ فَیَقُولُونَ : ہَؤُلاَئِ أَہْلُ النَّارِ۔","","Musannaf Ibn Abi Shaybah 36482","","","كتاب الزهد"
"36483","(۳۶۴۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : قَالَ لَنَا أَبِی : إذَا رَأَی أَحَدُکُمْ شَیْئًا مِنْ زِینَۃِ الدُّنْیَا وَزَہْرَتِہَا فَلْیَأْتِ أَہْلَہُ فَلْیَأْمُرْہُمْ بِالصَّلاَۃِ وَلْیَصْطَبِرْ عَلَیْہَا ، فَإِنَّ اللَّہَ ، قَالَ لِنَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : {وَلاَ تَمُدَّنَّ عَیْنَیْک إِلَی مَا مَتَّعْنَا بِہِ أَزْوَاجًا مِنْہُمْ} ثُمَّ قَرَأَ إِلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 36483","","","كتاب الزهد"
"36484","(۳۶۴۸۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ، قَالَ: إذَا رَأَیْت الرَّجُلَ یَعْمَلُ الْحَسَنَۃَ فَاعْلَمْ، أَنَّ لَہَا عِنْدَہُ أَخَوَاتٍ، فَإِنَّ الْحَسَنَۃَ تَدُلُّ عَلَی أُخْتِہَا ، وَإِذَا رَأَیْتہ یَعْمَلُ السَّیِّئَۃَ فَاعْلَمْ ، أَنَّ لَہَا عِنْدَہُ أَخَوَاتٍ، فَإِنَّ السَّیِّئَۃَ تَدُلُّ عَلَی أُخْتِہَا۔","","Musannaf Ibn Abi Shaybah 36484","","","كتاب الزهد"
"36485","(۳۶۴۸۵) حَدَّثَنَا یَحْیَی بْنُ بُکَیْر ، قَالَ: حدَّثَنَا إبْرَاہِیمُ بْنُ نَافِعٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ: حُلو الدُّنْیَا مُرٌّ الآخِرَۃِ ، وَمُرُّ الدُّنْیَا حُلو الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 36485","","","كتاب الزهد"
"36486","(۳۶۴۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ ، عَنْ طَاوُوسٍ، قَالَ: إنَّ الْمُؤْمِنَ لاَ یَحْرُزُ دِینَہُ إِلاَّ حُفْرَتُہُ۔","","Musannaf Ibn Abi Shaybah 36486","","","كتاب الزهد"
"36487","(۳۶۴۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی نَافِعُ بْنُ عُمَرَ ، عَنْ بشر بْنِ عَاصِمٍ ، قَالَ : قَالَ طَاوُوسٌ : مَا رَأَیْت مِثْلَ أَحَدٍ أَمِنَ عَلَی نَفْسِہِ قَدْ رَأَیْت رَجُلاً لَوْ قِیلَ لِی : مَنْ أَفْضَلُ مَنْ تَعْرِفُ قُلْتُ : فُلاَنٌ لِذَلِکَ الرَّجُلِ ، فَمَکَثَ عَلَی ذَلِکَ ، ثُمَّ أَخَذَہُ وَجَعٌ فِی بَطْنِہِ فَأَصَابَہُ مِنْہُ شَیْئٌ فَاسْتَسَحَّ بَطْنَہُ عَلَیْہِ وَاشْتَہَاہُ فباحتہ فَرَأَیْتہ فِی نِطْعٍ مَا أَدْرِی أَیُّ طَاقَیْہِ أَسْرَعُ حَتَّی مَاتَ عَرَقًا۔","","Musannaf Ibn Abi Shaybah 36487","","","كتاب الزهد"
"36488","(۳۶۴۸۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ طَاوُوسٍ ، قَالَ : کَانَ قَمِیصُہُ فَوْقَ الإِزَارِ وَالرِّدَائُ فَوْقَ الْقَمِیصِ۔","","Musannaf Ibn Abi Shaybah 36488","","","كتاب الزهد"
"36489","(۳۶۴۸۹) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : أَلاَ رَجُلٌ یَقُومُ بِعَشْرِ آیَاتٍ مِنَ اللَّیْلِ فَیُصْبِحُ قَدْ کُتِبَ لَہُ مِئَۃُ حَسَنَۃٍ وَأَکْثَرُ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 36489","","","كتاب الزهد"
"36490","(۳۶۴۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: التَّوَکُّلُ عَلَی اللہِ جِمَاعُ الإِیمَانِ۔","","Musannaf Ibn Abi Shaybah 36490","","","كتاب الزهد"
"36491","(۳۶۴۹۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک صِدْقَ التَّوَکُّلِ عَلَیْک وَحُسْنَ الظَّنِّ بِک۔","","Musannaf Ibn Abi Shaybah 36491","","","كتاب الزهد"
"36492","(۳۶۴۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بُکَیْرِ بْنِ عَتِیقٍ ، قَالَ سَقَیْت سَعِیدَ بْنَ جُبَیْرٍ شَرْبَۃً مِنْ عَسَلٍ فِی قَدَحٍ فَشَرِبَہَا ، ثُمَّ قَالَ : وَاللہِ لأسْأَلَنَّ ، عَنْ ہَذَا ، فَقُلْتُ : لِمَہْ ؟ فَقَالَ : شَرِبْتہ وَأَنَا أَسْتَلِذُّہُ۔","","Musannaf Ibn Abi Shaybah 36492","","","كتاب الزهد"
"36493","(۳۶۴۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ: قرَأْت کِتَابَ سَعِیدِ بْنِ جُبَیْرٍ إِلَی أَبِی: یَا أَبَا عُمَرَ ، کُلُّ یَوْمٍ یَعِیشُ فِیہِ الْمُسْلِمُ فَہُوَ غَنِیمَۃٌ۔","","Musannaf Ibn Abi Shaybah 36493","","","كتاب الزهد"
"36494","(۳۶۴۹۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنِ ابْنِ جُبَیْرٍ {بَلْ مَکْرُ اللَّیْلِ وَالنَّہَارِ} قَالَ مَرُّ اللَّیْلِ وَالنَّہَارِ۔","","Musannaf Ibn Abi Shaybah 36494","","","كتاب الزهد"
"36495","(۳۶۴۹۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ذَاکِرُ اللہِ فِی الْغَافِلِینَ کَحَامِی الْمُحْتَسِبِینَ۔","","Musannaf Ibn Abi Shaybah 36495","","","كتاب الزهد"
"36496","(۳۶۴۹۶) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {وَمَا ہُوَ بِالْہَزْلِ} قَالَ: وَمَا ہُوَ بِاللَّعِبِ۔","","Musannaf Ibn Abi Shaybah 36496","","","كتاب الزهد"
"36497","(۳۶۴۹۷) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {فَسُحْقًا لأَصْحَابِ السَّعِیرِ} قَالَ : وَادٍ فِی جَہَنَّمَ۔","","Musannaf Ibn Abi Shaybah 36497","","","كتاب الزهد"
"36498","(۳۶۴۹۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنِ الرَّبِیعِ بْنِ أَبِی رَاشِدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {یَا عِبَادِی الَّذِینَ آمَنُوا إنَّ أَرْضِی وَاسِعَۃٌ} قَالَ : مَنْ أُمِرَ بِمَعْصِیَۃٍ فَلْیَہْرُبْ۔","","Musannaf Ibn Abi Shaybah 36498","","","كتاب الزهد"
"36499","(۳۶۴۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الأَصْبَغُ بْنُ زَیْدٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ أنَّ سَعِیدَ بْنَ جُبَیْرٍ رَدَّدَ ہَذِہِ الآیَۃَ : {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ} بِضْعًا وَعِشْرِینَ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 36499","","","كتاب الزهد"
"36500","(۳۶۵۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی قَوْلِہِ : {إنَّا ہُدْنَا إلَیْک} قَالَ : تُبْ","","Musannaf Ibn Abi Shaybah 36500","","","كتاب الزهد"
"36501","(۳۶۵۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الزُّبَیْرِیُّ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {بَلَ الإِنْسَان عَلَی نَفْسِہِ بَصِیرَۃٌ} قَالَ : شَاہِدٌ عَلَی نَفْسِہِ وَلَوَ اعْتَذَرَ۔","","Musannaf Ibn Abi Shaybah 36501","","","كتاب الزهد"
"36502","(۳۶۵۰۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {لاَ جَرَمَ أَنَّ لَہُمُ النَّارَ وَأَنَّہُمْ مُفْرَطُونَ} قَالَ : مَنْسِیُّونَ مُضَیَّعُونَ۔","","Musannaf Ibn Abi Shaybah 36502","","","كتاب الزهد"
"36503","(۳۶۵۰۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ عَطَائٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {وَنَکْتُبُ مَا قَدَّمُوا وَآثَارَہُمْ} قَالَ: مَا نَسوا۔","","Musannaf Ibn Abi Shaybah 36503","","","كتاب الزهد"
"36504","(۳۶۵۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : یَقُولُ ، یَعْنِی اللَّہَ تَبَارَکَ وَتَعَالَی : مَا بَالُ أَقْوَامٍ یَتَفَقَّہُونَ بِغَیْرِ عِبَادَتِی ، یَلْبَسُونَ مُسُوکَ الضَّأْنِ وَقُلُوبُہُمْ أَمَرُّ مِنَ الصَّبِرِ ، أَبِی یَغْتَرُّونَ أَمْ إیَّایَ یَخْدَعُونَ فَبِی حَلَفْت لأُتِیحَنَّ لَہُمْ فِتْنَۃً فِی الدُّنْیَا تَدَعُ الْحَلِیمَ مِنْہُمْ حَیْرَاناً۔ (ابن المبارک ۵۰)","","Musannaf Ibn Abi Shaybah 36504","","","كتاب الزهد"
"36505","(۳۶۵۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، أَنَّ جَبَّارًا مِنَ الْجَبَابِرَۃِ ، قَالَ : لاَ أَنْتَہِی حَتَّی أَنْظُرَ إِلَی مَنْ فِی السَّمَائِ ، قَالَ : فَسَلَّطَ اللَّہُ عَلَیْہِ أَضْعَفَ خَلْقِہِ فَدَخَلَتْ بَقَّۃٌ فِی أَنْفِہِ فَأَخَذَہُ الْمَوْتُ ، فَقَالَ : اضْرِبُوا رَأْسِی ، فَضَرَبُوہُ حَتَّی نَثَرُوا دِمَاغَہُ۔","","Musannaf Ibn Abi Shaybah 36505","","","كتاب الزهد"
"36506","(۳۶۵۰۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ رَبِیعٍ ، قَالَ : سَمِعْتُ أَبَا عُبَیْدَۃَ یَقُولُ : إنَّ الْحُکْمَ الْعَدْلَ لَیُسَکِّنُ الأَصْوَاتَ عَنِ اللہِ ، وَإِنَّ الْحُکْمَ الْجَائِرَ تَکْثُرُ مِنْہُ الشَّکَاۃُ إِلَی اللہِ۔","","Musannaf Ibn Abi Shaybah 36506","","","كتاب الزهد"
"36507","(۳۶۵۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ {إنَّ ہَؤُلاَئِ لَشِرْذِمَۃٌ قَلِیلُونَ} قَالَ : کَانُوا سِتَّ مِئَۃِ أَلْفٍ وَسَبْعِینَ أَلْفًا۔","","Musannaf Ibn Abi Shaybah 36507","","","كتاب الزهد"
"36508","(۳۶۵۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : سَمِعْتُ عَبْدَ الأَعْلَی التَّیْمِیَّ یَقُولُ : مَنْ أُوتِیَ مِنَ الْعِلْمِ مَا لاَ یُبْکِیہِ لخَلِیقٌ أَنْ لاَ یَکُونَ أُوتِیَ عِلْمًا یَنْفَعُہُ، لأَنَّ اللَّہَ نَعَتَ الْعُلَمَائَ، ثُمَّ قَرَأَ إِلَی قَوْلِہِ {یَبْکُونَ}۔ (ابن المبارک ۱۲۵)","","Musannaf Ibn Abi Shaybah 36508","","","كتاب الزهد"
"36509","(۳۶۵۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : قَالَ عَبْدُ الأَعْلَی التَّیْمِیِّ قَالَ : ما من أہل دار إِلاَّ ملک الموت یتصفحہم فی الیوم مرتین۔","","Musannaf Ibn Abi Shaybah 36509","","","كتاب الزهد"
"36510","(۳۶۵۱۰) حَدَّثَنَا ابْنِِ عُیَیْنَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الأَعْلَی التَّیْمِیِّ ، قَالَ : الْجَنَّۃُ وَالنَّارُ لَقِنَتَا السَّمْعَ مِنْ بَنِی آدَمَ ، فَإِذَا سَأَلَ الرَّجُلُ الْجَنَّۃَ ، قَالَتْ : اللَّہُمَّ أَدْخِلْہُ فِیَّ ، وَإِذَا اسْتَعَاذَ مِنَ النَّارِ ، قَالَتْ : اللَّہُمَّ أَعِذْہُ مِنِّی۔","","Musannaf Ibn Abi Shaybah 36510","","","كتاب الزهد"
"36511","(۳۶۵۱۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ أَبُو صَالِحٍ یَؤُمُّنَا ، فَکَانَ لاَ یُبَیِّنُ الْقِرَائَۃَ مِنَ الرِّقَّۃِ۔","","Musannaf Ibn Abi Shaybah 36511","","","كتاب الزهد"
"36512","(۳۶۵۱۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، قَالَ : یُحْشَرُ النَّاسُ ہَکَذَا وَوَضَعَ رَأْسَہُ وَأَمْسَکَ بِیَمِینِہِ عَلَی شِمَالِہِ عِنْدَ صَدْرِہِ۔","","Musannaf Ibn Abi Shaybah 36512","","","كتاب الزهد"
"36513","(۳۶۵۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ {یَا وَیْلَنَا مَنْ بَعَثَنَا مِنْ مَرْقَدِنَا} قَالَ : کَانُوا یَرَوْنَ ، أَنَّ الْعَذَابَ یُخَفَّفُ ، عَنْ أَہْلِ الْقُبُورِ مَا بَیْنَ النَّفْخَتَیْنِ ، فَإِذَا جَائَتِ النَّفْخَۃُ الثَّانِیَۃُ ، قَالُوا : {یَا وَیْلَنَا مَنْ بَعَثَنَا مِنْ مَرْقَدِنَا}۔","","Musannaf Ibn Abi Shaybah 36513","","","كتاب الزهد"
"36514","(۳۶۵۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، قَالَ : طُوبَی شَجَرَۃٌ فِی الْجَنَّۃِ لَوْ أَنَّ رَاکِبًا رَکِبَ حِقَّۃً ، أَوْ جَذَعَۃً فَأَطَافَ بِہَا مَا بَلَغَ الْمَوْضِعَ الَّذِی رَکِبَ فِیہِ حَتَّی یَقْتُلَہُ الْہَرَمُ۔","","Musannaf Ibn Abi Shaybah 36514","","","كتاب الزهد"
"36515","(۳۶۵۱۵) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، قَالَ : حدَّثَنَا أَبُو سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّۃ ، عَنْ أَبِی صَالِحٍ ، قَالَ : یُحَاسِبُ یَوْمَ الْقِیَامَۃِ الَّذِینَ أَرْسَلَ إلَیْہِمَ الرُّسُلَ فَیُدْخِلُ الْجَنَّۃَ مَنْ أَطَاعَہُ وَیُدْخِلُ النَّارَ مَنْ عَصَاہُ : وَیَبْقَی قَوْمٌ مِنَ الْوِلْدَانِ وَالَّذِینَ ہَلَکُوا فِی الْفَتْرَۃِ وَمَنْ غُلِبَ عَلَی عَقْلِہِ ، فَیَقُولُ الرَّبُّ تَبَارَکَ وَتَعَالَی لَہُمْ : قَدْ رَأَیْتُمْ إنَّمَا أَدْخَلْت الْجَنَّۃَ مَنْ أَطَاعَنِی وَأَدْخَلْت النَّارَ مَنْ عَصَانِی ، وَإِنِّی آمُرُکُمْ أَنْ تَدْخُلُوا ہَذِہِ النَّارَ ، فَیَخْرُجُ لَہُمْ عُنُقٌ مِنْہَا ، فَمَنْ دَخَلَہَا کَانَتْ نَجَاتَہُ ، وَمَنْ نَکَصَ فَلَمْ یَدْخُلْہَا کَانَتْ ہَلَکَتَہُ۔","","Musannaf Ibn Abi Shaybah 36515","","","كتاب الزهد"
"36516","(۳۶۵۱۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی صَالِحٍ {وُجُوہٌ یَوْمَئِذٍ نَاضِرَۃٌ} قَالَ : حَسَنَۃٌ {إلَی رَبِّہَا نَاظِرَۃٌ} قَالَ : تَنْتَظِرُ الثَّوَابَ مِنْ رَبِّہَا۔","","Musannaf Ibn Abi Shaybah 36516","","","كتاب الزهد"
"36517","(۳۶۵۱۷) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ یَحْیَی، أَنَّہُ کَانَ إذَا صَلَّی کَأَنَّہُ یُخَاطِبُ رَجُلاً مِنْ إقْبَالِہِ عَلَی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 36517","","","كتاب الزهد"
"36518","(۳۶۵۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، قَالَ : کَانُوا إذَا کَانَتْ فِیہِمْ جِنَازَۃٌ عُرِفَ ذَلِکَ فِی وُجُوہِہِمْ أَیَّامًا۔","","Musannaf Ibn Abi Shaybah 36518","","","كتاب الزهد"
"36519","(۳۶۵۱۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ یَحْیَی إذَا قَضَی الصَّلاَۃَ مَکَثَ سَاعَۃً تُعْرَفُ عَلَیْہِ کَآبَۃُ الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 36519","","","كتاب الزهد"
"36520","(۳۶۵۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ضِرَارِ بْنِ مُرَّۃَ ، قَالَ : لَقِیت الضَّحَّاکَ بِخُرَاسَانَ وَعَلَیَّ فَرْوٌ لِی خَلِقٌ ، فَقَالَ الضَّحَّاکُ : قَالَ أَبُو إدْرِیسَ : قَلْبٌ نَقِیٌّ فِی ثِیَابٍ دَنِسَۃٍ خَیْرٌ مِنْ قَلْبٍ دَنِسٍ فِی ثِیَابٍ نَقِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 36520","","","كتاب الزهد"
"36521","(۳۶۵۲۱) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ الْیَامِیِّ، عَنْ أَبِی إدْرِیسَ رَجُلٌ مِنْ أَہْلِ الْیَمَنِ، قَالَ: کَانَ یَقُولُ : اللَّہُمَّ اجْعَلْ نَظَرِی عِبَرًا وَصَمْتِی تَفَکُّرًا وَمَنْطِقِی ذِکْرًا۔","","Musannaf Ibn Abi Shaybah 36521","","","كتاب الزهد"
"36522","(۳۶۵۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ صَفْوَانَ بْنِ سُلَیْمٍ ، قَالَ : قَالَ أَبُو مُسْلِمٍ الْخَوْلاَنِیُّ : کَانَ النَّاسُ وَرَقًا لاَ شَوْکَ فِیہِ ، وَإِنَّہُمَ الْیَوْمَ شَوْکٌ لاَ وَرَقَ فِیہِ ، إنْ سَابَبْتَہُمْ سَابُّوک ، وَإِنْ نَاقَدْتَہُمْ نَاقَدُوکَ ، وَإِنْ تَرَکْتَہُمْ لَمْ یَتْرُکُوک۔","","Musannaf Ibn Abi Shaybah 36522","","","كتاب الزهد"
"36523","(۳۶۵۲۳) حَدَّثَنَا سَعِیدُ بْنُ شُرَحْبِیلَ ، قَالَ : أَخْبَرَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ عُقَیْلٍ ، عَنِ ابْنِ شِہَابٍ ، قَالَ : جَلَسْت ذَاتَ یَوْمٍ إِلَی أَبِی إدْرِیسَ الْخَوْلاَنِیِّ وَہُوَ یَقُصُّ ، فَقَالَ : أَلاَ أُخْبِرُکُمْ بِمَنْ کَانَ أَطْیَبَ النَّاسِ طَعَامًا ، فَلَمَّا رَأَی النَّاسَ قَدْ نَظَرُوا إلَیْہِ ، قَالَ : إنَّ یَحْیَی بْنَ زَکَرِیَّا کَانَ أَطْیَبَ النَّاسِ طَعَامًا ، إنَّمَا کَانَ یَأْکُلُ مَعَ الْوَحْشِ کَرَاہِیَۃَ أَنْ یُخَالِطَ النَّاسَ فِی مَعَائِشِہِمْ۔","","Musannaf Ibn Abi Shaybah 36523","","","كتاب الزهد"
"36524","(۳۶۵۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ قَالَ : قَالَ أَبُو مُسْلِمٍ الْخَوْلاَنِیُّ : مَا عَمِلْت عَمَلاً أُبَالِی مَنْ رَآنِی إِلاَّ حَاجَتِی إِلَی أَہْلِی وَحَاجَتِی إِلَی الْغَائِطِ۔","","Musannaf Ibn Abi Shaybah 36524","","","كتاب الزهد"
"36525","(۳۶۵۲۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی إدْرِیسَ ، قَالَ : لاَ یَہْتِکُ اللَّہُ سَتْرَ عَبْدٍ فِی قَلْبِہِ مِثْقَالَ ذَرَّۃٍ مِنْ خَیْرٍ۔","","Musannaf Ibn Abi Shaybah 36525","","","كتاب الزهد"
"36526","(۳۶۵۲۶) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ أَبِی مُسْلِمٍ الْخَوْلاَنِیِّ ، قَالَ : أَرْبَعٌ لاَ یُقْبَلْنَ فِی أَرْبَعٍ : مَالُ الْیَتِیمِ وَالْغُلُولُ وَالْخِیَانَۃُ وَالسَّرِقَۃُ لاَ یُقْبَلْنَ فِی حَجٍّ ، وَلاَ عُمْرَۃٍ ، وَلاَ جِہَادٍ ، وَذَکَرَ حَرْفًا آخَرَ۔","","Musannaf Ibn Abi Shaybah 36526","","","كتاب الزهد"
"36527","(۳۶۵۲۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : قَالَ أَبُو عُثْمَانَ النَّہْدِیُّ : إنِّی لأَعْلَمُ حِینَ یَذْکُرُنِی رَبِّی ، قَالُوا : وَکَیْفَ ذَاکَ ، قَالَ : إنَّ اللَّہَ یَقُولُ : {فَاذْکُرُونِی أذْکُرْکُمْ} فَإِذَا ذَکَرْت اللَّہَ ذَکَرَنِی۔","","Musannaf Ibn Abi Shaybah 36527","","","كتاب الزهد"
"36528","(۳۶۵۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا الْحَجَّاجُ بْنُ أَبِی زَیْنَبَ، قَالَ: سَمِعْتُ أَبَا عُثْمَانَ یَقُولُ: مَا فِی الْقُرْآنِ آیَۃٌ أَرْجَی عِنْدِی لِہَذِہِ الأُمَّۃِ مِنْ قَوْلِہِ : {وَآخَرُونَ اعْتَرَفُوا بِذُنُوبِہِمْ خَلَطُوا عَمَلاً صَالِحًا وَآخَرَ سَیِّئًا}۔","","Musannaf Ibn Abi Shaybah 36528","","","كتاب الزهد"
"36529","(۳۶۵۲۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : قَلِیلاً مَا یَنَامُونَ لَیْلَۃً حَتَّی الصَّبَاحِ۔","","Musannaf Ibn Abi Shaybah 36529","","","كتاب الزهد"
"36530","(۳۶۵۳۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ {لاَ یَمَسُّہُ إِلاَّ الْمُطَہَّرُونَ} قَالَ : لَیْسَ أَنْتُمْ ، أَنْتُمْ أَصْحَابُ الذُّنُوبِ۔","","Musannaf Ibn Abi Shaybah 36530","","","كتاب الزهد"
"36531","(۳۶۵۳۱) حَدَّثَنَا عَبَّادٌ، عَنْ عَوْفٍ، عَنْ أَبِی الْمِنْہَالِ أنَّ أَبَا الْعَالِیَۃِ رَأَی رَجُلاً یَتَوَضَّأُ، فَلَمَّا فَرَغَ، قَالَ: اللَّہُمَّ اجْعَلْنِی مِنَ التَّوَّابِینَ وَاجْعَلْنِی مِنَ الْمُتَطَہِّرِینَ ، فَقَالَ : إنَّ الطُّہُورَ بالْمَائِ حَسَنٌ ، وَلَکِنَّہُمُ الْمُطَہَّرُونَ مِنَ الذُّنُوبِ۔","","Musannaf Ibn Abi Shaybah 36531","","","كتاب الزهد"
"36532","(۳۶۵۳۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ رَجُلٍ ، عَنْ أَبِی الْعَالِیَۃِ ، أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَخْتِمَ الْقُرْآنَ آخِرَ النَّہَارِ أَخَّرَہُ إِلَی أَنْ یُمْسِی ، وَإِذَا أَرَادَ أَنْ یَخْتِمَہُ آخِرَ اللَّیْلِ أَخَّرَہُ إِلَی أَنْ یُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 36532","","","كتاب الزهد"
"36533","(۳۶۵۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنْ عُثْمَانَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : قَالَ لِی أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَعْمَلْ لِغَیْرِ اللہِ فَیَکِلَکَ اللَّہُ إِلَی مَنْ عَمِلْت لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 36533","","","كتاب الزهد"
"36534","(۳۶۵۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : سَمِعْتُ شَیْخًا یُقَالَ لَہُ : زُفَرُ یَذْکُرُ ، عَنْ قَیْسِ بْنِ حَبْتَرٍ ، قَالَ : الصَّعْقَۃُ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 36534","","","كتاب الزهد"
"36535","(۳۶۵۳۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُوسَی الْجُہَنِیِّ ، عَنْ بَعْضِ أَصْحَابِہِ ، قَالَ : مَا أَتَتْ عَلَی عَبْدٍ لَیْلَۃٌ قَطُّ إِلاَّ، قَالَتْ : ابْنَ آدَمَ ، أَحْدِثْ فِیَّ خَیْرًا فَإِنِّی لَنْ أَعُودَ عَلَیْک أَبَدًا۔","","Musannaf Ibn Abi Shaybah 36535","","","كتاب الزهد"
"36536","(۳۶۵۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، أَنَّ الْحَسَنَ بْنَ الْحَکَمِ حَدَّثَہُ ، قَالَ : سَمِعْتُ حَمَّادًا یَقُولُ : سَمِعْت إبْرَاہِیمَ یَقُولُ : لَوْ أَنَّ عَبْدًا اکْتَتَمَ بِالْعِبَادَۃِ کَمَا یَکْتَتِمُ بِالْفُجُورِ لأظْہَرَ اللَّہُ ذَلِکَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 36536","","","كتاب الزهد"
"36537","(۳۶۵۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحْیُونَ الزِّیَادَۃَ وَیَکْرَہُونَ النُّقْصَانَ ، وَیَقُولُ : شَیْئٌ دِیمَۃٌ۔","","Musannaf Ibn Abi Shaybah 36537","","","كتاب الزهد"
"36538","(۳۶۵۳۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، قَالَ : زَعَمُوا ، أَنَّ إبْرَاہِیمَ کَانَ یَقُولُ : کُنَّا إذَا حَضَرْنَا جِنَازَۃً ، أَوْ سَمِعَنَّا بِمَیِّتٍ یُعْرَفُ ذَلِکَ فِینَا أَیَّامًا لأَنَّا قَدْ عَرَفْنَا ، أَنَّہُ قَدْ نَزَلَ بِہِ أَمْرٌ صَیَّرَہُ إِلَی الْجَنَّۃِ ، أَوِ النَّارِ، وَأَنَّکُمْ تَحَدَّثُونَ فِی جَنَائِزِکُمْ بِحَدِیثِ دُنْیَاکُمْ۔","","Musannaf Ibn Abi Shaybah 36538","","","كتاب الزهد"
"36539","(۳۶۵۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَیْنَا رَجُلٌ عَابِدٌ عِنْدَ امْرَأَۃٍ إذْ عَمَدَ فَضَرَبَ بِیَدِہِ عَلَی فَخِذِہَا ، قَالَ : فَأَخَذَ بِیَدِہِ فَوَضَعَہَا فِی النَّارِ حَتَّی نَشَّتْ۔","","Musannaf Ibn Abi Shaybah 36539","","","كتاب الزهد"
"36540","(۳۶۵۴۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ خَالِدِ بْنِ حَوْشَبٍ ، قَالَ : قَالَ إبْرَاہِیمُ : قَلَّمَا قَرَأْت ہَذِہِ الآیَۃَ إِلاَّ ذَکَرْت بَرْدَ الشَّرَابِ : {وَحِیلَ بَیْنَہُمْ وَبَیْنَ مَا یَشْتَہُونَ}۔","","Musannaf Ibn Abi Shaybah 36540","","","كتاب الزهد"
"36541","(۳۶۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَکَرِیَّا الْعَبْدِیِّ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ بَکَی فِی مَرَضِہِ ، فَقَالُوا لَہُ : یَا أَبَا عِمْرَانَ ، مَا یُبْکِیک ، فَقَالَ : وَکَیْفَ لاَ أَبْکِی وَأَنَا أَنْتَظِرُ رَسُولاً مِنْ رَبِّی یُبَشِّرُنِی إمَّا بِہَذِہِ وَإِمَّا بِہَذِہِ۔","","Musannaf Ibn Abi Shaybah 36541","","","كتاب الزهد"
"36542","(۳۶۵۴۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، قَالَ : رَأَی إبْرَاہِیمُ أَمِیرَ حُلْوَانَ یَمُرُّ بِدَوَابِّہِ فِی زَرْعٍ ، فَقَالَ : الْجَوْرُ فِی طَرِیقٍ خَیْرٌ مِنَ الْجَوْرِ فِی الدِّینِ۔","","Musannaf Ibn Abi Shaybah 36542","","","كتاب الزهد"
"36543","(۳۶۵۴۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی قَوْلِہِ : {حَمِیمًا وَغَسَّاقًا} قَالَ : الغساق : مَا یَتَقَطَّعُ مِنْ جُلُودِہِمْ ، وَمَا یَسِیلُ مِنْ بَشَرِہِمْ۔","","Musannaf Ibn Abi Shaybah 36543","","","كتاب الزهد"
"36544","(۳۶۵۴۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَمُجَاہِدٍ {یُنَبَّأُ الإِنْسَان یَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ} قَالاَ : بِأَوَّلِ عَمَلِہِ وَآخِرِہِ۔","","Musannaf Ibn Abi Shaybah 36544","","","كتاب الزهد"
"36545","(۳۶۵۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ {وَلَنُذِیقَنَّہُمْ مِنَ الْعَذَابِ الأَدْنَی دُونَ الْعَذَابِ الأَکْبَرِ} قَالَ: أَشْیَائُ یُصَابُونَ بِہَا فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 36545","","","كتاب الزهد"
"36546","(۳۶۵۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : کَانَ إبْرَاہِیمُ یَقْرَأُ فِی الْمُصْحَفِ فَإِذَا دَخَلَ عَلَیْہِ إنْسَانٌ غَطَّاہُ ، وَقَالَ : لاَ یَرَانِی أَقْرَأُ فِیہِ کُلَّ سَاعَۃٍ۔","","Musannaf Ibn Abi Shaybah 36546","","","كتاب الزهد"
"36547","(۳۶۵۴۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذَکَرَ إبْرَاہِیمُ ، أَنَّہُ أَرْسَلَ إلَیْہِ الْمُخْتَارُ بْنُ أَبِی عُبَیْدٍ ، قَالَ : فَطَلَی وَجْہَہُ بِطِلاَئٍ وَشَرِبَ دَوَائً وَلَمْ یَأْتِہِمْ ، فَتَرَکُوہُ۔","","Musannaf Ibn Abi Shaybah 36547","","","كتاب الزهد"
"36548","(۳۶۵۴۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو الْفُقَیْمِیِّ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنِ ابْتَغَی شَیْئًا مِنَ الْعِلْمِ یَبْتَغِی بِہِ اللہِ آتَاہُ اللَّہُ مِنْہُ مَا یَکْفِیہِ۔","","Musannaf Ibn Abi Shaybah 36548","","","كتاب الزهد"
"36549","(۳۶۵۴۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْخُشُوعُ فِی الْقَلْبِ۔","","Musannaf Ibn Abi Shaybah 36549","","","كتاب الزهد"
"36550","(۳۶۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ مَنْ قَبْلَکُمْ أَشْفَقَ ثِیَابًا وَأَشْفَقَ قُلُوبًا۔","","Musannaf Ibn Abi Shaybah 36550","","","كتاب الزهد"
"36551","(۳۶۵۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ ، إذَا قَالَ الرَّجُلُ حِینَ یُصْبِحُ : أَعُوذُ بِالسَّمِیعِ الْعَلِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ عَشْرَ مَرَّاتٍ أُجِیرَ مِنَ الشَّیْطَانِ إِلَی أَنْ یُمْسِی ، وَإذَا قَالَہُ مُمْسِیًا أُجِیرَ مِنَ الشَّیْطَانِ إِلَی أَنْ یُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 36551","","","كتاب الزهد"
"36552","(۳۶۵۵۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ قَمِیصُ إبْرَاہِیمَ عَلَی ظَہْرِ الْقَدَمِ۔","","Musannaf Ibn Abi Shaybah 36552","","","كتاب الزهد"
"36553","(۳۶۵۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ {لَعَلَّہُمْ یَرْجِعُونَ} قَالَ : یَتُوبُونَ۔","","Musannaf Ibn Abi Shaybah 36553","","","كتاب الزهد"
"36554","(۳۶۵۵۴) حَدَّثَنَا عَلِیُّ بْنُ حَفْصٍ ، عَنْ شَیْبَان ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَشْرُفُ قَوْمٌ فِی الْجَنَّۃِ عَلَی قَوْمٍ فِی النَّارِ فَیَقُولُونَ : مَا لَکُمْ فِی النَّارِ ، وَإِنَّمَا کُنَّا نَعْمَلُ بِمَا تُعَلِّمُونَا ، قَالُوا : کُنَّا نُعَلِّمُکُمْ ، وَلاَ نَعْمَلُ بِہِ۔","","Musannaf Ibn Abi Shaybah 36554","","","كتاب الزهد"
"36555","(۳۶۵۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ {وَمَعَارِجَ عَلَیْہَا یَظْہَرُونَ} قَالَ : الدَّرَجُ۔","","Musannaf Ibn Abi Shaybah 36555","","","كتاب الزهد"
"36556","(۳۶۵۵۶) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ {وَمَعَارِجَ عَلَیْہَا یَظْہَرُونَ} قَالَ : الدَّرَجُ ، وَسُقُفًا ، قَالَ : الْجَزُوعُ وَزُخْرُفًا ، قَالَ : الذَّہَبُ۔","","Musannaf Ibn Abi Shaybah 36556","","","كتاب الزهد"
"36557","(۳۶۵۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : سَمِعْتُ عُبَیْدَ اللہِ بْنَ الْعَیْزَارِ ، قَالَ : إنَّ الأَقْدَامَ یَوْمَ الْقِیَامَۃِ کَمَثَلِ النَّبْلِ فِی الْقَرْنِ ، وَالسَّعِیدُ مَنْ وَجَدَ لِقَدَمَیْہِ مَوْضِعًا یَضَعُہُمَا ، وَعِنْدَ الْمِیزَانِ مَلَکٌ یُنَادِی : أَلاَ إنَّ فُلاَنَ بْنَ فُلاَنٍ ثَقُلَتْ مَوَازِینُہُ ، فَسَعِدَ سَعَادَۃً لاَ یَشْقَی بَعْدَہَا أَبَدًا ، أَلاَ إنَّ فُلاَنَ بْنَ فُلاَنٍ خَفَّتْ مَوَازِینُہُ فَشَقِیَ شَقَائً لاَ یَسْعَدُ بَعْدَہُ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 36557","","","كتاب الزهد"
"36558","(۳۶۵۵۸) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، قَالَ : کَانَ یَقُولُ : لَنِعْمَۃُ اللہِ عَلَیَّ فِیمَا زَوَی عَنِّی مِنَ الدُّنْیَا أَعْظَمُ مِنْ نِعْمَتِہِ عَلَیَّ فِیمَا أَعْطَانِی مِنْہَا۔","","Musannaf Ibn Abi Shaybah 36558","","","كتاب الزهد"
"36559","(۳۶۵۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ سَمِعَ أَبَاہُ وَعَمَّہُ یَذْکُرَانِ ، قَالاَ : کَانَ عَبْدُ الْمَلِکِ بْنُ إیَاسٍ مِمَّنْ سَمِعَ ثُمَّ سَکَتَ۔","","Musannaf Ibn Abi Shaybah 36559","","","كتاب الزهد"
"36560","(۳۶۵۶۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَعْجَبُ أَہْلِ الْکُوفَۃِ إلَیَّ أَرْبَعَۃٌ : طَلْحَۃُ وَزُبَیْد وَمُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ، وَیَحْیَی بْنُ عَبَّادٍ۔","","Musannaf Ibn Abi Shaybah 36560","","","كتاب الزهد"
"36561","(۳۶۵۶۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، قَالَ : قُلْتُ لِطَلْحَۃَ : إنَّ طَاوُوسًا کَانَ یَکْرَہُ الأَنِینَ ، قَالَ : فَمَا سُمِعَ لَہُ أَنِینٌ حَتَّی مَاتَ۔","","Musannaf Ibn Abi Shaybah 36561","","","كتاب الزهد"
"36562","(۳۶۵۶۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ، عَنْ مِسْعَرٍ، قَالَ: أَعْطَانِی زَیْدٌ الْعَمِّیُّ کِتَابًا فِیہِ، أَنَّ رَجُلاً أَوْصَی ابْنَہُ، قَالَ: یَا بُنَی، کُنْ مِنْ نَأْیُہ مِمَّنْ نَأَی عَنْہُ تَغَنِّیًا وَنَزَاہَۃٌ، وَدُنُوِّہِ مِمَّنْ دَنَا مِنْہُ لِینٌ وَرَحْمَۃٌ، لَیْسَ نَأْیُہُ کِبَرًا، وَلاَ عَظَمَۃً، وَلَیْسَ دُنُوُّہُ خَدْعًا، وَلاَ خِیَانَۃً ، لاَ یُعَجِّلُ فِیمَا رَابَہُ ، وَیَعْفُو عَمَّا تَبَیَّنَ لَہُ ، لاَ یَغُرُّہُ ثَنَائُ مَنْ جَہِلَہُ، وَلاَ یَنْسَی إحْصَائَ مَا قَدْ عَمِلَہُ، إنْ ذُکِرَ خَافَ مِمَّا یَقُولُونَ، وَاسْتَغْفَرَ مِمَّا لاَ یَعْلَمُونَ، یَقُولُ رَبِّی أَعْلَمُ بِی مِنْ نَفْسِی، وَأَنَا أَعْلَمُ بِنَفْسِی مِنْ غَیْرِی ، یَسْأَلُ لِیَعْلَمَ ، وَیَنْطِقُ لِیَغْنَمَ ، وَیَصْمُتُ لِیَسْلَمَ ، وَیُخَالِطُ لِیَفْہَمَ، إنْ کَانَ فِی الْغَافِلِینَ کُتِبَ مِنَ الذَّاکِرِینَ وَإِنْ کَانَ فِی الْذَّاکِرینَ ، لَمْ یُکْتَبْ مِنَ الْغَافِلِینَ ، لأَنَّہُ یَذْکُرُ إذَا غَفَلُوا، وَلاَ یَنْسَی إذَا ذَکَرُوا، قَالَ حُسَیْنٌ: وَزَادَ فِیہِ ابْنُ عُیَیْنَۃَ: یَمْزُجُ الْعِلْمَ بِحِلْمِ زَہَادَتِہِ فِیمَا یَفْنَی کَرَغْبَتِہِ فِیمَا یَبْقَی۔","","Musannaf Ibn Abi Shaybah 36562","","","كتاب الزهد"
"36563","(۳۶۵۶۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الْمِنْہَالِ ، عَنْ خَیْثَمَۃ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : إذَا أَرَادَ اللَّہُ أَنْ یَنْسَی أَہْلُ النَّارِ جُعِلَ لِکُلِّ إنْسَانٍ مِنْہُمْ تَابُوتًا مِنْ نَارٍ عَلَی قَدْرِہِ ، ثُمَّ أُقْفِلَ عَلَیْہِ بِأَقْفَالٍ مِنْ نَارٍ فَلاَ یُضْرَبُ مِنْہُ عِرْقٌ إِلاَّ وَفِیہِ مِسْمَارٌ مِنْ نَارٍ ، ثُمَّ جُعِلَ ذَلِکَ التَّابُوتُ فِی تَابُوتٍ آخَرَ مِنْ نَارٍ ، ثُمَّ أُقْفِلَ عَلَیْہِ بِأَقْفَالٍ مِنْ نَارٍ ، ثُمَّ یُضْرَمُ بَیْنَہُمَا نَارٌ ، فَلاَ یَرَی أَحَدٌ مِنْہُمْ ، أَنَّ فِی النَّارِ أَحَدًا غَیْرَہُ ، فَذَلِکَ ق[corrupt]لہ تعالی : {لَہُمْ مِنْ فَوْقِہِمْ ظُلَلٌ مِنَ النَّارِ وَمِنْ تَحْتِہِمْ ظُلَلٌ} وَذَلِکَ قولہ تعالی : {لَہُمْ مِنْ جَہَنَّمَ مِہَادٌ وَمِنْ فَوْقِہِمْ غَوَاشٍ وَکَذَلِکَ نَجْزِی الظَّالِمِینَ}۔","","Musannaf Ibn Abi Shaybah 36563","","","كتاب الزهد"
"36564","(۳۶۵۶۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : إنَّ اللَّہَ لَیُصْلِحُ بِصَلاَحِ الْعَبْدِ وَلَدَہُ وَوَلَدَ وَلَدِہِ وَأَہْلَ دُوَیْرَتِہِ وَأَہْلَ الدُّوَیْرَاتِ حَوْلَہُ ، فَمَا یَزَالُونَ فِی حِفْظٍ مِنَ اللہِ مَا دَامَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 36564","","","كتاب الزهد"
"36565","(۳۶۵۶۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ حَمْزَۃَ الزَّیَّاتِ ، عَنْ حُمْرَانَ بْنِ أَعْیَن ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ الدّیلِیِّ ، قَالَ : إنَّ الرَّجُلَ لَیُحْبَسُ عَلَی بَابِ الْجَنَّۃِ بِالذَّنْبِ عَمِلَہُ مِئَۃَ عَامٍ وَإِنَّہُ لَیَرَی أَزْوَاجَہُ وَخَدَمَہُ۔","","Musannaf Ibn Abi Shaybah 36565","","","كتاب الزهد"
"36566","(۳۶۵۶۶) حَدَّثَنَا مُعَاوِیَۃُ ، عَنْ سُفْیَانَ ، عَنْ بَخْتَرِیٍّ الطَّائِیِّ ، قَالَ : کَانَ یُقَالَ : أُغْبِطَ الأَحْیَائُ بِمَا یُغْبَطُ بِہِ الأَمْوَاتُ وَاعْلَمْ ، أَنَّ الْعِبَادَۃَ لاَ تَصْلُحُ إِلاَّ بِزُہْدٍ وَذُلٍّ عِنْدَ الطَّاعَۃِ ، وَاسْتَصْعِبْ عِنْدَ الْمَعْصِیَۃِ ، وَأَحِبَّ النَّاسَ عَلَی قَدْرِ تَقْوَاہُمْ۔","","Musannaf Ibn Abi Shaybah 36566","","","كتاب الزهد"
"36567","(۳۶۵۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنِ الْقَاسِمِ بْنِ الْوَلِیدِ {فَإِذَا جَائَتِ الطَّامَّۃُ الْکُبْرَی} قَالَ : حینَ یُسَاقُ أَہْلُ الْجَنَّۃِ إِلَی الْجَنَّۃِ وَأَہْلُ النَّارِ إِلَی النَّارِ۔","","Musannaf Ibn Abi Shaybah 36567","","","كتاب الزهد"
"36568","(۳۶۵۶۸) حَدَّثَنَا الثَّقَفِیُّ، عَنْ أَیُّوبَ، عَنْ أَبِی قِلاَبَۃَ أَظُنُّہُ، عَنْ عُثْمَانَ، قَالَ: مَنْ عَمِلَ عَمَلاً کَسَاہُ اللَّہُ رِدَائَ عَمَلِہِ۔","","Musannaf Ibn Abi Shaybah 36568","","","كتاب الزهد"
"36569","(۳۶۵۶۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : قَالَ عُثْمَان بْنُ عَفَّانَ : مَنْ عَمِلَ عَمَلاً کَسَاہُ اللَّہُ رِدَائَہُ ، إنْ خَیْرٌ فَخَیْرٌ ، وَإِنْ شَرٌّ فَشَرٌّ۔","","Musannaf Ibn Abi Shaybah 36569","","","كتاب الزهد"
"36570","(۳۶۵۷۰) حَدَّثَنَا وَکِیعٌ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ یَحْیَی بْنِ رَافِعٍ ، قَالَ : سَمِعْتُ عُثْمَانَ یَقُولُ : {وَجَائَتْ کُلُّ نَفْسٍ مَعَہَا سَائِقٌ وَشَہِیدٌ} قَالَ : سَائِقٌ یَسُوقُہَا إِلَی أَمْرِ اللہِ ، وَشَہِیدٌ یَشْہَدُ عَلَیْہَا بِمَا عَمِلَتْ۔","Da'if","Musannaf Ibn Abi Shaybah 36570","","","كتاب الزهد"
"36571","(۳۶۵۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : أَیْمَنُ امْرِئٍ وَأَشْأَمُہُ مَا بَیْنَ لَحْیَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 36571","","","كتاب الزهد"
"36572","(۳۶۵۷۲) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : إنَّکُمْ فِی زَمَانٍ مَعْرُوفُہُ مُنْکَرُ زَمَانٍ قَدْ خَلا ، وَمُنْکَرُہُ مَعْرُوفُ زَمَانٍ مَا أَتَی۔","","Musannaf Ibn Abi Shaybah 36572","","","كتاب الزهد"
"36573","(۳۶۵۷۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی مَنْصُورٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : خَرَجْت إِلَی الْجَبَّانَۃِ فَجَلَسْت فِیہَا إِلَی جَنْبِ ْحَائِطٍ ، فَجَائَ رَجُلٌ إِلَی قَبْرٍ فَسَوَّاہُ ، ثُمَّ جَائَ فَجَلَسَ إلَی ، فَقُلْتُ : مَنْ ہَذَا ، فَقَالَ : أَخِی ، قَالَ : قُلْتُ : أَخٌ لَک ، قَالَ : أَخٌ لِی فِی الإِسْلاَمِ رَأَیْتہ الْبَارِحَۃَ فِیمَا یَرَی النَّائِمُ ، فَقُلْتُ : فُلاَنٌ قَدْ عِشْت الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، قَالَ : قَدْ قُلْتہَا ، لأَنْ أَکُونَ أَقْدَرَ عَلَی أَنْ أَقُولَہَا أَحَبُّ إلَیَّ مِنْ مِلْئِ الأَرْضِ ، وَمَا فِیہَا ، أَلَمْ تَرَ حِینَ کَانُوا یَدْفِنُونَنِی فَإِنَّ فُلاَنًا قَامَ فَصَلَّی رَکْعَتَیْنِ لأَنْ أَکُونَ أَقْدَرَ عَلَی أَنْ أُصَلِّیَہُمَا أَحَبُّ إلَیَّ مِنَ الدُّنْیَا ، وَمَا فِیہَا۔","","Musannaf Ibn Abi Shaybah 36573","","","كتاب الزهد"
"36574","(۳۶۵۷۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، قَالَ : للمُقَنِّطِین حبسٌ یَطَأُ النَّاسَ یَوْمَ الْقِیَامَۃِ عَلَی وُجُوہِہِمْ۔","","Musannaf Ibn Abi Shaybah 36574","","","كتاب الزهد"
"36575","(۳۶۵۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : حدَّثَنِی مُعَاوِیَۃُ بْنُ بَشِیرٍ ، قَالَ : أُرَاہُ ، عَنْ أَبِیہِ ، قَالَ : قَالَ خَبَّابٌ: أَنَّہَا سَتَکُونُ صَیْحَاتٌ فَأَصِیخُوا لَہَا۔","","Musannaf Ibn Abi Shaybah 36575","","","كتاب الزهد"
"36576","(۳۶۵۷۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمان عَنْ ثَابِتٍ ، قَالَ : قَالَ ابْنُ أَبِی لَیْلَی : طُفْت ہَذِہِ الأَمْصَارَ فَمَا رَأَیْت أکثر مُتَہَجِّدًا ، وَلاَ أَبْکَرَ عَلَی ذِکْرِ اللہِ مِنْ أَہْلِ الْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 36576","","","كتاب الزهد"
"36577","(۳۶۵۷۷) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، قَالَ : إنَّ الْمَلَکَ یَجِیئُ إِلَی أَحَدِکُمْ کُلَّ غَدَاۃٍ بِصَحِیفَۃٍ بَیْضَائَ فَلْیُمْلِ فِیہَا خَیْرًا ، فَإِذَا طَلَعَتِ الشَّمْسُ فَلْیُقِمْ لِحَاجَتِہِ ، ثُمَّ إذَا صَلَّی الْعَصْرَ فَلْیُمْلِ فِیہَا خَیْرًا فَإِنَّہُ إذَا أَمْلَی فِی أَوَّلِ صَحِیفَتِہِ وَآخِرِہَا خَیْرًا کَانَ عَسَی أَنْ یُکفی مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 36577","","","كتاب الزهد"
"36578","(۳۶۵۷۸) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ ثَوْرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، قَالَ : یَمُرُّونَ عَلَی النَّارِ وَہِیَ خَامِدَۃٌ فَیَقُولُونَ : أَیْنَ النَّارُ الَّتِی وُعِدْنَا ، قَالَ : مَرَرْتُمْ عَلَیْہَا وَہِیَ خَامِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 36578","","","كتاب الزهد"
"36579","(۳۶۵۷۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُوسَی بْنُ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : کَانَ سَعِیدُ بْنُ عامر بْنِ حُذَیْمٍ أَمِیرًا عَلَی مِصْرَ فَبَلَغَ عُمَرَ بْنَ الْخَطَّابِ ، أَنَّہُ یَأْتِی عَلَیْہِ حِینٌ لاَ یُدَخَّنُ فِی تَنُّورِہِ ، فَبَعَثَ إلَیْہِ بِمَالٍ فَاشْتَرَی مَا یُصْلِحُہُ وَأَہْلَہُ ، ثُمَّ قَالَ لاِمْرَأَتِہِ : لَوْ أَنَّا أَعْطَیْنَاہَا تَاجِرًا لَعَلَّہُ أَنْ یُصِیبَ لَنَا فِیہَا، قَالَتْ : فَافْعَلْ قَالَ : فَتَصَدَّقَ بِہَا الرَّجُلُ وَأَعْطَاہَا حَتَّی لَمْ یَبْقَ مِنْہَا شَیْئٌ ، ثُمَّ احْتَاجُوا ، فَقَالَتْ لَہُ امْرَأَتُہُ : لَوْ أَنَّک نَظَرْت إِلَی تِلْکَ الدَّرَاہِمِ فَأَخَذْتہَا فَإِنَّا قَدَ احْتَجْنَا إلَیْہَا ، فَأَعْرَضَ عنہا ، ثُمَّ عَادَتْ ، فَقَالَتْ أَیْضًا ، فَأَعْرَضَ عنہا حَتَّی اسْتَبَانَ لَہَا ، أَنَّہُ قَدْ أَمْضَاہَا ، قَالَ : فَجَعَلَتْ تَلُومُہُ ، قَالَ : فَاسْتَعَانَ عَلَیْہَا بِخَالِدِ بْنِ الْوَلِیدِ فَکَلَّمَہَا ، فَقَالَ : إنَّک قَدْ آذَیْتہ فَکَأَنَّمَا أغراہا بِہِ ، فَقَالَتْ لَہُ أَیْضًا ، فَلَمَّا رَأَی ذَلِکَ الرَّجُلُ بَرَکَ عَلَی رُکْبَتَیْہِ ، فَقَالَ : مَا یَسُرُّنِی أَنْ أُحْبَسَ عَنِ الَعَنَق الأَوَّلِ یَوْمَ الْقِیَامَۃِ ، وَلا أَنَّ لِی مَا ظَہَرَ عَلَی الأَرْضِ ، وَلَوْ أَنْ خَیِّرَۃ مِنَ الْخَیِّرَاتِ أَبْرَزَتْ أَصَابِعَہَا لأَہْلِ الأَرْضِ مِنْ فَوْقِ السَّمَاوَاتِ لَوُجِدَ رِیحُہُنَّ فَأَنَا أَدَعُہُنَّ لَکُنَّ لأَنْ أَدَعَکُنَّ لَہُنَّ أَحْرَی مِنْ أَنْ أَدَعَہُنَّ لَکُنَّ ، فَلَمَّا رَأَتْ ذَلِکَ کَفَّتْ عَنْہُ۔ (ابو نعیم ۲۴۴)","","Musannaf Ibn Abi Shaybah 36579","","","كتاب الزهد"
"36580","(۳۶۵۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : مَرَّ رَجُلٌ بِرَبِیعِ بْنِ أَبِی رَاشِدٍ وَہُوَ جَالِسٌ عَلَی صُنْدُوقٍ مِنْ صَنَادِیقِ الْحَذَّائِین ، فَقَالَ : لَوْ دَخَلْت الْمَسْجِدَ فَجَالَسْت إخْوَانَک ، فَقَالَ لَہُ رَبِیعٌ : لَوْ فَارَقَ ذِکْرُ الْمَوْتِ قَلْبِی سَاعَۃً خَشِیت أَنْ یَفْسُدَ قَلْبِی۔","Hasan","Musannaf Ibn Abi Shaybah 36580","","","كتاب الزهد"
"36581","(۳۶۵۸۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ إسْمَاعِیلَ بْنِ شُعَیْبٍ ، قَالَ : کَانَ أَبِی زَمِیلَ رَبِیعِ بْنِ أَبِی رَاشِدٍ إِلَی مَکَّۃَ ، فَقَالَ ذَاتَ یَوْمٍ : لَوْ أَنِّی أَعْلَمُ أَحَبَّ الْعَمَلِ إِلَی رَبِّی لَعَلِّی أَتَکَلَّفُہُ ، قَالَ : فَرَأَی فِی مَنَامِہِ الشُّکْرَ وَالذِّکْرَ۔","","Musannaf Ibn Abi Shaybah 36581","","","كتاب الزهد"
"36582","(۳۶۵۸۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : لَقِیَنِی رَبِیعُ بْنُ أَبِی رَاشِدٍ فِی السُّدَّۃِ فِی السُّوقِ فَأَخَذَ بِیَدِی فَصَافَحَنِی ، فَقَالَ : یَا أَبَا ذَرٍّ مَنْ سَأَلَ اللَّہَ رِضَاہُ فَقَدْ سَأَلَہُ أَمْرًا عَظِیمًا۔","","Musannaf Ibn Abi Shaybah 36582","","","كتاب الزهد"
"36583","(۳۶۵۸۳) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ عَوْنِ بْنِ شَدَّادٍ ، أَنَّ ہَرِمَ بْنَ حَیَّانَ الْعَبْدِیَّ لَمَّا نَزَلَ بِہِ الْمَوْتُ ، قَالُوا : لَہُ : یَا ہَرِمُ، أَوْصِنی، قَالَ: أُوصِیکُمْ أَنْ تَقْضُوا عَنِّی دَیْنِی، قَالُوا: بِمَ تُوصِی، قَالَ: فَتَلاَ آخِرَ سُورَۃِ النَّحْلِ {ادْعُ إِلَی سَبِیلِ رَبِّکَ بِالْحِکْمَۃِ وَالْمَوْعِظَۃِ الْحَسَنَۃِ} حَتَّی بَلَغَ {إنَّ اللَّہَ مَعَ الَّذِینَ اتَّقَوْا وَالَّذِینَ ہُمْ مُحْسِنُونَ}۔","","Musannaf Ibn Abi Shaybah 36583","","","كتاب الزهد"
"36584","(۳۶۵۸۴) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : قَالَ ہَرِمٌ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ زَمَانٍ یَتَمَرَّدُ فِیہِ صَغِیرُہُمْ وَیَأْمُلُ فِیہِ کَبِیرُہُمْ وَتَقْرُبُ فِیہِ آجَالُہُمْ۔","","Musannaf Ibn Abi Shaybah 36584","","","كتاب الزهد"
"36585","(۳۶۵۸۵) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ، عَنْ أَصْبَغَ الْوَرَّاقِ، عَنْ أَبِی نَضْرَۃَ ، أَنَّ عُمَرَ بَعَثَ ہَرِمَ بْنَ حَیَّانَ عَلَی الْخَیْلِ، فَغَضِبَ عَلَی رَجُلٍ فَأَمَرَ بِہِ فَوُجِئَتْ ، عُنُقُہُ ، ثُمَّ أَقْبَلَ عَلَی أَصْحَابِہِ، فَقَالَ: لاَ جَزَاکُمَ اللَّہُ خَیْرًا، مَا نَصَحْتُمُونِی حِینَ قُلْتُ: وَلاَ کَفَفْتُمُونِی عَنْ غَضَبِی ، وَاللہِ لاَ آلِی لَکُمْ عَمَلاً ، ثُمَّ کَتَبَ إِلَی عُمَرَ: یَا أَمِیرَ الْمُؤْمِنِینَ ، لاَ طَاقَۃَ لِی بِالرَّعِیَّۃِ فَابْعَثْ إلَیَّ عَمَلَک۔","","Musannaf Ibn Abi Shaybah 36585","","","كتاب الزهد"
"36586","(۳۶۵۸۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، أَنَّ ہَرِمَ بْنَ حَیَّانَ کَانَ یَقُولُ : لَمْ أَرَ مِثْلَ النَّارِ نَامَ ہَارِبُہَا ، وَلاَ مِثْلَ الْجَنَّۃِ نَامَ طَالِبُہَا۔","","Musannaf Ibn Abi Shaybah 36586","","","كتاب الزهد"
"36587","(۳۶۵۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : کَانَ ہَرِمُ بْنُ حَیَّانَ عَامِلاً عَلَی بَعْضِ رَسَاتِیقِ الأَہْوَازِ فَاسْتَأْذَنَہُ رَجُلٌ مِنْ أَصْحَابِہِ إِلَی أَہْلِہِ ، فَأَبَی أَنْ یَأْذَنَ لَہُ ، قَالَ : فَقَامَ ہَرِمُ بْنُ حَیَّانَ یَخْطُبُ یَوْمَ الْجُمُعَۃِ إذْ ، قَالَ الرَّجُلُ ہَکَذَا عَلَی أَنْفِہِ أَمْسَکَ عَلَی أَنْفِہِ فَأَشَارَ إلَیْہِ ہَرِمٌ بِیَدِہِ : اذْہَبْ ، فَانْطَلَقَ الرَّجُلُ حَتَّی أَتَی أَہْلَہُ فَقَضَی حَاجَتَہُ ، ثُمَّ رَجَعَ ، فَقَالَ لَہُ ہَرِمٌ : أَیْنَ کُنْت ، فَقَالَ : أَلَمْ تَرَ حِینَ قُمْت فَأَمْسَکْت عَلَی أَنْفِی فَأَشَرْتَ إلَیَّ بِیَدِکَ اذْہَبْ ، فَقَالَ ہَرِمٌ : أَخِّرْ رِجَالَ السُّوئِ لِزَمَانِ السُّوئِ۔","","Musannaf Ibn Abi Shaybah 36587","","","كتاب الزهد"
"36588","(۳۶۵۸۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : أَخْبَرَنِی غَالِبُ الْقَطَّانُ ، عَنْ بَکْرٍ ، قَالَ : إذَا کَانَ یَوْمَ الْقِیَامَۃِ لَمْ یَدَعِ اللَّہُ لِمُؤْمِنٍ حَاجَۃً إِلاَّ قَضَاہَا ، وَلاَ یَسْأَلُہُ إِلاَّ مَا یُوَافِقُ رِضَاہُ۔","","Musannaf Ibn Abi Shaybah 36588","","","كتاب الزهد"
"36589","(۳۶۵۸۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا سَعِیدٌ الْجُرَیْرِیُّ ، قَالَ : مَرَّ مُوَرِّقٌ الْعِجْلِیّ عَلَی مَجْلِسِ الْحَیِّ فَسَلَّمَ عَلَیْہِمْ ، فَرَدُّوا عَلَیْہِ السَّلاَمَ وَسَأَلُوہُ ، فَقَالَ رَجُلٌ مِنَ الْحَیِّ : أکُلُّ حَالِکَ صَالِحٌ، قَالَ : وَدِدْنَا ، أَنَّ الْعُشْرَ مِنْہُ یَصْلُحُ۔","","Musannaf Ibn Abi Shaybah 36589","","","كتاب الزهد"
"36590","(۳۶۵۹۰) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ حُصَیْنٍ، عَنْ بَکْرٍ، قَالَ: لاَ یَکُونُ الرَّجُلُ تَقِیًّا حَتَّی یَکُونَ تَقِیَّ الْغَضَبِ تَقِیَّ الطَّمَعِ۔","","Musannaf Ibn Abi Shaybah 36590","","","كتاب الزهد"
"36591","(۳۶۵۹۱) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ {فَلأَنْفُسِہِمْ یَمْہَدُونَ} قَالَ : فِی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 36591","","","كتاب الزهد"
"36592","(۳۶۵۹۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ {وَلِمَنْ خَافَ مَقَامَ رَبِّہِ جَنَّتَانِ} قَالَ : مَنْ خَافَ اللَّہَ عِنْدَ مَقَامِہِ عَلَی الْمَعْصِیَۃِ فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 36592","","","كتاب الزهد"
"36593","(۳۶۵۹۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، قَالَ : کُنْتُ إذَا رَأَیْت مُجَاہِدًا ظَنَنْت أَنَّہُ خربندۃ ، قَدْ ضَلَّ حِمَارُہُ فَہُوَ مُہْتَمٌّ۔","","Musannaf Ibn Abi Shaybah 36593","","","كتاب الزهد"
"36594","(۳۶۵۹۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا قُطْبَۃُ بْنُ عَبْدِ الْعَزِیزِ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا مِنْ یَوْمٍ یَمْضِی مِنَ الدُّنْیَا إِلاَّ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَخْرَجَنِی مِنَ الدُّنْیَا فَلاَ أَعُودُ إلَیْہَا أَبَدًا۔","","Musannaf Ibn Abi Shaybah 36594","","","كتاب الزهد"
"36595","(۳۶۵۹۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ {نَأْتِی الأَرْضَ نَنْقُصُہَا مِنْ أَطْرَافِہَا} قَالَ: الْمَوْتُ۔","","Musannaf Ibn Abi Shaybah 36595","","","كتاب الزهد"
"36596","(۳۶۵۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ بِالْمَدِینَۃِ أَہْلُ بَیْتٍ ذُو حَاجَۃٍ عِنْدَہُمْ رَأْسُ شَاۃٍ ، فَأَصَابُوا شَیْئًا فَقَالُوا : لَوْ بَعَثْنَا بِہَذَا الرَّأْسِ إِلَی مَنْ ہُوَ أَحْوَجُ إلَیْہِ مِنَّا ، قَالَ : فَبَعَثُوا بِہِ فَلَمْ یَزَلْ یَدُورُ بِالْمَدِینَۃِ حَتَّی رَجَعَ إِلَی أَصْحَابِہِ الَّذِینَ خَرَجَ مِنْ عِنْدِہِمْ۔","","Musannaf Ibn Abi Shaybah 36596","","","كتاب الزهد"
"36597","(۳۶۵۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : ذَہَبَ الْعُلَمَائُ فَمَا بَقِیَ إِلاَّ الْمُتَعَلِّمُونَ ، مَا الْمُجْتَہِدُ فِیکُمَ الْیَوْمَ إِلاَّ کَاللاَّعِبِ فِیمَنْ کَانَ قَبْلَکُمْ۔","","Musannaf Ibn Abi Shaybah 36597","","","كتاب الزهد"
"36598","(۳۶۵۹۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا الْتَقَی الرَّجُلُ الرَّجُلَ فَضَحِکَ فِی وَجْہِہِ تَحَاتَّتْ عَنْہُمَا الذُّنُوبُ کَمَا یَنْثُرُ الرِّیحُ الْوَرَقَ الْیَابِسَ مِنَ الشَّجَرِ ، قَالَ: فَقَالَ رَجُلٌ إنَّ ہَذَا مِنَ الْعَمَلِ یَسِیرٌ ، قَالَ : فَقَالَ : مَا سَمِعْت قولہ تعالی : {لَوْ أَنْفَقْتَ مَا فِی الأَرْضِ جَمِیعًا مَا أَلَّفْتَ بَیْنَ قُلُوبِہِمْ}۔","","Musannaf Ibn Abi Shaybah 36598","","","كتاب الزهد"
"36599","(۳۶۵۹۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَعْجَبُ أَہْلِ الْکُوفَۃِ إلَیَّ أَرْبَعَۃٌ : طَلْحَۃُ وَزُبَیْدٌ وَمُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ، وَیَحْیَی بْنُ عَبَّادٍ۔","","Musannaf Ibn Abi Shaybah 36599","","","كتاب الزهد"
"36600","(۳۶۶۰۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّ الْمُسْلِمَ لَوْ لَمْ یُصِبْ مِنْ أَخِیہِ إِلاَّ أَنَّ حَیَائَہُ مِنْہُ یَمْنَعُہُ مِنَ الْمَعَاصِی۔","","Musannaf Ibn Abi Shaybah 36600","","","كتاب الزهد"
"36601","(۳۶۶۰۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّمَا الْفَقِیہُ مَنْ یَخَافُ اللَّہَ۔","Hasan","Musannaf Ibn Abi Shaybah 36601","","","كتاب الزهد"
"36602","(۳۶۶۰۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ فِی قولہ تعالی : {تُوبُوا إِلَی اللہِ تَوْبَۃً نَصُوحًا} قَالَ : ہُوَ أَنْ یَتُوبَ ، ثُمَّ لاَ یَعُودَ۔","","Musannaf Ibn Abi Shaybah 36602","","","كتاب الزهد"
"36603","(۳۶۶۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ فی قولہ تعالی : {وَلَہُ أَسْلَمَ مَنْ ف[corrupt]ی السَّمَاوَاتِ وَالأَرْضِ طَوْعًا وَکَرْہًا} قَالَ : الطَّائِعُ الْمُؤْمِنُ۔","","Musannaf Ibn Abi Shaybah 36603","","","كتاب الزهد"
"36604","(۳۶۶۰۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : کَانُوا لاَ یَنَامُونَ کُلَّ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 36604","","","كتاب الزهد"
"36605","(۳۶۶۰۵) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ {حُورٌ مَقْصُورَاتٌ فِی الْخِیَامِ} قَالَ : مَقْصُورَاتٌ قُلُوبُہُنَّ وَأَبْصَارُہُنَّ وَأَنْفُسُہُنَّ عَلَی أَزْوَاجِہِنَّ فِی خِیَامِ اللُّؤْلُؤِ لاَ یُرِدْنَ غَیْرَہُمْ۔","","Musannaf Ibn Abi Shaybah 36605","","","كتاب الزهد"
"36606","(۳۶۶۰۶) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ مُجَاہِدٍ {وَحُورٌ عِینٌ} قَالَ : یَحَارُ فِیہِنَّ الْبَصَرُ۔","","Musannaf Ibn Abi Shaybah 36606","","","كتاب الزهد"
"36607","(۳۶۶۰۷) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ {وَاسْأَلُوا اللَّہَ مِنْ فَضْلِہِ} قَالَ : لَیْسَ بِعَرَضِ الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 36607","","","كتاب الزهد"
"36608","(۳۶۶۰۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ {وَتَبَتَّلْ إلَیْہِ تَبْتِیلاً} قَالَ : أَخْلِصْ لَہُ إخْلاَصًا۔","","Musannaf Ibn Abi Shaybah 36608","","","كتاب الزهد"
"36609","(۳۶۶۰۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا مِنْ مَیَّتٍ یَمُوتُ إِلاَّ تَبْکِی عَلَیْہِ الأَرْضُ أَرْبَعِینَ صَبَاحًا۔","","Musannaf Ibn Abi Shaybah 36609","","","كتاب الزهد"
"36610","(۳۶۶۱۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ {وَلِمَنْ خَافَ مَقَامَ رَبِّہِ جَنَّتَانِ} قَالَ : ہُوَ الرَّجُلُ یَذْکُرُ اللَّہَ عِنْدَ الْمَعَاصِی فَیَحْتَجِزُ عنہا۔","","Musannaf Ibn Abi Shaybah 36610","","","كتاب الزهد"
"36611","(۳۶۶۱۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {یُطَافُ عَلَیْہِمْ بِآنِیَۃٍ مِنْ فِضَّۃٍ وَأَکْوَابٍ کَانَتْ قَوَارِیرَا قَوَارِیرَا مِنْ فِضَّۃٍ قَدَّرُوہَا تَقْدِیرًا} قَالَ : الآنِیَۃُ : الأَقْدَاحُ ، وَالأَکْوَابُ : الکوکَباتُ ، وَتَقْدِیرًا : أَنَّہَا لَیْسَتَ بِالْمَلأْی الَّتِی تَفِیضُ ، وَلاَ نَاقِصَۃَ الْقَدْرِ۔","","Musannaf Ibn Abi Shaybah 36611","","","كتاب الزهد"
"36612","(۳۶۶۱۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ فِی قولہ تعالی : {لِلَّذِینَ یَعْمَلُونَ السُّوئَ بِجَہَالَۃٍ ثُمَّ یَتُوبُونَ مِنْ قَرِیبٍ} قَالَ : الدُّنْیَا کُلُّہَا قَرِیبٌ ، کُلُّہَا جَہَالَۃٌ۔","","Musannaf Ibn Abi Shaybah 36612","","","كتاب الزهد"
"36613","(۳۶۶۱۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ ، عَنْ عِکْرِمَۃَ {سِیمَاہُمْ فِی وُجُوہِہِمْ} قَالَ : السَّہَرُ۔","","Musannaf Ibn Abi Shaybah 36613","","","كتاب الزهد"
"36614","(۳۶۶۱۴) حَدَّثَنَا حَکَّامُ الرَّازِیّ ، عَنْ أَبِی سِنَانٍ ، عَنْ ثَابِتٍ ، عَنْ عِکْرِمَۃَ {وَاذْکُرْ رَبَّک إذَا نَسِیتَ} قَالَ : إذَا عَصَیْت ، وَقَالَ بَعْضُہُمْ : إذَا غَضِبْت۔","","Musannaf Ibn Abi Shaybah 36614","","","كتاب الزهد"
"36615","(۳۶۶۱۵) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ {وَبَلَغَتِ الْقُلُوبُ الْحَنَاجِرَ} قَالَ : إنَّ الْقُلُوبَ لَوْ تَحَرَّکَتْ ، أَوْ زَالَتْ خَرَجَتْ نَفْسُہُ ، وَلَکِنْ إنَّمَا ہُوَ الْفَزَعُ۔","","Musannaf Ibn Abi Shaybah 36615","","","كتاب الزهد"
"36616","(۳۶۶۱۶) حَدَّثَنَا یَحْیَی بْنُ بُکَیْر ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ سِمَاکٍ عَنْ عِکْرِمَۃَ {کَمَا یَئِسَ الْکُفَّارُ مِنْ أَصْحَابِ الْقُبُورِ} قَالَ : الْکُفَّارُ إذَا دَخَلُوا الْقُبُورَ فَعَایَنُوا مَا أَعَدَّ اللَّہُ لَہُمْ مِنَ الْخِزْیِ یَئِسُوا مِنْ رَحْمَۃِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36616","","","كتاب الزهد"
"36617","(۳۶۶۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی عَمْرو بَیَّاعِ الْمُلاَء ، عَنْ عِکْرِمَۃَ {إنَّ لَدَیْنَا أَنْکَالاً} قَالَ : قُیُودًا۔","","Musannaf Ibn Abi Shaybah 36617","","","كتاب الزهد"
"36618","(۳۶۶۱۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : دَخَلْنَا عَلَی مُحَمَّدِ بْنِ سُوقَۃَ ، فَقَالَ : أُحَدِّثُکُمْ بِحَدِیثٍ لَعَلَّہُ یَنْفَعُکُمْ فَإِنَّہُ قَدْ نَفَعَنِی ، قَالَ : قَالَ لَنَا عَطَائُ بْنُ أَبِی رَبَاحٍ : یَا ابْنَ أَخِی ، إنَّ مَنْ کَانَ قَبْلَکُمْ کَانَ یَکْرَہُ فُضُولَ الْکَلاَمُ مَا عَدَا کِتَابَ اللہِ تَعَالَی أَنْ تَقْرَأَہُ ، أَوْ أَمْرًا بِمَعْرُوفٍ ، أَوْ نَہْیًا ، عَنْ مُنْکَرٍ ، وَأَنْ تَنْطِقَ بِحَاجَتِکَ فِی مَعِیشَتِکَ الَّتِی لاَ بُدَّ لَک مِنْہَا ، أَتُنْکِرُونَ أَنَّ {عَلَیْکُمْ حَافِظِینَ کِرَامًا کَاتِبِینَ} وَأَنَّ {عَنِ الْیَمِینِ وَعَنِ الشِّمَالِ قَعِیدٌ مَا یَلْفِظُ مِنْ قَوْلٍ إِلاَّ لَدَیْہِ رَقِیبٌ عَتِیدٌ} أَمَا یَسْتَحْیِیْ أَحَدُکُمْ لَوْ نَشَرَ صَحِیفَتَہُ الَّتِی أَمْلَی صَدْرَ نَہَارِہِ وَأَکْثَرَ مَا فِیہَا لَیْسَ مِنْ أَمْرِ دِینِہِ ، وَلاَ دُنْیَاہُ۔","","Musannaf Ibn Abi Shaybah 36618","","","كتاب الزهد"
"36619","(۳۶۶۱۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عِمْرَانَ ، عَنِ الرُّدینی عَنْ یَحْیَی بْنِ یَعْمَُرَ ، قَالَ : مَا ہَاجَتِ الرِّیحُ إِلاَّ بِعَذَابٍ وَرَحْمَۃٍ۔","","Musannaf Ibn Abi Shaybah 36619","","","كتاب الزهد"
"36620","(۳۶۶۲۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ شَبِیبٍ ، عَنْ مُقَاتِلِ بْنِ حَیَّانَ {أَمِ اتَّخَذَ عِنْدَ الرَّحْمَن عَہْدًا} قَالَ : الْعَہْدُ الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 36620","","","كتاب الزهد"
"36621","(۳۶۶۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ ، قَالَ : کَانَ أَہْلُ الْخَیْرِ إذَا الْتَقَوْا یُوصِی بَعْضُہُمْ بَعْضًا بِثَلاَثٍ ، وَإِذَا غَابُوا کَتَبَ بَعْضُہُمْ إِلَی بَعْضٍ بِثَلاَثٍ : مَنْ عَمِلَ لآخِرَتِہِ کَفَاہُ اللَّہُ دُنْیَاہُ ، وَمَنْ أَصْلَحَ مَا بَیْنَہُ وَبَیْنَ اللہِ کَفَاہُ اللَّہُ النَّاسَ ، وَمِنْ أَصْلَحَ سَرِیرَتَہُ أَصْلَحَ اللَّہُ عَلاَنِیَتَہُ۔","","Musannaf Ibn Abi Shaybah 36621","","","كتاب الزهد"
"36622","(۳۶۶۲۲) حَدَّثَنَا سَعِیدُ بْنُ شُرَحْبِیلَ ، عَنْ خَلاَّدِ بْنِ سُلَیْمَانَ الْحَضْرَمِیِّ ، قَالَ : سَمِعْتُ خَالِدَ بْنَ أَبِی عِمْرَانَ یَقُولُ : کَانَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ لاَ یُفْطِرُ مِنَ الشَّہْرِ إِلاَّ ثَلاَثَۃَ أَیَّامٍ ، قَالَ خَالِدُ : مَکَثَ أَرْبَعِینَ سَنَۃً لَمْ یَنْزِعْ ثَوْبَہُ ، عَنْ ظَہْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 36622","","","كتاب الزهد"
"36623","(۳۶۶۲۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ وَہِشَامٌ جَمِیعًا ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : کُنَّا عِنْدَ أَبِی عُبَیْدَۃَ بْنِ حُذَیْفَۃَ فِی قُبَّۃٍ لَہُ ، فَأَتَاہُ رَجُلٌ فَجَلَسَ مَعَہُ عَلَی فِرَاشِہِ ، فَسَارَّہُ بِشَیْئٍ لَمْ أَفْہَمْہُ ، فَقَالَ لَہُ أَبُو عُبَیْدَۃَ : فَإِنِّی أَسْأَلُک أَنْ تَضَعَ إصْبَعَک فِی ہَذِہِ النَّارِ ، وَکَانُونٌ بَیْنَ أَیْدِیہمْ فِیہِ نَارٌ ، فَقَالَ الرَّجُلُ : سُبْحَانَ اللہِ ، فَقَالَ لَہُ أَبُو عُبَیْدَۃَ : تَبْخَلُ عَلَیَّ بِإِصْبَعٍ مِنْ أَصَابِعِکَ فِی نَارِ الدُّنْیَا وَتَسْأَلُنِی أَنْ أَجْعَلَ جَسَدِی کُلَّہُ فِی نَارِ جَہَنَّمَ ، قَالَ : فَظَنَنَّا أَنَّہُ دَعَاہُ إِلَی الْقَضَائِ۔","","Musannaf Ibn Abi Shaybah 36623","","","كتاب الزهد"
"36624","(۳۶۶۲۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، أَنَّ عُبَیْدَ اللہِ بْنَ عَدِیٍّ بْنِ الْخِیَارِ ، قَالَ : اللَّہُمَّ سَلِّمْنَا وَسَلِّمَ الْمُؤْمِنِینَ مِنَّا۔","","Musannaf Ibn Abi Shaybah 36624","","","كتاب الزهد"
"36625","(۳۶۶۲۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ الْحَارِثِ یَقُولُ : الزَّبَانِیَۃُ رُؤُوسُہُمْ فِی السَّمَائِ وَأَرْجُلُہُمْ فِی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 36625","","","كتاب الزهد"
"36626","(۳۶۶۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبّ[corrupt]اسٍ {مَا یَلْفِظُ مِنْ قَوْلٍ} قَالَ : یُکْتَبُ مِنْ قَوْلِہِ الْخَیْرُ وَالشَّرُّ۔","Sahih","Musannaf Ibn Abi Shaybah 36626","","","كتاب الزهد"
"36627","(۳۶۶۲۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عِمْرَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : یُکْتَبُ مَا عَلَیْہِ وَمَالُہُ۔","","Musannaf Ibn Abi Shaybah 36627","","","كتاب الزهد"
"36628","(۳۶۶۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَوْفٍ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : قَلَّ لَیْلَۃٌ أَتَتْ عَلَیْہِمْ ہَجَعُوہَا۔","","Musannaf Ibn Abi Shaybah 36628","","","كتاب الزهد"
"36629","(۳۶۶۲۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : بَیْنَمَا رَجُلٌ رَاکِبًا عَلَی حِمَارٍ إذْ عَثَرَ بِہِ ، فَقَالَ : تَعِسْت ، فَقَالَ : صَاحِبُ الْیَمِینِ : مَا ہِیَ بِحَسَنَۃٍ فَأَکْتُبُہَا ، وَقَالَ صَاحِبُ الشِّمَالِ : مَا ہِیَ بِسَیِّئَۃٍ فَاکْتُبْہَا ، فَنُودِیَ صَاحِبُ الشِّمَالِ ، إِنَّ مَا تَرَکَ صَاحِبُ الْیَمِینِ فَاکْتُبْہُ۔","","Musannaf Ibn Abi Shaybah 36629","","","كتاب الزهد"
"36630","(۳۶۶۳۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : مَنْ عَادَی أَوْلِیَائَ اللہِ فَقَدْ آذَنَ اللَّہَ بِالْمُحَارَبَۃِ ، وَمَنْ حَالَتْ شَفَاعَتُہُ دُونَ حَدٍّ مِنْ حُدُودِ اللہِ فَقَدْ حَادَّ اللَّہَ فِی أَمْرِہِ ، وَمَنْ أَعَانَ عَلَی خُصُومَۃٍ لاَ عِلْمَ لَہُ بِہَا کَانَ فِی سَخَطِ اللہِ حَتَّی یَنْزِعَ ، وَمَنْ قَفَا مُؤْمِنًا بِمَا لاَ عِلْمَ لَہُ بِہِ وَقَفَہُ اللَّہُ فِی رَدْغَۃِ الْخَبَالِ حَتَّی یَجِیئَ مِنْہَا بِالْمَخْرَجِ ، وَمَنْ خَاصَمَ لِضَعِیفٍ حَتَّی یَثْبُتَ لَہُ حَقُّہُ ، ثَبَّتَ اللَّہُ قَدَمَیْہِ یَوْمَ تَزِلُّ الأَقْدَامُ ، وَقَالَ اللَّہُ : مَا تَرَدَّدْت فِی شَیْئٍ أُرِیدُہُ ، تَرْدَادِی فِی قَبْضِ نَفْسِ عَبْدِی الْمُؤْمِنِ یَکْرَہُ الْمَوْتَ وَأَکْرَہُ مُسَائَتَہِ وَلاَ بُدَّ لَہُ مِنْہُ۔ (بخاری ۶۵۰۲)","","Musannaf Ibn Abi Shaybah 36630","","","كتاب الزهد"
"36631","(۳۶۶۳۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدِ رَبِّہِ بْنِ زیتون ، عَنِ ابْنِ مُحَیْرِیزٍ ، أَنَّہُ قَالَ : الْکَلاَمُ فِی الْمَسْجِدِ لَغْوٌ إِلاَّ لِمُصَلٍّ ، أَوْ ذَاکِرِ رَبِّہِ ، أَوْ سَائِلِ خَیْرٍ ، أَوْ مُعْطِیہ۔","","Musannaf Ibn Abi Shaybah 36631","","","كتاب الزهد"
"36632","(۳۶۶۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ رَجَاء بْنِ أَبِی سَلَمَۃَ ، قَالَ : بَلَغَنِی ، أَنَّ ابْنَ مُحَیْرِیزٍ دَخَلَ عَلَی رَجُلٍ مِنَ الْبَزَّازِینَ فَاشْتَرَی مِنْہُ شَیْئًا ، فَقَالَ رَجُلٌ لِلْبَزَّازِ أَتَدْرِی مَنْ ہَذَا ہَذَا ابْنُ مُحَیْرِیزٍ ، فَقَامَ ، فَقَالَ : إنَّمَا جِئْنَا نَشْتَرِی بِدَرَاہِمِنَا ، لَیْسَ بِدِینِنَا۔","","Musannaf Ibn Abi Shaybah 36632","","","كتاب الزهد"
"36633","(۳۶۶۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ وُہَیْبٍ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، قَالَ : سَمِعْتُ ابْنَ مُحَیْرِیزٍ وَنَحْنُ مَعَہُ بِالرَّمْلَۃِ وَہُوَ یَقُولُ : أَدْرَکْت النَّاسَ وَإِذَا مَاتَ مِنْہُمَ الْمَیِّتُ مِنَ الْمُسْلِمِینَ ، قَالُوا : الْحَمْدُ لِلَّہِ الَّذِی تَوَفَّی فُلاَنًا عَلَی الإِسْلاَمِ ، ثُمَّ انْقَطَعَ ذَلِکَ فَلَیْسَ أَحَدٌ الْیَوْمَ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 36633","","","كتاب الزهد"
"36634","(۳۶۶۳۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُجَمِّعِ بْنِ یَحْیَی ، قَالَ : کَانَ مُجَمِّعِ بْنُ جاریۃ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک مَوْتًا سَجِیحًا۔","","Musannaf Ibn Abi Shaybah 36634","","","كتاب الزهد"
"36635","(۳۶۶۳۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ أَبِیہِ فِی قَوْلِہِ : (خَافِضَۃٌ) مَنِ انْخَفَضَ یَوْمَئِذٍ لَمْ یَرْتَفِعْ أَبَدًا ، وَمَنَ ارْتَفَعَ یَوْمَئِذٍ لَمْ یَنْخَفِضْ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 36635","","","كتاب الزهد"
"36636","(۳۶۶۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ أَوْسٍ، عَنْ عَمْرِو بْنِ أَوْسٍ، قَالَ : المحسنون الَّذِینَ لاَ یَظْلِمُونَ وَإِنْ ظُلِمُوا لَمْ یَنْتَصِرُوا۔","Hasan","Musannaf Ibn Abi Shaybah 36636","","","كتاب الزهد"
"36637","(۳۶۶۳۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عِمْرَانَ ، عَنْ أَبِی الْعَلاَئِ بْنِ الشِّخِّیرِ ، قَالَ : قَالَ فُلاَنٌ : تَمْشُونَ عَلَی قُبُورِکُمْ قُلْتُ : نَعَمْ ، قَالَ : فَکَیْفَ تُمْطَرُونَ۔","","Musannaf Ibn Abi Shaybah 36637","","","كتاب الزهد"
"36638","(۳۶۶۳۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قولہ تعالی: {فَالْتَقَمَہُ الْحُوتُ} قَالَ : لَمَّا الْتَقَمَہُ ذَہَبَ بِہِ حَتَّی وَضَعَہُ فِی الأَرْضِ السَّابِعَۃِ فَسَمِعَ الأَرْضَ تُسَبِّحُ ، قَالَ: فَہَیَّجَتْہُ عَلَی التَّسْبِیحِ ، فَقَالَ: {لاَ إلَہَ إِلاَّ أَنْتَ سُبْحَانَک إنِّی کُنْت مِنَ الظَّالِمِینَ} قَالَ: فَأَخْرَجَہُ حَتَّی أَلْقَاہُ عَلَی الأَرْضِ بِلاَ شَعْرٍ ، وَلاَ ظُفُرٍ مِثْلُ الصَّبِیِّ الْمَنْفُوسِ ، فَأَنْبَتَ اللَّہُ عَلَیْہِ شَجَرَۃً تُظِلُّہُ ، وَیَأْکُلُ مِنْ تَحْتِہَا مِنْ حَشَرَاتِ الأَرْضِ ، فَبَیْنَمَا ہُوَ نَائِمٌ تَحْتَہَا فَتَسَاقَطَتْ عَلَیْہِ وَرَقُہَا قَدْ یَبِسَتْ ، فَشَکَا ذَلِکَ إِلَی رَبِّہِ، فَقِیلَ لَہُ : أَتَحْزَنُ عَلَی شَجَرَۃٍ ، وَلاَ تَحْزَنُ عَلَی مِئَۃِ أَلْفٍ ، أَوْ یَزِیدُونَ یُعَذَّبُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 36638","","","كتاب الزهد"
"36639","(۳۶۶۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبُو ہِلاَلٍ مُحَمَّدُ بْنُ سُلَیْمٍ الرَّاسِبِیُّ ، عَنِ الْحَسَنِ قَالَ : قَالَ أَبُو الصَّہْبَائِ : طَلَبْت الْمَالَ مِنْ حِلِّہِ فَأَعْیَانِی إِلاَّ رِزْقَ یَوْمٍ بِیَوْمٍ ، فَعَلِمْت ، أَنَّہُ قَدْ خِیرَ لِی : وَایْمُ اللہِ مَا مِنْ عَبْدٍ أُوتِیَ رِزْقَ یَوْمٍ بِیَوْمٍ فَلَمْ یَظُنَّ ، أَنَّہُ قد خِیرَ لَہُ إِلاَّ کَانَ عَاجِزًا ، أَوْ غَبِیَّ الرَّأْیِ۔","Hasan","Musannaf Ibn Abi Shaybah 36639","","","كتاب الزهد"
"36640","(۳۶۶۴۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا بُکَیْر بْنُ أَبِی السُّمَیْطِ ، قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنْ عَبْدِ اللہِ بْنِ مُطَرِّفٍ ، أَنَّہُ کَانَ یَقُولُ : إنَّک لَتَلْقَی بَیْنَ الرَّجُلَیْنِ أَحَدُہُمَا أَکْثَرُ صَوْمًا وَصَلاَۃً ، وَالآخَرُ أَکْرَمُہُمَا عَلَی اللہِ بَوْنًا بَعِیدًا ، قَالُوا : وَکَیْفَ یَکُونُ ذَلِکَ یَا أَبَا جَزْئٍ ، قَالَ : یَکُونُ أَوْرَعَہُمَا فِی مَحَارِمِہِ۔","","Musannaf Ibn Abi Shaybah 36640","","","كتاب الزهد"
"36641","(۳۶۶۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی قَوْلِہِ : {وَبَشِّرَ الْمُخْبِتِینَ} قَالَ : الْمُتَوَاضِعِینَ۔","","Musannaf Ibn Abi Shaybah 36641","","","كتاب الزهد"
"36642","(۳۶۶۴۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ {وَکَانُوا لَنَا خَاشِعِینَ} قَالَ : الذِّلَّۃُ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 36642","","","كتاب الزهد"
"36643","(۳۶۶۴۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ {یُصْہَرُ بِہِ مَا فِی بُطُونِہِمْ وَالْجُلُودُ} قَالَ : یُذَابُ بِہِ۔","","Musannaf Ibn Abi Shaybah 36643","","","كتاب الزهد"
"36644","(۳۶۶۴۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ ثَابِتٍ ، عَنِ الضَّحَّاکِ {وَإِذَا مَرُّوا بِاللَّغْوِ مَرُّوا کِرَامًا} قَالَ : لَمْ یَکُنِ اللَّغْوُ مِنْ حَالِہِمْ ، وَلاَ بَالِہِمْ۔","","Musannaf Ibn Abi Shaybah 36644","","","كتاب الزهد"
"36645","(۳۶۶۴۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ الزُّبَیْرِ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لَوْلاَ تِلاَوَۃُ الْقُرْآنِ لَسَرَّنِی أَنْ أَکُونَ مَرِیضًا۔","","Musannaf Ibn Abi Shaybah 36645","","","كتاب الزهد"
"36646","(۳۶۶۴۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ {فِی مَقَامٍ أَمِینٍ} قَالَ : أَمِنُوا الْمَوْتَ أَنْ یَمُوتُوا ، وَأَمِنُوا الْہَرَمَ أَنْ یَہْرَمُوا ، وَلاَ یَجُوعُوا ، وَلاَ یَعْرَوْا۔","","Musannaf Ibn Abi Shaybah 36646","","","كتاب الزهد"
"36647","(۳۶۶۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ جُوَیْبِرٍ، عَنِ الضَّحَّاکِ {إنَّک کَادِحٌ إِلَی رَبِّکَ کَدْحًا} قَالَ: عَامِلٌ إِلَی رَبِّکَ عَمَلاً۔","","Musannaf Ibn Abi Shaybah 36647","","","كتاب الزهد"
"36648","(۳۶۶۴۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ أَبِی بِسِطَامٍ ، عَنِ الضَّحَّاکِ (لَہُمَ الْبُشْرَی فِی الْحَیَاۃِ الدُّنْیَا) قَالَ : یَعْلَمُ أَیْنَ ہُوَ قَبْلَ الْمَوْتِ۔","","Musannaf Ibn Abi Shaybah 36648","","","كتاب الزهد"
"36649","(۳۶۶۴۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حَدَّثَنَا أَبُو سِنَانٍ ، قَالَ : سَمِعْتُ الضَّحَّاکَ بْنَ مُزَاحِمٍ یَقُولُ فِی قَوْلِہِ : {فَاسْتَبِقُوا الْخَیْرَاتِ إِلَی اللہِ مَرْجِعُکُمْ} قَالَ : أُمَّۃُ مُحَمَّدٍ الْبَرُّ وَالْفَاجِرُ۔","","Musannaf Ibn Abi Shaybah 36649","","","كتاب الزهد"
"36650","(۳۶۶۵۰) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا دَاوُد بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : سَمِعْتُ أَبَا الْفَیْضِ یقول عَنِ الضَّحَّاکِ قَالَ : {إنَّمَا یَتَقَبَّلُ اللَّہُ مِنَ الْمُتَّقِینَ} قَالَ : الَّذِینَ یَتَّقُونَ الشِّرْکَ۔","","Musannaf Ibn Abi Shaybah 36650","","","كتاب الزهد"
"36651","(۳۶۶۵۱) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا دَاوُد بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، قَالَ : حَدَّثَنِی أَشْرَسُ بْنُ حَسَّانِ الْکُوفِیُّ ، قَالَ : سَمِعْتُ وَہْبَ بْنَ مُنَبِّہٍ ، قَالَ : کَانَ ہَارُونُ ہُوَ الَّذِی یُجَمِّرُ الْکَنَائِسَ۔","","Musannaf Ibn Abi Shaybah 36651","","","كتاب الزهد"
"36652","(۳۶۶۵۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، أَنَّہُ قَالَ : ما أَدْرِی مَا حَسْبُ إیمَانِ عَبْدٍ لاَ یَدَعُ شَیْئًا یَکْرَہُہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 36652","","","كتاب الزهد"
"36653","(۳۶۶۵۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ ثَابِتٍ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، قَالَ : کَانَ أَحَدُہُمْ إذَا بَرَّأَ قِیلَ لَہُ : لِیَہْنِکَ الطُّہْرُ۔","","Musannaf Ibn Abi Shaybah 36653","","","كتاب الزهد"
"36654","(۳۶۶۵۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادٌ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، أَنَّ أَبَا بَکْرٍ کَانَ یَتَمَثَّلُ ہَذَا الْبَیْتَ :nلاَ تَزَالُ تَنْعَی حَبِیبًا حَتَّی تَکُونَہُ ۔۔۔ وَقَدْ یَرْجُو الْفَتَی رَجًا یَمُوتُ دُونَہُ۔","","Musannaf Ibn Abi Shaybah 36654","","","كتاب الزهد"
"36655","(۳۶۶۵۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : مَالِکُ بْنُ دِینَارٍ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ ، قُلْتُ: قَوْلُ اللہِ تَعَالَی : {وَلَوْلاَ أَنْ ثَبَّتْنَاک لَقَدْ کِدْت تَرْکَنُ إلَیْہِمْ شَیْئًا قلِیلاً إذًا لأَذَقْنَاک ضِعْفَ الْحَیَاۃِ وَضِعْفَ الْمَمَاتِ ثُمَّ لاَ تَجِدُ لَک عَلَیْنَا نَصِیرًا} مَا ضِعْفُ الْحَیَاۃِ وَضِعْفُ الْمَمَاتِ ؟ قَالَ جَابِرٌ : ضِعْفُ عَذَابِ الدُّنْیَا وَضِعْفُ عَذَابِ الآخِرَۃِ ، ثُمَّ لاَ تَجِدُ لَک عَلَیْنَا نَصِیرًا۔","","Musannaf Ibn Abi Shaybah 36655","","","كتاب الزهد"
"36656","(۳۶۶۵۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، قَالَ سَمِعْت ثَابِتًا ، قَالَ : کُنَّا عِنْدَ جَابِرِ بْنِ زَیْدٍ فَرَأَی جَمَلاً ، فَقَالَ : لَوْ قُلْتُ لَکُمْ : إنِّی لاَ أَعْبُدُ ہَذَا الْجَمَلَ مَا أَمِنْت أَنْ أَعْبُدَہُ۔","","Musannaf Ibn Abi Shaybah 36656","","","كتاب الزهد"
"36657","(۳۶۶۵۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْد ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ ، قَالَ : مَا أَشْبَہَ الْقَوْمَ بَعْضُہُمْ بِبَعْضٍ ، مَا أَشْبَہَ اللَّیْلَۃَ بِالْبَارِحَۃِ۔","","Musannaf Ibn Abi Shaybah 36657","","","كتاب الزهد"
"36658","(۳۶۶۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَرِیرٌ ، عَنْ شُعَیْبٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : أَکْثَرُ رَیَاحِینِ الْجَنَّۃِ الْحِنَّائُ۔","","Musannaf Ibn Abi Shaybah 36658","","","كتاب الزهد"
"36659","(۳۶۶۵۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ الرَّبِیعِ بْنِ خُثَیْمٍ قَالَ : حَدَّثَنَا أَبُو عُبَیْدَۃَ بْنُ عَبْدِ اللہِ ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیْمٍ إذَا دَخَلَ عَلَی عَبْدِ اللہِ لَمْ یَکُنْ عَلَیْہِ یَوْمَئِذٍ إذْنٌ حَتَّی یَفْرُغَ کُلُّ وَاحِدٍ مِنْہُمَا مِنْ صَاحِبِہِ ، قَالَ : وَقَالَ لَہُ عَبْدُ اللہِ یَا أَبَا یَزِیدَ ، إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَوْ رَآک أَحَبَّک ، وَمَا رَأَیْتُک إِلاَّ ذَکَرْت الْمُخْبِتِینَ۔ (احمد ۴۰۸۔ ابو نعیم ۱۰۶)","","Musannaf Ibn Abi Shaybah 36659","","","كتاب الزهد"
"36660","(۳۶۶۶۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، قَالَ : قِیلَ مَنِ الَّذِی یَسْمَنُ فِی الْخِصْبِ وَالْجَدْبِ ، وَمَنَ الَّذِی یَہْزَلُ فِی الْخِصْبِ وَالْجَدْبِ ، وَمَنَ الَّذِی ہُوَ أَحْلَی مِنَ الْعَسَلِ ، وَلاَ یَنْقَطِعُ ، قَالَ : أَمَّا الَّذِی یَسْمَنُ فِی الْخِصْبِ وَالْجَدْبِ فَالْمُؤْمِنُ الَّذِی إنْ أُعْطِیَ شَکَرَ ، وَإِنَ ابْتُلِیَ صَبَرَ ، وَأَمَّا الَّذِی یَہْزَلُ فِی الْخِصْبِ وَالْجَدْبِ فَالْکَافِرُ ، أَوِ الْفَاجِرُ إنْ أُعْطِیَ لَمْ یَشْکُرْ ، وَإِنَ ابْتُلِیَ لَمْ یَصْبِرْ ، وَأَمَّا الَّذِی ہُوَ أَحْلَی مِنَ الْعَسَلِ ، وَلاَ یَنْقَطِعُ فَہِیَ أُلْفَۃُ اللہِ الَّتِی أَلَّفَ بَیْنَ قُلُوبِ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 36660","","","كتاب الزهد"
"36661","(۳۶۶۶۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَبِی ثَامِرٍ وَکَانَ رَجُلاً عَابِدًا مِمَّنْ یَغْدُو إِلَی الْمَسْجِدِ فَرَأَی فِی الْمَنَامِ کَأَنَّ النَّاسَ قَدْ عُرِضُوا عَلَی اللہِ فَجِیئَ بِامْرَأَۃٍ عَلَیْہَا ثِیَابٌ رِقَاقٌ ، فَجَائَتْ رِیحٌ فَکَشَفْت ثِیَابَہَا ، فَأَعْرَضَ اللَّہُ عنہا ، وَقَالَ : اذْہَبُوا بِہَا إِلَی النَّارِ ، فَإِنَّہَا کَانَتْ مِنَ الْمُتَبَرِّجَاتِ حَتَّی انْتَہَی الأَمْرُ إلَیَّ ، فَقَالَ : دَعُوہُ فَإِنَّہُ کَانَ یُؤَدِّی حَقَّ الْجُمُعَۃِ۔","","Musannaf Ibn Abi Shaybah 36661","","","كتاب الزهد"
"36662","(۳۶۶۶۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَبِی ثَامِرٍ زَعَمَ أَنَّ امْرَأَۃً ، قَالَتْ : وَاللہِ لاَ یُعَذِّبُنِی اللَّہُ أَبَدًا مَا سَرَقْت ، وَلاَ زَنَیْت ، وَلاَ قَتَلْت وَلَدِی ، وَلاَ أَتَیْتُ بِبُہْتَانٍ یَفْتَرِینَہُ بَیْنَ أَیْدِیہِنَّ وَأَرْجُلِہِنَ ، فَرَأَتْ فِی الْمَنَامِ ، أَنَّہُ قِیلَ لَہَا : قَوْمِی إِلَی مَقْعَدِکَ مِنَ النَّارِ یَا مُقَلِّلَۃَ الْکَثِیرِ مُکْثِرَۃَ الْقَلِیلِ ، وَآکِلَۃَ لَحْمِ الْجَارِ الْغَرِیبِ بِالْغَیْبِ ، قَالَتْ : یَا رَبِ ، بَلْ أَتُوبُ بَلْ أَتُوبُ۔","","Musannaf Ibn Abi Shaybah 36662","","","كتاب الزهد"
"36663","(۳۶۶۶۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، أَنَّ أَبَا ثَامِرٍ رَأَی فِیمَا یَرَی النَّائِمُ : وَیْلٌ لِلْمُتَسَمِّنَاتِ مِنْ فَتْرَۃٍ فِی الْعِظَامِ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 36663","","","كتاب الزهد"
"36664","(۳۶۶۶۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، أَنَّ أَبَا ثَامِرٍ کَانَ رَجُلاً عَابِدًا ، فَنَامَ ذَاتَ لَیْلَۃٍ قَبْلَ أَنْ یُصَلِّیَ الْعِشَائَ ، فَأَتَاہُ مَلَکَانِ أَوْ رَجُلاَنِ فِی مَنَامِہِ فَقَعَدَ أَحَدُہُمَا عِنْدَ رَأْسِہِ وَالآخَرُ عِنْدَ رِجْلَیْہِ ، فَقَالَ : الَّذِی عِنْدَ رَأْسِہِ لِلَّذِی عِنْدَ رِجْلَیْہِ : الصَّلاَۃُ قَبْلَ النَّوْمِ تُرْضِی الرَّحْمَن وَتُسْخِطُ الشَّیْطَانَ ، وَقَالَ الَّذِی عِنْدَ رِجْلَیْہِ لِلَّذِی عِنْدَ رَأْسِہِ : إنَّ النَّوْمَ قَبْلَ الصَّلاَۃِ یُرْضِی الشَّیْطَانَ وَیُسْخَطُ الرَّحْمَن۔","","Musannaf Ibn Abi Shaybah 36664","","","كتاب الزهد"
"36665","(۳۶۶۶۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : حَدَّثَنَا ثَابِتٌ الْبُنَانِیُّ ، عَنْ صِلَۃَ بْنِ أَشَیْمَ ، أَنَّہُ قَالَ : وَاللہِ مَا أَدْرِی بِأَیِّ یَوْمِی أَنَا أَشَدُّ فَرَحًا : یَوْمٌ أُبَاکِرُ فِیہِ إِلَی ذِکْرِ اللہِ ، أَوْ یَوْمٌ خَرَجْت فِیہِ لِبَعْضِ حَاجَتِی فَعَرَضَ لِی ذِکْرُ اللہِ۔","","Musannaf Ibn Abi Shaybah 36665","","","كتاب الزهد"
"36666","(۳۶۶۶۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ کَانَ أَبُو رِفَاعَۃَ الْعَدَوِیُّ یَقُولُ : مَا عَزَبَتْ عَنِّی سُورَۃُ الْبَقَرَۃِ مُنْذُ عَلَّمَنِیہَا رَسُولُ اللہِ أَخَذْتُ مَعَہَا مَا أَخَذْتُ مِنَ الْقُرْآنِ ، وَمَا أَنْ وُجِعْت ظَہْرِی مِنْ قِیَامِ لَیْلٍ قَطُّ۔","Sahih","Musannaf Ibn Abi Shaybah 36666","","","كتاب الزهد"
"36667","(۳۶۶۶۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ عَنْ حُمَیْدُ بْنُ ہِلاَلٍ ، قَالَ : قَالَ صِلَۃٌ رَأَیْتُ أَبَا رِفَاعَۃَ بَعْدَ مَا أُصِیبَ فِی النَّوْمِ عَلَی نَاقَۃٍ سَرِیعَۃٍ وَأَنَا عَلَی جَمَلٍ ثِقَالَ قَطُوفٍ ، وَأَنَا أَجِدُ عَلَی أَثَرِہِ ، قَالَ : فَیُعَرِّجُہَا عَلَیَّ فَأَقُولُ الآن أُسْمِعْہُ الصَّوْتَ فَیُسَرِّحُہَا وَأَنَا أَتْبَعُ أَثَرَہَا ، فَأُوِّلَتْ رُؤْیَایَ أَنْ آخُذَ طَرِیقَ أَبِی رِفَاعَۃَ فَأَنَا أَکُدُّ بَعْدَہُ الْعَمَلَ کَدًّا۔","","Musannaf Ibn Abi Shaybah 36667","","","كتاب الزهد"
"36668","(۳۶۶۶۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، قَالَ : حَدَّثَنَا حُمَیْدُ بْنُ ہِلاَلٍ ، قَالَ کَانَ أَبُو رِفَاعَۃَ ، أَوْ رَجُلٌ مِنْہُمْ یُسَخِّنُ فِی السَّفَرِ لأَصْحَابِہِ الْمَائَ وَیَعْمِدُ إِلَی الْبَارِدِ فَیَتَوَضَّأُ بِہِ ، ثُمَّ یَقُولُ : أَحسّوا مِنْ ہَذَا ، فَسَأحس مِنْ ہَذَا۔","Hasan","Musannaf Ibn Abi Shaybah 36668","","","كتاب الزهد"
"36669","(۳۶۶۶۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ ، قَالَ : قَالَ ثَابِتٌ ، قَالَ مُطَرِّفٌ : إنْ کَانَ أَحَدٌ مِنْ ہَذِہِ الأُمَّۃِ مُمْتَحَنَ الْقَلْبِ لَقَدْ کَانَ مَذْعُورٌ لَمُمْتَحَنَ الْقَلْبِ۔","","Musannaf Ibn Abi Shaybah 36669","","","كتاب الزهد"
"36670","(۳۶۶۷۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سُلَیْمَانُ ، عَنْ ثَابِتٍ ، قَالَ : قَالَ مُطَرِّفٌ : رَآنِی أَنَا وَمَذْعُورًا رَجُلٌ ، فَقَالَ : مَنْ سَرَّہُ أَنْ یَنْظُرَ إِلَی رَجُلَیْنِ مِنْ أَہْلِ الْجَنَّۃِ فَلْیَنْظُرْ إِلَی ہَذَیْنِ ، فَسَمِعَہَا مَذْعُورٌ فَرَأَیْتُ الْکَرَاہِیَۃَ فِی وَجْہِہِ ، ثُمَّ قَالَ : اللَّہُمَّ إنَّک تَعْلَمُنَا وَلاَ یَعْلَمُنَا۔","","Musannaf Ibn Abi Shaybah 36670","","","كتاب الزهد"
"36671","(۳۶۶۷۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ شُعَیب أَبِی زِیَادٍ ، عَنْ أَبِی رَجَائٍ ، قَالَ : کَانَ ہَذَا الْمَکَانُ مِنَ ابْنِ عَبَّاسٍ مَجْرَی الدُّمُوعِ مِثْلُ الشِّرَاکِ الْبَالِی مِنَ الدُّمُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 36671","","","كتاب الزهد"
"36672","(۳۶۶۷۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الأَعْمَشِ ، عَنْ شِمْرِ بْنِ عَطِیَّۃَ ، عَنْ مُغِیرَۃَ بْنِ سَعْدِ بْنِ الأَخْرَمِ ، قَالَ : مَا خَرَجَ عَبْدُ اللہِ إِلَی السُّوقِ فَمَرَّ عَلَی الْحَدَّادِینَ فَرَأَی مَا یُخْرِجُونَ مِنَ النَّارِ إِلاَّ جَعَلَتْ عَیْنَاہُ تَسِیلاَنِ۔","","Musannaf Ibn Abi Shaybah 36672","","","كتاب الزهد"
"36673","(۳۶۶۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ أَبِی صَالِحٍ، قَالَ: لَمَّا قَدِمَ أَہْلُ الْیَمَنِ فِی زَمَانِ أَبِی بَکْرٍ فَسَمِعُوا الْقُرْآنَ جَعَلُوا یَبْکُونَ ، فَقَالَ أَبُو بَکْرٍ : ہَکَذَا کُنَّا ، ثُمَّ قَسَتِ الْقُلُوبُ۔","","Musannaf Ibn Abi Shaybah 36673","","","كتاب الزهد"
"36674","(۳۶۶۷۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی أَبِی أُسَیْدَ ، قَالَ : کَانَ عُمَرُ إذَا صَلَّی أَخْرَجَ النَّاسَ مِنَ الْمَسْجِدِ فَأَخَذَ إلَیْنَا ، فَلَمَّا رَأَی أَصْحَابَہُ أَلْقَی الدِّرَّۃَ وَجَلَسَ ، فَقَالَ : ادْعُوا ، فَدَعَوْا ، قَالَ : فَجَعَلَ یَدْعُو وَیَدْعُو حَتَّی انْتَہَتِ الدَّعْوَۃُ إلَی ، فَدَعَوْت وَأَنَا مَمْلُوک ، فَرَأَیْتہ دَعَا وَبَکَی بُکَائً لاَ تَبْکِیہ الثَّکْلَی ، فَقُلْتُ فِی نَفْسِی : ہَذَا الَّذِی تَقُولُونَ کم ہو غَلِیظٌ۔","Hasan","Musannaf Ibn Abi Shaybah 36674","","","كتاب الزهد"
"36675","(۳۶۶۷۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَبِی دَاوُدَ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، قَالَ : عَلَیْکُمْ بِالسَّبِیلِ وَالسُّنَّۃِ ، فَإِنَّہُ لَیْسَ مِنْ عَبْدٍ عَلَی سَبِیلٍ وَسُنَّۃٍ ذَکَرَ الرَّحْمَن فَفَاضَتْ عَیْنَاہُ مِنْ خَشْیَۃِ اللہِ فَمَسَّتْہُ النَّارُ أَبَدًا، وَلَیْسَ مِنْ عَبْدٍ عَلَی سَبِیلٍ وَسُنَّۃٍ ذَکَرَ اللَّہَ فَاقْشَعَرَّ جِلْدُہُ مِنْ خَشْیَۃِ اللہِ إِلاَّ کَانَ مَثَلُہُ کَمَثَلِ شَجَرَۃٍ یَبِسَ وَرِقُہَا فَہِیَ کَذَلِکَ إذْ أَصَابَتْہَا رِیحٌ فَتَحَاتَّ وَرَقُہَا عنہا إِلاَّ تَحَاتَّتْ خَطَایَاہُ کَمَا یَتَحَاتُّ عن ہَذِہِ الشَّجَرَۃِ وَرِقُہَا ، وَإِنَّ اقْتِصَادًا فِی سُنَّۃٍ وَسَبِیلٍ خَیْرٌ مِنِ اجْتِہَادٍ فِی غَیْرِ سُنَّۃٍ وَسَبِیلٍ ، فَانْظُرُوا أَعْمَالَکُمْ ، فَإِنْ کَانَتِ اقْتِصَادًا وَاجْتِہَادًا أَنْ تَکُونَ عَلَی مِنْہَاجِ الأَنْبِیَائِ وَسُنَّتِہِمْ۔ (ابو نعیم ۲۵۲)","Da'if","Musannaf Ibn Abi Shaybah 36675","","","كتاب الزهد"
"36676","(۳۶۶۷۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدِ بْنِ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ نَشِیجَ عُمَرَ وَأَنَا فِی آخِرِ الصَّفِّ وَہُوَ یَقْرَأُ سُورَۃَ یُوسُفَ : {إنَّمَا أَشْکُو بَثِّی وَحُزْنِی إِلَی اللہِ}۔","Sahih","Musannaf Ibn Abi Shaybah 36676","","","كتاب الزهد"
"36677","(۳۶۶۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ أنَّ ابْنَ عُمَرَ قَرَأَ : {وَإِنْ تُبْدُوا مَا فِی أَنْفُسِکُمْ ، أَوْ تُخْفُوہُ یُحَاسِبْکُمْ بِہِ اللَّہُ} الآیَۃُ فَدَمَعَتْ عَیْنَاہُ فَبَلَغَ صَنِیعُہُ ابْنَ عَبَّاسٍ ، فَقَالَ : یَرْحَمُ اللَّہُ أَبَا عَبْدِ الرَّحْمَنِ ، لَقَدْ صَنَعَ کَمَا صَنَعَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِین أُنْزِلَتْ ، فَنَسَخَتْہَا الآیَۃُ الَّتِی بَعْدَہَا {لَہَا مَا کَسَبَتْ وَعَلَیْہَا مَا اکْتَسَبَتْ}۔","Da'if","Musannaf Ibn Abi Shaybah 36677","","","كتاب الزهد"
"36678","(۳۶۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَرْفَجَۃَ السُّلَمِیِّ قَالَ : قَالَ أَبُو بَکْرٍ : ابکو وَإِنْ لَمْ تَبْکُوا فَتَبَاکَوْا۔","Da'if","Musannaf Ibn Abi Shaybah 36678","","","كتاب الزهد"
"36679","(۳۶۶۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی مُلَیْکَۃَ ، قَالَ : أَخْبَرَنِی عَلْقَمَۃُ بْنُ وَقَّاصٍ ، قَالَ : کَانَ عُمَرُ یَقْرَأُ فِی صَلاَۃِ عِشَائِ الآخِرَۃِ بِسُورَۃِ یُوسُفَ وَأَنَا فِی مُؤَخِّرِ الصُّفُوفِ حَتَّی إذَا ذُکِرَ یُوسُفُ سَمِعْت نَشِیجَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 36679","","","كتاب الزهد"
"36680","(۳۶۶۸۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنِ الْمِنْہَالِ ، عَنْ شَقِیقِ بْنِ سَلَمَۃَ ، قَالَ : دَخَلْنَا عَلَی خَبَّابٍ نَعُودُہُ ، فَقَالَ فِی ہَذَا التَّابُوتِ ، ثَمَانُونَ أَلْفًا مَا شَدَدْتہَا بِخَیْطٍ ، وَلاَ مَنَعْتہَا مِنْ سَائِلٍ ، فَقَالُوا : عَلاَمَ تَبْکِی ، قَالَ مَضَی أَصْحَابِی وَلَمْ تُنْقِصْہُمُ الدُّنْیَا شَیْئًا وَبَقِینَا حَتَّی مَا نَجِدُ لَہَا مَوْضِعًا إِلاَّ التُّرَابَ۔","Sahih","Musannaf Ibn Abi Shaybah 36680","","","كتاب الزهد"
"36681","(۳۶۶۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ عَبْدِ اللہِ بْنِ عُبَیْدَۃَ ، قَالَ : رَأَتْ صَفِیَّۃُ زَوْجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَوْمًا قَرَؤُوا سَجْدَۃً فَسَجَدُوا ، فَنَادَتْہُمْ : ہَذَا السُّجُودُ وَالدُّعَائُ فَأَیْنَ الْبُکَائُ۔","Da'if","Musannaf Ibn Abi Shaybah 36681","","","كتاب الزهد"
"36682","(۳۶۶۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ دَاوُدَ اللَّیْثِیِّ ، قَالَ : حدَّثَنَا الْبَخْتَرِیُّ بْنُ زَیْدِ بْنِ خَارِجَۃَ ، أَنَّ رَجُلاً مِنَ الْعُبَّادِ مَرَّ عَلَی کُورِ حَدَّادٍ مَکْشُوفٍ ، فَقَامَ یَنْظُرُ إلَیْہِ فَمَکَثَ مَا شَائَ اللَّہُ أَنْ یَمْکُثَ ، ثُمَّ شَہِقَ شَہْقَۃً فَمَاتَ۔","","Musannaf Ibn Abi Shaybah 36682","","","كتاب الزهد"
"36683","(۳۶۶۸۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : رَأَیْتُ عَبْدَ اللہِ بْنَ عَمْرٍو وَہُوَ یَبْکِی فَنَظَرْت إلَیْہِ ، فَقَالَ : أَتَعْجَبُ أَبْکوا مِنْ خَشْیَۃِ اللہِ ، فَإِنْ لَمْ تَبْکُوا فَتَبَاکُوا حَتَّی یَقُولَ أَحَدُکُمْ : ایہْ ، ایہْ ، إنَّ ہَذَا الْقَمَرَ لَیَبْکِی مِنْ خَشْیَۃِ اللہِ تَعَالَی۔","Da'if","Musannaf Ibn Abi Shaybah 36683","","","كتاب الزهد"
"36684","(۳۶۶۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی عَلْقَمَۃُ بْنُ مَرْثَدٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : لَوْ عُدِلَ بُکَائُ أَہْلِ الأَرْضِ بِبُکَائِ دَاوُد مَا عَدَلَہُ ، وَلَوْ عُدِلَ بُکَائُ دَاوُد وَبُکَائُ أَہْلِ الأَرْضِ بِبُکَائِ آدَمَ حِینَ أُہْبِطَ إِلَی الأَرْضِ مَا عَدَلَہُ۔","","Musannaf Ibn Abi Shaybah 36684","","","كتاب الزهد"
"36685","(۳۶۶۸۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ أَبُو صَالِحٍ یَؤُمُّنَا ، فَکَانَ لاَ یُجِیزُ الْقِرَائَۃَ مِنَ الرِّقَّۃِ۔","","Musannaf Ibn Abi Shaybah 36685","","","كتاب الزهد"
"36686","(۳۶۶۸۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ قَالَ : حدَّثَنِی فُلاَنٌ : قَالَ : أَتَیْتُ رَبِیعَۃَ وَہُوَ یَبْکِی عَلَی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 36686","","","كتاب الزهد"
"36687","(۳۶۶۸۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ ، أَنَّہُ کَانَ إذَا قَرَأَ ہَذِہِ الآیَۃَ بَکَی حَتَّی أَرَی أَنَّ قَصَصَ زُورِہِ سَیَنْدَقُّ : {وَسَیَعْلَمُ الَّذِینَ ظَلَمُوا أَیَّ مُنْقَلَبٍ یَنْقَلِبُونَ}۔","","Musannaf Ibn Abi Shaybah 36687","","","كتاب الزهد"
"36688","(۳۶۶۸۸) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أُمِّہِ وَکَانَتْ تَسْحَقُ الْکُحْلَ لِعَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّہُ کَانَ یُطْفِئُ السِّرَاجَ وَیَبْکِی حَتَّی رُسِعَتْ عَیْنَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 36688","","","كتاب الزهد"
"36689","(۳۶۶۸۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اقْرَأْ عَلَیَّ الْقُرْآنَ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ أَقْرَأُ عَلَیْک وَعَلَیْک أُنْزِلَ ، قَالَ: إنِّی أَشْتَہِی أَنْ أَسْمَعَہُ مِنْ غَیْرِی ، قَالَ: فَقَرَأْت النِّسَائَ حَتَّی إذَا بَلَغْت : {فَکَیْفَ إذَا جِئْنَا مِنْ کُلِّ أُمَّۃٍ بِشَہِیدٍ وَجِئْنَا بِکَ عَلَی ہَؤُلاَئِ شَہِیدًا} رَفَعْت رَأْسِی، أَوْ غَمَزَنِی رَجُلٌ إِلَی جَنْبِی فَرَأَیْتُ دُمُوعَہُ تَسِیلُ۔","Sahih","Musannaf Ibn Abi Shaybah 36689","","","كتاب الزهد"
"36690","(۳۶۶۹۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ عَبْدِ اللہِ رَفَعَہُ بِنَحْوٍ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 36690","","","كتاب الزهد"
"36691","(۳۶۶۹۱) حَدَّثَنَا مُحَاضِرٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : لَقَدْ أَدْرَکْت سِتِّینَ مِنْ أَصْحَابِ عَبْدِ اللہِ فِی مَسْجِدِنَا ہَذَا أَصْغَرُہُمَ الْحَارِثُ بْنُ سُوَیْد وَسَمِعْتہ یَقْرَأُ : {إذَا زُلْزِلَتْ} حَتَّی بَلَغَ {فَمَنْ یَعْمَلْ مِثْقَالَ ذَرَّۃٍ خَیْرًا یَرَہُ} قَالَ : فَبَکی ، ثُمَّ قَالَ : إنْ ہَذَا لإحْصَاء شَدِیدٌ۔","","Musannaf Ibn Abi Shaybah 36691","","","كتاب الزهد"
"36692","(۳۶۶۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَلاَّمُ بْنُ مِسْکِینٍ ، قَالَ : حَدَّثَنَا الْحَسَنُ ، قَالَ : مَرَّ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ یَقْرَأُ آیَۃً وَیَبْکِی وَیُرَدِّدُہَا ، قَالَ : فَقَالَ : أَلَمْ تَسْمَعُوا إِلَی قَوْلِ اللہِ تَعَالَی : {وَرَتِّلِ الْقُرْآنَ تَرْتِیلاً} قَالَ : ہَذَا التَّرْتِیلُ۔","Hasan","Musannaf Ibn Abi Shaybah 36692","","","كتاب الزهد"
"36693","(۳۶۶۹۳) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ الْعُقَیْلِیِّ ، قَالَ : سَمِعْتُ کَعْبًا یَقُولُ : لأَنْ أَبْکِی مِنْ خَشْیَۃِ اللہِ تَعَالَی حَتَّی یَسِیلَ دمعِی عَلَی وَجْنَتِی أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِوَزْنِی ذَہَبًا وَالَّذِی نَفْسُ کَعْبٍ بِیَدِہِ مَا مِنْ عَبْدٍ مُسْلِمٍ یَبْکِی مِنْ خَشْیَۃِ اللہِ حَتَّی تَقْطُرَ قَطْرَۃً مِنْ دُمُوعِہِ إلی الأَرْضِ فَتَمَسُّہُ النَّارُ أَبَدًا حَتَّی یَعُودَ قَطْرُ السَّمَائِ الَّذِی وَقَعَ إِلَی الأَرْضِ مِنْ حَیْثُ جَائَ وَلَنْ یَعُودَ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 36693","","","كتاب الزهد"
"36694","(۳۶۶۹۴) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، قَالَ سَمِعْت مُحَمَّدًا یَقُولُ : کَانَ الرَّجُلُ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَأْتِی عَلَیْہِ الثَّلاَثَۃُ الأَیَّامُ لاَ یَجِدُ شَیْئًا یَأْکُلُہُ فَیَجِدُ الْجِلْدَۃَ فَیَشْوِیہَا فَیَجْتَزِئُ بِہَا ، وَإِذَا لَمْ یَجِدْ شَیْئًا عَمَدَ إِلَی حَجَرٍ فَشَدَّ بِہِ بَطْنَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 36694","","","كتاب الزهد"
"36695","(۳۶۶۹۵) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ، قَالَ: حدَّثَنَا عَوْفٌ، عَنْ أَبِی الْوَرْدِ بْنِ ثُمَامَۃَ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ، قَالَ: کَانَ فِی بَنِی إسْرَائِیلَ رِجَالٌ أَحْدَاثُ الأَسْنَانِ مَغْمُورُونَ فِیہِمْ ، قَدْ قَرَؤُوا الْکِتَابَ وَعَلِمُوا عِلْمًا ، وَإِنَّہُمْ طَلَبُوا بِقِرَائَتِہِمَ الشَّرَفَ وَالْمَالَ، وَإِنَّہُمَ ابْتَدَعُوا بِدَعًا أَخَذُوا بِہَا الشَّرَفَ وَالْمَالَ فِی الدُّنْیَا فَضَلُّوا وَأَضَلُّوا کَثِیرًا۔","","Musannaf Ibn Abi Shaybah 36695","","","كتاب الزهد"
"36696","(۳۶۶۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یَحْیَی بْنِ الْمُہَلَّبِ ، عَنْ خَالِدِ بْنِ صَالِحٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ ، إنَّ الْقَلْبَ یَرْبُدُ کَمَا یَرْبُدُ الْحَدِیدُ ، قِیلَ : وَمَا جَلاَؤُہُ ، قَالَ : یُذْکَرُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 36696","","","كتاب الزهد"
"36697","(۳۶۶۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ لأَیُّوبَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَوَانِ فَجَائَا جمیعا فَلَمْ یَسْتَطِیعَا أن یَدْنُوَا منہ مِنْ رِیحِہِ ، فَقَالَ : أَحَدُہُمَا لِلآخَرِ : لَوْ کَانَ اللَّہُ عَلِمَ لأَیُّوبَ خَیْرًا مَا بَلَغَ بِہِ ہَذَا ، فَجَزَعَ أَیُّوبُ مِنْ قَوْلِہِمَا جَزَعًا شَدِیدًا لَمْ یَجْزَعْہُ مِنْ شَیْئٍ قَطُّ ، فَقَالَ أَیُّوبُ : اللَّہُمَّ إنْ کُنْت تَعْلَمُ أَنِّی لَمْ أَبِتْ لَیْلَۃً قَطُّ شِبَعًا وَأَنَا أَعْلَمُ مَکَانَ جَائِعٍ فَصَدِّقْنِی ، فَصُدِّقَ وَہُمَا یَسْمَعَانِ ، ثُمَّ قَالَ : اللَّہُمَّ إنْ کُنْت تَعْلَمُ أَنِّی لَمْ أَلْبَسْ قَمِیصًا قَطُّ وَأَنَا أَعْلَمُ مَکَانَ عَارٍ فَصَدِّقْنِی فَصُدِّقَ وَہُمَا یَسْمَعَانِ، ثُمَّ خَرَّ سَاجِدًا ، ثُمَّ قَالَ : اللَّہُمَّ إنِّی لاَ أَرْفَعُ رَأْسِی حَتَّی تَکْشِفَ عَنِّی ، قَالَ : فَمَا رَفَعَ رَأْسَہُ حَتَّی کَشَفَ اللَّہُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 36697","","","كتاب الزهد"
"36698","(۳۶۶۹۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ قَالَ : حدِّثْت ، أَنَّ عِیسَی ابْنَ مَرْیَمَ علیہما السلام کَانَ یَقُولُ : إذَا تَصَدَّقَ أَحَدُکُمْ فَلِیُعْطِ بِیَمِینِہِ وَلِیُخْفِ مِنْ شِمَالِہِ ، وَإِذَا کَانَ یَوْمُ صَوْمِ أحَدِکُمْ فَلْیَدَّہِنْ وَلْیَمْسَحْ شَفَتَیْہِ مِنْ دُہْنِہِ حَتَّی یَنْظُرَ إلَیْہِ النَّاظِرُ فَلاَ یَرَی أَنَّہُ صَائِمٌ ، وَإِذَا صَلَّی فِی بَیْتِہِ فَلْیَتَّخِذ عَلَیْہِ سُتْرَۃً فَإِنَّہُ یَقْسِمُ الثَّنَائَ کَمَا یَقْسِمُ الرِّزْقَ۔","","Musannaf Ibn Abi Shaybah 36698","","","كتاب الزهد"
"36699","(۳۶۶۹۹) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ بْنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، عَنْ نُسَیْرِ بْنِ ذُعْلُوقٍ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ مَسْعُودٍ إذَا رَأَی الرَّبِیعَ بْنَ خُثَیْمٍ مُقْبِلاً ، قَالَ : {بَشِّرَ الْمُخْبِتِینَ} أَمَّا وَاللہِ لَوْ رَآک رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَحَبَّک۔","","Musannaf Ibn Abi Shaybah 36699","","","كتاب الزهد"
"36700","(۳۶۷۰۰) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ بْنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، قَالَ : جَائَتْ بِنْتُ الرَّبِیعِ بْنِ خُثَیْمٍ ، وَعِنْدَہُ أَصْحَابٌ لَہُ ، فَقَالَتْ : یَا أَبَتَاہُ أَذْہَبُ أَلْعَبُ ، قَالَ : لاَ ، فَقَالَ لَہُ أَصْحَابُہُ : یَا أَبَا یَزِیدَ ، اتْرُکْہَا ، قَالَ : لاَ یُوجَدُ فِی صَحِیفَتِی أَنِّی قُلْتُ لَہَا : اذْہَبِی الْعَبِی ، لَکِنَ اذْہَبِی فَقَوْلِی خَیْرًا وَافْعَلِی خَیْرًا۔","","Musannaf Ibn Abi Shaybah 36700","","","كتاب الزهد"
"36701","(۳۶۷۰۱) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ یَقُولُ : یَا بَکْرُ بْنُ مَاعِزٍ یَا بَکْرُ اخْزُنْ عَلَیْک لِسَانَک إِلاَّ مِمَّا لَک ، وَلاَ عَلَیْک ، إِنِّی اتَّہَمْت النَّاسَ فِی دِینِی ، أَطِعَ اللَّہَ فِیمَا عَلِمْت ، وَمَا اسْتُؤْثِرَ بِہِ عَلَیْک فَکِلْہُ إِلَی عَالمِہِ ، لأَنَّا فِی الْعَمْدِ أَخْوَفُ مِنِّی عَلَیْکُمْ فِی الْخَطَأ ، مَا خَیْرُکُمَ الْیَوْمَ بِخَیْرِہِ ، وَلَکِنَّہُ خَیْرٌ مِنْ آخِرِ شَرٍّ مِنْہُ ، مَا کُلُّ مَا أَنْزَلَ اللَّہُ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَدْرَکْتُمْ ، وَلاَ کُلُّ مَا تَقْرَؤُونَ تَدْرُونَ مَا ہُوَ ، السَّرَائِرُ الَّتِی یخفینَ مِنَ النَّاسِ وَہُنَّ لِلَّہِ بَوَادٍ ، الْتَمِسُوا دَوَائَہَا ، ثُمَّ یَقُولُ لِنَفْسِہِ : وَمَا دَوَائَہَا أَنْ تَتُوبَ إِلَی اللہِ ، ثُمَّ لاَ تَعُودَ۔","","Musannaf Ibn Abi Shaybah 36701","","","كتاب الزهد"
"36702","(۳۶۷۰۲) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرِ بْنِ ذُعْلُوقٍ ، عَنْ بَکْرٍ ، قَالَ : لَمَّا انْتَہَی الرَّبِیعُ بْنُ خُثَیْمٍ إِلَی مَسْجِدِ قَوْمِہِ ، قَالُوا : لَہُ : یَا رَبِیعُ ، لَوْ قَعَدْت فَحَدِّثْنَا الْیَوْمَ ، قَالَ : فَقَعَدَ فَجَائَ حَجَرٌ فَشَجَّہُ ، فَقَالَ : {فَمَنْ جَائَہُ مَوْعِظَۃٌ مِنْ رَبِّہِ فَانْتَہَی فَلَہُ مَا سَلَفَ}۔","","Musannaf Ibn Abi Shaybah 36702","","","كتاب الزهد"
"36703","(۳۶۷۰۳) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیْمٍ یَقُولُ : لاَ خَیْرَ فِی الْکَلاَمُ إِلاَّ فِی تِسْعٍ : تَہْلِیلُ اللہِ وَتَسْبِیحُ اللہِ وَتَکْبِیرُ اللہِ وَتَحْمِیدُ اللہِ وَسُؤَالُک الْخَیْرَ وَتَعَوُّذُک مِنَ الشَّرِّ وَأَمْرُک بِالْمَعْرُوفِ وَنَہْیُک ، عَنِ الْمُنْکَرِ وَقِرَائَتُک الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 36703","","","كتاب الزهد"
"36704","(۳۶۷۰۴) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ إذَا قِیلَ لَہُ : کَیْفَ أَصْبَحْت یَا أَبَا یَزِیدَ ، یَقُولُ : أَصْبَحْنَا ضُعَفَائَ مُذْنِبِینَ نَأْکُلُ أَرْزَاقَنَا وَنَنْتَظِرُ آجَالَنَا۔","","Musannaf Ibn Abi Shaybah 36704","","","كتاب الزهد"
"36705","(۳۶۷۰۵) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : قَالَ ابْنُ الْکَوَّائِ لِرَبِیعِ بْنِ خُثَیْمٍ : مَا نَرَاک تَذُمُّ أَحَدًا ، وَلاَ تَعِیبُہُ ، قَالَ : وَیْلَک یَا ابْنَ الْکَوَّائِ ، مَا أَنَا عَنْ نَفْسِی بِرَاضٍ فَأَتَفَرَّغُ مِنْ ذَمِّی إِلَی ذَمِّ النَّاسِ ، إنَّ النَّاسَ خَافُوا اللَّہَ عَلَی ذُنُوبِ الْعِبَادِ وَأَمِنُوا عَلَی ذُنُوبِہِمْ۔","","Musannaf Ibn Abi Shaybah 36705","","","كتاب الزهد"
"36706","(۳۶۷۰۶) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ یَقُولُ : النَّاسُ رَجُلاَنِ : مؤمن ، وجاہل ، فأما المؤمن ؛ فلا تؤذہ ، وأما الجاہل ؛ فلا تجاہلہ۔","","Musannaf Ibn Abi Shaybah 36706","","","كتاب الزهد"
"36707","(۳۶۷۰۷) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ إذَا قِیلَ لَہُ : أَلاَ تُدَاوِی ، قَالَ : قَدْ أَرَدْت ذَلِکَ ، ثُمَّ ذَکَرْت عَادًا وَثُمَّودَ وَأَصْحَابَ الرَّسِّ وَقُرُونًا بَیْنَ ذَلِکَ کَثِیرًا ، فَعَرَفْت أنَّہُ قَدْ کَانَتْ فِیہِمْ أَوْجَاعٌ وَلَہُمْ أَطِبَّائُ فَمَاتَ الْمُدَاوِی وَالْمُدَاوَی۔","","Musannaf Ibn Abi Shaybah 36707","","","كتاب الزهد"
"36708","(۳۶۷۰۸) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ یَقُولُ إذَا أَصْبَحَ : اعْمَلُوا خَیْرًا وَقُولُوا خَیْرًا وَدُومُوا عَلَی صَالِحٍ ، وَإِذَا أَسَأْتُمْ فَتُوبُوا وَإِذَا أَحْسَنْتُمْ فَزِیدُوا ، مَا عَلِمْتُمْ فَأَقِیمُوا ، وَمَا شَکَکْتُمْ فَکِلُوہُ إِلَی اللہِ ، الْمُؤْمِنُ فَلاَ تُؤْذُوہُ ، وَالْجَاہِلُ فَلاَ تَجَاہَلُوہُ ، وَلاَ یَطُلْ عَلَیْکُمَ الأَمَدُ فَتَقْسُوا قُلُوبُکُمْ ، وَلاَ تَکُونُوا کَالَّذِینَ ، قَالُوا : سَمِعْنَا وَہُمْ لاَ یَسْمَعُونَ۔","","Musannaf Ibn Abi Shaybah 36708","","","كتاب الزهد"
"36709","(۳۶۷۰۹) حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ اللہِ ، عَنْ نُسَیْرٍ ، عَنْ بَکْرٍ ، قَالَ : کَانَ الرَّبِیعُ یَقُولُ : أَکْثِرُوا ذِکْرَ ہَذَا الْمَوْتِ الَّذِی لَمْ تَذُوقُوا قَبْلَہُ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 36709","","","كتاب الزهد"
"36710","(۳۶۷۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عُمَیْرِ بْنِ إِسْحَاقَ ، قَالَ : أَدْرَکْت مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَکْثَرَ مِمَّنْ سَبَقَنِی مِنْہُمْ ، فَلَمْ أَرَ قَوْمًا أَہْوَنَ سِیرَۃً ، وَلاَ أَقَلَّ تَشْدِیدًا مِنْہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 36710","","","كتاب الزهد"
"36711","(۳۶۷۱۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا مَالَتِ الأَفْیَائُ وَرَاحَتِ الأَرْوَاحُ فَاطْلُبُوا الْحَوَائِجَ إِلَی اللہِ فَإِنَّہَا سَاعَۃُ الأَوَّابِینَ وَقَرَأَ : {فَإِنَّہُ کَانَ لِلأَوَّابِینَ غَفُورًا}۔","Da'if","Musannaf Ibn Abi Shaybah 36711","","","كتاب الزهد"
"36712","(۳۶۷۱۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أُکَیْلَ ، قَالَ : کَانَ بَیْنَ رَجُلٍ مِنَ الْحَیِّ وَبَیْنَ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ شَیْئٌ، فَقَالَ لَہُ عَلْقَمَۃُ: أَکُنْت تَسُبُّنِی لَوْ سَبَبْتُک، قَالَ: لاَ۔ قَالَ: ہُوَ خَیْرٌ مِنِّی، ہُوَ أَکْثَرُ جِہَادًا مِنِّی۔","","Musannaf Ibn Abi Shaybah 36712","","","كتاب الزهد"
"36713","(۳۶۷۱۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، قَالَ : کَانَ لأَبِی وَائِلٍ خُصٌّ یَکُونُ فِیہِ وَدَابَّتُہُ ، فَإِذَا أَرَادَ الْغَزْوَ نَقَضَ الْخُصَّ ، وَإِذَا رَجَعَ بَنَاہُ۔","","Musannaf Ibn Abi Shaybah 36713","","","كتاب الزهد"
"36714","(۳۶۷۱۴) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ عَمْرِو بْنِ مَالِکٍ ، عَنْ أَبِی الْجَوْزَائِ : {إنَّ جَہَنَّمَ کَانَتْ مِرْصَادًا} قَالَ : صَارَتْ۔","","Musannaf Ibn Abi Shaybah 36714","","","كتاب الزهد"
"36715","(۳۶۷۱۵) حَدَّثَنَا سَعِیدُ بْنُ خُثَیْمٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْنَا عَلَی سُوَیْد ، یَعْنِی ابْنَ مَثْعَبَۃَ وَہُوَ یَشْتَکِی ، فَقُلْنَا لَہُ : کَیْفَ تَجِدُک ؟ فَقَالَ : إنِّی لَفِی عَافِیَۃٍ مِنْ رَبِّی۔","","Musannaf Ibn Abi Shaybah 36715","","","كتاب الزهد"
"36716","(۳۶۷۱۶) حَدَّثَنَا مُحَاضِرٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : مَا مِنْ شَجَرَۃٍ صَغِیرَۃٍ ، وَلاَ کَبِیرَۃٍ ، وَلاَ مُغْرز إِبِرَۃٍ رَطْبَۃٍ ، وَلاَ یَابِسَۃٍ إِلاَّ مَلَکٌ مُوَکَّلٌ بِہَا یَأْتِی اللَّہَ بِعَمَلِہَا کُلَّ یَوْمٍ بِرُطُوبَتِہَا إذَا رَطُبَتْ ، وَیُبُوسَتِہَا إذَا یَبِسَتْ۔","Da'if","Musannaf Ibn Abi Shaybah 36716","","","كتاب الزهد"
"36717","(۳۶۷۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إنْ کَانَ الرَّجُلُ مِنَ الْحَیِّ لِیَجِیئَ فَیَسُبَّ الْحَارِثَ بْنَ سُوَیْد فَیَسْکُتَ ، فَإِذَا سَکَتَ قَامَ فَنَفَضَ رِدَائَہُ فَدَخَلَ۔","","Musannaf Ibn Abi Shaybah 36717","","","كتاب الزهد"
"36718","(۳۶۷۱۸) حَدَّثَنَا الأَحْوَصُ بْنُ جَوَّابٍ، قَالَ: حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ، عَنْ عَمَّارٍ الدُّہْنِیِّ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ، قَالَ: أَوْحَی اللَّہُ إِلَی بَعْضِ أَوْلِیَائِہِ: إنِّی لَمْ أُحِلَّ رِضْوَانِی لأَہْلِ بَیْتٍ قَطُّ، وَلاَ لأَہْلِ دَارٍ قَطُّ، وَلاَ لأَہْلِ قَرْیَۃٍ قَطُّ فَأُحَوِّلُ عَنْہُمْ رِضْوَانِی حَتَّی یَتَحَوَّلُوا مِنْ رِضْوَانِی إِلَی سَخَطِی ، وَإِنِّی لَمْ أُحِلَّ سَخَطِی لأَہْلِ بَیْتٍ قَطُّ، وَلاَ لأَہْلِ دَارٍ قَطُّ، وَلاَ لأَہْلِ قَرْیَۃٍ قَطُّ فَأُحَوِّلُ، عَنْہُمْ سَخَطِی حَتَّی یَتَحَوَّلُوا مِنْ سَخَطِی إِلَی رِضْوَانِی۔","","Musannaf Ibn Abi Shaybah 36718","","","كتاب الزهد"
"36719","(۳۶۷۱۹) حَدَّثَنَا مُحَمَّدُ بْ[corrupt]ُ أَبِی عُبَیْدَۃَ ، قَالَ: حدَّثَنَا أَبِی، عَنِ الأَعْمَشِ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، قَالَ: مَا عَلَی أَحَدِکُمْ إذَا خَلاَ أَنْ یَقُولَ لِجَلِیسَیْہِ: اسْمَعَا رَحِمَکُمَا اللَّہُ ، ثُمَّ یُمْلِی عَلَیْہِمَا خَیْرًا۔","","Musannaf Ibn Abi Shaybah 36719","","","كتاب الزهد"
"36720","(۳۶۷۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : کان إذَا قَرَأَ : {أَلْہَاکُمُ التَّکَاثُرُ} قَالَ فِی الأَمْوَالِ وَالأَوْلاَدِ {حَتَّی زُرْتُمُ الْمَقَابِرَ کَلاَّ سَوْفَ تَعْلَمُونَ} قَالَ : وَعِیدٌ بَعْدَ وَعِیدٍ عِلْمَ الْیَقِینِ۔","","Musannaf Ibn Abi Shaybah 36720","","","كتاب الزهد"
"36721","(۳۶۷۲۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَرَأَ ہَذِہِ الآیَۃَ {إنَّ اللَّہَ اشْتَرَی مِنَ الْمُؤْمِنِینَ أَنْفُسَہُمْ وَأَمْوَالَہُمْ} قَالَ : أَنْفُسٌ ہُوَ خَلَقَہَا وَأَمْوَالٌ ہُوَ رَزَقَہَا فَیَقْتُلُونَ وَیُقْتَلُونَ {وَعْدًا عَلَیْہِ حَقًّا فِی التَّوْرَاۃِ وَالإِنْجِیلِ}۔","","Musannaf Ibn Abi Shaybah 36721","","","كتاب الزهد"
"36722","(۳۶۷۲۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ قوْلُہُ : {یَا أَیُّہَا الإِنْسَان مَا غَرَّک بِرَبِّکَ الْکَرِیمِ} قَالَ : الْجَہْلُ۔","","Musannaf Ibn Abi Shaybah 36722","","","كتاب الزهد"
"36723","(۳۶۷۲۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، قَالَ : کَانَ أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ یَذْہَبُ بِخَادِمِہِ إِلَی السُّوقِ فَیُلْقِی عَلَیْہَا الآیَۃَ بَعْدَ الآیَۃِ مِنَ الْقُرْآنِ یُعَلِّمُہَا ، وَکَانَ یَقُومُ مِنَ اللَّیْلِ إِلَی فِنَائِہِ فَیُلْقِیہ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 36723","","","كتاب الزهد"
"36724","(۳۶۷۲۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْمَسْعُودِیُّ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ کَانَ یَقُولُ : أَلاَ إنَّ الْحِلْمَ وَالْحَیَائَ وَالْعِیَّ عِیُّ اللِّسَانِ ، لاَ عِیُّ الْقَلْبِ ، وَالْفِقْہَ مِنَ الإِیمَانِ ، وَہُنَّ مِمَّا یَنْقُصُ مِنَ الدُّنْیَا وَیَزِدْنَ فِی الآخِرَۃِ ، وَمَا یَزِدْنَ فِی الآخِرَۃِ أَکْثَرُ مِمَّا یَنْقُصُ مِنَ الدُّنْیَا إِلا أَنَّ الْفُحْشَ وَالْبَذَائَ وَالْبَیَانَ مِنَ النِّفَاقِ وَہُنَّ مِمَّا یَزِدْنَ فِی الدُّنْیَا وَیَنْقُصْنَ مِنَ الآخِرَۃِ ، وَمَا یَنْقُصْنَ مِنَ الآخِرَۃِ أَکْثَرُ مِمَّا یَزِدْنَ فِی الدُّنْیَا۔","","Musannaf Ibn Abi Shaybah 36724","","","كتاب الزهد"
"36725","(۳۶۷۲۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عُبَیْدِ بْنِ مَسْرُوقٍ ، عَنْ مُنْذِرٍ الثَّوْرِیِّ عَنْ رَبِیعِ بْنِ خُثَیْمٍ {وَإِذَا الْعِشَارُ عُطِّلَتْ} قَالَ : تَخَلَّی مِنْہَا أَہْلُہَا فَلَمْ تَحْلِبْ وَلَمْ تُصَرَّ۔","","Musannaf Ibn Abi Shaybah 36725","","","كتاب الزهد"
"36726","(۳۶۷۲۶) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ الْمُنْذِرِ ، عَنْ طَرِیف قَالَ : رَأَیْتُ رَبِیعَ بْنَ خُثَیْمٍ یَحْمِلُ عَرَقَۃً إِلَی بَیْتِ عَمَّتِہِ۔","","Musannaf Ibn Abi Shaybah 36726","","","كتاب الزهد"
"36727","(۳۶۷۲۷) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ الْمُنْذِرِ ، عَنْ أَبِیہِ ، عَنْ رَبِیعِ بْنِ خُثَیْمٍ ، قَالَ : مَا لَمْ یُرَدْ بِہِ وَجْہُ اللہِ یَضْمَحِلُّ۔","","Musannaf Ibn Abi Shaybah 36727","","","كتاب الزهد"
"36728","(۳۶۷۲۸) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا أَبُو کُدَیْنَۃَ ، عَنْ مُطَرِّفٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ لَمَّا أُصِیبَ ابْنُ عُمَرَ ، قَالَ : مَا تَرَکْت خَلْفِی شَیْئًا مِنَ الدُّنْیَا آسَی عَلَیْہِ غَیْرَ ظَمَأِ الْہَوَاجِرِ وَغَیْرَ مَشْیٍ إِلَی الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 36728","","","كتاب الزهد"
"36729","(۳۶۷۲۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنْ آدَمَ بْنِ عَلِیٍّ ، قَالَ : سَمِعْتُ أَخَا بِلاَلٍ مُؤَذِّنِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : النَّاسُ ثَلاَثَۃٌ أَثْلاَثٍ : فَسَالِمٌ وَغَانِمٌ وَشَاجِبٌ ، قَالَ : السَّالِمُ السَّاکِتُ ، وَالْغَانِمُ الَّذِی یَأْمُرُ بِالْخَیْرِ وَیَنْہَی ، عَنِ الْمُنْکَرِ ، فَذَلِکَ فِی زِیَادَۃٍ مِنَ اللہِ ، وَالشَّاجِبُ : النَّاطِقُ بِالْخَنَا وَالْمُعِینُ عَلَی الظُّلْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 36729","","","كتاب الزهد"
"36730","(۳۶۷۳۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : أَخْبَرَنِی إبْرَاہِیمُ عَنِ الرَّبِیعِ بْنِ أَبِی رَاشِدٍ ، قَالَ : کَانَ أَبِی مُعْجَبًا بِخَلَفِ بْنِ حَوْشَبٍ ، قَالَ : قُلْتُ لَہُ : یَا أَبَتِ : إنَّک لَتَعْجَبُ بِہَذَا الرَّجُلِ ، فَقَالَ : یَا بُنَیَّ ، إِنَّہُ نَشَأَ عَلَی طَرِیقَۃٍ حَسَنَۃٍ فَلَمْ یَزَلْ عَلَیْہَا ، قَالَ : وَکَانَ تَکَنَّی أَبَا مَرْزُوقٍ : فَقَالَ لَہُ رَبِیعٌ : حَوِّلْہَا ، قَالَ : فَقَالَ خَلْفٌ : فَاکْنِنِّی ، قَالَ : أَنْتَ أَبُو عَبْدِ الرَّحْمَنِ۔","","Musannaf Ibn Abi Shaybah 36730","","","كتاب الزهد"
"36731","(۳۶۷۳۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، عَنِ الْحَسَنِ ، قَالَ : قَالَ الإِسْلاَمُ ، وَمَا الإِسْلاَمُ ، قَالَ : الإِسْلاَمُ السِّرُّ وَالْعَلاَنِیَۃُ فِیہِ سَوَائٌ أَنْ یُسْلِمَ قَلْبُک لِلَّہِ ، وَأَنْ یَسْلَمَ مِنْک کُلُّ مُسْلِمٍ وَکُلُّ ذِی عَہْدٍ۔","","Musannaf Ibn Abi Shaybah 36731","","","كتاب الزهد"
"36732","(۳۶۷۳۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، قَالَ بَلَغَنِی : أَنَّ الْعَمَلَ فِی یَوْمِ الْقَدْرِ کَالْعَمَلِ فِی لَیْلَتِہِ۔","","Musannaf Ibn Abi Shaybah 36732","","","كتاب الزهد"
"36733","(۳۶۷۳۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّب ، عَنْ خَیْثَمَۃَ ، قَالَ : قَالَ عِیسَی ابْنُ مَرْیَمَ : لاَ تُخَبِّؤوا رِزْقَ الْیَوْمِ لِغَدٍ فَإِنَّ الَّذِی أَتَاک بِہِ الْیَوْمَ سَیَأْتِیک بِہِ غَدًا ، فَإِنْ قُلْتَ : وَکَیْفَ یَکُونُ ؟ فَانْظُرْ إِلَی الطَّیْرِ لاَ تَحْرُثُ ، وَلاَ تَزْرَعُ تَغْدُو وَتَرُوحُ إِلَی رِزْقِ اللہِ ، فَإِنْ قُلْتَ : وَمَا یَکْفِی الطَّیْرُ ؟ فَانْظُرْ إِلَی حُمُرِ وَحْشٍ وَبَقَرِ الْوَحْشِ تَغْدُو إِلَی رِزْقِ اللہِ وَتَرُوحُ شِبَاعًا۔","","Musannaf Ibn Abi Shaybah 36733","","","كتاب الزهد"
"36734","(۳۶۷۳۴) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : حدَّثَنِی أَبُو یَعْفُورٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : یَنْبَغِی لِحَامِلِ الْقُرْآنِ أَنْ یُعْرَفَ بِلَیْلِہِ إذَا النَّاسُ نَائِمُونَ ، وَبِنَہَارِہِ إذَا النَّاسُ مُفْطِرُونَ ، وَبِحُزْنِہِ إذَا النَّاسُ یَفْرَحُونَ ، وَبِبُکَائِہِ إذَا النَّاسُ یَضْحَکُونَ ، وَبِصَمْتِہِ إذَا النَّاسُ یَخْلِطُونَ ، وَبِخُشُوعِہِ إذَا النَّاسُ یَخْتَالُونَ ، وَیَنْبَغِی لِحَامِلِ الْقُرْآنِ أَنْ یَکُونَ بَاکِیًا مَحْزُونًا حَلِیمًا حَکِیمًا سِکِّیتًا ، وَلاَ یَنْبَغِی لِحَامِلِ الْقُرْآنِ أَنْ یَکُونَ ، قَالَ أَبُو بَکْرٍ ذَکَرَ کَلِمَۃً ، لاَ صَخَّابًا ، وَلاَ صَیَّاحًا ، وَلاَ حَدِیدًا۔","","Musannaf Ibn Abi Shaybah 36734","","","كتاب الزهد"
"36735","(۳۶۷۳۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا أَبُو سِنَانٍ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ مُرَّۃَ ، قَالَ : جَائَ أَبُو وَائِلٍ یَعُودُ الرَّبِیعَ بْنَ خُثَیْمٍ ، فَقَالَ : مَا جِئْت إلَیْک إِلاَّ تَسَمعْت صَوْتَ النَّاعِیَۃِ ، فَقَالَ الرَّبِیعُ : مَا أَنَا إِلاَّ عَلَی شَہْرٍ یُکْتَبُ لِی فِیہِ خَمْسُونَ وَمِئَۃُ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 36735","","","كتاب الزهد"
"36736","(۳۶۷۳۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : حَدَّثَنَا أَبُو جَعْفَرٍ الْخَطْمِیُّ ، أَنَّ جَدَّہُ عُمَیْرَ بْنَ حَبِیبٍ کَانَ یَقُومُ مِنَ اللَّیْلِ فَیَقُولُ ، الرَّحِیلَ أَیُّہَا النَّاسِ ، سَبَقْتُمْ إِلَی الْمَائِ ، الدُّلْجَۃَ الدُّلْجَۃَ ، مَنْ یَسْبِقُ إِلَی الْمَائِ یَظْمَأ ، وَمَنْ یَسْبِقُ إِلَی الشَّمْسِ یَضْحَ الرَّحِیلَ الرَّحِیلَ۔","","Musannaf Ibn Abi Shaybah 36736","","","كتاب الزهد"
"36737","(۳۶۷۳۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، أَنَّ عمَیْرَ بْنَ حَبِیبٍ کَانَ لَہُ مَوْلًی یُعَلِّمُ بَنِیہِ الْقُرْآنَ وَالْکِتَابَ ، فَجَعَلَ یُذَاکِرُہُمُ النِّسَائَ وَالدُّنْیَا ، قَالَ : فَقَالَ لَہُ : یَا زِیَادُ ، لَقَدْ ظُلِّلَتْ عَلَی بَنِی قُبَّۃِ الشَّیْطَانِ ، اکْشِطُوہَا۔","","Musannaf Ibn Abi Shaybah 36737","","","كتاب الزهد"
"36738","(۳۶۷۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عدی ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَالَ مُسْلِمُ بْنُ یَسَارٍ : إذَا حَدَّثْت عَنِ اللہِ حَدِیثًا فَأَمْسِکْ فَاعْلَمْ مَا قَبْلَہُ ، وَمَا بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 36738","","","كتاب الزهد"
"36739","(۳۶۷۳۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ سُفْیَانَ بْنِ عُیَیْنَۃَ ، عَنْ عَاصِمٍ ، قَالَ : کَانَ عَامَّۃُ کَلاَمُ الحسن سُبْحَانَ اللہِ الْعَظِیمِ سُبْحَانَ اللہِ وَبِحَمْدِہِ۔","","Musannaf Ibn Abi Shaybah 36739","","","كتاب الزهد"
"36740","(۳۶۷۴۰) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : مَنْ أَصْفَی صُفِّیَ لَہُ ، وَمَنْ خَلَّطَ خُلِّطَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36740","","","كتاب الزهد"
"36741","(۳۶۷۴۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : أَوْصَی رَجُلٌ ابْنَہُ ، فَقَالَ : یَا بُنَی ، أَظْہِرَ الْیَأْسَ مِمَّا فِی أَیْدِی النَّاسِ فَإِنَّہُ غِنًی ، وَإِیَّاکَ وَطَلَبَ الْحَاجَاتِ فَإِنَّہُ فَقْر حَاضِرٌ ، وَإِیَّاکَ وَمَا یُعْتَذَرُ مِنْہُ بِالْقَوْلِ ، وَإِذَا صَلَّیْت فَصَلِّ صَلاَۃَ مُوَدِّعٍ لاَ تَرَی أَنَّک تَعُودُ ، وَإِنَ اسْتَطَعْت أَنْ تَکُونَ الْیَوْمَ خَیْرًا مِنْک أَمْسِ وَغَدًا خَیْرًا مِنْک الْیَوْمَ فَافْعَلْ۔","","Musannaf Ibn Abi Shaybah 36741","","","كتاب الزهد"
"36742","(۳۶۷۴۲) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنْ یُونُسَ بْنِ خَبَّابٍ ، قَالَ : قَالَ لِی مُجَاہِدٌ : أَلاَ أُنَبِّئُک بِالأَوَّابِ الْحَفِیظِ ، قُلْتُ : بَلَی ، قَالَ : ہُوَ الَّذِی یَذْکُرُ ذَنْبَہُ إذَا خَلاَ فَیَسْتَغْفِرُ اللَّہَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 36742","","","كتاب الزهد"
"36743","(۳۶۷۴۳) حَدَّثَنَا الْحَسَنُ ، قَالَ سَمِعْت زُہَیْرًا أَبَا خَیْثَمَۃ ، قَالَ : حدَّثَنَا أَبُو إِسْحَاقَ الْہَمْدَانِیُّ ، قَالَ : کَانَ الْحَسَنُ ، یَعْنِی الْبَصْرِیَّ یُشَبَّہُ بِأَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 36743","","","كتاب الزهد"
"36744","(۳۶۷۴۴) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ وَیُونُسَ بْنِ عُبَیْدٍ ، أَنَّہُمَا قَالاَ : قَدْ رَأَیْنَا الْفُقَہَائَ فَمَا رَأَیْنَا مِنْہُمْ أَحَدًا أَجْمَعِ مِنَ الْحَسَنِ۔","","Musannaf Ibn Abi Shaybah 36744","","","كتاب الزهد"
"36745","(۳۶۷۴۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، قَالَ : حَدَّثَنَا خَالِدُ بْنُ رَبَاحٍ ، أَنَّ أَنَسَ بْنَ مَالِکٍ سُئِلَ عَنْ مَسْأَلَۃٍ ، فَقَالَ : عَلَیْکُمْ بِمَوْلاَنَا الْحَسَنِ فَاسْأَلُوہُ ، فَقَالُوا : نَسْأَلُک یَا أَبَا حَمْزَۃَ وَتَقُولُ : سَلُوا مَوْلاَنَا الْحَسَنَ ، فَقَالَ : إنَّا سَمِعْنَا وَسَمِعَ فَنَسِینَا وَحَفِظَ۔","","Musannaf Ibn Abi Shaybah 36745","","","كتاب الزهد"
"36746","(۳۶۷۴۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُوسَی الْقَارِئِ ، عَنْ طَلْحَۃَ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ زَاذَانُ یُعَلِّمُ بِلاَ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 36746","","","كتاب الزهد"
"36747","(۳۶۷۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: حدَّثَنَا فَرَجُ بْنُ فَضَالَۃَ، عَنْ أَسَدِ بْنِ وَدَاعَۃَ، قَالَ: کَانَ شَدَّادُ بْنُ أَوْسٍ إذَا أَوَی إِلَی فِرَاشِہِ کَأَنَّہُ حَبَّۃُ قَمْحٍ عَلَی مِقْلَی، ثُمَّ یَقُولُ: اللَّہُمَّ إنَّ النَّارَ قَدْ مَنَعَتْنِی النَّوْمَ : ثُمَّ یَقُومُ إِلَی الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 36747","","","كتاب الزهد"
"36748","(۳۶۷۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، قَالَ : أَجْوَدُ النَّاسِ مَنْ جَادَ عَلَی مَنْ لاَ یَرْجُو ثَوَابَہُ وَإِنَّ أَحْلَمَ النَّاسِ مَنْ عَفَا بَعْدَ الْقُدْرَۃِ ، وَإِنَّ أَبْخَلَ النَّاسِ الَّذِی یَبْخَلُ بِالسَّلاَمِ ، وَإِنَّ أَعْجَزَ النَّاسِ الَّذِی یَعْجَزُ فِی دُعَائِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 36748","","","كتاب الزهد"
"36749","(۳۶۷۴۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَلاَّمُ بْنُ مِسْکِینٍ : قَالَ سَمِعْت الْحَسَنَ یَقُولُ : إذَا نَامَ الْعَبْدُ فِی سُجُودِہِ بَاہَی اللَّہُ بِہِ الْمَلاَئِکَۃَ یَقُولُ : انْظُرُوا عَبْدِی یَعْبُدُنِی وَرُوحُہُ عِنْدِی۔","","Musannaf Ibn Abi Shaybah 36749","","","كتاب الزهد"
"36750","(۳۶۷۵۰) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی السُّمَیْطِ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفٍ قَالَ : لَفَضْلُ الْعِلْمِ أَحَبُّ إلَیَّ مِنْ فَضْلِ الْعِبَادَۃِ ، وَمَلاء دِینِکُمَ الْوَرَعُ۔","","Musannaf Ibn Abi Shaybah 36750","","","كتاب الزهد"
"36751","(۳۶۷۵۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ رَجُلٍ مِنَ النَّخَعِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : یَوَدُّ أَہْلُ الْبَلاَئِ یَوْمَ الْقِیَامَۃِ ، أَنَّ جُلُودَہُمْ کَانَتْ تُقْرَضُ بِالْمَقَارِیضِ۔","Da'if","Musannaf Ibn Abi Shaybah 36751","","","كتاب الزهد"
"36752","(۳۶۷۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لَقَدَ اسْتُخْلِفَ عُثْمَان ، وَمَا أُزُرُہُمْ إِلاَّ الْبُرُودُ ، وَمَا أَرْدِیَتُہُمْ إِلاَّ النِّمَارُ ، کَانَ أَحَدُہُمْ یَقُولُ لِصَاحِبِہِ : نَمِرَتِی خَیْرٌ مِنْ نَمِرَتِک۔","","Musannaf Ibn Abi Shaybah 36752","","","كتاب الزهد"
"36753","(۳۶۷۵۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرٍ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ لَنَا أَبُو قَتَادَۃَ الْعَدَوِیُّ : عَلَیْکُمْ بِہَذَا الشَّیْخِ ، یَعْنِی الْحَسَنَ ، فَمَا رَأَیْتُ أَحَدًا أَشْبَہَ رَأْیًا بِعُمَرَ بْنِ الْخَطَّابِ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 36753","","","كتاب الزهد"
"36754","(۳۶۷۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، قَالَ : قَالَ مُطَرِّفُ بْنُ عَبْدِ اللہِ : مَا کُنْت لأؤَمِّنَ عَلَی دُعَائِ أَحَدٍ حَتَّی أَسْمَعَ مَا یَقُولُ إِلاَّ الْحَسَنَ۔","","Musannaf Ibn Abi Shaybah 36754","","","كتاب الزهد"
"36755","(۳۶۷۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، کَانَ أَبُو بَرْزَۃَ یَتَقَہَّلُ ، وَکَانَ عَائِدُ بْنُ عَمْرٍو الْمُزَنِیّ یَلْبَسُ لِبَاسًا حَسَنًا ، قَالَ : فَأَتَی أَحَدَہُمَا رَجُلٌ ، فَقَالَ : أَلَمْ تَرَ إِلَی أَخِیک یَلْبَسُ کَذَا وَکَذَا وَیَرْغَبُ، عَنْ لِبَاسِکَ ، قَالَ : وَمَنْ یَسْتَطِیعُ أَنْ یَکُونَ مِثْلَ فُلاَنٍ ، مِنْ فَضْلِ فُلاَنٍ کَذَا إنَّ مِنْ فَضْلِ فُلاَنٍ کَذَا ، إنْ مِنْ فَضْلِ فُلاَنٍ کَذَا ، قَالَ : وَأَتَی الآخَرَ ، فَقَالَ : مِثْلَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 36755","","","كتاب الزهد"
"36756","(۳۶۷۵۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَسْمَائَ بِنْتِ یَزِیدَ ، قَالَتْ : قَالَ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اسْمُ اللہِ الأَعْظَمُ فِی ہَاتَیْنِ الآیَتَیْنِ : {وَإِلَہُکُمْ إلَہٌ وَاحِدٌ لاَ إلَہَ إِلاَّ ہُوَ الرَّحْمَن الرَّحِیمُ} وَفَاتِحَۃِ سُورَۃِ آلِ عِمْرَانَ {الم اللَّہُ لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ}۔","Da'if","Musannaf Ibn Abi Shaybah 36756","","","كتاب الزهد"
"36757","(۳۶۷۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَ رَجُلاً یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُکَ بِأَنَّک أَنْتَ اللَّہُ الأَحَدُ الصَّمَدُ الَّذِی لَمْ یَلِدْ وَلَمْ یُولَدْ وَلَمْ یَکُنْ لَہُ کُفُوًا أَحَدٌ ، فَقَالَ : لَقَدْ سَأَلْت اللَّہَ بِاسْمِہِ الأَعْظَمِ الَّذِی إذَا دُعِیَ بِہِ أَجَابَ ، وَإِذَا سُئِلَ بِہِ أَعْطَی۔","Sahih","Musannaf Ibn Abi Shaybah 36757","","","كتاب الزهد"
"36758","(۳۶۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خُزَیْمَۃَ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُکَ بِأَنَّ لَک الْحَمْدَ لاَ إلَہَ إِلاَّ أَنْتَ وَحْدَک ، لاَ شَرِیکَ لَک ، الْمَنَّانُ بَدِیعُ السَّمَاوَاتِ وَالأَرْضِ ذُو الْجَلاَلِ وَالإِکْرَامِ، فَقَالَ: لَقَدْ سَأَلْت اللَّہَ بِاسْمِہِ الأَعْظَمِ الَّذِی إذَا سُئِلَ بِہِ أَعْطَی، وَإِذَا دُعِیَ بِہِ أَجَابَ۔","Hasan","Musannaf Ibn Abi Shaybah 36758","","","كتاب الزهد"
"36759","(۳۶۷۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ ابْنِ سَابِطٍ ، أنَّ دَاعِیًا دَعَا فِی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی أَسَالُکَ بِاسْمِکَ الَّذِی لاَ إلَہَ إِلاَّ أَنْتَ الرَّحْمَن الرَّحِیمُ بَدِیعُ السَّمَاوَاتِ وَالأَرْضِ ، وَإِذَا أَرَدْت أَمْرًا فَإِنَّمَا تَقُولُ لَہُ کُنْ فَیَکُونُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لقد کِدْت ، أَوْ کَادَ أَنْ تَدْعُوَ اللَّہَ بِاسْمِہِ الأَعْظَمِ۔","","Musannaf Ibn Abi Shaybah 36759","","","كتاب الزهد"
"36760","(۳۶۷۶۰) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنَا الْحَسَنُ بْنُ ثَوْبَانَ ، عَنْ ہِشَامِ بْنِ أَبِی رُقْیَۃَ ، عَنْ أَبِی الدَّرْدَائِ ، وَابْنِ عَبَّاسٍ أَنَّہُمَا کَانَا یَقُولاَنِ : اسْمُ اللہِ الأَکْبَرُ رَبِّ رَبِّ۔","Hasan","Musannaf Ibn Abi Shaybah 36760","","","كتاب الزهد"
"36761","(۳۶۷۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قرَأَ رَجُلٌ الْبَقَرَۃَ وَآلَ عِمْرَانَ ، فَقَالَ کَعْبٌ : لَقَدْ قَرَأَ سُورَتَیْنِ فِیہِمَا الاِسْمُ الَّذِی إذَا دُعِیَ بِہِ استجَابَ۔","","Musannaf Ibn Abi Shaybah 36761","","","كتاب الزهد"
"36762","(۳۶۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : اسْمُ اللہِ الأَعْظَمُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 36762","","","كتاب الزهد"
"36763","(۳۶۷۶۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مِسْعَرٍ عَمَّنْ سَمِعَ الشَّعْبِیَّ یَقُولُ : اسْمُ اللہِ الأَعْظَمُ اللَّہُ ، ثُمَّ قَرَأ ، أَوْ قَرَأْتُ عَلَیْہِ {ہُوَ اللَّہُ الْخَالِقُ الْبَارِیئُ المُصَوِّر} إِلَی آخِرِہَا۔","","Musannaf Ibn Abi Shaybah 36763","","","كتاب الزهد"
"36764","(۳۶۷۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ ، عَنْ ضَمْرَۃَ ، أَنَّ أَبَا رَیْحَانَۃَ مَرَّ بِحِمْصٍ وَأَہْلُہَا یَقْتَسِمُونَہَا بَیْنَہُمْ ، فَسَمِعَ ضَوْضَاء ، فَقَالَ : مَا ہَذَا الضَوْضَائَ ؟ قَالَ : حِمْص یَقْتَسِمُہَا أَہْلَہَا بَیْنَہُم فَقَالَ : اللَّہُمَّ لاَ تَجْعَلْہَا عَلَیْہِمْ فِتْنَۃً ، فَمَا زَالَ یُرَدِّدُہَا حَتَّی لَمْ یُدْرَ مَتَی انْقَطَعَ صَوْتُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 36764","","","كتاب الزهد"
"36765","(۳۶۷۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ ، عَنْ ضَمْرَۃَ ، أَنَّ أَبَا رَیْحَانَۃَ کَانَ مُرَابِطًا بِالْجَزِیرَۃِ فِی مَیَّافَارِقِینَ ، فَاشْتَرَی رَسَنًا مِنْ نَبَطِیٍّ مِنْ أَہْلِہَا بِأَفْلُسَ ، فَلَمَّا قَفَلَ ، وَکَانُوا بِالرَّسْتَنِ نَزَلَ عَنْ دَابَّتِہِ ، وَقَالَ لِغُلاَمِہِ : ہَلْ قَضَیْت النَّبَطِیَّ أَفْلُسَہُ ، قَالَ : لاَ ، قَالَ : فَاسْتَخْرَجَ نَفَقَۃً مِنْ نَفَقَتِہِ فَدَفَعَہَا إِلَی غُلاَمِہِ ، وَقَالَ لأَصْحَابِہِ : أَحْسِنُوا مَعُونَتَہُ عَلَی دَوَابِّہِ حَتَّی أَبْلُغَ أَہْلِی ، قَالُوا : یَا أَبَا رَیْحَانَۃَ ، وَمَا تُرِیدُ ؟ قَالَ : أُرِیدُ أَنْ آتِیَ غَرِیمِی فَأُؤَدِّ عَنِّی أَمَانَتِی، قَالَ: فَانْطَلَقَ حَتَّی أَتَی مَیَافَارْقِینَ ، ثُمَّ أَتَی إِلَی أَہْلِہِ بَعْدَ مَا قَضَی غَرِیمَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 36765","","","كتاب الزهد"
"36766","(۳۶۷۶۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ {کَلاَّ بَلْ لاَ یَخَافُونَ الآخِرَۃَ} قَالَ : ہَذَا الَّذِی فَضَحَہُمْ۔","","Musannaf Ibn Abi Shaybah 36766","","","كتاب الزهد"
"36767","(۳۶۷۶۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ دِینَارٍ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ ، قُلْتُ : قَوْلُ اللہِ {لَئِنْ لَمْ یَنْتَہِ الْمُنَافِقُونَ وَالَّذِینَ فِی قُلُوبِہِمْ مَرَضٌ} قَالَ : ہُمَ الزُّنَاۃُ۔","","Musannaf Ibn Abi Shaybah 36767","","","كتاب الزهد"
"36768","(۳۶۷۶۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ فِی قولہ تعالی : {ہُوَ أَعْلَمُ بِکُمْ إذْ أَنْشَأَکُمْ مِنَ الأَرْضِ وَإِذْ أَنْتُمْ أَجِنَّۃٌ فِی بُطُونِ أُمَّہَاتِکُمْ} قَالَ : عَلِمَ اللَّہُ مِنْ کُلِّ نَفْسٍ مَا ہِیَ عَامِلَۃٌ ، وَمَا ہِیَ صَانِعَۃٌ وَإِلَی مَا ہِیَ صَائِرَۃٌ۔","","Musannaf Ibn Abi Shaybah 36768","","","كتاب الزهد"
"36769","(۳۶۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، قَالَ : قَالَ عُمَرُ : التُّؤَدَۃُ فِی کُلِّ شَیْئٍ خَیْرٌ إِلاَّ مَا کَانَ مِنْ أَمْرِ الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 36769","","","كتاب الزهد"
"36770","(۳۶۷۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃ ، عَنِ الْحَارِثِ بْنِ قَیْسٍ ، قَالَ : إذَا کُنْتَ فِی شَیْئٍ مِنْ أَمْرِ الدُّنْیَا فتواحَّ ، وَإِذَا کُنْت فِی شَیْئٍ مِنْ أَمْرِ الآخِرَۃِ فَامْکُثْ مَا اسْتَطَعْت ، وَإِذَا جَائَک الشَّیْطَانُ وَأَنْتَ تُصَلِّی ، فَقَالَ : إنَّک تُرَائِی ، فَزِدْ وَأَطِلْ۔","","Musannaf Ibn Abi Shaybah 36770","","","كتاب الزهد"
"36771","(۳۶۷۷۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا فِطْرٌ ، عَنْ مُنْذِرٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، أَنَّہُ جَائَہُ سَائِلٌ ، فَقَالَ : أَطْعِمُوہُ سُکَّرًا ، فَقَالَ : أَہْلُہُ : مَا یَصْنَعُ ہَذَا بِالسُّکْرِ ، فَقَالَ : لَکِنْ أَنَا أَصْنَعُ بِہِ۔","","Musannaf Ibn Abi Shaybah 36771","","","كتاب الزهد"
"36772","(۳۶۷۷۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنِی مَیْمُونُ بْنُ أَبِی جَرِیر ، قَالَ بَلَغَنِی ، أَنَّ رَجُلاً مِنْ بَنِی ابْنِ عُمَرَ اسْتَکْسَاہُ إزَارًا ، قَالَ : فذکروا إزارا ، قَالَ : اقْطَعْہُ ، ثُمَّ انْکُسْہُ ، قَالَ : فَتَکَرَّہَ ذَلِکَ الْفَتَی ، فَقَالَ لَہُ ابْنُ عُمَرَ : وَیْحَک ، انْظُرْ لاَ تَکُونُ مِنَ الْقَوْمِ الَّذِینَ یجعلون مَا رَزَقَہُمُ اللَّہُ فِی بُطُونِہِمْ وَعَلَی ظُہُورِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 36772","","","كتاب الزهد"
"36773","(۳۶۷۷۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا جَعْفَرٌ ، عَنْ مَیْمُونٍ ، أَنَّ أَبَا الدَّرْدَائِ ، قَالَ : وَیْلٌ لِلَّذِی لاَ یَعْلَمُ مَرَّۃً وَوَیْلٌ لِلَّذِی یَعْلَمُ ، ثُمَّ لاَ یَعْمَلُ سِتَّ مِرَارٍ۔","","Musannaf Ibn Abi Shaybah 36773","","","كتاب الزهد"
"36774","(۳۶۷۷۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، قَالَ : حَدَّثَنِی أَیُّوبُ بْنُ رَاشِدٍ ، عَنْ وَہْبِ بْنِ مُنَبِّہٍ ، قَالَ : نَجِدُ فِی کِتَابِ اللہِ الْمُنَزَّلِ : أُنَاسٌ یَدِینُونَ بِغَیْرِ الْعِبَادَۃِ ، یَخْتِلُونَ الدُّنْیَا بِعَمَلِ الآخِرَۃِ ، یَلْبَسُونَ لِبَاسَ مُسُوکِ الضَّأْنِ ، قُلُوبُہُمْ کَقُلُوبِ الذِّئابِ ، أَلْسِنَتہمْ أَحْلَی مِنَ الْعَسَلِ ، وَأَنْفُسُہُمْ أَمَرُّ مِنَ الصَّبْرِ ، قَالَ : أَفَبِی یَغْتَرُّونَ ، وَإِیَّایَ یَخْدَعُونَ ، أَقْسَمْت لأَبْعَثَنَّ عَلَیْہِمْ فِتْنَۃً یَعُودُ الْحَلِیمُ فِیہَا حَیْرَانَ۔","","Musannaf Ibn Abi Shaybah 36774","","","كتاب الزهد"
"36775","(۳۶۷۷۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : لاَ یَکُونُ الرَّجُلُ تَقِیًّا حَتَّی یُحَاسِبَ نَفْسَہُ أَشَدَّ مِنْ مُحَاسَبَۃِ شَرِیکِہِ حَتَّی یَعْلَمَ مَأْکَلَہُ وَمَطْعَمَہُ وَمَشْرَبَہُ وَمَلْبَسَہُ۔","","Musannaf Ibn Abi Shaybah 36775","","","كتاب الزهد"
"36776","(۳۶۷۷۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عُمَرَ بْنِ مُوسَی الأَنْصَارِیِّ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أَکْثَرُ النَّاسِ صَلاَۃً وَکَانَ لاَ یَصُومُ إِلاَّ یَوْمَ عَاشُورَائَ۔","","Musannaf Ibn Abi Shaybah 36776","","","كتاب الزهد"
"36777","(۳۶۷۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، قَالَ : قَالَ : یَا بُنَی ، قُمْ فَصَلِّ مِنَ السَّحَرِ ، فَإِنْ لَمْ تَسْتَطِعْ فَلاَ تَدَعْ رَکْعَتَیَ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 36777","","","كتاب الزهد"
"36778","(۳۶۷۷۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ یَزِیدَ بْنِ حَیَّانَ ، قَالَ : إنْ کَانَ عَنْبَسُ بْنُ عُقْبَۃَ التَّیْمِیُّ ، تَیْمُ الرَّبَابُ ، لَیَسْجُدُ حَتَّی إِنَّ الْعَصَافِیرَ لَیَقَعَنْ عَلَی ظَہْرِہِ وَیَنْزِلْنَ ، مَا یَحْسِبْنَہُ إِلاَّ جِذْمَ حَائِطٍ۔","","Musannaf Ibn Abi Shaybah 36778","","","كتاب الزهد"
"36779","(۳۶۷۷۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ الْمُنْذِرِ ، عَنْ أَبِیہِ ، عَنِ الرَّبِیعِ بْن خُثَیْمٍ فِی قولہ تعالی : {وَمَنْ یَتَّقِ اللَّہَ یَجْعَلْ لَہُ مَخْرَجًا} قَالَ : مِنْ کُلِّ أَمْرٍ ضَاقَ عَلَی النَّاسِ۔","","Musannaf Ibn Abi Shaybah 36779","","","كتاب الزهد"
"36780","(۳۶۷۸۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {أَمَّنْ ہُوَ قَانِتٌ آنَائَ اللَّیْلِ سَاجِدًا وَقَائِمًا یَحْذَرُ الآخِرَۃَ} قَالَ : یَحْذَرُ عَذَابَ الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 36780","","","كتاب الزهد"
"36781","(۳۶۷۸۱) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَوْ عَنِ الْحَسَنِ ؛ فِی قولہ تعالی : {لاَ یَحْزُنُہُمَ الْفَزَعُ الأَکْبَرُ} قَالَ : إذَا أَطْبَقَتِ النَّارُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 36781","","","كتاب الزهد"
"36782","(۳۶۷۸۲) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی بَکْرٍ الزُّبَیْدِیِّ ، عَنْ أَبِیہِ ، قَالَ : مَا رَأَیْت حَیًّا أَکْثَرَ جُلُوسًا فِی الْمَسَاجِدِ مِنَ الثَّوْرِیِّینَ وَالْعُرَنِیِّینَ۔","","Musannaf Ibn Abi Shaybah 36782","","","كتاب الزهد"
"36783","(۳۶۷۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، قَالَ : قَالَ الْحَسَنُ : یَا ابْنَ آدَمَ تُبْصِرُ الْقَذَی فِی عَیْنِ أَخِیک ، وَتَدَعُ الْجَذَلَ مُعْتَرِضًا فِی عَیْنِک۔","","Musannaf Ibn Abi Shaybah 36783","","","كتاب الزهد"
"36784","(۳۶۷۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : کَانُوا یَقُولُونَ : إنَّ لِسَانَ الْحَکِیمِ مِنْ وَرَائِ قَلْبِہِ ، فَإِذَا أَرَادَ أَنْ یَقُولَ رَجَعَ إِلَی قَلْبِہِ ، فَإِنْ کَانَ لَہُ قَالَ ، وَإِنْ کَانَ عَلَیْہِ أَمْسَکَ ، وَإِنَّ الْجَاہِلَ قَلْبُہُ فِی طَرَفِ لِسَانِہِ لاَ یَرْجِعُ إِلَی قَلْبِہِ ، مَا أَتَی عَلَی لِسَانِہِ تَکَلَّمَ بِہِ۔","","Musannaf Ibn Abi Shaybah 36784","","","كتاب الزهد"
"36785","(۳۶۷۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : مَنْ یُتْبِعْ نَفْسَہُ کُلَّ مَا یَرَی فِی النَّاسِ یَطُلْ حُزْنُہُ وَلاَ یُشْفَ غَیْظُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 36785","","","كتاب الزهد"
"36786","(۳۶۷۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إنَّ فَرْقَدَ السَّبَخِیَّ لاَ یَأْکُلُ اللَّحْمَ ، وَلاَ یَأْکُلُ کَذَا ، فَقَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَیْرًا مِنْہُ کَانُوا یَأْکُلُونَ اللَّحْمَ وَالسَّمْنَ وَکَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 36786","","","كتاب الزهد"
"36787","(۳۶۷۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : یَا ابْنَ آدَمَ ، إنَّک لَنْ تُؤَاخَذَ إِلاَّ بِمَا رَکِبْت عَلَی عَمْد۔","","Musannaf Ibn Abi Shaybah 36787","","","كتاب الزهد"
"36788","(۳۶۷۸۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَہْلُ قَرْیَۃٍ أَوْسَعَ اللَّہُ عَلَیْہِمْ حَتَّی إِنَّہُمْ کَانُوا یَسْتَنْجُونَ بِالْخُبْزِ ، فَبَعَثَ اللَّہُ عَلَیْہِمَ الْجُوعَ حَتَّی أَنَّہُمْ کَانُوا یَأْکُلُونَ مَا یَقْعُدُونَ بِہِ۔","","Musannaf Ibn Abi Shaybah 36788","","","كتاب الزهد"
"36789","(۳۶۷۸۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ رَجُلٌ یُکْثِرُ غَشَیَانَ بَابِ عُمَرَ ، قَالَ : فَقَالَ لَہُ عُمَرُ : اذْہَبْ فَتَعَلَّمْ کِتَابَ اللہِ تَعَالَی قَالَ : فَذَہَبَ الرَّجُلُ فَفَقَدَہُ عُمَرُ ، ثُمَّ لَقِیَہُ لقاء ۃ فَکَأَنَّہُ عَاتَبَہُ ، فَقَالَ : وَجَدْت فِی کِتَابِ اللہِ مَا أَغْنَانِی عَنْ بَابِ عُمَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 36789","","","كتاب الزهد"
"36790","(۳۶۷۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَزَالُ الْعَبْدُ بِخَیْرٍ مَا لَمْ یُصِبْ کَبِیرَۃً تُفْسِدُ عَلَیْہِ قَلْبَہُ وَعَقْلَہُ ، قَالَ : وَقَالَ الْحَسَنُ : الإِیمَانَ الإِیمَانَ فَإِنَّہُ مَنْ کَانَ مُؤْمِنًا فَإِنَّ لَہُ عِنْدَ اللہِ شُفَعَائَ مُشَفَّعِینَ۔","","Musannaf Ibn Abi Shaybah 36790","","","كتاب الزهد"
"36791","(۳۶۷۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : مَنْ قَالَ قَوْلاً حَسَنًا وَعَمِلَ عَمَلاً حَسَنًا فَخُذُوا ، عَنْہُ ، وَمَنْ قَالَ قَوْلاً حَسَنًا وَعَمِلَ عَمَلاً سَیِّئًا فَلاَ تَأْخُذُوا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 36791","","","كتاب الزهد"
"36792","(۳۶۷۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الأَشْہَبِ ، قَالَ : قَالَ الْحَسَنُ : إنَّ مِنَ النِّفَاقِ اخْتِلاَفَ اللِّسَانِ وَالْقَلْبِ ، وَاخْتِلاَفَ السِّرِّ وَالْعَلاَنِیَۃِ ، وَاخْتِلاَفَ الدُّخُولِ وَالْخُرُوجِ۔","","Musannaf Ibn Abi Shaybah 36792","","","كتاب الزهد"
"36793","(۳۶۷۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : حدَّثَنَا حَفْصُ الضُّبَعِی ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ أَبِی مُلَیْکَۃَ : قَالَ عُمَرُ : یَا کعب حَدِّثْنَا عَنِ الْمَوْتِ ، قَالَ : نَعَمْ یَا أَمِیرَ الْمُؤْمِنِینَ ، غُصْنٌ کَثِیرُ الشَّوْکِ أُدْخِلَ فِی جَوْفِ رَجُلٍ فَأَخَذَتْ کُلُّ شَوْکَۃٍ بِعِرْقٍ ، ثُمَّ جَذَبَہُ رَجُلٌ شَدِیدُ الْجَذْبِ فَأَخَذَ مَا أَخَذَ وَأَبْقَی مَا أَبْقَی۔","","Musannaf Ibn Abi Shaybah 36793","","","كتاب الزهد"
"36794","(۳۶۷۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ حَسَّانِ بْنِ عَطِیَّۃَ ، قَالَ : بَلَغَنِی ، أَنَّ اللَّہَ تَبَارَکَ وَتَعَالَی یَقُولُ یَوْمَ الْقِیَامَۃِ : یَا بَنِی آدَمَ ، إنَّا قَدْ أَنْصَتْنَا لَکُمْ مُنْذُ خَلَقْنَاکُمْ إِلَی یَوْمِکُمْ ہَذَا ، فَأَنْصِتُوا لَنَا نقرأ أَعْمَالُکُمْ عَلَیْکُمْ ، فَمَنْ وَجَدَ خَیْرًا فَلْیَحْمَدَ اللَّہَ ، وَمِنْ وَجَدَ شَرًّا فَلاَ یَلُومَنَّ إِلاَّ نَفْسَہُ ، فَإِنَّمَا ہِیَ أَعْمَالُکُمْ نَرُدُّہَا عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 36794","","","كتاب الزهد"
"36795","(۳۶۷۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ ، عَنْ ضَمْرَۃَ ، أَنَّ أَبَا رَیْحَانَۃَ اسْتَأْذَنَ من صَاحِبِ مُسَلَّحَتِہِ أَنْ یَأْتِیَ أَہْلَہُ ، فَقَالَ : یَا أَبَا رَیْحَانَۃَ ، کَمْ تُرِیدُ أَنْ أُؤَجِّلَکَ ، قَالَ : لَیْلَۃً ، فَلَمَّا قَدِمَ أَتَی الْمَسْجِدَ فَلَمْ یَزَلْ یُصَلِّی حَتَّی أَصْبَحَ ، ثُمَّ دَعَا بِدَابَّتِہِ مُتَوَجِّہًا إِلَی مُسَلَّحَتِہِ فَقَالُوا : یَا أَبَا رَیْحَانَۃَ ، أَمَا اسْتَأْذَنْت إِلَی أَہْلِکَ ، فَقَالَ : إنَّمَا أَجَّلَنِی أَمِیرِی لَیْلَۃً ، فَلاَ أَکْذِبُ ، وَلاَ أُخْلِفُ ، قَالَ : فَانْصَرَفَ إِلَی مُسَلَّحَتِہِ وَلَمْ یَأْتِ أَہْلَہُ ، وَکَانَ مَنْزِلُ أَبِی رَیْحَانَۃَ بَیْتِ الْمَقْدِسِ۔","Da'if","Musannaf Ibn Abi Shaybah 36795","","","كتاب الزهد"
"36796","(۳۶۷۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، أَنَّ عَبْدَ اللہِ بْنَ سَلاَمٍ صَکَّ غُلاَمًا لَہُ صَکَّۃً ، فَجَعَلَ یَبْکِی وَیَقُولُ : اقْتَصَّ مِنِّی ، وَیَقُولُ الْغُلاَمُ : لاَ أَقْتَصُّ مِنْک یَا سَیِّدِی ، قَالَ ابْنُ سَلاَمٍ : کُلُّ ذَنْبٍ یَغْفِرُہُ اللَّہُ إِلاَّ صَکَّۃَ الْوَجْہِ۔","","Musannaf Ibn Abi Shaybah 36796","","","كتاب الزهد"
"36797","(۳۶۷۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، عَنْ مُطَرِّفٍ ، عَنْ کَعْبٍ ، قَالَ : مَا مِنْ عَبْدٍ إِلاَّ فِی رَأْسِہِ حِکْمَۃٌ ، فَإِنْ تَوَاضَعَ رَفَعَہُ اللَّہُ ، وَإِنْ تَکَبَّرَ وَضَعَہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 36797","","","كتاب الزهد"
"36798","(۳۶۷۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ؛ فِی قَوْلِ اللہِ تَعَالَی : {مَنْ یَعْمَلْ سُوئًا یُجْزَ بِہِ} قَالَ : قَالَ الْحَسَنُ : ذَاکَ لِمَنْ أَرَاْدَ اللَّہُ ہَوَانَہُ ، فَأَمَّا مَنْ أَرَاْدَ اللَّہُ کَرَامَتَہُ فَإِنَّہُ یَتَجَاوَزُ عَنْ سَیِّئَاتِہِ فِی أَصْحَابِ الْجَنَّۃِ {وَعْدَ الصِّدْقِ الَّذِی کَانُوا یُوعَدُونَ}۔","","Musannaf Ibn Abi Shaybah 36798","","","كتاب الزهد"
"36799","(۳۶۷۹۹) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، قَالَ : حَدَّثَنَا أَبُو صَالِحٍ الْعُقَیْلِیُّ ، قَالَ : کَانَ أَبُو الْعَلاَئِ یَزِیدُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ یَقْرَأُ فِی الْمُصْحَفِ حَتَّی یُغْشَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 36799","","","كتاب الزهد"
"36800","(۳۶۸۰۰) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ سَعِیدٍ الْجُرَیْرِیِّ ، قَالَ : کَانَ أَبُو الْعَلاَئِ یَقْرَأُ فِی الْمُصْحَفِ ، فَکَانَ مُطَرِّفٌ یَقُولُ لَہُ أَحْیَانًا : أَغْنِ عَنَّا مُصْحَفُک سَائِرَ الْیَوْمِ۔","","Musannaf Ibn Abi Shaybah 36800","","","كتاب الزهد"
"36801","(۳۶۸۰۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ: أَیُّ الْعَمَلِ أَفْضَلُ ، قَالَ: ذِکْرُ اللہِ أَکْبَرُ ، قَالَ : وَمَنْ أَبْطَأَ بِہِ عَمَلُہُ لَمْ یُسْرِعْ بِہِ حَسَبُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 36801","","","كتاب الزهد"
"36802","(۳۶۸۰۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْن أَبِی الْحُسَیْنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ أَدُلُّکُمْ عَلَی خَیْرِ أَخْلاَقِ أَہْلِ الدُّنْیَا وَالآخِرَۃِ مَنْ عَفَا عَمَّنْ ظَلَمَہُ وَأَعْطَی مَنْ حَرَمَہُ وَوَصَلَ مَنْ قَطَعَہُ ، وَمَنْ أَحَبَّ أَنْ یُنْسَأَ لَہُ فِی عُمُرِہِ وَیُزَادَ لَہُ فِی مَالِہِ فَلْیَتَّقِ اللَّہَ رَبَّہُ وَلْیَصِلْ رَحِمَہُ۔ (طبرانی ۳۴۳۔ عبدالرزاق ۲۰۲۳۷)","Hasan","Musannaf Ibn Abi Shaybah 36802","","","كتاب الزهد"
"36803","(۳۶۸۰۳) حَدَّثَنَا عَفَّانُ ، قَالَ حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَمْرِو بْنِ مَالِکٍ ، عَنْ أَبِی الْجَوْزَائِ {یَوْمَ ہُمْ عَلَی النَّارِ یُفْتَنُونَ} قَالَ : یُعَذَّبُونَ۔","","Musannaf Ibn Abi Shaybah 36803","","","كتاب الزهد"
"36804","(۳۶۸۰۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ جَعْفَرِ بْنِ سُلَیْمَانَ ، عن عمرو بن مالک ، عَنْ أَبِی الْجَوْزَائِ {وَیَخَافُونَ سُوئَ الْحِسَابِ} قَالَ : الْمُنَاقَشَۃُ فِی الأَعْمَالِ۔","","Musannaf Ibn Abi Shaybah 36804","","","كتاب الزهد"
"36805","(۳۶۸۰۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ مَالِکٍ ، قَالَ : سَمِعْتُ أَبَا الْجَوْزَائِ یَقُولُ : نَقْلُ الْحِجَارَۃِ أَہْوَنُ عَلَی الْمُنَافِقِ مِنْ قِرَائَۃِ الْقُرْآنِ ، وَقد قَالَ سَعِیدٌ : أَخَفُّ عَلَی الْمُنَافِقِ۔","","Musannaf Ibn Abi Shaybah 36805","","","كتاب الزهد"
"36806","(۳۶۸۰۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ ، عَنْ عَمْرِو بْنِ مَالِکٍ ، قَالَ : سَمِعْتُ أَبَا الْجَوْزَائِ یَقُولُ فِی ہَذِہِ الآیَۃِ : {وَمَا خَلَقْت الْجِنَّ وَالإِنْسَ إِلاَّ لِیَعْبُدُونِ مَا أُرِیدُ مِنْہُمْ مِنْ رِزْقٍ ، وَمَا أُرِیدُ أَنْ یُطْعِمُونَ} قَالَ : أَنَا أَرْزُقُہُمْ وَأَنَا أُطْعِمُہُمْ ، مَا خَلَقْتہمْ إِلاَّ لِیَعْبُدُونِ۔","","Musannaf Ibn Abi Shaybah 36806","","","كتاب الزهد"
"36807","(۳۶۸۰۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ مَالِکٍ ، قَالَ : سَمِعْتُ أَبَا الْجَوْزَائِ یَقُول : لَیْسَ لَہُمْ طَعَامٌ إِلاَّ مِنْ ضَرِیعٍ السَّلام کَیْفَ یَسْمَنُ مَنْ یَأْکُلُ الشَّوْکَ۔","","Musannaf Ibn Abi Shaybah 36807","","","كتاب الزهد"
"36808","(۳۶۸۰۸) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : غَزَا أَبُو أَیُّوبَ الْمَدِینَۃَ ، قَالَ : قُلْتُ : الْقُسْطَنْطِینِیَّۃ ، قَالَ : نَعَمْ ، قَالَ : فَمَرَّ بِقَاصٍّ یَقُصُّ وَہُوَ یَقُولُ : إذَا عَمِلَ الْعَبْدُ الْعَمَلَ فِی صَدْرِ النَّہَارِ عُرِضَ عَلَی أَہْلِ مَعَارِفِہِ مِنْ أَہْلِ الآخِرَۃِ مِنْ آخِرِ النَّہَارِ ، وَإِذَا عَمِلَ الْعَمَلَ فِی آخِرِ النَّہَارِ عُرِضَ عَلَی أَہْلِ مَعَارِفِہِ مِنْ أَہْلِ الآخِرَۃِ فِی صَدْرِ النَّہَارِ ، قَالَ : فَقَالَ أَبُو أَیُّوبَ : انْظُرْ مَا تَقُولُ ؟ قَالَ : فَقَالَ : وَاللہِ ، إِنَّہُ لَکُمَا أَقُولُ ، قَالَ : فَقَالَ أَبُو أَیُّوبَ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ أَنْ تَفْضَحَنِی عِنْدَ عُبَادَۃَ بْنِ الصَّامِتِ ، وَسَعْدِ بْنِ عُبَادَۃَ بِمَا عَمِلْت بَعْدَہُمَا قَالَ : فَقَالَ الْقَاصُّ : وَاللہِ لاَ یَکْتُبُ اللَّہُ وِلاَیَتَہُ لِعَبْدٍ إِلاَّ سَتَرَ عَوْرَاتِہِ وَأَثْنَی عَلَیْہِ بِأَحْسَنِ عَمَلِہِ۔","","Musannaf Ibn Abi Shaybah 36808","","","كتاب الزهد"
"36809","(۳۶۸۰۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، قَالَ : وَادِیَانِ عَرِیضَانِ لاَ یُدْرَکُ غَوْرُہُمَا سَلَکَ النَّاسُ فِیہِمَا فَاعْمَلْ عَمَلاً تَعْلَمُ ، أَنَّہُ لاَ یُنْجِیک إِلاَّ عَمَلٌ صَالِحٌ ، وَتَوَکَّلْ تَوَکُّلَ رَجُلٍ تَعْلَمُ ، أَنَّہُ لاَ یُصِیبُک إِلاَّ مَا کَتَبَ اللَّہُ لَک۔","","Musannaf Ibn Abi Shaybah 36809","","","كتاب الزهد"
"36810","(۳۶۸۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ أَبَا مَعْشَرٍ الَّذِی یَرْوِی ، عَنْ إبْرَاہِیمَ یُحَدِّثُ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا مِنْ قَرْیَۃٍ إِلاَّ وَفِیہَا مَنْ یُدْفَعُ ، عَنْ أَہْلِہَا بِہِ ، وَإِنِّی لأَرْجُو أَنْ یَکُونَ أَبُو وَائِلٍ مِنْہُمْ۔","","Musannaf Ibn Abi Shaybah 36810","","","كتاب الزهد"
"36811","(۳۶۸۱۱) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ الأَسَدِیُّ ، عَنْ عُقْبَۃَ بْنِ إِسْحَاقَ ، عَنْ أَبِی شَرَّاعَۃَ ، عَنْ یَحْیَی بْنِ الْجزَّار {إِذَا القوا مِنْہَا مَکَانًا ضَیِّقًا} قَالَ : کَضِیقِ الزُّجِّ فِی الرُّمْحِ۔","","Musannaf Ibn Abi Shaybah 36811","","","كتاب الزهد"
"36812","(۳۶۸۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا ثَابِتُ بْنُ یَزِیدٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ مُسْلِمُ بْنُ یَسَارٍ : لَوْ کُنْتَ بَیْنَ مَلِکٍ تَطْلُبُ حَاجَۃً لَسَرَّکَ أَنْ تَخْشَعَ لَہُ۔","","Musannaf Ibn Abi Shaybah 36812","","","كتاب الزهد"
"36813","(۳۶۸۱۳) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنِ الْعَلاَئِ بْنِ زِیَادٍ الْعَدَوِیِّ ، قَالَ : رَأَیْتُ فِی النَّوْمِ کَأَنِّی أَرَی عَجُوزًا عَوْراء کَبِیرَۃَ الْعَیْنِ وَالأُخْرَی قَدْ کَادَتْ أَنْ تَذْہَبَ عَلَیْہَا مِنَ الزَّبَرْجَدِ وَالْحِلْیَۃِ شَیْئٌ عَجَبٌ ، فَقُلْتُ: مَا أَنْتِ؟ قَالَتْ: أَنَا الدُّنْیَا ، فَقُلْتُ: أَعُوذُ بِاللہِ مِنْ شَرِّکَ، قَالَتْ : فَإِنْ سَرَّک أَنْ یُعِیذَک اللَّہُ مِنْ شَرِّی فَأَبْغِضِ الدِّرْہَمَ۔","","Musannaf Ibn Abi Shaybah 36813","","","كتاب الزهد"
"36814","([corrupt]۶۸۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ سُفْیَانَ، عَنْ عَمْرِو بْنِ دِینَارٍ، قَالَ: کَانَ جَابِرُ بْنُ زَیْدٍ مُسْلِمًا عِنْدَالدِّرْہَمِ۔","","Musannaf Ibn Abi Shaybah 36814","","","كتاب الزهد"
"36815","(۳۶۸۱۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنِ أَبِی عِیَاضٍ {وَنُقَلِّبُہُمْ ذَاتَ الْیَمِینِ وَذَاتَ الشِّمَالِ} قَالَ فِی کُلِّ عَامٍ مَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 36815","","","كتاب الزهد"
"36816","(۳۶۸۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعْدِ بْنِ مَعْبَدٍ ، قَالَ : حدَّثَتْنِی أَسْمَائُ ابْنَۃُ عُمَیْسٍ ، أَنَّ جَعْفَرًا جَائَہَا إذْ ہُمْ بِالْحَبَشَۃِ وَہُوَ یَبْکِی ، فَقَالَتْ : مَا شَأْنُک ، قَالَ : رَأَیْتُ فَتًی مُتْرَفًا مِنَ الْحَبَشَۃِ جَسِیمًا مَرَّ عَلَی امْرَأَۃٍ فَطَرَحَ دَقِیقًا کَانَ مَعَہَا ، فََنسَفتْہُ الرِّیحُ ، قَالَتْ : أَکِلُک إِلَی یَوْمِ یَجْلِسُ الْمَلِکُ عَلَی الْکُرْسِیِّ فَیَأْخُذُ لِلْمَظْلُومِ مِنَ الظَّالِمِ۔","Da'if","Musannaf Ibn Abi Shaybah 36816","","","كتاب الزهد"
"36817","(۳۶۸۱۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : إنِّی أَشُمُّ الرَّیْحَانَ أَذْکُرُ بِہِ الْجَنَّۃَ۔","","Musannaf Ibn Abi Shaybah 36817","","","كتاب الزهد"
"36818","(۳۶۸۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : قَالَ رَجُلٌ لِلشَّعْبِیِّ : أَفْتِنَا أَیُّہَا الْعَالِمُ ، قَالَ : الْعَالِمُ مَنْ یَخَافُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 36818","","","كتاب الزهد"
"36819","(۳۶۸۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُعْطِی الرَّجُلُ صَبِیَّہُ شَیْئًا فَیُخْرِجُہُ فَیَرَاہُ الْمِسْکِینُ فَیَبْکِی عَلَی أَہْلِہِ وَیَرَاہُ الْیَتِیمُ فَیَبْکِی عَلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 36819","","","كتاب الزهد"
"36820","(۳۶۸۲۰) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، قَالَ : لاَ یَفْقَہُ عَبْدٌ حَتَّی یَعُدَّ الْبَلاَئَ نِعْمَۃً وَالرَّخَائَ مُصِیبَۃً۔","","Musannaf Ibn Abi Shaybah 36820","","","كتاب الزهد"
"36821","(۳۶۸۲۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، قَالَ : کَانَ یُعْجِبُہُمْ أَنْ یُفَرِّحُوا أَنْفُسَہُمْ۔","","Musannaf Ibn Abi Shaybah 36821","","","كتاب الزهد"
"36822","(۳۶۸۲۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : سَمِعْتُ مَالِکَ بْنَ دِینَارٍ یَقُولُ : قَلْبٌ لَیْسَ فِیہِ حُزْنٌ مِثْلُ بَیْتٍ خَرِبٍ۔","","Musannaf Ibn Abi Shaybah 36822","","","كتاب الزهد"
"36823","(۳۶۸۲۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ شُمَیْطٍ ، عَنْ بُدَیْلِ بْنِ مَیْسَرَۃَ الْعُقَیْلِیِّ ، أَوْ مَطَرٍ الْوَرَّاقِ ، أَنَّہُ قَالَ : مَنْ عَرَفَ رَبَّہُ أَحَبَّہُ ، وَمَنْ أَبْصَرَ الدُّنْیَا زَہِدَ فِیہَا ، وَلاَ یَغْفُلُ الرجل الْمُؤْمِنُ حَتَّی یَلْہُوَ ، فَإِذَا تَفَکَّرَ حَزِنَ۔","","Musannaf Ibn Abi Shaybah 36823","","","كتاب الزهد"
"36824","(۳۶۸۲۴) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ أَبِی سیار ، عَنْ أَبِی حُصَیْنٍ ، قَالَ : مَثَلُ الَّذِی یَسْلُبُ الْیَتِیمَ وَیَکْسُو الأَرْمَلَۃَ مِثْلُ الَّذِی یَکْسِبُہُ مِنْ غَیْرِ حِلِّہِ وَیُنْفِقُہُ فِی غَیْرِ حِلِّہِ۔","","Musannaf Ibn Abi Shaybah 36824","","","كتاب الزهد"
"36825","(۳۶۸۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، قَالَ : إنَّ اللَّہَ لَیَأْمُرُ فِی أَہْلِ الأَرْضِ بِالْعَذَابِ فَتَقُولُ الْمَلاَئِکَۃُ : یَا رَبِّ فِیہِمُ الصِّبْیَانُ۔ (دارمی ۳۳۴۵)","","Musannaf Ibn Abi Shaybah 36825","","","كتاب الزهد"
"36826","(۳۶۸۲۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : کَانَ یُقَالَ : مَا أَکْثَرَ أَحَدٌ ذِکْرَ الْمَوْتِ إِلاَّ رُئِیَ ذَلِکَ فِی عَمَلِہِ۔","","Musannaf Ibn Abi Shaybah 36826","","","كتاب الزهد"
"36827","(۳۶۸۲۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : کان ثَابِتٌ یَقُولُ : اللَّہُمَّ إنْ کُنْت أَعْطَیْت أَحَدًا الصَّلاَۃَ فِی قَبْرِہِ فَأَعْطِنِی الصَّلاَۃَ فِی قَبْرِی۔","","Musannaf Ibn Abi Shaybah 36827","","","كتاب الزهد"
"36828","(۳۶۸۲۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، قَالَ : کُنَّا نَأْتِی أَنَسًا وَمَعَنَا ثَابِتٌ ، فَکُلَّمَا مَرَّ بِمَسْجِدٍ صَلَّی فِیہِ ، فَکُنَّا نَأْتِی أَنَسًا فَیَقُولُ: أَیْنَ ثَابِتٌ أَیْنَ ثَابِتٌ أَیْنَ ثَابِتٌ، إنَّ ثَابِتًا دُوَیْبَّۃٌ أُحِبُّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 36828","","","كتاب الزهد"
"36829","(۳۶۸۲۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ أَنَسٌ : وَلَمْ یَقُلْ شَہِدْتہ : إنَّ لِکُلِّ شَیْئٍ مِفْتَاحًا ، وَإِنَّ ثَابِتًا مِنْ مَفَاتِیحِ الْخَیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 36829","","","كتاب الزهد"
"36830","(۳۶۸۳۰) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : أَصَابَتْ بَنِی إسْرَائِیلَ مَجَاعَۃٌ ، فَمَرَّ رَجُلٌ عَلَی رَجُلٍ ، فَقَالَ : وَدِدْت ، أَنَّ ہَذَا الرَّمَلَ دَقِیقٌ لِی فَأُطْعِمُہُ بَنِی إسْرَائِیلَ ، قَالَ : فَأُعْطِیَ عَلَی نِیَّتِہِ۔","","Musannaf Ibn Abi Shaybah 36830","","","كتاب الزهد"
"36831","(۳۶۸۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، قَالَ : کَانَ یُقَالَ : الْحِکْمَۃُ ضَالَّۃُ الْمُؤْمِنِ یَأْخُذُہَا إذَا وَجَدَہَا۔","","Musannaf Ibn Abi Shaybah 36831","","","كتاب الزهد"
"36832","(۳۶۸۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : {اقْتَرَبَ لِلنَّاسِ حِسَابُہُمْ} قَالَ : مَا یُوعَدُونَ۔","","Musannaf Ibn Abi Shaybah 36832","","","كتاب الزهد"
"36833","(۳۶۸۳۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سُفْیَانَ ، قَالَ : الزُّہْدُ فِی الدُّنْیَا قِصَرُ الأَمَلِ ، وَلَیْسَ بِلُبْسِ الصُّوفِ وَذُکِرَ ، أَنَّ الأَوْزَاعِیَّ کَانَ یَقُولُ : الزُّہْدُ فِی الدُّنْیَا تَرْکُ الْمَحْمَدَۃِ ، یَقُولُ : تَعْمَلُ الْعَمَلَ لاَ تُرِیدُ أَنْ یَحْمَدَک النَّاسُ عَلَیْہِ ، وَذُکِرَ ، أَنَّ الزُّہْرِیَّ کَانَ یَقُولُ : الزُّہْدُ فِی الدُّنْیَا مَا لَمْ یَغْلِبَ الْحَرَامُ صَبْرَک ، وَمَا لَمْ یَغْلِبَ الْحَلاَلُ شُکْرَک۔","","Musannaf Ibn Abi Shaybah 36833","","","كتاب الزهد"
"36834","(۳۶۸۳۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَیُّوبَ ، قَالَ : کَانَ یَنْبَغِی لِلْعَالِمِ أَنْ یَضَعَ التُّرَابَ عَلَی رَأْسِہِ تَوَاضُعًا لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 36834","","","كتاب الزهد"
"36835","(۳۶۸۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، قَالَ : عِنْدِی مِنَ الرُّخَصِ رُخَصٌ لَوْ حَدَّثْتُکُمْ بِہَا لاَتَّکَلْتُمْ۔","","Musannaf Ibn Abi Shaybah 36835","","","كتاب الزهد"
"36836","(۳۶۸۳۶) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ ثَابِتٍ ، قَالَ : کَانَ رِجَالٌ مِنْ بَنِی عَدِیٍّ قَدْ أَدْرَکْت بَعْضَہُمْ إنْ کَانَ أَحَدُہُمْ لِیُصَلِّیَ حَتَّی مَا یأتی فِرَاشَہُ إِلاَّ حَبْوًا۔","","Musannaf Ibn Abi Shaybah 36836","","","كتاب الزهد"
"36837","(۳۶۸۳۷) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ مَالِکٍ ، قَالَ : إنَّ لِلَّہِ فِی الأَرْضِ آنیۃ لاَ یَقْبَلُ مِنْہَا إِلاَّ الصُّلْبَ الرَّقِیقَ الصَّافِیَ ، قَالَ : الصُّلْبُ فِی طَاعَۃِ اللہِ ، الرَّقِیقُ عِنْدَ ذِکْرِ اللہِ ، الصَّافِی النَّقِیُّ مِنَ الدَّرَنِ۔","","Musannaf Ibn Abi Shaybah 36837","","","كتاب الزهد"
"36838","(۳۶۸۳۸) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ أَوْسٍ ، قَالَ : کَانَ نَبِیٌّ مِنَ الأَنْبِیَائِ یَقُولُ : اللَّہُمَّ احْفَظْنِی بِمَا تَحْفَظُ بِہِ الصَّبِیَّ ، قَالَ : فَأَبْکَانِی۔","","Musannaf Ibn Abi Shaybah 36838","","","كتاب الزهد"
"36839","(۳۶۸۳۹) حَدَّثَنَا سَعِیدُ بْنُ شُرَحْبِیلَ ، قَالَ : أَخْبَرَنَا لَیْثُ بْنُ سَعْدٍ عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی أَیُّوبَ ، قَالَ : مَنْ أَرَاْدَ أَنْ یَعْظُمَ حِلْمُہُ وَیَکْثُرَ عِلْمُہُ فَلْیَجْلِسْ فِی غَیْرِ مَجْلِسِ عَشِیرَتِہِ۔","","Musannaf Ibn Abi Shaybah 36839","","","كتاب الزهد"
"36840","(۳۶۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی صَالِحٍ ، عَنِ الأَعْمَشِ ، قَالَ : إنْ کُنَّا لَنَحْضُرُ الْجِنَازَۃَ ، فَمَا نَدْرِی مَنْ نُعَزِّی مِنْ وَجْدِ الْقَوْمِ۔","","Musannaf Ibn Abi Shaybah 36840","","","كتاب الزهد"
"36841","(۳۶۸۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَشْرَسُ أَبُو شَیْبَانَ ، قَالَ : حَدَّثَنَا ثَابِتٌ الْبُنَانِیُّ ، قَالَ : لَقَدْ کُنَّا نَتْبَعُ الْجِنَازَۃَ فَمَا نَرَی حَوْلَ السَّرِیرِ إِلاَّ مُتَقَنِّعًا بَاکِیًا ، أَوْ مُتَفَکِّرًا کَأَنَّمَا عَلَی رُؤُوسِہِمَ الطَّیْرُ۔","","Musannaf Ibn Abi Shaybah 36841","","","كتاب الزهد"
"36842","(۳۶۸۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : الْتَقَی رَجُلاَنِ فِی السُّوقِ ، فَقَالَ : أَحَدُہُمَا لِصَاحِبِہِ : یَا أَخِی ، تَعَالَ نَدْعُو اللَّہَ وَنَسْتَغْفِرْہُ فِی غَفْلَۃِ النَّاسِ لَعَلَّہُ یَغْفِرُ لَنَا ، فَفَعَلا ، فَقُضِی لأَحَدِہِمَا ، أَنَّہُ مَاتَ قَبْلَ صَاحِبِہِ ، فَأَتَاہُ فِی الْمَنَامِ ، فَقَالَ : یَا أَخِی ، أَشْعَرْت أَنَّ اللَّہَ غَفَرَ لَنَا عَشِیَّۃَ الْتَقَیْنَا فِی السُّوقِ۔","","Musannaf Ibn Abi Shaybah 36842","","","كتاب الزهد"
"36843","(۳۶۸۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی زَیْنَبَ ، قَالَ : مَنْ أَتَی السُّوقَ لاَ یَأْتِیہَا إِلاَّ لِیَذْکُرَ اللَّہَ فِیہَا غُفِرَ لَہُ بِعَدَدِ مَنْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 36843","","","كتاب الزهد"
"36844","(۳۶۸۴۴) حَدَّثَنَا مُعَاذُ بْنُ مَعْقِلٍ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : أَبْکَانِی الْحَجَّاجُ فِی مَسْجِدِکُمْ ہَذَا وَہُوَ یَخْطُبُ فَسَمِعْتہ یَقُولُ : امْرُؤٌ زَوَّدَ نَفْسَہُ ، امْرُؤٌ وَعَظَ نَفْسَہُ ، امْرُؤٌ لَمْ یَأْتَمِنْ نَفْسَہُ عَلَی نَفْسِہِ ، امْرُؤٌ أَخَذَ مِنْ نَفْسِہِ لِنَفْسِہِ ، امْرُؤٌ کَانَ لِلِسَانِہِ وَقَلْبِہِ زَاجِرٌ مِنَ اللہِ تَعَالَی قَالَ : فَأَبْکَانِی۔","","Musannaf Ibn Abi Shaybah 36844","","","كتاب الزهد"
"36845","(۳۶۸۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ مِنْ أَہْلِ الشَّامِ یُکْنَی أَبَا عَبْدِ اللہِ ، قَالَ : أَتَیْتُ طَاوُوسًا فَاسْتَأْذَنْت عَلَیْہِ فَخَرَجَ إلَیَّ شَیْخٌ کَبِیرٌ ظَنَنْت ، أَنَّہُ طَاوُوسٌ ، قُلْتُ : أَنْتَ طَاوُوسٌ ؟ قَالَ : لاَ ، أَنَا ابْنُہُ ، قُلْتُ : لَئِنْ کُنْت ابْنَہُ فَقَدْ خَرِفَ أَبُوک ، قَالَ : یَقُولُ ہُوَ : إنَّ الْعَالِمَ لاَ یَخْرَفُ ، قَالَ : قُلْتُ : اسْتَأْذِنْ لِی عَلَی أَبِیک ، قَالَ : فَاسْتَأْذَنَ لِی ، فَدَخَلَتْ عَلَیْہِ ، فَقَالَ الشَّیْخُ : سَلْ وَأَوْجِزْ ، فَقُلْتُ : إنْ أَوْجَزْت لِی أَوْجَزْت لَک ، فَقَالَ : لاَ تَسْأَلْ ، أَنَا أُعَلِّمُک فِی مَجْلِسِکَ ہَذَا الْقُرْآنَ وَالتَّوْرَاۃَ وَالإِنْجِیلَ : خَفِ اللَّہَ مَخَافَۃً حَتَّی لاَ یَکُونَ أَحَدٌ أَخْوَف عِنْدَکَ مِنْہُ ، وَارْجَہ رَجَائً ہُوَ أَشَدُّ مِنْ خَوْفِکَ إیَّاہُ ، وَأَحِبَّ لِلنَّاسِ مَا تُحِبُّ لِنَفْسِک۔","","Musannaf Ibn Abi Shaybah 36845","","","كتاب الزهد"
"36846","(۳۶۸۴۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، قَالَ : کَانَ الْحَسَنُ یُحِبُّ الْمُدَاوَمَۃَ فِی الْعَمَلِ ، قَالَ : وَقَالَ مُحَمَّدٌ : أَرَأَیْت إنْ نَشِطَ لَیْلَۃً وَکَسِلَ لَیْلَۃً ، فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 36846","","","كتاب الزهد"
"36847","(۳۶۸۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، قَالَ : حدَّثَنِی أَبُو سَعِیدٍ ، عَنْ زَیْدِ بْنِ أَرَقْمَ ، قَالَ : اعْبُدَ اللَّہَ کَأَنَّک تَرَاہُ ، فَإِنْ کُنْت لاَ تَرَاہُ فَإِنَّہُ یَرَاک ، وَاحْسُبْ نَفْسَک فِی الْمَوْتَی ، وَاتَّقِ دَعْوَۃَ الْمَظْلُومِ فَإِنَّہَا مُسْتَجَابَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 36847","","","كتاب الزهد"
"36848","(۳۶۸۴۸) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی مُسْلِمٍ الْخَوْلاَنِیِّ ، قَالَ : الْعُلَمَائُ ثَلاَثَۃٌ : رَجُلٌ عَاشَ بِعِلْمِہِ وَعَاشَ بِہِ النَّاسُ مَعَہُ ، وَرَجُلٌ عَاشَ بِعِلْمِہِ وَلَمْ یَعِشْ بِہِ معہ أَحَدٌ غَیْرُہُ ، وَرَجُلٌ عَاشَ النَّاسُ بِعِلْمِہِ وَأَہْلَکَ نَفْسَہُ۔","","Musannaf Ibn Abi Shaybah 36848","","","كتاب الزهد"
"36849","(۳۶۸۴۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا زُرَیْک بْنُ أَبِی زُرَیْکٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : یَا ابْنَ آدَمَ ، ضَعْ قَدَمَک عَلَی أَرْضِکَ وَاعْلَمْ ، أَنَّہَا بَعْدَ قَلِیلٍ قَبْرُک۔","","Musannaf Ibn Abi Shaybah 36849","","","كتاب الزهد"
"36850","(۳۶۸۵۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا زُرَیْکُ بْنُ أَبِی زُرَیْکٍ ، قَالَ : سَمِعْتُ الْحَسَنَ وَہُوَ یَقُولُ : یَا ابْنَ آدَمَ ، إنَّک نَاظِرٌ إِلَی عَمَلِکَ فزن خَیْرَہُ وَشَرَّہُ ، وَلاَ تُحَقِّرْ شَیْئًا مِنَ الْخَیْرِ وَإِنْ ہُوَ صَغُرَ ، فَإِنَّک إذَا رَأَیْتہ سَرَّک مَکَانَہُ ، وَلاَ تُحَقِّرْ شَیْئًا مِنَ الشَّرِّ فَإِنَّک إذَا رَأَیْتہ سَائَک مَکَانَہُ ، رَحِمَ اللَّہُ عَبْدًا کَسَبَ طَیِّبًا وَأَنْفَقَ قَصْدًا وَوَجَّہَ فَضْلا ، وَجِّہُوا ہَذِہِ الْفُضُولَ حَیْثُ وَجَّہَہَا اللَّہُ ، وَضَعُوہَا حَیْثُ أَمَرَ اللَّہُ بِہَا أَنْ تُوضَعَ ، فَإِنَّ مَنْ قَبْلَکُمْ کَانُوا یَشْتَرُونَ أَنْفُسَہُمْ بِالْفَضْلِ مِنَ اللہِ ، وَإِنَّ ہَذَا الْمَوْتَ قَدْ أَضَرَّ بِالدُّنْیَا فَفَضَحَہَا ، فَوَاللہِ مَا وُجِدَ بَعْدُ ذُو لُبٍّ فَرِحًا۔","","Musannaf Ibn Abi Shaybah 36850","","","كتاب الزهد"
"36851","(۳۶۸۵۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، عَنْ أَبِی الْعُبَیْدَیْنِ ، قَالَ : إنْ ضَنُّوا عَلَیْک بِالْمُفلطَحَۃِ فَخُذْ رَغِیفَک وَرِدْ نَہْرَک وَأَمْسِکْ عَلَیْک دِینَک۔","","Musannaf Ibn Abi Shaybah 36851","","","كتاب الزهد"
"36852","(۳۶۸۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَازِمٍ ، عَنِ الْمِنْہَالِ ، قَالَ : قَالَ عَلِیٌّ : حَرَامٌ عَلَی کُلِّ نَفْسٍ أَنْ تَخْرُجَ مِنَ الدُّنْیَا حَتَّی تَعْلَمَ إِلَی أَیْنَ مَصِیرُہَا۔","","Musannaf Ibn Abi Shaybah 36852","","","كتاب الزهد"
"36853","(۳۶۸۵۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مُبَارَکٌ بْنُ فَضَالۃ ، قَالَ : حَدَّثَنَا بَکْرٌ ، عَنْ عَدِیِّ بْنِ أَرْطَاۃَ ، عَنْ رَجُلٍ کَانَ مِنْ صَدْرِ ہَذِہِ الأُمَّۃِ ، قَالَ : کَانُوا إذْ أَثْنُوا عَلَیْہِ فَسَمِعَ ذَلِکَ ، قَالَ : اللَّہُمَّ لاَ تُؤَاخِذُنِی بِمَا یَقُولُونَ ، وَاغْفِرْ لِی مَا لاَ یَعْلَمُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 36853","","","كتاب الزهد"
"36854","(۳۶۸۵۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مُبَارَکٌ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو الْفُقَیْمِیِّ ، عَنْ مُنْذِرٍ الثَّوْرِیِّ ، عَنْ مُحَمَّدِ بْنِ عَلِیِّ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : لَیْسَ بِحَکِیمٍ مَنْ لَمْ یُعَاشِرْ بِالْمَعْرُوفِ ، مَنْ لَمْ یَجِدْ بُدًّا یَجْعَلُ اللَّہُ لَہُ فَرَجًا وَمَخْرَجًا۔","","Musannaf Ibn Abi Shaybah 36854","","","كتاب الزهد"
"36855","(۳۶۸۵۵) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا بِشْرُ بْنُ مُفَضِّلٍ ، قَالَ : حدَّثَنَا عُمَارَۃُ بْنُ غَزِیَّۃَ ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ ، عَنْ محمود بْنِ لَبِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ إذَا أَحَبَّ عَبْدًا حَمَاہُ الدُّنْیَا کَمَا یَظَلُّ أَحَدُکُمْ یَحْمِی سَقِیمَہُ الْمَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 36855","","","كتاب الزهد"
"36856","(۳۶۸۵۶) حَدَّثَنَا عَبَّادٌ، عَنْ شُعْبَۃَ، عَنْ حُصَیْنٍ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ، قَالَ: لَیْسَ بَأَسرَّ لِلْمُؤْمِنِ مِنْ أَنْ یَخْلُوَ وَحْدَہُ۔","","Musannaf Ibn Abi Shaybah 36856","","","كتاب الزهد"
"36857","(۳۶۸۵۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : الدُّنْیَا دَارُ مِنْ لاَ دَارَ لَہُ ، وَمَالُ مِنْ لاَ مَالَ لَہُ ، وَلَہَا یَعْمَلُ مِنْ لاَ عَقْلَ لَہُ۔","","Musannaf Ibn Abi Shaybah 36857","","","كتاب الزهد"
"36858","(۳۶۸۵۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ سَعِیدٍ الْجُعْفِیِّ ، قَالَ : قَالَ عِیسَی ابْنُ مَرْیَمَ علیہما السلام : بَیْتِی الْمَسْجِدُ ، وَطِیبِی الْمَائُ ، وَإِدَامِی الْجُوعُ ، وَشِعَارِی الْخَوْفُ ، وَدَابَّتِی رِجْلاَی ، وَمُصْطَلاَیَ فِی الشِّتَائِ مَشَارِقُ الصَّیْفِ ، وَسِرَاجِی بِاللَّیْلِ الْقَمَرُ ، وَجُلَسَائِی الزَّمْنَی وَالْمَسَاکِینُ ، وَأُمْسِی وَلَیْسَ لِی شَیْئٌ ، وَأُصْبِحُ وَلَیْسَ لِی شَیْئٌ ، وَأَنَا بِخَیْرٍ ، فَمَنْ أَغْنَی مِنِّی۔","","Musannaf Ibn Abi Shaybah 36858","","","كتاب الزهد"
"36859","(۳۶۸۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، أَنَّ نَاسًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالُوا : یَا رَسُولَ اللہِ ، إنَّا نَعْمَلُ أَعْمَالاً فِی السِّرِّ فَنَسْمَعُ النَّاسَ یَتَحَدَّثُونَ بِہَا فَیُعْجِبُنَا أَنْ نُذْکَرَ بِخَیْرٍ ، فَقَالَ : لَکُمْ أَجْرَانِ : أَجْرُ السِّرِّ وَأَجْرُ الْعَلاَنِیَۃِ۔ (طیالسی ۲۴۳۰۔ ابن حبان ۳۷۵)","","Musannaf Ibn Abi Shaybah 36859","","","كتاب الزهد"
"36860","(۳۶۸۶۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ بْنُ عُبَیْدٍ ، قَالَ : حَدَّثَنَا الْحَسَنُ ، أَنَّ رَجُلَیْنِ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَاتَ أَحَدُہُمَا قَبْلَ صَاحِبِہِ بِجُمُعَۃٍ فَفَضَّلُوا الَّذِی مَاتَ وَکَانَ فِی أَنْفُسِہِمْ أَفْضَلَ مِنَ الآخَرِ ، فَذُکِرَ ذَلِکَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَلَیْسَ بَقِیَ الآخَرُ بَعْدَ الأَوَّلِ جُمُعَۃً ، صَلَّی کَذَا وَکَذَا صَلاَۃً ، قَالَ : فَکَأَنَّہُ فَضَّلَ الثانی۔","Hasan","Musannaf Ibn Abi Shaybah 36860","","","كتاب الزهد"
"36861","(۳۶۸۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ خَالِدٍ الضَّبِّیُّ ، عَنْ شَیْخٍ ، عَنْ أَبِی الدَّرْدَائِ ، أَنَّہُ قَالَ : تَعَوَّذُوا بِاللہِ مِنْ خُشُوعِ النِّفَاقِ ، قَالَ : قِیلَ : یَا أَبَا الدَّرْدَائِ ، وَمَا خُشُوعُ النِّفَاقِ ، قَالَ أَنْ تَرَی الْجَسَدَ خَاشِعًا وَالْقَلْبَ لَیْسَ بِخَاشِعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 36861","","","كتاب الزهد"
"36862","(۳۶۸۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ: حدَّثَنَا حَسَنٌ، عَنْ أَبِیہِ، عَنْ زَیْدٍ الْعَمِّیِّ، قَالَ: لَمَّا قِیلَ لِدَاوُدَ: قَدْ غُفِرَ لَک ، قَالَ : فَکَیْفَ لِی بِالرَّجُلِ ، قَالَ : قِیلَ لَہُ : نَسْتَوْہِبُک مِنْہُ فَیَہَبَک لَنَا ، فَإِنَّہَا لَتُرْجَی فِی الدُّنیا۔","","Musannaf Ibn Abi Shaybah 36862","","","كتاب الزهد"
"36863","(۳۶۸۶۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ یَزِیدَ الْعَطَّارُ ، قَالَ : حَدَّثَنَا قَتَادَۃُ : قَالَ حَدَّثَنا أَبُو الْعَالِیَۃِ الرِّیَاحِیُّ ، عَنْ حَدِیثِ سَہْلِ بْنِ حَنْظَلَۃَ الْعَبْشَمِیِّ أَنَّہُ قَالَ : مَا اجْتَمَعَ قَوْمٌ یَذْکُرُونَ اللَّہَ إِلاَّ نَادَی مُنَادٍ مِنَ السَّمَائِ : قُومُوا مَغْفُورًا لَکُمْ ، قَدْ بُدِّلَتْ سَیِّئَاتُکُمْ حَسَنَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36863","","","كتاب الزهد"
"36864","(۳۶۸۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ أَبِی رَوَّادٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ ، یُقَالَ : الْعِلْمُ ضَالَّۃُ الْمُؤْمِنِ یَغْدُو فِی طَلَبِہِ ، فَإِذَا أَصَابَ مِنْہُ شَیْئًا حَوَاہُ۔","","Musannaf Ibn Abi Shaybah 36864","","","كتاب الزهد"
"36865","(۳۶۸۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ أَبِی رَوَّادٍ ، أَنَّ أَصْحَابَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ظَہَرَ فِیہِمَ الْمِزَاحُ وَالضَّحِکَ ، فَأَنْزَلَ اللَّہُ تَعَالَی : {أَلَمْ یَأْنِ لِلَّذِینَ آمَنُوا أَنْ تَخْشَعَ قُلُوبُہُمْ لِذِکْرِ اللہِ} إِلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 36865","","","كتاب الزهد"
"36866","(۳۶۸۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا ابْنُ أَبِی رَوَّادٍ ، أَنَّ قَوْمًا صَحِبُوا عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، فَقَالَ : عَلَیْکُمْ بِتَقْوَی اللہِ وَحْدَہُ لاَ شَرِیکَ لَہُ ، وَإِیَّایَ وَالْمِزَاحَ ، فَإِنَّہُ یَجُرُّ الْقَبِیحَ وَیُورِثُ الضَّغِینَۃَ ، وَتَجَالَسُوا بِالْقُرْآنِ وَتَحَدَّثُوا بِہِِِِ ، فَإِنْ ثَقُلَ عَلَیْکُمْ فَحَدِیثٌ مِنْ حَدِیثِ الرِّجَالِ ، سِیرُوا بِاسْمِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36866","","","كتاب الزهد"
"36867","(۳۶۸۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّہَا کَتَبَتْ إِلَی مُعَاوِیَۃَ : أُوصِیک بِتَقْوَی اللہِ فَإِنَّک إنِ اتَّقَیْت اللَّہَ کَفَاک النَّاسَ فَإِنَ اتَّقَیْت النَّاسَ لَمْ یُغْنُوا ، عَنْک مِنَ اللہِ شَیْئًا ، فَعَلَیْک بِتَقْوَی اللہِ أَمَّا بَعْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 36867","","","كتاب الزهد"
"36868","(۳۶۸۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : مَا تَجَرَّعَ عَبْدٌ جَرْعَۃً أَفْضَلَ عِنْدَ اللہِ أَجْرًا مِنْ جَرْعَۃٍ کَظَمَہَا لِلَّہِ ابْتِغَائَ وَجْہِ اللہِ۔ (بخاری ۱۳۱۸)","Hasan","Musannaf Ibn Abi Shaybah 36868","","","كتاب الزهد"
"36869","(۳۶۸۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : لاَ تُعَلَّمُ للدنیا ، وَلاَ تَفْقَہُ لِلرِّیَائِ ، وَلاَ تَکُونَنَّ ضَحَّاکًا مِنْ غَیْرِ عَجَبٍ ، وَلاَ مَشَّائً فِی غَیْرِ أَرَبٍ۔","","Musannaf Ibn Abi Shaybah 36869","","","كتاب الزهد"
"36870","(۳۶۸۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ صَالِحِ بْنِ رُسْتُمَ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ، قَالَ: صَحِبْت ابْنَ عَبَّاسٍ مِنْ مَکَّۃَ إِلَی الْمَدِینَۃِ وَمِنَ الْمَدِینَۃِ إِلَی مَکَّۃَ ، فَکَانَ إذَا نَزَلَ مَنْزِلاً قَامَ شَطْرَ اللَّیْلِ فَأَکْثَرَ فِی ذَلِکَ النَّشِیجَ ، قُلْتُ: وَمَا النَّشِیجُ ، قَالَ : النَّحِیبُ وَالْبُکَائُ ، وَیَقْرَأُ : {وَجَائَتْ سَکْرَۃُ الْمَوْتِ بِالْحَقِّ ذَلِکَ مَا کُنْت مِنْہُ تَحِیدُ}۔","Hasan","Musannaf Ibn Abi Shaybah 36870","","","كتاب الزهد"
"36871","(۳۶۸۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی حَصِینٍ ، عَنْ خَیْثَمَۃ ، قَالَ : کَانَ عِیسَی ابْنُ مَرْیَمَ علیہما السلام ، وَیَحْیَی ابْنَیْ خَالَۃٍ ، وَکَانَ عِیسَی یَلْبَسُ الصُّوفَ ، وَکَانَ یَحْیَی یَلْبَسُ الْوَبَرَ ، وَلَمْ یَکُنْ لِوَاحِدٍ مِنْہُمَا دِینَارٌ ، وَلاَ دِرْہَمٌ ، وَلاَ عَبْدٌ ، وَلاَ أَمَۃٌ ، وَلاَ مَأْوًی یَأْوِیَانِ إلَیْہِ ، أَیْنَمَا جَنَّہُمَا اللَّیْلُ أَوَیَا، فَلَمَّا أَرَادَا أَنْ یَفْتَرِقَا، قَالَ لَہُ یَحْیَی: أَوْصِنِی، قَالَ: لاَ تَغْضَبْ، قَالَ: لاَ أَسْتَطِیعُ إِلاَّ أَنْ أَغْضَبَ، قَالَ : لاَ تَقْتَنِ مَالاً ، قَالَ : أَمَّا ہَذَا فَعَسَی۔","","Musannaf Ibn Abi Shaybah 36871","","","كتاب الزهد"
"36872","(۳۶۸۷۲) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی، قَالَ: حدَّثَنَا أَبُو ہِلاَلٍ، عَنْ قَتَادَۃَ فِی قَوْلِ ا[corrupt]لہِ تَعَالَی: {وَکَأْسٍ مِنْ مَعِینٍ} قَالَ : کَأْسٌ مِنْ خَمْرٍ جَارِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 36872","","","كتاب الزهد"
"36873","(۳۶۸۷۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا سَعِیدُ بْنُ إیَاسٍ الْجُرَیْرِیُّ ، قَالَ : حَدَّثَنَا أَبُو الْعَلاَئِ ، أَنَّ رَجُلاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَدْرَکَتْہُ الْوَفَاۃُ فَجَعَلَ یَقُولُ : وَا لَہْفَاہُ وَا لَہْفَاہُ ، فَقِیلَ لَہُ : لم تَلَہَّفُ ؟ فَقَالَ : إنِّی سَأَلْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُلْتُ : مَا یَکْفِینِی مِنَ الدُّنْیَا ، قَالَ : خَادِمٌ وَمَرْکَبٌ ، فَلاَ أَنَا سَکَتُّ فَلَمْ أَسْأَلْہُوَلاَ أَنَا حِینَ سَأَلْتُہُ انْتَہَیْت إِلَی قَوْلِہِ ، وَأَصَبْت مِنَ الدُّنْیَا وَفِی یَدِی مَا فِی یَدِی وَجَائَنِی الْمَوْتُ۔","","Musannaf Ibn Abi Shaybah 36873","","","كتاب الزهد"
"36874","(۳۶۸۷۴) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا شَیْبَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : آیَۃٌ أُنْزِلَتْ فِی ہَذِہِ الأمۃ : {قل أَؤُنَبِّئُکُمْ بِخَیْرٍ مِنْ ذَلِکُمْ} قَالَ عُمَرُ : الآنَ یَا رَبُّ۔","Da'if","Musannaf Ibn Abi Shaybah 36874","","","كتاب الزهد"
"36875","(۳۶۸۷۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ أَخُو حَمَّادِ بْنِ زَیْدٍ ، قَالَ : حَدَّثَنَا عُثْمَان الشَّحَّامُ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ وَاسِعٍ ، قَالَ : قَدِمْت مِنْ مَکَّۃَ فَإِذَا عَلَی الْخَنْدَقِ قَنْطَرَۃٌ ، فَأَخَذْت فَانْطُلِقَ بِی إِلَی مَرْوَانَ بْنِ الْمُہَلَّبِ ، وَہُوَ أَمِیرٌ عَلَی الْبَصْرَۃِ ، فَرَحَّبَ بِی ، وَقَالَ : حَاجَتُک یَا أَبَا عبْدِ اللہِ ، قُلْتُ : حَاجَتِی إنِ اسْتَطَعْت أَنْ أَکُونَ کَمَا قَالَ أَخُو بَنِی عَدِیٍّ ، قَالَ : وَمَنْ أَخُو بَنِی عَدِیٍّ ؟ قَالَ : الْعَلاَئُ بْنُ زِیَادٍ ، قَالَ : اسْتَعْمَلَ صَدِیقٌ لَہُ مَرَّۃً عَلَی عَمَلٍ فَکَتَبَ إلَیْہِ : أَمَّا بَعْدُ ، فَإِنَ اسْتَطَعْت أَنْ لاَ تَبِیتَ إِلاَّ وَظَہْرُک خَفِیفٌ، وَبَطْنُک خَمِیصٌ ، وَکَفُّک نَقِیَّۃٌ مِنْ دِمَائِ الْمُسْلِمِینَ وَأَمْوَالِہِمْ ، فَإِنَّک إنْ فَعَلَتْ ذَلِکَ لَمْ یَکُنْ عَلَیْک سَبِیلٌ {إنَّمَا السَّبِیلُ عَلَی الَّذِینَ یَظْلِمُونَ النَّاسَ وَیَبْغُونَ فِی الأَرْضِ} الآیَۃُ ، قَالَ مَرْوَانُ : صَدَقَ وَاللہِ وَنَصَحَ ، ثُمَّ قَالَ : حَاجَتُک یَا أَبَا عَبْدِ اللہِ ، قُلْتُ : حَاجَتِی أَنْ تُلْحِقَنِی بِأَہْلِی ، قَالَ : فَقَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 36875","","","كتاب الزهد"
"36876","(۳۶۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْیَسَعِ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ ابْنِ سَابِطٍ ، قَالَ : إنَّ فِی الْجَنَّۃِ لَشَجَرَۃً لَمْ یَخْلُقَ اللَّہُ مِنْ صَوْتٍ حَسَنٍ إِلاَّ وَہُوَ فِی جِذْمِہَا تَلَذُّذُہُمْ وَتَنَعُّمُہُمْ۔","","Musannaf Ibn Abi Shaybah 36876","","","كتاب الزهد"
"36877","(۳۶۸۷۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنَّ ثَلاَثَۃَ عُلَمَائَ اجْتَمَعُوا فَقَالُوا لأَحَدِہِمْ : مَا أَمَلُکَ ؟ قَالَ : مَّا یَأْتِی عَلَیَّ شَہْرٌ إِلاَّ ظَنَنْت أَنِّی أَمُوتُ فِیہِ ، قَالُوا : إنَّ ہَذَا الأَمَلَ ، فَقَالُوا لِلآخَرِ : مَا أَمَلُک ، قَالَ : مَا تَأْتِی عَلَیَّ جُمُعَۃٌ إِلاَّ ظَنَنْت أَنِّی أَمُوتُ فِیہَا ، قَالُوا لِلثَّالِثِ : وَمَا أَمَلُک ؟ قَالَ : وَمَا أَمَلُ مَنْ نَفْسُہُ بِیَدِ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 36877","","","كتاب الزهد"
"36878","(۳۶۸۷۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَضْرِبُ مَثَلَ ابْنِ آدَمَ مَثَلُ رَجُلٍ حَضَرَتْہُ الْوَفَاۃُ ، فَحَضَرَہ أَہْلُہُ وَعَمَلُہُ ، فَقَالَ لأَہْلِہِ : امْنَعُونِی ، قَالُوا : إنَّمَا کُنَّا نَمْنَعُک مِنْ أَمْرِ الدُّنْیَا ، فَأَمَّا ہَذَا فَلاَ نَسْتَطِیعُ أَنْ نَمْنَعَک مِنْہُ ، فَقَالَ لِمَالِہِ : أَنْتَ تَمْنَعُنِی ؟ قَالَ : إنِّی کُنْت زَیْنتک زَیَّنْت فِی الدُّنْیَا ، أَمَّا ہَذَا فَلاَ أَسْتَطِیعُ أَنْ أَمْنَعَک مِنْہُ ، قَالَ : فَوَثَبَ عَمَلُہُ ، فَقَالَ : أَنَا صَاحِبُک الَّذِی أَدْخُلُ مَعَک قَبْرَک وَأَزُولُ مَعَک حَیْثُمَا زُلْت ، قَالَ : أَمَا وَاللہِ لَوْ شَعَرْت لَکُنْت آثَرَ الثَّلاَثَۃِ عِنْدِی ، قَالَ : قَالَ الْحَسَنُ : فَالآنَ فَآثِرُوہُ عَلَی مَا سِوَاہُ۔","","Musannaf Ibn Abi Shaybah 36878","","","كتاب الزهد"
"36879","(۳۶۸۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ کُرْدُوسٍ الثَّعْلَبِیِّ ، قَالَ : مَکْتُوبٌ فِی التَّوْرَاۃِ : اتَّقِ تُوقَہُ ، إنَّمَا التَّوَقِّی بِالتَّقْوَی ، ارْحَمُوا تُرْحَمُوا ، تُوبُوا یُتَب عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 36879","","","كتاب الزهد"
"36880","(۳۶۸۸۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْجُرَیْرِیُّ ، عَنْ أَبِی نَضْرَۃَ ، أَنَّ رَجُلاً دَخَلَ الْجَنَّۃَ فَرَأَی مَمْلُوکَہُ فَوْقَہُ مِثْلَ الْکَوْکَبِ ، فَقَالَ : وَاللہِ یَا رَبِّ إنَّ ہَذَا مَمْلُوکِی فِی الدُّنْیَا ، فَمَا أَنْزَلَہُ ہَذِہِ الْمَنْزِلَۃَ ، قَالَ : کَانَ ہَذَا أَحْسَنَ عَمَلاً مِنْک۔","","Musannaf Ibn Abi Shaybah 36880","","","كتاب الزهد"
"36881","(۳۶۸۸۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : لَوْ رَأَیْت الَّذِی رَأَیْت لاَحْتَرَقَتْ کَبِدُک عَلَیْہِمْ ، وَقَالَ إبْرَاہِیمُ : إنْ کَانَ اللَّیْلُ لَیَطُولُ عَلَیَّ حَتَّی أُصْبِحَ فَأَرَاہُ۔","","Musannaf Ibn Abi Shaybah 36881","","","كتاب الزهد"
"36882","(۳۶۸۸۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا أَبُو مُوسَی التَّمِیمِیُّ، قَالَ: تُوُفِّیَتِ النَّوَارُ امْرَأَۃُ الْفَرَزْدَقِ، فَخَرَجَ فِی جِنَازَتِہَا وُجُوہُ أَہْلِ الْبَصْرَۃِ ، وَخَرَجَ فِیہَا الْحَسَنُ ، فَقَالَ الْحَسَنُ لِلْفَرَزْدَقِ : مَا أَعْدَدْت لِہَذَا الْیَوْمِ یَاأَبَا فِرَاسٍ ، قَالَ : شَہَادَۃَ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ مُنْذُ ، ثَمَانِینَ سَنَۃً ، قَالَ : فَلَمَّا دُفِنَتْ قَامَ عَلَی قَبْرِہَا ، فَقَالَ :nأَخَافُ وَرَائَ الْقَبْرِ إنْ لَمْ یُعَافِنِیnإذَا جَائَنِی یَوْمَ الْقِیَامَۃِ قَائِدٌnلَقَدْ خَابَ مِنْ أَوْلاَدِ دارم مَنْ مَشَیnأَشَدُّ مِنَ الْقَبْرِ الْتِہَابًا وَأَضْیَقَاnعَنِیفٌ وَسَوَّاقٌ یَسُوقُ الْفَرَزْدَقَاnإِلَی النَّارِ مَغْلُولَ الْقِلاَدَۃِ أَزْرَقَا","","Musannaf Ibn Abi Shaybah 36882","","","كتاب الزهد"
"36883","قرَأْت عَلَی مَسْلَمَۃَ بْنِ الْقَاسِمِ ، حَدَّثَکُمْ مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْجَہْمِ ، الْمَعْرُوفِ بِابْنِ الْوَرَّاقِ الْمَالِکِیِّ بِبَغْدَادَ ، فِی رَبِیعٍ الأَوَّلِ ، مِنْ سَنَۃِ أَرْبَعٍ وَعِشْرِینَ وَثَلاَثُ مِئَۃٍ ، قَالَ : قُرِئَ عَلَی أَبِی أَحْمَد مُحَمَّد بْن عَُبدوس بْن کَامِل السَّرَّاج ، وَأَنَا أَسْمَعُ مِنْہُ ، سَنَۃَ تِسْعِینَ ، قَالَ : حَدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ الْکُوفِیُّ ، قَالَ :n(۳۶۸۸۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ وَمَالِکُ بْنُ مِغْوَلٍ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ أَوَّلُ مَنْ قَضَی بِالْکُوفَۃِ ہَاہُنَا سلمان بْنُ رَبِیعَۃَ الْبَاہِلِی ، جَلَسَ أَرْبَعِینَ یَوْمًا لاَ یَأْتِیہ خَصْمٌ۔","","Musannaf Ibn Abi Shaybah 36883","","","كتاب الأوائل"
"36884","(۳۶۸۸۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، قَالَ : أَوَّلُ مَنْ أَخْرَجَ الْمِنْبَرَ فِی الْعِیدَیْنِ بِشْرُ بْنُ مَرْوَانَ ، وَأَوَّلُ مَنْ أَذَّنَ فِی الْعِیدَیْنِ زِیَادٌ۔","","Musannaf Ibn Abi Shaybah 36884","","","كتاب الأوائل"
"36885","(۳۶۸۸۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ أَوَّلُ مَنْ خَطَبَ جَالِسًا مُعَاوِیَۃُ حِینَ کَبِرَ وَکَثُرَ شَحْمُہُ وَعَظُمَ بَطْنُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 36885","","","كتاب الأوائل"
"36886","(۳۶۸۸۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، عَنْ عُثْمَانَ بْنِ یَسَارٍ ، عَنْ تَمِیمِ بْنِ حَذْلَم ، قَالَ : أَوَّلُ مَا سَلَّمَ عَلَی أَمِیرٍ بِالْکُوفَۃِ بِالإِمْرَۃِ ، قَالَ : خَرَجَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ مِنَ الْقَصْرِ فَعَرَضَ لَہُ رَجُلٌ مِنْ کِنْدَۃَ فَسَلَّمَ عَلَیْہِ بِالإِمْرَۃِ ، فَقَالَ : مَا ہَذَا ؟ مَا أَنَا إلاَّ رَجُلٌ مِنْہُمْ ، فَتُرِکَتْ زَمَانًا ، ثُمَّ أَقَرَّہَا بَعْدُ۔","Hasan","Musannaf Ibn Abi Shaybah 36886","","","كتاب الأوائل"
"36887","(۳۶۸۸۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ رَبِیعَۃَ بْنِ عُثْمَانَ التَّیْمِیِّ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : أَوَّلُ مَنْ خَطَبَ عَلَی الْمَنَابِرِ إبْرَاہِیمُ خَلِیلُ اللہِ عَزَّ وَجَلَّ۔","","Musannaf Ibn Abi Shaybah 36887","","","كتاب الأوائل"
"36888","(۳۶۸۸۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أنَّ إبْرَاہِیمَ أَوَّلُ النَّاسِ أَضَافَ الضَّیْفَ ، وَأَوَّلُ النَّاسِ اخْتُتِنَ ، وَأَوَّلُ النَّاسِ قَلَّمَ أَظْفَارَہُ وَجَزَّ شَارِبَہُ وَاسْتَحَدَّ۔","","Musannaf Ibn Abi Shaybah 36888","","","كتاب الأوائل"
"36889","(۳۶۸۸۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ الْمُسَیَّبِ ، أَنَّ إبْرَاہِیمَ أَوَّلُ مَنْ رَأَی الشَّیْبَ ، فَقَالَ : یَا رَبِ ، مَا ہَذَا ، قَالَ : الْوَقَارُ ، قَالَ : اللَّہُمَّ زِدْنِی وَقَارًا۔","","Musannaf Ibn Abi Shaybah 36889","","","كتاب الأوائل"
"36890","(۳۶۸۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عُرِضَتْ عَلَیَّ النَّارُ فَرَأَیْتُ فِیہَا عَمْرَو بْنَ لُحَیِّ بْنِ قَمْعَۃَ بْنِ خِنْدِفَ یَجُرُّ قَصَبَہُ فِی النَّارِ وَہُوَ أَوَّلُ مَنْ غَیَّرَ عَہْدَ إبْرَاہِیمَ عَلَیْہِ السَّلاَمُ وَسَیَّبَ السَّوَائِبَ۔ (ابو یعلی ۶۰۹۵۔ ابن حبان ۷۴۹۰)","Hasan","Musannaf Ibn Abi Shaybah 36890","","","كتاب الأوائل"
"36891","(۳۶۸۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، قَالَ : أَوَّلُ مَنْ أحْدَثَ التَّسْلِیمَ بِمَکَّۃَ عَبْدُ الرَّحْمَنِ بْنُ أَبْزَی۔","","Musannaf Ibn Abi Shaybah 36891","","","كتاب الأوائل"
"36892","(۳۶۸۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَوَّلُ مَنْ نَقَصَ التَّکْبِیرَ زِیَادٌ۔","","Musannaf Ibn Abi Shaybah 36892","","","كتاب الأوائل"
"36893","(۳۶۸۹۳) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ خَالِدِ بْنِ عُرْفُطَۃَ ، قَالَ : أَوَّلُ مَا رَأَیْت اخْتِلاَفَ أَصْحَابِ مُحَمَّدٍ حِینَ أَہَلَّ عُثْمَان بِحَجَّۃٍ ، وَأَہَلَّ عَلِیٌّ بِحَجَّۃٍ وَعُمْرَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 36893","","","كتاب الأوائل"
"36894","(۳۶۸۹۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ ، أَوَّلُ مَنِ اتَّخَذَ العودین ، وَخَطَبَ جَالِسًا وَأُذِّنَ قُدَّامَہُ فِی الْعِیدِ زِیَادٌ۔","","Musannaf Ibn Abi Shaybah 36894","","","كتاب الأوائل"
"36895","(۳۶۸۹۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُجَالِدٍ ، قَالَ : أَوَّلُ مَنْ أَخَذَ مِنَ السُّوقِ أَجْرًا زِیَادٌ۔","","Musannaf Ibn Abi Shaybah 36895","","","كتاب الأوائل"
"36896","(۳۶۸۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ رَجُلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، قَالَ : کُنْتُ قَائِدَ أَبِی حِینَ ذَہَبَ بَصَرُہُ ، فَکُنْت إذَا خَرَجْت مَعَہُ إِلَی الْجُمُعَۃِ فَسَمِعَ التَّأْذِینَ اسْتَغْفَرَ لأَبِی أُمَامَۃَ أَسْعَدَ بْنِ زُرَارَۃَ وَدَعَا لَہُ ، فَقُلْتُ لَہُ : یَا أَبَتِ ، مَا شَأْنُک إذَا سَمِعْت التَّأْذِینَ یَوْمَ الْجُمُعَۃِ اسْتَغْفَرَتْ لأَبِی أُمَامَۃَ وَدَعَوْت لَہُ وَصَلَّیْت عَلَیْہِ ، قَالَ : أَیْ بُنَیَّ ، إِنَّہُ کَانَ أَوَّلَ مَنْ جَمَّعَ بِنَا قَبْلَ قُدُومِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَقِیعِ الْخَضِمَّاتِ فِی ہَزْمِ بَنِی بَیَاضَۃَ ، قَالَ : وَکَمْ کُنْتُمْ یَوْمَئِذٍ ؟ قَالَ : کُنَّا أَرْبَعِینَ رَجُلاً۔n(ابوداؤد ۱۰۶۲۔ ابن ماجہ ۱۰۸۲)","Da'if","Musannaf Ibn Abi Shaybah 36896","","","كتاب الأوائل"
"36897","(۳۶۸۹۷) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَوَّلُ مَا سُمِعَتْ فِی الْجِنَازَۃِ اسْتَغْفِرُوا لَہُ غَفَرَ اللَّہُ لَکُمْ فِی جِنَازَۃِ سَعِیدِ بْنِ أَوْسٍ۔","","Musannaf Ibn Abi Shaybah 36897","","","كتاب الأوائل"
"36898","(۳۶۸۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْمُغِیرَۃِ بْنِ حَکِیمٍ ، قَالَ : أَوَّلُ مَنْ سَنَّ الصَّدَاقَ أَرْبَعَ مِئَۃِ دِینَارٍ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 36898","","","كتاب الأوائل"
"36899","(۳۶۸۹۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، أَنَّ أُمَّ أَیْمَنَ أَمَرَت بِالنَّعْشِ لِلنِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 36899","","","كتاب الأوائل"
"36900","(۳۶۹۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : قَدِمَتْ أُمُّ أَیْمَنَ مِنَ الْحَبَشَۃِ وَہِیَ أَمَرَتْ بِالنَّعْشِ لِلنِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 36900","","","كتاب الأوائل"
"36901","(۳۶۹۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : رَحْمَۃُ اللہِ عَلَی أَبِی بَکْرٍ ، کَانَ أَوَّلَ مَنْ جَمَعَ بَیْنَ اللَّوْحَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 36901","","","كتاب الأوائل"
"36902","(۳۶۹۰۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ عَبْدِ خَیْرٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : رَحْمَۃُ اللہِ عَلَی أَبِی بَکْرٍ ، ہُوَ أَوَّلُ مَنْ جَمَعَ ما بَیْنَ اللَّوْحَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 36902","","","كتاب الأوائل"
"36903","(۳۶۹۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : أَوَّلُ مَنْ بَدَأَ بِالْخُطْبَۃِ یَوْمَ الْعِیدِ قَبْلَ الصَّلاَۃِ مَرْوَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 36903","","","كتاب الأوائل"
"36904","(۳۶۹۰۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَوَّلُ مَنْ جَہَرَ ، وأَوَّلُ مَنْ أَعْلَنَ التَّسْلِیمَ فِی الصَّلاَۃِ ، عُمَرُ بْنُ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 36904","","","كتاب الأوائل"
"36905","(۳۶۹۰۵) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : أَوَّلُ مَنْ أَحْدَثَ الأَذَانَ فِی الْعِیدَیْنِ مُعَاوِیَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 36905","","","كتاب الأوائل"
"36906","(۳۶۹۰۶) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا أَبِی ، عن عَاصِمُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : أَوَّلُ مَنْ أَحْدَثَ الأَذَانَ فِی الْعِیدَیْنِ ابْنُ الزُّبَیْرِ۔","","Musannaf Ibn Abi Shaybah 36906","","","كتاب الأوائل"
"36907","(۳۶۹۰۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ عَاصِمُ بْنُ سُلَیْمَانَ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ ، قَالَ : أَوَّلُ مَنْ صَلَّی الضُّحَی : ذُو الزَّوَائِدِ رَجُلٌ کَانَ یَجِیئُ إِلَی السُّوقِ فِی الْحَوَائِجِ فَیُصَلِّی۔","Sahih","Musannaf Ibn Abi Shaybah 36907","","","كتاب الأوائل"
"36908","(۳۶۹۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، قَالَ : أَوَّلُ مَنْ جَعَلَ لِلْفَرَسِ سَہْمَیْنِ عُمَرُ بْنُ الْخَطَّابِ ، أَشَارَ بِہِ عَلَیْہِ رَجُلٌ مِنْ بَنِی تَمِیمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 36908","","","كتاب الأوائل"
"36909","(۳۶۹۰۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَوَّلُ مَنْ جَہَرَ بِالْمُعَوِّذَتَیْنِ فِی الصَّلاَۃِ عُبَیْدُ اللہِ بْنُ زِیَادٍ۔","","Musannaf Ibn Abi Shaybah 36909","","","كتاب الأوائل"
"36910","(۳۶۹۱۰) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ حَدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ الْہَادِ ، عَنِ ابْنِ شِہَابٍ ، قَالَ : بَلَغَنَا أَنَّ خَدِیجَۃَ بِنْتَ خُوَیْلِدٍ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَتْ أَوَّلَ مَنْ آمَنَ بِاللہِ وَرَسُولِہِ وَمَاتَتْ قَبْلَ أَنْ تُفْرَضَ الصَّلاَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 36910","","","كتاب الأوائل"
"36911","(۳۶۹۱۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ بْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : کَانَ مِنْ خُلُقِ الأَوَّلِینَ النَّظَرُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 36911","","","كتاب الأوائل"
"36912","(۳۶۹۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنِی أَبُو عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَوَّلُ مَنْ أَحْدَثَ مِنْ نِسَائِ الْعَرَبِ جَرَّ الذُّیُولِ أُمُّ إسْمَاعِیلَ ، قَالَ : لَمَّا فَرَّتْ مِنْ سَارَۃَ أَرْخَتْ ذَیْلَہَا لِتَعْفِی أَثَرَہَا ، وَأَوَّلُ مَنْ طَافَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ أُمُّ إسْمَاعِیلَ۔","Da'if","Musannaf Ibn Abi Shaybah 36912","","","كتاب الأوائل"
"36913","(۳۶۹۱۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَوَّلُ مَنْ أَظْہَرَ الإِسْلاَمَ سَبْعَۃٌ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ وَبِلاَلٌ وَخَبَّابٌ وَصُہَیْبٌ وَعَمَّارٌ وَسُمَیَّۃُ أُمُّ عَمَّارٍ۔","","Musannaf Ibn Abi Shaybah 36913","","","كتاب الأوائل"
"36914","(۳۶۹۱۴) حَدَّثَنَا حَمَّادٌ أَبُو أُسَامَۃَ ، عن إسماعیل قَالَ : حدَّثَنِی عَامِرٌ ، قَالَ : حَدَّثَنِی عَبْدُ الرَّحْمَنِ بْنُ أَبْزَی ، قَالَ: صَلَّیْت مَعَ عُمَرَ عَلَی زَیْنَبَ ، وَکَانَتْ أَوَّلَ نِسَائِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَاتَتْ بَعْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 36914","","","كتاب الأوائل"
"36915","(۳۶۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی حَمْزَۃَ مَوْلَی الأَنْصَارِ ، عَنْ زَیْدِ بْنِ أَرَقْمَ ، قَالَ : أَوَّلُ مَنْ أَسْلَمَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیٌّ ، فَذَکَرْتہُ لإِبْرَاہِیمَ فَأَنْکَرَہُ ، وَقَالَ : أَبُو بَکْرٍ۔","Shadh","Musannaf Ibn Abi Shaybah 36915","","","كتاب الأوائل"
"36916","(۳۶۹۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الْحَسَنِ ، قَالَ : جُعِلَ لِرَجُلٍ أَوَاقِیَ عَلَی أَنْ یَقْتُلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَطْلَعَہُ اللَّہُ عَلَی ذَلِکَ ، فَأَمَرَ بِہِ فَصُلِبَ ، وَکَانَ أَوَّلَ مَنْ صُلِبَ فِی الإِسْلاَمِ۔ (ابوداؤد ۲۹۸)","Hasan","Musannaf Ibn Abi Shaybah 36916","","","كتاب الأوائل"
"36917","(۳۶۹۱۷) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ حَدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، أَنَّہُ سَمِعَ عَبْدَ اللہِ بْنَ الْحَارِثِ بْنِ جَزْئٍ الزُّبَیْدِیَّ یَقُولُ : أَنَا أَوَّلُ مَنْ سَمِعَ النَّبِیّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَبُلْ أَحَدُکُمْ مُسْتَقْبِلَ الْقِبْلَۃِ ، وَأَنَا أَوَّلُ مَنْ حَدَّثَ النَّاسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 36917","","","كتاب الأوائل"
"36918","(۳۶۹۱۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، قَالَ : أَوَّلُ مَنْ أَلَّفَ من الْقَبَائِلِ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جُہَیْنَۃُ۔","","Musannaf Ibn Abi Shaybah 36918","","","كتاب الأوائل"
"36919","(۳۶۹۱۹) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ مِنْ بَایَعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْعَۃَ الرِّضْوَانِ أَبُو سِنَانٍ الأَسَدِیِّ۔","","Musannaf Ibn Abi Shaybah 36919","","","كتاب الأوائل"
"36920","(۳۶۹۲۰) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَوَّلُ شَہِیدٍ اسْتُشْہِدَ فِی الإِسْلاَمِ أُمُّ عَمَّارٍ ، طَعنہا أَبُو جَہْلٍ بِحَرْبَۃٍ فِی قُبُلِہَا۔","","Musannaf Ibn Abi Shaybah 36920","","","كتاب الأوائل"
"36921","(۳۶۹۲۱) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : قَالَ أَوَّلُ مَنِ اسْتُشْہِدَ مِنَ الْمُسْلِمِینَ یَوْمَ بَدْرٍ مِہْجَعٌ مَوْلَی عُمَرَ۔","","Musannaf Ibn Abi Shaybah 36921","","","كتاب الأوائل"
"36922","(۳۶۹۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَطْعَمَ جَدَّۃً مَعَ ابْنِہَا السُّدُسَ ، وَکَانَتْ أَوَّلَ جَدَّۃٍ وَرِثَتْ فِی الإِسْلاَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 36922","","","كتاب الأوائل"
"36923","(۳۶۹۲۳) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ فِی الْیَمِینِ مَعَ الشَّاہِدِ : بِدْعَۃٌ ، وَأَوَّلُ مَنْ قَضَی بِہَا مُعَاوِیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 36923","","","كتاب الأوائل"
"36924","(۳۶۹۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَوَّلُ مَنْ تَرَکَ إحْدَی إصْبَعَیْہِ فِی أُذُنَیْہِ ابْنُ الأَصَمِّ۔","","Musannaf Ibn Abi Shaybah 36924","","","كتاب الأوائل"
"36925","(۳۶۹۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : رَفْعُ الأَیْدِی یَوْمَ الْجُمُعَۃِ مُحْدَثٌ ، وَأَوَّلُ مَنْ أَحْدَثَ رَفْعَ الأَیْدِی یَوْمَ الْجُمُعَۃِ مَرْوَانُ۔","","Musannaf Ibn Abi Shaybah 36925","","","كتاب الأوائل"
"36926","(۳۶۹۲۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ، قَالَ: أَوَّلُ مَنْ رَفَعَ یَدَیْہِ فِی الْجُمُعَۃِ عُبَیْدُاللہِ بْنُ مَعْمَرٍ۔","","Musannaf Ibn Abi Shaybah 36926","","","كتاب الأوائل"
"36927","(۳۶۹۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الْحَسَنِ ، قَالَ : أَوَّلُ مَصْلُوبٍ صُلِبَ فِی الإِسْلاَمِ رَجُلٌ مِنْ بَنِی لَیْثٍ جَعَلَتْ لَہُ قُرَیْشٌ أَوَاقِیَ عَلَی أَنْ یَقْتُلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَاہُ جِبْرِیلُ فَأَخْبَرَہُ ، فَبَعَثَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأُمِرَ بِہِ فَصُلِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 36927","","","كتاب الأوائل"
"36928","(۳۶۹۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : أَوَّلُ جَدَّۃٍ أَطْعَمَتْ فِی الإِسْلاَمِ السُّدُسَ جَدَّۃٌ أُطْعِمَتْہُ وَابْنُہَا حَیٌّ۔","","Musannaf Ibn Abi Shaybah 36928","","","كتاب الأوائل"
"36929","(۳۶۹۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ غُلاَمٍ لِسَلْمَانَ وَیُقَالُ لَہُ سُوَیْد وَأَثْنَی عَلَیْہِ خَیْرًا ، قَالَ : لَمَّا افْتَتَحَ النَّاسُ الْمَدَائِنَ وَخَرَجُوا فِی طَلَبِ الْعَدُوِّ أَصَبْت سَلَّۃً ، فَقَالَ : سَلْمَانُ : ہَلْ عِنْدَکَ طَعَامٌ ، فَقُلْتُ : سَلَّۃٌ أَصَبْتہَا ، فَقَالَ : ہَاتِہَا ، فَإِنْ کَانَ مَالاً رَفَعْنَاہُ إِلَی ہَؤُلاَئِ ، وَإِنْ کَانَ طَعَامًا أَکَلْنَاہُ ، قَالَ : فَفَتَحْنَاہَا فَإِذَا أَرْغِفَۃٌ حُوَّارَی وَجُبْنَۃٌ وَسِکِّینٌ ، فَکَانَ أوَّلُ مَا رَأَتِ الْعَرَبُ الْحُوَّارَی۔","Hasan","Musannaf Ibn Abi Shaybah 36929","","","كتاب الأوائل"
"36930","(۳۶۹۳۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانُوا یَتَرَاہَنُونَ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ الزُّہْرِیُّ : وَأَوَّلُ مَنْ أَعْطَی فِیہِ عُمَرُ بْنُ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 36930","","","كتاب الأوائل"
"36931","(۳۶۹۳۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ قُلْتُ لَلزُّہْرِیِّ : مَنْ أَوَّلُ مَنْ وَرَّثَ الْعَرَبُ مِنَ الْمَوَالِی ، قَالَ : عُمَرُ بْنُ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 36931","","","كتاب الأوائل"
"36932","(۳۶۹۳۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ حَدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ حَدَّثَہُ أَنْ أَبَا بَکْرٍ طَافَ بِعَبْدِ اللہِ بْنِ الزُّبَیْرِ فِی خِرْقَۃٍ ، وَکَانَ أَوَّلَ مَوْلُودٍ وُلِدَ فِی الإِسْلاَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 36932","","","كتاب الأوائل"
"36933","(۳۶۹۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُتْبَۃَ ، یَعْنِی الْمَسْعُودِیَّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ أَوَّلُ مَنْ أَفْشَی الْقُرْآنَ بمکۃ مِنْ فِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ابْنَ مَسْعُودٍ ، وَأَوَّلُ مَنْ بَنَی مَسْجِدًا صُلِّیَ فِیہِ عَمَّارَ بْنَ یَاسِرٍ ، وَأَوَّلُ مَنْ أَذَّنَ بِلاَلٌ ، وَأَوَّلُ مَنْ رَمَی بِسَہْمٍ فِی سَبِیلِ اللہِ سَعْدُ بْنُ مَالِکَ ، وَأَوَّلُ مَنْ قُتِلَ مِنَ الْمُسْلِمِینَ مِہْجَعٌ ، وَأَوَّلُ مَنْ عَدَا بِہِ فَرَسُہُ فِی سَبِیلِ اللہِ الْمِقْدَادُ ، وَأَوَّلُ حَیٍّ أَدَّوْا الصَّدَقَۃَ مِنْ قِبَلِ أَنْفُسِہِمْ بَنُو عُذْرَۃَ ، وَأَوَّلُ حَیٍّ أَلَّفُوا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جُہَیْنَۃُ۔","","Musannaf Ibn Abi Shaybah 36933","","","كتاب الأوائل"
"36934","(۳۶۹۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ أَخْبَرَنَا عَامِرٌ ، قَالَ : أَوَّلُ مَنْ بَایَعَ تَحْتَ الشَّجَرِ أَ[corrupt]ُو سِنَانِ بْنُ وَہْبٍ الأَسَدِیُّ ، فَقَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلاَمَ تُبَایِعُ ، قَالَ عَلَی مَا فِی نَفْسِکَ ، فَبَایَعَہُ ، ثُمَّ تَتَابَعَ النَّاسُ فَبَایَعُوہُ۔","","Musannaf Ibn Abi Shaybah 36934","","","كتاب الأوائل"
"36935","(۳۶۹۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَامِرٍ ، قَالَ : أَوَّلُ مَنْ أَشَارَ بِصَنْعَۃِ النَّعْشِ أَنْ یُرْفَعَ أَسْمَائُ ابْنَۃُ عُمَیْسٍ حِین جَائَتْ مِنْ أَرْضِ الْحَبَشَۃِ ، رَأَتْہُمْ یَفْعَلُونَ ذَلِکَ بِأَرْضِہِمْ۔","","Musannaf Ibn Abi Shaybah 36935","","","كتاب الأوائل"
"36936","(۳۶۹۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الْجُوَیْرِیَّۃِ الْجَرْمِیِّ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْبَاذَقَ ، فَقَالَ : سَبَقَ مُحَمَّدُ الْبَاذِقَ ، أَنَا أَوَّلُ الْعَرَبِ سَأَلَ ابْنُ عَبَّاسٍ عَنْ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 36936","","","كتاب الأوائل"
"36937","(۳۶۹۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، قَالَ : أَوَّلُ جَدٍّ وَرِثَ فِی الإِسْلاَمِ عُمَرُ بْنُ الْخَطَّابِ ، فَأَرَادَ أَنْ یَحْتَازَ الْمَالَ کُلَّہُ ، فَقُلْتُ : یا أَمِیرَ الْمُؤْمِنِینَ ، إنَّہُمْ شَجَرَۃٌ دُونَک ، یَعْنِی بَنِی بَنِیہِ۔","","Musannaf Ibn Abi Shaybah 36937","","","كتاب الأوائل"
"36938","(۳۶۹۳۸) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ جَابِرٍ ، قَالَ : لَمَّا وَلِیَ عُمَرُ بْنُ الْخَطَّابِ الْخِلاَفَۃَ فَرَضَ الْفَرَائِضَ وَدَوَّنَ الدَّوَاوِینَ وَعَرَّفَ الْعُرَفَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 36938","","","كتاب الأوائل"
"36939","(۳۶۹۳۹) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ حَدَّثَنَا ہُرَیْمٌ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : أَتَی عُمَرَ رَجُلٌ مِنْ ثَقِیفٍ یُقَالُ لَہُ نَافِعُ بْنُ الْحَارِثِ وَکَانَ أَوَّلَ مَنِ افْتَلَی الْفِلاَئَ بِالْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 36939","","","كتاب الأوائل"
"36940","(۳۶۹۴۰) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی إِسْحَاقَ سَمِعْت الْبَرَائَ یَقُولُ : أَوَّلُ مَنْ قَدِمَ عَلَیْنَا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُصْعَبُ بْنُ عُمَیْرٍ ، وَابْنُ أُمِّ مَکْتُومٍ فَجَعَلاَ یُقْرِآنِ الناس الْقُرْآنَ ، قَالَ : ثُمَّ جَائَ عَمَّارٌ وَبِلاَلٌ وَسَعْدٌ ، ثُمَّ جَائَ عُمَرُ بْنُ الْخَطَّابِ فِی عِشْرِینَ راکبا، ثُمَّ جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا رَأَیْت أَہْلَ الْمَدِینَۃِ فَرِحُوا بِشَیْئٍ فَرَحَہُمْ بِہِ۔ (بخاری ۳۹۲۴۔ احمد ۲۸۴)","Sahih","Musannaf Ibn Abi Shaybah 36940","","","كتاب الأوائل"
"36941","(۳۶۹۴۱) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَمْ یُقْطِعِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ أَبُو بَکْرٍ ، وَلاَ عُمَرُ ، وَلاَ عَلِی ، وَأَوَّلُ مَنْ أَقْطَعَ الْقَطَائِعَ عُثْمَان ، وَبِیعَتِ الأَرْضُونَ فِی إمَارَۃِ عُثْمَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 36941","","","كتاب الأوائل"
"36942","(۳۶۹۴۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : أَوَّلُ مَنْ جَلَسَ عَلَی الْمِنْبَرِ فِی الْجُمُعَۃِ مُعَاوِیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 36942","","","كتاب الأوائل"
"36943","(۳۶۹۴۳) حَدَّثَنَا شَبَابَۃُ حَدَّثَنَا شُعْبَۃُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حَبَّۃَ الْعُرَنِیِّ ، عَنْ عَلِیٍّ ، قَالَ : أَنَا أَوَّلُ رَجُلٍ صَلَّی مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 36943","","","كتاب الأوائل"
"36944","(۳۶۹۴۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قُلْتُ لاِبْنِ الْحَنَفِیَّۃِ : أَبُو بَکْرٍ کَانَ أَوَّلَ الْقَوْمِ إسْلاَمًا ، قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 36944","","","كتاب الأوائل"
"36945","(۳۶۹۴۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ زَائِدَۃَ بْنِ قُدَامَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : أَوَّلُ مَنْ أَظْہَرَ إسْلاَمَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ وَعَمَّارٌ وَأُمُّہُ سُمَیَّۃُ وَصُہَیْبٌ وَبِلاَلٌ وَالْمِقْدَادُ۔","Da'if","Musannaf Ibn Abi Shaybah 36945","","","كتاب الأوائل"
"36946","(۳۶۹۴۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : اسْتَقْضَی شُرَیْحًا عُمَرَ عَلَی الْکُوفَۃِ فِی قَضِیَّۃٍ وَاسْتَقْضَی کَعْبَ بْنَ سُورٍ عَلَی الْبَصْرَۃِ فِی قَضِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 36946","","","كتاب الأوائل"
"36947","(۳۶۹۴۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : إنَّ أَوَّلَ حَیٍّ أَلَّفُوا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جُہَیْنَۃُ۔","","Musannaf Ibn Abi Shaybah 36947","","","كتاب الأوائل"
"36948","(۳۶۹۴۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی حَدَّثَنَا شَیْبَانُ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کُنْتُ جَالِسًا قَرِیبًا مِنْ کَعْبِ بْنِ عُجْرَۃَ یَوْمَ الْجُمُعَۃِ ، فَخَطَبَنَا الضَّحَّاکُ بْنُ قَیْسٍ فَجَلَسَ ، فَقَالَ : أَلاَ تَنْظُرُونَ وَاللہِ مَا رَأَیْت إمَامَ قَوْمٍ مُسْلِمِینَ یَخْطُبُ جَالِسًا۔","Sahih","Musannaf Ibn Abi Shaybah 36948","","","كتاب الأوائل"
"36949","(۳۶۹۴۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ خَالِدٍ ، عَنْ عَرْعَرَۃَ ، عَنْ عَلِیٍّ ، قَالَ لَہُ رَجُلٌ : أَخْبِرْنِی ، عَنِ الْبَیْتِ أَہْوَ أَوَّلُ بَیْتٍ وُضِعَ لِلنَّاسِ ، قَالَ : لاَ ، لَکِنَّہُ أَوَّلُ بَیْتٍ وُضِعَتْ فِیہِ الْبَرَکَۃُ مَقَامُ إبْرَاہِیمَ مَنْ دَخَلَہُ کَانَ آمِنًا۔","Da'if","Musannaf Ibn Abi Shaybah 36949","","","كتاب الأوائل"
"36950","(۳۶۹۵۰) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ حَدَّثَنَا زُہَیْرٌ ، عَنْ عَاصِمٍ ، عَنْ عَامِرٍ ، قَالَ : أَوَّلُ مَنْ جَعَلَ الْعُشُورَ عُمَرُ بْنُ الْخَطَّابِ۔","","Musannaf Ibn Abi Shaybah 36950","","","كتاب الأوائل"
"36951","(۳۶۹۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : أَوَّلُ مَنْ رَأَیْتہ یَمْشِی بَیْنَ الرُّکْنِ الْیَمَانِی وَالْحَجَرِ الأَسْوَدِ عُرْوَۃُ بْنُ الزُّبَیْرِ۔","","Musannaf Ibn Abi Shaybah 36951","","","كتاب الأوائل"
"36952","(۳۶۹۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ حَدَّثَنَا عَوْفٌ قَالَ : قیلَ لِلْحَسَنِ : مَنْ أَوَّلُ مَنْ أَعْتَقَ أُمَّہَاتِ الأَوْلاَدِ ، قَالَ عُمَرُ ، قُلْتُ: فَہَلْ یُرِقُّہُنَّ إنْ زَنَیْنَ ، قَالَ : لاَہَا اللَّہَ إذًا۔","Hasan","Musannaf Ibn Abi Shaybah 36952","","","كتاب الأوائل"
"36953","(۳۶۹۵۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَقِیَ قَوْمًا فِیہِمْ حَادٍ یَحْدُو ، فَلَمَّا رَأَوْا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَکَتَ حَادِیہُمْ ، فَقَالَ : مَنِ الْقَوْمُ ، قَالُوا : مِنْ مُضَرَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَأَنَا مِنْ مُضَرَ ، فَقَالَ : مَا شَأْنُ حَادِیکُمْ لاَ یَحْدُو فَقَالُوا : یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّا أَوَّلُ الْعَرَبِ حُدَائً ، قَالَ : وَمَا ذَاکَ ، قَالُوا : إنَّ رَجُلاً مِنَّا وَسَمَّوْہُ غَزَبَ فِی إِبِلٍ لَہُ فِی أَیَّامِ الرَّبِیعِ ، فَبَعَثَ غُلاَمًا لَہُ مَعَ الإِبِلِ ، فَأَبْطَأَ الْغُلاَمُ ، ثُمَّ جَائَ فَجَعَلَ یَضْرِبُہُ بِعَصًا عَلَی یَدِہِ ، فَانْطَلَقَ الْغُلاَمُ وَہُوَ یَقُولُ : وَایَدَاہُ وَایَدَاہُ ، قَالَ : فَتَحَرَّکَتِ الإِبِلُ وَنَشِطَتْ ، فَقَالَ لَہُ : أَمْسِکْ أَمْسِکْ ، قَالَ : فَافْتَتَحَ النَّاسُ الْحُدَائَ۔","","Musannaf Ibn Abi Shaybah 36953","","","كتاب الأوائل"
"36954","(۳۶۹۵۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالاَ : إنَّ أَوّ[corrupt]لَ مَنْ فَرَضَ الْعَطَائَ عُمَرُ بْنُ الْخَطَّابِ وَفَرَضَ فِیہِ الدِّیَۃَ کَامِلَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 36954","","","كتاب الأوائل"
"36955","(۳۶۹۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : بَعَثَ الْعَلاَئُ بْنُ الْحَضْرَمِیِّ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِثَمَانِ مِئَۃِ أَلْفٍ مِنْ خَرَاجِ الْبَحْرَیْنِ ، وَکَانَ أَوَّلُ خَرَاجٍ قَدِمَ بِہِ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَمَرَ بِہِ فَنُثِرَ عَلَی حَصِیرٍ فِی الْمَسْجِد ، وَأَذَّنَ الْمُؤَذِّنُ فَخَرَجَ إِلَی الصَّلاَۃِ فَصَلَّی ، ثُمَّ جَائَ إِلَی الْمَالِ فَمَثُلَ عَلَیْہِ قَائِمًا فَلَمْ یُعْطِ سَاکِتًا وَلَمْ یَمْنَعْ سَائِلا ، فَجَعَلَ الرَّجُلُ یَجِیئُ فَیَقُولُ : أَعْطِنِی ، فَیَقُولُ : خُذْ قَبْضَۃً ، ثُمَّ یَجِیئُ الرَّجُلُ فَیَقُولُ : أَعْطِنِی ، فَیَقُولُ : خُذْ قَبْضَتَیْنِ ، وَیَجِیئُ الرَّجُلُ فَیَقُولُ : أَعْطِنِی ، فَیَقُولُ : خُذْ ثَلاَثَ قَبَضَاتٍ ، فَجَائَ الْعَبَّاسُ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَعْطِنِی مِنْ ہَذَا الْمَالِ ، فَإِنِّی قد أَعْطَیْت فِدَایَ وَفِدَائَ عَقِیلٍ یَوْمَ بَدْرٍ ، وَلَمْ یَکُنْ لِعَقِیلٍ مَالٌ ، قَالَ : فَأَخَذَ یَبْسُطُ خَمِیصَۃً کَانَتْ عَلَیْہِ ، وَجَعَلَ یَحْثِی مِنَ الْمَالِ ، فَحَثَا فِیہَا ، ثُمَّ قَامَ بِہِ فَلَمْ یُطِقْ حَمْلَہُ ، فَقَالَ : یَا رَسُولَ اللہِ ، احْمِلْ عَلَیَّ ، فَنَظَرَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَتَبَسَّمَ حَتَّی بَدَا ضَاحِکُہُ ، وَقَالَ : أَنْقِصْ مِنَ الْمَالِ وَقُمْ بِقَدْرِ مَا تُطِیقُ ، فَلَمَّا وَلَّی الْعَبَّاسُ ، قَالَ : أَمَّا إحْدَی اللَّتَیْنِ وَعَدَنَا اللَّہُ فَقَدْ أَنْجَزَ لَنَا إحْدَاہُمَا ، وَنَحْنُ نَنْتَظِرُ الأُخْرَی ، قولہ تعالی : {یَا أَیُّہَا النَّبِیُّ قُلْ لِمَنْ فِی أَیْدِیکُمْ مِنَ الأَسْرَی إنْ یَعْلَمَ اللَّہُ فِی قُلُوبِکُمْ خَیْرًا} إِلَی آخِرِ الآیَۃِ ، فَقَدْ أَنْجَزَہَا اللَّہُ لَنَا وَنَحْنُ نَنْتَظِرُ الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 36955","","","كتاب الأوائل"
"36956","(۳۶۹۵۶) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَوَّلُ مَنْ قَاسَ إبْلِیسُ ، وَإِنَّمَا عُبِدَتِ الشَّمْسُ وَالْقَمَرُ بِالْمَقَایِیسِ۔","","Musannaf Ibn Abi Shaybah 36956","","","كتاب الأوائل"
"36957","(۳۶۹۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ ، قَالَ: أَوَّلُ مَا تَکَلَّمَ النَّاسُ فِی الْقَدَرِ جَائَ رَجُلٌ، فَقَالَ : کَانَ فِی قَدَرِ اللہِ ، أَنَّ شَرَارَۃً طَارَتْ فَأَحْرَقَتِ الْبَیْتَ ، فَقَالَ رَجُلٌ : ہَذَا مِنْ قَدَرِ اللہِ ، وَقَالَ آخَرُ : لَیْسَ مِنْ قَدَرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 36957","","","كتاب الأوائل"
"36958","(۳۶۹۵۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : أَوَّلُ مَنْ بَایَعَ تَحْتَ الشَّجَرَۃِ أَبُو سِنَانِ بْنِ وَہْبٍ الأَسَدِیُّ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أُبَایِعُک ، قَالَ : عَلاَمَ تُبَایِعُنِی ، قَالَ : أُبَایِعُک عَلَی مَا فِی نَفْسِکَ ، فَبَایَعَہُ النَّاسُ بَعْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 36958","","","كتاب الأوائل"
"36959","(۳۶۹۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ سَمِعَ سَعْدَ بْنَ أَبِی وَقَّاصٍ یَقُولُ : أَنَا وَاللہِ أَوَّلُ رَجُلٍ مِنَ الْعَرَبِ رَمَی بِسَہْمٍ فِی سَبِیلِ اللہِ عَزَّ وَجَلَّ۔","Sahih","Musannaf Ibn Abi Shaybah 36959","","","كتاب الأوائل"
"36960","(۳۶۹۶۰) حَدَّثَنَا حُسَیْنٌ ، عَنْ زَائِدَۃَ ، حَدَّثَنَا الْمُخْتَارُ بْنُ فُلْفُلٍ ، قَالَ : قَالَ أَنَسٌ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَا أَوَّلُ شَفِیعٍ فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 36960","","","كتاب الأوائل"
"36961","(۳۶۹۶۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْحَسَنِ بن سَعْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ ، قَالَ : أَوَّلُ مَنْ ہَاجَرَ مِنْ ہَذِہِ الأُمَّۃِ رَجُلاَنِ مِنْ قُرَیْشٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36961","","","كتاب الأوائل"
"36962","(۳۶۹۶۲) حَدَّثَنَا الْفَضْلُ حَدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ ، قَالَ : أَخْبَرَنِی یَعْقُوبُ بْنُ مُجَمِّعٍ ، عَنْ أَبِیہِ ، قَالَ : أَوَّلُ مَنْ رَأَیْتہ یُصَلِّی عَلَی نَعْلَیْہِ عُتْبَۃُ بْنُ عُوَیْمِ بْنِ سَاعِدَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 36962","","","كتاب الأوائل"
"36963","(۳۶۹۶۳) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : أَوَّلُ سُورَۃٍ أُنْزِلَتْ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","Sahih","Musannaf Ibn Abi Shaybah 36963","","","كتاب الأوائل"
"36964","(۳۶۹۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ یَقُولُ : أَوَّلُ مَا نَزَلَ مِنَ الْقُرْآنِ {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} ثُمَّ نُونٌ۔","Sahih","Musannaf Ibn Abi Shaybah 36964","","","كتاب الأوائل"
"36965","(۳۶۹۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ : أَخَذْت مِنْ أَبِی مُوسَی : {اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} وَہِیَ أَوَّلُ سُورَۃٍ أُنْزِلَتْ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 36965","","","كتاب الأوائل"
"36966","(۳۶۹۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : ہِیَ أَوَّلُ سُورَۃٍ نَزَلَتْ : (اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} ثُمَّ (ن) ۔","","Musannaf Ibn Abi Shaybah 36966","","","كتاب الأوائل"
"36967","(۳۶۹۶۷) حَدَّثَنَا شَیْخٌ لَنَا ، عَنِ السُّدِّیِّ ، قَالَ : أَوَّلُ مَنْ ثَرَدَ الثَّرِیدَ إبْرَاہِیمُ علیہ السلام۔","","Musannaf Ibn Abi Shaybah 36967","","","كتاب الأوائل"
"36968","(۳۶۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانُ ، عَنْ أَبِی رَبَاحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَوَّلُ مَنْ خَضَبَ بِالسَّوَادِ فِرْعَوْنُ۔","","Musannaf Ibn Abi Shaybah 36968","","","كتاب الأوائل"
"36969","(۳۶۹۶۹) حَدَّثَنَا عُثْمَان بْنُ مَطَر ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، قَالَ : أَوَّلُ مَخْضُوبٍ خُضِبَ فِی الإِسْلاَمِ أَبُو قُحَافَۃَ ، أُرِیَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرَأْسُہُ مِثْلُ الثَّغَامَۃِ ، فَقَالَ : غَیِّرُوہُ بِشَیْئٍ وَجَنِّبُوہُ السَّوَادَ۔","Da'if","Musannaf Ibn Abi Shaybah 36969","","","كتاب الأوائل"
"36970","(۳۶۹۷۰) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا فِطْرٌ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، عَنْ إقَامَۃِ الْمُؤَذِّنِینَ وَاحِدَۃً وَاحِدَۃً ، قَالَ : ذَاکَ شَیْئٌ اسْتَخَفَّتْہُ الأُمَرَائُ۔","","Musannaf Ibn Abi Shaybah 36970","","","كتاب الأوائل"
"36971","(۳۶۹۷۱) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ : مَنْ أَوَّلُ مَنْ سَمَّاہَا الْعَتَمَۃَ ، قَالَ : الشَّیْطَانُ۔","Hasan","Musannaf Ibn Abi Shaybah 36971","","","كتاب الأوائل"
"36972","(۳۶۹۷۲) حَدَّثَنَا عَبْدُ اللہِ ، عَنْ إبْرَاہِیمَ بْنِ سَمْعَانَ بْنِ مُجَمِّعٍ ، عَنْ یَعْقُوبَ بْنِ مَجْمَعٍ ، عَنْ أَبِیہِ مُجَمِّعِ بْنِ زَیْدٍ، قَالَ : أَوَّلُ مَنْ رَأَیْتہ یُصَلِّی فِی النَّعْلَیْنِ عُتْبَۃُ بْنُ عُوَیْمِ بْنِ سَاعِدَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 36972","","","كتاب الأوائل"
"36973","(۳۶۹۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ أَوَّلَ مَنْ أَبْدَأَ الْہِبَۃَ عُثْمَان بْنُ عَفَّانَ وَأَوَّلُ مَنْ سَأَلَ الطَّالِبَ الِبَیِّنَۃَ أَنَّ غَرِیمَہُ مَاتَ وَدَیْنُہُ عَلَیْہِ عُثْمَان بْنُ عَفَّانَ۔","Sahih","Musannaf Ibn Abi Shaybah 36973","","","كتاب الأوائل"
"36974","(۳۶۹۷۴) حَدَّثَنَا مَالِکٌ ، قَالَ : حدَّثَنَا مَسْعُودُ بْنُ سَعْدٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَوَّلُ مَنْ جَمَعَ النَّاسَ عَلَی الصَّلاَۃِ فِی رَمَضَانَ عُمَرُ بْنُ الْخَطَّابِ رضی اللَّہُ عَنْہُ جَمَعَہُمْ عَلَی أُبَیِّ بْنِ کَعْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36974","","","كتاب الأوائل"
"36975","(۳۶۹۷۵) حَدَّثَنَا مَالِکٌ حَدَّثَنَا مَسْعُودُ بْنُ سَعْدٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ الْعَرَبِ کَتَبَ ، یَعْنِی بِالْعَرَبِیَّۃِ حَرْبُ بْنُ أُمَیَّۃَ بْنِ عَبْدِ شَمْسٍ ، قِیلَ مِمَّنْ تَعَلَّمَ ذَلِکَ ، قَالَ : مِنْ أَہْلِ الْحِیرَۃِ ، قَالَ : مِمَّنْ تَعَلَّمَ أَہْلُ الْحِیرَۃِ ، قَالَ : مِنْ أَہْلِ الأَنْبَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 36975","","","كتاب الأوائل"
"36976","(۳۶۹۷۶) حَدَّثَنَا الْفَضْلُ حَدَّثَنَا رَبَاحُ بْنُ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ، قَالَ : طَافَ الْحَارِثُ بْنُ عَبْدِ اللہِ بْنِ أَبِی رَبِیعَۃَ مَعَ عبد الملک بْنِ مَرْوَانَ حَتَّی إذَا کَانَ فِی الطَّوَافِ السَّابِعِ دنا إِلَی الْبَیْتِ یَلْتَزِمُہُ فَأَخَذَ الْحَارِثُ بِیَدِہِ ، فَالْتَفَتَ إلَیْہِ ، فَقَالَ : مَالِکٌ یَا حَارِثُ ، قَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، تَدْرِی مَنْ أَوَّلُ مَنْ فَعَلَ ہَذَا عَجُوزٌ مِنْ عَجَائِزِ قَوْمِکَ ، قَالَ : فَکُفَّ وَلَمْ یلْتَزِمْہ۔","","Musannaf Ibn Abi Shaybah 36976","","","كتاب الأوائل"
"36977","(۳۶۹۷۷) حَدَّثَنَا الْفَضْلُ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : أَوَّلُ کَلِمَۃٍ ، قَالَہَا إبْرَاہِیمُ عَلَیْہِ السَّلاَمُ حِینَ طُرِحَ فِی النَّارِ حَسْبِی اللَّہُ وَنِعْمَ الْوَکِیلُ۔","Sahih","Musannaf Ibn Abi Shaybah 36977","","","كتاب الأوائل"
"36978","(۳۶۹۷۸) حَدَّثَنَا الْفَضْلُ أَخْبَرَنَا الْحَارِثُ بْنُ زِیَادٍ، قَالَ: سَمِعْتُ عَطَائً، قَالَ: أَوَّلُ جَبَلٍ جُعِلَ عَلَی الأَرْضِ أَبُوقُبَیْسٍ۔","","Musannaf Ibn Abi Shaybah 36978","","","كتاب الأوائل"
"36979","(۳۶۹۷۹) حَدَّثَنَا الْفَضْلُ حَدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : قَالَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ : إنَّ أَوَّلَ یَوْمٍ عَرَفْتُ فِیہِ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنِّی أَمْشِی مَعَ أَبِی جَہْلٍ بِمَکَّۃَ ، فَلَقِینَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُ : یَا أَبَا الْحَکَمِ ، ہَلُمَّ إِلَی اللہِ وَإِلَی رَسُولِہِ وَإِلَی کِتَابِہِ أَدْعُوک إِلَی اللہِ ، فَقَالَ : یَا مُحَمَّدُ ، مَا أَنْتَ بِمُنْتَہٍ عَنْ سَبِّ آلِہَتِنَا ، ہَلْ تُرِیدُ إلاَّ أَنْ نَشْہَدَ أَنْ قَدْ بَلَّغْتَ ، فَنَحْنُ نَشْہَدُ أَنْ قَدْ بَلَّغْتَ ، قَالَ : فَانْصَرَفَ عَنْہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَقْبَلَ عَلَیَّ ، فَقَالَ : وَاللہِ إنِّی لأعْلَمُ ، أَنَّ مَا یَقُولُ حَقٌّ وَلَکِنْ بَنِی قُصَیٍّ ، قَالُوا : فِینَا الْحِجَابَۃُ ، فَقُلْنَا : نَعَمْ ، ثُمَّ قَالُوا : فِینَا الْقِرَی ، فَقُلْنَا : نَعَمْ ، ثُمَّ قَالُوا فِینَا النَّدْوَۃُ ، فَقُلْنَا : نَعَمْ ، ثُمَّ قَالُوا فِینَا السِّقَایَۃُ ، فَقُلْنَا نَعَمْ ، ثُمَّ أَطْعَمُوا وَأَطْعَمْنَا حَتَّی إذَا تَحَاکَّتِ الرُّکَبُ ، قَالُوا : مِنَّا نَبِیٌّ وَاللہِ لاَ أَفْعَلُ۔","","Musannaf Ibn Abi Shaybah 36979","","","كتاب الأوائل"
"36980","(۳۶۹۸۰) حَدَّثَنَا الْفَضْلُ ، حَدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: قَدْ عَرَفْت أَوَّلَ النَّاسِ بَحَرَ الْبَحَائِرَ رَجُلٌ مِنْ بَنِی مُدْلِجٍ کَانَتْ لَہُ نَاقَتَانِ فَجَدَعَ آذَانَہُمَا وَحَرَّمَ أَلْبَانَہَا وَظُہُورَہُمَا ، وَلَقَدْ رَأَیْتُہُ وَإِیَّاہُمَا فِی النَّارِ تَخْبِطَانِہِ بِأَخْفَافِہِمَا وَتَقْضِمَانِہِ بِأَفْوَاہِہِمَا ، وَلَقَدْ عَرَفْت أَوَّلَ النَّاسِ سَیَّبَ السَّوَائِبَ وَنَصَبَ النُّصُبَ وَغَیَّرَ عَہْدَ إبْرَاہِیمَ عَمْرُو بْنُ لُحَی ، وَلَقَدْ رَأَیْتہ یَجُرُّ قَصَبَہُ فِی النَّارِ یُؤْذِی أَہْلَ النَّارِ جَرُّ قَصَبِہِ۔ (عبدالرزاق ۱۹۷)","","Musannaf Ibn Abi Shaybah 36980","","","كتاب الأوائل"
"36981","(۳۶۹۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنْ جَرِیرٍ ، أَنَّہُ قَالَ : أَوَّلُ الأَرْضِ خَرَابًا یُسْرَاہَا ، ثُمَّ تَتْبَعُہَا یُمْنَاہَا ، وَالْمَحْشَرُ ہَاہُنَا وَأَنَا بِالأَثَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 36981","","","كتاب الأوائل"
"36982","(۳۶۹۸۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی الْحَارِثِ التَّیْمِیِّ ، عَنْ أَبِی مَاجِدٍ الْحَنَفِیِّ ، قَالَ : کُنْتُ قَاعِدًا عِنْدَ عَبْدِ اللہِ فَأَنْشَأَ یُحَدِّثُنَا ، أَنَّ أَوَّلَ مَنْ قَطَعَ فِی الإِسْلاَمِ ، أَوْ مِنَ الْمُسْلِمِینَ رَجُلٌ مِنَ الأَنْصَارِ۔n(احمد ۳۹۱۔ ابو یعلی ۵۱۳۳)","Da'if","Musannaf Ibn Abi Shaybah 36982","","","كتاب الأوائل"
"36983","(۳۶۹۸۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَزَارَۃَ ، عَنْ مَیْمُونٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَوَّلُ مَنْ سَمَّاہَا الْعَتَمَۃَ : الشَّیْطَانُ۔","Hasan","Musannaf Ibn Abi Shaybah 36983","","","كتاب الأوائل"
"36984","(۳۶۹۸۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ شَدَّادِ بْنِ مَعْقِلٍ ، قَالَ : قَالَ عَبْدُ اللہِ : أَوَّلُ مَا تَفْقِدُونَ مِنْ دِینِکُمَ الأَمَانَۃَ ، وَآخِرُ مَا تَفْقِدُونَ مِنْہُ الصَّلاَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 36984","","","كتاب الأوائل"
"36985","(۳۶۹۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنْ أَبِیہِ ، قَالَ : أَوَّلُ کَلاَمُ تَکَلَّمَ بِہِ عُمَرُ أَنْ قَالَ : اللَّہُمَّ إنِّی ضَعِیفٌ فَقَوِّنِی ، وَإِنِّی شَدِیدٌ فَلَیِّنِی ، وَإِنِّی بَخِیلٌ فَسَخِّنِی۔","Da'if","Musannaf Ibn Abi Shaybah 36985","","","كتاب الأوائل"
"36986","(۳۶۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ زِیَادِ بْنِ حُدَیْرٍ ، قَالَ : أَنَا أَوَّلُ مَنْ عَشَّرَ فِی الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 36986","","","كتاب الأوائل"
"36987","(۳۶۹۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَوَّلُ مَنْ قَطَعَ الرِّجْلَ أَبُو بَکْرٍ۔","","Musannaf Ibn Abi Shaybah 36987","","","كتاب الأوائل"
"36988","(۳۶۹۸۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حَدَّثَنَا عَبْدُ الْجَبَّارِ بْنُ عَبَّاسٍ ، عَنْ عُثْمَانَ الأَعْشَی ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، أَوْ عَنْ حُصَیْنٍ أَخِیہِ أَحَدُہُمَا عَنِ الآخِرِ ، قَالَ : ذَکَرَ سَلْمَانُ خُرُوجَ بَعْضِ أُمَّہَاتِ الْمُؤْمِنِینَ ، فَقَالَ : إِنَّہُ لَفِی کِتَابِ اللہِ الأَوَّلِ ، أَوْ فِی الزَّبُورِ الأَوَّلِ۔","Da'if","Musannaf Ibn Abi Shaybah 36988","","","كتاب الأوائل"
"36989","(۳۶۹۸۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ حَدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُرَّۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ أَرَاْدَ عِلْمًا فَلْینشر الْقُرْآنَ فَإِنَّ فِیہِ خَبَرَ الأَوَّلِینَ وَالآخِرِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 36989","","","كتاب الأوائل"
"36990","(۳۶۹۹۰) حَدَّثَنَا ابْنُ آدَمَ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، أَنَّ عُمَرَ رحمہ اللہ أَوَّلُ مَنْ فَرَضَ الأُعْطِیَۃَ۔","","Musannaf Ibn Abi Shaybah 36990","","","كتاب الأوائل"
"36991","(۳۶۹۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنْ أَبِی إدْرِیسَ ، أَنَّ دَانْیَالَ أَوَّلُ مَنْ فَرَّقَ بَیْنَ الشُّہُودِ۔","","Musannaf Ibn Abi Shaybah 36991","","","كتاب الأوائل"
"36992","(۳۶۹۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : أَوَّلُ مَنْ عَرَّفَ بِالْبَصْرَۃِ ابْنُ عَبَّاسٍ۔","","Musannaf Ibn Abi Shaybah 36992","","","كتاب الأوائل"
"36993","(۳۶۹۹۳) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، وَابْنُ یَمَانٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَوَّلُ مَنْ قَرَأَہَا مَلِکِ مَرْوَانُ۔","","Musannaf Ibn Abi Shaybah 36993","","","كتاب الأوائل"
"36994","(۳۶۹۹۴) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ حَدَّثَنَا أَبُو کُدَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، قَالَ : أَوَّلُ مَنْ جَلَسَ عَلَی الْمِنْبَرِ فِی الْعِیدَیْنِ وَأَذَّنَ فِیہِمَا زِیَادٌ الَّذِی یُقَالُ لَہُ ابْنُ أَبِی سُفْیَانَ۔","","Musannaf Ibn Abi Shaybah 36994","","","كتاب الأوائل"
"36995","(۳۶۹۹۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ رَجُلاً حَدَّثَہُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَوَّلَ لِوَائٍ یَقْرَعُ بَابَ الْجَنَّۃِ لِوَائِی ، وَإِنَّ أَوَّلَ مَنْ یُؤْذَنُ لَہُ فِی الشَّفَاعَۃِ أَنَا ، وَلاَ فَخْرَ۔","","Musannaf Ibn Abi Shaybah 36995","","","كتاب الأوائل"
"36996","(۳۶۹۹۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الْمُخْتَارِ ، قَالَ : قَالَ أَنَسٌ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَا أَوَّلُ شَفِیعٍ فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 36996","","","كتاب الأوائل"
"36997","(۳۶۹۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی حَدَّثَنَا عَبْدُ اللہِ بْنُ سَلاَمٍ ، قَالَ : لَمَّا قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ انْجَفَلَ النَّاسُ قِبَلَہُ وَقِیلَ : قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثًا ، فَجِئْت فِی النَّاسِ لأَنْظُرَ إلَیْہِ ، فَلَمَّا تَبَیَّنْت وَجْہَہُ عَرَفْتُ أَنَّ وَجْہَہُ لَیْسَ بِوَجْہِ کَذَّابٍ ، فَکَانَ أَوَّلُ شَیْئٍ س[corrupt]مِعْتُہُ یَتَکَلَّمُ بِہِ أَنْ قَالَ : یَا أَیُّہَا النَّاسُ ، أَفْشُوا السَّلاَمَ ، وَأَطْعِمُوا الطَّعَامَ ، وَصِلُوا الأَرْحَامَ ، وَصَلُّوا وَالنَّاسُ نِیَامٌ ، تَدْخُلُوا الْجَنَّۃَ بِسَلاَمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 36997","","","كتاب الأوائل"
"36998","(۳۶۹۹۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حَدَّثَنَا سُفْیَانُ ، عَنِ الْمُخْتَارِ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَا أَوَّلُ مَنْ یَقْرَعُ بَابَ الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 36998","","","كتاب الأوائل"
"36999","(۳۶۹۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَا سَیِّدُ وَلَدِ آدَمَ ، وَأَوَّلُ مَنْ تَنْشَقُّ عَنْہُ الأَرْضُ ، وَأَوَّلُ شَافِعٍ وَأَوَّلُ مُشَفَّعٍ۔","","Musannaf Ibn Abi Shaybah 36999","","","كتاب الأوائل"
"37000","(۳۷۰۰۰) حَدَّثَنَا الْفَضْلُ حَدَّثَنَا الْوَلِیدُ بْنُ جُمَیْعٍ ، قَالَ حَدَّثَتْنِی جَدَّتِی ، عَنْ أُمِّ وَرَقَۃَ ابْنَۃِ عَبْدِ اللہِ بْنِ الْحَارِثِ الأَنْصَارِیِّ ، أَنَّ غُلاَمًا لَہَا وَجَارِیَۃً غَمَّاہَا وَقَتَلاَہَا فِی إمَارَۃِ عُمَرَ ، وَأَنَّہُمَا ہَرَبَا ، فَأُتِیَ بِہِمَا عُمَرُ فَصَلَبَہُمَا ، فَکَانَا أَوَّلَ مَصْلُوبَیْنِ بِالْمَدِینَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 37000","","","كتاب الأوائل"
"37001","(۳۷۰۰۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ حُذَیْفَۃَ بْنِ أَسِیدٍ ، قَالَ : آخِرُ مَنْ یُحْشَرُ مِنْ ہَذِہِ الأُمَّۃِ رَجُلاَنِ مِنْ قُرَیْشٍ۔ (مسلم ۱۰۱۰۔ حاکم ۵۶۶)","Sahih","Musannaf Ibn Abi Shaybah 37001","","","كتاب الأوائل"
"37002","(۳۷۰۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : أُخْبِرْت ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ آخِرَ مَنْ یُحْشَرُ مِنْ ہَذِہِ الأُمَّۃِ رَجُلاَنِ مِنْ قُرَیْشٍ۔","","Musannaf Ibn Abi Shaybah 37002","","","كتاب الأوائل"
"37003","(۳۷۰۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَمَتَّعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ وَعُثْمَان ، وَأَوَّلُ مَنْ نَہَی عَنْہُ مُعَاوِیَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 37003","","","كتاب الأوائل"
"37004","(۳۷۰۰۴) حَدَّثَنَا ابْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ کَعْبٍ ، قَالَ : أَوَّلُ مَنْ یَأْخُذُ بِحَلْقَۃِ بَابِ الْجَنَّۃِ فَیُفْتَحُ لَہُ مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 37004","","","كتاب الأوائل"
"37005","(۳۷۰۰۵) حَدَّثَنَا شَاذَانُ ، حَدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حدَّثَنَا زُبَیْدُ بْنُ الْحَارِثِ ، عَنْ عِکْرِمَۃَ ، عَنْ کَعْبٍ ، قَالَ : کَانَ أَوَّلُ مَا نَزَلَ الْقُرْآنُ مِنَ التَّوْرَاۃِ عَشْرَ آیَاتٍ وَہِیَ الْعَشْرُ الَّتِی أُنْزِلَتْ فِی آخِرِ الأَنْعَامِ۔","","Musannaf Ibn Abi Shaybah 37005","","","كتاب الأوائل"
"37006","(۳۷۰۰۶) حَدَّثَنَا أَسْوَدُ بْنُ عَلِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ ، قَالَ : یَکُونُ أَوَّلُ الآیَۃِ عَامًّا وَآخِرُہَا خَاصًّا ، قَرَأَ ہَذِہِ الآیَۃَ : {وَیَوْمَ الْقِیَامَۃِ یُرَدُّونَ إِلَی أَشَدِّ الْعَذَابِ ، وَمَا اللَّہُ بِغَافِلٍ عَمَّا تَعْمَلُونَ}۔","","Musannaf Ibn Abi Shaybah 37006","","","كتاب الأوائل"
"37007","(۳۷۰۰۷) حَدَّثَنَا شَبَابَۃُ حَدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ فِی بَنِی إسْرَائِیلَ وَالْکَہْفِ وَمَرْیَمَ وَطَہ وَالأَنْبِیَائِ : ہُنَّ مِنَ الْعُتُقِ الأُوَلِ وَہُنَّ مِنْ تِلاَدِی۔","Sahih","Musannaf Ibn Abi Shaybah 37007","","","كتاب الأوائل"
"37008","(۳۷۰۰۸) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : مَکْتُوبٌ فِی الْکِتَابِ الأَوَّلِ : مَثَلُ أَبِی بَکْرٍ مَثَلُ الْقَطْرِ حَیْثُمَا وَقَعَ نَفَعَ۔","","Musannaf Ibn Abi Shaybah 37008","","","كتاب الأوائل"
"37009","(۳۷۰۰۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَنَا أَوَّلُ مَنْ تَنْشَقُّ عَنْہُ الأَرْضُ وَأَوَّلُ شَافِعٍ۔","Hasan","Musannaf Ibn Abi Shaybah 37009","","","كتاب الأوائل"
"37010","(۳۷۰۱۰) حَدَّثَنَا أَحْوَصُ بْنُ جواب ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ بَعْجَۃَ ، قَالَ : إنَّ أَوَّلَ ذُلٍّ دَخَلَ عَلَی الْعَرَبِ قَتْلُ الْحُسَیْنِ بْنِ عَلِیٍّ وَادِّعَائُ زِیَادٍ۔","","Musannaf Ibn Abi Shaybah 37010","","","كتاب الأوائل"
"37011","(۳۷۰۱۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ عَمْرٍو حَدَّثَنَا زَائِدَۃُ ، عَنْ سُلَیْمَانَ الأَعْمَشِ ، عَنْ أَبِی خَالِدٍ الْوَالِبِی ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : أَوَّلُ النَّاسِ رَمَی بِسَہْمٍ فِی سَبِیلِ اللہِ تَعَالَی سَعْدٌ۔","Hasan","Musannaf Ibn Abi Shaybah 37011","","","كتاب الأوائل"
"37012","(۳۷۰۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ مِنْ ثَقِیفٍ ، قَالَ : اسْتَشَارَ رَجُلٌ مِنْ ثَقِیفٍ عُمَرَ أَنْ یَحْصِبَ الْمَسْجِدَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّہُ أَوْطَأُ وَأَغْفَرُ لِلنُّخَامَۃِ وَالْمُخَاطِ ، فَقَالَ عُمَرُ : أحْصِبُوہُ مِنَ الْوَادِی الْمُبَارَکِ مِنَ الْعَقِیقِ ، فَکَانَ أَوَّلُ مَنْ حَصَّبَ الْمَسْجِدَ عُمَرُ رضی اللَّہُ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 37012","","","كتاب الأوائل"
"37013","(۳۷۰۱۳) حَدَّثَنَا الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَوَّلُ مَنْ أَحْدَثَ الْقِرَائَۃَ خَلْفَ الإِمَامِ الْمُخْتَارُ ، وَکَانُوا لاَ یَقْرَؤُونَ۔","","Musannaf Ibn Abi Shaybah 37013","","","كتاب الأوائل"
"37014","(۳۷۰۱۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ؛ کان عُمَرُ أَوَّلُ مَنْ جَعَلَ الدِّیَۃَ عَشْرَۃً عَشْرَۃً فِی أَعْطِیَاتِ الْمُقَاتِلَۃِ دُونَ النَّاسِ۔","Hasan","Musannaf Ibn Abi Shaybah 37014","","","كتاب الأوائل"
"37015","(۳۷۰۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ ابن إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی نَجِیحٍ ، وَعَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، قَالاَ : أَوَّلُ مَنْ سَنَّ الصَّلاَۃَ عِنْدَ الْقَتْلِ خُبَیْبُ بْنُ عَدِیٍّ۔","","Musannaf Ibn Abi Shaybah 37015","","","كتاب الأوائل"
"37016","(۳۷۰۱۶) حَدَّثَنَا قَبِیصَۃُ ، عَنِ ابْنِ عُیَیْنَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ صَعْصَعَۃَ ، قَالَ : أَوَّلُ مَنْ جَمَعَ الْقُرْآنَ وَوَرَّثَ الْکَلاَلَۃَ أَبُو بَکْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 37016","","","كتاب الأوائل"
"37017","(۳۷۰۱۷) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَّلُ مَا یُقْضَی بَیْنَ النَّاسِ یَوْمَ الْقِیَامَۃِ فِی الدِّمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 37017","","","كتاب الأوائل"
"37018","(۳۷۰۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقِ بْنِ سَلَمَۃَ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَّلُ مَا یُقْضَی فِیہِ یَوْمَ الْقِیَامَۃِ بَیْنَ النَّاسِ فِی الدِّمَائِ۔ (نسائی ۳۴۵۸)","","Musannaf Ibn Abi Shaybah 37018","","","كتاب الأوائل"
"37019","(۳۷۰۱۹) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَکَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ أُحُدٍ بِالْمُشْرِکِینَ ، فَکَانَ ذَلِکَ أَوَّلَ یَوْمٍ مَکَرَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 37019","","","كتاب الأوائل"
"37020","(۳۷۰۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ حَدَّثَنَا الصَّعْقُ بْنُ حَزْنٍ ، عَنْ أَبِی جمرۃ الضُّبَعِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَوَّلُ الْعَرَبِ ہَلاَکًا قُرَیْشٌ وَرَبِیعَۃُ ، قَالُوا : وَکَیْفَ ، قَالَ : أَمَّا قُرَیْشٌ فَیُہْلِکُہَا الْمُلْک ، وَأَمَّا رَبِیعَۃُ فَتُہْلِکُہَا الْحَمِیَّۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 37020","","","كتاب الأوائل"
"37021","(۳۷۰۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ حَدَّثَنَا ثَابِتُ بْنُ زَیْدٍ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : أَوَّلُ الأَرْضِ خَرَابًا أَرْمِینِیَۃُ ، ثُمَّ مِصْرُ۔","","Musannaf Ibn Abi Shaybah 37021","","","كتاب الأوائل"
"37022","(۳۷۰۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ حَدَّثَنَا یَزِیدُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {سِدْرَۃِ الْمُنْتَہَی} قَالَ : أَوَّلُ یَوْمٍ مِنَ الآخِرَۃِ ، وَآخِرُ یَوْمٍ مِنَ الدُّنْیَا فَہُوَ حَیْثُ یَنْتَہِی۔","","Musannaf Ibn Abi Shaybah 37022","","","كتاب الأوائل"
"37023","(۳۷۰۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَوَّلُ مَا خَلَقَ اللَّہُ الْقَلَمَ ، ثُمَّ خَلَقَ النُّونَ۔ (ابن جریر ۲۹)","Sahih","Musannaf Ibn Abi Shaybah 37023","","","كتاب الأوائل"
"37024","(۳۷۰۲۴) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : أَوَّلُ مَا خَلَقَ اللَّہُ الْقَلَمَ ، وخُلِقَتْ لَہُ النُّونُ وَہِیَ الدَّوَاۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 37024","","","كتاب الأوائل"
"37025","(۳۷۰۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : دَخَلَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْفَضْلُ وَأُسَامَۃُ بْنُ زَیْدٍ وَطَلْحَۃُ بْنُ عُثْمَانَ ، قَالَ ابْنُ عُمَرَ : فَدَخَلْت ، فَکَانَ أَوَّلُ مَنْ لَقِیت بِلاَلاً ، فَقُلْتُ : أَیْنَ صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : بَیْن ہَاتَیْنِ السَّارِیَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 37025","","","كتاب الأوائل"
"37026","(۳۷۰۲۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی جَابِرٍ مُحَمَّدِ بْنِ عُبَیْدٍ الْکِنْدِیِّ ، قَالَ : قَالَ عَلِیٌّ لاِبْنِ الْکَوَّائِ : تَدْرِی مَا قَالَ الأَوَّلُ أَحْبِبْ حَبِیبَک ہَوْنًا مَا عَسَی أَنْ یَکُونَ بَغِیضَک یَوْمًا مَا وَأَبْغِضْ بَغِیضَک ہَوْنًا مَا عَسَی أَنْ یَکُونَ حَبِیبَک یَوْمًا مَا۔","","Musannaf Ibn Abi Shaybah 37026","","","كتاب الأوائل"
"37027","(۳۷۰۲۷) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃَ ، عَنْ أَبِی ذَرٍّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَوَّلُ مَنْ یُبَدِّلُ سُنَّتِی رَجُلٌ مِنْ بَنِی أُمَیَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 37027","","","كتاب الأوائل"
"37028","(۳۷۰۲۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الزَّعْرَائِ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ أَوَّلَ مَا تَفْقِدُونَ مِنْ دِینِکُمَ الأَمَانَۃَ ، وَآخِرُ مَا تَفْقِدُونَ الصَّلاَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 37028","","","كتاب الأوائل"
"37029","(۳۷۰۲۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی الأَسْلَمِیُّ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمِّلِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کَانَ أَوَّلُ إسْلاَمِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : ضَرَبَ أُخْتِی الْمَخَاضُ ، قَالَ : فَأُخْرِجْتُ مِنَ الْبَیْتِ ، فَدَخَلْتُ فِی أَسْتَارِ الْکَعْبَۃِ فِی لَیْلَۃٍ قَارَّۃٍ ، قَالَ : فَجَائَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَخَلَ الْحِجْرَ وَعَلَیْہِ نَعْلاَہُ ، قَالَ : فَصَلَّی مَا شَائَ اللَّہُ ، ثُمَّ انْصَرَفَ ، فَسَمِعْتُ شَیْئًا لَمْ أَسْمَعْ مِثْلَہُ ، فَخَرَجْتُ فَاتَّبَعْتُہُ ، فَقَالَ : مَنْ ہَذَا ، فَقُلْتُ : عُمَرُ ، قَالَ: یَا عُمَرُ ، مَا تَدَعَنْی لَیْلاً، وَلاَ نَہَارًا، قَالَ: فَخَشِیتُ أَنْ یَدْعُوَ عَلَی، فَقُلْتُ: أَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ، وَأَنَّک رَسُولُ اللہِ، فَقَالَ: یَا عُمَرُ، اسْتُرْہُ، قَالَ: فَقُلْتُ: وَالَّذِی بَعَثَک بِالْحَقِّ لأعْلِنَنَّہُ کَمَا أَعْلَنْتُ الشِّرْکَ۔n(مسند ۴۳۲۹۔ ابو نعیم ۳۹)","Da'if","Musannaf Ibn Abi Shaybah 37029","","","كتاب الأوائل"
"37030","(۳۷۰۳۰) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ أَبِیہِ ، عَنْ مُحْرِزِ بْنِ صَالِحٍ ، أَنَّ عَلِیًّا أَوَّلُ مَنْ فَرَّقَ بَیْنَ الشُّہُود۔","Da'if","Musannaf Ibn Abi Shaybah 37030","","","كتاب الأوائل"
"37031","(۳۷۰۳۱) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عُرْوَۃَ بْنِ رُوَیْمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَّلُ مَا نَہَانِی رَبِّی ، عَنْ عِبَادَۃِ الأَوْثَانِ ، وَعَنْ شُرْبِ الْخَمْرِ ، وَعَنْ مُلاَحَاۃِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 37031","","","كتاب الأوائل"
"37032","(۳۷۰۳۲) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِأَعْرَابِیٍّ یَبِیعُ شَیْئًا ، فَقَالَ : عَلَیْک بِأَوَّلِ سَوْمَۃٍ ، أَوْ بِأَوَّلِ السَّوْمِ فَإِنَّ الرِّبْحَ مَعَ السَّمَاحِ۔","","Musannaf Ibn Abi Shaybah 37032","","","كتاب الأوائل"
"37033","(۳۷۰۳۳) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ عَبْدِ الْحَمِیدِ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : قَالَ لِی ابْنُ عَبَّاسٍ : تَعْلَمُ أَیَّ آخِرِ سُورَۃٍ نَزَلَتْ جَمِیعًا قُلْتُ : {إذَا جَائَ نَصْرُ اللہِ وَالْفَتْحُ} قَالَ : صَدَقْت۔","Sahih","Musannaf Ibn Abi Shaybah 37033","","","كتاب الأوائل"
"37034","(۳۷۰۳۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، قَالَ : حدَّثَنِی الزُّہْرِیُّ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، أَنَّ أَبَا سَلَمَۃَ کَانَ ابْنَ عَمَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَانَ أَوَّلَ مَنْ ہَاجَرَ بِظَعِینَتِہِ إِلَی أَرْضِ الْحَبَشَۃِ ، ثُمَّ إِلَی الْمَدِینَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 37034","","","كتاب الأوائل"
"37035","(۳۷۰۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : آخِرُ آیَۃٍ أُنْزِلَتْ فِی الْقُرْآنِ : {یَسْتَفْتُونَک قُلَ اللَّہُ یُفْتِیکُمْ فِی الْکَلاَلَۃِ}۔","Sahih","Musannaf Ibn Abi Shaybah 37035","","","كتاب الأوائل"
"37036","(۳۷۰۳۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ السُّدِّیِّ ، قَالَ : آخِرُ آیَۃٍ أُنْزِلَتْ : {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ} الآیَۃُ۔","","Musannaf Ibn Abi Shaybah 37036","","","كتاب الأوائل"
"37037","(۳۷۰۳۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَطِیَّۃَ الْعَوْفِیِّ ، قَالَ : آخِرُ آیَۃٍ أُنْزِلَتْ : {وَاتَّقُوا یَوْمًا تُرْجَعُونَ فِیہِ إِلَی اللہِ} الآیَۃُ۔","","Musannaf Ibn Abi Shaybah 37037","","","كتاب الأوائل"
"37038","(۳۷۰۳۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مَیْسَرَۃَ أَبِی جَمِیلَۃَ ، قَالَ : إنَّ أَوَّلَ یَوْمٍ تَکَلَّمَتْ فِیہِ الْخَوَارِجُ یَوْمَ الْجَمَلِ۔","","Musannaf Ibn Abi Shaybah 37038","","","كتاب الأوائل"
"37039","(۳۷۰۳۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : إنَّ أَوَّلَ مَنْ طَبَخَ الطِّلاَئَ حَتَّی ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثَہُ عُمَرُ بْنُ الْخَطَّابِ۔","Da'if","Musannaf Ibn Abi Shaybah 37039","","","كتاب الأوائل"
"37040","(۳۷۰۴۰) حَدَّثَنَا حُسَیْنٌ ، عَنْ زَائِدَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَوَّلُ مَا کَتَبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَتَبَ بِاسْمِکَ اللَّہُمَّ ، فَلَمَّا نَزَلَتْ {بِسْمِ اللہِ مَجْرَاہَا وَمُرْسَاہَا} کَتَبَ بِسْمِ اللہِ ، فَلَمَّا نَزَلَتْ: {إِنَّہُ مِنْ سُلَیْمَانَ وَإِنَّہُ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ} کَتَبَ بسم اللہ الرَّحْمَن الرحیم۔","","Musannaf Ibn Abi Shaybah 37040","","","كتاب الأوائل"
"37041","(۳۷۰۴۱) حَدَّثَنَا الْفَضْلُ ، عَنِ ابْنِ أَبِی غَنِیَّۃَ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، قَالَ : قَالَ مُعَاوِیَۃُ : أَنَا أَوَّلُ الْمُلُوکِ۔","Da'if","Musannaf Ibn Abi Shaybah 37041","","","كتاب الأوائل"
"37042","(۳۷۰۴۲) حَدَّثَنَا ابْنُ آدَمَ حَدَّثَنَا إسْرَائِیلُ بْنُ یُونُسَ ، عَنِ ابْنِ أَبِی إِسْحَاقَ ، قَالَ : أَوَّلُ مَنْ خَطَبَ قَاعِدًا مُعَاوِیَۃُ ، قَالَ : ثُمَّ اعْتَذَرَ إِلَی النَّاسِ ، ثُمَّ قَالَ : إنِّی أَشْتَکِی قَدَمِی۔","Sahih","Musannaf Ibn Abi Shaybah 37042","","","كتاب الأوائل"
"37043","(۳۷۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ حَدَّثَنَا الْعَوَّامُ بْنُ حَوْشَبٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إنَّ أوَّلَ مَا یَبْدَأُ الْوَسْوَاسُ مِنَ الْوُضُوئِ۔","","Musannaf Ibn Abi Shaybah 37043","","","كتاب الأوائل"
"37044","(۳۷۰۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ حَدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ أَبِی بشر ، عَنْ مُجَاہِدٍ ، قَالَ : بَدْئُ الْخَلْقِ الْعَرْشُ وَالْمَائُ وَالْہَوَائُ ، وَخُلِقَتِ الأَرْضُ مِنَ الْمَائِ ، وَبَدْئُ الْخَلْقِ یوم الأحد والاِثْنَیْنِ وَالثُّلاَثَائِ وَالأَرْبِعَائِ وَالْخَمِیسِ ، وَجَمْعُ الْخَلْقِ یَوْمُ الْجُمُعَۃِ ، فَتَہَوَّدَتِ الْیَہُودُ یَوْمُ السَّبْتِ ، وَیَوْمٌ مِنَ السِّتَّۃِ الأَیَّامِ کَأَلْفِ سَنَۃٍ مِمَّا تَعُدُّونَ۔ (بیہقی ۸۰۶)","","Musannaf Ibn Abi Shaybah 37044","","","كتاب الأوائل"
"37045","(۳۷۰۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ حَدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : أَتَیْتُ عُمَرَ فِی نَاسٍ من قَوْمِی ، فَجَعَلَ یُفْرَضُ لِرِجَالٍ مِنْ طَیِّئٍ فِی أَلْفَیْنِ ، وَیُعْرِضُ عَنِّی ، فَقُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، أَمَا تَعْرِفُنِی ، فَضَحِکَ حَتَّی اسْتَلْقَی لِقَفَاہُ ، ثُمَّ قَالَ : وَاللہِ إنِّی لأعْرِفُک ، قَدْ آمَنْت إذْ کَفَرُوا ، وَأَقْبَلْت إذْ أَدْبَرُوا ، ثُمَّ أَخَذَ یَعْتَذِرُ ، ثُمَّ قَالَ : إنَّمَا فُرِضَتْ لِقَوْمٍ أَجْحَفَتْ بِہِمَ الْفَاقَۃُ ، وَہُمْ سَرَاۃُ عَشَائِرِہِمْ لِمَا یَنُوبُہُمْ مِنَ الْحُقُوقِ۔ (بخاری ۴۳۹۴۔ مسلم ۱۹۵۷)","Da'if","Musannaf Ibn Abi Shaybah 37045","","","كتاب الأوائل"
"37046","(۳۷۰۴۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیِّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : الشَّامُ أَوَّلُ الأَرْضِ خَرَابًا۔","Sahih","Musannaf Ibn Abi Shaybah 37046","","","كتاب الأوائل"
"37047","(۳۷۰۴۷) حَدَّثَنَا الْفَضْلُ مَالِکُ بْنُ أَنَسٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : أَدْرَکْت النَّاسَ إذَا ذَہَبُوا إِلَی الْجَنَائِزِ ذَہَبُوا مُشَاۃً وَرَجَعُوا مُشَاۃً ، وَأَوَّلُ مَنْ رَکِبَ مُعَاوِیَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 37047","","","كتاب الأوائل"
"37048","(۳۷۰۴۸) حَدَّثَنَا ہَوْذَۃُ حَدَّثَنَا عَوْفٌ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ أَوَّلُ دَعْوَۃِ دَانْیَالَ فِی سَوْسَنَ ، کَانَتْ فَتَاۃً جَمِیلَۃً فِی بَنِی إسْرَائِیلَ مُتَعَبِّدَۃً ، ثُمَّ ذَکَرَ حَدِیثًا فِیہِ طُولٌ۔","","Musannaf Ibn Abi Shaybah 37048","","","كتاب الأوائل"
"37049","(۳۷۰۴۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ : کُنَّ النِّسَائُ الأَوَّلُونَ یَجْعَلْنَ فِی أَکِمَّۃِ أَدْرُعِہِنَّ مَزَارًا تُدْخِلُہُ إحْدَاہُنَّ فِی إصْبَعِہَا تُغَطِّی بِہِ الْخَاتَمَ۔","","Musannaf Ibn Abi Shaybah 37049","","","كتاب الأوائل"
"37050","(۳۷۰۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لِلصَّلاَۃِ أَوَّلاً وَآخِرًا ، ثُمَّ ذَکَرَ فِیہِ حَدِیثًا۔","Sahih","Musannaf Ibn Abi Shaybah 37050","","","كتاب الأوائل"
"37051","(۳۷۰۵۱) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ حَدَّثَنَا أَبو الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَوَّلُ مَنْ یَدْخُلُ مِنْ ہَذِہِ الأُمَّۃِ النَّارَ السَّوَّاطُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 37051","","","كتاب الأوائل"
"37052","(۳۷۰۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَوَّلُ مَنْ طَافَ بِالْبَیْتِ الْمَلاَئِکَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 37052","","","كتاب الأوائل"
"37053","(۳۷۰۵۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : عَلَیْکُمْ بِالسَّمَاعِ الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 37053","","","كتاب الأوائل"
"37054","(۳۷۰۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ تَمِیمٍ الدَّارِیِّ ، قَالَ : أَوَّلُ مَا یُحَاسَبُ بِہِ الْعَبْدُ یَوْمَ الْقِیَامَۃِ الصَّلاَۃُ الْمَکْتُوبَۃُ ، فَإِنْ أَتَمَّہَا وَإِلاَّ قِیلَ : انْظُرُوا ہَلْ لَہُ مَنْ تَطَوَّعْ ، فَأُکْمِلَتِ الْفَرِیضَۃُ مِنْ تَطَوُّعِہِ ، فَإِنْ لَمْ تَکْمُلِ الْفَرِیضَۃُ وَلَمْ یَکُنْ لَہُ تَطَوُّعٌ أُخِذَ بِطَرَفَیْہِ فَقُذِفَ بِہِ فِی النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 37054","","","كتاب الأوائل"
"37055","(۳۷۰۵۵) حَدَّثَنَا عفان ، حَدَّثَنَا ہَمَّامٌ ، حَدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، قَالَ : إن أَوَّلُ یَوْمٍ عَرَفْت فِیہِ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی رَأَیْت شَیْخًا أَبْیَضَ الرَّأْسِ وَاللِّحْیَۃِ عَلَی حِمَارٍ وَہُوَ یَتْبَعُ جِنَازَۃً۔","","Musannaf Ibn Abi Shaybah 37055","","","كتاب الأوائل"
"37056","(۳۷۰۵۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ الضَّبِّیُّ ، عَنْ مَنْصُورٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : أَوَّلُ مَا یُسْأَلُ عَنْہُ الْعَبْدُ یُسْأَلُ عَنْ صَلاَتِہِ ، فَإِنْ تُقُبِّلَتْ مِنْہُ ، تُقَبِّلَ مِنْہُ سَائِرُ عَمَلِہِ ، وَإِنْ رُدَّتْ عَلَیْہِ ، رُدَّ عَلَیْہِ سَائِرُ عَمَلِہِ۔","","Musannaf Ibn Abi Shaybah 37056","","","كتاب الأوائل"
"37057","(۳۷۰۵۷) حَدَّثَنَا عَفَّانُ ، وَابْنُ أَبِی بُکَیْر ، قَالاَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَوَّلُ مَنْ یُکْسَی حُلَّۃً مِنَ النَّارِ إبْلِیسُ ، فَیَضَعُہَا عَلَی حَاجِبِہِ وَیَسْحَبُہَا مِنْ خَلْفِہِ وَہُوَ یَقُولُ : یَا ثُبُورَاہُ ، وَذُرِّیَّتُہُ خَلْفَہُ وَہُمْ یَقُولُونَ : یَا ثُبُورَہُمْ ، حَتَّی یَقِفَ عَلَی النَّارِ فَیَقُولُ : یَا ثُبُورَاہُ ، وَیَقُولُونَ : یَا ثُبُورَہُمْ ، فَیَقُولُ : (لاَ تَدْعُوا الْیَوْمَ ثُبُورًا وَاحِدًا وَادْعُوا ثُبُورًا کَثِیرًا) ۔","Da'if","Musannaf Ibn Abi Shaybah 37057","","","كتاب الأوائل"
"37058","(۳۷۰۵۸) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ عُبَیْدِاللہِ بْنِ إبْرَاہِیمَ ، قَالَ: أَوَّلُ مَنْ أَلْقَی الْحَصَی فِی مَسْجِدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُمَرُ بْنُ الْخَطَّابِ، کَانَ النَّاسُ إذَا رَفَعُوا رُؤُوسَہُمْ مِنَ السُّجُودِ نَفَّضُوا أَیْدِیہمْ فَأَمَرَ بِالْحَصَی فَجِیئَ بِہِ مِنَ الْعَقِیقِ، فَبُسِطَ فِی مَسْجِدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 37058","","","كتاب الأوائل"
"37059","(۳۷۰۵۹) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عِیسَی بْنِ الْمُخْتَارِ ، عَنْ مُحَمَّدِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَقَدْ لَبِثْنَا بالْمَدِینَۃِ سَنَتَیْنِ قَبْلَ أَنْ یَقْدَمَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَعْمُرُ الْمَسَاجِدَ وَنُقِیمُ الصَّلاَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 37059","","","كتاب الأوائل"
"37060","(۳۷۰۶۰) حَدَّثَنَا غُنْدَرٌ ، حَدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ زَیْدِ بْنِ أَرَقْمَ ، قَالَ : أَوَّلُ مَنْ أَسْلَمَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیُّ بْنُ أَبِی طَالِبٍ ، قَالَ : فَذَکَرْت ذَلِکَ لِلنَّخَعِیِّ فَأَنْکَرَہُ ، وَقَالَ : أَبُو بَکْرٍ أَوَّلُ مَنْ أَسْلَمَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Shadh","Musannaf Ibn Abi Shaybah 37060","","","كتاب الأوائل"
"37061","(۳۷۰۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن سَلْمَانَ الْفَارِسِیِّ ، قَالَ : أَوَّلُ مَا خَلَقَ اللَّہُ مِنْ آدَمَ رَأْسَہُ فَجَعَلَ یَنْظُرُ وَہُوَ یَخْلُقُ ، قَالَ : وَبَقِیَتْ رِجْلاَہُ ، فَلَمَّا کَانَ بَعْدَ الْعَصْرِ ، قَالَ : یَا رَبِّ عَجِّلْ قَبْلَ اللَّیْلِ ، فَذَلِکَ قولہ تعالی : (وَکَانَ الإِنْسَاْن عَجُولاً) ۔","","Musannaf Ibn Abi Shaybah 37061","","","كتاب الأوائل"
"37062","(۳۷۰۶۲) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : الْمُہَاجِرُونَ الأَوَّلُونَ مَنْ أَدْرَکَ الْبَیْعَۃَ تَحْتَ الشَّجَرَۃِ۔","","Musannaf Ibn Abi Shaybah 37062","","","كتاب الأوائل"
"37063","(۳۷۰۶۳) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی حَدَّثَنَا إسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّ أَوَّلَ مَنْ بَنَی بَابًا بِمَکَّۃَ عَبْدُ الرَّحْمَنِ بْنُ سُہَیْلٍ ، أَتَی عُمَرَ ، فَقَالَ : إنَّ الرَّجُلَ لَیَنْزِلُ عَلَیْنَا لَیْسَ مَعَہُ خَادِمٌ فَیَتْرُکُ نَعْلَہُ وَنَاقَتَہُ ، ثُمَّ یَخْرُجُ ، وَإِنَّک تُضَمِّنُنَا وَإِنَّا نَخَافُ اللُّصُوصَ ، فَائْذَنْ لِی فَأَجْعَلُ بَابًا ، فَأَذِنَ لَہُ فَتَکَلَّفَتْ قُرَیْشٌ فَجَعَلُوا الأَبْوَابَ۔","","Musannaf Ibn Abi Shaybah 37063","","","كتاب الأوائل"
"37064","(۳۷۰۶۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْوَلِیمَۃُ أَوَّلُ یَوْمٍ حَقٌّ ، وَالثَّانِی مَعْرُوفٌ ، وَمَا وَرَائَ ذَلِکَ فَہُوَ رِیَائٌ۔ (ابو داؤد ۳۷۳۸۔ عبدالرزاق ۱۰۶۶۰)","Hasan","Musannaf Ibn Abi Shaybah 37064","","","كتاب الأوائل"
"37065","(۳۷۰۶۵) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَوَّلُ مَا مُنِعَ الْقَاتِلُ الْمِیرَاثَ لِمَکَانِ صَاحِبِ الْبَقَرَۃِ۔","","Musannaf Ibn Abi Shaybah 37065","","","كتاب الأوائل"
"37066","(۳۷۰۶۶) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عُمَیْرِ بْنِ إِسْحَاقَ ، قَالَ : قیلَ لَہُمْ یَوْمَ بَدْرٍ : تَسَوَّمُوا فَإِنَّ الْمَلاَئِکَۃَ قَدْ تَسَوَّمَتْ ، قَالَ : فَأَوَّلُ مَا جُعِلَ الصُّوفُ ؛ لیَوْمَئِذٍ۔","","Musannaf Ibn Abi Shaybah 37066","","","كتاب الأوائل"
"37067","(۳۷۰۶۷) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ کَثِیرِ بْنِ زَیْدٍ الْمَدِینِیِّ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، قَالَ : لَمَّا مَاتَ عُثْمَان بْنُ مَظْعُونٍ دَفَنَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْبَقِیعِ أَوَّلُ مَنْ دُفِنَ فِیہِ ، ثُمَّ قَالَ لِرَجُلٍ عِنْدَہُ : اذْہَبْ إِلَی تِلْکَ الصَّخْرَۃِ ، فَأْتِنِی بِہَا حَتَّی أَضَعَہَا عِنْدَ قَبْرِہِ حَتَّی أَعْرِفَہُ بِہَا ، فَمَنْ مَاتَ مِنْ أَہْلِنَا دَفَنَّاہُ عِنْدَہُ۔","","Musannaf Ibn Abi Shaybah 37067","","","كتاب الأوائل"
"37068","(۳۷۰۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ فِی الْیَوْمِ الَّذِی یَقُولُ النَّاسُ : إِنَّہُ مِنْ رَمَضَانَ ، قَالَ : فَقَالَ : لاَ یَصُومَنَّ إلاَّ مَعَ الإِمَامِ إذَا صَامَ ، فَإِنَّمَا کَانَتْ أَوَّلُ الْفُرْقَۃِ فِی مِثْلِ ہَذَا۔","","Musannaf Ibn Abi Shaybah 37068","","","كتاب الأوائل"
"37069","(۳۷۰۶۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی إسْرَائِیلَ ، عَنِ الْحَکَمِ ، عَنْ أَبِی سُلَیْمَانَ الْجُہَنِیِّ ، یَعْنِی زَیْدَ بْنَ وَہْبٍ ، عَنْ حُذَیْفَۃَ فَذَکَرَ قَتْلَ عُثْمَانَ ، قَالَ : أَمَا أَنَّہَا أَوَّلُ الْفِتَنِ۔","Da'if","Musannaf Ibn Abi Shaybah 37069","","","كتاب الأوائل"
"37070","(۳۷۰۷۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : أَرَأَیْتُمْ یَوْمَ الدَّارِ کَانَتْ فِتْنَۃً ، یَعْنِی قَتْلَ عُثْمَانَ فَإِنَّہَا أَوَّلُ الْفِتَنِ وَآخِرُہَا الدَّجَّالُ۔","Sahih","Musannaf Ibn Abi Shaybah 37070","","","كتاب الأوائل"
"37071","(۳۷۰۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، قَالَ : أَخْبَرَنَا عَامِرٌ ، أَنَّ أَوَّلَ جَدٍّ خَاصَمَ بَنِی بَنِیہِ عُمَرُ بْنُ الْخَطَّابِ مَاتَ ابْنُہُ وَتَرَکَ ابْنَیْنِ فَخَاصَمَہُمْ إِلَی زَیْدِ بْنِ ثَابِتٍ فَرَآہُ عُمَرُ یَنْظُرُ فِی شَأْنِہِمْ ، فَقَالَ : مَنْ یُخَاصِمُنِی فِی وَلَدِی ، فَقَالَ : زَیْدٌ : إِنَّ لَہُمْ أَبًا دُونَک ، فَشَرَّکَ بَیْنَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 37071","","","كتاب الأوائل"
"37072","(۳۷۰۷۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : حدَّثَنِی أَیُّوبُ ، أَبُو زَیْدٍ الْحِمْصِیُّ ، عَنْ عُبَادَۃَ بْنِ الْوَلِیدِ بْنِ عُبَادَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ دَخَلَ عَلَی عُبَادَۃَ وَہُوَ مَرِیضٌ ، فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَوَّلُ شَیْئٍ خَلَقَ اللَّہُ الْقَلَمَ ، فَقَالَ : اجْرِ ، فَجَرَی تِلْکَ السَّاعَۃَ بِمَا ہُوَ کَائِنٌ۔n(ترمذی ۲۱۵۵۔ احمد ۳۱۷)","Hasan","Musannaf Ibn Abi Shaybah 37072","","","كتاب الأوائل"
"37073","(۳۷۰۷۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ أَوَّلُ مَنْ أَحْدَثَ الأَذَانَ الأَوَّلَ یَوْمَ الْجُمُعَۃِ عُثْمَان لِیُؤْذِنَ أَہْلَ الأسْوَاقِ۔","Da'if","Musannaf Ibn Abi Shaybah 37073","","","كتاب الأوائل"
"37074","(۳۷۰۷۴) حَدَّثَنَا إسْمَاعِیلُ ، یَعْنِی ابْنَ عُلَیَّۃَ ، عَنْ برد ، عَنِ الزُّہْرِیِّ : کَانَ الأَذَانُ عِنْدَ خُرُوجِ الإِمَامِ فَأَحْدَثَ أَمِیرُ الْمُؤْمِنِینَ عُثْمَان التَّأْذِینَۃَ الثَّانِیَۃَ عَلَی الزَّوْرَائِ لِیَجْمَعَ النَّاسَ۔","","Musannaf Ibn Abi Shaybah 37074","","","كتاب الأوائل"
