hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3631","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ ابْنِ وَقَّاصٍ , عَنْ مَلِيحِ بْنِ عَبْدِ اللَّهِ السَّعْدِيِّ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِنَّ الَّذِي يَرْفَعُ رَأْسَهُ قَبْلَ الإِمَامِ , وَيَخْفِضُ قَبْلَهُ فَإِنَّمَا نَاصِيَتُهُ بِيَدِ الشَّيْطَانِ ""","","","","","Book of Prayer"
"3632","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ الْخَطْمِيُّ , قَالَ : حَدَّثَنَا الْبَرَاءُ بْنُ عَازِبٍ وَهُوَ غَيْرُ كَذُوبٍ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا رَفَعَ , وَقَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , لَمْ يَحْنِ مِنَّا رَجُلٌ ظَهْرَهُ حَتَّى يَقَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَاجِدًا , ثُمَّ نَقَعُ سُجُودًا ""","","","","","Book of Prayer"
"3633","عَنِ الثَّوْرِيِّ , عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ , عَنْ نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعَمٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنِّي قَدْ تَبَدَّنْتُ فَلا تُبَادِرْ فِي الْقِيَامِ , وَلا تُبَادِرُوا فِي السُّجُودِ ""","","","","","Book of Prayer"
"3634","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" لا يُرْكَعُ قَبْلَ الإِمَامِ وَلا يُرْفَعُ قَبْلَهُ ""","","","","","Book of Prayer"
"3635","عَنِ ابْنِ عُيَيْنَةَ , عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ هِلالِ بْنِ يَسَافٍ , عَنْ سُحَيْمِ بْنِ نَوْفَلٍ , قَالَ : قَالَ ابْنُ مَسْعُودٍ : \" لا تُبَادِرُوا أَئِمَّتَكُمْ بِالرُّكُوعِ وَلا بِالسُّجُودِ , فَإِنْ سَبَقَ أَحَدٌ مِنْكُمْ فَلْيَضَعْ قَدْرَ مَا يَسْبِقُ بِهِ ""","","","","","Book of Prayer"
"3636","عَنْ عَبْدِ الوَهَّابِ , عَنِ ابْنِ أَبِي ذِئْبٍ , عَنْ يَعْقُوبَ بْنِ عَبْدِ اللَّهِ بْنِ الأَشَجِّ , عَنْ بُسْرِ بْنِ سَعِيدٍ , عَنِ الْحَارِثِ بنِ مَخْلَدٍ , عَنْ أَبِيهِ , قَالَ : قَالَ عُمَرُ : \" أَيُّمَا رَجُلٌ رَفَعَ رَأْسَهُ قَبْلَ الإِمَامِ فِي رُكُوعٍ , أَوْ فِي سُجُودٍ , فَلْيَضَعْ رَأْسَهُ بِقَدْرِ رَفْعِهِ إِيَّاهُ ""","","","","","Book of Prayer"
"3637","عَنْ رَجُلٍ , عَنْ مُحَمَّدِ بْنِ جَابِرٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ بَدْرٍ يُحَدِّثُ , عَنْ عَلِيِّ بْنِ شَيْبَانَ , عَنْ أَبِيهِ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ قَبْلَ الإِمَامِ فَلا صَلاةَ لَهُ","","","","","Book of Prayer"
"3638","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ حَفْصَةَ بِنْتِ سِيرِينَ , عَنْ أَبِي الْعَالِيَةِ , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي بِأَصْحَابِهِ يَوْمًا , فَجَاءَ رَجُلٌ ضَرِيرُ الْبَصَرِ , فَوَقَعَ فِي رَكِيَّةٍ فِيهَا مَاءٌ , فَضَحِكَ بَعْضُ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَلَمَّا انْصَرَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مَنْ ضَحِكَ فَلْيُعِدْ وُضُوءَهُ , ثُمَّ لِيُعِدْ صَلاتَهُ ""","","","","","Book of Prayer"
"3639","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ أَبِي الْعَالِيَةِ الرِّيَاحِيِّ , أَنَّ رَجُلا أَعْمَى تَرَدَّى فِي بِئْرٍ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي بِأَصْحَابِهِ , فَضَحِكَ بَعْضُ مَنْ كَانَ يُصَلِّي مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , \" فَأَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَنْ ضَحِكَ مِنْكُمْ فَلْيُعِدِ الصَّلاةَ \" , قَالَ مَعْمَرٌ : وَأَخْبَرَنِي أَيُّوبُ , عَنْ حَفْصَةَ بِنْتِ سِيرِينَ , عَنْ أَبِي الْعَالِيَةِ , مِثْلَ ذَلِكَ","","","","","Book of Prayer"
"3640","عَنِ الثَّوْرِيِّ , عَنْ خَالِدٍ , عَنْ أُمِّ الْهُذَيْلِ , عَنْ أَبِي الْعَالِيَةِ , قَالَ : بَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي بِالنَّاسِ إِذْ جَاءَ رَجُلٌ فِي بَصَرِهِ سُوءٌ , فَوَقَعَ فِي بِئْرٍ عِنْدَ الْمَسْجِدِ , \" فَأَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَنْ ضَحِكَ فَلْيُعِدِ الْوُضُوءَ , وَلْيُعِدِ الصَّلاةَ ""","","","","","Book of Prayer"
"3641","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا ضَحِكَ الرَّجُلُ فِي الصَّلاةِ اسْتَأْنَفَ الْوُضُوءَ , وَاسْتَأْنَفَ الصَّلاةَ ""","","","","","Book of Prayer"
"3642","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ عَنْ ذَلِكَ , قال : لَيْسَ فِي الضَّحِكِ وُضُوءٌ ""","","","","","Book of Prayer"
"3643","عَنْ مَعْمَرٍ , عَنْ مَطَرٍ الْوَرَّاقِ , عَنْ شُعَيبٍ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : \" إِذَا ضَحِكَ الرَّجُلُ فِي الصَّلاةِ , فَإِنَّهُ يُعِيدُ الصَّلاةَ وَلا يُعِيدُ الْوُضُوءَ \" , عَنِ الثَّوْرِيِّ , عَنْ إِسْمَاعِيلَ , عَنِ الشَّعْبِيِّ مِثْلَهُ","","","","","Book of Prayer"
"3644","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , \" أَنَّهُ رَأَى رَجُلا يَضْحَكُ , فَأَمَرَهُ أَنْ يُعِيدَ الصَّلاةَ ""","","","","","Book of Prayer"
"3645","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , \" أَنَّهُ أَمَرَ أَصْحَابَهُ مِنَ الضَّحِكِ بِإِعَادَةِ الصَّلاةِ , وَلا يُعِيدُ الْوُضُوءَ ""","","","","","Book of Prayer"
"3646","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ ضَحِكْتَ فِي الصَّلاةِ مُتَعَمِّدًا , ثُمَّ قَرْقَرْتَ فَقَدْ قَطَعْتَ صَلاتَكَ \" , قُلْتُ : أَرَأَيْتَ إِنْ ضَحِكْتُ نَاسِيًا فِي سَجْدَتَيْنِ , وَأَنَا أَرَى أَنِّي قَدْ فَرَغْتُ ؟ , قَالَ : \" مَا أَدْرِي لَعَلَّكَ إِنْ أَوْفَيْتَ مَا بَقِيَ عَلَى مَا مَضَى , ثُمَّ سَجَدْتَ سَجْدَتَيِ السَّهْوِ أَنَّ ذَلِكَ يُجْزِئُ عَنْكَ , بَلْ هُوَ قَوْلُهُ يُقْضَى عَنْكَ ""","","","","","Book of Prayer"
"3647","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يَقْطَعُ الصَّلاةَ التَّبَسُّمُ \" , قَالَ : قُلْتُ : أَسْجُدُ مَعَهُ سَجْدَتَيِ السَّهْوِ ؟ , \" إِنْ قَرْقَرْتَ وَلَكَ وِتْرٌ فَاشْفَعْ بِرَكْعَةٍ , ثُمَّ اسْتَقْبِلْ صَلاتَكَ جَدِيدًا ""","","","","","Book of Prayer"
"3648","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا قَرْقَرْتَ مَعَ الإِمَامِ فَقَدْ قَطَعْتَ صَلاتَكَ , فَابْتَدِئْ صَلاتَكَ حِينَئِذٍ مَعَهُ ""","","","","","Book of Prayer"
"3649","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يَقْطَعُ الصَّلاةَ التَّبَسُّمُ \" , قَالَ : قُلْتُ : أَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : \" إِنْ شِئْتَ , وَأَحَبُّ إِلَيَّ أَنْ تَفْعَلَ ""","","","","","Book of Prayer"
"3650","الثَّوْرِيِّ , عَنْ أَبِي الزُّبَيْرِ , عَنْ جَابِرٍ , قَالَ : \" لا يَقْطَعُ الصَّلاةَ التَّبَسُّمُ , وَلَكِنْ يَقْطَعُ الْقَرْقَرَةُ ""","","","","","Book of Prayer"
"3651","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنْ مُجَاهِدٍ , قال : \" لا يَقْطَعُ الصَّلاةَ التَّبَسُّمُ ""","","","","","Book of Prayer"
"3652","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" لا يَقْطَعُ الصَّلاةَ التَّبَسُّمُ حَتَّى يُقَهْقِهَ , أَوْ يُكَرْكِرَ ""","","","","","Book of Prayer"
"3653","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : لَوْ تَبَسَّمْتَ فَبَدَتْ أَسْنَانُكَ , لا يَقْطَعُ ذَلِكَ صَلاتَكَ ""","","","","","Book of Prayer"
"3654","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , قال : \" إِذَا كَشَرَ فَلا يَضُرُّهُ حَتَّى يُكَرْكِرَ \" , قُلْتُ لَهُ : مَا كَشَرَ ؟ , قَالَ : \" تَبَيَّنَ أَسْنَانُهُ ""","","","","","Book of Prayer"
"3655","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَاصِمُ بْنُ عُبَيْدِ اللَّهِ بْنِ عَاصِمٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عَامِرِ بْنِ رَبِيعَةَ , عَنْ أَبِيهِ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِنَّهُ سَتَكُونُ أُمَرَاءُ بَعْدِي , يُصَلُّونَ الصَّلاةَ لِوَقْتِهَا , وَيُؤَخِّرُونَ عَنْ وَقْتِهَا , فَصَلُّوهَا مَعَهُمْ , فَإِنْ صَلُّوهَا لِوَقْتِهَا وَصَلَّيْتُمُوهَا مَعَهُمْ فَلَكُمْ وَلَهُمْ , وَإِنْ أَخَّرُوهَا عَنْ وَقْتِهَا فَصَلَّيْتُمُوهَا مَعَهُمْ فَلَكُمْ وَعَلَيْهِمْ , مَنْ فَارَقَ الْجَمَاعَةَ مَاتَ مَيْتَةً جَاهِلِيَّةً , وَمَنْ نَكَثَ الْعَهْدَ فَمَاتَ نَاكِثًا لِعَهْدِهِ جَاءَ يَوْمَ الْقِيَامَةِ لا حُجَّةَ لَهُ ""","","","","","Book of Prayer"
"3656","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ أَبِي الْعَالِيَةِ , قَالَ : سَأَلْتُ عَبْدَ اللَّهِ بْنَ الصَّامِتِ , وَهُوَ ابْنُ أَخِي أَبِي ذَرٍّ , عَنِ الأُمَرَاءِ إِذَا أَخَّرُوا الصَّلاةَ , فَضَرَبَ رُكْبَتِي , فَقَالَ : سَأَلْتُ أَبَا ذَرٍّ عَنْ ذَلِكَ , فَفَعَلَ بِي كَمَا فَعَلْتُ بِكَ , وَضَرَبَ رُكْبَتِي , وَحَدَّثَنِي أَنَّهُ سَأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَفَعَلَ بِهِ كَمَا فَعَلَ بِي , وَضَرَبَ رُكْبَتَهِ كَمَا ضَرَبَ رُكْبَتِي , فَقَالَ : \" صَلِّ الصَّلاةَ لِوَقْتِهَا \" , قَالَ : \" فَإِنْ أَدْرَكْتُمْ مَعَهُمْ فَصَلُّوا , وَلا يَقُولَنَّ أَحَدُكُمْ : إِنِّي قَدْ صَلَّيْتُ فَلا يُصَلِّي ""","","","","","Book of Prayer"
"3657","عَنِ الثَّوْرِيِّ , عَنْ أَيُّوبَ , عَنْ أَبِي الْعَالِيَةِ , قَالَ : أَخَّرَّ عُبَيْدُ اللَّهِ بْنُ زِيَادٍ الصَّلاةَ , فَسَأَلْتُ عَبْدَ اللَّهِ بْنَ صَامِتٍ , فَضَرَبَ فَخِذِي , ثُمَّ قَالَ : سَأَلْتُ خَلِيلِي أَبَا ذَرٍّ , فَضَرَبَ فَخِذِي , ثُمَّ قَالَ : سَأَلْتُ خَلِيلِي يَعْنِي النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَضَرَبَ فَخِذِي , فَقَالَ : \" صَلِّ الصَّلاةَ لِوَقْتِهَا , فَإِنْ أَدْرَكْتَ فَصَلِّ مَعَهُمْ , وَلا يَقُولَنَّ أَحَدُكُمْ : إِنِّي قَدْ صَلَّيْتُ فَلا يُصَلِّي ""","","","","","Book of Prayer"
"3658","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ هِلالِ بْنِ يَسَافٍ , عَنْ أَبِي الْمُثَنَّى , عَنِ ابْنِ امْرَأَةِ عُبَادَةَ بْنِ صَامِتٍ , عَنْ عُبَادَةَ بْنِ الصَّامِتِ , قَالَ : كُنَّا جُلُوسًا عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : \" إِنَّهَا سَتَجِيءُ أُمَرَاءُ يَشْغَلُهُمْ أَشْيَاءُ حَتَّى لا يُصَلُّوا الصَّلاةَ لِمِيقَاتِهَا \" , فَقَالَ رَجُلٌ : يَا رَسُولَ اللَّهِ , ثُمَّ أُصَلِّي مَعَهُمْ ؟ , قَالَ : \" نَعَمْ ""","","","","","Book of Prayer"
"3659","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَبِي عِمْرَانَ الْجَوْنِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ صَامِتٍ , عَنْ أَبِي ذَرٍّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّهَا سَتَكُونُ أُمَرَاءُ يُصَلُّونَ الصَّلاةَ لِوَقْتِهَا , وَيُؤَخِّرُونَهَا عَنْ وَقْتِهَا , فَصَلُّوا الصَّلاةَ لِوَقْتِهَا , فَإِنْ أَخَّرُوهَا فَقَدْ أَحْرَزْتُمْ صَلاتَكُمْ ""","","","","","Book of Prayer"
"3660","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لأَبِي ذَرٍّ : \" مَا لِي أَرَاكَ . . . ؟ كَيْفَ بِكَ إِذَا أَخْرَجُوكَ مِنَ الْمَدِينَةِ ؟ \" , قَالَ : آتِي الأَرْضَ الْمُقَدَّسَةَ , قَالَ : \" فَكَيْفَ بِكَ إِذَا أَخْرَجُوكَ مِنْهَا ؟ \" , قَالَ : آتِي الْمَدِينَةَ , قَالَ : \" فَكَيْفَ بِكَ إِذَا أَخْرَجُوكَ مِنْهَا ؟ \" , قَالَ : آخُذُ سَيْفِي فَأَضْرِبُ بِهِ , قَالَ : \" فَلا , وَلَكِنِ اسْمَعْ وَأَطِعْ , وَإِنْ كَانَ عَبْدًا أَسْوَدَ \" , قَالَ : فَلَمَّا خَرَجَ أَبُو ذَرٍّ إِلَى الرَّبَذَةِ وَجَدَ بِهَا غُلامًا لِعُثْمَانَ أَسْوَدَ , فَأَذَّنَ وَأَقَامَ , ثُمَّ قَالَ : تَقَدَّمْ يَا أَبَا ذَرٍّ , قَالَ : لا , إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" أَمَرَنِي أَنْ أَسْمَعَ وَأُطِيعَ , وَإِنْ كَانَ عَبْدًا أَسْوَدَ , قَالَ : فَتَقَدَّمَ فَصَلَّى خَلْفَهُ ""","","","","","Book of Prayer"
"3661","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ هِلالِ بْنِ يَسَافٍ , عَنْ أَبِي صُهَيْبٍ , وَأَبِي الْمُثَنَّى , قَالا : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّهُ سَتَكُونُ عَلَيْكُمْ أُمَرَاءُ يُؤَخِّرُونَ الصَّلاةَ , صَلُّوا الصَّلاةَ لِوَقْتِهَا , فَإِذَا أَدْرَكْتُمْ فَصَلُّوا وَاجْعَلُوا صَلاتَكُمْ مَعَهُمْ سُبْحَةً ""","","","","","Book of Prayer"
"3662","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ لأَصْحَابِهِ : \" إِنِّي لا آلُوكُمْ عَنِ الْوَقْتِ , فَصَلَّى بِهِمُ الظُّهْرَ , حَسِبْتُهُ , قَالَ : حِينَ زَالَتِ الشَّمْسُ , ثُمَّ قَالَ : إِنَّهُ سَتَكُونُ عَلَيْكُمْ أُمَرَاءُ يُؤَخِّرُونَ الصَّلاةَ , فَصَلُّوا الصَّلاةَ لِوَقْتِهَا , فَإِنْ أَدْرَكْتُمْ مَعَهُمْ فَصَلُّوا ""","","","","","Book of Prayer"
"3663","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" إِنَّكُمْ فِي زَمَانٍ قَلِيلٍ خُطَبَاؤُهُ , كَثِيرٍ عُلَمَاؤُهُ , يُطِيلُونَ الصَّلاةَ , وَيُقَصِّرُونَ الْخُطْبَةَ , وَإِنَّهُ سَيَأْتِي عَلَيْكُمْ زَمَانٌ كَثِيرٌ خُطَبَاؤُهُ , قَلِيلٌ عُلَمَاؤُهُ , يُطِيلُونَ الْخُطْبَةَ , وَيُؤَخِّرُونَ الصَّلاةَ , حَتَّى يُقَالَ : هَذَا شَرَقُ الْمَوْتَى \" , قَالَ : قُلْتُ لَهُ : وَمَا شَرَقُ الْمَوْتَى ؟ , قَالَ : \" إِذَا اصْفَرَّتِ الشَّمْسُ جِدًّا , فَمَنْ أَدْرَكَ ذَلِكَ فَلْيُصَلِّ الصَّلاةَ لِوَقْتِهَا , فَإِنِ احْتُبِسَ فَلْيُصَلِّ مَعَهُمْ , وَلْيَجْعَلْ صَلاتَهُ وَحْدَهُ الْفَرِيضَةَ , وَلْيَجْعَلْ صَلاتَهُ مَعَهُمْ تَطَوُّعًا ""","","","","","Book of Prayer"
"3664","عَنْ مَعْمَرٍ , عَنْ عَبْدِ اللَّهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ ابْنِ مَسْعُودٍ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" كَيْفَ بِكَ يَا أَبَا عَبْدِ الرَّحْمَنِ , إِذَا كَانَ عَلَيْكَ أُمَرَاءُ يُطْفُونَ السُّنَّةَ , وَيُؤَخِّرُونَ الصَّلاةَ عَنْ مِيقَاتِهَا ؟ \" , قَالَ : فَكَيْفَ تَأْمُرُنِي يَا رَسُولَ اللَّهِ ؟ , قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" تَسْأَلُنِي ابْنَ أُمِّ عَبْدٍ كَيْفَ تَفْعَلُ ! لا طَاعَةَ لِمَخْلُوقٍ فِي مَعْصِيَةِ اللَّهِ ""","","","","","Book of Prayer"
"3665","عَنِ الثَّوْرِيِّ , عَنْ أَبِي حُصَيْنٍ , عَنِ الشَّعْبِيِّ , عَنْ مَهْدِيٍّ , قَالَ : قَالَ ابْنُ مَسْعُودٍ : كَيْفَ أَنْتَ يَا مَهْدِيُّ إِذَا ظُهِرَ بِخِيَارِكُمْ , وَاسْتُعْمِلَ عَلَيْكُمْ أَحْدَاثُكُمْ , وَصُلِّيَتِ الصَّلاةُ لِغَيْرِ مِيقَاتِهَا ؟ , قَالَ : قُلْتُ لا أَدْرِي , قَالَ : \" لا تَكُنْ جَابِيًا , وَلا عَرِيفًا , وَلا شُرْطِيًّا , وَلا بَرِيدًا , وَصَلِّ الصَّلاةَ لِوَقْتِهَا ""","","","","","Book of Prayer"
"3666","عَنْ مَعْمَرٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : أَخَّرَ الْوَلِيدُ بْنُ عُقْبَةَ الصَّلاةَ مَرَّةً , فَأَمَرَ ابْنُ مَسْعُودٍ الْمُؤَذِّنَ فَثَوَّبَ بِالصَّلاةِ , ثُمَّ تَقَدَّمَ فَصَلَّى بِالنَّاسِ , فَأَرْسَلَ إِلَيْهِ الْوَلِيدُ : مَا صَنَعْتَ ؟ أَجَاءَكَ مِنْ أَمِيرِ الْمُؤْمِنِينَ حَدَثٌ أَمِ ابْتَدَعْتَ ؟ \" , قَالَ ابْنُ مَسْعُودٍ : \" وَكُلُّ ذَلِكَ لَمْ يَكُنْ , وَلَكِنْ أَبَى عَلَيْنَا اللَّهُ وَرَسُولُهُ أَنْ نَنْتَظِرَكَ بِصَلاتِنَا وَأَنْتَ فِي حَاجَتِكَ ""","","","","","Book of Prayer"
"3667","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : بَلَغَنِي ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : \" سَيَحْدُثُ بَعْدَكُمْ عُمَّالٌ لا يُصَلُّونَ الصَّلاةَ لِمِيقَاتِهَا , وَإِذَا فَعَلُوا ذَلِكَ فَصَلُّوهَا لِمِيقَاتِهَا ""","","","","","Book of Prayer"
"3668","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَمَا مَا يُؤَخِّرُ الصَّلاةَ حَتَّى يُصَلِّيَهَا مُفَرِّطًا فِيهَا ؟ , قَالَ : \" صَلِّ مَعَهُ الْجَمَاعَةَ أَحَبُّ إِلَيَّ \" , قُلْتُ : فَمَا لَكَ ! أَلا تَنْتَهِي إِلَى قَوْلِ ابْنِ مَسْعُودٍ فِي ذَلِكَ ؟ قَالَ : \" الْجَمَاعَةُ أَحَبُّ إِلَيَّ إِذَا لَمْ تَفُتْ \" , قُلْتُ : وَإِنِ اصْفَرَّتِ الشَّمْسُ لِلْغُرُوبِ وَلَحِقَتْ بِرُءُوسِ الْجِبَالِ ؟ , قَالَ : \" نَعَمْ , مَا لَمْ تَغِبْ ""","","","","","Book of Prayer"
"3669","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنِ النَّخَعِيِّ , وَخَيْثَمَةَ , قال : \" كَانَا يُصَلِّيَانِ الظُّهْرَ وَالْعَصْرَ مَعَ الْحَجَّاجِ وَكَانَ يُمْسِي ""","","","","","Book of Prayer"
"3670","عَنْ مَعْمَرٍ , عَنْ ثَابِتٍ , قال : \" خَطَبَ الْحَجَّاجُ يَوْمَ الْجُمُعَةِ فَأَخَّرَ الصَّلاةَ , فَأَرَادَ إِنْسَانٌ أَنْ يَثِبَ إِلَيْهِ , وَيَحْبِسُهُ النَّاسُ ""","","","","","Book of Prayer"
"3671","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ , وَعَنِ الزُّهْرِيِّ , وعن قتادة \" أَنَّهُمْ كَانُوا يُصَلُّونَ مَعَ الأُمَرَاءِ , وَإِنْ أَخَّرُوا ""","","","","","Book of Prayer"
"3672","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : أَخَّرَ الْوَلِيدُ مَرَّةً الْجُمُعَةَ حَتَّى أَمْسَى , قال : \" فَصَلَّيْتُ الظُّهْرَ قَبْلَ أَنْ أَجْلِسَ , ثُمَّ صَلَّيْتُ الْعَصْرَ وَأَنَا جَالِسٌ وَهُوَ يَخْطُبُ \" , قَالَ : \" أَضَعُ يَدَيَّ عَلَى رُكْبَتِي , وَأُومِئُ بِرَأْسِي ""","","","","","Book of Prayer"
"3673","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ أَبِي إِسْمَاعِيلَ , قَالَ : رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ , وَعَطَاءَ بْنَ أَبِي رَبَاحٍ , قَالَ : \" وَأَخَّرَ الْوَلِيدُ مَرَّةً الصَّلاةَ , فَرَأَيْتُهُمَا يُومِئَانِ إِيمَاءً وَهُمَا قَاعِدَانِ ""","","","","","Book of Prayer"
"3674","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي الضُّحَى , عَنْ مَسْرُوقٍ , : \" أَنَّهُمَا كَانَا يُصَلِّيَانِ الظُّهْرَ إِذَا حَانَتِ الظُّهْرُ , وَإِذَا حَانَتِ الْعَصْرُ صَلَّيَا الْعَصْرَ فِي الْمَسْجِدِ مَكَانَهُمَا , وَكَانَ ابْنُ زِيَادٍ يُؤَخِّرُ الظُّهْرَ وَالْعَصْرَ ""","","","","","Book of Prayer"
"3675","عَنِ الثَّوْرِيِّ , عَنْ عُقْبَةَ , عَنْ أَبِي وَائِلٍ : \" أَنَّهُ كَانَ يَجْمَعُ مَعَ الْمُخْتَارِ الْكَذَّابُ ""","","","","","Book of Prayer"
"3676","عَنْ إِسْرَائِيلَ , عَنْ عَامِرِ بْنِ شَقِيقٍ , عَنْ شَقِيقٍ , قال : \" كَانَ يَأْمُرُنَا أَنْ نُصَلِّيَ الْجُمُعَةَ فِي بُيُوتِنَا , ثُمَّ نَأْتِي الْمَسْجِدَ , وَذَلِكَ أَنَّ الْحَجَّاجَ كَانَ يُؤَخِّرُ الصَّلاةَ ""","","","","","Book of Prayer"
"3677","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" الصَّلاةُ حَسَنَةٌ لا أُبَالِي مَنْ شَارَكَنِي فِيهَا ""","","","","","Book of Prayer"
"3678","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , عَنْ أَبِي جَعْفَرٍ : \" أَنَّ حَسَنًا , وَحُسَيْنًا , كَانَا يُسْرِعَانِ إِذَا سَمِعَا مُنَادِيَ مَرْوَانَ , وَهُمَا يَشْتُمَانِهِ يُصَلِّيَانِ مَعَهُ ""","","","","","Book of Prayer"
"3679","عَنْ أَبِي الأَشْهَبِ , شَيْخٍ مِنْ أَهْلِ الْبَصْرَةِ , قَالَ : سَأَلْتُ يَحْيَى بْنَ أَبِي كَثِيرٍ , وَكَانَتِ الْخَوَارِجُ ظَهَرُوا عَلَيْنَا , فَقُلْتُ : يَا أَبَا نَصْرٍ , كَيْفَ تَرَى فِي الصَّلاةِ خَلْفَ هَؤُلاءِ ؟ , قَالَ \" إِنَّ الْقُرْآنَ إِمَامُكَ , صَلِّ مَعَهُمْ مَا صَلُّوهَا لِوَقْتِهَا ""","","","","","Book of Prayer"
"3680","عَنِ الثَّوْرِيِّ , وَغَيْرِهِ , عَنِ الأَوْزَاعِيِّ , عَنْ عُمَيْرِ بْنِ هَانِئٍ , قَالَ : رَأَيْتُ ابْنَ عُمَرَ , وَابْنَ الزُّبَيْرِ , وَنَجْدَةَ , وَالْحَجَّاجَ , وَابْنُ عُمَرَ , يَقُولُ \" يَتَهَافَتُونَ فِي النَّارِ كَمَا يَتَهَافَتُ الذِّبَّانُ فِي الْمَرَقِ , فَإِذَا سَمِعَ الْمُؤَذِّنَ أَسْرَعَ إِلَيْهِ , يَعْنِي مُؤَذِّنَهُمْ فَيُصَلِّي مَعَهُ ""","","","","","Book of Prayer"
"3681","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِمَامٌ لا يُوفِي الصَّلاةَ , أَعْتَزِلُ الصَّلاةَ ؟ , قال : \" بَلْ صَلِّ مَعَهُ , وَأَوْفِ مَا اسْتَطَعْتَ وَإِنْ قَامَ \" , قُلْتُ : وَكَذَلِكَ إِنْ كَانَ فِي بَادِيَةٍ مَعَ الإِمَامِ , وَلا يُتَمَّمُ , قَالَ : \" وَكَذَلِكَ فَأَتِمَّهُ أَنْتَ \" , قُلْتُ : فَكُنْتُ أَنَا وَرَجُلٌ فِي سَفَرٍ فَوَجَدْنَا , فَكَانَ يَؤُمُّنِي وَلا يُتِمُّ , وَأُصَلِّي وَحْدِي ؟ , قَالَ : \" بَلْ صَلِّ مَعَهُ وَأَوْفِ , اثْنَانِ أَحَبُّ إِلَيَّ مِنْ وَاحِدٍ , وَثَلاثَةٌ أَحَبُّ إِلَيَّ مِنِ اثْنَيْنِ ""","","","","","Book of Prayer"
"3682","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ , عَنْ إِبْرَاهِيمَ , عَنِ الأَعْمَشِ , قَالَ : قُلْتُ لِعَلْقَمَةَ : \" إِمَامُنَا لا يُتِمُّ الصَّلاةَ , فَقَالَ عَلْقَمَةُ : لَكِنَّا نُتِمُّهَا , قَالَ : يَعْنِي نُصَلِّي مَعَهُمْ وَنُتِمُّهَا ""","","","","","Book of Prayer"
"3683","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : قَوْمٌ اجْتَمَعُوا فِي سَفَرٍ قُرَشِيٌّ , وَعَرَبِيٌّ , وَمَوْلًى , وَعَبْدٌ , وَأَعْرَابِيٌّ مِنْ أَهْلِ الْبَادِيَةِ , أَيُّهُمْ يَؤُمُّ أَصْحَابَهُ ؟ , قَالَ : \" كَانَ يَؤُمُّهُمْ أَفْقَهُهُمْ , فَإِنْ كَانُوا فِي الْفِقْهِ سَوَاءً فَأَقْرَؤُهُمْ , فَإِنْ كَانُوا فِي الْفِقْهِ وَالْقِرَاءَةِ سَوَاءً فَأَسَنُّهُمْ \" , قُلْتُ : فَإِنْ كَانُوا فِي الْفِقْهِ وَالْقِرَاءَةِ سَوَاءً , وَكَانَ الْعَبْدُ أَسَنُّهُمْ , أَيَؤُمُّهُمْ لِسِنِّهِ , فَيَؤُمُّ الْقُرَشِيَّ وَغَيْرَهُ ؟ , قَالَ : \" نَعَمْ , وَمَا لَهُمْ لا يَؤُمُّهُمْ أَعْلَمُهُمْ , وَأَقْرَؤُهُمْ , وَأَسَنُّهُمْ مَنْ كَانَ \" , قَالَ : \" وَكَانَ الثَّوْرِيُّ يَعْتَنِي بِهِ ""","","","","","Book of Prayer"
"3684","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا نَافِعٌ , أَنَّهُ سَمِعَ ابْنَ عُمَرَ , يَقُولُ : \" كَانَ سَالِمٌ مَوْلَى أَبِي حُذَيْفَةَ يَؤُمُّ الْمُهَاجِرِينَ الأَوَّلِينَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَالأَنْصَارَ فِي مَسْجِدِ قُبَاء , فِيهِمْ أَبُو بَكْرٍ , وَعُمَرُ , وَأَبُو سَلَمَةَ , وَزَيْدٌ , وَعَامِرُ بْنُ رَبِيعَةَ ""","","","","","Book of Prayer"
"3685","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ إِسْمَاعِيلَ بْنِ رَجَاءٍ , عَنْ أَوْسِ بْنِ ضَمْعَجٍ , عَنْ أَبِي مَسْعُودٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَؤُمُّ الْقَوْمَ أَقْرَؤُهُمْ , فَإِنْ كَانُوا فِي الْقِرَاءَةِ سَوَاءً فَأَقْدَمُهُمْ هِجْرَةً , فَإِنْ كَانُوا فِي الْهِجْرَةِ سَوَاءً فَأَعْلَمُهُمْ بِالسُّنَّةِ , فَإِنْ كَانُوا فِي الْعِلْمِ سَوَاءً فَأَقْدَمُهُمْ سِنًّا , وَلا يَؤُمُّ رَجُلٌ فِي سُلْطَانِهِ , وَلا يُجْلَسُ عَلَى تَكْرِمَتِهِ فِي بَيْتِهِ إِلا أَنْ يَأْذَنَ بِذَلِكَ ""","","","","","Book of Prayer"
"3686","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِسْمَاعِيلَ بْنِ رَجَاءٍ الزُّبَيْدِيِّ , عَنْ أَوْسِ بْنِ ضَمْعَجٍ , عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَحَقُّ الْقَوْمِ أَنْ يَؤُمَّهُمْ أَقْرَؤُهُمْ لِكِتَابِ اللَّهِ , فَإِنْ كَانُوا فِي الْقِرَاءَةِ سَوَاءً فَأَعْلَمُهُمْ بِالسُّنَّةِ , فَإِنْ كَانُوا فِي السُّنَّةِ سَوَاءً فَأَقْدَمُهُمْ هِجْرَةً , فَإِنْ كَانُوا فِي الْهِجْرَةِ سَوَاءً فَأَقْدَمُهُمْ سِنًّا , وَلا يُؤَمَّنَّ رَجُلٌ فِي سُلْطَانِهِ , وَلا يُقْعَدُ عَلَى تَكْرِمَتِهِ فِي بَيْتِهِ إِلا أَنْ يَأْذَنَ لَكَ ""","","","","","Book of Prayer"
"3687","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْمَلِكِ , عَنْ أَنَسِ بْنِ مَالِكٍ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" لا يَؤُمُّ الْقَوْمَ إِلا أَقْرَؤُهُمْ ""","","","","","Book of Prayer"
"3688","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ رَجُلٍ , عَنْ عَمْرِو بْنِ سَلَمَةَ , قَالَ : قَدِمَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَفْدُ جَرْمٍ , فَأَمَرَ عَمْرَو بْنَ سَلَمَةَ أَنْ يَؤُمَّهُمْ , وَكَانَ أَصْغَرَهُمْ سِنًّا , لأَنَّهُ كَانَ أَكْثَرَهُمْ قُرْآنًا ""","","","","","Book of Prayer"
"3689","عَنِ الثَّوْرِيِّ , عَنْ ثَوْرٍ , عَنْ مُهَاجِرِ بْنِ ضَمْرَةَ , قَالَ : اجْتَمَعَ أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ , وَسَعِيدُ بْنُ جُبَيْرٍ , فَقَالَ سَعِيدٌ لأَبِي سَلَمَةَ حَدِّثْ فَإِنَّا سَنَتَّبِعُكَ , فَقَالَ أَبُو سَلَمَةَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا كَانَ ثَلاثَةٌ فِي سَفَرٍ فَلْيَؤُمَّهُمْ أَقْرَؤُهُمْ , فَإِنْ كَانَ أَصْغَرَهُمْ سِنًّا فَإِذَا أَمَّهُمْ فَهُوَ أَمِيرُهُمْ \" , قَالَ أَبُو سَلَمَةَ : فَذَاكُمْ أَمِيرٌ أَمَّرَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"3690","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , عَنِ عُبَيْدِ بْنِ عُمَيْرٍ , قَالَ : لَقِيَ عُمَرُ بْنُ الْخَطَّابِ رَكْبًا يُرِيدُونَ الْبَيْتَ , فَقَالَ : \" مَنْ أَنْتُمْ ؟ \" فَأَجَابَهُمْ أَحْدَثُهُمْ سِنًّا , فَقَالَ : عِبَادُ اللَّهِ الْمُسْلِمُونَ , قَالَ : \" مِنْ أَيْنَ جِئْتُمْ ؟ \" , قَالَ : مِنَ الْفَجِّ الْعَمِيقِ , قَالَ : \" أَيْنَ تُرِيدُونَ ؟ \" , قَالَ : الْبَيْتَ الْعَتِيقَ , قَالَ عُمَرُ : \" تَأَوَّلَهَا لَعَمْرُ اللَّهِ \" , فَقَالَ عُمَرُ : \" مَنْ أَمِيرُكُمْ ؟ \" فَأَشَارَ إِلَى شَيْخٍ مِنْهُمْ , فَقَالَ عُمَرُ : \" بَلْ أَنْتَ أَمِيرُهُمْ \" , لأَحْدَثِهِمْ سِنًّا الَّذِي أَجَابَهُ بِجَيِّدٍ","","","","","Book of Prayer"
"3691","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَفْقَهُ الْقَوْمِ إِنْ قَدَّمَ آخَرَ دُونَهُ ؟ , قَالَ : لا بَأْسَ بِذَلِكَ إِنِّي لأَفْعَلُهُ ""","","","","","Book of Prayer"
"3692","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ عِكْرِمَةَ , عَنْ عَمْرِو بْنِ سَلَمَةَ الْجَرْمِيِّ , قَالَ : \" جَاءَنَا وَفْدٌ مِنْ عِنْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَعَلَّمَهُمُ الصَّلاةَ , ثُمَّ قَالَ لَنَا : لِيَؤُمَّكُمْ أَكْثَرُكُمْ قُرْآنًا , فَكَانَ عَمْرُو بْنُ سَلَمَةَ يَؤُمُّهُمْ وَلَمْ يَكُنِ احْتَلَمَ ""","","","","","Book of Prayer"
"3693","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" صَاحِبُ الرَّبْعِ يَؤُمُّ مَنْ جَاءَهُ \" , قُلْتُ لَهُ : مَا الرَّبْعُ ؟ , قَالَ : \" مَنْزِلُهُ ""","","","","","Book of Prayer"
"3694","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ يُنَاوِلْ هَؤُلاءِ الْقَوْمُ الْقُرَشِيُّ , وَالْعَرَبِيُّ , وَالأَعْرَابِيُّ , وَالْمَوْلَى , وَالْعَبْدُ , وَكَانَ لِكُلِّ امْرِئٍ فُسْطَاطًا , فَانْطَلَقَ أَحَدُهُمْ إِلَى فُسْطَاطِ أَحَدِهِمْ , فَحَانَتِ الصَّلاةُ , مَنْ يَؤُمُّ الْقَوْمَ حِينَئِذٍ ؟ , قَالَ : \" يَؤُمُّهُمْ صَاحِبُ الرَّحْلِ , وَهُوَ حَقُّهُ يُعْطِيهِ مَنْ شَاءَ ""","","","","","Book of Prayer"
"3695","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , \" أَنَّ أَبَا سَعِيدٍ صَنَعَ طَعَامًا , ثُمَّ دَعَا أَبَا ذَرٍّ , وَحُذَيْفَةَ , وَابْنَ مَسْعُودٍ , فَحَضَرَتِ الصَّلاةُ , فَتَقَدَّمَ أَبُو ذَرٍّ لِيُصَلِّيَ بِهِمْ , فَقَالَ لَهُ حُذَيْفَةُ : وَرَاءَكَ رَبُّ الْبَيْتِ أَحَقُّ بِالإِمَامَةِ , فَقَالَ لَهُ أَبُو ذَرٍّ : كَذَلِكَ يَا ابْنَ مَسْعُودٍ ؟ , قَالَ : نَعَمْ , قَالَ : فَتَأَخَّرَ أَبُو ذَرٍّ","","","","","Book of Prayer"
"3696","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ غُلامًا لَمْ يَحْتَلِمْ يُؤْتَى فِي رَبْعِهِ ؟ , قَالَ : \" يَؤُمُّهُمْ إِذَا لَمْ يَحْتَلِمْ , وَلَكِنْ يُقَالُ لَهُ : حَقٌّ , فَإِنْ شَاءَ أَمَّهُمْ بِحَقِّهِ , وَإِنْ شَاءَ أَعْطَى حَقَّهُ غَيْرَهُ مِنْهُمْ ""","","","","","Book of Prayer"
"3697","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ : \" أَنَّ ابْنَ عُمَرَ , قَدِمَ مَكَّةَ , فَأَتَاهُ نَاسٌ فِي مَنْزِلِهِ , فَحَضَرَتِ الصَّلاةُ فَأَمَّهُمْ , فَلَمَّا سَلَّمَ , قَالَ : أَتِمُّوا ""","","","","","Book of Prayer"
"3698","عَنِ ابْنِ عُيَيْنَةَ , عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ مُرَّةَ الْهَمْدَانِيِّ , قَالَ : \" أَتَيْتُ ابْنَ مَسْعُودٍ أَطْلُبُهُ فِي دَارِهِ , فَقِيلَ : هُوَ عِنْدَ أَبِي مُوسَى الأَشْعَرِيِّ , فَأَتَيْتُهُ فَإِذَا عَبْدُ اللَّهِ , وَحُذَيْفَةُ , فَقَالَ عَبْدُ اللَّهِ لِحُذَيْفَةَ : أَنْتَ صَاحِبُ الْكَلامِ ؟ , فَقَالَ حُذَيْفَةُ : إِي وَاللَّهِ , لَقَدْ قُلْتُ ذَلِكَ كَرِهْتُ , أَنْ يُقَالَ : فُلانٌ وَقَرَأَهُ فُلانٌ كَمَا تَفَرَّقَتْ بَنُو إِسْرَائِيلَ , قَالَ : فَأُقِيمَتِ الصَّلاةُ , فَتَقَدَّمَ أَبُو مُوسَى , فَأَمَّهُمْ لأَنَّهُمْ كَانُوا فِي دَارِهِ ""","","","","","Book of Prayer"
"3699","عَنِ الثَّوْرِيِّ , وَإِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ , عَنْ أَبِي نَضْرَةَ , عَنْ أَبِي سَعْدٍ , موْلَى بَنِي أُسَيْدٍ , قال : \" تَزَوَّجْتُ وَأَنَا مَمْلُوكٌ , فَدَعَوْتُ أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَبَا ذَرٍّ , وَابْنَ مَسْعُودٍ , وَحُذَيْفَةَ , فَحَضَرَتِ الصَّلاةُ , فَتَقَدَّمَ حُذَيْفَةُ لِيُصَلِّيَ بِنَا , فَقَالَ لَهُ أَبُو ذَرٍّ أَوْ غَيْرُهُ : لَيْسَ ذَلِكَ لَكَ , فَقَدَّمُونِي وَأَنَا مَمْلُوكٌ فَأَمَمْتُهُمْ ""","","","","","Book of Prayer"
"3700","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنْ كَانَ الْعَبْدُ وَالأَعْرَابِيُّ لا يَقْرَآنِ الْقُرْآنَ , أَيَؤُمَّانِ مَنْ جَاءَهُمَا فِي رَبْعِهِمَا ؟ , قال : \" لا لَعَمْرِي , لا يَؤُمَّانِ \" , قُلْتُ : إِنْ كَانَا يَقْرَآنِ بِأُمِّ الْقُرْآنِ قَطُّ , قَالَ : \" أَخْشَى أَنْ لا يَكُونَ لَهُمَا مَعَهَا فِقْهٌ , وَأَنْ يَكُونَا جَافِيَيِنِ لا يَعْلَمَانِ شَيْئًا ""","","","","","Book of Prayer"
"3701","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي مُلَيْكَةَ , أَنَّهُمْ كَانُوا يَأْتُونَ عَائِشَةَ أُمَّ الْمُؤْمِنِينَ بِأَعْلَى الْوَادِي هُوَ وَأَبُوهُ , وَعُبَيْدُ بْنُ عُمَيْرٍ , وَالْمِسْوَرُ بْنُ مَخْرَمَةَ , وَنَاسٌ كَثِيرٌ , فَيَؤُمُّهُمْ أَبُو عُمَرَ مَوْلَى عَائِشَةَ , وَأَبُو عَمْرٍو غُلامُهَا لَمْ يُعْتِقْ , فَكَانَ إِمَامَ أَهْلِهَا مُحَمَّدِ بْنِ أَبِي بَكْرٍ , وَعُرْوَةَ , وَأَهْلِهِمَا , إِلا عَبْدَ اللَّهِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ كَانَ يَسْتَأْخِرُ عَنْهُ أَبُو عَمْرٍو , قَالَتْ عَائِشَةُ : \" إِذَا غَيَّبَنِي أَبُو عَمْرٍو وَدَلانِي فِي حُفْرَتِي فَهُوَ حُرٌّ ""","","","","","Book of Prayer"
"3702","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ , عَنْ أَبِيهِ , \" أَنَّ عَائِشَةَ كَانَ يَؤُمُّهَا غُلامُهَا , يُقَالُ لَهُ : ذَكْوَانُ \" , قَالَ مَعْمَرٌ , قَالَ أَيُّوبُ : عَنِ ابْنِ أَبِي مُلَيْكَةَ كَانَ يَؤُمُّ مَنْ يَدْخُلُ عَلَيْهَا إِلا أَنْ يَدْخُلَ عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ فَيُصَلِّي بِهَا ""","","","","","Book of Prayer"
"3703","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ عَنِ الْعَبْدِ أَيَؤُمُّ ؟ , قَالَ : \" نَعَمْ , إِذَا أَقَامَ الصَّلاةَ ""","","","","","Book of Prayer"
"3704","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , \" أَنَّ رِجَالا مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" حَسِبْتُهُ , قَالَ : مِنْ أَصْحَابِ بَدْرٍ أُصِيبَتْ أَبْصَارُهُمْ , فَكَانُوا يَؤُمُّونَ عَشَائِرَهُمْ , مِنْهُمْ عَبْدُ اللَّهِ بْنُ أُمِّ مَكْتُومٍ , وَعِتْبَانُ ابْنُ مَالِكٍ , وَمُعَاذُ بْنُ عَفْرَاءَ ""","","","","","Book of Prayer"
"3705","عَنِ الثَّوْرِيِّ , عَنْ أَبِي خَالِدٍ , وَجَابِرٍ , عَنِ الشَّعْبِيِّ , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَخْلَفَ ابْنَ أُمِّ مَكْتُومٍ يَوْمَ غَزْوَةِ تَبُوكَ فَكَانَ يَؤُمُّ النَّاسَ وَهُوَ أَعْمَى ""","","","","","Book of Prayer"
"3706","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سَعْدُ بْنُ إِبْرَاهِيمَ , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا سَافَرَ اسْتَخْلَفَ ابْنَ أُمِّ مَكْتُومٍ عَلَى الْمَدِينَةِ ""","","","","","Book of Prayer"
"3707","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَنْ أُصَدِّقُ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَرَجَ مَخْرَجًا , فَأَمَرَ عَبْدَ اللَّهِ بْنَ أُمِّ مَكْتُومٍ , أَنْ يَؤُمَّ أَصْحَابَهُ , وَمَنْ تَخَلَّفَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الزُّمَنَاءِ , وَمَنْ لا يَسْتَطِيعُ خُرُوجًا ""","","","","","Book of Prayer"
"3708","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سُئِلَ عَطَاءٌ عَنِ الأَعْمَى أَيَؤُمُّ الْقَوْمَ ؟ , فَقَالَ : \" مَا لَهُ إِذَا كَانَ أَفْقَهُهُمْ ؟ \" , فَقَالَ إِنْسَانٌ لِعَطَاءٍ : إِلا أَنْ يُخْطِئَ الْقِبْلَةَ ؟ , قَالَ : قَالَ عَطَاءٌ : \" فَإِنْ أَخْطَأَ فَلْيُعَدِّلُوهُ , فَلْيَؤُمَّهُمْ إِذَا كَانَ أَفْقَهُهُمْ ""","","","","","Book of Prayer"
"3709","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ عَنِ الأَعْمَى هَلْ يَؤُمُّ ؟ , فَقَالَ : \" نَعَمْ , إِذَا أَقَامَ الصَّلاةَ ""","","","","","Book of Prayer"
"3710","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الأَعْلَى , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" كَيْفَ أَؤُمُّهُمْ وَهُمْ يُعَدِّلُونِي إِلَى الْقِبْلَةِ حِينَ عَمِيَ ؟ ""","","","","","Book of Prayer"
"3711","عَنْ أَبِيهِ , عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ سَعِيدِ ابْنِ جُبَيْرٍ , \" أَنَّ ابْنَ عَبَّاسٍ أَمَّهُمْ فِي ثَوْبٍ وَاحِدٍ , وَهُوَ أَعْمَى عَلَى بِسَاطٍ قَدْ طَبَّقَ الْبَيْتَ ""","","","","","Book of Prayer"
"3712","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ : \" كَانَ يَؤُمُّهُمْ وَهُوَ أَعْمَى ""","","","","","Book of Prayer"
"3713","عَنِ ابْنِ جُرَيْجٍ , قال : \" سَأَلَ سُلَيْمَانُ بْنُ مُوسَى عَطَاءً , عَنْ وَلَدِ الزِّنَا , إِذَا كَانَ رِضًا أَيَؤُمُّ الْقَوْمَ ؟ , قَالَ : نَعَمْ , قَالَ سُلَيْمَانُ : وَنَحْنُ نَرَى ذَلِكَ ""","","","","","Book of Prayer"
"3714","عَنِ ابْنِ جُرَيْجٍ , قال : \" إِنَّ عَمْرَو بْنَ دِينَارٍ مَا رَأَى بِذَلِكَ بَأْسًا ""","","","","","Book of Prayer"
"3715","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ عَنْ وَلَدِ الزِّنَا , وَالأَعْرَابِيِّ , وَالْعَبْدِ , وَالأَعْمَى , هَلْ يَؤُمُّونَ ؟ , قال : \" نَعَمْ , إِذَا أَقَامُوا الصَّلاةَ ""","","","","","Book of Prayer"
"3716","عَنِ الثَّوْرِيِّ , عَنْ زُهَيْرِ بْنِ أَبِي ثَابِتٍ , قَالَ : سَمِعْتُ الشَّعْبِيَّ , يَقُولُ : \" وَلَدُ الزِّنَا يَنْكِحُ , وَيُنْكَحُ إِلَيْهِ , وَتَجُوزُ شَهَادَتُهُ وَيَؤُمُّ ""","","","","","Book of Prayer"
"3717","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ : هَلْ يَؤُمُّ وَلَدُ الزِّنَا ؟ , قال : نَعَمْ , وَمَا شَأْنُهُ ؟ \" , قُلْتُ : فَالْمُخَنَّثُ ؟ , قَالَ : \" لا , وَلا كَرَامَةَ , وَلا يُؤْتَمُّ بِهِ ""","","","","","Book of Prayer"
"3718","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يَؤُمُّ الرَّجُلُ أَبَاهُ , وَلا أَخَاهُ أَكْبَرَ مِنْهُ ""","","","","","Book of Prayer"
"3719","أَخْبَرَنَا مَعْمَرٌ , عَنْ ثَابِتٍ الْبُنَانِيِّ , قَالَ : \" كُنْتُ مَعَ أَنَسِ بْنِ مَالِكٍ , وَخَرَجَ مِنْ أَرْضِهِ يُرِيدُ الْبَصْرَةَ , وَبَيْنَهَا وَبَيْنَ الْبَصْرَةِ ثَلاثَةُ أَمْيَالٍ أَوْ ثَلاثَةُ فَرَاسِخَ , فَحَضَرَتِ الصَّلاةُ , فَقَدَّمَ ابْنًا لَهُ , يُقَالُ لَهُ : أَبُو بَكْرٍ , فَصَلَّى بِنَا صَلاةَ الْفَجْرِ , فَقَرَأَ بِسُورَةِ تَبَارَكَ , فَلَمَّا انْصَرَفَ , قَالَ لَهُ : طَوَّلْتَ عَلَيْنَا ""","","","","","Book of Prayer"
"3720","عَنْ سَعِيدِ بْنِ قمَادِيزَ , عَنْ عُثْمَانَ بْنِ أَبِي سُلَيْمَانَ : \" أَنَّ الزُّبَيْرَ كَانَ يُصَلِّي خَلْفَ ابْنِهِ عَبْدِ اللَّهِ ""","","","","","Book of Prayer"
"3721","عَنْ مَعْمَرٍ , \" أَنَّ عَبْدَ اللَّهِ بْنَ الزُّبَيْرِ , كَانَ يَؤُمُّ الزُّبَيْرَ , وَطَلْحَةَ \" , قَالَ : \" وَكَانَ أَبُو بَكْرٍ يَؤُمُّ أَبَاهُ ""","","","","","Book of Prayer"
"3722","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يَؤُمُّ الْغُلامُ الَّذِي لَمْ يَحْتَلِمْ ""","","","","","Book of Prayer"
"3723","الثَّوْرِيُّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَرِهَ أَنْ يَؤُمَّ الْغُلامُ حَتَّى يَحْتَلِمَ ""","","","","","Book of Prayer"
"3724","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ دَاوُدَ بْنِ الْحُصَيْنِ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" لا يَؤُمُّ الْغُلامُ حَتَّى يَحْتَلِمَ وَلْيُؤَذِّنْ لَكُمْ خِيَارُكُمْ ""","","","","","Book of Prayer"
"3725","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ , أَنَّ عَبْدَ الْعَزِيزِ بْنَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ أَخْبَرَهُ , أَنَّ مُحَمَّدَ بْنَ أَبِي سُوَيْدٍ أَقَامَهُ لِلنَّاسِ , وَهُوَ غُلامٌ بِالطَّائِفِ فِي شَهْرِ رَمَضَانَ يَؤُمُّهُمْ , فَكَتَبَ بِذَلِكَ إِلَى عُمَرَ يُبَشِّرُهُ , فَغَضِبَ عُمَرُ , وَكَتَبَ إِلَيْهِ مَا كَانَ نَوْلُكَ أَنْ تُقَدِّمَ لِلنَّاسِ غُلامًا لَمْ تَجِبْ عَلَيْهِ الْحُدُودُ ""","","","","","Book of Prayer"
"3726","عَنْ مَعْمَرٍ , أَنَّ الضَّحَّاكَ بْنَ قَيْسٍ , أَمَرَ غُلامًا , قَبْلَ أَنْ يَحْتَلِمَ فَصَلَّى بِالنَّاسِ , فَقِيلَ لَهُ : لَمَ فَعَلْتَ ذَلِكَ ؟ , قَالَ الضَّحَّاكُ : \" إِنَّ مَعَهُ مِنَ الْقُرْآنِ مَا لَيْسَ مَعِي , فَإِنَّمَا قَدَّمْتُ الْقُرْآنَ \" , قَالَ مَعْمَرٌ : \" وَبَلَغَنِي أَنَّ الإِمَامَ فِي عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي وَلَمْ يَحْتَلِمْ , وَكَانَ أَكْثَرَهُمْ قُرْآنًا ""","","","","","Book of Prayer"
"3727","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , قَالَ : كَانَتِ الْعَرَبُ , تَقُولُ : انْظُرُوا هَذَا مَا يَصْنَعُ وَقَوْمُهُ ؟ يَعْنُونَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمَّا افْتَتَحَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَكَّةَ , جَاءَهُ وُفُودُ النَّاسِ , فَكَانَ غُلامٌ مِنْ جَرْمٍ يُقَالُ لَهُ عَمْرُو بْنُ سَلَمَةَ , كُلَّمَا مَرَّ بِهِ أَحَدٌ مِمَّنْ وَفَدَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَعَلَّمَ مِنْهُ الْقُرْآنَ , قَالَ : وَكَانَ أَكْثَرُ قَوْمِهِ قُرْآنًا , فَكَانَ يَؤُمُّهُمْ وَهُوَ صَبِيٌّ لَمْ يَحْتَلِمْ , وَكَانَ عَلَيْهِ خَلَقُ إِزَارٍ , فَتَقُولُ عَجُوزٌ مِنَ الْحَيِّ : أَلا تَكْسُونَ إِمَامَكُمْ ؟ , قَالَ : فَاشْتَرَوْا لِي إِزَارًا بِثَلاثَةِ دَرَاهِمَ , قَالَ : فَفَرِحْتُ بِهِ فَرَحًا شَدِيدًا","","","","","Book of Prayer"
"3728","أَخْبَرَنَا بْنُ جُرَيْجٍ قَالَ : أَخْبَرَنِي نَافِعٌ , قَالَ : \" أُقِيمَتِ الصَّلاةُ فِي مَسْجِدٍ بِطَائِفَةِ الْمَدِينَةِ , قَالَ : وَلِعَبْدِ اللَّهِ بْنِ عُمَرَ قَرِيبًا مِنْ ذَلِكَ الْمَسْجِدِ أَرْضٌ يَعْمَلُهَا , قَالَ : وَإِمَامُ أَهْلِ ذَلِكَ الْمَسْجِدِ مَوْلَى , وَمَسْكَنُ ذَلِكَ الْمَوْلَى وَأَصْحَابِهِ ثَمَّ , فَلَمَّا سَمِعَهُمْ عَبْدُ اللَّهِ بْنُ عُمَرَ , وَأَقَامُوا الصَّلاةَ جَاءَ يَشْهَدُ مَعَهُمُ الصَّلاةَ , فَقَالَ الْمَوْلَى صَاحِبُ الْمَسْجِدِ لابْنِ عُمَرَ : تَقَدَّمْ فَصَلِّ , فَقَالَ عَبْدُ اللَّهِ : أَنْتَ أَحَقُّ أَنْ تُصَلِّيَ فِي مَسْجِدِكَ , فَصَلَّى الْمَوْلَى ""","","","","","Book of Prayer"
"3729","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" رَجُلٌ مُسَافِرٌ مَرَّ بِأَهْلِ مَاءٍ , فَحَضَرَتِ الصَّلاةُ , فَقَدَّمُوهُ , لَيْسَ لَهُمْ إِمَامٌ أَيَؤُمُّهُمْ ؟ , قَالَ : لا بَأْسَ بِذَلِكَ ""","","","","","Book of Prayer"
"3730","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , قَالَ : سَمِعْتُ عُبَيْدَ بْنِ عُمَيْرٍ , يَقُولُ : \" اجْتَمَعَتْ جَمَاعَةٌ فِي بَعْضِ مَاءٍ حَوْلَ مَكَّةَ , قَالَ : حَسِبْتُ , أَنَّهُ قَالَ : بِأَعْلَى الْوَادِي هَهُنَا , قَالَ : وَفِي الْحَجِّ , فَحَانَتِ الصَّلاةُ , فَتَقَدَّمَ رَجُلٌ مِنْ آلِ أَبِي السَّائِبِ الْمَخْزُومِيِّ أَعْجَمِيِّ اللِّسَانِ , قَالَ : فَأَخَّرَهُ الْمِسْوَرُ بْنُ مَخْرَمَةَ , وَقَدَّمَ غَيْرَهُ , وَتَغَيَّبَ عُمَرُ بْنُ الْخَطَّابِ فَلَمْ يَعَرِّفْهُ بِشَيْءٍ حَتَّى جَاءَ الْمَدِينَةَ , فَلَمَّا جَاءَ الْمَدِينَةَ عَرَّفَهُ بِذَلِكَ , فَقَالَ الْمِسْوَرُ : أَنْظِرْنِي يَا أَمِيرَ الْمُؤْمِنِينَ , إِنَّ الرَّجُلَ كَانَ أَعْجَمِيَّ اللِّسَانِ , وَكَانَ فِي الْحَجِّ , فَخَشِيتُ أَنْ يَسْمَعَ بَعْضُ الْحَاجِّ قِرَاءَتَهُ فَيَأْخُذُ بِعُجْمَتِهِ , قَالَ : أَوَ هُنَالِكَ ذَهَبْتَ ؟ , قَالَ : نَعَمْ , قَالَ : أَصَبْتَ ""","","","","","Book of Prayer"
"3731","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنْسَانٌ يُؤْتَى فِي رَبْعِهِ فَيَؤُمُّ الْقَوْمَ , فَإِذَا هُوَ يَقْرَأُ شَيْئًا مِنَ الْقُرْآنِ , وَيَسْجَعُ مَعَ ذَلِكَ , قَالَ : \" فَلا يَؤُمَّكَ فَلا تُصَلِّ مَعَهُمْ , وَإِنْ كَانَ يَخْلِطُ مِنَ الْقُرْآنِ مِنْ هَهُنَا وَهَهُنَا فَصَلِّ بِصَلاتِهِ ""","","","","","Book of Prayer"
"3732","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , \" أَنَّ ابْنَ مَسْعُودٍ مَرَّ بِأَهْلِ مَاءٍ وَقَدْ أُقِيمَتِ الصَّلاةُ , فَدَخَلَ مَعَهُمْ , فَأَمَّهُمْ إِنْسَانٌ مِنْهُمْ , فَقَرَأَ , وَأَلْحَقَ فِي قِرَاءَتِهِ : نَحُجُّ بَيْتَ رَبِّنَا وَنَقْضِي الدِّينَ , وَزَادَ غَيْرُ قَتَادَةَ : وَهُنَّ كَالْقَطَوَاتِ يَهْوِينَ , فَقَالَ ابْنُ مَسْعُودٍ : مَا سَمِعْنَا بِهَذَا فِي الْمِلَّةِ الآخِرَةِ إِنْ هَذَا إِلا اخْتِلاقٌ , قَالَ : فَنَكَصَ الأَعْرَابِيُّ , وَتَقَدَّمَ ابْنُ مَسْعُودٍ فَصَلَّى بِهِمْ ""","","","","","Book of Prayer"
"3733","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ رَجُلٍ مِنْ طَيِّئٍ , قَالَ : \" مَرَّ ابْنُ مَسْعُودٍ عَلَى مَسْجِدٍ لَنَا , فَتَقَدَّمَ رَجُلٌ مِنْهُمْ فَقَرَأَ بِفَاتِحَةِ الْكِتَابِ , ثُمَّ قَالَ : نَحُجُّ بَيْتَ رَبِّنَا وَنَقْضِي الدِّينَ , وَهُوَ مِثْلُ الْقَطَوَاتِ يَهْوِينَ , فَقَالَ عَبْدُ اللَّهِ : مَا سَمِعْنَا بِهَذَا فِي الْمِلَّةِ الآخِرَةِ إِنْ هَذَا إِلا اخْتِلاقٌ , قَالَ : فَانْصَرَفَ عَبْدُ اللَّهِ ""","","","","","Book of Prayer"
"3734","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أُخْبِرْتُ أَنَّ حُمَيْدَ بْنَ الْحِمْيَرِيِّ , قَالَ : صَلَّى ابْنُ مَسْعُودٍ وَرَاءَ الأَعْرَابِيِّ , فَقَرَأَ الأَعْرَابِيُّ أُمَّ الْقُرْآنِ , فَلَمَّا خَتَمَهَا , وَقَالَ :  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ , قَالَ : نَحُجُّ بَيْتَ رَبِّنَا وَنَقْضِيهِ الدِّينَ , عَلَى مِثْلِ الْقَطَوَاتِ يَهْوِينَ , قَالَ ابْنُ مَسْعُودٍ : مَا سَمِعْنَا بِهَذَا فِي الْمِلَّةِ الآخِرَةِ إِنْ هَذَا إِلا اخْتِلاقٌ , قَالَ : فَاسْتَأْخَرَ الأَعْرَابِيُّ , حَتَّى تَقَدَّمَ ابْنُ مَسْعُودٍ , عَلِمَ أَنَّهُ أَفْقَهُ مِنْهُ , فَقَالَ ابْنُ مَسْعُودٍ : مَا رَأَيْتُ أَعْرَابِيًّا أَفْقَهَ مِنْهُ ""","","","","","Book of Prayer"
"3735","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَلَيْسَ إِنْ شَاءَ الإِمَامُ أَمَّ النَّاسَ فِيمَا يُرْفَعُ بِهِ الصَّوْتُ مِنَ الْقِرَاءَةِ , رَفَعَ بِأُمِّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ قَطُّ لا يَزِيدُ عَلَيْهَا ؟ , قَالَ : بَلَى , وَأَحَبُّ إِلَيَّ أَنْ يَرْفَعَ بِهِمَا بِسُورَةٍ ""","","","","","Book of Prayer"
"3736","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاء : كَانَ يُؤْمَرُ الإِمَامُ بِرَفْعِ الصَّوْتِ بِالْقُرْآنِ ؟ , قَالَ : \" نَعَمْ , وَقَدْ كَانَ الزُّبَيْرُ يَرْفَعُ صَوْتَهُ بِالْقِرَاءَةِ حَتَّى أَنَّ لِقِرَاءَتِهِ فِي الْمَسْجِدِ لَلَجَّةً \" , قُلْتُ : أَرَأَيْتَ لَوْ أَنَّ رَجُلا إِمَامًا لَمْ يَزِدْ عَلَى أَنْ يُسْمِعَهُمُ الشَّيْءَ ؟ , قَالَ : \" حَسْبُهُ ""","","","","","Book of Prayer"
"3737","عَنِ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ أَبِي سُهَيْلِ بْنِ مَالِكٍ , عَنْ أَبِيهِ , قَالَ : \" كَانَتْ تُسْمَعُ قِرَاءَةُ عُمَرَ فِي صَلاةِ الصُّبْحِ مِنْ دَارِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ""","","","","","Book of Prayer"
"3738","عَنْ مَالِكٍ , عَنْ عَمِّهِ أَبِي سُهَيْلِ بْنِ مَالِكٍ , عَنْ أَبِيهِ , قَالَ : \" كَانَتْ قِرَاءَةُ عُمَرَ تُسْمَعُ مِنَ الْبَلاطِ ""","","","","","Book of Prayer"
"3739","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" بِتُّ لَيْلَةً عِنْدَ خَالَتِي مَيْمُونَةَ , فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مُتَطَوِّعًا مِنَ اللَّيْلِ , فَقَامَ إِلَى الْقِرْبَةِ فَتَوَضَّأَ , ثُمَّ قَامَ يُصَلِّي , فَقُمْتُ لَمَّا رَأَيْتُهُ صَنَعَ ذَلِكَ , فَتَوَضَّأْتُ مِنَ الْقِرْبَةِ , ثُمَّ قُمْتُ إِلَى الشِّقِّ الأَيْسَرِ , فَأَخَذَ بِيَدِي وَرَاءَ ظَهْرِهِ , فَعَدَّلَنِي كَذَلِكَ مِنْ وَرَاءِ ظَهْرِهِ إِلَى الشِّقِّ الأَيْمَنِ \" , قُلْتُ : أَفِي التَّطَوُّعِ كَانَ ذَلِكَ ؟ , قَالَ : \" نَعَمْ ""","","","","","Book of Prayer"
"3740","عَنِ الثَّوْرِيِّ , عَنْ سَلَمَةَ بْنِ كُهَيْلٍ , عَنْ كُرَيْبٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : نِمْتُ عِنْدَ خَالَتِي مَيْمُونَةَ ابْنَةَ الْحَارِثِ , فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ اللَّيْلِ , فَأَتَى الْحَاجَةَ , ثُمَّ جَاءَ فَغَسَلَ وَجْهَهُ وَيَدَيْهِ , ثُمَّ نَامَ \" , قَالَ : \" ثُمَّ قَامَ يُصَلِّي مِنَ اللَّيْلِ , فَأَتَى الْقِرْبَةَ فَتَوَضَّأَ وُضُوءًا بَيْنَ وُضُوئَيْنِ , لَمْ يُكْثِرْ وَقَدْ أَبْلَغَ , ثُمَّ قَامَ فَصَلَّى \" , قَالَ : \" وَتَمَطَّيْتُ كَرَاهِيَةَ أَنْ يَرَى أَتَّقِيهِ يَعْنِي أُرَاقِبُهُ , ثُمَّ قُمْتُ فَفَعَلْتُ كَمَا فَعَلَ , فَقُمْتُ عَنْ يَسَارِهِ , فَأَخَذَ يُمَائِلُ إِذْنِي حَتَّى أَدَارَنِي , فَكُنْتُ عَنْ يَمِينِهِ وَهُوَ يُصَلِّي \" , قَالَ : \" فَتَتَامَّتْ صَلاتُهُ ثَلاثَ عَشْرَةَ رَكْعَةً , مِنْهَا رَكْعَتَا الْفَجْرِ , ثُمَّ اضْطَجَعَ فَنَامَ حَتَّى نَفَخَ , ثُمَّ جَاءَ بِلالٌ فَآذَنَهُ بِالصَّلاةِ , فَقَامَ فَصَلَّى وَلَمْ يَتَوَضَّأْ \" , وَزَادَنِي يَحْيَى فِي هَذَا الْحَدِيثِ , عَنِ الثَّوْرِيِّ , عَنْ سَلَمَةَ بْنِ كُهَيْلٍ , عَنْ كُرَيْبٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كَانَ فِي دُعَائِهِ اللَّهُمَّ اجْعَلْ فِي قَلْبِي نُورًا , وَفِي سَمْعِي نُورًا , وَفِي بَصَرِي نُورًا , وَعَنْ يَمِينِي نُورًا , وَعَنْ يَسَارِي نُورًا , وَمِنْ فَوْقِي نُورًا , وَمِنْ تَحْتِي نُورًا , وَمِنْ بَيْنِ يَدَيَّ نُورًا , وَمِنْ خَلْفِي نُورًا , وَأَعْظِمْ لِي نُورًا \" , قَالَ كُرَيْبٌ : \" وَسِتَّ عِنْدِي فِي التَّابُوتِ وَعَصَبِي , وَمُخِّي , وَدَمِي , وَشَعْرِي , وَبَشَرِي , وَعِظَامِي ""","","","","","Book of Prayer"
"3741","عَنِ الثَّوْرِيِّ , قَالَ : ذَكَرَ لَنَا عَنِ ابْنِ عَبَّاسٍ , أَنَّهُ ذَكَرَ لَهُ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَامَ , فَقَالَ : إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُحْفَظُ , فَقَالَ بَعْضُ الْفُقَهَاءِ , أَنَّهُ قَالَ : \" إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَنَامُ عَيْنَهُ وَلا يَنَامُ قَلْبُهُ ""","","","","","Book of Prayer"
"3742","عَنْ مَالِكٍ , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ , عَنْ أَبِي سَلَمَةَ , عَنْ عَائِشَةَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" تَنَامُ عَيْنَايَ وَلا يَنَامُ قَلْبِي ""","","","","","Book of Prayer"
"3743","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ سُمَيْعٍ الزَّيَّاتُ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كُنْتُ قُمْتُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَدَارَنِي فَجَعَلَنِي عَنْ يَمِينِهِ \" , قَالَ سُفْيَانُ : \" فِي تَطَوَّعٍ ""","","","","","Book of Prayer"
"3744","عَنْ مَالِكٍ , عَنْ مَخْرَمَةَ بْنِ سُلَيْمَانَ , عَنْ كُرَيْبٍ , أَنَّ ابْنَ عَبَّاسٍ أَخْبَرَهُ , أَنَّهُ بَاتَ عِنْدَ خَالَتُهِ مَيْمُونَةَ , قَالَ : \" وَاضْطَجَعْتُ فِي عَرَضِ الْوِسَادَةِ , وَاضْطَجَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَهْلُهُ فِي طُولِهَا , فَنَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى انْتَصَفَ اللَّيْلُ , أَوْ قَبْلَهُ بِقَلِيلٍ , أَوْ بَعْدَهُ بِقَلِيلٍ , ثُمَّ أَسْتَيْقِظَ فَجَلَسَ , فَمَسَحَ النَّوْمَ عَنْ وَجْهِهِ بِيَدَيْهِ , ثُمَّ قَرَأَ الْعَشْرَ الآيَاتِ الْخَوَاتِمَ مِنْ سُورَةِ آلِ عِمْرَانَ , ثُمَّ قَامَ إِلَى شَنٍّ مُعَلَّقٍ , فَتَوَضَّأَ مِنْهَا فَأَحْسَنَ وُضُوءَهُ , ثُمَّ قَامَ يُصَلِّي , فَصَنَعْتُ مِثْلَ مَا صَنَعَ , ثُمَّ ذَهَبْتُ فَقُمْتُ إِلَى جَنْبِهِ , فَوَضَعَ يَدَيْهِ عَلَى رَأْسِي , وَأَخَذَ بِأُذُنِي يَفْتِلُهَا , ثُمَّ صَلَّى رَكْعَتَيْنِ , ثُمَّ رَكْعَتَيْنِ , ثُمَّ رَكْعَتَيْنِ , ثُمَّ رَكْعَتَيْنِ , ثُمَّ أَوْتَرَ , فَاضْطَجَعَ حَتَّى جَاءَ الْمُؤَذِّنُ , فَقَامَ فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ , ثُمَّ خَرَجَ فَصَلَّى الصُّبْحَ ""","","","","","Book of Prayer"
"3745","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , قال : \" صَلَّيْتُ مَعَ أَبِي فَقَامَتِ امْرَأَتُهُ خَلْفَنَا ""","","","","","Book of Prayer"
"3746","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كُنْتُ فِي بَيْتِ مَيْمُونَةَ , فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ , فَقُمْتُ مَعَهُ عَلَى يَسَارِهِ , فَأَخَذَ بِيَدِي فَجَعَلَنِي عَنْ يَمِينِهِ , ثُمَّ صَلَّى ثَلاثَ عَشْرَةَ رَكْعَةً , حَزَرْتُ قِيَامَهُ فِي كُلِّ رَكْعَةٍ قَدْرَ : يَأَيُّهَا الْمُزَّمِّلُ ""","","","","","Book of Prayer"
"3747","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ مَوْلَى ابْنِ عُمَرَ , \" أَنَّهُ قَامَ وَحْدَهُ إِلَى يَسَارِ ابْنِ عُمَرَ , فَجَرَّ بِيَمِينِهِ حَتَّى جَرَّهُ إِلَى شِقِّهِ الأَيْمَنِ ""","","","","","Book of Prayer"
"3748","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَرَأَيْتَ الرَّجُلَ يُصَلِّي مَعَهُ الرَّجُلُ قَطُّ فَأَيْنَ يَكُونُ مِنْهُ ؟ , قَالَ : كَذَلِكَ إِلَى شِقِّهِ الأَيْمَنِ , قُلْتُ : أَيُحَاذِي بِهِ حَتَّى يُصَفَّ مَعَهُ لا يَفُوتُ أَحَدُهُمَا الآخَرَ ؟ , قَالَ : نَعَمْ , قَالَ : قُلْتُ : أَيَجِبُ أَنْ يَلْصَقَ بِهِ حَتَّى لا يَكُونُ بَيْنَهُمَا فُرْجَةٌ ؟ , قَالَ : \" نَعَمْ , هَا اللَّهِ إِذًا ""","","","","","Book of Prayer"
"3749","عَنْ مَعْمَرٍ , عَنْ ثَابِتٍ الْبُنَانِيِّ , قَالَ : \" صَلَّيْتُ مَعَ أَنَسِ بْنِ مَالِكٍ فَأَقَامَنِي عَنْ يَمِينِهِ , وَقَامَتْ جَمِيلَةُ أُمُّ وَلَدِهِ خَلْفَنَا ""","","","","","Book of Prayer"
"3750","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي الرَّجُلَيْنِ يَكُونُ مَعَهُمَا الْمَرْأَةُ , قال : \" يَقُومُ الرَّجُلُ عَنْ يَمِينِ صَاحِبِهِ , وَتَقُومُ الْمَرْأَةُ خَلْفَهُمَا \" , عَنِ الثَّوْرِيِّ , مِثْلَ قَوْلِ قَتَادَةَ","","","","","Book of Prayer"
"3751","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يَقُومُ الرَّجُلُ إِلَى رُكْنِ الإِمَامِ , وَالْمَرْأَتَانِ وَرَاءَهُمَا \" , قُلْتُ : فَنِسْوَةٌ ؟ , قَالَ : \" وَكَذَلِكَ أَيْضًا , الرَّجُلُ إِلَى رُكْنِ الرَّجُلِ , وَالنِّسْوَةُ وَرَاءَهُمَا ""","","","","","Book of Prayer"
"3752","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنْ عِكْرِمَةَ , قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" صَلَّيْتُ إِلَى جَنْبِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَعَائِشَةُ خَلْفَنَا تُصَلِّي مَعَنَا , وَأَنَا إِلَى جَنْبِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نُصَلِّي مَعَهُ ""","","","","","Book of Prayer"
"3753","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ , قال : \" يَقُومُ أَحَدُ الرَّجُلَيْنِ خَلْفَ الآخَرِ , وَالْمَرْأَةُ خَلْفَهُمَا ""","","","","","Book of Prayer"
"3754","عَنْ مَالِكٍ , عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ , عَنْ أَنَسِ بْنِ مَالِكٍ , عَنْ جَدَّتِهِ مُلَيْكَةَ يَعْنِي جَدَّةَ إِسْحَاقَ , \" أَنَّهَا دَعَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِطَعَامٍ صَنَعَتْهُ , فَأَكَلَ , ثُمَّ قَالَ : قُومُوا فَلْنُصَلِّ لَكُمْ \" , قَالَ : فَقُمْتُ إِلَى حَصِيرٍ لَنَا قَدِ اسْوَدَّ مِنْ طُولِ مَا لُبِسَ , فَنَضَحْتُهُ بِمَاءٍ , فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَصَفَفْتُ أَنَا وَالْيَتِيمُ وَرَاءَهُ , وَالْعَجُوزُ مِنْ وَرَائِنَا , فَصَلَّى لَنَا رَكْعَتَيْنِ ثُمَّ انْصَرَفَ ""","","","","","Book of Prayer"
"3755","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ كَانُوا ثَلاثَةً ؟ , قَالَ : \" يَقُولُ نَاسٌ : يَقُومُ اثْنَانِ إِلَى رُكْنِهِ , وَيَقُومُ آخِرٌ وَرَاءَهُ \" , قَالَ : قُلْتُ : فَكَيْفَ تَقُولُ أَنْتَ ؟ , قَالَ : \" أَقُولُ الثَّلاثَةُ جَمَاعَةٌ , فَإِذَا كَانُوا ثَلاثَةً فَلْيَؤُمَّهُمْ أَحَدُهُمْ , وَلْيَتَأَخَّرِ اثْنَانِ , فَلْيَقُومَا ""","","","","","Book of Prayer"
"3756","عَنِ ابْنِ جُرَيْجٍ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ , قَالَ : \" يُصَلِّيَانِ وَرَاءَهُ ""","","","","","Book of Prayer"
"3757","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , أَنَّ عُمَرَ , قَالَ : \" إِذَا كَانُوا ثَلاثَةً أَقَامَ رَجُلَيْنِ خَلْفَهُ \" , عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي الشَّعْثَاءِ , مِثْلَ قَوْلِ ابْنِ عُمَرَ","","","","","Book of Prayer"
"3758","عَنْ هِشَامٍ , عَنِ الْحَسَنِ , قال : الثَّلاثَةُ جَمَاعَةٌ ""","","","","","Book of Prayer"
"3759","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , \" أَنَّ عَلْقَمَةَ , وَالأَسْوَدَ , أَقْبَلا مَعَ ابْنِ مَسْعُودٍ إِلَى مَسْجِدٍ , فَاسْتَقْبَلَهُمُ النَّاسُ قَدْ صَلُّوا , فَرَفَعَ بِهِمَا إِلَى الْبَيْتِ , فَجَعَلَ أَحَدَهُمَا عَنْ يَمِينِهِ , وَالآخَرَ عَنْ شِمَالِهِ , ثُمَّ صَلَّى بِهِمَا ""","","","","","Book of Prayer"
"3760","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ , \" أَنَّ عَبْدَ اللَّهِ صَلَّى بِعَلْقَمَةَ , وَالأَسْوَدَ , فَقَامَ هَذَا عَنْ يَمِينِهِ , وَهَذَا عَنْ شِمَالِهِ , ثُمَّ قَامَ بَيْنَهُمَا ""","","","","","Book of Prayer"
"3761","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ ابْنُ مَسْعُودٍ : \" إِذَا كَانُوا ثَلاثَةً فَلْيَصُفُّوا جَمِيعًا , وَإِذَا كَانُوا أَكْثَرَ مِنْ ذَلِكَ فَلْيَتَقَدَّمْ أَحَدُهُمْ ""","","","","","Book of Prayer"
"3762","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : الثَّلاثَةُ جَمَاعَةٌ \" , وَذَكَرَهُ هِشَامٌ , عَنِ الْحَسَنِ أَيْضًا","","","","","Book of Prayer"
"3763","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ فِي الإِمَامِ يَحْضُرُهُ الصَّلاةُ , وَلَيْسَ مَعَهُ غَيْرَ رَجُلٍ وَاحِدٍ , قال : \" يُقِيمُهُ عَنْ يَمِينِهِ , فَإِذَا جَاءَ ثَالِثٌ تَأَخَّرَ وَقَامَا خَلْفَهُ ""","","","","","Book of Prayer"
"3764","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , عَنْ أَبِيهِ , قَالَ : \" دَخَلْتُ عَلَى عُمَرَ بْنِ الْخَطَّابِ وَهُوَ يُصَلِّي فِي الْهَاجِرَةِ تَطَوُّعًا , فَأَقَامَنِي حِذْوَهُ عَنْ يَمِينِهِ , فَلَمْ يَزَلْ كَذَلِكَ حَتَّى دَخَلَ يَرْفَأُ مَوْلاهُ , فَتَأَخَّرْتُ الصُّفُوفَ , فَصَفَفْنَا خَلْفَ عُمَرَ ""","","","","","Book of Prayer"
"3765","عَنْ مَعْمَرٍ , عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ , \" أَنَّ أَبَاهُ عَبْدَ اللَّهِ بْنَ عُتْبَةَ , دَخَلَ عَلَى عُمَرَ , فَوَجَدَهُ يُصَلِّي التَّطَوُّعَ , فَقَامَ إِلَى يَسَارِهِ , فَأَخَّرَهُ عُمَرُ إِلَى يَمِينِهِ , فَجَاءَ يَرْفَأُ مَوْلَى عُمَرَ , فَتَأَخَّرْتُ مَعَهُ , فَصَلَّيْتُ أَنَا وَيَرْفَأُ وَرَاءَهُ ""","","","","","Book of Prayer"
"3766","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا أُقِيمَتِ الصَّلاةُ وَلَيْسَ فِي الْمَسْجِدِ غَيْرُ الإِمَامِ وَرَجُلٌ , قَامَ خَلْفَهُ مَا بَيْنَهُ وَبَيْنَ الرَّكْعَةِ , فَإِنْ جَاءَ أَحَدٌ وَإِلا تَقَدَّمَ عَنْ يَمِينِهِ \" , قَالَ : وَقَالَ الشَّعْبِيُّ : \" يَقُومُ عَنْ يَمِينِهِ , وَقَوْلُ الشَّعْبِيِّ أَحَبُّ إِلَى سُفْيَانَ ""","","","","","Book of Prayer"
"3767","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" كُنْتُ أَقُومُ خَلْفَ الأَسْوَدِ حَتَّى يَنْزِلَ الْمُؤَذِّنُ ""","","","","","Book of Prayer"
"3768","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , قال : \" يَقُومُ عَنْ يَمِينِهِ ""","","","","","Book of Prayer"
"3769","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" مَنْ أَمَّ قَوْمًا , وَهُمْ لَهُ كَارِهُونَ لَمْ تُجَاوِزْ صَلاتُهُ تَرْقُوَتَهُ ""","","","","","Book of Prayer"
"3770","عَنِ الثَّوْرِيِّ , وَإِسْمَاعِيلَ , عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ , عَنْ إِبْرَاهِيمَ , قال : \" كُنْتُ أَقُومُ خَلْفَ عَلْقَمَةَ حَتَّى يَنْزِلَ الْمُؤَذِّنُ ""","","","","","Book of Prayer"
"3771","عَنِ الثَّوْرِيِّ , عَنْ إِسْمَاعِيلَ , عَنِ الْحَسَنِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" مَنْ أَمَّ قَوْمًا , وَهُمْ لَهُ كَارِهُونَ لَمْ تُجَاوِزْ صَلاتُهُ تَرْقُوَتَهُ \" , عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Prayer"
"3772","عَنْ إِسْمَاعِيلَ , أَوْ غَيْرِهِ , \" أَنَّ شُرَيْحًا , كَانَ يَؤُمُّ قَوْمَهُ , فَلَمَّا كَانَ مِنْ حُجْرِ بْنِ عَدِيٍّ مَا كَانَ , فَإِنَّهُمُ اتَّهَمُوا شُرَيْحًا فِي أَمَرَهِ , فَلَمَّا تَقَدَّمَ يُصَلِّي بِهِمْ , قَالُوا : تَأَخَّرْ , فَقَالَ : أَكُلُّكُمْ عَلَى هَذَا ؟ , قَالُوا : نَعَمْ ! فَاسْتَأْخَرَ شُرَيْحٌ ""","","","","","Book of Prayer"
"3773","عَنِ الثَّوْرِيِّ , عَنْ حَبِيبِ بْنِ أَبِي عَمْرَةَ , قال : رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ يُصَلِّي فِي طَاقِ الإِمَامِ , قَالَ : وَرَأَيْتُ مَعْمَرًا إِذَا أَمَّنَا يُصَلِّي فِي طَاقِ الإِمَامِ ""","","","","","Book of Prayer"
"3774","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , وَالأَعْمَشِ , ، عَنْ إِبْرَاهِيمَ , \" كَانَ يَكْرَهُ أَنْ يُصَلِّيَ فِي طَاقِ الإِمَامِ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ مِثْلَهُ , قَالَ الثَّوْرِيُّ : \" وَنَحْنُ نَكْرَهُهُ ""","","","","","Book of Prayer"
"3775","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , قَالَ : رَأَيْتُ الْحَسَنَ جَاءَ إِلَى ثَابِتٍ الْبُنَانِيِّ , قَالَ : أَرَاهُ زَارَهُ , قَالَ : فَحَضَرَتِ الصَّلاةُ , فَقَالَ ثَابِتٌ : تَقَدَّمْ يَا أَبَا سَعِيدٍ , فَقَالَ الْحَسَنُ : \" أَنْتَ , فَأَنْتَ أَحَقُّ \" , قَالَ ثَابِتٌ : وَاللَّهِ لا أَتَقَدَّمُكَ أَبَدًا , قَالَ : \" فَتَقَدَّمَ الْحَسَنُ , وَاعْتَزَلَ الطَّاقَ أَنْ يُصَلِّيَ فِيهِ \" , قَالَ ابْنُ التَّيْمِيِّ : \" وَرَأَيْتُ أَبِي , وَلَيْثًا يَعْتَزِلانِهِ ""","","","","","Book of Prayer"
"3776","عَنِ ابْنِ التَّيْمِيِّ , عَنْ لَيْثٍ , قَالَ : سَمِعْتُ الضَّحَّاكَ بْنَ مُزَاحِمٍ , يَقُولُ : \" أَوَّلُ شِرْكٍ كَانَ فِي هَذِهِ الضَّلالَةِ هَذِهِ الْمَحَارِيبَ ""","","","","","Book of Prayer"
"3777","عَنِ الثَّوْرِيِّ , عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ , عَنْ عُبَيْدِ بْنِ أَبِي الْجَعْدِ الأَشْجَعِيِّ , عَنْ كَعْبٍ , قال : \" يَكُونُ فِي آخِرِ الزَّمَانِ قَوْمٌ يُنْقَصُ أَعْمَارُهُمْ , وَيُزَيِّنُونَ مَسَاجِدَهُمْ , وَيَتَّخِذُونَ بِهَا مَذَابِحَ كَمَذَابِحِ النَّصَارَى , فَإِذَا فَعَلُوا ذَلِكَ صُبَّ عَلَيْهِمُ الْبَلاءُ ""","","","","","Book of Prayer"
"3778","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ مُجَاهِدٍ , قَالَ : رَأَى سُلَيْمَانُ حُذَيْفَةَ يَؤُمُّهُمْ عَلَى دُكَّانٍ مِنْ جِصٍّ , فَقَالَ : \" تَأَخَّرْ , فَإِنَّمَا أَنْتَ رَجُلٌ مِنَ الْقَوْمِ , فَلا تَرْفَعْ نَفْسَكَ عَلَيْهِمْ \" , فَقَالَ : \" صَدَقْتَ ""","","","","","Book of Prayer"
"3779","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ مُجَاهِدٍ , أَوْ غَيْرِهِ , شَكَّ أَبُو بَكْرٍ , \" أَنَّ ابْنَ مَسْعُودٍ ,  أَوْ قَالَ : أَبَا مَسْعُودٍ أَنَا أَشُكُّ , وَسُلَيْمَانَ , وَحُذَيْفَةَ صَلَّى بِهِمْ أَحَدُهُمْ , فَذَهَبَ يُصَلِّي عَلَى دُكَّانٍ , فَجَبَذَهُ صَاحِبَاهُ , وَقَالا : انْزِلْ عَنْهُ ""","","","","","Book of Prayer"
"3780","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ عَبْدِ اللَّهِ , عَنْ شُعْبَةَ , عَنْ أَبِي قَيْسٍ , عَنْ هُزَيْلِ بْنِ شُرَحْبِيلَ , قَالَ : : \" جَاءَنَا ابْنُ مَسْعُودٍ إِلَى مَسْجِدِنَا , فَأُقِيمَتِ الصَّلاةُ , فَقِيلَ لَهُ : تَقَدَّمْ , فَقَالَ : لِيَؤُمَّكُمْ إِمَامُكُمْ , قِيلَ لَهُ : إِنَّ الإِمَامَ لَيْسَ هَاهُنَا , قَالَ : فَلْيَتَقَدَّمْ رَجُلٌ مِنْكُمْ , فَتَقَدَّمَ , فَأَرَادَ أَنْ يَقُومَ عَلَى شِبْهِ دُكَّانٍ , فَنَهَاهُ عَبْدُ اللَّهِ ""","","","","","Book of Prayer"
"3781","أَخْبَرَنَا عُتْبَةُ بْنُ مُحَمَّدِ بْنِ الْحَارِثِ , أَنَّ كُرَيْبًا , مَوْلَى ابْنِ عَبَّاسٍ أَخْبَرَهُ , \" أَنَّهُ رَأَى ابْنَ عَبَّاسٍ يُصَلِّي فِي الْمَقْصُورَةِ مَعَ مُعَاوِيَةَ ""","","","","","Book of Prayer"
"3782","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ الْهُذَلِيِّ , قَالَ : \" رَأَيْتُ أَنَسَ بْنَ مَالِكٍ يُصَلِّي مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي الْمَقْصُورَةِ ""","","","","","Book of Prayer"
"3783","أَخْبَرَنَا مَعْمَرٌ , قَالَ : \" أَخْبَرَنِي مَنْ رَأَى أَنَسًا , وَالْحَسَنَ يُصَلِّيَانِ فِي الْمَقْصُورَةِ , قَالَ : وَرَأَيْتُ أَنَا مَعْمَرًا يُصَلِّي فِي الْمَقْصُورَةِ ""","","","","","Book of Prayer"
"3784","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , قال : \" رَأَيْتُ الْحَسَنَ فِي الْمَقْصُورَةِ يُصَلِّي غَيْرَ مَرَّةٍ , يَخْفِقُ بِرَأْسِهِ ثُمَّ يَقُومُ فَيُصَلِّي , وَلا يَتَوَضَّأُ ""","","","","","Book of Prayer"
"3785","عَنِ الثَّوْرِيِّ , عَنْ خُصَيْفٍ الذَّيَّاكِ , قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الْمَقْصُورَةِ , فَقال : \" إِنَّمَا فَعَلُوا ذَلِكَ مَخَافَةَ أَنْ يَطْعَنُوهُمْ ""","","","","","Book of Prayer"
"3786","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ الأَحْنَفَ بْنَ قَيْسٍ , كَانَ لا يُصَلِّي فِي الْمَقْصُورَةِ , وَيَقُولُ : \" هِيَ حِمًى \" , وَكَانَ لا يَنَامُ فِي السُّرَادِقِ , وَيَقُولُ : \" لَمْ يُذْكَرِ السُّرَادِقُ إِلا لأَهْلِ النَّارِ ""","","","","","Book of Prayer"
"3787","عَنْ رَجُلٍ , عَنْ مُحَمَّدِ بْنِ جَابِرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , \" أَنَّهُ كَانَ يَكْرَهُ , أَنْ يُصَلِّيَ فِي الْمَقْصُورَةِ \" , قَالَ : وَقَالَ حَمَّادٌ : \" الصَّفُّ الأَوَّلُ الَّذِي يَلِي الْمَقْصُورَةَ ""","","","","","Book of Prayer"
"3788","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : \" مَنَ صَلَّى الْمَكْتُوبَةَ , ثُمَّ بَدَا لَهُ أَنْ يَتَطَوَّعَ فَلْيَتَكَلَّمْ , أَوْ فَلْيَمْشِ , وَلْيُصَلِّ أَمَامَ ذَلِكَ \" , قَالَ : وَقَالَ ابْنُ عَبَّاسٍ : \" إِنِّي لأَقُولُ لِلْجَارِيَةِ : انْظُرِي كَمْ ذَهَبَ مِنَ اللَّيْلِ ؟ مَا بِي إِلا أَنْ أَفْصِلَ بَيْنَهُمَا ""","","","","","Book of Prayer"
"3789","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : أَخْبَرَنِي مَنْ رَأَى ابْنَ عُمَرَ , وَصَلَّى رَجُلٌ الْمَكْتُوبَةَ ثُمَّ قَامَ فِي مَقَامِهِ الَّذِي صَلَّى فِيهِ الْمَكْتُوبَةَ يَتَطَوَّعُ فِيهِ , فَدَفَعَهُ ابْنُ عُمَرَ , فَلَمَّا انْصَرَفَ , قَالَ لَهُ ابْنُ عُمَرَ : \" هَلْ تَدْرِي لِمَ دَفَعْتُكَ ؟ \" , قَالَ : لا , غَيْرَ أَنِّي أَرَى أَنَّكَ لَمْ تَدْفَعْنِي إِلا لَخَيْرٍ , قَالَ : \" أَجَلْ , مِنْ أَجْلِ أَنَّكَ لَمْ تَتَكَلَّمْ مُنْذُ انْصَرَفْتَ مِنَ الْمَكْتُوبَةِ , وَلَمْ تُصَلِّ أَمَامَكَ ""","","","","","Book of Prayer"
"3790","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُمَرُ بْنُ عَطَاءِ بْنِ أَبِي الْخُوَارِ , عَنِ السَّائِبِ بْنِ يَزِيدَ أَخْبَرَهُ , قَالَ : \" صَلَّيْتُ الْجُمُعَةَ مَعَ مُعَاوِيَةَ فِي الْمَقْصُورَةِ , فَلَمَّا سَلَّمَ قُمْتُ مَقَامِي فَصَلَّيْتُ , فَلَمَّا دَخَلَ أَرْسَلَ إِلَيَّ , فَقَالَ : لا تَعُدْ لِمَا فَعَلْتَ , إِذَا صَلَّيْتَ الْجُمُعَةَ فَلا تُصَلَّهَا حَتَّى تَكَلَّمَ أَوْ تَخْرُجَ , فَإِنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِذَلِكَ ""","","","","","Book of Prayer"
"3791","عَنِ الثَّوْرِيِّ , عَنْ مَيْسَرَةَ بْنِ حَبِيبٍ النَّهْدِيِّ , عَنِ الْمِنْهَالِ بْنِ عَمْرٍو , عَنْ عَبَّادِ بْنِ عَبْدِ اللَّهِ الأَسَدِيِّ , عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ , قَالَ : \" لا يَصْلُحُ لِلإِمَامِ أَنْ يُصَلِّيَ فِي الْمَكَانِ الَّذِي أَمَّ فِيهِ الْقَوْمَ حَتَّى يَتَحَوَّلَ , أَوْ يَفْصِلَ بِكَلامٍ ""","","","","","Book of Prayer"
"3792","عَنْ مَعْمَرٍ , عَنْ لَيْثٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا صَلَّى أَحَدُكُمُ الْمَكْتُوبَةَ فَأَرَادَ أَنْ يَتَطَوَّعَ بِشَيْءٍ فَلْيَتَقَدَّمْ قَلِيلا , أَوْ يَتَأَخَّرْ قَلِيلا , أَوْ عَنْ يَمِينِهِ , أَوْ عَنْ يَسَارِهِ","","","","","Book of Prayer"
"3793","عَنِ ابْنِ التَّيْمِيِّ , قَالَ : سَمِعْتُ مَنْصُورًا يُحَدِّثُ , عَنْ إِبْرَاهِيمَ , قال : \" لا يُصَلِّي الإِمَامُ التَّطَوُّعَ حَيْثُ يُصَلِّي الْمَكْتُوبَةَ ""","","","","","Book of Prayer"
"3794","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , أَنَّهُ رَأَى قَوْمًا يُصَلُّونَ فِي الْمَسْجِدِ , فَإِذَا انْصَرَفُوا تَأَخَّرُوا لِيُصَلُّوا بَعْدَ الْفَرِيضَةِ , فَقَالَ : \" كَانُوا يَتَقَدَّمُونَ وَلا يَتَأَخَّرُونَ ""","","","","","Book of Prayer"
"3795","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : ذَكَرْتُ لابْنِ الْمُسَيَّبِ , أَنَّ ابْنَ عُمَرَ , رَأَى رَجُلا يُصَلِّي يَوْمَ الْجُمُعَةَ فِي مَكَانَهِ تَطَوُّعًا , فَنَهَاهُ ابْنُ عُمَرَ عَنْ ذَلِكَ , وَقَالَ : \" لا أَرَاكَ تُصَلِّي مَكَانَكَ \" قَالَ ابْنُ الْمُسَيَّبِ , \" إِنَّمَا كُرِهَ ذَلِكَ لِلإِمَامِ ""","","","","","Book of Prayer"
"3796","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , أَنَّهُ كَانَ يَؤُمُّهُمْ , ثُمَّ يَتَطَوَّعُ فِي مَكَانَهِ , قَالَ : \" وَكَانَ إِذَا صَلَّى الْمَكْتُوبَةَ سَبَّحَ مَكَانَهُ \" , عَنِ الثَّوْرِيِّ , عَنْ عُبَيْدِ اللَّهِ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"3797","عَنِ الثَّوْرِيِّ , عَنْ شَيْخٍ لَنَا , يُقَالُ لَهُ : أَبُو بَحْرٍ , عَنْ شَيْخٍ لَهُمْ , قَالَ : \" جَاءَنَا عَبْدُ اللَّهِ , فَأَرَدْنَا أَنْ نُقَدِّمَهُ , فَقَالَ : يَتَقَدَّمُ بَعْضُكُمْ , وَسُئِلَ عَبْدُ اللَّهِ عَنِ الرَّجُلِ يُصَلِّي الْمَكْتُوبَةَ أَيَتَطَوَّعُ مَكَانَهُ ؟ , فَقَالَ : نَعَمْ ""","","","","","Book of Prayer"
"3798","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , عَنْ رَجُلٍ , عَنْ أَبِيهِ , \" أَنَّ ابْنَ مَسْعُودٍ لَمْ يَرَ بِذَلِكَ بَأْسًا ""","","","","","Book of Prayer"
"3799","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ , قَالَ : قِيلَ لِطَاوُسٍ : \" أَيَتَحَوَّلُ الرَّجُلُ إِذَا صَلَّى الْمَكْتُوبَةَ مِنْ مَكَانَهِ لِيَتَطَوَّعَ ؟ , فَقَالَ طَاوُسٌ : تُعَلِّمُونَ اللَّهَ بِدِينِكُمْ ""","","","","","Book of Prayer"
"3800","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قال : \" كَانُوا يَكْرَهُونَ أَنْ يَؤُمَّهُمْ , وَهُوَ يَقْرَأُ فِي الْمُصْحَفِ , فَيَتَشَبَّهُونَ بِأَهْلِ الْكِتَابِ ""","","","","","Book of Prayer"
"3801","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ : \" أَنَّهُ كَرِهَهُ ""","","","","","Book of Prayer"
"3802","عَنْ عَبْدِ الْقُدُّوسِ بْنِ حَبِيبٍ أَبُو سَعِيدٍ , عَنِ الْحَسَنِ , قَالَ : سَمِعْتُهُ , يَقُولُ : \" لا بَأْسَ أَنْ يَؤُمَّ الرَّجُلُ فِي شَهْرِ رَمَضَانَ وَهُوَ يَقْرَأُ فِي الْمُصْحَفِ ""","","","","","Book of Prayer"
"3803","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , أَنَّ عَائِشَةَ : \" كَانَتْ تَقْرَأُ فِي الْمُصْحَفِ وَهِيَ تُصَلِّي ""","","","","","Book of Prayer"
"3804","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , قال : \" كَانَ ابْنُ سِيرِينَ يُصَلِّي وَالْمُصْحَفُ إِلَى جَنْبِهِ , فَإِذَا تَرَدَّدَ نَظَرَ فِيهِ ""","","","","","Book of Prayer"
"3805","عَنِ ابْنِ جُرَيْجٍ , عَنْ دَاوُدَ بْنِ قَيْسٍ , عَنْ زَيْدِ بْنِ أَسْلَمَ , عَنِ ابْنِ مِحْجَنٍ الدُّئِلِيِّ , عَنْ أَبِيهِ , قَالَ : صَلَّيْتُ الظُّهْرَ وَالْعَصْرَ فِي بَيْتِي , ثُمَّ جِئْتُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَجَلَسْتُ عِنْدَهُ , فَأُقِيمَتِ الصَّلاةُ , فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَمْ أُصَلِّ , فَلَمَّا انْصَرَفَ , قَالَ : \" أَلَسْتَ بِمُسْلِمٍ ؟ \" , قُلْتُ : بَلَى , قَالَ : \" فَمَا لَكَ لَمْ تُصَلِّ ؟ \" , قَالَ : قُلْتُ : إِنِّي صَلَّيْتُ فِي بَيْتِي , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا أُقِيمَتِ الصَّلاةُ فَصَلِّ , وَلَوْ كُنْتَ قَدْ صَلَّيْتَ ""","","","","","Book of Prayer"
"3806","أَخْبَرَنَا مَعْمَرٌ , عَنْ زَيْدِ بْنِ أَسْلَمَ , عَنْ بُسْرِ بْنِ مِحْجَنٍ , عَنْ أَبِيهِ , قَالَ : أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَكَلَّمْتُهُ فِي حَاجَةٍ , ثُمَّ أُقِيمَتِ الصَّلاةُ وَأَنَا جَالِسٌ , فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالنَّاسِ ثُمَّ انْصَرَفَ , فَوَجَدَنِي جَالِسًا , فَقَالَ لِي : \" مَا أَنْتَ بِمُسْلِمٍ ؟ \" , قُلْتُ : بَلَى , يَا رَسُولَ اللَّهِ , قَالَ : \" فَمَا مَنَعَكَ أَنْ تُصَلِّيَ مَعَنَا ؟ \" , قَالَ : قُلْتُ : إِنِّي صَلَّيْتُ فِي رَحْلِي , قَالَ : \" وَإِنْ كُنْتَ قَدْ صَلَّيْتَ فِي رَحْلِكَ ""","","","","","Book of Prayer"
"3807","عَنْ هِشَامِ بْنِ حَسَّانَ , وَالثَّوْرِيِّ , عَنْ يَعْلَى بْنِ عَطَاءٍ الطَّائِفِيِّ , عَنْ جَابِرِ بْنِ يَزِيدَ بْنِ الأَسْوَدِ الْخُزَاعِيِّ , عَنْ أَبِيهِ , قَالَ : صَلَّيْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْفَجْرَ , فَانْحَرَفَ فَرَأَى رَجُلَيْنِ مِنْ وَرَاءِ النَّاسِ , فَدَعَا بِهِمَا , فَجِيءَ بِهِمَا تُرْعَدُ فَرَائِصُهُمَا , فَقَالَ : \" مَا مَنَعَكُمَا أَنْ تُصَلِّيَا مَعَ النَّاسِ ؟ \" , قَالا : يَا رَسُولَ اللَّهِ , صَلَّيْنَا فِي الرِّحَالِ , قَالَ : \" فَلا تَفْعَلا , إِذَا صَلَّى أَحَدُكُمْ فِي رَحْلِهِ , ثُمَّ أَدْرَكَ الصَّلاةَ مَعَ الإِمَامِ , فَلْيُصَلِّهِمَا مَعَهُ , فَإِنَّهَا لَهُ نَافِلَةٌ ""","","","","","Book of Prayer"
"3808","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنْ سَعِيدِ بْنِ عُبَيْدٍ , عَنْ صِلَةَ بْنِ زُفَرَ الْعَبْسِيِّ , قَالَ : \" خَرَجْتُ مَعَ حُذَيْفَةَ , فَمَرَّ بِمَسْجِدٍ , فَصَلَّى مَعَهُمُ الْمَغْرِبَ وَشَفَعَ بِرَكْعَةٍ , وَقَدْ كَانَ صَلَّى ""","","","","","Book of Prayer"
"3809","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا صَلَّيْتُ الْمَكْتُوبَةَ ثُمَّ أَدْرَكْتُهَا مَعَ النَّاسِ , فَإِنِّي أَجْعَلُ الَّذِي صَلَّيْتُ فِي بَيْتِي نَافِلَةً , وَأَجْعَلُ صَلاتِي مَعَ الإِمَامِ الْمَكْتُوبَةَ \" , قُلْتُ : أَفَرَأَيْتَ لَوْ أَنَّكَ لَمْ تُدْرِكْ إِلا رَكْعَةً وَاحِدَةً ؟ , قَالَ : \" وَكَذَلِكَ أَيْضًا ""","","","","","Book of Prayer"
"3810","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : سَأَلْتُهُ عَنِ الْعَصْرِ أَيُعِيدُهَا إِذَا جَاءَ الْجَمَاعَةُ ؟ , قَالَ مَعْمَرٌ , قَالَ ابْنُ الْمُسَيَّبِ : \" صَلِّ مَعَ الْقَوْمِ , فَإِنَّ صَلاتَكَ مَعَهُمْ تَفْضُلُ صَلاتَكَ وَحْدَكَ أَرْبَعًا وَعِشْرِينَ صَلاةً , أَوْ بِضْعًا وَعِشْرِينَ صَلاةً ""","","","","","Book of Prayer"
"3811","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ : سَأَلَ رَجُلٌ ابْنَ الْمُسَيَّبِ , قَالَ : \" صَلَّيْتُ فِي بَيْتِي , ثُمَّ جِئْتُ فَوَجَدْتُ النَّاسَ يُصَلُّونَ , فَأَيَّتُهُمَا أَجْعَلُ صَلاتِي ؟ , قَالَ : وَذَاكَ إِلَيْكَ ؟ إِنَّمَا ذَاكَ إِلَى اللَّهِ ""","","","","","Book of Prayer"
"3812","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , أَنَّ ابْنَ عُمَرَ , قَالَ : \" إِنْ كُنْتَ قَدْ صَلَّيْتَ فِي أَهْلِكَ , ثُمَّ أَدْرَكْتَ الصَّلاةَ فِي الْمَسْجِدِ مَعَ الإِمَامِ , فَصَلِّ مَعَهُ , غَيْرَ صَلاةِ الصُّبْحِ وَصَلاةِ الْمَغْرِبِ , الَّتِي يُقَالُ لَهَا : صَلاةُ الْعِشَاءِ , فَإِنَّهُمَا لا تُصَلِّيَانِ مَرَّتَيْنِ ""","","","","","Book of Prayer"
"3813","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : كَانَ إِذَا صَلَّى فِي بَيْتِهِ , ثُمَّ خَرَجَ , فَوَجَدَ الإِمَامَ يُصَلِّي صَلَّى مَعَهُ , إِلا الصُّبْحَ وَالْمَغْرِبَ ""","","","","","Book of Prayer"
"3814","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ : \" أَنَّهُ كَانَ يَكْرَهُ أَنْ يُعِيدَ الْمَغْرِبَ فِي جَمَاعَةٍ ""","","","","","Book of Prayer"
"3815","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , قال : \" أَعَدِ الصَّلَوَاتِ كُلَّهَا غَيْرَ الْعَصْرِ وَالْفَجْرِ , وَيَقُولُ : صَلاتُكَ الأُولَى مِنْهُمَا ""","","","","","Book of Prayer"
"3816","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , سُئِلَ عَنِ الْمَغْرِبِ يُصَلِّيهَا الرَّجُلُ فِي بَيْتِهِ , ثُمَّ يَجِدُ النَّاسَ فِيهَا ؟ , قَالَ : \" اشْفَعِ الَّذِي صَلَّيْتَ فِي بَيْتِكَ بِرَكْعَةٍ , ثُمَّ سَلِّمْ , وَالْحَقْ بِالنَّاسِ , وَاجْعَلِ الَّتِي هُمْ فِيهَا الْمَكْتُوبَةَ ""","","","","","Book of Prayer"
"3817","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" صَلَّيْتُ الْعِشَاءَ الآخِرَةَ وَأَوْتَرْتُ , ثُمَّ دَخَلْتُ الْمَسْجِدَ وَالإِمَامُ فِي آخِرِ رَكْعَةٍ , فَذَهَبْتُ أَشْفَعُ , فَلَمْ أَفْرُغْ حَتَّى رَكَعَ الإِمَامُ , وَرَفَعَ مِنْ آخِرِ رَكْعَةٍ قَالَ : لا تُعِدْ وَلَكِنْ أَوْتَرْ ""","","","","","Book of Prayer"
"3818","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ أَنِّي صَلَّيْتُ وَحْدِي رَكْعَةً ثُمَّ قَامُوا , فَأَخْشَى أَنْ لا أَشْفَعَ رَكْعَتِي بِرَكْعَةٍ حَتَّى يَفْرُغُوا , أُصَلِّي مَعَهُمْ ؟ , قَالَ : \" بَلِ اشْفَعْهَا بِرَكْعَةٍ , ثُمَّ انْصَرَفْ فَصَلِّ مَعَهُمْ ""","","","","","Book of Prayer"
"3819","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : كَانَ يَقُولُ : \" إِذَا خَرَجْتَ مِنْ بَيْتِكِ فَأَنْتَ فِي صَلاةٍ ""","","","","","Book of Prayer"
"3820","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" سَمِعْتُ أَنَّ صَلاةَ التَّطَوُّعِ تُكْرَهُ نِصْفَ النَّهَارِ إِلَى أَنْ تَزِيغَ الشَّمْسُ , وَحِينَ يَحِينُ طُلُوعُ الشَّمْسِ , وَحِينَ يَحِينُ غُرُوبُهَا , قَالَ : بَلَغَنِي أَنَّهَا تَطْلُعُ بَيْنَ قَرْنَيِ الشَّيْطَانِ , وَتَغْرُبُ بَيْنَ قَرْنَيْهِ ""","","","","","Book of Prayer"
"3821","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ سَابِطٍ , أَنَّ أَبَا أُمَامَةَ , سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : مَا أَنْتَ ؟ , قَالَ : \" نَبِيٌّ \" , قَالَ : إِلَى مَنْ أُرْسِلْتَ ؟ , قَالَ : \" إِلَى الأَحْمَرِ وَالأَسْوَدِ \" , قَالَ : أَيَّ حِينٍ تُكْرَهُ الصَّلاةُ ؟ , قَالَ : \" مِنْ حِينِ تُصَلِّي الصُّبْحَ حَتَّى تَرْتَفِعَ الشَّمْسُ قِيدَ رُمْحٍ , وَمَنْ حِينِ تَصْفَرُّ الشَّمْسُ إِلَى غُرُوبِهَا \" , قَالَ : فَأَيُّ الدُّعَاءِ أَسْمَعُ ؟ , قَالَ : \" شَطْرُ اللَّيْلِ الآخِرُ , وَأَدْبَارُ الْمَكْتُوبَاتِ \" , قَالَ : فَمَتَى غُرُوبُ الشَّمْسِ ؟ قَالَ : \" مِنْ أَوَّلِ مَا تَصْفَرُّ الشَّمْسُ حِينَ تَدْخُلُهَا صُفْرَةٌ إِلَى حِينِ أَنْ تَغْرُبَ الشَّمْسُ ""","","","","","Book of Prayer"
"3822","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ , عَنْ رَجُلٍ , عَنْ كَعْبِ بْنِ مُرَّةَ الْبَهْزِيِّ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ , أَيُّ اللَّيْلِ أَسْمَعُ ؟ قَالَ : \" جَوْفُ اللَّيْلِ الآخِرُ \" , قَالَ : \" ثُمَّ الصَّلاةُ مَقْبُولَةٌ حَتَّى يَطْلُعَ الْفَجْرُ , ثُمَّ لا صَلاةَ حَتَّى تَكُونَ الشَّمْسُ قِيدَ رُمْحٍ , أَوْ رُمْحَيْنِ , ثُمَّ لا صَلاةَ حَتَّى تَغْرُبَ الشَّمْسُ ""","","","","","Book of Prayer"
"3823","أَخْبَرَنَا مَعْمَرٌ , عَنْ زَيْدِ بْنِ أَسْلَمَ , عَنْ عَطَاءِ بْنِ يَسَارٍ , عَنْ أَبِي عَبْدِ اللَّهِ الصُّنَابِحِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ الشَّمْسَ تَطْلُعُ بَيْنَ قَرْنَيْ شَيْطَانٍ ,  أَوْ قَالَ : تَطْلُعُ مَعَهَا قَرْنُ شَيْطَانٍ , فَإِذَا ارْتَفَعَتْ فَارَقَهَا , فَإِذَا كَانَتْ فِي وَسَطِ السَّمَاءِ قَارَنَهَا , فَإِذَا دَلَكَتْ , أَوْ قَالَ : زَالَتْ فَارَقَهَا , فَإِذَا دَنَتْ لِلْغُرُوبِ قَارَنَهَا , فَلا تُصَلُّوا هَذِهِ الثَّلاثَ سَاعَاتٍ ""","","","","","Book of Prayer"
"3824","عَنْ مَالِكٍ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا يَتَحَرَّى أَحَدُكُمْ أَنْ يُصَلِّيَ عِنْدَ طُلُوعِ الشَّمْسِ , وَلا عِنْدَ غُرُوبِهَا ""","","","","","Book of Prayer"
"3825","عَنْ مَالِكٍ , عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ , عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ عُمَرَ , أَنَّهُ كَانَ يَقُولُ : \" لا تَتَحَرَّوْا طُلُوعَ الشَّمْسِ , وَلا غُرُوبِهَا , فَإِنَّ الشَّيْطَانَ يَطْلُعُ قَرْنَاهُ مَعَ طُلُوعِهَا , وَيَغْرُبَانِ مَعَ غُرُوبِهَا \" , قَالَ : وَكَانَ عُمَرُ يَضْرِبُ عَلَيْهِمَا الرِّجَالَ","","","","","Book of Prayer"
"3826","عَنِ ابْنِ جُرَيْجٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ طَاوُسٍ , قَالَ : إِنَّمَا قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تَحَرَّوْا طُلُوعَ الشَّمْسِ , وَلا غُرُوبِهَا فِي الصَّلاةِ , فَنَحْنُ لا نَتَحَرَّاهُ ""","","","","","Book of Prayer"
"3827","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَمَّنْ سَمِعَ يَزِيدَ بْنَ أَبِي حَبِيبٍ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِنَّ هَذِهِ الصَّلاةَ الَّتِي فُرِضَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ يَعْنِي الْعَصْرَ , فَضَيَّعُوهَا , فَمَنْ حَفِظَهَا الْيَوْمَ فَلَهُ أَجْرُهَا مَرَّتَيْنِ , وَلا صَلاةَ بَعْدَهَا حَتَّى يُرَى الشَّاهِدُ , وَالشَّاهِدُ النَّجْمُ ""","","","","","Book of Prayer"
"3828","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" مَا أَحَبُّ أَنَّ صَلاةَ رَجُلٍ حِينَ تَحْمَرُّ الشَّمْسُ , أَوْ قَالَ : تَصْفَرُّ بِفَلْسَيْنِ حَتَّى تَرْتَفِعَ قِيدَ نَخْلَةٍ ""","","","","","Book of Prayer"
"3829","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , عَنْ عَائِشَةَ , أَنَّهَا قَالَتِ : \" انْظُرُوا إِلَى هَؤُلاءِ الَّذِينَ تَرَكُوا الصَّلاةَ , حَتَّى إِذَا كَانَتِ السَّاعَةُ الَّتِي تُكْرَهُ الصَّلاةُ فِيهَا قَامُوا يُصَلُّونَ \" , قَالَ : \" وَذَلِكَ حِينَ قَامَ الْقَاصُّ بُكْرَةُ \" , قَالَ عَطَاءٌ : \" أَظُنُّ حِينَ حَانَ طُلُوعُ الشَّمْسِ ""","","","","","Book of Prayer"
"3830","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ ابْنِ سِيرِينَ , قال : \" تُكْرَهُ الصَّلاةُ فِي ثَلاثِ سَاعَاتٍ , وَتَحْرُمُ فِي سَاعَتَيْنِ , قَالَ : تُكْرَهُ بَعْدَ الْعَصْرِ , وَبَعْدَ الصُّبْحِ حَتَّى تَرْتَفِعَ قِيدَ نَخْلَةٍ , وَنِصْفَ النَّهَارِ فِي شِدَّةِ الْحَرِّ , وَتَحْرُمُ سَاعَتَيْنِ حِينَ يَطْلُعُ قَرْنُ الشَّيْطَانِ حَتَّى يَسْتَوِيَ طُلُوعُهَا , وَحِينَ تَصْفَرُّ حَتَّى يَسْتَوِيَ غُرُوبُهَا , فَإِنَّهَا تَغْرُبُ فِي قَرْنِ شَيْطَانٍ , وَتَطْلُعُ فِي قَرْنِ شَيْطَانٍ \" , عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ مِثْلَهُ","","","","","Book of Prayer"
"3831","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ , عَنْ عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ , أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ , يَقُولُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" لا صَلاةَ بَعْدَ صَلاةِ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ , وَلا صَلاةَ بَعْدَ صَلاةِ الصُّبْحِ حَتَّى تَطْلُعَ الشَّمْسُ ""","","","","","Book of Prayer"
"3832","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ عَطَاءِ بْنِ أَبِي الْخُوَارِ , عَنْ عَبْدِ اللَّهِ بْنِ عِيَاضٍ , وَعَنْ عَطَاءِ بْنِ بُخْتٍ , كِلاهُمَا , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , أَنَّهُمَا سَمِعَاهُ , يَقُولُ : سَمِعْتُ أَبَا الْقَاسِمِ , صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقُولُ : \" لا صَلاةَ بَعْدَ صَلاةِ الصُّبْحِ حَتَّى تَطْلُعَ الشَّمْسُ , وَلا صَلاةَ بَعْدَ صَلاةِ الْعَصْرِ حَتَّى اللَّيْلِ \" , فَقَالَ لَهُ : عَبْدُ اللَّهِ بْنُ عِيَاضٍ , إِنَّ ابْنَ الزُّبَيْرِ يُصَلِّي بَعْدَ الْعَصْرِ , وَقَبْلَ طُلُوعِ الشَّمْسِ فِي فِتْيَةٍ , فَقَالَ لَهُ أَبُو سَعِيدٍ : \" أَمَا إِنَّهُ قَدْ كَانَ يَعِيبُ ذَلِكَ عَلَى الْقَوْمِ يَعْنِي بَنِي أُمَيَّةَ ""","","","","","Book of Prayer"
"3833","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ , عَنْ قَزَعَةَ , قَالَ : \" كُنْتُ أُصَلِّي رَكْعَتَيْنِ بَعْدَ الْعَصْرِ , فَلَقِيَنِي أَبُو سَعِيدٍ الْخُدْرِيُّ , فَنَهَانِي عَنْهُمَا , فَقَالَ : أَتْرُكُهُمَا لَكَ ؟ قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"3834","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ خُبَيْبِ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ ابْنِ عَاصِمٍ , عَنْ أَبِي هُرَيْرَةَ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ : \" نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّلاةِ فِي سَاعَتَيْنِ , بَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ , وَبَعْدَ الصُّبْحِ حَتَّى تَطْلُعَ الشَّمْسُ ""","","","","","Book of Prayer"
"3835","عَنْ مَعْمَرٍ , عَنْ أَبِي هَارُونَ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ : رَأَيْتُ ابْنَ الزُّبَيْرِ يُصَلِّي بَعْدَ الْعَصْرِ رَكْعَتَيْنِ , فَقُلْتُ مَا هَذَا ؟ , فَقَالَ : أَخْبَرَتْنِي عَائِشَةُ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي بَعْدَ الْعَصْرِ رَكْعَتَيْنِ , قَالَ : فَذَهَبْتُ إِلَى عَائِشَةَ فَسَأَلْتُهَا , فَقَالَتْ : صَدَقَ , فَقُلْتُ : فَأَشْهَدُ لَسَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" لا صَلاةَ بَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ , وَلا بَعْدَ الْفَجْرِ حَتَّى تَطْلُعَ الشَّمْسُ \" , فَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ مَا أُمِرَ , وَنَحْنُ نَفْعَلُ مَا أُمِرْنَا","","","","","Book of Prayer"
"3836","عَنْ مَعْمَرٍ , عَنْ أَبِي هَارُونَ الْعَبْدِيِّ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ : \" لَقَدْ رَأَيْتُ عُمَرَ يَضْرِبُ عَلَيْهَا رُءُوسَ الْحِبَالِ يَعْنِي رَكْعَتَيْنِ بَعْدَ الْعَصْرِ ""","","","","","Book of Prayer"
"3837","عَنِ الثَّوْرِيِّ , عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ السَّائِبِ بْنِ يَزِيدَ , قَالَ : \" ضَرَبَ عُمَرُ الْمُنْكَدِرَ إِذْ رَآهُ سَبَّحَ بَعْدَ الْعَصْرِ ""","","","","","Book of Prayer"
"3838","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ زِرِّ بْنِ حُبَيْشٍ , قَالَ : \" رَأَيْتُ عُمَرَ بْنَ الْخَطَّابِ يَضْرِبُ عَلَى الصَّلاةِ بَعْدَ الْعَصْرِ ""","","","","","Book of Prayer"
"3839","عَنِ ابْنِ التَّيْمِيِّ , قَالَ : سَمِعْتُ عَبْدَ الْمَلِكِ بْنِ عُمَيْرٍ , يَقُولُ : حَدَّثَنِي أَبُو غَادِيَةَ , قَالَ : \" رَأَيْتُ عُمَرَ بْنَ الْخَطَّابِ يَضْرِبُ النَّاسَ عَلَى الرَّكْعَتَيْنِ بَعْدَ الْعَصْرِ ""","","","","","Book of Prayer"
"3840","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , أَنَّ عَلِيًّا سَبَّحَ فِي سَفَرٍ بَعْدَ الْعَصْرِ رَكْعَتَيْنِ , فَتَغَيَّظَ عَلَيْهِ عُمَرُ , وَقَالَ : أَمَا وَاللَّهِ لَقَدْ عَلِمْتَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَنْهَى عَنْ هَذَا","","","","","Book of Prayer"
"3841","عَنِ ابْنِ جُرَيْجٍ , عَنْ نَافِعٍ , قَالَ : قُلْتُ لَهُ : رَأَيْتُ ابْنَ عُمَرَ يُصَلِّي يَوْمَ النَّحْرِ فِي أَوَّلِ النَّهَارِ ؟ , قَالَ : لا , وَلا فِي غَيْرِ يَوْمِ النَّحْرِ حَتَّى تَرْتَفِعَ الشَّمْسُ , قَالَ : وَكَانَ ابْنُ عُمَرَ , يَقُولُ : أَمَّا أَنَا فَإِنِّي أُصَلِّي كَمَا رَأَيْتُ أَصْحَابِي يُصَلُّونَ , وَأَمَّا أَنَا فَلا أَنْهَى أَحَدًا أَنْ يُصَلِّيَ لَيْلا أَوْ نَهَارًا لا يَتَحَرَّى طُلُوعَ الشَّمْسِ وَلا غُرُوبَهَا , فَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ ذَلِكَ , وَقَالَ : \" إِنَّهُ يَطْلُعُ قَرْنُ الشَّيْطَانِ مَعَ طُلُوعِ الشَّمْسِ , فَلا يَتَحَرَّى أَحَدٌ طُلُوعَ الشَّمْسِ وَلا غُرُوبَهَا ""","","","","","Book of Prayer"
"3842","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , \" أَنَّ عَائِشَةَ , وَأُمَّ سَلَمَةَ كَانَتَا تَرْكَعَانِ بَعْدَ الْعَصْرِ ""","","","","","Book of Prayer"
"3843","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أُمِّ سَلَمَةَ , زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَتْ : \" لَمْ أَرَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بَعْدَ الْعَصْرِ قَطُّ , إِلا مَرَّةً جَاءَهُ نَاسٌ بَعْدَ الظُّهْرِ فَشَغَلُوهُ فِي شَيْءٍ , وَلَمْ يُصَلِّ بَعْدَ الظُّهْرِ شَيْئًا حَتَّى صَلَّى الْعَصْرَ \" , قَالَتْ : \" فَلَمَّا صَلَّى الْعَصْرَ دَخَلَ بَيْتِي , فَصَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"3844","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي لَبِيدٍ , قَالَ : سَمِعْتُ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ , يَقُولُ : قَدِمَ مُعَاوِيَةُ الْمَدِينَةَ , فَقَالَ : قُمْ يَا كَثِيرُ بْنَ الصَّلْتِ إِلَى أُمِّ الْمُؤْمِنِينَ , فَاسْأَلْهَا عَنِ الرَّكْعَتَيْنِ بَعْدَ الْعَصْرِ , قَالَ أَبُو سَلَمَةَ : فَقُمْتُ مَعَهُ , وَأَرْسَلَ ابْنُ عَبَّاسٍ عَبْدَ اللَّهِ بْنَ الْحَارِثِ , فَأَتَيْنَا عَائِشَةَ , فَقَالَتْ : لا أَدْرِي , سَلُوا أُمَّ سَلَمَةَ , فَأَتَيْنَا أُمَّ سَلَمَةَ , فَقَالَتْ : دَخَلَ عَلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمًا , فَصَلَّى رَكْعَتَيْنِ بَعْدَ الْعَصْرِ , لَمْ أَكُنْ أَرَاهُ يُصَلِّيهِمَا , فَقُلْتُ : يَا رَسُولَ اللَّهِ , مَا هَاتَانِ الرَّكْعَتَانِ ؟ , قَالَ : \" قَدِمَ وَفْدٌ مِنْ بَنِي تَمِيمٍ , أَوْ قَالَ : قَدِمَتْ صَدَقَةٌ وَكُنْتُ أُصَلِّي رَكْعَتَيْنِ بَعْدَ الظُّهْرِ , فَلَمْ أَكُنْ صَلَّيْتُهُمَا , فَهُمَا هَاتَانِ ""","","","","","Book of Prayer"
"3845","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ أَبَا سَعْدٍ الأَعْمَى , يُخْبِرُ عَنْ رَجُلٍ , يُقَالُ لَهُ : السَّائِبُ مَوْلَى الْفَارِسِيِّينَ , عَنْ زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ , أَنَّهُ رَآهُ عُمَرُ بْنُ الْخَطَّابِ , وَهُوَ خَلِيفَةٌ رَكَعَ بَعْدَ الْعَصْرِ رَكْعَتَيْنِ , فَمَشَى إِلَيْهِ فَضَرَبَهُ بِالدِّرَّةِ وَهُوَ يُصَلِّي كَمَا هُوَ , فَلَمَّا انْصَرَفَ , قَالَ زَيْدٌ : اضْرِبْ يَا أَمِيرَ الْمُؤْمِنِينَ , فَوَاللَّهِ لا أَدَعُهُمَا أَبَدًا بَعْدَ إِذْ رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّيهِمَا , قَالَ : فَجَلَسَ إِلَيْهِ عُمَرُ , وَقَالَ : يَا زَيْدُ بْنَ خَالِدٍ , لَوْلا أَنِّي أَخْشَى أَنْ يَتَّخِذَهَا النَّاسُ سُلَّمًا إِلَى الصَّلاةِ حَتَّى اللَّيْلِ لَمْ أَضْرِبْ فِيهِمَا ""","","","","","Book of Prayer"
"3846","عَنْ عَبْدِ اللَّهِ بْنِ سَعِيدٍ , قَالَ : أَخْبَرَنِي الأَزْرَقُ بْنُ قَيْسٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ رَبَاحٍ الأَنْصَارِيَّ يُحَدِّثُ , عَنْ رَجُلٍ مِنَ الأَنْصَارِ , مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى الْعَصْرَ , فَقَامَ رَجُلٌ يُصَلِّي بَعْدَهَا , فَأَخَذَ عُمَرُ بْنُ الْخَطَّابِ بِرِدَائِهِ , أَوْ بِثَوْبِهِ , وَقَالَ : اجْلِسْ فَإِنَّمَا هَلَكَ أَهْلُ الْكِتَابِ قَبْلَكُمْ لَمْ يَكُنْ لِصَلاتِهِمْ فَصَلٌ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَدَقَ ابْنُ الْخَطَّابِ ""","","","","","Book of Prayer"
"3847","عَنْ هُشَيْمٍ , أَوْ غَيْرِهِ , قَالَ : أَخْبَرَنِي أَبُو حَمْزَةَ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الصَّلاةِ بَعْدَ الْعَصْرِ , فَقَالَ : \" صَلِّ مَا شِئْتَ إِلَى اللَّيْلِ , قَالَ : وَلَقَدْ رَأَيْتُ عُمَرَ يَضْرِبُ الرَّجُلَ يَرَاهُ يُصَلِّي بَعْدَ الْعَصْرِ ""","","","","","Book of Prayer"
"3848","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ الْمُصْعَبِ , أَنَّ طَاوُسًا أَخْبَرَهُ , أَنَّهُ سَأَلَ ابْنَ عَبَّاسٍ عَنْ رَكْعَتَيْنِ بَعْدَ الْعَصْرِ , فَنَهَاهُ عَنْهَا , فَقَالَ : فَقُلْتُ : لا أَدَعُهُمَا , فَقَالَ ابْنُ عَبَّاسٍ : \"  وَمَا كَانَ لِمُؤْمِنٍ وَلا مُؤْمِنَةٍ إِذَا قَضَى اللَّهُ وَرَسُولُهُ أَمْرًا  فَتَلا هَذِهِ الآيَةَ إِلَى مُبِينًا ""","","","","","Book of Prayer"
"3849","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ , أَنَّ طَاوُسًا , أَقَامَهُ بِخَيْفِ مِنًى بَيْنَهُ وَبَيْنَ النَّاسِ , لِيُصَلِّيَ بَعْدَ الْعَصْرِ رَكْعَتَيْنِ , قَالَ : فَصَلَّى رَكْعَتَيْنِ , وَقَالَ لِي : \" أَتُصَلِّي بَعْدَ الْعَصْرِ ؟ \" , قَالَ : \" أُكْرِهْتُ وَاللَّهِ ""","","","","","Book of Prayer"
"3850","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , أَنَّ أَبَا أَيُّوبَ الأَنْصَارِيَّ كَانَ يُصَلِّي قَبْلَ خِلافَةِ عُمَرَ رَكْعَتَيْنِ بَعْدَ الْعَصْرِ , فَلَمَّا اسْتُخْلِفَ عُمَرُ تَرَكَهُمَا , فَلَمَّا تُوُفِّيَ رَكَعَهُمَا , فَقِيلَ لَهُ : مَا هَذَا ؟ , فَقَالَ \" إِنَّ عُمَرَ كَانَ يَضْرِبُ النَّاسَ عَلَيْهِمَا \" , قَالَ ابْنُ طَاوُسٍ : \" وَكَانَ أَبِي لا يَدَعُهُمَا ""","","","","","Book of Prayer"
"3851","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عُرْوَةَ بْنِ الزُّبَيْرِ , يَذْكُرُ أَنَّ عُرْوَةَ أَخْبَرَهُ , أَنَّ عَائِشَةَ أَخْبَرَتْهُ \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَدْخُلْ عَلَيْهَا قَطُّ إِلا رَكَعَ بَعْدَ الْعَصْرِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"3852","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , قَالَ : \" كُنَّا نُصَلِّي مَعَ ابْنِ الزُّبَيْرِ الْعَصْرَ فِي الْمَسْجِدِ الْحَرَامِ , فَكَانَ يُصَلِّي بَعْدَ الْعَصْرِ رَكْعَتَيْنِ , وَكُنَّا نُصَلِّيهِمَا مَعَهُ نَقُومُ صَفًّا خَلْفَهُ ""","","","","","Book of Prayer"
"3853","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , عَنْ أَنَسٍ , أَنَّهُ سُئِلَ عَنْ رَكْعَتَيْنِ قَبْلَ الْمَغْرِبِ , قَالَ : \" رَأَيْتُ اللُّبَابُ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلُّونَهُمَا ""","","","","","Book of Prayer"
"3854","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ زِرِّ بْنِ حُبَيْشٍ , قَالَ : \" كَانَ عَبْدُ الرَّحْمَنِ بْنِ عَوْفٍ , وَأُبَيُّ بْنُ كَعْبٍ يُصَلِّيَانِ الرَّكْعَتَيْنِ قَبْلَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"3855","عَنْ هُشَيْمٍ , قَالَ : حَدَّثَنَا يَعْلَى بْنُ عَطَاءٍ , عَنْ ثُمَامَةَ بْنِ عَبْدِ اللَّهِ بْنِ أَنَسٍ , قَالَ : كَانَ نَاسٌ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلُّونَ الرَّكْعَتَيْنِ قَبْلَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"3856","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَخْرُجُ عَلَيْنَا بَعْدَ مَا تَغْرُبُ الشَّمْسُ , وَيَكُونُ اللَّيْلُ , وَقَبْلَ أَنْ يُثَوَّبَ بِالْمَغْرِبِ , وَنَحْنُ نُصَلِّي , فَلا يَنْهَانَا وَلا يَأْمُرُنَا","","","","","Book of Prayer"
"3857","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , قال : \" كَانَ الْمُهَاجِرُونَ لا يَرْكَعُونَ الرَّكْعَتَيْنِ قَبْلَ الْمَغْرِبِ , وَكَانَتِ الأَنْصَارُ تَرْكَعُ بِهِمَا \" , قَالَ الزُّهْرِيُّ : \" وَكَانَ أَنَسٌ يَرْكَعُهُمَا ""","","","","","Book of Prayer"
"3858","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قَالَ : \" لَمْ يُصَلِّ أَبُو بَكْرٍ , وَلا عُمَرُ , وَلا عُثْمَانُ الرَّكْعَتَيْنِ قَبْلَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"3859","عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ عَامِرٍ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : \" لَقَدْ رَأَيْتُ اللُّبَابَ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا نُودِيَ بِالْمَغْرِبِ ابْتَدَرُوا السَّوَارِيَ لِيُصَلُّوا رَكْعَتَيْنِ قَبْلَ الْمَغْرِبِ ""","","","","","Book of Prayer"
"3860","عَنِ ابْنِ جُرَيْجٍ , وَالثَّوْرِيِّ , عَنْ عَمْرِو بْنِ دِينَارٍ , أَنَّ عَطَاءَ بْنَ يَسَارٍ أَخْبَرَهُ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا أُقِيمَتِ الصَّلاةُ فَلا صَلاةَ إِلا الْمَكْتُوبَةُ ""","","","","","Book of Prayer"
"3861","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الْحَسَنِ بْنِ مُسَافِرٍ , عَنْ سُوَيْدِ بْنِ غَفَلَةَ , قَالَ : \" كَانَ عُمَرُ بْنُ الْخَطَّابِ يَضْرِبُ عَلَى الصَّلاةِ بَعْدَ الإِقَامَةِ ""","","","","","Book of Prayer"
"3862","أَخْبَرَنَا مَعْمَرٌ , عَنْ بُلَعَ , عَنْ أَيُّوبَ , عَنْ عَطَاءِ بْنِ يَسَارٍ , عَنْ أَبِي هُرَيْرَةَ , يَبْلُغُ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا أُقِيمَتِ الصَّلاةُ فَلا صَلاةَ إِلا الْمَكْتُوبَةُ ""","","","","","Book of Prayer"
"3863","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ صَفْوَانَ بْنَ مَوْهَبٍ أَخْبَرَهُ , أَنَّهُ سَمِعَ مُسْلِمَ بْنَ عَقِيلٍ , يَقُولُ لِلنَّاسِ وَهُمْ يُصَلُّونَ : \" وَقَدْ أُقِيمَتِ الصَّلاةُ وَيْلَكُمْ , لا صَلاةَ إِذَا أُقِيمَتِ الصَّلاةُ ""","","","","","Book of Prayer"
"3864","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : أَخْبَرَنِي مَنْ ، سَمِعَ مُسْلِمَ بْنَ عَقِيلٍ \" يَنْهَى عَنِ الصَّلاةِ بَعْدَ الإِقَامَةِ ""","","","","","Book of Prayer"
"3865","عَنْ دَاوُدَ بْنِ إِبْرَاهِيمَ , قال : سَأَلْتُ طَاوُسًا , قُلْتُ : أَرْكَعُ رَكْعَتَيْنِ وَالْمُؤَذِّنُ يُقِيمُ ؟ , قَالَ : أَوَ تُطِيقُ ذَلِكَ ؟ ""","","","","","Book of Prayer"
"3866","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ فُضَيْلٍ , عَنْ إِبْرَاهِيمَ , وَسَعِيدِ بْنِ جُبَيْرٍ : \" أَنَّهُمَا يَكْرَهَانِ الصَّلاةَ عِنْدَ الإِقَامَةِ \" , وَقَالَ إِبْرَاهِيمُ : \" إِنْ كُنْتَ قَدْ دَخَلْتَ فِي شَيْءٍ فَأَتِمَّهُ ""","","","","","Book of Prayer"
"3867","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : إِذَا أُقِيمَتِ الصَّلاةُ فَلا صَلاةَ , فَإِنْ خَرَجَ الإِمَامُ وَأَنْتَ رَاكِعٌ , فَارْكَعْ إِلَيْهَا رَكْعَةً أُخْرَى خَفِيفَةً , ثُمَّ سَلَّمْ ""","","","","","Book of Prayer"
"3868","رَوَاهُ عَنِ الثَّوْرِيِّ  أَبُو سَعِيدٍ يَشُكُّ , عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ , عَنْ أَبِيهِ , قَالَ : مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِابْنِ الْعُشْبِ , وَهُوَ يُصَلِّي رَكْعَتَيْنِ حِينَ أُقِيمَتِ الصَّلاةُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَصَلاتَانِ مَعًا ؟ ""","","","","","Book of Prayer"
"3869","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : خَرَجَ الإِمَامُ , وَأَنَا مُتَطَوِّعٌ , فَأُتِمُّ ؟ , قَالَ : \" فَصِلْهَا بِهَا \" , قُلْتُ : إِنِّي لَمْ أُسَلِّمْ تَسْلِيمَ الانْصِرَافِ , قَالَ : \" أَلَيْسَ قَدْ تَشَهَّدْتَ ؟ \" , قُلْتُ : بَلَى , قَالَ : \" فَحَسْبُكَ , فَصِلْهَا بِهَا ""","","","","","Book of Prayer"
"3870","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ : كُنْتُ قَائِمًا أُصَلِّي , فَمَرَرْتُ بِسَجْدَةٍ مِنَ الْقُرْآنِ , فَخَرَرْتُ سَاجِدًا فِي تِلْكَ السَّجْدَةِ , قَالَ \" صِلْهَا بِهَا \" , قُلْتُ : أُكَبِّرُ ؟ , قَالَ : \" نَعَمْ \" , قُلْتُ : أَسْتَعِيذُ ؟ , قَالَ : \" نَعَمْ \" , قُلْتُ : وَلا أَكْتَفِي بِاسْتِعَاذَتِي لِلتَّطَوُّعِ ؟ , قَالَ : \" بَلَى , وَلَكِنْ أَحَبُّ إِلَيَّ أَنْ تَسْتَعِيذَ ""","","","","","Book of Prayer"
"3871","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ كَثِيرٍ الرَّازِيُّ , \" أَنَّ نَافِعَ بْنَ جُبَيْرٍ كَانَ يَصِلُ التَّطَوُّعَ بِالْمَكْتُوبَةِ , قَالَ : فَعَرَفْتُهُ , قَالَ : إِنَّهُ لَيْسَ بِرَأْيِهِ ""","","","","","Book of Prayer"
"3872","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ : \" أَنَّهُمَا كَانَا يَفْعَلانِ ذَلِكَ يَصِلانِ التَّطَوُّعَ بِالْمَكْتُوبَةِ ""","","","","","Book of Prayer"
"3873","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , وَالأَعْمَشِ , وَالزُّبَيْرِ , عَنْ إِبْرَاهِيمَ فِي الرَّجُلِ دَخَلَ مَسْجِدًا يَرَى أَنَّهُمْ قَدْ صَلُّوا , فَصَلَّى رَكْعَتَيْنِ مِنَ الْمَكْتُوبَةِ , ثُمَّ أُقِيمَتِ الصَّلاةُ , قال : \" يَدْخُلُ مَعَ الإِمَامِ فَيُصَلِّي رَكْعَتَيْنِ , ثُمَّ يُسَلِّمُ , ثُمَّ يَجْعَلُ الْبَاقِيَتَيْنِ تَطَوُّعًا \" , قَالَ الزُّبَيْرُ : فَقُلْتُ لإِبْرَاهِيمَ : مَا شَعَرْتُ أَنَّ أَحَدًا يَفْعَلُ هَذَا , قَالَ : \" إِنَّ هَذَا كَانَ يَصْنَعُهُ مَنْ كَانَ قَبْلَكُمْ ""","","","","","Book of Prayer"
"3874","عَنِ الثَّوْرِيِّ , عَنِ الشَّعْبِيِّ , قال : \" يَقْطَعُ صَلاتَهُ , وَيَدْخُلُ مَعَ الْقَوْمِ ""","","","","","Book of Prayer"
"3875","عَنِ الثَّوْرِيِّ , عَمَّنْ سَمِعَ إِبْرَاهِيمَ , يَقُولُ : \" إِذَا دَخَلْتَ فِي صَلاةٍ فَلا تَدْخُلْ مَعَهَا غَيْرَهَا , يَقُولُ : إِذَا كُنْتَ فِي الْمَكْتُوبَةِ فَلا تَجْعَلْهَا فِي تَطَوَّعٍ , أَوْ فِي تَطَوَّعٍ فَلا تَجْعَلْهَا فَرِيضَةً ""","","","","","Book of Prayer"
"3876","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , أَنَّهُ قَالَ : \" إِذَا وَصَلْتَ التَّطَوُّعَ بِالْمَكْتُوبَةِ فَهُوَ بِمَنْزِلَةِ الْكَلامِ , يَقُولُ : وَلَكِنْ سَلَّمْ وَادْخُلْ مَعَهُمْ \" , قَالَ مَعْمَرٌ , وَقَالَهُ الْحَسَنُ","","","","","Book of Prayer"
"3877","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ أَبِي مَيْسَرَةَ , عَنْ سُوَيْدِ بْنِ عَبْدِ اللَّهِ , عَنْ أَبِي سَهْلَةَ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : \" خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَالْمُؤَذِّنُ يُقِيمُ , فَصَلَّى الْفَجْرَ , فَوَجَدَ رَجُلَيْنِ يُصَلِّيَانِ , فَقَالَ : أَصَلاتَانِ مَعًا ؟ ""","","","","","Book of Prayer"
"3878","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ أَبِي مُلَيْكَةَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى رَجُلا يُصَلِّي وَالْمُؤَذِّنُ يُقِيمُ لِلصُّبْحِ , فَقَالَ : \" أَتُصَلِّي الصُّبْحَ أَرْبَعًا ؟ ""","","","","","Book of Prayer"
"3879","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ , رَأَى رَجُلا يُصَلِّي وَالْمُؤَذِّنُ يُقِيمُ , فَقال : \" أَتُصَلِّي الصُّبْحَ أَرْبَعًا ؟ \" , قَالَ مَعْمَرٌ : وَبَلَغَنِي عَنْ سَعِيدِ بْنِ جُبَيْرٍ مِثْلُ ذَلِكَ","","","","","Book of Prayer"
"3880","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , عَنْ أَبِي الْعَالِيَةِ , أَوْ عَنْ أَبِي عُثْمَانَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى رَجُلا يُصَلِّي رَكْعَتَيْنِ وَقَدْ أُقِيمَتْ صَلاةُ الْفَجْرِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَيَّتُهُمَا صَلاتُكَ ؟ الَّتِي صَلَّيْتَ وَحْدَكَ , أَمِ الَّتِي صَلَّيْتَ مَعَنَا ؟ ""","","","","","Book of Prayer"
"3881","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , كَرِهَ أَنْ يُصَلِّيهِمَا عِنْدَ الإِقَامَةِ , قَالَ : \" كَيْفَ يُصَلِّيهِمَا وَقَدْ فُرِضَتِ الصَّلاةُ ؟ ""","","","","","Book of Prayer"
"3882","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : دَخَلْتُ الْمَسْجِدَ وَالإِمَامُ فِي الصَّلاةِ وَلَمْ أَكُنْ رَكَعْتُهُمَا , قَالَ : \" فَارْكَعْهُمَا فِي الْمَسْجِدِ , إِلا أَنْ تَخْشَى أَنْ تَفُوتَكَ الرَّكْعَةُ الَّتِي الإِمَامُ فِيهَا ""","","","","","Book of Prayer"
"3883","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَحَبُّ إِلَيْكَ أَنْ أَرْكَعَهُمَا فِي الطَّرِيقِ ؟ , قَالَ : \" لا أُبَالِي أَيْنَ تَرْكَعُهُمَا , إِذَا رَكَعْتَهُمَا قَبْلَ الصَّلاةِ ""","","","","","Book of Prayer"
"3884","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ خِفْتُ أَنْ يَفُوتَنِي الصُّبْحُ ؟ , قال : \" فَدَعْهُمَا , وَلا تَفُوتُكَ شَيْءٌ مِنَ الصُّبْحِ , قَالَ : ثُمَّ أَخْبَرْتُهُ خَبَرَ أَبِي سَعْدٍ الأَعْمَى إِيَّانَا عَنِ الَّذِي رَكَعَهُمَا بَعْدَ الصُّبْحِ عَلَى عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"3885","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : أَرْكَعُهُمَا فِي بَيْتِي ثُمَّ آتِي الْمَسْجِدَ فَأَجْلَسُ أَحَبُّ إِلَيَّ , قَالَ زَيْدُ بْنُ خَالِدٍ : \" لا تَجْعَلُوا بُيُوتَكُمْ مَقَابِرَ ""","","","","","Book of Prayer"
"3886","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا أَخْطَأْتَ أَنْ تَرْكَعَهُمَا قَبْلَ الصُّبْحِ فَارْكَعْهُمَا بَعْدَ الصُّبْحِ ""","","","","","Book of Prayer"
"3887","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" إِذَا أُقِيمَتِ الصَّلاةُ وَلَمْ تَرْكَعْ رَكْعَتَيِ الْفَجْرِ صَلِّ مَعَ الإِمَامِ , فَإِذَا فَرَغَ ارْكَعْهُمَا بَعْدَ الصُّبْحِ ""","","","","","Book of Prayer"
"3888","\" وَرَأَيْتُ ابْنَ جُرَيْجٍ رَكَعَهُمَا بَعْدَ الصُّبْحِ فِي مَسْجِدِ صَنْعَاءَ بَعْدَمَا سَلَّمَ الإِمَامُ ""","","","","","Book of Prayer"
"3889","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ رَبِّهِ بْنَ سَعِيدٍ , أَخُو يَحْيَى بْنِ سَعِيدٍ يُحَدِّثُ , عَنْ جَدِّهِ , قَالَ : \" خَرَجَ إِلَى الصُّبْحِ , فَدَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الصُّبْحِ , وَلَمْ يَكُنْ رَكَعَ رَكْعَتَيِ الْفَجْرِ , فَصَلَّى مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ قَامَ حِينَ فَرَغَ مِنَ الصُّبْحِ , فَرَكَعَ رَكْعَتَيِ الْفَجْرِ \" , فَمَرَّ بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : \" مَا هَذِهِ الصَّلاةُ ؟ \" , فَأَخْبَرَهُ , فَسَكَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمَضَى وَلَمْ يَقُلْ شَيْئًا","","","","","Book of Prayer"
"3890","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , دَخَلَ الْمَسْجِدَ وَالْقَوْمُ فِي الصَّلاةِ , وَلَمْ يَكُنْ صَلَّى رَكْعَتَيِ الْفَجْرِ , فَدَخَلَ مَعَ الْقَوْمِ فِي صَلاتِهِمْ , ثُمَّ قَعَدَ , حَتَّى إِذَا أَشْرَقَتْ لَهُ الشَّمْسُ قَضَاهَا , قَالَ : \" وَكَانَ إِذَا أُقِيمَتِ الصَّلاةُ وَهُوَ فِي الطُّرُقِ صَلاهُمَا فِي الطَّرِيقِ ""","","","","","Book of Prayer"
"3891","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي صَالِحُ بْنُ كَيْسَانَ , عَنْ مُخْبِرٍ أَخْبَرَهُ , عَنِ ابْنِ عُمَرَ , أَنَّهُ رَكَعَ فِي الضُّحَى رَكْعَتَيْنِ , وَلَمْ يُصَلِّ صَلاةَ الضُّحَى قَطُّ , فَقِيلَ لَهُ : مَا رَأَيْنَاكَ تُصَلِّي هَذِهِ الصَّلاةَ قَطُّ , قَالَ : \" إِنِّي كُنْتُ نَسِيتُ رَكْعَتَيِ الْفَجْرِ فَرَكَعْتُهُمَا الآنَ ""","","","","","Book of Prayer"
"3892","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ , بَيْنَا هُوَ يَلْبَسُ لِلصُّبْحِ إِذْ سَمِعَ الإِقَامَةَ , فَصَلَّى فِي الْحُجْرَةِ رَكْعَتَيِ الْفَجْرِ , ثُمَّ خَرَجَ فَصَلَّى مَعَ النَّاسِ , قَالَ : \" وَكَانَ ابْنُ عُمَرَ إِذَا وَجَدَ الإِمَامَ يُصَلِّي وَلَمْ يَكُنْ رَكَعَهُمَا , دَخَلَ مَعَ الإِمَامِ , ثُمَّ يُصَلِّيهِمَا بَعْدَ طُلُوعِ الشَّمْسِ ""","","","","","Book of Prayer"
"3893","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى , قَالَ : بَلَغَنَا , عَنْ أَبِي الدَّرْدَاءِ , أَنَّهُ كَانَ يَقُولُ : \" نَعَمْ وَاللَّهِ , لَئِنْ دَخَلْتُ وَالنَّاسُ فِي الصَّلاةِ لأَعْمِدَنَّ إِلَى سَارِيَةٍ مِنْ سَوَارِي الْمَسْجِدِ , ثُمَّ لأَرْكَعَنَّهُمَا ثُمَّ لأُكْمِلَنَّهُمَا , ثُمَّ لا أَعْجَلُ عَنْ إِكْمَالِهِمَا , ثُمَّ أَمْشِي إِلَى النَّاسِ فَأُصَلِّي مَعَ النَّاسِ الصُّبْحَ ""","","","","","Book of Prayer"
"3894","عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي مُوسَى , قَالَ : \" جَاءَنَا ابْنُ مَسْعُودٍ وَالإِمَامُ يُصَلِّي الْفَجْرَ , فَصَلَّى رَكْعَتَيْنِ إِلَى سَارِيَةٍ , وَلَمْ يَكُنْ صَلَّى رَكْعَتَيِ الْفَجْرِ \" , عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي مُوسَى , عَنِ ابْنِ مَسْعُودٍ مِثْلَهُ عَنْ مَعْمَرٍ , قَالَ : وَكَانَ الْحَسَنُ يَفْعَلُهُ","","","","","Book of Prayer"
"3895","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي الضُّحَى , وَعَاصِمٍ , عَنِ الشَّعْبِيِّ : \" أَنَّ مَسْرُوقًا كَانَ يُصَلِّيهِمَا وَالإِمَامُ قَائِمٌ يُصَلِّي فِي الْمَسْجِدِ ""","","","","","Book of Prayer"
"3896","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ , قال : \" إِذَا دَخَلْتَ الْمَسْجِدَ وَالإِمَامُ فِي الصَّلاةِ , وَلَمْ تَكُنْ رَكَعْتَ رَكْعَتَيِ الْفَجْرِ , فَصَلِّهِمَا ثُمَّ ادْخَلْ مَعَ الإِمَامِ \" , قَالَ هِشَامٌ : \" وَكَانَ ابْنُ عُمَرَ , وَالنَّخَعِيُّ يَدْخُلانِ مَعَ الإِمَامِ , وَلا يَرْكَعَانِ حِينَئِذٍ ""","","","","","Book of Prayer"
"3897","عَنِ الثَّوْرِيِّ , عَنِ الشَّعْبِيِّ , قال : \" إِنْ لَمْ يَقْضِ رَكْعَتَيِ الْفَجْرِ , فَلَيْسَ عَلَيْهِ شَيْءٌ ""","","","","","Book of Prayer"
"3898","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَامَ فِي صَلاةِ الْفَجْرِ حِينَ رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ , قَالَ : \" رَبَّنَا وَلَكَ الْحَمْدُ \" فِي الرَّكْعَةِ الآخِرَةِ , قَالَ : \" اللَّهُمَّ ! الْعَنْ فُلانًا وَفُلانًا \" , دَعَا عَلَى نَاسٍ مِنَ الْمُنَافِقِينَ , قَالَ : فَأَنْزَلَ اللَّهُ :  لَيْسَ لَكَ مِنَ الأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ ","","","","","Book of Prayer"
"3899","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : لَمَّا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ الآخِرَةِ فِي صَلاةِ الْفَجْرِ , قَالَ : \" اللَّهُمَّ ! رَبَّنَا وَلَكَ الْحَمْدُ , اللَّهُمَّ ! أَنْجِ الْوَلِيدَ بْنَ الْوَلِيدِ , وَسَلَمَةَ بْنَ هِشَامٍ , وَعَيَّاشَ بْنَ أَبِي رَبِيعَةَ , وَالْمُسْتَضْعَفِينَ مِنَ الْمُؤْمِنِينَ بِمَكَّةَ , اللَّهُمَّ اشْدُدْ وَطْأَتَكَ عَلَى مُضَرَ , وَاجْعَلْهَا عَلَيْهِمْ كَسِنِي يُوسُفَ ""","","","","","Book of Prayer"
"3900","أَخْبَرَنَا مَعْمَرٌ , عَنْ عَاصِمٍ , عَنْ أَنَسٍ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَنَتَ شَهْرًا فِي صَلاةِ الصُّبْحِ , يَدْعُو عَلَى أَحْيَاءٍ مِنْ أَحْيَاءِ الْعَرَبِ , عُصَيَّةَ , وَذَكْوَانَ , وَرِعْلٍ , وَلِحْيَانَ , وَكُلُّهُمْ مِنْ بَنِي سُلَيْمٍ ""","","","","","Book of Prayer"
"3901","عَنْ مَعْمَرٍ , عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ , عَنْ رَجُلٍ مِنْ أَهْلِ الطَّائِفِ , قَالَ : جَاءَ كَلْبٌ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي بِالنَّاسِ صَلاةَ الْعَصْرِ لَيَمُرَّ بَيْنَ أَيْدِيهِمْ , فَقَالَ رَجُلٌ مِنَ الْقَوْمِ : اللَّهُمَّ احْبِسْهُ , فَمَاتَ الْكَلْبُ , فَلَمَّا انْصَرَفَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" أَيُّكُمْ دَعَا عَلَيْهِ ؟ \" , فَقَالَ رَجُلٌ : أَنَا يَا رَسُولَ اللَّهِ , فَقَالَ : \" لَوْ دَعَا عَلَى أُمَّةٍ لاسْتُجِيبَ لَهُ ""","","","","","Book of Prayer"
"3902","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْمَلِكِ بْنُ أَبِي بَكْرٍ , قَالَ : فَرَّ عَيَّاشُ بْنُ أَبِي رَبِيعَةَ , وَسَلَمَةُ بْنُ هِشَامٍ , وَالْوَلِيدُ بْنُ الْوَلِيدِ بْنِ الْمُغِيرَةِ مِنَ الْمُشْرِكِينَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَعَيَّاشٌ , وَسَلَمَةُ مُكَبَّلانِ مُرْتَدِفَانِ عَلَى بَعِيرٍ , وَالْوَلِيدُ يَسُوقُ بِهِمَا , فَكُلِمَتْ إِصْبَعُ الْوَلِيدِ , فَقَالَ : هَلْ أَنْتِ إِلا إِصْبَعٌ دَمِيَتِ وَفِي سَبِيلِ اللَّهِ مَا لَقِيتِ فَعَلِمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَخْرَجَهُمْ إِلَيْهِ وَشَأْنَهُمْ , قَبْلَ أَنْ يَعْلَمَ النَّاسُ , فَصَلَّى الصُّبْحَ فَرَكَعَ فِي أَوَّلِ رَكْعَةٍ مِنْهُمَا , فَلَمَّا رَفَعَ رَأْسَهُ دَعَا لَهُمَا قَبْلَ أَنْ يَسْجُدَ , فَقَالَ : \" اللَّهُمَّ ! أَنْجِ عَيَّاشَ بْنَ أَبِي رَبِيعَةَ , اللَّهُمَّ ! أَنْجِ سَلَمَةَ بْنَ هِشَامٍ , اللَّهُمَّ ! أَنْجِ الْوَلِيدَ ابْنَ الْوَلِيدِ , اللَّهُمَّ ! أَنْجِ الْمُسْتَضْعَفِينَ مِنَ الْمُؤْمِنِينَ , اللَّهُمَّ اشْدُدْ وَطْأَتَكَ عَلَى مُضَرَ , وَاجْعَلْهَا عَلَيْهِمْ سِنِينَ كَسِنِي يُوسُفَ ""","","","","","Book of Prayer"
"3903","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : دَعَوْتُ فِي الْمَكْتُوبَةِ عَلَى رَجُلٍ فَسَمَّيْتُهُ بِاسْمِهِ , قَالَ : قَدِ انْقَطَعَتْ صَلاتُكَ , ثُمَّ أَخْبَرَنِي حِينَئِذٍ , قَالَ : دَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعَيَّاشِ بْنِ أَبِي رَبِيعَةَ وَرَكَعَ , فَلَمَّا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ , قَالَ وَهُوَ قَائِمٌ : \" اللَّهُمَّ ! أَنْجِ عَيَّاشَ بْنَ أَبِي رَبِيعَةَ , وَالْوَلِيدَ بْنَ الْوَلِيدِ بْنِ الْمُغِيرَةِ , وَسَلَمَةَ بْنَ هِشَامٍ , وَالْمُسْتَضْعَفِينَ مِنْ عِبَادَكَ \" , قُلْتُ : فَدَعَا بِهَذَا وَسَمَّى مَا سَمَّى , قَالَ : لا أَدْرِي أَكَانَ فِي سُبْحَةٍ أَوْ مَكْتُوبَةٍ , قُلْتُ : أَرَأَيْتَ إِنْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَعَا لَهُمْ فِي الْمَكْتُوبَةِ ؟ , قَالَ : لا أَدْرِي , وَلَعَلَّهُ أُمِرَ بِذَلِكَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَلَسْنَا كَهَيْئَتِه , قَالَ ابْنُ جُرَيْجٍ : قَالَ عَطَاءٌ : دَعَا لَهُمْ ثُمَّ لَمْ يَدْعُ بَعْدَ ذَلِكَ فِيمَا بَلَغَنِي","","","","","Book of Prayer"
"3904","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ : دَعَا الْمَرْءُ فِي الْمَكْتُوبَةِ يَسْتَغْفِرُ رَبَّهُ وَيَسْأَلُهُ , قَالَ : \" مَا أُحِبُّهُ \" , قُلْتُ : أَيَقْطَعُ ذَلِكَ صَلاتَهُ ؟ , قَالَ : \" لا \" , قُلْتُ : أَيَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : \" لا \" , قُلْتُ : أَفَتَدْعُو أَنْتَ الْمَرَّةَ فِي الْمَكْتُوبَةِ قَبْلَ أَنْ تُسَلِّمَ مِنَ التَّشَهُّدِ الآخَرِ ؟ , قَالَ : \" نَعَمْ \" , قَالَ : إِنِّي لَتَأْخُذُنِي الْمَرَّةَ الرَّغْبَةُ فِي الْمَكْتُوبَةِ فَأَسْتَغْفِرُ وَأَسْأَلُ , بِذَلِكَ قَلِيلٌ قَالَ : \" وَلا سَوَاءٌ , الدُّعَاءُ فِي الدُّنْيَا وَغَرَضِهَا , أَشَدُّ مِنَ الدُّعَاءِ لِلآخِرَةِ وَالاسْتِغْفَارِ ""","","","","","Book of Prayer"
"3905","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ عَطَاءٍ , وَمُجَاهِدٍ , قال : \" إِذَا كُنْتَ فِي الْمَكْتُوبَةِ فَلا تَدْعُ بِشَيْءٍ حَتَّى يَفْرُغَ الإِمَامُ \" , قَالَ إِبْرَاهِيمُ : وَسَمِعْتُ طَاوُسًا , يَقُولُ : \" لا تَدْعُ فِي الْمَكْتُوبَةِ , وَلا أَعْلَمُ بَعْدَ الرَّكْعَتَيْنِ إِلا التَّشَهُّدَ ""","","","","","Book of Prayer"
"3906","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ ابْنِ سِيرِينَ , قال : ادْعُ فِي الْفَرِيضَةِ بِمَا فِي الْقُرْآنِ \" , عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ مِثْلَهُ","","","","","Book of Prayer"
"3907","عَنِ الثَّوْرِيِّ , عَنْ صَدَقَةَ بْنِ يَسَارٍ , عَنْ طَاوُسٍ , قال : \" ادْعُ فِي الْفَرِيضَةِ بِمَا فِي الْقُرْآنِ \" , عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ سَعِيدٍ , عَنْ أَبِي مَعْشَرٍ , عَنْ إِبْرَاهِيمَ , مِثْلَ قَوْلِ طَاوُسٍ","","","","","Book of Prayer"
"3908","عَنْ هِشَامٍ , عَنِ الْحَسَنِ , قال : \" ادْعُ فِي الْفَرِيضَةِ بِمَا شِئْتَ ""","","","","","Book of Prayer"
"3909","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ ابْنَ مَسْعُودٍ , كَانَ يَقُولُ : \" احْمِلُوا حَوَائِجَكُمْ عَلَى الْمَكْتُوبَةِ \" , وَقَالَ عَمْرُو بْنُ دِينَارٍ وَغَيْرُهُ مِنْ عُلَمَائِنَا : \" مَا مِنْ صَلاةٍ أَحَبُّ إِلَيَّ مِنْ أَنْ أَدْعُوَ فِيهَا حَاجَتِي مِنَ الْمَكْتُوبَةِ \" , قَالَ ابْنُ جُرَيْجٍ : وَأَقُولُ : \" وَنَظَرْتُ فِي اسْتِفْتَاحِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ الْمَكْتُوبَةَ أَجِدُهُمْ يَدْعُونَ وَيَسْتَغْفِرُونَ فِي بَعْضِ رُكُوعِهِمْ وَسُجُودِهِمْ , فَلا بَأْسَ بِذَلِكَ ""","","","","","Book of Prayer"
"3910","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ حَفْصِ بْنِ الْفُرَافِصَةِ , قَالَ : حَدَّثَنِي مُحَدِّثٌ , عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , \" أَنَّهُ كَانَ يَدْعُو لِلزُّبَيْرِ وَأَسْمَاءَ أُمِّهِ يُسَمِّيهِمَا فِي الصَّلاةِ بِأَسْمَائِهِمَا ""","","","","","Book of Prayer"
"3911","عَنْ مَعْمَرِ بْنِ رَاشِدٍ , وَغَيْرِهِ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ حَفْصِ بْنِ الْفُرَافِصَةِ , أَنَّهُ سَمِعَ عُرْوَةَ بْنَ الزُّبَيْرِ , يَقُولُ فِي صَلاتِهِ وَهُوَ سَاجِدٌ : \" اللَّهُمَّ ! اغْفِرْ لِلزُّبَيْرِ بْنِ الْعَوَّامِ , وَلأَسْمَاءَ بِنْتِ أَبِي بَكْرٍ ""","","","","","Book of Prayer"
"3912","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَتَكْرَهُ أَنْ يُسْتَغْفَرَ فِي التَّطَوُّعِ ؟ , قَالَ \" نَعَمْ , حَتَّى يَجْلِسَ وَيَتَشَهَّدَ , ثُمَّ يَسْتَغْفِرُ جَالِسًا , قَالَ :  وَأَقِمِ الصَّلاةَ لِذِكْرِي ""","","","","","Book of Prayer"
"3913","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" بَلَغَنِي أَنَّ الْمُسْلِمِينَ كَانُوا يَتَكَلَّمُونَ فِي الصَّلاةِ كَمَا يَتَكَلَّمُ الْيَهُودُ وَالنَّصَارَى , حَتَّى نَزَلَتْ :  وَإِذَا قُرِئَ الْقُرْءَانُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا ""","","","","","Book of Prayer"
"3914","عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ , قَالَ : \" صَلَّيْتُ إِلَى جَنْبِ عَبْدِ اللَّهِ , فَمَا عَلِمْتُ مَا يَقْرَأُ حَتَّى سَمِعْتُهُ , يَقُولُ :  زِدْنِي عِلْمًا , فَعَلِمْتُ أَنَّهُ فِي طَهَ ""","","","","","Book of Prayer"
"3915","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ سَعْدِ بْنِ عُبَيْدَةَ , عَنْ صِلَةَ بْنِ زُفَرَ , عَنْ حُذَيْفَةَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" كَانَ إِذَا مَرَّ بِآيَةِ خَوْفٍ تَعَوَّذَ , وَإِذَا مَرَّ بِآيَةِ رَحْمَةٍ سَأَلَ ""","","","","","Book of Prayer"
"3916","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ , \" أَنَّهُمَا كَانَا لا يَرَيَانِ بَأْسًا أَنْ يَدْعُوَ الرَّجُلُ فِي التَّطَوُّعِ , إِذَا مَرَّ بِآيَةٍ فِيهَا ذَكَرُ الْجَنَّةِ وَالنَّارِ فَيَقِفُ عِنْدَهَا فَيَسْأَلُ وَيَتَعَوَّذُ ""","","","","","Book of Prayer"
"3917","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي الضُّحَى , أَنَّ عَائِشَةَ , مَرَّتْ بِهَذِهِ الآيَةِ :  فَمَنَّ اللَّهُ عَلَيْنَا وَوَقَانَا عَذَابَ السَّمُومِ , فَقَالَتْ : \" رَبِّ مُنَّ عَلِيَّ وَقِنِي عَذَابَ السَّمُومِ ""","","","","","Book of Prayer"
"3918","عَنِ الثَّوْرِيِّ , عَنِ السُّدِّيِّ , عَنْ عَبْدِ خَيْرٍ الْهَمْدَانِيِّ , قَالَ : سَمِعْتُ عَلِيًّا , قَرَأَ فِي صَلاةٍ : سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى , فَقَالَ \" سُبْحَانَ رَبِّيَ الأَعْلَى ""","","","","","Book of Prayer"
"3919","عَنِ الثَّوْرِيِّ , عَنْ مِسْعَرٍ , عَنْ عُمَيْرِ بْنِ سَعِيدٍ , أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ , \" قَرَأَ فِي الْجُمُعَةِ : سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى , فَقَالَ : سُبْحَانَ رَبِّيَ الأَعْلَى , وَ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ ""","","","","","Book of Prayer"
"3920","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , عَنِ ابْنِ عَبَّاسٍ , أَنَّهُ كَانَ إِذَا قَرَأَ :  أَلَيْسَ ذَلِكَ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى , قَالَ : \" سُبْحَانَكَ اللَّهُمَّ ! بَلَى \" , وَإِذَا قَرَأَ :  سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى قَالَ : \" سُبْحَانَ رَبِّيَ الأَعْلَى ""","","","","","Book of Prayer"
"3921","عَنْ مَعْمَرٍ , عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا قَرَأَ التِّينَ , وَبَلَغَ  أَلَيْسَ اللَّهُ بِأَحْكَمِ الْحَاكِمِينَ , قَالَ : \" بَلَى \" , وَإِذَا قَرَأَ :  أَلَيْسَ ذَلِكَ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى , قَالَ : \" بَلَى \" , وَإِذَا قَرَأَ :  فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ , بِمَا أُنْزِلَ , أَوْ قَالَ : \" آمَنَّا بِاللَّهِ وَبِمَا أَنْزَلَ ""","","","","","Book of Prayer"
"3922","عَنْ مَعْمَرٍ , عَنْ شَدَّادِ بْنِ جَابَانَ , قَالَ : بِتُّ عِنْدَ حُجْرٍ الْمَدَرِيِّ , فَسَمِعْتُهُ وَهُوَ يُصَلِّي مِنَ اللَّيْلِ , فَقَرَأَ , فَمَرَّ بِهَذِهِ الآيَةِ :  أَفَرَأَيْتُمْ مَا تُمْنُونَ { 58 } أَأَنْتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ { 59 } , قال : بَلْ أَنْتَ يَا رَبُّ , بَلْ أَنْتَ يَا رَبُّ , بَلْ أَنْتَ يَا رَبُّ \" , ثَلاثًا , ثُمَّ قَرَأَ :  أَفَرَأَيْتُمْ مَا تَحْرُثُونَ { 63 } أَأَنْتُمْ تَزْرَعُونَهُ أَمْ نَحْنُ الزَّارِعُونَ { 64 } , قَالَ : \" بَلْ أَنْتَ يَا رَبُّ , بَلْ أَنْتَ يَا رَبُّ , بَلْ أَنْتَ يَا رَبُّ \" , ثَلاثًا قَالَ :  أَفَرَأَيْتُمُ الْمَاءَ الَّذِي تَشْرَبُونَ { 68 } أَأَنْتُمْ أَنْزَلْتُمُوهُ مِنَ الْمُزْنِ أَمْ نَحْنُ الْمُنْزِلُونَ { 69 } , قَالَ : \" بَلْ أَنْتَ يَا رَبُّ , بَلْ أَنْتَ يَا رَبُّ \" , ثَلاثًا , ثُمَّ قَالَ :  أَفَرَأَيْتُمُ النَّارَ الَّتِي تُورُونَ { 71 } أَأَنْتُمْ أَنْشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ الْمُنْشِئُونَ { 72 } قَالَ : \" بَلْ أَنْتَ يَا رَبُّ \" , قَالَهَا : ثَلاثًا","","","","","Book of Prayer"
"3923","عَنْ هِشَامٍ , عَنِ ابْنِ سِيرِينَ , \" كَرِهَ أَنْ يَمُرَّ الرَّجُلُ بِذِكْرِ النَّارِ فَيَتَعَوَّذَ مِنْهَا فِي الْفَرِيضَةِ وَالتَّطَوُّعِ \" , قَالَ : \" وَكَانَ الْحَسَنُ لا يَرَى بَأْسًا فِي التَّطَوُّعِ ""","","","","","Book of Prayer"
"3924","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنْ مُجَاهِدٍ , قال : \" كُرِهَ إِذَا مَرَّ الإِمَامُ بِآيَةِ تَخْوِيفٍ , أَوْ آيَةِ رَحْمَةٍ , أَنْ يَقُولَ مَنْ خَلْفَهُ شَيْئًا ""","","","","","Book of Prayer"
"3925","عَنِ الثَّوْرِيِّ , عَنْ أَبِي هَاشِمٍ , عَنْ مُجَاهِدٍ , قال : \"  وَإِذَا قُرِئَ الْقُرْءَانُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا \" , قَالَ : \" هَذَا فِي الصَّلاةِ ""","","","","","Book of Prayer"
"3926","عَنْ مَنْصُورٍ , عَنْ مَالِكِ بْنِ الْحَارِثِ , قال : يَقُولُ اللَّهُ جَلَّ ثَنَاؤُهُ : إِذَا شُغِلَ الْعَبْدُ بِكِتَابِهِ عَلَى مِنْ مَسْأَلَتِهِ إِيَّايَ أَعْطَيْتُهُ أَفْضَلَ مِمَّا أُعْطِي السَّائِلِينَ ""","","","","","Book of Prayer"
"3927","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ : الدُّعَاءُ فِي التَّطَوُّعِ مِثْلُهُ فِي الْمَكْتُوبَةِ إِنْ سَمَّيْتُ إِنْسَانًا يَقْطَعُ صَلاتِي ؟ , قَالَ \" نَعَمْ , فَإِنْ قُلْتَهُ وَلَكَ وِتْرٌ فَاشْفَعْ بِرَكْعَةٍ , ثُمَّ انْصَرَفْ فَاسْتَقْبَلْ صَلاتَكَ ""","","","","","Book of Prayer"
"3928","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سُئِلَ عَطَاءٌ : أَيُصَلِّي الرَّجُلُ وَهُوَ مُخَمِّرٌ فَاهُ ؟ , قَالَ : أَحَبُّ إِلَيَّ تَنْزِعَهُ مِنْ فِيكَ , إِنِّي سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا صَلَّيْتَ فَإِنَّكَ تُنَاجِي رَبِّكَ ""","","","","","Book of Prayer"
"3929","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , \" كَرِهَ أَنْ يَجْعَلَ الرَّجُلُ يَدَهُ , أَوْ ثَوْبَهُ عَلَى فِيهِ , أَوْ عَلَى أَنْفِهِ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"3930","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيَّبِ : \" أَنَّهُ كَرِهَ أَنْ يُصَلِّيَ الرَّجُلُ وَهُوَ مُتَلَثِّمٌ ""","","","","","Book of Prayer"
"3931","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , وَابْنِ أَبِي رَوَّادٍ , أَوْ أَحَدِهِمَا , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ كَانَ يَكْرَهُ أَنْ يُصَلِّيَ الرَّجُلُ وَهُوَ مُتَلَثِّمٌ ""","","","","","Book of Prayer"
"3932","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَرِهَ أَنْ يُصَلِّيَ الرَّجُلُ وَهُوَ مُتَلَثِّمٌ \" , وَكَانَ يَقُولُ : \" إِذَا عَطَسَ الرَّجُلُ فِي الصَّلاةِ فَلْيَحْمَدِ اللَّهَ وَلا يَجْهَرْ \" , وَسَأَلْتُهُ عَنِ الرَّجُلِ يَعْطِسُ عَلَى الْخَلاءِ , قَالَ : \" يَحْمَدُ اللَّهَ , فَإِنَّهَا تَصْعَدُ ""","","","","","Book of Prayer"
"3933","عَنِ ابْنِ عُيَيْنَةَ , عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ هِلالِ بْنِ يَسَافٍ , قال : \" أَبْصَرَ جَعْدَةُ بْنُ هُبَيْرَةَ عَلَى رَجُلٍ مِغْفَرًا وَهُوَ يُصَلِّي , فَأَرْسَلَ إِلَيْهِ رَجُلا أَنِ اكْشِفِ الْمِغْفَرَ عَنْ فِيكَ ""","","","","","Book of Prayer"
"3934","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , \" أَنَّ الْحَسَنَ كَانَ يُرَخِّصُ فِي أَنْ يُصَلِّيَ الرَّجُلُ وَهُوَ مُتَلَثِّمٌ إِذَا كَانَ مِنْ بَرْدٍ , أَوْ عُذْرٍ","","","","","Book of Prayer"
"3935","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَقُولُ فِي الْمَكْتُوبَةِ \" سُبْحَانَ اللَّهِ , سُبْحَانَ اللَّهِ , وَأُشِيرُ بِيَدِي ثُمَّ أَسْتَوِي إِلَى الصَّفِّ ؟ , قَالَ : نَعَمْ , ذَاكَ حَسَنٌ ""","","","","","Book of Prayer"
"3936","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" التَّسْبِيحُ لِلرِّجَالِ , وَالتَّصْفِيقُ لِلنِّسَاءِ , إِسْ إِسْ فِي الصَّلاةِ \" , قَالَ عَطَاءٌ : وَتَكَلَّمَ أَبُو هُرَيْرَةَ بِإِسْ إِسْ فِي الصَّلاةِ , قَالَ : قَالَ أَبُو هُرَيْرَةَ فِي الصَّلاةِ : \" كَذَلِكَ مِنْ قَوْلِ الرِّجَالِ وَالنِّسَاءِ \" , وَأَحَبُّ إِلَى عَطَاءٍ أَنْ يُسَبِّحْنَ مِنَ التَّصْفِيقِ مِنْ إِسْ إِسْ , قَالَ عَطَاءٌ : وَصَفَّقَ أَبُو هُرَيْرَةَ بِيَدَيْهِ","","","","","Book of Prayer"
"3937","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" التَّسْبِيحُ لِلرِّجَالِ , وَالتَّصْفِيقُ لِلنِّسَاءِ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"3938","عَنْ مَعْمَرٍ , عَنْ هَمَّامِ بْنِ مُنَبِّهٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" التَّسْبِيحُ لِلرِّجَالِ , وَالتَّصْفِيقُ لِلنِّسَاءِ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"3939","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ ذَكْوَانَ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : \" التَّسْبِيحُ لِلرِّجَالِ , وَالتَّصْفِيقُ لِلنِّسَاءِ ""","","","","","Book of Prayer"
"3940","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" التَّسْبِيحُ لِلرِّجَالِ , وَالتَّصْفِيقُ لِلنِّسَاءِ فِي الإِذْنِ ""","","","","","Book of Prayer"
"3941","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَبِي حَازِمٍ , قَالَ : كُنْتُ عِنْدَ سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ , إِذْ قِيلَ لَهُ : كَانَ بَيْنَ بَنِي عَمْرِو بْنِ عَوْفٍ وَأَهْلِ قُبَا شَيْءٌ , فَقَالَ : قَدِيمًا كَانَ ذَلِكَ , كُنَّا عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذْ جِيءَ , فَقِيلَ لَهُ : كَانَ بَيْنَ أَهْلِ قُبَا شَيْءٌ , فَانْطَلَقَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَيْهِمْ لِيُصْلِحَ بَيْنَهُمْ , فَأَبْطَأَ عَلَى النَّاسِ , فَقَالَ بِلالٌ لأَبِي بَكْرٍ : أَلا أُقِيمُ بِالصَّلاةِ ؟ , قَالَ : مَا شِئْتَ , فَأَقَامَ بِلالٌ فَقَدَّمَ النَّاسُ أَبَا بَكْرٍ , فَبَيْنَا هُوَ يُصَلِّي أَقْبَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَجَعَلَ يَشُقُّ الصُّفُوفَ حَتَّى قَامَ خَلْفَ أَبِي بَكْرٍ , فَجَعَلُوا يُصَفِّقُونَ , وَكَانَ لا يَلْتَفِتُ فِي الصَّلاةِ , فَلَمَّا أَكْثَرُوا الْتَفَتَ , فَإِذَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَائِمٌ خَلْفَهُ فَأَشَارَ إِلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُصَلِّيَ كَمَا هُوَ , فَنَكَصَ إِلَى وَرَائِهِ , وَتَقَدَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَصَلَّى , فَلَمَّا فَرَغَ , قَالَ : \" مَا مَنَعَكَ إِذْ أُمِرْتُ أَنْ لا تَكُونَ قَدْ صَلَّيْتَ ؟ \" , قَالَ : لا يَنْبَغِي لابْنِ أَبِي قُحَافَةَ أَنْ يَتَقَدَّمَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا شَأْنُ التَّصْفِيقِ فِي الصَّلاةِ ؟ إِنَّمَا التَّسْبِيحُ لِلرِّجَالِ , وَالتَّصْفِيقُ لِلنِّسَاءِ ""","","","","","Book of Prayer"
"3942","عَنِ ابْنِ جُرَيْجٍ , عَنْ رَجُلٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : خَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمًا إِلَى الْمَسْجِدِ , فَقَالَ : \" أَيْنَ الْفَتَى الدَّوْسِيُّ ؟ \" , قَالَ : هُوَ ذَاكَ يَا رَسُولَ اللَّهِ , يُوعَكُ فِي مُؤَخَّرِ الْمَسْجِدِ , فَأَتَانِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَمَسَحَ عَلَى رَأْسِي , وَقَالَ لِي : \" مَعْرُوفًا , ثُمَّ أَقْبَلَ عَلَى النَّاسِ , فَقَالَ : إِنْ أَنَا سَهَوْتُ فِي صَلاتِي فَلْيُسَبِّحِ الرِّجَالُ , وَلْيُصَفِّقِ النِّسَاءُ \" , قَالَ : فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَمْ يَسْهُ فِي شَيْءٍ مِنْ صَلاتِهِ , وَمَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَفَّانِ وَنِصْفٌ مِنَ الرِّجَالِ , وَصَفَّانِ مِنَ النِّسَاءِ , أَوْ صَفَّانِ مِنَ الرِّجَالِ وَصَفَّانِ وَنِصْفٌ مِنَ النِّسَاءِ","","","","","Book of Prayer"
"3943","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أخْبَرَنِي عَطَاءٌ , قَالَ : اشْتَكَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَ أَبَا بَكْرٍ أَنْ يُصَلِّيَ بِالنَّاسِ , فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِلنَّاسِ قَاعِدًا وَجَعَلَ أَبَا بَكْرٍ وَرَاءَهُ بَيْنَهُ وَبَيْنَ النَّاسِ , قَالَ : وَصَلَّى النَّاسُ وَرَاءَهُ قِيَامًا , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَوِ اسْتَقْبَلْتُ مِنْ أَمْرِي مَا اسْتَدْبَرْتُ مَا صَلَّيْتُمْ إِلا قُعُودًا بِصَلاةِ إِمَامِكُمْ , مَا كَانَ يُصَلِّي قَائِمًا فَصَلُّوا قِيَامًا , وَإِنْ صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا ""","","","","","Book of Prayer"
"3944","عَنِ ابْنِ جُرَيْجٍ , قَالَ : \" صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَمَرَ أَبَا بَكْرٍ فَقَامَ حِذْوَهُ إِلَى جَنْبِهِ , فَقَرَأَ , فَإِذَا خَتَمَ وَكَانَتِ الرَّكْعَةُ قَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَرَكَعَ وَسَجَدَ بِالنَّاسِ \" , قُلْتُ : وَكَمْ صَلَّى وَأَيَّةُ صَلاةٍ تِلْكَ ؟ , قَالَ : لا أَدْرِي إِلا أَنَّهَا صَلاةٌ فِيهَا قِرَاءَةٌ","","","","","Book of Prayer"
"3945","عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , قَالَ : \" خَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمًا , وَأَبُو بَكْرٍ يُصَلِّي بِالنَّاسِ , فَذَهَبَ أَبُو بَكْرٍ يَنْكُصُ , فَأَشَارَ إِلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُصَلِّيَ كَمَا هُوَ \" , قَالَ : \" فَجَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَجَلَسَ إِلَى جَنْبِهِ , فَكَانَ النَّاسُ يُصَلُّونَ بِصَلاةِ أَبِي بَكْرٍ , وَكَانَ أَبُو بَكْرٍ يُصَلِّي بِصَلاةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَالِسٌ ""","","","","","Book of Prayer"
"3946","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : \" جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي مَرَضِهِ حَتَّى جَلَسَ فِي مُصَلاهُ , وَقَامَ أَبُو بَكْرٍ إِلَى جَنْبِهِ , فَصَلَّى قَائِمًا يَأْتَمُّ بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَالنَّاسُ يَأْتَمُّونَ بِأَبِي بَكْرٍ ""","","","","","Book of Prayer"
"3947","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : سَقَطَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ فَرَسٍ فَجُحِشَ شِقُّهُ الأَيْمَنُ , فَدَخَلُوا عَلَيْهِ فَصَلَّى بِهِمْ قَاعِدًا , وَأَشَارَ إِلَيْهِمْ أَنِ اقْعُدُوا , فَلَمَّا سَلَّمَ , قَالَ : \" إِنَّمَا جُعِلَ الإِمَامُ لِيُؤْتَمَّ بِهِ , فَإِذَا كَبَّرَ فَكَبِّرُوا , وَإِذَا رَكَعَ فَارْكَعُوا , فَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , قُولُوا : رَبَّنَا وَلَكَ الْحَمْدُ , وَإِذَا سَجَدَ فَاسْجُدُوا , وَإِذَا صَلَّى جَالِسًا فَصَلُّوا جُلُوسًا أَجْمَعِينَ \" , قَالَ أَبُو عُرْوَةَ : \" وَبَلَغَنِي أَنَّهُ لا يَنْبَغِي ذَلِكَ لأَحَدٍ غَيْرَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"3948","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : سَقَطَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ فَرَسٍ فَجُحِشَ شِقُّهُ الأَيْمَنُ , فَصَلَّى بِهِمْ قَاعِدًا وَصَلُّوا مَعَهُ قُعُودًا , فَلَمَّا انْصَرَفَ , قَالَ : \" إِنَّمَا جُعِلَ الإِمَامُ لِيُؤْتَمَّ بِهِ , فَإِذَا صَلَّى قَائِمًا فَصَلُّوا قِيَامًا , وَإِذَا رَكَعَ فَارْكَعُوا , وَإِذَا قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَقُولُوا : رَبَّنَا وَلَكَ الْحَمْدُ , وَإِذَا صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا أَجْمَعِينَ ""","","","","","Book of Prayer"
"3949","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , قَالَ : \" صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَاعِدًا يَؤُمُّ النَّاسَ , فَقَامَ النَّاسُ خَلْفَهُ , فَأَخْلَفَ يَدَهُ إِلَيْهِمْ يُومِئُ بِهَا إِلَيْهِمْ أَنِ اجْلِسُوا ""","","","","","Book of Prayer"
"3950","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ عُبَيْدٍ , عَنِ الْحَسَنِ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اشْتَكَى , فَدَخَلَ عَلَيْهِ عُمَرُ وَنَفَرٌ مَعَهُ يَعُودُونَهُ , فَحَضَرَتِ الصَّلاةُ فَصَلَّى بِهِمْ قَاعِدًا وَهُمْ قِيَامٌ , وَأَشَارَ إِلَيْهِمْ بِيَدِهِ أَنِ اجْلِسُوا , فَلَمَّا فَرَغَ , قَالَ : \" إِنَّ فَارِسَ إِنَّمَا تَفَضَّلَتْ عَلَيْهِمْ مُلُوكُهُمْ لأَنَّهُمْ يَجْلِسُونَ وَيُقَامُ لَهُمْ , فَلا تَفْعَلُوا ذَلِكَ \" , وَأَشَارَ بِيَدِهِ إِلَى وَرَائِهِ مِنْ غَيْرِ أَنْ يَرْفَعَهُمَا إِلَى عَاتِقِهِ","","","","","Book of Prayer"
"3951","عَنْ مَعْمَرٍ , عَنْ هَمَّامِ بْنِ مُنَبِّهٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّمَا جُعِلَ الإِمَامُ لِيُؤْتَمَّ بِهِ , فَلا تَخْتَلِفُوا عَلَيْهِ , فَإِذَا كَبَّرَ فَكَبِّرُوا , وَإِذَا رَكَعَ فَارْكَعُوا , وَإِذَا , قَالَ : سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَقُولُوا : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ , وَإِذَا سَجَدَ فَاسْجُدُوا , وَإِذَا صَلَّى جَالِسًا فَصَلُّوا جُلُوسًا أَجْمَعِينَ ""","","","","","Book of Prayer"
"3952","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقُولُ : \" الإِمَامُ أَمِيرٌ , فَإِنْ صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا , وَإِنْ صَلَّى قَائِمًا فَصَلُّوا قِيَامًا ""","","","","","Book of Prayer"
"3953","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ , قَالَ : أَخْبَرَنِي قَيْسُ بْنُ قَهْدٍ الأَنْصَارِيُّ , أَنَّ إِمَامَهُمُ اشْتَكَى عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" فَكَانَ يَؤُمُّنَا جَالِسًا وَنَحْنُ جُلُوسٌ ""","","","","","Book of Prayer"
"3954","عَنِ ابْنِ عُيَيْنَةَ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , \" أَنَّ أُسَيْدَ بْنَ حُضَيْرٍ , اشْتَكَى وَكَانَ يَؤُمُّ قَوْمَهُ جَالِسًا ""","","","","","Book of Prayer"
"3955","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" أَحَبُّ إِلَيَّ إِذَا اشْتَكَى الإِمَامُ أَنْ يُؤَمِّرَ مَنْ يُصَلِّي بِالنَّاسِ إِذَا كَانَ لا يَسْتَطِيعُ أَنْ يُصَلِّيَ إِلا قَاعِدًا \" , قَالَ : \" وَإِنْ صَلَّى الإِمَامُ قَاعِدًا فَالسُّنَّةُ \" , قُلْتُ : فَإِنْ صَلَّى قَاعِدًا أُصَلِّي مَعَهُ أَوْ أَدَعُهُ ؟ , قَالَ : \" بَلْ صَلِّ مَعَهُ , أَتَرْغَبُ عَنْ سَنَةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ \" , قَالَ : \" وَأَحَبُّ إِلَيَّ أَنْ يُقَدِّمُوا غَيْرَهُ مِنْهُمْ ""","","","","","Book of Prayer"
"3956","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا يُؤَمَّنَّ رَجُلٌ بَعْدِي جَالِسًا ""","","","","","Book of Prayer"
"3957","عَنْ إِسْرَائِيلَ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا يُؤَمَّنَّ رَجُلٌ بَعْدِي جَالِسًا \" , قَالَ : \" وَمَا رَأَيْتُ النَّاسَ إِلا عَلَى الإِمَامِ , إِذَا صَلَّى قَاعِدًا صَلَّى مَنْ خَلْفَهُ قُعُودًا , وَهِيَ سُنَّةٌ مِنْ غَيْرِ وَاحِدٍ ""","","","","","Book of Prayer"
"3958","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ السَّائِبِ بْنِ يَزِيدَ , عَنِ المُطَّلِبِ بْنِ أَبِي وَدَاعَةَ السَّهْمِيِّ , عَنْ حَفْصَةَ , قَالَتْ : \" لَمْ أَرَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي قَاعِدًا حَتَّى كَانَ قَبْلَ مَوْتِهِ بِعَامٍ , أَوِ اثْنَيْنِ , وَكَانَ يُصَلِّي فِي سُبْحَتِهِ جَالِسًا , وَيُرَتِّلُ السُّورَةَ حَتَّى يَكُونَ فِي قِرَاءَةٍ أَطْوَلَ مِنْهَا ""","","","","","Book of Prayer"
"3959","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَ عُثْمَانُ بْنُ أَبِي سُلَيْمَانَ , أَنَّ أَبَا سَلَمَةَ أَخْبَرَهُ , أَنَّ عَائِشَةَ أَخْبَرَتْهُ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَمُتْ حَتَّى كَانَ أَكْثَرُ صَلاتِهِ وَهُوَ جَالِسٌ ""","","","","","Book of Prayer"
"3960","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أُمِّ سَلَمَةَ , قَالَتْ : \" وَالَّذِي تَوَفَّى نَفْسَهُ يَعْنِي النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , مَا تُوُفِّيَ حَتَّى كَانَ كَثِيرٌ مِنْ صَلاتِهِ قَاعِدًا إِلا الْمَكْتُوبَةَ , وَكَانَ أَعْجَبُ الْعَمَلِ إِلَيْهِ الَّذِي يَدُومُ عَلَيْهِ صَاحِبُهُ , وَإِنْ كَانَ يَسِيرًا ""","","","","","Book of Prayer"
"3961","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ أَبِي مُلَيْكَةَ , قَالَ : سَمِعْتُ أَهْلَ عَائِشَةَ يَذْكُرُونَ أَنَّهَا كَانَتْ , تَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَدِيدَ الإِنْصَابِ لِجَسَدِهِ فِي الْعِبَادَةِ , غَيْرَ أَنَّهُ حِينَ دَخَلَ فِي السِّنِّ , وَثَقُلَ مِنَ اللَّحْمِ كَانَ أَكْثَرَ مَا يُصَلِّي وَهُوَ قَاعِدٌ ""","","","","","Book of Prayer"
"3962","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : \" بَلَغَنَا أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَمُتْ حَتَّى صَلَّى جَالِسًا ""","","","","","Book of Prayer"
"3963","أَخْبَرَنَا مَعْمَرٌ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصَلِّي قَاعِدًا , فَإِذَا كَانَ عِنْدَ رُكُوعِهِ قَامَ فَقَرَأَ ثَلاثِينَ آيَةً أَوْ أَرْبَعِينَ آيَةً , ثُمَّ رَكَعَ ""","","","","","Book of Prayer"
"3964","عَنِ الثَّوْرِيِّ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , عَنْ عَائِشَةَ قَالَتْ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لا يَقْرَأُ فِي شَيْءٍ مِنْ صَلاةِ اللَّيْلِ جَالِسًا حَتَّى دَخَلَ فِي السِّنِّ , وَكَانَ إِذَا بَقِيَتْ عَلَيْهِ ثَلاثُونَ آيَةً , أَوْ أَرْبَعُونَ آيَةً قَامَ فَقَرَأَهَا ثُمَّ سَجَدَ ""","","","","","Book of Prayer"
"3965","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ مُحَمَّدِ بْنِ سِيرِينَ , عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ , قَالَ : سَأَلْنَا عَائِشَةَ , عَنْ صَلاةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى قَائِمًا رَكَعَ قَائِمًا , وَإِذَا صَلَّى جَالِسًا رَكَعَ جَالِسًا ""","","","","","Book of Prayer"
"3966","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ , قَالَ : سَأَلْنَا عَائِشَةَ عَنْ صَلاةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَتْ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي لَيْلا طَوِيلا قَائِمًا , وَلَيْلا طَوِيلا قَاعِدًا \" , قُلْتُ : كَيْفَ كَانَ يَصْنَعُ ؟ , قَالَتْ : \" كَانَ إِذَا قَرَأَ قَائِمًا رَكَعَ قَائِمًا , وَإِذَا قَرَأَ قَاعِدًا رَكَعَ قَاعِدًا ""","","","","","Book of Prayer"
"3967","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" يُسْتَحَبُّ لِلرَّجُلِ إِذَا أَرَادَ أَنْ يُصَلِّيَ قَاعِدًا , أَنْ يَفْتَتِحَ صَلاتَهُ بِرَكْعَتَيْنِ قَائِمًا ""","","","","","Book of Prayer"
"3968","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : يُصَلِّي الرَّجُلُ وَهُوَ جَالِسٌ فِي التَّطَوُّعِ إِنْ شَاءَ مُتَرَبِّعًا , وَإِنْ مُحْتَبِيًا \" , قَالَ : \" وَابْسُطْ رِجْلَكَ إِنْ شِئْتَ بَعْدَمَا تَتَشَهَّدُ \" , قَالَ : قُلْتُ : فَمُتَّكِئًا ؟ , قَالَ : \" لا ""","","","","","Book of Prayer"
"3969","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ : \" أَنَّهُ كَانَ يَحْتَبِي فِي آخِرِ صَلاتِهِ فِي التَّطَوُّعِ ""","","","","","Book of Prayer"
"3970","وَذَكَرَ الثَّوْرِيُّ , عَنِ ابْنِ أَبِي ذِئْبٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , قال : \" إِذَا أَرَادَ أَنْ يَسْجُدَ ثَنَى رِجْلَهُ وَسَجَدَ ""","","","","","Book of Prayer"
"3971","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا أَرَادَ الرَّجُلُ أَنْ يُصَلِّيَ جَالِسًا مُتَرَبِّعًا , فَإِذَا أَرَادَ أَنْ يَرْكَعَ ثَنَى فَخِذَهُ كَمَا يَجْلِسُ فِي الصَّلاةِ , ثُمَّ رَكَعَ وَسَجَدَ , وَقَوْلُ ابْنِ الْمُسَيَّبِ : أَحَبُّ إِلَى سُفْيَانَ ""","","","","","Book of Prayer"
"3972","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ : \" أَنَّهُ كَانَ يُصَلِّي جَالِسًا مُتَرَبِّعًا ""","","","","","Book of Prayer"
"3973","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , عَنْ مُحَمَّدٍ , قال : \" يُصَلِّي الرَّجُلُ قَاعِدًا مُتَرَبِّعًا ""","","","","","Book of Prayer"
"3974","عَنِ الثَّوْرِيِّ , عَنْ شَيْخٍ مِنَ الأَنْصَارِ , قَالَ : \" رَأَيْتُ أَنَسًا يُصَلِّي مُتَرَبِّعًا ""","","","","","Book of Prayer"
"3975","عَنِ الثَّوْرِيِّ , عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ الْهَيْثَمِ بْنِ شِهَابٍ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" لأَنْ يَجْلِسَ الرَّجُلُ عَلَى الرَّضْفَيْنِ خَيْرٌ مِنْ أَنْ يَجْلِسَ فِي الصَّلاةِ مُتَرَبِّعًا \" , قَالَ عَبْدُ الرَّزَّاقِ : \" يَقُولُ : إِذَا كَانَ صَلَّى قَائِمًا فَلا يَجْلِسُ يَتَشَهَّدُ مُتَرَبِّعًا , فَأَمَّا إِذَا صَلَّى قَاعِدًا فَلْيَتَرَبَّعْ ""","","","","","Book of Prayer"
"3976","عَنْ عَبْدِ اللَّهِ , عَنْ شُعْبَةَ , عَنِ الْحَكَمِ , عَنِ ابْنِ عَبَّاسٍ , \" أَنَّهُ كَانَ يَكْرَهُ التَّرَبُّعَ فِي الصَّلاةِ يَعْنِي التَّطَوُّعَ \" , قَالَ شُعْبَةُ : فَسَأَلْتُ عَنْهُ حَمَّادًا , فَقَالَ : \" لا بَأْسَ بِهِ فِي التَّطَوُّعِ ""","","","","","Book of Prayer"
"3977","عَنِ الثَّوْرِيِّ , عَنِ الْحَسَنِ بْنِ عَمْرٍو , عَنْ أَبِيهِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ : \" أَنَّهُ كَانَ يُصَلِّي مُحْتَبِيًا حَتَّى إِذَا بَقِيَتْ عَلَيْهِ عَشَرُ آيَاتٍ قَامَ فَقَرَأَ , ثُمَّ رَكَعَ ""","","","","","Book of Prayer"
"3978","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , أَنَّ عَطَاءً صَلَّى وَهُوَ مُحْتَبٍ , فَمَرَّ عَلَيْهِ سَعِيدُ بْنُ جُبَيْرٍ , فَقال : \" كَأَنَّكُمْ جُلُوسٌ تَتَحَدَّثُونَ \" , ثُمَّ أَطْلَقَ حَبْوَتَهُ , فَلَمَّا ذَهَبَ أَطْلَقَ عَطَاءٌ الْحِبْوَةَ , وَهُوَ يُصَلِّي","","","","","Book of Prayer"
"3979","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , قال : \" رَأَيْتُ ابْنَ سِيرِينَ يُصَلِّي جَالِسًا مُتَرَبِّعًا ""","","","","","Book of Prayer"
"3980","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ مَيْسَرَةَ , أَنَّ عُثْمَانَ بْنَ مُحَمَّدٍ أَخْبَرَهُ , أَنَّ مُزَاحِمَ مَوْلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ , قَالَ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ : أَعْجَبُ مِنْ صَلاةِ الرَّجُلِ مُعْجَبًا مُحْتَبِيًا مَا هِيَ بِشَيْءٍ , فَرَدَّ عَلَيْهِ عُمَرُ , وَقَالَ : قَدْ بَلَغَنَا , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَمُتْ حَتَّى كَانَ أَكْثَرُ صَلاتِهِ وَهُوَ جَالِسٌ ""","","","","","Book of Prayer"
"3981","عَنْ مَعْمَرٍ , أَنَّ عَطَاءً الْخُرَاسَانِيَّ : \" كَانَ يَحْتَبِي فِي صَلاةِ التَّطَوُّعِ , فَقُلْتُ لَهُ : مِمَّنَ أَخَذْتَ هَذَا ؟ وَحَدَّثْتُهُ بِحَدِيثِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , قَالَ : مَا أَرَى أَخَذْتُهُ إِلا مِنَ ابْنِ الْمُسَيَّبِ ""","","","","","Book of Prayer"
"3982","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ أَبِي الزِّنَادِ , قال : \" رَأَيْتُ ابْنَ الْمُسَيَّبِ يُصَلِّي وَهُوَ مُحْتَبِي فِي تَطَوَّعٍ ""","","","","","Book of Prayer"
"3983","عَنْ مَعْمَرٍ , أَوْ غَيْرِهِ : \" أَنَّ ابْنَ سِيرِينَ كَانَ يُصَلِّي وَهُوَ مُحْتَبٍ فِي التَّطَوُّعِ ""","","","","","Book of Prayer"
"3984","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَسْتَفْتِحُ الصَّلاةَ قَائِمًا فَأُصَلِّي فَأَقْرَأُ جَالِسًا وَلَمْ أَرْكَعْ وَلَمْ أَسْجُدْ ؟ , قَالَ : \" نَعَمْ \" ! , قُلْتُ : أَرْكَعُ رَكْعَةً وَاحِدَةً , ثُمَّ أَجْلِسُ فَأَقْرَأُ ؟ , قَالَ : \" لا , أَكْرَهُ أَنْ تَجْلِسَ فِي وِتْرٍ \" , قُلْتُ : فَأَسْتَفْتِحُ , ثُمَّ أَجْلِسُ بِغَيْرِ رُكُوعٍ وَلا سُجُودٍ ؟ , قَالَ : \" نَعَمْ , إِنْ شِئْتَ , لَسْتَ الآنَ فِي وِتْرٍ \" , قُلْتُ : فَجَلَسْتُ بَعْدَ رَكْعَةٍ وَاحِدَةٍ ؟ , قَالَ : \" اسْجُدْ سَجْدَتَيِ السَّهْوِ , وَلَكِنِ اجْلِسْ فِي مَثْنَى مَا شِئْتَ ""","","","","","Book of Prayer"
"3985","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" اسْتَفْتَحْتُ الصَّلاةَ قَائِمًا فَرَكَعْتُ رَكْعَةً وَسَجَدَتُ , ثُمَّ قُمْتُ , أَفَأَجْلِسُ إِنْ شِئْتُ بِغَيْرِ رُكُوعٍ وَلا سُجُودٍ ؟ , قَالَ : لا ""","","","","","Book of Prayer"
"3986","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُسْلِمٍ , أَنَّهُ سَمِعَ عَلْقَمَةَ بْنَ نَضْلَةَ يُحَدِّثُ , أَنَّهُ رَأَى ابْنَ عُمَرَ , قَالَ : \" بَيْنَا رَجُلٌ يُصَلِّي مُحْتَبِيًا قَدْ صَفَّ بَيْنَ رُكْبَتَيْهِ فَأَلْصَقَ يَدَيْهِ إِحْدَاهُمَا بِالأُخْرَى , فَجَعَلَهُمَا كَذَلِكَ بَيْنَ رُكْبَتَيْهِ اجْتَذَبَهُ ابْنُ عُمَرَ , ثُمَّ أَشَارَ إِلَيْهِ , أَنْ ضَعْ كَفَّيْكَ عَلَى رُكْبَتَيْكَ ""","","","","","Book of Prayer"
"3987","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ , قَالَ : قَدِمْنَا الْمَدِينَةَ , فَنَالَنَا وَبَاءٌ مِنْ وُعِكِ الْمَدِينَةِ شَدِيدٌ , وَكَانَ النَّاسُ يُكْثِرُونَ أَنْ يُصَلُّوا فِي سُبْحَتِهِمْ جُلُوسًا , فَخَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْهِمْ عِنْدَ الْهَاجِرَةِ , وَهُمْ يُصَلُّونَ فِي سُبْحَتِهِمْ جُلُوسًا , فَقَالَ : \" صَلاةُ الْجَالِسِ نِصْفُ صَلاةِ الْقَائِمِ \" , قَالَ : وَطَفِقَ النَّاسُ حِينَئِذٍ يَتَجَشَّمُونَ الْقِيَامَ","","","","","Book of Prayer"
"3988","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ ابْنُ شِهَابٍ : أَخْبَرَنِي أَنَسُ بْنُ مَالِكٍ , قَالَ : قَدِمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمَدِينَةِ وَهِيَ مُحِمَّةٌ فَحُمَّ النَّاسُ , فَدَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَالنَّاسُ يُصَلُّونَ قُعُودًا , فَقَالَ : \" صَلاةُ الْقَاعِدِ نِصْفُ صَلاةِ الْقَائِمِ \" , فَتَجَشَّمُوا النَّاسُ الصَّلاةَ قِيَامًا","","","","","Book of Prayer"
"3989","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِي , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" إِنَّ لِلْقَاعِدِ فِي الصَّلاةِ نِصْفَ أَجْرِ الْقَائِمِ ""","","","","","Book of Prayer"
"3990","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ هِلالِ بْنِ يَسَافٍ , عَنْ أَبِي يَحْيَى , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ , قَالَ : أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي قَاعِدًا , فَقُلْتُ : يَا رَسُولَ اللَّهِ , إِنِّي حُدِّثْتُ أَنَّكَ قُلْتَ : \" إِنَّ صَلاةَ الْقَاعِدِ عَلَى النِّصْفِ مِنْ صَلاةِ الْقَائِمِ , وَأَنْتَ تُصَلِّي جَالِسًا ؟ \" , فَقَالَ : \" أَجَلْ , وَلَكِنِّي لَسْتُ كَأَحَدٍ مِنْكُمْ ""","","","","","Book of Prayer"
"3991","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ : أَلا أُصَلِّي وَأَنَا جَالِسٌ , إِنْ شِئْتُ مِنْ غَيْرِ عِلَّةٍ ؟ , قَالَ : \" بَلَى , إِنْ شِئْتَ , وَلَكِنَّ صَلاةَ الْقَاعِدِ نِصْفُ أَجْرِ الْقَائِمِ ""","","","","","Book of Prayer"
"3992","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يُوسُفُ بْنُ مَاهَكَ , عَنْ بَعْضِ نِسَائِهِمْ : \" أَنَّهَا دَخَلَتْ عَلَى عَائِشَةَ فَصَلَّتِ الْعَصْرَ , ثُمَّ قَامَتْ فَصَلَّتْ بَعْدَهَا رَكْعَتَيْنِ , قَالَ : ثُمَّ دَخَلَتْ عَلَى أُمِّ سَلَمَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَلَّتِ الْعَصْرَ , ثُمَّ قَامَتْ فَصَلَّتْ بَعْدَهَا رَكَعَاتٍ وَهِيَ جَالِسَةٌ \" , فَقَالَتِ الْمَرْأَةُ : أَيْ أُمَّ سَلَمَةَ , إِنِّي دَخَلْتُ عَلَى أُخْتِكِ عَائِشَةَ فَصَلَّتْ رَكْعَتَيْنِ لِبَعْدِ الْعَصْرِ , قَالَتْ أُمُّ سَلَمَةَ : \" إِنَّ عَائِشَةَ أَشَبُّ مِنِّي وَأَنَا كَبِيرَةٌ ""","","","","","Book of Prayer"
"3993","قَالَ أَبُو سَعِيدٍ : لَعَلَّهُ عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ مَيْمُونِ بْنِ مِهْرَانَ , عَنْ أَبِيهِ , قَالَ : قِيلَ لَهُ : مَا عَلامَةُ مَا يُصَلِّي الْمَرِيضُ قَاعِدًا ؟ , قَالَ : \" إِذَا كَانَ لا يَسْتَطِيعُ أَنْ يَقُومَ لِدُنْيَاهُ فَلْيُصَلِّ قَاعِدًا ""","","","","","Book of Prayer"
"3994","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ كَيْفَ يُصَلِّي الْمَرِيضُ ؟ , قَالَ : \" يَكُونُ قِيَامُهُ مُرَبِّعًا \" , عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ مِثْلَهُ","","","","","Book of Prayer"
"3995","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الْهَيْثَمِ , قال : \" دَخَلْتُ عَلَى إِبْرَاهِيمَ وَهُوَ مَرِيضٌ وَهُوَ يُصَلِّي مُضْطَجِعًا عَلَى يَمِينِهِ يُومِئُ إِيمَاءً لِصَلاةِ الظُّهْرِ \" , قَالَ : وَكَانَ غَيْرُهُ مِنَ الْفُقَهَاءِ , يَقُولُ : \" كَانَ مُسْتَلْقِيًا عَلَى قَفَاهُ , تَلِي قَدَمَاهُ الْقِبْلَةَ قَدْرَ مَا لَوْ قَامَ اسْتَقْبَلَ الْقِبْلَةَ ""","","","","","Book of Prayer"
"3996","عَنْ أَبِي بَكْرِ بْنِ عُبَيْدِ اللَّهِ بْنِ عُمَرَ , عَنْ عُبَيْدِ اللَّهِ أَبِيهِ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ , قَالَ : \" يُصَلِّي الْمَرِيضُ مُسْتَلْقِيًا عَلَى قَفَاهُ تَلِي قَدَمَاهُ الْقِبْلَةَ ""","","","","","Book of Prayer"
"3997","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا كَانَ الْمَرِيضُ لا يَسْتَطِيعُ أَنْ يُصَلِّيَ إِلا مُضْطَجِعًا , فَيُصَلِّي وَهُوَ عَلَى جَنْبِهِ مُسْتَقْبِلَ الْقِبْلَةِ يُومِئُ إِيمَاءً ""","","","","","Book of Prayer"
"3998","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : الْمَرِيضُ يَكُونُ مُسْتَلْقِيًا لا يَسْتَطِيعُ أَنْ يَجْلِسَ , قال : \" فَلْيُصَلِّ مُنْحَرِفًا , فَإِنْ لَمْ يَسْتَطِعْ فَلْيُصَلِّ مُسْتَلْقِيًا يُومِئُ بِرَأْسِهِ \" , قَالَ : قُلْتُ : أَيَضَعُ يَدَيْهِ عَلَى رُكْبَتَيْهِ إِذَا رَكَعَ وَسَجَدَ ؟ , قَالَ : \" لا , وَلَكِنْ لِيُومِئْ بِرَأْسِهِ وَيَدَيْهِ , وَلِلتَّكْبِيرِ بِيَدَيْهِ ""","","","","","Book of Prayer"
"3999","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا صَلَّى الْمَرِيضُ جَالِسًا , فَإِذَا رَكَعَ وَضَعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ , وَإِذَا سَجَدَ وَضَعَ يَدَيْهِ عَلَى الأَرْضِ إِذَا اسْتَطَاعَ ""","","","","","Book of Prayer"
"4000","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا رَكَعَ الْمَرِيضُ وَضَعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ , وَإِذَا سَجَدَ وَضَعَ يَدَيْهِ عَلَى الأَرْضِ ""","","","","","Book of Prayer"
"4001","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ قَتَادَةَ , يَسْأَلُ عَنِ الْمَرِيضِ وَبِهِ الْمُدُّ أو شبهه كيف يصلي ؟ , قال : \" عَلَى كُلِّ حَالٍ , مُسْتَلْقِيًا وَمُنْحَرِفًا , فَإِذَا اسْتَقْبَلَ الْقِبْلَةَ وَكَانَ لا يَسْتَطِيعُ إِلا ذَلِكَ فَيُومِئُ إِيمَاءً , وَيَجْعَلُ سُجُودَهُ أَخْفَضَ مِنْ رُكُوعِهِ ""","","","","","Book of Prayer"
"4002","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِذَا لَمْ يَسْتَطِعْ أَنْ يَسْجُدَ عَلَى الأَرْضِ أَيَسْجُدُ عَلَى حَصِيرٍ , أَوْ يُرْفَعُ إِلَيْهِ بَطْحَاءُ عَلَى خُمْرَةٍ فَيَسْجُدُ عَلَيْهِ ؟ , قَالَ : \" لا , وَلَكِنْ لِيُومِئْ إِيمَاءً بِرَأْسِهِ , وَيَجْعَلِ السَّجْدَةَ أَخْفَضَ مِنَ الرَّكْعَةِ ""","","","","","Book of Prayer"
"4003","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : \" دَخَلَ ابْنُ عُمَرَ عَلَى صَفْوَانَ الطَّوِيلِ وَهُوَ يُصَلِّي عَلَى وِسَادَةٍ , فَنَهَاهُ أَنْ يُصَلِّيَ عَلَى حَصًى أَوْ عَلَى وِسَادَةٍ , وَأَمَرَهُ بِالإِيمَاءِ ""","","","","","Book of Prayer"
"4004","فَقَالَ سُلَيْمَانُ بْنُ مُوسَى : حَدَّثَنَا نَافِعٌ , أَنَّ ابْنَ عُمَرَ كَانَ , يَقُولُ : \" إِذَا كَانَ أَحَدُكُمْ مَرِيضًا فَلَمْ يَسْتَطِعْ سُجُودًا عَلَى الأَرْضِ فَلا يَرْفَعْ إِلَى وَجْهِهِ شَيْئًا , وَلْيَجْعَلْ سُجُودَهُ رُكُوعًا , وَلْيُومِئْ بِرَأْسِهِ \" , وَقَدْ رَأَى نَافِعٌ أَنَّ ابْنَ عُمَرَ فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ صَلَّى , فَوَضَعَ جَبْهَتَهُ مَرَّةً وَاحِدَةً , ثُمَّ لَمْ يَسْتَطِعْ بَعْدُ , فَجَعَلَ سُجُودَهُ رُكُوعًا ""","","","","","Book of Prayer"
"4005","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ عَطَاءٍ , قَالَ : دَخَلَ ابْنُ عُمَرَ عَلَى ابْنِ صَفْوَانَ الطَّوِيلِ , فَوَجَدَهُ يَسْجُدُ عَلَى وِسَادَةٍ , فَنَهَاهُ , وَقَالَ : \" أَوْمِئْ وَاجْعَلِ السُّجُودَ أَخْفَضَ مِنَ الرُّكُوعِ ""","","","","","Book of Prayer"
"4006","عَنِ الثَّوْرِيِّ , عَنْ جَبَلَةَ بْنِ سُحَيْمٍ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ , يَسْأَلُ الرَّجُلَ عَلَى الْعُودِ وَهُوَ مَرِيضٌ , فَقَالَ : \" لا آمُرُكُمْ أَنْ تَتَّخِذُوا مِنْ دُونِ اللَّهِ أَوْثَانًا , مَنِ اسْتَطَاعَ أَنْ يُصَلِّيَ قَائِمًا فَلْيُصَلِّ قَائِمًا , فَإِنْ لَمْ يَسْتَطِعْ فَجَالِسًا , فَإِنْ لَمْ يَسْتَطِعْ فَمُضَّجِعًا يُومِئُ إِيمَاءً ""","","","","","Book of Prayer"
"4007","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : كَانَ ابْنُ عُمَرَ , يَقُولُ : \" إِذَا لَمْ يَسْتَطِعُ الْمَرِيضُ عَلَى الأَرْضِ سُجُودًا أَوْمَأَ إِيمَاءً , وَكَانَ قَتَادَةُ يَكْرَهُ لِلْمَرِيضِ أَنْ يَسْجُدَ عَلَى الْجِدَارِ , أَوْ يَرْفَعَ إِلَى وَجْهِهِ حَصًى , أَوْ شَيْئًا ""","","","","","Book of Prayer"
"4008","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا كَانَ الْمَرِيضُ لا يَسْتَطِيعُ رُكُوعًا وَلا سُجُودًا أَوْمَأَ بِرَأْسِهِ فِي الرُّكُوعِ وَالسُّجُودِ وَهُوَ يُكَبِّرُ ""","","","","","Book of Prayer"
"4009","عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا كَانَ الْمَرِيضُ لا يَقْدِرُ عَلَى الرُّكُوعِ أَوْمَأَ بِرَأْسِهِ ""","","","","","Book of Prayer"
"4010","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ , عَنْ أَبِي حَرْبِ بْنِ أَبِي الأَسْوَدِ الدِّيلِيِّ , قَالَ : أَصَابَ وَالِدِي الْفَالِجُ , فَأَرْسَلَنِي إِلَى ابْنِ عُمَرَ أَيَرْفَعُ إِلَيْهِ شَيْئًا إِذَا صَلَّى ؟ , فَقَالَ ابْنُ عُمَرَ : \" أَيْضًا بَيْنَ عَيْنَيْكَ أَوْمِئْ إِيمَاءً ""","","","","","Book of Prayer"
"4011","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ زَيْدِ بْنِ مُعَاوِيَةَ , عَنْ عَلْقَمَةَ , وَالأَسْوَدَ , أَنَّ ابْنَ مَسْعُودٍ , دَخَلَ عَلَى عُتْبَةَ أَخِيهِ وَهُوَ يُصَلِّي عَلَى مِسْوَاكٍ يَرْفَعُهُ إِلَى وَجْهِهِ , فَأَخَذَهُ فَرَمَى بِهِ , ثُمَّ قَالَ : \" أَوْمِ إِيمَاءً وَلْتَكُنْ رَكْعَتُكَ أَرْفَعَ مِنْ سَجْدَتِكَ ""","","","","","Book of Prayer"
"4012","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ أُمِّ الْحَسَنِ , قَالَتْ : \" رَأَيْتُ أُمَّ سَلَمَةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَسْجُدُ عَلَى مِرْفَقَةٍ , وَهِيَ قَاعِدَةٌ أَعْنِي تُصَلِّي قَاعِدَةً ""","","","","","Book of Prayer"
"4013","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي فَزَارَةَ السُّلَمِيِّ , قَالَ : \" سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْمَرِيضِ يَسْجُدُ عَلَى الْمِرْفَقَةِ الطَّاهِرَةِ , فَقَالَ : لا بَأْسَ بِهِ ""","","","","","Book of Prayer"
"4014","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , قال : \" يَسْجُدُ الْمَرِيضُ عَلَى الْمِرْفَقَةِ الطَّاهِرَةِ , وَعَلَى الثَّوْبِ الطَّاهِرِ ""","","","","","Book of Prayer"
"4015","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ قَابُوسَ بْنِ أَبِي ظَبْيَانَ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" لا بَأْسَ بِأَنْ يَكُفَّ الثَّوْبَ الْمَرِيضُ وَيَسْجُدَ عَلَيْهِ ""","","","","","Book of Prayer"
"4016","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ \" أَنَّ عُرْوَةَ , كَانَ يُصَلِّي عَلَى الشَّيْءِ دُونَ الأَرْضِ ""","","","","","Book of Prayer"
"4017","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ : \" كَانَ يُرَخِّصُ لِلْمَرِيضِ أَنَّ يُصَلِّيَ عَلَى دَابَّتِهِ إِلَى الْقِبْلَةِ ""","","","","","Book of Prayer"
"4018","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا بَأْسَ بِأَنْ يُصَلِّيَ الْمَرِيضُ عَلَى دَابَّتِهِ مُقْبِلا إِلَى الْبَيْتِ غَيْرَ مُدْبِرٍ عَنْهُ ""","","","","","Book of Prayer"
"4019","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , قَالَ : \" أُغْمِيَ عَلَى ابْنِ عُمَرَ يَوْمًا وَلَيْلَةً فَلَمْ يَقْضِ مَا فَاتَهُ ""","","","","","Book of Prayer"
"4020","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ أُغْمِيَ عَلَيْهِ شَهْرًا فَلَمْ يَقْضِ مَا فَاتَهُ , وَصَلَّى يَوْمَهُ الَّذِي أَفَاقَ فِيهِ ""","","","","","Book of Prayer"
"4021","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" إِذَا أُغْمِيَ عَلَى الْمَرِيضِ , ثُمَّ عَقَلَ لَمْ يُعِدِ الصَّلاةَ \" , قَالَ مَعْمَرٌ : سَأَلْتُ الزُّهْرِيَّ عَنْ ذَلِكَ , فَقَالَ : \" لا يَقْضِي ""","","","","","Book of Prayer"
"4022","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَقَتَادَةَ , قَالا \" يَقْضِي صَلاةَ يَوْمِهِ وَصَلاةَ لَيْلَهِ إِذَا لَمْ يَعْقِلْ ""","","","","","Book of Prayer"
"4023","عَنِ الثَّوْرِيِّ , عَنِ السُّدِّيِّ , قَالَ : حَدَّثَنِي يَزِيدُ \" أَنَّ عَمَّارَ بْنَ يَاسِرٍ رُمِيَ , فَأُغْمِيَ عَلَيْهِ فِي الظُّهْرِ , وَالْعَصْرِ , وَالْمَغْرِبِ , وَالْعِشَاءِ , فَأَفَاقَ نِصْفَ اللَّيْلِ , فَصَلَّى الظُّهْرَ , ثُمَّ الْعَصْرَ , ثُمَّ الْمَغْرِبَ , ثُمَّ الْعِشَاءَ ""","","","","","Book of Prayer"
"4024","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا غُلِبَ الْمَرِيضُ عَلَى عَقْلِهِ ثُمَّ أَفَاقَ , فَلْيُصَلِّ مَا فَاتَهُ إِذَا عَقْلَ صَلاتَهُ كُلَّ يَوْمٍ وَلَيْلَةٍ كَذَلِكَ ""","","","","","Book of Prayer"
"4025","عَنِ ابْنِ جُرَيْجٍ , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ اشْتَكَى مَرَّةً غُلِبَ فِيهَا عَلَى عَقْلِهِ حَتَّى تَرَكَ الصَّلاةَ , ثُمَّ أَفَاقَ , فَلَمْ يُصَلِّ مَا تَرَكَ مِنَ الصَّلاةِ ""","","","","","Book of Prayer"
"4026","عَنِ الثَّوْرِيِّ فِي رَجُلٍ أُغْمِيَ عَلَيْهِ فَفَاتَتْهُ صَلاةٌ وَاحِدَةٌ لا يَدْرِي أَيَّتَهُنَّ هِيَ ؟ , قَالَ : \" يَبْدَأُ فَيُصَلِّي الْمَغْرِبَ , ثُمَّ الْفَجْرَ , ثُمَّ الظُّهْرَ , ثُمَّ يَنْوِي بِهَا الظُّهْرَ , وَالْعَصْرَ , وَالْعِشَاءَ , فَأَيَّتُهُنَّ كَانَتْ فَهِيَ أَرْبَعٌ ""","","","","","Book of Prayer"
"4027","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : فِي الْمَعْتُوهِ يُفِيقُ أَحْيَانًا , قال : \" لا يَقْضِي الصَّلاةَ إِذَا عَقَلَ ""","","","","","Book of Prayer"
"4028","عَنِ الثَّوْرِيِّ \" هَلْ يَقْضِي النَّائِمُ وَالسَّكْرَانُ الصَّلاةَ , وَلا يَقْضِي الْمَرِيضُ ؟ ""","","","","","Book of Prayer"
"4029","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ فِي الْمَجْنُونِ يُفِيقُ , قال : \" يَتَوَضَّأُ ""","","","","","Book of Prayer"
"4030","عَنْ هِشَامٍ , عَنِ الْحَسَنِ , قال : \" يَغْتَسِلُ ""","","","","","Book of Prayer"
"4031","أَخْبَرَنَا مَعْمَرٌ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , فِي الْمَعْتُوهِ يُفِيقُ أَحْيَانًا , قال : لا يَقْضِي الصَّلاةَ إِذَا عَقَلَ ""","","","","","Book of Prayer"
"4032","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْقِرَاءَةُ عَلَى الْغِنَاءِ ؟ قَالَ : مَا بَأْسَ بِذَلِكَ , سَمِعْتُ عُبَيْدَ بْنِ عُمَيْرٍ , يَقُولُ : \" كَانَ دَاوُدُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَأْخُذُ الْمِعْزَفَةَ فَيَعْزِفُ بِهَا عَلَيْهِ , يُرَدِّدُ عَلَيْهِ صَوْتَهُ , يُرِيدُ أَنْ يَبْكِيَ بِذَلِكَ وَيُبْكِي ""","","","","","Book of Prayer"
"4033","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا أَذِنَ اللَّهُ لِنَبِيٍّ مَا أَذِنَ لِنَبِيٍّ أَنْ يَتَغَنَّى بِالْقُرْآنِ ""","","","","","Book of Prayer"
"4034","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَمْ يَأْذَنِ اللَّهُ لِنَبِيٍّ مَا أَذِنَ لِنَبِيٍّ يَتَغَنَّى بِالْقُرْآنِ \" , قَالَ صَاحِبٌ لَهُ : زَادَ فِيهِ : يَجْهَرُ بِهِ","","","","","Book of Prayer"
"4035","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّهُ سَمِعَ أَبَا سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ يُخْبِرُ حَسِبْتُ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مَا أَذِنَ اللَّهُ لِشَيْءٍ كَمَا أَذِنِ لإِنْسَانٍ حَسَنِ التَّرَنُّمِ بِالْقُرْآنِ يَعْنِي مَا أَذِنِ , يَقُولُ : يَسْتَمِعُ ""","","","","","Book of Prayer"
"4036","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي سَلَمَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا أَذِنَ اللَّهُ لِنَبِيٍّ مَا أَذِنَ لإِنْسَانٍ حَسَنِ التَّرَنُّمِ بِالْقُرْآنِ ""","","","","","Book of Prayer"
"4037","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : دَخَلَ عَبْدُ اللَّهِ بْنُ عُمَرَ الْقَارِيُّ , وَالْمُتَوَكِّلُ بْنُ أَبِي نَهِيكٍ عَلَى سَعْدِ بْنِ أَبِي وَقَّاصٍ , فَقَالَ سَعْدٌ لِعَبْدِ اللَّهِ : مَنْ هَذَا ؟ , قَالَ : الْمُتَوَكِّلُ بْنُ أَبِي نَهِيكٍ , قَالَ : نَعَمْ , تُجَّارٌ كَسَبَةٌ , تُجَّارٌ كَسَبَةٌ يُؤَخِّرُونَ , سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" لَيْسَ مِنَّا مَنْ لَمْ يَتَغَنَّ بِالْقُرْآنِ ""","","","","","Book of Prayer"
"4038","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنِ ابْنِ أَبِي مُلَيْكَةَ , عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي نَهِيكٍ , عَنْ سَعْدِ بْنِ مَالِكٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَيْسَ مِنَّا مَنْ لَمْ يَتَغَنَّ بِالْقُرْآنِ ""","","","","","Book of Prayer"
"4039","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ , عَنِ الْبَرَاءِ بْنِ عَازِبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ اللَّهَ لَيَأْذَنُ لِلرَّجُلِ يَكُونُ حَسَنَ الصَّوْتِ , قَالَ : حَسِبْتُهُ يَتَغَنَّى بِالْقُرْآنِ ""","","","","","Book of Prayer"
"4040","عَنْ عَبْدِ اللَّهِ بْنِ الْمُحَرَّرِ , عَنْ قَتَادَةَ , عَنْ أَنَسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لِكُلِّ شَيْءٍ حِلْيَةٌ , وَحِلْيَةُ الْقُرْآنِ الصَّوْتُ الْحَسَنُ ""","","","","","Book of Prayer"
"4041","عَنْ مَعْمَرٍ , قال : \" كَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ حَسَنَ الصَّوْتِ , فَخَرَجَ لَيْلَةً يُصَلِّي فِي الْمَسْجِدِ , فَجَهَرَ بِصَوْتِهِ , فَاجْتَمَعَ النَّاسُ , فَأَرْسَلَ إِلَيْهِ سَعِيدُ بْنُ الْمُسَيِّبِ : فَتَنَتَ النَّاسَ , فَلَمْ يُعِدْ لِذَلِكَ ""","","","","","Book of Prayer"
"4042","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مَنْصُورٍ , وَالأَعْمَشِ , عَنْ طَلْحَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ النَّهْمِيِّ , عَنِ الْبَرَاءِ بْنِ عَازِبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ اللَّهَ وَمَلائِكَتَهُ يُصَلُّونَ عَلَى الصُّفُوفِ الأُوَلِ , وَزَيِّنُوا الْقُرْآنَ بِأَصْوَاتِكُمْ , وَمَنْ مَنَحَ مَنِيحَةَ لَبَنٍ , أَوْ مَنِيحَةَ وَرِقٍ , أَوْ أُهْدِيَ زُقَاقًا فَهُوَ كَعَدْلِ رَقَبَةٍ ""","","","","","Book of Prayer"
"4043","أَخْبَرَنَا مَعْمَرٌ , عَنْ مَنْصُورٍ , عَنْ طَلْحَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ , عَنِ الْبَرَاءِ بْنِ عَازِبٍ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" زَيِّنُوا أَصْوَاتَكُمْ بِالْقُرْآنِ \" , ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ الثَّوْرِيِّ","","","","","Book of Prayer"
"4044","عَنْ مَعْمَرٍ , وَابْنِ عُيَيْنَةَ , عَنِ الزُّهْرِيِّ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَمِعَ صَوْتَ أَبِي مُوسَى الأَشْعَرِيِّ وَهُوَ يَقْرَأُ , فَقَالَ : \" لَقَدْ أُوتِيَ أَبُو مُوسَى مِنْ مَزَامِيرِ آلِ دَاوُدَ ""","","","","","Book of Prayer"
"4045","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مَالِكِ بْنِ مِغْوَلٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ بُرَيْدَةَ يُحَدِّثُ , عَنْ أَبِيهِ , قَالَ : سَمِعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَوْتَ الأَشْعَرِيِّ أَبِي مُوسَى وَهُوَ يَقْرَأُ , فَقَالَ : \" لَقَدْ أُوتِيَ هَذَا مِزْمَارًا مِنْ مَزَامِيرِ آلِ دَاوُدَ \" , فَحَدَّثَهُ ذَلِكَ , فَقَالَ : الآنَ أَنْتَ لِي صِدِّيقٌ حِينَ أَخْبَرْتَنِي هَذَا عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لَوْ عَلِمْتُ أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَسْتَمِعُ لِقِرَاءَتِي حَبَّرْتُهَا تَحْبِيرًا , قَالَ : وَسَمِعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَوْتًا آخِرَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَتَقُولُهُ مُرَائِيًا ؟ \" , فَلَمْ أُجِبِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِشَيْءٍ حَتَّى رَدَّدَهَا عَلِيَّ مَرَّةً , أَوْ مَرَّتَيْنِ , أَوْ ثَلاثًا , فَقُلْتُ بَعْدَ اثْنَيْنِ أَوْ ثَلاثًا : أَتَقُولُهُ مُرَائِيًا بَلْ هُوَ مُنِيبٌ , قَالَ : وَسَمِعَ آخَرَ يَدْعُو : اللَّهُمَّ إِنِّي أَسْأَلُكَ بِأَنِّي أَشْهَدُ أَنَّكَ أَنْتَ اللَّهُ الَّذِي لا إِلَهَ غَيْرُكَ , الأَحَدُ الصَّمَدُ الَّذِي لَمْ يَلِدْ وَلَمْ يُولَدْ وَلَمْ يَكُنْ لَكَ كُفُوًا أَحَدٌ , فَقَالَ : \" لَقَدْ سَأَلَ اللَّهَ بِاسْمِهِ الَّذِي إِذَا دُعِيَ بِهِ أَجَابَ وَإِذَا سُئِلَ بِهِ أَعْطَى ""","","","","","Book of Prayer"
"4046","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : \" كَانَ عُمَرُ بْنُ الْخَطَّابِ إِذَا جَلَسَ عِنْدَهُ أَبُو مُوسَى رُبَّمَا قَالَ لَهُ : ذَكِّرْنَا رَبَّنَا يَا أَبَا مُوسَى , قَالَ : فَيَقْرَأُ ""","","","","","Book of Prayer"
"4047","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , عَنْ أَبِي سَلَمَةَ ابْنِ عَبْدِ الرَّحْمَنِ , \" أَنَّ عُمَرَ , كَانَ يَقُولُ لأَبِي مُوسَى وَهُوَ جَالِسٌ مَعَهُ فِي مَجْلِسٍ : ذَكِّرْنَا يَا أَبَا مُوسَى , قَالَ : فَيَقْرَأُ ""","","","","","Book of Prayer"
"4048","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , \" أَنَّ عُمَرَ , كَانَ يَقُولُ لأَبِي مُوسَى وَهُوَ جَالِسٌ مَعَهُ فِي الْمَجْلِسِ : ذَكِّرْنَا رَبَّنَا فَيَقْرَأُ عِنْدَهُ ""","","","","","Book of Prayer"
"4049","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَيَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ , قَالَ : بَيْنَمَا أُسَيْدُ بْنُ حُضَيْرٍ الأَنْصَارِيُّ يُصَلِّي ذَاتَ لَيْلَةٍ , قَالَ أُسَيْدٌ : غَشِيَتْنِي مِثْلُ السَّحَابَةِ فِيهَا مِثْلُ الْمَصَابِيحِ , وَالْمَرْأَةُ نَائِمَةٌ إِلَى جَنْبِي وَهِيَ حَامِلٌ , وَالْفَرَسُ مَرْبُوطٌ فِي الدَّارِ , قَالَ : فَخَشِيتُ أَنْ يَنْفِرَ الْفَرَسُ , فَتَفْزَعَ الْمَرْأَةُ فَتُلْقِيَ وَلَدَهَا , وَانْصَرَفْتُ مِنْ صَلاتِي , فَذَكَرْتُ ذَلِكَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَ أَصْبَحْتُ , فَقَالَ لِي : \" اقْرَأْ يَا أُسَيْدُ , ذَلِكَ مَلَكٌ اسْتَمَعَ الْقُرْآنَ ""","","","","","Book of Prayer"
"4050","عَنِ ابْنِ جُرَيْجِ , عَنِ ابْنِ شِهَابٍ , قَالَ : قَالَ أُسَيْدُ بْنُ حُضَيْرٍ : بَيْنَا أَنَا يَا رَسُولَ اللَّهِ , الْبَارِحَةَ أَقْرَأُ عَلَى ظَهْرِ بَيْتِي , إِذْ غَشِيَنِي شَيْءٌ كَالسَّحَابَةِ , وَامْرَأَتِي حَامِلٌ , وَالْفَرَسُ مَرْبُوطٌ , فَخَشِيتُ أَنْ تَضَعَ امْرَأَتِي , وَأَنْ يَنْفِرَ فَرَسِي , فَقَالَ : \" اقْرَأْ يَا أُسَيْدُ , فَإِنَّهُ الْمَلَكُ يَسْمَعُ الْقُرْآنَ \" , قَالَهَا : ثَلاثَ مَرَّاتٍ","","","","","Book of Prayer"
"4051","عَنِ ابْنِ عُيَيْنَةَ , عَنِ الحَسَنِ بْنِ عُبَيْدِ اللَّهِ النَّخَعِيِّ , عَنْ سَعْدِ بْنِ عُبَيْدَةَ , عَنْ أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ , قَالَ : حَثَّ عَلِيُّ بْنُ أَبِي طَالِبٍ النَّاسَ عَلَى السِّوَاكِ , وَقَالَ : \" إِنَّ الرَّجُلَ إِذَا قَامَ يُصَلِّي دَنَا الْمَلَكُ يَسْتَمِعُ الْقُرْآنَ , فَمَا يَزَالُ يَدْنُو حَتَّى أَنَّهُ يَضَعُ فَاهُ عَلَى فِيهِ , فَمَا يَلْفِظُ مِنْ آيَةٍ إِلا يَقَعُ فِي جَوْفِ الْمَلَكِ \" , قَالَ : \" فَطَبِنُوا مَا هُنَالِكَ وَحُبَّ عَلِيٍّ السِّوَاكَ ""","","","","","Book of Prayer"
"4052","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَبْدُ الْكَرِيمِ , عَنْ طَاوُسٍ , قَالَ : سُئِلَ رَسُولُ اللَّهَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَنْ أَحْسَنُ النَّاسِ قِرَاءَةً ؟ فَقَالَ : \" الَّذِي إِذَا سَمِعْتَ قِرَاءَتَهُ رَأَيْتَ أَنَّهُ يَخْشَى اللَّهَ , وَإِنِّي وَاللَّهِ مَا سَمِعْتُ قِرَاءَةً قَطُّ أَطْيَبَ مِنْ قِرَاءَةِ حَبِيبٍ طَاوُسٌ الْقَائِلُ ""","","","","","Book of Prayer"
"4053","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي غَيْرُ وَاحِدٍ , عَنْ أَبِي هُرَيْرَةَ , أَنَّهُ سَمِعَ رَجُلا ذَكَرُوا أَنَّهُ الْحَكَمُ الْغِفَارِيُّ , أَنَّهُ قَالَ : يَا طَاعُونُ , خُذْنِي اللَّيْلَ , قَالَ أَبُو هُرَيْرَةَ : مَا سَمِعْتَ يَا أَبَا فُلانٍ , رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ثُمَّ لا يَدْعُو أَحَدُكُمْ بِالْمَوْتِ , فَإِنَّهُ لا يَدْرِي عَلَى أَيِّ شَيْءٍ هُوَ مِنْهُ \" , قَالَ : بَلَى , وَلَكِنْ سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَذْكُرُ سِتًّا أَخْشَى أَنْ يُدْرِكَنِي بَعْضُهُنَّ قَالَ : \" بَيْعُ الْحَكَمِ , وَإِضَاعَةُ الدَّمِ , وَإِمَارَةُ السُّفَهَاءِ , وَكَثْرَةُ الشَّرَطِ , وَقَطِيعَةُ الرَّحِمِ , وَنَاسٌ يَتَّخِذُونَ الْقُرْآنَ مَزَامِيرَ يَتَغَنَّوْنَ بِهِ ""","","","","","Book of Prayer"
"4054","عَنْ مَعْمَرٍ , عَنْ أَبِي جَمْرَةَ الضُّبَعِيِّ , قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : إِنِّي رَجُلٌ فِي كَلامِي وَقِرَاءَتِي عَجَلَةٌ , فَقَالَ ابْنُ عَبَّاسٍ : \" لأَنْ أَقْرَأَ الْبَقَرَةَ فَأُرَتِّلَهَا أَحَبُّ إِلَيَّ مِنْ أَنْ أَهُذَّ الْقُرْآنَ كُلَّهُ ""","","","","","Book of Prayer"
"4055","عَنْ مَعْمَرٍ , قَالَ : سَأَلَ رَجُلٌ مُجَاهِدًا , فَقَالَ : \" رَجُلٌ قَرَأَ الْبَقَرَةَ , وَآلَ عِمْرَانَ فِي رَكْعَةٍ قِيَامُهُمَا وَاحِدٌ , وَسُجُودُهُمَا وَرُكُوعُهُمَا وَاحِدٌ , وَجُلُوسُهَا وَاحِدٌ أَيُّهُمَا أَفْضَلُ ؟ , قَالَ : الَّذِي قَرَأَ الْبَقَرَةَ , قَالَ : ثُمَّ قَرَأَ مُجَاهِدٌ :  وَقُرْءَانًا فَرَقْنَاهُ لِتَقْرَأَهُ عَلَى النَّاسِ عَلَى مُكْثٍ , قَالَ : عَلَى تُؤَدَةٍ ""","","","","","Book of Prayer"
"4056","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مَا قَوْلُهُ :  وَرَتَّلْنَاهُ تَرْتِيلا ؟ فَأَشَارَ بِيَدِهِ هُوَ الطَّرْحُ , هُوَ النَّبْذُ , فَإِذَا هُوَ لا يُحِبُّ التَّرْتِيلَ , قال : \" أَرَى أَنَّهُ يَرَى بِذَلِكَ تَنْشِيطَ الإِنْسَانِ ""","","","","","Book of Prayer"
"4057","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ , قَالَ :  وَرَتَّلْنَاهُ تَرْتِيلا , قَالَ : \" بَعْضُهُ عَلَى إِثْرِ بَعْضٍ ""","","","","","Book of Prayer"
"4058","عَنِ ابْنِ جُرَيْجٍ , قَالَ : وَقَالَ مُجَاهِدٌ : \" تَرْتِيلا تَرْتِيلا ""","","","","","Book of Prayer"
"4059","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , عَنْ أَبِيهِ فِي التَّرْتِيلِ , قال : \" تَلَيْتُهُ حَتَّى تُفَقِّهُهُ ""","","","","","Book of Prayer"
"4060","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَرَأَيْتَ إِذَا لَفَظْتُ الْقُرْآنَ فِي الْمَكْتُوبَةِ وَالتَّطَوُّعِ , فَلَمْ أُرَدِّدْ مِنْهُ شَيْئًا وَعَجِلْتُ ؟ , قَالَ : حَسْبُكَ ذَلِكَ ""","","","","","Book of Prayer"
"4061","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ زُرَارَةَ بْنِ أَوْفَى , عَنْ سَعْدِ بْنِ هِشَامٍ , عَنْ عَائِشَةَ , قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" الْمَاهِرُ بِالْقُرْآنِ مَعَ السَّفَرَةِ الْكِرَامِ الْبَرَرَةِ , وَالَّذِي يَقْرَأُ وَهُوَ عَلَيْهِ شَدِيدٌ فَلَهُ أَجْرَانِ اثْنَانِ ""","","","","","Book of Prayer"
"4062","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ رَدَّدْتُ شَيْئًا مِنْهُ ؟ , قَالَ : \" أَكْرَهُ ذَلِكَ فِي الصَّلاةِ , فَلا تُرَدِّدْ مِنْهُ شَيْئًا فِي التَّطَوُّعِ وَالْمَكْتُوبَةِ \" , قَالَ : قُلْتُ : أَرَأَيْتَ إِنْ عُرِضَتُ عَلَى إِنْسَانٍ فَرَدَّدْتُ ؟ , قَالَ : \" إِنَّمَا يَكْرَهُ ذَلِكَ فِي الصَّلاةِ ""","","","","","Book of Prayer"
"4063","عَنِ الثَّوْرِيِّ , عَنْ سَعِيدِ بْنِ عُبَيْدٍ , قَالَ : \" رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ وَهُوَ يَؤُمُّهُمْ فِي رَمَضَانَ يُرَدِّدُ هَذِهِ الآيَةَ :  إِذِ الأَغْلالُ فِي أَعْنَاقِهِمْ ,  يَأَيُّهَا الإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ { 6 } الَّذِي خَلَقَكَ فَسَوَّاكَ , يُرَدِّدُهَا مَرَّتَيْنِ , أَوْ ثَلاثًا ""","","","","","Book of Prayer"
"4064","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنَا عَطَاءٌ , عَنْ حَكِيمِ بْنِ عِقَالٍ : \" أَنَّهُ كَانَ يَنْهَى عَنْ رَفَعِ الصَّوْتِ بِالْقِرَاءَةِ بِالنَّهَارِ فِي التَّطَوُّعِ , قَالَ : وَيُقَالُ : يَرْفَعُ بِهَا مِنَ اللَّيْلِ مَا شَاءَ ""","","","","","Book of Prayer"
"4065","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِنَافِعٍ : أَكَانَ ابْنُ عُمَرَ يُسْمِعُكَ الْقِرَاءَةَ فِي التَّطَوُّعِ بِالنَّهَارِ ؟ , قَالَ : \" نَعَمْ , مِنَ السُّورَةِ الشَّيْءَ وَهُوَ يَسِيرٌ ""","","","","","Book of Prayer"
"4066","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ الْجَزَرِيُّ , عَنِ الْحَسَنِ , قال : \" صَلاةُ النَّهَارِ عَجْمَاءُ لا يُرْفَعُ بِهَا الصَّوْتُ إِلا الْجُمُعَةَ وَالصُّبْحَ , وَمَا يُرْفَعُ ""","","","","","Book of Prayer"
"4067","عَنِ ابْنِ جُرَيْجٍ قَالَ : قَالَ مُجَاهِدٌ : \" صَلاةُ النَّهَارِ عَجْمَاءُ ""","","","","","Book of Prayer"
"4068","عَنْ مَعْمَرٍ , عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ , قَالَ : سَمِعْتُ أَبَا عُبَيْدَةَ , يَقُولُ : \" صَلاةُ النَّهَار عَجْمَاءُ ""","","","","","Book of Prayer"
"4069","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْكَرِيمِ , قَالَ : أَرْسَلَنِي أَبُو عُبَيْدَةَ , إِلَى رَجُلٍ سَمِعَهُ يَجْهَرُ بِالنَّهَارِ , فَقَالَ : \" إِنَّ قِرَاءَةَ النَّهَارِ عَجْمَاءُ ""","","","","","Book of Prayer"
"4070","عَنِ الثَّوْرِيِّ , عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ , عَنْ أَسْوَدَ بْنِ هِلالٍ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" لَمْ يُخَافِتْ مَنْ أَسْمَعَ نَفْسَهُ ""","","","","","Book of Prayer"
"4071","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" لَمْ يُخَافِتْ مَنْ أَسْمَعَ نَفْسَهُ \" , يَقُولُ : \" إِذَا صَلَّى فِيمَا يُجْهَرُ فِيهِ الْقِرَاءَةُ ""","","","","","Book of Prayer"
"4072","عَنْ هِشَامٍ , عَنْ مُحَمَّدٍ , قال : \" سَأَلْتُ عُبَيْدَةَ , قَالَ : قُلْتُ : الرَّجُلَ يَشْتَهِي أَنْ يُخْفِيَ قِرَاءَتَهُ , قَالَ : فَيُسْمِعُ نَفْسَهُ ""","","","","","Book of Prayer"
"4073","عَنْ مَعْمَرٍ , عَنْ أَبِي عُمَرَ الْمَدَنِيِّ , قَالَ : سَأَلْنَا ابْنَ عُمَرَ عَنْ قِرَاءَةِ النَّهَارِ , فَقَامَ يُصَلِّي فَرُبَّمَا أَسْمَعَنَا الآيَةَ ""","","","","","Book of Prayer"
"4074","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعَبْدِ اللَّهِ بْنِ حُذَافَةَ وَهُوَ يُصَلِّي , فَجَهَرَ بِصَوْتِهِ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تُسْمِعْنِي يَا حُذَافَةُ , وَأَسْمَعِ اللَّهَ تَعَالَى ""","","","","","Book of Prayer"
"4075","أَخْبَرَنَا مَعْمَرٌ , عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , عَنْ يَحْيَى بْنِ يَعْمَرَ , عَنْ عَائِشَةَ , قَالَ : سَأَلَهَا رَجُلٌ هَلْ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ صَوْتَهُ مِنَ اللَّيْلِ إِذَا قَرَأَ ؟ , قَالَتْ : \" رُبَّمَا رَفَعَ , وَرُبَّمَا خَفَضَ \" , قَالَ : الْحَمْدُ لِلَّهِ الَّذِي جَعَلَ فِي الدِّينِ سَعَةً , قَالَ : فَهَلْ كَانَ يُوتِرُ مِنْ أَوَّلِ اللَّيْلِ ؟ , قَالَتْ : \" نَعَمْ , رُبَّمَا أَوْتَرَ مِنْ أَوَّلِ اللَّيْلِ , وَرُبَّمَا أَوْتَرَ مِنْ آخِرِهِ \" , قَالَ : الْحَمْدُ لِلَّهِ الَّذِي جَعَلَ فِي الدِّينِ سَعَةً , قَالَ : فَهَلْ كَانَ يَنَامُ وَهُوَ جُنُبٌ ؟ , قَالَتْ : \" رُبَّمَا اغْتَسَلَ قَبْلَ أَنْ يَنَامَ , وَرُبَّمَا نَامَ قَبْلَ أَنْ يَغْتَسِلَ , وَلَكِنَّهُ يَتَوَضَّأُ قَبْلَ أَنْ يَنَامَ \" , قَالَ : الْحَمْدُ لِلَّهِ الَّذِي جَعَلَ فِي الدِّينِ سَعَةً","","","","","Book of Prayer"
"4076","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ , قَالَ : سَمِعْتُ ابْنَ الْمُسَيَّبِ , يَقُولُ : مَرَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَبِي بَكْرٍ وَهُوَ يُصَلِّي وَهُوَ يُخَافِتُ , وَمَرَّ بِعُمَرَ وَهُوَ يَجْهَرُ , وَمَرَّ بِبِلالٍ وَهُوَ يَخْلِطُ , فَأَصْبَحُوا جَمِيعًا عِنْدَهُ فَقَالَ : \" مَرَرْتُ بِكَ يَا أَبَا بَكْرٍ فَرَأَيْتُ تُخَافِتُ \" , قَالَ : أَجَلْ بِأَبِي أَنْتَ وَأُمِّي , قَالَ : \" ارْفَعْ شَيْئًا \" , قَالَ : \" مَرَرْتُ بِكَ يَا عُمَرُ وَأَنْتَ تَجْهَرُ \" , قَالَ : بِأَبِي وَأُمِّي أُسْمِعُ الرَّحْمَنَ , وَأُوقِظُ النَّائِمَ , قَالَ : \" دُونَ , أَوْ قَالَ : اخْفِضْ شَيْئًا \" , قَالَ : \" وَمَرَرْتُ بِكَ يَا بِلالُ وَأَنْتَ تَخْلِطُ \" , قَالَ : أَجَلْ بِأَبِي أَنْتَ وَأُمِّي , أَخْلِطُ الطِّيبَ بِالطِّيبِ , قَالَ : \" اقْرَأْ كُلَّ سُورَةٍ عَلَى نَحْوِهَا ""","","","","","Book of Prayer"
"4077","عَنْ مَعْمَرٍ , عَنِ ابْنِ حَرْمَلَةَ , عَنِ ابْنِ الْمُسَيَّبِ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ لأَبِي بَكْرٍ : \" مَرَرْتُ بِكَ يَا أَبَا بَكْرٍ وَأَنْتَ تُخَافِتُ بِقِرَاءَتِكَ \" , قَالَ : إِنِّي أُسْمِعُ مَنْ أُنَاجِي , قَالَ : \" وَمَرَرْتُ بِكَ يَا عُمَرُ وَأَنْتَ تَجْهَرُ بِقِرَاءَتِكَ \" , قَالَ : اطْرُدُ الشَّيْطَانَ , وَأُوقِظُ الْوَسْنَانَ , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" اخْفِضْ شَيْئًا \" , قَالَ : \" وَمَرَرْتُ بِكَ يَا بِلالُ وَأَنْتَ تَقْرَأُ هَذِهِ السُّورَةَ وَمَنْ هَذِهِ السُّورَةِ \" , قَالَ : إِنِّي يَا رَسُولَ اللَّهِ , أَخْلِطُ الطِّيبَ بِالطِّيبِ , فَقَالَ : \" اقْرَإِ السُّورَةَ عَلَى نَحْوِهَا ""","","","","","Book of Prayer"
"4078","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ الْجُمَحِيُّ , عَنْ أَبِي بَكْرِ بْنِ عَمْرِو بْنِ حَزْمٍ , قال : \" بَاتَتْ عِنْدِي عَمْرَةُ ابْنَةُ عَبْدِ الرَّحْمَنِ فَقُمْتُ أُصَلِّي مِنَ اللَّيْلِ , فَخَافَتُّ بِقِرَاءَتِي , فَقَالَتِ : ارْفَعْ صَوْتَكَ , فَقَدْ كَانَ مُعَاذٌ الْقَارِئُ , وَأَفْلَحُ مَوْلَى أَبِي أَيُّوبَ يُوقِظَانِنَا مِنَ اللَّيْلِ بِرَفْعِ أَصْوَاتِهِمَا ""","","","","","Book of Prayer"
"4079","عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْنَا عَلْقَمَةَ كَيْفَ كَانَتْ قِرَاءَةُ عَبْدِ اللَّهِ بِاللَّيْلِ ؟ وَكَانَ يَبِيتُ عِنْدَهُ , قَالَ : \" كَانَ يُسْمِعُ آلَ عُتْبَةَ أَخِيهِ , وَهُمْ فِي حُجْرَةٍ بَيْنَ يَدَيْهِ ""","","","","","Book of Prayer"
"4080","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ , \" أَنَّ عَبْدَ اللَّهِ , كَانَ يُسْمِعُ قِرَاءَتَهُ أَهْلَ الدَّارِ مِنَ اللَّيْلِ ""","","","","","Book of Prayer"
"4081","عَنِ ابْنِ عُيَيْنَةَ , عَنِ الْحَكَمِ بْنِ أَبَانَ , عَنْ عِكْرِمَةَ , قال : \" لَكَ مِلْءُ دَارِكَ يَعْنِي فِي قِرَاءَةِ اللَّيْلِ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , عَنِ الْحَسَنِ بْنِ سَعْدٍ , عَنْ أَبِيهِ مِثْلَهُ","","","","","Book of Prayer"
"4082","أَخْبَرَنَا مَعْمَرٌ , عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ : اعْتَكَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ , فَسَمِعَهُمْ يَجْهَرُونَ بِالْقِرَاءَةِ , وَهُوَ فِي قُبَّةٍ لَهُ , فَكَشَفَ السُّتُورَ , وَقَالَ : \" أَلا إِنَّ كُلَّكُمْ يُنَاجِي رَبَّهُ , فَلا يُؤْذِي بَعْضُكُمْ بَعْضًا , وَلا يَرْفَعَنَّ بَعْضُكُمْ عَلَى بَعْضٍ فِي الْقِرَاءَةِ , أَوْ قَالَ : فِي الصَّلاةِ ""","","","","","Book of Prayer"
"4083","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ إِبْرَاهِيمَ التَّيْمِيُّ , عَنْ أَبِي حَازِمٍ مَوْلَى الأَنْصَارِ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي قُبَّةٍ فِي شَهْرِ رَمَضَانَ , وَالرَّجُلُ يَؤُمُّ النَّفْيَ , فَأَطْلَعَ عَلَيْهِمْ رَأْسَهُ , وَقَالَ : \" مَا شَاءَ اللَّهُ \" , ثُمَّ قَالَ : \" إِنَّ الْمُصَلِّيَ يُنَاجِي رَبَّهُ , فَإِذَا صَلَّى أَحَدُكُمْ فَلْيَنْظُرْ مَا يُنَاجِي بِهِ رَبَّهُ , وَلا يَجْهَرْ بَعْضُكُمْ عَلَى بَعْضٍ بِالْقُرْآنِ ""","","","","","Book of Prayer"
"4084","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَمَعَ لَيْلَةً أَبَا بَكْرٍ فَإِذَا هُوَ يُخَافِتُ بِالْقِرَاءَةِ فِي صَلاتِهِ , وَاسْتَمَعَ عُمَرَ فَإِذَا هُوَ يَرْفَعُ صَوْتَهُ , وَاسْتَمَعَ بِلالا فَإِذَا هُوَ يَأْخُذُ مِنْ هَذِهِ السُّورَةِ , وَمِنْ هَذِهِ السُّورَةِ , فَقَالَ : \" اسْتَمَعْتُ إِلَيْكَ يَا أَبَا بَكْرٍ , فَإِذَا أَنْتَ تَخْفِضُ صَوْتَكَ \" , قَالَ : أَخْفَضُ أَنْتَجِي رَبِّي , قَالَ : \" وَاسْتَمَعْتُ إِلَيْكَ يَا عُمَرُ , فَإِذَا أَنْتَ تَرْفَعُ صَوْتَكَ \" , قَالَ : أُنَفِّرُ الشَّيْطَانَ , وَأُوقِظُ النَّائِمَ , قَالَ : \" وَاسْتَمَعْتُ إِلَيْكَ يَا بِلالُ , وَإِذَا أَنْتَ تَأْخُذُ مِنْ هَذِهِ السُّورَةِ وَمِنْ هَذِهِ السُّورَةِ \" , قَالَ : أَجْمَعُ الطَّيِّبَ بِالطَّيِّبِ , أَخْلِطُ بَعْضَهُ إِلَى بَعْضٍ , قَالَ : \" كُلُّ هَذَا حَسَنٌ ""","","","","","Book of Prayer"
"4085","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ أَبِي رَزِينٍ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" النُّعَاسُ فِي الصَّلاةِ مِنَ الشَّيْطَانِ , وَالنُّعَاسُ فِي الْقِتَالِ أَمَنَةٌ مِنَ اللَّهِ ""","","","","","Book of Prayer"
"4086","عَنِ الثَّوْرِيِّ , عَنْ سَعِيدٍ الْجُرَيْرِيِّ , قَالَ : حَدَّثَنَا يَزِيدُ بْنُ عَبْدِ اللَّهِ بْنِ شِخِّيرٍ , عَنْ عُثْمَانَ بْنِ أَبِي الْعَاصِ الثَّقَفِيِّ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ , حَالَ الشَّيْطَانُ بَيْنِي وَبَيْنَ صَلاتِي وَقِرَاءَتِي , فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" ذَاكَ شَيْطَانٌ , يُقَالُ لَهُ : خِنْزَبٌ , فَإِذَا حَسَسْتَ بِهِ فَتَعَوَّذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ , وَاتْفُلْ مِنْ عَنْ يَسَارِكَ ثَلاثًا ""","","","","","Book of Prayer"
"4087","عَنْ مَعْمَرٍ , عَنْ هَمَّامِ بْنِ مُنَبِّهٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا قَامَ أَحَدُكُمْ مِنَ اللَّيْلِ فَاسْتَعْجَمَ الْقُرْآنُ عَلَى لِسَانِهِ , فَلَمْ يَدْرِ مَا يَقُولُ : فَلْيَنْصَرِفْ فَلْيَضْطَجِعْ ""","","","","","Book of Prayer"
"4088","عَنِ الثَّوْرِيِّ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , عَنْ عَائِشَةَ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا نَعَسَ أَحَدُكُمْ وَهُوَ يُصَلِّي فَلْيَنَمْ عَلَى فِرَاشِهِ ؛ فَإِنَّهُ لا يَدْرِي أَيَدْعُو عَلَى نَفْسِهِ أَمْ يَدْعُو لَهَا ""","","","","","Book of Prayer"
"4089","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" لا تُغَالِبُوا هَذَا اللَّيْلَ ؛ فَإِنَّكُمْ لا تُطِيقُونَهُ , فَإِذَا نَعَسَ أَحَدُكُمْ فِي صَلاتِهِ , فَلْيَنْصَرِفْ فَلْيَنَمْ عَلَى فِرَاشِهِ , فَإِنَّهُ أَسْلَمُ لَهُ ""","","","","","Book of Prayer"
"4090","عَنِ الثَّوْرِيِّ , عَنْ عَبْدَةَ بْنِ أَبِي لُبَابَةَ , عَنْ سُوَيْدِ بْنِ غَفَلَةَ , عَنْ أَبِي الدَّرْدَاءِ , أَوْ أَبِي ذَرٍّ , قَالَ : \" مَا مِنْ رَجُلٍ يُرِيدُ أَنْ يَقُومَ سَاعَةً مِنَ اللَّيْلِ , فَيَغْلِبُهُ عَيْنَاهُ عَنْهَا , إِلا كَتَبَ اللَّهُ لَهُ أَجْرَهَا , وَكَانَ نَوْمُهُ صَدَقَةً تَصَدَّقَ بِهَا اللَّهُ عَلَيْهِ \" , عَنْ أَبِي مَعْشَرٍ , عَنْ سَعِيدٍ الْمَقْبُرِيِّ , عَنْ أَبِي هُرَيْرَةَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Prayer"
"4091","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يُصَلِّي بِاللَّيْلِ مَثْنَى مَثْنَى , وَبِنَهَارٍ أَرْبَعًا ثُمَّ يُسَلِّمُ \" , أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ . وَالثَّوْرِيِّ , عَنْ عُبَيْدِ اللَّهِ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"4092","عَنْ مَعْمَرٍ , عَنْ ثَابِتٍ , قَالَ : \" بِتُّ عِنْدَ أَنَسٍ لَيْلَةً , فَصَلَّى مَثْنَى مَثْنَى , ثُمَّ سَلَّمَ ""","","","","","Book of Prayer"
"4093","عَنْ مُقَاتِلٍ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : سَأَلْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلاةِ اللَّيْلِ , فَقَالَ : \" مَثْنَى مَثْنَى \" , فَقُلْتُ : صَلاةُ النَّهَارِ ؟ , فَقَالَ : \" أَرْبَعًا ""","","","","","Book of Prayer"
"4094","عَنِ الثَّوْرِيِّ , عَنْ حَبِيبِ بْنِ أَبِي عَمْرَةَ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : فِي كُلِّ مَثْنَى مِنَ اللَّيْلِ وَالنَّهَارِ تَسْلِيمٌ ""","","","","","Book of Prayer"
"4095","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" اللَّيْلَ وَالنَّهَارَ يُجْزِيكَ التَّشَهُّدُ فِي الصَّلاةِ , إِلا أَنْ تَكُونَ لَكَ حَاجَةٌ فَتُسَلِّمَ ""","","","","","Book of Prayer"
"4096","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : يُجْزِيكَ التَّشَهُّدُ , وَإِنْ صَلَّيْتَ مِائَةَ رَكْعَةٍ ""","","","","","Book of Prayer"
"4097","عَنْ مَعْمَرٍ , عَنِ ابْنِ أَبِي ذِئْبٍ , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يُصَلِّ يَوْمَ الأَحْزَابِ الظُّهْرَ , وَالْعَصْرَ , وَالْعِشَاءَ , حَتَّى ذَهَبَ هَوِيٌّ مِنَ اللَّيْلِ , قَالَ : وَذَلِكَ قَبْلَ أَنْ تَنْزِلَ صَلاةُ الْخَوْفِ , فَأَمَرَ بِلالا فَأَذَّنَ , ثُمَّ أَقَامَ الظُّهْرَ , فَصَلاهَا كَمَا كَانَ يُصَلِّيهَا فِي وَقْتِهَا , ثُمَّ أَمَرَهُ فَأَقَامَ لِلْعَصْرِ , فَصَلاهَا كَمَا كَانَ يُصَلِّيهَا فِي وَقْتِهَا , ثُمَّ أَمَرَهُ فَقَامَ لِلْمَغْرِبِ فَصَلاهَا فِي وَقْتِهَا كَمَا كَانَ يُصَلِّيهَا فِي وَقْتِهَا , فَأَمَرَهُ فَقَامَ لِلْعِشَاءِ فَصَلاهَا كَمَا كَانَ يُصَلِّيهَا فِي وَقْتِهَا ""","","","","","Book of Prayer"
"4098","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ مُجَاهِدٍ , قَالَ : \" صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَصْحَابِهِ صَلاةَ الظُّهْرِ , قَبْلَ أَنْ يَنْزِلَ صَلاةُ الْخَوْفِ , قَالَ : فَتَلَهَّفَ الْمُشْرِكُونَ , أَنْ لا يَكُونُوا حَمَلُوا عَلَيْهِ , قَالَ : فَقَالَ رَجُلٌ : فَإِنَّ لَهُمْ صَلاةً قَبْلَ مَغْرِبَانِ الشَّمْسِ هِيَ أَحَبُّ إِلَيْهِمْ مِنْ أَنْفُسِهِمْ , فَقَالُوا : لَوْ صَلَّوْا بَعْدُ لَحَمَلْنَا عَلَيْهِمْ , فَأَرْصَدُوا ذَلِكَ , فَنَزَلَتْ صَلاةُ الْخَوْفِ , فَصَلَّى بِهِمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْخَوْفِ بِصَلاةِ الْعَصْرِ ""","","","","","Book of Prayer"
"4099","عَنْ مَعْمَرٍ , عَنْ خَلادِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ مُجَاهِدٍ , قَالَ : لَمْ يُصَلِّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْخَوْفِ إِلا مَرَّتَيْنِ , مَرَّةً بِذِي الرِّقَاعِ مِنْ أَرْضِ بَنِي سُلَيْمٍ , وَمَرَّةً بِعُسْفَانَ , وَالْمُشْرِكُونَ بِضَجْنَانَ بَيْنَهُمْ وَبَيْنَ الْقِبْلَةِ \" , قَالَ : \" فَصَفَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَصْحَابَهُ كُلَّهُمْ خَلْفَهُ , وَهُمْ بِعُسْفَانَ , ثُمَّ تَقَدَّمَ فَصَلَّى , فَرَكَعَ بِهِمْ جَمِيعًا , ثُمَّ سَجَدَ بِالَّذِينَ يَلُونَهُ , وَقَامَ الآخَرُونَ خَلْفَهُ يَحْرُسُونَهُ , فَلَمَّا سَجَدَ بِهِمْ سَجْدَتَيْنِ قَامُوا , وَسَجَدَ أُولَئِكَ الَّذِينَ خَلْفَهُ , ثُمَّ تَقَدَّمُوا إِلَى الصَّفِّ الأَوَّلِ , وَتَأَخَّرُوا هَؤُلاءِ , ثُمَّ رَكَعَ بِهِمْ جَمِيعًا , ثُمَّ سَجَدَ بِالَّذِينَ يَلُونَهُ , وَقَامُوا الآخَرُونَ يَحْرُسُونَهُمْ , فَلَمَّا رَفَعُوا رُءُوسَهُمْ مِنَ السَّجْدَةِ سَجَدَ أُولَئِكَ , ثُمَّ سَلَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَيْهِمْ جَمِيعًا , وَتَمَّتْ لَهُمْ صَلاتُهُمْ ""","","","","","Book of Prayer"
"4100","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ مُجَاهِدٌ فِي قَوْلِهِ : \"  إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا نَزَلَتْ يَوْمَ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعُسْفَانَ وَالْمُشْرِكُونَ بِضَجْنَانَ , فَتَوَافَقُوا , فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَصْحَابِهِ صَلاةَ الظُّهْرِ أَرْبَعًا , رُكُوعُهُمْ , وَسُجُودُهُمْ , وَقِيَامُهُمْ وَاحِدٌ مَعًا جَمِيعًا , فَهَمَّ بِهِمُ الْمُشْرِكُونَ , أَنْ يُغِيرُوا عَلَى أَمْتِعَتِهِمْ وَيُقَاتِلُونَهُمْ , فَأَنْزَلَ اللَّهُ تَعَالَى عَلَيْهِ  فَلْتَقُمْ طَائِفَةٌ , فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْعَصْرَ , وَصَفَّ أَصْحَابَهُ صَفَّيْنِ , وَكَبَّرَ بِهِمْ جَمِيعًا , فَسَجَدَ الأَوَّلُونَ بِسُجُودِهِ , وَالآخَرُونَ قِيَامٌ لَمْ يَسْجُدُوا , حَتَّى قَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَالصَّفُّ الأَوَّلُ , ثُمَّ كَبَّرَ بِهِمْ وَرَكَعُوا جَمِيعًا , فَتَقَدَّمُوا الصَّفُّ الآخَرُ , وَاسْتَأْخَرُوا الصَّفُّ الأَوَّلُ , فَتَعَاقَبُوا السُّجُودَ كَمَا فَعَلُوا أَوَّلَ مَرَّةٍ , وَقَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْعَصْرِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4101","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ , عَنْ أَبِي عَيَّاشٍ الزُّرَقِيِّ , قَالَ : كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعُسْفَانَ , قَالَ : فَاسْتَقْبَلَنَا الْمُشْرِكُونَ عَلَيْهِمْ خَالِدُ بْنُ الْوَلِيدِ , وَهُمْ بَيْنَنَا وَبَيْنَ الْقِبْلَةِ , فَصَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ , فَقَالُوا : قَدْ كَانُوا عَلَى حَالٍ لَوْ أَصَبْنَا غِرَّتَهُمْ , فَقَالُوا : تَأْتِي عَلَيْهِمُ الآنَ صَلاةٌ هِيَ أَحَبُّ إِلَيْهِمْ مِنْ أَبْنَائِهِمْ وَأَنْفُسِهِمْ , قَالَ : فَنَزَلَ جِبْرِيلُ بِهَذِهِ الآيَاتِ بَيْنَ الظُّهْرِ وَالْعَصْرِ  وَإِذَا كُنْتَ فِيهِمْ فَأَقَمْتَ لَهُمُ الصَّلاةَ , قَالَ : \" فَحَضَرَتِ الصَّلاةُ , فَأَمَرَهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَأَخَذُوا السِّلاحَ , فَصَفَفْنَا خَلْفَهُ صَفَّيْنِ قَالَ : ثُمَّ رَكَعَ فَرَكَعْنَا جَمِيعًا , قَالَ : ثُمَّ رَفَعَ فَرَفَعْنَا جَمِيعًا , ثُمَّ سَجَدَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالصَّفِّ الَّذِي يَلِيهِ , قَالَ : وَالآخَرُونَ قِيَامٌ يَحْرُسُونَهُمْ , فَلَمَّا سَجَدُوا وَقَامُوا , جَلَسَ الآخَرُونَ فَسَجَدُوا فِي مَكَانِهِمْ , ثُمَّ تَقَدَّمَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , وَجَاءَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ فَرَكَعُوا جَمِيعًا , ثُمَّ رَفَعَ فَرَفَعُوا جَمِيعًا , ثُمَّ سَجَدَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالصَّفِّ الَّذِي يَلِيهِ وَالآخَرُونَ قِيَامٌ يَحْرُسُونَهُمْ , فَلَمَّا جَلَسُوا جَلَسَ الآخَرُونَ فَسَجَدُوا , ثُمَّ سَلَّمَ عَلَيْهِمْ , ثُمَّ انْصَرَفَ \" , قَالَ : \" فَصَلاهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّتَيْنِ , مَرَّةً بِعُسْفَانَ , وَمَرَّةً فِي أَرْضِ بَنِي سُلَيْمٍ \" , عَنِ الثَّوْرِيِّ , عَنْ أَبِي الزُّبَيْرِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِهِمْ مِثْلَ هَذِهِ الصَّلاةِ , غَيْرَ أَنَّهُ لَمْ يَذْكُرْ نُزُولَ جَبْرَائِيلَ , قَالَ : وَقَالَ جَابِرٌ : كَمَا يَفْعَلُ أُمَرَاؤُكُمْ هَذِهِ , عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , مِثْلَ هَذَا عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , إِلا أَنَّهُ قَالَ : \" نَكَصَ الصَّفُّ الْمُقَدَّمُ الْقَهْقَرَى حِينَ يَرْفَعُونَ رُءُوسَهُمْ مِنَ السُّجُودِ , وَيَتَقَدَّمُ الصَّفُّ الْمُؤَخَّرُ فَيَسْجُدُونَ فِي مَصَافِّ الأَوَّلِينَ ""","","","","","Book of Prayer"
"4102","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ مُسْلِمٍ , أَنَّ طَاوُسًا أَخْبَرَهُ , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلاةَ الظُّهْرِ أَرْبَعَ رَكَعَاتٍ وَهُوَ وَالْعَدُوُّ فِي صَحْرَاءَ وَاحِدَةٍ , فَقَالَ الْعَدُوُّ : إِنَّ لَهُمْ صَلاةً أُخْرَى هِيَ أَحَبُّ إِلَيْهِمْ مِنَ الدُّنْيَا وَمَا فِيهَا فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الْعَصْرَ , فَقَامُوا خَلْفَهُ صَفَّيْنِ , فَرَكَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَرَكَعَ الصَّفُّ الأَوَّلُ وَالصَّفُّ الآخَرُ قِيَامٌ , ثُمَّ قَامُوا فَارْتَدَّ الصَّفُّ الأَوَّلُ الْقَهْقَرَى , ثُمَّ قَامُوا إِلَى مَقَامِ الصَّفِّ الآخَرِ , فَتَقَدَّمَ الآخَرُ حَتَّى قَامُوا فِي مَقَامِهِمْ , ثُمَّ رَكَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَرَكَعَ الصَّفُّ الأَوَّلُ , فَكَانَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَانِ , وَلِكُلِّ صَفٍّ رَكْعَةٌ , ثُمَّ صَلَّوْا عَلَى مَصَافِّهِمْ رَكْعَةً رَكْعَةً ""","","","","","Book of Prayer"
"4103","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , أَنَّ ابْنَ عُمَرَ , قَالَ : \" صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْخَوْفِ بِإِحْدَى الطَّائِفَتَيْنِ رَكْعَةً , وَالطَّائِفَةُ الأُخْرَى مُوَاجِهَةٌ الْعَدُوَّ , ثُمَّ انْصَرَفُوا وَقَامُوا فِي مَقَامِ أَصْحَابِهِمْ مُقْبِلِينَ عَلَى الْعَدُوِّ , وَجَاءَ أُولَئِكَ فَصَلَّى بِهِمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكْعَةً , ثُمَّ سَلَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ قَضَى هَؤُلاءِ رَكْعَةً وَهَؤُلاءِ رَكْعَةً ""","","","","","Book of Prayer"
"4104","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ , أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ كَانَ يُحَدِّثُ , أَنَّهُ صَلاهَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" فَكَبَّرَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَصَفَّ وَرَاءَهُ طَائِفَةً مِنَّا , وَأَقْبَلَتْ طَائِفَةٌ عَلَى الْعَدُوِّ , فَرَكَعَ لَهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكْعَةً وَسَجْدَتَيْنِ يَسْجُدُ مِثْلَ نِصْفِ صَلاةِ الصُّبْحِ , ثُمَّ انْصَرَفُوا فَأَقْبَلُوا عَلَى الْعَدُوِّ , وَجَاءَتِ الطَّائِفَةُ الأُخْرَى فَصَفُّوا مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَفَعَلُوا ذَلِكَ , ثُمَّ سَلَّمَ , فَقَامَ كُلُّ رَجُلٍ مِنَ الطَّائِفَتَيْنِ يُصَلِّي لِنَفْسِهِ رَكْعَةً وَسَجْدَتَيْنِ ""","","","","","Book of Prayer"
"4105","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ , قَالَ : سَمِعْتُهُ يُخْبِرُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي صَلاةِ الْخَوْفِ , قَالَ : \" صَلَّى كُلُّ رَجُلٍ مِنَ الْقَوْمِ رَكْعَةً مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ صَلَّى كُلُّ رَجُلٍ لِنَفْسِهِ رَكْعَةً ""","","","","","Book of Prayer"
"4106","عَنْ إِسْرَائِيلَ , وَغَيْرِهِ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" تَتَقَدَّمُ طَائِفَةٌ مَعَ الإِمَامِ , وَطَائِفَةٌ بِإِزَاءِ الْعَدُوِّ , فَيُصَلِّي بِهِمُ الإِمَامُ رَكْعَةً وَسَجْدَتَيْنِ , ثُمَّ تَذْهَبُ الطَّائِفَةُ الَّذِينَ صَلَّوْا مَعَ الإِمَامِ فَيَقُومُونَ مَوْقِفَ أَصْحَابِهِمْ , وَيَجِيءُ أُولَئِكَ فَيَدْخُلُونَ فِي صَلاةِ الإِمَامِ , فَيُصَلِّي بِهِمْ رَكْعَةً , ثُمَّ يُسَلِّمُ الإِمَامُ , ثُمَّ يَقُومُونَ فَيُصَلُّونَ رَكْعَةً مَكَانَهُمْ , ثُمَّ يَنْطَلِقُونَ فَيَقُومُونَ مَكَانَ أَصْحَابِهِمْ , وَيَجِيءُ أُولَئِكَ فَيُصَلُّونَ رَكْعَةً ""","","","","","Book of Prayer"
"4107","عَنِ الثَّوْرِيِّ , عَنْ خُصَيْفٍ , عَنْ أَبِي عُبَيْدَةَ , عَنْ عَبْدِ اللَّهِ , قَالَ : \" كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَصَفَّ صَفًّا خَلْفَهُ وَصَفًّا مُوَازِيَ الْعَدُوِّ \" , قَالَ : \" وَهُمْ فِي صَلاةٍ كُلُّهُمْ \" , قَالَ : \" فَكَبَّرَ وَكَبَّرُوا جَمِيعًا , فَصَلَّى بِالصَّفِّ الَّذِي يَلِيهِ رَكْعَةً وَصَفٌّ مُوَازِيَ الْعَدُوِّ , ثُمَّ ذَهَبَ هَؤُلاءِ وَجَاءُوا هَؤُلاءِ فَصَلَّى بِهِمْ رَكْعَةً , ثُمَّ قَامَ هَؤُلاءِ الَّذِينَ صَلَّى بِهِمُ الرَّكْعَةَ الثَّانِيَةَ فَصَفُّوا مَكَانَهُمْ , ثُمَّ ذَهَبَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , وَجَاءَ هَؤُلاءِ إِلَى هَؤُلاءِ فَقَضَوْا رَكْعَةً ""","","","","","Book of Prayer"
"4108","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : يَقُومُ صَفٌّ خَلْفَ الإِمَامِ وَصَفٌّ مُوَازِيَ الْعَدُوِّ فِي غَيْرِ صَلاةٍ \" , قَالَ : \" فَيُصَلِّي الإِمَامُ بِالَّذِينَ مَعَهُ رَكْعَةً , ثُمَّ ذَهَبَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , وَيَجِيءُ هَؤُلاءِ فَيُصَلِّي بِهِمْ رَكْعَةً , ثُمَّ يُسَلِّمُ الإِمَامُ , ثُمَّ يَرْجِعُ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , وَيَرْجِعُ هَؤُلاءِ فَيَصُفُّونَ رَكْعَةً , ثُمَّ يَنْصَرِفُ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , وَيَرْجِعُ هَؤُلاءِ فَيَقْضُونَ رَكْعَةً , فَيَكُونُ لِلإِمَامِ رَكْعَتَيْنِ , وَلِكُلِّ وَاحِدٍ مِنَ الْفَرِيقَيْنِ رَكْعَةٌ مَعَ الإِمَامِ وَرَكَعَةٌ وَحْدَهُ , غَيْرَ أَنَّ الأَوَّلِينَ يَبْدَءُونَ بِالْقَضَاءِ ؛ لأَنَّهُمْ كَانُوا بَدَءُوا بِالصَّلاةِ , وَلا يَتَكَلَّمُونَ حَتَّى يَفْرُغُوا مِنْ صَلاتِهِمْ كُلِّهَا ؛ لأَنَّهُمْ فِي صَلاةٍ ""","","","","","Book of Prayer"
"4109","عَنِ الثَّوْرِيِّ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , عَنْ صَالِحِ بْنِ خَوَّاتِ بْنِ جُبَيْرٍ , عَنْ سَهْلِ بْنِ أَبِي حَثْمَةَ , وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" يَقُومُ الإِمَامُ فِي صَلاةِ الْخَوْفِ , وَيَقُومُ صَفٌّ خَلْفَهُ وَصَفٌّ مُوَازِيَ الْعَدُوِّ \" , وَقَالَ : \" فَيُصَلِّي بِهَؤُلاءِ رَكْعَةً , فَإِذَا صَلَّى بِهِمْ رَكْعَةً قَامُوا مَكَانَهُمْ , وَالإِمَامُ قَائِمٌ فَقَضَوْا رَكْعَةً , ثُمَّ ذَهَبُوا إِلَى مَصَافِّ أُولَئِكَ , وَجَاءَ أُولَئِكَ فَصَلَّى بِهِمْ رَكْعَةً , ثُمَّ قَامُوا مَكَانَهُمْ , فَقَضَوْا رَكْعَةً ""","","","","","Book of Prayer"
"4110","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , قَالَ : حَدَّثَنِي مَنْ شَهِدَ سَعِيدَ بْنَ الْعَاصِ فِي غَزْوَةٍ , يُقَالُ لَهَا : ذَاتُ الْخَشَبِ , وَمَعَهُ حُذَيْفَةُ , فَقَالَ سَعِيدٌ : أَيُّكُمْ شَهِدَ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْخَوْفِ ؟ فَقَالَ حُذَيْفَةُ : أَنَا , فَأَمَرَهُمْ حُذَيْفَةُ فَلَبِسُوا السِّلاحَ , ثُمَّ قَالَ : \" إِنْ هَاجَكُمْ هَيْجٌ فَقَدْ حَلَّ لَكُمُ الْقِتَالُ , قَالَ : \" فَصَلَّى بِإِحْدَى الطَّائِفَتَيْنِ رَكْعَةً , وَالطَّائِفَةُ الأُخْرَى مُوَاجِهَةٌ الْعَدُوَّ , ثُمَّ انْصَرَفَ هَؤُلاءِ فَقَامُوا مَقَامَ أُولَئِكَ , وَجَاءَ أُولَئِكَ فَصَلَّى بِهِمْ رَكْعَةً أُخْرَى , ثُمَّ سَلَّمَ عَلَيْهِمْ ""","","","","","Book of Prayer"
"4111","عَنِ الثَّوْرِيِّ , عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ , عَنْ أَسْوَدَ بْنِ هِلالٍ , عَنْ ثَعْلَبَةَ بْنِ زَهْدَمٍ الْحَنْظَلِيِّ , قَالَ : كُنَّا مَعَ سَعِيدِ بْنِ الْعَاصِ , أُرَاهُ قَالَ : بِطَبَرِسْتَانَ , فَقَالَ : أَيُّكُمْ شَهِدَ صَلاةَ الْخَوْفِ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ , فَقَالَ حُذَيْفَةُ : أَنَا , قَالَ : \" فَقَامَ صَفٌّ خَلْفَهُ وَصَفٌّ مُوَازِيَ الْعَدُوِّ \" , قَالَ : \" فَصَلَّى بِهِمُ الرَّكْعَةَ , ثُمَّ ذَهَبَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , فَصَلَّى بِهِمْ رَكْعَةً , ثُمَّ انْصَرَفَ ""","","","","","Book of Prayer"
"4112","عَنِ الثَّوْرِيِّ , عَنِ الرُّكَيْنِ بْنِ الرَّبِيعِ بْنِ عُمَيْلَةَ الْفَزَارِيِّ , عَنِ الْقَاسِمِ بْنِ حَسَّانَ , عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ : سَأَلْتُهُ عَنْ صَلاةِ الْخَوْفِ ؟ , قَالَ : قَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى بِهِمْ , فَقَامَ صَفٌّ خَلْفَهُ وَصَفٌّ مُوَازِيَ الْعَدُوِّ , فَصَلَّى بِهِمْ رَكْعَةً \" , قَالَ : \" ثُمَّ ذَهَبَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , وَجَاءَ هَؤُلاءِ فَصَلَّى بِهِمْ رَكْعَةً , ثُمَّ انْصَرَفَ ""","","","","","Book of Prayer"
"4113","عَنِ الثَّوْرِيِّ , عَنْ أَبِي بَكْرِ بْنِ أَبِي جَهْمٍ عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْخَوْفِ بِذِي قَرَدَ , فَصَفَّ صَفًّا خَلْفَهُ وَصَفًّا مُوَازِيَ الْعَدُوِّ \" , وَقَالَ : \" فَصَلَّى بِالصَّفِ الَّذِي مَعَهُ رَكْعَةً , ثُمَّ ذَهَبَ هَؤُلاءِ إِلَى مَصَافِّ هَؤُلاءِ , فَصَلَّى بِهِمْ رَكْعَةً , ثُمَّ سَلَّمَ عَلَيْهِمْ جَمِيعًا , ثُمَّ انْصَرَفُوا , فَكَانَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَانِ , وَلِكُلِّ وَاحِدٍ مِنَ الْفَرِيقَيْنِ رَكْعَةٌ ""","","","","","Book of Prayer"
"4114","عَنِ الثَّوْرِيِّ , عَنْ سَالِمٍ الأَفْطَسِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" وَكَيْفَ تَكُونُ مَقْصُورَةً ؟ يَعْنِي إِذَا كَانَتْ لِكُلِّ وَاحِدٍ مِنَ الْفَرِيقَيْنِ رَكْعَةٌ ""","","","","","Book of Prayer"
"4115","عَنِ الثَّوْرِيِّ , عَنْ سَالِمٍ الأَفْطَسِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" وَكَيْفَ تَكُونُ مَقْصُورَةً ؟ يَعْنِي إِذَا كَانَتْ لِكُلِّ وَاحِدٍ مِنَ الْفَرِيقَيْنِ رَكْعَتَانِ , إِنَّهَا لَيْسَتْ بِقَصْرٍ ""","","","","","Book of Prayer"
"4116","عَنِ الثَّوْرِيِّ , قَالَ : صَلاةُ الْخَوْفِ , قال : \" يَقُومُ الإِمَامُ وَيَقُومُ خَلْفَهُ صَفٌّ , وَصَفٌّ مُوَازِيَ الْعَدُوِّ فِي غَيْرِ صَلاةٍ , فَيُصَلِّي بِالصَّفِّ الَّذِي خَلْفَهُ رَكْعَةً , ثُمَّ يَنْصَرِفُونَ عَلَى أَعْقَابِهِمْ مُوَازِيَ الْعَدُوِّ , وَيَجِيءُ الصَّفُّ الآخَرُونَ , فَيُصَلُّونَ مَعَ الإِمَامِ رَكْعَةً , ثُمَّ يَقُومُونَ فَيَنْطَلِقُونَ إِلَى مَصَافِّهِمْ , وَالإِمَامُ قَاعِدٌ , وَيَجِيءُ الأَوَّلُونَ وَالإِمَامُ قَاعِدٌ , فَيَرْكَعُونَ وَيَسْجُدُونَ , وَلا يَقْرَءُونَ , وَيَجْلِسُونَ مَعَ الإِمَامِ , ثُمَّ يَقُومُ بِهِمْ فَيُصَلِّي بِهِمُ الثَّانِيَةَ , ثُمَّ يُسَلِّمُ الإِمَامُ , فَيَنْطَلِقُونَ إِلَى مَصَافِّهِمْ , وَيَجِيءُ الآخَرُونَ فَيُصَلُّونَ رَكْعَةً يَقْرَءُونَ فِيهَا ثُمَّ يَجْلِسُونَ , وَيَتَشَهَّدُونَ , ثُمَّ يَقُومُونَ مَكَانَهُمْ فَيُصَلُّونَ رَكْعَةً أُخْرَى لا يَقْرَءُونَ فِيهَا إِلا بِفَاتِحَةِ الْكِتَابِ إِنْ شَاءُوا , وَيَتَشَهَّدُونَ وَيُسَلِّمُونَ ""","","","","","Book of Prayer"
"4117","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , أَنَّ أَبَاهُ , قَالَ :  أَنْ تَقْصُرُوا مِنَ الصَّلاةِ إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا , قَالَ : \" قَصْرُهَا فِي الْخَوْفِ وَالْقِتَالِ , الصَّلاةُ فِي كُلِّ وَجْهٍ رَاكِبًا وَمَاشِيًا \" , قَالَ : \" أَمَّا صَلاةُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ هَاتَيْنِ الرَّكْعَتَيْنِ , وَصَلاةُ النَّاسِ فِي السَّفَرِ رَكْعَتَيْنِ , فَلَيْسَ بِقَصْرٍ , هُوَ وَفَاؤُهَا \" , طَاوُسٍ يَقُولُ ذَلِكَ","","","","","Book of Prayer"
"4118","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ سُلَيْمَانُ لِعَطَاءٍ : الْمُسْلِمُ يَطْلُبُ الْعَدُوَّ عَلَى أَثَرِهِ فَيُصَلِّي وَهُوَ يَطْلُبُهُ مُدْبِرًا عَنِ الْبَيْتِ , قال : \" يُصَلِّي عَلَى دَابَّتِهِ كَذَلِكَ ؟ \" , قَالَ : \" لا , وَلَكِنْ إِذَا كَانَ الْمُسْلِمُ هُوَ يُطْلَبُ وَطَلَبُهُ الْعَدُوُّ فَلْيَقْضِهَا كَذَلِكَ ""","","","","","Book of Prayer"
"4119","عَنْ مَالِكٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِنْ كَانَ الْخَوْفُ أَشَدَّ مِنْ ذَلِكَ , كَأَنَّهُ يَعْنِي الْمُضَارَبَةَ صَلَّوْا رِجَالا , قِيَامًا عَلَى أَقْدَامِهِمْ , أَوْ رُكْبَانًا مُسْتَقْبِلِينَ الْقِبْلَةَ , أَوْ غَيْرَ مُسْتَقْبِلِيهَا \" , قَالَ : وَلا أَدْرِي عَبْدَ اللَّهِ إِلا وَقَدْ رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"4120","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِنْ كَانَ الْخَوْفُ أَشَدَّ مِنْ ذَلِكَ فَلْيُصَلُّوا قِيَامًا وَرُكْبَانًا حَيْثُ جِهَتُهُمْ ""","","","","","Book of Prayer"
"4121","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , قال : \" إِذَا أَظَلَّتْهُمُ الأَعْدَاءُ فَقَدْ حَلَّ لَهُمْ أَنْ يُصَلُّوا قِبَلَ أَيِّ جِهَةٍ كَانُوا رِجَالا , أَوْ رُكْبَانًا رَكْعَتَيْنِ يُومُونَ إِيمَاءً \" , ذَكَرَهُ الزُّهْرِيُّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ","","","","","Book of Prayer"
"4122","عَنْ سُفْيَانَ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ فِي قَوْلِهِ :  فَإِنْ خِفْتُمْ فَرِجَالا أَوْ رُكْبَانًا , قال : \" رَكْعَتَيْنِ يُومِئُ بِرَأْسِهِ إِيمَاءً حَيْثُ كَانَ وَجْهُهُ \" , قَالَ سُفْيَانُ : \" رَاكِبًا أَوْ مَاشِيًا ""","","","","","Book of Prayer"
"4123","عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ , قال : \" يُومِئُ بِرَكْعَةٍ ""","","","","","Book of Prayer"
"4124","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي قَوْلِهِ :  فَرِجَالا أَوْ رُكْبَانًا , قال : \" ذَلِكَ عِنْدَ الضِّرَابِ بِالسَّيْفِ , تُصَلِّي رَكْعَةً إِيمَاءً حَيْثُ كَانَ وَجْهُكَ رَاكِبًا كُنْتَ , أَوْ مَاشِيًا , أَوْ سَاعِيًا ""","","","","","Book of Prayer"
"4125","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الضَّحَّاكِ فِي قَوْلِهِ :  فَإِنْ خِفْتُمْ فَرِجَالا أَوْ رُكْبَانًا , قال : تُجْزِئُ تَكْبِيرَتَانِ حَيْثُ كَانَ تَوَجُّهُهُ ""","","","","","Book of Prayer"
"4126","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ مُجَاهِدٌ : \" إِذَا اخْتَلَطُوا , فَإِنَّمَا هُوَ الذِّكْرُ وَالإِشَارَةُ بِالرَّأْسِ ""","","","","","Book of Prayer"
"4127","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" إِذَا كَانَتِ الْمُسَايَفَةُ , فَإِنَّمَا هِيَ رَكْعَةٌ يُومِئُ بِهَا إِيمَاءً أَيْنَ كَانَ وَجْهُهُ مَاشِيًا أَوْ رَاكِبًا ""","","","","","Book of Prayer"
"4128","أَخْبَرَنَا مَعْمَرٌ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" رَكْعَتَانِ يُومِئُ بِهِمَا حَيْثُ كَانَ وَجْهُهُ ""","","","","","Book of Prayer"
"4129","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , \" أَنَّ عَائِشَة زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَتْهُ : أَنَّ الصَّلاةَ أَوَّلَ مَا فُرِضَتْ فُرِضَتْ رَكْعَتَيْنِ , ثُمَّ أَتَمَّ اللَّهُ الصَّلاةَ فِي الْحَضَرِ وَأُقِرَّتِ الرَّكْعَتَانِ عَلَى هَيْئَتِهِمَا فِي السَّفَرِ \" , قَالَ : فَقُلْتُ لِعُرْوَةَ : فَمَا كَانَ يَحْمِلُ عَائِشَةَ عَلَى أَنْ تُصَلِّيَ أَرْبَعَ رَكَعَاتٍ فِي السَّفَرِ وَقَدْ عَلِمَتْ أَنَّهَا فَرَضَهَا اللَّهُ رَكْعَتَيْنِ ؟ , قَالَ عُرْوَةُ : \" تَأَوَّلَتْ مِنْ ذَلِكَ مَا تَأَوَّلَ عُثْمَانُ مِنْ إِتْمَامِ الصَّلاةِ بِمِنًى ""","","","","","Book of Prayer"
"4130","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِنًى رَكْعَتَيْنِ , وَمَعَ أَبِي بَكْرٍ رَكْعَتَيْنِ , وَمَعَ عُمَرَ رَكْعَتَيْنِ , وَمَعَ عُثْمَانَ صَدْرًا مِنْ خِلافَتِهِ , ثُمَّ صَلاهَا أَرْبَعًا \" , قَالَ الزُّهْرِيُّ : \" فَبَلَغَنِي , أَنَّ عُثْمَانَ إِنَّمَا صَلاهَا أَرْبَعًا ؛ لأَنَّهُ أَزْمَعَ أَنْ يُقِيمَ بَعْدَ الْحَجِّ ""","","","","","Book of Prayer"
"4131","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَأَبَا بَكْرٍ , وَعُمَرَ , وَعُثْمَانَ صَدْرًا مِنْ خِلافَتِهِ , كَانُوا يُصَلُّونَ بِمَكَّةَ وَبِمِنًى رَكْعَتَيْنِ , ثُمَّ إِنَّ عُثْمَانَ صَلاهَا أَرْبَعًا \" , فَبَلَغَ ذَلِكَ ابْنَ مَسْعُودٍ , فَاسْتَرْجَعَ ثُمَّ قَامَ فَصَلَّى أَرْبَعًا , فَقِيلَ لَهُ : اسْتَرْجَعْتَ , ثُمَّ صَلَّيْتَ أَرْبَعًا ؟ , قَالَ : \" الْخِلافُ شَرٌّ ""","","","","","Book of Prayer"
"4132","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُسَافَرُ مِنَ الْمَدِينَةِ إِلَى مَكَّةَ لا يَخَافُ إِلا اللَّهَ فَيُصَلِّي رَكْعَتَيْنِ \" , عَنْ هِشَامٍ , عَنِ ابْنِ سِيرِينَ , عَنِ ابْنِ عَبَّاسٍ مِثْلَهُ","","","","","Book of Prayer"
"4133","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" قُلْتُ : فِيمَا جُعِلَ الْقَصْرُ فِي الْخَوْفِ وَقَدْ أَمِنَ النَّاسُ ؟ , قَالَ : السُّنَّةُ , قُلْتُ : وَرُخْصَةٌ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4134","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقْصُرُهَا فِيهَا مَا أَقَامَ يَعْنِي بِمَكَّةَ فِي سَفَرِهِ , وَأَبُو بَكْرٍ , وَعُمَرُ , وَعُثْمَانُ حَتَّى كَانَ بَيْنَ ظَهْرَانَيْ خِلافَتِهِ","","","","","Book of Prayer"
"4135","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : أَمَّا قَوْلُهُ :  إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا , قَالَ : \" إِنَّمَا ذَلِكَ إِذَا خَافُوا الَّذِينَ كَفَرُوا , وَسَنَّ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعْدُ رَكْعَتَيْنِ , وَلَيْسَ بِقَصْرٍ , وَلَكِنَّهَا وَفَاءٌ ""","","","","","Book of Prayer"
"4136","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ بْنَ عَبْدِ اللَّهِ بْنِ أَبِي عَمَّارٍ يُحَدِّثُ , عَنْ عَبْدِ اللَّهِ بْنِ بَابَاهْ , عَنْ يَعْلَى بْنِ أُمَيَّةَ , قَالَ : قُلْتُ لِعُمَرَ بْنِ الْخَطَّابِ : إِنَّمَا اللَّهُ , قَالَ :  أَنْ تَقْصُرُوا مِنَ الصَّلاةِ إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا , فَقَدْ أَمِنَ النَّاسُ , فَقَالَ عُمَرُ : عَجِبْتُ مِمَّا عَجِبْتَ مِنْهُ , فَسَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : \" صَدَقَةٌ تَصَدَّقَ اللَّهُ بِهَا عَلَيْكُمْ , فَاقْبَلُوا صَدَقَتَهُ ""","","","","","Book of Prayer"
"4137","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أُمَيَّةَ بْنِ عَبْدِ اللَّهِ , أَنَّهُ قَالَ لابْنِ عُمَرَ : نَجِدُ صَلاةَ الْخَوْفِ وَصَلاةَ الْحَضَرِ فِي الْقُرْآنِ , وَلا نَجِدُ صَلاةَ الْمُسَافِرِ , فَقَالَ ابْنُ عُمَرَ : \" بَعَثَ اللَّهُ نَبِيَّهُ وَنَحْنُ أَجْفَى النَّاسِ , فَنَصْنَعُ كَمَا صَنَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"4138","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ حُمَيْدٌ الْحِمْيَرِيُّ ابْنَ عَبَّاسٍ , فَقَالَ : إِنِّي أُسَافِرُ أَفَأَقْصُرُ الصَّلاةَ فِي السَّفَرِ أَمْ أُتِمُّهَا ؟ , فَقَالَ ابْنُ عَبَّاسٍ : \" لَيْسَ بِقَصْرِهَا , وَلَكِنْ تَمَامُهَا , وَسُنَّةُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ آمِنًا لا يَخَافُ إِلا اللَّهَ , فَصَلَّى اثْنَيْنِ حَتَّى رَجَعَ , ثُمَّ خَرَجَ أَبُو بَكْرٍ لا يَخَافُ إِلا اللَّهَ , فَصَلَّى رَكْعَتَيْنِ حَتَّى رَجَعَ , ثُمَّ خَرَجَ عُمَرُ آمِنًا لا يَخَافُ إِلا , اللَّهَ فَصَلَّى اثْنَيْنِ حَتَّى رَجَعَ , ثُمَّ فَعَلَ ذَلِكَ عُثْمَانُ ثُلُثَيْ إِمَارَتِهِ أَوْ شَطْرَهَا , ثُمَّ صَلاهَا أَرْبَعًا , ثُمَّ أَخَذَ بِهَا بَنُو أُمَيَّةَ \" , قَالَ ابْنُ جُرَيْجٍ : فَبَلَغَنِي , \" أَنَّهُ أَوْفَى أَرْبَعًا بِمِنًى قَطْ مِنْ أَجْلِ أَنَّ أَعْرَابِيًّا نَادَاهُ فِي مَسْجِدِ الْخَيْفِ بِمِنًى يَا أَمِيرَ الْمُؤْمِنِينَ , مَا زِلْتُ أُصَلِّيهِمَا رَكْعَتَيْنِ مُنْذُ رَأَيْتُكَ عَامَ أَوَّلٍ صَلَّيْتَهَا رَكْعَتَيْنِ , فَخَشِيَ عُثْمَانُ أَنْ يَظُنَّ جُهَّالُ النَّاسِ , إِنَّمَا الصَّلاةُ رَكْعَتَيْنِ , وَإِنَّمَا كَانَ أَوْفَاهَا بِمِنًى قَطْ ""","","","","","Book of Prayer"
"4139","عَنِ الثَّوْرِيِّ , عَنْ زُبَيْدٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : \" صَلاةُ الأَضْحَى رَكْعَتَانِ , وَصَلاةُ الْفِطْرِ رَكْعَتَانِ , وَصَلاةُ الْمُسَافِرِ رَكْعَتَانِ , تَمَامٌ وَلَيْسَ بِقَصْرٍ , عَلَى لِسَانِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","Book of Prayer"
"4140","عَنْ سَعِيدِ بْنِ السَّائِبِ , عَنْ دَاوُدَ بْنِ أَبِي عَاصِمٍ , قَالَ : لَقِيتُ ابْنَ عُمَرَ , فَقُلْتُ : الصَّلاةُ فِي السَّفَرِ , فَقَالَ : \" رَكْعَتَيْنِ \" , قَالَ : قُلْتُ : فَكَيْفَ تَرَى هَا هُنَا بِمِنًى ؟ , قَالَ : \" وَيْحَكَ وَهَلْ سَمِعْتَ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ \" , قَالَ : قُلْتُ : نَعَمْ , وَآمَنْتُ بِاللَّهِ , قَالَ : \" فَإِنَّهُ كَانَ يُصَلِّي رَكْعَتَيْنِ رَكْعَتَيْنِ , فَصَلِّ إِنْ شِئْتَ أَوْ دَعْ ""","","","","","Book of Prayer"
"4141","عَنْ إِسْرَائِيلَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , عَنْ أَبِيهِ , أَنَّ عَلِيًّا , قَالَ : \" صَلاةُ الْمُسَافِرِ رَكْعَتَانِ ""","","","","","Book of Prayer"
"4142","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ مُوَرِّقٍ الْعِجْلِيِّ , قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الصَّلاةِ فِي السَّفَرِ , فَقَالَ : \" رَكْعَتَيْنِ رَكْعَتَيْنِ , مَنْ خَالَفَ السُّنَّةَ كَفَرَ ""","","","","","Book of Prayer"
"4143","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ , قَالا : \" الْمُسَافِرُ يُصَلِّي رَكْعَتَيْنِ حَتَّى يَرْجِعَ , إِلا أَنْ يَدْخُلَ مِصْرًا مِنْ أَمْصَارِ الْمُسْلِمِينَ , فَإِنَّهُ يُتِمُّ ""","","","","","Book of Prayer"
"4144","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي لَيْلَى الْكِنْدِيِّ , قَالَ : أَقْبَلَ سُلَيْمَانُ فِي اثْنَيْ عَشَرَ رَاكِبًا , أَوْ ثَلاثَةَ عَشَرَ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَلَمَّا حَضَرَتِ الصَّلاةُ , قَالُوا : تَقَدَّمْ يَا أَبَا عَبْدِ اللَّهِ , قَالَ : \" إِنَّا لا نَؤُمُّكُمْ , وَلا نَنْكِحُ نِسَاءَكُمْ , إِنَّ اللَّهَ هَدَانَا بِكُمْ \" , قَالَ : فَتَقَدَّمَ رَجُلٌ مِنَ الْقَوْمِ فَصَلَّى أَرْبَعَ رَكَعَاتٍ , فَلَمَّا سَلَّمَ , قَالَ سَلْمَانُ : \" مَا لَنَا وَلِلْمَرْبَعَةِ ! , إِنَّمَا كَانَ يَكْفِينَا نِصْفُ الْمَرْبَعَةِ , وَنَحْنُ إِلَى الرُّخْصَةِ أَحْوَجُ ""","","","","","Book of Prayer"
"4145","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ عُثْمَانَ كَتَبَ إِلَى بَعْضِ عُمَّالِهِ , \" إِنَّهُ لا يُصَلِّي الرَّكْعَتَيْنِ الْمُقِيمُ , وَلا الْبَادِي , وَلا التَّاجِرُ , إِنَّمَا يُصَلِّي الرَّكْعَتَيْنِ مَنْ مَعَهُ الزَّادُ وَالْمَزَادُ ""","","","","","Book of Prayer"
"4146","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , قَالَ : أَخْبَرَنِي مَنْ قَرَأَ كِتَابَ عُثْمَانَ , أَوْ قُرِئَ عَلَيْهِ , أَنَّ عُثْمَانَ كَتَبَ إِلَى أَهْلِ الْبَصْرَةِ \" أَمَّا بَعْدُ , فَإِنَّهُ بَلَغَنِي أَنَّ بَعْضَكُمْ يَكُونُ فِي جَشْرَةٍ , أَوْ فِي تِجَارَةٍ , أَوْ يَكُونُ جَابِيًا فَيَقْصُرُ الصَّلاةَ , إِنَّمَا يَقْصُرُ الصَّلاةَ مَنْ كَانَ شَاخِصًا أَوْ بِحَضْرَةِ عَدُوٍّ ""","","","","","Book of Prayer"
"4147","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ : \" لا تُقْصَرُ الصَّلاةُ إِلا فِي حَجٍّ , أَوْ جِهَادٍ ""","","","","","Book of Prayer"
"4148","عَنِ الثَّوْرِيِّ , عَنْ خُصَيْفٍ , عَنْ أَبِي عُبَيْدَةَ , عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ قَالَ : \" لا تَغْتَرُّوا بِتِجَارَاتِكُمْ وَأَجْشَارِكُمْ , وَتُسَافِرُوا إِلَى آخِرِ السَّوَادِ , تَقُولُوا : إِنَّا قَوْمٌ سَفْرٌ , إِنَّمَا الْمُسَافِرُونَ مِنْ أُفُقٍ إِلَى أُفُقٍ ""","","","","","Book of Prayer"
"4149","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ , عَنِ ابْنِ سَعِيدٍ , وَحُذَيْفَةَ , أَنَّهُمَا كَانَا يَقُولانِ لأَهْلِ الْكُوفَةِ : \" لا يَغُرَّكُمْ جَشْرُكُمْ وَلا سَوَادُكُمْ , لا تَقْصُرُوا الصَّلاةَ إِلَى سَوَادٍ \" , قَالَ : \" وَبَيْنَهُمْ وَبَيْنَ السَّوَادِ ثَلاثُونَ فَرْسَخًا ""","","","","","Book of Prayer"
"4150","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : مَا أَرَى أَنْ تَقْصُرُوا فِي الصَّلاةِ إِلا فِي سَبِيلٍ مِنْ سُبُلِ اللَّهِ , وَقَدْ كَانَ قَبْلَ ذَلِكَ لا يَقُولُ هَذَا الْقَوْلَ , كَانَ يَقُولُ : يَقْصُرُ فِي كُلِّ ذَلِكَ , قَالَ : وَكَانَ طَاوُسٌ يَسْأَلُهُ الرَّجُلُ فَيَقُولُ : أُسَافِرُ لِبَعْضِ حَاجَتِي , أَقْصُرُ الصَّلاةَ ؟ فَيَسْكُتُ , وَقَالَ : إِذَا خَرَجْنَا حُجَّاجًا , أَوْ عُمَّارًا صَلَّيْنَا رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4151","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : قَوْلُهُمْ لا تَقْصُرُوا الصَّلاةَ إِلا فِي سَبِيلِ اللَّهِ , قال : \" إِنِّي لأَحْسَبُ أَنَّ ذَلِكَ كَذَلِكَ \" , قُلْتُ : لِمَ ؟ , قَالَ : \" مِنْ أَجْلِ أَنَّ إِمَامَ الْمُتَّقِينَ لَمْ يَقْصُرِ الصَّلاةَ إِلا فِي سَبِيلٍ مِنْ سُبُلِ اللَّهِ , حَجٍّ , أَوْ عُمْرَةٍ , أَوْ غَزْوَةٍ , وَالأَئِمَّةُ بَعْدَهُ أَيُّهُمْ كَانَ يَضْرِبُ فِي الأَرْضِ يَبْتَغِي الدُّنْيَا ؟ , قُلْتُ : أَرَأَيْتَ ابْنَ عَبَّاسٍ خَرَجَ فِي غَيْرِ حَجٍّ , وَلا عُمْرَةٍ ؟ , قَالَ : \" لا , إِلا مَخْرَجُهُ إِلَى الطَّائِفِ \" , قُلْتُ : فَجَابِرٌ , وَابْنُ عُمَرَ , وَأَبُو سَعِيدٍ الْخُدْرِيُّ ؟ , قَالَ : \" وَلا أَحَدٌ مِنْهُمْ \" , قُلْتُ : فَمَا تَرَى ؟ , قَالَ : قَالَ : \" أَرَى أَلا تَقْصُرَ إِلا فِي سَبِيلِ اللَّهِ فِي سَبِيلِ الْخَيْرِ , وَقَدْ كَانَ قَبْلَ ذَلِكَ لا يَقُولُ هَذَا الْقَوْلَ , يَقْصُرُ فِي كُلِّ ذَلِكَ ""","","","","","Book of Prayer"
"4152","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , \" أَنَّ ابْنَ عُمَرَ يَقْصُرُ إِلَى مَالٍ لَهُ بِخَيْبَرَ يُطَالِعُهُ , فَلَيْسَ الآنَ حَجٌّ , وَلا عُمْرَةٌ , وَلا غَزْوَةٌ ""","","","","","Book of Prayer"
"4153","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , \" أَنَّ ابْنَ عَبَّاسٍ خَرَجَ إِلَى الطَّائِفِ يَقْصُرُ الصَّلاةَ ""","","","","","Book of Prayer"
"4154","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : أَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ , \" أَنَّ ابْنَ عُمَرَ اشْتَرَى شَيْئًا مِنْ رَجُلٍ أَحْسَبُهُ نَاقَةً , فَخَرَجَ يَنْظُرُ إِلَيْهَا فَقَصَرَ الصَّلاةَ , وَكَانَ ذَلِكَ مَسِيرَةَ يَوْمٍ تَامٍّ , أَوْ أَرْبَعٍ , كَذَا , بُرُدٍ ""","","","","","Book of Prayer"
"4155","عَنْ مَالِكٍ , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ خَرَجَ إِلَى خَيْبَرَ فَقَصَرَ الصَّلاةَ ""","","","","","Book of Prayer"
"4156","عَنْ مَالِكٍ , عَنْ نَافِعٍ , \" أَنَّهُ كَانَ يُسَافِرُ مَعَ ابْنِ عُمَرَ الْبَرِيدَ فَلا يَقْصُرُ فِيهِ الصَّلاةَ ""","","","","","Book of Prayer"
"4157","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ , فَقُلْتُ : أَقْصُرُ الصَّلاةَ إِلَى عَرَفَةَ , أَوْ إِلَى مِنًى ؟ , قَالَ \" لا , وَلَكِنْ إِلَى الطَّائِفِ وَإِلَى جُدَّةَ , وَلا تَقْصُرُوا الصَّلاةَ إِلا فِي الْيَوْمِ التَّامِّ , وَلا تَقْصُرْ فِيمَا دُونَ الْيَوْمِ , فَإِنْ ذَهَبْتَ إِلَى الطَّائِفِ , أَوْ إِلَى جُدَّةَ , أَوْ إِلَى قَدْرِ ذَلِكَ مِنَ الأَرْضِ , إِلَى أَرْضٍ لَكَ , أَوْ مَاشِيَةٍ فَاقْصُرِ الصَّلاةَ , فَإِذَا قَدِمْتَ فَأَوْفِ ""","","","","","Book of Prayer"
"4158","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ دِينَارٍ , عَنْ عَطَاءٍ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ : أَقْصُرُ الصَّلاةَ إِلَى عَرَفَةَ ؟ , قَالَ : \" لا \" , قُلْتُ : إِلَى مِنًى ؟ , قَالَ : \" لا , وَلَكِنْ إِلَى جُدَّةَ , وَإِلَى عُسْفَانَ , وَإِلَى الطَّائِفِ , فَإِنْ قَدِمْتَ عَلَى أَهْلٍ لَكَ , أَوْ عَلَى مَاشِيَةٍ فَأَتِمَّ الصَّلاةَ ""","","","","","Book of Prayer"
"4159","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ : \" سَأَلَ رَجُلٌ ابْنَ عَبَّاسٍ , فَقَالَ : أَقْصُرُ الصَّلاةَ إِلَى مِنًى ؟ , قَالَ : لا , قَالَ : فَإِلَى عَرَفَةَ ؟ , قَالَ : لا , قَالَ : فَإِلَى الطَّائِفِ ؟ , قَالَ : نَعَمٌ ""","","","","","Book of Prayer"
"4160","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" إِذَا سَافَرْتَ يَوْمًا إِلَى الْعِشَاءِ فَأَتِمَّ الصَّلاةَ , فَإِنْ زِدْتَ فَاقْصُرْ ""","","","","","Book of Prayer"
"4161","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , عَنِ الزُّهْرِيِّ , قَالَ : \" أَخْبَرَنِي سَالِمٌ , أَنَّ ابْنَ عُمَرَ كَانَ يَقْصُرُ الصَّلاةَ فِي مَسِيرَةِ الْيَوْمِ التَّامِّ ""","","","","","Book of Prayer"
"4162","قَالَ مَعْمَرٌ وَأَخْبَرَنِي أَيُّوبُ , عَنْ نَافِعٍ , \" أَنَّ ابْنَ عُمَرَ كَانَ يَقْصُرُ الصَّلاةَ فِي مَسِيرَةِ أَرْبَعٍ كَذَا بُرُدٍ ""","","","","","Book of Prayer"
"4163","عَنْ مَالِكٍ , عَنِ ابْنِ شِهَابٍ , عَنْ سَالِمٍ , \" أَنَّ ابْنَ عُمَرَ سَافَرَ إِلَى رِيمٍ فَقَصَرَ الصَّلاةَ , وَهِيَ مَسِيرَةُ ثَلاثِينَ مِيلا ""","","","","","Book of Prayer"
"4164","قَالَ مَالِكٌ وَأَخْبَرَنِي نَافِعٌ , \" أَنَّ ابْنَ عُمَرَ قَصَرَ الصَّلاةَ إِلَى ذَاتِ النُّصُبِ ""","","","","","Book of Prayer"
"4165","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , \" أَنَّ ابْنَ عُمَرَ كَانَ أَدْنَى مَا يَقْصُرُ الصَّلاةَ إِلَيْهِ مَالٌ لَهُ يُطَالِعُهُ مِنْ خَيْبَرَ , وَهِيَ مَسِيرَةُ ثَلاثَةِ قَوَاصِدَ , لَمْ يَكُنْ يَقْصُرُ فِيمَا دُونَهُ \" , قُلْتُ : وَكَمْ خَيْبَرُ ؟ , قَالَ : \" ثَلاثُ قَوَاصِدَ \" , قُلْتُ : فَالطَّائِفُ ؟ , قَالَ : \" نَعَمْ , مِنَ السِّهْلَةِ وَأَنْفَسُ قَلِيلا ""","","","","","Book of Prayer"
"4166","عَنْ إِسْرَائِيلَ , عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ الأَعْلَى , قَالَ : سَمِعْتُ سُوَيْدَ بْنَ غَفَلَةَ , يَقُولُ : \" إِذَا سَافَرْتَ ثَلاثًا فَاقْصُرِ الصَّلاةَ ""","","","","","Book of Prayer"
"4167","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ , وَسَعِيدَ بْنَ جُبَيْرٍ فِي كَمْ تَقْصُرُ الصَّلاةَ ؟ , فَقَالا : \" فِي مَسِيرَةِ ثَلاثَةٍ ""","","","","","Book of Prayer"
"4168","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , قال : \" إِذَا كَانَ السَّفَرُ مَسِيرَةَ لَيْلَتَيْنِ فَأَكْثَرَ فَاقْصُرِ الصَّلاةَ , وَبِهِ يَأْخُذُ قَتَادَةُ ""","","","","","Book of Prayer"
"4169","عَنْ إِسْرَائِيلَ , عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ الأَعْلَى , قَالَ : قَالَ لِي سُوَيْدُ بْنُ غَفَلَةَ : \" إِذَا سَافَرْتَ ثَلاثًا فَاقْصُرِ الصَّلاةَ ""","","","","","Book of Prayer"
"4170","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ التَّيْمِيِّ , عَنْ أَبِيهِ , قَالَ : \" كُنْتُ مَعَ حُذَيْفَةَ بِالْمَدَائِنِ , فَاسْتَأْذَنْتُ أَنْ آتِيَ أَهْلِي بِالْكُوفَةِ , فَأَذِنَ , وَشَرَطَ عَلَيَّ أَنْ لا أُفْطِرَ وَلا أُصَلِّيَ رَكْعَتَيْنِ حَتَّى أَرْجِعَ إِلَيْهِ ""","","","","","Book of Prayer"
"4171","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" يَقْصُرُ الصَّلاةَ فِي مَسِيرَةِ يَوْمَيْنِ ""","","","","","Book of Prayer"
"4172","عَنْ إِسْرَائِيلَ , عَنْ عَامِرِ بْنِ شَقِيقٍ , قال : سَأَلْتُ شَقِيقَ بْنَ سَلَمَةَ , قَالَ : قُلْتُ : أَخْرُجُ إِلَى الْمَدَائِنِ , أَوْ إِلَى وَاسِطٍ , قَالَ : لا تَقْصُرِ الصَّلاةَ ""","","","","","Book of Prayer"
"4173","عَنْ إِسْرَائِيلَ , عَنْ عِيسَى , قال : \" رَأَيْتُ عَامِرًا الشَّعْبِيَّ يَسِيرُ إِلَى وَاسِطٍ فَيَقْصُرُ الصَّلاةَ وَيُفْطِرُ ""","","","","","Book of Prayer"
"4174","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : فَمَنْ سَلَكَ الثَّنَايَا حَاجًّا , أَوْ مُعْتَمِرًا , وَمَنْ سَلَكَ السِّهْلَةَ مِنْ طَرِيقِ الطَّائِفِ قَصَرَ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4175","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنْ عِكْرِمَةَ , قال : \" إِذَا خَرَجْتَ فَبِتَّ فِي غَيْرِ أَهْلِكَ فَاقْصُرْ , فَإِنْ أَتَيْتَ إِلَى أَهْلِكَ فَأَتْمِمْ ""","","","","","Book of Prayer"
"4176","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" تُقْصَرُ الصَّلاةُ إِلَى الْمَدَائِنِ , وَهِيَ سَبْعَةٌ وَعِشْرُونَ فَرْسَخًا مِنَ الْكُوفَةِ ""","","","","","Book of Prayer"
"4177","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : \" صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمَدِينَةِ أَرْبَعًا , وَصَلَّيْتُ مَعَهُ الْعَصْرَ بِذِي الْحُلَيْفَةِ رَكْعَتَيْنِ , وَكَانَ خَرَجَ مُسَافِرًا ""","","","","","Book of Prayer"
"4178","عَنِ الثَّوْرِيِّ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , وَمُحَمَّدِ بْنِ الْمُنْكَدِرِ , عَنْ أَنَسٍ , قَالَ : \" صَلَّيْتُ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ بِالْمَدِينَةِ أَرْبَعًا , وَالْعَصْرَ بِذِي الْحُلَيْفَةِ رَكْعَتَيْنِ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ الْمُنْكَدِرِ , وَإِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ أَنَسٍ , مِثْلُهُ","","","","","Book of Prayer"
"4179","عَنْ هُشَيْمٍ , قَالَ : أَخْبَرَنِي أَبُو هَارُونَ , عَنْ أَبِي سَعِيدٍ , قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا سَارَ فَرْسَخًا نَزَلَ يَقْصُرُ الصَّلاةَ ""","","","","","Book of Prayer"
"4180","عَنِ الثَّوْرِيِّ , عَنْ دَاوُدَ , عَنْ أَبِي حَرْبِ بْنِ أَبِي الأَسْوَدِ الدِّيَلِيِّ , أَنَّ عَلِيًّا لَمَّا خَرَجَ إِلَى الْبَصْرَةِ رَأَى خُصًّا , فَقَالَ \" لَوْلا هَذَا الْخُصُّ لَصَلَّيْنَا رَكْعَتَيْنِ \" , فَقُلْتُ : مَا خُصًّا ؟ , قَالَ : \" بَيْتٌ مِنْ قَصَبٍ ""","","","","","Book of Prayer"
"4181","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ الْمُنْكَدِرِ , عَنْ أَنَسِ بْنِ مَالِكٍ : \" أَنَّهُ صَلَّى مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْمَدِينَةِ الظُّهْرَ أَرْبَعًا , وَصَلَّيْتُ مَعَهُ بِذِي الْحُلَيْفَةِ الْعَصْرَ رَكْعَتَيْنِ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُرِيدُ مَكَّةَ ""","","","","","Book of Prayer"
"4182","عَنِ الثَّوْرِيِّ , عَنْ وِقَاءِ بْنِ إِيَاسٍ الأَسَدِيِّ , قَالَ : حَدَّثَنِي عَلِيُّ بْنُ رَبِيعَةَ الأَسَدِيُّ , قَالَ : \" خَرَجْنَا مَعَ عَلِيٍّ وَنَحْنُ نَنْظُرُ إِلَى الْكُوفَةِ , فَصَلَّى رَكْعَتَيْنِ , ثُمَّ رَجَعَ فَصَلَّى رَكْعَتَيْنِ , وَهُوَ يَنْظُرُ إِلَى الْقَرْيَةِ , فَقُلْنَا لَهُ : أَلا تُصَلِّي أَرْبَعًا ؟ , قَالَ : حَتَّى نَدْخُلَهَا ""","","","","","Book of Prayer"
"4183","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَيْدٍ الْفَايْشِيِّ , قَالَ : \" خَرَجْنَا مَعَ عَلِيٍّ إِلَى صِفِّينَ , فَصَلَّى رَكْعَتَيْنِ بَيْنَ الْقَنْطَرَةِ وَالْجِسْرِ ""","","","","","Book of Prayer"
"4184","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ : \" أَنَّهُ كَانَ يَقْصُرُ الصَّلاةَ حِينَ يَخْرُجُ مِنْ بُيُوتِ الْمَدِينَةِ , وَيَقْصُرُ إِذَا رَجَعَ حَتَّى يَدْخُلَ بُيُوتَهَا ""","","","","","Book of Prayer"
"4185","عَنْ مَالِكٍ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا خَرَجَ حَاجًّا أَوْ مُعْتَمِرًا قَصَرَ الصَّلاةَ بِذِي الْحُلَيْفَةِ ""","","","","","Book of Prayer"
"4186","عَنْ إِسْرَائِيلَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , قَالَ : \" خَرَجْتُ مَعَ أَبِي , وَمَعَ عَلْقَمَةَ , وَالأَسْوَدِ , وَعَمْرِو بْنِ مَيْمُونٍ فَقَصَرُوا حِينَ خَرَجُوا مِنَ الْبُيُوتِ ""","","","","","Book of Prayer"
"4187","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : كَانَ يَقْصُرُ إِذَا خَلَّفَ الْبُيُوتَ ""","","","","","Book of Prayer"
"4188","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا أَرَدْتَ السَّفَرَ فَجَاوَزْتَ الْجِسْرَ , أَوِ الْخَنْدَقَ فَصَلِّ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4189","عَنِ الثَّوْرِيِّ , عَنْ حُصَيْنٍ , عَنْ إِبْرَاهِيمَ , قال : \" كَانَ عَلْقَمَةُ يَقْصُرُ بِالنَّجَفِ , وَكَانَ الأَسْوَدُ يَقْصُرُ بِالْقَادِسِيَّةِ إِذَا أَرَادُوا مَكَّةَ ""","","","","","Book of Prayer"
"4190","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا خَرَجَ الرَّجُلُ حَاجًّا فَلَمْ يَخْرُجْ مِنْ بُيُوتِ الْقَرْيَةِ حَتَّى حَضَرَتِ الصَّلاةُ , فَإِنْ شَاءَ قَصَرَ , وَإِنْ شَاءَ أَوْفَى , وَمَا سَمِعْتُ فِي ذَلِكَ بِشَيْءٍ ""","","","","","Book of Prayer"
"4191","عَنِ ابْنِ جُرَيْجٍ , عَنْ سُلَيْمَانَ بْنِ مُوسَى , قال : \" إِذَا خَرَجَ الرَّجُلُ مِنْ بَيْتِهِ ذَاهِبًا لِوَجْهِهِ فَلَمْ يَخْرُجْ مِنَ الْقَرْيَةِ حَتَّى حَانَتِ الصَّلاةُ فَلْيَقْصُرْهَا , وَكَذَلِكَ إِذَا دَخَلَ الْقَرْيَةَ مُرَاجِعًا مِنْ سَفَرِهِ , ثُمَّ حَانَتِ الصَّلاةُ فَلْيَقْصُرْهَا حَتَّى يَدْخُلَ بَيْتَهُ ""","","","","","Book of Prayer"
"4192","عَنِ ابْنِ جُرَيْجٍ , عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ إِذَا خَرَجَ مِنْ بَيْتِهِ يَقْصُرُ الصَّلاةَ حَتَّى يَرْجِعَ إِلَيْهِ ""","","","","","Book of Prayer"
"4193","عَنِ الثَّوْرِيِّ , قال : \" إِذَا خَرَجَ فِي وَقْتِ الصَّلاةِ صَلَّى رَكْعَتَيْنِ , كَمَا لَوْ دَخَلَ الْقَرْيَةَ فِي وَقْتِ الصَّلاةِ صَلَّى أَرْبَعًا ""","","","","","Book of Prayer"
"4194","عَنِ الثَّوْرِيِّ , عَنْ جَعْفَرِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ , عَنْ أَبِيهِ , قال : \" إِذَا أَقَمْتُ بِأَرْضٍ عَشْرًا فَأُتِمُّ , فَإِنْ قُلْتُ : أَخْرُجُ الْيَوْمَ أَوْ غَدًا , فَأُصَلِّي رَكْعَتَيْنِ , وَإِذَا أَقَمْتُ شَهْرًا فَأُصَلِّي رَكْعَتَيْنِ \" , عَنْ إِبْرَاهِيمَ , عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ , عَنْ أَبِيهِ , عَنْ عَلِيٍّ , مِثْلُهُ","","","","","Book of Prayer"
"4195","قَالَ أَبُو سَعِيدٍ وَجَدْتُ فِي كِتَابِ غَيْرِي , عَنْ مَعْمَرٍ وَهُوَ الصَّوَابُ , قَالَ : أَخْبَرَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ , عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : \" أَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَبُوكَ عِشْرِينَ يَوْمًا يَقْصُرُ الصَّلاةَ ""","","","","","Book of Prayer"
"4196","عَنِ الثَّوْرِيِّ , عَنْ يَحْيَى بْنِ أَبِي إِسْحَاقَ , قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِكٍ , يَقُولُ : \" خَرَجْنَا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْصُرُ الصَّلاةَ حَتَّى جَاءَ مَكَّةَ فَأَقَامَ بِهَا عَشْرًا يَقْصُرُ حَتَّى رَجَعْنَا ""","","","","","Book of Prayer"
"4197","عَنِ ابْنِ مُبَارَكٍ , عَنْ عَاصِمٍ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" أَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمَكَّةَ سَبْعَ عَشْرَةَ لَيْلَةً يَقْصُرُ الصَّلاةَ ""","","","","","Book of Prayer"
"4198","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنِ الْحَكَمِ , عَنْ مِقْسَمٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" أَقَامَ رَسُولُ اللَّهِ بِخَيْبَرَ أَرْبَعِينَ لَيْلَةً يَقْصُرُ الصَّلاةَ ""","","","","","Book of Prayer"
"4199","عَنِ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ أَقَامَ بِأَذْرَبِيجَانَ سِتَّةَ أَشْهُرٍ يَقْصُرُ الصَّلاةَ قَالَ : وَكَانَ يَقُولُ : \" إِذَا أَزْمَعْتَ إِقَامَةً فَأَتِمَّ ""","","","","","Book of Prayer"
"4200","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمِ بْنِ عُمَرَ , قال : \" لَوْ قَدِمْتُ أَرْضًا لَصَلَّيْتُ رَكْعَتَيْنِ مَا لَمْ أُجْمِعْ مُكْثًا , وَإِنْ أَقَمْتُ اثْنَتَيْ عَشْرَةَ لَيْلَةً \" , عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , مِثْلُهُ","","","","","Book of Prayer"
"4201","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ كَانَ يَقُولُ : \" إِذَا أَجْمَعْتَ أَنْ تُقِيمَ اثْنَتَيْ عَشْرَةَ لَيْلَةً فَأَتِمَّ الصَّلاةَ ""","","","","","Book of Prayer"
"4202","عَنْ عُمَرَ بْنِ ذَرٍّ , قَالَ : سَمِعْتُ مُجَاهِدًا , يَقُولُ : \" كَانَ ابْنُ عُمَرَ إِذَا قَدِمَ مَكَّةَ فَأَرَادَ أَنْ يُقِيمَ خَمْسَ عَشْرَةَ لَيْلَةً سَرَّحَ ظَهْرَهُ فَأَتَمَّ الصَّلاةَ ""","","","","","Book of Prayer"
"4203","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ ابْنِ سِيرِينَ , قَالَ : \" كَتَبَ عُبَيْدُ اللَّهِ بْنُ عُمَرَ إِلَى ابْنِ عُمَرَ وَهُوَ بِأَرْضِ فَارِسَ : إِنَّا مُقِيمُونَ إِلَى الْهِلالِ , فَكَتَبَ , أَنْ أُصَلِّيَ رَكْعَتَيْنِ \" , عَنِ الثَّوْرِيِّ , عَنِ ابْنِ عَجْلانَ , عَنْ نَافِعٍ , مِثْلُهُ","","","","","Book of Prayer"
"4204","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيِّبِ , قال : إِذَا أَقَمْتَ بِأَرْضٍ أَرْبَعًا فَصَلِّ أَرْبَعًا \" , عَنْ مَالِكٍ , عَنْ عَطَاءِ بْنِ عَبْدِ اللَّهِ الْخُرَاسَانِيِّ , عَنِ ابْنِ الْمُسَيِّبِ , مِثْلُهُ","","","","","Book of Prayer"
"4205","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي دَاوُدُ بْنُ أَبِي هِنْدَ , عَنِ ابْنِ الْمُسَيِّبِ , قال : \" إِذَا أَزْمَعْتَ بِقِيَامٍ خَمْسَ عَشْرَةَ لَيْلَةً فَأَتِمَّ ""","","","","","Book of Prayer"
"4206","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ الْحَارِثِ , قَالَ : \" قَدِمْنَا الْمَدِينَةَ فَأَرْسَلْتُ إِلَى ابْنِ الْمُسَيِّبِ , إِنَّا مُقِيمُونَ أَيَّامًا بِالْمَدِينَةِ أَفَنَقْصُرُ ؟ , قَالَ : نَعَمْ ""","","","","","Book of Prayer"
"4207","عَنِ الثَّوْرِيِّ , عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْمِسْوَرِ , عَنْ سَعْدٍ , قَالَ : \" كُنَّا مَعَهُ بِالشَّامِ شَهْرَيْنِ , فَكُنَّا نُتِمُّ وَكَانَ يَقْصُرُ , فَقُلْنَا لَهُ , فَقَالَ : إِنَّا نَحْنُ أَعْلَمُ ""","","","","","Book of Prayer"
"4208","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي زَكَرِيَّا بْنُ عُمَرَ , \" أَنَّ سَعْدَ بْنَ أَبِي وَقَّاصٍ وَفَدَ إِلَى مُعَاوِيَةَ فَأَقَامَ عِنْدَهُ شَهْرًا يَقْصُرُهُ , أَوْ شَهْرَ رَمَضَانَ فَأَفْطَرَهُ ""","","","","","Book of Prayer"
"4209","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ , قَالَ : كُنَّا مَعَهُ فِي بَعْضِ بِلادِ فَارِسَ سَنَتَيْنِ , وَكَانَ لا يَجْمَعُ , وَلا يَزِيدُ عَلَى رَكْعَتَيْنِ \" , عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ , مِثْلُهُ","","","","","Book of Prayer"
"4210","عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ جَعْفَرِ بْنِ عَبْدِ اللَّهِ , \" أَنَّ أَنَسَ بْنَ مَالِكٍ أَقَامَ بِالشَّامِ شَهْرَيْنِ مَعَ عَبْدِ الْمَلِكِ بْنِ مَرْوَانٍ يُصَلِّي رَكْعَتَيْنِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4211","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , وَمَنْصُورٍ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ : \" أَنَّهُ أَقَامَ بِخَوَارَزْمَ سَنَتَيْنِ فَصَلَّى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4212","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ شَقِيقٍ , قال : كُنَّا مَعَ مَسْرُوقٍ بِالسِّلْسِلَةِ سِنِينَ , وَهُوَ عَامِلٌ عَلَيْهَا , فَصَلَّى بِنَا رَكْعَتَيْنِ رَكْعَتَيْنِ حَتَّى انْصَرَفَ , وَيَلْتَمِسُ بِذَلِكَ السُّنَّةَ ""","","","","","Book of Prayer"
"4213","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ أَبِي وَائِلٍ , \" أَنَّهُ خَرَجَ مَعَ مَسْرُوقٍ إِلَى السِّلْسِلَةِ فَقَصَرَ , وَأَقَامَ سِنِينَ يَقْصُرُ \" , قَالَ : قُلْتُ لَهُ : يَا أَبَا عَائِشَةَ , مَا يَحْمِلُكَ عَلَى هَذَا ؟ , قَالَ : \" الْتِمَاسُ السُّنَّةِ \" , وَقَصَرَ حَتَّى رَجَعَ","","","","","Book of Prayer"
"4214","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , قَالَ : \" أَقَمْنَا مَعَ وَالٍ , قَالَ : أَحْسَبُهُ بِسِجِسْتَانَ سَنَتَيْنِ , وَمَعَنَا رِجَالٌ مِنْ أَصْحَابِ ابْنِ مَسْعُودٍ , فَصَلَّى بِنَا رَكْعَتَيْنِ رَكْعَتَيْنِ حَتَّى انْصَرَفَ , ثُمَّ قَالَ : كَذَلِكَ كَانَ ابْنُ مَسْعُودٍ يَفْعَلُ ""","","","","","Book of Prayer"
"4215","عَنْ يَاسِينَ , عَنْ أَبِي إِسْحَاقَ , عَنْ زَائِدَةَ بْنِ عُمَيْرٍ , قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : إِنِّي أَخْرُجُ مُسَافِرًا فَأُقِيمُ سِنِينَ مُكْعَبًا عَدُومًا فَأَقْصُرُ ؟ قَالَ : \" لَيْسَ بِقَصْرٍ وَلَكِنْ تَمَامٌ , فَصَلِّ رَكْعَتَيْنِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4216","عَنْ هِشَامٍ , عَنِ الْحَسَنِ , قال : \" يُصَلِّي رَكْعَتَيْنِ , وَإِنْ أَقَامَ سَنَةً ""","","","","","Book of Prayer"
"4217","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ أَسْمَاءَ بْنِ عُبَيْدٍ , قَالَ : سَأَلْتُ الشَّعْبِيَّ زَمَانَ الْحَجِّ ؟ , قَالَ : قُلْتُ : آتِي إِلَى الْكُوفَةِ وَفِيهَا جَدَّتِي وَأَهْلِي ؟ , قَالَ : فَقَالَ : أَيُّ الأَمْصَارِ أَفْضَلُ , أَوْ قَالَ : أَعْظَمُ ؟ ثُمَّ أَجَابَنِي , فَقَالَ : أَلَيْسَ الْمَدِينَةُ ؟ , فَقُلْتُ : بَلَى , فَقَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ ذَلِكَ , فَقَالَ : إِنِّي لآتِي الْبَيْتَ الَّذِي وُلِدْتُ فِيهِ يَعْنِي مَكَّةَ , فَمَا أَزِيدُ عَلَى رَكْعَتَيْنِ \" , قَالَ الشَّعْبِيُّ : \" فَكُنْتُ أُقِيمُ سَنَةً أَوْ سَنَتَيْنِ أُصَلِّي رَكْعَتَيْنِ , أَوْ قَالَ : مَا أَزِيدُ عَلَى رَكْعَتَيْنِ رَكْعَتَيْنِ \" . عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ أَسْمَاءَ , عَنِ الشَّعْبِيِّ , مِثْلُهُ","","","","","Book of Prayer"
"4218","عَنْ إِسْرَائِيلَ , عَنْ عِيسَى بْنِ أَبِي عَزَّةَ , قَالَ : \" مَكَثَ عِنْدَنَا عَامِرٌ الشَّعْبِيُّ بِالنَّهْرَيْنِ أَرْبَعَةَ أَشْهُرٍ لا يَزِيدُ عَلَى رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4219","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ يَزِيدَ الرِّشْكِ , قَالَ : حَدَّثَنَا أَبُو مِجْلَزٍ , قَالَ : كُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ فَدَخَلَ عَلَيْهِ رَجُلٌ , فَقَالَ : يَا أَبَا عَبْدِ الرَّحْمَنِ ! مَا الإِشْرَاكُ بِاللَّهِ ؟ , قَالَ \" أَنْ تَجْعَلَ مَعَ اللَّهِ إِلَهًا آخَرَ \" , فَقَالَ أَيْضًا : يَا أَبَا عَبْدِ الرَّحْمَنِ ! مَا الإِشْرَاكُ بِاللَّهِ ؟ , قَالَ : \" أَنْ تَتَّخِذَ مِنْ دُونِ اللَّهِ أَنْدَادًا \" , فَقَالَ أَيْضًا : يَا أَبَا عَبْدِ الرَّحْمَنِ ! مَا الإِشْرَاكُ بِاللَّهِ ؟ , فَقَالَ : \" أُحَرِّجُ عَلَيْكَ إِنْ كُنْتَ مُسْلِمًا لَمَا خَرَجْتَ عَنِّي \" , فَخَرَجَ الرَّجُلُ , وَغَضِبَ ابْنُ عُمَرَ غَضَبًا شَدِيدًا , قَالَ : فَقُمْتُ لَمَّا رَأَيْتُ مِنْ شِدَّةِ غَضَبِهِ لأَخْرُجَ , فَضَرَبَ بِيَدِي عَلَى رُكْبَتِي , فَقَالَ : \" اجْلِسْ , فَإِنِّي أَرْجُو أَنْ لا تَكُونَ مِنْهُمْ \" , قَالَ : قُلْتُ : يَا أَبَا عَبْدِ الرَّحْمَنِ ! آتِي الْمَدِينَةَ طَالِبَ حَاجَةٍ , فَأُقِيمُ بِهَا السَّبْعَةَ الأَشْهُرَ وَالثَّمَانِيَةَ الأَشْهُرَ , كَيْفَ أُصَلِّي ؟ , قَالَ : \" صَلِّ رَكْعَتَيْنِ رَكْعَتَيْنِ ""","","","","","Book of Prayer"
"4220","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللَّهِ , قَالَ : كَيْفَ كَانَ ابْنُ عُمَرَ يَصْنَعُ ؟ , قَالَ : \" إِذَا كَانَ صَدَرَ الظَّهْرُ , وَقَالَ : نَحْنُ مَاكِثُونَ , أَتَمَّ الصَّلاةَ , وَقَالَ : وَإِذَا قَالَ الْيَوْمَ وَغَدًا قَصَرَ الصَّلاةَ , وَإِنْ مَكَثَ عِشْرِينَ لَيْلَةً ""","","","","","Book of Prayer"
"4221","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : أَمَّا مَا كُنْتُ أَتَجَهَّزُ بِبَلَدٍ , أَقُولُ : أَخْرُجُ الآنَ الآنَ , فَإِنِّي أَقْصُرُ الصَّلاةَ , فَإِنْ أَزْمَعْتُ إِقَامَتَهُ فَإِنِّي أُوفِي \" , قُلْتُ : إِنِّي مُقِيمٌ عَشْرًا ؟ , قَالَ : \" فَأَوْفِ ""","","","","","Book of Prayer"
"4222","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : إِذَا وَضَعْتَ رَحْلَكَ بِأَرْضٍ فَأَتِمَّ الصَّلاةَ ""","","","","","Book of Prayer"
"4223","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قِيلَ لِعَطَاءٍ : إِنْسَانٌ يَسِيرُ فِي الرَّمَلِ قَرِيبًا مِنَ الشَّهْرِ يَنْتَجِعُ كُلَّ يَوْمٍ , أَيَقْصُرُ ؟ , قَالَ : \" لا , قَوْمٌ يَسِيرُونَ فِي أَمْوَالِهِمْ يُقِيمُونَ بَيْنَ ذَلِكَ ""","","","","","Book of Prayer"
"4224","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : صَلَّى عُمَرُ بِأَهْلِ مَكَّةَ الظُّهْرَ , فَسَلَّمَ فِي رَكْعَتَيْنِ , ثُمَّ قَالَ : \" أَتِمُّوا صَلاتَكُمْ يَا أَهْلَ مَكَّةَ ! فَإِنَّا قَوْمٌ سَفْرٌ ""","","","","","Book of Prayer"
"4225","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : صَلَّى عُمَرُ بِأَهْلِ مَكَّةَ الظُّهْرَ أَوِ الْعَصْرَ , فَسَلَّمَ فِي رَكْعَتَيْنِ , ثُمَّ قَالَ : \" أَتِمُّوا صَلاتَكُمْ يَا أَهْلَ مَكَّةَ ! فَإِنَّا قَوْمٌ سَفْرٌ ""","","","","","Book of Prayer"
"4226","عَنِ الثَّوْرِيِّ , عَنْ زَيْدِ بْنِ أَسْلَمَ , عَنْ أَبِيهِ , قَالَ : صَلَّى عُمَرُ بِأَهْلِ مَكَّةَ رَكْعَتَيْنِ , ثُمَّ قَالَ : \" يَا أَهْلَ مَكَّةَ , إِنَّا قَوْمٌ سَفْرٌ , فَأَتِمُّوا الصَّلاةَ ""","","","","","Book of Prayer"
"4227","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : دَخَلَ ابْنُ عُمَرَ عَلَى رَجُلٍ مِنْ أَهْلِ مَكَّةَ يَعُودُهُ , فَحَضَرَتِ الصَّلاةُ , فَصَلَّى بِهِمُ ابْنُ عُمَرَ رَكْعَتَيْنِ , ثُمَّ الْتَفَتَ إِلَيْهِمْ , فَقَالَ : أَتِمُّوا ""","","","","","Book of Prayer"
"4228","عَنْ مَالِكٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ صَفْوَانَ بْنِ عَبْدِ اللَّهِ , قَالَ : \" جَاءَ عَبْدُ اللَّهِ بْنُ عُمَرَ يَعُودُ عَبْدَ اللَّهِ بْنَ صَفْوَانَ , فَصَلَّى لَنَا رَكْعَتَيْنِ ثُمَّ انْصَرَفَ , فَقُمْنَا فَأَتْمَمْنَا ""","","","","","Book of Prayer"
"4229","عَنِ الثَّوْرِيِّ فِي مُسَافِرٍ صَلَّى هَاتَيْنِ فَأَحْدَثَ , فَقَدَّمَ مُسَافِرًا فَصَلَّى بِهِمْ أَرْبَعًا , قَالَ : \" يُعِيدُونَ ""","","","","","Book of Prayer"
"4230","عَنِ الثَّوْرِيِّ فِي مُسَافِرٍ أَمَّ قَوْمًا مُقِيمِينَ فَصَلَّى بِهِمْ أَرْبَعًا , قَالَ : \" لا يُجْزِيهِمْ يَسْتَقْبِلُونَ , وَقَدْ قَصَرَ هُوَ صَلاتَهُ ""","","","","","Book of Prayer"
"4231","عَنِ الثَّوْرِيِّ , عَنْ أَشْعَثَ , عَنِ الْحَسَنِ فِي مُسَافِرٍ يَسْهُو فَيُصَلِّي الظُّهْرَ أَرْبَعًا , قَالَ : \" يَسْجُدُ سَجْدَتَيِ السَّهْوِ ""","","","","","Book of Prayer"
"4232","عَنِ الثَّوْرِيِّ , قال : \" إِذَا أَمَّ مُسَافِرٌ مُقِيمِينَ فَصَلَّى بِهِمْ رَكْعَةً , ثُمَّ أَحْدَثَ , فَقَدَّمَ رَجُلا فَاتَتْهُ رَكْعَةٌ , فَكَانَ يَنْبَغِي لَهُ أَنْ لا يُقَدِّمَ إِلا مَنْ أَدْرَكَ فَقَدَّمَ هَذَا , فَإِنَّهُ يُصَلِّي بِهِمْ بَقِيَّةَ صَلاتِهِ , ثُمَّ نَكَصَ فَقَدَّمَ رَجُلا مِمَّنْ أَدْرَكَ الصَّلاةَ كُلَّهَا , فَيُسَلِّمُ ثُمَّ يَقُومُ هُوَ فَيَقْضِي مَا فَاتَهُ ""","","","","","Book of Prayer"
"4233","عَنِ الثَّوْرِيِّ , قال : إِذَا صَلَّى مُسَافِرٌ بِمُقِيمِينَ رَكْعَةً , وَخَلْفُهُ مُسَافِرٌ وَمُقِيمُونَ , فَقَدَّمَ مُسَافِرًا , فَبَدَا لِلْمُسَافِرِ أَنْ يُقِيمَ , فَلْيُصَلِّ بِهِمْ بَقِيَّةَ صَلاةِ الْمُسَافِرِ , ثُمَّ يَتَأَخَّرْ فَيُقَدِّمْ رَجُلا مِنَ الْمُسَافِرِينَ فَيُسَلِّمُ بِهِمْ , ثُمَّ يَقُومُ هُوَ وَالْمُقِيمُونَ فَيُتِمُّوا بَقِيَّةَ صَلاتِهِمْ بِغَيْرِ إِمَامٍ ""","","","","","Book of Prayer"
"4234","عَنِ الثَّوْرِيِّ فِي رَجُلٍ مَكِّيٍّ يُرِيدُ الْكُوفَةَ فَسَارَ حَتَّى بَلَغَ يَبْرِينَ الْمُرْتَفِعَ أَوْ نَحْوَهَا , ثُمَّ بَدَتْ لَهُ حَاجَةٌ فَرَجَعَ , قَالَ : \" يُتِمُّ الصَّلاةَ ؛ لأَنَّهُ لَمْ يَبْلُغْ سَفَرًا يَقْصُرُ فِيهِ الصَّلاةَ ""","","","","","Book of Prayer"
"4235","عَنِ الثَّوْرِيِّ , قال : \" إِذَا كُنْتَ فِي سَفَرٍ فَصَلَّيْتَ لَكَ رَكْعَةً , ثُمَّ بَدَا لَكَ أَنْ تُقِيمَ بِذَلِكَ الْبَلَدِ فَأَتِمَّ صَلاتَكَ , فَإِنْ بَدَا لَكَ أَنْ تَخْرُجَ بَعْدَمَا نَوَيْتَ الإِقَامَةَ , فَعَلَيْكَ أَنْ تُتِمَّ حَتَّى تَخْرُجَ مِنْ ذَلِكَ الْمِصْرِ ""","","","","","Book of Prayer"
