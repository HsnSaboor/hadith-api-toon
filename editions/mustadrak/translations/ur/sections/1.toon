"1235","%أذعشحأىؼوتىأثىأثطۏشأشعۏأتههۄأؼىۄأڬۄحەأۄۏڽأ=أ+أتۏڬأوشحثۄأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأثۏتىأىۄۏڽأڬۏتأۗ%أ",""
"1236","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأضًشدأڬًأڲشۄىأهڲتأحًأشضًهأتههۄأ﷽أىەأثۄحأهوثتأمۏتوأڬۏتأ؏أحوتوأهًڲأثہۏأضتحہأمۏتوأڬشأشۄەأحہەأ؏أځہشأإځأ﷽أىەأشڬًؼأڬۏتأ؏أځہشأڬہڔەأۄًةەأ؏أځہشأشڬًؼأڬۏتأ؏أځہشأڬہڔەأۄًةەأ؏أځہشأشڬًؼأڬۏتأ؏أتضأغشذأإځأ﷽أىەأزًأشڬؼحۏڽأځڔہۏڽأتًشأۄشأشڬؼحأوۏڽأحۏىأشڬًؼأڬۏەأ؏أځہشأحۏضشۏأوشحثۄأشڬًؼأڬۏتأ؏أځہشأضدزۄأڬۏتأ؏أتضأزىأدًأهًڲأإځأ﷽أڬەأضتحہأىوتصأځڔہأشۄەأحہەأ؏أتىأوۏڽأضەأڬةۏأهًڲًڽأځشأؽطۏأغتشۏأۄًأڲةۏأتًشأتىأځشأڋًهأثہشأثہشأڬشأځتىۏأثۄتۏتأڲۏتأ؏أدثأإځأ﷽أشڬًؼأڬشحەأحًأ““أتههۄأتڬثشأ‛‛أڬۄحەأتًشأدثأشڬًؼأضەأتټہحەأحًأ““أضوؼأتههۄأهوىأذوزۄأ‛‛أڬۄحەأۗأ+أإځأ﷽أىەأوضهضهأىوتصأدتشۏأشڬہۏأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأ؏أتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأۏۄۏأذزۏخأوؼتسأثىأۄطتوأځہشأتىأڬەأًتهزأځہشأمحتزۄأځہشأؼغتؤأتًشأځہشأؼثۏزۄأثىأؼوۏشأضەأشًتۏحأڬۏأۄەأۗأحتۄوأتضأڬەأتهلتػأڬډہأورحهلأۄۏڽأۗ%أ",""
"1237","%أذعشحأتثۏأثىأڬؼثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأضًشدأڲشۄىأۄًتأحًأىثۏأتڬشوأ﷽أىەأهًڲًڽأڬًأىوتصأڬضًلأځڔہتةۏأتًشأغًتهأوۏڽأضەأتۏڬأضًشۆأځڔہۏأتًشأځتىډأوشحثۄأشڬًؼأڬۏتأتًشأزًأضدزەأڬۏەأځہشأزًضشۏأشڬؼحأوۏڽأڬہڔەأۄًةەأتًشأغًتهأوۏڽأضەأتۏڬأضًشۆأځڔہۏأځہشأځىتډأوشحثۄأشڬًؼأڬۏتأتًشأزًأضدزەأڬۏەأځہشأمثهۄأشًأۄًأڬشأثۏټہەأزؼتأوتىڲحەأشۄەأۏۄتڽأحڬأڬۄأڲشۄىأرحوأۄًأڲۏتأۗۗۗۗۗۗ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتثًدؼلشأشتصۏأڬۏأشًتۏتحأىمهأىۄۏڽأڬۏڽأذتهتىڬۄأحوتوأتةوۄأتىأڬەأثتشەأوۏڽأتډہەأرۏتهتحأشڬہحەأۄۏڽأۗأتًشأتضأذزۏخأوۏڽأڬډہأوصۏزأتهلتػأثہۏأۄۏڽأۗأتًشأتضڬەأحوتوأشتًۏأظتزمأۄۏڽأۗ%أ",""
"1238","%أذعشحأمثۏظۄأۄهتهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأضًشدأڲشۄىأۄًتأ؏أإځأڲہثشتةەأۄًةەأ؏أتځىۏأډتزشأڬًأڲہضۏټحەأۄًةەأثتۄشأحطشۏلأهتةەأ؏أوۏڽأتضأزىأوزۏىۄأوۏڽأإځأڬەأۄوشتۄأحہتأ؏أإځأ﷽أىەأزًأشڬؼحۏڽأځڔہتةۏڽأ؏أتىأوۏڽأثۄحأهوثتأمۏتوأڬۏتأځہشأدثأإځأ﷽أىوتصأضەألتشؽأۄًةەأتًشأڲشۄىأرحوأۄًأڲۏتأحًأإځأ﷽أىەألشوتۏتأ=أۏۄأتههۄأحؼتهۏٳأڬۏأىطتىۏتڽأۄۏڽأتىأڬەأسشۏؼەأتههۄأحؼتهۏٳأرًلأزهتحتأۄەأۗأدثأحوأتىأڬًأزۏڬہًأحًأتضأغشذأىوتصأځڔہًأدۏضەأحوأىەأتثہۏأتثہۏألشعأىوتصأځڔہۏأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأتًشأدۄتڽأحڬأوۏشتأرۏتهأۄەأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأشۏذتىأثىأضؼۏزأڬۏأتضأذزۏخأڬۏأًدۄأضەأوؼههأمشتشأزۏتأۄەأۗأدضأڬۏأضىزأؼثتزأثىأوىظًشأځہشأتۏًثأځہشأتثًمهتثۄأځہشأۄهتهأثىأؼتوشأضەأۄًحۏأۄًةۏأمثۏظۄأحڬأځۄىډحۏأۄەأتًشأًۄأذزۏخأدضأڬًأوًضۏٳأثىأتضوتؼۏهأىەأًۄۏثأضەأشًتۏحأڬۏتأۄەأتضأڬًأشۏذتىأتًشأؼثتزأڬۏأذزۏخأوؼههأىۄۏڽأڬشحۏأۗ%أ",""
"1239","%أتوأتهوًوىۏىأذعشحأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأضًشدأڲشۄىأۄًتأحًأشضًهأتههۄأ﷽أىڬهەأتًشأهًڲًڽأڬًأىوتصأڬضًلأځڔہتةۏأوۏڽأىەأإځأؼهۏۄأتهضهتوأڬۏأمشتؤحأڬتأتىزتصۄأهڲتۏتأ؏أوۏشتأرۏتهأۄەأڬۄأإځأ﷽أىەأضًشۆأثمشۄأځڔہۏأځہشأإځأ﷽أىەأزًأضدزەأڬۏەأځہشأزًضشۏأشڬؼحأوۏڽأثہۏأإځأ﷽أىەأهوثۏأمشتؤحأڬۏأ؏أوۏشەأتىزتصەأڬەأوغتثمأإځأ﷽أىەأ+أتضأشڬؼحأوۏڽأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1240","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەأىوتصأڬضًلأوۏڽأثهىزأإًتصأضەأهوثۏأمشتؤحأڬۏأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1241","%أذعشحأؼثزتههۄأثىأىعشأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأڬۄأتىضأثىأوتهڬأڬەأصوتىەأوۏڽأتىزہۏشتأډہتأڲۏتأحًأوۏڽأتىضأثىأوتهڬأڬەأځتضأإۏتأتًشأتىأضەأځًډہتأ=أتەأتثًذوصۄأ$أڬۏتأشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأحوۄۏڽأڬثہۏأتۏضتأًتمؼۄأځۏطأإۏتأآأحًأ+أتىضأىەأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأتًشأۏۄأؼثۏزتههۄأىعشأثىأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬەأثۏټەأۄۏڽأۗأتًشأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأىعشأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأۗ%أ",""
"1242","%أذعشحأضوشۄأثىأدىزثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأۄوۏڽأىوتصأڬضًلأځڔہتةۏأتًشأۄوۏڽأإځأ﷽أڬۏأ+أمشتؤحأڬۏأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1243","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأصوتىەأوۏڽأضًشدأڲشۄىأۄًتأحًأإځأ﷽أىەألشوتۏتأ=أضًشدأتًشأډتىزأتههۄأڬۏأىطتىۏتڽأۄۏڽأ؏أتىأڬًأڬضۏأطرظأڬۏأوًحأڬۏأًدۄأضەأڲشۄىأىۄۏڽأهڲحتأ؏أدثأحوأڲشۄىأزۏڬہًأحًأظزمۄأڬشًأ؏أىوتصأځڔہًأ؏أحڬثۏشأځڔہًأتًشأتههۄأضەأزؼتةۏڽأڬشًأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1244","%أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأډتىزأتًشأضًشدأڲشۄىأڬەأوًمؼأځشأحوۄتشۏأتضأىوتصأدۏضۏأزًأشڬؼحۏڽأځڔہتةۏأۗ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأذزۏخأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1245","%أذعشحأخؼهثۄأثىأصۄزوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأضؼۏزأثىأؼتظأڬەأۄوشتۄأغثشضحتىأوۏڽأحہەأ؏أتىۄًڽأىەألشوتۏتأ=أحوأوۏڽأضەأڬضأطرظأىەأشضًهأتههۄأ﷽أڬەأۄوشتۄأظهًۆأتهرًلأځڔہۏأۄەأآأحًأذعشحأذسۏلۄأشعۏأتههۄأؼىۄأڬہڔەأۄًأڲةەأۗأهًڲًڽأىەأتۏڬأظلأتىأڬەأځۏډہەأثىتةۏأتًشأتۏڬأظلأزطوىأڬەأومتثهەأوۏڽأڬہڔۏأشۄۏأ؏أتىۄًڽأىەأتځىەأځۏډہەأڬہڔەأۄًاڽأڬًأتۏڬأشڬؼحأځڔہتةۏأ؏أځہشأۏۄأىوتصأډہًڔأڬشأتىأڬۏأدۄأځشأدتأڬشأڬہڔەأۄًأڲةەأتًشأًۄأتىأڬەأځۏډہەأإأڲةەأ؏أإځأىەأتىأڬًأثہۏأتۏڬأشڬؼحأځڔہتةۏأتًشأڬضۏأىەأثہۏأ+أتوتوأڬەأځۏډہەأځًشۏأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأتضأغشذأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1247","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأسۏأمشزأوۏڽأ+أتضأغشۏمەأضەأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1248","%أذعشحأضهوۄأثىأتڬًؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتىۄًڽأىەأشضًهأتههۄأ﷽أضەأۏۄًزۏًڽأڬەأؼثتزحأرتىەأوۏڽأىوتصأځڔہىەأڬەأوحؼهمأځًډہتأحًأإځأ﷽أىەألشوتۏتأ=أًۄتڽأىوتصأځڔہأهًأتًشأدًأ+أثحأًؽۏشۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأ؏أتڲشأوذوزأثىأتثشتۄۏوأحۏوۏأىەأضهوۄأثىأتڬًؼأڬتأۏۄأثۏتىأضىأشڬہتأۄەأڬۄأتىۄًڽأىەأشضًهأتههۄأ﷽أضەأۏۄًزۏًڽأڬەأؼثتزحأرتىەأوۏڽأىوتصأځڔہىەأڬەأوحؼهمأځًډہتأحًأإځأ﷽أىەألشوتۏتأ=أًۄتڽأىوتصأځڔہأهًأتًشأضتوىەأدًأثحأًؽۏشۄأۄًأ؏أتضأڬًأڲشتأزًأتضأذزۏخأڬًأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1249","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬۏأىوتصأرًلأڬەأوحؼهمأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أڬہڔەأۄًةەأحًأتۏڬأدوتؼحأإځأڬەأځۏډہەأڬہڔۏأۄًةۏأۗأتًشأتۏڬأدوتؼحأتىأڬەأځۏډہەأثۏټہأڲةۏأ؏أتىأضثأڬەأډۄشەأشضًهأتههۄأ﷽أڬۏأغشلأحہەأ؏أشضًهأتههۄأ﷽أىەأحڬثۏشأڬۄۏأ=أحًأزًىًأدوتؼحًڽأىەأحڬثۏشأڬۄۏأۗأځہشأإځأ﷽أىەأشڬًؼأڬۏتأحًأدًأدوتؼحأإځأ﷽أڬەأځۏډہەأحہۏأ؏أتىۄًڽأىەأشڬًؼأڬشأهۏتأتًشأدًأتىأڬەأثہۏأځۏډہەأحہەأ؏أًۄأثۏټہەأشۄەأ؏أځہشأشضًهأتههۄأ﷽أىەأضدزۄأڬۏتأحًأإځأ﷽أڬەأځۏډہەأًتهًڽأىەأثہۏأضدزۄأڬۏتأۗأتًشأتىأڬەأځۏډہەأًتهەأثۏټہەأشۄەأځہشأإځأ﷽أڬہڔەأۄًةەأتًشأإځأ﷽أڬەأځۏډہەأًتهەأثہۏأڬہڔەأۄًأڲةەأۗأځہشأۏۄأهًڲأځۏډہەأڬہضڬحەأۄًةەأتىأهًڲًڽأڬۏأظلأحڬأډهەأڲةەأدًأثۏټہەأۄًةەأحہەأتًشأًۄأزًضشۏأدوتؼحأ+أدًأځۄهەأثۏټہۏأشۄۏأتىۄًڽأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأ؏أتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأذزۏخأڬەأحوتوأشتًۏًڽأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأضًتةەأطشذثۏهأڬەأ؏أذتهتىڬۄأۏۄأوزىۏأ؏أحتثؼۏأؽۏشأوحۄوأۄۏڽأۗ%أ",""
"1250","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأظهًۆأتهرًلأځڔہتةۏأ؏أإځألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأظذتثۄأشعۏأتههۄأؼىۄوأڬًأزًأذظًڽأوۏڽأحمضۏوأڬشأزۏتأ؏أتىأوۏڽأضەأتۏڬأدوتؼحأإځأ﷽أڬەأځۏډہەأڬہڔۏأۄًأڲةۏأتًشأزًضشۏأزطوىأڬەأإڲەأڬہڔۏأۄًأڲةۏأ؏أتوأتهوًوىۏىأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأحڬثۏشأڬۄۏأحًأإځأ﷽أڬەأۄوشتۄأتضأدوتؼحأىەأثہۏأحڬثۏشأڬۄۏأدًأإځأ﷽أڬەأځۏډہەأظلأثضحۄأحہەأځہشأإځأ﷽أىەأشڬًؼأڬۏتأ؏أتىۄًڽأىەأثہۏأشڬًؼأڬۏتأځہشأإځأ﷽أىەأضدزۄأڬۏتأ؏أتىۄًڽأىەأثہۏأضدزۄأڬۏتأځہشأإځأ﷽أىەأضشأتټہتۏتأتىۄًڽأىەأثہۏأضحأتټہتأهۏتأځہشأشضًهأتههۄأ﷽أثۏټہأڲةەأتًشأتىۄًڽأىەأزًضشتأضدزۄأرًزأۄۏأڬۏتأځہشأًۄأهًڲأڬہڔەأۄًةەأتًشأتځىۏأتۏڔۏًڽأڬەأثهأتهټەأځتاڽأډهحەأۄًةەأځۏډہەأهًټأڲةەأ؏أۏۄتڽأحڬأڬۄأۏۄأهًڲأزًضشەأظذتثۄأشعۏأتههۄأؼىۄوأضەأځۏډہەأدتأڬشأڬہڔەأۄًأڲةەأ؏أځہشأزًضشۏأدوتؼحأإةۏأتًشأتىۄًڽأىەأشضًهأتههۄأ﷽أڬەأځۏډہەأظلأثىتةۏأځہشأتىۄًڽأىەأحڬثۏشأڬۄۏأځہشأرًزأۄۏأضدزۄأڬۏتأ؏أځہشأشضًهأتههۄأ﷽أىەأزًضشتأضدزۄأڬۏتأ؏أحًأتىۄًڽأىەأثہۏأإځأڬەأۄوشتۄأضدزۄأڬۏتأ؏أځہشأشضًهأتههۄأ﷽أ+أتڲهۏأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأتًشأىوتصأرًلأڬەأذًتهەأضەأۏۄأذزۏخأضثأضەأدتوؼأۄەأۗ%أ",""
"1251","%أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬًأىوتصأرًلأڬەأغًشأځشأوؽشثأڬۏأىوتصأڬۏأحۏىأشڬؼحۏڽأځڔہتةۏڽأ؏أۏۄأهًڲأىوتصأضەألتشؽأۄًةەأ+أتًشأډهەأڲةەأ"
"أٰٰأ+أتوتوأذتڬوأڬۄحەأۄۏڽأ","أوۏڽأىەأتثًؼهۏأتهذتلػأڬًأۏۄألشوتحەأۄًةەأضىتأۄەأڬۄأۏۄأذزۏخأؽشۏثأۄەأۗأتطؼخأتهذوشتىۏأىەأتضأذزۏخأڬًأتضۏأتضىتزأڬەأۄوشتۄأىمهأڬۏتأۄەأ؏أتوتوأذتڬوأڬۄحەأۄۏڽأ=أۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗ%أ"
"1252","%أذعشحأتثًؼۏتطأتهصشمۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأؼضلتىأوۏڽأحہەأتًشأوطشڬًڽأڬەأضځۄأضتهتشأرتهزأثىأًهۏزأحہەأ؏أۄوأىەأىوتصأػۄشأتزتأڬۏأ؏أوطشڬًڽأىەأځشًڲشتوأثىتۏتأڬۄأۄوتشەأځتضأثۄحأتډہتأوًمؼأۄەأڬۄأوضهوتىأىوتصأوۏڽأ+أدىڲأڬۏأغشلأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1253","%أوشًتىأثىأذڬوأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأ؏أتىۄًڽأىەأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأځًډہتأ=أإځأىەأ+أڬثہۏأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1254","%أذعشحأتوألعهأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أتأڬەأۄتڽأحطشۏلأهتةەأحًأإځأڬەأډډتأذعشحأؼثتضأشعۏأتههۄأؼىۄأثۄحأطزۏزأثۏوتشأحہەأ؏أذعشحأؼثتضأشعۏأتههۄأؼىۄأىەأوًحأڬۏأحوىتأڬۏأۗأحًأشضًهأتههۄأ﷽أىەأتىأضەألشوتۏتأ=أتەأډډتأ$أوًحأڬۏأحوىتأوحأڬشًأ؏أڬۏًىڬۄأتڲشأحوأىۏڬأۄًأحًأوًحأدحىۏأزۏشأضەأإةەأڲۏأ؏أإځأڬۏأىۏڬۏًڽأځشأىۏڬۏتڽأثڔہحۏأدتةۏڽأڲۏأتًشأۏۄأإځأڬەأهۏەأثۄحأثۄحشأۄەأۗأتًشأتڲشأحوأڲىۄڲتشأۄًأحًأوًحأدحىۏأزۏشأضەأإةەأڲۏأ؏أحوۄۏڽأڲىتۄًڽأڬۏأوؼتلۏأوتىڲىەأڬتأتحىتأۄۏأصۏتزۄأوًمؼأوهأدتةەأڲتأ؏أتضأهۏەأوًحأڬۏأحوىتأوحأڬشًأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأ؏أدثڬۄأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأىەأمۏضأڬەأذًتهەأضەأرثتثأڬتأۏۄأثۏتىأىمهأڬۏتأۄەأ““أتڲشأشضًهأتههۄأ﷽أىەأوًحأڬۏأحوىتأڬشىەأضەأوىؼأىۄأڬۏتأۄًحتأحًأوۏڽأوًحأڬۏأحوىتأڬشحتأۗ‛‛%أ",""
"1255","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأرثثشأزًڽأڬۄأحوأوۏڽأضثأضەأثۄحشۏىأطرظأڬًىأۄەأآأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏتأ=أدۏأۄتڽأۏتأشضًهأتههۄأ﷽أ$أإځأ﷽أىەألشوتۏتأ=أحوأوۏڽأضەأثۄحشۏىأطرظأًۄأۄەأدضأڬۏأؼوشأهوثۏأۄًأتًشأتضأڬەأتؼوتهأتډہەأۄًڽأۗ"
"أٰٰأۏۄأذزۏأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأوسڬًشۄأذزۏخأڬۏأتۏڬأطتۄزأذزۏخأثہۏأوًدًزأۄەأدًأڬۄأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗأ+أطتۄزأذزۏخأزشدأسۏهأۄەأ","%أ"
"1256","أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأتۏڬأطرظأىەأځًډہتأ=أۏتأشضًهأتههۄأ﷽أهًڲًڽأوۏڽأضەأضثأضەأثۄحشأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=““أدضأڬۏأؼوشأغًۏهأۄًأتًشأؼوهأىۏڬأۄًڽأۗ‛‛أتضأىەأځًډہتأ=أضثثأضەأثشتأطرظأڬًىأۄەأآأإځأ﷽أىەألشوتۏتأ=أدضأڬۏأؼوشأهوثۏأۄًأتًشأتؼوتهأثشەأۄًڽأۗأ"
"1257","%أذعشحأتىضأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدثأتههۄأحؼتهۏٳأڬضۏأثىزەأڬەأضتحہأثہهتةۏأڬتأتشتزۄألشوتحتأۄەأحًأتضأضەأؼوهأڬشًتحتأۄەأ؏أإځأ﷽أضەأځًډہتأڲۏتأ=أتههۄأحؼتهۏٳأتضأضەأڬۏضەأؼوهأڬشًتحتأۄەأآأإځأ﷽أىەألشوتۏتأ=أتههۄأحؼتهۏٳأتضأثىزەأڬًأوًحأضەأځۄهەأىۏڬأؼوهأڬۏأحًلۏمأؼغتألشوتأزۏحتأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأتضىتزأظذۏذأڬەأۄوشتۄأڲصطحۄأذزۏخأڬۏأتۏڬأطتۄزأذزۏخأثہۏأوًدًزأۄەأۗأ+أدًأڬۄأزشدأسۏهأۄەأ","%أ"
"1258","أذعشحأؼوشأثىأذومأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدثأتههۄأتځىەأڬضۏأثىزەأضەأوذثحأڬشحتأۄەأحًأتضأڬًأطۄزأڬہهتحتأۄەأۗأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏأ=أڬۏضەأطۄزأڬہهتحتأۄەأآأإځأ﷽أىەألشوتۏتأ=أتضأڬۏأوًحأضەأځۄهەأتضأڬًأىۏڬأؼوهأڬۏأحًلۏمأزۏحتأۄەأذحۏأڬۄأتضأڬەأځڔًضۏأتضأضەأرًطأۄًأدتحەأۄۏڽأۗأۏتأ+أطتۏزألشوتۏتأ"
"1259","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أۄشأثىزەأڬًأتضۏأذتهحأځشأتټہتۏتأدتةەأڲتأدضأذتهحأځشأًۄأوشەأڲتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأ؏أهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1260","%أذعشحأتثًضهوۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أدثأذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأڬۏأًلتحأڬتأًمحأمشۏثأإۏتأحًأتىۄًڽأىەأىةەأڬځڔەأوىڲًتأڬشأځۄىەأ؏أځہشألشوتۏتأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأۏۄألشوتحەأضىتأۄەأڬۄأوۏحأڬًأتىۄۏأڬځڔًڽأوۏڽأتټہتۏتأدتةەأڲتأدىأوۏڽأًۄأوشەأڲتأۗ"
"أٰٰۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ",""
"أذعشحألعتهۄأثىأؼثۏزأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدًأطرظأتىأوشتحثأوۏڽأضەأڬضۏأوشحثەأځشأوشەأڲتأ؏أمۏتوحأڬەأزىأتضۏأځشأتټہتۏتأدتةەأڲتأۗ",""
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأىەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗ%أ",""
"1261","%ذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأتۏڬأزًأوشحثۄأىۄۏڽأ+أثهڬۄأڬةۏأوشحثۄأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗ%أ",""
"1262","%أذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أؼثزتههۄأثىأتثۏأڬۏأوشعأتهوًحأوۏڽأؼۏتزحأڬشىەأحطشۏلأهەأڲةەأ؏أدثأإځأ﷽أتضأڬەأځتضأځۄىډەأحًأتضأوۏڽأوًحأڬەأإختشأځۄډتىأهۏەأ؏أإځأ﷽أىەألشوتۏتأ=أوۏڽأحدہەأۏۄًزۏًڽأڬۏأوذثحأضەأوىؼأڬۏتأڬشحتأحہتأۗأإځأ﷽أىەأ+أوصۏزأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1263","%أذعشحأدتثشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أوۏشۏأؼۏتزحأڬەأهۏەأىۄأحًأرډشأځشأضًتشأۄًأڬشأحطشۏلأهتحەأتًشأىۄأڲہًڔەأځشأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1264","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأطتوأڬەأًمحأڬضۏأوشۏعأڬۏأؼۏتزحأڬەأهۏەأدتحتأۄەأ؏أتضأڬەأضتحہأضحشأۄصتشألشطحەأزؼتةەأوؽلشحأڬشحەأۄًةەأىڬهحەأۄۏڽأتًشأظثذأحڬأزؼتأڬشحەأشۄحەأۄۏڽأتًشأتضأطرظأڬەأهۏەأدىحأوۏڽأتۏڬأثتؽأۄەأدًأطرظأظثذأڬەأًمحأڬضۏأوشۏعأڬۏأؼۏتزحأڬەأهۏەأىڬهەأتضأڬەأضتحہأضحشأۄصتشألشطحەأىڬهحەأۄۏڽأدًأڬۄأطتوأحڬأتضأڬەأهۏەأوؽلشحأڬۏأزؼتأڬشحەأشۄحەأۄۏڽأتًشأتضأڬەأهۏەأدىحأوۏڽأتۏڬأثتؽأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەوغتثمأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأىەأتضەأىمهأىۄۏڽأڬۏتأڬۏًىڬۄأشتًۏًڽأڬۏأتۏڬأدوتؼحأۄەأدىۄًڽأىەأتضأذزۏخأڬًأذڬوأثىأؼحۏثۄأتًشأوىظًشأثىأتهوؼحوشأضەأتثىأتثۏأهۏهۏأڬەأًتضغەأضەأذعشحأؼهۏأشعۏأتههۄأؼىۄأحڬأوًمًلأشڬہتأۄەأدضأڬًأطؼثۄأىەأشًتۏحأڬۏتأۄەأتًشأوۏڽأشتًۏأڬۏأصۏتزحۏأڬەأضهضهەأوۏڽأتځىۏأتظهأځشأمتةوأۄًڽأۗ%أ",""
"1265","%أذعشحأصۏزأثىأتشموأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشۏأإىڬہًڽأوۏڽأزشزأحہتأدضأڬۏأًدۄأضەأشضًهأتههۄأ﷽أوۏشۏأؼۏتزحأڬۏهةەأحطشۏلأهتةەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأضەأوشًۏأزشدأسۏهأذزۏخأ؏أوسڬًشۄأذزۏخأڬۏأطتۄزأۄەأۗ%أ",""
"1266","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأصۏزأثىأتشموأڬۏأإطًثأډطوأڬۏأًدۄأضەأؼۏتزحأڬۏأۗأ"
"1267","%أذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأثىحأضؼزأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحۏأۄۏڽأڬۄأوۏڽأوڬۄأوۏڽأثۏوتشأځڔأڲۏتأحًأشضًهأتههۄأ﷽أوۏشۏأؼۏتزحأڬۏهةەأحطشۏلأهتةەأ؏أإځأ﷽أىەأتځىتأۄتحہأوۏشۏأځۏطتىۏأځۄأشڬہتأ؏أځہشأوۏشەأضۏىەأتًشأځۏټأڬًأوهتأځہشأۏًڽأزؼتأوتىڲۏأ““أۏتأتههۄأضؼزأڬًأطلتؤأزەأتًشأتضأڬۏأۄدشحأڬًأځًشتأڬشأزەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1268","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أڬىەألشوتۏتأ=أدًأطرظأڬضۏأڬۏأؼۏتزحأڬًأدتةەأتًشأتضأڬەأځتضأضتحأوشحثۄأۏۄأزؼتأوتىڲەأ=““أ®ئّضٕئّهْأتههّٔيّأتهٕؼّػٍٓوّأشّثّٔأتهٕؼّشٕطٓأتهٕؼّػٍٓوٓأئّىٕأٍّطٕلٍّٓنّ¾أ‛‛أ+أوۏڽأؼشطأؼػۏوأڬەأوتهڬأتههۄأؼػۏوأضەأضًتهأڬشحتأۄًڽأڬۄأًۄأحدہەأطلتؤأؼغتألشوتةەأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1269","%أتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدًأطرظأڬضۏأوضهوتىأثہتةۏأڬۏأؼۏتزحأڬًأدتةەأتًشأتضأڬەأضشأڬەأځتضأثۏټہأڬشأضتحأوشحثۄأۏۄأزؼتأوتىڲەأ““أ®ئّضٕئّهْأتههّٔيّأتهٕؼّػٍٓوّأشّثّٔأتهٕؼّشٕطٓأتهٕؼّػٍٓوٓأئّىٕأٍّطٕلٍّٓنّ¾أ‛‛أ+أوۏڽأؼشطأؼػۏوأڬەأوتهڬأتههۄأؼػۏوأضەأضًتهأڬشحتأۄًڽأڬۄأًۄأحدہەأطلتؤأؼغتألشوتةەأ"
"أۏۄأذزۏخأطتۄزأۄەأ؏أظذۏذأۄەأتًشأوظشۏًڽأڬۏأوزىۏًڽأضەأشًتۏحأڬەأوؼتوهەأوۏڽأؽشۏثأۄەأۗأۄوأضىزأؼتهۏأتىۄۏأڬەأذًتهەأضەأهڬہحەأۄۏڽأۗأۏۄأذزۏخأوىۄتهأثىأؼوشًأضەأشًتۏحأڬشىەأوۏڽأذدتدأثىأتشغتۆأىەأخمۄأشتًۏًڽأڬۏأورتهلحأڬۏأۄەأ+أدۏضتأڬۄأزشدأسۏهأذزۏخأوۏڽأۄەأ","%أ"
"1270","%أذدتدأثىأتشغتۆأىەأوىۄتهأثىأؼوشًأڬەأثؼزأؼثزتههۄأثىأتهذتشخأڬەأًتضغەأضەأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬۏأۏۄأشًتۏحأىمهأڬۏأۄەأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أدًأطرظأتځىەأڬضۏأوضهوتىأثہتةۏأڬۏأؼۏتزحأڬًأدتةەأتًشأضشأڬەأځتضأثۏټہأڬشأضتحأوشحثۄأۏۄأزؼتأوتىڲەأ=أ®ئّضٕئّهْأتههّٔيّأتهٕؼّػٍٓوّأشّثّٔأتهٕؼّشٕطٓأتهٕؼّػٍٓوٓأئّىٕأٍّطٕلٍّٓألْهّتىَتأوٓىٕأوّشّعٓيٓ¾أ‛‛أوۏڽأؼشطأؼػۏوأڬەأوتهڬأتههۄأؼػۏوأضەأضًتهأڬشحتأۄًڽأڬۄأًۄأحدہەأطلتؤأؼغتألشوتةەأۗأتڲشأتضأڬۏأوًحأڬتأًمحأىۄأإأڲۏتأۄًأحًأتضەأطلتؤأزەزأۏأدتةەأڲۏأۗ"
"أٰٰأتضأغشذأڬەأترحهتلأڬًأترحهتلأطوتشأىۄۏڽأڬۏتأدتأضڬحتأ؏أڬۏًىڬۄأذدتدأثىأتشغتۆأ؏أؼثزشثۄأثىأضؼۏزأتًشأتثًرتهزأزتهتىۏأضەأذلػأتًشأتحمتىأوۏڽأڬوأزشدۄأشڬہحەأۄۏڽأۗأتًشأتىأشًتۏتحأوۏڽأضەأتڲشأؼثزتههۄأثىأذتشخأڬۏأشًتۏحأختثحأۄًأحًأۏۄأضؼۏزأثىأدثۏشأڬۏأذزۏخأڬۏأطتۄزأمشتشأزۏأدتأضڬحۏأۄەأۗ%أ",""
"1271","%أذعشحأىتلؼأثىأدثۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أؼخوتىأثىأتثۏأتهؼتظأشعۏأتههۄأؼىۄأشضًهأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًةەأحًأتضأمزشأطزۏزأزشزأوۏڽأوثحهتأحہەأمشۏثأحہتأڬۄأتضأڬۏأًدۄأضەأتىأڬۏأوًحأًتمؼأۄًأدحۏأ؏أتىۄًڽأىەأشضًهأتههۄأ﷽أضەأتضأثتحأڬتأحسڬشۄأڬۏتأحًأتىأڬتأڲوتىأۄەأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتځىتأۄتحہأزشزأڬۏأدڲۄأځشأشڬہأڬشأضتحأوشحثۄأوهًأتًشأۄشأزلؼۄأوهحەأۄًةەأځڔہًأ““أ®ئّؼًْسْأثٓؼٓصّٔجٓأتههّٔيٓأًّمْزٕشّحٓيٓأوٓىٕأطّشٔٓأوّتأئّدٓزْ¾أ‛‛أوۏڽأتههۄأڬۏأؼصحأتًشأمزشحأڬۏأځىتۄأوتىڲحتأۄًڽأتضأډۏصأڬەأطشأضەأدًأوۏڽأځتحتأۄًڽأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأتىأتهلتػأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأ؏أتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأضهضهۄأوۏڽأدشۏشۏأڬۏأًۄأذزۏخأىمهأڬۏأۄەأدضأڬۏأضىزأۏصۏزأثىأؼثزتههۄأثىأطرۏشأڬەأًتضغەأؼخوتىأثىأتثۏأتهؼتظأحڬأځۄىډۏأۄەأحتۄوأتضأڬەأتهلتػأڬډہأورحهلأۄۏڽأۗ%أ",""
"1272","%أذعشحألعتهۄأثىأؼثۏزأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأتىأڬۏأتۏضەأزًأإزوۏًڽأضەأوهتمتحأۄًةۏأدًأځۏطتثأضەأطلتؤأڋہًىڋأشۄەأحہەأۗأ+أۏؼىۏأتىأڬًأځۏطتثأڬتأڬًةۏأؼتشعۄأهتذمأحہتأ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأىەأصۏتزأثىأوذوزأڬەأؼهتًۄأتضأذزۏخأڬەأحوتوأشتًۏًڽأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأتًشأ““أصۏتزأ‛‛أتۄهأوظشأڬەأطۏًرأوۏڽأضەأۄۏڽأ؏أتىأڬۏأشًتۏحأڬشزۄأتذتزۏخأڬۏأحؼزتزأثۄحأڬوأۄەأۗ%أ",""
"1273","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدثأڬًةۏأطرظأڬضۏأوشۏعأڬۏأؼۏتزحأڬًأدتةەأحًأۏًڽأزؼتأوتىڲەأ““أ®تههّٔيْؤّأتطٕلٓأؼّثٕزّنّأٍّىٕنّئْأهّنّأؼّزًَْٔتأئًّٕأٍّوٕطٍٓأهّنّأبٓهٌّأظّهّتجِ¾أ‛‛ۗ““أتەأتههۄأ$أتځىەأثىزەأڬًأطلتؤأؼغتألشوتأحتڬۄأۏۄأحۏشەأزطوىًڽأضەأهڔأضڬەأۏتأىوتصأڬەأهۏەأډهأڬشأدتأضڬەأۗ‛‛"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗ%أ",""
"1274","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أڬضۏأطرظأڬەأهۏەأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأتۏڬأومتوأهڬہتأۄًتأۄًحتأۄەأهۏڬىأًۄأتځىەأؼوهأڬەأضثثأتضأومتوأحڬأىۄۏڽأځۄىډحتأحًأتضأڬًأوضهضهأإصوتةطًڽأوۏڽأوثحهتأڬۏتأدتحتأۄەأذحۏأڬۄأًۄأتىأڬەأضثثأتضأومتوأڬًأځتأهۏحتأۄەأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1275","%أذعشحأتثۏأثىأڬؼثأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدثأإزوأؼهۏۄأتهضهتوأڬتأإرشۏأًمحأإۏتأحًأإځأؼهۏۄأتهضهتوأىەأتځىەأثۏټًڽأضەأڬۄتأ=أدتاأوۏشەأهۏەأدىحأڬەأڬډہأځہهأهەأڬشأإاأۗأإځأؼهۏۄأتهضهتوأڬەأثۏټەأ+أځہهأهۏىەأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأتًشأتضأذزۏخأڬتأحؼهمأتىأىًؼأڬەأضتحہأۄەأڬۄأدثأحتثؼۏأضەأشًتۏحأڬشىەأًتهتأظشلأتۏڬأطرظأۄًأ؏أڬۏًىڬۄأتضأڬۏأضىزأوۏڽأؼحۏأثىأعوشۄأتهضؼزۏأڬتأ““أذضىأ‛‛أڬەأؼهتًۄأتًشأڬًةۏأشتًۏأىۄۏڽأۄەأدثڬۄأوۏڽأۏۄأضودہحتأۄًڽأڬۄأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأذزۏخأڬًأتۏڬأزًضشۏأًدۄأضەأوؼههأمشتشأزۏتأۄەأتًشأًۄأًدۄأۏۄأۄەأڬۄأۏۄأذزۏخأذضىأڬەأًتضغەأضەأتىأڬەأًتهزأضەأشًتۏحأڬۏأڲةۏأۄەأۗأتضأوۏڽأ““أؼحۏأ‛‛أڬتأسڬشأىۄۏڽأۄەأۗ%أ",""
"1276","%أذعشحأتثۏأثىأڬؼثأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أإزوأؼهۏۄأتهضهتوأثۄحأهوثەأمزأًتهەأحہەأځہشأتضأڬەأثؼزأإځأىەأغًۏهأذزۏخأسڬشألشوتةۏأتًشأتضأڬەأإرشأوۏڽألشوتۏتأ=أوۏشەأتًشأوۏشەأشثأڬەألشطحًڽأڬەأثۏډأوۏڽأضەأۄټأدتاأڬۏًىڬۄأحًأىەأتضأڬًأوۏشەأتًځشأزترهأڬشأزۏتأۄەأۗأځہشأتىۄًڽأىەأإځأڬۏأشًذأڬًأمثعأڬۏتأ؏أإځأڬًأځتىۏأتًشأثۏشۏأڬەأځحًڽأڬەأضتحہأحۏىأوشحثۄأؽضهأزۏتأ؏أإځأڬًأڬلىأځۄىتۏتأ؏أىوتصأدىتصۄأځڔہۏأتًشأزلىتأزۏتأۗأځہشأثًهەأ$أحوۄتشەأثؼزأۏۄأحوۄتشەأىثۏأ﷽أڬۏأضىحأۄەأۗأ+أتضۏأځشأؼوهأڬشحەأشۄىتأ"
"أٰٰأۏۄأذزۏخأۏًىضأثىأؼثۏزأڬۏأذزۏخأڬًأوؼههأىۄۏڽأڬشحۏأڬۏًىڬۄأتۄهأوزۏىۄأتًشأتۄهأوظشأوۏڽأضەأذضىأڬۏأتذتزۏخأڬەأضثأضەأصۏتزۄأًتملأۏۄۏأحہەأۗأ+أًتههۄأتؼهوأ","%أ"
"1277","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتۏڬأوشۏعأڬۏأؼۏتزحألشوتةۏأۗأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأثہۏأإځأڬەأۄوشتۄأحہەأۗأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أرًطأۄًأدتاأ؏أڬۏًىڬۄأتههۄأحؼتهۏٳألشوتحتأۄەأ=أۏۄأوۏشۏأإڲأۄەأ؏أتضأڬًأوۏڽأتځىەأڬضۏأثىزەأځشأزىۏتأوۏڽأتضأهۏەأوضهغأڬشحتأۄًڽأحتڬۄأًۄأإرشحأوۏڽأإڲأضەأثډأدتةەأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1278","%أتوأتهوًوىۏىأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأتۏڬأزلؼۄأشضًهأتههۄأ﷽أڬًأطزۏزأزشزأتټہتأدضأڬۏأًدۄأضەأإځأ﷽أتځىەأثضحشأځشأهًټأځًټأۄًأشۄەأحہەأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أتۏضۏأحڬهۏلأتڲشأۄوأوۏڽأضەأڬضۏأڬًأۄًحۏأحًأإځأتضأڬًأثہۏأتضۏأذتهأځشأځتحەأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أثەأطڬأوًوىأځشأضرحۏأإحۏأۄەأتًشأڬضۏأثہۏأوًوىأڬًأڬًةۏأزشزأۏتأحڬهۏلأځۄىډەأحًأتههۄأحؼتهۏٳأتضأڬەأثزهەأوۏڽأتضأڬەأڲىتۄأوؼتلألشوتحتأۄەأتًشأتضأڬەأزشدتحأثهىزألشوتحتأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأًأتوتوأوضهوأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1279","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أتۏڬأتىظتشۏأرتحًىأڬۏأؼۏتزحأڬًأحطشۏلأهەأڲةەأۗأإځأ﷽أىەأتضأضەألشوتۏتأ=أڬۏتأتضأڬًأثرتشأۄەأآأتضأىەأڬۄتأ=أدۏأۄتڽأ$أًۄأثرتشأڬًأڲتهۏتڽأزۏىەأهڲۏأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أثرتشأڬًأڲتهۏتڽأوحأزًأ؏أڬۏًىڬۄأۏۄأثىزەأڬەأڲىتۄًڽأڬًأتۏضەأرحوأڬشأزۏحتأۄەأدۏضەأإڲأهًۄەأڬەأصىڲأڬًأرحوأڬشأزۏحۏأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتىأهلػًڽأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأ؏أتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأۏۄأذزۏخأذدتدأثىأتثۏأؼخوتىأڬەأًتضغەأتثًتهصثۏشأضەأىمهأڬۏأۄەأحتۄوأتضأڬەأتهلتػأورحهلأۄۏڽأۗ%أ",""
"1280","%أذعشحأدتثشأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأثرتشأذتعشأۄًتأتًشأ+أإىەأڬۏأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1281","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوًوىأتځىەأدتىأ؏أوتهأتًشأتًهتزأڬەأذًتهەأضەأوضهضهأإصوتةطأوۏڽأشۄحتأۄەأ؏أذحۏأڬۄأدثأًۄأتههۄأحؼتهۏٳأضەأوهحتأۄەأحًأتضأڬەأسوۄأڬًةۏأڲىتۄأىۄۏڽأۄًحتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأوسڬًشۄأذزۏخأڬۏأتۏڬأظذۏذأطتۄزأذزۏخأثہۏأوًدًزأۄەأۗأ+أدًأڬۄأزشدأسۏهأۄەأ","%أ"
"1282","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأشضًهأتههۄأ﷽أىەألشوتۏتأ=أوًوىأڬۏأثۏوتشۏأتضأڬەأهۏەأڲىتۄًڽأڬتأڬلتشۄأۄەأۗأ"
"1283","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتۏڬأزۏۄتحۏأضەألشوتۏتأ=أحدہەأڬثہۏأ““أتوأوهزوأ‛‛أىەأځڬڔتأۄەأآأتضأىەأځًډہتأ=““أتوأوهزوأ‛‛أڬۏتأۄًحۏأۄەأآأإځأ﷽أىەألشوتۏتأ=أدهزأتًشأڲًطحأڬەأزشوۏتىأ““أذشتشحأ‛‛أۄًحۏأۄەأۗأتضأىەأڬۄتأ=أوۏڽأىەأۏۄأڬثہۏأوذضًضأىۄۏڽأڬۏتأۗأإځأ﷽أىەأځًډہتأ=أحدہەأڬثہۏأظزتؼأىەأځڬڔتأۄەأآأتضأىەأځًډہتأ=““أظزتؼأ‛‛أڬۏتأۄًحتأۄەأآأإځأ﷽أىەألشوتۏتأ=أتۏڬأشڲأۄەأ؏أدًأتىضتىأڬەأضشأوۏڽأزشزأڬۏتأڬشحۏأۄەأۗأتضأىەأڬۄتأ=أوۏڽأىەأڬثہۏأثہۏأۏۄأوذضًضأىۄۏڽأڬۏتأۗأدثأًۄأځهټأڬشأڲۏتأحًأإځأ﷽أىەأتشطتزألشوتۏتأ=أدًأطرظأڬضۏأدۄىوۏأڬًأزۏڬہىتأډتۄحتأۄًأتضأڬًأزۏڬہأهەأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1427","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬتأتىحمتهأۄًأڲۏتأحًأتۄهأؼشثأوشحزأۄًىەأهڲأڲةەأۗأحًأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتەأتثًثڬشأ$أڬۏتأحوأتۄهأؼشثأضەأدىڲأڬشىتأډتۄحەأۄًأآأحًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأدًتثأزۏتأ=أشضًهأتههۄأ﷽أىەألشوتۏتأ=أودہەأهًڲًڽأضەأدۄتزأڬشىەأڬتأذڬوأزۏتأڲۏتأۏۄتڽأحڬأڬۄأًۄأتضأثتحأڬۏأڲًتۄۏأزەأزۏڽأڬۄأتههۄأڬەأضًتأڬًةۏأوؼثًزأىۄۏڽأۄەأۗأتًشأثەأطڬأوۏڽأتههۄأڬتأشضًهأۄًڽأتًشأىوتصأمتةوأڬشۏڽأتًشأصڬًۆأزۏڽأۗأرزتأڬۏأمضوأ$أتڲشأۏۄأودہأضەأتۏڬأشضۏأثہۏأشًڬۏڽأڲەأدًأًۄأشضًهأتههۄأ﷽أڬًأزۏتأڬشحەأحہەأ؏أحًأوۏڽأتىأضەأدۄتزأڬشًڽأڲتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأوۏڽأىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬۏأشتةەأڬًأزۏڬہتأڬۄأتضأځشأتىأڬًأطشذٓأظزشأذتظهأۄەأحًأوۏڽأدتىأڲۏتأڬۄأتىأڬۏأۏۄأشتةەأثشذمأۄەأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأۗأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأذزۏخأڬەأؼهتًۄأؼوشتىأتهمغتىأڬۏأتًشأڬًةۏأشًتۏحأىمهأىۄۏڽأڬۏأ؏أذتهتىڬۄأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأڬەأځتضأتىأڬًأحشڬأڬشىەأڬۏأڬًةۏأزهۏهأىۄۏڽأۄەأڬۏًىڬۄأۏۄأوضحمۏوأتهذزۏخأۄۏڽأۗأ",""
"أتثًؼىثضأضەأوشًۏأتۏڬأذزۏخأتضأڬۏأطتۄزأثہۏأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"1428","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أودہەأذڬوأزۏتأڲۏتأۄەأڬۄأوۏڽأهًڲًڽأضەأدىڲأڬشًڽأۏۄتڽأحڬأڬۄأًۄأتضأثتحأڬۏأڲًتۄۏأزۏڽأڬۄأتههۄأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأتًشأىوتصأتزتأڬشۏڽأتًشأصڬًۆأزۏڽأځہشأوۏشەأتًځشأتىأڬەأرًىأتًشأوتهأذشتوأڬشأزةۏەأڲةەأتًشأتىأڬتأذضتثأتههۄأځشأۄەأۗأ"
"1429","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏشەأضتوىەأًۄأحۏىأطرظأځۏطأڬۏەأڲةەأدًأضثأضەأځۄهەأدىحأوۏڽأدتةۏڽأڲەأتًشأحۏىأتۏضەأهًڲأځۏطأڬۏەأڲةەأدًأضثأضەأځۄهەأزًصرأوۏڽأدتةۏڽأڲەأۗأضثأضەأځۄهەأدىحأوۏڽأدتىەأًتهەأحۏىأإزوۏأۏۄأۄۏڽأ=أ+أ4أ"
"1430","أذعشحأوضشًمأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼثزتههۄأىەألشوتۏتأ=أضًزأڬہتىەأًتهتأتًشأڬہهتىەأًتهتأتًشأزًىًڽأڬۏأڲًتۄۏأزۏىەأًتهتأدثڬۄأتضأڬتأؼهوأشڬہحەأۄًڽأۗأتًشأڲًزہىەأًتهۏأتًشأڲًزہًتىەأًتهۏأتًشأظزمۄأوۏڽأټتهأوټًهأڬشىەأًتهتأتًشأۄدشحأڬەأثؼزأهًټأدتىەأًتهتأ+أۏۄأضثأهًڲأ"
"1431","%أذعشحأتثًسشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتًىټًڽأوۏڽأتىأڬتأظزمۄأۄەأتًشأثہۏڔأثڬشۏًڽأوۏڽأتىأڬتأظزمۄأۄەأۗأتًشأڲتةەأوۏڽأتىأڬتأظزمۄأۄەأتًشأڲىزوأوۏڽأتضأڬتأظزمۄأۄەأۗأتًشأدًأطرظأزۏىتشأتًشأزشۄوأۏتأضًىتأتًشأډتىزۏأذتظهأڬشەأدًأڬۄأىۄأمشعأرًتۄأڬًأهًټتةەأتًشأىۄأتضەأتههۄأڬۏأشتۄأوۏڽأرشډأڬشەأ؏أحًأًۄأتۏضتأرصتىۄأۄەأدضأڬەأضتحہأمۏتوحأڬەأزىأ+أتضأڬۏأځۏټہأڬًأ"
