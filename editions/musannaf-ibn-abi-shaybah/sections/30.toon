hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"29059","(۲۹۰۵۹) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَن لَیْثٍ ، عَن مُجَاہِدٍ (ح) وَعَنْ جَابِرٍ ، وَابْنِ سَالِمٍ ، عَنْ عَامِرٍ ، قَالُوا : مَنْ قَذَفَ ابْنَ الْمُلاَعنۃِ جُلِدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29059","","","كتاب أقضية رسول الله ﷺ"
"29060","(۲۹۰۶۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَن مُجَاہِدٍ ، وَطَاوُوسٍ ؛ فِی الرَّجُلِ یَقُولُ لابْنِ الْمُلاَعنۃِ : یَا ابْنَ الزَّانِیَۃِ ، قَالَ : یُجْلَدُ ثَمَانِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29060","","","كتاب أقضية رسول الله ﷺ"
"29061","(۲۹۰۶۱) حَدَّثَنَا أَبُو بَکْرٍ بْنُ عَیَّاشٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ قَذَفَ ابْنَ الْمُلاَعنۃِ جُلِدَ۔","Da'if","Musannaf Ibn Abi Shaybah 29061","","","كتاب أقضية رسول الله ﷺ"
"29062","(۲۹۰۶۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَن عِمْرَانَ ، عَن عِکْرِمَۃَ ، قَالَ : مَنْ قَالَ لاِبْنِ الْمُلاَعنۃِ : یَا ابْنَ الْہَنَۃِ ، جُلِدَ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 29062","","","كتاب أقضية رسول الله ﷺ"
"29063","(۲۹۰۶۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ ، إِذَا قِیلَ لاِبْنِ الْمُلاَعنۃِ : لَسْتَ بِابْنِ فُلاَنٍ الَّذِی لاَعَنَ أُمَّک ، قَالَ : یُجْلَدُ الَّذِی یَقُولُ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29063","","","كتاب أقضية رسول الله ﷺ"
"29064","(۲۹۰۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ رَمَی ابْنَ الْمُلاَعنۃِ ، أَوْ أُمَّہُ ، جُلِدَ۔","Da'if","Musannaf Ibn Abi Shaybah 29064","","","كتاب أقضية رسول الله ﷺ"
"29065","(۲۹۰۶۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْفَضْلِ بْنِ دَلْہَمٍ ، عَنِ الْحَسَنِ ، قَالَ : یُضْرَبُ قَاذِفُ ابْنِ الْمُلاَعنۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29065","","","كتاب أقضية رسول الله ﷺ"
"29066","(۲۹۰۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِنْ قَذَفَہَا إِنْسَانٌ جُلِدَ قَاذِفُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 29066","","","كتاب أقضية رسول الله ﷺ"
"29067","(۲۹۰۶۷) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ، وَحَمَّادٍ، عَنْ إِبْرَاہِیمَ؛ فِی الأَمَۃِ تَکُونُ تَحْتَ الْحُرِّ فَیَقْذِفُہَا، قَالَ : لاَ یُضْرَبُ الْحَدَّ ، وَلاَ یُلاَعِن۔","No Data Available","Musannaf Ibn Abi Shaybah 29067","","","كتاب أقضية رسول الله ﷺ"
"29068","(۲۹۰۶۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ؛ فِی الأَمَۃِ تَکُونُ تَحْتَ الْحُرِّ فَیَقْذِفُہَا ، قَالَ : لاَ حَدَّ عَلَیْہِما ، وَلاَ لِعَانَ۔","","Musannaf Ibn Abi Shaybah 29068","","","كتاب أقضية رسول الله ﷺ"
"29069","(۲۹۰۶۹) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَن طَاوُوسٍ ، وَمُجَاہِدٍ (ح) وَالْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ؛ فِی الرَّجُلِ تَکُونُ تَحْتَہُ الأَمَۃُ فَیَقْذِفُہَا ، قَالُوا : لَیْسَ بَیْنَہُمَا تَلاَعَنٌ ، وَلَیْسَ عَلَی قَاذِفِہَا حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29069","","","كتاب أقضية رسول الله ﷺ"
"29070","(۲۹۰۷۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ فِی الْعَبْدِ تَکُونُ تَحْتَہُ الْحُرَّۃُ فَیَقْذِفُہَا ، قَالاَ : لَیْسَ بَیْنَہُمَا مُلاَعنۃٌ ، وَیُجْلَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29070","","","كتاب أقضية رسول الله ﷺ"
"29071","(۲۹۰۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْیَہُودِیَّۃِ تُلاَعِنِ الْمُسْلِمَ ؟ قَالَ : لاَ ، وَلاَ الْعَبْدُ الْحُرَّۃَ ، وَلَکِنْ یُجْلَدُ الْعَبْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29071","","","كتاب أقضية رسول الله ﷺ"
"29072","(۲۹۰۷۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، وَعَامِرٍ ؛ فِی الْمَمْلُوکِ تَکُونُ لَہُ امْرَأَۃٌ حُرَّۃٌ ، فَتَجِیئُ بِوَلَدٍ فَیَنْتَفِی مِنْہُ ، قَالَ : یُضْرَبُ ، وَلاَ لِعَانَ بَیْنَہُمَا ، وَیُلْزَقُ بِہِ الْوَلَدُ۔\n وَقَالَ عَامِرٌ ، وَالْحَکَمُ ؛ فِی الْحُرِّ تَحْتَہُ الأَمَۃُ ، فَجَائَتْ بِوَلَدٍ ، فَانْتَفَی مِنْہُ ، قَالاَ : لَیْسَ بَیْنَہُمَا لِعَانٌ ، وَیُلْزَقُ بِہِ الْوَلَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29072","","","كتاب أقضية رسول الله ﷺ"
"29073","(۲۹۰۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الْعَبْدِ إِذَا کَانَ تَحْتَہُ الْحُرَّۃُ ، أَنَّہُ إِذَا قَذَفَہَا جُلِدَ ، وَلاَ یُلاَعِنُ ، وَإِذَا کَانَ حُرٌّ تَحْتَہُ أَمَۃٌ فَقَذَفَہَا ، فَإِنَّہُ لاَ یُجْلَدُ ، وَلاَ یُلاَعِنُ ، وَإِذَا کَانَ عَبْدٌ تَحْتَہُ أَمَۃٌ فَقَذَفَہَا ، فَإِنَّہُ لاَ یُجْلَدُ ، وَلاَ یُلاَعِنُ۔","","Musannaf Ibn Abi Shaybah 29073","","","كتاب أقضية رسول الله ﷺ"
"29074","(۲۹۰۷۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی أَرْبَعَۃٍ شَہِدُوا عَلَی رَجُلٍ أَنَّہُ طَلَّقَ امْرَأَتَہُ ثَلاَثًا ، فَأَنْکَرَ ، وَأَقَرَّ بِغَشَیَانِ الْمَرْأَۃِ ، فَقَالَ : لاَ حَدَّ عَلَیْہِ لأَنَّہُ مُخَاصِمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29074","","","كتاب أقضية رسول الله ﷺ"
"29075","(۲۹۰۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، وَہُوَ قَوْلُ قَتَادَۃَ ؛ أَنَّہُمَا قَالاَ : یُفَرَّقُ بَیْنَہُمَا بِشَہَادَۃِ اثْنَیْنِ وَثَلاَثَۃٍ ، وَیُرْجَمُ بِشَہَادَۃِ أَرْبَعَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29075","","","كتاب أقضية رسول الله ﷺ"
"29076","(۲۹۰۷۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، قَالَ : نَبَّؤُوا عَنْ حَبِیْبِ بْنِ أَبِی ذِئْبٍ ، عَنْ عُمَرَ ، قَالَ : یُفَرَّقُ بَیْنَہُمَا بِشَہَادَۃِ أَرْبَعَۃٍ فَأَکْثَرَ ، فَإِنْ عَادَ رُجِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 29076","","","كتاب أقضية رسول الله ﷺ"
"29077","(۲۹۰۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، قَالَ : نَبَّؤُووا عَنْ إبْرَاہِیمَ ، قَالَ : یُفَرَّقُ بَیْنَہُمَا بِشَہَادَۃِ أَرْبَعَۃٍ ، وَأَکْثَرِ مِنْ ذَلِکَ رَجْمٌ۔","","Musannaf Ibn Abi Shaybah 29077","","","كتاب أقضية رسول الله ﷺ"
"29078","(۲۹۰۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ شَہِدَ عَلَیْہِ شُہُودٌ أَنَّہُ طَلَّقَ امْرَأَتَہُ ثَلاَثًا ، فَجَحَدَ ذَلِکَ ، وَأَنَّہُ کَانَ یَغْشَاہَا ؟ قَالَ : فَقَالَ الشَّعْبِیِّ : یُدْرَأُ عَنْہُ الْحَدُّ لإِنْکَارِہِ۔","","Musannaf Ibn Abi Shaybah 29078","","","كتاب أقضية رسول الله ﷺ"
"29079","(۲۹۰۷۹) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ فَأَشْہَدَ شَاہِدَیْنِ ، ثُمَّ قَدِمَ الْقَرْیَۃَ الَّتِی بِہَا الْمَرْأَۃُ ، فَغَشِیَہَا وَأَقَرَّ بِأَنْ قَدْ أَصَابَہَا ، وَأَنْکَرَ أَنْ یَکُونَ طَلَّقَہَا ، فَقَالَ عَطَائٌ : تَجُوزُ شَہَادَتُہُمَا ، وَیُفَرَّقُ بَیْنَہُمَا ، وَلاَ یُحَدُّ۔","","Musannaf Ibn Abi Shaybah 29079","","","كتاب أقضية رسول الله ﷺ"
"29080","(۲۹۰۸۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ رَجُلاً طَلَّقَ امْرَأَتَہُ ثَلاَثًا ، ثُمَّ جَعَلَ یَغْشَاہَا بَعْدَ ذَلِکَ ، فَسُئِلَ عَن ذَلِکَ عَمَّارٌ ؟ فَقَالَ : لَئِنْ قَدَرْتُ عَلَی ہَذَا لأَرْجُمَنَّہُ۔","","Musannaf Ibn Abi Shaybah 29080","","","كتاب أقضية رسول الله ﷺ"
"29081","(۲۹۰۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَمَّارٍ ؛ بِنَحْوِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29081","","","كتاب أقضية رسول الله ﷺ"
"29082","(۲۹۰۸۲) حَدَّثَنَا حُمَیْدٌ ، وَعَبْدُ الرَّحْمَنِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَن عِیسَی بْنِ عَاصِمٍ ، قَالَ : خَرَجَ قَوْمٌ فِی سَفَرٍ ، فَمَرُّوا بِرَجُلٍ فَنَزَلُوا بِہِ ، فَطَلَّقَ امْرَأَتَہُ ثَلاَثًا ، فَمَضَی الْقَوْمُ فِی سَفَرِہِمْ ، ثُمَّ عَادُوا فَوَجَدُوہُ مَعَہَا ، فَقَدَّمُوہُ إِلَی شُرَیْحٍ، فَقَالُوا: إِنَّ ہَذَا طَلَّقَ امْرَأَتَہُ ثَلاَثًا وَوَجَدْنَاہُ مَعَہَا، فَأَنْکَرَ، فَقَالَ: تَشْہَدُونَ أَنَّہُ زَانٍ؟ فَأَعَادُوا عَلَیْہِ القَول کَمْا قَالُوا، فَقَالَ: تَشْہَدُونَ أَنَّہُ زَانٍ؟ فَأَعَادُوا عَلَیْہِ، فَفَرَّقَ بَیْنَہُمَا، وَلَمْ یَحُدَّہُمَا، وَأَجَازَ شَہَادَتَہُمَا۔","","Musannaf Ibn Abi Shaybah 29082","","","كتاب أقضية رسول الله ﷺ"
"29083","(۲۹۰۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَنْصَارِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : أَخْبَرَنِی فُلاَنٌ أَنَّک زَنَیْتَ ، قَالَ : لَیْسَ عَلَیْہِ حَدٌّ لأَنَّہُ أَضَافَہُ إِلَی غَیْرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29083","","","كتاب أقضية رسول الله ﷺ"
"29084","(۲۹۰۸۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ رَجُلاً قَالَ لِرَجُلٍ : زَعَمَ فُلاَنٌ أَنَّک زَانٍ ، قَالَ : إِنْ جَائَ بِالْبَیِّنَۃِ ، وَإِلاَّ ضُرِبَ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 29084","","","كتاب أقضية رسول الله ﷺ"
"29085","(۲۹۰۸۵) حَدَّثَنَا ہُشَیْمٌ ، عَن مَنْصُورٍ ، عَنِ الْحَارِثِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لأَنْ أُعَطِّلُ الْحُدُودَ بِالشُّبُہَاتِ أَحَبَّ إِلَیَّ مِنْ أَنْ أُقِیمَہَا فِی الشُّبُہَاتِ۔","","Musannaf Ibn Abi Shaybah 29085","","","كتاب أقضية رسول الله ﷺ"
"29086","(۲۹۰۸۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ إِسْحَاقَ بْنِ أَبِی فَرْوَۃَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ؛ أَنَّ مُعَاذًا ، وَعَبْدَ اللہِ بْنَ مَسْعُودٍ ، وَعُقْبَۃَ بْنَ عَامِرٍ ، قَالُوا : إِذَا اشْتَبَہَ عَلَیْک الْحَدُّ فَادْرَأْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29086","","","كتاب أقضية رسول الله ﷺ"
"29087","(۲۹۰۸۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن قَیْسِ بْنِ مُسْلِمٍ ، عَن طَارِقِ بْنِ شِہَابٍ ؛ أَنَّ امْرَأَۃً زَنَتْ ، فَقَالَ عُمَرُ : أُرَاہَا کَانَتْ تُصَلِّی مِنَ اللَّیْلِ فَخَشَعَتْ ، فَرَکَعَتْ فَسَجَدَتْ ، فَأَتَاہَا غَاوٍ مِنَ الْغُوَاۃِ فَتَجَتَّمَہَا ، فَأَرْسَلَ عُمَرُ إِلَیْہَا ، فَقَالَتْ کَمَا قَالَ عُمَرُ ، فَخَلَّی سَبِیلَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 29087","","","كتاب أقضية رسول الله ﷺ"
"29088","(۲۹۰۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ ، ادْرَؤُوا الْحُدُودَ عَنْ عِبَادِ اللہِ مَا اسْتَطَعْتُمْ۔","","Musannaf Ibn Abi Shaybah 29088","","","كتاب أقضية رسول الله ﷺ"
"29089","(۲۹۰۸۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن بُرْدٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : ادْفَعُوا الْحُدُودَ لِکُلِّ شُبْہَۃٍ۔","","Musannaf Ibn Abi Shaybah 29089","","","كتاب أقضية رسول الله ﷺ"
"29090","(۲۹۰۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : ادْرَؤُوا الْقَتْلَ وَالْجَلْدَ عَنِ الْمُسْلِمِینَ مَا اسْتَطَعْتُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 29090","","","كتاب أقضية رسول الله ﷺ"
"29091","(۲۹۰۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ : اطْرُدُوا الْمُعْتَرِفِینَ۔","","Musannaf Ibn Abi Shaybah 29091","","","كتاب أقضية رسول الله ﷺ"
"29092","(۲۹۰۹۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ أَبُو مُوسَی : أُتِیَت وَأَنَا بِالْیَمَنِ بِامْرَأَۃٍ حُبْلَی ، فَسَأَلْتُہَا ؟ فَقَالَتْ : مَا تَسْأَلُ عَنِ امْرَأَۃٍ حُبْلَی ثَیِّبٍ مِنْ غَیْرِ بَعْلٍ ؟ أَمَا وَاللَّہِ مَا خَالَلْتُ خَلِیلاً ، وَلاَ خَادَنْتُ خِدْنًا مُنْذُ أَسْلَمْتُ ، وَلَکِنْ بَیْنَا أَنَا نَائِمَۃٌ بِفِنَائِ بَیْتِی ، وَاللَّہِ مَا أَیْقَظَنِی إِلاَّ رَجُلٌ رقصنی وَأَلْقَی فِی بَطْنِی مِثْلَ الشِّہَابِ ، ثُمَّ نَظَرْت إِلَیْہِ مُقَفِّیًا مَا أَدْرِی مَنْ ہُوَ مِنْ خَلْقِ اللہِ ، فَکَتَبْتُ فِیہَا إِلَی عُمَرَ ، فَکَتَبَ عُمَرُ : وَافِنِی بِہَا ، وَبِنَاسٍ مِنْ قَوْمِہَا ، قَالَ : فَوَافَیْنَاہُ بِالْمَوْسِمِ ، فَقَالَ شَبَہَ الْغَضْبَانِ : لَعَلَّک قَدْ سَبَقْتَنِی بِشَیْئٍ مِنْ أَمْرِ الْمَرْأَۃِ ؟ قَالَ : قُلْتُ : لاَ ، ہِیَ مَعِی وَنَاسٌ مِنْ قَوْمِہَا ، فَسَأَلَہَا ، فَأَخْبَرَتْہُ کَمَا أَخْبَرَتْنِی ، ثُمَّ سَأَلَ قَوْمَہَا فَأَثْنَوْا خَیْرًا ، قَالَ : فَقَالَ عُمَرُ : شَابَّۃٌ تِہَامِیَّۃٌ نُوَمۃ ، قَدْ کَانَ یُفْعَلُ ، فَمَارَّہَا ، وَکَسَاہَا ، وَأَوْصَی قَوْمَہَا بِہَا خَیْرًا۔","Hasan","Musannaf Ibn Abi Shaybah 29092","","","كتاب أقضية رسول الله ﷺ"
"29093","(۲۹۰۹۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، قَالَ : بَیْنَمَا نَحْنُ بِمِنًی مَعَ عُمَرَ ، إِذَا امْرَأَۃٌ ضَخْمَۃٌ عَلَی حِمَارَۃٍ تَبْکِی ، قَدْ کَادَ النَّاسُ أَنْ یَقْتُلُوہَا مِنَ الزِّحَامِ ، یَقُولُونَ : زَنَیْتِ ، فَلَمَّا انْتَہَتْ إِلَی عُمَرَ ، قَالَ : مَا یُبْکِیکِ ؟ إِنَّ الْمَرأَۃ رُبَّمَا اسْتُکْرِہَتْ ، فَقَالَتْ : کُنْت امْرَأَۃً ثَقِیلَۃَ الرَّأْسِ ، وَکَانَ اللَّہُ یَرْزُقُنِی مِنْ صَلاَۃِ اللَّیْلِ ، فَصَلَّیْتُ لَیْلَۃً ثُمَّ نِمْتُ ، فَوَاللَّہِ مَا أَیْقَظَنِی إِلاَّ الرَّجُلُ قَدْ رَکِبَنِی ، فَنَظرتُ إِلَیْہِ مُقْفِیًا مَا أَدْرِی مَنْ ہُوَ مِنْ خَلْقِ اللہِ ، فَقَالَ عُمَرُ : لَوْ قَتَلْتُ ہَذِہِ خَشِیت عَلَی الأَخْشَبَیْنِ النَّارَ ، ثُمَّ کَتَبَ إِلَی الأَمْصَارِ : أَنْ لاَ تُقْتَلَ نَفْسٌ دُونَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29093","","","كتاب أقضية رسول الله ﷺ"
"29094","(۲۹۰۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ زِیَادٍ الْبَصْرِیِّ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : ادْرَؤُوا الْحُدُودَ عَنِ الْمُسْلِمِینَ مَا اسْتَطَعْتُمْ ، فَإِذَا وَجَدْتُمْ لِلْمُسْلِمِ مَخْرَجًا ، فَخَلُّوا سَبِیلَہُ ، فَإِنَّ الإِمَامَ أَنْ یُخْطِیء فِی الْعَفْوِ ، خَیْرٌ مِنْ أَنْ یُخْطِئَ فِی الْعُقُوبَۃِ۔ (ترمذی ۱۴۲۴۔ حاکم ۳۸۴)","Da'if","Musannaf Ibn Abi Shaybah 29094","","","كتاب أقضية رسول الله ﷺ"
"29095","(۲۹۰۹۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، وَأَبُو الأَحْوَصِ ، عَنْ عَاصِمٍ ، عَنْ أَبِی رَزِینٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ أَتَی بَہِیمَۃً فَلاَ حَدَّ عَلَیْہِ۔ (ابوداؤد ۴۴۶۰)","Sahih","Musannaf Ibn Abi Shaybah 29095","","","كتاب أقضية رسول الله ﷺ"
"29096","(۲۹۰۹۶) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنِ الْحَکَمِ ؛ فِیمَنْ أَتَی بَہِیمَۃً ، قَالَ : یُجْلَدُ ، وَلاَ یُبْلَغُ بِہِ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 29096","","","كتاب أقضية رسول الله ﷺ"
"29097","(۲۹۰۹۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ فِی الَّذِی یَأْتِی الْبَہِیمَۃَ ، قَالَ : یُعَزَّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29097","","","كتاب أقضية رسول الله ﷺ"
"29098","(۲۹۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَی مَنْ أَتَی بَہِیمَۃً حَدٌّ ، وَلاَ عَلَی مَنْ رُمِی بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 29098","","","كتاب أقضية رسول الله ﷺ"
"29099","(۲۹۰۹۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی حَنِیفَۃَ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : لَیْسَ عَلَی مَنْ أَتَی بَہِیمَۃً حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29099","","","كتاب أقضية رسول الله ﷺ"
"29100","(۲۹۱۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَنْ أَتَی بَہِیمَۃً فَلاَ حَدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29100","","","كتاب أقضية رسول الله ﷺ"
"29101","(۲۹۱۰۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَن بُدَیْلٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ قَالَ : إِذَا أَتَی الرَّجُلُ الْبَہِیمَۃَ ، أُقِیمَ عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29101","","","كتاب أقضية رسول الله ﷺ"
"29102","(۲۹۱۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنْ أَبِی عَلِیٍّ الرَّحَبِیِّ ، عَن عِکْرِمَۃَ ، قَالَ : سُئِلَ الْحَسَنُ بْنُ عَلِیٍّ عَنْ رَجُلٍ أَتَی بَہِیمَۃً ؟ قَالَ : إِنْ کَانَ مُحْصَنًا رُجِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 29102","","","كتاب أقضية رسول الله ﷺ"
"29103","(۲۹۱۰۳) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنِ ابْنِ أَبِی فَرْوَۃَ ، عَن بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّہُ کَانَ یُقِیمُ عَلَیْہِ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 29103","","","كتاب أقضية رسول الله ﷺ"
"29104","(۲۹۱۰۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِیمَنْ یَأْتِی الْبَہِیمَۃَ وَالْغُلاَمَ ؟ قَالَ : عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29104","","","كتاب أقضية رسول الله ﷺ"
"29105","(۲۹۱۰۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِذَا وَقَعَ الرَّجُلُ بِالْبَہِیمَۃِ جُلِدَ الْحَدَّ تَامًّا ، وَمَنْ رَمَی امْرَأَۃً بِالْبَہِیمَۃِ فَعَلَیْہِ الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 29105","","","كتاب أقضية رسول الله ﷺ"
"29106","(۲۹۱۰۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ ، عَن مَسْرُوقٍ ؛ فِی الَّذِی یَأْتِی الْبَہِیمَۃَ ، قَالَ : إِذَا فَعَلَ بِہَا ، قَالَ : ذُبِحَتْ۔","","Musannaf Ibn Abi Shaybah 29106","","","كتاب أقضية رسول الله ﷺ"
"29107","(۲۹۱۰۷) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَن دَاوُد ، قَالَ : قَالَ مَسْرُوقٌ : یُرْجَمُ وَتُرْجَمُ الْحِجَارَۃ الَّتِی رُجِمَ بِہَا ، وَیُعْفَی أَثَرُہُ ، یَعْنِی فِی الَّذِی یَأْتِی الْبَہِیمَۃَ۔","","Musannaf Ibn Abi Shaybah 29107","","","كتاب أقضية رسول الله ﷺ"
"29108","(۲۹۱۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، قَالَ : مَنْ أَتَی الْبَہِیمَۃَ أُقِیمَ عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29108","","","كتاب أقضية رسول الله ﷺ"
"29109","(۲۹۱۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : مَنْ أَتَی بَہِیمَۃً لَمْ تُقمْ لَہُ قِیَامَۃٌ۔","","Musannaf Ibn Abi Shaybah 29109","","","كتاب أقضية رسول الله ﷺ"
"29110","(۲۹۱۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الَّذِی یَأْتِی الْبَہِیمَۃَ ، قَالَ : عَلَیْہِ أَدْنَی الْحَدَّیْنِ ، أُحْصِنَ ، أَمْ لَمْ یُحْصَنْ۔","","Musannaf Ibn Abi Shaybah 29110","","","كتاب أقضية رسول الله ﷺ"
"29111","(۲۹۱۱۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إِبْرَاہِیمَ بْنِ إِسْمَاعِیلَ ، عَن دَاوُد بْنِ حُصَیْنٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اقْتُلُوا الْفَاعِلَ بِالْبَہِیمَۃِ وَالْبَہِیمَۃَ۔ \n(ابوداؤد ۴۴۵۹۔ حاکم ۳۵۵)","Da'if","Musannaf Ibn Abi Shaybah 29111","","","كتاب أقضية رسول الله ﷺ"
"29112","(۲۹۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ عُمَیْرِ بْنِ نُمَیْرٍ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنْ جَارِیَۃٍ کَانَتْ بَیْنَ رَجُلَیْنِ ، فَوَقَعَ عَلَیْہَا أَحَدُہُمَا ؟ قَالَ : لَیْسَ عَلَیْہِ حَدٌّ ، ہُوَ خَائِنٌ یُقَوَّمُ عَلَیْہِ قِیمَۃٌ وَیَأْخُذُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 29112","","","كتاب أقضية رسول الله ﷺ"
"29113","(۲۹۱۱۳) حَدَّثَنَا حَفْصٌ ، عَن دَاوُد ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی جَارِیَۃٍ کَانَتْ بَیْنَ رَجُلَیْنِ ، فَوَقَعَ عَلَیْہَا أَحَدُہُمَا ، قَالَ : یُضْرَبُ تِسْعَۃً وَتِسْعِینَ سَوْطًا۔","No Data Available","Musannaf Ibn Abi Shaybah 29113","","","كتاب أقضية رسول الله ﷺ"
"29114","(۲۹۱۱۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدَۃَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ دَرَأَ عَنہُ الْحَدَّ ، وَضَمَّنَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29114","","","كتاب أقضية رسول الله ﷺ"
"29115","(۲۹۱۱۵) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الأَمَۃِ تَکُونُ بَیْنَ الشُّرَکَائِ ، فَیَقَعُ عَلَیْہَا أَحَدُہُمْ ، قَالَ : یُضْرَبُ مِئَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 29115","","","كتاب أقضية رسول الله ﷺ"
"29116","(۲۹۱۱۶) حَدَّثَنَا رَوَّادُ بْنُ الْجَرَّاحِ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ؛ فِی جَارِیَۃٍ بَیْنَ ثَلاَثَۃٍ ، وَقَعَ عَلَیْہَا أَحَدُہُمْ ، فَقَالَ : عَلَیْہِ أَدْنَی الْحَدَّیْنِ مِئَۃً ، وَعَلَیْہِ ثُلُثَا ثَمَنِہَا ، وَثُلُثَا عُقْرُہَا ، وَیَلِی قِیمَۃَ الْوَلَدِ إِنْ کَانَ۔","","Musannaf Ibn Abi Shaybah 29116","","","كتاب أقضية رسول الله ﷺ"
"29117","(۲۹۱۱۷) حَدَّثَنَا یَزِیدُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یُعَزَّرُ ، وَیُقَوَّمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29117","","","كتاب أقضية رسول الله ﷺ"
"29118","(۲۹۱۱۸) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : بَلَغَنَا أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أُتِیَ بِجَارِیَۃٍ کَانَتْ بَیْنَ رَجُلَیْنِ ، فَوَطِئَہَا أَحَدُہُمَا ، فَاسْتَشَارَ فِیہَا سَعِیدَ بْنَ الْمُسَیَّبِ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، وَعُرْوَۃَ بْنِ الزُّبَیْرِ ، فَقَالُوا : نَرَی أَنْ یُجْلَدَ دُونَ الْحَدِّ ، ویُقَوّموہا قِیمَۃً ، فَیَدْفَعُ إِلَی شَرِیکِہِ نِصْفَ الْقِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 29118","","","كتاب أقضية رسول الله ﷺ"
"29119","(۲۹۱۱۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ؛ فِی رَجُلٍ یَقَعُ عَلَی جَارِیَۃٍ بَیْنَہُ وَبَیْنَ شَرِیکِہِ ، قَالَ : تُقَوَّمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29119","","","كتاب أقضية رسول الله ﷺ"
"29120","(۲۹۱۲۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی جَارِیَۃٍ کَانَتْ بَیْنَ رَجُلَیْنِ ، فَوَقَعَ عَلَیْہَا أَحَدُہُمَا ، فَحَمَلَتْ ، قَالَ : تُقَوَّمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29120","","","كتاب أقضية رسول الله ﷺ"
"29121","(۲۹۱۲۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَنْ لَیْثٍ ، عَن طَاوُوسٍ ؛ فِی الْجَارِیَۃِ تَکُونُ بَیْنَ الرَّجُلَیْنِ ، فَیَطَؤُہَا أَحَدُہُمَا ، قَالَ : عَلَیْہِ الْعُقْرُ بِالْحِصَّۃِ۔","","Musannaf Ibn Abi Shaybah 29121","","","كتاب أقضية رسول الله ﷺ"
"29122","(۲۹۱۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الْحَکَمِ ؛ أَنَّہُ قَالَ فِی رَجُلٍ وَطِئَ جَارِیَۃً مِنَ الْفَیْئِ ، قَالَ : لَیْسَ عَلَیْہِ حَدٌّ ، لَہُ فِیہَا نَصِیبٌ۔","","Musannaf Ibn Abi Shaybah 29122","","","كتاب أقضية رسول الله ﷺ"
"29123","(۲۹۱۲۳) حَدَّثَنَا عَبْدَۃُ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: لَیْسَ عَلَیْہِ حَدٌّ، إِذَا کَانَ لَہُ فِیہَا نَصِیبٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29123","","","كتاب أقضية رسول الله ﷺ"
"29124","(۲۹۱۲۴) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ بُکَیْرِ بْنِ دَاوُد ؛ أَنَّ عَلِیًّا أَقَامَ عَلَی رَجُلٍ وَقَعَ عَلَی جَارِیَۃٍ مِنَ الْخُمُسِ الْحَدَّ۔","Da'if","Musannaf Ibn Abi Shaybah 29124","","","كتاب أقضية رسول الله ﷺ"
"29125","(۲۹۱۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا کَانَ لَہُ فِی الْفَیْئِ شَیْئٌ ، عُزِّرَ وَتُقَوَّمُ عَلَیْہِ، وَکَذَلِکَ فِی جَارِیَۃٍ بَیْنَہُ وَبَیْنَ رَجُلٍ۔","","Musannaf Ibn Abi Shaybah 29125","","","كتاب أقضية رسول الله ﷺ"
"29126","(۲۹۱۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَن حَبِیبِ بْنِ سَالِمٍ ؛ أَنَّ رَجُلاً وَقَعَ بِجَارِیَۃِ امْرَأَتِہِ ، فَأَتَتِ امْرَأَتُہُ النُّعْمَانَ بْنَ بَشِیرٍ فَأَخْبَرَتْہُ ، فَقَالَ : أَمَا إِنَّ عَندِی فِی ذَلِکَ خَبَرًا شَافِیًا ، أُحَدِّثْہُ عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ کُنْتِ أَذِنْتِ لَہُ جَلَدْتہ مِئَۃً ، وَإِنْ کُنْت لَمْ تَأْذَنِی لَہُ رَجَمْتَہُ۔ (ترمذی ۱۴۵۲۔ احمد ۲۷۷)","Da'if","Musannaf Ibn Abi Shaybah 29126","","","كتاب أقضية رسول الله ﷺ"
"29127","(۲۹۱۲۷) حَدَّثَنَا عَلِی ابْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَن عِکْرِمَۃَ ، قَالَ : جَائَتِ امْرَأَۃٌ إِلَی عَلِیٍّ ، فَقَالَتْ : إِنَّ زَوْجِی وَقَعَ عَلَی وَلِیدَتِی ، قَالَ : إِنْ تَکُونِی صَادِقَۃً رَجَمْنَاہُ ، وَإِنْ تَکُونِی کَاذِبَۃً جَلَدْنَاکِ ، ثُمَّ تَضَرَّبَ النَّاسُ حَتَّی اخْتَلَطُوا ، فَذَہَبَتِ الْمَرْأَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 29127","","","كتاب أقضية رسول الله ﷺ"
"29128","(۲۹۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَن مُبَارَکِ بْنِ عُمَارَۃَ ، قَالَ : جَائَتِ امْرَأَۃٌ إِلَی عَلِیٍّ ، فَقَالَتْ : یَا وَیْلَہَا ، إِنَّ زَوْجَہَا وَقَعَ عَلَی جَارِیَتِہَا ، فَقَالَ : إِنْ کُنْتِ صَادِقَۃً رَجَمْنَاہُ ، وَإِنْ تَکُونِی کَاذِبَۃً جَلَدْنَاکِ۔","Da'if","Musannaf Ibn Abi Shaybah 29128","","","كتاب أقضية رسول الله ﷺ"
"29129","(۲۹۱۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ، قَالَ: قَالَ عُمَرُ: لاَ أُوتَی بِرَجُلٍ وَقَعَ عَلَی جَارِیَۃِ امْرَأَتِہِ، إِلاَّ فَعَلْتُ وَفَعَلْتُ۔","","Musannaf Ibn Abi Shaybah 29129","","","كتاب أقضية رسول الله ﷺ"
"29130","(۲۹۱۳۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ کَانَا إِذَا سُئِلاَ عَنِ الرَّجُلِ یَقَعُ عَلَی جَارِیَۃِ امْرَأَتِہِ یَتْلُوَانِ ہَذِہِ الآیَۃَ : {وَالَّذِینَ ہُمْ لِفُرُوجِہِمْ حَافِظُونَ إِلاَّ عَلَی أَزْوَاجِہِمْ ، أَوْ مَا مَلَکَتْ أَیْمَانُہُمْ فَإِنَّہُمْ غَیْرُ مَلُومِینَ}۔","","Musannaf Ibn Abi Shaybah 29130","","","كتاب أقضية رسول الله ﷺ"
"29131","(۲۹۱۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ بَشِیرِ بْنِ سَلْمَانَ ، قَالَ : سَمِعْتُ إِبْرَاہِیمَ ، یَقُولُ : تَعْزِیرٌ وَلاَ حَدَّ۔","","Musannaf Ibn Abi Shaybah 29131","","","كتاب أقضية رسول الله ﷺ"
"29132","(۲۹۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ مَعْبَدٍ ، وَعُبَیْدٍ بَنِی حُمْرَانَ ، عَنِ ابْنِ مَسْعُودٍ ؛ أَنَّہُ ضَرَبَہُ دُونَ الْحَدِّ۔","Da'if","Musannaf Ibn Abi Shaybah 29132","","","كتاب أقضية رسول الله ﷺ"
"29133","(۲۹۱۳۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، قَالَ : قَالَ عَلْقَمَۃُ : مَا أُبَالِی وَقَعْتُ عَلَی جَارِیَۃِ امْرَأَتِی ، أَوْ جَارِیَۃِ عَوْسَجَۃَ ، رَجُلٍ مِنَ الْحَیِّ۔","","Musannaf Ibn Abi Shaybah 29133","","","كتاب أقضية رسول الله ﷺ"
"29134","(۲۹۱۳۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ ؛ فِی رَجُلٍ یَأْتِی جَارِیَۃَ امْرَأَتِہِ ، أَنَّہُ قَالَ : مَا أُبَالِی أَتَیْتُہَا ، أَوْ جَارِیَۃً مِنَ الطَّرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29134","","","كتاب أقضية رسول الله ﷺ"
"29135","(۲۹۱۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29135","","","كتاب أقضية رسول الله ﷺ"
"29136","(۲۹۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَامِرٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : لَوْ أُتِیتُ بِرَجُلٍ وَقَعَ عَلَی جَارِیَۃِ امْرَأَتِہِ لَرَجَمْتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29136","","","كتاب أقضية رسول الله ﷺ"
"29137","(۲۹۱۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أخْبَرَنَا ابْنُ أَبِی عَرُوبَۃَ ، عَنْ إِیَاسِ بْنِ مُعَاوِیَۃَ ، عَن نَافِعٍ ، قَالَ : جَائَتْ جَارِیَۃٌ إِلَی عُمَرَ ، فَقَالَتْ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّ الْمُغِیرَۃَ یَطَؤُنِی ، وَإِنَّ امْرَأَتَہُ تَدْعُونِی زَانِیَۃً ، فَإِنْ کُنْتُ لَہَا فَانْہَہُ عَنْ غَشَیَانِی ، وَإِنْ کُنْتُ لَہُ فَانْہَ امْرَأَتَہُ عَن قَذْفِی ، فَأَرْسَلَ إِلَی الْمُغِیرَۃِ ، فَقَالَ : تَطَأُ ہَذِہِ الْجَارِیَۃَ ؟ قَالَ : نَعَمْ ، قَالَ : مِنْ أَیْنَ ؟ قَالَ : وَہَبَتْہَا لِی امْرَأَتِی ، قَالَ : وَاللَّہِ لَئِنْ لَمْ تَکُنْ وَہَبَتْہَا لَکَ لاَ تَرْجِعُ إِلَی أَہْلِکَ إِلاَّ مَرْجُومًا ، ثُمَّ ، وَقَالَ : انْطَلِقَا إِلَی امْرَأَۃِ الْمُغِیرَۃِ فَأَعْلِمَاہَا : لَئِنْ لَمْ تَکُونِی وَہَبْتِہَا لَہُ لَنَرْجُمَنَّہُ ، قَالَ : فَأَتَیَاہَا فَأَخْبِرَاہَا ، فَقَالَتْ : یَا لَہْفَاہُ ، أَیُرِیدُ أَنْ یَرْجُمَ بَعْلِی ، لاَہَا اللہِ إِذًا ، لَقَدْ وَہَبْتُہَا لَہُ ، قَالَ : فَخَلَّی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 29137","","","كتاب أقضية رسول الله ﷺ"
"29138","(۲۹۱۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیم ، قَالَ : أَتَی رَجُلٌ ابْنَ مَسْعُودٍ ، فَقَالَ : إِنِّی وَقَعْت عَلَی جَارِیَۃِ امْرَأَتِی ، فَقَالَ : قَدْ سَتَرَ اللَّہُ عَلَیْک ، فَاسْتَتِرْ ، فَبَلَغَ ذَلِکَ عَلِیًّا ، فَقَالَ : لَوْ أَتَانِی الَّذِی أَتَی ابْنَ أُمِّ عَبْدٍ ، لَرَضَخْتُ رَأْسَہُ بِالْحِجَارَۃِ۔","","Musannaf Ibn Abi Shaybah 29138","","","كتاب أقضية رسول الله ﷺ"
"29139","(۲۹۱۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنِ الْہَیْثَمِ بْنِ بَدْرٍ ، عَن حُرْقُوسٍ ، عَنْ عَلِیٍّ ؛ أَنَّ رَجُلاً وَقَعَ عَلَی جَارِیَۃِ امْرَأَتِہِ ، فَدَرَأَ عَنہُ الْحَدَّ۔ (عبدالرزاق ۱۳۴۸)","Da'if","Musannaf Ibn Abi Shaybah 29139","","","كتاب أقضية رسول الله ﷺ"
"29140","(۲۹۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَا ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ قَالَ : لاَ حَدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29140","","","كتاب أقضية رسول الله ﷺ"
"29141","(۲۹۱۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَ رَجُلٌ إِلَی عَبْدِ اللہِ ، فَقَالَ : إِنِّی وَقَعْتُ عَلَی جَارِیَۃِ امْرَأَتِی ، فَقَالَ : اتَّقِ اللَّہَ ، وَلاَ تَعُدْ۔","","Musannaf Ibn Abi Shaybah 29141","","","كتاب أقضية رسول الله ﷺ"
"29142","(۲۹۱۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَن رِبْعِیٍّ ، عَن عُقْبَۃَ بْنِ جَبَّار ، عَنْ عَبْدِ اللہِ ، قَالَ : لاَ حَدَّ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29142","","","كتاب أقضية رسول الله ﷺ"
"29143","(۲۹۱۴۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ عَامِرِ بْنِ مَطَرٍ ، عَنْ عَبْدِ اللہِ ؛ فِی الرَّجُلِ یَقَعُ عَلَی جَارِیَۃِ امْرَأَتِہِ ، قَالَ : إِنَ اسْتَکْرَہَہَا فَہِیَ حُرَّۃٌ ، وَعَلَیْہِ مِثْلُہَا لِسَیِّدَتِہَا ، وَإِنْ کَانَتْ طَاوَعَتْہُ فَہِیَ لَہُ ، وَعَلَیْہِ مِثْلُہَا لِسَیِّدَتِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 29143","","","كتاب أقضية رسول الله ﷺ"
"29144","(۲۹۱۴۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ جَرِیرٍ ، عَنْ قَیْسٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ حَدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29144","","","كتاب أقضية رسول الله ﷺ"
"29145","(۲۹۱۴۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ سَلَمَۃَ بْنِ مَحَبِّقٍ ؛ أَنَّ رَجُلاً وَقَعَ عَلَی جَارِیَۃِ امْرَأَتِہِ، فَدَرَأَ عَنہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْحَدَّ۔ (ابوداؤد ۴۴۵۶۔ احمد ۴۶۷)","Hasan","Musannaf Ibn Abi Shaybah 29145","","","كتاب أقضية رسول الله ﷺ"
"29146","حَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ، قَالَ: حدَّثَنَا أَبُو عَبْدِالرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ، قَالَ: حَدَّثَنَا أَبُوبَکْرٍ، قَالَ:\n(۲۹۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ امْرَأَۃً تَزَوَّجَتْ فِی عِدَّتِہَا ، فَضَرَبَہَا عُمَرُ تَعْزِیرًا دُونَ الْحَدِّ۔","Sahih","Musannaf Ibn Abi Shaybah 29146","","","كتاب أقضية رسول الله ﷺ"
"29147","(۲۹۱۴۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : إِنْ تَزَوَّجَہَا فِی عِدَّتِہَا عَمْدًا ؟ قَالَ : یُقَامُ عَلَیْہَا الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29147","","","كتاب أقضية رسول الله ﷺ"
"29148","(۲۹۱۴۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ مَرْوَانَ جَلَدَہُمَا أَرْبَعِینَ أَرْبَعِینَ ، وَفَرَّقَ بَیْنَہُمَا ، فَقَالَ لَہُ قبیصَۃُ بْنُ ذُؤَیْبٍ : لَوْ خَفَّفْتَ فَجَلَدْتَہُمَا عِشْرِینَ عِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 29148","","","كتاب أقضية رسول الله ﷺ"
"29149","(۲۹۱۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ (ح) وَعَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛فِی امْرَأَۃٍ نَکَحَتْ فِی عِدَّتِہَا ، قَالاَ : لَیْسَ عَلَیْہَا حَدٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29149","","","كتاب أقضية رسول الله ﷺ"
"29150","(۲۹۱۵۰) حَدَّثَنَا شَرِیکٌ، عَن مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ یُقَامُ عَلَی أَہْلِ الْکِتَابِ حَدٌّ فِی شُرْبِ خَمْرٍ، وَلاَ زِنًی۔","","Musannaf Ibn Abi Shaybah 29150","","","كتاب أقضية رسول الله ﷺ"
"29151","(۲۹۱۵۱) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ ، عَنْ عَمْرٍو ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: لَیْسَ عَلَی أَہْلِ الْکِتَابِ حَدٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 29151","","","كتاب أقضية رسول الله ﷺ"
"29152","(۲۹۱۵۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ رَجَائٍ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ؛ أَنَّ رَجُلاً وَقَعَ عَلَی جَارِیَتِہِ وَلَہَا زَوْجٌ ، فَضَرَبَہُ عُمَرُ بْنُ الْخَطَّابِ مِئَۃً نَکَالاً۔","Sahih","Musannaf Ibn Abi Shaybah 29152","","","كتاب أقضية رسول الله ﷺ"
"29153","(۲۹۱۵۳) حَدَّثَنَا شَرِیکٌ ، عَنْ جَامِعٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : أُتِیَ عُمَرُ بِرَجُلٍ وَقَعَ عَلَی أَمَتِہِ وَقَدْ زَوَّجَہَا ، فَضَرَبَہُ ضَرْبًا ، وَلَمْ یَبْلُغْ بِہِ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 29153","","","كتاب أقضية رسول الله ﷺ"
"29154","(۲۹۱۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِذَا وَقَعَ الرَّجُلُ عَلَی أَمَتِہِ وَلَہَا زَوْجٌ ، فَإِنَّہُ یُجْلَدُ مِئَۃً ، أُحْصِنَ ، أَوْ لَمْ یُحْصَنْ ، فَإِنْ حَمَلَتْ ، فَالْوَلَدُ لِلْفِرَاشِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29154","","","كتاب أقضية رسول الله ﷺ"
"29155","(۲۹۱۵۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الرَّجُلِ یَسْرِقُ مِنْ بَیْتِ الْمَالِ ؟ قَالَ : یُقْطَعُ ، وَقَالَ الْحَکَمُ : لاَ یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29155","","","كتاب أقضية رسول الله ﷺ"
"29156","(۲۹۱۵۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ؛ أَنَّ رَجُلاً سَرَقَ مِنْ بَیْتِ الْمَالِ ، فَکَتَبَ فِیہِ سَعْدٌ إِلَی عُمَرَ ، فَکَتَبَ عُمَرُ إِلَی سَعْدٍ : لَیْسَ عَلَیْہِ قَطْعٌ ، لَہُ فِیہِ نَصِیبٌ۔","","Musannaf Ibn Abi Shaybah 29156","","","كتاب أقضية رسول الله ﷺ"
"29157","(۲۹۱۵۷) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، قَالَ: سَأَلْتُ الْحَکَمَ عن الرجل یَسْرِقُ مِنْ بَیْتِ الْمَالِ؟ قَالَ: لَیْسَ عَلَیْہِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29157","","","كتاب أقضية رسول الله ﷺ"
"29158","(۲۹۱۵۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یَسْرِقُ مِنَ الْمَغْنَمِ ، قَالَ : لَیْسَ عَلَیْہِ حَدٌّ ، إِذَا کَانَ لَہُ فِیہِ نَصِیبٌ۔","","Musannaf Ibn Abi Shaybah 29158","","","كتاب أقضية رسول الله ﷺ"
"29159","(۲۹۱۵۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا سَرَقَ الرَّجُلُ مِنَ الْغَنِیمَۃِ ، وَلَہُ فِیہَا شَیْئٌ لَمْ یُقْطَعْ ، فَإِنْ سَرَقَ مِنْہَا وَلَیْسَ لَہُ فِیہَا نَصِیبٌ قُطِعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29159","","","كتاب أقضية رسول الله ﷺ"
"29160","(۲۹۱۶۰) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنِ ابن عبَیْدِ بْنِ الأَبْرَصِ ؛ أَنَّ عَلِیًّا کَانَ یَقْسِمُ سِلاَحًا فِی الرَّحْبَۃِ ، فَأَخَذَ رَجُلٌ مِغْفَرًا ، فَالْتَحَفَ عَلَیْہِ ، فَوَجَدَہُ رَجُلٌ ، فَأَتَی بِہِ عَلِیًّا ، فَلَمْ یَقْطَعْہُ ، وَقَالَ : لَہُ فِیہِ شِرْکٌ۔","Da'if","Musannaf Ibn Abi Shaybah 29160","","","كتاب أقضية رسول الله ﷺ"
"29161","(۲۹۱۶۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ؛ أَنَّ عَبْدَ اللہِ بْنَ عَمْرِو بْنِ الْحَضْرَمِیِّ ، قَالَ : أَتَیْتُ عُمَرَ بِغُلاَمٍ لِی ، فَقُلْتُ : اقْطَعْہُ ، قَالَ : وَمَا لَہُ ؟ قُلْتُ : سَرَقَ مِرْآۃً لاِمْرَأَتِی خَیْرٌ مِنْ سِتِّینَ دِرْہَمًا ، قَالَ عُمَرُ : غُلاَمُکُمْ یَسْرقُ مَتَاعَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 29161","","","كتاب أقضية رسول الله ﷺ"
"29162","(۲۹۱۶۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ ہَمَّامٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ،قَالَ : جَائَ مَعْقِلٌ الْمُزَنِیّ إِلَی عَبْدِ اللہِ ، فَقَالَ : غُلاَمِی سَرَقَ قَبَائِی ، فَاقْطَعُہُ ؟ قَالَ عَبْدُ اللہِ : لاَ ، مَالِکُ بَعْضُہُ فِی بَعْضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29162","","","كتاب أقضية رسول الله ﷺ"
"29163","(۲۹۱۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ؛ أَنَّ عَلِیًّا ، قَالَ : إِذَا سَرَقَ عَبْدِی مِنْ مَالِی لَمْ أَقْطَعْہُ۔","","Musannaf Ibn Abi Shaybah 29163","","","كتاب أقضية رسول الله ﷺ"
"29164","(۲۹۱۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حَدَّثَنَا سَلَیْمُ بْنُ حَیَّانَ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ مِینَائَ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ یَلِی صَدَقَۃَ الزُّبَیْرِ ، وَکَانَتْ فِی بَیْتٍ لاَ یَدْخُلُہُ أَحَدٌ غَیْرُہُ ، وَغَیْرُ جَارِیَۃٍ لَہُ ، فَفَقَدَ شَیْئًا مِنَ الْمَالِ، فَقَالَ لِلْجَارِیَۃِ : مَا کَانَ یَدْخُلُ ہَذَا الْبَیْتَ غَیْرِی وَغَیْرُک ، فَمَنْ أَخَذَ ہَذَا الْمَالَ ؟ فَأَقَرَّتِ الْجَارِیَۃُ ، فَقَالَ لِی : یَا سَعِیدُ ، انْطَلِقْ بِہَا فَاقْطَعْ یَدَہَا ، فَإِنَّ الْمَالَ لَوْ کَانَ لِی لَمْ یَکُنْ عَلَیْہَا قَطْعٌ۔","Sahih","Musannaf Ibn Abi Shaybah 29164","","","كتاب أقضية رسول الله ﷺ"
"29165","(۲۹۱۶۵) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، قَالَ: سَأَلْتُ حَمَّادًا، وَالْحَکَمَ عَنِ الرَّجُلِ یَقَعُ عَلَی جَارِیَۃِ أُمِّہِ؟ قَالاَ: عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29165","","","كتاب أقضية رسول الله ﷺ"
"29166","(۲۹۱۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَن ، قَالَ : لَیْسَ عَلَیْہِ حَدٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29166","","","كتاب أقضية رسول الله ﷺ"
"29167","(۲۹۱۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ یَزِیدَ بْنِ أَبِی کَبْشَۃَ ؛ أَنَّ أَبَا الدَّرْدَائِ أُتِیَ بِامْرَأَۃٍ قَدْ سَرَقَتْ ، فَقَالَ لَہَا : سَلامَۃُ ، أَسَرَقْتِ ؟ قُولِی : لاَ۔","Hasan","Musannaf Ibn Abi Shaybah 29167","","","كتاب أقضية رسول الله ﷺ"
"29168","(۲۹۱۶۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ مَوْلًی لأَبِی مَسْعُودٍ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : أُتِیَ بِرَجُلٍ سَرَقَ ، فَقَالَ : أَسَرَقْتَ ؟ قُلْ : وَجَدْتُہُ ، قَالَ : وَجَدْتُہُ ، فَخَلَّی سَبِیلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29168","","","كتاب أقضية رسول الله ﷺ"
"29169","(۲۹۱۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ سُلَیْمَانِ النَّاجِی ، عَنْ أَبِی الْمُتَوَکِّلِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ أُتِیَ بِسَارِقٍ ، وَہُوَ یَوْمَئِذٍ أَمِیرٌ ، فَقَالَ : أَسَرَقْتَ ؟ أَسَرَقْتَ ؟ قُلْ : لاَ ، لاَ مَرَّتَیْنِ ، أَوْ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 29169","","","كتاب أقضية رسول الله ﷺ"
"29170","(۲۹۱۷۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ؛ أَنَّ رَجُلاً سَرَقَ شَمْلَۃً، فَأُتِیَ بِہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، ہَذَا سَرَقَ شَمْلَۃً ، فَقَالَ : مَا إِخَالَہُ سَرَقَ۔\n(عبدالرزاق ۱۳۸۳۔ دارقطنی ۱۰۲)","","Musannaf Ibn Abi Shaybah 29170","","","كتاب أقضية رسول الله ﷺ"
"29171","(۲۹۱۷۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، قَالَ : سَمِعْتُ سُبَیْعًا أَبَا سَالِمٍ ، یَقُولُ : شَہِدْتُ الْحَسَنَ بْنَ عَلِیٍّ ، وَأُتِیَ بِرَجُلٍ أَقَرَّ بِسَرِقَۃٍ ، فَقَالَ لَہُ الْحَسَنُ : لَعَلَّک اخْتَلَسْتَ ؟ لِکَیْ یَقُولَ : لاَ۔","Da'if","Musannaf Ibn Abi Shaybah 29171","","","كتاب أقضية رسول الله ﷺ"
"29172","(۲۹۱۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، قَالَ : أُتِیَ عُمَرُ بِسَارِقٍ قَدِ اعْتَرَفَ ، فَقَالَ عُمَرُ: إِنِّی لأَرَی یَدَ رَجُلٍ مَا ہِیَ بِیَدِ سَارِقٍ، قَالَ الرَّجُلُ: وَاللَّہِ مَا أَنَا بِسَارِقٍ، فَأَرْسَلَہُ عُمَرُ وَلَمْ یَقْطَعْہُ۔","","Musannaf Ibn Abi Shaybah 29172","","","كتاب أقضية رسول الله ﷺ"
"29173","(۲۹۱۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ مَنْ مَضَی یُؤْتَی بِالسَّارِقِ ، فَیَقُولُ : أَسَرَقْتَ ؟ وَلاَ أَعْلَمہُ إِلاَّ سَمَّی أَبَا بَکْرٍ وَعُمَرَ۔","","Musannaf Ibn Abi Shaybah 29173","","","كتاب أقضية رسول الله ﷺ"
"29174","(۲۹۱۷۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : حدَّثَنِی مِسْکِینٌ ، رَجُلٌ مِنْ أَہْلِی ، قَالَ : شَہِدْتُ عَلِیًّا أُتِیَ بِرَجُلٍ وَامْرَأَۃٍ وُجِدَا فِی خَرِبَۃٍ ، فَقَالَ لَہُ عَلِیٌّ : أَقَرُبْتَہَا ؟ فَجَعَلَ أَصْحَابُ عَلِیٍّ یَقُولُونَ لَہُ : قُلْ : لاَ ، فَقَالَ : لاَ ، فَخَلَّی سَبِیلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29174","","","كتاب أقضية رسول الله ﷺ"
"29175","(۲۹۱۷۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِمَاعِزِ بْنِ مَالِکٍ : لَعَلَّک قَبَّلْتَ ، أَوْ لَمَسْتَ ، أَوْ بَاشَرْتَ ۔ (احمد ۲۵۵۔ بخاری ۶۸۲۴)","Sahih","Musannaf Ibn Abi Shaybah 29175","","","كتاب أقضية رسول الله ﷺ"
"29176","(۲۹۱۷۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ قَطْعَ فِی ثُمَّرٍ ، وَلاَ کَثَرٍ۔ (احمد ۴۶۳۔ مالک ۸۳۹)","","Musannaf Ibn Abi Shaybah 29176","","","كتاب أقضية رسول الله ﷺ"
"29177","(۲۹۱۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : لَیْسَ فِی شَیْئٍ مِنَ الْحَیَوَانِ قَطْعٌ حَتَّی یَأْوِیَ الْمُرَاحَ ، وَلَیْسَ فِی شَیْئٍ مِنَ الثِّمَارِ قَطْعٌ حَتَّی یَأْوِیَ الْجَرِینَ۔","","Musannaf Ibn Abi Shaybah 29177","","","كتاب أقضية رسول الله ﷺ"
"29178","(۲۹۱۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْحَاقَ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ فِی شَیْئٍ مِنَ الثِّمَارِ قَطْعٌ ، إِلاَّ مَا أَوَی الْجَرِینَ ، وَلَیْسَ فِی شَیْئٍ مِنَ الْمَاشِیَۃِ قَطْعٌ ، إِلاَّ فِیمَا آوَی الْمُرَاحَ۔","Sahih","Musannaf Ibn Abi Shaybah 29178","","","كتاب أقضية رسول الله ﷺ"
"29179","(۲۹۱۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مَعْمَرٍ ، قَالَ : قَالَ یَحْیَی بْنُ أَبِی کَثِیرٍ ، قَالَ : قَالَ عُمَرُ : لاَ یُقْطَعُ فِی عِذْقٍ ، وَلاَ فِی عَامِ سَنَۃٍ۔","","Musannaf Ibn Abi Shaybah 29179","","","كتاب أقضية رسول الله ﷺ"
"29180","(۲۹۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، وَالسُّرِیِّ بْنِ یَحْیَی ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِرَجُلٍ سَرَقَ طَعَامًا ، فَلَمْ یَقْطَعْہُ۔ (ابوداؤد ۲۴۵۔ عبدالرزاق ۱۸۹۱۵)","Hasan","Musannaf Ibn Abi Shaybah 29180","","","كتاب أقضية رسول الله ﷺ"
"29181","(۲۹۱۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ بْنِ عَبْدِ الْمَلِکِ ، وَعَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِرَجُلٍ سَرَقَ طَعَامًا ، فَلَمْ یَقْطَعْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 29181","","","كتاب أقضية رسول الله ﷺ"
"29182","(۲۹۱۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَسْرِقُ الطَّعَامَ ، أَوِ الْحِمَارَ مِنَ الصَّحْرَائِ ؟ فَقَالَ : لَیْسَ عَلَیْہِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29182","","","كتاب أقضية رسول الله ﷺ"
"29183","(۲۹۱۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ الْقَاسِمِ ، قَالَ : قَطَعَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی مُدٍّ ، أَوْ أَمْدَادٍ مِنْ طَعَامٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29183","","","كتاب أقضية رسول الله ﷺ"
"29184","(۲۹۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ حسان بْنِ زَاہِرٍ ، عَنْ حُصَیْنِ بْنِ حُدَیرٍ ، قَالَ : سَمِعْتُ عُمَرَ وہو یَقُولُ : لاَ قَطْعَ فِی عِذْقٍ ، وَلاَ فِی عَامِ سَنَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 29184","","","كتاب أقضية رسول الله ﷺ"
"29185","(۲۹۱۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ؛ أَنَّہُ قَالَ: لَیْسَ فِی الثَمَرَۃِ قَطْعٌ، وَلاَ فِی الْمَاشِیَۃِ الرَّاعِیَۃِ، وَلَکِنْ فِیہَا نَکَالٌ وَتَضْعِیفُ الْغُرْمِ ، فَإِذَا آوَاہا الْمُرَاحُ ، أَوِ الْجَرِینُ ، یُقْطَعُ إِذَا سَرَقَ قَدْرَ رُبْعِ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 29185","","","كتاب أقضية رسول الله ﷺ"
"29186","(۲۹۱۸۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ حَکِیمِ بْنِ حَکِیمِ بْنِ عَبَّادِ بْنِ حُنَیْفٍ ، عَنِ النُّعْمَانِ بْنِ مُرَّۃَ الزُّرَقِیِّ ؛ أَنَّ عَلِیًّا قَطَعَ سَارِقًا مِنَ الْخَصْرِ ، خَصْرِ الْقَدَمِ۔","","Musannaf Ibn Abi Shaybah 29186","","","كتاب أقضية رسول الله ﷺ"
"29187","(۲۹۱۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ الْحَنَفِیِّ ، عَنْ أُمِّ رَزِینٍ ، قَالَتْ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : أَیَعْجِزُ أُمَرَاؤُنَا ہَؤُلاَئِ أَنْ یَقْطَعُوا کَمَا قَطَعَ ہَذَا الأَعْرَابِیُّ ، یَعْنِی نَجْدَۃَ ، فَلَقَدْ قَطَعَ فَمَا أَخْطَأَ ، یَقْطَعُ الرِّجْلَ ، وَیَذَرُ عَاقِبَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 29187","","","كتاب أقضية رسول الله ﷺ"
"29188","(۲۹۱۸۸) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَعَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنِ الْقَطْعِ ؟ فَقَالَ : أَمَّا الرِّجْلُ ، فَیُتْرَکُ لَہُ عَقِبُہُ۔","","Musannaf Ibn Abi Shaybah 29188","","","كتاب أقضية رسول الله ﷺ"
"29189","(۲۹۱۸۹) حَدَّثَنَا عَبْدَۃُ، عَنِ الْعَلاَئِ بْنِ عَبْدِالْکَرِیمِ، عَنْ أَبِی جَعْفَرٍ، قَالَ: الرِّجْلُ تُقْطَعُ مِنْ وَسَطِ الْقَدَمِ مِنْ مَفْصِلٍ۔","","Musannaf Ibn Abi Shaybah 29189","","","كتاب أقضية رسول الله ﷺ"
"29190","(۲۹۱۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ ، عَنْ أَبِی جَعْفَرٍ ؛ بِنَحْوِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29190","","","كتاب أقضية رسول الله ﷺ"
"29191","(۲۹۱۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ مَیْسَرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عنْ عِکْرِمَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَطَعَ الْیَدَ مِنَ الْمَفْصِلِ ، وَقَطَعَ عَلِیٌّ الْقَدَمَ ، وَأَشَارَ عَمْرٌو إِلَی شَطْرِہَا۔","","Musannaf Ibn Abi Shaybah 29191","","","كتاب أقضية رسول الله ﷺ"
"29192","(۲۹۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَسَرَّۃَ بْنِ مَعْبَدٍ اللَّخْمِیِّ ، قَالَ : سَمِعْتُ عَدِیَّ بْنِ عَدِیٍّ یُحَدِّثُ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَطَعَ رَجُلاً مِنَ الْمَفْصِلِ۔ (۲۷۰)","","Musannaf Ibn Abi Shaybah 29192","","","كتاب أقضية رسول الله ﷺ"
"29193","(۲۹۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سَمُرَۃَ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : رَأَیْتُ بِالْحِیرَۃ مَقْطُوعًا مِنَ الْمَفْصِلِ ، فَقُلْتُ : مَنْ قَطَعَک ؟ قَالَ : قَطَعَنی الرَّجُلُ الصَّالِحُ عَلِیٌّ ، أَمَا إِنَّہُ لَمْ یَظْلِمْنِی۔","Da'if","Musannaf Ibn Abi Shaybah 29193","","","كتاب أقضية رسول الله ﷺ"
"29194","(۲۹۱۹۴) حَدَّثَنَا أَبُو سَعْدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ عُمَرَ قَطَعَ الْیَدَ مِنَ الْمَفْصِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 29194","","","كتاب أقضية رسول الله ﷺ"
"29195","(۲۹۱۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ ابْنِ ثَوْبَانٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَطَعَ یَدَ رَجُلٍ ، ثُمَّ حَسَمَہُ۔","","Musannaf Ibn Abi Shaybah 29195","","","كتاب أقضية رسول الله ﷺ"
"29196","(۲۹۱۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، رفعہ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 29196","","","كتاب أقضية رسول الله ﷺ"
"29197","(۲۹۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ أَبِی سُفْیَانَ ؛ أَنَّ ابْنَ الزُّبَیْرِ أُتِیَ بِسَارِقٍ ، فَقَطَعَہُ ، فَقَالَ لَہُ أَبَانُ بْنُ عُثْمَانَ : احْسِمْہُ ، فَقَالَ : إِنَّک بِہِ لَرَحِیمٌ ، قَالَ : لاَ ، وَلَکِنَّہُ مِنَ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 29197","","","كتاب أقضية رسول الله ﷺ"
"29198","(۲۹۱۹۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : مِنَ السُّنَّۃِ حَسْمُ السَّارِقِ۔","Da'if","Musannaf Ibn Abi Shaybah 29198","","","كتاب أقضية رسول الله ﷺ"
"29199","(۲۹۱۹۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ حُجِّیَّۃَ ؛ أَنَّ عَلِیًّا کَانَ یَقْطَعُ اللُّصُوصَ وَیَحْسِمُہُمْ وَیَحْبِسُہُمْ وَیُدَاوِیہِمْ ، فَإِذَا بَرَؤُوا ، قَالَ : أرْفَعُوا أَیْدِیَکُمْ ، فَیَرْفَعُونَہَا کَأَنَّہَا أُیُورُ الْحُمُرِ ، ثُمَّ یَقُولُ : مَنْ قَطَعَکُمْ ؟ فَیَقُولُونَ : عَلِیٌّ ، فَیَقُولُ : وَلِمَ ؟ فَیَقُولُونَ : إِنَّا سَرَقْنَا ، فَیَقُولُ : اللَّہُمَّ اشْہَدْ ، اللَّہُمَّ اشْہَدْ ، اذْہَبُوا۔","Da'if","Musannaf Ibn Abi Shaybah 29199","","","كتاب أقضية رسول الله ﷺ"
"29200","(۲۹۲۰۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زُہَیْرِ بْنِ مُحَمَّدِ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، قَالَ : أُتِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ بِرَجُلٍ قد سَرَقَ طَیْرًا ، فَاسْتَفْتَی فِی ذَلِکَ السَّائِبَ بْنَ یَزِیدَ ، فَقَالَ : مَا رَأَیْتُ أَحَدًا قَطَعَ فِی الطَّیْرِ ، وَمَا عَلَیْہِ فِی ذَلِکَ قَطْعٌ ، فَتَرَکَہُ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ ، فَلَمْ یَقْطَعْہُ۔","","Musannaf Ibn Abi Shaybah 29200","","","كتاب أقضية رسول الله ﷺ"
"29201","(۲۹۲۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْن یَسَارٍ ، قَالَ : أُتِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی رَجُلٍ سَرَقَ دَجَاجَۃً ، فَأَرَادَ أَنْ یَقْطَعَہُ ، فَقَالَ لَہُ أَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ : قَالَ عُثْمَانُ : لاَ قَطْعَ فِی الطَّیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 29201","","","كتاب أقضية رسول الله ﷺ"
"29202","(۲۹۲۰۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَبِی خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ لاَ یَقْطَعُ فِی الطَّیْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 29202","","","كتاب أقضية رسول الله ﷺ"
"29203","(۲۹۲۰۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ بَعْضَ مَنْ أَرْضَی ، یَقُولُ : لاَ قَطْعَ فِی بَازٍ سُرِقَ ، وَإِنْ کَانَ ثَمَنُہُ دِینَارًا ، أَوْ أَکْثَرَ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29203","","","كتاب أقضية رسول الله ﷺ"
"29204","(۲۹۲۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : کَانَ یَقُولُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29204","","","كتاب أقضية رسول الله ﷺ"
"29205","(۲۹۲۰۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : أُتِیَ مَرْوَانُ بْنُ الْحَکَمِ بِقَوْمٍ یَخْتَفُونَ الْقُبُورَ ، یَعْنِی یَنْبُشُونَ ، فَضَرَبَہُمْ وَنَفَاہُمْ ، وَأَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَوَافِرُونَ۔","","Musannaf Ibn Abi Shaybah 29205","","","كتاب أقضية رسول الله ﷺ"
"29206","(۲۹۲۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، قَالَ : أُخِذَ نَبَّاشٌ فِی زَمَانِ مُعَاوِیَۃَ ، زَمَانَ کَانَ مَرْوَانُ عَلَی الْمَدِینَۃِ ، فَسَأَلَ مَنْ کَانَ بِحَضْرَتِہِ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْمَدِینَۃِ وَالْفُقَہَائِ ؟ فَلَمْ یَجِدُوا أَحَدًا قَطَعَہُ ، قَالَ : فَأَجْمَعَ رَأْیُہُمْ عَلَی أَنْ یَضْرِبَہُ ، وَیُطَافَ بِہِ۔","","Musannaf Ibn Abi Shaybah 29206","","","كتاب أقضية رسول الله ﷺ"
"29207","(۲۹۲۰۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ مَعْمَرٍ ، قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَطَعَ نَبَّاشًا۔","No Data Available","Musannaf Ibn Abi Shaybah 29207","","","كتاب أقضية رسول الله ﷺ"
"29208","(۲۹۲۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، قَالاَ : یُقْطَعُ سَارِقُ أَمْوَاتِنَا ، کَمَا یُقْطَعُ سَارِقُ أَحْیَائِنَا۔","","Musannaf Ibn Abi Shaybah 29208","","","كتاب أقضية رسول الله ﷺ"
"29209","(۲۹۲۰۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ النَّبَّاشِ ؟ قَالَ : یُقْطَعُ۔","","Musannaf Ibn Abi Shaybah 29209","","","كتاب أقضية رسول الله ﷺ"
"29210","(۲۹۲۱۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی النَّبَّاشِ ، قَالَ : ہُوَ بِمَنْزِلَۃِ السَّارِقِ ، یُقْطَعُ۔","","Musannaf Ibn Abi Shaybah 29210","","","كتاب أقضية رسول الله ﷺ"
"29211","(۲۹۲۱۱) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، قَالَ: سَأَلْتُ الْحَسَنَ عَنِ النَّبَّاشِ؟ فَقَالَ: یُقْطَعُ، وَسَأَلْتُ الشَّعْبِیَّ؟ فَقَالَ: یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29211","","","كتاب أقضية رسول الله ﷺ"
"29212","(۲۹۲۱۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی النَّبَّاشِ ، قَالَ : یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29212","","","كتاب أقضية رسول الله ﷺ"
"29213","(۲۹۲۱۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ ، وَأَصْحَابِہِ ، قَالُوا: یُقْطَعُ النَّبَّاشُ ، لأَنَّہُ قَدْ دَخَلَ عَلَی الْمَیِّتِ بَیْتَہُ۔","","Musannaf Ibn Abi Shaybah 29213","","","كتاب أقضية رسول الله ﷺ"
"29214","(۲۹۲۱۴) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ شَیْخٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ یُقْطَعُ ، إِلاَّ أَنْ یَکُونَ لِلْقَبْرِ بَابٌ۔","","Musannaf Ibn Abi Shaybah 29214","","","كتاب أقضية رسول الله ﷺ"
"29215","(۲۹۲۱۵) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إِسْرَائِیلَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ معاویۃ بْنِ قُرَّۃَ ، قَالَ : النَّبَّاشُ لِصٌّ ، فَاقْطَعْہُ۔","","Musannaf Ibn Abi Shaybah 29215","","","كتاب أقضية رسول الله ﷺ"
"29216","(۲۹۲۱۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ؛ أَنَّ مَسْرُوقًا ، وَإِبْرَاہِیمَ النَّخَعِیّ ، وَالشَّعْبِیَّ ، وَزَاذَانَ ، وَأَبَا زُرْعَۃَ بْنَ عَمْرِو بْنِ جَرِیرٍ ، کَانُوا یَقُولُونَ فِی النَّبَّاشِ : یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29216","","","كتاب أقضية رسول الله ﷺ"
"29217","(۲۹۲۱۷) حَدَّثَنَا شَیْخٌ لَقِیتُہُ بِمِنَی ، عَنْ رَوْحِ بْنِ الْقَاسِمِ ، عَنْ مُطَرِّفٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ عَلَی النَّبَّاشِ قَطْعٌ ، وَعَلَیْہِ شَبِیہٌ بِالْقَطْعِ۔","Da'if","Musannaf Ibn Abi Shaybah 29217","","","كتاب أقضية رسول الله ﷺ"
"29218","(۲۹۲۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَاجٍ ، عَنْ أَبِی مُصْعَبٍ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا أُتِیَ بِالنَّجَاشِیَّ سَکْرَانًا مِنَ الْخَمْرِ فِی رَمَضَانَ ، فَتَرَکَہُ حَتَّی صَحَا ، ثُمَّ ضَرَبَہُ ثَمَانِینَ ، ثُمَّ أَمَرَ بِہِ إِلَی السِّجْنِ ، ثُمَّ أَخْرَجَہُ مِنَ الْغَدِ فَضَرَبَہُ عِشْرِینَ ، فَقَالَ : ثَمَانِینَ لِلْخَمْرِ ، وَعِشْرینَ لِجُرْأَتِکَ عَلَی اللہِ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 29218","","","كتاب أقضية رسول الله ﷺ"
"29219","(۲۹۲۱۹) حَدَّثَنَا أَبُو الأَحْوصِ ، عَنْ أَبِی الْحَارِثِ التَّیْمِیِّ ، عَن أَبِی مَاجِدٍ الْحَنَفِیِّ ، قَالَ : کُنْتُ عِنْدَ عَبْدِ اللہِ بْنِ مَسْعُودٍ قَاعِدًا ، فَجَائَہُ رَجُلٌ مِنَ الْمُسْلِمیَن بِابْنِ أَخٍ لَہُ ، فَقَالَ لَہُ : یَا أَبَا عَبْدِ الرَّحْمَانَ ، ابْنُ أَخِی وَجَدْتُ??ُ سَکْرَانًا ، فَقَالَ عَبْدُ اللہِ : تَرْتِرُوہ ، وَمَزْمِزُوہ ، وَاستُنْکِہُوہ ، فَتُرْتِر ،وَمُزْمِز ، وَاستُنْکِہ ، فَوُجِدَ سَکْرَانًا ، فَدُفِعَ إِلَی السِّجْنِ ، فَلَمَا کَانَ الْغَدُ ، جِئْتُ وَجِیئَ بِہِ۔ (بیہقی ۳۱۸)","Da'if","Musannaf Ibn Abi Shaybah 29219","","","كتاب أقضية رسول الله ﷺ"
"29220","(۲۹۲۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا سَکَرَ الإِنْسَانُ تُرِکَ حَتَّی یُفِیقَ ، ثُمَّ جُلِدَ۔","","Musannaf Ibn Abi Shaybah 29220","","","كتاب أقضية رسول الله ﷺ"
"29221","(۲۹۲۲۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا سَکَرَ الإِمَامُ جُلِدَ وَہُوَ لاَ یَعْقِلُ ، فَإِِنَّہُ إِنْ عَقِلَ امْتَنَعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29221","","","كتاب أقضية رسول الله ﷺ"
"29222","(۲۹۲۲۲) حَدَّثَنَا وَکِیعٌ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، عَنِ السَّائِبِ بْنِ یَزِیدَ؛ أَنَّ عُمَرَ کَانَ یَضْرِبُ فِی الرِّیحِ۔","Sahih","Musannaf Ibn Abi Shaybah 29222","","","كتاب أقضية رسول الله ﷺ"
"29223","(۲۹۲۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، قَالَ : قرَأَ عَبْدُ اللہِ سُورَۃَ یُوسُفَ بِحِمْصَ ، فَقَالَ رَجُلٌ : مَا ہَکَذَا أُنْزِلَتْ ، فَدَنَا مِنْہُ عَبْدُ اللہِ ، فَوَجَدَ مِنْہُ رِیحَ الْخَمْرِ ، فَقَالَ لَہُ : تُکَذِّبُ بِالْحَقِّ ، وَتَشْرَبُ الرِّجْسَ ، وَاللَّہِ ، لَہکَذَا أَقْرَأَنِیہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، لاَ أَدَعُک حَتَّی أَحُدَّک ، فَجَلَدَہُ الْحَدَّ۔ (بخاری ۵۰۰۱۔ مسلم ۵۵۲)","Sahih","Musannaf Ibn Abi Shaybah 29223","","","كتاب أقضية رسول الله ﷺ"
"29224","(۲۹۲۲۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ؛ أَنَّ ذَا قَرَابَۃٍ لَمَیْمُونَۃَ دَخَلَ عَلَیْہَا ، فَوَجَدَتْ مِنْہُ رِیحَ شَرَابٍ ، فَقَالَتْ : لَئِنْ لَمْ تَخْرُجْ إِلَی الْمُسْلِمِینَ فَیَحُدُّونَک ، أَوْ یُطَہِّرُونَک ، لاَ تَدْخُلْ عَلَیَّ بَیْتِی أَبَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 29224","","","كتاب أقضية رسول الله ﷺ"
"29225","(۲۹۲۲۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : کَتَبْتُ إِلَی ابْنِ الزُّبَیْرِ ، أَسْأَلُہُ عَنِ الرَّجُلِ یُوجَدُ مِنْہُ رِیحُ الشَّرَابِ ؟ فَقَالَ : إِنْ کَانَ مُدْمِنًا فَحُدَّہُ۔","","Musannaf Ibn Abi Shaybah 29225","","","كتاب أقضية رسول الله ﷺ"
"29226","(۲۹۲۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : أُتِیتُ بِرَجُلٍ وُجِدَتْ مِنْہُ رِیحُ الْخَمْرِ، وَأَنَا قَاضٍ عَلَی الطَّائِفِ ، فَأَرَدْتُ أَنْ أَضْرِبَہُ ، فَقَالَ : إِنَّمَا أَکَلْتُ فَاکِہَۃً ، فَکَتَبْتُ إِلَی ابْنِ الزُّبَیْرِ ، فَکَتَبَ إِلَیَّ : إِنْ کَانَ مِنَ الْفَاکِہَۃِ مَا یُشْبِہُ رِیحَ الْخَمْرِ ، فَادْرَأْ عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29226","","","كتاب أقضية رسول الله ﷺ"
"29227","(۲۹۲۲۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، وَعَمْرِو بْنِ دِینَارٍ ، قَالاَ : لاَ حَدَّ فِی رِیحٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29227","","","كتاب أقضية رسول الله ﷺ"
"29228","(۲۹۲۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی الرِّیحِ حَدًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 29228","","","كتاب أقضية رسول الله ﷺ"
"29229","(۲۹۲۲۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مَالِکِ بْنِ عُمَیْرٍ الْحَنَفِیِّ ، قَالَ : أُتِیَ عُمَرُ بِابْنِ مَظْعُونٍ قَدْ شَرِبَ خَمْرًا ، فَقَالَ : مَنْ شُہُودُک ؟ قَالَ : فُلاَنٌ وَفُلاَنٌ ، وَعَتَّابُ بْنُ سَلَمَۃَ ، وَکَانَ یُسَمَّی عَتَّابُ الشَّیْخَ الصَّدُوقَ ، فَقَالَ : رَأَیْتُہُ یَقِیؤُہَا ، وَلَمْ أَرَہُ یَشْرَبُہَا ، فَجَلَدَہُ عُمَرُ الْحَدَّ۔","Da'if","Musannaf Ibn Abi Shaybah 29229","","","كتاب أقضية رسول الله ﷺ"
"29230","(۲۹۲۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مَالِکِ بْنِ عُمَیْرٍ ، عَنْ عَتَّابِ بْنِ سَلَمَۃَ ؛ أَنَّ عُمَرَ ضَرَبَہُ الْحَدَّ ، وَنَصَبَہُ لِلنَّاسِ ، إِلاَّ أَنَّہُ قَالَ : أُتِیَ بِحَفْصِ بْنِ عُمَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 29230","","","كتاب أقضية رسول الله ﷺ"
"29231","(۲۹۲۳۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ سُئِلَ عَنِ الْحَلْقِ ؟ فَقَالَ : جَعَلَہُ اللَّہُ تَعَالَی نُسُکًا وَسُنَّۃً ، وَجَعَلَہُ النَّاسُ عُقُوبَۃً۔","","Musannaf Ibn Abi Shaybah 29231","","","كتاب أقضية رسول الله ﷺ"
"29232","(۲۹۲۳۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ رَوْحِ بْنِ یَزِید ، عَنْ بِشْرٍ ، عَنْ أبِیہِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ: إِیَّایَ وَحَلْقَ الرَّأْسِ وَاللِّحْیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29232","","","كتاب أقضية رسول الله ﷺ"
"29233","(۲۹۲۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : حدَّثَنِی الرِّضَا ، یَعْنِی طَاوُوسًا ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَثَّلَ بِالشَّعْرِ فَلَیْسَ مِنَّا۔ (طبرانی ۱۰۹۷۷)","","Musannaf Ibn Abi Shaybah 29233","","","كتاب أقضية رسول الله ﷺ"
"29234","(۲۹۲۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَن طَاوُوسٍ ، قَالَ : جَعَلَہُ اللَّہُ طَہُورًا ، وَجَعَلْتُمُوہُ عُقُوبَۃً۔","","Musannaf Ibn Abi Shaybah 29234","","","كتاب أقضية رسول الله ﷺ"
"29235","(۲۹۲۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : حلْقُ الرَّأْسِ فِی الْعُقُوبَۃِ بِدْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29235","","","كتاب أقضية رسول الله ﷺ"
"29236","(۲۹۲۳۶) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، قَالَ : جِیئَ بِرَجُلٍ مَعَہُ أَرْبَعَۃٌ ، فَشَہِدَ ثَلاَثَۃٌ مِنْہُمْ بِالزِّنَی ، وَلَمْ یَمْضِ الرَّابِعُ ، فَجَلَدَ عَلِیٌّ الثَّلاَثَۃَ ، وَجَزَّ رَأْسَ الْمَشْہُودِ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29236","","","كتاب أقضية رسول الله ﷺ"
"29237","(۲۹۲۳۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، وَالْوَلِیدِ بْنِ أَبِی مَالِکٍ ؛ أَنَّ عُمَرَ کَتَبَ فِی شَاہِدِ الزُّورِ : یُضْرَبُ أَرْبَعِینَ سَوْطًا ، وَیُسَخَّمُ وَجْہُہُ ، وَیُحْلَقُ رَأْسُہُ ، وَیُطَالُ حَبْسُہُ۔","","Musannaf Ibn Abi Shaybah 29237","","","كتاب أقضية رسول الله ﷺ"
"29238","(۲۹۲۳۸) حَدَّثَنَا عُثْمَانُ بْنُ عُثْمَانَ ، عَنْ عُمَرَ بْنِ مُصْعَبٍ ، قَالَ : أُتِیَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ بِرَجُلٍ مِنْ بَنِی تَمِیمٍ ، فَأَمَرَ بِحَلْقِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29238","","","كتاب أقضية رسول الله ﷺ"
"29239","(۲۹۲۳۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ فُضَیْلٍ ، عَنِ ابْنِ مُغَفَّلٍ ؛ أَنَّ رَجُلاً جَائَ إِلَی عَلِیٍّ فَسَارَّہُ ، فَقَالَ : یَا قَنْبَرُ ، أَخْرِجْہُ مِنَ الْمَسْجِدِ ، فَأَقِمْ عَلَیْہِ الْحَدَّ۔","Da'if","Musannaf Ibn Abi Shaybah 29239","","","كتاب أقضية رسول الله ﷺ"
"29240","(۲۹۲۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ؛ أَنَّ عُمَرَ أُتِیَ بِرَجُلٍ فِی شَیْئٍ ، فَقَالَ : أَخْرِجَاہُ مِنَ الْمَسْجِدِ ، فَأَخْرَجَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29240","","","كتاب أقضية رسول الله ﷺ"
"29241","(۲۹۲۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ الشَّعَیْثِیِّ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حَکِیمِ بْنِ حِزَامٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُقَامُ الْحُدُودُ فِی الْمَسَاجِدِ ، وَلاَ یُسْتَقَادُ فِیہَا۔\n(ابن ماجہ ۷۴۸)","Da'if","Musannaf Ibn Abi Shaybah 29241","","","كتاب أقضية رسول الله ﷺ"
"29242","(۲۹۲۴۲) حَدَّثَنَا وَکِیعٌ، عَنْ مُبَارَکٍ، عَنْ ظَبْیَانَ بْنِ صَبَیْحٍ، قَالَ: قَالَ ابْنُ مَسْعُودٍ: لاَ تُقَامُ الْحُدُودُ فِی الْمَسَاجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 29242","","","كتاب أقضية رسول الله ﷺ"
"29243","(۲۹۲۴۳) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عنْ مُجَاہِدٍ (ح) وَعَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالاَ : کَانُوا یَکْرَہُونَ أَنْ یُقِیمُوا الْحُدُودَ فِی الْمَسَاجِدِ۔","","Musannaf Ibn Abi Shaybah 29243","","","كتاب أقضية رسول الله ﷺ"
"29244","(۲۹۲۴۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ ، أَوْ کَانَ یَکْرَہُ الْجَلْدَ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 29244","","","كتاب أقضية رسول الله ﷺ"
"29245","(۲۹۲۴۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ ، رَفَعَہُ ، قَالَ : لاَ تُقَامُ الْحُدُودُ فِی الْمَسَاجِدِ۔ (ترمذی ۱۴۰۱۔ ابن ماجہ ۲۵۹۹)","","Musannaf Ibn Abi Shaybah 29245","","","كتاب أقضية رسول الله ﷺ"
"29246","(۲۹۲۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیل ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : شَہِدْتُہُ ،وَضَرَبَ رَجُلاً افْتَرَی عَلَی رَجُلٍ فِی قَمِیصٍ ، وَلَمْ یَضْرِبْہُ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 29246","","","كتاب أقضية رسول الله ﷺ"
"29247","(۲۹۲۴۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْنِ خَالِدٍ الضَّبِّیِّ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جَنِّبُوا مَسَاجِدَکُمْ إِقَامَۃَ حُدُودِکُمْ۔ (ابن ماجہ ۷۵۰۔ طبرانی ۱۳۶)","","Musannaf Ibn Abi Shaybah 29247","","","كتاب أقضية رسول الله ﷺ"
"29248","(۲۹۲۴۸) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : لِلْمَسْجِدِ حُرْمَۃٌ۔","","Musannaf Ibn Abi Shaybah 29248","","","كتاب أقضية رسول الله ﷺ"
"29249","(۲۹۲۴۹) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی الضُّحَی ؛ أَنَّہُ کَرِہَ الضَّرْبَ فِی الْمَسْجِدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29249","","","كتاب أقضية رسول الله ﷺ"
"29250","(۲۹۲۵۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : تُقَامُ الْحُدُودُ فِی الْمَسَاجِدِ کُلُّہَا ، إِلاَّ الْقَتْلَ۔","","Musannaf Ibn Abi Shaybah 29250","","","كتاب أقضية رسول الله ﷺ"
"29251","(۲۹۲۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِسْمَاعِیلَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ یُقِیمُ الْحُدُودَ فِی الْمَسَاجِدِ۔","","Musannaf Ibn Abi Shaybah 29251","","","كتاب أقضية رسول الله ﷺ"
"29252","(۲۹۲۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ قَالَ لِرَجُلٍ : مَا تَأْتِی امْرَأَتُک إِلاَّ حَرَامًا ، قَالَ : کَذَبَ ، لَیْسَ عَلَیْہِ حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29252","","","كتاب أقضية رسول الله ﷺ"
"29253","(۲۹۲۵۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَیْسَ عَلَی الْمُخْتَلِسِ ، وَلاَ عَلَی الْمُسْتَلِبِ ، وَلاَ الْخَائِنِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29253","","","كتاب أقضية رسول الله ﷺ"
"29254","(۲۹۲۵۴) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، رَفَعَہُ ، بِنَحْوِہِ۔\n(ابوداؤد ۴۳۹۱۔ ترمذی ۱۴۴۸)","","Musannaf Ibn Abi Shaybah 29254","","","كتاب أقضية رسول الله ﷺ"
"29255","(۲۹۲۵۵) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ؛ أَنَّ مَرْوَانَ سَأَلَ زَیْدَ بْنَ ثَابِتٍ عَنِ الْخُلْسَۃِ؟ فَلَمْ یَرَ فِیہَا قَطْعًا۔","","Musannaf Ibn Abi Shaybah 29255","","","كتاب أقضية رسول الله ﷺ"
"29256","(۲۹۲۵۶) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ : لَیْسَ عَلَی الْمُخْتَلِسِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29256","","","كتاب أقضية رسول الله ﷺ"
"29257","(۲۹۲۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ؛ أَنَّ عَلِیًّا لَمْ یَکُنْ یَقْطَعْ فِی الْخُلْسَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 29257","","","كتاب أقضية رسول الله ﷺ"
"29258","(۲۹۲۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ غُلاَمًا اخْتَلَسَ طَوْقًا ، فَرُفِعَ إِلَی عَدِیِّ بْنِ أَرْطَاۃَ ، فَسَأَلَ الْحَسَنَ عَن ذَلِکَ ؟ فَقَالَ : لاَ قَطْعَ عَلَیْہِ ، وَسَأَلَ عَن ذَلِکَ إِیَاسَ بْنَ مُعَاوِیَۃَ ؟ فَأَمَرَہُ بِقَطْعِہِ ، فَلَمَّا اخْتَلَفَا ، کَتَبَ فِی ذَلِکَ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ إِلَیْہِ عُمَرُ : إِنَّ الْعَرَبَ کَانَتْ تَدْعُوہَا عَدْوَۃَ الظَّہِیرَۃِ ، لاَ قَطْعَ عَلَیْہِ ، وَلَکِنْ أَوْجِعْ ظَہْرَہُ ، وَأَطِلْ حَبْسَہُ۔","","Musannaf Ibn Abi Shaybah 29258","","","كتاب أقضية رسول الله ﷺ"
"29259","(۲۹۲۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ؛ أَنَّ عَدِیًّا رُفِعَ إِلَیْہِ رَجُلٌ اخْتَلَسَ خُلْسَۃً ، فَقَالَ إِیَاسٌ : عَلَیْہِ الْقَطْعُ ، وَقَالَ الْحَسَنُ : لاَ قَطْعَ عَلَیْہِ ، فَکَتَبَ عَدِیٌّ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَقَالَ : لَیْسَ عَلَیْہِ قَطْعٌ ، قَالَ : وَکَانَتِ الْعَرَبُ تُسَمِّیہَا عَدْوَۃَ الظَّہِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 29259","","","كتاب أقضية رسول الله ﷺ"
"29260","(۲۹۲۶۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ مُحَمَّدٍ ، قَالَ : لَیْسَ فِی الْخُلْسَۃِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29260","","","كتاب أقضية رسول الله ﷺ"
"29261","(۲۹۲۶۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ عَلَی الْخَائِنِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29261","","","كتاب أقضية رسول الله ﷺ"
"29262","(۲۹۲۶۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لَیْسَ عَلَی الْخَائِنِ قَطْعٌ۔","Da'if","Musannaf Ibn Abi Shaybah 29262","","","كتاب أقضية رسول الله ﷺ"
"29263","(۲۹۲۶۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَ رَجُلٌ إِلَی شُرَیْحٍ ، فَقَالَ : إِنَّ ہَذَا سَرَقَ مِنِّی ، فَقَالَ : وَمَنْ ہَذَا ؟ قَالَ : أَجِیرِی ، قَالَ : لَیْسَ بِسَارِقٍ مَنِ ائْتَمَنْتہ عَلَی بَیْتِک۔","No Data Available","Musannaf Ibn Abi Shaybah 29263","","","كتاب أقضية رسول الله ﷺ"
"29264","(۲۹۲۶۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ فِی الْخِیَانَۃِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29264","","","كتاب أقضية رسول الله ﷺ"
"29265","(۲۹۲۶۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی غُلاَمٍ کَانَ مَعَ قَوْمٍ فِی السُّوقِ ، فَسَرَقَ بَعْضَ مَتَاعِہِمْ ، فَقَالَ : ہُوَ خَائِنٌ ، وَلاَ قَطْعَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29265","","","كتاب أقضية رسول الله ﷺ"
"29266","(۲۹۲۶۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : أُتِیَ عُمَرُ بِرَجُلٍ فِی حَدٍّ ، فَأُتِیَ بِسَوْطٍ ، فَقَالَ : أُرِیدُ أَلْیَنَ مِنْ ہَذَا ، فَأُتِیَ بِسَوْطٍ فِیہِ لِینٌ ، فَقَالَ : أُرِیدُ أَشَدَّ مِنْ ہَذَا ، فَأُتِیَ بِسَوْطٍ بَیْنَ السَّوْطَیْنِ ، فَقَالَ : اضْرِبْ ، وَلاَ یُرَی إِبْطُک ، وَأَعْطِ کُلَّ عُضْوٍ حَقَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29266","","","كتاب أقضية رسول الله ﷺ"
"29267","(۲۹۲۶۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی الْحَارِثِ التَّیْمِیِّ ، عَنْ أَبِی مَاجِدٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ دَعَا جَلاَّدًا ، فَقَالَ : اجْلِدْ وَارْفَعْ یَدَک ، وَأَعْطِ کُلَّ عُضْوٍ حَقَّہُ ، قَالَ : فَضَرَبَہُ الْحَدَّ ضَرْبًا غَیْرَ مُبَرِّحٍ۔","Da'if","Musannaf Ibn Abi Shaybah 29267","","","كتاب أقضية رسول الله ﷺ"
"29268","(۲۹۲۶۸) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنِ الْمُہَاجِرِ بْنِ عَمِیرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : أُتِیَ بِرَجُلٍ سَکْرَانَ ، أَوْ فِی حَدٍّ ، فَقَالَ : اضْرِبْ ، وَأَعْطِ کُلَّ عُضْوٍ حَقَّہُ ، وَاتَّقِ الْوَجْہَ وَالْمَذَاکِیرَ۔","Da'if","Musannaf Ibn Abi Shaybah 29268","","","كتاب أقضية رسول الله ﷺ"
"29269","(۲۹۲۶۹) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَنْ أَشْعَثَ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْتُ أَبَا بَرْزَۃَ أَقَامَ الْحَدَّ عَلَی أَمَۃٍ لَہُ فِی دِہْلِیزِہِ ، وَعَندَہُ نَفَرٌ مِنْ أَصْحَابِہِ ، فَقَالَ : اجْلِدْہَا جَلْدًا بَیْنَ الْجَلْدَیْنِ ، لَیْسَ بِالْتَّمَطی ، وَلاَ بِالتَّخْفِیفِ۔","Da'if","Musannaf Ibn Abi Shaybah 29269","","","كتاب أقضية رسول الله ﷺ"
"29270","(۲۹۲۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : الْجَلاَدُ لاَ یَخْرُجُ إِبْطُہُ۔","","Musannaf Ibn Abi Shaybah 29270","","","كتاب أقضية رسول الله ﷺ"
"29271","(۲۹۲۷۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : شَہِدْتُ الشَّعْبِیَّ وَضَرَبَ نَصْرَانِیًّا قَذَفَ مُسْلِمًا ، فَقَالَ : اضْرِبْ، وَأَعْطِ کُلَّ عُضْوٍ حَقَّہُ ، وَلاَ یُرَیَنَّ إِبْطَک۔","","Musannaf Ibn Abi Shaybah 29271","","","كتاب أقضية رسول الله ﷺ"
"29272","(۲۹۲۷۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : حدَّ الْفِرْیَۃِ ، وَحَدَّ الْخَمْرِ أَنْ تَجْلِدَ ، وَلاَ تَرْفَعْ یَدَک۔","No Data Available","Musannaf Ibn Abi Shaybah 29272","","","كتاب أقضية رسول الله ﷺ"
"29273","(۲۹۲۷۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: یُضْرَبُ الزَّانِی ضَرْبًا شَدِیدًا، وَیُقَسَّمُ الضَّرْبُ بَیْنَ أَعْضَائِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29273","","","كتاب أقضية رسول الله ﷺ"
"29274","(۲۹۲۷۴) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : حدُّ الزِّنَی أَشَدُّ مِنْ حَدِّ الْخَمْرِ ، وَحَدُّ الْخَمْرِ وَالْفِرْیَۃِ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 29274","","","كتاب أقضية رسول الله ﷺ"
"29275","(۲۹۲۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ ، عَنِ الْحَسَنِ ، قَالَ : یُضْرَبُ الزَّانِی أَشَدَّ مِنْ ضَرْبِ الشَّارِبِ ، وَیُضْرَبُ الشَّارِبُ أَشَدَّ مِنْ ضَرْبِ الْقَاذِفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29275","","","كتاب أقضية رسول الله ﷺ"
"29276","(۲۹۲۷۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ حَنْظَلَۃَ السَّدُوسِیِّ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ ، یَقُولُ : کَانَ یُؤْمَرُ بِالسَّوْطِ ، فَتُقْطَعُ ثَمَرَتُہُ ، ثُمَّ یُدَقُّ بَیْنَ حَجَرَیْنِ ، ثُمَّ یُضْرَبَ بِہِ ، فَقُلْتُ لأَنَسٍ : فِی زَمَانِ مَنْ کَانَ ہَذَا ؟ قَالَ : فِی زَمَانِ عُمَرَ بْنِ الْخَطَّابِ۔","Da'if","Musannaf Ibn Abi Shaybah 29276","","","كتاب أقضية رسول الله ﷺ"
"29277","(۲۹۲۷۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی الْحَارِثِ التَّیْمِیِّ ، عَنِ أبی مَاجِدٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ دَعَا بِسَوْطٍ فَدَقَّ ثَمَرَتَہُ حَتَّی آضَتْ لَہُ مِخْفَقَہُ ، وَدَعَا بِجَلاَّدٍ ، فَقَالَ : اجْلِدْ۔","Da'if","Musannaf Ibn Abi Shaybah 29277","","","كتاب أقضية رسول الله ﷺ"
"29278","(۲۹۲۷۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَن زَیْدِ بْنِ أَسْلَمَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِرَجُلٍ قَدْ أَصَابَ حَدًّا ، فَأُتِیَ بِسَوْطٍ جَدِیدٍ شَدِیدٍ ، فَقَالَ : دُونَ ہَذَا ، فَأُتِیَ بِسَوْطٍ مُنْکَسِرٍ مُنْتَشِرٍ ، فَقَالَ : فَوْقَ ہَذَا ، فَأُتِیَ بِسَوْطٍ قَدْ دِیث ، یَعْنِی قَدْ لُیِّنَ ، فَقَالَ : ہَذَا۔ (مالک ۱۲)","Munkar","Musannaf Ibn Abi Shaybah 29278","","","كتاب أقضية رسول الله ﷺ"
"29279","(۲۹۲۷۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنِ الْمُثَنَّی ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : إِذَا وُجِدَ الْغُلُولُ عَندَ الرَّجُلِ ، أُخِذَ وَجُلِدَ مِئَۃً ، وَحُلِقَ رَأْسُہُ وَلِحْیَتُہُ ، وَأُخِذَ مَا کَانَ فِی رَحْلِہِ مِنْ شَیْئٍ إِلاَّ الْحَیَوَانَ ، وَأُحْرِقَ رَحْلُہُ ، وَلَمْ یَأْخُذْ سَہْمًا فِی الْمُسْلِمِینَ أَبَدًا ، قَالَ : وَبَلَغَنِی ؛ أَنَّ أَبَا بَکْرٍ وَعُمَرَ کَانَا یَفْعَلاَنِہِ۔","","Musannaf Ibn Abi Shaybah 29279","","","كتاب أقضية رسول الله ﷺ"
"29280","(۲۹۲۸۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ فِی الْغُلُولِ قَطْعٌ۔","Da'if","Musannaf Ibn Abi Shaybah 29280","","","كتاب أقضية رسول الله ﷺ"
"29281","(۲۹۲۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : لَیْسَ فِی الْغُلُولِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29281","","","كتاب أقضية رسول الله ﷺ"
"29282","(۲۹۲۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْغُلُولِ إِذَا وُجِدَ عَندَ رَجُلٍ : یُحْرَقُ رَحْلُہُ۔","","Musannaf Ibn Abi Shaybah 29282","","","كتاب أقضية رسول الله ﷺ"
"29283","(۲۹۲۸۳) حَدَّثَنَا دَاوُد بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ ، عَن صَالِحِ بْنِ مُحَمَّدِ بْنِ زَائِدَۃَ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَنْ وَجَدْتُمُوہُ قَدْ غَلَّ فَحَرِّقُوا مَتَاعَہُ۔ (ابوداؤد ۲۷۰۶۔ ترمذی ۱۴۶۱)","Da'if","Musannaf Ibn Abi Shaybah 29283","","","كتاب أقضية رسول الله ﷺ"
"29284","(۲۹۲۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانَ ، عَنْ أَبِیہِ ، قَالَ : أُوتِیَ عَلِیٌّ بِرَجُلٍ شَرِبَ خَمْرًا فِی رَمَضَانَ ، فَجَلَدَہُ ثَمَانِینَ ، وَعَزَّرَہُ عِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 29284","","","كتاب أقضية رسول الله ﷺ"
"29285","(۲۹۲۸۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی سِنَانٍ الْبَکْرِیِّ ، قَالَ : أُتِیَ عُمَرُ بِرَجُلٍ شَرِبَ خَمْرًا فِی رَمَضَانَ ، فَضَرَبَہُ ثَمَانِینَ ، وَعَزَّرَہُ عِشْرِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 29285","","","كتاب أقضية رسول الله ﷺ"
"29286","(۲۹۲۸۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 29286","","","كتاب أقضية رسول الله ﷺ"
"29287","(۲۹۲۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الْیَہُودِیِّ وَالنَّصْرَانِیِّ : إِنْ کَانَ أُحْصِنَ فِی شِرْکِہِ ، ثُمَّ أَسْلَمَ ، ثُمَّ أَصَابَ فَاحِشَۃً قَبْلَ أَنْ یُحْصَنَ فِی الإِسْلاَمِ ، قَالَ : یُرْجَمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29287","","","كتاب أقضية رسول الله ﷺ"
"29288","(۲۹۲۸۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِحْصَانُ الْیَہُودِیِّ وَالنَّصْرَانِیِّ فِی شِرْکِہِمَا إِحْصَانٌ ، وَلَیْسَ الْمَجُوسِیُّ بِإِحْصَانٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29288","","","كتاب أقضية رسول الله ﷺ"
"29289","(۲۹۲۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی أَرْبَعَۃٍ شَہِدُوا عَلَی امْرَأَۃٍ بِالزِّنَی أَحَدُہُمْ زَوْجُہَا ، قَالَ : یُلاَعِنُ الزَّوْجُ ، وَیُضْرَبُ الثَّلاَثَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 29289","","","كتاب أقضية رسول الله ﷺ"
"29290","(۲۹۲۹۰) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29290","","","كتاب أقضية رسول الله ﷺ"
"29291","(۲۹۲۹۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَعَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا جَاؤُوا جَمِیعًا مَعًا ، فَالزَّوْجُ أَجْوَزُہُمْ شَہَادَۃً۔","","Musannaf Ibn Abi Shaybah 29291","","","كتاب أقضية رسول الله ﷺ"
"29292","(۲۹۲۹۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُقَامُ عَلَیْہا الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29292","","","كتاب أقضية رسول الله ﷺ"
"29293","(۲۹۲۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُلاَعِنُ الزَّوْجُ ، وَیُضْرَبُ الثَّلاَثَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29293","","","كتاب أقضية رسول الله ﷺ"
"29294","(۲۹۲۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَبِیعُ امْرَأَتَہُ ، قَالاَ : یُعَاقَبَانِ ، وَیُنَکَّلاَنِ۔","Da'if","Musannaf Ibn Abi Shaybah 29294","","","كتاب أقضية رسول الله ﷺ"
"29295","(۲۹۲۹۵) حَدَّثَنَا زَیْدُ بْنُ حُبَاب ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ بَاعَ امْرَأَۃً وَہُمَا حُرَّانِ ، فَأُخِذَا عِندَ الْجِسْرِ، فِی أَوْسَاطِہِمَا الدَّنَانِیرُ، فَکُتِبَ إِلَی عُمَرَ بْنِ عَبْدِالْعَزِیزِ فِیہِمَا، فَکَتَبَ: أَنْ یُعَزَّرَا، وَیُسْتَوْدَعَا السِّجْنَ۔","Hasan","Musannaf Ibn Abi Shaybah 29295","","","كتاب أقضية رسول الله ﷺ"
"29296","(۲۹۲۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، عَن عِکْرِمَۃَ ، عنِ ابْنِ عَبَّاسٍ ؛ فِی رَجُلَیْنِ بَاعَ أَحَدُہُمَا الآخَرَ ، قَالَ : یُرَدُّ الْبَیْعُ ، وَیُعَاقَبَانِ ، وَلاَ قَطْعَ عَلَیْہِمَا۔","Hasan","Musannaf Ibn Abi Shaybah 29296","","","كتاب أقضية رسول الله ﷺ"
"29297","(۲۹۲۹۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَن خِلاَسٍ ، عَنْ عَلِیٍّ ، قَالَ : تُقْطَعُ یَدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29297","","","كتاب أقضية رسول الله ﷺ"
"29298","(۲۹۲۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ شِہَابٍ ؛ فِی رَجُلٍ بَاعَ رَجُلاً حُرًّا ، قَالَ : یُعَاقَبَانِ ، الَّذِی بَاعَہُ وَالَّذِی أَقَرَّ بِالْبَیْعِ ، عُقُوبَۃً مُوجِعَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 29298","","","كتاب أقضية رسول الله ﷺ"
"29299","(۲۹۲۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی مَعْمَرٌ ، عَنِ ابْنِ شِہَابٍ ؛ فِی رَجُلٍ بَاعَ ابْنَتَہُ ، فَوَقَعَ الْمُبْتَاعُ عَلَیْہَا ، فَقَالَ أَبُوہَا : حَمَلَنِی عَلَی بَیْعِہَا الْحَاجَۃُ ، قَالَ : یُجْلَدَانِ ، الأَبُ وَابْنَتُہُ ، مِئَۃٌ ، مِئَۃٌ ، إِنْ کَانَتْ قَدْ بَلَغَتْ ، وَیُرَدُّ إِلَی الْمُبْتَاعِ الثَمَنُ ، وَعَلَی الْمُبْتَاعِ صَدَاقُہَا بِمَا أَصَابَ مِنْہَا ، ثُمَّ یَغْرَمُ الأَبُ الصَّدَاقَ ، إِلاَّ أَنْ یَکُونَ الْمُبْتَاعُ قَدْ عَلِمَ أَنَّہَا حُرَّۃٌ ، فَعَلَیْہِ الصَّدَاقُ ، وَلاَ یَغْرَمُ الأَبُ لَہُ ، وَیُجْلَدُ مِئَۃً ، وَإِنْ کَانَتْ جَارِیَۃً لاَ تَعْقِلُ ، فَعَلَی الأَبِ النَّکَالُ۔","","Musannaf Ibn Abi Shaybah 29299","","","كتاب أقضية رسول الله ﷺ"
"29300","(۲۹۳۰۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَن حَمَّادٍ ؛ فِی امْرَأَۃٍ بَاعَتْ أُخْتَہَا عَنْ أَمْرِہَا ، فَاشْتَرَاہَا رَجُلٌ ، فَوَطِئَہَا ، قَالَ : یُرَدُّ عَلَی الرَّجُلِ مَالُہُ ، وَتُعَاقَبُ الْمَرْأَۃُ وَأُخْتُہَا ، وَیَرْضَخُ لَہَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 29300","","","كتاب أقضية رسول الله ﷺ"
"29301","(۲۹۳۰۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : شَاہِدُ الزُّورِ یُضْرَبُ شَیْئًا ، وَیُعَرَّفُ النَّاسُ ، وَیُقَالُ : إِنَّ ہَذَا شَہِدَ بِزُورٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29301","","","كتاب أقضية رسول الله ﷺ"
"29302","(۲۹۳۰۲) حَدَّثَنَا عَبَّادُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : شَاہِدُ الزُّورِ یُضْرَبُ مَا دُونَ الأَرْبَعِینَ ؛ خَمْسَۃً وَثَلاَثِینَ ، سِتَّۃً وَثَلاَثِینَ ، وَسَبْعَۃً وَثَلاَثِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29302","","","كتاب أقضية رسول الله ﷺ"
"29303","(۲۹۳۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : شَاہِدُ الزُّورِ یُعَزَّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29303","","","كتاب أقضية رسول الله ﷺ"
"29304","(۲۹۳۰۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ الْمُحَارِبِیُّ ، عَنِ الْجَعْدِ أَبِی عُثْمَانَ ، قَالَ : کَانَ شُرَیْحٌ إِذَا أُتِیَ بِشَاہِدِ الزُّورِ خَفَقَہُ خَفَقَاتٍ۔","","Musannaf Ibn Abi Shaybah 29304","","","كتاب أقضية رسول الله ﷺ"
"29305","(۲۹۳۰۵) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ جَلَدَ شَاہِدَ الزُّورِ سَبْعِینَ سَوْطًا۔","No Data Available","Musannaf Ibn Abi Shaybah 29305","","","كتاب أقضية رسول الله ﷺ"
"29306","(۲۹۳۰۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، وَالْوَلِیدِ بْنِ أَبِی مَالِکٍ ، قَالاَ : کَتَبَ عُمَرُ بْنُ الْخَطَّابِ فِی شَاہِدِ الزُّورِ ؛ یُضْرَبُ أَرْبَعِینَ سَوْطًا ، وَیُسَخَّمُ وَجْہُہُ ، وَیُحْلَقُ رَأْسُہُ ، وَیُطَافُ بِہِ ، وَیُطَالُ حَبْسُہُ۔","","Musannaf Ibn Abi Shaybah 29306","","","كتاب أقضية رسول الله ﷺ"
"29307","(۲۹۳۰۷) حَدَّثَنَا حَفْصٌ ، وَعَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَضَتِ السُّنَّۃُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْخَلِیفَتَیْنِ مِنْ بَعْدِہِ ، أَنْ لاَ تَجُوزَ شَہَادَۃُ النِّسَائِ فِی الْحُدُودِ۔","","Musannaf Ibn Abi Shaybah 29307","","","كتاب أقضية رسول الله ﷺ"
"29308","(۲۹۳۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ بَیَانٌ ، عَنْ إِبْرَاہِیمَ ؛ سُئِلَ عَن ثَلاَثَۃٍ شَہِدُوا عَلَی رَجُلٍ بِالزِّنَی ، وَامْرَأَتَینِ ؟ قَالَ : لاَ یَجُوزُ حَتَّی یَکُونُوا أَرْبَعَۃً۔","","Musannaf Ibn Abi Shaybah 29308","","","كتاب أقضية رسول الله ﷺ"
"29309","(۲۹۳۰۹) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ فِی الطَلاَقِ وَالْحُدُودِ۔","","Musannaf Ibn Abi Shaybah 29309","","","كتاب أقضية رسول الله ﷺ"
"29310","(۲۹۳۱۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ فِی الْحُدُودِ۔","","Musannaf Ibn Abi Shaybah 29310","","","كتاب أقضية رسول الله ﷺ"
"29311","(۲۹۳۱۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَوَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ امْرَأَۃٍ فِی حَدٍّ ، وَلاَ شَہَادَۃُ عَبْدٍ۔","","Musannaf Ibn Abi Shaybah 29311","","","كتاب أقضية رسول الله ﷺ"
"29312","(۲۹۳۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ فِی الْحُدُودِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29312","","","كتاب أقضية رسول الله ﷺ"
"29313","(۲۹۳۱۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ جُوَیْبِرٍ، عَنِ الضَّحَّاکِ، قَالَ: لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ فِی دَمٍ ، وَلاَ حَدِّ دَمٍ۔","","Musannaf Ibn Abi Shaybah 29313","","","كتاب أقضية رسول الله ﷺ"
"29314","(۲۹۳۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : سَمِعْتُ حَمَّادًا ، یَقُولُ : لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ فِی الْحُدُودِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29314","","","كتاب أقضية رسول الله ﷺ"
"29315","(۲۹۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیُّ بْنُ صَالِحٍ ، قَالَ : سَمِعْتُ عَبْد الرَّحْمن بن سَعِید بْنِ وَہْبٍ ، یَقُولُ : لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ فِی الْحُدُودِ۔","","Musannaf Ibn Abi Shaybah 29315","","","كتاب أقضية رسول الله ﷺ"
"29316","(۲۹۳۱۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یُجْلَدُ فِی شَیْئٍ مِنَ الْحُدُودِ ، إِلاَّ بِشَہَادَۃِ رَجُلَیْنِ۔","","Musannaf Ibn Abi Shaybah 29316","","","كتاب أقضية رسول الله ﷺ"
"29317","(۲۹۳۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ {وَلْیَشْہَدْ عَذَابَہُمَا طَائِفَۃٌ مِنَ الْمُؤْمِنِینَ} ، قَالَ : أَدْنَاہ رَجُلٌ ، وَقَالَ عَطَائٌ : رَجُلاَنِ۔","","Musannaf Ibn Abi Shaybah 29317","","","كتاب أقضية رسول الله ﷺ"
"29318","(۲۹۳۱۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ {وَلْیَشْہَدْ عَذَابَہُمَا طَائِفَۃٌ مِنَ الْمُؤْمِنِینَ} ، قَالَ : عَشَرَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29318","","","كتاب أقضية رسول الله ﷺ"
"29319","(۲۹۳۱۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : ثَلاَثَۃٌ فَصَاعِدًا۔","No Data Available","Musannaf Ibn Abi Shaybah 29319","","","كتاب أقضية رسول الله ﷺ"
"29320","(۲۹۳۲۰) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْتُ أَبَا بَرْزَۃَ ضَرَبَ أمَۃً لَہُ فَجَرَتْ ، وَعَلَیْہَا مِلْحَفَۃٌ قَدْ جُلِّلَتْ بِہَا ، وَعَندَہُ طَائِفَۃٌ مِنَ النَّاسِ ، ثُمَّ قَالَ : {وَلْیَشْہَدْ عَذَابَہُمَا طَائِفَۃٌ مِنَ الْمُؤْمِنِینَ}۔","Da'if","Musannaf Ibn Abi Shaybah 29320","","","كتاب أقضية رسول الله ﷺ"
"29321","(۲۹۳۲۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : (إِنْ یُعْفَ عَنْ طَائِفَۃٍ مِنْکُمْ) ، قَالَ : کَانَ رَجُلاً۔","","Musannaf Ibn Abi Shaybah 29321","","","كتاب أقضية رسول الله ﷺ"
"29322","(۲۹۳۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَعَن مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُمَا قَالاَ : مَنْ قَذَفَ صَغِیرًا فَلاَ حَدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29322","","","كتاب أقضية رسول الله ﷺ"
"29323","(۲۹۳۲۳) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ حَدَّ فِی غُلاَمٍ افْتُرِیَ عَلَیْہِ وَہُوَ صَغِیرٌ ، حَتَّی تَجِبَ عَلَیْہِ الْحُدُودُ۔","","Musannaf Ibn Abi Shaybah 29323","","","كتاب أقضية رسول الله ﷺ"
"29324","(۲۹۳۲۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ عَلَی مَنَ دَعَی لِغَیْرِ أُمِّہِ حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29324","","","كتاب أقضية رسول الله ﷺ"
"29325","(۲۹۳۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ قَالَ لِرَجُلٍ : لَسْتَ لِفُلاَنَۃَ ، أُمِّہِ ، قَالَ : کَانَ لاَ یُجْعَلُ عَلَیْہِ الْحَدُّ ، إِنَّمَا ہِیَ کَذْبَۃٌ۔","","Musannaf Ibn Abi Shaybah 29325","","","كتاب أقضية رسول الله ﷺ"
"29326","(۲۹۳۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ رَجُلٍ ، عَنْ حَمَّادٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 29326","","","كتاب أقضية رسول الله ﷺ"
"29327","(۲۹۳۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَیْہِ حَدٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29327","","","كتاب أقضية رسول الله ﷺ"
"29328","(۲۹۳۲۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی الضَّرْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29328","","","كتاب أقضية رسول الله ﷺ"
"29329","(۲۹۳۲۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الضَّرْبِ۔","","Musannaf Ibn Abi Shaybah 29329","","","كتاب أقضية رسول الله ﷺ"
"29330","(۲۹۳۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ فِی قَوْلِہِ تَعَالَی : {وَلاَ تَأْخُذْکُمْ بِہِمَا رَأْفَۃٌ فِی دِینِ اللہِ} ، قَالَ : إِقَامَۃُ الْحُدُودِ إِذَا رُفِعَتْ إِلَی السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 29330","","","كتاب أقضية رسول الله ﷺ"
"29331","(۲۹۳۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ (ح) وَعَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ فِی قَوْلِہِ تَعَالَی : {وَلاَ تَأْخُذْکُمْ بِہِمَا رَأْفَۃٌ فِی دِینِ اللہِ} ، قَالاَ : لَیْسَ بِالْقَتْلِ ، وَلَکِنْ فِی إِقَامَۃِ الْحَدِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29331","","","كتاب أقضية رسول الله ﷺ"
"29332","(۲۹۳۳۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إِقَامَۃُ الْحَدِّ ، أَمَا إِنَّہُ لَیْسَ بِشِدَّۃِ الْجَلْدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29332","","","كتاب أقضية رسول الله ﷺ"
"29333","(۲۹۳۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ {وَلاَ تَأْخُذْکُمْ بِہِمَا رَأْفَۃٌ فِی دِینِ اللہِ}، قَالَ : فِی إِقَامَۃِ الْحَدِّ ، یُقَامُ ، وَلاَ یُعَطَّلُ۔","","Musannaf Ibn Abi Shaybah 29333","","","كتاب أقضية رسول الله ﷺ"
"29334","(۲۹۳۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ ، وَسُلَیْمَانَ بْنِ یَسَارٍ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ ، وَلَمْ یَکُنْ تَزَوَّجَ حُرَّۃً قَبْلَہَا ، ثُمَّ یَفْجُرُ ، قَالَ سُلَیْمَانُ بْنُ یَسَارٍ : یُرْجَمُ ، وَقَالَ عِکْرِمَۃُ: یُجْلَدُ۔","","Musannaf Ibn Abi Shaybah 29334","","","كتاب أقضية رسول الله ﷺ"
"29335","(۲۹۳۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنْ رَجُلٍ زَنَی وَلَہُ سَرَارِیُّ ؟ قَالَ : یُجْلَدُ ، وَلاَ یُرْجَمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29335","","","كتاب أقضية رسول الله ﷺ"
"29336","(۲۹۳۳۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یُحْصن الْحُرَّ بِیَہُودِیَّۃٍ ، وَلاَ نَصْرَانِیَّۃٍ ، وَلاَ بِأَمَۃٍ۔","","Musannaf Ibn Abi Shaybah 29336","","","كتاب أقضية رسول الله ﷺ"
"29337","(۲۹۳۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، أَوْ عَبْدِ اللہِ بْنِ عُتْبَۃَ ؛ أَنَّ مَرْوَانَ سَأَلَہُ عَنِ الْحُرِّ تَکُونُ تَحْتَہُ الأَمَۃُ ، ثُمَّ یُصِیبُ فَاحِشَۃً ؟ قَالَ : یُرْجَمُ ، قَالَ : عَمَّنْ تَأْخُذُ ہَذَا ؟ قَالَ : أَدْرَکْنَا أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُونَہُ۔ (بیہقی ۲۱۶)","Sahih","Musannaf Ibn Abi Shaybah 29337","","","كتاب أقضية رسول الله ﷺ"
"29338","(۲۹۳۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : لاَ تُحْصِنُ الأَمَۃُ الْحُرَّ ، وَلاَ الْعَبْدُ الْحُرَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29338","","","كتاب أقضية رسول الله ﷺ"
"29339","(۲۹۳۳۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَہُوَ قَوْلُ قَتَادَۃَ ؛ أَنَّہُمَا کَانَا یَقُولاَنِ فِی الْحُرَّۃِ تَحْتَ الْعَبْدِ تَزْنِی ، السُّنَّۃُ أَنَّہَا تُرْجَمُ ، وَفِی الْحُرِّ تَحْتَہُ الأَمَۃُ : لاَ یُرْجَمُ۔","Hasan","Musannaf Ibn Abi Shaybah 29339","","","كتاب أقضية رسول الله ﷺ"
"29340","(۲۹۳۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنِ الْفَضْلِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّ سُلَیْمَانَ بْنَ یَسَارٍ ، قَالَ : أَحْصَنَہَا وَأَحْصَنَتْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29340","","","كتاب أقضية رسول الله ﷺ"
"29341","(۲۹۳۴۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : أَحْصَنَہَا وَأَحْصَنَتْہُ ، قَالَ : الْحُرُّ الآنَ مَرْجُومٌ۔","","Musannaf Ibn Abi Shaybah 29341","","","كتاب أقضية رسول الله ﷺ"
"29342","(۲۹۳۴۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَدِمْتُ الْمَدِیِنَۃ ، وَقَدَ أَجْمَعُوا عَلَی عَبْدٍ أُحْصِنَ بِحُرَّۃ أَنْ یرْجَم ، إِلاَّ عِکْرِمَۃ ، فَإِنَّہُ قَالَ : عَلَیْہِ نِصَفُ الْحَّدِ۔","","Musannaf Ibn Abi Shaybah 29342","","","كتاب أقضية رسول الله ﷺ"
"29343","(۲۹۳۴۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْعَبْدِ تَکُونُ تَحْتَہُ الْحُرَّۃُ ، وَالْحُرِّ یَکُون تَحْتَہُ الأَمَۃُ، فَیَزْنِی أَحَدُہُمَا، قَالَ: لَیْسَ عَلَی وَاحِدٍ مِنْہُمَا رَجْمٌ، حَتَّی یَکُونَا حُرَّیْنِ مُسْلِمَیْنِ۔","","Musannaf Ibn Abi Shaybah 29343","","","كتاب أقضية رسول الله ﷺ"
"29344","(۲۹۳۴۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِحْصَانُ الأَمَۃِ أَنْ تَنْکِحَ الْحُرَّ ، وَإِحْصَانُ الْعَبْدِ أَنْ یَنْکِحَ الْحُرَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29344","","","كتاب أقضية رسول الله ﷺ"
"29345","(۲۹۳۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ؛ فِی الْحُرِّ یَتَزَوَّجُ الْیَہُودِیَّۃَ وَالنَّصْرَانِیَّۃ ثُمَّ یَفْجُرُ ، فَقَالاَ : یُجْلَدُ ، وَلاَ یُرْجَمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29345","","","كتاب أقضية رسول الله ﷺ"
"29346","(۲۹۳۴۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَرَی أَنْ یُحْصِنَ الْحُرَّ ، إِلاَّ الْحُرَّۃُ الْمُسْلِمَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29346","","","كتاب أقضية رسول الله ﷺ"
"29347","(۲۹۳۴۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرٍ بْنِ عَبْدِ اللہِ بْنِ أَبِی مَرْیَمَ ، عَنْ عَلِیِّ بْنِ أَبِی طَلْحَۃَ ، عَنْ کَعْبٍ؛ أَنَّہُ أَرَادَ أَنْ یَتَزَوَّجَ یَہُودِیَّۃً ، أَوْ نَصْرَانِیَّۃً ، فَسَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَن ذَلِکَ ؟ فَنَہَاہُ عَنْہَا، وَقَالَ : إِنَّہَا لاَ تُحْصِنُک۔ (ابوداؤد ۲۰۶۔ طبرانی ۲۰۵)","Da'if","Musannaf Ibn Abi Shaybah 29347","","","كتاب أقضية رسول الله ﷺ"
"29348","(۲۹۳۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَرَی مُشْرِکَۃً مُحْصِنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 29348","","","كتاب أقضية رسول الله ﷺ"
"29349","(۲۹۳۴۹) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ أَشْرَکَ بِاَللَّہِ فَلَیْسَ بِمُحْصِن۔","Sahih","Musannaf Ibn Abi Shaybah 29349","","","كتاب أقضية رسول الله ﷺ"
"29350","(۲۹۳۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : إِذَا تَزَوَّجَہَا وَہُوَ غَیْرُ مُسْلِمٍ ، لَمْ تُحْصِنْہُ حَتَّی یَطَأَہَا فِی الإِسْلاَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29350","","","كتاب أقضية رسول الله ﷺ"
"29351","(۲۹۳۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ بَشِیرٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الْیَہُودِیَّۃِ وَالنَّصْرَانِیَّۃ تَکُونُ تَحْتَ الْمُسْلِمِ ، ثُمَّ یَفْجُرُ ، قَالاَ : یُرْجَمُ۔","","Musannaf Ibn Abi Shaybah 29351","","","كتاب أقضية رسول الله ﷺ"
"29352","(۲۹۳۵۲) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : تُحْصِنُ الْیَہُودِیَّۃُ وَالنَّصْرَانِیَّۃُ الْمُسْلِمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29352","","","كتاب أقضية رسول الله ﷺ"
"29353","(۲۹۳۵۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ مِنْ أَہْلِ الْکِتَابِ ، أَنَّہَا تُحْصِنُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29353","","","كتاب أقضية رسول الله ﷺ"
"29354","(۲۹۳۵۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إِسْرَائِیلَ ، عَنْ سَالِمٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الرَّجُلِ یَتَزَوَّجُ الْیَہُودِیَّۃَ، وَالنَّصْرَانِیَّۃَ ، وَالأَمَۃَ أَیُحْصَنُ بِہِنَّ ؟ قَالَ : نَعَمْ ، وَلَوْ مَا۔","","Musannaf Ibn Abi Shaybah 29354","","","كتاب أقضية رسول الله ﷺ"
"29355","(۲۹۳۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ بَکْرٍ ، قَالَ : تَزَوَّجَتِ امْرَأَۃٌ عَبْدَہَا ، فَقِیلَ لَہَا ؟ فَقَالَتْ : أَلَیْسَ اللَّہُ یَقُولُ : {وَمَا مَلَکَتْ أَیْمَانُکُمْ} فَہَذَا مْلِکُ یَمِینِی ، وَتَزَوَّجَتِ امْرَأَۃٌ مِنْ غَیْرِ بَیِّنَۃٍ ، وَلاَ وَلِیٍّ ، فَقِیلَ لَہَا ؟ فَقَالَتْ : أَنَا ثَیِّبٌ ، وَقَدْ مَلَکْتُ أَمْرِی ، فَرُفِعَتا إِلَی عُمَرَ ، فَجَمَعَ النَّاسَ فَسَأَلَہُمْ ؟ فَقَالُوا : قَدْ خَاصَمَتَاک بِکِتَابِ اللہِ جَلَّ جَلاَلُہُ ، وَقَالَ عَلِیٌّ : قَدْ خَاصَمَتَاک بِکِتَابِ اللہِ ، فَجَلَدَ کُلَّ وَاحِدٍ مِنْہُمَا مِئَۃَ جَلْدَۃٍ ، ثُمَّ کَتَبَ إِلَی الأَمْصَارِ : أَیُّمَا امْرَأَۃٍ تَزَوَّجَتْ عَبْدَہَا ، أَوْ تَزَوَّجَتْ بِغَیْرِ وَلِیٍّ ، فَہِیَ بِمَنْزِلَۃِ الزَّانِیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 29355","","","كتاب أقضية رسول الله ﷺ"
"29356","(۲۹۳۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ؛ أَنَّ عُمَرَ کَتَبَ فِی امْرَأَۃٍ تَزَوَّجَتْ عَبْدَہَا ، أَنْ یُفَرَّقَ بَیْنَہُمَا ، وَیُقَامُ الْحَدُّ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 29356","","","كتاب أقضية رسول الله ﷺ"
"29357","(۲۹۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَأَلْتُ عَطَائً ، وَعَبْدَ اللہِ بْنَ عُبَیْدِ بْنِ عُمَیْرٍ ، وَمُجَاہِدًا عَنِ امْرَأَۃٍ کَانَ لَہَا عَبْدٌ ، فَأَرَادَتْ أَنْ تُعْتِقَہُ عَلَی أَنْ یَتَزَوَّجَہَا ؟ فَقَالَ عَطَائٌ ، وَعَبْدُ اللہِ بْنُ عُبَیْدٍ : تُعْتِقُہُ ، وَلاَ تُشَارِطُہُ ، وَقَالَ مُجَاہِدٌ : فِی ہَذَا عُقُوبَۃٌ مِنَ اللہِ وَمِنَ السُّلْطَانِ ، تُفَارِقُہُ ، وَیُقَامُ عَلَیْہَا الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29357","","","كتاب أقضية رسول الله ﷺ"
"29358","(۲۹۳۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَسْوَدِ بْنِ شَیْبَانَ ، عَنْ أَبِی نَوْفَلِ بْنِ أَبِی عَقْرَبٍ ، قَالَ : جَائَتِ امْرَأَۃٌ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَتْ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنِّی امْرَأَۃٌ کَمَا تَرَی ، وَغَیْرِی مِنَ النِّسَائِ أَجْمَلُ مِنِّی ، وَلِی عَبْدٌ قَدْ رَضِیتُ دِینَہُ وَأَمَانَتَہُ ، فَأَرَدْتُ أَنْ أَتَزَوَّجَہُ ، فَدَعَا بِالْغُلاَمِ فَضَرَبَہُمَا ضَرْبًا مُبَرِّحًا ، وَأَمَرَ فِی الْعَبْدِ فَبِیعَ فِی أَرْضِ غُرْبَۃٍ۔","","Musannaf Ibn Abi Shaybah 29358","","","كتاب أقضية رسول الله ﷺ"
"29359","(۲۹۳۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، قَالَ: إِذَا قَالَ: یَاابْنَ الزَّانِیَیْنِ، قَالَ: یُجْلَدُ حَدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 29359","","","كتاب أقضية رسول الله ﷺ"
"29360","(۲۹۳۶۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حُسَیْنٍ ، عَنْ مَکْحُولٍ ؛ فِی رَجُلٍ قَالَ لِرَجُلٍ : یَا زَانٍ ، یَاابْنَ الزَّانِیَۃِ ، قَالَ : یُضْرَبُ حَدَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29360","","","كتاب أقضية رسول الله ﷺ"
"29361","(۲۹۳۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْمُجَالِدِ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرٍ ، قَالَ : جَائَ مَاعِزُ بْنُ مَالِکٍ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنَّہُ قَدْ زَنَی ، فَقَالَ : أَمَا لِہَذَا أَحَدٌ ؟ فَرَدَّہُ ، ثُمَّ جَائَ ثَلاَثَ مِرَارٍ ، فَقَالَ : أَمَا لِہَذَا أَحَدٌ ، فَرَدَّہُ ، فَلَمَّا کَانَتِ الرَّابِعَۃُ ، قَالَ : ارْجُمُوہُ ، فَرَمَاہُ وَرَمَیْنَاہُ ، وَفَرَّ وَاتَّبَعَنَاہُ ، قَالَ عَامِرٌ : فَقَالَ لِی جَابِرٌ : فَہَاہُنَا قَتَلْنَاہُ۔ (بخاری ۵۲۷۰۔ مسلم ۱۳۱۸)","Da'if","Musannaf Ibn Abi Shaybah 29361","","","كتاب أقضية رسول الله ﷺ"
"29362","(۲۹۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، قَالَ : حدَّثَنَی یَزِیدُ بْنُ نُعَیْمٍ بْنِ ہَزَّالٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ مَاعِزُ بْنُ مَالِکٍ فِی حَجْرِ أَبِی ، فَأَصَابَ جَارِیَۃً مِنَ الْحَیِّ ، فَقَالَ لَہُ أَبِی : إِئْتِ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبِرْہُ بِمَا صَنَعْتَ ، یَسْتَغْفِرْ لَکَ ، وَإِنَّمَا یُرِیدُ بِذَلِکَ لِیَجْعَلَ لَہُ مَخْرَجًا ، فَأَتَاہُ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی قَدْ زَنَیْت فَأَقِمْ عَلَیَّ کِتَابَ اللہِ ، فَأَعْرَضَ عَنْہُ ، ثُمَّ أَتَاہُ ، حَتَّی ذَکَرَ أَرْبَعَ مِرَارٍ ، ثُمَّ أَتَاہُ الرَّابِعَۃَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی قَدْ زَنَیْت فَأَقِمْ عَلَیَّ کِتَابَ اللہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلَیْسَ قَدْ قُلْتَہَا أَرْبَعَ مَرَّاتٍ ، فَبِمَنْ ؟ قَالَ : بِفُلاَنَۃٍ ، قَالَ : ہَلْ ضَاجَعْتہَا ؟ قَالَ : نَعَمْ ، قَالَ : ہَلْ بَاشَرْتَہَا ؟ قَالَ : نَعَمْ ، قَالَ : ہَلْ جَامَعْتہَا ؟ قَالَ : نَعَمْ ، قَالَ : فَأَمَرَ بِہِ لِیُرْجَمَ ، فَأُخْرِجَ إِلَی الْحَرَّۃِ ، فَلَمَّا وَجَدَ مَسَّ الْحِجَارَۃِ خَرَجَ یَشْتَدُّ، فَلَقِیَہُ عَبْدُ اللہِ بْنُ أُنَیْسٍ وَقَدْ أَعْجَزَ أَصْحَابَہُ ، فَانْتَزَعَ لَہُ بِوَظِیفِ بَعِیرٍ ، فَرَمَاہُ بِہِ فَقَتَلَہُ ، ثُمَّ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ ذَلِکَ لَہُ ، فَقَالَ : ہَلاَّ تَرَکْتُمُوہُ ، لَعَلَّہُ یَتُوبُ ، فَیَتُوبَ اللَّہُ عَلَیْہِ ؟۔ (ابوداؤد ۴۴۱۸۔ احمد ۲۱۷)","Hasan","Musannaf Ibn Abi Shaybah 29362","","","كتاب أقضية رسول الله ﷺ"
"29363","(۲۹۳۶۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : جَائَ مَاعِزُ بْنُ مَالِکٍ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنِّی قَدْ زَنَیْتَ ، فَأَعْرَضَ عَنْہُ حَتَّی أَتَاہُ أَرْبَعَ مِرَارٍ ، فَأَمَرَ بِہِ أَنْ یُرْجَمَ ، فَلَمَّا أَصَابَتْہُ الْحِجَارَۃُ أَدْبَرَ یَشْتَدُّ ، فَلَقِیَہُ رَجُلٌ بِیَدِہِ لَحْیُ جَمَلٍ ، فَضَرَبَہُ فَصَرَعَہُ ، فَذُکِرَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِرَارُہُ حِینَ مَسَّتْہُ الْحِجَارَۃُ ، قَالَ : فَہَلاَّ تَرَکْتُمُوہُ۔ (بخاری ۵۲۷۲۔ مسلم ۱۶)","Hasan","Musannaf Ibn Abi Shaybah 29363","","","كتاب أقضية رسول الله ﷺ"
"29364","(۲۹۳۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنِ ابْنِ أَبْزَی ، عَنْ أَبِی بَکْرٍ ، قَالَ : أَتَی مَاعِزُ بْنُ مَالِکٍ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَقَرَّ عَندَہُ ثَلاَثَ مَرَّاتٍ ، فَقُلْتُ : إِنْ أَقْرَرْتَ عَندَہُ الرَّابِعَۃَ ، فَأَمَرَ بِہِ فَحُبِسَ ، یَعْنِی یُرْجَمُ۔ (احمد ۸۔ ابویعلی ۳۶)","Da'if","Musannaf Ibn Abi Shaybah 29364","","","كتاب أقضية رسول الله ﷺ"
"29365","(۲۹۳۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : شَہِدَ مَاعِزٌ عَلَی نَفْسِہِ أَرْبَعَ مَرَّاتٍ أَنَّہُ قَدْ زَنَی ، فَأَمَرَ بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُرْجَمَ۔","","Musannaf Ibn Abi Shaybah 29365","","","كتاب أقضية رسول الله ﷺ"
"29366","(۲۹۳۶۶) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ أُتِیَ بِمَاعِزِ بْنِ مَالِکٍ ، أُتِیَ بِرَجُلٍ أَشْعَرَ ذِی عَضَلاَتٍ ، فِی إِزَارِہِ ، فَرَدَّہُ مَرَّتَیْنِ، ثُمَّ أَمَرَ بِرَجْمِہِ۔ (مسلم ۱۳۲۰۔ ابوداؤد ۴۴۲۲)","Hasan","Musannaf Ibn Abi Shaybah 29366","","","كتاب أقضية رسول الله ﷺ"
"29367","(۲۹۳۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا بَشِیرُ بْنِ الْمُہَاجِرٍ ، قَالَ : حَدَّثَنَی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ مَاعِزَ بْنَ مَالِکٍ الأَسْلَمِیَّ أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنِّی قَدْ ظَلَمْتُ نَفْسِی وَزَنَیْتُ ، وَإِنِّی أُرِیدُ أَنْ تُطَہِّرَنِی ، فَرَدَّہُ ، فَلَمَّا کَانَ الْغَدُ أَتَاہُ أَیْضًا ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی قَدْ زَنَیْتُ ، فَرَدَّہُ الثَّانِیَۃَ ، فَأَرْسَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی قَوْمِہِ ، فَقَالَ : أَتَعْلَمُونَ بِعَقْلِہِ بَأْسًا ؟ تُنْکِرُونَ مِنْہُ شَیْئًا ؟ فَقَالُوا : لاَ نَعْلَمُہُ إِلاَّ وَفِی الْعَقْلِ مِنْ صَالِحِینَا فِیمَا نُرَی ، قَالَ : فَأَتَاہُ الثَّالِثَۃَ ، فَأَرْسَلَ إِلَیْہِمْ أَیْضًا ، فَسَأَلَ عَنْہُ ؟ فَأَخْبَرُوہُ أَنَّہُ لاَ بَأْسَ بِہِ ، وَلاَ بِعَقْلِہِ ، فَلَمَّا کَانَ الرَّابِعَۃُ ، حَفَرَ لَہُ حُفْرَۃً ، ثُمَّ أَمَرَ بِہِ فَرُجِمَ۔ (مسلم ۱۳۲۳۔ ابوداؤد ۴۴۳۲)","Da'if","Musannaf Ibn Abi Shaybah 29367","","","كتاب أقضية رسول الله ﷺ"
"29368","(۲۹۳۶۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ دَاوُد ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : جَائَ مَاعِزُ بْنُ مَالِکٍ فَاعْتَرَفَ بِالزِّنَی ثَلاَثَ مَرَّاتٍ ، فَسَأَلَ عَنْہُ ؟ ثُمَّ أَمَرَ بِہِ فَرُجِمَ ، فَرَمَیْنَاہُ بِالْخَزَفِ ، وَالْجَنْدَلِ ، وَالْعِظَامِ ، وَمَا حَفَرْنَا لَہُ ، وَلاَ أَوْثَقْنَاہُ ، فَسَبَقْنَا إِلَی الْحَرَّۃِ وَاتَّبَعَناہُ ، فَقَامَ إِلَیْنَا ، فَرَمَیْنَاہُ حَتَّی سَکَتَ ، فَمَا اسْتَغْفَرَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ سَبَّہُ۔ (مسلم ۱۳۲۱۔ ابوداؤد ۴۴۲۹)","Sahih","Musannaf Ibn Abi Shaybah 29368","","","كتاب أقضية رسول الله ﷺ"
"29369","(۲۹۳۶۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْمُغِیرَۃِ الطَّائِفِیِّ ، عَنِ ابْنِ شَدَّادٍ ، عَنْ أَبِی ذَرٍّ ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَجَائَ رَجُلٌ فَأَقَرَّ أَنَّہُ قَدْ زَنَی ، فَرَدَّہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثًا ، فَلَمَّا کَانَتِ الرَّابِعَۃُ وَنَزَلَ ، أَمَرَ بِہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرُجِمَ ، وَشَقَّ ذَلِکَ عَلَیْہِ حَتَّی عَرَفْتُہَ فِی وَجْہِہِ ، فَلَمَّا سُرِّیَ عَنْہُ الْغَضَبُ ، قَالَ : یَا أَبَا ذَرٍّ ، إِنَّ صَاحِبَکُمْ قَدْ غُفِرَ لَہُ ، قَالَ : وَکَانَ یُقَالُ : إِنَّ تَوْبَتَہُ أَنْ یُقَامَ عَلَیْہِ الْحَدُّ۔ (احمد ۱۱۹۔ طحاوی ۱۴۲)","Da'if","Musannaf Ibn Abi Shaybah 29369","","","كتاب أقضية رسول الله ﷺ"
"29370","(۲۹۳۷۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قُلْتُ لَہُ : رَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، قُلْتُ : بَعْدَ مَا أُنْزِلَتْ سُورَۃُ النُّورِ ، أَوْ قَبْلَہَا ؟ قَالَ : لاَ أَدْرِی۔\n(بخاری ۶۸۱۳۔ مسلم ۱۳۲۸)","Sahih","Musannaf Ibn Abi Shaybah 29370","","","كتاب أقضية رسول الله ﷺ"
"29371","(۲۹۳۷۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عُمَرُ : قَدْ خَشِیت أَنْ یَطُولَ بِالنَّاسِ زَمَانٌ حَتَّی یَقُولَ الْقَائِلُ : مَا نَجِدُ الرَّجْمَ فِی کِتَابِ اللہِ ، فَیَضِلُّوا بِتَرْکِ فَرِیضَۃٍ أَنْزَلَہَا اللَّہُ ، أَلاَ وَإِنَّ الرَّجْمَ حَقٌّ ، إِذَا أُحْصِنَ الرَّجُل ، أَوْ قَامَتِ الْبَیِّنَۃُ ، أَوْ کَانَ حَمْلٌ ، أَوِ اعْتِرَافٌ ، وَقَدْ قَرَأْتُہَا : {الشَّیْخُ وَالشَّیْخَۃُ إِذَا زَنَیَا فَارْجُمُوہُمَا الْبَتَّۃَ}۔ \n رَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرَجَمْنَا بَعْدَہُ۔\n قِیلَ لِسُفْیَانَ : رَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ۔ (بخاری ۲۸۲۹۔ مسلم ۱۳۱۷)","Sahih","Musannaf Ibn Abi Shaybah 29371","","","كتاب أقضية رسول الله ﷺ"
"29372","(۲۹۳۷۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُہُ عَنِ الرَّجُلِ یُقِرُّ بِالزِّنَی ، کَمْ یُرَدُّ ؟ قَالَ : مَرَّۃً ، وَسَأَلْتُ الْحَکَمَ ؟ فَقَالَ : أَرْبَعَ مَرَّاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29372","","","كتاب أقضية رسول الله ﷺ"
"29373","(۲۹۳۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ مَاعِزَ بْنَ مَالِکٍ أَتَی أَبَا بَکْرٍ فَأَخْبَرَہُ أَنَّہُ زَنَی ، فَقَالَ لَہُ أَبُو بَکْرٍ : ذَکَرَتَ ہَذَا لأَحَدٍ غَیْرِی ؟ قَالَ : لاَ ، قَالَ لَہُ أَبُو بَکْرٍ : اسْتَتِرْ بِسِتْرِ اللہِ ، وَتُبْ إِلَی اللہِ ، فَإِنَّ النَّاسَ یُعَیِّرُونَ ، وَلاَ یُغَیِّرُونَ ، وَاللَّہُ یَقْبَلُ التَّوْبَۃَ عَن عِبَادِہِ ، فَلَمْ تَقَرَّ نَفْسُہُ، حَتَّی أَتَی عُمَرَ ، فَذَکَرَ مِثْلَ مَا ذکرَ لأَبِی بَکْرٍ ، فَقَالَ لَہُ عُمَرُ : مِثْلَ مَا قَالَ أَبُو بَکْرٍ ، فَلَمْ تَقَرَّ نَفْسُہُ حَتَّی أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ أَنَّہُ قَدْ زَنَی ، فَأَعْرَضَ عَنْہُ ، حَتَّی قَالَ لَہُ ذَلِکَ مِرَارًا ، فَلَمَّا أَکْثَرَ ، بَعَثَ إِلَی قَوْمِہِ ، فَقَالَ لَہُمْ : ہَلَ اشْتَکَی ؟ أَبِہِ جِنَّۃٌ ؟ فَقَالُوا : لاَ وَاللَّہِ یَا رَسُولَ اللہِ ، إِنَّہُ صَحِیحٌ ، قَالَ : أَبِکْرٌ ، أَمْ ثَیِّبٌ ؟ قَالُوا : بَلْ ثَیِّبٌ ، فَأَمَرَ بِہِ فَرُجِمَ۔ (عبدالرزاق ۱۳۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 29373","","","كتاب أقضية رسول الله ﷺ"
"29374","(۲۹۳۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، قَالَ : رَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَرَجَمَ أَبُو بَکْرٍ ، وَرَجَمْتُ۔ (ترمذی ۱۴۳۱۔ مالک ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 29374","","","كتاب أقضية رسول الله ﷺ"
"29375","(۲۹۳۷۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَشْعَثَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ یُوسُفَ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عُمَرُ : الرَّجْمُ حَدٌّ مِنْ حُدُودِ اللہِ ، فَلاَ تُخْدَعُوا عَنْہُ ، وَآیۃُ ذَلِکَ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ ، وَرَجَمَ أَبُو بَکْرٍ ، وَرَجَمْتُ أَنَا۔ (طیالسی ۲۵۔ عبدالرزاق ۱۳۳۶۴)","Da'if","Musannaf Ibn Abi Shaybah 29375","","","كتاب أقضية رسول الله ﷺ"
"29376","(۲۹۳۷۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی عُثْمَانَ بْنِ نَصْرٍ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ فِیمَنْ رَجَمَ مَاعِزًا ، فَلَمَّا وَجَدَ مَسَّ الْحِجَارَۃِ ، قَالَ : رُدُّونِی إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَنْکَرْتُ ذَلِکَ ، فَأَتَیْتُ عَاصِمَ بْنَ عُمَرَ ، فَقَالَ : قَالَ الْحَسَنُ بْنُ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ : لَقَدْ بَلَغَنِی، فَأَنْکَرْتہ، فَأَتَیْتُ جَابِرًا، فَقُلْت: لَقَدْ ذَکَرَ الأَسْلَمِیُّ شَیْئًا مِنْ قَوْلِ مَاعِزِ بْنِ مَالِکٍ: رُدَّونِی، فَأَنْکَرْتُہُ، فَقَالَ: أَنَا فِیمَنْ رَجَمَہُ ، فَقَالَ: إِنَّہُ وَجَدَ مَسَّ الْحِجَارَۃِ ، قَالَ: رُدّونِی إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَإِنَّ قَوْمِی آذَوْنِی ، وَقَالُوا : ائْتِ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَإِنَّہُ غَیْرُ قَاتِلِکَ ، فَمَا أَقْلَعْنَا عَنْہُ حَتَّی قَتَلْنَاہُ ، فَلَمَا ذُکِرَ شَأْنُہُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَلاَ تَرَکْتُمُوہُ حَتَّی أَنْظُرَ فِی شَأْنِہِ۔\n(نسائی ۷۲۰۶۔ احمد ۴۳۱)","Da'if","Musannaf Ibn Abi Shaybah 29376","","","كتاب أقضية رسول الله ﷺ"
"29377","(۲۹۳۷۷) حَدَّثَنَا ہَوْذَۃُ بْنُ خَلِیفَۃَ ، قَالَ : حدَّثَنَا عَوْفٌ ، عَنْ مُسَاوِرِ بْنِ عُبَیْدٍ ، عَنْ أَبِی بَرْزَۃَ ،قَالَ : رَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً مِنَّا ، یُقَالُ لَہُ : مَاعِزُ بْنُ مَالِکٍ۔ (احمد ۴۲۳۔ بزار ۳۸۵۵)","Da'if","Musannaf Ibn Abi Shaybah 29377","","","كتاب أقضية رسول الله ﷺ"
"29378","(۲۹۳۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، عَنْ مُحَمَّدِ بْنِ سُلَیْمٍ أَبِی ہِلاَلٍ ، عَنْ نَجِیحٍ أَبِی عَلِی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : رَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَرَجَمَ أَبُو بَکْرٍ ، وَعُمَرُ وَأَمْرُہُمَا سُنَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 29378","","","كتاب أقضية رسول الله ﷺ"
"29379","(۲۹۳۷۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ یَزِیدَ بْنِ نُعَیْمٍ ، عَنْ أَبِیہِ ،قَالَ : جَائَ مَاعِزُ بْنُ مَالِکٍ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی قَدْ زَنَیْتُ فَأَقِمْ فِیَّ کِتَابَ اللہِ ، فَأَعْرَضَ عَنْہُ ، ثُمَّ قَالَ : إِنِّی قَدْ زَنَیْتُ ، فَأَقِمْ فِیَّ کِتَابَ اللہِ ، فَأَعْرَضَ عَنْہُ حَتَّی ذَکَرَ أَرْبَعَ مَرَّاتٍ ، قَالَ : اذْہَبُوا فَارْجُمُوہُ ، فَلَمَّا مَسَّہُ مَسَّ الْحِجَارَۃُ اشْتَدَّ ، فَخَرَجَ عَبْدُ اللہِ بْنُ أُنَیْسٍ ، أَوِ ابْنُ أَنَسٍ ، مِنْ بَادِیَتِہِ ، فَرَمَاہُ بِوَظِیفِ جَمَلٍ فَصَرَعَہُ ، فَرَمَاہُ النَّاسُ حَتَّی قَتَلُوہُ ، فَذُکِرَ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِرَارُہُ ، فَقَالَ : ہَلاَّ تَرَکْتُمُوہُ یَتُوبُ ، فَیَتُوبَ اللَّہُ عَلَیْہِ ، یَا ہَزَّالُ ، أَوْ یَا ہِزَّانُ ، لَوْ سَتَرْتَہُ بِثَوْبِکَ ؛ کَانَ خَیْرًا لَکَ مِمَّا صَنَعْتَ۔ (بیہقی ۲۱۹۔ احمد ۲۱۷)","Hasan","Musannaf Ibn Abi Shaybah 29379","","","كتاب أقضية رسول الله ﷺ"
"29380","(۲۹۳۸۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، وَزَیْدِ بْنِ خَالِدٍ ، وَشِبْلٍ ؛ أَنَّہُمْ قَالُوا :\n کُنَّا عَندَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَامَ رَجُلٌ ، فَقَالَ : أُنْشِدُک اللَّہَ إِلاَ قَضَیْتَ بَیْنَنَا بِکِتَابِ اللہِ ، فَقَالَ : خَصْمُہُ ، وَکَانَ أَفْقَہَ مِنْہُ: اقْضِ بَیْنَنَا بِکِتَابِ اللہِ ، وَائْذَنْ لِی حَتَّی أَقُولَ، قَالَ: قُلْ، قَالَ: إِنَّ ابْنِی کَانَ عَسِیفًا عَلَی ہَذَا ، وَإِنَّہُ زَنَی بِامْرَأَتِہِ ، فَافْتَدَیْتُ مِنْہُ بِمِئَۃِ شَاۃٍ وَخَادِمٍ ، فَسَأَلْتُ رِجَالاً مِنْ أَہْلِ الْعِلْمِ ؟ فَأُخْبِرْتُ أَنَّ عَلَی ابْنِی جَلْدَ مِئَۃٍ وَتَغْرِیبَ عَامٍ ، وَأَنَّ عَلَی امْرَأَۃِ ہَذَا الرَّجْمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَالَّذِی نَفْسِی بِیَدِہِ ، لأَقْضِیَنَّ بَیْنَکُمَا بِکِتَابِ اللہِ ، الْمِئَۃُ شَاۃٍ وَالْخَادِمُ رَدٌّ عَلَیْک ، وَعَلَی ابْنِکَ جَلْدُ مِئَۃٍ وَتَغْرِیبُ عَامٍ، وَاغْدُ یَا أُنَیْسُ عَلَی امْرَأَۃِ ہَذَا، فَإِنَ اعْتَرَفْت فَارْجُمْہَا۔(بخاری ۲۳۱۵۔ ابن ماجہ ۲۵۴۹)","Sahih","Musannaf Ibn Abi Shaybah 29380","","","كتاب أقضية رسول الله ﷺ"
"29381","(۲۹۳۸۱) حَدَّثَنَا شَبَابَۃُ بْنُ سوَّارٍ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذُوا عَنِی ، قَدْ جَعَلَ اللَّہُ لَہُنَّ سَبِیلاً ، الثَّیِّبُ بِالثَّیِّبِ ، وَالْبِکْرُ بِالْبِکْرِ ، الْبِکْرُ یُجْلَدُ وَیُنْفَی ، وَالثَّیِّبُ یُجْلَدُ وَیُرْجَمُ۔ (مسلم ۱۳۔ ابوداؤد ۴۴۱۵)","Sahih","Musannaf Ibn Abi Shaybah 29381","","","كتاب أقضية رسول الله ﷺ"
"29382","(۲۹۳۸۲) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ ، عنْ أُبَیٍّ ، قَالَ : إِذَا زَنَی الْبِکْرَانِ یُجْلَدَانِ وَیُنْفَیَانِ ، وَإِذَا زَنَی الثَّیِّبَانِ یُجْلَدَانِ وَیُرْجَمَانِ۔","Hasan","Musannaf Ibn Abi Shaybah 29382","","","كتاب أقضية رسول الله ﷺ"
"29383","(۲۹۳۸۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ إِسْمَاعِیلَ، عَنِ الشَّعْبِیِّ، عَنْ أُبَیٍّ؛ أَنَّہُ کَانَ یَرَی فِی الثَّیِّبِ یُجْلَدُ وَیُرْجَمُ۔","","Musannaf Ibn Abi Shaybah 29383","","","كتاب أقضية رسول الله ﷺ"
"29384","(۲۹۳۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : الْبِکْرَانِ یُجْلَدَانِ وَیُنْفَیَانِ ، وَالثَّیِّبَانِ یُجْلَدَانِ وَیُرْجَمَانِ۔","","Musannaf Ibn Abi Shaybah 29384","","","كتاب أقضية رسول الله ﷺ"
"29385","(۲۹۳۸۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، وَالشَّیْبَانِیِّ ، وَأَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ عَلِیًا جَلَدَ وَرَجَمَ۔","","Musannaf Ibn Abi Shaybah 29385","","","كتاب أقضية رسول الله ﷺ"
"29386","(۲۹۳۸۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ عُمَرُ یَرْجُمُ وَیَجْلِدُ ، وَکَانَ عَلِیٌّ یَرْجُمُ وَیَجْلِدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29386","","","كتاب أقضية رسول الله ﷺ"
"29387","(۲۹۳۸۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ، قَالَ : قَالَ أَبُو ذَرٍّ : الشَّیْخَانِ الثَّیِّبَانِ یُجْلَدَانِ وَیُرْجَمَانِ، وَالْبِکْرَانِ یُجْلَدَانِ وَیُنْفَیَانِ۔","","Musannaf Ibn Abi Shaybah 29387","","","كتاب أقضية رسول الله ﷺ"
"29388","(۲۹۳۸۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ، عَنْ أَبِیہِ، قَالَ: عَلَی الْمُحْصَنِ إِذَا زَنَی الرَّجْمُ، وَعَلَی الْبِکْرِ الْجَلْدُ وَالنَّفْیُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29388","","","كتاب أقضية رسول الله ﷺ"
"29389","(۲۹۳۸۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنْ عَامِرٍ ؛ فِی الْبِکْرِ إِذَا زَنَی یُنْفَی سَنَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 29389","","","كتاب أقضية رسول الله ﷺ"
"29390","(۲۹۳۹۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا جَلَدَ وَرَجَمَ، جَلَدَ یَوْمَ الْخَمِیسِ ، وَرَجَمَ یَوْمَ الْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 29390","","","كتاب أقضية رسول الله ﷺ"
"29391","(۲۹۳۹۱) حَدَّثَنَا شَاذَانُ ، وَعَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَن سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ مَاعِزَ بْنَ مَالِکٍ ، وَلَمْ یَذْکُرْ جَلْدًا۔ (احمد ۹۲۔ طبرانی ۱۹۶۷)","Hasan","Musannaf Ibn Abi Shaybah 29391","","","كتاب أقضية رسول الله ﷺ"
"29392","(۲۹۳۹۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ بِنْتِ أَبِی عُبَیْدٍ ، عَنْ أَبِی بَکْرٍ ؛ أَنَّہُ جَلَدَ رَجُلاً وَقَعَ عَلَی جَارِیَۃٍ بِکْرٍ ، فَأَحْبَلَہَا ، فَاعْتَرَفَ ، وَلَمْ یَکُنْ أُحْصِنَ ، فَأَمَرَ بِہِ أَبُو بَکْرٍ فَجُلِدَ ، ثُمَّ نُفِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 29392","","","كتاب أقضية رسول الله ﷺ"
"29393","(۲۹۳۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن زَیْدِ بْنِ أَسْلَمَ ، عْن أَبِیہِ ؛ أَنَّ عُمَرَ نَفَی إِلَی فَدَکَ۔","Sahih","Musannaf Ibn Abi Shaybah 29393","","","كتاب أقضية رسول الله ﷺ"
"29394","(۲۹۳۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ ابْنِ یَسَارٍ مَوْلًی لِعُثْمَانَ ، قَالَ : جَلَدَ عُثْمَانُ امْرَأَۃً فِی زِنًا ، ثُمَّ أَرْسَلَ بِہَا مَوْلًی لَہُ ، یُقَالُ لَہُ : الْمُہْرِیُّ ، إِلَی خَیْبَرَ ، فَنَفَاہَا إِلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 29394","","","كتاب أقضية رسول الله ﷺ"
"29395","(۲۹۳۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَیِّ ؛ أَنَّ عَلِیًّا نَفَی إِلَی الْبَصْرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 29395","","","كتاب أقضية رسول الله ﷺ"
"29396","(۲۹۳۹۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الأَجْلَحِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أُتِیَ عَلِیٌّ بِجَارِیَۃٍ مِنْ ہَمْدَانَ ، فَضَرَبَہَا وَسَیَّرَہَا إِلَی الْبَصْرَۃِ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 29396","","","كتاب أقضية رسول الله ﷺ"
"29397","(۲۹۳۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ فِی زَمَنِ ابْنِ ہُبَیْرَۃَ : مِنْ أَیْنَ یُنْفَی فِی الزِّنَی ؟ قَالَ : مِنْ عَمَلِہِ إِلَی عَمِلِ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 29397","","","كتاب أقضية رسول الله ﷺ"
"29398","(۲۹۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَفَی إِلَی خَیْبَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 29398","","","كتاب أقضية رسول الله ﷺ"
"29399","(۲۹۳۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ أَبَا بَکْرٍ نَفَی رَجُلاً وَامْرَأَۃً حَوْلاً۔","","Musannaf Ibn Abi Shaybah 29399","","","كتاب أقضية رسول الله ﷺ"
"29400","(۲۹۴۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ عُمَرَ نَفَی إِلَی الْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 29400","","","كتاب أقضية رسول الله ﷺ"
"29401","(۲۹۴۰۱) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا أَبِی عِمْرَانَ ، قَالَ : سَمِعْتُ شَیْخًا یُحَدِّثُ ، عَنِ ابْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ امْرَأَۃً فَحَفَرَ إِلَی الثَّنْدُوَۃِ۔ (ابوداؤد ۴۴۴۰۔ احمد ۳۶)","Da'if","Musannaf Ibn Abi Shaybah 29401","","","كتاب أقضية رسول الله ﷺ"
"29402","(۲۹۴۰۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَن مُجَالِدٍ ، عَنْ عَامِرٍ ؛ أَنَّ عَلِیًّا رَجَمَ امْرَأَۃً ، فَحَفَرَ لَہَا إِلَی السُّرَّۃِ ، وَأَنَا شَاہِد ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 29402","","","كتاب أقضية رسول الله ﷺ"
"29403","(۲۹۴۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حَدَّثَنَا بَشِیرُ بْنُ الْمُہَاجِرِ ، قَالَ : حدَّثَنَی عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَتْہُ الْغَامِدِیَّۃُ ، فَأَقَرَّتْ عَندَہُ بِالزِّنَی ، فَأَمَرَ بِہَا ، فَحُفِرَ لَہَا إِلَی صَدْرِہَا ، وَأَمَرَ النَّاسَ فَرَجَمُوا ، ثُمَّ أَمَرَ بِہَا فَصُلِّیَ عَلَیْہَا ، ثُمَّ دُفِنَتْ۔ (مسلم ۱۳۲۳۔ ابوداؤد ۴۴۳۹)","","Musannaf Ibn Abi Shaybah 29403","","","كتاب أقضية رسول الله ﷺ"
"29404","(۲۹۴۰۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنِ الْحَسَنِ ، قَالَ : جَائَتِ امْرَأَۃٌ مِنْ بَارِقَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إِنِّی قَدْ زَنَیْت فَأَقِمْ فِیَّ حَدَّ اللہِ ، قَالَ : فَرَدَّہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی شَہِدَتْ عَلَی نَفْسِہَا شَہَادَاتٍ ، قَالَ : فَقَالَ لَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ارْجِعِی ، فَلَمَّا وَضَعَتْ حَمْلَہَا أَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَتَطَہَّرَتْ ، وَلَبِسَتْ أَکْفَانَہَا ، ثُمَّ أُمِرَ بِہَا فَرُجِمَتْ ، فَأَصَابَ خَالِدَ بْنَ الْوَلِیدِ مِنْ دَمِہَا فَسَبَّہَا ، فَنَہَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لَقَدْ تَابَتْ تَوْبَۃً لَوْ تَابَہَا صَاحِبُ مَکْسٍ لَقُبِلَ مِنْہُ۔ (ابوداؤد ۲۴۹)","Hasan","Musannaf Ibn Abi Shaybah 29404","","","كتاب أقضية رسول الله ﷺ"
"29405","(۲۹۴۰۵) حَدَّثَنَا ابْنُ نُمَیْرٍ، قَالَ: حدَّثَنَا بَشِیرُ بْنُ مُہَاجِرٍ ، قَالَ: حَدَّثَنَا عَبْدُ اللہِ بْنُ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : جَائَتِ الْغَامِدِیَّۃُ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إِنِّی قَدْ زَنَیْتُ ، وَإِنِّی أُرِیدُ أَنْ تُطَہِّرَنِی ، وَإِنَّہُ رَدَّہَا ، فَلَمَّا کَانَ الْغَدُ ، قَالَتْ : یَا نَبِیَّ اللہِ ، لِمَ تَرُدَّنِی ؟ فَلَعَلَّک أَنْ تُرَدِّدَنِی کَمَا رَدَّدْتَ مَاعِزَ بْنَ مَالِکٍ ، فَوَاللَّہِ إِنِّی لِحُبْلَی ، قَالَ : إِمَّا لاَ ، فَاذْہَبِی حَتَّی تَلِدِی ، فَلَمَّا وَلَدَتْ أَتَتْہُ بِالصَّبِیِّ فِی خِرْقَۃٍ ، قَالَتْ : ہَذَا قَدْ وَلَدْتُہُ ، قَالَ : اذْہَبِی فَأَرْضِعِیہِ ، حَتَّی تَفْطِمِیہِ ، فَلَمَّا فَطَمَتْہُ أَتَتْہُ بِالصَّبِیِّ ، وَفِی یَدِہِ کِسْرَۃُ خُبْزٍ ، فَقَالَتْ : ہَذَا یَا نَبِیَّ اللہِ قَدْ فَطَمْتُہُ ، وَقَدْ أَکَلَ الطَّعَامَ ، فَدُفَعَ الصَّبِیَّ إِلَی رَجُلٍ مِنَ الْمُسْلِمِینَ ، ثُمَّ أَمَرَ بِہَا فَحُفِرَ لَہَا إِلَی صَدْرِہَا ، وَأَمَرَ النَّاسَ فَرَجَمُوا ، فَأَقْبَلَ خَالِدُ بْنُ الْوَلِیدِ بِحَجَرٍ فَرَمَی رَأْسَہَا ، فَانْتَضَخَ الدَّمُ عَلَی وَجْہِ خَالِدِ بْنِ الْوَلِیدِ ، فَسَمِعَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَبَّہُ إِیَّاہَا ، فَقَالَ : مَہْلاً یَا خَالِدُ بْنَ الْوَلِیدِ ، فَوَالَّذِی نَفْسِی بِیَدِہِ ، لَقَدْ تَابَتْ تَوْبَۃً لَوْ تَابَہَا صَاحِبُ مَکْسٍ لَغُفِرَ لَہُ ، ثُمَّ أَمَرَ بِہَا فَصُلَّیَ عَلَیْہَا وَدُفِنَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 29405","","","كتاب أقضية رسول الله ﷺ"
"29406","(۲۹۴۰۶) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، قَالَ : حَدَّثَنَی یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ امْرَأَۃً مِنْ جُہَیْنَۃَ أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إِنِّی أَصَبْتُ حَدًّا فَأَقِمْہُ عَلَیَّ ، وَہِیَ حَامِلٌ ، فَأَمَرَ بِہَا أَنْ یُحْسَنَ إِلَیْہَا حَتَّی تَضَعَ ، فَلَمَّا أَنْ وَضَعَتْ ، جِیئَ بِہَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَ بِہَا ، فَشُکَّتْ عَلَیْہَا ثِیَابُہَا ، ثُمَّ رَجَمَہَا وَصَلَّی عَلَیْہَا ، فَقَالَ عُمَرُ : یَا نَبِیَّ اللہِ ، أَتُصَلِّی عَلَیْہَا وَقَدْ زَنَتْ ؟ فَقَالَ : لَقَدْ تَابَتْ تَوْبَۃً لَوْ قُسِمَتْ بَیْنَ سَبْعِینَ مِنْ أَہْلِ الْمَدِینَۃِ لَوَسِعَتْہُمْ ، وَہَلْ وَجَدْتَ أَفْضَلَ مِنْ أَنْ جَادَتْ بِنَفْسِہَا۔ (مسلم ۱۳۲۴۔ ابوداؤد ۴۴۳۷)","Sahih","Musannaf Ibn Abi Shaybah 29406","","","كتاب أقضية رسول الله ﷺ"
"29407","(۲۹۴۰۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، قَالَ : أُتِیَ عَلِیٌّ بِشُرَاحَۃَ ، امْرَأَۃٍ مِنْ ہَمْدَانَ ، وَہِیَ حُبْلَی مِنْ زِنًی ، فَأَمَرَ بِہَا عَلِیٌّ فَحُبِسَتْ فِی السِّجْنِ ، فَلَمَّا وَضَعَتْ مَا فِی بَطْنِہَا ، أَخْرَجَہَا یَوْمَ الْخَمِیسِ ، فَضَرَبَہَا مِئَۃ سَوْطٍ ، وَرَجَمَہَا یَوْمَ الْجُمُعَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 29407","","","كتاب أقضية رسول الله ﷺ"
"29408","(۲۹۴۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ أَشْیَاخِہِ ؛ أَنَّ امْرَأَۃً غَابَ عنہا زَوْجُہَا ، ثُمَّ جَائَ وَہِیَ حَامِلٌ ، فَرَفَعَہَا إِلَی عُمَرَ ، فَأَمَرَ بِرَجْمِہَا ، فَقَالَ مُعَاذٌ : إِنْ یَکُنْ لَکَ عَلَیْہَا سَبِیلٌ ، فَلاَ سَبِیلَ لَکَ عَلَی مَا فِی بَطْنِہَا ، فَقَالَ عُمَرُ : احْبِسُوہَا حَتَّی تَضَعَ ، فَوَضَعَتْ غُلاَمًا لَہُ ثَنِیَّتَانِ ، فَلَمَّا رَآہُ أَبُوہُ ، قَالَ : ابْنِی ، ابْنِی ، فَبَلَغَ ذَلِکَ عُمَرَ ، فَقَالَ : عَجَزَتِ النِّسَائُ أَنْ تَلِدْنَ مِثْلَ مُعَاذٍ ، لَوْلاَ مُعَاذٌ ہَلَکَ عُمَرُ۔","Da'if","Musannaf Ibn Abi Shaybah 29408","","","كتاب أقضية رسول الله ﷺ"
"29409","(۲۹۴۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَن بْن سَعْدٍ ، عَنْ عَبْدِ الرَّحَمَن بْنِ عَبْدِ اللہِ ، قَالَ : أُتِیَ عَلِیٌّ بِامْرَأَۃٍ قَدْ زَنَتْ ، فَحَبَسَہَا حَتَّی وَضَعَتْ وَتَعَلَّتْ مِنْ نِفَاسہَا۔","","Musannaf Ibn Abi Shaybah 29409","","","كتاب أقضية رسول الله ﷺ"
"29410","(۲۹۴۱۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 29410","","","كتاب أقضية رسول الله ﷺ"
"29411","(۲۹۴۱۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ سِمَاکٍ ، قَالَ : حدَّثَنِی ذُہلُ بْنُ کَعْبٍ ، قَالَ : أَرَادَ عُمَرُ أَنْ یَرْجُمَ الْمَرْأَۃَ الَّتِی فَجَرَتْ وَہِیَ حَامِلٌ ، فَقَالَ لَہُ مُعَاذٌ : إِذًا تَظْلِمُہَا ، أَرَأَیْتَ الَّذِی فِی بَطْنِہَا ، مَا ذَنْبُہُ ؟ عَلاَمَ تَقْتُلْ نَفْسَیْنِ بِنَفْسٍ وَاحِدَۃٍ ؟ فَتَرَکَہَا حَتَّی وَضَعَتْ حَمْلَہَا ، ثُمَّ رَجَمَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 29411","","","كتاب أقضية رسول الله ﷺ"
"29412","(۲۹۴۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْمِنْہَالِ ، عَنْ زَاذَانَ ؛ أَنَّ عَلِیًّا أَمَرَ بِہَا فَلُفَّتْ فِی عَبَائِۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29412","","","كتاب أقضية رسول الله ﷺ"
"29413","(۲۹۴۱۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ صَالِحِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعِیدِ الْہَمْدَانِیِّ ، عَنْ مَسْعُودٍ ، رَجُلٍ مِنْ آلِ أَبِی الدَّرْدَائِ ؛ أَنَّ عَلِیًّا لَمَّا رَجَمَ شُرَاحَۃَ ، جَعَلَ النَّاسُ یَلْعَنُونَہَا ، فَقَالَ : أیُّہَا النَّاسُ ، لاَ تَلْعَنُوہَا ، فَإِنَّہُ مَنْ أُقِیمَ عَلَیْہِ عَصَا حَدٍّ ، فَہُوَ کَفَّارَتُہُ ، جَزَائَ الدَّیْن بِالدَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 29413","","","كتاب أقضية رسول الله ﷺ"
"29414","(۲۹۴۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا کَانَ إِذَا شَہِدَ عَندَہُ الشُّہُودُ عَلَی الزِّنَی ، أَمَرَ الشُّہُودَ أَنْ یَرْجُمُوا ، ثُمَّ رَجَمَ ، ثُمَّ رَجَمَ النَّاسُ ، وَإِذَا کَانَ إِقْرَارًا ، بَدَأَ ہُوَ فَرَجَمَ، ثُمَّ رَجَمَ النَّاسُ۔","Da'if","Musannaf Ibn Abi Shaybah 29414","","","كتاب أقضية رسول الله ﷺ"
"29415","(۲۹۴۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، عَنْ عَلِیٍّ ، قَالَ : أَیُّہَا النَّاسُ ، إِنَّ الزِّنَی زِنَائَانِ : زِنَی سِرٍّ ، وَزِنَی عَلاَنِیَۃٍ ، فَزِنَی السِّرِّ ، أَنْ یَشْہَدَ الشُّہُودُ فَتَکُونَ الشُّہُودُ أَوَّلَ مَنْ یَرْمِی ، ثُمَّ الإِمَامُ ، ثُمَّ النَّاسُ ، وَزِنَی الْعَلاَنِیَۃِ ، أَنْ یَظْہَرَ الْحَبَلُ ، أَوِ الاِعْتِرَافُ ، فَیَکُونُ الإِمَامُ أَوَّلَ مَنْ یَرْمِی ، قَالَ : وَفِی یَدِہِ ثَلاَثَۃُ أَحْجَارٍ ، قَالَ : فَرَمَاہَا بِحَجَرٍ فَأَصَابَ صِمَاخَہَا فَاسْتَدَارَتْ ، وَرَمَی النَّاسُ۔","","Musannaf Ibn Abi Shaybah 29415","","","كتاب أقضية رسول الله ﷺ"
"29416","(۲۹۴۱۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 29416","","","كتاب أقضية رسول الله ﷺ"
"29417","(۲۹۴۱۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ نَافِعٍ ، یُحَدِّثُ عَنْ عَلِیٍّ ، قَالَ : الرَّجْمُ رَجْمَانِ ، فَرَجْمٌ یَرْجُمُ الإِمَامُ ، ثُمَّ النَّاسُ ، وَرَجْمٌ یَرْجُمُ الشُّہُودُ ، ثُمَّ الإِمَامُ ، ثُمَّ النَّاسُ ، فَقُلْتُ لِلْحَکَمِ : مَا رَجْمُ الإِمَامِ ؟ قَالَ : إِذَا وَلَدَتْ ، أَوْ أَقَرَّتْ ، وَرَجْمُ الشُّہُودِ إِذَا شَہِدُوا۔","Da'if","Musannaf Ibn Abi Shaybah 29417","","","كتاب أقضية رسول الله ﷺ"
"29418","(۲۹۴۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : قُلْتُ لِلْحَکَمِ : مَا رَجْمُ الإِمَامِ ؟ قَالَ : إِذَا وَلَدَتْ ، أَوْ أَقَرَّتْ ، وَإِذَا شَہِدَ الشُّہُودُ بَدَأَ الشُّہُودُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29418","","","كتاب أقضية رسول الله ﷺ"
"29419","(۲۹۴۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : لَمَّا شَہِدَ أَبُو بَکْرَۃَ وَصَاحِبَاہُ عَلَی الْمُغِیرَۃِ ، جَائَ زِیَادٌ ، فَقَالَ لَہُ عُمَرُ : رَجُلٌ لَنْ یَشْہَدَ إِنْ شَائَ اللَّہُ إِلاَّ بِحَقٍّ ، قَالَ : رَأَیْتُ انْبِہَارًا وَمَجْلِسًا سَیِّئًا ، فَقَالَ عُمَرُ : ہَلْ رَأَیْتَ الْمِرْوَدَ دَخَلَ الْمُکْحُلَۃِ ؟ قَالَ : لاَ ، فَأَمَرَ بِہِمْ فَجُلِدُوا۔","Sahih","Musannaf Ibn Abi Shaybah 29419","","","كتاب أقضية رسول الله ﷺ"
"29420","(۲۹۴۲۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ أُنَاسًا شَہِدُوا عَلَی رَجُلٍ فِی زِنًی ، قَالَ : فَقَالَ عُثْمَانُ بِیَدِہِ ہَکَذَا : تَشْہَدُونَ أَنَّہُ ،وَجَعَلَ یُدْخِلُ إِصْبَعَہُ السَّبَّابَۃَ فِی إِصْبَعِہِ الْیُسْرَی ، وَقَدْ عَقَدَ بِہَا عَشْرًۃ۔","","Musannaf Ibn Abi Shaybah 29420","","","كتاب أقضية رسول الله ﷺ"
"29421","(۲۹۴۲۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ قَسَامَۃَ بْنِ زُہَیْرٍ ، قَالَ : لَمَّا کَانَ مِنْ شَأْنِ أَبِی بَکْرَۃَ وَالْمُغِیرَۃِ بْنِ شُعْبَۃَ الَّذِی کَانَ ، قَالَ أَبُو بَکْرَۃَ : اجْتَنِبْ ، أَوْ تَنَحَّ عَن صَلاَتِنَا ، فَإِنَّا لاَ نُصَلِّی خَلْفَک ، قَالَ : فَکَتَبَ إِلَی عُمَرَ فِی شَأْنِہِ ، قَالَ : فَکَتَبَ عُمَرُ إِلَی الْمُغِیرَۃِ : أَمَّا بَعْدُ ، فَإِنَّہُ قَدْ رَقِیَ إِلَیَّ مِنْ حَدِیثِکَ حَدِیثٌ ، فَإِنْ یَکُنْ مَصْدُوقًا عَلَیْک ، فَلأَنْ تَکُونَ مِتَّ قَبْلَ الْیَوْمِ خَیْرٌ لَکَ ، قَالَ : فَکَتَبَ إِلَیْہِ وَإِلَی الشُّہُودِ ، أَنْ یُقْبِلُوا إِلَیْہِ۔\n فَلَمَّا انْتَہَوْا إِلَیْہِ ، دَعَا الشُّہُودَ فَشَہِدُوا ، فَشَہِدَ أَبُو بَکْرَۃَ ، وَشِبْلُ بْنُ مَعْبَدٍ ، وَأَبُو عَبْدِ اللہِ نَافِعٌ ، قَالَ : فَقَالَ عُمَرُ حِینَ شَہِدَ ہَؤُلاَئِ الثَّلاَثَۃُ : أَوْدَی الْمُغِیرَۃِ أَرْبَعَۃٌ ، وَشَقَّ عَلَی عُمَرَ شَأْنُہُ جِدًّا ، فَلَمَّا قَامَ زِیَادٌ ، قَالَ: لَنْ یَشْہَدْ إِنْ شَائَ اللَّہُ إِلاَّ بِحَقٍّ ، ثُمَّ شَہِدَ ، فَقَالَ : أَمَّا الزِّنَی فَلاَ أَشْہَدُ بِہِ ، وَلَکِنِّی قَدْ رَأَیْتُ أَمْرًا قَبِیحًا، فَقَالَ عُمَرُ : اللَّہُ أَکْبَرُ ، حُدُّوہُمْ ، فَجَلَدَہُمْ ، فَلَمَّا فَرَغَ مِنْ جَلْدِ أَبِی بَکْرَۃَ ، قَامَ أَبُو بَکْرَۃَ ، فَقَالَ : أَشْہَدُ أَنَّہُ زَانٍ ، فَذَہَب عُمَرُ یُعِیدَ عَلَیْہِ الْحَدَّ ، فَقَالَ عَلِیٌّ : إِنْ جَلَدْتَہُ فَارْجُمْ صَاحِبَک ، فَتَرَکَہُ ، فَلَمْ یُجْلَدْ فِی قَذفٍ مَرَّتَیْنِ بَعْدُ۔","","Musannaf Ibn Abi Shaybah 29421","","","كتاب أقضية رسول الله ﷺ"
"29422","(۲۹۴۲۲) حَدَّ??َنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : لَقِیَنِی سَعِیدُ بْنُ أَرْطَبَان ، عَمُّ ابْنِ عَوْنٍ ، فَقَالَ : أَتُرِیدُ أَنْ تَأْتِیَ أَبَا الْعَالِیَۃِ ؟ قُلْتُ : نَعَمْ ، قَالَ : فَقُلْ لَہُ : شَہِدَ الْحَسَنُ ، وَابْنُ سِیرِینَ ، وَثَابِتٌ الْبُنَانِیُّ عَلَی امْرَأَۃٍ وَرَجُلٍ أَنَّہُمَا زَنَیَا ، وَأَقَرَّتِ الْمَرْأَۃُ ، وَأَنْکَرَ الرَّجُلُ ؟ فَسَأَلْتُ أَبَا الْعَالِیَۃِ عَن ذَلِکَ ؟ فَقَالَ : لَقِیْتَ رَجُلاً مِنْ أَہْلِ الأَہْوَائِ ؛ یُجْلَدُ الْحَسَنُ ثَمَانِینَ ، وَمُحَمَّدٌ ثَمَانِینَ ، وَثَابِتٌ ثَمَانِینَ ، وَتُرْجَمُ الْمَرْأَۃُ بِاعْتِرَافِہَا ، وَیَذْہَبُ الرَّجُلُ لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 29422","","","كتاب أقضية رسول الله ﷺ"
"29423","(۲۹۴۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ الْیَہُودَ قَالُوا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا حَدَّ ذَلِکَ ؟ یَعْنونَ الرَّجْمَ ، قَالَ : إِذَا شَہِدَ أَرْبَعَۃٌ أَنَّہُمْ رَأَوْہُ یُدْخِلُ کَمَا یُدْخِلُ الْمِیلُ فِی الْمُکْحُلَۃِ ، فَقَدْ وَجَبَ الرَّجْمُ۔","","Musannaf Ibn Abi Shaybah 29423","","","كتاب أقضية رسول الله ﷺ"
"29424","(۲۹۴۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا شَہِدَ أَرْبَعَۃٌ عَلَی شَیْئٍ ،مَنَعُوا ظُہُورَہُمْ ، وَجَازَتْ شَہَادَاتُہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 29424","","","كتاب أقضية رسول الله ﷺ"
"29425","(۲۹۴۲۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ جَعْفَرٍ، عَنْ أَبِیہِ، قَالَ: قَالَ عَلِّیٌّ: مَا أُحِبَّ أَنْ أَکُونَ أَوَّلَ الشُّہُودِ الأَرْبَعَۃِ۔","","Musannaf Ibn Abi Shaybah 29425","","","كتاب أقضية رسول الله ﷺ"
"29426","(۲۹۴۲۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : أُتِیَ عَلِیٌّ بِرَجُلٍ وَشَہِدَ عَلَیْہِ رَجُلاَنِ أَنَّہُ سَرَقَ ، فَأَخَذَ فِی شَیْء مِنْ أُمُورِ النَّاسِ ، وَتَہَدَّدَ شُہُودَ الزُّورِ ، فَقَالَ : لاَ أُوتَی بِشَاہِدِ زُورٍ إِلاَّ فَعَلْتُ بِہِ کَذَا وَکَذَا ، قَالَ : ثُمَّ طَلَبَ الشَّاہِدَیْنِ فَلَمْ یَجِدْہُمَا ، فَخَلَّی سَبِیلَہُ۔","","Musannaf Ibn Abi Shaybah 29426","","","كتاب أقضية رسول الله ﷺ"
"29427","(۲۹۴۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ؛ أَنَّ امْرَأَۃً رُفِعَتْ إِلَی عُمَرَ ، أَقَرَّتْ بِالزِّنَی أَرْبَعَ مَرَّاتٍ ، فَقَالَ : إِنْ رَجَعْتِ لَمْ نُقِمْ عَلَیْکِ الْحَدَّ ، فَقَالَتْ : لاَ یَجْتَمِعُ عَلَیَّ أَمْرَانِ ؛ آتِی الْفَاحِشَۃَ ، وَلاَ یُقَامُ عَلَیَّ الْحَدُّ ، قَالَ : فَأَقَامَہُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 29427","","","كتاب أقضية رسول الله ﷺ"
"29428","(۲۹۴۲۸) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، عَنْ نَافِع، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ؛ أَنَّ أَبَا وَاقِدٍ بَعَثَہُ عُمَرُ إِلَیْہَا ، فَذَکَرَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 29428","","","كتاب أقضية رسول الله ﷺ"
"29429","(۲۹۴۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَعَطَائٍ ، قَالاَ : إِذَا أَقَرَّ بِحَدِّ زِنًی ، أَوْ سَرِقَۃٍ ، ثُمَّ جَحَدَ دُرِئَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 29429","","","كتاب أقضية رسول الله ﷺ"
"29430","(۲۹۴۳۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، قَالَ : إِنْ کَانَ أَقَرَّ فَقَدْ أَنْکَرَ ، یَعْنِی الَّذِی یُقِرُّ بِالْحَدِّ ، ثُمَّ یَرْجِعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29430","","","كتاب أقضية رسول الله ﷺ"
"29431","(۲۹۴۳۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُقِرُّ عِنْدَ النَّاسِ ، ثُمَّ یَجْحَدُ ، قَالَ : یُؤْخَذُ بِہِ۔","","Musannaf Ibn Abi Shaybah 29431","","","كتاب أقضية رسول الله ﷺ"
"29432","(۲۹۴۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُقِرُّ بِالْحَدِّ دُونَ السُّلْطَانِ ، ثُمَّ یَجْحَدُ إِذَا رُفِعَ ، لَمْ یَرَ أَنْ یَلْزَمَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29432","","","كتاب أقضية رسول الله ﷺ"
"29433","(۲۹۴۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی إِسْمَاعِیلُ ، عَنِ ابْنِ شِہَابٍ ،قَالَ : مَنِ اعْتَرَفَ مِرَارًا کَثِیرَۃً بِسَرِقَۃٍ ، أَوْ بِحَدٍّ ثُمَّ أَنْکَرَ ، لَمْ یَجُزْ عَلَیْہِ شَیئٌ۔","","Musannaf Ibn Abi Shaybah 29433","","","كتاب أقضية رسول الله ﷺ"
"29434","(۲۹۴۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُد ، عَنْ زِیَادِ بْنِ عُثْمَان ؛ أَنَّ رَجُلاً مِن النَّصَارَی اسْتَکْرَہ امْرَأَۃً مُسْلِمَۃً عَلَی نَفْسِہَا ، فَرُفِعَ إِلَی أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ ، فَقَالَ : مَا عَلَی ہَذَا صَالَحْنَاکُم ، فَضَرَبَ عُنُقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29434","","","كتاب أقضية رسول الله ﷺ"
"29435","(۲۹۴۳۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْمُجَالِدِ ، عَنِ الشَّعْبِیِّ ، عَنْ سُوَیْدِ بْنِ غَفَلَۃَ ؛ أَنَّ رَجُلاً مِنْ أَہْلِ الذِّمَّۃِ ، مِنْ نُبَیْطِ أَہْلِ الشَّامِ نَخَسَ بِامْرَأَۃٍ عَلَی دَابَّۃٍ ، فَلَمْ تَقَعْ ، فَدَفَعَہَا بِیَدِہِ فَصَرَعَہَا ، فَانْکَشَفَتْ عَنْہَا ثِیَابُہَا ، فَجَلَسَ لِیُجَامِعَہَا ، فَرُفِعَ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، وَقَامَتْ عَلَیْہِ الْبَیِّنَۃُ ، فَأَمَرَ بِہِ فَصُلِبَ ، وَقَالَ : لَیْسَ عَلَی ہَذَا عَاہَدْنَاکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 29435","","","كتاب أقضية رسول الله ﷺ"
"29436","(۲۹۴۳۶) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّ عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ أُتِیَ بِرَجُلٍ مِنْ أَہْلِ الذِّمَّۃِ اسْتَکْرَہَ امْرَأَۃً مُسْلِمَۃً ، فَخَصَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29436","","","كتاب أقضية رسول الله ﷺ"
"29437","(۲۹۴۳۷) حَدَّثَنَا الْبَکْرَاوِیُّ ، عَنْ إِسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا اسْتَکْرَہَ الذِّمِّیُّ الْمُسْلِمَۃَ قُتِلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29437","","","كتاب أقضية رسول الله ﷺ"
"29438","(۲۹۴۳۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ؛ أَنَّ مَاعِزَ بْنَ مَالِکٍ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَقَرَّ عَلَی نَفْسِہِ بِالزِّنَی ، قَالَ : وَبِمَنْ ، قَالَ : بِفُلاَنَۃَ مَوْلاَۃِ ابْنِ فُلاَنٍ ، فَأَرْسَلَ إِلَیْہَا فَأَنْکَرَتْ ، فَخَلَّی سَبِیلَہَا ، وَأَخَذَہُ بِمَا أَقَرَّ عَلَی نَفْسِہِ ، وَلَمْ یُذْکَرْ أَنَّہُ جَلَدَہُ حَدَّ الْفِرْیَۃِ فِیہَا۔ (احمد ۳۳۹)","","Musannaf Ibn Abi Shaybah 29438","","","كتاب أقضية رسول الله ﷺ"
"29439","(۲۹۴۳۹) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَالَ : زَنَیْت بِفُلاَنَۃٍ ، قَالَ : عَلَیْہِ لَہَا الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 29439","","","كتاب أقضية رسول الله ﷺ"
"29440","(۲۹۴۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ قَالَ لاِمْرَأَۃٍ : أَشْہَدُ أَنِّی قَدْ زَنَیْتُ بِکِ ، قَالَ : أَضْرَبُہُ بِمَا افْتَرَی عَلَیْہَا ، وَلاَ أَضْرِبُہُ بِمَا افْتَرَی عَلَی نَفْسِہِ إِلاَّ بِبَیِّنَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 29440","","","كتاب أقضية رسول الله ﷺ"
"29441","(۲۹۴۴۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : یُجْلَدُ حَدَّیْنِ ، قُلْتُ : فَإِنْ أَکْذَبَ ؟ قَالَ : یُجْلَدُ حَدًّا، وَیُدْرَأُ عَنْہُ آخَرُ۔","","Musannaf Ibn Abi Shaybah 29441","","","كتاب أقضية رسول الله ﷺ"
"29442","(۲۹۴۴۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا قَالَتِ الْمَرْأَۃُ : زَنَی بِی فُلاَنٌ ، فلا تُجْلَدُ ، وَلاَ یُجْلَدُ۔","","Musannaf Ibn Abi Shaybah 29442","","","كتاب أقضية رسول الله ﷺ"
"29443","(۲۹۴۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَام ، عَنِ الْحَسَن ، قَالَ : إِذَا قَذَفَ الرَّجُلُ الرَّجُلَ بِالْمَرَأَۃِ ؛ جُلِدَ حَدَّینِ ؛ حَدّ لِلْرَجُلِ ، وَحَدّ لِلْمَرَأَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 29443","","","كتاب أقضية رسول الله ﷺ"
"29444","(۲۹۴۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِذَا قَالَ الرَّجُلُ لِلْرَجُلِ : إِنَّ فُلاَنًا زَنَی بِفُلاَنَۃَ ، فَلَیْسَ عَلَیْہِ إِلاَّ حَدٌّ وَاحِدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29444","","","كتاب أقضية رسول الله ﷺ"
"29445","(۲۹۴۴۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا قَذَفَ الرَّجُلُ امْرَأَتَہُ بِرَجُلٍ مُسَمًّی ، أُقِیمَ عَلَیْہِ الْحَدُّ۔ وَقَالَ ابْنُ سِیرِینَ : لاَ حَدَّ عَلَیْہِ ، کَانَ الَّذِی لاَعَنَ بِہِ النَّبیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَذَفَہَا بِابْنِ سَحْمَائَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29445","","","كتاب أقضية رسول الله ﷺ"
"29446","(۲۹۴۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا قَذَفَ الرَّجُلُ امْرَأَتَہُ بِرَجُلٍ مُسَمًّی ، لَمْ یَکُنْ عَلَیْہِ لَہُمَا إِلاَّ حَدٌّ وَاحِدٌ ، قَالَ : أَیْہَُما أَخَذَہُ بِحَدِّہِ ؛ لَمْ یَکُنْ لِلآخَرِ حَدٌّ ۔ إِنْ بَدَأَتِ الْمَرْأَۃُ فَلاَعَنَتَہُ ، لَمْ یُضْرَبُ لِلْرَجُلِ ، وَإِنْ ضُرِبَ لِلْرَجُلِ لَمْ یَلاَعَنْ لِلْمَرَأَۃِ۔","","Musannaf Ibn Abi Shaybah 29446","","","كتاب أقضية رسول الله ﷺ"
"29447","(۲۹۴۴۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی رَجُلٍ قَالَ لامْرَأَتِہِ : رَأَیْتُکِ تَزْنِینَ قَبْلَ أَنْ تَکُونِین عَندِی ، قَالَ سَعِیدٌ : حَدٌّ ، وَلاَ مُلاَعَنَۃَ۔ وَقَالَ الْحَسَنُ : لاَ حَدَّ ، وَلاَ مُلاَعَنۃَ ، لأَنَّہُ قَالَ لَہَا ذَلِکَ وَہِیَ عَندَہُ۔","","Musannaf Ibn Abi Shaybah 29447","","","كتاب أقضية رسول الله ﷺ"
"29448","(۲۹۴۴۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ قَالَ لاِمْرَأَتِہِ : زَنَیْتِ وَأَنْتِ أَمَۃٌ ، قَالَ : یُحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29448","","","كتاب أقضية رسول الله ﷺ"
"29449","(۲۹۴۴۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ عَمْرِو بْنِ ہَرمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ وَاحِدَۃً ، ثُمَّ قَذَفَہَا ، قَالَ : یُجْلَدُ الْحَدَّ ، لَیْسَ کَمَنْ لَمْ یُطَلِّقْ\n وَقَالَ ابْنُ عُمَرَ : یُلاَعِنْ إِذَا کَانَ یَمْلِکُ الرَّجْعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 29449","","","كتاب أقضية رسول الله ﷺ"
"29450","(۲۹۴۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ ثَلاَثًا ، ثُمَّ قَذَفَہَا ، قَالَ : یُجْلَدُ الْحَدَّ ، إِلاَّ أَنْ تَکُونَ حَامِلاً ، فَإِنْ کَانَتْ حَامِلاً لاَعَنْہَا۔","","Musannaf Ibn Abi Shaybah 29450","","","كتاب أقضية رسول الله ﷺ"
"29451","(۲۹۴۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا وَہِیَ حُبْلَی ، ثُمَّ انْتَفَی مِمَّا فِی بَطْنِہَا ، قَالَ : یُجْلَدُ ، وَیُلْزَقُ بِہِ الْوَلَدُ۔","","Musannaf Ibn Abi Shaybah 29451","","","كتاب أقضية رسول الله ﷺ"
"29452","(۲۹۴۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا طَلَّقَ ثَلاَثًا ، ثُمَّ انْتَفَی مِنْ وَلَدِہِ وَہُوَ لاَ یَمْلِکُ الرَّجْعَۃَ، جُلِدَ ، وَأُلْزِقَ بِہِ الْوَلَدُ ، وَإِذَا انْتَفَی مِنْ وَلَدِہِ وَہُوَ یَمْلِکُ الرَّجْعَۃَ لاَعَنَ ، وَنُفِیَ عَنْہُ الْوَلَدَ ، وَإِنْ کَانَ لَمْ یُقِرَّ بِہِ قَطُّ۔","","Musannaf Ibn Abi Shaybah 29452","","","كتاب أقضية رسول الله ﷺ"
"29453","(۲۹۴۵۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ طَلاَقًا بَائِنًا ،فَادَّعَتْ حَمْلاً فَانْتَفَی مِنْہُ ، قَالَ : یُلاَعِنُہَا۔","","Musannaf Ibn Abi Shaybah 29453","","","كتاب أقضية رسول الله ﷺ"
"29454","(۲۹۴۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا ، فَجَائَتْ بِحَمْلٍ ، فَانْتَفَی مِنْہُ ؟ قَالَ : فَقَالَ : یُلاَعِنْ ، قَالَ : فَقَالَ الْحَارِثُ : یَا أَبَا عَمْرو ، إِنَّ اللَّہَ قَالَ فِی کِتَابِہِ : (وَالَّذِینَ یَرْمُونَ أَزْوَاجَہُمْ) ، أَفَتَرَاہَا لَہُ زَوْجَۃً ؟ قَالَ : فَقَالَ الشَّعْبِیُّ : إِنِّی لأَسْتَحِی إِذَا رَأَیْتُ الْحَقَّ أَنْ لاَ أَرْجِع إِلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29454","","","كتاب أقضية رسول الله ﷺ"
"29455","(۲۹۴۵۵) حَدَّثَنَا عَبَّادٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ طَلاَقًا بَائِنًا ، ثُمَّ یَقْذِفُہَا ، قَالَ : یُضْرَبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29455","","","كتاب أقضية رسول الله ﷺ"
"29456","(۲۹۴۵۶) حَدَّثَنَا عُثْمَانُ بْنُ عُثْمَانَ الْقُرَشِیُّ ، عَنْ عُثْمَانَ البَتِّی ، قَالَ : کَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ یَقُولُ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ، ثُمَّ قَالَ لَہَا : زَنَیْتِ وَأَنْتِ امْرَأَتِی ، قَالَ : یُلاَعِنُ۔","","Musannaf Ibn Abi Shaybah 29456","","","كتاب أقضية رسول الله ﷺ"
"29457","(۲۹۴۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ قَذَفَ ، ثُمَّ طَلَّقَ ثَلاَثًا ، قَالَ : یُلاَعِنُہَا مَا کَانَتْ فِی الْعِدَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29457","","","كتاب أقضية رسول الله ﷺ"
"29458","(۲۹۴۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا کَانَ یَمْلِکُ الرَّجْعَۃَ لاَعَنَ ، وَإِذَا کَانَ لاَ یَمْلِکُ الرَّجْعَۃَ جُلِدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29458","","","كتاب أقضية رسول الله ﷺ"
"29459","(۲۹۴۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : سَمِعْتُ حَمَادًا ، یَقُولُ : لاَ حدَّ وَلاَ لِعَان۔","","Musannaf Ibn Abi Shaybah 29459","","","كتاب أقضية رسول الله ﷺ"
"29460","(۲۹۴۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ ، عَنِ الْحَکَمِ ، قَالَ : یُضْرَبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29460","","","كتاب أقضية رسول الله ﷺ"
"29461","(۲۹۴۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ عَامِرٍ ، عَنْ مَکْحُولٍ؛ أَنَّہُ قَالَ : إِذَا قَذَفَ ثُمَّ طَلَّقَ ، لاَعَنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29461","","","كتاب أقضية رسول الله ﷺ"
"29462","(۲۹۴۶۲) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّہْنِ ، لَمْ یَرَ عَلَیْہِ حَدًّا۔","","Musannaf Ibn Abi Shaybah 29462","","","كتاب أقضية رسول الله ﷺ"
"29463","(۲۹۴۶۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا رَہَنْتَ وَلِیدَتَکَ ، فَلاَ تَقَعْنَّ عَلَیْہَا حَتَّی تَفْتَکَّہَا۔","","Musannaf Ibn Abi Shaybah 29463","","","كتاب أقضية رسول الله ﷺ"
"29464","(۲۹۴۶۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مَرْیَمَ ، عَنْ حَکِیمِ بْنِ عُمَیْرٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ الْخَطَّابِ : أَلاَ لاَ یَجْلِدَنَّ أَمِیرُ جَیْشٍ ، وَلاَ سَرِیَّۃٍ أَحَدًا الْحَدَّ ، حَتَّی یَطْلُعَ الدَّرْبِ ، لِئَلاَّ تَحْمِلَہُ حَمِیَّۃُ الشَّیْطَانِ أَنْ یَلْحَقَ بِالْکُفَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 29464","","","كتاب أقضية رسول الله ﷺ"
"29465","(۲۹۴۶۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مَرْیَمَ ، عنْ حُمَیْدِ بْنِ فُلاَنِ بْنِ رُومَانَ ؛ أَنَّ أَبَا الدَّرْدَائِ نَہَی أَنْ یُقَامَ عَلَی أَحَدٍ حَدٌّ فِی أَرْضِ الْعَدُوِّ۔","Da'if","Musannaf Ibn Abi Shaybah 29465","","","كتاب أقضية رسول الله ﷺ"
"29466","(۲۹۴۶۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، قَالَ : غَزَوْنَا أَرْضَ الرُّومِ وَمَعَنا حُذَیْفَۃُ ، وَعَلَیْنَا رَجُلٌ مِنْ قُرَیْشٍ ، فَشَرِبَ الْخَمْرَ ، فَأَرَدْنَا أَنْ نَحُدَّہُ ، فَقَالَ حُذَیْفَۃُ : أَتَحُدُّونَ أَمِیرَکُمْ ، وَقَدْ دَنَوْتُمْ مِنْ عَدُوِّکُمْ ، فَیَطْمَعُونَ فِیکُمْ ؟ فَقَالَ : لأَشْرَبَنَّہَا ، وَإِنْ کَانَتْ مُحَرَّمَۃً ، وَلأَشْرَبَنَّہَا عَلَی رَغْمِ مَنْ رَغِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 29466","","","كتاب أقضية رسول الله ﷺ"
"29467","(۲۹۴۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ خَالِدٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ فِیمَنْ أَتَی ذَاتَ مَحْرَمٍ مِنْہُ ، قَالَ : ضَرْبَۃُ عُنُقٍ۔","","Musannaf Ibn Abi Shaybah 29467","","","كتاب أقضية رسول الله ﷺ"
"29468","(۲۹۴۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : اقْتُلُوا کُلَّ مَنْ أَتَی ذَاتَ مَحْرَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 29468","","","كتاب أقضية رسول الله ﷺ"
"29469","(۲۹۴۶۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ عَدِیٍّ بْنِ ثَابِتٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ إِلَی رَجُلٍ تَزَوَّجَ امْرَأَۃَ أَبِیہِ ، فَأَمَرَہُ أَنْ یَأْتِیَہُ بِرَأْسِہِ۔ (ترمذی ۱۳۶۲۔ ابن ماجہ ۲۶۰۷)","Da'if","Musannaf Ibn Abi Shaybah 29469","","","كتاب أقضية رسول الله ﷺ"
"29470","(۲۹۴۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ السَّدِیِّ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنِ الْبَرَائِ ، قَالَ : لَقِیت خَالِی وَمَعَہُ الرَّایَۃُ ، فَقُلْتُ لَہُ ؟ فَقَالَ : بَعَثَنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی رَجُلٍ تَزَوَّجَ امْرَأَۃَ أَبِیہِ أَنْ أَقْتُلَہُ ، أَوْ أَضْرِبَ عُنُقَہُ۔ (ابوداؤد ۴۴۵۱۔ احمد ۲۹۰)","Hasan","Musannaf Ibn Abi Shaybah 29470","","","كتاب أقضية رسول الله ﷺ"
"29471","(۲۹۴۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : رُفِعَ إِلَی الْحَجَّاجِ رَجُلٌ زَنَی بِابْنَتِہِ ، فَقَالَ : مَا أَدْرِی بِأَیِّ قِتْلَۃٍ أَقْتُلُ ہَذَا ، وَہَمَّ أَنْ یَصْلُبَہُ ، فَقَالَ لَہُ عَبْدُ اللہِ بْنُ مُطَرِّفٍ ، وَأَبُو بُرْدَۃَ : سَتَرَ اللَّہُ ہَذِہِ الأُمَّۃَ ، أَحَبَّ البَلاَئِ مَا سَتَرَ الإِسْلاَمَ ، اقْتُلْہُ ، قَالَ : صَدَقْتُمَا ، فَأَمَرَ بِہِ فَقُتِلَ۔","","Musannaf Ibn Abi Shaybah 29471","","","كتاب أقضية رسول الله ﷺ"
"29472","(۲۹۴۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، قَالَ : سَأَلْتُہُ : مَا کَانَ الْحَسَنُ یَقُولُ فِیمَنْ تَزَوَّجَ ذَاتَ مَحْرَمٍ مِنْہُ ، وَہُوَ یَعْلَمُ ؟ قَالَ : عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29472","","","كتاب أقضية رسول الله ﷺ"
"29473","(۲۹۴۷۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ یَحْیَی بْنِ عَبْدِ اللہِ بْنِ صَیْفِیٍّ ؛ أَنَّ عُمَرَ کَتَبَ إِلَی أَبِی مُوسَی : أَلاَ یُبْلَغُ فِی تَعْزِیرٍ أَکْثَرُ مِنْ ثَلاَثِینَ۔","","Musannaf Ibn Abi Shaybah 29473","","","كتاب أقضية رسول الله ﷺ"
"29474","(۲۹۴۷۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ جَامِعٍ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّ رَجُلاً کَتَبَ إِلَی أُمِّ سَلَمَۃَ فِی دَیْنٍ لَہُ قِبَلَہَا ، یحرّجُ عَلَیْہَا فِیہِ ، فَأَمَرَ عُمَرُ بْنُ الْخَطَّابِ أَنْ یُضْرَبَ ثَلاَثِینَ جَلْدَۃً۔ قَالَ بَعْضُ أَصْحَابِنَا : کُلُّہَا یُبْضِعُ وَیُحْدرُ۔","Sahih","Musannaf Ibn Abi Shaybah 29474","","","كتاب أقضية رسول الله ﷺ"
"29475","(۲۹۴۷۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : التَّعْزِیرُ مَا بَیْنَ السَّوْطِ إِلَی الأَرْبَعِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29475","","","كتاب أقضية رسول الله ﷺ"
"29476","(۲۹۴۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ صَدَقَۃَ بْنِ عَبْدِ اللہِ ، عَنِ الْحَارِثِ بْنِ عُتْبَۃَ ؛ أنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أُتِیَ بِرَجُلٍ یَسُبُّ عُثْمَانَ ، فَقَالَ : مَا حَمَلَک عَلَی أَنْ سَبَبْتَہُ ؟ قَالَ : أُبْغِضُہُ ، قَالَ : وَإِنْ أَبْغَضْتَ رَجُلاً سَبَبْتَہُ ، قَالَ : فَأَمَرَ بِہِ فَجُلِدَ ثَلاَثِینَ جَلْدَۃً۔","","Musannaf Ibn Abi Shaybah 29476","","","كتاب أقضية رسول الله ﷺ"
"29477","(۲۹۴۷۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : کُنْتُ جَالِسًا عَندَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَجَائَہُ رَجُلٌ ، فَسَأَلَہُ الْفَرِیضَۃَ ؟ فَلَمْ یَفْرِضْ لَہُ ، فَقَالَ : ہُوَ کَافِرٌ بِاللَّہِ إِنْ لَمْ یَفْرِضْ لَہُ ،قَالَ : فَضَرَبَہُ مَا بَیْنَ الْعَشَرَۃِ إِلَی الْخَمْسَۃِ عَشَرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29477","","","كتاب أقضية رسول الله ﷺ"
"29478","(۲۹۴۷۸) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جَابِرٍ ، عَنْ أَبِی بُرْدَۃَ بْنِ نِیَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُجْلَدُ فَوْقَ عَشَرَۃِ أَسْوَاطٍ ، إِلاَّ فِی حَدٍّ۔ (بخاری ۶۸۴۸۔ ابوداؤد ۴۴۸۵)","Sahih","Musannaf Ibn Abi Shaybah 29478","","","كتاب أقضية رسول الله ﷺ"
"29479","(۲۹۴۷۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ عِمْرَانَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ أَرْبَعَۃٍ شَہِدُوا عَلَی رَجُلٍ أَنَّہُ لَیْسَ ابْنَ فُلاَنٍ ، وَشَہِدَ أَرْبَعَۃٌ أَنَّہُ ابْنُ فُلاَنٍ ؟ فَقَالَ : ادْرَأْ عَن ہَؤُلاَئِ لأَنَّہُمْ أَرْبَعَۃٌ ، وَأُصَدِّقَ الآخَرِینَ۔","","Musannaf Ibn Abi Shaybah 29479","","","كتاب أقضية رسول الله ﷺ"
"29480","(۲۹۴۸۰) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیِمِ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ عُمَرُ لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ : أَرَأَیْتَ لَوْ کُنْتَ الْقَاضِیَ وَالْوَالِیَ ، ثُمَّ أَبْصَرْتَ إِنْسَانًا عَلَی حَدٍّ ، أَکُنْتَ مُقِیمًا عَلَیْہِ ؟ قَالَ : لاَ ، حَتَّی یَشْہَدَ مَعِی غَیْرِی ، قَالَ : أَصَبْتَ ، وَلَوْ قُلْتَ غَیْرَ ذَلِکَ لَمْ تُجِدْ۔","","Musannaf Ibn Abi Shaybah 29480","","","كتاب أقضية رسول الله ﷺ"
"29481","(۲۹۴۸۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، قَالَ : سَمِعْتُ حَمَّادًا ، یَقُولُ : سَمِعْنَا أَنَّ الْحَاکِمَ یُجَوِّزُ قَوْلَہُ فِیمَا اعْتُرِفَ عَندَہُ إِلاَّ الْحُدُودَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29481","","","كتاب أقضية رسول الله ﷺ"
"29482","(۲۹۴۸۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ أَنَّہُ سُئِلَ عَنِ الْمَرْأَۃِ تَعَلَّقُ بِالرَّجُلِ فَتَقُولُ: فَعَلَ بِی؟ فَقَالَ الْحَسَنُ: قَذَفَتْ رَجُلاً مِنَ الْمُسْلِمِینَ، عَلَیْہَا الْحَدُّ۔ قَالَ: وَقَالَ إِبْرَاہِیمُ : ہِیَ طَالِبَۃُ حَقٍّ، کَیْفَ تَقُولُ؟","No Data Available","Musannaf Ibn Abi Shaybah 29482","","","كتاب أقضية رسول الله ﷺ"
"29483","(۲۹۴۸۳) حَدَّثَنَا عَبْد الرَّحیم ، عَنِ الأَشْعَثِ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَالَتْ لَہُ امْرَأَۃٌ : إِنَّ ہَذَا زَنَی بِی ، قَالَ : تُجْلَدُ بِقَذْفِہَا الرَّجُلَ ، وَلاَ یُجْلَدُ الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 29483","","","كتاب أقضية رسول الله ﷺ"
"29484","(۲۹۴۸۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَبِیہِ ، وَعَمِّہِ ، وَیَحْیَی بْنِ أَبِی الْہَیْثَمِ ، عَنْ جَدِّہِ ؛ أَنَّہُ شَہِدَ عَلِیًّا وَأُتِیَ بِرَجُلٍ وَامْرَأَۃٍ ، وُجِدَا فِی خَرِبِ مُرَادٍ ، فَأُتِیَ بِہِمَا عَلِیٌّ ، فَقَالَ : بِنْتُ عمِّی وَیَتِیمَتِی فِی حَجْرِی ، فَجَعَلَ أَصْحَابُہُ یَقُولُونَ : قُولِی زَوْجِی ، فَقَالَتْ : ہُوَ زَوْجِی ، فَقَالَ عَلِیٌّ : خُذْ بِیَدِ امْرَأَتِک۔","Sahih","Musannaf Ibn Abi Shaybah 29484","","","كتاب أقضية رسول الله ﷺ"
"29485","(۲۹۴۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : یُدْرَأُ عَنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29485","","","كتاب أقضية رسول الله ﷺ"
"29486","(۲۹۴۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُدْرَأُ عَنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29486","","","كتاب أقضية رسول الله ﷺ"
"29487","(۲۹۴۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمَرْأَۃِ تُوجَدُ مَعَ الرَّجُلِ ، فَتَقُولُ : تَزَوَّجَنِی ، فَقَالَ إِبْرَاہِیمُ : لَوْ کَانَ ہَذَا حَقًّا مَا کَانَ عَلَی زَانٍ حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29487","","","كتاب أقضية رسول الله ﷺ"
"29488","(۲۹۴۸۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنْ رَجُلٍ نَفَی رَجُلاً مِنْ أَبٍ لَہُ فِی الشِّرْکِ ؟ فَقَالَ : عَلَیْہِ الْحَدُّ ، لأَنَّہُ نَفَاہُ مِنْ نَسَبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29488","","","كتاب أقضية رسول الله ﷺ"
"29489","(۲۹۴۸۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَجُلاً مِنَ الْمُہَاجِرِینَ افْتُرِیَ عَلَیْہِ عَلَی عَہْدِ عُمَرَ بْنِ الْخَطَّابِ ، وَکَانَتْ أُمُّہُ مَاتَتْ فِی الْجَاہِلِیَّۃِ ، فَجَلَدَہُ عُمَرُ لِحُرْمَۃِ الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 29489","","","كتاب أقضية رسول الله ﷺ"
"29490","(۲۹۴۹۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عَمِّہِ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ قَذَفَ رَجُلاً ، وَأُمُّہُ مُشْرِکَۃٌ ؟ قَالَ : أَرَأَیْتَ لَوْ أَنَّ رَجُلاً قَذَفَ الأَشْعَثَ ، أَلَمْ یُضْرَبْ ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 29490","","","كتاب أقضية رسول الله ﷺ"
"29491","(۲۹۴۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ سَعِیدٍ الزُّبَیْدِیِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : لَسْتَ لأَبِیک ، وَأُمُّہُ أَمَۃٌ ، أَوْ یَہُودِیَّۃٌ ، أَوْ نَصْرَانِیَّۃٌ ، قَالَ : لاَ حَدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29491","","","كتاب أقضية رسول الله ﷺ"
"29492","(۲۹۴۹۲) حَدَّثَنَا ابْنُ أَبِی غَنِیۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إِذَا قَذَفَ الرَّجُلُ الرَّجُلَ ، وَلَہُ أُمٌّ یَہُودِیَّۃٌ ، أَوْ نَصْرَانِیَّۃٌ ، فَلاَ حَدَّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29492","","","كتاب أقضية رسول الله ﷺ"
"29493","(۲۹۴۹۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ یَغِیبُ عَنِ امْرَأَتِہِ ، وَلَمْ یَدْخُلْ بِہَا ، فَتَجِیئُ بِحَمْلٍ ، أَوْ بِوَلَدٍ ، قَالَ : إِنْ کَانَتْ غَیْبَتُہُ بِأَرْضٍ بَعِیدَۃٍ لَمْ تُصَدَّقْ ، وَیُقَامُ عَلَیْہَا الْحَدُّ ، وَإِنْ کَانَ فِی أَرْضٍ قَرِیبَۃٍ یُرَوْنَ أَنَّہُ یَأْتِیہَا سِرًّا ، صُدِّقَتْ بِالْوَلَدِ أَنَّہُ مِنْ زَوْجِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 29493","","","كتاب أقضية رسول الله ﷺ"
"29494","(۲۹۴۹۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَوْ أَنَّ رَجُلاً قَذَفَ رَجُلاً ، فَعَفَا وَأَشْہَدَ ، ثُمَّ جَائَ بِہِ إِلَی الإِمَامِ بَعْدَ ذَلِکَ ، أَخَذَ لَہُ بِحَقِّہِ ، وَلَوْ مَکَثَ ثَلاَثِینَ سَنَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 29494","","","كتاب أقضية رسول الله ﷺ"
"29495","(۲۹۴۹۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الْحَسَنَ ، وَابْنَ سِیرِینَ عَنِ الرَّجُلِ یَفْتَرِی عَلَی الرَّجُلِ فَیَعْفُو ؟ قَالَ الْحَسَنُ : لاَ ، وَقَالَ ابْنُ سِیرِینَ : مَا أَدْرِی۔","","Musannaf Ibn Abi Shaybah 29495","","","كتاب أقضية رسول الله ﷺ"
"29496","(۲۹۴۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ رُزَیْقٍ ، قَالَ : کَتَبْتُ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی رَجُلٍ قَذَفَ ابْنَہُ : فَقَالَ ابْنَہُ : إِنْ جُلِدَ أَبِی اعْتَرَفْتُ ، فَکَتَبَ إِلَیَّ عُمَرُ : أَنِ اجْلِدْہُ ، إِلاَّ أَنْ یَعْفُوَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 29496","","","كتاب أقضية رسول الله ﷺ"
"29497","(۲۹۴۹۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَرَادُوا أَنْ یَقْطَعُوا یَدَہُ ، یَعْنِی الْیُمْنَی ، فَقَدَّمَ یَدَہُ الْیُسْرَی ، فَقُطِعَتْ ؟ قَالَ : لاَ تُقْطَعُ الْیُمْنَی۔","","Musannaf Ibn Abi Shaybah 29497","","","كتاب أقضية رسول الله ﷺ"
"29498","(۲۹۴۹۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّ عَلِیًّا أَمْضَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29498","","","كتاب أقضية رسول الله ﷺ"
"29499","(۲۹۴۹۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ؛ فِی إِمَامٍ أُتِیَ بِسَارِقٍ، فَجَہلَ فَقُطِعَ یَسَارُہُ، قَالَ: یُتْرَکُ۔","","Musannaf Ibn Abi Shaybah 29499","","","كتاب أقضية رسول الله ﷺ"
"29500","(۲۹۵۰۰) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَمَّنْ حَدَّثَہُ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، قَالَ : اجْتَمَعْتُ أَنَا وَسَعِیدُ بْنُ الْمُسَیَّبِ فِی الرَّجُلِ إِذَا أُمِرَ بِقَطْعِ یَمِینِہِ ، أَنَّہُ إِنْ دَسَّ إِلَی الْحَجَّامِ یَسَارَہُ فَقَطَعَہَا ، قَالاَ : یَدُہُ تُبطلُ ، وَالْقَوَدُ فِی مَوْضِعِہِ۔","","Musannaf Ibn Abi Shaybah 29500","","","كتاب أقضية رسول الله ﷺ"
"29501","(۲۹۵۰۱) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : طَلَّقَ جَارٌ لِی سَکْرَانُ ، فَأَمَرَنِی أَنْ أَسْأَلَ سَعِیدَ بْنَ الْمُسَیَّبِ ، قَالَ : إِنْ أُصِیبَ فِیہِ الْحَقُّ جُلِدَ ثَمَانِینَ ، وَفُرِّقَ بَیْنَہُ وَبَیْنَ أَہْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29501","","","كتاب أقضية رسول الله ﷺ"
"29502","(۲۹۵۰۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَنبَسَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَجَازَ طَلاَقَہُ ، وَجَلَدَہُ۔","","Musannaf Ibn Abi Shaybah 29502","","","كتاب أقضية رسول الله ﷺ"
"29503","(۲۹۵۰۳) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا قَالاَ : طَلاَقُ السَّکْرَانِ جَائِزٌ ، وَیُجْلَدُ ظَہْرُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29503","","","كتاب أقضية رسول الله ﷺ"
"29504","(۲۹۵۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرٍ ، عَن مَیْمُونَ ، قَالَ : یَجُوزُ طَلاَقُہُ وَیُجْلَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29504","","","كتاب أقضية رسول الله ﷺ"
"29505","(۲۹۵۰۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیُّ ، عَنِ الزُّہْرِیِّ ، قَالَ: إِذَا أَعْتَقَ ، أَوْ طَلَّقَ السَّکْرَانُ جَازَ طَلاَقُہُ، وَأُقِیمَ عَلَیْہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29505","","","كتاب أقضية رسول الله ﷺ"
"29506","(۲۹۵۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَمَّنْ سَمِعَ الشَّعْبِیَّ ، یَقُولُ : یَجُوزُ طَلاَقُہُ ، وَیُوجَعُ ظَہْرُہُ۔","","Musannaf Ibn Abi Shaybah 29506","","","كتاب أقضية رسول الله ﷺ"
"29507","(۲۹۵۰۷) حَدَّثَنَا عُبَادَۃُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَن حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ عَلِیًّا وَعَبْدَ اللہِ اخْتَلَفَا فِی أُمِّ وَلَدٍ بَغَتْ ، فَقَالَ عَلِیٌّ : تُجْلَدُ ، وَلاَ نَفْیَ عَلَیْہَا ، وَقَالَ عَبْدُ اللہِ : تُجْلَدُ وَتُنْفَی۔","","Musannaf Ibn Abi Shaybah 29507","","","كتاب أقضية رسول الله ﷺ"
"29508","(۲۹۵۰۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی أُمِّ الْوَلَدِ تَفْجُرُ ، قَالَ : یُقَامُ عَلَیْہَا حَدُّ الأَمَۃِ ، وَہِیَ عَلَی مَنْزِلَتِہَا۔","","Musannaf Ibn Abi Shaybah 29508","","","كتاب أقضية رسول الله ﷺ"
"29509","(۲۹۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : سَمِعْتُ حَمَّادًا ، یَقُولُ : لاَ تَجُوزُ شَہَادَۃٌ عَلَی شَہَادَۃٍ فِی حَدٍّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29509","","","كتاب أقضية رسول الله ﷺ"
"29510","(۲۹۵۱۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ تَجُوزُ شَہَادَۃٌ عَلَی شَہَادَۃٍ فِی قِصَاصٍ ، وَلاَ حَدٍّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29510","","","كتاب أقضية رسول الله ﷺ"
"29511","(۲۹۵۱۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الرَّجُلِ عَلَی الرَّجُلِ فِی الْحُدُودِ۔","","Musannaf Ibn Abi Shaybah 29511","","","كتاب أقضية رسول الله ﷺ"
"29512","(۲۹۵۱۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَنْ لَیْثٍ ، عَن طَاوُوسٍ ، وَعَطَائٍ ؛ قَالاَ : لاَ تَجُوزُ شَہَادَۃٌ عَلَی شَہَادَۃٍ فِی حَدٍّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29512","","","كتاب أقضية رسول الله ﷺ"
"29513","(۲۹۵۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، ??َنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، وَمَسْرُوقٍ ؛ أَنَّہُمَا قَالاَ : لاَ تَجُوزُ شَہَادَۃٌ عَلَی شَہَادَۃٍ فِی حَدٍّ ، وَلاَ یُکْفَلاَنِ فِی حَدٍّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29513","","","كتاب أقضية رسول الله ﷺ"
"29514","(۲۹۵۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا ہَرَبَ إِلَی الْحَرَمِ ، فَقَدْ أَمِنَ ، فَإِنْ أَصَابَہُ فِی الْحَرَمِ ، أُقِیمَ عَلَیْہِ الْحَدُّ فِی الْحَرَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29514","","","كتاب أقضية رسول الله ﷺ"
"29515","(۲۹۵۱۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ أَنَّ الْوَلِیدَ أَرَادَ أَنْ یُقِیمَ عَلَی رَجُلٍ الْحَدَّ فِی الْحَرَمِ ، فَقَالَ لَہُ عُبَیْدُ بْنُ عُمَیْرٍ : لاَ تُقِمْہُ إِلاَّ أَنْ یَکُونَ أَصَابَہُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 29515","","","كتاب أقضية رسول الله ﷺ"
"29516","(۲۹۵۱۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : إِذَا أَصَابَ حَدًّا فِی غَیْرِ الْحَرَمِ ، ثُمَّ لَجَأَ إِلَی الْحَرَمِ ، أُخْرِجَ مِنَ الْحَرَمِ حَتَّی یُقَامَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29516","","","كتاب أقضية رسول الله ﷺ"
"29517","(۲۹۵۱۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن خُصَیْفٍ ، عَن مُجَاہِدٍ ، قَالَ : إِذَا أَصَابَ الرَّجُلُ الْحَدَّ فِی غَیْرِ الْحَرَمِ ، ثُمَّ أَتَی الْحَرَمَ ، أُخْرِجَ مِنَ الْحَرَمِ فَأُقِیمَ عَلَیْہِ الْحَدُّ ، وَإِذَا أَصَابَہُ فِی الْحَرَمِ أُقِیمَ عَلَیْہِ فِی الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 29517","","","كتاب أقضية رسول الله ﷺ"
"29518","(۲۹۵۱۸) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَن خُصَیْفٍ ، عَن مُجَاہِدٍ ؛ أَنَّ رَجُلاً قَتَلَ رَجُلاً ، ثُمَّ دَخَلَ الْحَرَمَ ، قَالَ : یُؤْخَذُ فَیُخْرَجُ بِہِ مِنَ الْحَرَمِ ، ثُمَّ یُقَامُ عَلَیْہِ الْحَدُّ ۔ یَقُولُ : الْقَتْلُ۔","","Musannaf Ibn Abi Shaybah 29518","","","كتاب أقضية رسول الله ﷺ"
"29519","(۲۹۵۱۹) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَطَائٍ ، عَنْ سَعِیدٍ (ح) وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَقْتُلُ ، ثُمَّ یَدْخُلُ الْحَرَمَ ، قَالَ : لاَ یُبَایِعُہُ أَہْلُ مَکَّۃَ ، وَلاَ یَشْتَرُونَ مِنْہُ ، وَلاَ یَسْقُونَہُ ، وَلاَ یُطْعِمُونَہُ ، وَلاَ یُؤْوُونَہُ ، وَلاَ یُنْکِحُونَہُ حَتَّی یَخْرُجَ فَیُؤْخَذَ بِہِ۔ (ابن جریر ۱۳)","","Musannaf Ibn Abi Shaybah 29519","","","كتاب أقضية رسول الله ﷺ"
"29520","(۲۹۵۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، قَالاَ : لَوْ وَجَدْنَا قَاتِلَ آبَائِنَا فِی الْحَرَمِ لَمْ نَقْتُلْہُ۔","","Musannaf Ibn Abi Shaybah 29520","","","كتاب أقضية رسول الله ﷺ"
"29521","(۲۹۵۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَقْتُلُ ، ثُمَّ یَدْخُلُ الْحَرَمَ ؟ قَالَ حَمَّادٌ : یُخْرَجُ فَیُقَامُ عَلَیْہِ الْحَدُّ ، وَقَالَ الْحَکَمُ : لاَ یُبَایَعُ ، وَلاَ یُؤَاکَلُ۔","","Musannaf Ibn Abi Shaybah 29521","","","كتاب أقضية رسول الله ﷺ"
"29522","(۲۹۵۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنی أَبُو بَکْرِ بْنُ عَبْدِ اللہِ ، أَنَّ خَالِدَ بْنَ مَعْبَدٍ حَدَّثَہُ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَعُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ؛ أَنَّہُمَا سُئِلاَ عَنِ السَّارِقِ یَسْرِقُ ، فَیَطْرَحُ سَرِقَتَہُ خَارِجًا مِنَ الْبَیْتِ ، وَیُوجَدُ فِی الْبَیْتِ الَّذِی سَرَقَ فِیہِ الْمَتَاعَ ، أَعَلَیْہِ الْقَطْعُ ؟ فَقَالاَ : عَلَیْہِ الْقَطْعُ۔","","Musannaf Ibn Abi Shaybah 29522","","","كتاب أقضية رسول الله ﷺ"
"29523","(۲۹۵۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی مَعْمَرٌ ، عَن خُصَیْفٍ ، قَالَ : فَقَدَ قَوْمٌ مَتَاعًا لَہُمْ مِنْ بَیْتِہِمْ ، فَرَأَوْا نَقْبًا فِی الْبَیْتِ ، فَخَرَجُوا یَنْظُرُونَ ، فَإِذَا رَجُلاَنِ یَسْعَیَانِ، فَأَدْرَکُوا أَحَدَہُمَا مَعَہُ مَتَاعُہُمْ، وَأَفْلَتَہُمَ الآخَرُ ، فَأَتَیَا بِہِ ، فَقَالَ : لَمْ أَسْرِقْ شَیْئًا ، وَإِنَّمَا اسْتَأْجَرَنِی ہَذَا الَّذِی أٌفْلِتَ، وَدَفَعَ إِلَیَّ ہَذَا الْمَتَاعَ لأَحْمِلَہُ لَہُ ، لاَ أَدْرِی مِنْ أَیْنَ جَائَ بِہِ ؟ قَالَ خُصَیْفٌ : فَکُتِبَ فِیہِ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَتَبَ : أَنْ یُنَکَّلَہُ وَیُخْلدَہُ السِّجْنَ ، وَلاَ یَقْطَعَہُ۔","","Musannaf Ibn Abi Shaybah 29523","","","كتاب أقضية رسول الله ﷺ"
"29524","(۲۹۵۲۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ أَخَذَ مِنْ رَجُلٍ ثَوْبًا ، فَقَالَ : سَرَقْتَہُ ؟ فَقَالَ : إِنَّمَا أَخَذْتُہُ بِحَقٍّ لِی عَلَیْہِ ، فَقَالَ الشَّعْبِیُّ : لاَ حَدَّ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29524","","","كتاب أقضية رسول الله ﷺ"
"29525","(۲۹۵۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : إِنْ وُجِدَتْ سَرِقَۃً مَعَ رَجُلِ سَوْئٍ یُتَّہَمُ فَقَالَ : ابْتَعْتَہَا ، فَلَمْ یعیِّن مِمَّنِ ابْتَاعَہَا مِنْہُ ، أَوْ قَالَ : وَجَدْتُہَا ، لَمْ یُقْطَعْ ، وَلَمْ یُعَاقَبْ۔","","Musannaf Ibn Abi Shaybah 29525","","","كتاب أقضية رسول الله ﷺ"
"29526","(۲۹۵۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ بِکِتَابٍ قَرَأْتُہُ : إِذَا وُجِدَ الْمَتَاعُ مَعَ الرَّجُلِ الْمُتَّہم فَقَالَ : ابْتَعْتَہُ ، فَلَمْ ینفذہُ ، فَاشْدُدْہُ فِی السِّجْنِ وَثَاقًا ، وَلاَ تَحُلَّہُ بِکَلاَمِ أَحَدٍ حَتَّی یَأْتِیَ فِیہِ أَمْرُ اللہِ ، قَالَ : فَذَکَرْتُ ذَلِکَ لِعَطَائٍ ، فَأَنْکَرَہُ۔","","Musannaf Ibn Abi Shaybah 29526","","","كتاب أقضية رسول الله ﷺ"
"29527","(۲۹۵۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ ، یَقُولُ : مَنْ رَفَعَ السِّلاَحَ ، ثُمَّ وَضَعَہُ ، فَدَمُہُ ہَدَرٌ۔\n قَالَ : وَکَانَ طَاوُوسٌ یَرَی ذَلِکَ أَیْضًا۔","","Musannaf Ibn Abi Shaybah 29527","","","كتاب أقضية رسول الله ﷺ"
"29528","(۲۹۵۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی مَعْمَرٌ ، عَنِ ابْنِ شِہَابٍ ؛ أَنَّ رَجُلاً ضَرَبَ رَجُلاً بِالسَّیْفِ ، فَلَمْ یَقْطَعْ مَرْوَانُ بْنُ الْحَکَمِ یَدَہُ ، وَأَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَطَعَ یَدَ رَجُلٍ فِی ذَلِکَ بِکِتَابِ الْوَلِیدِ بْنِ عَبْدِ الْمَلِکِ۔ (عبدالرزاق ۱۸۶۸۶)","","Musannaf Ibn Abi Shaybah 29528","","","كتاب أقضية رسول الله ﷺ"
"29529","(۲۹۵۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنَی زِیَادٌ ؛ أَنَّ ابْنَ شِہَابٍ أَخْبَرَہُ ، قَالَ : ضَرَبَ صَفْوَانُ بْنُ الْمُعَطَّلِ حَسَّانَ بْنَ الْفُرَیْعَۃِ بِالسَّیْفِ فِی ہِجَائٍ ہَجَاہُ ، فَلَمْ یَقْطَعْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَہُ۔ (عبدالرزاق ۱۸۶۸۶)","","Musannaf Ibn Abi Shaybah 29529","","","كتاب أقضية رسول الله ﷺ"
"29530","(۲۹۵۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَفَعَ عَلَیْنَا السِّلاَحَ فَلَیْسَ مِنَّا۔ (بخاری ۶۸۷۴۔ مسلم ۹۸)","Sahih","Musannaf Ibn Abi Shaybah 29530","","","كتاب أقضية رسول الله ﷺ"
"29531","(۲۹۵۳۱) حَدَّثَنَا جَرِیرٌ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَن خَیْثَمَۃَ ، قَالَ : قَالَ عُمَرُ : لَیْسَ مِنَّا مَنْ شَہَرَ السِّلاَحَ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 29531","","","كتاب أقضية رسول الله ﷺ"
"29532","(۲۹۵۳۲) حَدَّثَنَا جَرِیرٌ بن عَبْدِ الْحَمِیدِ ، أَوْ حُدَّثْتُ عَنْہُ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 29532","","","كتاب أقضية رسول الله ﷺ"
"29533","(۲۹۵۳۳) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، عَن عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ إِیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَلَّ عَلَیْنَا السَّیْفَ فَلَیْسَ مِنَّا۔ (مسلم ۱۶۲۔ احمد ۴۶)","Sahih","Musannaf Ibn Abi Shaybah 29533","","","كتاب أقضية رسول الله ﷺ"
"29534","(۲۹۵۳۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن شَرِیکٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ رَفَعَ عَلَیْنَا السِّلاَحَ فَلَیْسَ مِنَّا۔ (بخاری ۱۲۸۰۔ مسلم ۱۶۴)","Hasan","Musannaf Ibn Abi Shaybah 29534","","","كتاب أقضية رسول الله ﷺ"
"29535","(۲۹۵۳۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، سُلَیْمَانُ بْنُ حَیَّانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَن أُسَامَۃَ ، قَالَ : بَعَثَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَرِیَّۃٍ ، فَصَبَّحْنَا الْحُرَقَاتِ مِنْ جُہَیْنَۃَ ، فَأَدْرَکْت رَجُلاً ، فَقَالَ : لاَ إِلَہَ إِلاَّ اللَّہُ ، فَطَعَنتُہُ ، فَوَقَعَ فِی نَفْسِی مِنْ ذَلِکَ ، فَذَکَرْتُہُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَالَ لاَ إِلَہَ إِلاَّ اللَّہُ وَقَتَلْتَہُ ؟ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إِنَّمَا قَالَہَا فَرَقًا مِنَ السِّلاَحِ ، قَالَ : فَأَلاَّ شَقَقْتَ عَن قَلْبِہِ حَتَّی تَعْلَمَ قَالَہَا فَرَقًا ، أَمْ لاَ ؟ قَالَ : فَمَا زَالَ یُکَرِّرُہَا عَلَیَّ ، حَتَّی تَمَنَّیْت أَنِّی أَسْلَمْت یَوْمَئِذٍ۔ (بخاری ۴۲۶۹۔ مسلم ۱۸۵)","Hasan","Musannaf Ibn Abi Shaybah 29535","","","كتاب أقضية رسول الله ﷺ"
"29536","(۲۹۵۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، عَن أُسَامَۃَ ، قَالَ : بَعَثْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَرِیَّۃٍ ، فَذَکَرَ نَحْوَہُ۔ (مسلم ۱۵۸۔ طبرانی ۳۹۴)","Sahih","Musannaf Ibn Abi Shaybah 29536","","","كتاب أقضية رسول الله ﷺ"
"29537","(۲۹۵۳۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ (ح) وَعَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالا : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إِلَہَ إِلاَّ اللَّہُ ، فَإِذَا قَالُوہَا مَنَعُوا مِنِّی دِمَائَہُمْ وَأَمْوَالَہُمْ إِلاَّ بِحَقِّہَا ، وَحِسَابُہُمْ عَلَی اللہِ۔ (ابوداؤد ۲۶۳۳۔ ترمذی ۲۶۰۶)","Hasan","Musannaf Ibn Abi Shaybah 29537","","","كتاب أقضية رسول الله ﷺ"
"29538","(۲۹۵۳۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَبِی مَالِکٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ: مَنْ وَحَّدَ اللَّہَ ، وَکَفَرَ بِمَا یُعْبَدُ مِنْ دُونِہِ ، فَقَدْ حَرُمَ دَمُہُ ، وَحِسَابُہُ عَلَی اللہِ۔ (مسلم ۳۷۔ احمد ۷۷۲)","Hasan","Musannaf Ibn Abi Shaybah 29538","","","كتاب أقضية رسول الله ﷺ"
"29539","(۲۹۵۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا : لاَ إِلَہَ إِلاَّ اللَّہُ ، فَإِذَا قَالُوہَا عَصَمُوا مِنِّی دِمَائَہُمْ وَأَمْوَالَہُمْ إِلاَّ بِحَقِّہَا ، وَحِسَابُہُمْ عَلَی اللہِ ، ثُمَّ قَرَأَ : {فَذَکِّرْ إِنَّمَا أَنْتَ مُذَکِّرٌ لَسْت عَلَیْہِمْ بِمُصَیْطِرٍ}۔\n(مسلم ۵۲۔ ترمذی ۳۳۴۱)","Sahih","Musannaf Ibn Abi Shaybah 29539","","","كتاب أقضية رسول الله ﷺ"
"29540","(۲۹۵۴۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، عَن حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، أَنَّ عَمْرَو بْنَ أَوْسٍ أَخْبَرَہُ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا لاَ إِلَہَ إِلاَّ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29540","","","كتاب أقضية رسول الله ﷺ"
"29541","(۲۹۵۴۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ ، عَنْ إِبْرَاہِیمَ بْنِ جَرِیرٍ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا لاَ إِلَہَ إِلاَّ اللَّہُ۔ (طبرانی ۲۳۹۲)","","Musannaf Ibn Abi Shaybah 29541","","","كتاب أقضية رسول الله ﷺ"
"29542","(۲۹۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أُمِرْت أَنْ أُقَاتِلَ النَّاسَ حَتَّی یَقُولُوا لاَ إِلَہَ إِلاَّ اللَّہُ ، فَإِذَا قَالُوہَا حَرُمَتْ عَلَیَّ دِمَاؤُہُمْ وَأَمْوَالُہُمْ إِلاَّ بِحَقِّہَا ، وَحِسَابُہُمْ عَلَی اللہِ۔ (احمد ۴۷۵)","Sahih","Musannaf Ibn Abi Shaybah 29542","","","كتاب أقضية رسول الله ﷺ"
"29543","(۲۹۵۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : خَرَجَ الْمِقْدَادُ بْنُ الأَسْوَدِ فِی سَرِیَّۃٍ ، فَمَرُّوا بِرَجُلٍ فِی غُنَیْمَۃٍ لَہُ ، فَأَرَادُوا قَتْلَہُ ، فَقَالَ : لاَ إِلَہَ إِلاَّ اللَّہُ ، فَقَالَ الْمِقْدَادُ : وَدَّ لَوْ فَرَّ بِأَہْلِہِ وَمَالِہِ ، قَالَ : فَلَمَّا قَدِمُوا ، ذَکَرُوا ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَنَزَلَتْ : {یَا أَیُّہَا الَّذِینَ آمَنُوا إِذَا ضَرَبْتُمْ فِی سَبِیلِ اللہِ فَتَبَیَّنُوا ، وَلاَ تَقُولُوا لِمَنْ أَلْقَی إِلَیْکُمُ السَّلاَمَ لَسْتَ مُؤْمِنًا تَبْتَغُونَ عَرَضَ الْحَیَاۃِ الدُّنْیَا} قَالَ : الْغَنِیمَۃُ ، {فَعَندَ اللہِ مَغَانِمُ کَثِیرَۃٌ کَذَلِکَ کُنْتُمْ مِنْ قَبْلُ} قَالَ: تَکْتُمُونَ إِیمَانَکُمْ مِنَ الْمُشْرِکِینَ ، {فَمَنَّ اللَّہُ عَلَیْکُمْ} فَأَظْہَرَ الإِسْلاَمَ ، {فَتَبَیَّنُوا} وَعِیدًا مِنَ اللہِ ، {إِنَّ اللَّہَ کَانَ بِمَا تَعْمَلُونَ خَبِیرًا}۔","","Musannaf Ibn Abi Shaybah 29543","","","كتاب أقضية رسول الله ﷺ"
"29544","(۲۹۵۴۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إِسْرَائِیلَ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَرَّ رَجُلٌ مِنْ بَنِی سُلَیْمٍ عَلَی نَفَرٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ غَنَمٌ ، فَسَلَّمَ عَلَیْہِمْ ، فَقَالُوا : مَا سَلَّمَ عَلَیْکُمْ إِلاَّ لِیَتَعَوَّذَ مِنْکُمْ ، فَعَمَدُوا إِلَیْہِ فَقَتَلُوہُ ، وَأَخَذُوا غَنَمَہُ ، فَأَتَوْا بِہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَنْزَلَ اللَّہُ : {یَا أَیُّہَا الَّذِینَ أَمَّنُوا إِذَا ضَرَبْتُمْ فِی سَبِیلِ اللہِ فَتَبَیَّنُوا وَلاَ تَقُولُوا لِمَنْ أَلْقَی إِلَیْکُمَ السَّلاَمَ لَسْت مُؤْمِنًا تَبْتَغُونَ عَرَضَ الْحَیَاۃِ الدُّنْیَا فَعَندَ اللہِ مَغَانِمُ کَثِیرَۃٌ} إِلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 29544","","","كتاب أقضية رسول الله ﷺ"
"29545","(۲۹۵۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، بِمِثْلِہِ ، وَلَمْ یَذْکُرْ : فَأَتَوْا بِہَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 29545","","","كتاب أقضية رسول الله ﷺ"
"29546","(۲۹۵۴۶) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عَطَائِ بْنِ یَزِیدَ اللَّیْثِیِّ ، عَن عُبَیْدِ اللہِ بْنِ عَدِیِّ بْنِ الْخِیَارِ ، عَنِ الْمِقْدَادِ ؛ أَنَّہُ أَخْبَرَہُ أَنَّہُ قَالَ : یَا رَسُولَ اللہِ ، أَرَأَیْتَ إِنْ لَقِیتُ رَجُلاً مِنَ الْکُفَّارِ ، فَقَاتَلَنِی فَضَرَبَ إِحْدَی یَدَیَّ بِالسَّیْفِ فَقَطَعَہَا ، ثُمَّ لاَذَ مَنِی بِشَجَرَۃٍ ، فَقَالَ : أَسْلَمْتُ لِلَّہِ ، أَقْتُلُہُ یَا رَسُولَ اللہِ ، بَعْدَ أَنْ قَالَہَا ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقْتُلْہُ ، فَقُلْتُ : یَا رَسُولَ اللہِ ، قَطَعَ یَدِی ، ثُمَّ قَالَ ذَلِکَ بَعْدَ أَنْ قَطَعَہَا ، فَأَقْتُلُہُ ؟ قَالَ : لاَ تَقْتُلْہُ ، وَإِنْ قَتَلْتَہُ فَإِنَّہُ بِمَنْزِلَتِکَ قَبْلَ أَنْ تَقْتُلَہُ ، وَأَنْتَ بِمَنْزِلَتِہِ قَبْلَ أَنْ یَقُولَ الْکَلِمَۃَ الَّتِی قَالَ۔ (مسندہ ۴۸۶)","Sahih","Musannaf Ibn Abi Shaybah 29546","","","كتاب أقضية رسول الله ﷺ"
"29547","(۲۹۵۴۷) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : جَائَ أَبُو الْعَالِیَۃِ إِلَیَّ وَإِلَی صَاحِبٍ لِی ، فَقَالَ : ہَلُمَّا فَإِنَّکُمَا أَشَبُّ مِنِّی ، وأَوْعَی لِلْحَدِیثِ مِنِّی ، فَانْطَلَقْنَا حَتَّی أَتَیْنَا بِشْرَ بْنَ عَاصِمٍ اللَّیْثِیَّ ، فقال أَبُو الْعَالِیَۃِ : حَدِّثْ ہَذَیْنِ حَدِیثَکَ ، فَقَالَ : حَدَّثَنَا عٌُقْبَۃُ بْنُ مَالِکِ اللَّیْثِیُّ ، قَالَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَرِیَّۃً ، فَأَغَارَتْ عَلَی الْقَوْمِ ، فَشَدَّ رَجُلٌ مِنَ الْقَوْمِ ، فَاتَّبَعَہُ رَجُلٌ مِنَ السَّرِیَّۃِ مَعَہُ سَیْفٌ شَاہِرٌ ، فَقَالَ الشَّادُّ مِنَ الْقَوْمِ : إِنِّی مُسْلِمٌ ، فَلَمْ یَنْظُرْ فِیمَا قَالَ ، فَضَرَبَہُ فَقَتَلَہُ ، فَنُمِّیَ الْحَدِیثُ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَوْلاً شَدِیدًا ، فَبَلَغَ الْقَاتِلَ ، فَبَیْنَمَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ ، إِذْ قَالَ الْقَاتِلُ : وَاللَّہِ یَا نَبِیَّ اللہِ ، مَا قَالَ الَّذِی قَالَ إِلاَّ تَعَوُّذًا مِنَ الْقَتْلِ ، فَأَعْرَضَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْہُ ، وَعَمَّنْ یَلِیہِ مِنَ النَّاسِ ، وَفَعَلَ ذَلِکَ مَرَّتَیْنِ ، کُلُّ ذَلِکَ یُعْرِضُ عَنْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوَجْہِہِ ، فَلَمْ یَصْبِرْ أَنْ قَالَ الثَّالِثَۃَ مِثْلَ ذَلِکَ ، وَأَقْبَلَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوَجْہِہِ ، تُعْرَفُ الْمَسَائَۃُ فِی وَجْہِہِ ، فَقَالَ : إِنَّ اللَّہَ أَبَی عَلَیَّ فِیمَنْ قَتَلَ مُؤْمِنًا ، ثَلاَثَ مَرَّاتٍ یَقُولُ ذَلِکَ۔ (ابوداؤد ۲۶۲۰۔ احمد ۲۸۸)","Hasan","Musannaf Ibn Abi Shaybah 29547","","","كتاب أقضية رسول الله ﷺ"
"29548","(۲۹۵۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : لَمَّا ارْتَدَّ مَنِ ارْتَدَّ عَلَی عَہْدِ أَبِی بَکْرٍ ، أَرَادَ أَبُو بَکْرٍ أَنْ یُجَاہِدَہُمْ ، فَقَالَ عُمَرُ : أَتُقَاتِلُہُمْ وَقَدْ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : مَنْ شَہِدَ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ ، حَرُمَ مَالُہُ إِلاَّ بِحَقٍّ ، وَحِسَابُہُمْ عَلَی اللہِ تَعَالَی ؟ فَقَالَ أَبُو بَکْرٍ : أَنَّی لاَ أَقَاتِلُ مَنْ فَرَّقَ بَیْنَ الصَّلاَۃِ وَالزَّکَاۃِ، وَاللَّہِ لأَقَاتِلَنَّ مَنْ فَرَّقَ بَیْنَہُمَا حَتَّی أَجْمَعَہُمَا ، قَالَ عُمَرُ : فَقَاتَلْنَا مَعَہُ فَکَانَ رَشْدًا ، فَلَمَّا ظَفِرَ بِمَنْ ظَفِرَ بِہِ مِنْہُمْ ، قَالَ : اخْتَارُوا مِنِّی خَصْلَتَیْنِ ؛ إِمَّا حَرْبٌ مُجْلِیَۃٌ ، وَإِمَّا الْخِطَّۃُ الْمُخْزِیَۃُ ۔ قَالُوا : ہَذِہِ الْحَرْبُ الْمُجْلِیَۃُ قَدْ عَرَفْنَاہَا ، فَمَا الْخِطَّۃُ الْمُخْزِیَۃُ ؟ قَالَ : تَشْہَدُونَ عَلَی قَتْلاَنَا أَنَّہُمْ فِی الْجَنَّۃِ ، وَعَلَی قَتْلاَکُمْ أَنَّہُمْ فِی النَّارِ ، فَفَعَلُوا۔ (بخاری ۱۳۹۹۔ مسلم ۳۲)","Da'if","Musannaf Ibn Abi Shaybah 29548","","","كتاب أقضية رسول الله ﷺ"
"29549","(۲۹۵۴۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ عَبْدِ اللہِ الْبَجَلِیُّ ، قَالَ : حَدَّثَنِی إِبْرَاہِیمُ بْنُ جَرِیرٍ ، عَنْ جَرِیرٍ، قَالَ: إِنَّ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَنِی إِلَی الْیَمَنِ أُقَاتِلُہُمْ وَأَدْعُوہُمْ ، فَإِذَا قَالُوا لاَ إِلَہَ إِلاَّ اللَّہُ، حَرُمَتْ عَلَیْکُمْ أَمْوَالُہُمْ وَدِمَاؤُہُمْ۔","","Musannaf Ibn Abi Shaybah 29549","","","كتاب أقضية رسول الله ﷺ"
"29550","(۲۹۵۵۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنُ أَبِی ذِئْبٍ ، عَن خَالِہِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : ضُرِبَ ابْنٌ لَہُ فِی الشَّرَابِ وَطِیفَ بِہِ ، فَقَالَ : مَا أَجِدُ عَلَیْہِ فِی ضَرْبِہِ إِیَّاہُ ، وَلَکِنِّی أَجِدُ عَلَیْہِ أَنَّہُ طَافَ بِہِ ، وَہُوَ شَیْئٌ لَمْ یَفْعَلْہُ الْمُسْلِمُونَ۔","","Musannaf Ibn Abi Shaybah 29550","","","كتاب أقضية رسول الله ﷺ"
"29551","(۲۹۵۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، قَالَ : سَمِعْتُ مَالِکَ بْنَ عُمَیْرٍ ، یَقُولُ : سَمِعْت عَتَّابَ بْنَ سَلَمَۃَ ، یَقُولُ : سَأَلَنِی عُمَرُ بْنُ الْخَطَّابِ عَنْ رَجُلٍ قَالَ : رَأَیْتہُ یَشْرَبُہَا ؟ فَقُلْتُ : لَمْ أَرَہُ یَشْرَبُہَا ، وَلَکِنْ رَأَیْتہ یَقِیؤُہَا ، قَالَ : فَضَرَبَہُ الْحَدَّ ، وَنَصَبَہُ لِلنَّاسِ۔","Da'if","Musannaf Ibn Abi Shaybah 29551","","","كتاب أقضية رسول الله ﷺ"
"29552","(۲۹۵۵۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : زَنَیْتَ وَأَنْتَ مُشْرِکٌ ، قَالَ : لاَ یُحَدُّ۔","","Musannaf Ibn Abi Shaybah 29552","","","كتاب أقضية رسول الله ﷺ"
"29553","(۲۹۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ؛ أَنَّہُ قَالَ : إِذَا قَالَ : زَنَیْتَ وَأَنْتَ مُشْرِکٌ ، یُقَامُ عَلَیْہِ الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 29553","","","كتاب أقضية رسول الله ﷺ"
"29554","(۲۹۵۵۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی الْکَافِرِ یَزْنِی ، فَیُقَامُ عَلَیْہِ الْحَدَّ ثُمَّ یُسْلِمْ ، فَیَقْذِفُہُ رَجُلٌ ، وَیَقُولُ : إِنَّمَا عَنیْتُ زِنَاہُ الَّذِی کَانَ فِی کُفْرِہِ ؟ قَالَ : یُقَامُ عَلَی قَاذِفِہِ الْحَدُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29554","","","كتاب أقضية رسول الله ﷺ"
"29555","(۲۹۵۵۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنِ امْرَأَۃٍ زَنَتْ وَہِیَ یَہُودِیَّۃٌ ، أَوْ نَصْرَانِیَّۃٌ، أَوْ مَجُوسِیَّۃٌ، ثُمَّ أَسْلَمَتْ، فَقَذَفَہَا رَجُلٌ؟ فَقَالَ ابْنُ شِہَابٍ: لَیْسَ عَلَی مَنْ قَذَفَہَا حَدٌّ، وَلَکِنْ یُنَکَّلُ۔","","Musannaf Ibn Abi Shaybah 29555","","","كتاب أقضية رسول الله ﷺ"
"29556","(۲۹۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَنْفِی الرَّجُلَ مِنْ فَخْذِہِ ، قَالَ : لاَ یُضْرَبُ ، إِلاَّ أَنْ یَنْفِیَہُ مِنْ أَبِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29556","","","كتاب أقضية رسول الله ﷺ"
"29557","(۲۹۵۵۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ رَجُلٍ، عَنِ الْحَکَمِ ، قَالَ: إِذَا قَالَ : لَسْتَ مِنْ بَنِی تَمِیمٍ ، قَالَ : یُضْرَبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29557","","","كتاب أقضية رسول الله ﷺ"
"29558","(۲۹۵۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ ، قَالَ فِی رَجُلٍ یَقُولُ لِلرَّجُلِ : یَا زَانٍ ، وَہُوَ یَعْلَمُ أَنَّہُ قَدْ زَنَی ، أَیُحَدُّ ؟ قَالَ : نَعَمْ ، إِنَّ اللَّہَ یَقُولُ : {ثُمَّ لَمْ یَأْتُوا بِأَرْبَعَۃِ شُہَدَائَ}۔","","Musannaf Ibn Abi Shaybah 29558","","","كتاب أقضية رسول الله ﷺ"
"29559","(۲۹۵۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ؛ أَنَّ رَجُلاً قَالَ لِرَجُلٍ : یَا روسبیہ ، فَضَرَبَہُ عُرْوَۃُ بْنُ الْمُغِیرَۃِ الْحَدَّ ، فَأَعْجَبَ ذَلِکَ الشَّعْبِیَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29559","","","كتاب أقضية رسول الله ﷺ"
"29560","(۲۹۵۶۰) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی بْنُ الْحَارِثِ ، قَالَ : حدَّثَنَا أَبِی ، عَنْ غَیْلاَنَ بْنِ جَامِعٍ ، عَنْ أَشْعَثَ بْنَ سُلَیْمَانَ ، قَالَ : جِیئَ بِرَجُلٍ إِلَی الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ وَہُوَ قَاضٍ ، قَالَ : فَشُہِدَ عَلَیْہِ أَنَّہُ قَالَ لِرَجُلٍ : یَا روسبیہ ، فَجَلَدَہُ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 29560","","","كتاب أقضية رسول الله ﷺ"
"29561","(۲۹۵۶۱) حَدَّثَنَا وَکِیعٌ، عَنْ صَالِحِ بْنِ مَعْبَدٍ، عَنِ الشَّعْبِیِّ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ: یَا مَعْفُوج، قَالَ: عَلَیْہِ الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 29561","","","كتاب أقضية رسول الله ﷺ"
"29562","(۲۹۵۶۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ یَحْیَی بْنِ الْوَلِیدِ ، قَالَ : شَہِدْتُ ابْنَ أَشْوَعَ أُتِیَ بِرَجُلٍ قَالَ لِرَجُلٍ : یَا مَفْعُولُ ، فَجَلَدَہُ الْحَدَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29562","","","كتاب أقضية رسول الله ﷺ"
"29563","(۲۹۵۶۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُجْلَدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29563","","","كتاب أقضية رسول الله ﷺ"
"29564","(۲۹۵۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ الْحَسَنِ ، وَعِکْرِمَۃَ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : یَا مُخَنَّثُ ، قَالَ عِکْرِمَۃُ : عَلَیْہِ الْحَدُّ ۔ وَقَالَ الْحَسَنُ : لَیْسَ عَلَیْہِ الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 29564","","","كتاب أقضية رسول الله ﷺ"
"29565","(۲۹??۶۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَیْہِ حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29565","","","كتاب أقضية رسول الله ﷺ"
"29566","(۲۹۵۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إِذَا قَالَ : یَا مُخَنَّثُ فَلَیْسَ عَلَیْہِ حَدٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29566","","","كتاب أقضية رسول الله ﷺ"
"29567","(۲۹۵۶۷) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ عَلِیٌّ : قَوْلُ الرَّجُلِ لِلرَّجُلِ : یَا خَبِیثُ ، یَا فَاسِقُ ، قَالَ : ہُنَّ فَوَاحِشُ ، وَفِیہِنَّ عُقُوبَۃٌ ، وَلاَ تَقُولُہُنَّ فَتَعَوَّدَہُنَّ۔","","Musannaf Ibn Abi Shaybah 29567","","","كتاب أقضية رسول الله ﷺ"
"29568","(۲۹۵۶۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّ أَبَا بَکْرٍ قَالَ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : یَا خَبِیثُ ، یَا فَاسِقُ ، قَالَ : قَدْ قَالَ قَوْلاً سَیِّئًا ، وَلَیْسَ فِیہِ عُقُوبَۃٌ ، وَلاَ حَدٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 29568","","","كتاب أقضية رسول الله ﷺ"
"29569","(۲۹۵۶۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، قَالَ : شَہِدْتُ سَالِمًا ، وَالْقَاسِمَ وَسَأَلَہُمَا أَمِیرُ الْمَدِینَۃِ عَنْ رَجُلٍ قَالَ لِرَجُلٍ یَا فَاسِقُ ؟ فَقَرَآ ہَذِہِ الآیَۃَ : {إِنْ جَائَکُمْ فَاسِقٌ بِنَبَأٍ فَتَبَیَّنُوا}، وَقَالاَ : الْفَاسِقُ : الْکَذَّابُ ، یُعَزَّرُ أَسْوَاطًا۔","No Data Available","Musannaf Ibn Abi Shaybah 29569","","","كتاب أقضية رسول الله ﷺ"
"29570","(۲۹۵۷۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : یَا خَبِیثُ ، قَالَ : ہُوَ قَوْلُ سَیْئٍ ، وَلَیْسَ فِیہِ عُقُوبَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 29570","","","كتاب أقضية رسول الله ﷺ"
"29571","(۲۹۵۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَوْ أَنَّ رَجُلاً قَالَ لِرَجُلٍ : ادَّعَاک عَشَرَۃٌ ، لَمْ یَکُنْ عَلَیْہِ حَدٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29571","","","كتاب أقضية رسول الله ﷺ"
"29572","(۲۹۵۷۲) حَدَّثَنَا جَرِیرٌ ، عَنْ رَقبۃَ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : أَنْتَ دَعِیٌّ ، لَیْسَ عَلَیْہِ حَدٌّ۔","","Musannaf Ibn Abi Shaybah 29572","","","كتاب أقضية رسول الله ﷺ"
"29573","(۲۹۵۷۳) حَدَّثَنَا أَبُو عِصَامٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ مِنَ الْعَرَبِ : إِنَّک لَمَوْلًی ، قَالَ : یُضْرَبُ الْحَدَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 29573","","","كتاب أقضية رسول الله ﷺ"
"29574","(۲۹۵۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا زَنَی الرَّجُلُ بِالصَّبِیَّۃِ جُلِدَ وَلَمْ یُرْجَمْ ، وَلَیْسَ عَلَی الصَّبِیَّۃِ شَیْئٌ ، وَإِذَا زَنَی غُلاَمٌ بِامْرَأَۃٍ جُلِدَتْ وَلَمْ تُرْجَمْ ، وَعَلَی الْغُلاَمِ تَعْزِیرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29574","","","كتاب أقضية رسول الله ﷺ"
"29575","(۲۹۵۷۵) حَدَّثَنَا جَرِیرٌ ، عَنِ الْمُغِیرَۃِ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ افْتَضَّ صَبِیَّۃً ، قَالَ : عَلَیْہِ عُقْرُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 29575","","","كتاب أقضية رسول الله ﷺ"
"29576","(۲۹۵۷۶) حَدَّثَنَا عَمْرُ بْنُ عَلِیِّ بْنِ عَطَائِ بْنِ مُقَدَّمٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنِ ابْنِ مُحَیْرِیزٍ ، عَنْ فَضَالَۃَ بْنِ عُبَیْدٍ ، قَالَ : سَأَلْتُہُ عَن تَعْلِیقِ الْیَدِ فِی الَعُنُقِ ؟ فَقَالَ : السُّنَّۃُ ، قَطَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَ رَجُلٍ ، ثُمَّ عَلَّقَہَا فِی عُنُقِہِ۔ (ابوداؤد ۴۴۱۱۔ ترمذی ۱۴۴۷)","","Musannaf Ibn Abi Shaybah 29576","","","كتاب أقضية رسول الله ﷺ"
"29577","(۲۹۵۷۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا قَطَعَ یَدَ سَارِقٍ فَرَأَیْتہَا مُعَلَّقَۃً ، یَعْنِی فِی عُنُقِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29577","","","كتاب أقضية رسول الله ﷺ"
"29578","(۲۹۵۷۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا قَطَعَ یَدَ رَجُلٍ ، ثُمَّ عَلَّقَہَا فِی عُنُقِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29578","","","كتاب أقضية رسول الله ﷺ"
"29579","(۲۹۵۷۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ : یُقْتَلُ السُّحَّارُ ، وَلاَ یُسْتَتَابُون۔","","Musannaf Ibn Abi Shaybah 29579","","","كتاب أقضية رسول الله ﷺ"
"29580","(۲۹۵۸۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ؛ أَنَّ جُنْدَبًا قَتَلَ سَاحِرًا، أَوْ أَرَادَ أَنْ یَقْتُلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29580","","","كتاب أقضية رسول الله ﷺ"
"29581","(۲۹۵۸۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ سَالِمٍ ، عَنْ قَیْسِ بْنِ عُبَادٍ ؛ أنَّہُ قَتَلَ سَاحِرًا۔","","Musannaf Ibn Abi Shaybah 29581","","","كتاب أقضية رسول الله ﷺ"
"29582","(۲۹۵۸۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَمَّامِ بْنِ یَحْیَی ؛ أَنَّ عَامِلَ عُمَانَ کَتَبَ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی سَاحِرَۃٍ أَخَذَہَا ، فَکَتَبَ إِلَیْہِ عُمَرُ : إِنَ اعْتَرَفَتْ ، أَوْ قَامَتْ عَلَیْہَا الْبَیِّنَۃُ ، فَاقْتُلْہَا۔","","Musannaf Ibn Abi Shaybah 29582","","","كتاب أقضية رسول الله ﷺ"
"29583","(۲۹۵۸۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ جَارِیَۃً لِحَفْصَۃَ سَحَرَتْہَا ، وَوَجَدُوا سِحْرَہَا ، وَاعْتَرَفَتْ ، فَأَمَرَت عَبْدَ الرَّحْمَنِ بْنُ زَیْدٍ فَقَتَلَہَا ، فَبَلَغَ ذَلِکَ عُثْمَانَ فَأَنْکَرَہُ ، وَاشْتَدَّ عَلَیْہِ ، فَأَتَاہُ ابْنُ عُمَرَ فَأَخْبَرَہُ أَنَّہَا سَحَرَتْہَا ، وَوَجَدُوا سِحْرَہَا ، وَاعْتَرَفَتْ بِہِ ، فَکَأَنَّ عُثْمَانُ إِنَّمَا أَنْکَرَ ذَلِکَ لأَنَّہَا قُتِلَتْ بِغَیْرِ إِذْنِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29583","","","كتاب أقضية رسول الله ﷺ"
"29584","(۲۹۵۸۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ زَیْدٍ أَبِی الْمُعَلَّی ، قَالَ : حدَّثَنِی شُرْطِیٌّ لِسِنَانِ بْنِ سَلَمَۃَ ؛ أَنَّ سِنَانًا أُتِیَ بِسَاحِرَۃٍ ، فَأَمَرَ بِہَا أَنْ تُلْقَی فِی الْبَحْرِ۔","","Musannaf Ibn Abi Shaybah 29584","","","كتاب أقضية رسول الله ﷺ"
"29585","(۲۹۵۸۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ؛ سَمِعَ بَجَالَۃ ، یَقُولُ : کُنْتُ کَاتِبًا لِجَزْئِ بْنِ مُعَاوِیَۃَ ، فَأَتَانَا کِتَابُ عُمَرَ بْنِ الْخَطَّابِ : أَنَ اقْتُلُوا کُلَّ سَاحِرٍ وَسَاحِرَۃٍ ، قَالَ : فَقَتَلْنَا ثَلاَثَ سَوَاحِرَ۔","Sahih","Musannaf Ibn Abi Shaybah 29585","","","كتاب أقضية رسول الله ﷺ"
"29586","(۲۹۵۸۶) حَدَّثَنَا الثَّقَفِیُّ، عَنِ الْمُثَنَّی، عَنْ عَمْرِو بْنِ شُعَیْبٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ فِی السَّاحِرِ إِذَا اعْتَرَفَ قُتِلَ۔","","Musannaf Ibn Abi Shaybah 29586","","","كتاب أقضية رسول الله ﷺ"
"29587","(۲۹۵۸۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی السَّاحِرِ ، قَالَ : یُقْتَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29587","","","كتاب أقضية رسول الله ﷺ"
"29588","(۲۹۵۸۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : لَمَّا قَدِمَ عَلَی عُمَرَ فَتْحُ تَسْتُرَ ، وَتَسْتُرُ مِنْ أَرْضِ الْبَصْرَۃِ ، سَأَلَہُمْ : ہَلْ مِنْ مُغْرِبَۃٍ ؟ قَالُوا : رَجُلٌ مِنَ الْمُسْلِمِینَ لَحِقَ بِالْمُشْرِکِینَ فَأَخَذْنَاہُ، قَالَ : فَمَا صَنَعْتُمْ بِہِ ؟ قَالُوا : قَتَلْنَاہُ ، قَالَ : أَفَلاَ أَدْخَلْتُمُوہُ بَیْتًا ، وَأَغْلَقْتُمْ عَلَیْہِ بَابًا ، وَأَطْعَمْتُمُوہُ کُلَّ یَوْمٍ رَغِیفًا ، ثُمَّ اسْتَتَبْتُمُوہُ ثَلاَثًا ، فَإِنْ تَابَ ، وَإِلاَّ قَتَلْتُمُوہُ ، ثُمَّ قَالَ : اللَّہُمَّ لَمْ أَشْہَدْ ، وَلَمْ آمُرْ ، وَلَمْ أَرْضَ إِذْ بَلَغَنِی ، أَوْ قَالَ : حِینَ بَلَغَنِی۔","Da'if","Musannaf Ibn Abi Shaybah 29588","","","كتاب أقضية رسول الله ﷺ"
"29589","(۲۹۵۸۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: قَالَ عَلِیٌّ: یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا، فَإِنْ عَادَ قُتِلَ۔","Da'if","Musannaf Ibn Abi Shaybah 29589","","","كتاب أقضية رسول الله ﷺ"
"29590","(۲۹۵۹۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ، عَنِ ابْنِ جَرِیرٍ، عَنْ سُلَیْمَانَ بْنِ مُوسَی، عَنْ عُثْمَانَ، قَالَ: یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 29590","","","كتاب أقضية رسول الله ﷺ"
"29591","(۲۹۵۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَمَّنْ سَمِعَ ابْنَ عُمَرَ ، یَقُولُ : یُسْتَتَابُ الْمُرْتَدُّ ثَلاَثًا ، فَإِنْ تَابَ تُرِکَ ، وَإِنْ أَبَی قُتِلَ۔","Da'if","Musannaf Ibn Abi Shaybah 29591","","","كتاب أقضية رسول الله ﷺ"
"29592","(۲۹۵۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْمُغِیرَۃِ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمُرْتَدُّ یُسْتَتَابُ ، فَإِنْ تَابَ تُرِکَ ، وَإِنْ أَبَی قُتِلَ۔","","Musannaf Ibn Abi Shaybah 29592","","","كتاب أقضية رسول الله ﷺ"
"29593","(۲۹۵۹۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عنْ حُمَیْدِ بْنِ ہِلاَلٍ ؛ أَنَّ مُعَاذَ بْنَ جَبَلٍ أَتَی أَبَا مُوسَی وَعَندَہُ رَجُلٌ یَہُودِیٌّ ، فَقَالَ : مَا ہَذَا ؟ فَقَالَ : ہَذَا یَہُودِیٌّ أَسْلَمَ ، ثُمَّ ارْتَدَّ وَقَدِ اسْتَتَابَہُ أَبُو مُوسَی شَہْرَیْنِ ، قَالَ : فَقَالَ مُعَاذٌ : لاَ أَجْلِسُ حَتَّی أَضْرِبُ عُنُقَہُ ، قَضَائُ اللہِ وَقَضَائُ رَسُولِہِ۔ (بخاری ۶۹۲۳۔ مسلم ۱۴۵۶)","Da'if","Musannaf Ibn Abi Shaybah 29593","","","كتاب أقضية رسول الله ﷺ"
"29594","(۲۹۵۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ حَیَّانَ ، عَنِ ابْنِ شِہَابٍ ، قَالَ : یُدْعَی إِلَی الإِسْلاَمِ ثَلاَثَ مَرَّاتٍ ، فَإِنْ أَبَی ضُرِبَتْ عُنُقُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29594","","","كتاب أقضية رسول الله ﷺ"
"29595","(۲۹۵۹۵) حَدَّثَنَا ابْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ فِی الإِنْسَانِ یَکْفُرُ بَعْدَ إِسْلاَمِہِ : یُدْعَی إِلَی الإِسْلاَمِ ، فَإِنْ أَبَی قُتِلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29595","","","كتاب أقضية رسول الله ﷺ"
"29596","(۲۹۵۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَمْرُو بْنُ دِینَارٍ ؛ فِی الرَّجُلِ یَکْفُرُ بَعْدَ إِیمَانِہِ ، قَالَ : سَمِعْتُ عُبَیْدَ بْنَ عُمَیْرٍ ، یَقُولُ : یُقْتَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 29596","","","كتاب أقضية رسول الله ﷺ"
"29597","(۲۹۵۹۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَدَّلَ دِینَہُ فَاقْتُلُوہُ۔ (بخاری ۶۹۲۲۔ ابوداؤد ۴۳۵۱)","Sahih","Musannaf Ibn Abi Shaybah 29597","","","كتاب أقضية رسول الله ﷺ"
"29598","(۲۹۵۹۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عن علی ؛ فِی الْمُرْتَدَّۃِ تُسْتَأْمَی ، وَقَالَ : تُقْتَلُ۔","Sahih","Musannaf Ibn Abi Shaybah 29598","","","كتاب أقضية رسول الله ﷺ"
"29599","(۲۹۵۹۹) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ ، وَوَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی رَزِینٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ یُقْتَلْنَ النِّسَائُ إِذَا ہُنَّ ارْتَدَدْنَ عَنِ الإِسْلاَمِ ، وَلَکِنْ یُحْبَسْنَ وَیُدْعَیْنَ إِلَی الإِسْلاَمِ ، وَیُجْبَرْنَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29599","","","كتاب أقضية رسول الله ﷺ"
"29600","(۲۹۶۰۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ فِی الْمُرْتَدَّۃِ ، قَالَ : لاَ تُقْتَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29600","","","كتاب أقضية رسول الله ﷺ"
"29601","(۲۹۶۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ عمرو ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 29601","","","كتاب أقضية رسول الله ﷺ"
"29602","(۲۹۶۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَقْتُلُوا النِّسَائَ إِذَا ہُنَّ ارْتَدَدْنَ عَنِ الإِسْلاَمِ ، وَلَکِنْ یُدْعَیْنَ إِلَی الإِسْلاَمِ ، فَإِنْ ہُنَّ أَبَیْنَ سُبِینَ ، فَیُجْعَلْنَ إِمَائَ الْمُسْلِمِینَ ، وَلاَ یُقْتَلْنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29602","","","كتاب أقضية رسول الله ﷺ"
"29603","(۲۹۶۰۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حَرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَرْتَدُّ عَنِ الإِسْلاَمِ ، قَالَ : لاَ تُقْتَلُ ، تُحْبَسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29603","","","كتاب أقضية رسول الله ﷺ"
"29604","(۲۹۶۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیدۃ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُقْتَلُ۔","","Musannaf Ibn Abi Shaybah 29604","","","كتاب أقضية رسول الله ﷺ"
"29605","(۲۹۶۰۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمُرْتَدَّۃِ : تُسْتَتَابُ ، فَإِنْ تَابَتْ ، وَإِلاَّ قُتِلَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 29605","","","كتاب أقضية رسول الله ﷺ"
"29606","(۲۹۶۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ أَنَّ أُمَّ وَلَدٍ لِرَجُلٍ مِنَ الْمُسْلِمِینَ ارْتَدَّتْ ، فَبَاعَہَا بِدَوْمَۃِ الْجَنْدَلِ ، مِنْ غَیْرِ أَہْلِ دِینِہَا۔","","Musannaf Ibn Abi Shaybah 29606","","","كتاب أقضية رسول الله ﷺ"
"29607","(۲۹۶۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمَرْأَۃِ تَرْتَدُّ عَنِ الإِسْلاَمِ ، قَالَ : تُسْتَتَابُ ، فَإِنْ تَابَتْ ، وَإِلاَّ قُتِلَتْ۔","","Musannaf Ibn Abi Shaybah 29607","","","كتاب أقضية رسول الله ﷺ"
"29608","(۲۹۶۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، عَنْ سَعِیدٍ، عَنْ أَبِی مَعْشَرٍ، عَنْ إِبْرَاہِیمَ، قَالَ: تُسْتَتَابُ، فَإِنْ تَابَتْ، وَإِلاَّ قُتِلَتْ۔","","Musannaf Ibn Abi Shaybah 29608","","","كتاب أقضية رسول الله ﷺ"
"29609","(۲۹۶۰۹) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : تُقْتَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29609","","","كتاب أقضية رسول الله ﷺ"
"29610","(۲۹۶۱۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ سُوَیْدِ بْنِ غَفَلَۃَ ؛ أَنَّ عَلِیًّا حَرَقَ زَنَادِقَۃً بِالسُّوقِ ، فَلَمَّا رَمَی عَلَیْہِمْ بِالنَّارِ ، قَالَ : صَدَقَ اللَّہُ وَرَسُولُہُ ، قَالَ : ثُمَّ انْصَرَفَ ، فَاتَّبَعْتُہُ ، قَالَ : أَسُوَیْدُ ؟ قُلْتُ : نَعَمْ ، یَا أَمِیرَ الْمُؤْمِنِینَ ، سَمِعْتُک تَقُولُ شَیْئًا ، قَالَ : یَا سُوَیْد ، إِنِّی مَعَ قَوْمٍ جُہَّالٍ ، فَإِذَا سَمِعْتنِی أَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَہُوَ حَقٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 29610","","","كتاب أقضية رسول الله ﷺ"
"29611","(۲۹۶۱۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُبَیْدٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ أُنَاسٌ یَأْخُذُونَ الْعَطَائَ وَالرِّزْقَ وَیُصَلُّونَ مَعَ النَّاسِ کَانُوا یَعْبُدُونَ الأَصْنَامَ فِی السِّرِّ ، فَأُتِیَ بِہِمْ عَلِیُّ بْنُ أَبِی طَالِبٍ فَوَضَعَہُمْ فِی الْمَسْجِدِ ، أَوْ قَالَ : فِی السِّجْنِ ، ثُمَّ قَالَ : یَا أَیُّہَا النَّاسُ ، مَا تَرَوْنَ فِی قَوْمٍ کَانُوا یَأْخُذُونَ مَعَکُم الْعَطَائَ وَالرِّزْقَ ، وَیَعْبُدُونَ ہَذِہِ الأَصْنَامَ ؟ قَالَ النَّاسُ : اقْتُلْہُمْ ، قَالَ : لاَ ، وَلَکِنْ أَصْنَعُ بِہِمْ کَمَا صُنِعَ بِأَبِینَا إِبْرَاہِیمَ صلوات اللہ علیہ ، فَحَرَّقَہُمْ بِالنَّارِ۔","","Musannaf Ibn Abi Shaybah 29611","","","كتاب أقضية رسول الله ﷺ"
"29612","(۲۹۶۱۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَیُّوبَ بْنِ نُعْمَانَ ، قَالَ : شَہِدْتُ عَلِیًّا فِی الرَّحْبَۃِ ، وَجَائَ رَجُلٌ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّ ہَاہُنَا أَہْلَ بَیْتٍ لَہُمْ وَثَنٌ فِی دَارِہِمْ یَعْبُدُونَہُ ، فَقَامَ عَلِیٌّ یَمْشِی حَتَّی انْتَہَی إِلَی الدَّارِ ، فَأَمَرَہُمْ فَدَخَلُوا ، فَأَخْرَجُوا إِلَیْہِ تِمْثَالَ رُخَامٍ ، فَأَلْہَبَ عَلِیٌّ الدَّارَ۔","Da'if","Musannaf Ibn Abi Shaybah 29612","","","كتاب أقضية رسول الله ﷺ"
"29613","(۲۹۶۱۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ قَابُوسَ بْنِ مُخَارِقٍ ، عَنْ أَبِیہِ ، قَالَ : بَعَثَ عَلِیٌّ مُحَمَّدَ بْنَ أَبِی بَکْرٍ أَمِیرًا عَلَی مِصْرَ ، فَکَتَبَ مُحَمَّدٌ إِلَی عَلِیٍّ یَسْأَلُہُ عَنْ زَنَادِقَۃٍ ؛ مِنْہُمْ مَنْ یَعْبُدُ الشَّمْسَ وَالْقَمَرَ ، وَمِنْہُمْ مَنْ یَعْبُدُ غَیْرَ ذَلِکَ ، وَمِنْہُمْ مَنْ یُدْعَی لِلإِسْلاَم?? ؟ فَکَتَبَ عَلِیٌّ وَأمَرَہُ بِالزَّنَادِقَۃِ ؛ أَنْ یَقْتُلَ مَنْ کَانَ یَدْعِی الإِسْلاَمِ ، وَیُتْرَکُ سَائِرُہُمْ یَعْبُدُونَ مَا شَاؤُوا۔","Hasan","Musannaf Ibn Abi Shaybah 29613","","","كتاب أقضية رسول الله ﷺ"
"29614","(۲۹۶۱۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ بَلَغَہُ أَنَّ عَلِیًّا أَخَذَ زَنَادِقَۃً فَأَحْرَقَہُمْ ، قَالَ : فَقَالَ : أَمَّا أَنَا فَلَوْ کُنْتُ لَمْ أُعَذِّبْہُمْ بِعَذَابِ اللہِ ، وَلَوْ کُنْتُ أَنَا لَقَتَلْتہمْ ، لِقَوْلِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَدَّلَ دِینَہُ فَاقْتُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29614","","","كتاب أقضية رسول الله ﷺ"
"29615","(۲۹۶۱۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنِ ابْنِ عُبَیْدِ بْنِ الأَبْرَصِ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ؛ أَنَّہُ أُتِیَ بِرَجُلٍ کَانَ نَصْرَانِیًّا فَأَسْلَمَ ، ثُمَّ تَنَصَّرَ ، قَالَ : فَسَأَلَہُ عَنْ کَلِمَۃٍ ، فَقَالَ لَہُ ، فَقَامَ إِلَیْہِ عَلِیٌّ فَرَفَسَہُ بِرِجْلِہِ ، فَقَامَ النَّاسُ إِلَیْہِ فَضَرَبُوہُ حَتَّی قَتَلُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29615","","","كتاب أقضية رسول الله ﷺ"
"29616","(۲۹۶۱۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدِ بْنِ حَیَّانَ ، عَنْ عَمَّارٍ الدَّہْنِیِّ ، قَالَ : حدَّثَنَی أَبُو الطُّفَیْلِ ، قَالَ : کُنْتُ فِی الْجَیْشِ الَّذِینَ بَعَثَہُ عَلِیُّ بْنُ أَبِی طَالِبٍ إِلَی بَنِی نَاجِیَۃَ ، قَالَ : فَانْتَہَیْنَا إِلَیْہِمْ ، فَوَجَدْنَاہُمْ عَلَی ثَلاَثِ فِرَقٍ ، قَالَ : فَقَالَ أَمِیرُنَا لِفِرْقَۃٍ مِنْہُمْ : مَا أَنْتُمْ ؟ قَالُوا : نَحْنُ قَوْمٌ مِنَ النَّصَارَی لَمْ نَرَ دِینًا أَفْضَلَ مِنْ دِینِنَا ، فَثَبَتْنَا عَلَیْہِ ، فَقَالَ : اعْتَزَلُوا ، ثُمَّ قَالَ لِفِرْقَۃٍ أُخْرَی : مَا أَنْتُمْ ؟ قَالُوا : نَحْنُ قَوْمٌ کُنَّا نَصَارَی فَأَسْلَمْنَا فَثَبَتْنَا عَلَی الإِسْلاَمِ ، فَقَالَ : اعْتَزَلُوا ، ثُمَّ قَالَ لِلثَّالِثَۃِ : مَا أَنْتُمْ ؟ قَالُوا : نَحْنُ قَوْمٌ کُنَّا نَصَارَی فَأَسْلَمْنَا، ثُمَّ رَجَعْنَا، فَلَمْ نَرَ دِینًا أَفْضَلَ مِنْ دِینِنَا الأَوَّلِ، فَتَنَصَّرْنَا، فَقَالَ لَہُمْ: أَسْلِمُوا ، فَأَبَوْا، فَقَالَ لأَصْحَابِہِ : إِذَا مَسَحْتُ رَأْسِی ثَلاَثَ مَرَّاتٍ ، فَشُدُّوا عَلَیْہِمْ ، فَفَعَلُوا ، فَقَتَلُوا الْمُقَاتِلَۃَ ، وَسَبَوْا الذَّرِیۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 29616","","","كتاب أقضية رسول الله ﷺ"
"29617","(۲۹۶۱۷) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُسَاکِنُکُمُ الْیَہُودُ وَالنَّصَارَی ، إِلاَّ أَنْ یُسْلِمُوا ، فَمَنْ أَسْلَمَ مِنْہُمْ ثُمَّ ارْتَدَّ ، فَلاَ تَضْرِبُوا إِلاَّ عُنُقَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29617","","","كتاب أقضية رسول الله ﷺ"
"29618","(۲۹۶۱۸) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ فِی رَجُلٍ سَرَقَ مِنَ الْکَعْبَۃِ ؟ قَالَ : لَیْسَ عَلَیْہِ قَطْعٌ۔","","Musannaf Ibn Abi Shaybah 29618","","","كتاب أقضية رسول الله ﷺ"
"29619","(۲۹۶۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی بَزَّۃَ ، عَن مُجَاہِدٍ (ح) وَعَن لَیْثٍ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ (ح) وَجُوَیْبِرٍ ، عَنِ الضِّحَاکِ (ح) وَأَبِی حَرَّۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُمْ قَالُوا فِی الْمُحَارِبِ : الإِمَامُ فِیہِ مُخَیَّرٌ۔","","Musannaf Ibn Abi Shaybah 29619","","","كتاب أقضية رسول الله ﷺ"
"29620","(۲۹۶۲۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : السُّلْطَانُ وَلِیُّ قَتْلِ مَنْ حَارَبَ الدِّینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29620","","","كتاب أقضية رسول الله ﷺ"
"29621","(۲۹۶۲۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الإِمَامُ مُخَیَّرٌ فِی الْمُحَارِبِ۔","","Musannaf Ibn Abi Shaybah 29621","","","كتاب أقضية رسول الله ﷺ"
"29622","(۲۹۶۲۲) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الْمَرْأَۃِ تَقَعُ عَلَی الْمَرْأَۃِ ، قَالَ : تُضْرَبُ أَدْنَی الْحَدَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29622","","","كتاب أقضية رسول الله ﷺ"
"29623","(۲۹۶۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْحَارِثِ الْحَاطِبِیَّ ، عَنْ حَفْصَۃَ بِنْتِ زَیْدٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ؛ فِی الْمَرْأَۃِ تَرْکَبُ الْمَرْأَۃَ ، قَالَ : لَیَلْقَیْنَ اللَّہَ وَہُمَا زَانِیَتَانِ۔","","Musannaf Ibn Abi Shaybah 29623","","","كتاب أقضية رسول الله ﷺ"
"29624","(۲۹۶۲۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : {إِنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ} ، قَالَ : إِذَا خَرَجَ وَأَخَافَ السَّبِیلَ ، وَأَخَذَ الْمَالَ ، قُطِعَتْ یَدُہُ وَرِجْلُہُ مِنْ خِلاَفٍ ، وَإِذَا أَخَافَ السَّبِیلَ ، وَلَمْ یَأْخُذَ الْمَالَ نُفِیَ ، وَإِذَا قَتَلَ قُتِلَ ، وَإِذَا أَخَافَ السَّبِیلَ وَأَخَذَ الْمَالَ وَقَتَلَ صُلِبَ۔","","Musannaf Ibn Abi Shaybah 29624","","","كتاب أقضية رسول الله ﷺ"
"29625","(۲۹۶۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : حُدَّثْتُ عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَنْ حَارَبَ فَہُوَ مُحَارِبٌ ، قَالَ سَعِیدٌ : فَإِنْ أَصَابَ دَمًا قُتِلَ ، وَإِنْ أَصَابَ دَمًا وَمَالاً صُلِبَ ، فَإِنَّ الصَّلْبَ ہُوَ أَشَدُّ ، وَإِذَا أَصَابَ مَالاً وَلَمْ یُصِبْ دَمًا قُطِعَتْ یَدُہُ وَرِجْلُہُ ، لِقَوْلِ اللہِ جَلَّ جَلاَلہ : {أَوْ تُقَطَّعَ أَیْدِیہِمْ وَأَرْجُلُہُمْ مِنْ خِلاَفٍ} ، فَإِنْ تَابَ فَتَوْبَتُہُ بَیْنَہُ وَبَیْنَ اللہِ ، وَیُقَامُ عَلَیْہِ الْحَدُّ۔","","Musannaf Ibn Abi Shaybah 29625","","","كتاب أقضية رسول الله ﷺ"
"29626","(۲۹۶۲۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی قَوْلِہِ : {إِنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ وَیَسْعَوْنَ فِی الأَرْضِ فَسَادًا أَنْ یُقَتَّلُوا ، أَوْ یُصَلَّبُوا ، أَوْ تُقَطَّعَ أَیْدِیہِمْ وَأَرْجُلُہُمْ مِنْ خِلاَفٍ} حَتَّی خَتَمَ الآیَۃَ ، فَقَالَ : إِذَا حَارَبَ الرَّجُلُ فَقَتَلَ وَأَخَذَ الْمَالَ ، قُطِعَتْ یَدُہُ وَرِجْلُہُ مِنْ خِلاَفٍ وَصُلِبَ ، وَإِذَا قَتَلَ وَلَمْ یَأْخُذِ الْمَالَ قُتِلَ ، وَإِذَا أَخَذَ الْمَالَ وَلَمْ یَقْتُلْ ، قُطِعَتْ یَدُہُ وَرِجْلُہُ مِنْ خِلاَفٍ ، وَإِذَا لَمْ یَقْتُلْ وَلَمْ یَأْخُذِ الْمَالَ نُفِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 29626","","","كتاب أقضية رسول الله ﷺ"
"29627","(۲۹۶۲۷) حَدَّثَنَا وَکِیعٌ ، عَن عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ فِی ہَذِہِ الآیَۃِ : {إِنَّمَا جَزَائُ الَّذِینَ یُحَارِبُونَ اللَّہَ وَرَسُولَہُ} قَالَ : إِذَا قَتَلَ وَأَخَذَ الْمَالَ قُتِلَ ، وَإِذَا أَخَذَ الْمَالَ وَأَخَافَ السَّبِیلَ صُلِبَ ، وَإِذَا قَتَلَ وَلَمْ یَعْدُ ذَلِکَ قُتِلَ ، وَإِذَا أَخَذَ الْمَالَ وَلَمْ یَعْدُ ذَلِکَ قُطِعَ ، وَإِذَا أَفْسَدَ نُفِیَ۔","","Musannaf Ibn Abi Shaybah 29627","","","كتاب أقضية رسول الله ﷺ"
"29628","(۲۹۶۲۸) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ: مَنْ وَطِئَ فَرْجًا بِجَہَالَۃٍ ، دُرِئَ عَنْہُ الْحَدُّ ، وَضَمِنَ الْعُقْرَ۔","","Musannaf Ibn Abi Shaybah 29628","","","كتاب أقضية رسول الله ﷺ"
"29629","(۲۹۶۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ الہُجَیمیِّ ، عَنْ عَمِّہِ ، قَالَ : رَأَیْتُ سَلْمَانَ بْنَ رَبِیعَۃَ أَخَذَ رَجُلاً فِی حَدٍّ فَأَضْجَعَہُ ، ثُمَّ ضَرَبَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29629","","","كتاب أقضية رسول الله ﷺ"
"29630","(۲۹۶۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا ضَرَبَ رَجُلاً وَہُوَ قَاعِدٌ ، عَلَیْہِ عَبَائَۃٌ لَہُ قَسْطَلاَن۔","Da'if","Musannaf Ibn Abi Shaybah 29630","","","كتاب أقضية رسول الله ﷺ"
"29631","(۲۹۶۳۱) حَدَّثَنَا شَرِیکٌ، عَنْ سِمَاکٍ، عَنْ جَابِرِ بْنِ سَمُرَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا وَیَہُودِیَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 29631","","","كتاب أقضية رسول الله ﷺ"
"29632","(۲۹۶۳۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا وَیَہُودِیَّۃً۔","Da'if","Musannaf Ibn Abi Shaybah 29632","","","كتاب أقضية رسول الله ﷺ"
"29633","(۲۹۶۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیَّیْنِ ، أَنَا فِیمَنْ رَجَمَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 29633","","","كتاب أقضية رسول الله ﷺ"
"29634","(۲۹۶۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ الْبَرَائِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا۔","Sahih","Musannaf Ibn Abi Shaybah 29634","","","كتاب أقضية رسول الله ﷺ"
"29635","(۲۹۶۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجَمَ یَہُودِیًّا ، أَوْ یَہُودِیَّۃً۔","","Musannaf Ibn Abi Shaybah 29635","","","كتاب أقضية رسول الله ﷺ"
"29636","(۲۹۶۳۶) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، عَنْ مَکْحُولٍ ؛ فِی رَجُلٍ دَخَلَ حَمَّامًا ؛ فَأَخَذَ جُبَّۃً فَلَبِسَہَا بَیْنَ قَمِیصَیْنِ ، قَالَ : یُقْطَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29636","","","كتاب أقضية رسول الله ﷺ"
"29637","(۲۹۶۳۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ؛ قَالَ : أَخْبَرَنَی مُعَاوِیَۃُ بْنُ صَالِحٍ ؛ قَالَ : حَدَّثَنَی أَبُو الزَّاہِرِیَّۃِ ، عَن جُبَیْرِ بْنِ نُفَیْرٍ، عَنْ أَبِی الدَّرْدَائِ ؛ أَنَّہُ سُئِلَ عَن سَارِقِ الْحَمَّامِ ؟ فَقَالَ : لاَ قَطْعَ عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 29637","","","كتاب أقضية رسول الله ﷺ"
"29638","(۲۹۶۳۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : تُضْرَبُ النِّسَائُ ضَرْبًا دُونَ ضَرْبٍ ، وَسَوْطًا دُونَ سَوْطٍ ، وَتُتَّقَی وُجُوہُہُنَّ ، وَلاَ یُمَدَّدْنَ ، وَلاَ یُجَرَّدْنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29638","","","كتاب أقضية رسول الله ﷺ"
"29639","(۲۹۶۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَشْعَثَ ، عَنْ أَبِیہِ ؛ قَالَ : شَہِدْتُ أَبَا بَرْزَۃَ ضَرَبَ أَمَۃً لَہُ قَدْ فَجَرَتْ ، وَعَلَیْہَا مِلْحَفَۃٌ ، ضَرْبًا لَیْسَ بِالتَّمَطِّی ، وَلاَ بِالتَّخْفِیفِ۔","Da'if","Musannaf Ibn Abi Shaybah 29639","","","كتاب أقضية رسول الله ﷺ"
"29640","(۲۹۶۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَامِرٍ ؛ قَالَ : النِّسَائُ لاَ یُجَرَّدْنَ ، وَلاَ یُمْدَّدْنَ ، یُضْرَبْنَ ضَرْبًا دُونَ ضَرْبٍ ، وَسَوْطًا دُونَ سَوْطٍ ، وَتُتَّقَی وُجُوہُہُنَّ۔","","Musannaf Ibn Abi Shaybah 29640","","","كتاب أقضية رسول الله ﷺ"
"29641","(۲۹۶۴۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ؛ أَنَّ أَبَا بَکْرٍ أُتِیَ بِرَجُلٍ انْتَفَی مِنْ أَبِیہِ ، فَقَالَ أَبُو بَکْرٍ : اضْرِبِ الرَّأْسَ ، فَإِنَّ الشَّیْطَانَ فِی الرَّأْسِ ۔","","Musannaf Ibn Abi Shaybah 29641","","","كتاب أقضية رسول الله ﷺ"
"29642","(۲۹۶۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : شَہِدْتُ الشَّعْبِیَّ وَنَہَی عَنْ ضَرْبَ رَأْسِ رَجُلٍ افْتَرَی عَلَی رَجُلٍ ، وَہُوَ یُجْلَدُ۔","","Musannaf Ibn Abi Shaybah 29642","","","كتاب أقضية رسول الله ﷺ"
"29643","(۲۹۶۴۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : سُئِلَ عَطَائٌ عَنِ الرَّجُلِ یَسْمَعُ الرَّجُلَ یَقْذِفُ الرَّجُلَ ، أَیُبَلِّغُہُ ؟ قَالَ : لاَ ، إِنَّمَا تُجَالِسُونَ بِالأَمَانَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29643","","","كتاب أقضية رسول الله ﷺ"
"29644","(۲۹۶۴۴) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَن جُوَیْبِرٍ، عَنِ الضَّحَّاکِ؛ فِی رَجُلٍ قَذَفَ أمْرَأَتَہُ، ثُمَّ ادَّعَی شُہُودًا غَیْبًا، قَالَ: لاَ یُؤَجَّلُ۔","","Musannaf Ibn Abi Shaybah 29644","","","كتاب أقضية رسول الله ﷺ"
"29645","(۲۹۶۴۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عُلاَثَۃَ مُحَمَّدِ بْنِ عَبْدِ اللہِ الْعُقَیْلِیِّ ، قَالَ : قَذَفَ رَجُلٌ رَجُلاً ، فَرَفَعَہُ إِلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَادَّعَی الْقَاذِفُ الْبَیِّنَۃَ عَلَی مَا قَالَ لَہُ بِأَرْمِینِیَّۃَ ، یَعْنِی غَیْبًا ، قَالَ : فَقَالَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ: الْحَدُّ لاَ یُؤَخَّرُ ، لَکِنْ إِنْ جِئْتَ بِبَیِّنَۃٍ قَبِلْتُ شَہَادَتَہُمْ۔","","Musannaf Ibn Abi Shaybah 29645","","","كتاب أقضية رسول الله ﷺ"
"29646","(۲۹۶۴۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَن حُمَیْدٍ ، عَن بَکْرٍ ؛ أَنَّ رَجُلاً قَذَفَ رَجُلاً ، فَرَفَعَہُ إِلَی عُمَرَ بْنِ الْخَطَّابِ ، فَأَرَادَ أَنْ یَجْلِدَہُ ، فَقَالَ : أَنَا أُقِیمُ الْبَیِّنَۃَ ، فَتَرَکَہُ۔","","Musannaf Ibn Abi Shaybah 29646","","","كتاب أقضية رسول الله ﷺ"
"29647","(۲۹۶۴۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : إِذَا قَتَلَ السَّکْرَانُ قُتِلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29647","","","كتاب أقضية رسول الله ﷺ"
"29648","(۲۹۶۴۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُقْتَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29648","","","كتاب أقضية رسول الله ﷺ"
"29649","(۲۹۶۴۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ؛ أَنَّ سَکْرَانَیْنِ قَتَلَ أَحَدُہُمَا صَاحِبَہُ : فَقَتَلَہُ مُعَاوِیَۃُ۔","","Musannaf Ibn Abi Shaybah 29649","","","كتاب أقضية رسول الله ﷺ"
"29650","قالَ أَبُو بَکْرٍ : ہَذَا مَا حَفِظْت عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَضَی بِہِ وَأَجَازَ فِیہِ الْقَضَائَ۔\n حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ قَالَ : حدَّثَنَا أَبْو بَکْرٍ قَالَ :\n(۲۹۶۵۰) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَن عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِالْوَلَدِ لِلْفِرَاشِ۔","Sahih","Musannaf Ibn Abi Shaybah 29650","","","كتاب أقضية رسول الله ﷺ"
"29651","(۲۹۶۵۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی کُلِّ شَرِکٍ لَمْ یُقْسَمْ رَبْعَۃٍ ، أَوْ حَائِطٍ ، لاَ یَحِلُّ لَہُ أَنْ یَبِیعَ حَتَّی یَسْتَأْذِنَ شَرِیکَہُ ، فَإِنْ شَائَ أَخَذَ ، وَإِنْ شَائَ تَرَکَ ، فَإِنْ بَاعَ وَلَمْ یُؤْذِنْہُ ، فَہُوَ أَحَقُّ بِہِ۔ (مسلم ۱۲۲۹۔ ابوداؤد ۳۵۰۷)","Sahih","Musannaf Ibn Abi Shaybah 29651","","","كتاب أقضية رسول الله ﷺ"
"29652","(۲۹۶۵۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ قَالا : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ لِلْجِوَارِ۔","","Musannaf Ibn Abi Shaybah 29652","","","كتاب أقضية رسول الله ﷺ"
"29653","(۲۹۶۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ قَالَ : حدَّثَنَا نَافِعُ بْنُ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِالْیَمِینِ عَلَی الْمُدَّعَی عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29653","","","كتاب أقضية رسول الله ﷺ"
"29654","(۲۹۶۵۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَن فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ أَنَّہُ سُئِلَ ، عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً فَمَاتَ عنہا وَلَمْ یَدْخُلْ بِہَا وَلَمْ یَفْرِضْ لَہَا صَدَاقًا قَالَ عَبْدُ اللہِ : لَہَا الصَّدَاقُ وَلَہَا الْمِیرَاثُ وَعَلَیْہَا الْعِدَّۃُ ، وَقَالَ مَعْقِلُ بْنُ سِنَانٍ : شَہِدْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی بِرْوَعَ ابنَۃ وَاشِقٍ بِمِثْلِ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 29654","","","كتاب أقضية رسول الله ﷺ"
"29655","(۲۹۶۵۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن تَمِیمِ بْنِ طَرَفَۃَ قَالَ : اخْتَصَمَ رَجُلانِ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جَمَلٍ ، فَجَائَ کُلُّ وَاحِدٍ مِنْہُمَا إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِشَاہِدَیْنِ یَشْہَدَانِ أَنَّہُ جَمَلُہُ فَقَضَی بِہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 29655","","","كتاب أقضية رسول الله ﷺ"
"29656","(۲۹۶۵۶) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ قَالَ : کُنَّا جُلُوسًا عِنْدَ شُرَیْحٍ إِذْ أَتَاہُ قَوْمٌ یَخْتَصِمُونَ إِلَیْہِ فِی عُمْرَی جُعِلَتْ لِرَجُلِ حَیَاتَہُ ، فَقَالَ لَہُ : ہِیَ لَہُ حَیَاتَہُ وَمَوْتَہُ ، فَأَقْبَلَ عَلَیْہِ الَّذِی قَضَی عَلَیْہِ یُنَاشِدُہُ فَقَالَ شُرَیْحٌ : لَقَدْ لامَنِی ہَذَا فِی أَمْرٍ قَضَی بِہِ رسول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 29656","","","كتاب أقضية رسول الله ﷺ"
"29657","(۲۹۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ أَنَّ عُمَرَ اسْتَشَارَ النَّاسَ فِی إِمْلاصِ الْمَرْأَۃِ، فَقَالَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ : شَہِدْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِیہِ بِغُرَّۃِ عَبْدٍ ، أَوْ أَمَۃٍ ، فَقَالَ عُمَرُ : لَتَأْتِیَنَّ بِمَنْ یَشْہَدُ ، فَشَہِدَ لَہُ مُحَمَّدُ بْنُ مَسْلَمَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 29657","","","كتاب أقضية رسول الله ﷺ"
"29658","(۲۹۶۵۸) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عُبَیْدِ بْنِ نُضَیْلَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی عَاقِلَتِہَا االدِّیَۃِ ، وَفِی الْحَمْلِ غُرَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 29658","","","كتاب أقضية رسول الله ﷺ"
"29659","(۲۹۶۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَن ہُزَیْلِ بْنِ شُرَحْبِیلَ قَالَ : جَائَ رَجُلٌ إِلَی أَبِی مُوسَی وَسَلْمَانَ بْنِ رَبِیعَۃَ فَسَأَلَہُمَا عَنِ ابْنَۃٍ ، وَابْنَۃِ ابْنٍ ، وَأُخْتٍ لأَبٍ وَأُمٍّ ، فَقَالا : لِلابْنَۃِ النِّصْفُ ، وَمَا بَقِیَ فَلِلأُخْتِ ، وَائْتِ ابْنَ مَسْعُودٍ فَاسْأَلْہُ فَإِنَّہُ سَیُتَابِعُنَا ، فَأَتَی الرَّجُلُ ابْنَ مَسْعُودٍ فَسَأَلَہُ وَأَخْبَرَہُ بِمَا قَالا : فَقَالَ ابْنُ مَسْعُودٍ : {لقَدْ ضَلَلْتُ إِذًا وَمَا أَنَا مِنَ الْمُہْتَدِینَ} وَلَکِنْ سَأَقْضِی بِمَا قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلابْنَۃِ النِّصْفُ ، وَلابْنَۃِ الابْنِ السُّدُسُ تَکْمِلَۃَ الثُّلُثَیْنِ ، وَمَا بَقِیَ فَلِلأُخْتِ۔\n(بخاری ۶۷۴۲۔ ابوداؤد ۲۸۸۲)","Sahih","Musannaf Ibn Abi Shaybah 29659","","","كتاب أقضية رسول الله ﷺ"
"29660","(۲۹۶۶۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ ، عَن زَیْدِ بْنِ خَالِدٍ وَشَبْلٍ ، وَأَبِی ہُرَیْرَۃَ قَالُوا : کُنَّا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَاہُ رَجُلٌ فَقَالَ : أَنْشُدُک اللَّہَ ، إِلاَّ قَضَیْت بَیْنَنَا بِکِتَابِ اللہِ ، فَقَالَ خَصْمُہُ ، وَکَانَ أَفْقَہَ مِنْہُ : أَجَلْ یَا رَسُولَ اللہِ اقْضِ بَیْنَنَا بِکِتَابِ اللہِ وَائْذَنْ لِی حَتَّی أَقُولَ ، قَالَ : قُلْ ، قَالَ : إِنَّ ابْنِی کَانَ عَسِیفًا عَلَی ہَذَا ، وَالْعَسِیفُ : الأَجِیرُ ، وَإِنَّہُ زَنَی بِامْرَأَتِہِ فَافْتَدَیْت مِنْہُ بِمِئَۃِ شَاۃٍ وَخَادِمٍ ، فَسَأَلْت رِجَالاً مِنْ أَہْلِ الْعِلْمِ فَأُخْبِرْت أَنَّ عَلَی ابْنِی جَلْدَ مِئَۃ وَتَغْرِیبَ عَامٍ ، وَأَنَّ عَلَی امْرَأَۃِ ہَذَا الرَّجْمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَالَّذِی نَفْسِی بِیَدِہِ ، لأَقْضِیَنَّ بَیْنَکُمَا بِکِتَابِ اللہِ : الْمِئَۃُ شَاۃٍ وَالْخَادِمُ رَدٌّ عَلَیْک ، وَعَلَی ابْنِکَ جَلْدُ مِئَۃ وَتَغْرِیبُ عَامِ ، وَاغْدُ یَا أُنَیْسُ عَلَی امْرَأَۃِ ہَذَا فَإِنَ اعْتَرَفَتْ فَارْجُمْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 29660","","","كتاب أقضية رسول الله ﷺ"
"29661","(۲۹۶۶۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ : حدَّثَنَا سَیْفُ بْنُ سُلَیْمَانَ الْمَکِّیُّ قَالَ : أَخْبَرَنَی قَیْسُ بْنُ سَعْدٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِیَمِینٍ وَشَاہِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29661","","","كتاب أقضية رسول الله ﷺ"
"29662","(۲۹۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالدَّیْنِ قَبْلَ الْوَصِیَّۃِ وَأَنْتُمْ تَقْرَؤُونَ : {مِنْ بَعْدِ وَصِیَّۃٍ یُوصِی بِہَا أَوْ دَیْنٍ} وَأَنَّ أَعْیَانَ بَنِی الأُمِّ یَتَوَارَثُونَ دُونَ بَنِی الْعَلاَّتِ۔ (ابن ماجہ ۲۷۱۵۔ احمد ۱۳۱)","Da'if","Musannaf Ibn Abi Shaybah 29662","","","كتاب أقضية رسول الله ﷺ"
"29663","(۲۹۶۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَعْقُوبَ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ قَالَ: حدَّثَنِی رَبَاحٌ ، عَنْ عُثْمَانَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی أَنَّ الْوَلَدَ لِلْفِرَاشِ۔","Da'if","Musannaf Ibn Abi Shaybah 29663","","","كتاب أقضية رسول الله ﷺ"
"29664","(۲۹۶۶۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنْ شَیْبَۃَ بْنِ مُسَاوِرٍ قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَقُرِئَ عَلَیْنَا کِتَابُہُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْمُوضِحَۃِ بِخَمْسٍ مِنَ الإِبِلِ ، وَلَمْ یَقْضِ فِیمَا سِوَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29664","","","كتاب أقضية رسول الله ﷺ"
"29665","(۲۹۶۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ أَبِی مَالِکِ بْنِ ثَعْلَبَۃَ ، عَنْ أَبِیہِ ثَعْلَبَۃَ بْنِ أَبِی مَالِکٍ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَہْزُورِ وَادِی بَنِی قُرَیْظَۃَ أَنْ یَحْبِسَ الْمَائَ إِلَی الْکَعْبَیْنِ ، لاَ یَحْبِسُ الأَعْلَی عَلَی الأَسْفَلِ۔ (طبرانی ۱۳۸۶)","Da'if","Musannaf Ibn Abi Shaybah 29665","","","كتاب أقضية رسول الله ﷺ"
"29666","(۲۹۶۶۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی السِّنِّ بِخَمْسٍ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 29666","","","كتاب أقضية رسول الله ﷺ"
"29667","(۲۹۶۶۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ وَحرَامِ بْنِ سَعْدٍ أَنَّ نَاقَۃً لِلْبَرَائِ دَخَلَتْ حَائِطَ قَوْمٍ فَأَفْسَدَتْ عَلَیْہِمْ ، فَقَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ حِفْظَ الأَمْوَالِ عَلَی أَہْلِہَا بِالنَّہَارِ ، وَأَنَّ عَلَی أَہْلِ الْمَاشِیَۃِ مَا أَصَابَتِ الْمَاشِیَۃُ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 29667","","","كتاب أقضية رسول الله ﷺ"
"29668","(۲۹۶۶۸) حَدَّثَنَا أَبُو أُسَامَۃَ وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَن غَالِبٍ التَّمَّارِ، عنْ حُمَیْدِ بْنِ ہِلالٍ، عَن مَسْرُوقِ بْنِ أَوْسٍ ، عَنْ أَبِی مُوسَی الأَشْعَرِیِّ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الأَصَابِعِ عَشْرًا مِنَ الإِبِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 29668","","","كتاب أقضية رسول الله ﷺ"
"29669","(۲۹۶۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الأَصَابِعِ عَشْرًا عَشْرًا۔","Hasan","Musannaf Ibn Abi Shaybah 29669","","","كتاب أقضية رسول الله ﷺ"
"29670","(۲۹۶۷۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عُثْمَانَ الْبَتِّیِّ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ أَبَوَیْہِ اخْتَصَمَا فِیہِ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَدُہُمَا کَافِرٌ وَالآخَرُ مُسْلِمٌ ، فَخَیَّرَہُ ، فَتَوَجَّہَ إِلَی الْکَافِرِ ، فَقَالَ اللَّہُمَّ اہْدِہِ فَتَوَجَّہَ إِلَی الْمُسْلِمِ فَقَضَی لَہُ بِہِ۔ (نسائی ۶۳۸۷۔ احمد ۴۴۶)","Da'if","Musannaf Ibn Abi Shaybah 29670","","","كتاب أقضية رسول الله ﷺ"
"29671","(۲۹۶۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْجَنِینِ غُرَّۃً : عَبْدًا ، أَوْ أَمَۃً ، فَقَالَ الَّذِی قَضَی عَلَیْہِ : أَنَعْقِلُ مَنْ لاَ شَرِبَ ، وَلا أَکَلَ ، وَلا صَاحَ ، وَلا اسْتَہَلَّ ، وَمِثْلُ ذَلِکَ یُطَل ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ ہَذَا لَیَقُولُ بِقَوْلِ شَاعِرٍ ، فِیہِ غُرَّۃٌ : عَبْدٌ ، أَوْ أَمَۃٌ۔ (ابن ماجہ ۲۶۳۹)","Hasan","Musannaf Ibn Abi Shaybah 29671","","","كتاب أقضية رسول الله ﷺ"
"29672","(۲۹۶۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ قَالَ : قرِئَ عَلَیْنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَیُّمَا رَجُلٍ أَفْلَسَ فَأَدْرَکَ رَجُلٌ مَتَاعَہُ بِعَیْنِہِ ، فَہُوَ أَحَقُّ بِہِ مِنْ سَائِرِ الْغُرَمَائِ إلا أن یکون اقتضی من مالہ شیئًا ، فہو أسوۃ الغرماء ، قَضَی بِذَلِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 29672","","","كتاب أقضية رسول الله ﷺ"
"29673","(۲۹۶۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی الطُّفَیْلِ سَعِیدِ بْنِ حَمْلٍ ، عَن عِکْرِمَۃَ قَالَ: عِدَّۃُ الْمُخْتَلِعَۃِ حَیْضَۃٌ ، قَضَاہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جَمِیلَۃَ ابْنَۃِ سَلُولَ۔","Da'if","Musannaf Ibn Abi Shaybah 29673","","","كتاب أقضية رسول الله ﷺ"
"29674","(۲۹۶۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ حَجَّاجٍ ، عَنْ أَبِی سَعِیدٍ الأَعْسَمِ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْعَبْدِ وَسَیِّدِہِ قَضِیَّتَیْنِ ، قَضَی فِی الْعَبْدِ إِذَا خَرَجَ مِنْ دَارِ الْحَرْبِ قَبْلَ سَیِّدِہِ ، فَہُوَ حُرٌّ ، فَإِنْ خَرَجَ سَیِّدُہُ بَعْدَہُ لَمْ یردہ عَلَیْہِ ، وَإِنْ خَرَجَ السَّیِّدُ قَبْلَ الْعَبْدِ مِنْ دَارِ الْحَرْبِ ، ثُمَّ خَرَجَ الْعَبْدُ بَعْدَ ردّہ عَلَی سَیِّدِہِ۔ (سعید بن منصور ۲۸۰۶)","Da'if","Musannaf Ibn Abi Shaybah 29674","","","كتاب أقضية رسول الله ﷺ"
"29675","(۲۹۶۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ حَدَّثَنَا عَبَّادُ بْنُ مَنْصُورٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : فَرَّقَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا یَعْنِی الْمُتَلاعِنَیْنِ ، وَقَضَی أَنْ لاَ بَیْتَ لَہَا عَلَیْہِ ، وَلا قُوتَ مِنْ أَجْلِ أَنَّہُمَا یَتَفَرَّقَانِ مِنْ غَیْرِ طَلاقٍ ، وَلا مُتَوَفًّی عَنہَا ، وَقَضَی أَنْ لاَ یُدْعَی ولدہا لأبٍ وَلا تُرْمَی ہِیَ ، وَلا یُرْمَی وَلَدُہَا ، وَمَنْ رَمَاہَا ، أَوْ رَمَی وَلَدَہَا فَعَلَیْہِ الْحَدُّ۔","Da'if","Musannaf Ibn Abi Shaybah 29675","","","كتاب أقضية رسول الله ﷺ"
"29676","(۲۹۶۷۶) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ قَالَ : قَالَ عَلِیٌّ : مَنْ بَاعَ عَبْدًا ، وَلَہُ مَالٌ فَمَالُہُ لِلْبَائِعِ إِلاَّ أَنْ یَشْرِطَ الْمُبْتَاعُ ، قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 29676","","","كتاب أقضية رسول الله ﷺ"
"29677","(۲۹۶۷۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مَرْیَمَ ، عَن ضَمْرَۃَ بْنِ حَبِیبٍ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی ابْنَتِہِ فَاطِمَۃَ بِخِدْمَۃِ الْبَیْتِ ، وَقَضَی عَلَی عَلِیٍّ بِمَا کَانَ خَارِجًا مِنَ الْبَیْتِ مِنَ الْخِدْمَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 29677","","","كتاب أقضية رسول الله ﷺ"
"29678","(۲۹۶۷۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ فِی کُلِّ شَیْئٍ فِی الأَرْضِ وَالدَّارِ وَالْجَارِیَۃِ وَالدَّابَّۃِ ، فَقَالَ عَطَائٌ إِنَّمَا الشُّفْعَۃُ فِی الأَرْضِ وَالدَّارِ ، فَقَالَ ابْنُ أَبِی مُلَیْکَۃَ : تَسْمَعُنی لاَ أُمَّ لَکَ أَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَتَقُول ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 29678","","","كتاب أقضية رسول الله ﷺ"
"29679","(۲۹۶۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرٍو، عَن عِکْرِمَۃَ قَالَ: قضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِرَجُلٍ مِنَ الأَنْصَارِ قَتَلَہُ مَوْلَی بَنِی عَدِیٍّ بِالدِّیَۃِ اثْنَیْ عَشَرَ أَلْفًا، وَفِیہِمْ نَزَلَتْ: {وَمَا نَقَمُوا إِلاَّ أَنْ أَغْنَاہُمُ اللَّہُ وَرَسُولُہُ مِنْ فَضْلِہِ}۔","","Musannaf Ibn Abi Shaybah 29679","","","كتاب أقضية رسول الله ﷺ"
"29680","(۲۹۶۸۰) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عن داود ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ مَسْعُودٍ فَقَالَ : إِنَّ رَجُلاً مِنَّا تَزَوَّجَ امْرَأَۃً ولَمْ یَفْرِضْ لَہَا وَلَمْ یُجَامِعْہَا حَتَّی مَاتَ ، فَقَالَ ابْنُ مَسْعُودٍ : مَا سُئِلْتُ عَن شَیْئٍ مُنْذُ فَارَقْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشَدَّ عَلَیَّ مِنْ ہَذَا ، قَالَ : فَتَرَدَّدَ فِیہَا شَہْرًا فَقَالَ : سَأَقُولُ فِیہَا بِرَأْیِی ، فَإِنْ کَانَ صَوَابًا فَمِنَ اللہِ ، وَإِنْ کَانَ خَطَأً فَمِنِّی وَالشَّیْطَانِ ، أَرَی أَنَّ لَہَا مَہْرَ نِسَائِہَا لاَ وَکْسَ ، وَلا شَطَطَ ، وَلَہَا الْمِیرَاثُ ، وَعَلَیْہَا عِدَّۃُ الْمُتَوَفَّی عنہا زَوْجُہَا ، فَقَامَ نَاسٌ مِنْ أَشْجَعَ فَقَالُوا : نَشْہَدُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِمِثْلِ الَّذِی قَضَیْت فِی امْرَأَۃٍ مِنَّا یُقَالُ لَہَا بِرْوَعُ ابْنَۃُ وَاشِقٍ ، قَالَ فَمَا رَأَیْت ابْنَ مَسْعُودٍ فَرِحَ کما فَرِحَ یَوْمَئِذٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29680","","","كتاب أقضية رسول الله ﷺ"
"29681","(۲۹۶۸۱) حَدَّثَنَا یَحْیَی بْنُ زکریا بن أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَن حُمَیْدٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ قَالَ : نَحَلَ رَجُلٌ مِنَّا أُمَّہُ نخلاً حَیَاتَہَا ، فَلَمَّا مَاتَتْ قَالَ : أَنَا أَحَقُّ بِنخْلِی ، فَقَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہَا مِیرَاثٌ۔ (مسلم ۱۲۴۷)","Da'if","Musannaf Ibn Abi Shaybah 29681","","","كتاب أقضية رسول الله ﷺ"
"29682","(۲۹۶۸۲) حَدَّثَنَا یَحْیَی بْنُ زکریا بن أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَن خَالِدِ بْنِ سَلَمَۃَ قَالَ : حدَّثَنِی مُحَمَّدُ بْنُ أَبِی ضرَارٍ قَالَ : اخْتَصَمَ رَجُلانِ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَضَی عَلَی أَحَدِہِمَا ، قَالَ : فَأَحدَّ کَأَنَّہُ یُنْکِرُ وَیَرَی غَیْرَ ذَلِکَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّمَا أَنَا بَشَرٌ أَقْضِی بِمَا أَرَی ، فَمَنْ قَضَیْت لہ مِنْ حق أَخِیہِ شَیْئًا فَلا یَأْخُذْہُ۔","","Musannaf Ibn Abi Shaybah 29682","","","كتاب أقضية رسول الله ﷺ"
"29683","(۲۹۶۸۳) حَدَّثَنَا وَکِیعٌ ، حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَن مَخْلَدِ بْنِ خُفَافِ بْنِ إِیمَاء بْنِ رَحْضَۃَ الْغِفَارِیِّ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ قَالَتْ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّ خَرَاجَ الْعَبْدِ بِضَمَانِہِ۔ (ابوداؤد ۳۵۰۲۔ ترمذی ۱۲۸۵)","Hasan","Musannaf Ibn Abi Shaybah 29683","","","كتاب أقضية رسول الله ﷺ"
"29684","(۲۹۶۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَن زَیْنَبَ ابنۃ أُمِّ سَلَمَۃَ ، عَن أُمِّ سَلَمَۃَ قَالَتْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّکُمْ تَخْتَصِمُونَ إِلَیَّ ، وَإِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَکُمْ أَنْ یَکُونَ أَلْحَنَ بِحُجَّتِہِ مِنْ بَعْضٍ ، وَإِنَّمَا أَقْضِی بَیْنَکُمْ عَلَی نَحْوِ مما أَسْمَعُ مِنْکُمْ ، فَمَنْ قَضَیْت لَہُ مِنْ حَقِّ أَخِیہِ شَیْئًا فَلا یَأْخُذْہُ ، فَإِنَّمَا أَقْطَعُ لَہُ قِطْعَۃً مِنَ النَّارِ ، یَأْتِی بِہَا یَوْمَ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 29684","","","كتاب أقضية رسول الله ﷺ"
"29685","(۲۹۶۸۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی أَنَّ رَجُلَیْنِ ادَّعَیَا دَابَّۃً لَیْسَ لِوَاحِدٍ مِنْہُمَا بَیِّنَۃٌ فَقَضَی بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 29685","","","كتاب أقضية رسول الله ﷺ"
"29686","(۲۹۶۸۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الذَّکَرِ إِذَا اسْتُؤْصِلَ ، أَوْ قُطِعَتْ حَشَفَتُہُ الدِّیَۃَ مِئَۃ مِنَ الإِبِلِ۔","Da'if","Musannaf Ibn Abi Shaybah 29686","","","كتاب أقضية رسول الله ﷺ"
"29687","(۲۹۶۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِالأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ: دَعَانِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَسَأَلَنِی عَنِ الْقَسَامَۃِ فَقَالَ : إِنَّہُ قَدْ بَدَا لِی أَنْ أَرُدَّہَا إِنَّ الأَعْرَابِیَّ یَشْہَدُ ، وَالرَّجُلُ الْغَائِبُ یَجِیئُ فَیَشْہَدُ ، فَقُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّک لَنْ تَسْتَطِیعَ رَدَّہَا ، قَضَی بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْخُلَفَائُ بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 29687","","","كتاب أقضية رسول الله ﷺ"
"29688","(۲۹۶۸۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ: حدَّثَنَا ابْنُ أَبِی ذِئْبٍ، عَنِ ابْنِ شِہَابٍ، عَنْ أَبِی سَلَمَۃَ، عَنْ جَابِرِ بْنِ عَبْدِاللہِ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْعُمْرَی لَہُ وَلِعَقِبِہِ بَتْلَۃً ، لَیْسَ لِلْمُعْطِی فِیہَا شَرْطٌ ، وَلا ثُنْیَا۔","Sahih","Musannaf Ibn Abi Shaybah 29688","","","كتاب أقضية رسول الله ﷺ"
"29689","(۲۹۶۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِابْنَۃِ حَمْزَۃَ لِجَعْفَرٍ ، وَقَالَ : إِنَّ خَالَتَہَا عَندَہُ ، وَالْخَالَۃُ وَالِدَۃٌ۔ (ابوداؤد ۲۲۷۴۔ احمد ۹۸)","","Musannaf Ibn Abi Shaybah 29689","","","كتاب أقضية رسول الله ﷺ"
"29690","(۲۹۶۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ مَکْحُولٍ ، قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمُوضِحَۃِ فَصَاعِدًا ؛ قَضَی فِی الْمُوضِحَۃِ : بِخَمْسٍ مِنَ الإِبِلِ ، وَفِی المنقَّلۃ : خمس عشرۃ ، وفی المأمومۃ : الثلث ، وفی الجائفۃ : الثلث۔","","Musannaf Ibn Abi Shaybah 29690","","","كتاب أقضية رسول الله ﷺ"
"29691","(۲۹۶۹۱) حَدَّثَنَا عبد الرحیم بن سلیمان ، عن أشعث ، عن الزہری قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الصُّلْبِ الدِّیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 29691","","","كتاب أقضية رسول الله ﷺ"
"29692","(۲۹۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَن دَاوُد بْنِ أَبِی ہِنْدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : کَتَبَ إِلَیَّ أَخٌ مِنْ بَنِی زُرَیْقٍ : لِمَنْ قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِابْنِ الْمُلاعَنَۃِ ؟ فَکَتَبْت إِلَیْہِ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِہِ لأُِمِّہِ ، ہِیَ بِمَنْزِلَۃِ أَبِیہِ وَبِمَنْزِلَۃِ أُمِّہِ۔ (عبدالرزاق ۱۲۴۷۶)","","Musannaf Ibn Abi Shaybah 29692","","","كتاب أقضية رسول الله ﷺ"
"29693","(۲۹۶۹۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَنْ خَالِدِ بْنِ عَرْعَرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لَمَّا أَرَادُوا أَنْ یَرْفَعُوا الْحَجَرَ الأَسْوَدَ ، اخْتَصَمُوا فِیہِ فَقَالُوا : یَحْکُمُ بَیْنَنَا أَوَّلُ رَجُلٍ یَخْرُجُ مِنْ ہَذِہِ السِّکَّۃِ ، قَالَ : فَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوَّلَ مَنْ خَرَجَ علیہم ، فَقَضَی بَیْنَہُمْ أَنْ یَجْعَلُوہُ فِی مِرْطٍ ، ثُمَّ یَرْفَعَہُ جَمِیعُ الْقَبَائِلِ کُلِّہَا۔ (حاکم ۴۵۸)","Da'if","Musannaf Ibn Abi Shaybah 29693","","","كتاب أقضية رسول الله ﷺ"
"29694","(۲۹۶۹۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ أَبِی الْمُعْتَمِرِ عن عمر بْنِ خَلْدَۃَ الأَنْصَارِیِّ ، قَالَ : جِئنا أَبا ہُرَیْرَۃَ فِی صَاحِبٍ لَنَا أُصِیبَ بِہَذَا الدَّیْنِ ، یَعْنِی أَفْلَسَ ، فَقَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَجُلٍ مَاتَ ، أَوْ أَفْلَسَ أَنَّ صَاحِبَ الْمَتَاعِ أَحَقُّ بِمَتَاعِہِ إِذَا وَجَدَہُ إِلاَّ أَنْ یَتْرُکَ صَاحِبُہُ وَفَائً۔\n(ابوداؤد ۳۵۱۸۔ ابن ماجہ ۲۳۶۰)","Da'if","Musannaf Ibn Abi Shaybah 29694","","","كتاب أقضية رسول الله ﷺ"
"29695","(۲۹۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُمَرَ بْنِ رَاشِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہ یَقُولُ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْجِوَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 29695","","","كتاب أقضية رسول الله ﷺ"
"29696","(۲۹۶۹۶) حَدَّثَنَا وَکِیعٌ ، عَنِ علی بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ یَزِیدَ بْنِ نُعَیْمٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ نَضْرَۃَ بْنَ أَکْثَم تَزَوَّجَ امْرَأَۃً وَہِیَ حَامِلٌ ، فَفَرَّقَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا ، وَقَضَی لَہَا بِالصَّدقۃ۔ (ابوداؤد ۲۱۲۴)","","Musannaf Ibn Abi Shaybah 29696","","","كتاب أقضية رسول الله ﷺ"
"29697","(۲۹۶۹۷) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَن یُونُسَ ، عَنِ الْحَسَنِ أَنَّ عُمَرَ قَالَ : مَنْ یَعْلَمُ قَضِیَّۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْجَدِّ ، فَقَالَ : مَعْقِلُ بْنُ یَسَارٍ الْمُزَنِیّ فِینَا قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : بمَاذَا ؟ قَالَ : السُّدُسُ ، قَالَ : مَعَ مَنْ ؟ قَالَ : لاَ أَدْرِی ، قَالَ : لاَ دَرَیْت فَمَاذَا تُغْنِی إِذًا۔\n(ابوداؤد ۲۸۸۹۔ ابن ماجہ ۲۷۲۳)","Hasan","Musannaf Ibn Abi Shaybah 29697","","","كتاب أقضية رسول الله ﷺ"
"29698","(۲۹۶۹۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَن طَاوُوس ، أَنَّ امْرَأَتَیْنِ ضَرَّتَیْنِ رَمَتْ إِحْدَاہُمَا الأُخْرَی فَأَسْقَطَتْ جَنِینًا ، فَقَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہِ عَبْدًا ، أَوْ أَمَۃً ، أَوْ فَرَسًا۔","Da'if","Musannaf Ibn Abi Shaybah 29698","","","كتاب أقضية رسول الله ﷺ"
"29699","(۲۹۶۹۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ عَمَّنْ حَدَّثَہُ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی الْحَسَنِ مَوْلًی لِبَنِی نَوْفَلٍ ، قَالَ : کُنْتُ أَنَا وَامْرَأَتِی مَمْلُوکَیْنِ فَطَلَّقْتُہَا ثِنْتَیْنِ ، ثُمَّ أُعْتِقْنَا بَعْدُ ، فَأَرَدْت مُرَاجَعَتَہَا ، فَانْطَلَقْت إِلَی ابْنِ عَبَّاسٍ فَسَأَلْتُہُ ، عَن مُرَاجَعَتِہَا فَقَالَ : إِنْ رَاجَعْتہَا فَہِیَ عِنْدَکَ عَلَی وَاحِدَۃٍ ، وَمَضَتِ اثْنَتَانِ ، قَضَی بِذَلِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 29699","","","كتاب أقضية رسول الله ﷺ"
"29700","(۲۹۷۰۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ قَالَ : أَتَیْتُ عُمَرَ رضی اللہ ، عَنہ وَہُوَ بِالْمَوْسِمِ فنادیت مِنْ وَرَائِ الْفُسْطَاطِ : أَلا إِنِّی فُلانُ بْنُ فُلانٍ الْجَرْمِیُّ ، وَإِنَّ ابْنَ أُخْتٍ لَنَا عَانَ فِی بَنِی فُلانٍ وَقَدْ عَرَضْنَا عَلَیْہِ قَضِیَّۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فأبی ؟ قَالَ : فرفع عمر جانب الفسطاط ، فقال : تعرف صاحبک ؟ فقَالَ : نَعَمْ ، فقال : ہو ذاک ؛ انطلقا بہ حتی ینفذ لک قضیۃ رسول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : وَکُنَّا نَتَحَدَّثُ أَنَّ الْقَضِیَّۃَ کَانَتْ أَرْبَعًا مِنَ الإِبِلِ۔ (ابویعلی ۱۶۴)","Hasan","Musannaf Ibn Abi Shaybah 29700","","","كتاب أقضية رسول الله ﷺ"
"29701","(۲۹۷۰۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ قَالَ : ضَرَبَتِ امْرَأَۃٌ امْرَأَۃً فَقَتَلَتْہَا وَأَلْقَتْ جَنِینًا مَیِّتًا، قَالَ : فَقَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالدِّیَۃِ عَلَی عَاقِلَۃِ الْقَاتِلَۃِ ، وَلَمْ یَجْعَلْ عَلَی وَلَدِہَا ، وَلا عَلَی زَوْجِہَا شَیْئًا وَقَضَی بِالدِّیَۃِ لِزَوْجِ الْمَقْتُولَۃِ وَوَلَدِہَا ، وَلَمْ یَجْعَلْ لِعَصَبَتِہَا مِنْہَا شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 29701","","","كتاب أقضية رسول الله ﷺ"
"29702","(۲۹۷۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدِ بْنِ عَلِیٍّ وَعَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَعَنْ أَبَانَ بْنِ صَالِحٍ ، عَن مُجَاہِدٍ قَالُوا : تَغَایَرَتِ امْرَأَتَانِ لِحَمْلِ بْنِ مَالِکِ بْنِ النَّابِغَۃِ ، فَحَمَلَتْ إِحْدَاہُمَا عَلَی الأُخْرَی بِعَمُودِ فُسْطَاطٍ فَضَرَبَتْہَا فَأَلْقَتْ مَا فِی بَطْنِہَا وَمَاتَتْ ، فَرُفِعَ ذَلِکَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَضَی بِدِیَتِہَا عَلَی عَاقِلَۃِ الْقَاتِلَۃِ وَقَضَی فِی الْجَنِینِ بِغُرَّۃٍ عَبْدٍ ، أَوْ أَمَۃٍ فَقَالَ أَبُو الْقَاتِلَۃ ، أَوْ عَمُّہَا : أَنَدِی مَنْ لاَ أَکَلَ ، وَلا شَرِبَ ، وَلا صَاحَ ، ولا اسْتَہَلَّ ، وَمثل ذَلِکَ یُطَل ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ ہَذَا یَقُولُ بِقَوْلِ شَاعِرٍ ، نَعَمْ ، فِیہِ غُرَّۃٌ : عَبْدٌ ، أَوْ أَمَۃٌ۔\n(بخاری ۶۷۴۰۔ مسلم ۱۳۰۹)","","Musannaf Ibn Abi Shaybah 29702","","","كتاب أقضية رسول الله ﷺ"
"29703","(۲۹۷۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِشَاہِدٍ وَیَمِین المدعی ، فَقَالَ أَبُو جَعْفَرٍ : وَقَضَی بِہِ عَلِیٌّ فِیکُمْ۔","","Musannaf Ibn Abi Shaybah 29703","","","كتاب أقضية رسول الله ﷺ"
"29704","(۲۹۷۰۴) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فِی رَجُلٍ قَتَلَ رَجُلاً وَأَمْسَکَہُ آخَرَ : أَنْ یُقتل القَاتل ویُحبس الممسک۔","","Musannaf Ibn Abi Shaybah 29704","","","كتاب أقضية رسول الله ﷺ"
"29705","(۲۹۷۰۵) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا ابن أبی ذئب ، عن الحکم بن مسلم السالمی ، عن عبد الرحمن بن ہرمز الأعرج قَالَ : قضی رَسُول اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أن لاَ تَجُوزُ شَہَادَۃُ الظِّنَّۃِ ، وَلا الْحِنَۃِ ولا الجِنَّۃ۔\n(عبدالرزاق ۱۵۳۶۶۔ حاکم ۹۹)","","Musannaf Ibn Abi Shaybah 29705","","","كتاب أقضية رسول الله ﷺ"
"29706","(۲۹۷۰۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سِمَاکٍ ، عَن حَنَشِ بْنِ الْمُعْتَمِرِ قَالَ : حُفِرَت زُبْیَۃٌ بِالْیَمَنِ لِلأَسَدِ ، فَوَقَعَ فِیہَا الأَسَدُ ، فَأَصْبَحَ النَّاسُ یَتَدَافَعُونَ عَلَی رَأْسِ الْبِئْرِ ، فَوَقَعَ فِیہَا رَجُلٌ فَتَعَلَّقَ بِرَجُلٍ ، ثُمَّ تَعَلَّقَ الآخَرُ بِآخَرَ ، فَہَوَی فِیہَا أَرْبَعَۃٌ فَہَلَکُوا جَمِیعًا ، فَلَمْ یَدْرِ النَّاسُ کَیْفَ یَصْنَعُونَ ، فَجَائَ عَلِیٌّ رحمہ اللہ فَقَالَ : إِنْ شِئْتُمْ قَضَیْت بَیْنَکُمْ بِقَضَائٍ یَکُونُ حَاجِزًا بَیْنَکُمْ حَتَّی تَأْتُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَإِنِّی أَجْعَلُ الدِّیَۃَ عَلَی مَنْ حَضَرَ رَأْسَ الْبِئْرِ ، فَجَعَلَ لِلأَوَّلِ الَّذِی ہُوَ فِی الْبِئْرِ رُبْعَ الدِّیَۃِ ، وَلِلثَّانِی ثُلُثَ الدِّیَۃِ ، وَلِلثَّالِثِ نِصْفَ الدِّیَۃِ ، وَلِلرَّابِعِ الدِّیَۃَ کَامِلَۃً ، قَالَ : فَتَرَاضَوْا عَلَی ذَلِکَ حَتَّی أَتَوُا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرُوہُ بِقَضَائِ عَلِیٍّ فَأَجَازَ الْقَضَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 29706","","","كتاب أقضية رسول الله ﷺ"
"29707","(۲۹۷۰۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَن سِمَاکٍ ، عَن حَنَشٍ ، عَنْ عَلِیٍّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا تَقَاضَی إِلَیْک رَجُلانِ فَلا تَقْضِ لِلأَوَّلِ حَتَّی تَسْمَعَ مَا یَقُولُ الآخَرُ ، فَإِنَّک سَوْفَ تَرَی کَیْفَ تَقْضِی ، قَالَ عَلِیٌّ : فَمَا زِلْت بَعْدَہَا قَاضِیًا۔","Da'if","Musannaf Ibn Abi Shaybah 29707","","","كتاب أقضية رسول الله ﷺ"
"29708","(۲۹۷۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ عَلِیٍّ قَالَ : بَعَثَنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی أَہْلِ الْیَمَنِ لأَقْضِیَ بَیْنَہُمْ ، قُلْتُ : یَا رَسُولَ اللہِ : إِنَّہ لاَ عِلْمَ لِی بِالْقَضَائِ ، فَضَرَبَ بِیَدِہِ عَلَی صَدْرِی ، وَقَالَ : اللَّہُمَّ اہْدِ قَلْبَہُ وَسَدِّدْ لِسَانَہُ ، قَالَ : فَمَا شَکَکْت فِی قَضَائٍ بَیْنَ اثْنَیْنِ حَتَّی جَلَسْت مَجْلِسِی ہَذَا۔ (احمد ۸۸۔ حاکم ۸۸)","","Musannaf Ibn Abi Shaybah 29708","","","كتاب أقضية رسول الله ﷺ"
"29709","(۲۹۷۰۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عُبَیْدِ بْنِ نُضَیْلۃ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : شَہِدْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِیہِ بِغُرَّۃٍ عَبْدٍ ، أَوْ أَمَۃٍ ، فَقَالَ عمر : لِتَجِیئَ بِمَنْ یَشْہَدُ مَعَک ، فَشَہِدَ لَہُ مُحَمَّدُ بْنُ مَسْلَمَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 29709","","","كتاب أقضية رسول الله ﷺ"
"29710","(۲۹۷۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عَوْنٍ ، عَنِ الْحَارِثِ بْنِ عَمْرٍو الْہُذَلِیِّ ، عَنْ رَجُلٍ مِنْ أَہْلِ حِمْصَ مِنْ أَصْحَابِ مُعَاذٍ ، عَن مُعَاذٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا بَعَثَہُ قَالَ : کَیْفَ تَقْضِی ، قَالَ : أَقْضِی بِکِتَابِ اللہِ ، قَالَ : فَإِنْ لَمْ یَکُنْ فی کِتَابِ اللہ ؟ قَالَ : أَقْضِی بِسُنَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَإِنْ لَمْ تَکُنْ سُنَّۃٌ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : أَجْتَہِدُ بِرَأْیِی ، قَالَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَمْدُ لِلَّہِ الَّذِی وَفَّقَ رَسُولَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 29710","","","كتاب أقضية رسول الله ﷺ"
"29711","(۲۹۷۱۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَنِ ابْنَۃِ حَمْزَۃَ ، قَالَ مُحَمَّدٌ : وَہِیَ أُخْتُ ابْنِ شَدَّادٍ لأُِمِّہِ ، قَالَتْ : مَاتَ مَوْلی لی وَتَرَکَ ابْنَتَہُ، فَقَسَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَالَہُ بَیْنِی وَبَیْنَ ابْنَتِہِ ، فَجَعَلَ لِی النِّصْفَ وَلَہَا النِّصْفَ۔\n(ابن ماجہ ۲۷۳۴۔ طبرانی ۸۷۴)","Da'if","Musannaf Ibn Abi Shaybah 29711","","","كتاب أقضية رسول الله ﷺ"
"29712","(۲۹۷۱۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إِسْرَائِیلَ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرِّکَازِ الْخُمُسَ۔","","Musannaf Ibn Abi Shaybah 29712","","","كتاب أقضية رسول الله ﷺ"
"29713","(۲۹۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْعَقْلِ عَلَی الْعَصَبَۃِ ، وَالدِّیَۃُ مِیرَاثٌ۔ (عبدالرزاق ۱۷۷۶۸)","","Musannaf Ibn Abi Shaybah 29713","","","كتاب أقضية رسول الله ﷺ"
"29714","(۲۹۷۱۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ فِی کُلِّ شَیْئٍ : الأَرْضِ ، وَالدَّارِ ، وَالْجَارِیَۃِ ، وَالدَّابَّۃِ ، فَقَالَ عَطَائٌ : إِنَّمَا الشُّفْعَۃُ فِی الأَرْضِ وَالدَّارِ ، فَقَالَ لَہُ ابْنُ أَبِی مُلَیْکَۃَ : تَسْمَعنی لاَ أُمَّ لَکَ أَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَل??یْہِ وَسَلَّمَ ، وَتَقُولُ ہَذَا ؟!!۔","","Musannaf Ibn Abi Shaybah 29714","","","كتاب أقضية رسول الله ﷺ"
"29715","(۲۹۷۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حدَّثَنَا ابْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَن سُلَیْمَانَ بْنِ یَسَارٍ ، وَقَالَ : الْقَسَامَۃُ حَقٌّ قَضَی بِہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَمَا الأَنْصَارُ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذْ خَرَجَ رَجُلٌ مِنْہُمْ ، ثُمَّ خَرَجُوا مِنْ عِنْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَإِذَا ہُمْ بِصَاحِبِہِمْ یَتَشَحَّطُ فِی دَمِہِ ، فَرَجَعُوا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالُوا : قَتَلَتْنَا یَہُود ، وَسَمُّوا رَجُلاً مِنْہُمْ ، وَلَمْ تَکُنْ لَہُمْ بَیِّنَۃٌ، فَقَالَ لَہُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : شَاہِدَانِ مِنْ غَیْرِکُمْ حَتَّی أَدْفَعَہُ إِلَیْکُمْ بِرُمَّتِہِ ، فَلَمْ تَکُنْ لَہُمْ بَیِّنَۃٌ فَقَالَ : اسْتَحَقُّوا بخمسین قَسَامَۃً أَدْفَعُہُ إِلَیْکُمْ بِرُمَّتِہِ ، فقَالُوا : إِنَّا نَکْرَہُ أَنْ نَحْلِفَ عَلَی غَیْبٍ ، فَأَرَادَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَأْخُذَ قَسَامَۃَ الْیَہُودِ بِخَمْسِینَ مِنْہُمْ ، فَقَالَتِ الأَنْصَارُ : یَا رَسُولَ اللہِ ، إِنَّ الْیَہُودَ لاَ یُبَالُونَ الْحَلِفَ ، مَتَی نَقْبَلُ ہَذَا مِنْہُمْ یَأْتُونَا عَلَی آخِرِنَا ، فَوَدَاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ عَندِہِ۔","","Musannaf Ibn Abi Shaybah 29715","","","كتاب أقضية رسول الله ﷺ"
"29716","(۲۹۷۱۶) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْضِی بِالْقَضَائَ ، ثُمَّ یَنْزِلُ الْقُرْآنُ بِغَیْرِ الَّذِی قَضَی بِہِ فَلا یَرُدُّہُ ، وَیَسْتَأْنِفُ۔","","Musannaf Ibn Abi Shaybah 29716","","","كتاب أقضية رسول الله ﷺ"
"29717","(۲۹۷۱۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ النَّجْرَانِیِّ قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ عمَرَ : أُسْلِمُ فِی نَخْلٍ قَبْلَ أَنْ یُطْلِعَ ، قَالَ : لاَ ، قُلْتُ : لِمَ ؟ قَالَ : إِنَّ رَجُلاً أَسْلَمَ فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَدِیقَۃِ نَخْلٍ قَبْلَ أَنْ تُطْلِعَ ، فَلَمْ تُطْلِعْ شَیْئًا ذَلِکَ الْعَامَ ، فَقَالَ الْمُشْتَرِی : ہُوَ لِی حَتَّی تُطْلِعَ ، وَقَالَ الْبَائِعُ : إِنَّمَا بِعْتُک النَّخْلَ ہَذِہِ السَّنَۃَ، فَاخْتَصَمَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْبَائِعِ : أَجَدَّ مِنْ نَخْلِکَ شَیْئًا ؟ قَالَ : لاَ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَبِمَ تَسْتَحِلُّ مَالَہُ ؟ ارْدُدْ عَلَیْہِ مَا أَخَذْت مِنْہُ ، وَلا تُسْلِمُوا فِی نَخْلٍ حَتَّی یَبْدُوَ صَلاحُہُ۔ (ابوداؤد ۳۴۶۱۔ احمد ۱۵)","Da'if","Musannaf Ibn Abi Shaybah 29717","","","كتاب أقضية رسول الله ﷺ"
"29718","(۲۹۷۱۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنِ الْحَسَنِ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَجُلٍ عَضَّ یَدَ رَجُلٍ فَنَزَعَ الرَّجُلُ یَدَہُ مِنْ فِیہِ فَانْتَزَعَتْ ثَنِیَّتَہُ ، فَانْطَلَقَ الرَّجُلُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہُ لَمْ یَدَعْک تَأْکُلُ یَدَہُ ، فَلَمْ یَقْضِ لَہُ مِنَ الدِّیَۃِ شَیْئًا۔","Hasan","Musannaf Ibn Abi Shaybah 29718","","","كتاب أقضية رسول الله ﷺ"
"29719","(۲۹۷۱۹) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْمَرْأَۃِ تُقْتَلُ : یَرِثُہَا وَلَدُہَا وَالْعَقْلُ عَلَی عَصَبَتِہَا۔","","Musannaf Ibn Abi Shaybah 29719","","","كتاب أقضية رسول الله ﷺ"
"29720","(۲۹۷۲۰) حَدَّثَنَا شَبَابَۃُ ، حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : قَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَرِثُ قَاتِلُ مَنْ قَتَلَ وَلِیَّہُ شَیْئًا مِنَ الدِّیَۃ عَمْدًا ، أَوْ خَطَأً۔ (ابوداؤد ۳۶۰۔ بیہقی ۲۱۹)","","Musannaf Ibn Abi Shaybah 29720","","","كتاب أقضية رسول الله ﷺ"
"29721","(۲۹۷۲۱) حَدَّثَنَا شَبَابَۃُ ، حَدَّثَنَا ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْقَسَامَۃِ أَنَّ الْیَمِینَ عَلَی الْمُدَّعَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 29721","","","كتاب أقضية رسول الله ﷺ"
"29722","(۲۹۷۲۲) حَدَّثَنَا شَبَابَۃُ ، حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ أَبِی جَابِرٍ الْبَیَاضِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرَّجُلِ یُغَیِّرُ شَہَادَتَہُ ، قَالَ : یُؤْخَذُ بِالأُولَی۔ (عبدالرزاق ۱۵۵۰۸)","Da'if","Musannaf Ibn Abi Shaybah 29722","","","كتاب أقضية رسول الله ﷺ"
"29723","(۲۹۷۲۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الرَّجُلِ یُقِرُّ بِالْوَلَدِ ، ثُمَّ یَنْتَفِی مِنْہُ ، قَالَ : یُلاعن بِکِتَابِ اللہِ ، وَیُلْزَمُ الْوَلَدَ بِقَضَائِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 29723","","","كتاب أقضية رسول الله ﷺ"
"29724","(۲۹۷۲۴) حَدَّثَنَا عَفَّانُ ، حدَّثَنَا ہَمَّامٌ ، َدَّثَنَا قَتَادَۃُ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنَّ زَوْجَ بَرِیرَۃَ کَانَ عَبْدًا أَسْوَدَ یُسَمَّی مُغِیثًا ، فَقَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہَا أَرْبَعَ قَضِیَّاتٍ ، قَضَی أَنَّ مَوَالِیَہَا اشْتَرَطُوا الْوَلائَ ، فَقَضَی أَنَّ الْوَلائَ لِمَنْ أَعْطَی الثَّمَنَ ، وَخَیَّرَہَا ، وَأَمَرَہَا أَنْ تَعْتَدَّ ، وَتُصُدِّقَ عَلَیْہَا بِصَدَقَۃٍ ، فَأَہْدَتْ مِنْہا إِلَی عَائِشَۃَ فَذَکَرَتْ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ہُوَ لَہَا صَدَقَۃٌ وَلَنَا ہَدِیَّۃٌ۔\n(بخاری ۵۲۸۰۔ ابوداؤد ۲۲۲۵)","Sahih","Musannaf Ibn Abi Shaybah 29724","","","كتاب أقضية رسول الله ﷺ"
"29725","(۲۹۷۲۵) حَدَّثَنَا شَبَابَۃُ ، حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جَنِینِ امْرَأَۃٍ مِنْ بَنِی لَحْیَانَ سَقَطَ مَیِّتًا بِغُرَّۃٍ عَبْدٍ ، أَوْ أَمَۃٍ ، ثُمَّ إِنَّ الْمَرْأَۃَ الَّتِی قَضَی عَلَیْہَا بِالْغُرَّۃِ تُوُفِّیَتْ ، فَقَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّ مِیرَاثَہَا لِزَوْجِہَا وَبَنِیہَا ، وَأَنَّ الْعَقْلَ عَلَی عَصَبَتِہَا۔ (بخاری ۶۷۴۰۔ مسلم ۱۳۰۹)","Sahih","Musannaf Ibn Abi Shaybah 29725","","","كتاب أقضية رسول الله ﷺ"
"29726","(۲۹۷۲۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حَدَّثَنَا الثَّوْرِیِّ ، عَن حُمَیْدٍ الأَعْرَجِ ، عَن طَارِقٍ الْمَکِّیِّ ، عَنْ جَابِرٍ قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی امْرَأَۃٍ مِنَ الأَنْصَارِ أَعْطَاہَا ابْنُہَا حَدِیقَۃً مِنْ نَخْلٍ فَمَاتَتْ ، فَقَالَ ابْنُہَا : إِنَّمَا أَعْطَیْتہَا حَیَاتَہَا ، وَلَہُ إِخْوَۃٌ ، فَقَالَ لَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہِیَ لَہَا حَیَاتَہَا وَمَوْتَہَا ، قَالَ : فإِنی کُنْتُ تَصَدَّقْتُ بِہَا عَلَیْہَا ، قَالَ : فَذَاکَ أَبْعَدُ لَک۔ (ابوداؤد ۳۵۵۲۔ بیہقی ۱۷۴)","Sahih","Musannaf Ibn Abi Shaybah 29726","","","كتاب أقضية رسول الله ﷺ"
"29727","(۲۹۷۲۷) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أو ابْنِ أَبِی مُلَیْکَۃَ وَعَمْرِو بْنِ دِینَارٍ قَالا : مَا زِلْنَا نَسْمَعُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی الْعَبْدِ الآبِقِ یُؤخَدُ خَارِجًا مِنَ الْحَرَمِ دِینَارًا وَعَشَرَۃَ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 29727","","","كتاب أقضية رسول الله ﷺ"
"29728","(۲۹۷۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا قَضَی بالْوَلَدَ لابْنِ زَمْعَۃَ قَالَ : یا سَوْدَۃ : احْتَجِبِی مِنْہُ ، وَقَالَ : إِنِّی لَوْ لَمْ أ??فْعَلْ ہَذَا لَمْ یَشَأْ رَجُلٌ أَنْ یَدَّعِیَ وَلَدَ رَجُلٍ إِلاَّ ادَّعَاہُ۔\n(بخاری ۲۰۵۳۔ مسلم ۱۰۸۰)","","Musannaf Ibn Abi Shaybah 29728","","","كتاب أقضية رسول الله ﷺ"
"29729","(۲۹۷۲۹) حَدَّثَنَا عَفَّانُ ، حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ رَجُلَیْنِ ادَّعَیَا بَعِیرًا ، فَبَعَثَ کُلٌّ مِنْہُمَا بِشَاہِدَیْنِ ، فَقَضَی فِیہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 29729","","","كتاب أقضية رسول الله ﷺ"
"29730","(۲۹۷۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا جُوَیْرِیَۃُ بْنُ أَسْمَائَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ مَوْلَی الْمُنْبَعِثِ ، عَنْ رَجُلٍ ، عَن سُرَّقٍ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِشَاہِدٍ وَیَمِینٍ۔","Da'if","Musannaf Ibn Abi Shaybah 29730","","","كتاب أقضية رسول الله ﷺ"
"29731","حَدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :\n(۲۹۷۳۱) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ : حَدَّثَنَا زَیْدُ بْنُ ثَابِتٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : تَعَوَّذُوا بِاللہِ مِنْ عَذَابِ النَّارِ ثَلاثًا ، قُلْنَا : نَعُوذُ بِاللہِ مِنْ عَذَابِ النَّارِ ، فقال : تَعَوَّذُوا بِاللہِ مِنْ عَذَابِ الْقَبْرِ ، قلنا نَعُوذُ بِاللہِ مِنْ عَذَابِ الْقَبْرِ ، قَالَ : تَعَوَّذُوا بِاللہِ مِنَ الْفِتَنِ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ ، قلنا نَعُوذُ بِاللہِ مِنَ الْفِتَنِ مَا ظَہَرَ مِنْہَا ، قَالَ : تَعَوَّذُوا بِاللہِ مِنْ فِتْنَۃِ الدَّجَّالِ ، قُلْنَا : نَعُوذُ بِاللہِ مِنْ فِتْنَۃِ الدَّجَّالِ۔","Sahih","Musannaf Ibn Abi Shaybah 29731","","","كتاب الدعاء"
"29732","(۲۹۷۳۲) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سَلُوا اللَّہَ عِلْمًا نَافِعًا ، وَتَعَوَّذُوا بِاللہِ مِنْ عِلْمٍ لاَ یَنْفَعُ۔","Hasan","Musannaf Ibn Abi Shaybah 29732","","","كتاب الدعاء"
"29733","(۲۹۷۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الشَّیْطَانِ مِنْ ہَمْزِہِ وَنَفْثِہِ وَنَفْخِہِ ، قَالَ : فَہَمْزُہُ الْمَوْتَۃُ ، وَنَفْثُہُ الشِّعْرُ ، وَنَفْخُہُ الْکِبْرُ۔ (ابن ماجہ ۸۰۸۔ احمد ۴۰۳)","Da'if","Musannaf Ibn Abi Shaybah 29733","","","كتاب الدعاء"
"29734","(۲۹۷۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ أَبِی عُثْمَانَ ، وَعَبْدِ اللہِ بْنِ الْحَارِثِ ، عَن زَیْدِ بْنِ أَرْقَمَ قَالَ: لاَ أَقُولُ لَکُمْ إِلاَّ مَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْعَجْزِ وَالْکَسَلِ وَالْبُخْلِ وَالْجُبْنِ وَالْہَرَمِ وَعَذَابِ الْقَبْرِ ، اللَّہُمَّ آتِ نَفْسِی تَقْوَاہَا، أَنْتَ وَلِیُّہَا وَمَوْلاہَا، أَنْتَ خَیْرُ مَنْ زَکَّاہَا ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ عِلْمٍ لاَ یَنْفَعُ، وَنَفْسٍ لاَ تَشْبَعُ ، وَقَلْبٍ لاَ یَخْشَعُ، وَدُعَائٍ لاَ یُسْتَجَابُ۔","Sahih","Musannaf Ibn Abi Shaybah 29734","","","كتاب الدعاء"
"29735","(۲۹۷۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَن ہِلالٍ ، عَن فَرْوَۃَ بْنِ نَوْفَلٍ ، عَنْ عَائِشَۃَ ، قَالَ : سَأَلْتُہَا عَن دُعَائٍ کَانَ یَدْعُو بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَتْ : کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ مَا عَمِلْتُ وشَرِّ مَا لَمْ أَعْلَمْ۔ (مسلم ۶۵۔ ابوداؤد ۱۵۴۵)","Sahih","Musannaf Ibn Abi Shaybah 29735","","","كتاب الدعاء"
"29736","(۲۹۷۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن مُحَمَّدِ بْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : کَانَ مِنْ دُعَائِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ عِلْمٍ لاَ یَنْفَعُ ، وَمِنْ دُعَائٍ لاَ یُسْمَعُ ، وَمِنْ قَلْبٍ لاَ یَخْشَعُ ، وَمِنْ نَفْسٍ لاَ تَشْبَعُ۔ (ابوداؤد ۱۵۴۳۔ احمد ۳۴۰)","Hasan","Musannaf Ibn Abi Shaybah 29736","","","كتاب الدعاء"
"29737","(۲۹۷۳۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن حُمَیْدِ بْنِ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ قَلْبٍ لاَ یَخْشَعُ ، وَعِلْمٍ لاَ یَنْفَعُ وَدُعَائٍ لاَ یُسْمَعُ وَنَفْسٍ لاَ تَشْبَعُ ، وَمِنَ الْجُوعِ فَإِنَّہُ بِئْسَ الضَّجِیعُ۔ (حاکم ۵۳۳)","Da'if","Musannaf Ibn Abi Shaybah 29737","","","كتاب الدعاء"
"29738","(۲۹۷۳۸) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ عِلْمٍ لاَ یَنْفَعُ، وَعَمَلٍ لاَ یُرْفَعُ، وَقَلْبٍ لاَ یَخْشَعُ، وَقَوْلٍ لاَ یُسْمَعُ۔\n(احمد ۱۹۲۔ ابویعلی ۲۸۳۷)","Sahih","Musannaf Ibn Abi Shaybah 29738","","","كتاب الدعاء"
"29739","(۲۹۷۳۹) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْبَرَصِ وَالْجُذَامِ وَمِنْ سَیِّئِ الأَسْقَامِ۔ (ابوداؤد ۱۵۴۹۔ احمد ۱۹۲)","Sahih","Musannaf Ibn Abi Shaybah 29739","","","كتاب الدعاء"
"29740","(۲۹۷۴۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَن مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا ہَذِہِ الْکَلِمَاتِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْبُخْلِ ، وَأَعُوذُ بِکَ مِنَ الْجُبْنِ ، وَأَعُوذُ بِکَ أَنْ أُرَدَّ إِلَی أَرْذَلِ الْعُمُرِ ، وَأَعُوذُ بِکَ مِنْ فِتْنَۃِ الدُّنْیَا وَعَذَابِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29740","","","كتاب الدعاء"
"29741","(۲۹۷۴۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْکَسَلِ وَالْہَرَمِ وَالْمَأْثَمِ وَالْمَغْرَمِ۔ (بخاری ۶۳۶۸۔ مسلم ۲۰۷۸)","Sahih","Musannaf Ibn Abi Shaybah 29741","","","كتاب الدعاء"
"29742","(۲۹۷۴۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، أَنَّہُ قَالَ لِبَنِیہِ : أَیْ بَنِیَّ تَعَوَّذُوا بِکَلِمَاتٍ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَعَوَّذُ بِہِنَّ فَذَکَرَ مِثْلَ حَدِیثِ عَبِیدَۃَ ، إلاَّ أَنَّہُ لَمْ یَذْکُرْ : أَرْذَلِ الْعُمُرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29742","","","كتاب الدعاء"
"29743","(۲۹۷۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَن عُمَرَ ، أَنَّ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَعَوَّذُ مِنَ الْجُبْنِ وَالْبُخْلِ وَعَذَابِ الْقَبْرِ وَأَرْذَلِ الْعُمُرِ وَفِتْنَۃِ الصَّدْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29743","","","كتاب الدعاء"
"29744","(۲۹۷۴۴) حَدَّثَنَا شَبَابَۃُ ، حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَن عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29744","","","كتاب الدعاء"
"29745","(۲۹۷۴۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو بِہَؤُلائِ الدَّعَوَاتِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ فِتْنَۃِ النَّارِ وَعَذَابِ النَّارِ وَمِنْ فِتْنَۃِ الْقَبْرِ وَعَذَابِ الْقَبْرِ وَمِنْ شَرِّ فِتْنَۃِ الْغِنَی وَمِنْ شَرِّ فِتْنَۃِ الْفَقْرِ ، وَأَعُوذُ بِکَ مِنْ فِتْنَۃِ الْمَسِیحِ الدَّجَّالِ۔","Sahih","Musannaf Ibn Abi Shaybah 29745","","","كتاب الدعاء"
"29746","(۲۹۷۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَعَوَّذُوا بِاللہِ مِنْ جَہَنَّمَ ، تَعَوَّذُوا بِاللہِ مِنْ عَذَابِ الْقَبْرِ ، تَعَوَّذُوا بِاللہِ مِنْ فِتْنَۃِ الْمَسِیحِ الدَّجَّالِ ، تَعَوَّذُوا بِاللہِ مِنْ فِتْنَۃِ الْمَحْیَا وَالْمَمَاتِ۔","Sahih","Musannaf Ibn Abi Shaybah 29746","","","كتاب الدعاء"
"29747","(۲۹۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ الدَّسْتَوَائِیِّ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَعَوَّذُ مِنَ الْجُبْنِ وَالْبُخْلِ ، وَمِنْ فِتْنَۃِ الْمَحْیَا وَالْمَمَاتِ ، وَمِنْ عَذَابِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29747","","","كتاب الدعاء"
"29748","(۲۹۷۴۸) حَدَّثَنَا وَکِیعٌ ، عَن عُثْمَانَ الشَّحَّامِ ، عَن مُسْلِمِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَدْعُو فِی دُبُرِ الصَّلاۃِ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْکُفْرِ وَالْفَقْرِ وَعَذَابِ الْقَبْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 29748","","","كتاب الدعاء"
"29749","(۲۹۷۴۹) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الْمُغِیرَۃِ ابْنِ عَبْدِ اللہِ ، عَنِ الْمَعْرُورِ ، عَنْ عَبْدِ اللہِ قَالَ : قالَتْ أُمُّ حَبِیبَۃَ زَوْجُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ أمْتِعْنی بِزَوْجِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَبِأَبِی أَبِی سُفْیَانَ وَبِأَخِی مُعَاوِیَۃَ ، قَالَ : فَقَالَ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّکِ سَأَلْتِ اللَّہَ لآجَالٍ مَضْرُوبَۃٍ وَأَیَّامٍ مَعْدُودَۃٍ ، وَأَرْزَاقٍ مَقْسُومَۃٍ ، وَلَنْ یُعَجِّلَ شَیْئًا قَبْلَ حِلِّہِ ، أَوْ یُؤَخِّرَ شَیْئًا عَن حِلِّہِ وَلَوْ کُنْتِ سَأَلْتِ اللَّہَ أَنْ یُعِیذَکِ مِنْ عَذَابٍ فِی النَّارِ أَوْ عَذَابٍ فِی الْقَبْرِ کَانَ خَیْرًا وَأَفْضَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 29749","","","كتاب الدعاء"
"29750","(۲۹۷۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ یَحْیَی بْنُ حَبَّانَ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : فَقَدْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ مِنَ الْفِرَاشِ فَالْتَمَسْتہ ، فَوَقَعَتْ یَدَیَّ عَلَی بَطْنِ قَدَمَیْہِ وَہُوَ فِی الْمَسْجِدِ وَہُمَا مَنْصُوبَتَانِ وَہُوَ یَقُولُ : إنَّی أَعُوذُ بِرِضَاکَ مِنْ سَخَطِکَ ، وَبِمُعَافَاتِکَ مِنْ عُقُوبَتِکَ وَأَعُوذُ بِکَ مِنْکَ ، لاَ أُحْصِی ثَنَائً عَلَیْکَ ، أَنْتَ کَمَا أَثْنَیْتَ عَلَی نَفْسِکَ۔ (مسلم ۳۵۲۔ ابوداؤد ۸۷۵)","Sahih","Musannaf Ibn Abi Shaybah 29750","","","كتاب الدعاء"
"29751","(۲۹۷۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو بِہَذَا الدُّعَائِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْہَمِّ وَالْحَزَنِ وَالْعَجْزِ وَالْکَسَلِ وَالْجُبْنِ وَالْبُخْلِ۔ \n(ترمذی ۳۴۸۵۔ احمد ۱۷۹)","Sahih","Musannaf Ibn Abi Shaybah 29751","","","كتاب الدعاء"
"29752","(۲۹۷۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبَّادِ بْنِ عَاصِمٍ ، عَن نَافِعِ بْنِ جُبَیْرٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ افْتَتَحَ الصَّلاۃَ یَقُولُ: اللَّہُ أَکْبَرُ ثَلاثًا، الْحَمْدُ لِلَّہِ کَثِیرًا ثَلاثًا ، سُبْحَانَ اللہِ بُکْرَۃً وَأَصِیلاً ثَلاثًا ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الشَّیْطَانِ مِنْ ہَمْزِہِ وَنَفْثِہِ وَنَفْخِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29752","","","كتاب الدعاء"
"29753","(۲۹۷۵۳) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ قَالَ : حدِّثْتُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ دُعَائٍ لاَ یُسْمَعُ ، وَعِلْمٍ لاَ یَنْفَعُ ، وَقَلْبٍ لاَ یَخْشَعُ ، وَنَفْسٍ لاَ تَشْبَعُ ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ ہَؤُلائِ الأَرْبَعِ ، اللَّہُمَّ إنِّی أَسْأَلُک عِیشَۃً سَوِیَّۃً ، وَمِیتَۃً تَقِیَّۃً ، وَمَرَدًّا إلَیْک غَیْرَ مُخْزٍ۔ (طبرانی ۱۴۳۵)","","Musannaf Ibn Abi Shaybah 29753","","","كتاب الدعاء"
"29754","(۲۹۷۵۴) حَدَّثَنَا الْمُطَّلِبُ بْنُ زِیَادٍ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ: اللَّہُمَّ إنِّی أَعُوذُبِکَ مِنَ الشَّکِّ بَعْدَ الْیَقِینِ، وَأَعُوذُ بِکَ مِنْ مُقَارَنَۃِ الشَّیَاطِینِ، وَأَعُوذُ بِکَ مِنْ عَذَابِ یَوْمِ الدِّینِ۔","Da'if","Musannaf Ibn Abi Shaybah 29754","","","كتاب الدعاء"
"29755","(۲۹۷۵۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سَعْدِ بْنِ أَوْسٍ ، عَن بِلالِ بْنِ یَحْیَی قَالَ : حدَّثَنِی شُتَیْرُ بْنُ شَکَلٍ ، عَنْ أَبِیہِ شَکَلِ بْنِ حُمَیْدٍ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقُلْتُ : عَلِّمْنِی تَعْوِیذًا أَتَعَوَّذُ بِہِ فَقَالَ : قُلِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ سَمْعِی وَبَصَرِی وَلِسَانِی وَمَنِیِّی۔ (ابوداؤد ۱۵۴۶۔ احمد ۴۲۹)","Sahih","Musannaf Ibn Abi Shaybah 29755","","","كتاب الدعاء"
"29756","(۲۹۷۵۶) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا وُہَیْبٌ ، حَدَّثَنَا مُوسَی بْنُ عُقْبَۃَ قَالَ حَدَّثَتْنِی أُمُّ خَالِدٍ بِنْتُ خَالِدٍ ، أَنَّہَا سَمِعَتْ مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثًا وَہُوَ یَتَعَوَّذُ مِنْ عَذَابِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29756","","","كتاب الدعاء"
"29757","(۲۹۷۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ عَن أُمِّ مُبَشِّرٍ قَالَتْ : دَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا فِی حَائِطٍ مِنْ حَوَائِطِ بَنِی النَّجَّارِ فِیہِ قُبُورٌ ، مِنْہُمْ قَدْ مُوِّتُوا فِی الْجَاہِلِیَّۃِ ، قَالَتْ: فَخَرَجَ فَسَمِعْتہ وَہُوَ یَقُولُ : اسْتَعِیذُوا بِاللہِ مِنْ عَذَابِ الْقَبْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 29757","","","كتاب الدعاء"
"29758","(۲۹۷۵۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، قَالا : حدَّثَنَا الأَعْمَشُ ، عَنِ الْمِنْہَالِ ، عَن زَاذَانَ ، عَنِ الْبَرَائِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اسْتَعِیذُوا بِاللہِ مِنْ عَذَابِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29758","","","كتاب الدعاء"
"29759","(۲۹۷۵۹) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن حُمَیْدٍ قَالَ: سُئِلَ أَنَسٌ، عَنْ عَذَابِ الْقَبْرِ فَقَالَ أَنَسٌ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْکَسَلِ وَالْہَرَمِ وَالْجُبْنِ وَالْبُخْلِ وَفِتْنَۃِ الدَّجَّالِ وَعَذَابِ الْقَبْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29759","","","كتاب الدعاء"
"29760","(۲۹۷۶۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی سِنَانٍ عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، عَن شَیْخٍ حَسِبْتہ قَالَ : کَانَ یُصَلِّی فِی مَسْجِدٍ إِیلیَاء ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرٍو یَقُولُ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ قَلْبٍ لاَ یَخْشَعُ ، وَنَفْسٍ لاَ تَشْبَعُ ، وَعِلْمٍ لاَ یَنْفَعُ ، وَدُعَائٍ لاَ یُسْمَعُ ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ ہَؤُلائِ الأَرْبَعِ۔ (ترمذی ۳۴۸۲۔ احمد ۱۶۷)","Da'if","Musannaf Ibn Abi Shaybah 29760","","","كتاب الدعاء"
"29761","(۲۹۷۶۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُو : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ غَلَبَۃِ الدَّیْنِ وَغَلَبَۃِ الْعَدُوِّ وَبَوَارِ الأَیِّمِ۔ (طبرانی ۱۳۵۴)","","Musannaf Ibn Abi Shaybah 29761","","","كتاب الدعاء"
"29762","(۲۹۷۶۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَکَمِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَعَوَّذُ مِنْ أَرْبَعٍ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ غَلَبَۃِ الْعَدُوِّ ، وَمِنْ غَلَبَۃِ الدَّیْنِ ، وَفِتْنَۃِ الدَّجَّالِ ، وَعَذَابِ الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 29762","","","كتاب الدعاء"
"29763","(۲۹۷۶۳) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو بِہَذَا الدُّعَائِ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ غَلَبَۃِ الدَّیْنِ وَغَلَبَۃِ الْعَدُوِّ۔","","Musannaf Ibn Abi Shaybah 29763","","","كتاب الدعاء"
"29764","(۲۹۷۶۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عَبْدِ الْجَلِیلِ بْنِ عَطِیَّۃَ قَالَ : حدَّثَنَی جَعْفَرُ بْنُ مَیْمُونٍ قَالَ : حَدَّثَنَی عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرَۃَ قَالَ : حَدَّثَنِی أَبِی ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ کَلِمَاتُ لِلْمَکْرُوبِ : اللَّہُمَّ رَحْمَتَکَ أَرْجُو ، فَلا تَکِلْنِی إِلَی نَفْسِی طَرْفَۃَ عَیْنٍ ، وَأَصْلِحْ لِی شَأْنِی کُلَّہُ ، لاَ إلَہَ إِلاَّ أَنْتَ۔\n(ابوداؤد ۵۰۴۹۔ احمد ۴۲)","Da'if","Musannaf Ibn Abi Shaybah 29764","","","كتاب الدعاء"
"29765","(۲۹۷۶۵) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ الدَّسْتَوَائِیِّ ، عَن قَتَادَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ عِنْدَ الْکَرْبِ : لاَ إلَہَ إِلاَّ اللَّہُ الْحَلِیمُ الْکَرِیمُ ، لاَ إلَہَ إِلاَّ اللَّہُ رَبُّ السَّمَاوَاتِ وَرَبُّ الْعَرْشِ الْعَظِیمِ۔ (بخاری ۶۳۴۵۔ مسلم ۲۰۹۳)","Sahih","Musannaf Ibn Abi Shaybah 29765","","","كتاب الدعاء"
"29766","(۲۹۷۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ قَالَ حَدَّثَنَی ہِلالٌ مَوْلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَن عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، أَنَّ أُمَّہُ أَسْمَائَ بِنْتِ عُمَیْسٍ قَالَتْ : عَلَّمَنِی رَسُولُ اللہِ کَلِمَاتٍ أَقُولُہُنَّ عِنْدَ الْکَرْبِ : اللَّہَ اللَّہَ رَبِّی لاَ أُشْرِکُ بِہِ شَیْئًا۔ (ابوداؤد ۱۵۲۰۔ ابن ماجہ ۳۸۸۲)","Hasan","Musannaf Ibn Abi Shaybah 29766","","","كتاب الدعاء"
"29767","(۲۹۷۶۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ إِسْحَاقَ الْجَزَرِیِّ ، عَنْ أَبِی جَعْفَرٍ قَالَ : کَلِمَاتُ الْفَرَجِ: لاَ إلَہَ إِلاَّ اللَّہُ الْعَلِیُّ الْعَظِیمُ ، سُبْحَانَ اللہِ رَبِّ الْعَرْشِ الْکَرِیمِ ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، اللَّہُمَّ اغْفِرْ لِی وَارْحَمْنِی وَتَجَاوَزْ عَنی وَاعْفُ عَنی فَإِنَّک عَفُوٌّ غَفُورٌ۔","","Musannaf Ibn Abi Shaybah 29767","","","كتاب الدعاء"
"29768","(۲۹۷۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَن صَفْوَانَ بْنِ عَبْدِ اللہِ وَکَانَتْ تَحْتَہُ الدَّرْدَائُ ، فَأَتَاہَا فَوَجَدَ أُمَّ الدَّرْدَائِ وَلَمْ یَجِدْ أَبَا الدَّرْدَائَ ، فَقَالَتْ لَہُ : تُرِیدُ الْحَجَّ الْعَامَ ؟ قَالَ : نَعَمْ ، قَالَتْ : فَادْعُ اللَّہَ لَنَا بِخَیْرٍ فَإِنَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : إنَّ دَعْوَۃَ الْمَرْئِ مُسْتَجَابَۃٌ لأَخِیہِ بِظَہْرِ الْغَیْبِ عِنْدَ رَأْسِہِ مَلَکٌ یُؤَمِّنُ عَلَی دُعَائِہِ کُلَّمَا دَعَا لَہُ بِخَیْرٍ قَالَ : آمِینَ ، وَلَک بِمِثْلِہِ ، ثُمَّ خَرَجْت إِلَی السُّوقِ فَلَقِیتُ أَبَا الدَّرْدَائِ فَحَدَّثَنِی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ ذَلِکَ۔ (مسلم ۲۰۹۵۔ ابن ماجہ ۲۸۹۵)","Sahih","Musannaf Ibn Abi Shaybah 29768","","","كتاب الدعاء"
"29769","(۲۹۷۶۹) حَدَّثَنَا یَعْلَی ، عَنِ الإِفْرِیقِیِّ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ الدُّعَائِ دَعْوَۃُ غَائِبٍ لِغَائِبٍ۔ (ابوداؤد ۱۵۳۰۔ ترمذی ۱۹۸۰)","Hasan","Musannaf Ibn Abi Shaybah 29769","","","كتاب الدعاء"
"29770","(۲۹۷۷۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن حُمَیْدٍ الطَّوِیلِ ، عَن طَلْحَۃَ ، عَن أُمِّ الدَّرْدَائِ قَالَتْ : دَعْوَۃُ الْمَرْئِ الْمُسْلِمِ لأَخِیہِ وَہُوَ غَائِبٌ لاَ تُرَدُ ، قَالَ : وَقَالَتْ : إِلَی جَنْبِہِ مَلَکٌ لاَ یَدْعُو لَہُ بِخَیْرٍ إِلاَّ قَالَ الْمَلَکُ : آمین وَلَکَ۔","","Musannaf Ibn Abi Shaybah 29770","","","كتاب الدعاء"
"29771","(۲۹۷۷۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن فُضَیْلِ بْنِ غَزْوَانَ ، قَالَ : سَمِعْتُ طَلْحَۃَ بْنَ عُبَیْدِ اللہِ بْنِ کَرِیزٍ ، قَالَ : سَمِعْتُ أُمَّ الدَّرْدَائِ قَالَتْ : سَمِعْت النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إِنَّہُ یُسْتَجَابُ لِلْمَرْئِ بِظَہْرِ الْغَیْبِ لأَخِیہِ ، فَمَا دَعَا لأَخِیہِ بِدَعْوَۃٍ إِلاَّ قَالَ الْمَلَکُ : وَلَک بِمِثْلِ۔ (مسلم ۲۰۹۴۔ ابوداؤد ۱۵۲۹)","","Musannaf Ibn Abi Shaybah 29771","","","كتاب الدعاء"
"29772","(۲۹۷۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَعَا أَحَدُکُمْ فَلْیَعْزِمْ فِی الدُّعَائِ وَلا یَقُلِ : اللَّہُمَّ إِنْ شِئْتَ فَأَعْطِنِی فَإِنَّ اللَّہَ لاَ مُسْتَکْرِہَ لَہُ۔\n(بخاری ۶۳۳۸۔ مسلم ۲۰۶۳)","Sahih","Musannaf Ibn Abi Shaybah 29772","","","كتاب الدعاء"
"29773","(۲۹۷۷۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ عَجْلانَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَقُلْ أَحَدُکُمْ : اغْفِرْ لِی إِنْ شِئْتَ ، وَلْیَعْزِمْ فِی الْمَسْأَلَۃِ فَإِنَّہُ لاَ مُکْرِہَ لَہُ۔\n(ابوداؤد ۱۴۷۸۔ ترمذی ۳۴۹۷)","Hasan","Musannaf Ibn Abi Shaybah 29773","","","كتاب الدعاء"
"29774","(۲۹۷۷۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ قَالَ : قالَتْ عَائِشَۃُ لابْنِ أَبِی السَّائِبِ قَاصِّ أَہْلِ مَکَّۃَ اجْتَنِبَ السَّجْعَ فِی الدُّعَائِ فَإِنِّی عَہِدْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَصْحَابَہُ ، وَہُمْ لاَ یَفْعَلُونَ ذَلِکَ۔ (طبرانی ۵۴)","","Musannaf Ibn Abi Shaybah 29774","","","كتاب الدعاء"
"29775","(۲۹۷۷۵) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا الأَسْوَدُ بْنُ شَیْبَانَ ، حَدَّثَنَا أَبُو نَوْفَلُ بْنُ أَبِی عَقْرَبٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحِبُّ الْجَوَامِعَ مِنَ الدُّعَائِ ، وَیَدَعُ مَا بَیْنَ ذَلِکَ۔ (ابوداؤد ۱۴۷۷)","Sahih","Musannaf Ibn Abi Shaybah 29775","","","كتاب الدعاء"
"29776","(۲۹۷۷۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ ، عَنْ أَبِی الصِّدِّیقِ ، عَنْ أَبِی سَعِیدٍ قَالَ : إذَا سَأَلْتُمَ اللَّہَ فَاعْزِمُوا فَإِنَّ اللَّہَ لاَ مُسْتَکْرِہَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29776","","","كتاب الدعاء"
"29777","(۲۹۷۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن ذَرٍّ ، عَن یُسَیْعٍ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الدُّعَائُ ہُوَ الْعِبَادَۃُ ، ثُمَّ تَلا : {وَقَالَ رَبُّکُمُ ادْعُونِی أَسْتَجِبْ لَکُمْ} ۔۔۔ الآیَۃَ۔\n(ترمذی ۳۲۴۷۔ ابوداؤد ۱۴۷۴)","Sahih","Musannaf Ibn Abi Shaybah 29777","","","كتاب الدعاء"
"29778","(۲۹۷۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرٍ ، عَن مُوسَی بْنِ عُقْبَۃَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ فُتِحَ لَہُ مِنَ الدُّعَائِ مِنْکُمْ فُتِحَتْ لَہُ أَبْوَابُ الإِجَابَۃِ۔ (ترمذی ۳۵۴۸)","Da'if","Musannaf Ibn Abi Shaybah 29778","","","كتاب الدعاء"
"29779","(۲۹۷۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمَلِیحِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لَمْ یَدْعُ اللَّہَ غَضِبَ عَلَیْہِ۔ (بخاری ۶۵۸۔ ابن ماجہ ۳۸۲۷)","Da'if","Musannaf Ibn Abi Shaybah 29779","","","كتاب الدعاء"
"29780","(۲۹۷۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَلِیِّ بْنِ عَلِیٍّ ، قَالَ : سَمِعْتُ أَبَا الْمُتَوَکِّلِ النَّاجِیَّ قَالَ : قَالَ أَبُو سَعِیدٍ قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ مُسْلِمٍ یَدْعُو بِدَعْوَۃٍ لَیْسَ فِیہَا إِثْمَ وَلا قَطِیعَۃُ رَحِمٍ إِلاَّ أَعْطَاہُ اللَّہُ بِہَا إحْدَی ثَلاثٍ : إمَّا أَنْ یُعَجِّلَ لَہُ دَعْوَتَہُ ، وَإِمَّا یَدَّخِرَہَا لَہُ فِی الآخِرَۃِ ، وَإِمَّا أَنْ یَکْشِفَ عَنہُ من السُّوئَ بِمِثْلِہَا، قَالُوا : إذًا نُکْثِرُ یَا نبی اللہ ، قَالَ : اللَّہُ أَکْثَرُ۔ (بخاری ۷۱۰۔ احمد ۱۸)","Hasan","Musannaf Ibn Abi Shaybah 29780","","","كتاب الدعاء"
"29781","(۲۹۷۸۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ قَالَ : کَانَ یُقَالُ : إذَا بَدَأَ الرَّجُلُ بِالثَّنَائِ قَبْلَ الدُّعَائِ ، فَقَدِ اسْتَوْجَبَ ، وَإِذَا بَدَأَ بِالدُّعَائِ قَبْلَ الثَّنَائِ کَانَ عَلَی رَجَائٍ۔","","Musannaf Ibn Abi Shaybah 29781","","","كتاب الدعاء"
"29782","(۲۹۷۸۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ قَالَ : بَلَغَنِی أَنَّ الْمُسْلِمَ إذَا دَعَا فَلَمْ یُسْتَجَبْ لَہُ کُتِبَتْ لَہُ حَسَنَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 29782","","","كتاب الدعاء"
"29783","(۲۹۷۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن عُمَارَۃَ ، عَنْ أَبِی عَمَّارٍ ، عَن حُذَیْفَۃَ قَالَ : لَیَأْتِیَنَّ عَلَی النَّاسِ زَمَانٌ لاَ یَنْجُو فِیہِ إِلاَّ مَنْ دَعَا بِدُعَائٍ کَدُعَائِ الْغَرَقِ۔ (حاکم ۵۰۷)","Sahih","Musannaf Ibn Abi Shaybah 29783","","","كتاب الدعاء"
"29784","(۲۹۷۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَن ہَمَّامٍ ، عَن حُذَیْفَۃَ مِثْلُہُ إلاَّ أَنَّہُ قَالَ : الَّذِی یَدْعُو۔","Sahih","Musannaf Ibn Abi Shaybah 29784","","","كتاب الدعاء"
"29785","(۲۹۷۸۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، وَیُونُسُ بْنِ عُبَیْدٍ ، عَنِ الْحَسَنِ ، أَنَّ أَبَا الدَّرْدَائِ کَانَ یَقُولُ : جِدُّوا فی الدُّعَائِ فَإِنَّہُ مَنْ یُکْثِرُ قَرْعَ الْبَابِ یُوشِکُ أَنْ یُفْتَحَ لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 29785","","","كتاب الدعاء"
"29786","(۲۹۷۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ ثُمَامَۃَ بْنِ عُقْبَۃَ الْمُحَلِّمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد قَالَ : قَالَ عَبْدُ اللہِ : إذَا کَانَ عَلَی أَحَدِکُمْ إمَامٌ یَخَافُ تَغَطْرُسَہُ وَظُلْمَہُ فَلْیَقُلِ : اللَّہُمَّ رَبَّ السَّمَاوَاتِ السبع وَرَبَّ الْعَرْشِ الْعَظِیمِ ، کُنْ لِی جَارًا مِنْ فُلانٍ وَأَحْزَابِہِ وَأَشْیَاعِہِ أَنْ یَفْرُطُوا عَلَیَّ ، أَوْ أَنْ یَطْغَوْا ، عَزَّ جَارُک وَجَلَّ ثَنَاؤُک ، وَلا إلَہَ غَیْرُک إِلاَّ أَنَّ أَبَا مُعَاوِیَۃَ زَادَ فِیہِ : قَالَ الأَعْمَشُ : فَذَکَرْتہ لإِبْرَاہِیمَ فَحَدَّثَ عَنْ عَبْدِ اللہِ بِمِثْلِہِ ، وَزَادَ فِیہِ : مِنْ شَرِّ الْجِنِّ وَالإِنْسِ۔ (بخاری ۷۰۷)","Sahih","Musannaf Ibn Abi Shaybah 29786","","","كتاب الدعاء"
"29787","(۲۹۷۸۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو قَالَ : حَدَّثَنِی سَعِیدُ بْنُ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا أَتَیْتَ سُلْطَانًا مَہِیبًا تَخَافُ أَنْ یَسْطُوَ عَلَیْک فَقُلْ : اللَّہُ أَکْبَرُ ، اللَّہُ أَعَزُّ مِنْ خَلْقِہِ جَمِیعًا، اللَّہُ أَعَزُّ مِمَّا أَخَافُ وَأَحْذَرُ، أَعُوذُ بِاللہِ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْمُمْسِکُ السَّمَاوَاتِ السَّبْعِ أَنْ یَقَعْنَ عَلَی الأَرْضِ إِلاَّ بِإِذْنِہِ ، مِنْ شَرِّ عَبْدِکَ فُلانٍ وَجُنُودِہِ وَأَتْبَاعِہِ وَأَشْیَاعِہِ مِنَ الْجِنِّ وَالإِنْسِ ، اللَّہُمَّ کُنْ لِی جَارًا مِنْ شَرِّہِمْ ، جَلَّ ثَنَاؤُک وَعَزَّ جَارُک وَتَبَارَکَ اسْمُک ، وَلا إلَہَ غَیْرُک ثَلاثَ مَرَّاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29787","","","كتاب الدعاء"
"29788","(۲۹۷۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن حُصَیْنٍ ، عَنْ عَامِرٍ قَالَ : کُنْتُ جَالِسًا مَعَ زِیَادِ بْنِ أَبِی سُفْیَانَ فَأُتِیَ بِرَجُلٍ یُحْمَلُ ، مَا نَشُکُّ فِی قَتْلِہِ ، قَالَ : فَرَأَیْتہ حَرَّکَ شَفَتَیْہِ بِشَیْئٍ مَا نَدْرِی مَا ہُوَ ، فَخَلَّی سَبِیلَہُ فَأَقْبَلَ إلَیْہِ بَعْضُ الْقَوْمِ فَقَالَ : لَقَدْ جِیئَ بِکَ ، وَمَا نَشُکُّ فِی قَتْلِکَ ، فَرَأَیْتُکَ حَرَّکْتَ شَفَتَیْک بِشَیْئٍ مَا نَدْرِی مَا ہُوَ ، قَالَ : فَخَلَّی سَبِیلَک ، قَالَ : قُلْتُ : اللَّہُمَّ رَبَّ إبْرَاہِیمَ وَرَبَّ إِسْحَاقَ وَرَبَّ یَعْقُوبَ وَرَبَّ جِبْرِیلَ وَمِیکَائِیلَ وَإِسْرَافِیلَ وَمُنَزِّلَ التَّوْرَاۃِ وَالإِنْجِیلِ وَالزَّبُورِ وَالْقُرْآنِ الْعَظِیمِ ، ادْرَأْ عَنی شَرَّ زِیَادٍ۔","","Musannaf Ibn Abi Shaybah 29788","","","كتاب الدعاء"
"29789","(۲۹۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ الْحَسَنِ بْنِ الْحَسَنِ ، أَنَّ عَبْدَ اللہِ بْنَ جَعْفَرٍ زَوَّجَ ابْنَتَہُ فَخَلا بِہَا فَقَالَ : إذَا نَزَلَ بِکَ الْمَوْتُ ، أَوْ أَمْرٌ مِنْ أُمُورِ الدُّنْیَا فَظِیعٌ فَاسْتَقْبِلِیہِ بِأَنْ تَقُولِی : لاَ إلَہَ إِلاَّ اللَّہُ الْحَلِیمُ الْکَرِیمُ ، سُبْحَانَ اللہِ رَبِّ الْعَرْشِ الْعَظِیمِ ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔\n قَالَ الْحَسَنُ بْنُ الْحَسَنِ : فَبَعَثَ إلَیَّ الْحَجَّاجُ فَقُلْتُہُنَّ ، فَلَمَّا قُمْت بَیْنَ یَدَیْہِ قَالَ : لقد بَعَثْتُ إلَیْک ، وَأَنَا أُرِیدُ أَنْ أَضْرِبَ عُنُقَکَ وَلَقَدْ صِرْت، وَمَا مِنْ أَہْلِ بَیْتِ أَحَدٌ أَکْرَمُ عَلَیَّ مِنْک، سَلْنِی حَاجَتَک۔ (نسائی ۱۰۴۶۳)","Hasan","Musannaf Ibn Abi Shaybah 29789","","","كتاب الدعاء"
"29790","(۲۹۷۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ قَالَ : کَانَ الرَّجُلُ إذَا کَانَ مِنْ خَاصَّۃِ الشَّعْبِیِّ أَخْبَرَہُ بِہَذَا الدُّعَائِ : اللَّہُمَّ إلَہَ جِبْرِیلَ وَمِیکَائِیلَ وَإِسْرَافِیلَ وَإِلَہَ إبْرَاہِیمَ وَإِسْمَاعِیلَ وَإِسْحَاقَ عَافِنِی ، وَلا تُسَلِّطَنَّ أَحَدًا مِنْ خَلْقِکَ عَلَیَّ بِشَیْئٍ لاَ طَاقَۃَ لِی بِہِ ، وَذُکِرَ أَنَّ رَجُلاً أَتَی أَمِیرًا فَقَالَہَا ، فَأَرْسَلِہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29790","","","كتاب الدعاء"
"29791","(۲۹۷۹۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ قَالَ : مَنْ خَافَ مِنْ أَمِیرٍ ظُلْمًا فَقَالَ : رَضِیت بِاللہِ رَبًّا وَبِالإِسْلامِ دِینًا وَبِمُحَمَّدٍ نَبِیًّا وَبِالْقُرْآنِ حَکَمًا وَإِمَامًا أَنْجَاہُ اللَّہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 29791","","","كتاب الدعاء"
"29792","(۲۹۷۹۲) حَدَّثَنِی یَحْیَی بْنُ أَبِی بکیر قَالَ : حدَّثَنَی زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَن مُعَاذِ بْنِ رِفَاعَۃَ بْنِ رَافِعٍ الأَنْصَارِیِّ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ أَبَا بَکْرٍ یَقُول سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی ہَذَا الْقَیْظِ عَامَ الأَوَّلِ : سَلُوا اللَّہَ الْعَافِیَۃَ وَالْیَقِینَ فِی الآخِرَۃِ وَالاُولَی۔\n(ترمذی ۳۵۵۸۔ احمد ۳)","Da'if","Musannaf Ibn Abi Shaybah 29792","","","كتاب الدعاء"
"29793","(۲۹۷۹۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَن یَحْیَی بْنِ جَعْدَۃِ قَالَ : قَالَ أَبُو بَکْرٍ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ الأَوَّلِ ، وَالْعَہْدُ قَرِیبٌ یَقُولُ : سَلُوا اللَّہَ الْیَقِینَ وَالْعَافِیَۃَ۔","","Musannaf Ibn Abi Shaybah 29793","","","كتاب الدعاء"
"29794","(۲۹۷۹۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ : حدَّثَنَی عَبْدُ الْجَلِیلِ بْنُ عَطِیَّۃَ قَالَ : حَدَّثَنَی جَعْفَرُ بْنُ مَیْمُونٍ قَالَ : حَدَّثَنَی عَبْدُ الرَّحْمَن بْنُ أَبِی بَکْرَۃَ ، قَالَ : سَمِعْتُ أَبِی یَدْعُو بِہَذَا الدُّعَائِ : اللَّہُمَّ عَافِنِی فِی بَدَنِی ، اللَّہُمَّ عَافِنِی فِی سَمْعِی ، اللَّہُمَّ عَافِنِی فِی بَصَرِی ، لاَ إلَہَ إِلاَّ أَنْتَ غُدْوَۃً وَعَشِیَّۃً ، فَقُلْتُ لَہُ : یَا أَبَتِ ، سَمِعْتُک ، وَأَنْتَ تَدْعُو بِہَذَا الدُّعَائِ غُدْوَۃً وَعَشِیَّۃً قَالَ : یَا بُنَی ، إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُو بِہِ وَأَنَا أُحِبُّ أَنْ أَسْتَنَّ بِسُنَّتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29794","","","كتاب الدعاء"
"29795","(۲۹۷۹۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ قَالَ الْعَبَّاسُ : یَا رَسُولَ اللہِ ، عَلِّمْنِی شَیْئًا أَسْأَلُہُ رَبِّی ، قَالَ : سَلْ رَبَّک الْعَافِیَۃَ فِی الدُّنْیَا وَالآخِرَۃِ۔ (بخاری ۷۲۶۔ ترمذی۳۵۱۴)","Da'if","Musannaf Ibn Abi Shaybah 29795","","","كتاب الدعاء"
"29796","(۲۹۷۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَ??ِی بَکْرِ بْنِ أَبِی مُلَیْکَۃَ ، عَن مُوسَی بْنِ عُقْبَۃَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا سَأَلَ اللَّہَ عَبْدٌ شَیْئًا أَحَبَّ إلَیْہِ مِنْ أَنْ یَسْأَلَہُ الْعَافِیَۃَ۔\n(ترمذی ۳۵۴۸)","Da'if","Musannaf Ibn Abi Shaybah 29796","","","كتاب الدعاء"
"29797","(۲۹۷۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْعَبَّاسِ بْنِ ذُرَیْحٍ ، عَن شُرَیْحِ بْنِ ہَانِئٍ ، عَنْ عَائِشَۃَ قَالَتْ : إِنِّی لَوْ عَرَفْتُ أَیُّ لَیْلَۃٍ لَیْلَۃُ الْقَدْرِ مَا سَأَلْتُ اللَّہَ فِیہَا إِلاَّ الْعَافِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 29797","","","كتاب الدعاء"
"29798","(۲۹۷۹۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ: أَخْبَرَنَا أَبُو مَالِکٍ الأَشْجَعِیُّ، عَنْ أَبِیہِ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَتَاہُ رجل فَقَالَ: کَیْفَ أَقُولُ حِینَ أَسْأَلُ رَبِّی؟ قَالَ: قل اللَّہُمَّ ارْحَمْنِی وَاغْفِرْ لِی وَعَافِنِی وَارْزُقْنِی وَجَمَعَ أَصَابِعَہُ الأَرْبَعَ إِلاَّ الإِبْہَامَ فَإِنَّ ہَؤُلائِ یَجْمَعن لَکَ دِینَک وَدُنْیَاک۔ (مسلم ۲۰۷۳۔ احمد ۴۷۲)","Sahih","Musannaf Ibn Abi Shaybah 29798","","","كتاب الدعاء"
"29799","(۲۹۷۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا کَہْمَسُ بْنُ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ بریدۃ قَالَ: قَالَتْ عَائِشَۃُ: لَوْ عَلِمْتُ أَیُّ لَیْلَۃٍ لَیْلَۃُ الْقَدْرِ کَانَ أَکْثَرُ دُعَائِی فِیہَا أَسْأَلُ اللَّہَ الْعَفْوَ وَالْعَافِیَۃَ۔ (ترمذی۳۵۱۳۔ ابن ماجہ۳۸۵۰)","Hasan","Musannaf Ibn Abi Shaybah 29799","","","كتاب الدعاء"
"29800","(۲۹۸۰۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْحَسَنِ یَعْنِی ہِلالَ بْنَ یَسَافَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنَّ فِی الْجُمُعَۃِ لَسَاعَۃً لاَ یُوَافِقُہَا رَجُلٌ مُسْلِمٌ یَسْأَلُ اللَّہَ فِیہَا شَیْئًا إِلاَّ أَعْطَاہُ ، فَقَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، مَاذَا أَسْأَلُ قَالَ : سَلِ اللَّہَ الْعَافِیَۃَ فِی الدُّنْیَا وَالآخِرَۃِ۔\n(بخاری ۹۳۵۔ مسلم ۱۳)","","Musannaf Ibn Abi Shaybah 29800","","","كتاب الدعاء"
"29801","(۲۹۸۰۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، أَنَّ مُحَمَّدَ بْنَ یَحْیَی بْنِ حَبَّانَ أَخْبَرَہُ ، أَنَّ عَمَّہُ أَبَا صِرْمَۃَ کَانَ یُحَدِّثُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک غِنَایَ وَغِنَی مَوَالِیَ۔ (بخاری ۶۶۲۔ احمد ۴۵۳)","Sahih","Musannaf Ibn Abi Shaybah 29801","","","كتاب الدعاء"
"29802","(۲۹۸۰۲) حَدَّثَنَا عُمَرُ بْنُ سعد ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک الْہُدَی وَالتُّقَی وَالْعِفَّۃَ وَالْغِنَی۔ \n(مسلم ۲۰۸۷۔ ترمذی ۳۳۸۹)","Sahih","Musannaf Ibn Abi Shaybah 29802","","","كتاب الدعاء"
"29803","(۲۹۸۰۳) حَدَّثَنَا أَبُو خَالِدٍ حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن مُسْلِمِ بْنِ یَسَارٍ کَانَ مِنْ دُعَائِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ فَالِقَ الإِصْبَاحِ وَجَاعِلَ اللَّیْلِ سَکَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ، اقْضِ عَنی الدَّیْنَ وَاغْنِنِی مِنَ الْفَقْرِ وَمَتِّعْنی بِسَمْعِی وَبَصَرِی وَقُوَّتِی فِی سَبِیلِک۔ (مالک ۲۱۲)","","Musannaf Ibn Abi Shaybah 29803","","","كتاب الدعاء"
"29804","(۲۹۸۰۴) حَدَّثَنَا ابْنُ مُسْہِرٍ، عَن ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ قَالَ: کَانَ الرَّجُلُ إذَا دَعَا قَالَ: اللَّہُمَّ أَغْنِنِی وَأَغْنِ مَوْلایَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29804","","","كتاب الدعاء"
"29805","(۲۹۸۰۵) حَدَّثَنَا عُبَیْدُ اللہِ ، أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ عَمَّنْ حَدَّثَہُ ، عَن عُبَادَۃَ بْنِ الصَّامِتِ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک الأَمْنَ وَالإِیمَانَ وَالصَّبْرَ وَالشُّکْرَ وَالْغِنَی وَالْعَفَافَ۔","Da'if","Musannaf Ibn Abi Shaybah 29805","","","كتاب الدعاء"
"29806","(۲۹۸۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ أَنَسٍ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُکْثِرُ أَنْ یَقُولَ : یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، قَالُوا : یَا رَسُولَ اللہِ ، آمَنَّا بِکَ وَبِمَا جِئْت بِہِ ، فَہَلْ تَخَافُ عَلَیْنَا ؟ قَالَ : نَعَمْ ، إنَّ الْقُلُوبَ بَیْنَ إصْبَعَیْنِ مِنْ أَصَابِعِ اللہِ یُقَلِّبُہَا۔ (ترمذی ۲۱۴۰۔ احمد ۱۱۲)","Hasan","Musannaf Ibn Abi Shaybah 29806","","","كتاب الدعاء"
"29807","(۲۹۸۰۷) حَدَّثَنَا مُعَاذٌ ، أَخْبَرَنَا أَبُو کَعْبٍ صَاحِبُ الْحَرِیرِ ، حَدَّثَنَا شَہْرُ بْنُ حَوْشَبٍ قَالَ : قُلْتُ لأُمِّ سَلَمَۃَ : یَا أُمَّ الْمُؤْمِنِینَ ، مَا کَانَ أَکْثَرُ دُعَائِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَانَ عِنْدَکَ ، قَالَتْ : کان أَکْثَرُ دُعَائِہِ : یَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، ثُمَّ قَالَ : یَا أُمَّ سَلَمَۃَ ، إِنَّہُ لَیْسَ مِنْ آدَمِیٍّ إِلاَّ وَقَلْبُہُ بَیْنَ إصْبَعَیْنِ مِنْ أَصَابِعِ اللہِ ، مَا شَائَ أَقَامَ ، وَمَا شَائَ أَزَاغَ۔ (ترمذی ۳۵۲۲۔ احمد ۲۹۴)","Hasan","Musannaf Ibn Abi Shaybah 29807","","","كتاب الدعاء"
"29808","(۲۹۸۰۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَدْعُو بِہَذَا الدُّعَائِ : یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِک۔","","Musannaf Ibn Abi Shaybah 29808","","","كتاب الدعاء"
"29809","(۲۹۸۰۹) حَدَّثَنَا یَزِیدُ ، أَخْبَرَنَا ہَمَّامُ بْنُ یَحْیَی ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَن أُمِّ مُحَمَّدٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ یَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِی عَلَی دِینِکَ ، قُلْتُ : یَا رَسُولَ اللہِ ، إنَّک تَدْعُو بِہَذَا الدُّعَائِ ، قَالَ : یَا عَائِشَۃُ ، أَو مَا عَلِمْتِ أَنَّ الْقُلُوبَ ، أَوْ قَالَ : قَلْبَ ابْنِ آدَمَ بَیْنَ إصْبَعَی اللہِ، إذَا شَائَ أَنْ یُقَلِّبَہُ إِلَی ہُدَی قَلَبَہُ ، وَإِذَا شَائَ أَنْ یُقَلِّبَہُ إِلَی ضَلالَۃِ قَلَبَہُ ۔ (نسائی ۷۷۳۷۔ احمد ۲۵۰)","Da'if","Musannaf Ibn Abi Shaybah 29809","","","كتاب الدعاء"
"29810","(۲۹۸۱۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَن مَنْصُورٍ، عَنِ الشَّعْبِیِّ قَالَ: قالَتْ أُمُّ سَلَمَۃَ: کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَرَجَ قَالَ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ أَنْ أَزِلَّ ، أَوْ أَضِلَّ ، أَوْ أَظْلِمَ ، أَوْ أُظْلَمَ ، أَوْ أَجْہَلَ ، أَوْ یُجْہَلَ عَلَیَّ۔\n(ابوداؤد ۵۰۵۳)","","Musannaf Ibn Abi Shaybah 29810","","","كتاب الدعاء"
"29811","(۲۹۸۱۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنِ الشَّعْبِیِّ ، عَن أُمِّ سَلَمَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْہُ۔ (ترمذی ۳۴۲۷۔ نسائی ۷۹۲۳)","","Musannaf Ibn Abi Shaybah 29811","","","كتاب الدعاء"
"29812","(۲۹۸۱۲) حَدَّثَنَا وَکِیعٌ، عَن فُضَیْلِ بْنِ مَرْزُوقٍ، عَنْ عَطِیَّۃَ، عَنْ أَبِی سَعِیدٍ قَالَ: مَنْ قَالَ إذَا خَرَجَ إِلَی الصَّلاۃِ: اللَّہُمَّ إنِّی أَسْأَلُک بِحَقِّ السَّائِلِینَ عَلَیْک وَبِحَقِّ مَمْشَایَ ہَذَا لَمْ أخْرجہ أَشَرًا ، وَلا بَطَرًا ، وَلا رِیَائً ، وَلا سُمْعَۃً ، خَرَجْتہ ابْتِغَائَ مَرْضَاتِکَ وَاتِّقَائَ سَخَطِکَ ، أَسْأَلُک أَنْ تُنْقِذَنِی مِنَ النَّارِ وَأَنْ تَغْفِرَ لِی ذُنُوبِی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ إِلاَّ أَقْبَلَ اللَّہُ عَلَیْہِ بِوَجْہِہِ حَتَّی یَنْصَرِفَ ، وَوَکَّلَ بِہِ سَبْعِینَ أَلْفَ مَلَکٍ یَسْتَغْفِرُونَ لَہُ۔ (احمد ۲۱)","Da'if","Musannaf Ibn Abi Shaybah 29812","","","كتاب الدعاء"
"29813","(۲۹۸۱۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ ضَمْرَۃَ ، عَن کَعْبٍ قَالَ : إذَا خَرَجَ الرَّجُلُ مِنْ مَنْزِلِہِ اسْتَقْبَلَتْہُ الشَّیَاطِینُ ، فَإِذَا قَالَ بِسْمِ اللہِ قَالَتِ الْمَلائِکَۃُ : ہُدِیتَ ، وَإِذَا قَالَ : تَوَکَّلْت عَلَی اللہِ قَالَتْ: کُفِیت ، وَإِذَا قَالَ لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ قَالَتْ : حُفِظْت ، فَتَقُولُ الشَّیَاطِینُ بَعْضُہَا لِبَعْضٍ : مَا سَبِیلُکُمْ عَلَی مَنْ کُفِیَ وَہُدِیَ وَحُفِظَ۔ (ابوداؤد ۵۰۵۴۔ عبدالرزاق ۱۹۸۲۷)","","Musannaf Ibn Abi Shaybah 29813","","","كتاب الدعاء"
"29814","(۲۹۸۱۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَن کَعْبِ الأَحْبَارِ قَالَ : إذَا خَرَجَ مِنْ بَیْتِہِ فَقَالَ : بِسْمِ اللہِ ، تَوَکَّلْت عَلَی اللہِ ، وَلا حول ولا قُوَّۃَ إِلاَّ بِاللہِ ، تلقت الشَّیَاطِینُ بَعْضُہُمْ بَعْضًا قَالُوا : ہَذَا عَبْدٌ قَدْ ہُدِیَ وَحُفِظَ وَکُفِیَ فَلا سَبِیلَ لَکُمْ عَلَیْہِ ، فَیَتَصَدَّعُونَ عَنہُ۔","","Musannaf Ibn Abi Shaybah 29814","","","كتاب الدعاء"
"29815","(۲۹۸۱۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو : اللَّہُمَّ اغْسِلْ خَطَایَایَ بِمَائِ الثَّلْجِ وَالْبَرَدِ وَنَقِّ قَلْبِی مِنَ الْخَطَایَا کَمَا نَقَّیْت الثَّوْبَ الأَبْیَضَ مِنَ الدَّنَسِ ، وَبَاعِدْ بَیْنِی وَبَیْنَ خَطَایَایَ کَمَا بَاعَدْت بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ۔ (بخاری ۶۳۶۸۔ مسلم ۲۰۷۸)","Sahih","Musannaf Ibn Abi Shaybah 29815","","","كتاب الدعاء"
"29816","(۲۹۸۱۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، حَدَّثَنَا شُعْبَۃُ ، عَن مَجْزَأَۃَ بْنِ زَاہِرٍ الأَسْلَمِیِّ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ أَبِی أَوْفَی یُحَدِّثُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَدْعُو : اللَّہُمَّ طَہِّرْنِی بِالْبَرَدِ وَالثَّلْجِ وَالْمَائِ الْبَارِدِ ، اللَّہُمَّ طَہِّرْنِی مِنَ الذُّنُوبِ وَنَقِّنِی مِنْہَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضُ مِنَ الدَّنَسِ۔\n(مسلم ۳۴۶۔ ترمذی ۳۵۴۷)","Sahih","Musannaf Ibn Abi Shaybah 29816","","","كتاب الدعاء"
"29817","(۲۹۸۱۷) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَن حَبِیبٍ قَالَ : حُدِّثْتُ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو یَقُولُ : اللَّہُمَّ طَہِّرْنِی بِالثَّلْجِ وَالْبَرَدِ وَالْمَائِ الْبَارِدِ وَنَقِّنِی مِنَ الْخَطَایَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضُ مِنَ الدَّنَسِ وَبَاعِدْ بَیْنِی وَبَیْنَ خَطَایَایَ کَمَا بَاعَدْت بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ۔ (طبرانی ۶۹۵۰)","","Musannaf Ibn Abi Shaybah 29817","","","كتاب الدعاء"
"29818","(۲۹۸۱۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَبَّرَ سَکَتَ بَیْنَ التَّکْبِیرِ وَالْقِرَائَۃِ ، قَالَ : فَقُلْتُ لَہُ : بِأَبِی وَأُمِّی ، أَرَأَیْت سُکُوتَکَ بَیْنَ التَّکْبِیرِ وَالْقِرَائَۃِ ، أَخْبِرْنِی مَا تَقُولُ ؟ قَالَ : أَقُولُ : اللَّہُمَّ بَاعِدْ بَیْنِی وَبَیْنَ خَطَایَایَ کَمَا بَاعَدْت بَیْنَ الْمَشْرِقِ وَالْمَغْرِبِ : اللَّہُمَّ نَقِّنِی مِنْ خَطَایَایَ کَالثَّوْبِ الأَبْیَضِ مِنَ الدَّنَسِ ، اللَّہُمَّ اغْسِلْنِی مِنْ خَطَایَایَ بِالْمَائِ وَالْبَرَدِ وَالثَّلْجِ۔ (مسلم ۱۴۹۔ ابن ماجہ ۸۰۵)","Sahih","Musannaf Ibn Abi Shaybah 29818","","","كتاب الدعاء"
"29819","(۲۹۸۱۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، حَدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ قَالَ : حدَّثَنَی حَبِیبُ بْنُ عُبَیْدٍ ، عَن جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ، عَنْ عَوْفِ بْنِ مَالِکٍ الأَشْجَعِیِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی الْمَیِّتِ : اللَّہُمَّ اغْسِلْہُ بِالْمَائِ وَالثَّلْجِ وَالْبَرَدِ وَنَقِّہِ مِنَ الْخَطَایَا کَمَا یُنَقَّی الثَّوْبُ الأَبْیَضُ مِنَ الدَّنَسِ۔","Hasan","Musannaf Ibn Abi Shaybah 29819","","","كتاب الدعاء"
"29820","(۲۹۸۲۰) حَدَّثَنَا وَکِیعٌ، حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ قَالَ : بَلَغَنَا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا سَمِعَ الرَّعْدَ الشَّدِیدَ قَالَ : اللَّہُمَّ لاَ تُہْلِکْنَا بِعَذَابِکَ ، وَلا تَقْتُلْنَا بِغَضَبِکَ وَعَافِنَا قَبْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29820","","","كتاب الدعاء"
"29821","(۲۹۸۲۱) حَدَّثَنَا وَکِیعٌ ، عَن مَہْدِیِّ بْنِ مَیْمُونٍ سَمِعَہُ مِنْ غَیْلانَ بْنِ جَرِیرٍ ، عَن رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ إذَا سَمِعَ الرَّعْدَ قَالَ : سُبْحَانَ اللہِ وَبِحَمْدِہِ سُبْحَانَ اللہِ الْعَظِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 29821","","","كتاب الدعاء"
"29822","(۲۹۸۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ إذَا سَمِعَ الرَّعْدَ قَالَ : سُبْحَانَ مَنْ سَبَّحْت لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29822","","","كتاب الدعاء"
"29823","(۲۹۸۲۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنِ ابْنِ أَبِی زَکَرِیَّا قَالَ : مَنْ سَمِعَ صَوْتَ الرَّعْدِ فَقَالَ : سُبْحَانَ اللہِ بِحَمْدِہِ لَمْ تُصِبْہُ صَاعِقَۃٌ۔","","Musannaf Ibn Abi Shaybah 29823","","","كتاب الدعاء"
"29824","(۲۹۸۲۴) حَدَّثَنَا مَعَن ، عَن مَالِکِ بْنِ أَنَسٍ ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ إذَا سَمِعَ الرَّعْدَ تَرَکَ الْحَدِیثَ ، وَقَالَ : سُبْحَانَ الَّذِی سَبَّحَ الرَّعْدُ بِحَمْدِہِ وَالْمَلائِکَۃُ مِنْ خِیفَتِہِ ، ثُمَّ یَقُولُ : إنَّ ہَذَا لَوَعِیدٌ لأَہْلِ الأَرْضِ شَدِیدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 29824","","","كتاب الدعاء"
"29825","(۲۹۸۲۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ حَدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ قَالَ : بَلَغَنِی أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اللَّہُمَّ لاَ تَقْتُلْنَا بِغَضَبِکَ ، وَلا تُہْلِکْنَا بِعَذَابِکَ وَعَافِنَا قَبْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29825","","","كتاب الدعاء"
"29826","(۲۹۸۲۶) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، حَدَّثَنَا یَعْلَی بْنُ الْحَارِثِ قَالَ : حدَّثَنَیہِ جَامِعُ بْنُ شَدَّادٍ قَالَ : کَانَ الأَسْوَدُ النَّخَعِیُّ ابْنُ یَزِیدَ ، إذَا سَمِعَ الرَّعْدَ قَالَ : سُبْحَانَ الَّذِی یُسَبِّحُ الرَّعْدُ بِحَمْدِہِ وَالْمَلائِکَۃُ مِنْ خِیفَتِہِ۔","","Musannaf Ibn Abi Shaybah 29826","","","كتاب الدعاء"
"29827","(۲۹۸۲۷) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، عَن حَجَّاجِ بْنِ أَرْطَاۃَ ، عَنْ أَبِی مَطَرٍ ، أَنَّہُ سَمِعَ سَالِمَ بْنَ عَبْدِ اللہِ یُحَدِّثُ عَنْ أَبِیہِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَمِعَ الرَّعْدَ وَالصَّوَاعِقَ قَالَ : اللَّہُمَّ لاَ تَقْتُلْنَا بِغَضَبِکَ ، وَلا تُہْلِکْنَا بِعَذَابِکَ وَعَافِنَا قَبْلَ ذَلِکَ۔ (بخاری ۷۲۱۔ ترمذی ۳۴۵۰)","Da'if","Musannaf Ibn Abi Shaybah 29827","","","كتاب الدعاء"
"29828","(۲۹۸۲۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ قَالَ : حدَّثَنَا ثَابِتٌ الزُّرَقِیُّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسُبُّوا الرِّیحَ فَإِنَّہَا مِنْ رُوحِ اللہِ ، تَأْتِی بِالرَّحْمَۃِ وَالْعَذَابِ ، وَلَکِنْ تَعَوَّذُوا بِاللہِ مِنْ شَرِّہَا وَسَلُوا اللَّہَ مِنْ خَیْرِہَا۔ (ابن ماجہ ۳۷۲۷)","Sahih","Musannaf Ibn Abi Shaybah 29828","","","كتاب الدعاء"
"29829","(۲۹۸۲۹) حَدَّثَنَا أَسْبَاطٌ ، عَنِ الأَعْمَشِ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَن سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، عَن أُبَیٍّ قَالَ : لاَ تَسُبُّوا الرِّیحَ فَإِذَا رَأَیْتُمْ مَا تَکْرَہُونَ فَقُولُوا : اللَّہُمَّ إنَّا نَسْأَلُک خَیْرَ ہَذِہِ الرِّیحِ وَخَیْرَ مَا فِیہَا وَخَیْرَ مَا أُرْسِلَتْ بِہِ ، وَنَعُوذُ بِکَ مِنْ شَرِّ ہَذِہِ الرِّیحِ وَشَرِّ مَا فِیہَا وَشَرِّ مَا أُرْسِلَتْ بِہِ۔\n(ترمذی ۲۲۵۲۔ احمد ۱۲۳)","Sahih","Musannaf Ibn Abi Shaybah 29829","","","كتاب الدعاء"
"29830","(۲۹۸۳۰) حَدَّثَنَا عُبَیْدُ اللہِ أَخْبَرَنَا شَیْبَانُ ، عَن مَنْصُورٍ ، عَن مُجَاہِدٍ قَالَ : ہَا??َتْ رِیحٌ ، أَوْ ہَبَّتْ رِیحٌ فَسَبُّوہَا فَقَالَ ابْنُ عَبَّاسٍ : لاَ تَسُبُّوہَا ، فَإِنَّہَا تَجِیئُ بِالرَّحْمَۃِ وَتَجِیئُ بِالْعَذَابِ ، وَلَکِنْ قُولُوا : اللَّہُمَّ اجْعَلْہَا رَحْمَۃً ، وَلا تَجْعَلْہَا عَذَابًا۔","Sahih","Musannaf Ibn Abi Shaybah 29830","","","كتاب الدعاء"
"29831","(۲۹۸۳۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ قَالَ : کَانَ ابْنُ عُمَرَ إذَا عَصَفَتِ الرِّیحُ فَدَارَتْ یَقُولُ : شُدُّوا التَّکْبِیرَ فَإِنَّہَا مُذْہِبَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 29831","","","كتاب الدعاء"
"29832","(۲۹۸۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ حَدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِی فَزَارَۃَ قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ مَالِکٍ إذَا رَأَی الرِّیحَ قَالَ : اللَّہُمَّ إنَّا نَسْأَلُک خَیْرَہَا وَخَیْرَ مَا أرسلت فِیہَا وَنَعُوذُ بِکَ مِنْ شَرِّہَا، وَشَرِّ مَا قَدَّرْتَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 29832","","","كتاب الدعاء"
"29833","(۲۹۸۳۳) حَدَّثَنَا یَزِیدُ بْنُ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنِ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ ، أَنَّہُ ذَکَرَ أن عَائِشَۃَ حَدَّثَتْہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَأَی سَحَابًا ثَقِیلاً مِنْ أُفُقٍ مِنَ الآفَاقِ تَرَکَ مَا ہُوَ فِیہِ ، وَإِنْ کَانَ فِی صَلاۃٍ حَتَّی یَسْتَقْبِلَہُ فَیَقُولُ : اللَّہُمَّ إنَّا نَعُوذُ بِکَ مِنْ شَرِّ مَا أُرْسِلَ بِہِ ، فَإِنْ أَمْطَرَ قَالَ : اللَّہُمَّ سَیْبًا نَافِعًا مَرَّتَیْنِ ، أَوْ ثَلاثًا ، فَإِنْ کَشَفَہُ اللَّہُ وَلَمْ یُمْطِرْ حَمِدَ اللَّہَ عَلَی ذَلِکَ۔ (بخاری ۶۸۶۔ ابوداؤد ۵۰۵۸)","Hasan","Musannaf Ibn Abi Shaybah 29833","","","كتاب الدعاء"
"29834","(۲۹۸۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ عَن نَافِعٍ ، عَنِ الْقَاسِمِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَی الْمَطَرَ قَالَ : اللَّہُمَّ اجْعَلْہُ صَیْبًا نَافِعًا۔ (بخاری ۱۰۳۲۔ احمد ۹۰)","","Musannaf Ibn Abi Shaybah 29834","","","كتاب الدعاء"
"29835","(۲۹۸۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ، عَن شُرَحْبِیلَ بْنِ السَّمْطِ قَالَ : قلْنَا لِکَعْبِ بْنِ مُرَّۃَ یَا کَعْبُ ، حَدِّثْنَا ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فقَالَ : کُنَّا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَائَہُ رَجُلٌ فَقَالَ : یَا رَسُولَ اللہِ ، اسْتَسْقِ اللَّہَ لِمُضَرَ ، قَالَ : فَرَفَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَیْہِ فَقَالَ : اللَّہُمَّ اسْقِنَا غَیْثًا مَرِیعًا مَرِیًّا عَاجِلاً غَیْرَ رَائِثٍ نَافِعًا غَیْرَ ضَارٍّ، قَالَ : فَمَا جَمَّعُوا حَتَّی أُحیوا فَأَتَوْہُ فَشَکَوْا إلَیْہِ الْمَطَرَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، تَہَدَّمَتِ الْبُیُوتُ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہِ: اللَّہُمَّ حَوَالَیْنَا، وَلا عَلَیْنَا، قَالَ: فَجَعَلَ السَّحَابُ یَتَقَطَّعُ یَمِینًا وَشِمَالاً۔ (ابن ماجہ ۱۲۶۹۔ طیالسی ۱۱۹۹)","","Musannaf Ibn Abi Shaybah 29835","","","كتاب الدعاء"
"29836","(۲۹۸۳۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن حَمْزَۃَ الزَّیَّاتِ ، عَنْ أَبِی إِسْحَاقَ ، عَن سَعِیدِ بْنِ جُبَیْرٍ عَن ابْنِ عَبَّاسٍ ، عَن أُبَیِّ بْنِ کَعْبٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا دَعَا لأَحَدٍ بَدَأَ بِنَفْسِہِ فَذَکَرَ ذَاتَ یَوْمٍ مُوسَی فَقَالَ : رَحْمَۃُ اللہِ عَلَیْنَا وَعَلَی مُوسَی ، لَوْ کَانَ صَبَرَ لَقَصَّ اللَّہُ عَلَیْنَا مِنْ خَبَرِہِ ، وَلَکِنْ قَالَ : {إنْ سَأَلْتُک عَن شَیْئٍ بَعْدَہَا فَلا تُصَاحِبْنِی قَدْ بَلَغْتَ مِنْ لَدُنِّی عُذْرًا}۔ (بخاری ۱۲۲۔ مسلم ۱۸۴۷)","Sahih","Musannaf Ibn Abi Shaybah 29836","","","كتاب الدعاء"
"29837","(۲۹۸۳۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنِ إِبْرَاہِیم قَالَ : کَانَ یُقَالُ : إذَا دَعَوْت فَابْدَأْ بِنَفْسِکَ فَإِنَّک لاَ تَدْرِی فِی أَیِّ دُعَائٍ یُسْتَجَابُ لَک۔","","Musannaf Ibn Abi Shaybah 29837","","","كتاب الدعاء"
"29838","(۲۹۸۳۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إبْرَاہِیمَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَرْحَمُنَا اللَّہُ وَأَخَا عَادٍ۔ (ابن ماجہ ۳۸۵۲)","","Musannaf Ibn Abi Shaybah 29838","","","كتاب الدعاء"
"29839","(۲۹۸۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ یَسَارٍ قَالَ : جَلَسْت إِلَی ابْنِ عُمَرَ فَذَکَرْت رَجُلاً فَتَرَحَّمْت عَلَیْہِ فَضَرَبَ صَدْرِی ، وَقَالَ : ابْدَأْ بِنَفْسِک۔","Sahih","Musannaf Ibn Abi Shaybah 29839","","","كتاب الدعاء"
"29840","(۲۹۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الدَّرْدَائِ الأَنْصَارِیِّ قَالَ : قالَتْ عَائِشَۃُ لابْنِ أُخْتِہَا : إنَّک أَنْ تَدْعُوَ لِنَفْسِکَ خَیْرٌ مِنْ أَنْ یَدْعُوَ لَکَ الْقَاصُّ۔","","Musannaf Ibn Abi Shaybah 29840","","","كتاب الدعاء"
"29841","(۲۹۸۴۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن سَعِیدِ بْنِ مَسْرُوقٍ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی رِشْدِینَ کُرَیْبٍ مَوْلَی ابْنِ عَبَّاسٍ قَالَ : قَالَ ابْنُ عَبَّاسٍ : بِتُّ عِنْدَ خَالَتِی مَیْمُونَۃَ فَسَمِعْتُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی سُجُودِہِ :اللَّہُمَّ اجْعَلْ فِی قَلْبِی نُورًا ، وَفِی سَمْعِی نُورًا ، وَاجْعَلْ فِی بَصَرِی نُورًا ، وَاجْعَلْ أَمَامِی نُورًا ، وَاجْعَلْ خَلْفِی نُورًا ، وَاجْعَلْ مِنْ تَحْتِی نُورًا ، وَأَعْظِمْ لِی نُورًا۔","Sahih","Musannaf Ibn Abi Shaybah 29841","","","كتاب الدعاء"
"29842","(۲۹۸۴۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عَاصِمٍ ، عَن زِرِّ بْنِ حُبَیْشٍ ، عَنْ عَلِیٍّ قَالَ : مِنْ أَحَبِّ الْکَلِمِ إِلَی اللہِ أَنْ یَقُولَ الْعَبْدُ وَہُوَ سَاجِدٌ : ظَلَمْت نَفْسِی فَاغْفِرْ لِی۔","Da'if","Musannaf Ibn Abi Shaybah 29842","","","كتاب الدعاء"
"29843","(۲۹۸۴۳) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَنْ ثُویر بْنِ أَبِی فَاخِتَۃَ، عَن مُجَاہِدٍ قَالَ: قَالَ أَبُو سَعِیدٍ الْخُدْرِیِّ: مَا وَضَعَ رَجُلٌ جَبْہَتَہُ لِلَّہِ سَاجِدًا فَقَالَ : یَا رَبِّ اغْفِرْ لِی یَا رَبِّ اغْفِرْ لِی یَا رَبِّ اغْفِرْ لِی ثَلاثًا إِلاَّ رَفَعَ رَأْسَہُ وَقَدْ غُفِرَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 29843","","","كتاب الدعاء"
"29844","(۲۹۸۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عَاصِمٍ قَالَ : کَانَ أَبُو وَائِلٍ یَقُولُ وَہُوَ سَاجِدٌ : رَبِّ إِنْ تَعْفُ عَنی تَعْفُ ، عَن طَوْلٍ مِنْک ، وَإِنْ تُعَذِّبْنِی تُعَذِّبْنِی غَیْرَ ظَالِمٍ ، وَلا مَسْبُوقٍ ، ثُمَّ یَبْکِی۔","No Data Available","Musannaf Ibn Abi Shaybah 29844","","","كتاب الدعاء"
"29845","(۲۹۸۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن مُحَمَّدِ بْنِ سَعْدٍ الأَنْصَارِیِّ قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ یزِید بْنِ رَبِیعَۃَ الدِّمَشْقِیُّ قَالَ: قَالَ أَبُو الدَّرْدَائِ: أَدْلَجْت ذَاتَ لَیْلَۃٍ إِلَی الْمَسْجِدِ ، فَلَمَّا دَخَلْت مَرَرْت عَلَی رَجُلٍ سَاجِدٍ وَہُوَ یَقُولُ: اللَّہُمَّ إنِّی خَائِفٌ مُسْتَجِیرٌ فَأَجِرْنِی مِنْ عَذَابِکَ ، وَسَائِلٌ فَقِیرٌ فَارْزُقْنِی مِنْ فَضْلِکَ ، لاَ بَرِیئَ مِنْ ذَنْبٍ فَأَعْتَذِرَ ، وَلا ذُو قُوَّۃٍ فَأَنْتَصِرَ ، وَلَکِنْ مُذْنِبٌ مُسْتَغْفِرٌ ، فَأَصْبَحَ أَبُو الدَّرْدَائِ یُعَلِّمُہُنَّ أَصْحَابَہُ إعْجَابًا بِہِا۔","Da'if","Musannaf Ibn Abi Shaybah 29845","","","كتاب الدعاء"
"29846","(۲۹۸۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَن مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ عُمَرَ قَالَ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَقُلْ : رَبِّ ظَلَمْت نَفْسِی فَاغْفِرْ لِی ، قَالَ مُحَارِبٌ : فَإِنَّہُ أَقْرَبُ مَا یَکُونُ إِلَی اللہِ عَزَّ وَجَلَّ۔","Da'if","Musannaf Ibn Abi Shaybah 29846","","","كتاب الدعاء"
"29847","(۲۹۸۴۷) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ قَالَتْ : طَلَبْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَیْلَۃً فَلَمْ أَجِدْہُ ، قَالَتْ : فَظ??نَنْت أَنَّہُ أَتَی بَعْضَ جَوَارِیہِ ، أَوْ نِسَائِہِ ، قَالَتْ : فَرَأَیْتہ وَہُوَ سَاجِدٌ وَہُوَ یَقُولُ : اللَّہُمَّ اغْفِرْ لِی مَا أَسْرَرْتُ ، وَمَا أَعْلَنْتُ۔ (احمد ۱۴۷۔ حاکم ۲۲۱)","","Musannaf Ibn Abi Shaybah 29847","","","كتاب الدعاء"
"29848","(۲۹۸۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَن عَبْدِ اللہِ بْنِ مَسْعُودٍ ، أَنَّہُ قَالَ : مَنْ تَعَارَّ مِنَ اللَّیْلِ فَقَالَ : لاَ إلَہَ إِلاَّ أَنْتَ رَبِّ ظَلَمْت نَفْسِی فَاغْفِرْ لِی خَرَجَ مِنْ ذُنُوبِہِ کَمَا تَخْرُجُ الْحَیَّۃُ مِنْ سَلْخِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 29848","","","كتاب الدعاء"
"29849","(۲۹۸۴۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ عَن زَیْدِ بْنِ صُوحَانَ ، عَن سَلْمَانَ ، أَنَّہُ کَانَ إذَا تَعَارَّ مِنَ اللَّیْلِ قَالَ : سُبْحَانَ رَبِّ النَّبِیِّینَ وإلہ الْمُرْسَلِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 29849","","","كتاب الدعاء"
"29850","(۲۹۸۵۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَن ہُرَیْمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ أَبِی کَثِیرٍ مَوْلَی أُمِّ سَلَمَۃَ ، أَنَّ أُمَّ سَلَمَۃَ کَانَتْ إذَا تَعَارَّتْ مِنَ اللَّیْلِ تَقُولُ : رَبِّ اغْفِرْ وَارْحَمْ وَاہْدِ السَّبِیلَ الأَقْوَمَ۔","Da'if","Musannaf Ibn Abi Shaybah 29850","","","كتاب الدعاء"
"29851","(۲۹۸۵۱) حَدَّثَنَا بَکْرُ بْنُ عُبَیْدٍ ، حَدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَن مُحَمَّدِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَانَ إذَا تَحَرَّکَ مِنَ اللَّیْلِ قَالَ : یَا أَیُّہَا النَّاسُ {قَدْ جَائَکُمْ بُرْہَانٌ مِنْ رَبِّکُمْ وَأَنْزَلْنَا إلَیْکُمْ نُورًا مُبِینًا}۔","Da'if","Musannaf Ibn Abi Shaybah 29851","","","كتاب الدعاء"
"29852","(۲۹۸۵۲) حَدَّثَنَا مَعَن ، عَن مَالِکِ بْنِ أَنَسٍ ، عَنْ أَبِی حَازِمٍ ، عَن سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ قَالَ : سَاعَتَانِ تُفْتَحُ فِیہِمَا أَبْوَابُ السَّمَائِ ، وَقَلَّ دَاعٍ تُرَدُّ عَلَیْہِ دَعْوَتُہُ : حَضْرَۃُ النِّدَائِ فِی الصَّلاۃِ ، والصَّفُّ فِی سَبِیلِ اللہِ عَزَّ وَجَلَّ۔ (ابوداؤد ۲۵۳۲۔ ابن حبان ۱۷۶۴)","Sahih","Musannaf Ibn Abi Shaybah 29852","","","كتاب الدعاء"
"29853","(۲۹۸۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَن مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ قَالَ : کَانَ یَأْمُرُ بِالدُّعَائِ عِنْدَ أَذَانِ الْمُؤَذِّنِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 29853","","","كتاب الدعاء"
"29854","(۲۹۸۵۴) حَدَّثَنَا وَکِیعٌ ، عن سُفْیَان ، عَن زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی إیَاسٍ ، عَنْ أَنَسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الدُّعَائُ بَیْنَ الأَذَانِ وَالإِقَامَۃِ لاَ یُرَدُّ۔","Da'if","Musannaf Ibn Abi Shaybah 29854","","","كتاب الدعاء"
"29855","(۲۹۸۵۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ أَبِی مُرَارَۃَ ، عَن مُجَاہِدٍ قَالَ : أَفْضَلُ السَّاعَاتِ مَوَاقِیتُ الصَّلاۃِ فَادْعُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 29855","","","كتاب الدعاء"
"29856","(۲۹۸۵۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ قَالَ : إنَّ السَّاعَۃَ الَّتِی یُسْتَجَابُ فِیہَا لِمَنْ دَعَا یَوْمَ الْجُمُعَۃِ حِینَ یَقُومُ الإِمَامُ فِی الصَّلاۃِ حَتَّی یَنْصَرِفَ مِنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 29856","","","كتاب الدعاء"
"29857","(۲۹۸۵۷) حَدَّثَنَا عُبَیْدُ اللہِ ، أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَن بُرَیْدِ بْنِ أَبِی مَرْیَمَ ، عْن أَنَسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الدُّعَائَ لاَ یُرَدُّ بَیْنَ الأَذَانِ وَالإِقَامَۃِ فَادْعُوا۔","Sahih","Musannaf Ibn Abi Shaybah 29857","","","كتاب الدعاء"
"29858","(۲۹۸۵۸) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ الْمَلِکِ بْنِ وَاقِدٍ حَدَّثَنَا الْحَارِثُ بْنُ مُرَّۃَ ، حَدَّثَنَا یَزِیدُ الرَّقَاشِیُّ ، عَنْ أَنَسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ عِنْدَ الأَذَانِ فُتِحَتْ أَبْوَابُ السَّمَائِ وَاسْتُجِیبَ الدُّعَائُ ، وَإِذَا کَانَ عِنْدَ الإِقَامَۃِ لَمْ تُرَدَّ دَعْوَۃٌ۔ (ابویعلی ۴۰۹۵۔ طیالسی ۲۱۰۶)","Da'if","Musannaf Ibn Abi Shaybah 29858","","","كتاب الدعاء"
"29859","(۲۹۸۵۹) حَدَّثَنَا یَحْیَی بْنُ إِسْحَاقَ ، حَدَّثَنَا اللَّیْثُ بْنُ سَعْدٍ ، عَنِ الْحُکَیْمِ بْنِ عَبْدِ اللہِ بْنِ قَیْسٍ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ سَعْدٍ ، أَنَّہُ قَالَ : مَنْ قَالَ إذَا قَالَ الْمُؤَذِّنُ أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ : رَضِیت بِاللہِ رَبًّا ، وَبِالإِسْلامِ دِینًا وَبِمُحَمَّدٍ نَبِیًّا ، غُفِرَ لَہُ ذُنُوبُہُ ، فَقَالَ لَہُ رَجُلٌ : یَا سَعْدُ ، مَا تَقَدَّمَ مِنْ ذَنْبِہِ ، وَمَا تَأَخَّرَ ؟ قَالَ : لاَ ہَکَذَا سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُہُ۔ (مسلم ۲۹۰۔ ابوداؤد ۵۲۶)","Sahih","Musannaf Ibn Abi Shaybah 29859","","","كتاب الدعاء"
"29860","(۲۹۸۶۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَن ہُرَیْمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ أَبِی کَثِیرٍ مَوْلَی أُمِّ سَلَمَۃَ ، عَن أُمِّ سَلَمَۃَ قَالَتْ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قُولِی عِنْدَ أَذَانِ الْمَغْرِبِ : اللَّہُمَّ عند إقْبَالُ لَیْلِکَ وَإِدْبَارُ نَہَارِکَ وَأَصْوَاتُ دُعَاتِکَ وَحُضُورُ صَلاتِکَ اغْفِرْ لِی۔ (ابوداؤد ۵۳۱۔ ترمذی ۳۵۸۹)","Da'if","Musannaf Ibn Abi Shaybah 29860","","","كتاب الدعاء"
"29861","(۲۹۸۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ عَبْدِ الْکَرِیمِ الْمُکْتِبِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ مُعَاوِیَۃَ قَالَ : الْکَلِمَاتُ الَّتِی تَلَقَّی آدَم مِنْ رَبِّہِ : اللَّہُمَّ لاَ إلَہَ إِلاَّ أَنْتَ سُبْحَانَک وَبِحَمْدِکَ ، عَمِلْتُ سُوئًا وَظَلَمْتُ نَفْسِی فَارْحَمْنِی وَأَنْتَ خَیْرُ الرَّاحِمِینَ ، اللَّہُمَّ لاَ إلَہَ إِلاَّ أَنْتَ سُبْحَانَک وَبِحَمْدِکَ عَمِلْتُ سُوئًا وَظَلَمْتُ نَفْسِی فَتُبْ عَلَیَّ إنَّک أَنْتَ التَّوَّابُ الرَّحِیمُ۔","","Musannaf Ibn Abi Shaybah 29861","","","كتاب الدعاء"
"29862","(۲۹۸۶۲) حَدَّثَنَا أَسْبَاطٌ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن کَعْبِ بْنِ عُجْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مُعَقِّبَاتٌ لاَ یَخِیبُ قَائِلُہُنَّ : سُبْحَانَ اللہِ فِی دُبُرِ کُلِّ صَلاۃٍ ثَلاثًا وَثَلاثِینَ ، وَتَحْمَدَ ثَلاثًا وَثَلاثِینَ ، وَتُکَبِّرَ أَرْبَعًا وَثَلاثِینَ۔ (مسلم ۴۱۸۔ ترمذی ۳۴۱۲)","Sahih","Musannaf Ibn Abi Shaybah 29862","","","كتاب الدعاء"
"29863","(۲۹۸۶۳) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن کَعْبِ بْنِ عُجْرَۃَ قَالَ : ثَلاثٌ لاَ یَخِیبُ قَائِلُہُنَّ ، أَوْ قَالَ : قَائِلُوہُنَّ : یُسَبِّحُ ثَلاثًا وَثَلاثِینَ ، وَیَحْمَدُ ثَلاثًا وَثَلاثِینَ ، وَیُکَبِّرُ أَرْبَعًا وَثَلاثِینَ فِی دُبُرِ کُلِّ صَلاۃٍ ، قَالَ الْحَکَمُ : فَمَا تَرَکْتُہُنَّ بَعْدُ۔ (بخاری ۶۲۲۔ طیالسی ۱۰۶۰)","Sahih","Musannaf Ibn Abi Shaybah 29863","","","كتاب الدعاء"
"29864","(۲۹۸۶۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَن کَعْبٍ قَالَ : مُعَقِّبَاتٌ لاَ یَخِیبُ قَائِلُہُنَّ ، ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ وَکِیعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29864","","","كتاب الدعاء"
"29865","(۲۹۸۶۵) حَدَّثَنَا وَکِیعٌ ، عَن یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، عَنْ أَبِی مُوسَی ، أَنَّہُ کَانَ یَقُولُ إذَا فَرَغَ مِنْ صَلاتِہِ : اللَّہُمَّ اغْفِرْ لِی ذَنْبِی وَیَسِّرْ لِی أَمْرِی ، وَبَارِکْ لِی فِی رِزْقِی۔","Hasan","Musannaf Ibn Abi Shaybah 29865","","","كتاب الدعاء"
"29866","(۲۹۸۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا مِسْعَرٌ ، عَن مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَن طَیْسِلَۃَ ، عَنِ ابْنِ عُمَرَ قَالَ : مَنْ قَالَ دُبُرَ کُلِّ صَلاۃٍ وَإِذَا أَخَذَ مَضْجَعَہُ : اللَّہُ أَکْبَرُ کَبِیرًا ، عَدَدَ الشَّفْعِ وَالْوِتْرِ ، وَکَلِمَاتِ اللہِ التَّامَّاتِ ، الطَّیِّبَاتِ الْمُبَارَکَاتِ ثَلاثًا ، وَلا إلَہَ إِلاَّ اللَّہُ مِثْلُ ذَلِکَ ، کُنَّ لَہُ فِی قَبْرِہِ نُورًا ، وَعَلَی الْجِسْرِ نُورًا ، وَعَلَی الصِّرَاطِ نُورًا حَتَّی یُدْخِلْنَہُ الْجَنَّۃَ ، أَوْ یَدْخُلَ الْجَنَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 29866","","","كتاب الدعاء"
"29867","(۲۹۸۶۷) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ، عَنْ عَلِیٍّ، أَنَّہُ کَانَ یَقُولُ: تَمَّ نُورُک فَہَدَیْت فَلَکَ الْحَمْدُ ، وَعَظُمَ حِلْمُک فَعَفَوْت فَلَکَ الْحَمْدُ ، وَبَسَطْت یَدَک فَأَعْطَیْت فَلَکَ الْحَمْدُ رَبَّنَا وَجْہُک أَکْرَمُ الْوُجُوہِ، وَجَاہُک خَیْرُ الْجَاہِ، وَعَطِیَّتُک أَفْضَلُ الْعَطِیَّۃِ وَأَہْنَؤُہَا، تُطَاعُ رَبَّنَا فَتَشْکُرُ، وَتُعْصَی رَبَّنَا فَتَغْفِرُ، تُجِیبُ الْمُضْطَرَّ، وَتَکْشِفُ الضُّرَّ، وَتَشْفِی السَّقِیمَ، وَتُنْجِی مِنَ الْکَرْبِ وَتَقْبَلُ التَّوْبَۃ ، وَتَغْفِرُ الذَّنْبَ لِمَنْ شِئْت ، لاَ یُجْزِئُ بآلائِکَ أَحَدٌ ، وَلا یُحْصِی نَعْمَائَک قَوْلُ قَائِلٍ یَعْنِی : کُلٌّ یَقُولُ بَعْدَ الصَّلاۃِ۔ (ابویعلی ۴۳۶)","Hasan","Musannaf Ibn Abi Shaybah 29867","","","كتاب الدعاء"
"29868","(۲۹۸۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن عُمَیْرِ بْنِ سَعْدٍ قَالَ : کَانَ عَبْدُ اللہِ یَدْعُو بِہَذِہِ الدَّعَوَاتِ بَعْدَ التَّشَہُّدِ : اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ مَا عَلِمْت مِنْہُ ، وَمَا لَمْ أَعْلَمْ وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ مَا عَلِمْت مِنْہُ ، وَمَا لَمْ أَعْلَمْ ، اللَّہُمَّ إنِّی أَسْأَلُکَ خَیْرَ مَا سَأَلَک عِبَادُک الصَّالِحُونَ ، وَأَعُوذُ بِکَ مِنْ شَرِّ مَا عَاذَ مِنْہُ عِبَادُک الصَّالِحُونَ : رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ ، رَبَّنَا إنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا وَکَفِّرْ عَنَّا سَیِّئَاتِنَا وَتَوَفَّنَا مَعَ الأَبْرَارِ ، رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَی رُسُلِکَ ، وَلا تُخْزِنَا یَوْمَ الْقِیَامَۃِ إنَّک لاَ تُخْلِفُ الْمِیعَادَ۔","Sahih","Musannaf Ibn Abi Shaybah 29868","","","كتاب الدعاء"
"29869","(۲۹۸۶۹) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن زِیَادِ بْنِ فَیَّاضٍ ، قَالَ : سَمِعْتُ مُصْعَبَ بْنَ سَعْدٍ یُحَدِّثُ ، عَن سَعْدٍ ، أَنَّہُ کَانَ إذَا تَشَہَّدَ قَالَ : سُبْحَانَ اللہِ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ ، وَمَا بَیْنَہُنَّ ، وَمَا تَحْتَ الثَّرَی ، قَالَ شُعْبَۃُ : لاَ أَدْرِی اللَّہُ أَکْبَرُ قَبْلُ ، أَوِ الْحَمْدُ لِلَّہِ حَمْدًا طَیِّبًا مُبَارَکًا فِیہِ ، لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ ، ثُمَّ یُسَلِّمُ۔","Sahih","Musannaf Ibn Abi Shaybah 29869","","","كتاب الدعاء"
"29870","(۲۹۸۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَن وَرَّادٍ مَوْلَی الْمُغِیرَۃِ قَالَ : کَتَبَ مُعَاوِیَۃُ إِلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ : أَیُّ شَیْئٍ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ إذَا سَلَّمَ فِی الصَّلاۃِ ، قَالَ : فَأَمْلاہَا عَلَیَّ الْمُغِیرَۃُ ، قَالَ : فَکَتَبْت بِہَا إِلَی مُعَاوِیَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ إذَا سَلَّمَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، اللَّہُمَّ لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلا مُعْطِیَ لِمَا مَنَعْت ، وَلا یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔","Sahih","Musannaf Ibn Abi Shaybah 29870","","","كتاب الدعاء"
"29871","(۲۹۸۷۱) حَدَّثَنَا ابْنُ نُمَیْرٍ، حَدَّثَنَا الأَعْمَشُ، عَنْ عَمْرِو بْنِ مُرَّۃَ قَالَ حدَّثَنِی شَیْخٌ، عَن صِلَۃَ بْنِ زُفَرَ، قَالَ: سَمِعْتُ ابْنَ عُمَرَ یَقُولُ فِی دُبُرِ الصَّلاۃِ : اللَّہُمَّ أَنْتَ السَّلامُ وَمِنْک السَّلامُ ، تَبَارَکْت یَا ذَا الْجَلالِ وَالإِکْرَامِ ، ثُمَّ صَلَّیْت إِلَی جَنْبِ عَبْدِ اللہِ بْنِ عَمْرٍو فَسَمِعَہُ یَقُولُہُ ، فَقُلْتُ لَہُ : إنِّی سَمِعْتُ ابْنَ عُمَرَ یَقُولُ مِثْلَ الَّذِی تَقُولُ ، فَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : إنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُہُنَّ فِی آخِرِ صَلاتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 29871","","","كتاب الدعاء"
"29872","(۲۹۸۷۲) حَدَّثَنَا عَبْدَۃُ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِی الزُّبَیْرِ مَوْلًی لَہُمْ ، أَنَّ عَبْدَ اللہِ بْنَ الزُّبَیْرِ کَانَ یُہَلِّلُ دُبُرَ کُلِّ صَلاۃٍ یَقُولُ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ ، وَلا نَعْبُدُ إِلاَّ إیَّاہُ ، لَہُ النِّعْمَۃُ وَلَہُ الْفَضْلُ وَلَہُ الثَّنَائُ الْحَسَنُ ، لاَ إلَہَ إِلاَّ اللَّہُ مُخْلِصِینَ لَہُ الدِّینَ وَلَوْ کَرِہَ الْکَافِرُونَ ، ثُمَّ یَقُولُ ابْنُ الزُّبَیْرِ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُہَلِّلُ بِہِنَّ دُبُرَ کُلِّ صَلاۃٍ۔ (مسلم ۴۱۶۔ ابوداؤد ۱۵۰۲)","Sahih","Musannaf Ibn Abi Shaybah 29872","","","كتاب الدعاء"
"29873","(۲۹۸۷۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ قَالَ : أَتَی عَلِیُّ بْنُ أَبِی طَالِبٍ رضی اللہ عَنہ فَاطِمَۃَ رضی اللہ عنہا فَقَالَ إنِّی أَشْتَکِی صَدْرِی مِمَّا أَمدُ بِالْغَرْبِ ، قَالَتْ : وَأَنَا وَاللہ إنِّی لأشْتَکِی یَدَیَّ مِمَّا أَطْحَنُ الرَّحَا ، فَقَالَ : لَہَا : ائْتِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَدْ أَتَاہُ سَبْیٌ ائْتِیہِ لَعَلَّہُ یُخْدِمُکِ خَادِمًا ، فَانْطَلَقَا إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَاہُمَا فَقَالَ : إنَّکُمَا جِئْتُمَانِی لأُخْدِمَکُمَا خَادِمًا ، وَإِنِّی سَأُخْبِرُکُمَا بِمَا ہُوَ خَیْرٌ لَکُمَا مِنَ الْخَادِمِ ، فَإِنْ شِئْتُمَا أَخْبَرْتُکُمَا بِمَا ہُوَ خَیْرٌ لَکُمَا مِنَ الْخَادِمِ : تُسَبِّحَانِہِ دُبُرَ کُلِّ صَلاۃٍ ثَلاثًا وَثَلاثِینَ وَتَحْمَدَانِہِ ثَلاثًا وَثَلاثِینَ وَتُکَبِّرَانِہِ أَرْبَعًا وَثَلاثِینَ ، وَإِذَا أَخَذْتُمَا مَضَاجِعَکُمَا مِنَ اللَّیْلِ فَتِلْکَ مِئَۃ قَالَ عَلِیٌّ رضی اللہ ، عَنہ : فَمَا أَعْلَمُنِی تَرَکْتہَا بَعْدُ ، قَالَ لَہُ عَبْدُ اللہِ ابْنُ الْکَوَّائِ : وَلا لَیْلَۃَ صِفِّینَ ، فَقَالَ لَہُ عَلِیٌّ : قَاتَلَکُمَ اللَّہُ یَا أَہْلَ الْعِرَاقِ ، وَلا لَیْلَۃَ الصِّفِّینِ۔ (ابن ماجہ ۴۱۵۲۔ احمد ۷۹)","","Musannaf Ibn Abi Shaybah 29873","","","كتاب الدعاء"
"29874","(۲۹۸۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُلَّتَانِ لاَ یُحَافِظُ عَلَیْہِمَا رَجُلٌ إِلاَّ دَخَلَ الْجَنَّۃَ ، ہُمَا یَسِیرٌ وَمَنْ یَفْعَلُہُمَا قلِیلٌ قِیلَ : مَا ہُمَا یَا رَسُولَ اللہِ قَالَ : الصَّلَوَاتُ الْخَمْسُ ، یُسَبِّحُ الرَّجُلُ فِی دُبُرِ کُلِّ صَلاتِہِ عَشْرًا وَیَحْمَدُ عَشْرًا وَیُکَبِّرُ عَشْرًا ، فَذَلِکَ خَمْسُونَ وَمِئَۃٌ عَلَی اللِّسَانِ ، وَأَلْفٌ وَخَمْسُمِئَۃٍ فِی الْمِیزَانِ قَالَ : وَلَقَدْ رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُدُّہُنَّ فِی یَدِہِ وَیُسَبِّحُ ثَلاثًا وَثَلاثِینَ وَیَحْمَدُ ثَلاثًا وَثَلاثِینَ وَیُکَبِّرُ أَرْبَعًا وَثَلاثِینَ عِنْدَ مَضْجَعِہِ مِنَ اللَّیْلِ وَإِذَا أَوی إِلَی فِرَاشِہِ سَبَّحَ وَحَمِدَ وَکَبَّرَ مِئَۃ فَذَلِکَ مِئَۃ عَلَی اللِّسَانِ ، وَأَلْفٌ فِی الْمِیزَانِ ، فَأَیُّکُمْ یُذْنِبُ فِی اللَّیْلَۃِ أَلْفَیْنِ وَخَمْسَمِئَۃٍ۔ (ابن ماجہ ۹۲۶۔ ترمذی ۳۴۱۰)","Da'if","Musannaf Ibn Abi Shaybah 29874","","","كتاب الدعاء"
"29875","(۲۹۸۷۵) حَدَّثَنَا شَبَابَۃُ حَدَّثَنَا شُعْبَۃُ ، عَن مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَن مَوْلًی لاُمِّ سَلَمَۃَ ، عَن أُمِّ سَلَمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ إذَا صَلَّی الصُّبْحَ حِینَ یُسَلِّمُ : اللَّہُمَّ إنِّی أَسْأَلُک عِلْمًا نَافِعًا وَرِزْقًا طَیِّبًا وَعَمَلاً مُتَقَبَّلاً۔ (احمد ۳۰۵۔ ابویعلی ۶۹۶۱)","Da'if","Musannaf Ibn Abi Shaybah 29875","","","كتاب الدعاء"
"29876","(۲۹۸۷۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن حُصَیْنٍ ، عَن ہِلالِ بْنِ یَِسَافٍ عَن زَاذَانَ قَالَ : حدَّثَنِی رَجُلٌ مِنَ الأَنْصَارِ ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی دُبُرِ الصَّلاۃِ : اللَّہُمَّ اغْفِرْ لِی وَتُبْ عَلَیَّ إنَّک أَنْتَ التَّوَّابُ الْغَفُورُ مِئَۃ مَرَّۃٍ۔ (احمد ۳۷۱۔ بخاری ۶۱۹)","Sahih","Musannaf Ibn Abi Shaybah 29876","","","كتاب الدعاء"
"29877","(۲۹۸۷۷) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ أَبِی عُمَرَ الصینی وَعَن سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ سَمِعَہُ مِنْ أَبِی عُمَرَ ، عَنْ أَبِی الدَّرْدَائِ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، ذَہَبَ الأَغْنِیَائُ بِالأَجْرِ ، یُصَلُّونَ کَمَا نُصَلِّی ، وَیَصُومُونَ کَمَا نَصُومُ ، وَیَحُجُّونَ کَمَا نَحُجُّ ، وَیَتَصَدَّقُونَ ، وَلا نَجِدُ مَا نَتَصَدَّقُ قَالَ : فَقَالَ : أَلا أَدُلُّکُمْ عَلَی شَیْئٍ إذَا فَعَلْتُمُوہُ أَدْرَکْتُمْ مَنْ سَبَقَکُمْ ، وَلا یُدْرِکُکُمْ مَنْ بَعْدَکُمْ إِلاَّ مَنْ عَمِلَ بِالَّذِی تَعْمَلُونَ : تُسَبِّحُونَ اللَّہَ ثَلاثًا وَثَلاثِینَ وَتَحْمَدُونَہُ ثَلاثًا وَثَلاثِینَ وَتُکَبِّرُونَہُ أَرْبَعًا وَثَلاثِینَ فِی دُبُرِ کُلِّ صَلاۃٍ۔\n(احمد ۴۴۶۔ نسائی ۹۹۷۹)","Da'if","Musannaf Ibn Abi Shaybah 29877","","","كتاب الدعاء"
"29878","(۲۹۸۷۸) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنِ الرُّکَیْنِ بْنِ الرَّبِیعِ عَنْ أَبِیہِ قَالَ : کَانَ عُمَرُ إذَا انْصَرَفَ مِنْ صَلاتِہِ قَالَ : اللَّہُمَّ أَسْتَغْفِرُک لِذَنْبِی ، وَأَسْتَہْدِیک لمرَاشَدِ أَمْرِی ، وَأَتُوبُ إلَیْک فَتُبْ عَلَی ، اللَّہُمَّ أَنْتَ رَبِّی فَاجْعَلْ رَغْبَتِی إلَیْک ، وَاجْعَلْ غِنَائِی فِی صَدْرِی وَبَارِکْ لِی فِیمَا رَزَقَتْنِی ، وَتَقَبَّلْ مِنِّی ، إنَّک أَنْتَ رَبِّی۔","","Musannaf Ibn Abi Shaybah 29878","","","كتاب الدعاء"
"29879","(۲۹۸۷۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَن مَعْمَرٍ ، عَن سِمَاکِ بْنِ الْفَضْلِ ، عَن وَہْبِ بْنِ مُنَبِّہٍ قَالَ : مَثَلُ الَّذِی یَدْعُو بِغَیْرِ عَمَلٍ مَثَلُ الَّذِی یَرْمِی بِغَیْرِ وَتَرٍ۔","","Musannaf Ibn Abi Shaybah 29879","","","كتاب الدعاء"
"29880","(۲۹۸۸۰) حَدَّثَنَا ابْنُ نُمَیْرٍ حَدَّثَنَا الأَعْمَشُ ، عَن مَالِکِ بْنِ الْحَارِثِ قَالَ : کَانَ رَبِیعٌ یَأْتِی عَلْقَمَۃَ یَوْمَ الْجُمُعَۃِ ، قَالَ : فَأَتَاہُ ، وَلَمْ یَکُنْ ثَمَّۃَ ، فَجَائَ رَجُلٌ فَقَالَ : أَلا تَعْجَبُونَ مِنَ النَّاسِ وَکَثْرَۃِ دُعَائِہِمْ وَقِلَّۃِ إجَابَتِہِمْ ، فَقَالَ رَبِیعٌ : تَدْرُونَ لِمَ ذَاکَ ؟ إنَّ اللَّہَ لاَ یَقْبَلُ إِلاَّ النَّخِیلَۃَ مِنَ الدُّعَائِ ، قَالَ عَبْدُ الرَّحْمَنِ بْن یَزِید : فَلَمَّا جِئْتُ أَخْبَرَنِی عَلْقَمَۃ بِقَوْلِ رَبِیعٍ فَقُلْتُ لَہُ : أَمَا سَمِعْتَ قَوْلَ عَبْدَ اللہِ؟ قَالَ: وَمَا ذَاکَ؟ قَالَ: قَالَ عَبْدُ اللہِ: وَالَّذِی لاَ إلَہَ غَیْرُہُ لاَ یَسْمَعُ اللَّہُ مِنْ مُسَمِّعٍ ، وَلا مِنْ مُرَائِی ، وَلا لاعِبٍ ، وَلا دَاعٍ إِلاَّ دَاعٍ دَعَا بِتَثَبُّتٍ مِنْ قَلْبِہِ۔","","Musannaf Ibn Abi Shaybah 29880","","","كتاب الدعاء"
"29881","(۲۹۸۸۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن مَالِکِ بْنِ الْحَارِثِ قَالَ : یَقُولُ اللَّہُ مَنْ شَغَلَہُ ذِکْرِی ، عَن مَسْأَلَتِی أَعْطَیْتہ فَوْقَ مَا أُعْطِی السَّائِلِینَ۔ (بخاری ۱۸۵۰۔ ترمذی ۲۹۲۶)","","Musannaf Ibn Abi Shaybah 29881","","","كتاب الدعاء"
"29882","(۲۹۸۸۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ أَبُو أُمَیَّۃُ بْنُ فُضَالَۃَ قَالَ : حَدَّثَنَا بَکْرُ بْنُ عَبْدِ اللہِ الْمُزَنِیّ قَالَ أَبُو ذَرٍّ : یَکْفِی مِنَ الدُّعَائِ مَعَ الْبِرِّ مَا یَکْفِی الطَّعَامَ مِنَ الْمِلْحِ۔","Hasan","Musannaf Ibn Abi Shaybah 29882","","","كتاب الدعاء"
"29883","(۲۹۸۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن مُوسَی بْنِ مُسْلِمَ ، عْن عَمْرِو بْنِ مُرَّۃَ ، رَفَعَہُ قَالَ : مَنْ شَغَلَہُ ذِکْرِی عَن مَسْأَلَتِی أَعْطَیْتہ فَوْقَ مَا أُعْطِی السَّائِلِینَ ، یَعْنِی الرَّبَّ تَبَارَکَ وَتَعَالَی۔","","Musannaf Ibn Abi Shaybah 29883","","","كتاب الدعاء"
"29884","(۲۹۸۸۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ عَاصِمٍ یُحَدِّثُ ، أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : إنَّ أَبَا بَکْرٍ قَالَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَخْبِرْنِی بِشَیْئٍ أَقُولُہُ إذَا أَصْبَحْت وَإِذَا أَمْسَیْت، قَالَ : قُلِ : اللَّہُمَّ عَالِمَ الْغَیْبِ وَالشَّہَادَۃِ فَاطِرَ السَّمَاوَاتِ وَالأَرْضِ ، رَبَّ کُلِّ شَیْئٍ وَمَلِیکَہُ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ ، أَعُوذُ بِکَ مِنْ شَرِّ نَفْسِی ، وَمِنَ الشَّیْطَانِ وَشِرْکِہِ ، قُلْہُ إذَا أَمْسَیْت وَإِذَا أَصْبَحْت ، وَإِذَا أَخَذْت مَضْجَعَک۔","Sahih","Musannaf Ibn Abi Shaybah 29884","","","كتاب الدعاء"
"29885","(۲۹۸۸۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ الْعُکْلِیُّ ، حَدَّثَنَا أَبُو مَوْدُودٍ قَالَ : حدَّثَنَی مَنْ سَمِعَ أَبَانَ بْنَ عُثْمَانَ قَالَ : حَدَّثَنَی أَبِی عُثْمَانُ ، أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ قَالَ إذَا أَصْبَحَ وَإِذَا أَمْسَی ثَلاثَ مِرَارٍ : بِسْمِ اللہِ الَّذِی لاَ یَضُرُّ مَعَ اسْمِہِ شَیْئٌ فِی الأَرْضِ ، وَلا فِی السَّمَائِ وَہُوَ السَّمِیعُ الْعَلِیمُ لَمْ یُصِبْہُ فِی یَوْمِہِ ، وَلا فِی لَیْلَتِہِ شَیْئٌ۔ (ابوداؤد ۵۰۴۷۔ نسائی ۹۸۴۴)","Da'if","Musannaf Ibn Abi Shaybah 29885","","","كتاب الدعاء"
"29886","(۲۹۸۸۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن زَائِدَۃَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ بْنِ سُوَیْد ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَمْسَی قَالَ : أَمْسَیْنَا وَأَمْسَی الْمُلْکُ لِلَّہِ وَالْحَمْدُ لِلَّہِ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، اللَّہُمَّ إنِّی أَسْأَلُک مِنْ خَیْرِ ہَذِہِ اللَّیْلَۃِ وَخَیْرِ مَا فِیہَا ، وَأَعُوذُ بِکَ مِنْ شَرِّہَا وَشَرِّ مَا فِیہَا اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْکَسَلِ وَالْہَرَمِ والْکِبَرِ وَفِتْنَۃِ الدُّنْیَا وَعَذَابِ الْقَبْرِ ، وَقَالَ الْحَسَنُ بْنُ عُبَیْدِ اللہِ : وَزَادَنِی فِیہِ زُبَیْدٌ ، عَنْ إبْرَاہِیمَ بْنِ سُوَیْد ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، رَفَعَہُ ، قَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ۔ (مسلم ۲۰۸۹۔ ابوداؤد ۵۰۳۲)","Sahih","Musannaf Ibn Abi Shaybah 29886","","","كتاب الدعاء"
"29887","(۲۹۸۸۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن سُفْیَانَ ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَصْبَحَ قَالَ : أَصْبَحْنَا عَلَی فِطْرَۃِ الإِسْلامِ ، وَکَلِمَۃِ الإِخْلاصِ ، وَدِینِ نَبِیِّنَا مُحَمَّدٍ ، وَمِلَّۃِ أَبِینَا إِبْرَاہِیمَ حَنِیفًا ، وَمَا کان مِنَ الْمُشْرِکِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 29887","","","كتاب الدعاء"
"29888","(۲۹۸۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا فَائِدٌ أَبُو وَرْقَائَ ، حَدَّثَنَا عَبْدِ اللہِ بْنِ أَبِی أَوْفَی ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَصْبَحَ یقول : أَصْبَحْنَا وَأَصْبَحَ الْمُلْکُ لِلَّہِ ، وَالْکِبْرِیَائُ وَالْعَظَمَۃُ ، وَالْخَلْقُ وَالأَمْرُ، وَاللَّیْلُ وَالنَّہَارُ ، وَمَا یُضْحَی فِیہِمَا لِلَّہِ وَحْدَہُ ، لاَ شَرِیکَ لَہُ ، اللَّہُمَّ اجْعَلْ أَوَّلَ ہَذَا النَّہَارِ صَلاحًا، وَأَوْسَطَہُ فَلاحًا ، وَآخِرَہُ نَجَاحًا ، أَسْأَلُک خَیْرَ الدُّنْیَا ، یَا أَرْحَمَ الرَّاحِمِینَ۔ (عبد بن حمید ۵۳۱)","Da'if","Musannaf Ibn Abi Shaybah 29888","","","كتاب الدعاء"
"29889","(۲۹۸۸۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حَدَّثَنَا عُبَادَۃُ بْنُ مُسْلِمٍ الْفَزَارِیّ ، حَدَّثَنَا جُبَیْرُ بْنُ أَبِی سُلَیْمَانَ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، زَعَمَ أَنَّہُ کَانَ جَالِسًا مَعَ عَبْدِ اللہِ بْنِ عُمَرَ فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی دُعَائِہِ حِینَ یُمْسِی وَحِینَ یُصْبِحُ لَمْ یَدَعْہُ حَتَّی فَارَقَ الدُّنْیَا ، أَوْ حَتَّی مَاتَ : اللَّہُمَّ إنِّی أسْأَلُک الْعَافِیَۃَ فِی الدُّنْیَا وَالآخِرَۃِ اللَّہُمَّ إنِّی أَسْأَلُک الْعَفْوَ وَالْعَافِیَۃَ فِی دِینِی وَدُنْیَایَ وَأَہْلِی وَمَالِی ، اللَّہُمَّ اسْتُرْ عَوْرَاتِی وَآمِنْ رَوْعَاتِی ، اللَّہُمَّ احْفَظْنِی مِنْ بَیْنِ یَدَیَّ وَمِنْ خَلْفِی ، وَعَن یَمِینِی وَعَن شِمَالِی وَمِنْ فَوْقِی ، وَأَعُوذُ بِعَظَمَتِکَ أَنْ أُغْتَالَ مِنْ تَحْتِی ، قَالَ جُبَیْرٌ : وَہُوَ الْخَسْفُ ، وَلا أَدْرِی : قَوْلُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ قَوْلُ جُبَیْرٍ۔ (نسائی ۷۹۷۱)","Sahih","Musannaf Ibn Abi Shaybah 29889","","","كتاب الدعاء"
"29890","(۲۹۸۹۰) حَدَّثَنَا وَکِیعٌ ، عَن عُبَادَۃَ ، عَن جُبَیْرِ بْنِ أَبِی سُلَیْمَانَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْہُ۔ (ابوداؤد ۵۰۳۵۔ ابن حبان ۹۶۱)","Sahih","Musannaf Ibn Abi Shaybah 29890","","","كتاب الدعاء"
"29891","(۲۹۸۹۱) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ قَالَ : حُدِّثْتُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ إذَا أَصْبَحَ : بِکَ أَصْبَحْنَا وَبِکَ نَحْیَا وَبِکَ نَمُوتُ وَإِلَیْک النُّشُور وَإِذَا أَمْسَی قَالَ : اللہم بِکَ أَمْسَیْنَا وَبِکَ نَحْیَا وَبِکَ نَمُوتُ وَإِلَیْک الْمَصِیرُ۔","","Musannaf Ibn Abi Shaybah 29891","","","كتاب الدعاء"
"29892","(۲۹۸۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ قَالَ : حدَّثَنَی أَبُو عَقِیلٍ عَن سَابِقٍ ، عَنْ أَبِی سَلاَّمٍ خَادِمِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عن رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا مِنْ مُسْلِمٍ ، أَوْ إنْسَانٍ ، أَوْ عَبْدٍ یَقُولُ حِینَ یُمْسِی وَحِینَ یُصْبِحُ ثَلاثَ مَرَّاتٍ رَضِیت بِاللہِ رَبًّا ، وَبِالإِسْلامِ دِینًا ، وَبِمُحَمَّدٍ نَبِیًّا ، إِلاَّ کَانَ حَقًّا عَلَی اللہِ أَنْ یُرْضِیَہُ یَوْمَ الْقِیَامَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 29892","","","كتاب الدعاء"
"29893","(۲۹۸۹۳) حَدَّثَنَا زَیْدٌ ، حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ شُرَیْحٍ ، حَدَّثَنِی أَبُو ہَانِئٍ ، عَنْ أَبِی عَلِیٍّ الْجَنَبِیِّ ، قَالَ : سَمِعْتُ أَبَا سَعِیدٍ الْخُدْرِیِّ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ رَضِیت بِاللہِ رَبًّا وَبِالإِسْلامِ دِینًا وَبِمُحَمَّدٍ رَسُولا ، وَجَبَتْ لَہُ الْجَنَّۃُ۔ (ابوداؤد ۱۵۲۴۔ حاکم ۹۳)","Hasan","Musannaf Ibn Abi Shaybah 29893","","","كتاب الدعاء"
"29894","(۲۹۸۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْمُجَبَّرِ ، عَن صَفْوَانَ بْنِ سُلَیْمٍ ، عَنْ عَطَائِ بْنِ یَسَارٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ حِینُ یُمْسِی : رَضِیت بِاللہِ رَبًّا ، وَبِالإِسْلامِ دِینًا ، وَبِمُحَمَّدٍ رَسُولاً ، فَقَدْ أَصَابَ حَقِیقَۃَ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 29894","","","كتاب الدعاء"
"29895","(۲۹۸۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، عَن بُکَیْر بْنِ الأَخْنَسِ قَالَ : مَنْ قَالَ حِینَ یُمْسِی وَیُصْبِحُ ثَلاثًا، اللَّہُمَّ إنِّی أَمْسَیْت أَشْہَدُ ، وَإِذَا أَصْبَحَ قَالَ : اللَّہُمَّ أَصْبَحْت أَشْہَدُ ، أَنَّہُ مَا أَصْبَحَ بِنَا مِنْ عَافِیَۃٍ وَنِعْمَۃٍ، فَمِنْک وَحْدَک ، لاَ شَرِیکَ لَکَ ، فَلَکَ الْحَمْدُ لَمْ یُسْأَلْ عَن نِعْمَۃٍ کَانَتْ فِی لَیْلَتِہِ تِلْکَ ، وَلا یَوْمِہِ ، إِلاَّ قَدْ أَدَّی شُکْرَہَا۔ (ابوداؤد ۵۰۳۴۔ ابن حبان ۸۶۱)","","Musannaf Ibn Abi Shaybah 29895","","","كتاب الدعاء"
"29896","(۲۹۸۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ ، أَنَّہُ کَانَ یَقُولُ إذَا أَصْبَحَ وَأَمْسَی : اللَّہُمَّ إنِّی أَسْأَلُک عِنْدَ حَضْرَۃِ صَلاواتک وَقِیَامِ دُعَاتِکَ أَنْ تَغْفِرَ لِی وَتَرْحَمَنِی۔","","Musannaf Ibn Abi Shaybah 29896","","","كتاب الدعاء"
"29897","(۲۹۸۹۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَخْبَرَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا أَصْبَحَ أو أَمْسَی : اللَّہُمَّ اجْعَلْنِی أَفْضَلِ عِبَادِکَ الْغَدَاۃَ ، أَو اللَّیْلَۃَ نَصِیبًا مِنْ خَیْرٍ تَقْسِمُہُ ، وَنُورٍ تَہْدِی بِہِ ، وَرَحْمَۃٍ تَنْشُرہا ، وَرِزْقٍ تَبْسُطُہُ ، وَضُرٍّ تَکْشِفُہُ ، وَبَلائٍ تَرْفَعُہُ ، وَشَرٍّ تَدْفَعُہُ ، وَفِتْنَۃٍ تَصْرِفُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 29897","","","كتاب الدعاء"
"29898","(۲۹۸۹۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ مَا تَقُولُونَ إذَا أَصْبَحْتُمْ وَأَمْسَیْتُمْ مِمَّا تَدْعُونَ بِہِ ، قَالَ : نَقُولُ : أَعُوذُ بِوَجْہِ اللہِ الْکَرِیمِ وَاسْمِ اللہِ الْعَظِیمِ وَکَلِمَۃِ اللہِ التَّامَّۃِ مِنْ شَرِّ السَّامَّۃِ وَاللاَّمَّۃِ وَمِنْ شَرِّ مَا جَہِلت أَیْ رَبِ ، وَشَرِّ مَا أَنْتَ آخِذٌ بِنَاصِیَتِہِ ، وَمِنْ شَرِّ ہَذَا الْیَوْمِ وَشَرِّ مَا بَعْدَہُ ، وَشَرِّ الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 29898","","","كتاب الدعاء"
"29899","(۲۹۸۹۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَن رِبْعِیٍّ ، عَن رَجُلٍ مِنَ النَّخَعِ ، عَنْ أَبِیہِ ، عَن سَلْمَانَ قَالَ: مَنْ قَالَ إذَا أَصْبَحَ وَإِذَا أَمْسَی اللَّہُمَّ أَنْتَ رَبِّی لاَ شَرِیکَ لَکَ ، أَصْبَحْنَا وَأَصْبَحَ الْمُلْکُ لَکَ لاَ شَرِیکَ لَہ ، غفر لہ ما أَحَدَثَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 29899","","","كتاب الدعاء"
"29900","(۲۹۹۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَن رِبْعِیٍّ بن حراش عَن رَجُلٍ مِنَ النَّخَعِ ، عَن سَلْمَانَ قَالَ : مَنْ قَالَ إذَا أَصْبَحَ اللَّہُمَّ أَنْتَ رَبِّی لاَ شَرِیکَ لَکَ کَانَ کَفَّارَۃً لِمَا أَحْدَثَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 29900","","","كتاب الدعاء"
"29901","(۲۹۹۰۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن مُوسَی الْجُہَنِیِّ قَالَ : حدَّثَنِی رَجُلٌ ، عَن سَعِیدِ بْنِ جُبَیْرٍ قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ حِینَ تُمْسُونَ وَسُبْحَانَ اللہِ حِینَ تُصْبِحُونَ حَتَّی یَفْرُغَ مِنَ الآیَۃِ ثَلاثَ مَرَّاتٍ أَدْرَکَ مَا فَاتَہُ مِنْ یَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 29901","","","كتاب الدعاء"
"29902","(۲۹۹۰۲) حَدَّثَنَا الحَسَنُ بْنُ مُوسَی ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی عَیَّاشٍ الزُّرَقِیِّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ حِینَ یُصْبِحُ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ کَانَ لَہُ کَعَدْلِ رَقَبَۃٍ مِنْ وَلَدِ إسْمَاعِیلَ ، وَکُتِبَتْ لَہُ بِہَا عَشْرُ حَسَنَاتٍ، وَحُطَّتْ بِہَا عَنہُ عَشْرُ سَیِّئَاتٍ ، وَرُفِعَتْ لَہُ بِہَا عَشْرُ دَرَجَاتٍ ، وَکَانَ فِی حِرْزٍ مِنَ الشَّیْطَانِ حَتَّی یُمْسِیَ ، وَإِذَا أَمْسَی مِثْلُ ذَلِکَ حَتَّی یُصْبِحَ۔","Sahih","Musannaf Ibn Abi Shaybah 29902","","","كتاب الدعاء"
"29903","(۲۹۹۰۳) حَدَّثَنَا الحَسَنُ بْنُ مُوسَی ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ إذَا أَصْبَحَ : اللَّہُمَّ بِکَ أَصْبَحْنَا وَبِکَ أَمْسَیْنَا ، وَبِکَ نَحْیَا وَبِکَ نَمُوتُ ، وَإِلَیْک الْمَصِیرُ۔ (ابوداؤد ۵۰۲۹۔ ترمذی ۳۳۹۱)","Sahih","Musannaf Ibn Abi Shaybah 29903","","","كتاب الدعاء"
"29904","(۲۹۹۰۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَی فِطْرٌ قَالَ : حَدَّثَنَی عَبْدُ اللہِ بْنُ عُبَیْدِ بْنِ عُمَیْرٍ ، عَن رَجُلٍ مِنْ أَصْحَابِ مُحَمَّدٍ قَالَ : مَنْ قَالَ حِینَ یُصْبِحُ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، بِیَدِہِ الْخَیْرُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ عَشْرَ مَرَّاتٍ ، رُفِعَ لَہُ عَشْرُ دَرَجَاتٍ ، وَمُحِیَ عَنہُ عَشْرُ سَیِّئَاتٍ ، وَبَرِئَ یَوْمَئِذٍ مِنَ النِّفَاقِ حَتَّی یُمْسِی ، وَإِنْ قَالَ حِینَ یُمْسِی کَانَ مِثْلَ ذَلِکَ ، وَبَرِئَ مِنَ النِّفَاقِ حَتَّی یُصْبِحَ۔","Sahih","Musannaf Ibn Abi Shaybah 29904","","","كتاب الدعاء"
"29905","(۲۹۹۰۵) حَدَّثَنَا الحَسَنُ بْنُ مُوسَی ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن یَحْیَی بْنِ سَعِیدٍ بْنِ حَیَّانَ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرِو بْنِ جَرِیرٍٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَن کَعْبٍ قَالَ : أَجِدُ فِی التَّوْرَاۃِ : مَنْ قَالَ إِذَا أَصْبحَ : اللَّہُمَّ إنِّی أَعُوذُ بِاسْمِکَ وَبِکَلِمَاتِکَ التَّامَّۃِ مِنَ الشَّیْطَانِ الرَّجِیمِ ، اللَّہُمَّ إنِّی أَعُوذُ بِاسْمِکَ وَبِکَلِمَاتِکَ التَّامَّۃِ مِنْ عذابک وَشَرِّ عِبَادِکَ ، اللَّہُمَّ إنِّی أَسْأَلُکَ بِاسْمِکَ وَکَلِمَاتِکَ التَّامَّۃِ مِنْ خَیْرِ مَا تُسْأَلُ وَمِنْ خَیْرِ مَا تُعْطِی وَمِنْ خَیْرِ مَا تُبْدِی وَمِنْ خَیْرِ مَا تُخْفِی : اللَّہُمَّ إنِّی أَعُوذُ بِکَ بِاسْمِکَ وَبِکَلِمَاتِکَ التَّامَّۃِ مِنْ شَرِّ مَا تَجَلَّی بِہِ النَّہَارُ ، لَمْ تُطِفْ بِہِ الشَّیَاطِینُ ، وَلا لِشَیْئٍ یَکْرَہُہُ ، وَإِذَا قَالَہُنَّ إذَا أَمْسَی کَمِثْلِ ذَلِکَ غَیْرَ أَنَّہُ یَقُولُ : مِنْ شَرِّ مَا دَجَا بِہِ اللَّیْلُ۔","Sahih","Musannaf Ibn Abi Shaybah 29905","","","كتاب الدعاء"
"29906","(۲۹۹۰۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَخَذَ مَضْجَعَہُ قَالَ : اللَّہُمَّ إلَیْک أَسْلَمْت نَفْسِی ، وَوَجَّہْت وَجْہِی ، وَإِلَیْک فَوَّضْت أَمْرِی : وَإِلَیْک أَلْجَأْت ظَہْرِی رَغْبَۃً وَرَہْبَۃً إلَیْک ، لاَ مَلْجَأَولا مَنْجَی مِنْک إِلاَّ إلَیْک : آمَنْت بِکِتَابِکَ الَّذِی أَنْزَلْت ، وَبِنَبِیِّکَ ، أَوْ رَسُولِکَ الَّذِی أَرْسَلْت۔","Sahih","Musannaf Ibn Abi Shaybah 29906","","","كتاب الدعاء"
"29907","(۲۹۹۰۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِرَجُلٍ : یَا فُلانُ ، إذَا أَویْت إِلَی فِرَاشِکَ فَقُلِ : اللَّہُمَّ أَسْلَمْت نَفْسِی إلَیْک ، وَوَلَّیْت ظَہْرِی إلَیْک ، ثُمَّ ذَکَرَ نَحْوَہُ إِلاَّ أَنَّہُ قَالَ : فَإِنْ مِتَّ مِنْ لَیْلَتِکَ مِتَّ عَلَی الْفِطْرَۃِ ، وَإِنْ أَصْبَحْت أَصَبْت خَیْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 29907","","","كتاب الدعاء"
"29908","(۲۹۹۰۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ لِرَجُلٍ : إذَا أَخَذْت مَضْجَعَک فَقُلِ : اللَّہُمَّ إنِّی أَسْلَمْت نَفْسِی إلَیْک ، وَوَجَّہْت وَجْہِی إلَیْک ، وَفَوَّضْت أَمْرِی إلَیْک ، وَأَلْجَأْت ظَہْرِی إلَیْک رَہْبَۃً وَرَغْبَۃً إلَیْک ، لاَ مَنْجَی ، وَلا مَلْجَأَ مِنْک إِلاَّ إلَیْک ، آمَنْت بِکِتَابِکَ الَّذِی أَنْزَلْت وَنَبِیِّکَ الَّذِی أَرْسَلْت فَإِنْ مِتَّ مِتَّ عَلَی الْفِطْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 29908","","","كتاب الدعاء"
"29909","(۲۹۹۰۹) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، عَن حُذَیْفَۃَ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَخَذَ مَضْجَعَہُ قَالَ : اللَّہُمَّ بِاسْمِکَ أَمُوتُ وَأَحْیَا ، وَإِذَا قَامَ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَحْیَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَیْہِ النُّشُورُ۔","Sahih","Musannaf Ibn Abi Shaybah 29909","","","كتاب الدعاء"
"29910","(۲۹۹۱۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رِبْعِیٍّ ، عَن حُذَیْفَۃَ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا نَامَ قَالَ : بِاسْمِکَ أَحْیَا وَأَمُوتُ ، وَإِذَا اسْتَیْقَظَ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَحْیَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَیْہِ النُّشُورُ۔","Sahih","Musannaf Ibn Abi Shaybah 29910","","","كتاب الدعاء"
"29911","(۲۹۹۱۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رِبْعِیٍّ ، عَن حُذَیْفَۃَ ، عن النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ ، الشَّکُّ مِنْ جَرِیرٍ فِی عَبْدِ الْمَلِکِ ، أَوْ مَنْصُورٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29911","","","كتاب الدعاء"
"29912","(۲۹۹۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ قَالَ : کُنْتُ قَاعِدًا عِنْدَ عَمَّارٍ فَأَتَاہُ رَجُلٌ فَقَالَ : أَلا أُعَلِّمُک کَلِمَاتٍ کَأَنَّہُ یَرْفَعُہُنَّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَخَذْت مَضْجَعَک مِنَ اللَّیْلِ فَقُلِ : اللَّہُمَّ أَسْلَمْت نَفْسِی إلَیْک ، وَفَوَّضْت أَمْرِی إلَیْک ، وَأَلْجَأْت ظَہْرِی إلَیْک ، آمَنْت بِکِتَابِکَ الْمُنَزَّلِ وَنَبِیِّکَ الْمُرْسَلِ ، اللَّہُمَّ نَفْسِی خَلَقْتہَا ، لَکَ مَحْیَاہَا وَلَک مَمَاتُہَا ، فَإِنْ کَفَتَّہَا فَارْحَمْہَا ، وَإِنْ أَخَّرْتہَا فَاحْفَظْہَا بِحِفْظِ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 29912","","","كتاب الدعاء"
"29913","(۲۹۹۱۳) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، قَالَ : سَمِعْتُ أَبَا بَکْرِ بْنَ أَبِی مُوسَی یُحَدِّثُ ، عَنِ الْبَرَائِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا اسْتَیْقَظَ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَحْیَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَیْہِ النُّشُورُ قَالَ شُعْبَۃُ ہَذَا ، أَوْ نَحْوُہُ ، وَإِذَا نَامَ قَالَ : اللَّہُمَّ بِاسْمِکَ أَحْیَا وَبِاسْمِکَ أَمُوتُ۔","Sahih","Musannaf Ibn Abi Shaybah 29913","","","كتاب الدعاء"
"29914","(۲۹۹۱۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو : اللَّہُمَّ آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ۔ (احمد ۲۴۷۔ مسلم ۲۰۷۱)","Sahih","Musannaf Ibn Abi Shaybah 29914","","","كتاب الدعاء"
"29915","(۲۹۹۱۵) حَدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ الْمَقْبُرِیِّ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا أَرَادَ أَحَدُکُمْ أَنْ یَضْطَجِعَ عَلَی فِرَاشِہِ فَلْیَنْزِعْ دَاخِلَۃَ إزَارِہِ ، ثُمَّ لِیَنْفُضْ بِہَا فِرَاشَہُ فَإِنَّہُ لاَ یَدْرِی مَا خَلَفَہُ عَلَیْہِ، ثُمَّ لِیَضْطَجِعْ عَلَی شِقِّہِ الأَیْمَنِ، ثُمَّ لِیَقُلْ: بِاسْمِکَ رَبِّی وَضَعْت جَنْبِی وَبِکَ أَرْفَعُہُ، فَإِنْ أَمْسَکْت نَفْسِی فَارْحَمْہَا، وَإِنْ أَرْسَلْتہَا فَاحْفَظْہَا بِمَا تَحْفَظُ بِہِ عِبَادَک الصَّالِحِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 29915","","","كتاب الدعاء"
"29916","(۲۹۹۱۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ حَدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَن فَرْوَۃَ بْنِ نَوْفَلٍ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَہُ : مَجِیئٌ مَا جَائَ بِکَ ؟ قَالَ : یَا رَسُولَ اللہِ ، تُعَلِّمُنِی شَیْئًا أَقُولُہُ عِنْدَ مَنَامِی ، قَالَ : إذَا أَخَذْت مَضْجَعَک فَاقْرَأْ : (قُلْ یَا أَیُّہَا الْکَافِرُونَ) ثُمَّ نَمْ عَلَی خَاتِمَتِہَا فَإِنَّہَا بَرَائَ ۃٌ مِنَ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 29916","","","كتاب الدعاء"
"29917","(۲۹۹۱۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنِ الأَفْرِیقِیِّ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِرَجُلٍ مِنَ الأَنْصَارِ : کَیْفَ تَقُولُ حِینَ تُرِیدُ أَنْ تَنَامَ ؟ قَالَ : أَقُولُ : بِاسْمِکَ وَضَعْت جَنْبِی فَاغْفِرْ لِی ، قَالَ : قَدْ غُفِرَ لَک۔","Da'if","Musannaf Ibn Abi Shaybah 29917","","","كتاب الدعاء"
"29918","(۲۹۹۱۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ الأَشْجَعِیِّ ، عَنْ أَبِیہِ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ أَخْبِرْنِی بِشَیْئٍ أَقُولُہُ إذَا أَصْبَحْت وَإِذَا أَمْسَیْت ، فَقَالَ : اقْرَأْ {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، ثُمَّ نَمْ عَلَی خَاتِمَتِہَا فَإِنَّہَا بَرَائَ ۃٌ مِنَ الشِّرْکِ۔","Da'if","Musannaf Ibn Abi Shaybah 29918","","","كتاب الدعاء"
"29919","(۲۹۹۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ بَابَاہُ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ قَالَ حِینَ یَأْوِی إِلَی فِرَاشِہِ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، سُبْحَانَ اللہِ وَبِحَمْدِہِ ، الْحَمْدُ لِلَّہِ ، لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ غُفِرَ لَہُ ذُنُوبُہُ ، وَإِنْ کَانَتْ مِثْلَ زَبَدِ الْبَحْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 29919","","","كتاب الدعاء"
"29920","(۲۹۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عِفَاقٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ قَالَ : مَنْ قَالَ إذَا أَوی إِلَی فِرَاشِہِ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ أَرْبَعَ مَرَّاتٍ غُفِرَ لَہُ ذُنُوبُہُ ، وَإِنْ کَانَتْ طِفَاحَ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 29920","","","كتاب الدعاء"
"29921","(۲۹۹۲۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمٍ ، عَن سَوَائٍ ، عَن حَفْصَۃَ ، أنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَخَذَ مَضْجَعَہُ قَالَ : رَبِّ قِنِی عَذَابَک یَوْمَ تَبْعَثُ عِبَادَک۔","","Musannaf Ibn Abi Shaybah 29921","","","كتاب الدعاء"
"29922","(۲۹۹۲۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ حَدَّثَنَا زُہَیْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ قَالَ : إذَا أَخَذْت مَضْجَعَک فَقُلْ : بِسْمِ اللہِ وَفِی سَبِیلِ اللہِ ، وَعَلَی مِلَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 29922","","","كتاب الدعاء"
"29923","(۲۹۹۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا نَامَ تَوَسَّدَ یَمِینَہُ تَحْتَ خَدِّہِ وَیَقُولُ : قِنِی عَذَابَک یَوْمَ تَبْعَثُ عِبَادَک۔","","Musannaf Ibn Abi Shaybah 29923","","","كتاب الدعاء"
"29924","(۲۹۹۲۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ إذَا نَامَ قَالَ : اللَّہُمَّ قِنِی عَذَابَک یَوْمَ تَبْعَثُ عِبَادَک ، وَکَانَ یَضَعُ یَمِینَہُ تَحْتَ خَدِّہِ۔","","Musannaf Ibn Abi Shaybah 29924","","","كتاب الدعاء"
"29925","(۲۹۹۲۵) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَوی إِلَی فِرَاشِہِ قَالَ : اللَّہُمَّ رَبَّ السَّمَاوَاتِ وَرَبَّ الأَرَضِینَ ، ربنا وَرَبَّ کُلِّ شَیْئٍ ، فَالِقَ الْحَبِّ وَالنَّوَی ، مُنْزِلَ التَّوْرَاۃِ وَالإِنْجِیلِ وَالْقُرْآنِ ، أَعُوذُ بِکَ مِنْ شَرِّ کُلِّ ذِی شَرٍّ أَنْتَ آخِذٌ بِنَاصِیَتِہِ ، أَنْتَ الأَوَّلُ فَلَیْسَ قَبْلَک شَیْئٌ ، وَأَنْتَ الآخِرُ فَلَیْسَ بَعْدَکَ شَیْئٌ ، وَأَنْتَ الظَّاہِرُ فَلَیْسَ فَوْقَک شَیْئٌ ، وَأَنْتَ الْبَاطِنُ فَلَیْسَ دُونَک شَیْئٌ ، اقْضِ عَنی الدَّیْنَ وَأَغْنِنِی مِنَ الْفَقْرِ۔\n(مسلم ۲۰۸۴۔ ابوداؤد ۵۰۱۲)","Sahih","Musannaf Ibn Abi Shaybah 29925","","","كتاب الدعاء"
"29926","(۲۹۹۲۶) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ أَبِی مَعْشَرٍ قَالَ : حُدِّثْتُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ إذَا أَوی إِلَی فِرَاشِہِ : اللَّہُمَّ عَافِنِی فِی دِینِی وَعَافِنِی فِی جَسَدِی وَعَافِنِی فِی بَصَرِی وَاجْعَلْہُ الْوَارِثَ مِنِّی ، لاَ إلَہَ إِلاَّ اللَّہُ الْعَلِیُّ الْعَظِیمُ سُبْحَانَ اللہ رَبِّ السَّمَاوَاتِ السَّبْعِ وَرَبِّ الْعَرْشِ الْکَرِیمِ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔ (ترمذی ۳۴۸۰۔ ابویعلی ۴۶۷۱)","","Musannaf Ibn Abi Shaybah 29926","","","كتاب الدعاء"
"29927","(۲۹۹۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَن عُبَیْدِ بْنِ عَمْرٍو الْخَارِِفِیِّ ، عَنْ عَلِیٍّ قَالَ : مَا أَرَی أَحَدًا یَعْقِلُ دَخَلَ فِی الإِسْلامِ یَنَامُ حَتَّی یَقْرَأَ آیَۃَ الْکُرْسِیِّ۔","Da'if","Musannaf Ibn Abi Shaybah 29927","","","كتاب الدعاء"
"29928","(۲۹۹۲۸) حَدَّثَنَا الحَسَنُ بْنُ مُوسَی حَدَّثَنَا لَیْثُ بْنُ سَعْدِ بْنِ خَالِدٍ ، عَن عُقَیْلِ بْنِ خَالِدٍ ، عَنِ ابْنِ شِہَابٍ ، أَنَّہُ قَالَ: أَخْبَرَنِی عُرْوَۃُ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا أَخَذَ مَضْجَعَہُ نَفَثَ فِی یَدَیْہِ وَقَرَأَ فِیہِمَا بِالْمُعَوِّذَتَیْنِ ، ثُمَّ مَسَحَ بِہِمَا جَسَدَہُ۔ (بخاری ۵۰۱۷۔ ابوداؤد ۵۰۱۷)","Hasan","Musannaf Ibn Abi Shaybah 29928","","","كتاب الدعاء"
"29929","(۲۹۹۲۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عِنْدَ مَنَامِہِ : أَعُوذُ بِوَجْہِکَ الْکَرِیمِ وَکَلِمَاتِکَ التَّامَّۃِ مِنْ شَرِّ مَا أَنْتَ بَاطِشٌ بِنَاصِیَتِہِ ، اللَّہُمَّ إنَّک انت تَکْشِفُ الْمَأْثَمَ وَالْمَغْرَمَ ، اللَّہُمَّ لاَ یُخْلَفُ وَعْدُک ، وَلا یُہْزَمُ جُنْدُک ، وَلا یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُ ، سُبْحَانَک وَبِحَمْدِک۔ (ابوداؤد ۵۰۱۳۔ نسائی ۱۰۶۰۳)","","Musannaf Ibn Abi Shaybah 29929","","","كتاب الدعاء"
"29930","(۲۹۹۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن فُضَیْلِ بْنِ مَرْزُوقٍ قَالَ : حدَّثَنَا أَبُو سَلَمَۃَ الْجُہَنِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا قَالَ عَبْدٌ قَطُّ إذَا أَصَابَہُ ہَمٌّ، أَوْ حَزَنٌ : اللَّہُمَّ إنِّی عَبْدُک ابْنُ عَبْدِکَ ابْنُ أَمَتِکَ، نَاصِیَتِی بِیَدِکَ، مَاضٍ فِی حُکْمُک عَدْلٌ فِی قَضَاؤُک، أَسْأَلُک بِکُلِّ اسْمٍ ہُوَ لَکَ سَمَّیْت بِہِ نَفْسَک، أَوْ أَنْزَلْتہ فِی کِتَابِکَ، أَوْ عَلَّمْتہ أَحَدًا مِنْ خَلْقِکَ، أَو اسْتَأْثَرْت بِہِ فِی عِلْمِ الْغَیْبِ عِنْدَکَ أَنْ تَجْعَلَ الْقُرْآنَ رَبِیعَ قَلْبِی وَنُورَ صَدْرِی وَجَلائَ حُزْنِی وَذَہَابَ ہَمِّی إِلاَّ أَذْہَبَ اللَّہُ ہَمَّہُ وَأَبْدَلَہُ مَکَانَ حُزْنِہِ فَرَحًا ، قَالُوا : یَا رَسُولَ اللہِ ، یَنْبَغِی لَنَا أَنْ نَتَعَلَّمَ ہؤلاء الْکَلِمَاتِ ؟ قَالَ : أَجَلْ ، یَنْبَغِی لِمَنْ سَمِعَہُنَّ أَنْ یَتَعَلَّمَہُنَّ۔ (احمد ۳۹۱۔ ابویعلی ۵۲۷۶)","Da'if","Musannaf Ibn Abi Shaybah 29930","","","كتاب الدعاء"
"29931","(۲۹۹۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَن مَنْصُورٍ ، عَن رِبْعِیٍّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ قَالَ : قَالَ لِی عَلِیٌّ : أَلا أُعَلِّمُک کَلِمَاتٍ لَمْ أُعَلِّمْہَا حَسَنًا ، وَلا حُسَیْنًا ، إذَا طَلَبْت حَاجَۃً وَأَحْبَبْت أَنْ تَنْجَحَ فَقُلْ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ الْعَلِیُّ الْعَظِیمُ ، وَلا إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ الْحَلِیمُ الْکَرِیمُ ، ثُمَّ سَلْ حَاجَتَک۔ (نسائی ۱۰۴۶۹)","Sahih","Musannaf Ibn Abi Shaybah 29931","","","كتاب الدعاء"
"29932","(۲۹۹۳۲) حَدَّثَنَا محمد بْنُ فُضَیْلٍ ، عَن لَیْثٍ ، عَن خَالِدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : دَخَلْت الْمَسْجِدَ وَأَنَا أَرَی أَنِّی قَدْ أَصْبَحْت وَإِذَا عَلَیَّ لَیْلٌ طَوِیلٌ ، وَإِذَا لَیْسَ فِیہِ أَحَدٌ غَیْرِی ، فَقُمْت فَسَمِعْت حَرَکَۃً خَلْفِی فَفَزِعْت ، فَقَالَ : أَیُّہَا الْمُمْتَلِئُ قَلْبُہُ فَرَقًا ، لاَ تَفْرَقْ ، أو لاَ تَفْزَعْ وَقُلِ : اللَّہُمَّ إنَّک مَلِیکٌ مُقْتَدِرٌ مَا تَشَائُ مِنْ أَمْرٍ یَکُونُ ، ثُمَّ سَلْ مَا بَدَا لَکَ ، قَالَ سَعِیدٌ : فَمَا سَأَلْت اللَّہَ شَیْئًا إِلاَّ اسْتَجَابَ لِی۔","","Musannaf Ibn Abi Shaybah 29932","","","كتاب الدعاء"
"29933","(۲۹۹۳۳) حَدَّثَنَا وَکِیعٌ ، عَن مَالِکِ بْنِ مِغْوَلٍ قَالَ : طَلَبْت الْحَکَمَ فِی حَاجَۃٍ فَلَمْ أَجِدْہُ ، ثُمَّ طَلَبْتہ فَوَجَدْتہ وقَالَ : الْحَکَمُ : قَالَ خَیْثَمَۃُ : إذَا طَلَبَ أَحَدُکُمَ الْحَاجَۃَ فَوَجَدَہَا فَلْیَسْأَلَ اللَّہَ الْجَنَّۃَ ، لَعَلَّہُ یَوْمُہُ الَّذِی یُسْتَجَابُ لَہُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 29933","","","كتاب الدعاء"
"29934","(۲۹۹۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَن سَعْدِ بْنِ إبْرَاہِیمَ قَالَ : کَانَ طَلْقُ بْنُ حَبِیبٍ یَقُولُ : اللَّہُمَّ أَبْرِمْ لِہَذِہِ الأُمَّۃِ أَمْرًا رَشِیدًا تُعِزُّ فِیہِ وَلِیَّک وَتُذِلُّ فیہ عَدُوَّک وَیُعْمَلُ فِیہِ بِطَاعَتِک۔","","Musannaf Ibn Abi Shaybah 29934","","","كتاب الدعاء"
"29935","(۲۹۹۳۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عُبَیْدِ بْنِ عَبْدِ الْمَلِکِ قَالَ : أَخْبَرَنِی مَنْ رَأَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ وَاقِفًا بِعَرَفَۃَ یَدْعُو وَہُوَ یَقُولُ بِإِصْبَعِہِ ہَکَذَا یُشِیرُ بِہَا : اللَّہُمَّ زِدْ مُحْسِنَ أُمَّۃِ مُحَمَّدٍ إحْسَانًا وَراجِعْ بِمُسِیئِہِمْ إِلَی التَّوْبَۃِ ، ثُمَّ یَقُولُ ہَکَذَا ، ثُمَّ یُدِیرُ بِإِصْبَعِہِ : وَحُطَّ مَنْ وَرَائَہُمْ بِرَحْمَتِک۔","","Musannaf Ibn Abi Shaybah 29935","","","كتاب الدعاء"
"29936","(۲۹۹۳۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَن عُبَیْدِ بْنِ عَبْدِ الْمَلِکِ قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَقُولُ اللَّہُمَّ أَصْلِحْ مَنْ کَانَ صَلاحُہُ صَلاحًا لأُمَّۃِ مُحَمَّدٍ ، اللَّہُمَّ وَأَہْلِکْ مَنْ کَانَ ہَلاکُہُ صَلاحًا لأُمَّۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29936","","","كتاب الدعاء"
"29937","(۲۹۹۳۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن حَجَّاجِ بْنِ دِینَارٍ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ أَبِی بَرْزَۃَ الأَسْلَمِیِّ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ إذَا أَرَادَ أَنْ یَقُومَ مِنَ الْمَجْلِسِ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ ، أَسْتَغْفِرُک وَأَتُوبُ إلَیْک۔ (ابویعلی ۷۳۸۹)","Sahih","Musannaf Ibn Abi Shaybah 29937","","","كتاب الدعاء"
"29938","(۲۹۹۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ قَالَ : مَنْ قَالَ حِینَ یَقُومُ مِنْ مَجْلِسِہِ سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ أَسْتَغْفِرُک وَأَتُوبُ إلَیْک قَالَ : کَفَّر اللَّہُ عَنہُ کُلَّ ذَنْبٍ فِی ذَلِکَ الْمَجْلِسِ۔","Sahih","Musannaf Ibn Abi Shaybah 29938","","","كتاب الدعاء"
"29939","(۲۹۹۳۹) حَدَّثَنَا جَرِیرٌ، عَن مَنْصُورٍ، عَن فُضَیْلِ بْنِ عَمْرٍو، عَن زِیَادِ بْنِ الْحُصَیْنِ قَالَ: دَخَلْتُ عَلَی أَبِی الْعَالِیَۃِ، فَلَمَّا أَرَدْت أَنْ أَخْرُجَ مِنْ عَندِہِ قَالَ : أَلا أُزَوِّدُک کَلِمَاتٍ عَلَّمَہُنَّ جِبْرِیلُ مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : قُلْتُ : بَلَی ؟ قَالَ : فَإِنَّہُ لَمَّا کَانَ بِآخِرَۃٍ کَانَ إذَا قَامَ مِنْ مَجْلِسِہِ قَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ أَنْتَ ، أَسْتَغْفِرُک وَأَتُوبُ إلَیْک ، قَالَ : فَقِیلَ : یَا رَسُولَ اللہِ ، مَا ہَؤُلائِ الْکَلِمَاتُ الَّتِی تَقُولُہُنَّ ؟ قَالَ : ہُنَّ کَلِمَاتٌ عَلَّمَنِیہِنَّ جِبْرِیلُ کَفَّارَاتٌ لِمَا یَکُونُ فِی الْمَجْلِسِ۔ (نسائی ۱۰۲۶۴)","","Musannaf Ibn Abi Shaybah 29939","","","كتاب الدعاء"
"29940","(۲۹۹۴۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ فِی قَوْلِہِ وَسَبِّحْ بِحَمْدِ رَبِّکَ حِینَ تَقُومُ قَالَ : إذَا قُمْت فَقُلْ : سُبْحَانَ اللہِ وَبِحَمْدِہِ۔","","Musannaf Ibn Abi Shaybah 29940","","","كتاب الدعاء"
"29941","(۲۹۹۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَن مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : کُنَّا نَعُدُ الأَوَّابَ الْحَفِیظَ ، إذَا قَامَ مِنْ مَجْلِسِہِ قَالَ : اللَّہُمَّ اغْفِرْ لِی مَا أَصَبْت فِی مَجْلِسِی ہَذَا۔","","Musannaf Ibn Abi Shaybah 29941","","","كتاب الدعاء"
"29942","(۲۹۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن حَبِیبٍ عَن یَحْیَی بْنِ جَعْدَۃَ قَالَ : کَفَّارَۃُ الْمَجْلِسِ سُبْحَانَک وَبِحَمْدِکَ أَسْتَغْفِرُک وَأَتُوبُ إلَیْک۔","","Musannaf Ibn Abi Shaybah 29942","","","كتاب الدعاء"
"29943","(۲۹۹۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَابْنُ نُمَیْرٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، قَالَ : سَمِعْتُ عَائِشَۃَ تَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ وَہُوَ مُسْتَنِدٌ إِلَی صَدْرِی : اللَّہُمَّ اغْفِرْ لِی وَارْحَمْنِی وَأَلْحِقْنِی بِالرَّفِیقِ۔ (بخاری ۴۴۴۰۔ مسلم ۸۵)","Sahih","Musannaf Ibn Abi Shaybah 29943","","","كتاب الدعاء"
"29944","(۲۹۹۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُکْثِرُ أَنْ یَقُولَ قَبْلَ أَنْ یَمُوتَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ أَسْتَغْفِرُک وَأَتُوبُ إلَیْک ، قَالَت : فَقُلْتُ : یَا رَسُولَ اللہِ ، مَا ہَذِہِ الْکَلِمَاتُ الَّتِی أَحْدَثْتہَا تَقُولُہَا ؟ قَالَ : جُعِلَتْ لِی عَلامَۃٌ لأُمَّتِی إذَا رَأَیْتہَا قُلْتہَا إذَا جَائَ نَصْرُ اللہِ وَالْفَتْحُ۔ (بخاری ۷۹۴۔ مسلم ۳۵۱)","Sahih","Musannaf Ibn Abi Shaybah 29944","","","كتاب الدعاء"
"29945","(۲۹۹۴۵) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍحَدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَن یَزِیدَ ، عَن مُوسَی بْنِ سَرْجِسَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَمُوتُ ، وَعَندَہُ قَدَحٌ فِیہِ مَائٌ فَیُدْخِلُ یَدَہُ فِی الْقَدَحِ ، وَیَمْسَحُ وَجْہَہُ بِالْمَائِ ، ثُمَّ یَقُولُ : اللَّہُمَّ أَعَنی عَلَی سَکَرَاتِ الْمَوْتِ۔\n(ترمذی ۹۷۸۔ احمد ۱۶۲۳)","Da'if","Musannaf Ibn Abi Shaybah 29945","","","كتاب الدعاء"
"29946","(۲۹۹۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَن مُسْلِمٍ، عَن مَسْرُوقٍ، عَنْ عَائِشَۃَ قَالَتْ: لَمَّا ثَقُلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: اللَّہُمَّ اغْفِرْ لِی، وَأَلْحِقْنِی بِالرَّفِیقِ، قَالَتْ: فَکَانَ ہَذَا آخِرَ مَا سَمِعْت مِنْ کَلامُہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29946","","","كتاب الدعاء"
"29947","(۲۹۹۴۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن مَالِکِ بْنِ أَنَسٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَن طَاوُوس ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا تَہَجَّدَ مِنَ اللَّیْلِ قَالَ : اللَّہُمَّ لَکَ الْحَمْدُ أَنْتَ نُورُ السَّمَاوَاتِ وَالأَرْضِ ، وَلَک الْحَمْدُ ، أَنْتَ قَیَّامُ السَّمَاوَاتِ وَالأَرْضِ ، وَلَک الْحَمْدُ أَنْتَ رَبُّ السَّمَاوَاتِ وَالأَرْضِ وَمَنْ فِیہِنَّ ، أَنْتَ الْحَقُّ وَقَوْلُک الْحَقُّ وَالْجَنَّۃُ حَقٌّ وَالنَّارُ حَقٌّ وَالسَّاعَۃُ حَقٌّ ، اللَّہُمَّ لَکَ أَسْلَمْت وَبِکَ آمَنْت وَعَلَیْک تَوَکَّلْت وَبِکَ خَاصَمْت وَإِلَیْک حَاکَمْت ، فَاغْفِرْ لِی مَا قَدَّمْت ، وَمَا أَخَّرْت ، وَمَا أَسْرَرْت ، وَمَا أَعْلَنْت ، وَمَا أَنْتَ أَعْلَمُ بِہِ مِنِّی ، أَنْتَ الْمُقَدِّمُ وَالْمُؤَخِّرُ لاَ إلَہَ إِلاَّ أَنْتَ۔ (بخاری ۱۱۲۰۔ مسلم ۵۳۴)","Sahih","Musannaf Ibn Abi Shaybah 29947","","","كتاب الدعاء"
"29948","(۲۹۹۴۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَن مُعَاوِیَۃَ بْنِ صَالِحٍ قَالَ : حدَّثَنِی أَزْہَرُ بْنُ سَعِیدٍ ، عَنْ عَاصِمِ بْنِ حُمَیْدٍ قَالَ : سَأَلْتُ عَائِشَۃَ : مَاذَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَفْتَتِحُ بِہِ قِیَامَ اللَّیْلِ ؟ قَالَتْ : لَقَدْ سَأَلْتنِی عَن شَیْئٍ مَا سَأَلَنِی عَنہُ أَحَدٌ قَبْلَک، کَانَ یُکَبِّرُ عَشْرًا وَیَحْمَدُ عَشْرًا وَیُسَبِّحُ عَشْرًا وَیَسْتَغْفِرُ عَشْرًا وَیَقُولُ: اللَّہُمَّ اغْفِرْ لِی وَاہْدِنِی وَارْزُقْنِی وَعَافِنِی وَیَتَعَوَّذُ مِنْ ضِیقِ الْمَقَامِ یَوْمَ الْقِیَامَۃِ۔(ابوداؤد ۷۶۲۔ ابن حبان ۲۶۰۲)","Hasan","Musannaf Ibn Abi Shaybah 29948","","","كتاب الدعاء"
"29949","(۲۹۹۴۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ قَالَ : کُنَّا مَعَ أَبِی مُوسَی ، فَجَنَّنََا اللَّیْلَ إِلَی بُسْتَانٍ خَرِبٍ ، قَالَ : فَقَامَ مِنَ اللَّیْلِ یُصَلِّی فَقَرَأَ قِرَائَۃً حَسَنَۃً ، ثُمَّ قَالَ : اللَّہُمَّ إنَّک مُؤْمِنٌ تُحِبُّ الْمُؤْمِنَ، وَمُہَیْمِنٌ تُحِبُّ الْمُہَیْمِنَ ، سَلامٌ تُحِبُّ السَّلامَ ، صَادِقٌ تُحِبُّ الصَّادِقَ۔","Sahih","Musannaf Ibn Abi Shaybah 29949","","","كتاب الدعاء"
"29950","(۲۹۹۵۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، حَدَّثَنَا شَیْبَانُ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ رَبِیعَۃَ بْنَ کَعْبٍ أَخْبَرَہُ ، أَنَّہُ کَانَ یَبِیتُ عِنْدَ بَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ یَسْمَعُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ اللَّیْلِ یَقُولُ : سُبْحَانَ اللہِ رَبِّ الْعَالَمِینَ الْہَوِیَّ ، ثُمَّ یَقُولُ : سُبْحَانَ اللہِ وَبِحَمْدِہِ۔\n(بخاری ۱۲۱۸۔ ترمذی ۳۴۱۶)","Hasan","Musannaf Ibn Abi Shaybah 29950","","","كتاب الدعاء"
"29951","(۲۹۹۵۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَن شُعْبَۃَ ، عَن ثَابِتٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو : اللَّہُمَّ آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 29951","","","كتاب الدعاء"
"29952","(۲۹۹۵۲) حَدَّثَنَا عَبِیدَۃُ بْنِ حُمَیْدٍ ، عَنْ أَنَسٍ قَالَ : دَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ کَأَنَّہُ فَرْخٌ مَنْتُوفٌ مِنَ الْجَہْدِ ، قَالَ : فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ کُنْت تَدْعُو اللَّہَ بِشَیْئٍ ؟ قَالَ : کُنْتُ أَقُولُ اللَّہُمَّ مَا کُنْت مُعَاقِبِی بِہِ فِی الآخِرَۃِ فَعَجِّلْہُ لِی فِی الدُّنْیَا ، فَقَالَ لَہُ : النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَلا قُلْتَ : اللَّہُمَّ آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ قَالَ : فَدَعَا اللَّہَ فَشَفَاہُ۔\n(بخاری ۷۲۸۔ مسلم ۲۰۶۸)","Sahih","Musannaf Ibn Abi Shaybah 29952","","","كتاب الدعاء"
"29953","(۲۹۹۵۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَن حَبِیبِ بْنِ صَہْبَانَ ، قَالَ : سَمِعْتُ عُمَرَ وَہُوَ یَطُوفُ حَوْلَ الْبَیْتِ وَلَیْسَ لَہُ ہِجِّیرًا إِلاَّ ہَؤُلائِ الْکَلِمَاتِ : { رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ}۔","","Musannaf Ibn Abi Shaybah 29953","","","كتاب الدعاء"
"29954","(۲۹۹۵۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ ، عَن حَبِیبِ بْنِ صَہْبَانَ ، عَن عُمَرَ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29954","","","كتاب الدعاء"
"29955","(۲۹۹۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عُبَیْدَۃَ ، قَالَ : حَدَّثَنِی أَبِی ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : أَتَتْ فَاطِمَۃُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَسْأَلُہُ خَادِمًا فَقَالَ لَہَا : مَا عِنْدِی مَا أُعْطِیک ، فَرَجَعَتْ فَأَتَاہَا بَعْدَ ذَلِکَ فَقَالَ : الَّذِی سَأَلْت أَحَبُّ إلَیْک أَمْ مَا ہُوَ خَیْرٌ مِنْہُ ، فَقَالَ : لَہَا عَلِیٌّ : قُولِی : لاَ ، بَلْ مَا ہُوَ خَیْرٌ مِنْہُ ، فَقَالَتْ فَقَالَ : قُولِی : اللَّہُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ وَرَبَّ الْعَرْشِ الْعَظِیمِ رَبَّنَا وَرَبَّ کُلِّ شَیْئٍ مُنْزِلَ التَّوْرَاۃِ وَالإِنْجِیلِ وَالْقُرْآنِ الْعَظِیمِ ، أَنْتَ الأَوَّلُ فَلَیْسَ قَبْلَک شَیْئٌ وَأَنْتَ الآخِرُ فَلَیْسَ بَعْدَکَ شَیْئٌ ، وَأَنْتَ الظَّاہِرُ فَلَیْسَ فَوْقَک شَیْئٌ وَأَنْتَ الْبَاطِنُ فَلَیْسَ دُونَک شَیْئٌ ، اقْضِ عَنَّا الدَّیْنَ وأَغْنِنَا مِنَ الْفَقْرِ۔ (مسلم ۶۳۔ ترمذی ۳۴۸۱)","Sahih","Musannaf Ibn Abi Shaybah 29955","","","كتاب الدعاء"
"29956","(۲۹۹۵۶) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، أَنَّ فَاطِمَۃَ اشْتَکَتْ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَہَا مِنَ الْعَجْنِ وَالرَّحَی ، قَالَ : فَقَدِمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بسَبْیٌ فَأَتَتْہُ تَسْأَلُہُ خَادِمًا فَلَمْ تَجِدْہُ ، وَوَجَدَتْ عَائِشَۃَ فَأَخْبَرَتْہَا ، قَالَ عَلِیٌّ : فَجَائَنَا بَعْدَ مَا أَخَذْنَا مَضَاجِعَنا فَذَہَبْنَا نقوم فَقَالَ : مَکَانَکُمَا ، قَالَ : فَجَائَ فَجَلَسَ بَیْنِی وَبَیْنَہَا حَتَّی وَجَدْت بَرْدَ قَدَمِہِ فَقَالَ : أَلا أَدُلُّکُمَا عَلَی مَا ہُوَ خَیْرٌ لَکُمَا مِنْ خَادِمٍ : تُسَبِّحَانِہِ ثَلاثًا وَثَلاثِینَ ، وَتَحْمَدَانِہِ ثَلاثًا وَثَلاثِینَ ، وَتُکَبِّرَانِہِ ثَلاثًا وَثَلاثِینَ۔ (بخاری ۲۰۲۳۔ مسلم ۲۰۹۱)","Sahih","Musannaf Ibn Abi Shaybah 29956","","","كتاب الدعاء"
"29957","(۲۹۹۵۷) حَدَّثَنَا عَفَّانُ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ أَخْبَرَنَا جَبْرُ بْنُ حَبِیبٍ عَن أُمِّ کُلْثُومٍ بِنْتِ أَبِی بَکْرٍ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَّمَہَا ہَذَا الدُّعَائَ اللَّہُمَّ إنِّی أَسْأَلُک مِنَ الْخَیْرِ کُلِّہِ عَاجِلِہِ وَآجِلِہِ ، مَا عَلِمْت مِنْہُ ، وَمَا لَمْ أَعْلَمْ ، وَأَعُوذُ بِکَ مِنَ الشَّرِّ کُلِّہِ ، مَا عَلِمْت مِنْہُ ، وَمَا لَمْ أَعْلَمْ ، اللَّہُمَّ إنِّی أَسْأَلُک مِنْ خَیْرِ مَا سَأَلَک عَبْدُک وَنَبِیُّک ، وَأَعُوذُ بِکَ مِنْ شَرِّ مَا عَاذَ مِنْہُ عَبْدُک وَنَبِیُّک ، اللَّہُمَّ إنِّی أَسْأَلُک الْجَنَّۃَ ، وَمَا قَرَّبَ إلَیْہَا مِنْ قَوْلٍ ، أَوْ عَمَلٍ ، وَأَعُوذُ بِکَ مِنَ النَّارِ ، وَمَا قَرَّبَ إلَیْہَا مِنْ قَوْلٍ ، أَوْ عَمَلٍ ، وَأَسْأَلُک أَنْ تَجْعَلَ کُلَّ قَضَائٍ تَقْضِیہِ لِی خَیْرًا۔ (احمد ۱۳۴۔ ابن حبان ۸۶۹)","Sahih","Musannaf Ibn Abi Shaybah 29957","","","كتاب الدعاء"
"29958","(۲۹۹۵۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَن شَرِیکٍ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ أَبِی مِجْلَزٍ ، عَن قَیْسِ بْنِ عُبَادٍ قَالَ : صَلَّی عَمَّارٌ صَلاۃً کَأَنَّہُمْ أَنْکَرُوہَا ، فَقِیلَ لَہُ فِی ذَلِکَ فَقَالَ : أَلَمْ أُتِمَّ الرُّکُوعَ وَالسُّجُودَ ؟ قَالُوا : بَلَی ، قَالَ : فَإِنِّی قَدْ دَعَوْت اللہ بِدُعَائٍ سَمِعْتہ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُمَّ بِعِلْمِکَ الْغَیْبَ وَقُدْرَتِکَ عَلَی الْخَلْقِ أَحْیِنِی مَا عَلِمْت الْحَیَاۃَ خَیْرًا لِی ، وَتَوَفَّنِی إذَا عَلِمْت الْوَفَاۃَ خَیْرًا لِی ، اللَّہُمَّ إنِّی أَسْأَلُک کَلِمَۃَ الإِخْلاصِ فِی الْغَضَبِ وَالرِّضَی ، وَالْقَصْدَ فِی الْغِنَی وَالْفَقْرِ ، وَخَشْیَتَکَ فِی الْغَیْبِ وَالشَّہَادَۃِ ، وَأَسْأَلُک الرِّضَا بِالْقُدْرَۃِ ، وَأَسْأَلُک نَعِیمًا لاَ یَنْفَدُ ، وَقُرَّۃَ عَیْنٍ لاَ تَنْقَطِعُ ، وَلَذَّۃَ الْعَیْشِ بَعْدَ الْمَوْتِ ، وَلَذَّۃَ النَّظَرِ إِلَی وَجْہِکَ ، وَشَوْقًا إِلَی لِقَائِکَ ، وَأَعُوذُ بِکَ مِنْ ضَرَّائَ مُضِرَّۃٍ ، وَفِتْنَۃٍ مُضِلَّۃٍ ، اللَّہُمَّ زَیِّنَّا بِزِینَۃِ الإِیمَانِ وَاجْعَلْنَا ہُدَاۃً مُہْتَدِینَ۔ (بزار ۱۳۹۲۔ طبرانی ۶۲۵)","Hasan","Musannaf Ibn Abi Shaybah 29958","","","كتاب الدعاء"
"29959","(۲۹۹۵۹) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَن حُمَیْدٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَتَمنَّ أَحَدُکُمَ الْمَوْتَ لِضُرٍّ نَزَلَ بِہِ فِی الدُّنْیَا وَلَکِنْ لِیَقُلِ : اللَّہُمَّ أَحْیِنِی مَا کَانَتِ الْحَیَاۃُ خَیْرًا لِی وَتَوَفَّنِی إذَا کَانَتِ الْوَفَاۃُ خَیْرًا لِی۔ (بخاری ۵۶۷۱۔ مسلم ۲۰۶۴)","Sahih","Musannaf Ibn Abi Shaybah 29959","","","كتاب الدعاء"
"29960","(۲۹۹۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن مَالِکِ بْنِ الْحَارِثِ قَالَ : کَانَ مِنْ دُعَائِ عَمَّارٍ اللَّہُمَّ إنِّی أَسْأَلُک بِعِلْمِکَ الْغَیْبَ وَقُدْرَتِکَ عَلَی الْخَلْقِ أَنْ تُحْیِیَنِی مَا عَلِمْت الْحَیَاۃَ خَیْرًا لِی وَتَوَفَّنِی مَا عَلِمْت الْوَفَاۃَ خَیْرًا لِی ، اللَّہُمَّ أَسْأَلُک خَشْیَتَکَ فِی الْغَیْبِ وَالشَّہَادَۃِ ، وَأَسْأَلُک الْقَصْدَ فِی الْغِنَی وَالْفَقْرِ ، وَأَسْأَلُک الْعَدْلَ فِی الرِّضَائِ وَالْغَضَبِ ، اللَّہُمَّ حَبِّبْ إلَیَّ لِقَائَک وَشَوْقًا إلَیْک فِی غَیْرِ فِتْنَۃٍ مُضِلَّۃٍ ، وَلا ضَرَّاء مَضَرَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 29960","","","كتاب الدعاء"
"29961","(۲۹۹۶۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَن عُمَرَ بْنِ رَاشِدٍ قَالَ : حدَّثَنَی إیَاسُ بْنُ سَلَمَۃَ بْنِ الأَکْوَعِ ، عَنْ أَبِیہِ قَالَ : مَا سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَفْتِحُ دُعَاء إِلاَّ یَسْتَفْتِحُہُ بِسُبْحَانَ رَبِّی الأَعْلَی الْعَلِیِّ الْوَہَّابِ۔ (احمد ۵۴)","Da'if","Musannaf Ibn Abi Shaybah 29961","","","كتاب الدعاء"
"29962","(۲۹۹۶۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ وَمَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن مُوسَی الْجُہَنِیِّ ، عَن مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ قَالَ : جَائَ أَعْرَابِیٌّ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، عَلِّمْنِی شَیْئًا أَقُولُہُ ، قَالَ : قُلْ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ لَہُ الْمُلْکُ اللَّہُ ، أَکْبَرُ کَبِیرًا ، وَالْحَمْدُ لِلَّہِ کَثِیرًا ، سُبْحَانَ اللہِ رَبِّ الْعَالَمِینَ ، لاَ حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ الْعَزِیزِ الْحَکِیمِ ، قَالَ : فَقَالَ الأَعْرَابِیُّ : ہَذَا لِرَبِّی فَمَا لِی ، قَالَ : قُلِ : اللَّہُمَّ اغْفِرْ لِی وَارْحَمْنِی وَاہْدِنِی وَارْزُقْنِی۔ (مسلم ۲۰۷۲۔ ابن حبان ۹۴۶)","Sahih","Musannaf Ibn Abi Shaybah 29962","","","كتاب الدعاء"
"29963","(۲۹۹۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن مِسْعَرٍ ، عَنْ أَبِی الَعَنَبَسِ ، عَنْ أَبِی الْعَدَبَّس ، عَنْ أَبِی مَرْزُوقٍ ، عَنْ أَبِی غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَکَأَنَّا اشْتَہَیْنَا أَنْ یَدْعُوَ لَنَا فَقَالَ : اللَّہُمَّ اغْفِرْ لَنَا وَارْحَمْنَا وَارْضَ عَنَّا وَتَقَبَّلْ مِنَّا وَأَدْخِلْنَا الْجَنَّۃَ وَنَجِّنَا مِنَ النَّارِ وَأَصْلِحْ لَنَا شَأْنَنَا کُلَّہُ ، فَکَأَنَّا اشْتَہَیْنَا أَنْ یَزِیدَنَا فَقَالَ : قَدْ جَمَعْت لَکُمُ الأَمْرَ۔ (احمد ۲۵۳)","Da'if","Musannaf Ibn Abi Shaybah 29963","","","كتاب الدعاء"
"29964","(۲۹۹۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ حَدَّثَنَا مَنْصُورُ بْنُ الْمُعْتَمِرِ قَالَ : حدَّثَنِی رِبْعِیُّ بْنُ حِرَاشٍ ، عَن عِمْرَانَ بْنِ حُصَیْنٍ ، أَنَّہُ قَالَ : جَائَ حُصَیْنٌ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَبْلَ أَنْ یُسْلِمَ فَقَالَ: یَا مُحَمَّدُ ، مَا تَأْمُرُنِی أَنْ أَقُولَ ؟ قَالَ : تَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ شَرِّ نَفْسِی ، وَأَسْأَلُک أَنْ تَعْزِمَ لِی عَلَی أَرْشَدِ أَمْرِی ، قَالَ : ثُمَّ إنَّ حُصَیْنًا أَسْلَمَ بَعْدُ ، ثُمَّ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إنِّی کُنْت سَأَلْتُک الْمَرَّۃَ الأُولَی ، وَإِنِّی الآنَ أَقُولُ : مَا تَأْمُرُنِی أَقُولُ ؟ قَالَ : قُلِ : اللَّہُمَّ اغْفِرْ لِی مَا أَسْرَرْت ، وَمَا أَعْلَنْت ، وَمَا أَخْطَأْت ، وَمَا تَعَمَّدْت ، وَمَا جَہِلْت ، وَمَا عَلِمْت۔ (ترمذی ۳۴۸۳۔ احمد ۴۴۴)","Sahih","Musannaf Ibn Abi Shaybah 29964","","","كتاب الدعاء"
"29965","(۲۹۹۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلائِ ، عَنْ أَبِی دَاوُدَ الأَوْدِیِّ ، عَن بُرَیْدَۃَ قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلا أُعَلِّمُک کَلِمَاتٍ مَنْ أَرَادَ اللَّہُ بِہِ خَیْرًا عَلَّمَہُ إیَّاہُنَّ ، ثُمَّ لَمْ یُنْسِہِ إیَّاہُنَّ أَبَدًا ، قَالَ: قُلِ : اللَّہُمَّ إنِّی ضَعِیفٌ فَقَوِّ فِی رِضَاک ضَعْفِی ، وَخُذْ إِلَی الْخَیْرِ بِنَاصِیَتِی ، وَاجْعَلِ الإِسْلامَ مُنْتَہَی رِضَائِی ، اللَّہُمَّ إنِّی ضَعِیفٌ فَقَوِّنِی ، وَذَلِیلٌ فَأَعِزَّنِی وَفَقِیرٌ فَارْزُقْنِی۔ (حاکم ۵۲۷)","Da'if","Musannaf Ibn Abi Shaybah 29965","","","كتاب الدعاء"
"29966","(۲۹۹۶۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍحَدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَن یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی الْخَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنْ أَبِی بَکْرٍ ، أَنَّہُ قَالَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلِّمْنِی دُعَائً أَدْعُو بِہِ ، قَالَ : قُلِ : اللَّہُمَّ إنِّی ظَلَمْت نَفْسِی ظُلْمًا کَثِیرًا ، وَلا یَغْفِرُ الذَّنْبَ إِلاَّ أَنْتَ فَاغْفِرْ لِی مَغْفِرَۃً مِنْ عَندِکَ وَارْحَمْنِی إنَّک أَنْتَ الْغَفُورُ الرَّحِیمُ۔ (بخاری ۸۳۴۔ مسلم ۲۰۷۸)","Sahih","Musannaf Ibn Abi Shaybah 29966","","","كتاب الدعاء"
"29967","(۲۹۹۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ قَالَ : قَالَ لِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلا أُعَلِّمُک کَلِمَاتٍ إذَا قُلْتہنَّ غُفِرَ لَکَ ، مَعَ أَنَّہُ مَغْفُورٌ لَکَ : لاَ إلَہَ إِلاَّ اللَّہُ الْحَلِیمُ الْکَرِیمُ لاَ إلَہَ إِلاَّ اللَّہُ الْعَلِیُّ الْعَظِیمُ سُبْحَانَ اللہِ رَبِّ السَّمَاوَاتِ السَّبْعِ وَرَبِّ الْعَرْشِ الْعَظِیمِ الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔ (ترمذی ۳۵۰۴۔ ابن حبان ۶۹۲۸)","Hasan","Musannaf Ibn Abi Shaybah 29967","","","كتاب الدعاء"
"29968","(۲۹۹۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْوَرْدِ بْنِ ثُمَامَۃَ ، عَنِ اللَّجْلاجِ ، عَن مُعَاذٍ قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ وَہُوَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک الصَّبْرَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَأَلْت اللَّہَ الْبَلائَ فَاسْأَلْہُ الْمُعَافَاۃَ ، وَمَرَّ عَلَی رَجُلٍ وَہُوَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک تَمَامَ النِّعْمَۃِ فَقَالَ : یَا ابْنَ آدَمَ ، وَہَلْ تَدْرِی مِنْ تَمَامِ النِّعْمَۃِ ؟ قَالَ : یَا رَسُولَ اللہِ ، دَعْوَۃٌ دَعَوْت بِہَا رَجَائَ الْخَیْرِ ، قَالَ : فَإِنَّ مِنْ تَمَامِ النِّعْمَۃِ دُخُولَ الْجَنَّۃِ والعوذ مِنَ النَّارِ ، وَمَرَّ عَلَی رَجُلٍ وَہُوَ یَقُولُ : یَا ذَا الْجَلالِ وَالإِکْرَامِ ، فَقَالَ : قَدِ اسْتُجِیبَ لَکَ فَاسْأَلْ۔ (احمد ۲۳۱)","Hasan","Musannaf Ibn Abi Shaybah 29968","","","كتاب الدعاء"
"29969","(۲۹۹۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ عَنِ الأعمش عَنِ یزید الرقاشی عَنِ أنس قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ألظوا بـ : یَا ذَا الْجَلالِ وَالإِکْرَامِ۔ (ترمذی ۳۵۲۴۔ احمد ۱۷۷)","Da'if","Musannaf Ibn Abi Shaybah 29969","","","كتاب الدعاء"
"29970","(۲۹۹۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عن إِسْحَاقُ بْنُ رَاشِدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ، أَنَّ عَبْدَ اللہِ بْنَ جَعْفَرٍ دَخَلَ عَلَی ابْنٍ لَہُ مَرِیضٍ یُقَالُ لَہُ صَالِحٌ ، فَقَالَ لَہُ : قُلْ لاَ إلَہَ إِلاَّ اللَّہُ الْحَلِیمُ الْکَرِیمُ ، سُبْحَانَ رَبِّ الْعَرْشِ الْعَظِیمِ ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ اللَّہُمَّ اغْفِرْ لِی ، اللَّہُمَّ ارْحَمْنِی ، اللَّہُمَّ تَجَاوَزْ عَنی ، اللَّہُمَّ اعْفُ عَنی فَإِنَّک عَفُوٌّ غَفُورٌ ، ثُمَّ قَالَ : ہَؤُلائِ الْکَلِمَاتُ عَلَّمَنِیہِنَّ عَمِّی ذَکَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَّمَہُنَّ إیَّاہُ۔ (نسائی ۱۰۴۷۷)","Sahih","Musannaf Ibn Abi Shaybah 29970","","","كتاب الدعاء"
"29971","(۲۹۹۷۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَن حَسَّانَ بْنِ عَطِیَّۃَ ، عَن شَدَّادِ بْنِ أَوْسٍ ، أَنَّہُ قَالَ : احْفَظُوا عَنی مَا أَقُولُ لَکُمْ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا کَنَزَ النَّاسُ الذَّہَبَ وَالْفِضَّۃَ فَاکْنِزُوا ہَذِہِ الْکَلِمَاتِ اللَّہُمَّ إنِّی أَسْأَلُک الثَّبَاتَ فِی الأَمْرِ ، وَالْعَزِیمَۃَ عَلَی الرُّشْدِ ، وَأَسْأَلُک شُکْرَ نِعْمَتِکَ ، وَأَسْأَلُک حُسْنَ عِبَادَتِکَ ، وَأَسْأَلُک قَلْبًا سَلِیمًا وَلِسَانًا صَادِقًا ، وَأَسْأَلُک مِنْ خَیْرِ مَا تَعْلَمُ ، وَأَعُوذُ بِکَ مِنْ شَرِّ مَا تَعْلَمُ ، وَأَسْتَغْفِرُک لِمَا تَعْلَمُ ، إنَّک أَنْتَ عَلاَّمُ الْغُیُوبِ۔ (احمد ۱۲۳۔ ابن حبان ۱۹۷۴)","","Musannaf Ibn Abi Shaybah 29971","","","كتاب الدعاء"
"29972","(۲۹۹۷۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ مُوسَی بْن عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ کَعْبٍ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُ أَصْحَابَہُ ، یَقُولُ : قُولُوا : اللَّہُمَّ اغْفِرْ لَنَا حَوْبَاتِنَا وَأَقِلْنَا عَثَرَاتِنَا وَاسْتُرْ عَوْرَاتِنَا۔","Da'if","Musannaf Ibn Abi Shaybah 29972","","","كتاب الدعاء"
"29973","(۲۹۹۷۳) حَدَّثَنَا وَکِیعٌ قَالَ حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَ رَجُلاً یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک بِأَنَّک أَنْتَ اللَّہُ ، الأَحَدُ الصَّمَدُ ، الَّذِی لَمْ یَلِدْ وَلَمْ یُولَدْ ، وَلَمْ یَکُنْ لَہُ کُفُوًا أَحَدٌ ، فَقَالَ : لَقَدْ سَأَلَ اللَّہَ بِاسْمِہِ الأَعْظَمِ ، الَّذِی إذَا دُعِیَ بِہِ أَجَابَ ، وَإِذَا سُئِلَ بِہِ أَعْطَی۔\n(ابوداؤد ۱۴۸۸۔ترمذی ۳۴۷۵)","Sahih","Musannaf Ibn Abi Shaybah 29973","","","كتاب الدعاء"
"29974","(۲۹۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خُزَیْمَۃَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ قَالَ : سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک بِأَنَّ لَکَ الْحَمْدَ لاَ إلَہَ إِلاَّ أَنْتَ وَحْدَک ، لاَ شَرِیکَ لَکَ ، الْمَنَّانُ بَدِیعُ السَّمَاوَاتِ وَالأَرْضِ ذُو الْجَلالِ وَالإِکْرَامِ ، فَقَالَ : لَقَدْ سَأَلَ اللَّہَ بِاسْمِہِ الأَعْظَمِ الَّذِی إذَا سُئِلَ بِہِ أَعْطَی وَإِذَا دُعِیَ بِہِ أَجَابَ۔ (ترمذی ۳۵۴۴۔ احمد ۲۶۵)","Hasan","Musannaf Ibn Abi Shaybah 29974","","","كتاب الدعاء"
"29975","(۲۹۹۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ ابْنِ سَابِطٍ ، أَنَّ دَاعِیًا دَعَا فِی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : اللَّہُمَّ إنِّی أَسْأَلُک بِاسْمِکَ اللہ الَّذِی لاَ إلَہَ إِلاَّ أَنْتَ الرَّحْمَن الرَّحِیمُ بَدِیعُ السَّمَاوَاتِ وَالأَرْضِ ، وَإِذَا أَرَدْت أَمْرًا فَإِنَّمَا تَقُولُ لَہُ : کُنْ ، فَیَکُونُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ کِدْت ، أَوْ کَادَ أَنْ یَدْعُوَ بِاسْمِہِ الْعَظِیمِ الأَعْظَمِ۔","","Musannaf Ibn Abi Shaybah 29975","","","كتاب الدعاء"
"29976","(۲۹۹۷۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَسْمَائَ بِنْتِ یَزِیدَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اسْمُ اللہِ الأَعْظَمُ فِی ہَاتَیْنِ الآیَتَیْنِ : {وَإِلَہُکُمْ إلَہٌ وَاحِدٌ لاَ إلَہَ إِلاَّ ہُوَ الرَّحْمَن الرَّحِیمُ} وَفَاتِحَۃِ سُورَۃِ آلِ عِمْرَانَ : {الم اللَّہُ لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ} ۔\n(ابوداؤد ۱۴۹۱۔ ترمذی ۳۴۷۸)","Da'if","Musannaf Ibn Abi Shaybah 29976","","","كتاب الدعاء"
"29977","(۲۹۹۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ قَالَ : قرَأَ رَجُلٌ الْبَقَرَۃَ وَآلَ عِمْرَانَ فَقَالَ کَعْبٌ : قَدْ قَرَأَ سُورَتَیْنِ إنَّ فِیہِمَا لِلاسْمِ الَّذِی إذَا دُعِیَ بِہِ اسْتَجَابَ۔","No Data Available","Musannaf Ibn Abi Shaybah 29977","","","كتاب الدعاء"
"29978","(۲۹۹۷۸) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، عَن سَعِیدِ بْنِ أَبِی أَیُّوبَ قَالَ : حدَّثَنَی الْحَسَنُ بْنُ ثَوْبَانَ ، عَن ہِشَامِ بْنِ أَبِی رُقْیَۃَ ، عَنْ أَبِی الدَّرْدَائِ ، وَابْنِ عَبَّاسٍ أَنَّہُمَا کَانَا یَقُولانِ : اسْمُ اللہِ الأَکْبَرُ رَبِّ رَبِّ۔","Hasan","Musannaf Ibn Abi Shaybah 29978","","","كتاب الدعاء"
"29979","(۲۹۹۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلالٍ ، عَن حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : اسْمُ اللہِ الأَعْظَمُ اللَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 29979","","","كتاب الدعاء"
"29980","(۲۹۹۸۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَن مِسْعَرٍ عَمَّنْ سَمِعَ الشَّعْبِیَّ یَقُولُ : اسْمُ اللہِ الأَعْظَمُ اللہ ، ثُمَّ قَرَأَ ، أَوْ قَرَأْت عَلَیْہِ ہُوَ اللَّہُ الْخَالِقُ إِلَی آخِرِہَا","","Musannaf Ibn Abi Shaybah 29980","","","كتاب الدعاء"
"29981","(۲۹۹۸۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَن حُمَیْدٍ ، عَنْ أَبِی الصِّدِّیقِ قَالَ : قَالَ أَبُو سَعِیدٍ : إذَا سَأَلْتُمُ اللَّہَ تعالی فَارْفَعُوا فِی الْمَسْأَلَۃِ ، فَإِنَّ مَا عِنْدَ اللہِ لَسْتُمْ مُنْفِدِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 29981","","","كتاب الدعاء"
"29982","(۲۹۹۸۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حَدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : إذَا تَمَنَّی أَحَدُکُمْ فَلْیُکْثِرْ فَإِنَّمَا یَسْأَلُ رَبَّہُ۔ (ابن حبان ۸۸۹۔ عبد بن حمید ۱۴۹۶)","Sahih","Musannaf Ibn Abi Shaybah 29982","","","كتاب الدعاء"
"29983","(۲۹۹۸۳) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رَجَائِ بْنِ حَیْوَۃَ ، عَنْ أَبِی الدَّرْدَائِ قَالَ : إیَّاکَ وَدَعْوَۃَ الْمَظْلُومِ فَإِنَّہَا تَصْعَدُ إِلَی السَّمَائِ کَشَرَارَاتِ نَارٍ حَتَّی تُفْتَحَ لَہَا أَبْوَابُ السَّمَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 29983","","","كتاب الدعاء"
"29984","(۲۹۹۸۴) حَدَّثَنَا وَکِیعٌ ، عَن زَکَرِیَّا بْنِ إِسْحَاقَ قَالَ : حدَّثَنَی یَحْیَی بْنُ عَبْدِ اللہِ بْنِ صَیْفِیٍّ ، عَنْ أَبِی مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَن مُعَاذِ بْنِ جَبَلٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إیَّاکَ وَدَعْوَۃَ الْمَظْلُومِ فَإِنَّہُ لَیْسَ بَیْنَہَا وَبَیْنَ اللہِ حِجَابٌ۔","Sahih","Musannaf Ibn Abi Shaybah 29984","","","كتاب الدعاء"
"29985","(۲۹۹۸۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن شَیْبَانَ ، عَن فِرَاسٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، رَفَعَہُ قَالَ : اجْتَنِبُوا دَعَوَاتِ الْمَظْلُومِ۔ (بخاری ۶۲۴۔ ابویعلی ۱۳۳۲)","Da'if","Musannaf Ibn Abi Shaybah 29985","","","كتاب الدعاء"
"29986","(۲۹۹۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَن مَعَن ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ قَالَ : أَرْبَعٌ لاَ یُحْجَبْنَ عَنِ اللہِ : دَعْوَۃُ وَالِدٍ رَاضٍ وَإِمَامٍ مُقْسِطٍ وَدَعْوَۃُ الْمَظْلُومِ وَدَعْوَۃُ رَجُلٍ دُعَائً لأَخِیہِ بِظَہْرِ الْغَیْبِ۔","","Musannaf Ibn Abi Shaybah 29986","","","كتاب الدعاء"
"29987","(۲۹۹۸۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ حَدَّثَنَا أَبُو مَعْشَرٍ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ۔ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : دَعْوَۃُ الْمَظْلُومِ مُسْتَجَابَۃٌ ، وَإِنْ کَانَ فَاجِرًا فَفُجُورُہُ عَلَی نَفْسِہِ۔\n(ابن حبان ۸۷۵۔ احمد ۳۶۷)","Da'if","Musannaf Ibn Abi Shaybah 29987","","","كتاب الدعاء"
"29988","(۲۹۹۸۸) حَدَّثَنَا شَرِیکٌ ، عَن سَالِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ الْحَبْنَائِ ، عَنْ عَلِیٍّ قَالَ : ثَلاثَۃٌ لاَ تُرَدُّ دَعْوَتُہُمْ : الإِمَامُ الْعَادِلُ عَلَی الرَّعِیَّۃِ ، وَالْوَالِدُ لِوَلَدِہِ ، وَالْمَظْلُومُ۔","Da'if","Musannaf Ibn Abi Shaybah 29988","","","كتاب الدعاء"
"29989","(۲۹۹۸۹) حَدَّثَنَا شَرِیکٌ، عَن بَیَانَ أَبِی بِشْرٍ، عَنْ عَبْدِالرَّحْمَنِ بْنِ ہِلالٍ، عَنْ أَبِی الدَّرْدَائِ قَالَ: إیَّاکَ وَدَعْوَۃَ الْمَظْلُومِ۔","Hasan","Musannaf Ibn Abi Shaybah 29989","","","كتاب الدعاء"
"29990","(۲۹۹۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، أَنَّ رَجُلاً أَتَی مُعَاذًا فَقَالَ : أَوْصِنِی ، فَقَالَ : إیَّاکَ وَدَعْوَۃَ الْمَظْلُومِ۔","Hasan","Musannaf Ibn Abi Shaybah 29990","","","كتاب الدعاء"
"29991","(۲۹۹۹۱) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَن یُونُسَ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ الأَزْدِیِّ قَالَ : حُدِّثْتُ أَنَّ دَاوُد عَلَیْہِ السَّلامُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ غِنًی یُطْغِی ، وَمِنْ فَقْرٍ یُنْسِی ، وَمِنْ ہَوًی یُرْدِی ، وَمِنْ عَمَلٍ یُخْزِی۔","","Musannaf Ibn Abi Shaybah 29991","","","كتاب الدعاء"
"29992","(۲۹۹۹۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَن مَنْصُورٍ ، عَنْ عَطَائِ بْنِ أَبِی مَرْزُوقٍ ، عَن کَعْبٍ قَالَ : کَانَ دَاوُد عَلَیْہِ السَّلامُ یَقُولُ : اللَّہُمَّ خَلِّصْنِی مِنْ کُلِّ مُصِیبَۃٍ نَزَلَت اللَّیْلَۃَ مِنَ السَّمَائِ فِی الأَرْضِ ثَلاثًا ، وَیَقُولُ : اللَّہُمَّ اجْعَلْ لِی سَہْمًا فِی کُلِّ حَسَنَۃٍ نَزَلَتِ اللَّیْلَۃَ مِنَ السَّمَائِ فِی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 29992","","","كتاب الدعاء"
"29993","(۲۹۹۹۳) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَن سُفْیَانَ ، عَنْ أَبِی مُصْعَبٍ وَہُوَ عَطَائٌ ، عَنْ أَبِیہِ ، عَن کَعْبٍ قَالَ : کَانَ إذَا أَفْطَرَ اسْتَقْبَلَ الْقِبْلَۃَ ، وَقَالَ : اللَّہُمَّ خَلِّصْنِی مِنْ کُلِّ مُصِیبَۃٍ اللَّیْلَۃَ نَزَلَت مِنَ السَّمَائِ ثَلاثًا ، وَإِذَا طَلَعَ حَاجِبُ الشَّمْسِ قَالَ : اللَّہُمَّ اجْعَلْ لِی سَہْمًا فِی کُلِّ حَسَنَۃٍ نَزَلَتِ اللَّیْلَۃَ مِنَ السَّمَائِ إِلَی الأَرْضِ ثَلاثًا ، قَالَ : فَقِیلَ لَہُ ، فقَالَ : دَعْوَۃُ دَاوُد فَلَیِّنُوا بِہَا أَلْسِنَتَکُمْ وَأَشْعِرُوہَا قُلُوبَکُمْ۔","","Musannaf Ibn Abi Shaybah 29993","","","كتاب الدعاء"
"29994","(۲۹۹۹۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، عَنْ عَبَّاسٍ الْعَمِّیِّ قَالَ : بَلَغَنِی أَنَّ دَاوُد النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی دُعَائِہِ سُبْحَانَک اللَّہُمَّ أَنْتَ رَبِّی ، تَعَالَیْت فَوْقَ عَرْشِکَ ، وَجَعَلْت عَلَی مَنْ فِی السَّمَاوَاتِ وَالأَرْضِ خَشْیَتَکَ ، فَأَقْرَبُ خَلْقِکَ مِنْک مَنْزِلَۃً أَشَدُّہُمْ لَکَ خَشْیَۃً ، وَمَا عِلْمُ مَنْ لَمْ یَخْشَک ، أَوْ مَا حِکمۃ مَنْ لَمْ یُطِعْ أَمْرَک۔ (دارمی ۴۶۰۲)","No Data Available","Musannaf Ibn Abi Shaybah 29994","","","كتاب الدعاء"
"29995","(۲۹۹۹۵) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ حَدَّثَنَا مُبَارَکٌ ، عَنِ الْحَسَنِ ، أَنَّ دَاوُد النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اللَّہُمَّ لاَ مَرَضَ یُضْنِینِی ، وَلا صِحَّۃَ تُنْسِینِی ، وَلَکِنْ بَیْنَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 29995","","","كتاب الدعاء"
"29996","(۲۹۹۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَن سَعِیدِ بْنِ أَبِی سَعِیدٍ قَالَ : کَانَ مِنْ دُعَائِ دَاوُد عَلَیْہِ السَّلامُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ جَارِ السُّوئِ۔","No Data Available","Musannaf Ibn Abi Shaybah 29996","","","كتاب الدعاء"
"29997","(۲۹۹۹۷) حَدَّثَنَا عَفَّانُ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ قَالَ: أَخْبَرَنَی حَبِیبُ بْنُ شَہِیدٍ، عَنِ ابْنِ بُرَیْدَۃَ، أَنَّ دَاوُد النَّبِیُّ علیہ السلام کَانَ یَقُولُ: اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنْ عَمَلٍ یُخْزِینِی ، وَہَوًی یُرْدِینِی ، وَفَقْرٍ یُنْسِینِی ، وَغِنًی یُطْغِی۔","","Musannaf Ibn Abi Shaybah 29997","","","كتاب الدعاء"
"29998","(۲۹۹۹۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن مُحَمَّدِ بْنِ عَجْلانَ ، عَن مُسْلِمِ بْنِ أَبِی مَرْیَمِ قَالَ : جَائَتْ أُمُّ ہَانِئٍ إِلَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَتْ: یَا رَسُولَ اللہِ، قَدْ کَبِرْت وَضَعُفْت فَعَلِّمْنِی عَمَلاً أَعْمَلُہُ، وَأَنَا جَالِسَۃٌ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّک إِنْ کَبَّرْت اللَّہَ مِئَۃ تَکْبِیرَۃٍ کَانَتْ خَیْرًا مِنْ مِئَۃ بَدَنَۃٍ مُجَلَّلَۃٍ مُتَقَبَّلَۃٍ ، وَإِنَّک إِنْ سَبَّحْت اللَّہَ مِئَۃ تَسْبِیحَۃٍ کَانَتْ خَیْرًا مِنْ مِئَۃ رَقَبَۃٍ تُعْتِقِینَہَا ، وَإِنَّک إِنْ حَمِدْت اللَّہَ مِئَۃ تَحْمِیدَۃٍ کَانَتْ خَیْرًا مِنْ مِئَۃ فَرَسٍ مُسَرَّجٍ مُلَجَّمٍ یحمل عَلَیْہِنَّ فِی سَبِیلِ اللہِ عَزَّ وَجَلَّ۔\n(نسائی ۱۰۶۸۰۔ ابن ماجہ ۳۸۱۰)","","Musannaf Ibn Abi Shaybah 29998","","","كتاب الدعاء"
"29999","(۲۹۹۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ قَالَ : حدَّثَنَی رَجُلٌ قِبَلَ الْجَمَاجِمِ مِنْ أَہْلِ الْمَسَاجِدِ قَالَ : أُخْبِرْت أَنَّ عِیسَی ابْنَ مَرْیَمَ عَلَیْہِ السَّلامُ کَانَ یَقُولُ : اللَّہُمَّ أَصْبَحْت لاَ أَمْلِکُ لِنَفْسِی مَا أَرْجُو، وَلا أَسْتَطِیعُ عنہا دَفْعَ مَا أَکْرَہُ ، وَأَصْبَحَ الْخَیْرُ بِیَدِ غَیْرِی، وَأَصْبَحْتُ مُرْتَہِنًا بِمَا کَسَبْت، فَلا فَقِیرَ أَفْقَرُ مِنِّی ، فَلا تَجْعَلْ مُصِیبَتِی فِی دِینِی ، وَلا تَجْعَلَ الدُّنْیَا أَکْبَرَ ہَمِّی ، وَلا تُسَلِّطْ عَلَیَّ مَنْ لاَ یَرْحَمُنِی۔","","Musannaf Ibn Abi Shaybah 29999","","","كتاب الدعاء"
"30000","(۳۰۰۰۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنِی إسْمَاعِیلُ قَالَ : ذُکِرَ عَن بَعْضِ الأَنْبِیَائِ ، أَنَّہُ قَالَ : اللَّہُمَّ لاَ تُکَلِّفْنِی طَلَبَ مَا لَمْ تُقَدِّرْہُ لِی ، وَمَا قَدَّرْت لِی مِنْ رِزْقٍ فَائْتِنِی بِہِ فِی یُسْرٍ مِنْک وَعَافِیَۃٍ ، وَأَصْلِحْنِی بِمَا أَصْلَحْت بِہِ الصَّالِحِینَ ، فَإِنَّمَا أَصْلَحَ الصَّالِحِینَ أَنْتَ۔","","Musannaf Ibn Abi Shaybah 30000","","","كتاب الدعاء"
"30001","(۳۰۰۰۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا الْجُرَیْرِیُّ ، عَنْ أَبِی الْعَلائِ بْنِ الشِّخِّیرِ ، أَنَّ نُوحًا وَمَنْ بَعْدَہُ کَانُوا یَتَعَوَّذُونَ مِنْ فِتْنَۃِ الدَّجَّالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 30001","","","كتاب الدعاء"
"30002","(۳۰۰۰۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَن سُحَیْمِ بْنِ نَوْفَلٍ قَالَ : بَیْنَمَا نَحْنُ عِنْدَ عَبْدِ اللہِ إذْ جَائَتْ وَلِیدَۃٌ أَعْرَابِیَّۃٌ إِلَی سَیِّدِہَا وَنَحْنُ نَعْرِضُ مُصْحَفًا ، فَقَالَتْ : مَا یجلسک وَقَدْ لَقَعَ فُلانٌ مُہْرَک بِعَیْنِہِ ، فَتَرَکَہُ یتقلب فِی الدَّارِ کَأَنَّہُ فِی قدر ، قُمْ فَابْتَغِ رَاقِیًا ، فَقَالَ عَبْدُ اللہِ : لاَ تَبْتَغِ رَاقِیًا وَانْفُثْ فِی مَنْخِرِہِ الأَیْمَن أَرْبَعًا ، وَفِی الأَیْسَرِ ثَلاثًا ، وَقُلْ : لاَ بَأْسَ ، لاَ بأس ، أَذْہِبَ الْبَأْسَ رَبَّ النَّاسِ ، اشْفِ أَنْتَ الشَّافِی ، لاَ یَکْشِفُ الضُّرَّ إِلاَّ أَنْتَ ، قَالَ : فَذَہَبَ ، ثُمَّ رَجَعَ إلَیْنَا ، قَالَ : قلت مَا أَمَرَتْنِی فَمَا جِئْت حَتَّی رَاثَ وَبَالَ وَأَکَلَ۔","Da'if","Musannaf Ibn Abi Shaybah 30002","","","كتاب الدعاء"
"30003","(۳۰۰۰۳) حَدَّثَنَا وَکِیعٌ، حَدَّثَنَا سُفْیَانُ قَالَ: حدَّثَنَی عَمْرُو بْنُ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ الْمُکْتِبِ ، عَن طَلِیقِ بْنِ قَیْسٍ الْحَنَفِیِّ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی دُعَائِہِ: رَبِّ أَعِنی، وَلا تَعُنْ عَلَی ، وَانْصُرْنِی ، وَلا تَنْصُرْ عَلَی وَامْکُرْ لِی ، وَلا تَمْکُرْ عَلَی ، وَاہْدِنِی وَیَسِّرَ الْہُدَی لِیْ وَانْصُرْنِی عَلَی مَنْ بَغَی عَلَی ، رَبِّ اجْعَلْنِی لَکَ شَکَّارًا لَکَ ذَکَّارًا لَکَ رَہَّابًا لَکَ مُطِیعًا ، إلَیْک مُخْبِتًا، إلَیْک أَوَّاہًا مُنِیبًا، رَبِّ تَقَبَّلْ تَوْبَتِی، وَاغْسِلْ حَوْبَتِی، وَأَجِبْ دَعْوَتِی، وَاہْدِ قَلْبِی، وَثَبِّتْ حُجَّتِی، وَسَدِّدْ لِسَانِی، وَاسْلُلْ سَخِیمَۃَ قَلْبِی۔ (ابوداؤد ۱۵۰۵۔ ترمذی ۳۵۵۱)","Sahih","Musannaf Ibn Abi Shaybah 30003","","","كتاب الدعاء"
"30004","(۳۰۰۰۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَبَّادِ بْنِ عَبَّادٍ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ أَبِی مُوسَی قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوَضُوئٍ فَتَوَضَّأَ وَصَلَّی ، ثُمَّ قَالَ : اللَّہُمَّ اغْفِرْ لِی ذَنْبِی وَوَسِّعْ لِی فِی دَارِی وَبَارِکْ لِی فِی رِزْقِی۔ (نسائی ۹۹۰۸۔ احمد ۳۷۵)","","Musannaf Ibn Abi Shaybah 30004","","","كتاب الدعاء"
"30005","(۳۰۰۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَن شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃٍ ، عَنْ أَبِی مُوسَی قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُو بِہَؤُلائِ الدَّعَوَاتِ : اللَّہُمَّ اغْفِرْ لِی خَطِیئَتِی وَجَہْلِی وَإِسْرَافِی فِی أَمْرِی ، وَمَا أَنْتَ أَعْلَمُ بِہِ مِنِّی ، اللَّہُمَّ اغْفِرْ لِی جَدِّی وَہَزْلِی وَخَطَئِی وَعَمْدِی ، وَکُلُّ ذَلِکَ عِنْدِی۔\n(بخاری ۶۳۹۸۔ احمد ۴۱۷)","Hasan","Musannaf Ibn Abi Shaybah 30005","","","كتاب الدعاء"
"30006","(۳۰۰۰۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ ثَابِتٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اللَّہُمَّ انْفَعَنی بِمَا عَلَّمْتنِی وَعَلِّمْنِی مَا یَنْفَعَنی وَزِدْنِی عِلْمًا ، وَالْحَمْدُ لِلَّہِ عَلَی کُلِّ حَالٍ ، وَأَعُوذُ بِاللہِ مِنْ عَذَابِ النَّارِ۔ (ترمذی ۳۵۹۹۔ ابن ماجہ ۲۵۱)","Da'if","Musannaf Ibn Abi Shaybah 30006","","","كتاب الدعاء"
"30007","(۳۰۰۰۷) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن سَعِیدٍ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلائِ ، عَن عُثْمَانَ بْنِ أَبِی الْعَاصِ وَامْرَأَۃٍ مِنْ قَیْسٍ أَنَّہُمَا سَمِعَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ أَحَدُہُمَا : سَمِعْتہ یَقُولُ : اللَّہُمَّ اغْفِرْ لِی ذَنْبِی وَخَطَایَایَ وَعَمْدِی ، وَقَالَ الآخَرُ : سَمِعْتہ یَقُولُ : اللَّہُمَّ إنِّی أَسْتَہْدِیک لأَرْشَدِ أَمْرِی ، وَأَعُوذُ بِکَ مِنْ شَرِّ نَفْسِی۔ (احمد ۲۱۔ ابن حبان ۹۰۱)","Sahih","Musannaf Ibn Abi Shaybah 30007","","","كتاب الدعاء"
"30008","(۳۰۰۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی رِشْدِینَ ، عَنِ ابْنِ عَبَّاسٍ، عَن جُوَیْرِیَۃَ قَالَتْ : مَرَّ بِہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاۃَ الْغَدَاۃِ ، أَوْ بَعْدَ مَا صَلَّی الْغَدَاۃَ ، وَہِیَ تَذْکُرُ اللَّہَ ، فَرَجَعَ حِینَ ارْتَفَعَ النَّہَارُ ، أَوْ قَالَ : انْتَصَفَ النَّہَارُ وَہِیَ کَذَلِکَ ، فَقَالَ : لَقَدْ قُلْتُ مُنْذُ قُمْتُ عَنْکِ أَرْبَعَ کَلِمَاتٍ ثَلاثَ مَرَّاتٍ ہِیَ أَکْثَرُ وَأَرْجَحُ ، أَوْ أَوْزَنُ مِمَّا قُلْتِ : سُبْحَانَ اللہِ عَدَدَ خَلْقِہِ ، سُبْحَانَ اللہِ رِضَا نَفْسِہِ ، سُبْحَانَ اللہِ زِنَۃَ عَرْشِہِ ، سُبْحَانَ اللہِ مِدَادَ کَلِمَاتِہِ۔ (مسلم ۷۹۔ ترمذی ۳۵۵۵)","Sahih","Musannaf Ibn Abi Shaybah 30008","","","كتاب الدعاء"
"30009","(۳۰۰۰۹) حَدَّثَنَا عَبِیدَۃ بْنُ حُمَیْدٍ ، عَن حُمَیْدٍ ، عَنِ الْحَسَنِ الْبَصْرِیِّ قَالَ : کَانَ یَقُولُ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدْعُو : اللَّہُمَّ اغْفِرْ لِی اللَّہُمَّ ارْحَمْنِی اللَّہُمَّ اہْدِنِی اللَّہُمَّ سَدِّدْنِی اللَّہُمَّ عَافِنِی اللَّہُمَّ ارْزُقْنِی۔","Hasan","Musannaf Ibn Abi Shaybah 30009","","","كتاب الدعاء"
"30010","(۳۰۰۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ حَدَّثَنَا مِسْعَرٌ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَن رَجُلٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اللَّہُمَّ ارْزُقْنَا مِنْ فَضْلِکَ ، وَلا تَحْرِمْنَا رِزْقَک ، وَبَارِکْ لَنَا فِیمَا رَزَقْتنَا ، وَاجْعَلْ رَغْبَتَنَا فِیمَا عِنْدَکََ ، وَاجْعَلْ غِنَانَا فِی أَنْفُسِنَا۔ (ابونعیم ۶۶)","Da'if","Musannaf Ibn Abi Shaybah 30010","","","كتاب الدعاء"
"30011","(۳۰۰۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی مُصْعَبٍ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ وَغَیْرِہِ ، قَالا : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اللَّہُمَّ أَقِلْنِی عَثْرَتِی ، وَاسْتُرْ عَوْرَتِی ، وَآمِنْ رَوْعَتِی ، وَاکْفِنِی مَنْ بَغَی عَلَیَّ وَانْصُرْنِی مِمَّنْ ظَلَمَنِی وَأَرِنِی ثَأْرِی فِیہِ۔","","Musannaf Ibn Abi Shaybah 30011","","","كتاب الدعاء"
"30012","(۳۰۰۱۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حَدَّثَنَا عَبْدُ اللہِ بْنُ عَامِرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُک بِأَنَّک الأَوَّلُ فَلا شَیْئَ قَبْلَک ، وَالآخِرُ فَلا شَیْئَ بَعْدَکَ وَالظَّاہِرُ فَلا شَیْئَ فَوْقَک ، وَالْبَاطِنُ فَلا شَیْئَ دُونَک أَنْ تَقْضِیَ عَنَّا الدَّیْنَ ، وَأَنْ تُغْنِیَنَا مِنَ الْفَقْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 30012","","","كتاب الدعاء"
"30013","(۳۰۰۱۳) حَدَّثَنَا عَفَّانُ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ أَخْبَرَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : اللَّہُمَّ أَعِنِّی عَلَی ذِکْرِکَ وَشُکْرِکَ وَحُسْنِ عِبَادَتِکَ ، وَأَعُوذُ بِکَ أَنْ یَغْلِبَنِی دَیْنٌ ، أَوْ عَدُوٌّ ، وَأَعُوذُ بِکَ مِنْ غَلَبَۃِ الرِّجَالِ۔ (ابوداؤد ۱۵۱۷۔ احمد ۲۴۴)","","Musannaf Ibn Abi Shaybah 30013","","","كتاب الدعاء"
"30014","(۳۰۰۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ قَالَ : جعلَنِی عَلِیٌّ خَلْفَہُ ، ثُمَّ سَارَ فِی جَانِبِ الْحَرَّۃِ ، ثُمَّ رَفَعَ رَأْسَہُ إِلَی السَّمَائِ فَقَالَ : اغْفِرْ لِی ذُنُوبِی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ أَحَدٌ غَیْرُک ، ??ُمَّ الْتَفَتَ إلَیَّ فَضَحِکَ ، قُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، اسْتِغْفَارُک رَبَّک ، وَالْتِفَاتُک إلَیَّ تَضْحَکُ ؟ قَالَ: حَمَلَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَلْفَہُ ، ثُمَّ سَارَ بِی إِلَی جَانِبِ الْحَرَّۃِ ، ثُمَّ رَفَعَ رَأْسَہُ إِلَی السَّمَائِ فَقَالَ : اللَّہُمَّ اغْفِرْ لِی ذُنُوبِی إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ أَحَدٌ غَیْرُک ، ثُمَّ الْتَفَتَ إلَیَّ فَضَحِکَ ، فَقُلْتُ : یَا رَسُولَ اللہِ ، اسْتِغْفَارُک رَبَّک وَالْتِفَاتُک إلَیَّ تَضْحَکُ ؟ قَالَ ضَحِکْت لِضَحِکِ رَبِّی لِعَجَبِہِ لِعَبْدِہِ ، أَنَّہُ یَعْلَمُ أَنَّہُ لاَ یَغْفِرُ الذُّنُوبَ أَحَدٌ غَیْرُہُ۔ (ابوداؤد ۲۵۹۵۔ ترمذی ۳۴۴۶)","Da'if","Musannaf Ibn Abi Shaybah 30014","","","كتاب الدعاء"
"30015","(۳۰۰۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ قَالَ: قَالَ عَبْدُ اللہِ: إذَا أَرَادَ أَحَدُکُمْ الْحَاجَۃَ فَلْیَقُلِ: اللَّہُمَّ إنِّی أَسْتَخِیرُک بِعِلْمِکَ وَأَسْتَقْدِرُک بِقُدْرَتِکَ وَأَسْأَلُک مِنْ فَضْلِکَ فَإِنَّک تَقْدِرُ ، وَلا أَقْدِرُ وَتَعْلَمُ ، وَلا أَعْلَمُ وَأَنْتَ عَلاَّمُ الْغُیُوبِ اللَّہُمَّ إِنْ کَانَ ہَذَا الأَمْرَ الَّذِی أَرَدْتہ خَیْرًا لِی فِی دِینِی وَمَعِیشَتِی وَخَیْرِ عَاقِبَتِی فَیَسِّرْہُ لِی وَبَارِکْ لِی فِیہِ، وَإِنْ کَانَ غَیْرُ ذَلِکَ خَیْرًا فَقَدِّرْ لِی الْخَیْرَ حَیْثُمَا کَانَ، ثُمَّ رَضِّنِی بِمَا قَضَیْت۔ (بزار ۱۵۸۳)","","Musannaf Ibn Abi Shaybah 30015","","","كتاب الدعاء"
"30016","(۳۰۰۱۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ : حدَّثَنَی عَبْدُ الرَّحْمَنِ بْنُ أَبِی الْمَوَّالِی ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ الْمُنْکَدِرِ یُحَدِّثُ عَبْدَ اللہِ بْنَ الْحَسَنِ ، عَنْ جَابِرٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا الاسْتِخَارَۃَ کَمَا یُعَلِّمُنَا السُّورَۃَ مِنَ الْقُرْآنِ ، قَالَ : إذَا ہَمَّ أَحَدُکُمْ بِأَمْرٍ فَلْیُصَلِّ رَکْعَتَیْنِ غَیْرَ الْفَرِیضَۃِ ثُمَّ یُسَمِّی الأَمْرَ وَیَقُولُ : اللَّہُمَّ إنِّی أَسْتَخِیرُک بِعِلْمِکَ ، وَأَسْتَقْدِرُک بِقُدْرَتِکَ ، وَأَسْأَلُک مِنْ فَضْلِکَ الْعَظِیمِ ، فَإِنَّک تَقْدِرُ ، وَلا أَقْدِرُ وَتَعْلَمُ ، وَلا أَعْلَمُ وَأَنْتَ عَلاَّمُ الْغُیُوبِ ، اللَّہُمَّ إِنْ کَانَ ہَذَا الأَمْرُ خَیْرًا لِی فِی دِینِی وَعَاقِبَۃِ أَمْرِی فَاقْدِرْہُ لِی ، وَیَسِّرْہُ لِی ، وَبَارِکْ لِی فِیہِ ، وَإِنْ کَانَ شَرًّا فِی دِینِی وَعَاقِبَۃِ أَمْرِی فَاصْرِفْہُ عَنی وَاصْرِفْنِی عَنہُ وَاقْدُرْ لِی الْخَیْرَ حَیْثُ کَانَ ، ثُمَّ رَضِّنِی بِہِ۔ (بخاری ۱۱۶۲۔ ابوداؤد ۱۵۳۳)","Sahih","Musannaf Ibn Abi Shaybah 30016","","","كتاب الدعاء"
"30017","(۳۰۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ ، عَن عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : إذَا أَرَادَ أَحَدُکُمُ الْحَاجَۃَ فَلْیَقُلِ اللَّہُمَّ إنِّی أَسْتَخِیرُک بِعِلْمِکَ وَأَسْتَقْدِرُک بِقُدْرَتِکَ وَأَسْأَلُک مِنْ فَضْلِکَ ، فَإِنَّک تَقْدِرُ ، وَلا أَقْدِرُ وَتَعْلَمُ ، وَلا أَعْلَمُ وَأَنْتَ عَلاَّمُ الْغُیُوبِ ، اللَّہُمَّ إِنْ کَانَ ہَذَا الأَمْر الَّذِی أَرَدْتہ خَیْرًا لِی فِی دِینِی وَمَعِیشَتِی وَخَیْرِ عَاقِبَۃٍ فَیَسِّرْہُ لِی وَبَارِکْ لِی فِیہِ ، وَإِنْ کَانَ غَیْرُ ذَلِکَ خَیْرًا فَقَدِّرْ لِی الْخَیْرَ حَیْثُ کَانَ وَرَضِّنِی بِہِ۔","","Musannaf Ibn Abi Shaybah 30017","","","كتاب الدعاء"
"30018","(۳۰۰۱۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَن خَالِدٍ ، عَنْ أَبِی قِلابَۃَ ، عَنِ ابْنِ مُحَیْرِیزٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا سَأَلْتُمَ اللَّہَ فَاسْأَلُوہُ بِبُطُونِ أَکُفِّکُمْ ، وَلا تَسْأَلُوہُ بِظُہُورِہَا۔","","Musannaf Ibn Abi Shaybah 30018","","","كتاب الدعاء"
"30019","(۳۰۰۱۹) حَدَّثَنَا حَفْصٌ ، عَن لَیْثٍ ، عَن شَہْرٍ قَالَ : الْمَسْأَلَۃُ ہَکَذَا وَبَسَطَ کَفَّہُ نَحْوَ وَجْہِہِ ، وَالتَّعَوُّذُ ہَکَذَا وَقَلَبَ کَفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 30019","","","كتاب الدعاء"
"30020","(۳۰۰۲۰) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی حَدَّثَنَا حَمَّادُ بْنُ سَلِمَۃَ حَدَّثَنَا بِشْرُ بْنُ حَرْبٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْعُو بِعَرَفَۃَ وَیَرْفَعُ یَدَیْہِ ہَکَذَا ، یَجْعَلُ ظَاہِرَہُمَا مِمَّا یَلِی وَجْہَہُ ، وَبَاطِنَہُمَا مِمَّا یَلِی الأَرْضَ۔ (احمد ۸۵۔ طیالسی ۲۱۷۴)","Da'if","Musannaf Ibn Abi Shaybah 30020","","","كتاب الدعاء"
"30021","(۳۰۰۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلانَ ، عَنِ الْعَبَّاسِ بْنِ ذُرَیْحٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الإِخْلاصُ ہَکَذَا وَأَشَارَ بِإِصْبَعِہِ ، وَالدُّعَائُ ہَکَذَا یَعْنِی یُشِیرُ بِبُطُونِ کَفَّیْہِ ، وَالاسْتِخَارَۃُ ہَکَذَا وَرَفَعَ یَدَیْہِ وَوَلَّی ظَہْرَہُمَا وَجْہَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 30021","","","كتاب الدعاء"
"30022","(۳۰۰۲۲) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا وُہَیْبٌ ، حَدَّثَنَا مُحَمَّدُ بْنُ عَجْلانَ ، عَن یَعْقُوبَ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، عَن سَعْدِ بْنِ مَالِکٍ ، عَن خَوْلَۃَ بِنْتِ حَکِیمٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لَوْ أَنَّ أَحَدَکُمْ إذَا نَزَلَ مَنْزِلاً قَالَ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ لَمْ یَضُرَّہُ فِی ذَلِکَ الْمَنْزِلِ شَیْئٌ حَتَّی یَرْتَحِلَ مِنْہُ۔ (مسلم ۲۰۸۰۔ احمد ۴۰۹)","Hasan","Musannaf Ibn Abi Shaybah 30022","","","كتاب الدعاء"
"30023","(۳۰۰۲۳) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ ، عَن شُعْبَۃَ ، عَن زِیَادِ بْنِ مِخْرَاقٍ ، قَالَ : سَمِعْتُ قَیْسَ بْنَ عَبَایَۃَ ، عَن مَوْلًی لِسَعْدٍ ، عَن سَعْدٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إِنَّہُ سَیَکُونُ قَوْمٌ یَعْتَدُونَ فِی الدُّعَائِ۔ (ابوداؤد ۱۴۷۵۔ احمد ۱۸۳)","Da'if","Musannaf Ibn Abi Shaybah 30023","","","كتاب الدعاء"
"30024","(۳۰۰۲۴) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ أَخْبَرَنَا سَعِیدٌ الْجُرَیْرِیُّ ، عَنْ أَبِی نَعَامَۃَ ، أَنَّ عَبْدَ اللہِ بْنَ مُغَفَّلٍ سَمِعَ ابْنَہُ یَقُولُ : اللَّہُمَّ إنِّی أَسْأَلُکَ الْقَصْرَ الأَبْیَضَ عَن یَمِینِ الْجَنَّۃِ إِذَا دَخَلْتہَا ، فَقَالَ : أَیْ بُنَی ، سَلِ اللَّہَ الْجَنَّۃَ وَعُذْ بِہِ مِنَ النَّارِ ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : سَیَکُونُ قَوْمٌ یَعْتَدُونَ فِی الدُّعَائِ۔ (ابوداؤد ۹۷۔ احمد ۵۵)","","Musannaf Ibn Abi Shaybah 30024","","","كتاب الدعاء"
"30025","(۳۰۰۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ أَقُولَ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ أَحَبُّ إلَیَّ مِمَّا طَلَعَتْ عَلَیْہِ الشَّمْسُ۔ (مسلم ۲۰۷۲۔ ترمذی ۳۵۹۷)","Sahih","Musannaf Ibn Abi Shaybah 30025","","","كتاب الدعاء"
"30026","(۳۰۰۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَلِمَتَانِ خَفِیفَتَانِ عَلَی اللِّسَانِ ثَقِیلَتَانِ فِی الْمِیزَانِ حَبِیبَتَانِ إِلَی الرَّحْمَن : سُبْحَانَ اللہِ وَبِحَمْدِہِ سُبْحَانَ اللہِ الْعَظِیمِ۔ (بخاری ۶۴۰۶۔ مسلم ۲۰۷۲)","Sahih","Musannaf Ibn Abi Shaybah 30026","","","كتاب الدعاء"
"30027","(۳۰۰۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ سَمِعْت ہَانِئَ بْنَ عُثْمَانَ یُحَدِّثُ ، عَن أُمِّہِ حُمَیْضَۃَ بِنْتَ یَاسِرٍ ، عَنْ جَدَّتِہَا یُسَیْرَۃَ ، وَکَانَتْ إحْدَی الْمُہَاجِرَاتِ ، قَالَتْ : قَالَ لہا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیْکُنَّ بِالتَّسْبِیحِ وَالتَّکْبِیرِ وَالتَّقْدِیسِ ، وَاعْقُدْنَ بِالأَنَامِلِ فَإِنَّہُنَّ یَأْتِینَ یَوْمَ الْقِیَامَۃِ مَسْئُولاتٍ مُسْتَنْطَقَاتٍ ، وَلا تَغْفُلْنَ فَتُنْسَیْنَ مِنَ الرَّحْمَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30027","","","كتاب الدعاء"
"30028","(۳۰۰۲۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن مُوسَی بْنِ سَالِمٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، أَوْ عَنْ أَخِیہِ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الَّذِینَ یَذْکُرُونَ مِنْ جَلالِ اللہِ من تَسْبِیحِہِ وَتَحْمِیدِہِ وَتَکْبِیرِہِ وَتَہْلِیلِہِ ، یَتَعَاطَفْنَ حَوْلَ الْعَرْشِ ، لَہُنَّ دَوِیٌّ کَدَوِیِّ النَّحْلِ ، یُذَکِّرُونَ بِصَاحِبِہِنَ ، أَوَ لاَ یُحِبُّ أَحَدُکُمْ أَنْ لاَ یَزَالَ عِنْدَ الرَّحْمَن شَیْئٌ یُذَکِّرُ بِہِ۔ (ابن ماجہ ۳۸۰۹۔ احمد ۲۷۱)","Sahih","Musannaf Ibn Abi Shaybah 30028","","","كتاب الدعاء"
"30029","(۳۰۰۲۹) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَن حَمَّادِ بْنِ سَلَمَۃَ ، عَن حَجَّاجٍ الصَّوَافِّ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ سُبْحَانَ اللہِ الْعَظِیمِ غُرِسَ لَہُ نَخْلَۃٌ ، أَوْ شَجَرَۃٌ فِی الْجَنَّۃِ۔\n(ترمذی ۳۴۶۴۔ ابن حبان ۸۲۶)","","Musannaf Ibn Abi Shaybah 30029","","","كتاب الدعاء"
"30030","(۳۰۰۳۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، أَخْبَرَنَا مَالِکُ بْنُ أَنَسٍ ، عَن سُمِیٍّ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَالَ فِی یَوْمٍ مِئَۃ مَرَّۃٍ سُبْحَانَ اللہِ وَبِحَمْدِہِ حُطَّتْ خَطَایَاہُ وَلَوْ کَانَتْ مِثْلَ زَبَدِ الْبَحْرِ۔ (بخاری ۶۴۰۵۔ مسلم ۲۰۷۱)","Sahih","Musannaf Ibn Abi Shaybah 30030","","","كتاب الدعاء"
"30031","(۳۰۰۳۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَن شُعْبَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی عَبْدِ اللہِ الْجَسْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلا أُخْبِرُک بِأَحَبِّ الْکَلامُ إِلَی اللہِ ؟ قُلْتُ : یَا رَسُولَ اللہِ أَخْبِرْنِی بِأَحَبِّ الْکَلامُ إِلَی اللہِ ، قَالَ : أَحَبَّ الْکَلامُ إِلَی اللہِ : سُبْحَانَ اللہِ وَبِحَمْدِہِ۔\n(مسلم ۲۰۹۳۔ ترمذی ۳۵۹۳)","Sahih","Musannaf Ibn Abi Shaybah 30031","","","كتاب الدعاء"
"30032","(۳۰۰۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ إبْرَاہِیمَ السَّکْسَکِیِّ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی أَوْفَی قَالَ : أَتَی رَجُلٌ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَذَکَرَ أَنَّہُ لاَ یَسْتَطِیعُ أَنْ یَأْخُذَ مِنَ الْقُرْآنِ ، وَسَأَلَہُ شَیْئًا یُجْزِئُ بِالْقُرْآنِ ، فَقَالَ لَہُ : قُلْ سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، وَلا حَوْلَ وَلا قُوَّۃَ إِلاَّ بِاللہِ۔\n(ابوداؤد ۸۲۸۔ احمد ۳۵۳)","Hasan","Musannaf Ibn Abi Shaybah 30032","","","كتاب الدعاء"
"30033","(۳۰۰۳۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، حَدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَن وَاصِلٍ ، عَن یَحْیَی بْنِ عُقَیْلٍ ، عَن یَحْیَی بْنِ یَعْمَُرَ ، عَنْ أَبِی الأَسْوَدِ الدُّؤَلِیِّ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : بکُلِّ تَسْبِیحَۃٍ صَدَقَۃٌ۔ \n(مسلم ۴۹۸۔ احمد ۱۶۸)","Sahih","Musannaf Ibn Abi Shaybah 30033","","","كتاب الدعاء"
"30034","(۳۰۰۳۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن ہِلالِ بْنِ یَِسَافٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : لأَنْ أَقُولَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِعَدَدِہَا دَنَانِیرَ۔","","Musannaf Ibn Abi Shaybah 30034","","","كتاب الدعاء"
"30035","(۳۰۰۳۵) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَبْدِ اللہِ بْنِ مَیْسَرَۃَ ، عَن ہِلالِ بْنِ یَِسَافٍ قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُسَبِّحَ تَسْبِیحَاتٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُنْفِقَ عَدَدَہُنَّ دَنَانِیرَ فِی سَبِیلِ اللہِ عز وجل۔","","Musannaf Ibn Abi Shaybah 30035","","","كتاب الدعاء"
"30036","(۳۰۰۳۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن طَلْقِ بْنِ حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : لأَنْ أَقُولَہَا یَعْنِی سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ أَحَبُّ إلَیَّ مِنْ أَنْ أَحْمِلَ عَلَی عِدَّتِہَا مِنْ خَیْلٍ بِأَرْسَانِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 30036","","","كتاب الدعاء"
"30037","(۳۰۰۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن مُصْعَبِ بْنِ سَعْدٍ قَالَ : إذَا قَالَ الْعَبْدُ سُبْحَانَ اللہِ ، قَالَتِ الْمَلائِکَۃُ : وَبِحَمْدِہِ ، فَإِذَا قَالَ : سُبْحَانَ اللہِ وَبِحَمْدِہِ ، صَلُّوْا عَلَیْہِ ، وَقَالَ أَبُو أُسَامَۃَ صَلَّتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 30037","","","كتاب الدعاء"
"30038","(۳۰۰۳۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن مُوسَی بْنِ عُبَیْدۃَ ، عَن زَیْدِ بْنِ أَسْلَمَ ، عْن جَابِرِ بْنِ عَبْدِ اللہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلا أُعَلِّمُکُمْ مَا عَلَّمَ نُوحٌ ابْنَہُ ؟ قَالُوا : بَلَی ، قَالَ : آمُرُک بِقَوْلِ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، فَإِنَّ السَّمَاوَاتِ لَوْ کَانَتْ فِی کِفَّۃٍ لَرَجَحَتْ بِہَا ، وَلَوْ کَانَتْ حَلْقَۃً قَصَمَتْہَا ، وَآمُرُک تُسَبِّحُ اللَّہَ وَتَحْمَدُہُ ، فَإِنَّہُ صَلاۃُ الْخَلْقِ وَتَسْبِیحُ الْخَلْقِ ، وَبِہَا یُرْزَقُ الْخَلْقُ۔ (بخاری ۵۴۸۔ احمد ۱۶۹)","Da'if","Musannaf Ibn Abi Shaybah 30038","","","كتاب الدعاء"
"30039","(۳۰۰۳۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَن عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : تَسْبِیحَۃٌ بِحَمْدِ اللہِ فِی صَحِیفَۃِ الْمُؤْمِنِ خَیْرٌ مِنْ أَنْ تَسِیلَ ، أَوْ تَسِیرَ مَعَہُ جِبَالُ الدُّنْیَا ذَہَبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 30039","","","كتاب الدعاء"
"30040","(۳۰۰۴۰) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، عَنْ أَبِی الأَحْوَصِ قَالَ : قَالَ سَمِعْتہ یَقُولُ : تَسْبِیحَۃٌ فِی طَلَبِ حَاجَۃٍ خَیْرٌ مِنْ لُقُوحِ صَفِیٍّ فِی عَامٍ أَزِبَۃً ، أَوْ لَزِبَۃٍ۔","","Musannaf Ibn Abi Shaybah 30040","","","كتاب الدعاء"
"30041","(۳۰۰۴۱) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عفاق ، عَنْ عَمْرِو بْنِ مَیْمُونٍ قَالَ : أَیَعْجَزُ أَحَدُکُمْ أَنْ یُسَبِّحَ مِئَۃ تَسْبِیحَۃٍ وَتَکُونَ لَہُ أَلْفُ تَسْبِیحَۃٍ۔","","Musannaf Ibn Abi Shaybah 30041","","","كتاب الدعاء"
"30042","(۳۰۰۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَن ثَابِتٍ الْبُنَانِیِّ قَالَ : حدَّثَنَی رَجُلٌ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِنْدَ ہَذِہِ السَّارِیَۃِ قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ وَبِحَمْدِہِ أَسْتَغْفِرُ اللَّہَ وَأَتُوبُ إلَیْہِ کُتِبَتْ لَہُ فِی رِقٍّ ، ثُمَّ طُبِعَ عَلَیْہَا خَاتَمٌ مِنْ مِسْکٍ فَلَمْ یُکْسَرْ حَتَّی یُوَافِیَ بِہَا یَوْمَ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 30042","","","كتاب الدعاء"
"30043","(۳۰۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَی ہِشَامُ أَبِی عَبْدِ اللہِ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی الدَّرْدَائِ قَالَ : لأَنْ أُسَبِّحَ مِئَۃ تَسْبِیحَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَتَصَدَّقَ بِمِئَۃِ دِینَارٍ عَلَی الْمَسَاکِینِ۔","","Musannaf Ibn Abi Shaybah 30043","","","كتاب الدعاء"
"30044","(۳۰۰۴۴) حَدَّثَنَا الْفَضْلُ بْنِ دُکَیْنٍ ، أَخْبَرَنَا سُفْیَانُ ، عَن شَبِیبِ بْنِ غَرْقَدَۃَ ، عَن مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِسَوْدَۃِ : سَبِّحِی اللَّہَ کُلَّ غَدَاۃٍ عَشْرًا وَکَبِّرِی عَشْرًا وَاحْمَدِی عَشْرًا وَقُولِی : اغْفِرْ لِی عَشْرًا ، فَإِنَّہُ یَقُولُ : قَدْ فَعَلْت قَدْ فَعَلْت۔","","Musannaf Ibn Abi Shaybah 30044","","","كتاب الدعاء"
"30045","(۳۰۰۴۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَن مُوسَی الْجُہَنِیِّ ، عَن مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ قَالَ : کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ لَنَا : أَیَعْجَزُ أَحَدُکُمْ أَنْ یَکْسِبَ فِی الْیَوْمِ أَلْفَ حَسَنَۃٍ ؟ فَسَأَلَہُ سَائِلٌ : کَیْفَ یَکْسِبُ أَحَدُنَا أَلْفَ حَسَنَۃٍ ، قَالَ : یُسَبِّحُ اللَّہَ مِئَۃ تَسْبِیحَۃٍ ، فتُکْتَبُ لَہُ أَلْفُ حَسَنَۃٍ ، أو تُحَطُّ عَنہُ أَلْفُ خَطِیئَۃٍ۔ (مسلم ۲۰۷۳۔ احمد ۱۸۰)","Sahih","Musannaf Ibn Abi Shaybah 30045","","","كتاب الدعاء"
"30046","(۳۰۰۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا الْجُرَیْرِیُّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَن کَعْبٍ قَالَ : إنَّ مِنْ خَیْرِ الْقِیلِ سُبْحَۃَ الْحَدِیثِ، قَالَ: قُلْتُ: یَا أَبَا عَبْدَ الرَّحْمَان، وَمَا سَبْحَۃُ الْحَدِیثِ، قَالَ: یُسَبِّحُ الرَّجُلُ، وَالْقَوْمُ یُحَدِّثُونَ۔","","Musannaf Ibn Abi Shaybah 30046","","","كتاب الدعاء"
"30047","(۳۰۰۴۷) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍحَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : کُنَّا عِنْدَ سَعْدِ بْنِ مَالِکٍ فَسَکَتَ سَکْتَۃً فَقَالَ : لَقَدْ أَصَبْت بِسَکْتَتِی ہَذِہِ مِثْلَ مَا سَقَی النِّیلُ وَالْفُرَاتُ ، قَالَ : قُلْنَا : وَمَا أَصَبْت ؟ قَالَ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","Da'if","Musannaf Ibn Abi Shaybah 30047","","","كتاب الدعاء"
"30048","(۳۰۰۴۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن مِسْعَرٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ قَالَ : إذَا قَالَ الْعَبْدُ : الْحَمْدُ لِلَّہِ کَثِیرًا ، قَالَ الْمَلَکُ : کَیْفَ أَکْتُبُ ؟ قَالَ : یقول : اکْتُبْ لَہُ رَحْمَتِی کَثِیرًا ، وَإِذَا قَالَ الْعَبْدُ : اللَّہُ أَکْبَرُ کَبِیرًا ، قَالَ الْمَلَکُ : کَیْفَ أَکْتُبُ ؟ قَالَ : اکْتُبْ رَحْمَتِی کَثِیرًا ، وَإِذَا قَالَ : سُبْحَانَ اللہِ کَثِیرًا ، قَالَ الْمَلَکُ : کَیْفَ أَکْتُبُ ؟ قَالَ : اکْتُبْ لہ رَحْمَتِی کَثِیرًا۔","Da'if","Musannaf Ibn Abi Shaybah 30048","","","كتاب الدعاء"
"30049","(۳۰۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَن شَرِیکٍ ، عَن یَعْلَی بْنِ عَطَائٍ ، عَنْ أَبِی یحنس ، عَنْ أَبِی الدَّرْدَائِ قَالَ : بَخٍ بَخٍ لِخَمْسٍ : سُبْحَانَ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلا إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ وَوَلَدٌ صَالِحٌ یَمُوتُ۔","Da'if","Musannaf Ibn Abi Shaybah 30049","","","كتاب الدعاء"
"30050","(۳۰۰۵۰) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی الزَّعْرَائِ الْجُشَمِیِّ ، عَنْ أَبِی الأَحْوَصِ قَالَ : کَانَ عَبْدُ اللہِ بْنُ مَسْعُودٍ یَقُولُ : سُبْحَانَ اللہِ عَدَدَ الْحَصَی۔","Sahih","Musannaf Ibn Abi Shaybah 30050","","","كتاب الدعاء"
"30051","(۳۰۰۵۱) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَن یُونُسَ بْنِ الْحَارِثِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : مَنْ قَالَ سُبْحَانَ اللہِ الْعَظِیمِ وَبِحَمْدِہِ غُرِسَ لَہُ بِہَا نَخْلَۃٌ فِی الْجَنَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 30051","","","كتاب الدعاء"
"30052","(۳۰۰۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن حُسَیْنِ بْنِ ذَکْوَانَ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَن بُشَیْرِ بْنِ کَعْبٍ ، عَن شَدَّادِ بْنِ أَوْسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَیِّدُ الاسْتِغْفَارِ أَنْ یَقُولَ : اللَّہُمَّ أَنْتَ رَبِّی وَأَنَا عَبْدُک لاَ إلَہَ إِلاَّ أَنْتَ خَلَقْتنِی وَأَنَا عَبْدُک أَصْبَحْت عَلَی عَہْدِکَ وَوَعْدِکَ مَا اسْتَطَعْت ، أَعُوذُ بِکَ مِنْ شَرِّ مَا صَنَعْت ، أَبُوئُ لَکَ بِنِعْمَتِکَ عَلَیَّ وَأَبُوئُ لَکَ بِذُنُوبِی فَاغْفِرْ لِی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 30052","","","كتاب الدعاء"
"30053","(۳۰۰۵۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ: حَدَّثَنِی کَثِیرُ بْنُ زَیْدٍ ، قَالَ: حدَّثَنِی الْمُغِیرَۃُ بْنُ سَعِیدٍ بْنُ نَوْفَلٍ، عَن شَدَّادِ بْنِ أَوْسٍ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ: أَلا أَدُلُّک عَلَی سَیِّدِ الاسْتِغْفَارِ؟ أَنْ تَقُولَ: اللہم أَنْتَ إلَہِی لاَ إلَہَ إِلاَّ أَنْتَ ، خَلَقْتنِی وَأَنَا عَبْدُک ، وَأَنَا عَلَی عَہْدِکَ وَوَعْدِکَ مَا اسْتَطَعْت، أَعُوذُ بِکَ مِنْ شَرِّ مَا صَنَعْت وَأَبُوئُ لَکَ بِنِعْمَتِکَ عَلَیَّ ، وَأَبُوئُ لَکَ بِذُنُوبِی فَاغْفِرْ لِی فَإِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ ، مَا مِنْ عَبْدٍ یَقُولُہَا فَیَأْتِیہِ قَدَرُہُ فِی یَوْمِہِ قَبْلَ یُمْسِیَ ، أَوْ فِی مَسَائِہِ قَبْلَ یُصْبِحَ ، إِلاَّ کَانَ مِنْ أَہْلِ الْجَنَّۃِ۔ (طبرانی ۷۱۸۹)","Da'if","Musannaf Ibn Abi Shaybah 30053","","","كتاب الدعاء"
"30054","(۳۰۰۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ الْمُغِیرَۃِ ، عَن حُذَیْفَۃَ ، قَالَ : شَکَوْت إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَرَبَ لِسَانِی فَقَالَ : أَیْنَ أَنْتَ مِنَ الاسْتِغْفَارِ ، إنِّی لأَسْتَغْفِرُ اللَّہَ فِی کُلِّ یَوْمٍ مِئَۃ مَرَّۃٍ۔\n(احمد ۳۹۴۔ دارمی ۲۷۲۳)","Da'if","Musannaf Ibn Abi Shaybah 30054","","","كتاب الدعاء"
"30055","(۳۰۰۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حَدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو حَدَّثَنَا أَبُو سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنِّی لاسْتَغْفِرُ اللَّہَ وَأَتُوبُ إلَیْہِ فِی الْیَوْمِ مِئَۃ مَرَّۃٍ۔ (ابن ماجہ ۳۸۱۵۔ نسائی ۱۰۲۶۸)","Hasan","Musannaf Ibn Abi Shaybah 30055","","","كتاب الدعاء"
"30056","(۳۰۰۵۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ حَدَّثَنَا نُمَیْرٍ مَالِکُ بْنُ مِغْوَلٍ ، عَن مُحَمَّدِ بْنِ سُوقَۃَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِنْ کُنَّا لَنَعُدُّ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَجْلِسِ یَقُولُ : رَبِّ اغْفِرْ لِی وَتُبْ عَلَیَّ إنَّک أَنْتَ التَّوَّابُ الْغَفُورُ مِئَۃ مَرَّۃٍ۔ (ابوداؤد ۱۵۱۱۔ احمد ۲۱)","Sahih","Musannaf Ibn Abi Shaybah 30056","","","كتاب الدعاء"
"30057","(۳۰۰۵۷) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : سَمِعْتُ الأَغَرَّ وَکَانَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحَدِّثُ ابْنَ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُوبُوا إِلَی رَبِّکُمْ فَإِنِّی أَتُوبُ إلَیْہِ فِی الْیَوْمِ مِئَۃ مَرَّۃٍ۔ (مسلم ۲۰۷۵۔ ابوداؤد ۱۵۱۰)","Sahih","Musannaf Ibn Abi Shaybah 30057","","","كتاب الدعاء"
"30058","(۳۰۰۵۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حَدَّثَنَا مُغِیرَۃُ بْنُ أَبِی الْحُرِّ ، عَن سَعِیدِ بْنِ بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ جُلُوسٌ فَقَالَ : مَا أَصْبَحْت غَدَاۃً إِلاَّ اسْتَغْفَرْت اللَّہَ فِیہَا مِئَۃ مَرَّۃٍ۔ (احمد ۴۱۰۔ ابن ماجہ ۳۸۱۶)","Sahih","Musannaf Ibn Abi Shaybah 30058","","","كتاب الدعاء"
"30059","(۳۰۰۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن کَہَمْسٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : کَانَ أَبُو الدَّرْدَائِ یَقُولُ : طُوبَی لِمَنْ وُجِدَ فِی صَحِیفَتِہِ نَبْذٌ مِنِ اسْتِغْفَارِ۔ (نسائی ۱۰۲۸۹)","Sahih","Musannaf Ibn Abi Shaybah 30059","","","كتاب الدعاء"
"30060","(۳۰۰۶۰) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا بُکَیْرُ بْنُ أَبِی السَّمیطِ ، حَدَّثَنَا مَنْصُورُ بْنُ زَاذَانَ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : مَنْ قَالَ أَسْتَغْفِرُ اللَّہَ الَّذِی لاَ إلَہَ إِلاَّ ہُوَ الْحَیُّ الْقَیُّومُ وَأَتُوبُ إلَیْہِ خَمْسَ مَرَّاتٍ غُفِرَ لَہُ ، وَإِنْ کَانَ عَلَیْہِ مِثْلُ زَبَدِ الْبَحْرِ۔","Hasan","Musannaf Ibn Abi Shaybah 30060","","","كتاب الدعاء"
