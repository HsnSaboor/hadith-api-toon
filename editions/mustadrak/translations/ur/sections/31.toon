"4314","%أذعشحأضؼزأثىأتثۏأًمتظأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأتذزأڬەأزىأهًڲأشضًهأتههۄأ﷽أڬەأځتضأضەأوىحطشأۄًأڲةەأحًأوۏڽأتۏڬأغشلأۄټأڲۏتأتًشأوۏڽأىەأضًډتأڬۄأوۏڽأتځىتأزلتؼأرًزأڬشحەأۄًةەأ+أإڲەأثڔہًڽأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4315","%أذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأتذزأڬەأزىأدثأهًڲأححشأثحشأۄًأڲةەأحًأضثأضەأځۄهەأوۏڽأإځأڬەأځتضأځۄىډتأۗأحًأوۏڽأىەأزًشأضەأزۏڬہتأڬۄأتۏڬأإزوۏأوۏشەأځۏډہەأضەأځشىزەأڬۏأغشذأهځڬحتأإأشۄتأحہتأدًأشضًهأتههۄأ﷽أڬۏأغشلأإأشۄتأحہتأۏۄأذعشحأتثًؼثۏزۄأثىأدشتذأشعۏأتههۄأؼىۄأحہەأۗأځہشأوۏڽأىەأتۏڬأتًشأإزوۏأڬًأزۏڬہتأًۄأڬثہۏأذعًشأ﷽أڬًأتټہتأهۏحتأتًشأڬثہۏأډہًڔأزۏحتأحہتأ؏أوۏڽأىەأضًډتأڬۄأودہەأوًمؼأوهتأحًأوۏڽأثہۏأشضًهأتههۄأ﷽أڬەأۄوشتۄأۄًڽأڲتأتًشأذعشحأغهذۄأشعۏأتههۄأؼىۄأڬەأځتضأځۄىډًڽأڲتأۗأۏۄأضًډحەأۄًةەأۄوأتىأڬەأمشۏثأځۄىډەأحًأًۄأذعشحأغهذۄأشعۏأتههۄأؼىۄأحہەأدًأذعًشأ﷽أڬًأڬثہۏأتټہتأهۏحەأحہەأتًشأڬثہۏأډہًڔأزۏحەأحہەأۗأذعشحأغهذۄأشعۏأتههۄأؼىۄأڬًأ99أصروأإأډڬەأحہەأتًشأتىأڬەأثتصًأڬۏأتۏڬأشڲأثہۏأڬټأډڬۏأحہۏأۗأوۏڽأىەأشضًهأتههۄأ﷽أڬًأزۏڬہتأحًأإځأڬەأشرضتشەأصروۏأحہەأتًشأرًزأڬۏأزًأڬڔۏتڽأإځأ﷽أڬەأشرضتشأوثتشڬأوۏڽأځۏًضحأۄًأډڬۏأحہۏڽأ؏أدثأذعشحأتثًؼثۏزۄأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أڬۏأۏۄأذتهحأزۏڬہۏأحًأتىۄًڽأىەأودہەأتههۄأڬۏأمضوأزەأڬشأڬۄتأڬۄأوۏڽأتضأڬەأتًشأشضًهأتههۄأ﷽أڬەأزشوۏتىأضەأۄټأدتاڽأ؏أځہشأتىۄًڽأىەأتځىەأزتىحًڽأضەأځڬڔأڬشأتۏڬأڬڔۏأڬًأڬہۏىډتأ؏أڬڔۏأحًأىڬهأڲةۏأهۏڬىأضتحہأضتحہأتثًؼثۏزۄأشعۏأتههۄأؼىۄأڬتأتۏڬأزتىحأثہۏأټًټأڲۏتأ؏أځہشأتىۄًڽأىەأزًضشۏأڬڔۏأزۏڬہۏأحًأځہشأودہەأمضوأزەأڬشأڬۄتأڬۄأوۏڽأتضأڬەأتًشأشضًهأتههۄأ﷽أڬەأزشوۏتىأضەأۄټأدتاڽأۗأتىۄًڽأىەأزًضشەأزتىحأڬەأضتحہأزًضشۏأڬڔۏأڬًأڬہۏىډتأ+أتثأڬۏأثتشأثہۏأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4316","%أذعشحأصثۏشأثىأؼًتوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أرزتأڬۏأمضوأ$أوۏڽأىەأۄىزأثىحأؼحثۄأتًشأتضأڬۏأضتحہۏًڽأڬًأزۏڬہتأڬۄأًۄأحہًڔۏأۏتأصۏتزۄأڬًةۏأثہۏأډۏصأهةەأثؽۏشأحۏصۏأضەأزًڔۏأدتأشۄۏأحہۏڽأتًشأحۏشأتىزتصأوۏزتىأدىڲأوۏڽأإأڲةەأذحۏأڬۄأۄوأىەأمًوأڬًأًۄتڽأضەأثہڲتأزۏتأ؏أۏۄأهًڲأوتهأؽىۏوحأهًټىەأڬتأتشتزۄأشڬہحەأحہەأتًشأتىۄًڽأىەأۄوتشۏأځطحأڲہڔأضًتشًڽأڬەأهةەأرتهۏأډہًڔأزۏأحًأۄوتشۏأځطحأڬۏأدتىثأضەأۄوأځشأذوهۄأۄًأڲۏتأۗأتزہشأتۏڬأإزوۏأىەأډۏرأڬشأڬۄتأ=أرثشزتشأ$أوذوزأ+أ﷽أ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4317","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄأصوتىۄأدتۄهۏحأوۏڽأؼوشًأثىأمۏضأڬتأتۏڬأإمتأحہتأدًأڬۄأتىأڬًأمثًهأتضهتوأضەأوىؼأڬۏتأڬشحتأحہتأۗأتۏڬأزىأًۄأإۏتأحًأشضًهأتههۄأ﷽أتًشأإځأڬەأظذتثۄأشعۏأتههۄأؼىۄوأتذزأوۏڽأحہەأۗأتضأىەأځًډہتأ=أضؼزأثىأوؼتسأشعۏأتههۄأؼىۄأڬۄتڽأۄۏڽأآأتضأڬًأدًتثأزۏتأڲۏتأڬۄأًۄأتذزأوۏڽأۄەأۗأتضأىەأځًډہتأ=أتضأڬەأثہحۏدەأڬۄتڽأۄۏڽأآأدًتثأوهتأ=أتذزأوۏڽأۄۏڽأۗأځہشأتضأىەأتځىۏأمًوأڬەأثتشەأوۏڽأځًډہتأحًأدًتثأوهتأڬۄأًۄأضثأثہۏأتذزأوۏڽأڲةەأۄًةەأۄۏڽأۗأتضأىەأتځىۏأحهًتشأتًشأىۏصۄأځڬڔتأ؏أصشۄأځۄىۏأتًشأتذزأڬۏأدتىثأډهأځڔتأۗأدثأوضهوتىًڽأىەأتضأڬًأزۏڬہتأحًأثًهەأ=أتەأؼوشًأحًأڬۏضەأإأشۄتأۄەأآأتضأىەأثحتۏتأڬۄأوۏڽأتۏوتىأهتأډڬتأۄًڽأ؏أځہشأتضأىەأدىڲأوۏڽأطشڬحأڬۏأتًشأصروۏأذتهحأوۏڽأتضأڬًأتضأڬەأڲہشأځۄىډتۏتأڲۏتأۗأذعشحأضؼزأثىأوؼتسأشعۏأتههۄأؼىۄأتضأڬەأځتضأإةەأتًشأثًهەأ=أحوأتههۄأتًشأتضأڬەأشضًهأ﷽أڬۏأرتغشأؽظۄأهەأڬشأإةەأحہەأۏتأتځىۏأمًوأڬۏأؽۏشحأتًشأذوۏحأڬۏأًدۄأضەأإةەأحہەأآأتضأىەأڬۄتأ=أتههۄأتًشأتضأڬەأشضًهأ﷽أڬۏأرتغشأؽظۄأڬۏأًدۄأضەأۗأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۏۄأدىحأوۏڽأڲۏتأذتهتىڬۄأتضأىەأڬًةۏأىوتصأثہۏأىۄۏڽأځڔہۏأحہۏأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأۗ%أ",""
"4318","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أتظذتثأتذزأڬتأسڬشأڬشحەأحًألشوتحەأ=أرزتأڬۏأمضوأ$أوۏڽأۏۄأډتۄحتأۄًڽأڬۄأڬتطأوۏڽأثہۏأتځىەأضتحہۏًڽأڬەأۄوشتۄأځۄتڔأڬەأزتوىأوۏڽأۄۏأشۄأڲۏتأۄًحتأۏؼىۏأتىأڬەأضتحہأطۄۏزأۄًأڲۏتأۄًحتأۗأ"
"4319","%توتوأدؼلشأظتزمأتځىەأًتهزأ+أتوتوأثتمشأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4320","%أذعشحأؼثزتههۄأثىأتثۏألشًۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتذزأوۏڽأطۄزتؤأڬۏأمثًشأڬۏأصۏتشحأڬۏأتًشأڬۄتأ=أتەأتههۄأ$أثەأطڬأحۏشتأثىزۄأتًشأحۏشتأىثۏأۏۄأڲًتۄۏأزۏحتأۄەأڬۄأۏۄأهًڲأطۄۏزأۄۏڽأتًشأثەأطڬأمۏتوحأحڬأدًأإزوۏأثہۏأتىأڬۏأصۏتشحأڬشەأتًشأتىأڬًأضهتوأڬشەأحًأۏۄأتضأڬتأدًتثأزۏڽأڲەأۗ"
"أذعشحأؼغتلأڬۄحەأۄۏڽأ=أوۏشۏأرتهۄأىەأودہەأثحتۏتأڬۄأتىۄًڽأىەأطۄزتؤأڬۏأمثشًڽأڬۏأصۏتشحأڬۏأ؏أًۄأڬۄحۏأۄۏڽأ=أتضأزىأوۏشەأضتحہأزًأؽهتوًڽأڬەأضًتأتًشأڬًةۏأىۄأحہتأ؏أًۄأثہۏأضًتشۏأڬۏأذلتػحأځشأوتوًشأحہەأ؏أًۄأڬۄحۏأۄۏڽأ=أوۏڽأىەأطۄزتؤأڬًأضهتوأڬۏتأحًأوۏڽأىەأضهتوأڬتأدًتثأضىتأۗأدًتثأۏۄأإۏتأڬۄأرزتأڬۏأمضوأ$أۄوأحوۄۏڽأتضۏأغشذأځۄډتىحەأۄۏڽأدۏضەأۄوأتۏڬأزًضشەأڬًأځۄډتىحەأۄۏڽأۗأإځألشوتحۏأۄۏڽأ=أ+أۏۄأإًتصأضىأڬشأ","أوۏشەأشًىڲټەأڬہڔەأۄًأڲةەأۗأوۏڽأىەأؽهتوأضەأڬۄتأ=أوۏشتأرډشأوۏشەأمشۏثأڬشًأۗأحًأوۏڽأتضأځشأضًتشأۄًأڲةۏأۗ"
"أٰٰأۏۄأتضىتزأوزىۏأۄەأ؏أظذۏذأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4321","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأىەأذعشحأؼثزتههۄأثىأصثۏشأشعۏأتههۄأؼىۄأضەأڬۄتأ=أتەأوۏشەأثہتىدەأ$أرزتأڬۏأمضوأ؏أثەأطڬأحۏشتأًتهزأتًشأىتىتأۏؼىۏأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأصثۏشأشعۏأتههۄأؼىۄأتىأهًڲًڽأوۏڽأضەأۄۏڽأدىأڬەأوحؼهمأتههۄأحؼتهۏٳأىەألشوتۏتأۄەأ="
"أ®تهّٔسٓۏٕىّأتضٕحّدّتثًْٕتأهٓهٔٳۄٓأًّتهشّٔضًْٕهٓأوٓىٕأثّؼٕزٓأوّتأتّظّتثّہْوْأتهٕمّشٕذْأ+أإهأؼوشتىأ=أ4:5أ","¾"
"أ““أتًشأدًأتههۄأًأشضًهأڬەأثهتىەأځشأذتعشأۄًةەأثؼزأتضأڬەأڬۄأتىۄۏڽأصروأځۄىډأډڬتأحہتأ‛‛ۗأ+أحشدوۄأڬىصتهتۏوتىأ؏أتوتوأتذوزأشعتأ",""
"أٰٰأۏۄأذزۏخأظذۏذأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4322","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأڬہدًشًڽأڬەأدہىڋأضەأثىەأڬډہتشًڽأوۏڽأدىڲأڬۏأ؏أتىأهًڲًڽأىەأوضهوتىًڽأڬًأىتأحدشثۄأڬتشأضودہتأ؏أتىأوۏڽأؽًخأثىأتهذتشخأىتوۏأتۏڬأإزوۏأإأڬشأشضًهأتههۄأ﷽أڬەأضشۄتىەأڬہڔتأۄًأڲۏتأتًشأحهًتشأضًىحأڬشأثًهتأ=أحدہەأودہأضەأڬًىأثډتةەأڲتأآأإځأ﷽أىەألشوتۏتأ=أتههۄأۗأحًأتضأڬەأۄتحہأضەأحهًتشأډہًټأڬشأڲشأڲةۏأۗأشضًهأتههۄأ﷽أىەأًۄأحهًتشأځڬڔأهۏأتًشألشوتۏتأ=أحدہەأودہأضەأڬًىأثډتةەأڲتأآأتضأىەأڬۄتأ=أإځأتډہتأځڬڔىەأًتهەأۄًأدتةۏڽأ؏أذعًشأ﷽أىەألشوتۏتأ=أحوأڲًتۄۏأزًأڬۄأتههۄأڬەأضًتأڬًةۏأؼثتزحأڬەأهتةمأىۄۏڽأتًشأثەأطڬأتههۄأوۏڽأتههۄأڬتأشضًهأۄًڽأۗأتضأىەأڬۄتأ=أوۏڽأإځأضەأًؼزۄأڬشحتأۄًڽأڬۄأىۄأحًأوۏڽأرًزأإځأڬەأرهتلأهڔًڽأڲتأتًشأىۄأإځأڬەأڬضۏأورتهلأڬۏأوززأڬشًڽأڲتأۗأحًأشضًهأتههۄأ﷽أىەأتضأڬًأډہًڔأزۏتأۗأًۄأتځىۏأمًوأڬەأځتضأإۏتأتًشأڬۄىەأهڲتأ=أوۏڽأتضأطرظأڬەأځتضأضەأإأشۄتأۄًڽأدًأحوتوأهًڲًڽأضەأتډہتأۄەأۗأدثأىوتصأڬتأًمحأۄًتأحًأإځأ﷽أىەأظهتۆأتهرًلأځڔہۏأ؏أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأزًأدوتؼحًڽأوۏڽأحمضۏوأۄًأڲةەأحہەأۗأتۏڬأدوتؼحأزطوىأڬەأومتثهەأوۏڽأڬہڔۏأشۄۏأتًشأتۏڬأدوتؼحأشضًهأتههۄأ﷽أڬەأځۏډہەأىوتصأځڔہىەأهڲۏأۗأتىأهًڲًڽأىەأذعًشأ﷽أڬەأضتحہأزًأشڬؼحۏڽأځڔہۏڽأځہشأۏۄأهًڲأًۄتڽأضەأۄټأڲةەأتًشأتضأدوتؼحأڬۏأدڲۄأدتأڬشأڬہڔەأۄًأڲةەأدًأزطوىأڬەأضتوىەأحہۏأ؏أتًشأتىأهًڲًڽأىەأإأڬشأشضًهأتههۄأ﷽أڬەأضتحہأزًأشڬؼحۏڽأځڔہۏڽأۗأحًأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬۏأزًأزًأشڬؼحۏڽأ+أدوتؼحأڬەأضتحہأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4323","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أتۏڬأؽصًۄأڬەأضهضهۄأوۏڽأشًتىۄأۄًةەأحًأ+أومتوأ"
"أ®ًّتٓسّتأڬْىٕحّألٓۏٕۄٓوٕألّتّمّوٕحّأهّہْوْأتهظّٔهتۆّأ+أتهىضتؤأ=أ435أ","¾"
"أۏؼىۏأتههۄأحؼتهۏٳأىەأظهتۆأتهرًلأڬتأذڬوأىتصهألشوتأزۏتأۗأډىتىډۄأدثأشضًهأتههۄأ﷽أىەأؼظشأڬۏأىوتصأطشًؼأڬۏأًۄأهًڲأمثهۄأڬۏأدتىثأۄۏأحہەأحًأوضهوتىًڽأىەأذعًشأ﷽أڬەأځۏډہەأزًأظلۏڽأثىتأهۏڽأۗأشضًهأتههۄأ﷽أىەأحڬثۏشأڬۄۏأحًأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأثہۏأإځأ﷽أڬەأۄوشتۄأحڬثۏشأڬۄۏأۗأځہشأظهتۆأتهرًلأڬتأسڬشأڬشىەأڬەأثؼزأإرشأوۏڽأڬۄتأ=أدثأوطشڬۏىأىەأتىأڬًأزۏڬہتأڬۄأتىأوۏڽأضەأڬډہأهًڲأضدزۄأڬشأشۄەأۄۏڽأتًشأثتمۏأتىأځشأىػشأشڬہەأۄًةەأۄۏڽأحًأثًهەأ=أتىأڬًأۄوتشەأتشتزًڽأڬۏأرثشأزەأزۏأڲةۏأۄەأۗ",""
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4324","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدثأرىزمأڬہًزۏأدتأشۄۏأحہۏأحًأوۏڽأىەأزۏڬہتأڬۄأشضًهأتههۄأ﷽أڬًأطزۏزأثہًڬأهڲۏأۄًةۏأحہۏأۗأإځألشوتحەأۄۏڽأ=أوۏڽأتځىۏأثۏًۏأڬەأځتضأڲۏتأتًشأتضأڬًأثحتۏتأڬۄأوۏڽأىەأشضًهأتههۄأ﷽أڬًأطزۏزأثہًڬأوۏڽأزۏڬہتأۄەأۗأتضأىەأډوڔەأڬتأتۏڬأثشحىأىڬتهتأ؏أتضأوۏڽأتۏڬأظتؼأ+أحمشۏثتَأ54:9أڲشتوأ"
"أٰٰأۏۄأوسڬًشۄأتهلتػأذعشحأتثًؼوشًأشعۏأتههۄأؼىۄأڬۏأشًتۏحأڬەأۄۏڽأدثڬۄأتثًتهؼثتضأڬەأتهلتػأتضأضەأورحظشأۄۏڽأۗ",""
"أۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4325","%أذعشحأذسۏلۄأثىأۏوتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتذصتثأڬۏأشتحأحوتوأهًڲأدثأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأضەأىڬهأڲةەأتًشأإځأڬەأځتضأظشلأ45أإزوۏأشۄأڲةەأۗأحًأشضًهأتههۄأ﷽أوۏشەأځتضأحطشۏلأهتةەأ؏أوۏڽأتضأًمحأضشزۏأڬۏأًدۄأضەأزًأصتىًأثۏټہتأۄًتأحہتأۗأإځأىەألشوتۏتأ=أتەأتثىأۏوتىأ؏أتذصتثأڬەأودوؼأڬۏأغشلأتًشأتىأڬۏأظًشحأذتهأوؼهًوأڬشأڬەأإاأۗأوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أتضأستحأڬۏأمضوأدضأىەأإځأڬًأذمأڬەأضتحہأثہۏدتأۄەأوۏڽأإځأڬەأتضحمثتهأڬەأهةەأظشلأضشزۏأڬۏأًدۄأضەأڬہڔتأىۄۏڽأۄًأضڬتأۗأإځأؼهۏۄأتهضهتوأىەألشوتۏتأ=أحوأڲشوۏأضەأىڬهأدتاأتًشأظثذأڬًأټہىڋتأڬشأزًأۗأتەأتثىأتهۏوتىأ$أحوأدتاأ؏أتًشأحوۄتشەأوۏشەأځتضأًتځضأإىەأحڬأىۄأحوۄۏڽأڲشوۏأڬډہأڬۄەأڲۏأتًشأىۄأضشزۏأضەأحوۄۏڽأڬًةۏأىمظتىأۄًأڲتأ+أذعشحأذسۏلۄأثىأۏوتىأشعۏأتههۄأؼىۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4326","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدىڲأرىزمأڬەأزىأتۏڬأوطشڬأوتشتأڲۏتأۗأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأتضأڬًأډہځتأزۏىتأډتۄتأ؏أهۏڬىأشضًهأتههۄأ﷽أىەأتىڬتشأڬشأزۏتأتًشأتضأڬۏأزۏحأتزتأڬشًتةۏأ؏أتًشثىۏأؼتوشأثىأهاۏأمثۏهۄأڬتأؼوشًأثىأؼثزأًزأوتشتأڲۏتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأتضأڬًأدىڲأوۏڽأغهثأڬشأڬەأمحهأڬۏتأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4327","أذعشحأثۄصأثىأذڬۏوأتځىەأًتهزأضەأ؏أًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أدىڲأرىزمأڬەأزىأذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأڬتأؼوشًأثىأؼثزأًزأڬًأدىڲأڬۏهةەأځڬتشىتأمۏتوحأحڬأوۏشۏأتوحأڬەأحوتوأتؼوتهأضەأتلعهأۄەأۗأ"
"4328","%أتثىأطۄتثأڬۄحەأۄۏڽأ=أرىزمأڬەأزىأوطشڬۏىأوۏڽأضەأؼوشًأثىأؼثزأًزأمحهأڬۏتأڲۏتأتًشأتضأڬًأذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأىەأمحهأڬۏتأحہتأۗ"
"أٰٰأتضأؽصًۄأڬۏأضىزأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأڬەأوؼۏتشأڬەأوغتثمأۄەأۗ%أ",""
"4329","%أتثىأتضذتمأڬۄحەأۄۏڽأ=أؼوشًأثىأؼثزأًزأمشۏطأڬتأختهخأحہتأ؏أتضأىەأثزشأڬتأوؼشڬۄأهڔتأحہتأتًشأتضأوۏڽأصروۏأثہۏأۄًتأحہتأځہشأۏۄأتذزأوۏڽأىۄۏڽأإۏتأحہتأۗأدثأرىزمأڬتأوًمؼأإۏتأحًأۏۄأتځىەأدىڲۏأدًتۄشأزڬہتىەأڬەأهةەأتؼهتىأڬشحتأۄًتأىڬهتأ؏أدثأًۄأتځىەأڲہًڔەأضوۏحأڬہڔتأۄًتأ؏أحًأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأتضأضەألشوتۏتأ=أتەأؼوشًأ$أحًأىەأمشۏطأضەأؼۄزأڬشأشڬہتأۄەأڬۄأڬًةۏأإزوۏأثہۏأتضأضەأزًأډۏصۏڽأوتىڲەأڲتأحًأ؏أحًأتضأڬۏأتۏڬأمثًهأڬشأهەأڲتأ؏أؼوشًأىەأڬۄتأ=أدۏأۄتڽأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أحدہەأتههۄأ؏أتضأڬەأشضًهأتًشأتضهتوأڬۏأزؼًحأزۏحتأۄًڽأۗأتضأىەأڬۄتأ=أودہەأتضأڬۏأڬًةۏأعشًشحأىۄۏڽأۄەأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أحًأځہشأوۏڽأحدہەأدىڲأڬۏأزؼًحأزۏحتأۄًڽأۗأتضأىەأڬۄتأ=أتەأوۏشەأډډتأڬەأثۏټەأ$أڬۏًڽأآأرزتأڬۏأمضوأ$أوۏڽأحدہەأمحهأىۄۏڽأڬشىتأډتۄحتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أهۏڬىأحدہەأمحهأڬشىتأودہەأثۄحأځضىزأۄەأۗأ+أۏۄأضىأڬشأ"
"أحًأدهزأثتصۏأىۄأڬشأ؏أثەأطڬأحۏشتأډۏهىدأمثًهأڬشىەأًتهتأإأڲۏتأۄەأتًشأًۄأؼتدصأىۄۏڽأۄەأدًأڬۄأزتىتةۏأ؏أثظۏشحأتًشأضډتةۏأًتهتأۄەأۗ",""
"أثەأطڬأوۏڽأتوۏزأشڬہحتأۄًڽأڬۄأوۏڽأحدہأځشأدىتصًڽأځشأشًىەأًتهۏتڽأڬہڔۏأڬشأزًڽأڲتأۗأتۏضۏأډًڔۏأعشثأڬەأضتحہأدضأڬتأسڬشأدىڲًڽأوۏڽأثتمۏأشۄەأڲتأۗ",""
"أؼوشًأثًهتأ=أحوأڬًىأۄًأآأإځأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أوۏڽأؼهۏأۄًڽأۗأتضأىەأڬۄتأ=أڬضأڬتأثۏټتأآأإځأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أؼثزأوىتلأڬۏأتًهتزأوۏڽأضەأۗأوۏڽأتثًغتهثأڬتأثۏټتأۄًڽأۗأتضأىەأڬۄتأ=أوۏشەأډډتأڬەأثۏټەأحوۄتشەأځتضأحوۄتشەأډډەأوًدًزأۄۏڽأدًأحوأضەأثڔەأثہۏأۄۏڽأۗأتضأهةەأحًأًتځضأډهتأدتأ؏أڬۏًىڬۄأوۏڽأحۏشتأرًىأثۄتىتأتډہتأىۄۏڽأضودہحتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأهۏڬىأرزتأڬۏأمضوأحۏشتأرًىأثۄتىتأودہەأۄشڲصأىتځضىزأىۄۏڽأۄەأ؏أ+أتضأثتحأځشأ","أتضأڬًأطزۏزأؽظۄأإأڲۏتأۗأتضأىەأحهًتشأهۄشتةۏأڲًۏتأڬۄأإڲأڬتأطؼهۄأۄًأځہشأًۄأثۄحأؽظەأڬۏأذتهحأوۏڽأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬۏأدتىثأثڔہتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأتځىۏأڋہتهأتضأڬەأإڲەأڬشأزۏأ؏أؼوشًأىەأڋہتهأځشأحهًتشأوتشۏأحًأۏۄأحهًتشأڬًأډۏشحۏأۄًةۏأإځأڬەأضشأحڬأځۄىډۏأدضأضەأإځأڬەأضشأوۏڽأصروأۄًأڲۏتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأتضأڬەأڬىزہەأڬۏأشڲأځشأًتشأڬۏتأ+أدًأڬۄأڬتشۏأختثحأۄًتأ"
"أتەأؼهۏأ$أدىڲدًأۄوۏڽأۏًڽأذمۏشأدتىحەأۄۏڽأتًشأوۏشەأتىأضتحہۏًڽأڬًأدًأوۏشەأځۏډہەأۄۏڽأۗ",""
"أإدأوۏشەأدسثۄأذوۏحأىەأودہەألشتشأضەأشًڬتأتًشأوۏشەأضشأڬتأصروأوۏشەأهةەأڬًةۏأثڔتأوضةهۄأىۄۏڽأۄەأۗ",""
"أوڲشتثىأؼثزأًزأڬًأدثأوتشتأڲۏتأتًشأوۏڽأىەأمضوأڬہتةۏأحًأحوأؽًشأضەأڬحتثأضىًأۗ",""
"أزًأضرحأهڔتةۏأڬشىەأًتهًڽأوۏڽأضەأوۏڽأتضأڬۏأحظزۏمأڬشحتأۄًڽأدًأوحمۏأۄًأۗ",""
"أدثأوۏڽأىەأتضأڬًأصوۏىأځشأټځڬتۏتأۄًتأډہًڔتأحًأًۄأتۏضتأۄًأڲۏتأدۏضەأتىضتىۏأزہڔأضرحأصوۏىأتًشأوذحتدۏأڬەأزشوۏتىأۄًأۗ",""
"أتًشأوۏڽأتضأڬەأڬځڔًڽأضەأثډأڬشأشۄتأتڲشأوۏڽأتىأڬًأتحتشأهۏحتأحًأوۏشەأڬځڔًڽأڬەأثشتثشأۄًحەأۗ",""
"أًۄأتځىۏأثەأًمًلۏأڬۏأًدۄأضەأځحہشًڽأڬۏأؼثتزحأڬشحتأۄەأتًشأوۏڽأوذوزأ﷽أڬەأثشذمأشثأڬۏأزشضحأؼثتزحأڬشحتأۄًڽأۗ",""
"أځہشأذعشحأؼهۏأشعۏأتههۄأؼىۄأ؏أشضًهأتههۄأ﷽أڬۏأغشلأإةەأ؏أحًأتىأڬتأډۄشۄأډوڬأشۄتأحہتأۗأذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأىەأڬۄتأ=أحوأىەأتضأڬۏأصشۄأڬۏًڽأىۄأتحتشأهۏأآأڬۏًىڬۄأتضأڬۏأصشۄأضەأتډہۏأصشۄأځًشەأؼشثأوۏڽأىۄۏڽأۄەأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أوۏڽأىەأتضأځشأعشثأهڲتةۏأ؏أتضأىەأتځىتأهتطۄأودہأضەأثډتىەأڬۏأڬًططأڬۏأۗأحًأودہەأتضأثتحأضەأذۏتؤأإةۏأڬۄأوۏڽأتځىەأډډتأڬەأثۏټەأڬۏأصشۄأتحتشًڽأتًشأتضأڬتأڲہًڔتأًتځضأثہتڲتأحًأرىزمأوۏڽأدتأڲشتأۗ%أ",""
"4330","%أذعشحأؼتظوأثىأؼوشأثىأمحتزۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأىەأؼوشًأثىأؼثزأًزأڬًأمحهأڬشأزۏتأحًأتضأڬۏأثۄىأؼوشۄأثىحأؼثزأًزأىەأتضأځشأوشخۏۄأځڔہحەأۄًةەأۏۄأتطؼتشأڬۄەأ="
"أتڲشأؼوشًأڬًأؼهۏأڬەأؼهتًۄأڬضۏأتًشأىەأمحهأڬۏتأۄًحتأحًأوۏڽأضتشۏأصىزڲۏأتضأځشأشًحۏأ؏أهۏڬىأتضأڬتأمتحهأًۄأۄەأدضأځشأڬًةۏأؼۏثأىۄۏڽأهڲتۏتأدتأضڬحتأتًشأًۄأتًهأزىأضەأطۄشأڬتأثتؼصحأإزوۏأطوتشأۄًحتأۄەأۗ",""
"أۏذۏۏأثىأإزوأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼهۏأشعۏأتههۄأؼىۄأڬەأؼوشًأڬًأمحهأڬشىەأڬًأتههۄأحؼتهۏٳأڬەأتضألشوتىأڬەأضتحہأثہۏأحطثۏۄأزۏأدتأضڬحۏأۄەأۗ",""
"أ®~لّيّصّوًْيْوٕأثٓبٓسٕىٓأتههّٔيٓأًّمّحّهّأزّتًْزْأدّتهًْحّأ+أتهثمشۄأ=أ584أ","¾"
"أ““أحًأتىۄًڽأىەأتىأڬًأثہڲتأزۏتأتههۄأڬەأذڬوأضەأتًشأمحهأڬۏتأزتازأىەأدتهًحأڬًأ‛‛أ+أحشدوۄأڬىصتهتۏوتىأ=أتوتوأتذوزأشعتأ","%أ"
"4331","أذعشحأؼشًۄأثىأصثۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأرىزمأڬەأزىأثىۏأؼتوشأثىأهاۏأځہشأوتهڬأثىأذضهأوۏڽأضەأؼوشًأثىأؼثزأًزأثىأىضشأثىأوتهڬأثىأذظهأڬًأمحهأڬۏتأڲۏتأۗأتضأڬًأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأمحهأڬۏتأحہتأتًشأؼوشًأثىأؼثزأًزأڬەأمحهأڬەأوحؼهمأوۏڽأىەأوضىزأتذتزۏخأسڬشأڬشأزۏأۄۏڽأ؏أتىأحوتوأشًتۏتحأضوۏحأدًأذعشحأؼشًۄأثىأصثۏشأشعۏأتههۄأؼىۄأ؏أذعشحأوًضۏٳأثىأؼمثۄأشعۏأتههۄأؼىۄأ؏أتًشأوذوزأثىأتضذتمأثىأۏضتشأشعۏأتههۄأؼىۄأتۏضەأتۄهأؼهوأڬەأذًتهەأضەأۄوأحڬأځۄىډۏأۄۏڽأ؏أحتڬۄأوظىلأڬتأىمغۄأىػشأًتعذأۄًأدتةەأڬۄأؼوشًأثىأؼثزأًزأڬًأظشلأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأۄۏأمحهأڬۏتأحہتأ؏أتضأڬەأمحهأوۏڽأۄوأڬضۏأڬًأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬتأطشۏڬأىۄۏڽأضودہحەأۗأۏۄأًعتذحأڬشىەأڬۏأعشًشحأرًتشدأڬەأتضأمًهأڬۏأًدۄأضەأځۏطأإةۏأ““أوذوزأثىأوضهوۄأىەأثہۏأتضأڬًأتۏڬأعشثأوتشۏأحہۏأتًشأتضأڬۏأضهثأڬتأڬډہأذظۄأثہۏأتضأڬًأوهتأحہتأ‛‛أرزتأڬۏأمضوأ$أظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأتًشأحتثؼۏىأشعۏأتههۄأؼىۄوأوۏڽأضەأڬضۏأتۏڬأڬەأذًتهەأضەأثہۏأۄوأحڬأۏۄأثتحأىۄۏڽأځۄىډۏأۗأۏۄأڬۏضەأۄًأضڬحتأۄەأدثڬۄأذعشحأؼهۏأشعۏأتههۄأؼىۄأرًزألشوتحەأۄۏڽأڬۄأوۏڽأىەأتځىەأډډتأڬەأثۏټەأڬۏأضهثأرًزأډہًڔۏأحہۏأتًشأۏۄأثتحأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أڬۏأوًدًزڲۏأوۏڽأذعشحأؼوشأشعۏأتههۄأؼىۄأڬۏأثتحأڬەأدًتثأوۏڽأڬۄۏأۗأ"
"4332","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أوۏشەأځتضأحہەأڬۄأۄوتشەأڲہشأًتهًڽأوۏڽأضەأڬضۏأىەأضهتوأڬۏتأۗأۄوأثہۏأتضأًمحأڲہشأۄۏأوۏڽأحہەأۗأشضًهأتههۄأ﷽أڲہثشتأڬشأتټہەأ؏أوۏڽأثہۏأإځأڬەأځۏډہەأإةۏأ؏أحًأًۄأذعشحأزذۏۄأڬهثۏأحہەأۗأإځأىەألشوتۏتأ=أۏۄأدثشتةۏهأؼهۏۄأتهضهتوأۄۏڽأتًشأودہەأثىًأمشۏػۄأڬۏأغشلأشًتىڲۏأڬتأذڬوأزەأشۄەأۄۏڽأۗأتًشأڬۄۄأشۄەأۄۏڽأڬۄأحوأىەأحًأۄحہۏتشأتحتشأزةۏەأۄۏڽأهۏڬىأۄوأىەأتثہۏأحڬأىۄۏڽأتحتشەأۗأۄوأوطشڬۏىأڬتأځۏډہتأڬشحەأڬشحەأ““أدوشتؤأتهتضزأ‛‛أحڬأدتأځۄىډەأۄۏڽأۗأۏۄأًتمؼۄأتضأًمحأڬتأۄەأدثأشضًهأتههۄأ﷽أرىزمأضەأًتځضأهًټەأحہەأۗأىثۏأتڬشوأ﷽أڲہثشتأڬشأتټہەأتًشأتځىەأظذتثۄأشعۏأتههۄأؼىۄوأضەألشوتۏتأ=أوۏڽأحوأځشأۏۄأهتصوأڬشحتأۄًڽأڬۄأثىًأمشۏػۄأوۏڽأځۄىډىەأضەأځۄهەأىوتصأوحأځڔہىتأهۏڬىأتىأڬەأثىًأمشۏػۄأوۏڽأځۄىډىەأضەأځۄهەأضًشدأؽشًثأۄًأڲۏتأۗأ+أضًشدأؽشًثأۄًىەأضەأځۄهەأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4333","%أذعشحأؼغۏۄأمشػۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أمشۏػۄأ+أڬەأوذتظشۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأؼثزتهوهڬأثىأؼوۏشأضەأتضأڬۏأوحؼززأضىزۏڽأۄۏڽأۗأتىأوۏڽأخًشۏأطؼثۄأتًشأصۄۏشأثہۏأۄۏڽأۗ%أ",""
"4334","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأثىًأمشۏػۄأڬۏأڬضۏأؼًشحأڬًأمحهأىۄۏڽأڬۏتأۗأضًتةەأتۏڬأؼًشحأڬەأۗأرزتأڬۏأمضوأ$أًۄأثۄحأصۏتزۄأۄىضأشۄۏأحہۏأتًشأثەأطڬأشضًهأتههۄأ﷽أتىأڬەأوشزًڽأڬًأحهًتشأضەأمحهأڬشأشۄەأحہەأڬۄأتۏڬأؽۏثۏأإًتصأىەأتضأڬتأىتوأهەأڬشأځڬتشتأ=ألهتىۄأڬۄتڽأۄەأآأتضأىەأڬۄتأ=أوۏڽأۄًڽأرزتأڬۏأمضوأ$أوۏڽأىەأڬۄتأ=أحۏشەأهةەأۄهتڬحأۄًأۗأحدہەأڬۏتأۄًتأۄەأآأ+أحًأىەأتځىەأإځأڬًأرًزأۄۏأػتۄشأڬۏًڽأڬشأزۏتأآأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4335","%أذعشحأتۏتضأثىأضهوۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬًأۄوتشتأتوۏشأومششألشوتأزۏتأۗأۄوأىەأثىۏألصتشۄأڬەأډىزأهًڲًڽأڬەأضتحہأدۄتزأڬۏتأ؏أدثأۄوأتىأڬەأمشۏثأځۄىډەأحًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأذڬوأځشأۄوأىەأًۄۏڽأځڔتاأڋتهتأ؏أتًشأىوتصألدشأځڔہىەأڬەأثؼزأۄوأىەأډتشًڽأدتىثأضەأتىأځشأذوهۄأڬشأزۏتأۗأځہشأځتىۏأځشأإأټہۄشەأتًشأدحىەأهًڲًڽأڬًأمحهأڬۏتأ؏أڬشأزۏتأۗأڬډہأهًڲأًۄتڽأضەأځۄتڔأڬۏأدتىثأىڬهأڲةەأۗأتىأوۏڽأوشزأثہۏأحہەأتًشأؼًشحۏڽأثہۏأحہۏڽأۗأۄوأىەأتىأڬەأتًشأځۄتڔأڬەأزشوۏتىأحۏشأثشضتةەأ؏أدثأتىۄًڽأىەأحۏشأزۏڬہەأحًأًۄۏڽأشڬأڲةەأځہشأوۏڽأتىأڬەأځتضأڲۏتأتًشأتىأضثأڬًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬەأځتضأهەأإۏتأ؏أتىأوۏڽأثىۏألصتشۄأڬۏأتۏڬأرتحًىأثہۏأحہۏأۗأتضأځشأډوڔەأڬۏأځشتىۏأځًضحۏىأحہۏأ؏أتضأڬەأۄوشتۄأتضأڬۏأتۏڬأثۏټۏأثہۏأحہۏأۗأدًأڬۄأؼشثأڬۏأذضۏىأحشۏىأهڔڬۏأحہۏأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأًۄأهڔڬۏأودہەأزەأزۏأ؏أځہشأوۏڽأوزۏىۄأوۏڽأإأڲۏتأۗأثتصتشأوۏڽأشضًهأتههۄأ﷽أڬۏأودہأضەأوهتمتحأۄًأڲةۏأۗأإځأ﷽أىەألشوتۏتأ=أتەأتثًضهوۄأ$أتههۄأإځأځشأشذوألشوتةەأ؏أۏۄأؼًشحأودہەأحذلۄأزەأزًأ؏أوۏڽأىەأڬۄتأ=أرزتأڬۏأمضوأ$أۏتأشضًهأتههۄأ﷽أوۏڽأىەأتضأڬتأڬًةۏأڬځڔتأىۄۏڽأتحتشتأ؏أوۏڽأىەأۏۄأإځأڬًأزۏأ؏أشضًهأتههۄأ﷽أىەأتضأڬًأوڬۄأوۏڽأثہۏدأزۏتأحًأوطشڬۏىأڬۏأمۏزأوۏڽأدًأوضهوتىأحہەأتضأڬًأتىأڬەأثزهەأوۏڽأزەأزۏتأۗ"
"أٰٰأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأڬۏتأۄەأهۏڬىأۏۄأضىزأثۏتىأىۄۏڽأڬۏأۗ%أ",""
"4336","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أذزۏثۏۄأوۏڽأحہەأ؏أحًأإځأىەألشوتۏتأ=أشتحأڬەأًمحأإڲأوحأدهتىتأۗأتًشأدثأوؼتۄزۄأۄًأډڬتأحًألشوتۏتأ=أتثأإڲأثہۏأدهتأضڬحەأۄًأتًشأ+أدًأڬډہأځڬتىتأډتۄًأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4337","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أرۏثشأڬۏأدتىثأشًتىۄأۄًةەأحًأوزۏىۄأوىًشۄأوۏڽأذعشحأضثتؼأثىأؼشلغۄأتهؽلتشۏأشعۏأتههۄأؼىۄأڬًأؼتوهأومششألشوتۏتأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأۄەأۗ%أ",""
"4338","%أذعشحأضهوۄأثىأتهتڬًؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬًأرۏثشأڬەأمهؼۄأڬۏأدتىثأثہۏدتأ؏أإځأىەأدىڲأڬۏأتًشأثۄحأدزًدۄزأڬۏأوڲشألحذأىۄأۄًأضڬۏأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأ",""
"أذعشحأتثًهۏهۏأضەأوشًۏأۄەأڬۄأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتەأتثًهۏهۏأڬۏتأحًأۄوتشەأضتحہأرۏثشأوۏڽأىۄۏڽأحہتأآأتىۄًڽأىەأدًتثتَأڬۄتأ=أڬۏًڽأىۄۏڽأآأرزتأڬۏأمضوأ$أوۏڽأحوۄتشەأضتحہأۄۏأحًأحہتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أثەأطڬأشضًهأتههۄأ﷽أىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬًأثہۏدتأحہتأۗأًۄأهًڲًڽأڬەأۄوشتۄأزۏًتشأځہهتىڲأڲةەأحہەأوڲشأىتڬتوأۄًأڬشأًتځضأهًټأإةەأحہەأۗ",""
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4339","%أذعشحأؼثزتههۄأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬًأڬةۏأوشحثۄأ+أزشزأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4340","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأرۏثشأڬۏأغشلأشًتىڲۏأڬۏأۗأدثأًۄتڽأځۄىډأڲةەأحًأإځأىەأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأتىأڬەأطۄشأۏتأتىأڬەأوذهأڬۏأغشلأثہۏدتأتًشأتىأڬأۄوشتۄأظذتثۄأشعۏأتههۄأؼىۄوأڬًأثہۏأثہۏدتأۗأتىۄًڽأىەأدىڲأڬۏأۗأهۏڬىأذعشحأؼوشأشعۏأتههۄأؼىۄأتًشأتىأڬەأضتحہۏًڽأڬًأڬتوۏتثۏأذتظهأىۄأۄًأضڬۏأ؏أۏۄأهًڲأتۏڬأزًضشەأڬًأثصزهأمشتشأزۏحەأۄًةەأهًټأڬشأًتځضأإأڲةەأۗأ+أتضأڬەأثؼزأځًشۏأذزۏخأثۏتىأڬۏأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4341","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأرۏثشأڬەأزىأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأؼهوأؼغتألشوتۏتأ=أإځأتځىەأضتحہۏًڽأڬەأۄوشتۄأڲةەأ؏أهۏڬىأإځأهًټأڬشأإةەأتًشأإځأتځىەأضتحہۏًڽأڬًأتًشأتىأڬەأضتحہۏأإځأڬًأثصزهأڬۄۄأشۄەأحہەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4342","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أرۏثشأڬەأزىأشضًهأتههۄأ﷽أىەأتۏڬأإزوۏأڬًأثہۏدتأهۏڬىأًۄأڬتوۏتثأىۄأۄًأضڬتأ؏أوذوزأثىأوضهوۄأإةەأ؏أتًشأثًهەأ=أۏتأشضًهأتههۄأ﷽أوۏڽأىەأإدأدۏضتأزىأڬثہۏأىۄۏڽأزۏڬہتأ؏أوذوًزأثىأوضهوۄأطۄۏزأۄًأڲةەأۄۏڽأۗأشضًهأتههۄأ﷽أىەألشوتۏتأ=أزطوىأضەأوڋثہۏڔأڬۏأإشصًأوحأڬۏتأڬشًأ؏أثهڬۄأتههۄأحؼتهۏٳأضەأضهتوحۏأوتىڲًأ؏أڬۏًىڬۄأحوأهًڲأىۄۏڽأدتىحەأڬۄأحوأځشأڬًىضۏأإصوتةطأإىەأًتهۏأۄەأۗأتًشأدثأزطوىأڬتأضتوىتأۄًأحًأۏًڽأزؼتأوتىڲًأ““أتەأتههۄأ$أحًأۄۏأۄوتشتأشثأۄەأتًشأتىأڬتأشثأۄەأ؏أۄوتشۏأځۏطتىۏتڽأتًشأتىأڬۏأځۏطتىۏتڽأحۏشەأۄۏأۄتحہأوۏڽأۄۏڽأۗأتىأڬًأحًأۄۏأمحهأڬشەأڲتأۗأځہشأحوأصوۏىأڬەأضتحہأډځڬأڬشأثۏټہأدتاأۗأدثأًۄأحوۄتشەأتىزشأڲہضأإةۏڽأحًأىؼشۄأحڬثۏشأثهىزأڬشحەأۄًةەأتټہأڬہڔەأۄًأ؏أځہشأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأڬهأتۏضەأإزوۏأڬًأثہۏدًڽأڲتأدًأتههۄأتًشأتضأڬەأشضًهأضەأوذثحأڬشحتأۄەأتًشأتههۄأتًشأتضأڬتأشضًهأتضأضەأوذثحأڬشحەأۄۏڽأۗأًۄأځۏټہأځہۏشأڬشأىۄۏڽأثہتڲەأڲتأ؏أتههۄأحؼتهۏٳأتضأڬەأۄتحہأځشألحذأزەأڲتأۗأهًڲأتضأثتحأڬًأمتثهألرشأضودہىەأهڲەأۗأتضأزىأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬۏأإىڬہۏڽأإةۏأۄًةۏأحہۏڽأۗأشضًهأتههۄأ﷽أىەأتىأڬًأذوهۄأڬشىەأڬتأڬۄتأ=أحًأتىۄًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أودہەأحًأڬډہأزڬہتةۏأىۄۏڽأزۏحتأۗأشضًهأتههۄأ﷽أىەأتىأڬۏأإىڬہًڽأځشأتځىتأهؼتثأزۄىأهڲتۏتأ؏أتىأڬًأهطڬشأڬۏأضشزتشۏأتًشأؼهوأؼغتألشوتۏتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏڽأڬضأوغتهثەأځشأدۄتزأڬشًڽأآأإځأ﷽أىەألشوتۏتأ=أتضأ+أوغتهثەأ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأىەأؼهوأًتهۏأذزۏخأىمهألشوتةۏأۄەأ؏أهۏڬىأتضأضىزأڬەأۄوشتۄأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4343","%أذعشحأتۏتضأثىأضهوۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أۄوأىەأشضًهأتههۄأ﷽أڬەأۄوشتۄأؽصًۄأرۏثشأوۏڽأطشڬحأڬۏأۗأحًأشضًهأتههۄأ﷽أىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬۏأإىڬہًڽأوۏڽأتځىتأهؼتثأزۄىأهڲتۏتأحًأتىأڬۏأإىڬہۏڽأټہۏڬأۄًأڲةۏڽأۗأإځأىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬًأدہىڋتأؼغتألشوتۏتأ؏أوشذثأىەأۏًڽأڬۄحەأۄًةەأوثتصشحأغهثأڬۏأ="
"أرۏثشأدتىحتأۄەأڬۄأوۏڽأوشذثأۄًڽأۄحہۏتشأثىزأ؏أحدشثۄأڬتشأهۏڋشأۄًڽأ؏أدثأدىڲأطشًؼأۄًأدتةەأحًأۏۄأطؼهۄأصىأۄًحتأۄەأۗ",""
"أذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأۏًڽأڬۄحەأۄًةەأتضأڬًأدىڲأڬەأهةەأثهتۏتأ=",""
"أوۏڽأًۄأۄًڽأدضأڬتأىتوأتضأڬۏأوتڽأىەأذۏزشأشڬہتأۄەأدۏضتأڬۄأدىڲهأڬتأطۏشأ؏أشؼثأزتشأًدتۄحأًتهتأۗأوۏڽأحوأوۏڽأًضۏؼأځۏوتىەأځشأحثتۄۏأځہۏهتأزًڽأڲتأۗ",""
"أځہشأإځأىەأوشذثأځشأتۏڬأعشثأهڲتةۏأتًشأتضأڬتأضشأډۏشأڬشأشڬہأزۏتأتًشأتضأڬًأمحهأڬشأزۏتأحًأرۏثشألحذأۄًأڲۏتأۗ",""
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأتضأتضىتزأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4344","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتځىۏأحهًتشأسًتهلمتشأدىڲأثزشأڬەأوًمؼأځشأوتهأؽىۏوحأوۏڽأضەأهۏأحہۏأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتًشأوۏڽأىەأتضأڬًأتضأومتوأځشأتضأهةەأسڬشأڬۏتأۄەأڬۄأڬډہأعؼۏلأتذتزۏخأضەأۏۄأختثحأۄەأڬۄأسًتهلمتشأرۏثشأڬەأوتهأوۏڽأضەأحہۏأۗ%أ",""
"4345","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أذعشحأظلۏۄأشعۏأتههۄأؼىۄتأوتهأؽىۏوحأوۏڽأضەأحہۏڽأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4346","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأودہەأروضأڬەأځتىډًۏڽأذظۄأڬۏأًهتۏحأؼغتألشوتةۏأ؏أحًأوۏڽأىەأشضًهأتههۄأ﷽أڬۏأذۏتحأغۏثۄأوۏڽأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأزًشأرهتلحأوۏڽأۄۏأتضأڬًأتضأڬەأومتوتحأځشأومششأڬشأزۏتأحہتأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4347","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأرۏثشأضەأًتزۏأمشۏٳأڬۏأغشلأهًټەأحًأإځأڬەأضتحہأتۏڬأؽهتوأثہۏأحہتأۗأدًأذعشحأشلتؼۄأثىأصۏزأتهذصتوۏأشعۏأتههۄأؼىۄأىەأإځأڬًأۄزۏۄأزۏتأحہتأۗأًۄأؽشًثأإلحتثأڬەأًمحأشضًهأتههۄأ﷽أڬتأڬدتًۄأتحتشأشۄتأحہتأۗأتۏڬأىتوؼهًوأحۏشأإأڬشأتىأڬًأهڲتأدضأضەأًۄأۄهتڬأۄًأڲۏتأۗأتًشأتضأحۏشأڬەأثتشەأوۏڽأڬًةۏأځحۄأىۄأډهأضڬتأڬۄأڬضأىەأوتشتأحہتأ؏أۄوأىەأتضأڬەأثتشەأوۏڽأڬۄتأ=أتضأڬًأوثتشڬأۄًأڬۄأۏۄأدىحۏأۄەأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أۄشڲصأىۄۏڽأۗأتضأستحأڬۏأمضوأ$أدضأڬەأمثعۄأوۏڽأوذوزأ﷽أڬۏأدتىأۄەأ؏أتضأڬتأطوهۄأتضأًمحأإڲأوۏڽأدهأشۄتأۄەأ؏أدًأڬۄأتضأىەأرۏثشأڬەأزىأوضهوتىًڽأڬەأوتهأؽىۏوحأضەأډشتۏتأحہتأۗأحًأشضًهأتههۄأ﷽أڬۏأۏۄأثتحأضىأڬشأإځأڬتأتۏڬأظذتثۏأشعۏأتههۄأؼىۄأڲہثشتحتأۄًتأإۏتأتًشأثًهتأ=أوۏڽأىەأدًحًڽأڬەأۏۄأزًأحضوەأتځىەأهةەأشڬہأهةەأحہەأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أحدہەأتضۏأڬۏأوخهأإڲأوۏڽأدهىتأځڔحتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأحتۄوأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأىەأتضۏأضىزأڬەأۄوشتۄأخًشأثىأۏصۏزأڬەأذًتهەأضەأذعشحأوتهڬأڬۏأۏۄأذزۏخأىمهأڬۏأۄەأ““أۄوأرۏثشأڬۏأغشلأىڬهەأحًأۄوۏڽأضًىتأتًشأډتىزۏأؽىۏوحأوۏڽأىۄۏڽأوهتأۗأ+أځہشأوڬوهأذزۏخأثۏتىأڬۏأ","%أ"
"4348","%أذعشحأثشتؤأثىأؼتصثأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬًأذعشحأدؼلشأشعۏأتههۄأؼىۄأڬۏأطۄتزحأڬۏأرثشأزۏأڲةۏأحًأإځأؼهۏۄأتهضهتوأڬًأتضأځشألرشأۄًتأۗأحًأذعشحأدثشۏهأؼهۏۄأتهضهتوأإځأ﷽أڬەأځتضأإةەأتًشأثًهەأ=أتههۄأحؼتهۏٳأىەأدؼلشأشعۏأتههۄأؼىۄأڬًأرًىأضەأشىڲەأۄًةەأضشرأشىڲأڬەأزًأځشأؼغتألشوتةەأۄۏڽأًۄأتىأڬەأضتحہأوهتةڬۄأڬەأۄوشتۄأځشًتصأڬشحەأشۄحەأۄۏڽأۗ"
"أٰٰأذعشحأثشتؤأشعۏأتههۄأؼىۄأڬەأذًتهەأضەأتضأذزۏخأڬۏأوحؼززأضىزۏڽأوًدًزأۄۏڽأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4349","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬًأذعشحأدؼلشأشعۏأتههۄأؼىۄأڬۏأطۄتزحأ+أڬۏأرثشأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4350","%أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬەأثؼزأذعشحأدؼلشأثىأتثۏأغتهثأشعۏأتههۄأؼىۄأضەأثۄحشأىۄأڬضۏأىەأدًحتأثىًتۏتأ؏أىۄأځۄىتأتًشأىۄأضًتشۏأځشأضًتشأۄًتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4351","%أذعشحأدثۏشأثىأىلۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأوًحۄأڬەأزىأدثأشضًهأتههۄأ﷽أڬەأظذتثۄأشعۏأتههۄأؼىۄوأڬتأطۄزتؤأځشأدصؼأًألصؼأطزحأترحۏتشأڬشأڲۏتأحًأشضًهأتههۄأ﷽أىەأحۏىأوشحثۄأتشطتزألشوتۏتأ=أزدتهأڬًأحوأدۏضەأۏتأحوأضەأثۄحشأهًڲأځتةۏڽأڲەأتًشأتههۄأحؼتهۏٳأتضأمًوأڬًأۄشڲصأشضًتأىۄۏڽأڬشەأڲتأدضأڬەأطشًؼأوۏڽأ؏أوۏڽأتًشأإرشأوۏڽأذعشحأؼۏضۏٳأؼهۏۄأتهضهتوأۄًڽأڲەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4352","%أذعشحأؼتوشأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأ؏أذعشحأؼثزتههۄأثىأدؼلشأشعۏأتههۄأؼىۄوتأڬًأضهتوأڬشحەأحًأۏًڽأڬۄحەأ““أ®تهضّٔهّتوْأؼّهّۏٕڬّأۏّتتثىّأسٓۏأتهٕدّىّتذّۏٕىٓ¾أ‛‛أ+أتەأزًأځشًڽأًتهەأڬەأثۏټەأحوأځشأضهتوحۏأۄًأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأذعشحأدؼلشأثىأتثۏأغتهثأشعۏأتههۄأؼىۄأڬەألعتةهأإرشأوۏڽأسڬشأڬشىەأڬۏأًدۄأۏۄأۄەأحتڬۄأوۏڽأتضأڬًألعتةهأظذتثۄأوۏڽأثۏتىأڬشًڽأۗ%أ",""
"4353","%أذعشحأىؼوتىأثىأثطۏشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأشًتذۄأشعۏأتههۄأؼىۄأځشأؽطۏأغتشۏأۄًةۏأحًأتىأڬۏأثۄىأثۏىأڬشحەأۄًةەأًتًۏهتأڬشىەأهڲأڲةۏأ؏أدثأتىأڬًأتلتمۄأۄًتأحًألشوتۏتأ=أحًأىەأدًأدًأڬډہأثًهتأ؏أتضأضثأڬەأوحؼهمأودہأضەأځًډہتأڲۏتأڬۄأحًأًتمؼۏأتۏضتأۄەأآأڬۏتأحًأًتمؼۏأتۏضتأۄەأآ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4354","%أؼثزتههۄأثىأثشۏزۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأؽصًۄأستحأتهضهتضهأوۏڽأذعشحأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄأڬًأ+أتوۏشأثىتأڬشأ"
"أۏۄأذزۏخأضىزأڬەأتؼحثتشأضەأظذۏذأۄەأحتۄوأطۏرۏىأىەأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4355","%أؼتوشأثىأؼثزتههۄأثۏتىأڬشحەأۄۏڽأ؏أضۏٔزۄأتوأضهوۄأىەأذعشحأضهوۄأثىأۄطتوأثىأوؽۏشۄأشعۏأتههۄأؼىۄأڬۏأتۄهۏۄأضەأزشۏتلحأڬۏتأ=أڬۏتأًدۄأۄەأڬۄأوۏڽأىەأضهوۄأشعۏأتههۄأؼىۄأڬًأىثۏأتڬشوأ﷽أتًشأوضهوتىًڽأڬەأضتحہأثتدوتؼحأىوتصأتزتأڬشحەأۄًةەأىۄۏڽأزۏڬہتأحًأتضأرتحًىأىەأدًتثأزۏتأ=أتههۄأڬۄأمضوأ$أًۄأتضأًدۄأضەأ+أڲہشأضەأ"
"أ+أشتًۏأڬۄحەأۄۏڽأ=أ","أتىۄًڽأىەأؽصًۄأوًحۄأوۏڽأذعشحأرتهزأثىأًهۏزأشعۏأتههۄأؼىۄأڬەأضتحہأطشڬحأڬۏأحہۏأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4356","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏشەأډډتأصتزأثہتةۏأتًشأوۏشەأزشوۏتىأڬډہأىتشتعڲۏأحہۏأۗأتضأىەأڬۄتأ=““أوڲشأحۏشتأدىڲأوًحۄأضەأثہتڲىتأ‛‛أ+أڬۏتأوؼىۏأشڬہحتأۄەأآأ"
"4357","%أذعشحأؼثزتههۄأثىأثشۏزۄأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذعشحأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄأڬًأ““أؽصًۄأستحأتهضهتضهأ‛‛أوۏڽأثہۏدتأ؏أتىأوۏڽأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأثہۏأوًدًزأحہەأۗأدثأۏۄأهًڲأومتوأدىڲأوۏڽأځۄىډەأحًأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأؽظۄأإأڲۏتأتًشأتىأضەأ+أهڬڔۏتڽأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4358","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أ46أشوعتىأتهوثتشڬأڬًأوڬۄألحذأۄًتأۗأ"
"4359","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽ألحذأوڬۄأًتهەأضتهأشًتىۄأۄًةەأتًشأزضأۄصتشأوضهوتىًڽأڬۏأۄوشتۄۏأوۏڽأ““أوشتهػۄشتىأ‛‛أضەأڲصشەأ+أمثۏهۄأثىًأ"
"أرزتأڬۏأمضوأ$أًۄأزىأثہۏأحہەأدثأوۏڽأهتحأڬەأهطڬشأڬًأوذوزأڬەأهطڬشأځشأؽتهثأڬشىەأڬەأهةەأؼهوأثهىزأڬۏتأڬشحتأحہتأۗ",""
"أوۏڽأتضأذۏشتىأإزوۏأڬۏأغشذأحہتأدًأتىزہۏشەأوۏڽأځہىضتأۄًتأۄًأ؏أهۏڬىأۏۄأذمأ+أڬًأحضهۏوأڬشأهۏىەأ","أڬتأًمحأۄەأۗأتههۄأىەأودہەأۄزتۏحأزۏأۄەأتًشأوۏڽأضۏزہەأشتضحۄأځشأإأڲۏتأۄًڽأۗ"
"أځضأحوأمثۏهۄأخمۏلأڬًأڬۄۄأزًأڬۄأوۏڽأحوأضەأهڔىتأىۄۏڽأډتۄحتأ؏أتًشأخمۏلأضەأڬۄۄأزًأڬۄأًۄأوۏشەأځتضأۄۏڽأ؏أحًأًۄأًؼزۄأڬشۏڽأۗ",""
"أتۏڬأۄزتۏحأزۏىەأًتهەأىەأودہەأضۏزہتأشتضحۄأزڬہتۏتأ؏أتًشأوۏشۏأستحأڬًأثزهأڬشأشڬہأزۏتأتًشأتضأىەأتههۄأڬۏأغشلأوۏشۏأشتۄىوتةۏأڬۏأدضأڬًأوۏڽأثتهڬهأزہحڬتشأډڬتأحہتأۗ",""
"أوۏڽأوذوزأ﷽أضەأثۄحأزًشأثہتڲحتأحہتأ؏أتًشأهًڲأودہەأوذوزأضەأوىضًثأڬشحەأحہەأتڲشډۄأوۏڽأتىأضەأوىضًثأۄًىتأىۄۏڽأډتۄحتأحہتأۗ",""
"أًۄأتۏضۏأدوتؼحأحہۏأ+أدضأوۏڽأ؏أوۏڽأځۄهەأطتوهأحہتأ","أڬۄأدًأتىأڬۏأرًتۄطأڬەأوغتثمأتىأڬۏأذوتۏحأوۏڽأىۄأثًهحتأتضأڬًأوهتوحأڬۏأدتحۏأتًشأتضەأرغتًتشأټہۄشتۏتأدتحتأتڲشډۄأًۄأؼمهأوىزأۄۏأڬۏًڽأىۄأۄًحتأۗ"
"أوۏڽأتىأڬًأشتعۏأڬشىتأډتۄحتأحہتأتًشأوۏڽأڬضۏأمًوأڬەأضتحہأتضأًمحأحڬأڲلحڲًأىۄۏڽأڬۏتأڬشحتأحہتأدثأحڬأًۄأودہەأۄشأودهضأڬتأۄزۏۄأځۏطأىۄأڬشأزۏحەأحہەأۗ",""
"أوۏڽأدضأهطڬشأوۏڽأثہۏأشۄتأحًأتىۄًڽأىەأدًأڬډہأوتهأځتۏتأتًشأدًأڬہتۏتأضثأوۏشەأۄتحہأتًشأوۏشۏأصثتىأڬۏأڬوتةۏأحہۏأۗ",""
"أتًشأثەأطڬأدضأطرظأڬًأحوأىەأىڬتهتأتًشأثشتأثہهتأڬۄتأ؏أؼىمشۏثأًۄأحوتوأشطحۄأزتشۏًڽأضەأثتهتحشأۄًأڬشأحوۄتشەأهةەأدزًدۄزأڬشەأڲتأۗ",""
"أ+أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأ","ألشوتحەأۄۏڽأ=أدثأتضأىەأڬۄتأ=أ®تهۏأوىأغشزحأڬهأوغشز¾أحًأشضًهأتههۄأ﷽أىەأتضأڬەأضۏىەأځشأۄتحہأوتشأڬشألشوتۏتأ=أ®تىحأتهسۏأغشزحىۏأڬهأوغشز¾أ+أحًأۄۏأۄەأدضأىەأودہەأثتهڬهأزہحڬتشأزۏتأحہتأ"
"أتثىأتضذتمأڬۄحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬۏأًتهزۄأوتدزۄأتځىەأوتوًاڽأضەأوهىەأثىۏأىدتشأڲةۏأحہۏڽأحًأًۄۏڽأومتوأتثًتؤأوۏڽأتىأڬتأتىحمتهأۄًأڲۏتأۗ",""
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتًشأتثًضلۏتىأثىأذتشخأشعۏأتههۄأؼىۄأشضًهأتههۄأ﷽أڬتأشعتؼۏأثہتةۏأحہتأزًىًڽأڬًأذهۏوۄأضؼزۏۄأشعۏأتههۄأؼىۄتأىەأزًزہأځهتۏتأحہتأۗأتًشأًۄأذعًشأ﷽أڬتأډډتأصتزأثہتةۏأثہۏأحہتأۗأهۏڬىأتضأىەأشضًهأتههۄأ﷽أڬەأضتحہأىتشًتأضهًڬأڬۏتأتًشأڬةۏأوشحثۄأإځأڬۏأطتىأوۏڽأۄشصۄأضشتةۏأڬۏأۗأذحۏأڬۄأذعشحأذضتىأثىأختثحأشعۏأتههۄأؼىۄأىەأتځىەأمظۏزەأوۏڽأتضأڬتأدًتثأزۏتأۗأتضأوۏڽأإځألشوتحەأۄۏڽأ=",""
"أحًأىەأإځأ﷽أڬۏأؼۏثأدًةۏأڬۏأۄەأتًشأوۏڽأىەأتضأڬتأدًتثأزۏتأۄەأتًشأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأتضأڬتأثزهۄأوهەأڲتأۗ",""
"أۏۄأوڬوهأذزۏخأتًشأځًشتأمظۏزۄأظذۏذأوضهوأطشۏلأڬۏأذزۏخأوۏڽأوًدًزأۄەأۗ",""
"أذعشحأذضتىأثىأختثحأشعۏأتههۄأؼىۄأتضأ+أتثًضلۏتىأ","أڬۏأوسوحأثۏتىأڬشىەأڬۏأتدتصحأوتىڲتأڬشحەأحہەأهۏڬىأشضًهأتههۄأ﷽أوىؼألشوتأزۏتأڬشحەأحہەأۗ%أ"
"4360","%أذعشحأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=ألحذأوڬۄأڬەأزىأؼثزتههۄأثىأتثۏأضشذأشعۏأتههۄأؼىۄأذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأڬەأځتضأدتأڬشأډہځأڲةەأۗأذعشحأؼخوتىأشعۏأتههۄأؼىۄأتىأڬًأهەأڬشأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًأڲةەأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أؼثزتههۄأڬۏأثۏؼحأهەأهۏدةەأۗأىثۏأتڬشوأ﷽أىەأحۏىأوشحثۄأضشأتټہتأڬشأتضأڬۏأغشلأزۏڬہتأځہشأإځأىەأتځىەأظذتثۄأشعۏأتههۄأؼىۄوأڬۏأغشلأوحًدۄأۄًأڬشألشوتۏتأ=أڬۏتأحوأوۏڽأڬًةۏأضودہزتشأإزوۏأىۄۏڽأۄەأآأدثأتضأىەأزۏڬہأهۏتأحہتأڬۄأوۏڽأتضأڬۏأثۏؼحأضەأځۄهًأحۄۏأڬشأشۄتأۄًڽأحًأًۄأتټہأڬشأتضأڬًأوتشأزۏحتأۗأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أۄوۏڽأځحۄأىۄۏڽأډهأضڬتأحہتأڬۄأإځأڬەأزهأوۏڽأڬۏتأتشتزۄأۄەأۗأإځأۄوۏڽأإىڬہأضەأتطتشۄألشوتأزۏحەأۗأإځأ﷽أىەألشوتۏتأ=أڬضۏأىثۏأڬۏأطتىأڬەأهتةمأىۄۏڽأۄەأڬۄأتضأڬۏأإىڬہأرتةىأۄًأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4361","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذعشحأؼثزتههۄأثىأتثۏأضشذأشعۏأتههۄأؼىۄأ؏أشضًهأتههۄأ﷽أڬەأ+أۄتڽأًذۏأڬۏأڬحتثحأڬەأهةەأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4362","%أذعشحأطشذثۏهأثىأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۏۄأإۏحأذعشحأؼثزتههۄأثىأتثۏأضشذأڬەأثتشەأوۏڽأىتصهأۄًةۏأ"
"أ®ًّوّىٕأتّػٕهّوْأوٓؤّىٓأتلٕحّشّۏأؼّهّۏأتههٔٳۄٓأڬّسٓثَتأتًْٕذٓۏّأتٓهّۏّٔأًّهّوٕأۏًْٕذّأتٓهّۏٕۄٓأطّۏٕةُأًّوّىٕأمّتهّأضّتْىٕصٓهْأوٓخٕهّأوّتأتّىٕصّهّأتههٔٳۄْأ+أتهتىؼتوأ=أ<6أ","¾"
"أ““أتًشأتضأضەأثڔہأڬشأػتهوأڬًىأدًأتههۄأځشأدہًټأثتىزہەأۏتأڬۄەأودہەأًذۏأۄًةۏأتًشأتضەأڬډہأًذۏأىۄأۄًةۏأتًشأدًأڬۄەأتثہۏأوۏڽأتحتشحتأۄًڽأتۏضتأدۏضتأرزتأىەأتحتشتأ‛‛أ+أحشدوۄأڬىصتهتۏوتىأ؏أتوتوأتذوزأشعتأ",""
"أدثأشضًهأتههۄأ﷽أ+ألحذأوڬۄأڬەأوًمؼأځشأ","أوڬۄأوۏڽأزترهأۄًةەأحًأًۄأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأځتضأثہتڲأڲۏتأڬۏًىڬۄأًۄأذعشحأؼخوتىأڬتأشعتؼۏأثہتةۏأثہۏأحہتأۗأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأتضأڬًأډہځتةەأشڬہتأذحۏأڬۄأدثأوڬۄأوۏڽأتوىأۄًأڲۏتأحًأذعشحأؼخوتىأشعۏأتههۄأؼىۄأىەأتضأڬًأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأځۏطأڬشأزۏتأتًشأتضأڬەأهةەأتوتىأڬۏأضلتشطأڬۏأۗ"
"أٰٰأىًټأ=أتوتوأذتڬوأڬۄحەأۄۏڽأ=أثرتشۏأتًشأوضهوأوۏڽأۏۄأظذۏذأشًتۏتحأوًدًزأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأوڬۄأوۏڽأزترهأۄًىەأضەأځۄهەأؼثزتههۄأثىأضؼزأتًشأؼثزتههۄأثىأرغهأڬەأمحهأڬتأذڬوأزۏتأحہتأۗأتضأهةەأدضأإزوۏأڬۏأىػشأذعشحأؼخوتىأثىأؼلتىأشعۏأتههۄأؼىۄأڬۏأطۄتزحأتًشأؼثزتههۄأثىأضؼزأڬۏأوظشأوۏڽأتىأڬەأرهتلأذشڬحًڽأځشأۄەأ؏أًۄأدتىحتأۄەأڬۄأىثۏأتڬشوأ﷽أڬًأتضۏأًمحأتضأ+أڬۏأذشڬحًڽأ","أڬتأځحۄأحہتأۗ%أ"
"4363","%أذعشحأتضوتؤأثىحأتثۏأثڬشأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=ألحذأوڬۄأڬەأزىأدثأشضًهأتههۄأ﷽أ““أسۏأغًۏأ‛‛أوۏڽأحطشۏلأهەأإةەأحًأذعشحأتثًمذتلۄأشعۏأتههۄأؼىۄأىەأتځىۏأضثأضەأډہًټۏأثۏټۏأضەأڬۄتأ=أتەأثۏټۏأ$أودہەأتثًمثۏضأ+أځۄتڔأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4364","%أذعشحأؼوشًأثىأضهوۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأۄوأهًڲًڽأڬۏأڲصشڲتۄأځشأۄًحەأحہەأتًشأإحەأدتحەأمتلهًڽأضەأوهتمتحأڬشأڬەأتىأضەأځًډہحەأڬۄأتظهأوضةهۄأڬۏتأۄەأآأتًشأتضأڬەأثتشەأوۏڽأهًڲًڽأڬەأحتخشتحأڬۏتأۄۏڽأآأحًأًۄأثحتحەأڬۄأ““أتۏڬأىثۏأۄەأدًأۏۄأضودہحتأۄەأڬۄأتههۄأحؼتهۏٳأىەأتضأڬًأشضًهأثىتۏتأۄەأتًشأتضأڬۏأغشلألهتڽألهتڽأًذۏأإحۏأۄەأۗأدثڬۄأهًڲًڽأڬًأتضهتوأهتىەأوۏڽأتىأڬۏألحذأڬتأتىحػتشأۄەأتًشأًۄأڬۄحەأۄۏڽأڬۄأتضأڬًأزۏڬہحەأشۄًأتڲشأۏۄأؽتهثأإأڲۏتأحًأًتمؼۏأىثۏأۄًأڲتأحًأتضأڬۏأحظزۏمأڬشأزۏىتأۗأډىتىډۄألحذأوڬۄأڬەأثؼزأۄشأمثۏهۄأتۏڬأزًضشەأضەأإڲەأثڔہأڬشأشضًهأتههۄأ﷽أڬۏأثتشڲتۄأوۏڽأوطشلأثتتضهتوأۄًحتأحًأًۄأثہۏأذعًشأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًةەأتًشأڬډہأؼشظۄأًۄۏڽأمۏتوأڬۏتأځہشأًۄتڽأضەأإأڲةەأۗأحًأۄوأىەأتىأضەأوهتمتحأڬۏأۗأحًأتىۄًڽأىەأڬۄتأ=أوۏڽأحوۄتشەأځتضأتههۄأڬەأضډەأشضًهأڬەأځتضأضەأإۏتأۄًڽأۗأتًشأًۄألهتڽألهتڽأذڬوأزۏحەأۄۏڽأۗأتًشأدثأىوتصأڬتأًمحأۄًأدتةەأحًأۄوأوۏڽأضەأڬًةۏأتۏڬأإزوۏأتستىأځڔہەأتًشأحوأوۏڽأضەأًۄأطرظأدوتؼحأڬشتةەأدًأحوأوۏڽأضثأضەأتډہتأمشإىأځڔہحتأۄًأۗأتىأهًڲًڽأىەأثۄحأحهتطأڬۏتأوڲشأتىأهًڲًڽأڬًأودہأضەأصۏتزۄأتډہتأمشإىأځڔہىەأًتهتأڬًةۏأىۄأوهتأۗأډىتىډۄأتىۄًڽأىەأودہەأۄۏأإڲەأڬشأزۏتأۗأوۏشۏأؼوشأتضأًمحأډہأۏتأضتحأضتهأۄًأڲۏأۗأحًأوۏڽأتىأڬًأىوتصأځڔہتۏتأڬشحتأحہتأۗأدثأوۏڽأضدزۄأوۏڽأدتحتأحًأوۏشۏأډتزشأتڬټہۏأۄًأدتحۏأحًأمثۏهەأڬۏأتۏڬأرتحًىأىەأڬۄتأ=أتځىەأتوتوأڬۏأضشۏىأډہځتىەأڬتأتىحػتوأڬشًأۗ"
"أذعشحأؼوشًأثىأضهوۄأثۏتىأڬشحەأۄۏڽأ=أحًأودہەأتۏڬأۏوىۏأډتزشأځۄىىەأڬەأهۏەأزۏأڲةۏأدضأڬۏأمۏوحأډہأۏتأضتحأزشۄوأحہۏأدحىۏأودہەأًۄأډتزشأذتظهأڬشىەأڬۏأرًطۏأۄًةۏأتضأضەأځۄهەأڬثہۏأتحىۏأرًطۏأىۄۏڽأۄًةۏأحہۏأۗ",""
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأۏۄأذزۏخأذعشحأضهۏوتىأثىأذشثأشعۏأتههۄأؼىۄأڬەأذًتهەأضەأورحظشتَأشًتۏحأڬۏأۄەأدثڬۄأوۏڽأىەأتضأڬًأولظهأثۏتىأڬۏتأۄەأۗ%أ",""
"4365","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽ألحذأوڬۄأڬەأزىأوڬۆأتهوڬشوۄأوۏڽأزترهأۄًةەأحًأؼتدصۏأڬۏأثىۏتزأځشأ+أتځىتأضشأتىًشأتضأمزشدہڬتةەأۄًةەأحہەأڬۄأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4366","%أذعشحأتثًوضؼًزأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄألحذأوڬۄأڬەأزىأتۏڬأإزوۏأىثۏأتڬشوأ﷽أضەأثتحأڬشحەأۄًةەأڬتىځىەأهڲتأىثۏأتڬشوأ﷽أىەأتضأضەألشوتۏتأ=أتځىەأإځأڬًأمتثًأوۏڽأشڬہًأڬۏًىڬۄأوۏڽأمشۏطأڬۏأتضأرتحًىأڬتأثۏټتأۄًڽأدًأرطڬأڲًطحأڬہتۏتأڬشحۏأحہۏأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4367","%أذعشحأدتثشأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأذىۏىأڬەأزىأشضًهأتههۄأ﷽أىەأتىظتشأڬًأځڬتشتأحًأضثأىەأدًتثتَأڬۄتأ=أۏتأشضًهأتههۄأ﷽أۄوتشەأوتڽأثتځأإځأځشأمشثتىأۄًأدتةۏڽأ؏أۄوأذتعشأۄۏڽأۗأإځأىەألشوتۏتأ=أتههۄأتًشأتضأڬەأشضًهأڬۏأغشلأوحًدۄأۄًأدتاأ؏أًۄأحوۄۏڽأتۏضەأثتؽتحأوۏڽأزترهأڬشەأڲتأدضأڬەأىۏډەأىۄشۏڽأدتشۏأۄۏڽأحًأًۄأضثأهًڲأإًتصۏڽأهڲتحەأۄًةەأثہتڲأإةەأتًشأتىأڬًأډتشًڽأغشلأضەأڲہۏشأهۏتأڲۏتأ؏أتىأڬًأځډہتڔتأڲۏتأ؏أتىأڬۏأڲشزىۏڽأڬټحۏأشۄۏڽأ؏أهۏڬىأًۄأدۄتزأڬشحەأشۄەأذحۏأڬۄأتههۄأحؼتهۏٳأىەأوطشڬۏىأڬًأطڬضحأزۏأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ",""
"أوثتشڬأثىألعتهۄأضەأوشًۏأزشدأسۏهأذزۏخأ؏أوسڬًشۄأذزۏخأڬۏأطتۄزأۄەأۗ%أ",""
"4368","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأذىۏىأڬەأزىأوڬۄأتًشأوزۏىۄأًتهًڽأڬۏأوطشڬۏىأضەأوڋثہۏڔأۄًةۏأ؏أثۄحأڲہوضتىأڬۏأهڔتةۏأۄًةۏأ؏أحًأوضهوتىأثہتڲأىڬهەأۗأحًأشضًهأتههۄأ﷽أىەأتىظتشأڬًأإًتصأزەأڬشأڬۄتأ=أتەأوضهوتىًڽأ$أوۏڽأتههۄأڬتأشضًهأۄًڽأ؏أوضهوتىًڽأىەأڬۄتأ=أرزتأڬۏأمضوأ$أۄوأإځأڬۏأغشلأإأڲةەأ؏أډىتىډۄأتىۄًڽأىەأحؼوۏهأتشطتزأڬۏأتًشأځہشأ+أدوأڬشأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4369","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأضەأوشًۏأۄەأڬۄألحذأوڬۄأڬەأثؼزأشضًهأتههۄأ﷽أىەأذىۏىأڬۏأغشلأځۏطأمزوۏألشوتةۏأ+أتضأڬتأًتمؼۄأڬډہأۏًڽأۄەأڬۄأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4370","أذعشحأؼثتزۄأثىأظتوحأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذىۏىأڬەأزىأتًىټأڬەأځۄهًأوۏڽأضەأڬډہأثتهأځڬڔەأځہشأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأىەأدًأحوۄۏڽأوتهأؽىۏوحأزۏتأۄەأ؏أتضأوۏڽأضەأوۏشەأهةەأتحىۏأومزتشأوۏڽأثہۏأذهتهأىۄۏڽأۄەأضًتةەأروضأڬەأتًشروضأحوأځشأشزأڬۏتأڲۏتأۄەأتًشأضًةۏأتًشأزہتڲۄأحڬأثہۏأتزتأڬشًأ؏أتًشأزہًڬۄأزۄۏأضەأثډًأڬۏًىڬۄأوهتًټأمۏتوحأڬەأزىأوهتًټأڬشىەأًتهًڽأڬەأهةەأثتؼخأؼتشأۄًأڲۏأتًشأحوأځشأدۄتزألۏأضثۏهأتههۄأهتصوأۄەأڬۏًىڬۄأۏۄأدىحأڬەأزشًتصًڽأوۏڽأضەأتۏڬأزشًتصۄأۄەأ؏أتههۄأحؼتهۏٳأتضأڬۏأثزًهحأځشۏطتىۏًڽأتًشأزڬہًڽأڬًأرحوألشوتأزۏحتأۄەأتًشأشضًهأتههۄأ﷽أوتهأؽىۏوحأڬًأ+أرًزأتځىەأهةەأ"
"4371","%أذعشحأتثًىدۏذأضهوۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأىەأشضًهأتههۄأ﷽أڬەأۄوشتۄأغتةلأڬەأمهؼۄأڬتأوذتظشۄأڬۏتأ؏أوۏڽأىەأشضًهأتههۄأ﷽أڬًأ+أتضأوًمؼأځشأ"
"أٰٰأۏۄأذزۏخأظذۏذأۄەأ؏أتضأڬۏأضىزأؼتهۏأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4372","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأډتشأؼوشەأڬةەأ؏أ+أ4أ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4373","%أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أىەأحثًڬأڬۏأدتىثأځۏطأمزوۏألشوتةۏأحًأڬًةۏأىۄأڬًةۏأځۏډہەأشۄأدتحتأ؏أحًأهًڲأڬۄحەأ=أۏتأشضًهأتههۄأ﷽ألهتڽأطرظأځۏډہەأشۄأڲۏتأۄەأ؏أإځأؼهۏۄأتهضهتوألشوتحەأ=أتضأڬًأډہًڔًأ؏أتڲشأتضأ+أڬەأىظۏثأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4374","%أدوۏؼأثىأؼوۏشأهۏخۏألشوتحەأۄۏڽأ=أوۏڽأذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأڬەأځتضأإۏتأتًشأتىأضەأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأضًتهأڬۏتأۗأحًأتىۄًڽأىەأودہەأڋتىټأزۏتأۗأځہشألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬەأثتشەأوۏڽأىۄأثحتاڽأآأوضدزأوۏڽأۏۄأشضًهأتههۄأ﷽أڬتأذدشۄأۄەأتًشأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬتأذدشۄأۄەأۗأثەأطڬأشضًهأتههۄأ﷽أىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأثشتؤۆأڬتأتؼهتىأڬشىەأڬەأهةەأتۄهأوڬۄأڬۏأغشلأثہۏدتأۗأۏۄأزًىًڽأډهەأځڔەأۗأحًأتىأڬەأضتوىەأتۏڬأضًتشأإۏتأ؏أتىۄًڽأىەأتضأضەأځًډہتأ=أحوأڬًىأۄًأآأتضأىەأدًتثتَأڬۄتأ=أتەأتثًثڬشأشعۏأتههۄأؼىۄأوۏڽأؼهۏأۄًڽأ؏أتًشأًۄأرغأودہەأزًأدًأحوۄتشەأځتضأۄەأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأځًډہتأ=أًۄأڬۏًڽأآأتىۄًڽأىەأڬۄتأ=أرزتأڬۏأمضوأ$أوۏڽأثہهتةۏأۄۏأدتىحتأۄًڽأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأًۄأرغأهەأڬشأإڲەأڲةەأتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأًتځضأډهەأإةەأتًشأإأڬشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أ$أۄوأوۏڽأڬۏتأڬوۏأحہۏأآأذعًشأ﷽أىەألشوتۏتأ=أ+أحوأوۏڽأڬًةۏأڬوۏأىۄۏڽأحہۏأثهڬۄأ"
"أٰٰأۏۄأذزۏخأطتسأۄەأۗأتضأوۏڽأدوۏؼأثىأؼوۏشأځشأتضأڬەأثؼزأتضذتمأثىأثطشأځشأذوهأۄەأۗ%أ",""
"4375","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڬًأثہۏدتأتًشأتىأڬًأذڬوأزۏتأڬۄأتىأثتحًڽأڬتأتؼهتىأڬشأزًأ؏أځہشأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬًأتىأڬەأځۏډہەأشًتىۄأڬشأزۏتأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتثہۏأشتضحۄأۄۏأوۏڽأحہەأڬۄأتىأڬًأشضًهأتههۄأ﷽أڬۏأتًىټىۏأڬۏأإًتصأضىتةۏأزۏأۗأحًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأڲہثشتأڬشأتضأإًتصأڬۏأغشلأډهأځڔەأًۄأضودہەأڬۄأطتۏزأشضًهأتههۄأ﷽أحطشۏلأهتأشۄەأۄۏڽأۗأدثأځتضأځۄىډەأحًأًۄأذعشحأؼهۏأشعۏأتههۄأؼىۄأحہەأۗأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأشضًهأتههۄأ﷽أڬتأًۄأوڬحًثأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬەأذًتهەأڬۏتأدضأڬتأذدأڬەأوًمؼأځشأتؼهتىأڬشىەأڬتأذڬوأحہتأۗأتًشأذعشحأؼهۏأشعۏأتههۄأؼىۄأضەأڬۄتأ=أتىأڬهوتحأڬتأتؼهتىأڬشأزۏىتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأتۏتوأحطشۏمأوۏڽأڬہڔەأۄًةەأتًشأتؼهتىأڬشأزۏتأڬۄأتههۄأتًشأتضأڬتأشضًهأ﷽أوطشڬًڽأضەأثۏصتشأۄۏڽأۗأحوأصوۏىأوۏڽأډتشأوتۄأحڬأډهأځہشأهًأتًشأتضأضتهأڬەأثؼزأىۄأڬضۏأوطشڬأڬًأذدأڬشىەأڬۏأتدتصحأۄًأڲۏأتًشأىۄأڬًةۏأىىڲەأۄًأڬشأثۏحأتههۄأڬتأغًتلأڬشەأڲتأۗأتًشأدىحأوۏڽأظشلأتۏوتىأًتهتأۄۏأدتةەأڲتأۗأذعشحأؼهۏأشعۏأتههۄأؼىۄأوضهضهأۏۄأتؼهتىأڬشحەأشۄەأذحۏأڬۄأتىأڬۏأتًىټىۏأثۏټہأڲةۏأۗأحًأځہشأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأتټہأڬشأڬہڔەأۄًةەأتًشأتىۄًڽأىەأتؼهتىأڬشىتأطشًؼأڬشأزۏتأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتضأتؼهتىأڬۏأًعتذحأڬەأۄوشتۄأزشدأسۏهأظذۏذأذزۏخأثہۏأوًدًزأۄەأۗ%أ",""
"4376","%أذعشحأصۏزأثىأۏخۏؼأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أۄوأىەأذعشحأؼهۏأشعۏأتههۄأؼىۄأضەأځًډہتأ=أإځأڬًأڬۏتأځۏؽتوأزەأڬشأذدأڬەأوًمؼأځشأثہۏدتأڲۏتأحہتأآأتىۄًڽأىەألشوتۏتأ=أډتشأډۏصۏڽأحہۏڽأ"
"+أ4أ","أدىحأوۏڽأظشلأتۏوتىأًتهتأۄۏأدتأضڬحتأۄەأۗ"
"أ+أ5أ","أڬضۏأڬًأثۏحأتههۄأڬتأغًتلأثشۄىۄأذتهحأوۏڽأڬشىەأڬۏأتدتصحأىۄۏڽأۗ"
"أ+أ6أ","أتضأضتهأڬەأثؼزأوضدزأذشتوأوۏڽأوًوىأتًشأڬتلشأتڬټہەأىۄۏڽأۄًڽأڲەأۗ"
"أ+أ7أ","أدضأڬتأىثۏأتڬشوأ﷽أڬەأضتحہأڬضۏأومششۄأوۏؼتزأحڬأوؼتۄزۄأحہتأتضأڬتأوؼتۄزۄأتضأڬۏأوۏؼتزأحڬأځًشتأڬۏتأدتةەأڲتأتًشأدضأڬەأضتحہأڬًةۏأوؼتۄزۄأىۄۏڽأۄًتأحہتأتىأڬًأډتشأوتۄأڬۏأوۄهحأزۏأدتحۏأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4377","%أذعشحأضهوۄأثىأىؼۏوأثىأوضؼًزأتځىەأًتهزأڬەأذًتهەأضەأثۏتىأڬشحەأۄۏڽأڬۄأدثأوضۏهوۄأڬستثأڬەأضلۏشأتضأڬتأرغأهەأڬشأشضًهأتههۄأ﷽أڬەأځتضأإةەأحًأشضًهأتههۄأ﷽أىەأتىأضەألشوتۏتأ=أڬۏتأحوأثہۏأتضأڬەأىػشۏتحأڬەأمتةهأۄًأآأتىۄًڽأىەأڬۄتأ=أدۏأۄتڽأۗأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتڲشأضلۏشًڽأڬەأمحهأځشأځتثىزۏأىۄأۄًحۏأحًأوۏڽأحوۄۏڽأمحهأڬشأزۏحتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4378","%متضوأثىأؼثزتهشذوىأثىأؼثزتههۄأتهوضؼًزۏأشعۏأتههۄأؼىۄأتځىەأًتهزأڬتأۏۄأثۏتىأىمهأڬشحەأۄۏڽأ=أتۏڬأإزوۏأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬەأځتضأإۏتأتًشأڬۄىەأهڲتأ=أتەأتثًؼثزتهشذوىأ$أۏۄتڽأځشأڬډہأهًڲأۄۏڽأدًأوضۏهوۄأڬۏأمشتؤحأځڔہحەأۄۏڽأۗأحًأذعشحأؼثزتههۄأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أڬۏتأتههۄأڬۏأڬحتثأڬەأؼهتًۄأثہۏأڬًةۏأڬحتثأۄەأآأۏتأتههۄأڬەأشضًهأڬەأؼهتًۄأثہۏأڬًةۏأشضًهأۄەأآأثؼزأتضأڬەأڬۄأتضهتوأځہۏهأډڬتأۄەأۗأ+أإځأىەأۏۄأڬۄۄأڬشأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4379","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أوضۏهوۄأڬەأځتضأڲةەأحًأوضۏهوۄأىەأإځأضەأڬۄتأ=أحوأڲًتۄۏأزًأڬۄأوۏڽأتههۄأڬتأشضًهأۄًڽأ؏أحًأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأتههۄأځشأتًشأتضأڬەأشضًهًڽأځشأتۏوتىأهتۏتأ؏أځہشأشضًهأتههۄأ﷽أتشطتزألشوتۏتأ=أۏۄأطرظأتځىۏأمًوأڬۏأۄهتڬحأڬتأضثثأۄەأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4380","%أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أثىًأضؼزأثىأثڬشأىەأعوتوأثىأخؼهثۄأشعۏأتههۄأؼىۄأڬًأشضًهأتههۄأ﷽أڬەأځتضأثہۏدتأحًأًۄأۄوتشەأځتضأإۏتأ؏أتضأىەأوضدزأڬەأزشًتصەأځشأتځىتأتًىټأثټہتۏتأتًشأتضأڬًأثتىزہأزۏتأۗأځہشأًۄأشضًهأتههۄأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتضأًمحأإځأ﷽أتځىەأتظذتثأڬەأۄوشتۄأوضدزأوۏڽأحطشۏلألشوتأحہەأۗأتضأىەأڬۄتأ=أحوأوۏڽأؼثزتهوغهثأڬتأثۏټتأڬًىأۄەأآأشضًهأتههۄأ﷽أىەألشوتۏتأ=أوۏڽأۄًڽأؼثزتهوغهثأڬتأثۏټتأۗأتضأىەأڬۄتأ=أوذوزأآأإځأىەألشوتۏتأ=أۄتڽأۗأتضأىەأڬۄتأ=أتەأوذوزأ$أوۏڽأإځأضەأڬډہأځًډہىتأډتۄحتأۄًڽأ؏أحًأتڲشأوۏشەأهۄدەأوۏڽأضرحۏأځتةۏڽأحًأإځأتضأڬًأوذضًضأوحأڬۏدةەأڲتأۗأڬۏًىڬۄأًۄأضرحۏأوۏشەأزهأوۏڽأىۄۏڽأۄەأۗأإځأىەألشوتۏتأ=أحوأدًأځًډہىتأډتۄحەأۄًأځًډہًأۗأتضأىەأڬۄتأ=أوۏڽأحوۄۏڽأتضأتههۄأڬۏأمضوأزۏحتأۄًڽأدًأحوۄتشتأوؼثًزأۄەأتًشأحوأضەأځۄهًڽأڬتأوؼثًزأۄەأۗأتًشأتىأضثأڬتأوؼثًزأۄەأدًأحوۄتشەأثؼزأۄًڽأڲەأۗأڬۏتأتههۄأىەأحوأڬًأۄوتشۏأغشلأشضًهأثىتأڬشأثہۏدتأۄەأآإځأىەألشوتۏتأ=أدۏأۄتڽأۗأتضأىەأڬۄتأ=أوۏڽأحوۄۏڽأتضأتههۄأڬۏأمضوأزۏحتأۄًڽأدًأحوۄتشتأوؼثًزأۄەأ؏أحوأضەأځۄهەأهًڲًڽأڬتأوؼثًزأۄەأتًشأتىأحوتوأهًڲًڽأڬتأوؼثًزأۄەأدًأحوۄتشەأثؼزأۄًڽأڲەأۗأڬۏتأتههۄأىەأحوۄۏڽأۏۄأذڬوأزۏتأۄەأڬۄأۄوأظشلأتضأڬۏأؼثتزحأڬشۏڽأتًشأتضأڬەأضتحہأڬضۏأڬًأطشۏڬأىۄأټہۄشتةۏڽأتًشأۏۄأڬۄأۄوأتىأثحًڽأڬًأډہًڔأزۏڽأدىأڬۏأؼثتزحأۄوتشەأإثتاأتدزتزأڬۏتأڬشحەأحہەأآأإځأىەألشوتۏتأ=أدۏأۄتڽأۗأځہشأتضأىەألشتةعأتضهتوأ؏أىوتصأ؏أشًصۄأ؏أذدأتًشأصڬتۆأوۏڽأضەأتۏڬأڬتأىتوأهەأڬشأۄشأتۏڬأڬەأضتحہأتضۏأغشذأمضوۏڽأزەأزەأڬشأضًتهأڬةەأ؏أدثأًۄأحوتوأضًتهتحأضەألتشؽأۄًتأحًأثًهتأ=أوۏڽأڲًتۄۏأزۏحتأۄًڽأڬۄأثەأطڬأتههۄأڬەأضًتأڬًةۏأوؼثًزأىۄۏڽأۄەأتًشأثەأطڬأإځأتضأڬەأثىزەأتًشأشضًهأۄۏڽأۗأوۏڽأتىألشتةعأځشأؼوهأڬشًڽأڲتأۗأتًشأتىأډۏصًڽأضەأشڬًڽأڲتأدىأضەأإځأىەأودہەأوىؼألشوتۏتأۄەأۗأىۄأتىأوۏڽأتعتلۄأڬشًڽأڲتأتًشأىۄأتىأوۏڽأڬوۏأڬشًڽأڲتأځہشأًۄأًتځضأتځىەأتًىټأڬۏأغشلأځهټأڲۏتأۗأدثأًۄأًتځضأدتأشۄتأحہتأحًأشضًهأتههۄأ﷽أىەألشوتۏتأ=أتڲشأتضأزًأډًټۏًڽأًتهەأىەأضډأڬۄتأۄەأحًأۏۄأدىحۏأۄەأۗأذعشحأعوتوأغتمحًشأتًشأڲہىەأثتهًڽأًتهەأإزوۏأحہەأتًشأۏۄأتځىەأثتهًڽأڬۏأزًأډًټۏتڽأشڬہحەأحہەأۗ"
"أځہشأًۄأتځىەأتًىټأڬەأځتضأإةەأ؏أتځىتأتًىټأڬہًهتأتًشأتځىۏأمًوأڬەأځتضأإأڲةەأ؏أضثأهًڲأتىأڬەأتشزڲشزأدوؼأۄًأڲةەأۗأتىۄًڽأىەأڲلحڲًأطشًؼأڬشحەأۄًةەأهتحأتًشأؼصۏأڬًأڲتهۏتڽأزۏىتأطشًؼأڬشأزۏڽأۗأهًڲًڽأىەأڬۄتأ=أتەأعوتوأ$أثضأڬشأۗأحًأثشظأ؏أدستوأ؏أتًشأدىًىأ+أدۏضۏأوۄهڬأثۏوتشۏًڽأضەأ","أثډأۗأعوتوأىەأڬۄتأ=أحوۄتشەأهةەأۄهتڬحأۄًأ؏أرزتأڬۏأمضوأ$أثەأطڬأۏۄأحوۄۏڽأىۄأڬًةۏألتةزۄأزەأضڬحەأۄۏڽأىۄأڬًةۏأىمظتىأزەأضڬحەأۄۏڽأۗأثەأطڬأتههۄأحؼتهۏٳأىەأتځىتأشضًهأثہۏدتأۄەأتًشأتضأځشأتۏضۏأڬحتثأتحتشۏأۄەأدًأحوۄۏڽأتضأ+أڬلشأًأغؽۏتىأ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأذعشحأعوتوأڬەأوزۏىۄأوىًشۄأوۏڽأإىەأڬتأحسڬشۄأحًأڬۏتأۄەأحتۄوأتىأزًىًڽأوۏڽأضەأڬضۏأىەأثہۏأتضأحلظۏهأڬەأضتحہأذزۏخأىمهأىۄۏڽأڬۏأۗأۏۄأذزۏخأظذۏذأۄەأۗ%أ",""
"4381","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأزضأۄدشۏأڬًأذدأتزتأڬۏتأتًشأإځأىەأذدأتلشتزأڬۏتأۗأ"
"4382","%أذعشحأضلۏتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأۄدشحأضەأځۄهەأوحؼززأذدأڬةەأتًشأۄدشحأڬەأثؼزأظشلأذدۆأتهًزتؼأڬۏتأۗأتًشأإځأتۏڬأضًأتًىټأمشثتىۏأڬەأهةەأضتحہأهتةەأحہەأدىأڬەأىتڬأوۏڽأډتىزۏأڬۏأىڬۏهۏڽأحہۏڽأۗأىثۏأتڬشوأ﷽أىەأ96أتًىټأرًزأتځىەأۄتحہأضەأىذشأڬةەأتًشأثتمۏأذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأىذشأڬةەأ؏أخًشۏأضەأځًډہتأڲۏتأ=أۏۄأذزۏخأحوۄۏڽأڬضأىەأثحتةۏأآأحًأتىۄًڽأىەأثحتۏتأ=أتوتوأدؼلشأظتزمأىەأتځىەأًتهزأ+أتوتوأثتمشأ"
"أٰٰأتوتوأذتڬوأڬۄحەأۄۏڽأ=أًۄأتذتزۏخأوتخًشۄأدىأوۏڽأذدۆأتهًزتؼأڬۏأحلظۏهأوًدًزأۄەأدىأڬًأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأىمهأڬۏتأۄەأ؏أتىأڬۏأضىزۏڽأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄۏڽأۗأتىأحوتوأوۏڽأضثأضەأدتوؼأشًتۏحأًۄأۄەأدًأدتثشأثىأوذوزأظتزمأىەأتځىەأًتهزأڬەأًتضغەأضەأذعشحأدتثشأشعۏأتههۄأؼىۄأضەأىمهأڬۏأۄەأۗأدضأڬًأظشلأتوتوأوضهوأثىأذدتدأشذوۆأتههۄأؼهۏۄأىەأىمهأڬۏتأۄەأتًشأۄوأتههۄأڬەألعهأًأڬشوأتًشأتضأڬۏأوززأضەأشضًهأتههۄأ﷽أڬۏأوشعأتهًلتحأڬەأإؽتصأ+أضەأوحؼهمأشًتۏتحأ","أحڬأإأځۄىډەأۄۏڽأۗ%أ"
"4383","%أشضًهأتههۄأ﷽أڬەأؽهتوأذعشحأتثًوًۏۄثۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أتۏڬأشتحأشضًهأتههۄأ﷽أوۏشەأځتضأحطشۏلأهتةەأتًشألشوتۏتأ=أتەأتثًوًۏۄثۄأ$أډهًأتضحؽلتشأڬشًأڬۏًىڬۄأودہەأذڬوأوهتأۄەأڬۄأوۏڽأتىأثمۏؼأًتهًڽأڬەأهةەأتضحؽلتشأڬشًڽأۗأوۏڽأإځأڬەأۄوشتۄأډهأځڔتأ؏أدثأإځأثمۏؼأوثتشڬأوۏڽأځۄىډەأحًأڬۄتأ=أتهضهتوأؼهۏڬوأۏتأتۄهأتهثمۏؼأۗأحوأدضأذتهأوۏڽأۄًأ؏أحوۄۏڽأًۄتڽأرًطأشۄىتأډتۄةەأتڲشأحوأدتىأهًأڬۄأتههۄأحؼتهۏٳأىەأحوۄۏڽأڬحىەأثڔەألحىًڽأضەأثډتأهۏتأۄەأ؏أتىزہۏشۏأشتحأڬۏأغشذألحىەأإأشۄەأۄۏڽأۗأتًشأۏڬەأثؼزأزۏڲشەأوضهضهألحىەأۄۏألحىەأۄۏڽأۗأځہشألشوتۏتأ=أتثًوًۏۄثۄأ$أتههۄأحؼتهۏٳأىەأودہەأترحۏتشأزۏتأۄەأڬۄأډتۄەأحًأوۏڽأصوۏىأڬەأرصتىەأهەأهًڽأتًشأوۏڽأتضأوۏڽأۄوۏطۄأشۄىتأهەأهًڽأتًشأځہشأتضأڬەأثؼزأدىحأهەأهًڽأۏتأتځىەأشثأضەأوهتمتحأڬشأهًڽأۗأوۏڽأىەأڬۄتأ=أوۏشەأوتڽأثتځأإځأځشأمشثتىأۄًأدتةۏڽأ؏أإځأصوۏىأڬەأرصتىەأ؏أتىأڬۏأۄوۏطڲۏأتًشأدىحأهەأهۏڽأۗأإځأىەألشوتۏتأ=أتەأتثًوًۏۄثۄأ$أوۏڽأىەأتځىەأشثأڬۏأوهتمتحأترحۏتشأڬشأهۏأ؏أځہشأإځأىەأتۄهأثمۏؼأڬەأهةەأزؼتةەأوؽلشحألشوتةۏأۗأځہشأًتځضأحطشۏلأهەأإةەأۗأتضأضەأتڲهەأزىأإځأ﷽أڬۏأتضأثۏوتشۏأڬتأإؽتصأۄًتأدضأوۏڽأإځأ﷽أڬتأًظتهأۄًتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتىۄًڽأىەأزشدأسۏهأضىزأڬًأځضىزألشوتۏتأۄەأۗ%أ",""
"4384","أوسڬًشۄأضىزأڬەأۄوشتۄأثہۏأۏۄأذزۏخأوشًۏأۄەأۗأ"
"4385","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أذعشحأوۏوًىۄأشعۏأتههۄأؼىۄتأڬەأڲہشأشضًهأتههۄأ﷽أڬًأًۄأوشعأطشًؼأۄًةۏأدضأوۏڽأإځأڬتأتىحمتهأۄًتأۗأإځأتځىتأضشأهځۏټأڬشأزًأإزوۏًڽأڬەأزشوۏتىأ+أتىأڬتأضۄتشتأهەأڬشأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ",""
"أًلتحأڬەأزىأشضًهأتههۄأ﷽أڬۏأؼوشأوثتشڬأڬحىەأزىأحہۏأ؏أتضأضهضهەأوۏڽأتضأضەأځۄهەأۄوأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬتأترحهتلأسڬشأڬشأډڬەأۄۏڽأۗ%أ",""
"4386","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬۏأًلتحأڬتأوىػشأزۏڬہتأۄەأۗأإځأڬەأمشۏثأځتىۏأڬتأتۏڬأځۏتهۄأحہتأ؏أإځأتضأوۏڽأتځىتأۄتحہأڋتهأڬشأتځىەأډۄشەأځشأځہۏشحەأتًشأڬۄحەأ=““أتەأتههۄأ$أحًأضڬشتحأتهوًحأوۏڽأوۏشۏأوززألشوتأ‛‛"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4387","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أڬتأإرشۏأڬهتوأۏۄأحہتأ““أ®دهتهأشثۏأتهشلۏؼألمزأثهؽح¾أ‛‛أوۏشەأثهىزأًأثشحشأشثأڬەأدهتهأڬۏأمضوأ$أوۏڽأىەأ+أتضأڬەأحوتوأتذڬتوأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأوڲشأۏۄأ+أذضۏىأثىأؼهۏأثىأؼثزتهظوزأ","ألتشضۏأتضأضىزأوۏڽأوذوزأثىأؼثزتهتؼهۏٳأځشأًتۄوأ+أؽهغۏتڽأڬشىەأًتهتأ"
"4388","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأذعًشأ﷽أڬۏأًلتحأڬتأًمحأمشۏثأحہتأحًأإځأڬۏأضثأضەأإرشۏأًظۏحأۏۄأحہۏأ؏أىوتصأ؏أىوتصأ؏أ+أشتًۏأڬۄحەأۄۏڽأ=أ"
"أٰٰأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأۏۄأذزۏخأثہۏأىمهأڬۏأۄەأتًشأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأڬۏأًۄأذزۏخأثہۏأىمهأڬۏأۄەأڬۄأإځأڬەأإرشۏأتهلتػأۏۄأحہەأ““أتهشلۏمأتهتؼهۏٳأ‛‛%أ",""
"4389","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدضأزىأشضًهأتههۄأ﷽أڬۏأًلتحأۄًةۏأتضأزىأوزۏىەأوۏڽأۄشأډۏصأحتشۏڬۏأوۏڽأڋًثأڲةۏأحہۏأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4390","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأًۄأزىأزۏڬہتأۄەأدضأوۏڽأشضًهأتههۄأ﷽أڬۏأًلتحأۄًةۏأۄەأ؏أوۏڽأىەأإدأحڬأتۏضتأمثۏذأ+أحڬهۏلأزۄأتًشأىتځضىزۏزۄأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4391","%أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬتأتىحمتهأۄًتأحًألشطحًڽأىەأإځأڬًأڲہۏشأهۏتأۗأهًڲًڽأڬًأتىأڬۏأوًدًزڲۏأڬتأتذضتضأحًأۄًحتأحہتأهۏڬىأًۄأىػشأىۄۏڽأإأشۄەأحہەأۗألشطحًڽأىەأتۄهأرتىۄأڬًأضهتوأڬەأثؼزأڬۄتأ=أثەأطڬأتههۄأحؼتهۏٳأۄشأوظۏثحأځشأضۄتشتأزۏحتأۄەأتًشأۄشألًحأطزۄأڬتأىؼوأتهثزهأزۏحتأۄەأۗأحوأتىأڬًأتههۄأڬەأذًتهەأڬشأزًأتًشأتضأڬۏأثتشڲتۄأضەأرۏشأڬۏأتوۏزأشڬہًأۗأڬۏًىڬۄأوذشًوأحًأًۄأۄەأدًأخًتثأضەأوذشًوأشۄتأۗأًتهضهتوأؼهۏڬوأًشذوۆأتههۄأًثشڬتحۄأۗ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4392","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬتأتىحمتهأۄًتأحًأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأىەأإځأڬًأډتشًڽأغشلأضەأڲہۏشأهۏتأ؏أدثأضثأدوؼأۄًأڲةەأتًشأشًىەأهڲەأحًأتۏڬأإزوۏأًۄتڽأځشأإۏتأدضأڬۏأزتڔہۏأضشرۏأوتةهأضلۏزأحہۏأ؏أثۄحأرًثظًشحأتًشأدضۏوأإزوۏأحہتأۗأۏۄأهًڲًڽأڬۏأڲشزىۏڽأځہهتىڲحتأۄًتأإۏتأتًشأرًزأثہۏأشًأزۏتأ؏أځہشأۏۄأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأڬۏأدتىثأوحًدۄأۄًأڬشأثًهتأ=أثەأطڬأتههۄأحؼتهۏٳأۄشأوظۏثحأوۏڽأضۄتشتأزۏحتأۄەأ؏أۄشأعتةؼأۄًىەأًتهۏأډۏصأڬتأؼًعأزۏحتأۄەأتًشأۄشألًحأۄًىەأًتهەأڬتأىتةثأثىتحتأۄەأ؏أځضأحوأتههۄأۄۏأڬۏأغشلأشدًؼأڬشًأتًشأتضۏأڬۏأغشلأحًدۄأشڬہًأ؏أًۄأإصوتةطأوۏڽأحوۄتشەأتًځشأىڲتۄأڬشوأڬشەأڲتأۗأتًشأحوأؽًشأڬشًأ؏أڬۄأوظۏثحأصزۄأحًأًۄأۄەأدضأڬەأىمظتىأڬۏأحهتلۏأىۄأۄًأۗأځہشأًۄأډهتأڲۏتأ؏أحًأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأتۏڬأزًضشەأضەأڬۄىەأهڲەأ=أڬۏتأحوأهًڲأتضأإزوۏأڬًأدتىحەأۄًأآأحًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أدۏأۄتڽأۗأۏۄأشضًهأتههۄأ﷽أڬەأثہتةۏأذعشحأرعشأؼهۏۄأتهضهتوأۄۏڽأۗ"
"أٰٰأۏۄأذزۏخأڲصطحۄأذزۏخأڬۏأطتۄزأۄەأتڲشډۄأؼثتزأثىأؼثزتهظوزأتضأڬحتثأڬەأوؼۏتشأڬەأشتًۏأىۄۏڽأۄۏڽأۗ%أ",""
"4393","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أوشعأتهوًحأوۏڽألشوتۏتأڬشحەأحہەأ=أتەأؼتةطۄأشعۏأتههۄأؼىۄتأ$أودہەأصۄشأڬتأستةمۄأوذضًضأۄًأشۄتأۄەأدًأرۏثشأوۏڽأودہەأڬہهتۏتأڲۏتأحہتأتًشأتضأًمحأتضۏأصۄشأڬەأتخشأڬۏأًدۄأضەأوۏشۏأطۄأشڲأڬټحۏأدتأشۄۏأۄەأۗ"
"أٰٰأۏۄأذزۏخأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأڬەأوؼۏتشأڬەأوغتثمأۄەأتًشأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأۏًىضأڬەأذًتهەأضەأىمهأڬۏتأۄەأۗ%أ",""
"4394","%أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىًأوشحثۄأۏۄأمضوأڬہتاڽأڬۄأشضًهأتههۄأ﷽أڬًأطۄۏزأڬۏتأڲۏتأحہتأۏۄأودہەأصۏتزۄأوذثًثأۄەأثۄأىضثحأتضأڬەأڬۄأوۏڽأتۏڬأوشحثۄأۏۄأمضوأڬہتاڽأڬۄأإځأڬًأطۄۏزأىۄۏڽأڬۏتأڲۏتأحہتأۗأتضأڬۏأًدۄأۏۄأۄەأڬۄأتههۄأحؼتهۏٳأىەأتىأڬًأتځىتأىثۏأثىتۏتأۄەأتًشأتىأڬًأطۄۏزأثىتۏتأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4395","أذعشحأطؼثۏألشوتحەأۄۏڽأ=أرزتأڬۏأمضوأ$أشضًهأتههۄأ﷽أڬًأصۄشأزۏتأڲۏتأۗأذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأڬًأصۄشأزۏتأڲۏتأۗأذعشحأؼوشأشعۏأتههۄأؼىۄأڬًأطۄۏزأڬۏتأڲۏتأۗأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬًأطۄۏزأڬۏتأڲۏتأۗأذعشحأؼهۏأتثىأتثۏأغتهثأشعۏأتههۄأؼىۄأڬًأطۄۏزأڬۏتأڲۏتأۗأذعشحأذضىأثىأؼهۏأشعۏأتههۄأؼىۄأڬًأطۄۏزأڬۏتأڲۏتأۗأذعشحأذضۏىأثىأؼهۏأشعۏأتههۄأؼىۄوتأڬًأثہۏأطۄۏزأڬۏتأڲۏتأۗأحًأتىأڬەأثؼزأۄوأڬۏتأ+أرۏشأڬۏأ"
"4396","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أذعشحألتغوۄأثىحأشضًهأتههۄأ﷽أىەأشضًهأتههۄأ﷽أځشأشًحەأۄًةەأڬۄتأ=أتەأوۏشەأتثتأدتىأ$أإځأتځىەأشثأڬەأځتضأډهەأڲةەأۗأتەأوۏشەأتثتأدتىأ$أدثشۏهأتوۏىأؼهۏۄأتهضهتوأىەأۏۄأرثشأضىتةۏأۄەأۗأتەأوۏشەأتثتأدتىأ$أدىحأتهلشزًضأإځأڬتأټہڬتىۄأۄەأۗ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4397","%أذعشحأؼهۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأشضًهأتههۄأ﷽أڬًأؽضهأزۏتأ؏أوۏڽأىەأإځأوۏڽأؼتوأوۏحًڽأڬۏأغشذأڬًةۏأ+أثتؼخأىلشحأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4398","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أۄوأىەأدثأشضًهأتههۄأ﷽أڬًأؽضهأزۏىەأڬتأتشتزۄأڬۏتأحًأهًڲًڽأوۏڽأتضأثتحأځشأترحهتلأۄًأڲۏتأڬۄأؼتوأوۏحًڽأڬۏأغشذأإځأڬەأڬځڔەأتحتشەأدتةۏڽأۏتأإځأڬًأڬځڔًڽأضوۏحأؽضهأزۏتأدتةەأۗأتههۄأحؼتهۏٳأىەأتىأځشأتًىڲہأغتشۏألشوتأزۏأحًأۄشأطرظأتځىۏأټہًڔۏأتځىەأضۏىەأځشأشڬہەأۄًةەأضًأڲۏتأۗأحًأذدشەأڬەأتىزشأضەأتۏڬأإًتصأزۏىەأًتهەأىەأإًتصأزۏأ““أحوۄۏڽأوؼهًوأىۄۏڽأۄەأڬۄأتههۄأڬەأشضًهأ﷽أڬًأڬځڔًڽأضوۏحأؽضهأزۏتأدتحتأۄەأ‛‛أډىتىډۄأتىأهًڲًڽأىەأإځأڬًأتضأذتهأوۏڽأؽضهأزۏتأڬۄأموۏظأإځأڬەأدضوأځشأۄۏأحہۏأۗأًۄأځتىۏأڋتهأڋتهأڬشأموۏظأڬەأتًځشأضەأۄۏأوهحەأشۄەأۗأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أرزتأڬۏأمضوأ$أتڲشأوۏڽأتځىۏأثتحأوىًتحۏأحًأوۏڽأځۏډہەأىۄأشۄحۏأۗأشضًهأتههۄأ﷽أڬًأتىأڬۏأتصًتدأوغۄشتحأىەأؽضهأزۏتأحہتأۗ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"4399","%أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدثأشضًهأتههۄأ﷽أڬتأإرشۏأًمحأإۏتأحًأۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أإځأڬۏأىوتصۄأدىتصۄأڬًىأځڔہتةەأآأحًأإځأشًأځڔەأ؏أتًشأۄوأهًڲأثہۏأشًأځڔەأۗأإځأؼهۏۄأتهضهتوأىەألشوتۏتأ=أذًظهۄأڬشًأ؏أتههۄأحؼتهۏٳأحوۄتشۏأوؽلشحألشوتةەأ؏أتًشأحوۄتشەأىثۏأڬەأظزمەأحوۄۏڽأدصتةەأرۏشأزەأ؏أدثأحوأودہەأؽضهأتًشأڬلىأًؽۏشۄأزەأڬشأودہەأحۏتشأڬشأډڬًأحًأودہەأوۏشۏأمثشأڬۏأهذزأوۏڽأتحتشأزۏىتأۗأځہشأڬډہأزۏشأڬەأثؼزأودہەأًۄتڽأضەأىڬتهأهۏىتأۗأضثأضەأځۄهەأوۏشتأدىتصۄأوۏشەأزًضحأذعشحأدثشتةۏهأؼهۏۄأتهضهتوأځڔہۏڽأڲەأ؏أځہشأذعشحأوۏڬتةۏهأؼهۏۄأتهضهتوأځڔہۏڽأڲەأ؏أځہشأذعشحأتضشتلۏهأؼهۏۄأتهضهتوأځڔہۏڽأڲەأ؏أځہشأوهڬأتهوًحأؼهۏۄأتهضهتوأوهتةڬۄأڬۏأدوتؼحًڽأڬەأۄوشتۄأوۏشتأدىتصۄأځڔہۏڽأڲەأ؏أځہشأضثأضەأځۄهەأوۏشەأڲہشأًتهًڽأوۏڽأضەأوشزأذعشتحأوۏشتأدىتصۄأځڔہۏڽأڲەأ؏أځہشأتىأڬۏأؼًشحۏڽأځہشأحوأدوتؼحأزشأدوتؼحأتًشأتڬۏهەأتڬۏهەأ+أدۏضەأثہۏأثىأځڔەأ"
"أٰٰأتضأضىزأوۏڽأدًأؼثزتهوهڬأثىأؼثزتهشذوىأۄۏڽأۏۄأودۄًهأۄۏڽأ؏أتىأڬۏأؼزتهحأتًشأدشذأڬەأوحؼهمأۄوأڬډہأىۄۏڽأدتىحەأۗأحتۄوأثتمۏأحوتوأشتًۏأخمۄأۄۏڽأۗ%أ",""
"4400","%أتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أوۏڽأىەأرًتثأوۏڽأزۏڬہتأڬۄأحۏىأډتىزأوۏشەأذدشەأوۏڽأإىأڲشەأۄۏڽأۗأوۏڽأىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأضەأتضأڬۏأحؼثۏشأځًډہۏأحًأتىۄًڽأىەأدًتثأزۏتأ=أتەأؼتةطۄأ$أتڲشأحۏشتأرًتثأضډتأۄًأڲۏتأحًأحۏشەأذدشەأوۏڽأحۏىأإزوۏأدًأشًةەأصوۏىأوۏڽأضثأضەأتلعهأۄۏڽأ؏أزلىأۄًڽأڲەأځہشأدثأشضًهأتههۄأ﷽أڬتأتىحمتهأۄًتأتًشأتىأڬًأ+أوۏشەأذدشەأوۏڽأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأتًشأتضأذزۏخأڬًأۄوأىەأذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬەأذًتهەأضەأوضىزتَأثہۏأهڬہتأۄەأۗ%أ",""
"4401","أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أىثۏأتڬشوأ﷽أرًتثًڽأڬًأثۄحأځضىزأڬشحەأحہەأۗأإځأځًډہتأڬشحەأحہەأڬۄأإدأحوأوۏڽأضەأڬضۏأىەأڬًةۏأرًتثأزۏڬہتأۄەأآأحًأتوأتهوًوىۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأىەأڬۄتأ=أوۏڽأىەأرًتثأزۏڬہتأڬۄأوۏشەأذدشەأوۏڽأحۏىأډتىزأتأٖڲشەأۄۏڽأۗأحًأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتڲشأحۏشتأرًتثأضډتأۄًتأحًأحۏشەأذدشەأوۏڽأحۏىأإزوۏأزلىأۄًڽأڲەأدًأځًشۏأشًةەأصوۏىأضەأتلعهأۄًڽأڲەأۗأدثأىثۏأتڬشوأ﷽أڬتأتىحمتهأۄًتأتًشأتىأڬًأوۏشەأذدشۄأوۏڽأزلىأڬۏتأڲۏتأحًأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأىەأودہأضەأڬۄتأ=أۏۄأحۏشەأتىأډتىزًڽأوۏڽأضەأتۏڬأۄەأۗأتًشأۏۄأتىأضثأضەأتلعهأۄەأۗأځہشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأثہۏأثؼزأتصأًلتحأتضۏأذدشەأوۏڽأزلىأڬةەأڲةەأۗأ"
"4402","%أتوأتهوًوۏىأذعشحأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أدضأذدشۄأوۏڽأشضًهأتههۄأ﷽أوزلًىأۄۏڽأ؏أوۏڽأتضأوۏڽأڲہشأڬەأؼتوأڬځڔًڽأوۏڽأډهۏأدتحۏأحہۏأتًشأوۏڽأضًډحۏأحہۏأڬۄأۏۄأحًأوۏشەأطًۄشأۄۏڽأتًشأ+أزًضشەأۏؼىۏأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأشذوۆأتههۄأؼهۏۄوتأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""