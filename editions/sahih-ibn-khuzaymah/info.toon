sections[1073]{id,name,name_ar,name_bn,name_en,name_fr,name_id,name_ru,name_tr,name_ur,hadith_first,hadith_last,arabic_first,arabic_last}:
"1","صحيح ابن خزيمة","","","","","","","","صحيح ابن خزيمة","1","1","1","1"
"2","بَابُ ذِكْرِ فَضَائِلِ الْوُضُوءِ يَكُونُ بَعْدَهُ صَلَاةٌ مَكْتُوبَةٌاس","بَابُ ذِكْرِ فَضَائِلِ الْوُضُوءِ يَكُونُ بَعْدَهُ صَلَاةٌ مَكْتُوبَةٌاس","","","","","","","وضو کے فضائل کا بیان جس کے بعد فرض نماز ادا کی جائے","2","2","2","2"
"3","بَابُ ذِكْرِ فَضْلِ الْوُضُوءِ ثَلَاثًا ثَلَاثًا يَكُونُ بَعْدَهُ صَلَاةُ تَطَوُّعٍ، لَا يُحَدِّثُ الْمُصَلِّي فِيهَا نَفْسَهُاس","بَابُ ذِكْرِ فَضْلِ الْوُضُوءِ ثَلَاثًا ثَلَاثًا يَكُونُ بَعْدَهُ صَلَاةُ تَطَوُّعٍ، لَا يُحَدِّثُ الْمُصَلِّي فِيهَا نَفْسَهُاس","","","","","","","وضو کی فضیلت کا بیان جس میں اعضاء تین تین بار دھوئے جائیں، اور نفلی نماز ادا کی جائے جس میں نمازی اپنے نفس سے بات چیت نہ کرے","3","3","3","3"
"4","بَابُ ذِكْرِ حَطِّ الْخَطَايَا بِالْوُضُوءِ مِنْ غَيْرِ ذِكْرِ صَلَاةٍ تَكُونُ بَعْدَهُبغیر","بَابُ ذِكْرِ حَطِّ الْخَطَايَا بِالْوُضُوءِ مِنْ غَيْرِ ذِكْرِ صَلَاةٍ تَكُونُ بَعْدَهُبغیر","","","","","","","نماز پڑھے، صرف وضو ہی سے گناہ معاف ہونے کا بیان","4","4","4","4"
"5","بَابُ ذِكْرِ حَطِّ الْخَطَايَا، وَرَفْعِ الدَّرَجَاتِ فِي الْجَنَّةِ بِإِسْبَاغِ الْوُضُوءِ عَلَى الْمَكَارِهِ، وَإِعْطَاءِ مُنْتَظِرِ الصَّلَاةِ بَعْدَ الصَّلَاةِ أَجْرَ الْمُرَابِطِ فِي سَبِيلِ اللَّهِمشقت","بَابُ ذِكْرِ حَطِّ الْخَطَايَا، وَرَفْعِ الدَّرَجَاتِ فِي الْجَنَّةِ بِإِسْبَاغِ الْوُضُوءِ عَلَى الْمَكَارِهِ، وَإِعْطَاءِ مُنْتَظِرِ الصَّلَاةِ بَعْدَ الصَّلَاةِ أَجْرَ الْمُرَابِطِ فِي سَبِيلِ اللَّهِمشقت","","","","","","","اور تکلیف کے باوجود مکمل وضو کرنے سے گناہوں کے معاف ہونے، جنت میں درجات کی بلندی اور ایک نماز کے بعد دوسری نماز کا انتظار کرنے والے کو جہاد فی سبیل اللہ کرنے والے کے برابر ثواب دیے جانے کا بیان","5","5","5","5"
"6","بَابُ ذِكْرِ عَلَامَةِ أُمَّةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ جَعَلَهُمُ اللَّهُ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ بِآثَارِ الْوُضُوءِ يَوْمَ الْقِيَامَةِ، عَلَامَةً يُعْرَفُونَ بِهَا فِي ذَلِكَ الْيَوْمِ.نبی","بَابُ ذِكْرِ عَلَامَةِ أُمَّةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ جَعَلَهُمُ اللَّهُ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ بِآثَارِ الْوُضُوءِ يَوْمَ الْقِيَامَةِ، عَلَامَةً يُعْرَفُونَ بِهَا فِي ذَلِكَ الْيَوْمِ.نبی","","","","","","","کریم صلی اللہ علیہ وسلم کی امت، جسے اللہ تعالیٰ نے بہترین امت بنایا اور انہیں لوگوں کی بھلائی کے لیے پیدا کیا ہے، کی نشانی قیامت کے روز آثار وضو ہو گی جس سے وہ پہچانے جائیں گے","6","6","6","6"
"7","بَابُ اسْتِحْبَابِ تَطْوِيلِ التَّحْجِيلِ بِغَسْلِ الْعَضُدَيْنِ فِي الْوُضُوءِ إِذِ الْحِلْيَةُ تَبْلُغُ مَوَاضِعَ الْوُضُوءِ يَوْمَ الْقِيَامَةِ بِحُكْمِ النَّبِيِّ الْمُصْطَفَى صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَوضو میں   «عَضُدَين»","بَابُ اسْتِحْبَابِ تَطْوِيلِ التَّحْجِيلِ بِغَسْلِ الْعَضُدَيْنِ فِي الْوُضُوءِ إِذِ الْحِلْيَةُ تَبْلُغُ مَوَاضِعَ الْوُضُوءِ يَوْمَ الْقِيَامَةِ بِحُكْمِ النَّبِيِّ الْمُصْطَفَى صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَوضو میں   «عَضُدَين»","","","","","","","(کندھے اور کہنی کے درمیان کے حصے تک بازو) دھو کر تجیل کو لمبا کرنا مستحب ہے کیونکہ نبی صلی اللہ علیہ وسلم کے حکم (پر عمل کرنے) کی وجہ سے قیامت کے روز (مؤمن کا) زیور وضو کے مقامات تک پہنچے گا","7","7","7","7"
"8","بَابُ نَفْيِ قَبُولِ الصَّلَاةِ بِغَيْرِ وُضُوءٍ، بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسِّرٍ.وضو","بَابُ نَفْيِ قَبُولِ الصَّلَاةِ بِغَيْرِ وُضُوءٍ، بِذِكْرِ خَبَرٍ مُجْمَلٍ غَيْرِ مُفَسِّرٍ.وضو","","","","","","","کے بغیر نماز قبول نہیں ہوتی، اس کے متعلق مجمل غیر مفسر حدیث کا بیان","8","10","8","10"
"9","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَا،گذشتہ","بَابُ ذِكْرِ الْخَبَرِ الْمُفَسِّرِ لِلَّفْظَةِ الْمُجْمَلَةِ الَّتِي ذَكَرْتُهَا،گذشتہ","","","","","","","مجمل روایت کی مفسر روایت کا بیان","11","130","11","130"
"100","بَابُ الْأَمْرِ بِتَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ تَخْمِيرِ الْأَوَانِي، وَالْعِلَّةُ الَّتِي مِنْ أَجْلِهَا أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَخْمِيرِ الْإِنَاءِبرتنوں","بَابُ الْأَمْرِ بِتَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ تَخْمِيرِ الْأَوَانِي، وَالْعِلَّةُ الَّتِي مِنْ أَجْلِهَا أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِتَخْمِيرِ الْإِنَاءِبرتنوں","","","","","","","کو ڈھانپتے وقت بسم اللہ پڑھنے کا حکم ہے اور اس علت کا بیان جس کی وجہ سے نبی کریم صلی اللہ علیہ وسلم نے برتن ڈھانپنے کا حکم دیا ہے","131","133","131","133"
"102","بَابُ بَدْءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالسِّوَاكِ عِنْدَ دُخُولِ مَنْزِلِهِنبی","بَابُ بَدْءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالسِّوَاكِ عِنْدَ دُخُولِ مَنْزِلِهِنبی","","","","","","","اکرم صلی اللہ علیہ وسلم کا اپنے گھر داخل ہوتے وقت مسواک سے ابتداء کرنا","134","134","134","134"
"103","بَابُ فَضْلِ السِّوَاكِ وَتَطْهِيرِ الْفَمِ بِهِمسواک","بَابُ فَضْلِ السِّوَاكِ وَتَطْهِيرِ الْفَمِ بِهِمسواک","","","","","","","کی فضیلت اور اس سے منہ صاف کرنے کا بیان۔","135","135","135","135"
"104","بَابُ اسْتِحْبَابِ التَّسَوُّكِ عِنْدَ الْقِيَامِ مِنَ النَّوْمِ لِلتَّهَجُّدِتہجد","بَابُ اسْتِحْبَابِ التَّسَوُّكِ عِنْدَ الْقِيَامِ مِنَ النَّوْمِ لِلتَّهَجُّدِتہجد","","","","","","","کے لیے نیند سے بیدار ہوکر مسواک کرنا مستحب ہے۔","136","136","136","136"
"105","بَابُ فَضْلِ السِّوَاكِ وَتَضْعِيفِ فَضْلِ الصَّلَاةِ الَّتِي يُسْتَاكُ لَهَا عَلَى الصَّلَاةِ الَّتِي لَا يُسْتَاكُ لَهَا- إِنْ صَحَّ الْخَبَرُجس","بَابُ فَضْلِ السِّوَاكِ وَتَضْعِيفِ فَضْلِ الصَّلَاةِ الَّتِي يُسْتَاكُ لَهَا عَلَى الصَّلَاةِ الَّتِي لَا يُسْتَاكُ لَهَا- إِنْ صَحَّ الْخَبَرُجس","","","","","","","نماز کے لیے مسواک کی جائے وہ اس نماز سے افضل ہے جس کے لیے مسواک نہ کی جائے، بشرطیکہ اس سلسلے میں مذکورہ حدیث صحیح ہو","137","137","137","137"
"106","بَابُ الْأَمْرِ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ أَمْرُ نَدْبٍ وَفَضِيلَةٍ لَا أَمْرُ وُجُوبٍ وَفَرِيضَةٍہر","بَابُ الْأَمْرِ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ أَمْرُ نَدْبٍ وَفَضِيلَةٍ لَا أَمْرُ وُجُوبٍ وَفَرِيضَةٍہر","","","","","","","نماز کے وقت مسواک کرنے کا حکم استجاب اور فضیلت کے لیے ہے۔ وجوبی یا فرضی حکم نہیں","138","138","138","138"
"107","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْأَمْرَ بِالسِّوَاكِ أَمْرُ فَضِيلَةٍ لَا أَمْرُ فَرِيضَةٍاس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْأَمْرَ بِالسِّوَاكِ أَمْرُ فَضِيلَةٍ لَا أَمْرُ فَرِيضَةٍاس","","","","","","","بات کی دلیل کا بیان کہ مسواک کرنے کا حکم افضلیت کے لیے فرضیت کے لیے نہیں","139","140","139","140"
"108","بَابُ صِفَةِ اسْتِيَاكِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنبی","بَابُ صِفَةِ اسْتِيَاكِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنبی","","","","","","","اکرم صلی اللہ علیہ وسلم کے مسواک کرنے کی کیفیت کا بیان","141","141","141","141"
"109","بَابُ إِيجَابِ إِحْدَاثِ النِّيَّةِ لِلْوُضُوءِ وَالْغُسْلِوضو","بَابُ إِيجَابِ إِحْدَاثِ النِّيَّةِ لِلْوُضُوءِ وَالْغُسْلِوضو","","","","","","","اور غسل کے لئے نیت کرنا واجب ہے","142","143","142","143"
"110",")- بَابُ ذِكْرِ تَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ الْوُضُوءِوضو",")- بَابُ ذِكْرِ تَسْمِيَةِ اللَّهِ- عَزَّ وَجَلَّ- عِنْدَ الْوُضُوءِوضو","","","","","","","کرتے وقت بسم اللہ پڑھنی چاہیے","144","144","144","144"
"111","بَابُ الْأَمْرِ بِغَسْلِ الْيَدَيْنِ ثَلَاثًا، عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ.نیند","بَابُ الْأَمْرِ بِغَسْلِ الْيَدَيْنِ ثَلَاثًا، عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ.نیند","","","","","","","سے بیدار ہوکر دونوں ہاتھوں کو کسی برتن میں ڈالنے سے پہلے تین مرتبہ دھونے کا حکم ہے","145","145","145","145"
"112","بَابُ كَرَاهَةِ مُعَارَضَةِ خَبَرِ النَّبِيِّ- عَلَيْهِ السَّلَامُ- بِالْقِيَاسِ وَالرَّأْيِقیاس","بَابُ كَرَاهَةِ مُعَارَضَةِ خَبَرِ النَّبِيِّ- عَلَيْهِ السَّلَامُ- بِالْقِيَاسِ وَالرَّأْيِقیاس","","","","","","","اور شخصی رائے کے ساتھ نبی اکرم صلی اللہ علیہ وسلم کی حدیث کی مخالفت کرنا مکروہ ہے","146","146","146","146"
"113","بَابُ صِفَةِ غَسْلِ الْيَدَيْنِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ. وَصِفَةِ وُضُوءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.دونوں","بَابُ صِفَةِ غَسْلِ الْيَدَيْنِ قَبْلَ إِدْخَالِهِمَا الْإِنَاءَ. وَصِفَةِ وُضُوءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.دونوں","","","","","","","ہاتھوں کو برتن میں ڈالنے سے پہلے انہیں دھونے کی کیفیت اور نبی اکرم صلی اللہ علیہ وسلم کے وضو کے طریقے کا بیان","147","147","147","147"
"114","بَابُ إِبَاحَةِ الْمَضْمَضَةِ وَالِاسْتِنْشَاقِ مِنْ غَرْفَةٍ وَاحِدَةٍ، وَالْوُضُوءُ مَرَّةً مَرَّةًایک ہی چُلّو","بَابُ إِبَاحَةِ الْمَضْمَضَةِ وَالِاسْتِنْشَاقِ مِنْ غَرْفَةٍ وَاحِدَةٍ، وَالْوُضُوءُ مَرَّةً مَرَّةًایک ہی چُلّو","","","","","","","سے کلی کرنا اور ناک میں پانی ڈالنا جائز ہے اور اعضائے وضو ایک ایک مرتبہ دھونا جائز ہے","148","148","148","148"
"115","بَابُ الْأَمْرِ بِالِاسْتِنْشَاقِ عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ، وَذِكْرُ الْعِلَّةِ الَّتِي مِنْ أَجْلِهَا أَمَرَ بِهِنیند","بَابُ الْأَمْرِ بِالِاسْتِنْشَاقِ عِنْدَ الِاسْتِيقَاظِ مِنَ النَّوْمِ، وَذِكْرُ الْعِلَّةِ الَّتِي مِنْ أَجْلِهَا أَمَرَ بِهِنیند","","","","","","","سے بیدار ہوکر ناک صاف کرنے کے حکم اور اس علت کا بیان جس کی وجہ سے حکم دیا گیا ہے","149","149","149","149"
"116","بَابُ الْأَمْرِ بِالْمُبَالَغَةِ فِي الِاسْتِنْشَاقِ إِذَا كَانَ الْمُتَوَضِّئُ مُفْطِرًا غَيْرَ صَائِمٍوضو","بَابُ الْأَمْرِ بِالْمُبَالَغَةِ فِي الِاسْتِنْشَاقِ إِذَا كَانَ الْمُتَوَضِّئُ مُفْطِرًا غَيْرَ صَائِمٍوضو","","","","","","","کرنے والا اگر روزے دار نہ ہو تو وضو کرتے ہوئے ناک میں خوب اچھی طرح اس کو پانی چڑھانا چاہئے","150","150","150","150"
"117","بَابُ تَخْلِيلِ اللِّحْيَةِ فِي الْوُضُوءِ عِنْدَ غَسْلِ الْوَجْهِوضو","بَابُ تَخْلِيلِ اللِّحْيَةِ فِي الْوُضُوءِ عِنْدَ غَسْلِ الْوَجْهِوضو","","","","","","","میں چہرہ دھوتے وقت داڑھی کا خلال کرنا","151","152","151","152"
"118","بَابُ اسْتِحْبَابِ صَكِّ الْوَجْهِ بِالْمَاءِ عِنْدَ غَسْلِ الْوَجْهِ.چہرہ","بَابُ اسْتِحْبَابِ صَكِّ الْوَجْهِ بِالْمَاءِ عِنْدَ غَسْلِ الْوَجْهِ.چہرہ","","","","","","","دھوتے وقت چہرے کو پانی سے اچھی طرح ملنا مستحب ہے۔","153","153","153","153"
"119","بَابُ اسْتِحْبَابِ تَجْدِيدِ حَمْلِ الْمَاءِ لِمَسْحِ الرَّأْسِ غَيْرِ فَضْلِ بَلَلِ الْيَدَيْنِ.سر","بَابُ اسْتِحْبَابِ تَجْدِيدِ حَمْلِ الْمَاءِ لِمَسْحِ الرَّأْسِ غَيْرِ فَضْلِ بَلَلِ الْيَدَيْنِ.سر","","","","","","","کے مسح کے لیے دونوں ہاتھوں سے بچے ہوئے پانی کے علاوہ نیا پانی لینا مستحب ہے","154","154","154","154"
"120","بَابُ اسْتِحْبَابِ مَسْحِ الرَّأْسِ بِالْيَدَيْنِ جَمِيعًا لِيَكُونَ أَوْعَبَ لِمَسْحِ جَمِيعِ الرَّأْسِ، وَصِفَةِ الْمَسْحِ، وَالْبَدْءِ بِمُقَدَّمِ الرَّأْسِ قَبْلَ الْمُؤَخَّرِ فِي الْمَسْحِ.دونوں","بَابُ اسْتِحْبَابِ مَسْحِ الرَّأْسِ بِالْيَدَيْنِ جَمِيعًا لِيَكُونَ أَوْعَبَ لِمَسْحِ جَمِيعِ الرَّأْسِ، وَصِفَةِ الْمَسْحِ، وَالْبَدْءِ بِمُقَدَّمِ الرَّأْسِ قَبْلَ الْمُؤَخَّرِ فِي الْمَسْحِ.دونوں","","","","","","","ہاتھوں سے سر کا مسح کرنا مستحب ہے تاکہ سارے سر کا مسح ہوجائے، اور مسح کی کیفیت کا بیان، اور مسح پچھلی جاب سے پہلے پیشانی سے شروع کیا جائے گا","155","156","155","156"
"122","بَابُ مَسْحِ جَمِيعِ الرَّأْسِ فِي الْوُضُوءِوضو","بَابُ مَسْحِ جَمِيعِ الرَّأْسِ فِي الْوُضُوءِوضو","","","","","","","میں اپنے تمام سر کا مسح کرنا","157","157","157","157"
"124","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْكَعْبَيْنِ اللَّذَيْنِ أُمِرَ الْمُتَوَضِّئُ بِغَسْلِ الرِّجْلَيْنِ إِلَيْهِمَا الْعَظْمَانِ النَّاتِئَانِ فِي جَانِبَيِ الْقَدَمِ لَا الْعَظْمُ الصَّغِيرُ النَّاتِئُ عَلَى ظَهْرِ الْقَدَمِ، عَلَى مَا يَتَوَهَّمُهُ مَنْ يَتَحَذْلَقُ مِمَّنْ لَا يَفْهَمُ الْعِلْمَ، وَلَا لُغَةَ الْعَرَبِ.اس","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْكَعْبَيْنِ اللَّذَيْنِ أُمِرَ الْمُتَوَضِّئُ بِغَسْلِ الرِّجْلَيْنِ إِلَيْهِمَا الْعَظْمَانِ النَّاتِئَانِ فِي جَانِبَيِ الْقَدَمِ لَا الْعَظْمُ الصَّغِيرُ النَّاتِئُ عَلَى ظَهْرِ الْقَدَمِ، عَلَى مَا يَتَوَهَّمُهُ مَنْ يَتَحَذْلَقُ مِمَّنْ لَا يَفْهَمُ الْعِلْمَ، وَلَا لُغَةَ الْعَرَبِ.اس","","","","","","","بات کی دلیل کا بیان کہ وہ دونوں ٹخنے جہاں تک وضو کرنے والے کو پاؤں دھونے کا حکم دیا گیا ہے وہ قدم کے دونوں جانب ابھری ہوئی دوہڈیاں ہیں۔ قدم کے اوپر ابھری ہوئی چھوٹی ہڈی مراد نہیں ہے جیسا کہ بعض کم فہم اور عرب لغت نہ جاننے والے شیخی خوروں کو وہم ہوا ہے","158","160","158","160"
"125","بَابُ التَّغْلِيظِ فِي تَرْكِ غَسْلِ الْعَقِبَيْنِ فِي الْوُضُوءِ،وضو","بَابُ التَّغْلِيظِ فِي تَرْكِ غَسْلِ الْعَقِبَيْنِ فِي الْوُضُوءِ،وضو","","","","","","","میں ایڑیوں کے نہ دھونے پر وعید کا بیان","161","162","161","162"
"126","بَابُ التَّغْلِيظِ فِي تَرْكِ غَسْلِ بُطُونِ الْأَقْدَامِ فِي الْوُضُوءِ،وضو میں قدموں کے نچلے حصّے","بَابُ التَّغْلِيظِ فِي تَرْكِ غَسْلِ بُطُونِ الْأَقْدَامِ فِي الْوُضُوءِ،وضو میں قدموں کے نچلے حصّے","","","","","","","کو نہ دھونے پر وعید و عذاب کا بیان","163","163","163","163"
"127","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْمَسْحَ عَلَى الْقَدَمَيْنِ غَيْرُ جَائِزٍ، لَا كَمَا زَعَمَتِ الرَّوَافِضُ، وَالْخَوَارِجُ.رافضیوں","بَابُ ذِكْرِ الدَّلِيلِ عَلَى أَنَّ الْمَسْحَ عَلَى الْقَدَمَيْنِ غَيْرُ جَائِزٍ، لَا كَمَا زَعَمَتِ الرَّوَافِضُ، وَالْخَوَارِجُ.رافضیوں","","","","","","","اور خارجیوں کے دعوے کے برعکس اس بات کی دلیل کا بیان کہ قدموں پر مسح کرنا جائز نہیں ہے","164","164","164","164"
"128","بَابُ ذِكْرِ الْبَيَانِ أَنَّ اللَّهَ- عَزَّ وَجَلَّ وَعَلَا- أَمَرَ بِغَسْلِ الْقَدَمَيْنِ فِي قَوْلِهِ: [وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِالْآيَةَ، لَا بِمَسْحِهِمَا عَلَى مَا زَعَمَتِ الرَّوَافِضُ، وَالْخَوَارِجُ،اس بات کی دلیل کا بیان کہ اللہ عزوجل نے اپنے فرمان: ﴿وَأَرْجُلَکُمْ إِلَی الْکَعْبَیْنِ﴾","بَابُ ذِكْرِ الْبَيَانِ أَنَّ اللَّهَ- عَزَّ وَجَلَّ وَعَلَا- أَمَرَ بِغَسْلِ الْقَدَمَيْنِ فِي قَوْلِهِ: [وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِالْآيَةَ، لَا بِمَسْحِهِمَا عَلَى مَا زَعَمَتِ الرَّوَافِضُ، وَالْخَوَارِجُ،اس بات کی دلیل کا بیان کہ اللہ عزوجل نے اپنے فرمان: ﴿وَأَرْجُلَکُمْ إِلَی الْکَعْبَیْنِ﴾","","","","","","","”پاؤں ٹخنوں سمیت“ میں رافضیوں اور خارجیوں کے دعوے کے برعکس قدموں کو دھونے کا حکم دیا ہے مسح کرنے کا نہیں","165","165","165","165"
"129","بَابُ التَّغْلِيظِ فِي الْمَسْحِ عَلَى الرِّجْلَيْنِ، وَتَرْكِ غَسْلِهِمَا فِي الْوُضُوءِ،وضو","بَابُ التَّغْلِيظِ فِي الْمَسْحِ عَلَى الرِّجْلَيْنِ، وَتَرْكِ غَسْلِهِمَا فِي الْوُضُوءِ،وضو","","","","","","","میں پاؤں پر مسح کرنے اور انہیں نہ دھونے پر وعید کا بیان","166","166","166","166"
"130","بَابُ غَسْلِ أَنَامِلِ الْقَدَمَيْنِ فِي الْوُضُوءِ،وضو","بَابُ غَسْلِ أَنَامِلِ الْقَدَمَيْنِ فِي الْوُضُوءِ،وضو","","","","","","","میں پاؤں کی انگلیاں دھونے کا بیان","167","167","167","167"
"131","بَابُ تَخْلِيلِ أَصَابِعِ الْقَدَمَيْنِ فِي الْوُضُوءِ.وضو","بَابُ تَخْلِيلِ أَصَابِعِ الْقَدَمَيْنِ فِي الْوُضُوءِ.وضو","","","","","","","میں پاؤں کی انگلیوں کا خلال کرنا","168","168","168","168"
"132","بَابُ صِفَةِ وُضُوءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلَاثًا ثَلَاثًا.نبی","بَابُ صِفَةِ وُضُوءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلَاثًا ثَلَاثًا.نبی","","","","","","","اکرم صلی اللہ علیہ وسلم کے تین تین بار وضو کرنے کی کیفیت کا بیان","169","169","169","169"
