hadiths[12]{hadithnumber,text}:
"364","'Amr ibn Shu'ayb reported from his grandfather that the Messenger\nof Allah"
"365","Ya'la ibn Murra said"
"366","Bukayr reported that he saw 'Abdullah ibn Ja'far kissing Zaynab"
"367","Al-Hasan said"
"368","Yusuf ibn 'Abdullah ibn Sallam said"
"369","'A'isha said"
"370","Abu'l-'Ajlan al-Muharibi said"
"371","Jarir reported that the Prophet"
"372","'Umar was heard to say"
"373","'Umar was heard to say"
"374","Mu'awiya ibn Qurra reported that his father said"
"375","Abu Hurayra said"
