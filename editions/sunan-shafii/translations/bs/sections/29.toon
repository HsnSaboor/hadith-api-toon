hadiths[7]{hadithnumber,text}:
"353","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu – od svoga oca – od Amra ibn Jahjaa el-Mazinija, rahimehullah: Allahov Poslanik, sallallahu alejhi ve sellem, rekao je: „U manje od pet deva nema sadake [zekata].“"
"354","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu – od svoga oca: čuo sam Allahovog Poslanika, sallallahu alejhi ve sellem, kako govori: „U manje od pet deva nema sadake.“"
"355","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu – od svoga oca: čuo sam Allahovog Poslanika, sallallahu alejhi ve sellem, kako govori: „U manje od pet vaska nema sadake.“"
"356","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu: Allahov Poslanik, sallallahu alejhi ve sellem, rekao je: „U manje od pet vaska hurmi nema sadake.“"
"357","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu – od svoga oca – od Amra ibn Jahjaa el-Mazinija, rahimehullah: Allahov Poslanik, sallallahu alejhi ve sellem, rekao je: „U manje od pet ukija nema sadake.“"
"358","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu – od svoga oca: čuo sam Allahovog Poslanika, sallallahu alejhi ve sellem, kako govori: „U manje od pet ukija nema sadake.“"
"359","[AI-translation] Prenosi Ebu Se'id el-Hudri, radijallahu anhu: Allahov Poslanik, sallallahu alejhi ve sellem, rekao je: „U manje od pet ukija srebra nema sadake.“"
