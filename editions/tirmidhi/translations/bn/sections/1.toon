hadiths[148]{hadithnumber,text}:
"1","। ইবনু উমর (রাঃ) হতে বর্ণিত"
"2","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"3","। আলী (রাঃ) হতে বর্ণিত আছে"
"4","। জাবির ইবনু আবদুল্লাহ (রাঃ) হতে বর্ণিত আছে"
"5","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"6","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"7","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"8","। আবু আইয়ুব আনসারী (রাঃ) হতে বর্ণিত আছে"
"9","। জাবির ইবনু আবদিল্লাহ (রাঃ) হতে বর্ণিত আছে"
"10","। ইবনু লাহীআ আবূ যুবাইরের সূত্রে"
"11","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"12","। আইশা (রাঃ) হতে বর্ণিত আছে"
"13","। হুযাইফা (রাঃ) হতে বর্ণিত আছে"
"14","। আনাস (রাঃ) হতে বর্ণিত আছে"
"15","। আবদুল্লাহ ইবনু আবী কাতাদা (রাঃ) হতে তার পিতার সূত্রে বর্ণিত আছে। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যে কোন ব্যক্তিকে ডান হাত দিয়ে নিজের লজ্জাস্থান স্পর্শ করতে নিষেধ করেছেন। —সহীহ। ইবনু মাজাহ– (৩১০)"
"16","। আবদুর রাহমান ইবনু ইয়াযীদ (রাহঃ) হতে বর্ণিত আছে"
"17","। আবদুল্লাহ (রাঃ) হতে বর্ণিত আছে"
"18","। আবদুল্লাহ ইবনু মাসউদ (রাঃ) হতে বর্ণিত আছে"
"19","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"20","। মুগীরা ইবনু শুবা (রাঃ) হতে বর্ণিত আছে"
"21","। 'আবদুল্লাহ ইবনু মুগাফফাল (রাঃ) হতে বর্ণিত আছে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কোন ব্যক্তিকে নিজের গোসলখানায় পেশাব করতে নিষেধ করেছেন। তিনি আরো বলেছেনঃ (মানুষের মনে) বেশিরভাগ ওয়াসওয়াসা তা হতেই সৃষ্টি হয়। -প্রথম অংশ সহীহ"
"22","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"23","। যাইদ ইবনু খালিদ আল-জুহানী (রাঃ) হতে বর্ণিত আছে"
"24","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"25","। রাবাহ ইবনু আবদির রহমান ইবনি আবী সুফিয়ান ইবনি হুআইত্বিব হতে তার দাদীর সূত্রে"
"26","। পূর্বের হাদীসের অনুরূপ।"
"27","। সালামা ইবনু কাইস (রাঃ) হতে বর্ণিত আছে"
"28","। আবদুল্লাহ ইবনু যাইদ (রাঃ) হতে বর্ণিত আছে"
"29","। আবদুল করীম ইবনু আবুল মুখারিক আবু উমাইয়া হতে হাসসান ইবনু বিলালের সূত্রে বর্ণিত"
"30","। আম্মার (রাঃ) রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হতে বর্ণনা করেন ..... এ সূত্রেও উপরের হাদীসের মতই বর্ণিত হয়েছে। আবু ঈসা বলেনঃ এ অনুচ্ছেদে আয়িশাহ"
"31","। উসমান ইবনু আফফান (রাঃ) হতে বর্ণিত আছে"
"32","। আবদুল্লাহ ইবনু যাইদ (রাঃ) হতে বর্ণিত আছে"
"33","। রুবাই বিনতু মুআবিয ইবনি আফরাআ (রাঃ) হতে বর্ণিত আছে"
"34","। রুবাই বিনতু মু'আকিবয ইবনি আফরাআ (রাঃ) হতে বর্ণিত আছে"
"35","। আবদুল্লাহ ইবনু যাইদ (রাঃ) হতে বর্ণিত আছে"
"36","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"37","। আবু উমামা (রাঃ) হতে বর্ণিত আছে"
"38","। আসিম ইবনু লাকীত ইবনু সাবিরা হতে তার পিতার সূত্রে বর্ণিত আছে"
"39","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"40","। মুসতাওরিদ ইবনু শাদ্দাদ আল-ফিহরী (রাঃ) হতে বর্ণিত আছে"
"41","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"42","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"43","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"44","। আলী (রাঃ) হতে বর্ণিত আছে"
"45","। সাবিত ইবনু আবূ সাফিয়্যা (রাহঃ) বলেন"
"46","। সাবিত ইবনু আবু সাফিয়্যা (রাহঃ) বলেন"
"47","। আবদুল্লাহ ইবনু যাইদ (রাঃ) হতে বর্ণিত আছে"
"48","। আবু হাইআ (রাহঃ) হতে বর্ণিত আছে"
"49","। আবদি খাইর আলী (রাঃ)-এর সূত্রে আবু হাইআ হতে বর্ণিত হাদীসের মত হাদীস বর্ণনা করেছেন। কিন্তু আবদি খাইরের বর্ণিত হাদীসের শেষের অংশ নিম্নরূপঃ তিনি যখন ওযু শেষ করতেন তখন অবশিষ্ট পানি হাতের আঁজলে নিয়ে পান করতেন। —সহীহ। দেখুন পূর্ববতী হাদীস। আবু ঈসা বলেনঃ আলী (রাঃ)-এর হাদীসটি আবু ইসহাক হামদানী বর্ণনা করেছেন আবু হাইআ হতে"
"50","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"51","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"52","। 'আলা (রহঃ) হতে এই সনদসূত্রে উপরের হাদীসের মতই বর্ণিত হয়েছে"
"53","। আইশা (রাঃ) হতে বর্ণিত আছে"
"54","। মুআয ইবনু জাবাল (রাঃ) হতে বর্ণিত আছে"
"55","। উমার ইবনুল খাত্তাব (রাঃ) হতে বর্ণিত আছে"
"56","। সাফীনাহ (রাঃ) হতে বর্ণিত আছে"
"57","। উবাই ইবনু কাব (রাঃ) হতে বর্ণিত আছে"
"58","। আনাস (রাঃ) হতে বর্ণিত আছে"
"59","। ইবনু উমর (রাঃ) হতে বর্ণিত"
"60","। আমর ইবনু আমির আনসারী (রহঃ) হতে বর্ণিত আছে"
"61","। সুলাইমান ইবনু বুরাইদা (রহঃ) হতে তার পিতার সূত্রে বর্ণিত আছে"
"62","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"63","। বানী গিফার গোত্রের এক ব্যক্তির সূত্রে বর্ণিত আছে"
"64","। হাকাম ইবনু আমর আল-গিফারী (রাঃ) হতে বর্ণিত আছে"
"65","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"66","। আবু সাঈদ খুদরী (রাঃ) হতে বর্ণিত আছে"
"67","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"68","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"69","। মুগীরা ইবনু আবী বুরদা হতে বর্ণিত আছে"
"70","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"71","। উম্মু কাইস বিনতু মিহসান (রাঃ) হতে বর্ণিত আছে"
"72","। আনাস (রাঃ) হতে বর্ণিত আছে"
"73","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"74","আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"75","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"76","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"77","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"78","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"79","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"80","। জাবির (রাঃ) হতে বর্ণিত আছে"
"81","। বারাআ ইবনু আযিব (রাঃ) হতে বর্ণিত আছে"
"82","। বুসরা বিনতু সাফওয়ান (রাঃ) হতে বর্ণিত আছে"
"83","। এ হাদীসটি একাধিক সূত্রে হিশাম"
"84","। আবুল যিনাদ ওরওয়ার সূত্রে বুসরা হতে অনুরূপ হাদীস বর্ণনা করেছেন। -সহীহ। দেখুন পূর্বের হাদীস। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামের একাধিক সাহাবী ও তাবিঈন এই মত দিয়েছেন যে"
"85","। কাইস ইবনু তালক ইবনু আলী আল-হানাফী হতে তার পিতার (তালকের) সূত্রে বর্ণনা করা হয়েছে"
"86","। আয়িশাহ (রাঃ) হতে বর্ণিত হয়েছে"
"87","। আবু দারদা (রাঃ) হতে বর্ণিত আছে; রাসূলুল্লাহ সাল্লাল্লাহু 'আলাইহি ওয়াসাল্লাম বমি করলেন"
"88","আবদুল্লাহ ইবনু মাসউদ (রাঃ) হতে বর্ণিত আছে"
"89","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"90","। ইবনু উমর (রাঃ) হতে বর্ণিত আছে"
"91","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"92","। কাবশা বিনতু কাব ইবনি মালিক (রাঃ) হতে বর্ণিত আছে"
"93","। হাম্মাম ইবনুল হারিস (রহঃ) হতে বর্ণিত আছে"
"94","। শাহার ইবনু হাওশাব হতে বর্ণিত; তিনি বলেনঃ আমি জারীর ইবনু আবদুল্লাহকে ওযু করতে এবং মোজার উপর মসিহ করতে দেখলাম। আমি এ ব্যাপারে তার দৃষ্টি আকর্ষণ করলাম। তিনি বললেন"
"95","। খুযাইমাহ ইবনু সাবিত (রাঃ) হতে বর্ণিত আছে"
"96","। সাফওয়ান ইবনু 'আসসাল (রাঃ) হতে বর্ণিত আছে"
"97","। মুগীরা ইবনু শু’বা (রাঃ) হতে বর্ণিত আছে"
"98","। মুগীরা ইবনু শু’বা (রাঃ) হতে বর্ণিত আছে"
"99","। মুগীরা ইবনু শুবা (রাঃ) হতে বর্ণিত আছে"
"100","। মুগীরা ইবনু শুবা (রাঃ) হতে বর্ণিত আছে"
"101","। বিলাল (রাঃ) হতে বর্ণিত আছে"
"102","। আবু উবাইদা ইবনু মুহাম্মাদ ইবনু আম্মার ইবনু ইয়াসার (রহঃ) হতে বর্ণিত আছে"
"103","ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে তিনি তার খালা মাইমূনা (রাঃ)-এর সূত্রে বর্ণনা করেছেন"
"104","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"105","উম্মু সালামাহ (রাঃ) হতে বর্ণিত আছে"
"106","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"107","আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"108","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"109","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"110","। উবাই ইবনু কাব (রাঃ) হতে বর্ণিত আছে"
"111","। ইমাম যুহরী (রহঃ) হতে এই সূত্রে উপরের হাদীসের মত হাদীস বর্ণনা হয়েছে। আবু ঈসা বলেন"
"112","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"113","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"114","। আলী (রাঃ) হতে বর্ণিত আছে"
"115","সাহল ইবনু হুনাইফ (রাঃ) হতে বর্ণিত আছে"
