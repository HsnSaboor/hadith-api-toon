"4344","(۴۳۴۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَمِعَ الرَّجُلُ السَّجْدَۃَ وَہُوَ یُصَلِّی ، فَلْیَخِرَّ سَاجِدًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4344","","","كتاب الصلوات"
"4345","(۴۳۴۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْجُنُبِ إذَا سَمِعَ السَّجْدَۃَ : یَغْتَسِلُ ثُمَّ یَقْرَؤُہَا فَیَسْجُدُ بِہَا ، وَإِنْ کَانَ لاَ یُحْسِنُہَا قَرَأَ غَیْرَہَا ، ثُمَّ سَجَدَ۔","Hasan","Musannaf Ibn Abi Shaybah 4345","","","كتاب الصلوات"
"4346","(۴۳۴۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، أَنَّہُمَا قَالاَ : إذَا سَمِعَ الْجُنُبُ السَّجْدَۃَ اغْتَسَلَ ، ثُمَّ سَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4346","","","كتاب الصلوات"
"4347","(۴۳۴۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْحَائِضِ تَسْمَعُ السَّجْدَۃَ ، قَالَ : لاَ تَسْجُدُ ، ہِیَ تَدَعُ مَا ہُوَ أَعْظَمُ مِنَ السَّجْدَۃِ ، الصَّلاَۃ الْمَکْتُوبَۃَ۔","","Musannaf Ibn Abi Shaybah 4347","","","كتاب الصلوات"
"4348","(۴۳۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَإِبْرَاہِیمَ عَنِ الْحَائِضِ تَسْمَعُ السَّجْدَۃَ ؟ فَقَالاَ : لَیْسَ عَلَیْہَا سُجُودٌ ، الصَّلاَۃ أَکْبَرُ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4348","","","كتاب الصلوات"
"4349","(۴۳۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : أَرَأَیْتَ إِنْ مَرَّتْ حَائِضٌ بِقَوْمٍ یَقْرَؤُونَ الْمُصْحَفَ فَسَجَدُوا ، تَسْجُد مَعَہُمْ ؟ قَالَ : لاَ ، قَدْ مُنِعَتْ خَیْرًا مِنْ ذَلِکَ ،الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4349","","","كتاب الصلوات"
"4350","(۴۳۵۰) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی الضُّحَی (ح) وَعَنْ إبْرَاہِیمَ ، قَالاَ : إذَا سَمِعَتِ الْحَائِضُ السَّجْدَۃَ فَلاَ تَسْجُدُ ، ہِیَ تَدَعُ أَوْجَبَ مِنْ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4350","","","كتاب الصلوات"
"4351","(۴۳۵۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ؛ فِی الْجُنُبِ وَالْحَائِضِ یَسْمَعَانِ السَّجْدَۃَ، فَقَال: لاَ یَسْجُدَانِ۔","","Musannaf Ibn Abi Shaybah 4351","","","كتاب الصلوات"
"4352","(۴۳۵۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُثْمَانَ ، قَالَ : تُومِیئُ بِرَأْسِہَا إیمَائً۔","","Musannaf Ibn Abi Shaybah 4352","","","كتاب الصلوات"
"4353","(۴۳۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، قَالَ: حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : تُومِیئُ بِرَأْسِہَا وَتَقُولُ: اللَّہُمَّ لَکَ سَجَدْت۔","","Musannaf Ibn Abi Shaybah 4353","","","كتاب الصلوات"
"4354","(۴۳۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، قَالَ : أَخْبَرَنَا أَبُو الْحَسَنِ ، عَنْ رَجُلٍ ، زَعَمَ أَنَّہُ کَنَفْسِہِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ عُمَرَ یَنْزِلُ عَنْ رَاحِلَتِہِ فَیُہْرِیقُ الْمَائَ ، ثُمَّ یَرْکَبُ فَیَقْرَأُ السَّجْدَۃَ فَیَسْجُدُ ، وَمَا تَوَضَّأَ۔","Majhul","Musannaf Ibn Abi Shaybah 4354","","","كتاب الصلوات"
"4355","(۴۳۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَسْمَعُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ، فَلاَ سُجُودَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4355","","","كتاب الصلوات"
"4356","(۴۳۵۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَمِعَہُ وَہُوَ غَیْرُ طَاہِرٍ فَلْیَتَوَضَّأْ ، ثُمَّ لِیَقْرَأْہَا فَیَسْجُدْ ، فَإِنْ کَانَ لاَ یُحْسِنُہَا قَرَأَ غَیْرَہَا ، ثُمَّ سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4356","","","كتاب الصلوات"
"4357","(۴۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ ، قَالَ : یَسْجُدُ حَیْثُ کَانَ وَجْہُہُ۔","","Musannaf Ibn Abi Shaybah 4357","","","كتاب الصلوات"
"4358","(۴۳۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَسْمَعُ السَّجْدَۃَ وَلَیْسَ عَلَی وُضُوئٍ ، قَالَ : إِنْ کَانَ عِنْدَہُ مَائٌ تَوَضَّأَ وَسَجَدَ ، وَإِنْ لَمْ یَکُنْ عِنْدَہُ مَائٌ تَیَمَّمَ وَسَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4358","","","كتاب الصلوات"
"4359","(۴۳۵۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ کُرَیْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ الْقِبْلَۃِ أَیَسْجُدُ ؟ قَالَ : نَعَمْ ، لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4359","","","كتاب الصلوات"
"4360","(۴۳۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ یَقْرَأُ السَّجْدَۃَ وَہُوَ عَلَی غَیْرِ الْقِبْلَۃِ وَہُوَ یَمْشِی ، فَیُومِیئُ بِرَأْسِہِ ، ثُمَّ یُسَلِّمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4360","","","كتاب الصلوات"
"4361","(۴۳۶۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، قَالَ : سَمِعْتُ الْحَسَنَ وَقَرَأَ السَّجْدَۃَ الَّتِی فِی (ص) فَسَجَدَ عَلَی حَرْفِ أُسْطُوَانَۃٍ ، ثُمَّ قَالَ لِلْقَوْمِ : تَوَجَّہُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 4361","","","كتاب الصلوات"
"4362","(۴۳۶۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَانَ یَقْرَأُ بِہَا وَہُوَ جَالِسٌ ، فَیَسْتَقْبِلُ الْقِبْلَۃَ وَیَسْجُدُ۔","","Musannaf Ibn Abi Shaybah 4362","","","كتاب الصلوات"
"4363","(۴۳۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا قَرَأَ الرَّجُلُ السَّجْدَۃَ بَعْدَ الْعَصْرِ وَبَعْدَ الْفَجْرِ ، فَلْیَسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4363","","","كتاب الصلوات"
"4364","(۴۳۶۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُمَا قَالاَ : اقْرَأْ وَاسْجُدْ مَا کُنْتَ فِی وَقْتٍ بَعْدَ الْعَصْرِ ، وَبَعْدَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 4364","","","كتاب الصلوات"
"4365","(۴۳۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْعَصْرِ ؟ فَقَالَ الْحَکَمُ : قَدِمَ عَلَیْنَا رَجَائُ بْنُ حَیْوَۃَ زَمَانَ بَشْرِ بْنِ مَرْوَانَ ، وَکَانَ قَاصَّ الْعَامَّۃِ ، فَکَانَ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْعَصْرِ فَیَسْجُدُ، قَالَ شُعْبَۃُ : وَسَأَلْت حَمَّادًا ، فَقَالَ : إذَا کَانَ فِی وَقْتِ صَلاَۃٍ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 4365","","","كتاب الصلوات"
"4366","(۴۳۶۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ، وَالْقَاسِمِ ، وَعَطَائٍ ، وَعَامِرٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْعَصْرِ ، وَقَبْلَ أَنْ تَطْلُعَ الشَّمْسُ فَیَسْجُدُ ؟ قَالُوا : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 4366","","","كتاب الصلوات"
"4367","(۴۳۶۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا قَرَأْتَ الْقُرْآنَ فَأَتَیْت عَلَی السَّجْدَۃِ بَعْدَ الْعَصْرِ وَبَعْدَ الْغَدَاۃِ فَاسْجُدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4367","","","كتاب الصلوات"
"4368","(۴۳۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إنَّمَا یَمْنَعُہُمْ مِنْ ذَلِکَ الْکَسَلُ۔","","Musannaf Ibn Abi Shaybah 4368","","","كتاب الصلوات"
"4369","(۴۳۶۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عُبَیْدِ اللہِ بْنِ مِقْسَمٍ ؛ أَنَّ قَاصًّا کَانَ یَقْرَأُ السَّجْدَۃَ بَعْدَ الْفَجْرِ فَیَسْجُدُ ، فَنَہَاہُ ابْنُ عُمَرَ فَأَبَی أَنْ یَنْتَہِیَ ، فَحَصَبَہُ ، وَقَالَ : إنَّہُمْ لاَ یَعْقِلُونَ۔","Hasan","Musannaf Ibn Abi Shaybah 4369","","","كتاب الصلوات"
"4370","(۴۳۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَابِتِ بْنِ عُمَارَۃَ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، قَالَ : کُنْتُ أَقْرَأُ السَّجْدَۃَ بَعْدَ الْفَجْرِ فَأَسْجُدُ ، فَأَرْسَلَ إلَیَّ ابْنُ عُمَرَ فَنَہَانِی۔","Hasan","Musannaf Ibn Abi Shaybah 4370","","","كتاب الصلوات"
"4371","(۴۳۷۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ سَعِیدُ بْنُ أَبِی الْحَسَنِ یَقْرَأُ بَعْدَ الْغَدَاۃِ ، فَیَمُرُّ بِالسَّجْدَۃِ فَیُجَاوِزُہَا ، فَإِذَا حَلَّتِ الصَّلاَۃ قَرَأَہَا وَسَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4371","","","كتاب الصلوات"
"4372","(۴۳۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، قَالَ : رَأَیْتُ الْحَسَنَ قَرَأَ سَجْدَۃً بَعْدَ الْعَصْرِ ، فَلَمَّا غَابَتِ الشَّمْسُ قَرَأَہَا ، ثُمَّ سَجَدَ۔","","Musannaf Ibn Abi Shaybah 4372","","","كتاب الصلوات"
"4373","(۴۳۷۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی عُتْبَۃَ ؛ أَنَّ أَبَا أَیُّوبَ کَانَ یُحَدِّثُ ، فَإِذَا بَزَغَتِ الشَّمْسُ قَرَأَ السَّجْدَۃَ فَسَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 4373","","","كتاب الصلوات"
"4374","(۴۳۷۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سَلِیمِ بْنِ حَیَّانَ ، عَنْ أَبِی غَالِبٍ ؛ أَنَّ أَبَا أُمَامَۃَ کَانَ یَکْرَہُ الصَّلاَۃ بَعْدَ الْعَصْرِ حَتَّی تَغْرُبَ الشَّمْسُ ، وَبَعْدَ الْفَجْرِ حَتَّی تَطْلُعَ الشَّمْسُ ، وَکَانَ أَہْلُ الشَّامِ یَقْرَؤُونَ السَّجْدَۃَ بَعْدَ الْعَصْرِ ، فَکَانَ أَبُو أُمَامَۃَ إذَا رَأَی أَنَّہُمْ یَقْرَؤُونَ سُورَۃً فِیہَا سَجْدَۃٌ بَعْدَ الْعَصْرِ ، لَمْ یَجْلِسْ مَعَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 4374","","","كتاب الصلوات"
"4375","(۴۳۷۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنِ نَافِع ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سَمِعَ قَاصًّا یَقْرَأُ السَّجْدَۃَ قَبْلَ أَنْ تَحِلَّ الصَّلاَۃ ، فَسَجَدَ الْقَاصُّ وَمَنْ مَعَہُ ، فَأَخَذَ ابْنُ عُمَرَ بِیَدَیَّ ، فَلَمَّا أَضْحَی ، قَالَ لِی : یَا نَافِعُ ، اُسْجُدْ بِنَا السَّجْدَۃَ الَّتِی سَجَدَہَا الْقَوْمُ فِی غَیْرِ حِینِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 4375","","","كتاب الصلوات"
"4376","(۴۳۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَسْجُدُ اثْنَتَیْ عَشْرَۃَ سَجْدَۃً فِی الْقُرْآنِ ، الَّتِی یَسْجُدُونَ فِیہَا ، لَمْ یَذْکُرْ فِیہَا : {إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4376","","","كتاب الصلوات"
"4377","(۴۳۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : عَدَّ عَلَیَّ مَسْرُوقٌ ثِنْتَیْ عَشْرَۃَ سَجْدَۃً فِی الْقُرْآنِ ، لَمْ یَذْکُرِ الَّتِی فِی {إذَا السَّمَائُ انْشَقَّتْ}۔","No Data Available","Musannaf Ibn Abi Shaybah 4377","","","كتاب الصلوات"
"4378","(۴۳۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی الْعُرْیَانِ الْمُجَاشِعِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، وَذَکَرُوا سُجُودَ الْقُرْآنِ ، فَقَالَ : الأَعْرَافُ ، وَالرَّعْدُ ، وَالنَّحْلُ ، وَبَنِی إسْرَائِیلَ ، وَمَرْیَمُ ، وَالْحَجُّ سَجْدَۃٌ وَاحِدَۃٌ ، وَالنَّمْلُ، وَالْفُرْقَانُ ، وَ(الم تَنْزِیلُ) ، وَ(حم تَنْزِیل) ، وَ(ص) ، وَقَالَ : وَلَیْسَ فِی الْمُفَصَّلِ سُجُودٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4378","","","كتاب الصلوات"
"4379","(۴۳۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ مَسْعُودٍ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی الأَعْرَافِ ، وَبَنِی إسْرَائِیلَ ، وَالنَّجْمِ ، وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ} ، وَ{إذَا السَّمَائُ انْشَقَّتْ}۔","","Musannaf Ibn Abi Shaybah 4379","","","كتاب الصلوات"
"4380","(۴۳۸۰) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ یُوسُفَ الْمَکِّیِّ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ؛ أَنَّہُ قَالَ : عَزَائِمُ السُّجُودِ : (ألم تَنْزِیلُ) ، وَ(حٰمٓ تَنْزِیلُ) ، وَالأَعْرَافُ ، وَبَنِی إسْرَائِیلَ۔","","Musannaf Ibn Abi Shaybah 4380","","","كتاب الصلوات"
"4381","(۴۳۸۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ یُوسُفَ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عَلِیٍّ ، قَالَ : عَزَائِمُ سُجُود الْقُرْآن : (ألم تَنْزِیلُ) السَّجْدَۃَ ، وَ(حم تَنْزِیلُ)السَّجْدَۃَ ، وَالنَّجْمُ ، وَ(اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ)۔","Da'if","Musannaf Ibn Abi Shaybah 4381","","","كتاب الصلوات"
"4382","(۴۳۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، یَعْنِی ابْنَ إیَاسٍ ، عَنْ جَعْفَرٍ ؛ أَنَّ سَعِیدَ بْنَ جُبَیْرٍ ، قَالَ : عَزَائِمُ السُّجُودِ : (الم تَنْزِیلُ) ، وَالنَّجْمُ ، وَ{اقْرَأْ بِاسْمِ رَبِّکَ الَّذِی خَلَقَ}۔","No Data Available","Musannaf Ibn Abi Shaybah 4382","","","كتاب الصلوات"
"4383","(۴۳۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا ثَابِتُ بْنُ عُمَارَۃَ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ؛ أَنَّ أَشْیَاخًا مِنْ بَنِی الہُجَیْمِ بَعَثُوا رَاکِبًا لَہُمْ إلَی الْمَدِینَۃِ وَإِلَی مَکَّۃَ ، لِیَسْأَلَ لَہُمْ عَنْ سُجُودِ الْقُرْآنِ ، فَرَجَعَ إلَیْہِمْ فَأَخْبَرَہُمْ أَنَّہُمْ أَجْمَعُوا عَلَی عَشْرِ سَجَدَاتٍ۔","","Musannaf Ibn Abi Shaybah 4383","","","كتاب الصلوات"
"4384","(۴۳۸۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : دَخَلْتُ الْمَسْجِدَ فَإِذَا أَنَا بِشَیْخَیْنِ یَقْرَأُ أَحَدُہُمَا عَلَی صَاحِبِہِ الْقُرْآنَ ، فَجَلَسْتُ إلَیْہِمَا ، فَإِذَا أَحَدُہُمَا قَیْسُ بْنُ السَّکَنِ الأَسَدِیُّ ، وَإِذَا الآَخَرُ یَقْرَأُ سُورَۃَ مَرْیَمَ ، فَلَمَّا بَلَغَ السَّجْدَۃَ قَالَ لَہُ قَیْسُ بْنُ سَکَنٍ : دَعْہَا ، فَإِنَّا نَکْرَہُ أَنْ یَرَانَا أَہْلُ الْمَسْجِدِ ، فَتَرَکَہَا وَقَرَأَ مَا بَعْدَہَا ، قَالَ قَیْسٌ : وَاللَّہِ مَا صَرَفَنَا عَنْہَا إِلاَّ شَیْطَانٌ ، اقْرَأْہَا ، فَقَرَأَہَا فَسَجَدنَا۔","","Musannaf Ibn Abi Shaybah 4384","","","كتاب الصلوات"
"4385","(۴۳۸۵) حَدَّثَنَا ہُشَیْمٌ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانُوا یَکْرَہُونَ إذَا أَتَوْا عَلَی السَّجْدَۃِ أَنْ یُجَاوِزُوہَا حَتَّی یَسْجُدُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 4385","","","كتاب الصلوات"
"4386","(۴۳۸۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَمُرُّ بِالسَّجْدَۃِ فِی الصَّلاَۃ ، فَقَالَ : لاَ یَنْبَغِی لَہُ أَنْ یَمَرَّ بِہَا فَیَتْرُکَہَا۔","","Musannaf Ibn Abi Shaybah 4386","","","كتاب الصلوات"
"4387","(۴۳۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ یَنْبَغِی لَہُ إذَا مَرَّ بِہَا أَنْ یَتْرُکَہَا ، وَلَکِنْ یَسْجُدُ بِہَا ، وَإِنْ شَائَ رَکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4387","","","كتاب الصلوات"
"4388","(۴۳۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، قَالَ : حَدَّثَنَا بَکْرُ بْنُ عَبْدِ اللہِ الْمُزَنِیّ ، عَنْ صَفْوَانَ بْنِ مُحْرِزٍ ، قَالَ: بَیْنَا الأَشْعَرِیُّ یَخْطُبُ یَوْمَ الْجُمُعَۃِ إذْ قَرَأَ السَّجْدَۃَ الآخِرَۃَ مِنْ سُورَۃِ الْحَجِّ ، قَالَ : فَنَزَلَ عَنِ الْمِنْبَرِ ، فَسَجَدَ ثُمَّ عَادَ إلَی مَجْلِسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4388","","","كتاب الصلوات"
"4389","(۴۳۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ سَجْدَۃَ سُورَۃِ (ص) عَلَی الْمِنْبَرِ ، فَلَمَّا أَتَی عَلَی السَّجْدَۃِ قَرَأَہَا ، ثُمَّ نَزَلَ فَسَجَدَ۔","","Musannaf Ibn Abi Shaybah 4389","","","كتاب الصلوات"
"4390","(۴۳۹۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو إِسْحَاقَ الْکُوفِی ، عَنِ الشَّعْبِیِّ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ؛ أَنَّہُ قَرَأَ سَجْدَۃَ (ص) وَہُوَ عَلَی الْمِنْبَرِ ، فَنَزَلَ فَسَجَدَ ، ثُمَّ عَادَ إلَی مَجْلِسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 4390","","","كتاب الصلوات"
"4391","(۴۳۹۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، قَالَ : قَرَأَ عَمَّارٌ عَلَی الْمِنْبَرِ : (إذَا السَّمَائُ أنْشَقَّتْ) ، ثُمَّ نَزَلَ إلَی الْقَرَارِ ، فَسَجَدَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4391","","","كتاب الصلوات"
"4392","(۴۳۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ قَرَأَہَا وَہُوَ عَلَی الْمِنْبَرِ ، ثُمَّ نَزَلَ فَسَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 4392","","","كتاب الصلوات"
"4393","(۴۳۹۳) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شُرَیْحٍ ، قَالَ : حدَّثَنِی وَاہِبٌ الْمَعَافِرِیُّ ، عَنْ أَوْسِ بْنِ بِشْرٍ، قَالَ : رَأَیْتُ عُقْبَۃَ بْنَ عَامِرٍ قَرَأَ عَلَی الْمِنْبَرِ السَّجْدَۃَ ، فَنَزَلَ فَسَجَدَ۔","Majhul","Musannaf Ibn Abi Shaybah 4393","","","كتاب الصلوات"
"4394","(۴۳۹۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی الْمَرْأَۃِ تَقْرَأُ السَّجْدَۃَ وَمَعَہَا رِجَالٌ ، أَوْ رَجُلٌ ، قَالَ : یَسْجُدُونَ قَبْلَہَا ، وَلاَ یَأْتَمُّونَ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4394","","","كتاب الصلوات"
"4395","(۴۳۹۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الْمَرْأَۃِ تَقْرَأُ السَّجْدَۃَ ؟ فَقَالَ : ہِیَ إمَامُک۔","No Data Available","Musannaf Ibn Abi Shaybah 4395","","","كتاب الصلوات"
"4396","(۴۳۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ؛ أَنَّ غُلاَمًا قَرَأَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السَّجْدَۃَ ، فَانْتَظَرَ الْغُلاَمُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَسْجُدَ ، فَلَمَّا لَمْ یَسْجُدْ ، قَالَ : یَا رَسُولَ اللہِ ، أَلَیْسَ فِی ہَذِہِ السُّورَۃِ سَجْدَۃٌ ؟ قَالَ : بَلَی ، وَلَکِنَّک کُنْت إمَامَنَا فِیہَا ، فَلَوْ سَجَدْتَ لَسَجَدْنَا۔ (بیہقی ۳۲۴)","","Musannaf Ibn Abi Shaybah 4396","","","كتاب الصلوات"
"4397","(۴۳۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمٍ أَبِی إِسْحَاقَ ، عَنْ سُلَیْمِ بْنِ حَنْظَلَۃَ ، قَالَ : قرَأْتُ عَلَی عَبْدِ اللہِ بْنِ مَسْعُودٍ سُورَۃَ بَنِی إسْرَائِیلَ ، فَلَمَّا بَلَغْتُ السَّجْدَۃَ ، قَالَ عَبْدُ اللہِ : اقْرَأْہَا ، فَإِنَّک إمَامُنَا فِیہَا۔","Hasan","Musannaf Ibn Abi Shaybah 4397","","","كتاب الصلوات"
"4398","(۴۳۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ عَلْقَمَۃَ ، وَالأَسْوَدَ ، وَمَسْرُوقًا ، وَعَمْرَو بْنَ شُرَحبیلَ ؛ کَانُوا یَقُولُونَ : إذَا کَانَتِ السَّجْدَۃُ آخِرَ السُّورَۃِ ، أَجْزَأک أَنْ تَرْکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4398","","","كتاب الصلوات"
"4399","(۴۳۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ فِی آخِرِ السُّورَۃِ سَجْدَۃٌ ، أَجْزَأک أَنْ تَرْکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4399","","","كتاب الصلوات"
"4400","(۴۴۰۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الْعِشَائِ الآخِرَۃِ : (تَنْزِیلَ) السَّجْدَۃَ فَیَرْکَعُ بِالسَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4400","","","كتاب الصلوات"
"4401","(۴۴۰۱) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ عَبْدِالْمَلِکِ بْنِ أَبِی سُلَیْمَانَ، قَالَ: سَمِعْتُ الشَّعْبِیَّ، وَسُئِلَ عَنِ الرَّجُلِ یَقْرَأُ بِالسَّجْدَۃِ فَتَکُونُ فِی آخِرِ السُّورَۃِ ؟ فَقَالَ : إِنْ ہُوَ سَجَدَ بِہَا قَامَ فَقَرَأَ بَعْدَہَا ، وَإِنْ شَائَ أَنْ یَرْکَعَ بِہَا رَکَعَ بِہَا۔","","Musannaf Ibn Abi Shaybah 4401","","","كتاب الصلوات"
"4402","(۴۴۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی عُتْبَۃُ بْنُ قَیْسٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَقْرَأُ السَّجْدَۃَ فِی بَنِی إسْرَائِیلَ ، وَمَا بَعْدَہَا ، ثُمَّ یَرْکَعُ۔","","Musannaf Ibn Abi Shaybah 4402","","","كتاب الصلوات"
"4403","(۴۴۰۳) حَدَّثَنَا عُبَیْدُاللہِ ، قَالَ: أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ، قَالَ : إذَا کَانَتِ السَّجْدَۃُ آخِرَ السُّورَۃِ ، فَإِنْ شِئْتَ فَارْکَعْ ، وَإِنْ شِئْتَ فَاسْجُدْ ، فَإِنَّ الرَّکْعَۃَ مَعَ السَّجْدَۃِ۔","","Musannaf Ibn Abi Shaybah 4403","","","كتاب الصلوات"
"4404","(۴۴۰۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٌ ، قَالاَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : سَأَلْنَا عَبْدَ اللہِ عَنِ السُّورَۃِ تَکُونُ فِی آخِرِہَا سَجْدَۃٌ ، أَیَرْکَعُ ، أَوْ یَسْجُدُ ؟ قَالَ : إذَا لَمْ یَکُنْ بَیْنَکَ وَبَیْنَ السَّجْدَۃِ إِلاَّ الرُّکُوعُ فَہُوَ قَرِیبٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4404","","","كتاب الصلوات"
"4405","(۴۴۰۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی سُجُودِ الْقُرْآنِ : سَجَدَ وَجْہِی لِلَّذِی خَلَقَہُ وَصَوَّرَہُ ، وَشَقَّ سَمْعَہُ وَبَصَرَہُ ، بِحَوْلِہِ وَقُوَّتِہِ۔ (ترمذی ۵۸۰۔ احمد ۳۰)","","Musannaf Ibn Abi Shaybah 4405","","","كتاب الصلوات"
"4406","(۴۴۰۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ زِیَادِ بْنِ الْحُصَیْنِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ فِی سُجُودِہِ : اللَّہُمَّ لَکَ سَجَدَ سَوَادِی ، وَبِکَ آمَنَ فُؤَادِی ، اللَّہُمَّ اُرْزُقْنِی عِلْمًا یَنْفَعُنِی ، وَعَمَلاً یَرْفَعُنِی۔","Sahih","Musannaf Ibn Abi Shaybah 4406","","","كتاب الصلوات"
"4407","(۴۴۰۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی سُجُودِ الْقُرْآنِ بِاللَّیْلِ فِی السَّجْدَۃِ مِرَارًا : سَجَدَ وَجْہِی لِمَنْ خَلَقَہُ ، وَشَقَّ سَمْعَہُ وَبَصَرَہُ ، بِحَوْلِہِ وَقُوَّتِہِ۔ (ابوداؤد ۱۴۰۹۔ احمد ۲۱۷)","Majhul","Musannaf Ibn Abi Shaybah 4407","","","كتاب الصلوات"
"4408","(۴۴۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ کَانَ یَقُولُ إذَا قَرَأَ السَّجْدَۃَ {سُبْحَانَ رَبِّنَا إِنْ کَانَ وَعْدُ رَبِّنَا لَمَفْعُولاً} ، سُبْحَانَ اللہِ وَبِحَمْدِہِ ، سُبْحَانَ اللہِ وَبِحَمْدِہِ ، ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 4408","","","كتاب الصلوات"
"4409","(۴۴۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : دَخَلْتُ الْمَسْجِدَ فَإِذَا أَنَا بِشَیْخَیْنِ یَقْرَأُ أَحَدُہُمَا عَلَی صَاحِبِہِ الْقُرْآنَ ، فَجَلَسْتُ إلَیْہِمَا فَإِذَا أَحَدُہُمَا قَیْسُ بْنُ سَکَنِ الأَسَدِیُّ ، وَالأَخَرُ یَقْرَأُ عَلَیْہِ سُورَۃَ مَرْیَمَ ، فَلَمَّا بَلَغَ السَّجْدَۃَ ، قَالَ لَہُ قَیْسٌ : دَعْہَا ، فَإِنَّا نَکْرَہُ أَنْ یَرَانَا أَہْلُ الْمَسْجِدِ ، فَتَرَکَہَا وَقَرَأَ مَا بَعْدَہَا ، ثُمَّ قَالَ قیْسٌ : وَاللَّہِ مَا صَرَفَنَا عَنْہَا إِلاَّ الشَّیْطَانُ ، اقْرَأْہَا ، فَقَرَأَہَا فَسَجَدْنَا ، فَلَمَّا رَفَعْنَا رُؤُوسَنَا ، قَالَ لَہُ قَیْسٌ : تَدْرِی مَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ إذَا سَجَدَ ؟ قَالَ : نَعَمْ ، کَانَ یَقُولُ : سَجَدَ وَجْہِی لِمَنْ خَلَقَہُ ، وَشَقَّ سَمْعَہُ وَبَصَرَہُ ، قَالَ : صَدَقْت ، وَبَلَغَنِی أَنَّ دَاوُد عَلَیْہِ السَّلاَمُ کَانَ یَقُولُ : سَجَدَ وَجْہِی مُتَعَفِّرًا فِی التُّرَابِ لِخَالِقِی وَحُقَّ لَہُ ، ثُمَّ قَالَ : سُبْحَانَ اللہِ ! مَا أَشْبَہَ کَلاَمَ الأَنْبِیَائِ بَعْضَہُم بِبَعض۔","Da'if","Musannaf Ibn Abi Shaybah 4409","","","كتاب الصلوات"
"4410","(۴۴۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَرَأَ عَبْدُ اللہِ السَّجْدَۃَ فَسَجَدَ ، قَالَ إبْرَاہِیمُ: فَحَدَّثَنِی مَنْ سَمِعَہُ یَقُولُ فِی سُجُودِہِ : لَبَّیْکَ وَسَعْدَیْکَ ، وَالْخَیْرُ فِی یَدَیْک۔","Majhul","Musannaf Ibn Abi Shaybah 4410","","","كتاب الصلوات"
"4411","(۴۴۱۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ؛ أَنَّ إبْرَاہِیمَ لَبَّی وَہُوَ سَاجِدٌ۔","","Musannaf Ibn Abi Shaybah 4411","","","كتاب الصلوات"
"4412","(۴۴۱۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : قَرَأْتُ سَجْدَۃً فَسَجَدْت بِہَا ، فَأَضَفْتُ إلَیْہَا سَجْدَۃً أُخْرَی نَاسِیًا ؟ قَالَ : اُسْجُدْ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4412","","","كتاب الصلوات"
"4413","(۴۴۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ قَرَأَ السَّجْدَۃَ وَہُوَ فِی صَلاَۃٍ مَکْتُوبَۃٍ ، فَسَجَدَ سَجْدَتَیْنِ ، قَالَ : یَسْجُدُ سَجْدَتَیْنِ إذَا فَرَغَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4413","","","كتاب الصلوات"
"4414","(۴۴۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : قَرَأْتُ السَّجْدَۃَ وَأَنَا سَاجِدٌ ، أَسْجُدُ ؟ قَالَ : لاَ ، وَلِمَ تَقْرَأُ وَأَنْتَ سَاجِدٌ ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 4414","","","كتاب الصلوات"
"4415","(۴۴۱۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ : قَرَأْتُ السَّجْدَۃَ وَأَنَا أَطُوفُ بِالْبَیْتِ فَکَیْفَ تَرَی ؟ قَالَ : آمُرُک أَنْ تَسْجُدَ ، قُلْتُ : إذَا تَرَکَنِی النَّاسُ وَہُمْ یَطُوفُونَ، فَیَقُولُونَ : مَجْنُونٌ ، أَفَأَسْتَطِیعُ أَنْ أَسْجُدَ وَہُمْ یَطُوفُونَ ؟ فَقَالَ : وَاللَّہِ لَئِنْ قُلْتَ ذَلِکَ لَقَدْ قَرَأَ ابْنُ الزُّبَیْرِ السَّجْدَۃَ فَلَمْ یَسْجُدْ ، فَقَامَ الْحَارِثُ بْنُ أَبِی رَبِیعَۃَ فَقَرَأَ السَّجْدَۃَ ثُمَّ جَائَ فَجَلَسَ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ، مَا مَنَعَک أَنْ تَسْجُدَ قُبَیْلُ حَیْثُ قَرَأْتَ السَّجْدَۃَ ؟ فَقَالَ : لأَیِّ شَیْئٍ أَسْجُدُ ؟ إنِّی لَوْ کُنْت فِی صَلاَۃٍ سَجَدْت ، فَأَمَّا إذَا لَمْ أَکُنْ فِی صَلاَۃٍ فَإِنِّی لاَ أَسْجُدُ ، قَالَ : وَسَأَلْتُ عَطَائً عَنْ ذَلِکَ ؟ فَقَالَ : اسْتَقْبِلِ الْبَیْتَ وَأَوْمِیئْ بِرَأْسِک۔","","Musannaf Ibn Abi Shaybah 4415","","","كتاب الصلوات"
"4416","(۴۴۱۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَقْرَأُ السَّجْدَۃَ وَہُوَ یَطُوفُ بِالْبَیْتِ ، قَالَ : یُومِیئُ ، أَوْ قَالَ : یَسْجُدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4416","","","كتاب الصلوات"
"4417","(۴۴۱۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : قَرَأَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَۃٍ مَکْتُوبَۃٍ سَجْدَۃً ، ثُمَّ سَجَدَ۔","Da'if","Musannaf Ibn Abi Shaybah 4417","","","كتاب الصلوات"
"4418","(۴۴۱۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : بَلَغَنِی عَنْ أَبِی مِجْلَزٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی صَلاَۃِ الظُّہْرِ سَجْدَۃ فَسَجَدَ ، فَرَأَوْا أَنَّہُ قَرَأَ : (ألم تَنْزِیلُ) السَّجْدَۃَ۔","Majhul","Musannaf Ibn Abi Shaybah 4418","","","كتاب الصلوات"
"4419","(۴۴۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا التَّیْمِیُّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ ، قَالَ : وَلَمْ یَسْمَعْہُ التَّیْمِیُّ مِنْ أَبِی مِجْلَزٍ۔","","Musannaf Ibn Abi Shaybah 4419","","","كتاب الصلوات"
"4420","(۴۴۲۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ إیَاسِ بْنِ دَغْفَلٍ ، عَنْ أَبِی حَکِیمَۃَ ؛ أَنَّ ابْنَ عُمَرَ صَلَّی بِأَصْحَابِہِ الظُّہْرَ، فَسَجَدَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4420","","","كتاب الصلوات"
"4421","(۴۴۲۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی ابْنَ الزُّبَیْرِ فِی حَائِطٍ مِنْ حِیطَانِ مَکَّۃَ ، قَالَ : فَصَلَّی الْعَصْرَ ، أَوِ الظُّہْرَ ، قَالَ : فَسَجَدَ ، فَقَالَ لَہُ رَجُلٌ : إنَّک صَلَّیْت خَمْسَ رَکَعَاتٍ ، فَقَالَ : إنِّی قَرَأْتُ سُورَۃً فِیہَا سَجْدَۃٌ۔","Majhul","Musannaf Ibn Abi Shaybah 4421","","","كتاب الصلوات"
"4422","(۴۴۲۲) حَدَّثَنَا وَکِیعٌ ، وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ؛ أَنَّ ابْنَ مَسْعُودٍ قَرَأَ فِی الظُّہْرِ: (ألم تَنْزِیلُ) السَّجْدَۃَ ، وَفِی الأُخْرَی بِسُورَۃٍ مِنَ الْمَثَانِی۔","","Musannaf Ibn Abi Shaybah 4422","","","كتاب الصلوات"
"4423","(۴۴۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ: لاَ تَقْرَأُ السَّجْدَۃَ فِی شَیْئٍ مِنَ الْمَکْتُوبَۃِ إِلاَّ فِی صَلاَۃِ الْفَجْرِ ، وَکَانَ إبْرَاہِیمُ یَسْتَحِبُّ یَوْمَ الْجُمُعَۃِ أَنْ یَقْرَأَ بِسُورَۃٍ فِیہَا سَجْدَۃٌ۔","","Musannaf Ibn Abi Shaybah 4423","","","كتاب الصلوات"
"4424","(۴۴۲۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عِمْرَانَ بن حُدیر ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَانَ لاَ یَسْجُدُ فِی صَلاَۃٍ مَکْتُوبَۃٍ ، وَیَقُولُ : أَکْرَہُ أَنْ أَزِیدَ فِی صَلاَۃٍ مَکْتُوبَۃٍ۔","","Musannaf Ibn Abi Shaybah 4424","","","كتاب الصلوات"
"4425","(۴۴۲۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : جَائَ رَجُلٌ إلَی عُمَرَ ، فَقَالَ: إنَّ فُلاَنًا صَلَّی بِنَا الْفَجْرَ فَقَرَأَ بِسُورَۃٍ سَجَدَ فِیہَا ، فَقَالَ لَہُ عُمَرُ : أَوَقَدْ فَعَلَ ؟ قَالَ : نَعَمْ ، فَصَلَّی عُمَرُ مِنَ الْغَدِ ، فَقَرَأَ بِالنَّحْلِ وَبَنِی إسْرَائِیلَ ، فَسَجَدَ فِیہِمَا جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 4425","","","كتاب الصلوات"
"4426","(۴۴۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ ، قَالَ : صَلَّیْتُ مَعَ عُثْمَانَ الْعِشَائَ الآخِرَۃَ ، فَقَرَأَ بِالنَّجْمِ فَسَجَدَ فِیہَا ، ثُمَّ قَامَ فَقَرَأَ : وَالتِّینِ وَالزَّیْتُونِ۔","Da'if","Musannaf Ibn Abi Shaybah 4426","","","كتاب الصلوات"
"4427","(۴۴۲۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ سُوَیْد بْنِ مَنْجُوفٍ ، قَالَ : حدَّثَنَا أَبُو رَافِعٍ ، قَالَ : صَلَّی بِنَا عُمَرُ الْعِشَائَ الآخِرَۃَ ، فَقَرَأَ فِی إحْدَی الرَّکْعَتَیْنِ : {إذَا السَّمَائُ انْشَقَّتْ} فَسَجَدَ ، وَسَجَدْنَا مَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4427","","","كتاب الصلوات"
"4428","(۴۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : قُلْتُ لأَبِی الْعَالِیَۃِ : صَلَّیْتُ فِی مَسْجِدِ بَنِی فُلاَنٍ ، فَقَرَأَ إمَامُہُمُ السَّجْدَۃَ فَلَمْ یَسْجُدْ ، قَالَ : أَفَلاَ سَجَدْتَ ؟۔","","Musannaf Ibn Abi Shaybah 4428","","","كتاب الصلوات"
"4429","(۴۴۲۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ؛ أَنَّہُ سَمِعَ عَبْدَ الرَّحْمَن الأَعْرَجَ یَقُولُ : کَانَ أَبُو ہُرَیْرَۃَ یَسْجُدُ فِی {إذَا السَّمَائُ انْشَقَّتْ} فَإِذَا قُرِئَتْ وَکَانَ خَلْفَ الإِمَام فَلَمْ یَسْجُدِ الإِمَامُ ، قَالَ : فَیُومِیئُ بِرَأْسِہِ أَبُو ہُرَیْرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 4429","","","كتاب الصلوات"
"4430","(۴۴۳۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی عَمْرٍو مَوْلَی الْمُطَّلِبِ ؛ أَنَّہُ حَدَّثَہُمْ ، قَالَ : إنِّی لَقَاعِدٌ مَعَ ابْنِ عُمَرَ یَوْمَ الْجُمُعَۃِ إلَی حُجْرَۃِ عَائِشَۃَ ، وَطَارِقٌ یَخْطُبُ النَّاسَ عَلَی الْمِنْبَرِ ، فَقَرَأَ (النَّجْمَ) ، فَلَمَّا فَرَغَ وَقَعَ ابْنُ عُمَرَ سَاجِدًا ، وَسَجَدْنَا مَعَہُ ، وَمَا یَتَحَرَّک الأَخَرُ۔","Majhul","Musannaf Ibn Abi Shaybah 4430","","","كتاب الصلوات"
"4431","(۴۴۳۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَسِیَ سَجْدَۃً مِنْ أول صَلاَتِہِ فَلَمْ یَذْکُرْہَا حَتَّی کَانَ فِی آخِرِ رَکْعَۃٍ مِنْ صَلاَتِہِ ، قَالَ : یَسْجُدُ فِیہَا ثَلاَثَ سَجَدَاتٍ ، فَإِنْ لَمْ یَذْکُرْہَا حَتَّی یَقْضِیَ صَلاَتَہُ غَیْرَ أَنَّہُ لَمْ یُسَلِّمْ بَعْدُ ، قَالَ : یَسْجُدُ سَجْدَۃً وَاحِدَۃً مَا لَمْ یَتَکَلَّمْ ، فَإِنْ تَکَلَّمَ اسْتَأْنَفَ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4431","","","كتاب الصلوات"
"4432","(۴۴۳۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ الرَّجُلُ سَجْدَۃً مِنَ الصَّلاَۃ ، فَلْیَسْجُدْہَا مَتَی مَا ذَکَرَہَا فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4432","","","كتاب الصلوات"
"4433","(۴۴۳۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَشُکُّ فِی سَجْدَۃٍ وَہُوَ جَالِسٌ لاَ یَدْرِی سَجَدَہَا أَمْ لاَ ، قَالَ مُجَاہِدٌ : إِنْ شِئْتَ فَاسْجُدْہَا ، فَإِذَا قَضَیْتَ صَلاَتَکَ ، فَاسْجُدْ سَجْدَتَیْنِ وَأَنْتَ جَالِسٌ ، وَإِنْ شِئْتَ فَلاَ تَسْجُدْہَا ، وَاسْجُدْ سَجْدَتَیْنِ وَأَنْتَ جَالِسٌ فِی آخِرِ صَلاَتِک۔","","Musannaf Ibn Abi Shaybah 4433","","","كتاب الصلوات"
"4434","(۴۴۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَمِعَ السَّجْدَۃَ وَہُوَ رَاکِعٌ ، أَوْ سَاجِدٌ ، أَجْزَأَہُ رُکُوعُہُ وَسُجُودُہُ مِنَ السُّجُودِ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4434","","","كتاب الصلوات"
"4435","(۴۴۳۵) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، عَنْ عَبْدِاللہِ، قَالَ: صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃً فَزَادَ ، أَوْ نَقَصَ ، فَلَمَّا سَلَّمَ وَأَقْبَلَ عَلَی الْقَوْمِ بِوَجْہِہِ ، قَالُوا: یَا رَسُولَ اللہِ ، حَدَثَ فِی الصَّلاَۃ شَیْئٌ؟ قَالَ : وَمَا ذَاکَ ؟ قَالُوا : صَلَّیْتَ کَذَا وَکَذَا ، فَثَنَی رِجْلَہُ فَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ وَأَقْبَلَ عَلَی الْقَوْمِ بِوَجْہِہِ ، فَقَالَ : إِنَّہُ لَوْ حَدَثَ فِی الصَّلاَۃ شَیْئٌ أَنْبَأْتُکُمْ بِہِ ، وَلَکِنِّی بَشَرٌ أَنْسَی کَمَا تَنْسَوْنَ ، فَإِذَا نَسِیتُ فَذَکِّرُونِی ، فَإِذَا سَہَا أَحَدُکُمْ فِی صَلاَتِہ فَلْیَتَحَرَّ الصَّوَابَ فَلْیُتِمَّ عَلَیْہِ ، فَإِذَا سَلَّمَ سَجَدَ سَجْدَتَیْنِ۔ (بخاری ۴۰۱۔ ابوداؤد ۱۰۱۲)","Sahih","Musannaf Ibn Abi Shaybah 4435","","","كتاب الصلوات"
"4436","(۴۴۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا شَکَّ أَحَدُکُمْ فِی صَلاَتِہِ فَلْیُلْغ الشَّکَّ ، وَیَبْنِ عَلَی الْیَقِینِ ، فَإِذَا اسْتَیْقَنَ التَّمَامَ رَکَعَ رَکْعَۃً وَسَجَدَ سَجْدَتَیْنِ ، فَإِنْ کَانَتْ صَلاَتُہُ تَامَّۃً ، کَانَتِ الرَّکْعَۃُ وَالسَّجْدَتَانِ نَافِلَۃً ، وَإِنْ کَانَتْ نَاقِصَۃً کَانَتِ الرَّکْعَۃُ تَمَامَ صَلاَتِہِ ، وَالسَّجْدَتَانِ یُرْغِمَانِ الشَّیْطَانَ۔ (ابوداؤد ۱۰۱۶۔ احمد ۳/۸۴)","Hasan","Musannaf Ibn Abi Shaybah 4436","","","كتاب الصلوات"
"4437","(۴۴۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْتُ مَعَ عُمَرَ أَرْبَعًا قَبْلَ الظُّہْرِ فِی بَیْتِہِ ، وَقَالَ : إذَا أَوْہَمْتَ فَکُنْ فِی زِیَادَۃٍ ، وَلاَ تَکُنْ فِی نُقْصَانٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4437","","","كتاب الصلوات"
"4438","(۴۴۳۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ : إذَا شَکَّ فِی الزِّیَادَۃِ وَالنُّقْصَانِ فَلْیُصَلِّ رَکْعَۃً ، فَإِنَّ اللَّہَ لاَ یُعَذِّبُ عَیََ زِیَادَۃٍ فِی صَلاَۃ ، فَإِنْ کَانَتْ تَمَامًا کَانَتْ لَہُ ، وَإِنْ کَانَتْ زِیَادَۃً کَانَتْ لَہُ۔","","Musannaf Ibn Abi Shaybah 4438","","","كتاب الصلوات"
"4439","(۴۴۳۹) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ: إذَا شَکَکْتَ فَلَمْ تَدْرِ، أَتْمَمْتَ، أَوْ لَمْ تُتِمَّ ، فَأَتْمِمْ مَا شَکَکْتَ ، فَإِنَّ اللَّہَ لاَ یُعَذِّبُ عَلَی الزِّیَادَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4439","","","كتاب الصلوات"
"4440","(۴۴۴۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا شَکَّ أَحَدُکُمْ فِی صَلاَتِہِ ، فَلْیَتَحَرَّ أَکْثَرَ ظَنِّہِ ، فَلْیَبْنِ عَلَیْہِ ، فَإِنْ کَانَ أَکْثَرُ ظَنِّہِ أَنَّہُ صَلَّی ثَلاَثًا ، فَلْیَرْکَعْ رَکْعَۃً ، وَیَسْجُدْ سَجْدَتَیْنِ ، وَإِنْ کَانَ ظَنُّہُ أَرْبَعًا فَلْیَسْجُدْ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4440","","","كتاب الصلوات"
"4441","(۴۴۴۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : یَتَحَرَّی وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4441","","","كتاب الصلوات"
"4442","(۴۴۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَقُولُ: یَتَوَخَّی الَّذِی یُرَی أَنَّہُ نَقَصَ فَیُتِمَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4442","","","كتاب الصلوات"
"4443","(۴۴۴۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَالِمٍ ، قَالَ : إذَا شَکَّ فَلَمْ یَدْرِ أَثَلاَثًا صَلَّی أَمْ أَرْبَعًا ، فَلْیَرْمِ بِالشَّکِّ وَیَسْجُدْ سَجْدَتَیْنِ ، فَذَکَرْتُ ذَلِکَ لِلْقَاسِمِ ، فَقَالَ : وَأَنَا کَذَاکَ أَقُولُ ، وَأَنَا کَذَاکَ أَقُولُ۔","","Musannaf Ibn Abi Shaybah 4443","","","كتاب الصلوات"
"4444","(۴۴۴۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی مَالِکُ بْنُ أَنَسٍ ، عَنْ عَفِیفِ بْنِ عَمْرٍو السَّہْمِیِّ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ عَمْرِو بْنِ الْعَاصِ ، وَکَعْبًا عَنِ الَّذِی یَشُکُّ فِی صَلاَتِہِ ، صَلَّی ثَلاَثًا ، أَوْ أَرْبَعًا ؟ فَکِلاَہُمَا قَالَ : لِیَقُمْ فَلْیُصَلِّ رَکْعَۃً ، ثُمَّ یَسْجُدْ سَجْدَتَیْنِ ، إذَا صَلَّی وَہُوَ جَالِسٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4444","","","كتاب الصلوات"
"4445","(۴۴۴۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَحَرَّی وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4445","","","كتاب الصلوات"
"4446","(۴۴۴۶) حَدَّثَنَا حَفْصٌ، عَنْ یَحْیَی، عَنْ سَالِمٍ، قَالَ: یَبْنِی عَلَی مَا یَسْتَیْقِنُ، قِیلَ لَہُ: وَیَسْجُدُ سَجْدَتَیْنِ؟ قَالَ: نَعَمْ۔","","Musannaf Ibn Abi Shaybah 4446","","","كتاب الصلوات"
"4447","(۴۴۴۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : إذَا شَکَّ أَحَدُکُمْ فِی صَلاَتِہِ فَلَمْ یَدْرِ زَادَ ، أَوْ نَقَصَ ، فَإِنْ کَانَ شَکَّ فِی الْوَاحِدَۃِ وَالثِّنْتَیْنِ ، فَلْیَجْعَلْہَا وَاحِدَۃً حَتَّی یَکُونَ الْوَہْمُ فِی الزِّیَادَۃِ ، ثُمَّ یَسْجُدْ سَجْدَتَیْنِ وَہُوَ جَالِسٌ قَبْلَ أَنْ یُسَلِّمَ ، ثُمَّ یُسَلِّمُ ۔ قَالَ مُحَمَّدٌ: قَالَ لِی حُسَیْنُ بْنُ عَبْدِ اللہِ : ہَلْ أَسْنَدَ لَکَ مَکْحُولٌ الْحَدِیثَ ؟ قَالَ مُحَمَّدٌ : ما سَأَلْتُہُ عَنْ ذَلِکَ ، قَالَ : فَإِنَّہُ ذَکَرَہُ عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ عُمَرَ ، وَابْنَ عَبَّاسٍ تَدَارَآ فِیہِ ، فَجَائَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ ، فَقَالَ : أنَا سَمِعْتُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ہَذَا الْحَدِیثَ۔(ترمذی ۳۹۸۔ احمد ۱/۱۹۰)","Hasan","Musannaf Ibn Abi Shaybah 4447","","","كتاب الصلوات"
"4448","(۴۴۴۸) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ فُرَاتٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَأَبِی عُبَیْدَۃَ ؛ أَنَّہُمَا کَانَا إذَا وَہِمَا فِی صَلاَتِہِمَا ، فَلَمْ یَدْرِیَا ثَلاَثًا صَلَّیَا ، أَمْ أَرْبَعًا ، سَجَدَا سَجْدَتَیْنِ قَبْلَ أَنْ یُسَلِّمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4448","","","كتاب الصلوات"
"4449","(۴۴۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : صَلَّی بِنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعَصْرَ ، فَسَلَّمَ مِنْ ثَلاَثِ رَکَعَاتٍ ، ثُمَّ دَخَلَ ، فَقَامَ إلَیْہِ رَجُلٌ ، یُقَالُ لَہُ : الْخِرْبَاقُ ، فَقَالَ : یَا رَسُولَ اللہِ ، فَذَکَرَ لَہُ الَّذِی صَنَعَ ، فَخَرَجَ مُغْضَبًا یَجُرُّ رِدَائَہُ حَتَّی انْتَہَی إلَی النَّاسِ ، فَقَالَ : صَدَقَ ہَذَا ؟ فَقَالُوا : نَعَمْ ، فَصَلَّی تِلْکَ الرَّکْعَۃَ ، ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔ (مسلم ۱۰۱۔ ابوداؤد ۱۰۱۰)","Sahih","Musannaf Ibn Abi Shaybah 4449","","","كتاب الصلوات"
"4450","(۴۴۵۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، وَالْحَسَنِ ، قَالاَ : یَنْتَہِی إلَی آخِرِ وَہْمِہِ ، ثُمَّ یَسْجُدُ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4450","","","كتاب الصلوات"
"4451","(۴۴۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : أَحْصِ مَا اسْتَطَعْتَ ، وَلاَ تُعِدْ۔","Sahih","Musannaf Ibn Abi Shaybah 4451","","","كتاب الصلوات"
"4452","(۴۴۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ قَعَدَ فِی الرَّکْعَۃِ الثَّالِثَۃِ ، فَسَبَّحُوا بِہِ ، فَقَامَ فَأَتَمَّہُنَّ أَرْبَعًا ، فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ أَقْبَلَ عَلَی الْقَوْمِ بِوَجْہِہِ ، فَقَالَ : إذَا وَہَمْتُمْ فَاصْنَعُوا ہَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 4452","","","كتاب الصلوات"
"4453","(۴۴۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا لَمْ یَدْرِ أَزَادَ ، أَمْ نَقَصَ ، فَلْیَسْجُدْ سَجْدَتَیْنِ وَہُوَ جَالِسٌ۔","Hasan","Musannaf Ibn Abi Shaybah 4453","","","كتاب الصلوات"
"4454","(۴۴۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَمَّا أَنَا فَإِذَا لَمْ أَدْرِ کَمْ صَلَّیْتُ فَإِنِّی أُعِیدُ۔","Sahih","Musannaf Ibn Abi Shaybah 4454","","","كتاب الصلوات"
"4455","(۴۴۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الَّذِی لاَ یَدْرِی ثَلاَثًا صَلَّی ، أَوْ أَرْبَعًا ، قَالَ : یُعِیدُ حَتَّی یَحْفَظَ۔","Sahih","Musannaf Ibn Abi Shaybah 4455","","","كتاب الصلوات"
"4456","(۴۴۵۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالاَ : إذَا صَلَّی فَانْصَرَفَ فَلَمْ یَدْرِ کَمْ صَلَّی شَفْعًا ، أَوْ وِتْرًا ، فَلْیُعِدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4456","","","كتاب الصلوات"
"4457","(۴۴۵۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ (ح) وَعَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ بِنَحْوِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4457","","","كتاب الصلوات"
"4458","(۴۴۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الشَّکِّ فِی الصَّلاَۃ ؟ فَقَالَ : أَمَّا أَنَا فَإِذَا کَانَ فِی الْمَکْتُوبَۃِ فَإِنِّی أُعِیدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4458","","","كتاب الصلوات"
"4459","(۴۴۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ رَمَیْتُ الْجِمَار فَلَمْ أَدْرِ بِکَمْ رَمَیْتُ ، فَسَأَلْتُ ابْنَ عُمَرَ فَلَمْ یُجِبْنِی ، فَمَرَّ ابْنُ الْحَنَفِیَّۃِ فَسَأَلْتُہُ ، فَقَالَ : یُعِیدُ یَا أَبَا عَبْدِ اللہِ ، لَیْسَ شَئٌَٔ أَعْظَمَ عِنْدَنَا مِنَ الصَّلاَۃ ، فَإِذَا نَسِیَ أَحَدُنَا أَعَادَ ، قَالَ : فَذَکَرْت لابْنِ عُمَرَ قَوْلَہُ ، فَقَالَ : إنَّہُمْ أَہْلُ بَیْتٍ مُفْہِمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 4459","","","كتاب الصلوات"
"4460","(۴۴۶۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُعِیدُ ، فَذَکَرْتُہُ لأَبِی ألضُّحَی ، فَقَالَ : کَانَ شُرَیْحٌ یَقُولُ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 4460","","","كتاب الصلوات"
"4461","(۴۴۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا صَلَّیْتَ فَلَمْ تَدْرِ کَمْ صَلَّیْتَ فَأَعِدْہَا مَرَّۃً ، فَإِنِ التبستْ عَلَیْک مَرَّۃً أُخْرَی ، فَلاَ تُعِدْہَا۔","","Musannaf Ibn Abi Shaybah 4461","","","كتاب الصلوات"
"4462","(۴۴۶۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٍ ، عَنْ مَالِکٍ ، عَنْ عَطَائٍ ، قَالَ : یُعِیدُ۔","","Musannaf Ibn Abi Shaybah 4462","","","كتاب الصلوات"
"4463","(۴۴۶۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : یُعِیدُ مَرَّۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 4463","","","كتاب الصلوات"
"4464","(۴۴۶۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ فُرَاتٍ ، عَنْ عَبْدِ الْکَرِیمِ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، وَمَیْمُونٍ ؛ أَنَّہُمْ کَانُوا إذَا وَہَمُوا فِی الصَّلاَۃ أَعَادُوا۔","","Musannaf Ibn Abi Shaybah 4464","","","كتاب الصلوات"
"4465","(۴۴۶۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، وَسَعِیدِ بْنِ جُبَیْرٍ ، قَالاَ : فِی التَّطَوُّعِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4465","","","كتاب الصلوات"
"4466","(۴۴۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَرَی الْوَہْمَ فِی التَّطَوُّعِ۔","Hasan","Musannaf Ibn Abi Shaybah 4466","","","كتاب الصلوات"
"4467","(۴۴۶۷) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِی ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی أَیُّوبَ ، قَالَ : حَدَّثَنِی أَبُو عَقِیلٍ ؛ أَنَّہُ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : سَجْدَتَا السَّہْوِ فِی النَّوَافِلِ ، کَسَجْدَتَیِ السَّہْوِ فِی الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 4467","","","كتاب الصلوات"
"4468","(۴۴۶۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ شَیْئٍ مِنَ الْوَہْمِ فِی التَّطَوُّعِ ؟ فَقَالَ : لاَ أَدْرِی أَیْنَ مَوْضِعُہُ ، فَقُلْتُ : أَسْجُدُ بَعْدَہُ سَجْدَتَیْنِ ؟ قَالَ : أَتُشَبِّہُہَا بِالْمَکْتُوبَۃِ ؟ أَمَّا أَنَا فَلَوْ کُنْتُ لَمْ أَفْعَلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4468","","","كتاب الصلوات"
"4469","(۴۴۶۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی الْوَہْمَ فِی التَّطَوُّعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4469","","","كتاب الصلوات"
"4470","(۴۴۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنْ ضَمْرَۃَ بْنِ سَعِیدٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ سَجَدَ سَجْدَتَیِ السَّہْوِ بَعْدَ السَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 4470","","","كتاب الصلوات"
"4471","(۴۴۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّہُ سَجَدَہُمَا بَعْدَ التَّسْلِیمِ۔","","Musannaf Ibn Abi Shaybah 4471","","","كتاب الصلوات"
"4472","(۴۴۷۲) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا قَالَ : سَجْدَتَا السَّہْوِ بَعْدَ السَّلاَمِ وَقَبْلَ الْکَلاَمِ۔","","Musannaf Ibn Abi Shaybah 4472","","","كتاب الصلوات"
"4473","(۴۴۷۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَہُمَا بَعْدَ مَا سَلَّمَ وَتَکَلَّمَ۔ (بخاری ۱۲۲۹۔ مسلم ۹۷)","Hasan","Musannaf Ibn Abi Shaybah 4473","","","كتاب الصلوات"
"4474","(۴۴۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَہَا فَصَلَّی رَکْعَۃً ، ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 4474","","","كتاب الصلوات"
"4475","(۴۴۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّ عَبْدَ اللہِ سَجَدَ سَجْدَتَیِ السَّہْوِ بَعْدَ السَّلاَمِ ، وَذُکِرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔ (بخاری۴۰۱۔ ترمذی ۳۹۲)","Sahih","Musannaf Ibn Abi Shaybah 4475","","","كتاب الصلوات"
"4476","(۴۴۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ سَعْدًا ، وَعَمَّارًا سَجَدَاہُمَا بَعْدَ التَّسْلِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 4476","","","كتاب الصلوات"
"4477","(۴۴۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ بْنِ الْحَارِثِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ ، وَالسَّائِبَ الْقَارِیَّ کَانَا یَقُولاَنِ : السَّجْدَتَانِ قَبْلَ الْکَلاَمِ وَبَعْدَ التَّسْلِیمِ۔","","Musannaf Ibn Abi Shaybah 4477","","","كتاب الصلوات"
"4478","(۴۴۷۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَأَنَسٍ ؛ أَنَّہُمَا سَجَدَا سَجْدَتَیِ السَّہْوِ بَعْدَ السَّلاَمِ ، ثُمَّ قَامَا وَلَمْ یُسَلِّمَا۔","Sahih","Musannaf Ibn Abi Shaybah 4478","","","كتاب الصلوات"
"4479","(۴۴۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّہُ سَہَا فَسَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4479","","","كتاب الصلوات"
"4480","(۴۴۸۰) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ؛ أَنَّہُ سَہَا فِی الصَّلاَۃ بِالشَّامِ ، فَسَجَدَ سَجْدَتَیْنِ بَعْدَ التَّسْلِیمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4480","","","كتاب الصلوات"
"4481","(۴۴۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَہُمَا بَعْدَ مَا سَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4481","","","كتاب الصلوات"
"4482","(۴۴۸۲) حدَّثَنَا سُفْیَانُ ، عَنِ الزُّہْرِیِّ ، عَنِ الأَعْرَجِ ، عَنِ ابْنِ بُحَیْنَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی صَلاَۃً نَظُنُّ أَنَّہَا الْعَصْرُ ، فَلَمَّا کَانَ فِی الثَّالِثَۃِ قَامَ قَبْلَ أَنْ یَجْلِسَ ، فَلَمَّا کَانَ قَبْلَ أَنْ یُسَلِّمَ سَجَدَ سَجْدَتَیْنِ۔ (بخاری ۸۲۹۔ ابوداؤد ۱۰۲۷)","Sahih","Musannaf Ibn Abi Shaybah 4482","","","كتاب الصلوات"
"4483","(۴۴۸۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، وَالزُّہْرِیِّ ، قَالاَ : سَجْدَتَانِ قَبْلَ أَنْ یُسَلِّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4483","","","كتاب الصلوات"
"4484","(۴۴۸۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، وَحَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَلَّمَ فِی سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4484","","","كتاب الصلوات"
"4485","(۴۴۸۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سَلَّمَ فِیہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 4485","","","كتاب الصلوات"
"4486","(۴۴۸۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : فِیہِمَا تَسْلِیمٌ۔","","Musannaf Ibn Abi Shaybah 4486","","","كتاب الصلوات"
"4487","(۴۴۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ سَعْدٍ ، وَعَمَّارٍ ؛ أَنَّہُمَا صَلَّیَا ثَلاَثًا ، ثُمَّ سَلَّمَا ، فَقِیلَ لَہُمَا : فَقَضَیَا الَّتِی بَقِیَتْ عَلَیْہِمَا ، ثُمَّ کَبَّرَا ، ثُمَّ سَجَدَا ، ثُمَّ سَلَّمَا تَسْلِیمَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4487","","","كتاب الصلوات"
"4488","(۴۴۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّہُ سَجَدَہُمَا ثُمَّ سَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4488","","","كتاب الصلوات"
"4489","(۴۴۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَلَّمَ فِیہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4489","","","كتاب الصلوات"
"4490","(۴۴۹۰) حَدَّثَنَا جَرِیرٌ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِالْمَلِکِ بْنِ إیَاسٍ، عَنْ إبْرَاہِیمَ، قَالَ: تَسْلِیمُ السَّہْوِ وَالْجِنَازَۃِ وَاحِدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4490","","","كتاب الصلوات"
"4491","(۴۴۹۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی سَجْدَتَیِ السَّہْوِ فِیہِمَا سَلاَمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4491","","","كتاب الصلوات"
"4492","(۴۴۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : یَتَشَہَّدُ فِیہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 4492","","","كتاب الصلوات"
"4493","(۴۴۹۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : فِیہِمَا تَشَہُّدٌ۔","","Musannaf Ibn Abi Shaybah 4493","","","كتاب الصلوات"
"4494","(۴۴۹۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَ سَجْدَتَیِ السَّہْوِ فَتَشَہَّدَ فِیہِمَا ثُمَّ سَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4494","","","كتاب الصلوات"
"4495","(۴۴۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ ، عَنْ عَلْقَمَۃَ ، قَالَ : سُئِلَ مُحَمَّدُ بْنُ سِیرِینَ عَنْ سَجْدَتَیِ الْوَہْمِ ، فِیہِمَا تَشَہُّدٌ ؟ قَالَ : أَحَبُّ إلَیَّ أَنْ یَتَشَہَّدَ فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 4495","","","كتاب الصلوات"
"4496","(۴۴۹۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا ابْنُ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ تَشَہُّدٌ ، وَلاَ تَسْلِیمٌ۔","","Musannaf Ibn Abi Shaybah 4496","","","كتاب الصلوات"
"4497","(۴۴۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ فِیہِمَا تَشَہُّدٌ ، وَلاَ تَسْلِیمٌ۔","","Musannaf Ibn Abi Shaybah 4497","","","كتاب الصلوات"
"4498","(۴۴۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَأَنَسٍ ؛ أَنَّہُمَا سَجَدَاہُمَا ، ثُمَّ قَامَا وَلَمْ یُسَلِّمَا۔","Sahih","Musannaf Ibn Abi Shaybah 4498","","","كتاب الصلوات"
"4499","(۴۴۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتَشَہَّدُ الإِمَام فِی سَجْدَتَیِ السَّہْوِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4499","","","كتاب الصلوات"
"4500","(۴۵۰۰) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ أَنَّہُمَا قَالاَ : یَتَشَہَّدُ فِی السَّہْوِ ، ثُمَّ یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4500","","","كتاب الصلوات"
"4501","(۴۵۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَجَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجْدَتَیِ السَّہْوِ بَعْد َمَا سَلَّمَ وَکَبَّرَ ، فَسَجَدَ وَکَبَّرَ وَہُوَ جَالِسٌ ، ثُمَّ رَفَعَ وَکَبَّرَ ، ثُمَّ سَجَدَ وَکَبَّرَ ، ثُمَّ رَفَعَ وَکَبَّرَ۔","Hasan","Musannaf Ibn Abi Shaybah 4501","","","كتاب الصلوات"
"4502","(۴۵۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ سَعْدٍ ، وَعَمَّارٍ ؛ أَنَّہُمَا صَلَّیَا ثَلاَثًا ، فَقِیلَ لَہُمَا : فَقَضَیَا الَّتِی بَقِیَتْ عَلَیْہِمَا ثُمَّ سَلَّمَا ، ثُمَّ کَبَّرَا ، ثُمَّ سَجَدَا ، ثُمَّ کَبَّرَا، ثُمَّ رَفَعَا، ثُمَّ کَبَّرَا وَسَجَدَا، ثُمَّ کَبَّرَا وَرَفَعَا۔","Da'if","Musannaf Ibn Abi Shaybah 4502","","","كتاب الصلوات"
"4503","(۴۵۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ بن أبی العَیزار ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَہُمَا بِتَکْبِیرَۃٍ۔","","Musannaf Ibn Abi Shaybah 4503","","","كتاب الصلوات"
"4504","(۴۵۰۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4504","","","كتاب الصلوات"
"4505","(۴۵۰۵) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالاَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ سَہْوٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4505","","","كتاب الصلوات"
"4506","(۴۵۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ مُغِیرَۃَ ، وَابْنَ أَبِی لَیْلَی ، والبَتّیَّ ، عَنْ رَجُلٍ سَہَا فِی سَجْدَتَیِ السَّہْوِ ؟ فَقَالوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4506","","","كتاب الصلوات"
"4507","(۴۵۰۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ فِی سَجْدَتَیِ السَّہْوِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4507","","","كتاب الصلوات"
"4508","(۴۵۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَجَدَ سَجْدَتَیِ السَّہْوِ بَعْدَ الْکَلاَمِ۔ (مسلم ۴۰۲۔ ترمذی ۳۹۳)","Sahih","Musannaf Ibn Abi Shaybah 4508","","","كتاب الصلوات"
"4509","(۴۵۰۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی رَجُلٍ نَسِیَ سَجْدَتَیِ السَّہْوِ حَتَّی یَخْرُجَ مِنَ الْمَسْجِدِ ؟ قَالَ : لاَ یُعِیدُ ، وَقَالَ ابْنُ شُبْرُمَۃَ : یُعِیدُ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4509","","","كتاب الصلوات"
"4510","(۴۵۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّہُ لَقِیَ ذَلِکَ فَأَعَادَ الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4510","","","كتاب الصلوات"
"4511","(۴۵۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ وَضَّاحٍ ، قَالَ : سَأَلْتُ قَتَادَۃَ ، فَقَالَ : یُعِیدُ سَجْدَتَیِ السَّہْوِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4511","","","كتاب الصلوات"
"4512","(۴۵۱۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : إذَا صَرَفَ وَجْہَہُ عَنِ الْقِبْلَۃِ لَمْ یَبْنِ ، وَلَمْ یَسْجُدْ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4512","","","كتاب الصلوات"
"4513","(۴۵۱۳) حَدَّثَنَا شَرِیکٌ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، قَالَ : قُلْتُ لِلضَّحَّاکِ : إنِّی سَہَوْتُ ، وَلَمْ أَسْجُدْ ؟ قَالَ : ہَاہُنَا فَاسْجُدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4513","","","كتاب الصلوات"
"4514","(۴۵۱۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: ہُمَا عَلَیْہِ حَتَّی یَخْرُجَ، أَوْ یَتَکَلَّمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4514","","","كتاب الصلوات"
"4515","(۴۵۱۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، وَعَلِیِّ بْنِ مُدْرِکٍ ، قَالاَ : صَلَّی بِنَا عَلْقَمَۃُ فَصَلَّی بِنَا خَمْسًا ، فَلَمَّا سَلَّمَ ، قَالُوا لَہُ : صَلَّیْتَ خَمْسًا ، فَالْتَفَتَ إلَی رَجُلٍ مِنَ الْقَوْمِ ، فَقَالَ : کَذلکَ یَا أَعْوَرُ ؟ فَقَالَ : نَعَمْ ، فَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4515","","","كتاب الصلوات"
"4516","(۴۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : فِی کُلِّ سَہْوٍ سَجْدَتَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4516","","","كتاب الصلوات"
"4517","(۴۵۱۷) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ ، قَالَ: أَخْبَرَنَا الْہَیْثُمُ بْنُ حُمَیْدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدٍ ، عَنْ زُہَیْرٍ الْحِمْصِیِّ، عَنْ ثَوْبَانَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِکُلِّ سَہْوٍ سَجْدَتَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 4517","","","كتاب الصلوات"
"4518","(۴۵۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : صَلَّی بِنَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی ، فَلَمَّا جَلَسَ تَحَرَّکَ لِلْقِیَامِ ، سَجَدَ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4518","","","كتاب الصلوات"
"4519","(۴۵۱۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَمَّنَا أَنَسٌ فِی سَفَرٍ ، فَصَلَّی بِنَا الْعَصْرَ رَکْعَتَیْنِ ، فَلَمَّا جَلَسَ فِی الثَّانِیَۃ نَسِیَ أَنْ یُسَلِّمَ ، فَذَہَبَ لِیَقُومَ فَسَبَّحْنَا بِہِ ، فَلَمَّا جَلَسَ سَلَّمَ وَسَجَدَ سَجْدَتَیِ السَّہْوِ۔","Sahih","Musannaf Ibn Abi Shaybah 4519","","","كتاب الصلوات"
"4520","(۴۵۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ؛ أَنَّ أَنَسًا قَعَدَ فِی الرَّکْعَۃِ الثَّالِثَۃِ فَسَبَّحُوا ، فَقَامَ فَأَتَمَّہَا أَرْبَعًا ، فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ أَقْبَلَ عَلَی الْقَوْمِ ، فَقَالَ : إِذَا وَہِمْتُمْ فَاصْنَعُوا ہَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 4520","","","كتاب الصلوات"
"4521","(۴۵۲۱) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَطَائٍ ، قَالاَ : إنَّمَا السَّہْوُ فِی الزِّیَادَۃِ وَالنُّقْصَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4521","","","كتاب الصلوات"
"4522","(۴۵۲۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، وَعَلْقَمَۃَ ؛ أَنَّہُمَا کَانَا یَرْفَعَانِ رُؤُوسَہُمَا مِنَ السُّجُودِ حَتَّی تَرْتَفِعَ أَلْیَتَاہُمَا ، فَیَجْلِسَانِ وَلاَ یَسْجُدَانِ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4522","","","كتاب الصلوات"
"4523","(۴۵۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : صَلَّی فَنَہَضَ فِی الرَّکْعَتَیْنِ فَلَمْ یَسْتَتمِمْ قَائِمًا ، فَسَبَّحَ بِہِ الْقَوْمُ ، فَجَلَسَ فَلَمْ یَسْجُدْ لِذَلِکَ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4523","","","كتاب الصلوات"
"4524","(۴۵۲۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ فِی الَّذِی یَقُومُ فِی الرَّکْعَتَیْنِ ، قَالَ : إِنْ ذَکَرَ وَہُوَ مُتَحَادِبٌ جَلَسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4524","","","كتاب الصلوات"
"4525","(۴۵۲۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یَسْہُو فِی الصَّلاَۃ ، إنِ اسْتَوَی قَائِمًا فَعَلَیْہِ السَّجْدَتَانِ ، وَإِنْ ذَکَرَ قَبْلَ أَنْ یَعْتَدِلَ قَائِمًا فَلاَ سَہْوَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4525","","","كتاب الصلوات"
"4526","(۴۵۲۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : صَلَّیْتُ خَلْفَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ فَقَامَ فِی الثَّانِیَۃِ ، فَسَبَّحَ النَّاسُ بِہِ فَلَمْ یَجْلِسْ ، فَلَمَّا سَلَّمَ وَانْفَتَلَ سَجَدَ سَجْدَتَنِیْ وَہُوَ جَالِسٌ ، ثُمَّ قَالَ : ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَنَعَ۔ (ابوداؤد ۱۰۲۹۔ احمد ۴/۲۵۳)","Da'if","Musannaf Ibn Abi Shaybah 4526","","","كتاب الصلوات"
"4527","(۴۵۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، قَالَ : صَلَّی سَعْدُ بْنُ مَالِکٍ بِأَصْحَابِہِ ، فَقَامَ فِی الرَّکْعَۃِ الثانیۃ فَسَبَّحَ بِہِ الْقَوْمُ ، فَلَمْ یَجْلِسْ وَسَبَّحَ ہُوَ وَأَشَارَ إلَیْہِمْ ، أَنْ قُومُوا فَصَلَّی وَسَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4527","","","كتاب الصلوات"
"4528","(۴۵۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، وَعَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ؛ أَنَّ ابْنَ بُحَیْنَۃَ أَخْبَرَہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَامَ فِی اثْنَتَیْنِ مِنَ الظُّہْرِ ، نَسِیَ الْجُلُوسَ ، حَتَّی إذَا فَرَغَ مِنْ صَلاَتِہِ إِلاَّ أَنْ یُسَلِّمَ ، سَجَدَ سَجْدَتَیِ السَّہْوِ وَسَلَّمَ۔ (ابن ماجہ ۱۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 4528","","","كتاب الصلوات"
"4529","(۴۵۲۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ قَامَ فِی رَکْعَتَیْنِ فَسَبَّحَ الْقَوْمُ ، حَتَّی إذَا عَرَفَ أَنَّہُ قَدْ وَہَمَ فَمَضَی فِی صَلاَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4529","","","كتاب الصلوات"
"4530","(۴۵۳۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ النُّعْمَانَ بْنَ بَشِیرٍ صَلَّی فَنَہَضَ فِی الرَّکْعَتَیْنِ فَسَبَّحُوا بِہِ فَمَضَی ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَیِ السَّہْوِ وَہُوَ جَالِسٌ۔","Hasan","Musannaf Ibn Abi Shaybah 4530","","","كتاب الصلوات"
"4531","(۴۵۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : صَلَّیْتُ رَکْعَتَیْنِ ، فَلَمَّا أَرَدْتُ أَنْ أَجْلِسَ قُمْتُ ، قَالَ : لَوْ کُنْتُ أَنَا لَمَضَیْتُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4531","","","كتاب الصلوات"
"4532","(۴۵۳۲) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ ؛ أَنَّ عَبْدَ الرَّحْمَن بْنَ شِمَاسَۃَ حَدَّثَہُ ، أَنَّ عُقْبَۃَ بْنَ عَامِرٍ قَامَ فِی صَلاَۃٍ وَعَلَیْہِ جُلُوسٌ ، فَقَالَ النَّاسُ : سُبْحَانَ اللہِ ، فَعَرَفَ الَّذِی یُرِیدُونَ ، فَلَمَّا أَنْ صَلَّی سَجَدَ سَجْدَتَیْنِ وَہُوَ جَالِسٌ ، فَقَالَ : إنِّی قَدْ سَمِعْتُ قَوْلَکُمْ ، وَہَذِہِ سُنَّۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4532","","","كتاب الصلوات"
"4533","(۴۵۳۳) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُصَلِّی رَکْعَتَیْنِ مِنَ الْمَکْتُوبَۃِ ، ثُمَّ یَقُومُ ، قَالَ : إنِ استتم قَائِمًا مَضَی فِی صَلاَتِہِ ، فَإِذَا ہُوَ أَکْمَلَ صَلاَتَہُ سَجَدَ سَجْدَتَیْنِ وَہُوَ جَالِسٌ بَعْدَ مَا یُسَلِّمُ۔","","Musannaf Ibn Abi Shaybah 4533","","","كتاب الصلوات"
"4534","(۴۵۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی رَکْعَتَیْنِ مِنَ الْمَکْتُوبَۃِ وَنَسِیَ أَنْ یَتَشَہَّدَ حَتَّی نَہَضَ ، قَالَ : إذَا اسْتَوَی قَائِمًا مَضَی فِی صَلاَتِہِ ، وَسَجَدَ سَجْدَتَیِ السَّہْو۔","No Data Available","Musannaf Ibn Abi Shaybah 4534","","","كتاب الصلوات"
"4535","(۴۵۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : صَلَّیْت خَلْفَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ، فَقَامَ فِی الرَّکْعَتَیْنِ فَلَمْ یَجْلِسْ ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4535","","","كتاب الصلوات"
"4536","(۴۵۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : صَلَّی بِنَا عِمْرَانُ بْنُ حُصَیْنٍ فِی الْمَسْجِدِ فَنَہَضَ فِی رَکْعَتَیْنِ ، أَوْ قَعَدَ فِی ثَلاَثٍ ، وَأَکْثَرُ ظَنِّ ہِشَامٍ أَنَّہُ قَعَدَ فِی الرَّکْعَتَیْنِ ، فَلَمَّا أَتَمَّ الصَّلاَۃ سَجَدَ سَجْدَتَیِ السَّہْوِ۔","Sahih","Musannaf Ibn Abi Shaybah 4536","","","كتاب الصلوات"
"4537","(۴۵۳۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : صَلَّی الضَّحَّاکُ بْنُ قَیْسٍ بِالنَّاسِ الظُّہْرَ ، فَلَمْ یَجْلِسْ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ ، فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَیْنِ وَہُوَ جَالِسٌ۔","Sahih","Musannaf Ibn Abi Shaybah 4537","","","كتاب الصلوات"
"4538","(۴۵۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : صَلَّی ابْنُ الزُّبَیْرِ فَسَلَّمَ فِی رَکْعَتَیْنِ ، ثُمَّ قَامَ إلَی الْحَجَرِ فَاسْتَلَمَہُ ، فَسَبَّحَ بِہِ الْقَوْمُ ، فَرَجَعَ فَأَتَمَّ وَسَجَدَ سَجْدَتَیْنِ ، قَالَ : فَذَکَرْتُ ذَلِکَ لابْنِ عَبَّاسٍ ، فَقَالَ : لِلَّہِ أَبُوہُ ، مَا أَمَاطَ عَنْ سُنَّۃِ نَبِیِّہِ۔ (احمد ۱/۳۵۱۔ ابو یعلی ۲۵۹۷)","Da'if","Musannaf Ibn Abi Shaybah 4538","","","كتاب الصلوات"
"4539","(۴۵۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سَلَّمَ فِی رَکْعَتَیْنِ ، فَقَامَ فَأَتَمَّ وَسَجَدَ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4539","","","كتاب الصلوات"
"4540","(۴۵۴۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ سَہَا فِی صَلاَتِہِ فَسَلَّمَ فِی رَکْعَتَیْنِ ؟ قَالَ : ثُمَّ ذَکَرَ ، قَالَ : یَمْضِی فِی صَلاَتِہِ ، وَیَسْجُدُ سَجْدَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4540","","","كتاب الصلوات"
"4541","(۴۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، قَالَ : صَلَّی بِنَا ابْنُ أَبِی لَیْلَی فَسَلَّمَ فِی الرَّکْعَتَیْنِ فَسَبَّحْنَا بِہِ ، فَقَامَ فَأَتَمَّ الصَّلاَۃ ، فَلَمَّا فَرَغَ سَجَدَ سَجْدَتَیْنِ ، قَالَ : فَذَکَرْتُ ذَلِکَ لِعِکْرِمَۃَ ، فَقَالَ : أَحْسَنَ۔","","Musannaf Ibn Abi Shaybah 4541","","","كتاب الصلوات"
"4542","(۴۵۴۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سَلَّمَ فِی الرَّکْعَتَیْنِ أَتَمَّ وَسَجَدَ سَجْدَتَیِ السَّہْوِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4542","","","كتاب الصلوات"
"4543","(۴۵۴۳) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ؛ أَنَّ سُوَیْد بْنَ قَیْسٍ أَخْبَرَہُ، عَنْ مُعَاوِیَۃَ بْنِ حُدِیجٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمًا فَسَلَّمَ وَانْصَرَفَ وَقَدْ بَقِیَ عَلَیْہِ مِنَ الصَّلاَۃ رَکْعَۃٌ ، فَأَدْرَکَہُ رَجُلٌ ، فَقَالَ : نَسِیتَ مِنَ الصَّلاَۃ رَکْعَۃً ، فَرَجَعَ فَدَخَلَ الْمَسْجِدَ وَأَمَرَ بِلاَلاً فَأَقَامَ الصَّلاَۃ فَصَلَّی بِالنَّاسِ رَکْعَۃً ، فَأَخْبَرْتُ بِذَلِکَ النَّاسَ فَقَالُوا : أَتَعْرِفُ الرَّجُلَ ؟ فَقُلْتُ : لاَ ، إِلاَّ أَنْ أَرَاہُ ، فَمَرَّ بِی ، فَقُلْتُ : ہُوَ ہَذَا ، فَقَالُوا : ہَذَا طَلْحَۃُ بْنُ عُبَیْدِ اللہِ۔ (ابوداؤد ۱۰۱۵۔ احمد ۴۰۱)","Sahih","Musannaf Ibn Abi Shaybah 4543","","","كتاب الصلوات"
"4544","(۴۵۴۴) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ ، عَنْ عِمْرَانَ بْن أَبِی أَنَسٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی یَوْمًا فَسَلَّمَ فِی رَکْعَتَیْنِ ، ثُمَّ انْصَرَفَ فَأَدْرَکَہُ ذُو الشِّمَالَیْنِ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَنَقَصَتِ الصَّلاَۃُ أَمْ نَسِیتَ ؟ قَالَ : لَمْ تَنْقُصِ الصَّلاَۃ ، وَلَمْ أَنْسَ ، فَقَالَ : بَلَی ، وَالَّذِی بَعَثَک بِالْحَقِّ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَصَدَقَ ذُو الْیَدَیْنِ ؟ قَالُوا : نَعَمْ یَا رَسُولَ اللہِ ، فَصَلَّی بِالنَّاسِ رَکْعَتَیْنِ۔ (بخاری ۷۲۵۔ ابوداؤد ۱۰۰۱)","Sahih","Musannaf Ibn Abi Shaybah 4544","","","كتاب الصلوات"
"4545","(۴۵۴۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الظُّہْرَ رَکْعَتَیْنِ ، ثُمَّ سَلَّمَ ، فَقِیلَ لَہُ : أَنَقَصَ مِنَ الصَّلاَۃ ؟ فَصَلَّی رَکْعَتَیْنِ أُخْرَاوَیْنِ وَسَلَّمَ، ثُمَّ سَجَدَ سَجْدَتَیْنِ۔ (بخاری ۱۲۲۷۔ ابوداؤد ۱۰۰۶)","Sahih","Musannaf Ibn Abi Shaybah 4545","","","كتاب الصلوات"
"4546","(۴۵۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالنَّاسِ ثَلاَثَ رَکَعَاتٍ ، ثُمَّ انْصَرَفَ ، فَقَالَ لَہُ بَعْضُ الْقَوْمِ : حَدَثَ فِی الصَّلاَۃ شَیْئٌ ؟ قَالَ : وَمَا ذَاکَ ؟ قَالُوا : لَمْ تُصَلِّ إِلاَّ ثَلاَثَ رَکَعَاتٍ ، فَقَالَ : أَکَذَلِکَ یَا ذَا الْیَدَیْنِ ؟ وَکَانَ یُسَمَّی ذا الشِّمَالَیْنِ ، قَالَ : نَعَمْ ، قَالَ : فَصَلَّی رَکْعَۃً وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4546","","","كتاب الصلوات"
"4547","(۴۵۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ أبی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْعَصْرَ فَسَلَّمَ فِی ثَلاَثِ رَکَعَاتٍ ، ثُمَّ دَخَلَ فَقَامَ إلَیْہِ رَجُلٌ، یُقَالُ لَہُ: الْخِرْبَاقُ، فَقَالَ : یَا رَسُولَ اللہِ ، فَذَکَّرَ لَہ الَّذِی صَنَعَ ، فَخَرَجَ مُغْضَبًا یَجُرُّ رِدَائَہُ حَتَّی انْتَہَی إلَی النَّاسِ ، فَقَالَ : صَدَقَ ہَذَا ؟ قَالُوا : نَعَمْ ، قَالَ : فَصَلَّی تِلْکَ الرَّکْعَۃَ ثُمَّ سَلَّمَ ، وَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 4547","","","كتاب الصلوات"
"4548","(۴۵۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِالنَّاسِ رَکْعَتَیْنِ فَسَہَا فَسَلَّمَ ، فَقَالَ لَہُ رَجُلٌ ، یُقَالُ لَہُ ذُو الْیَدَیْنِ ، فَذَکَرَ مِثْلَ حَدِیثِ ابْنِ عَوْنٍ ، وَہِشَامٍ ، وَحَدِیثُہُمَا أَنَّہُ قَالَ : نَقَصَتِ الصَّلاَۃُ ؟ فَقَالَ : لاَ ، فَصَلَّی رَکْعَتَیْنِ أُخْرَاوَیْنِ ، ثُمَّ سَلَّمَ ، ثُمَّ سَجَدَ سَجْدَتَیْنِ ، ثُمَّ سَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 4548","","","كتاب الصلوات"
"4549","(۴۵۴۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ؛ أَنَّ الزُّبَیْرَ بْنَ الْعَوَّامِ صَلَّی فَتَکَلَّمَ، فَبَنَی عَلَی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4549","","","كتاب الصلوات"
"4550","(۴۵۵۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنِ ، عَنْ مُحَمَّدِ بْنِ یُوسُفَ ، عَنْ أَبِیہِ ، قَالَ : فَاتَ ابْنَ الزُّبَیْرِ بَعْضُ الصَّلاَۃ ، فَقَالَ لِی بِیَدِہِ : کَمْ فَاتَنِی ؟ قَالَ : قُلْتُ : لاَ أَدْرِی مَا تَقُولُ ؟ قَالَ : کَمْ صَلَّیْتُم ؟ قُلْتُ : کَذَا وَکَذَا ، قَالَ : فَصَلَّی وَسَجَدَ سَجْدَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 4550","","","كتاب الصلوات"
"4551","(۴۵۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ مَکْحُولٍ ؛ أَنَّ أَبَا الدَّرْدَائِ صَلَّی بِہِمْ فِی سَقِیفَۃٍ بِالشَّامِ وَہُمْ خَارِجُونَ ، قَالَ : فَمُطِرُوا مَطَرًا بَلَغَ مِنْہُمْ ، فَلَمَّا صَلَّی أَوَ سَلَّمَ ، قَالَ : أَمَا کَانَ فِی الْقَوْمِ فَقِیہٌ یَقُولُ : یَا ہَذَا ، خَفِّفْ ، فَإِنَّا قَدْ مُطِرْنَا۔","","Musannaf Ibn Abi Shaybah 4551","","","كتاب الصلوات"
"4552","(۴۵۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الْعَصْرَ رَکْعَتَیْنِ ، ثُمَّ سَلَّمَ وَدَخَلَ ، فَدَخَلَ عَلَیْہِ رَجُلٌ مِنْ أَصْحَابِہِ ، یُقَالُ لَہُ : ذُو الشِّمَالَیْنِ ، فَقَالَ : یَا رَسُولَ اللہِ ، قَصُرَتِ الصَّلاَۃ ؟ قَالَ : مَاذَا ؟ قَالَ : صَلَّیْتَ رَکْعَتَیْنِ ، فَخَرَجَ ، فَقَالَ : مَا یَقُولُ ذُو الْیَدَیْنِ ؟ فَقَالُوا : یَا رَسُولَ اللہِ ، نَعَمْ ، فَصَلَّی بِہِمْ رَکْعَتَیْنِ وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4552","","","كتاب الصلوات"
"4553","(۴۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا : أَحْدَثْت فَصَلِّ رَکْعَتَیْنِ وَإِنْ تَکَلَّمْت۔","No Data Available","Musannaf Ibn Abi Shaybah 4553","","","كتاب الصلوات"
"4554","(۴۵۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عُرْوَۃَ بْنِ الزُّبَیْرِ ؛ أَنَّہُ صَلَّی مَرَّۃً الْمَغْرِبَ رَکْعَتَیْنِ، ثُمَّ سَلَّمَ فَکَلَّمَ قَائِدَہُ ، فَقَالَ لَہُ قائِدُہُ : إنَّمَا صَلَّیْتَ رَکْعَتَیْنِ ، فَصَلَّی رَکْعَۃً ، ثُمَّ سَلَّمَ وَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ قَالَ: إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَ مِثْلَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 4554","","","كتاب الصلوات"
"4555","(۴۵۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ، قَالَ: أَوْہَمَ إمَامٌ مِنْ أَئِمَّۃِ الْمَسْجِدِ الْجَامِعِ ، فَلَمْ یَسْجُدْ سَجْدَتَیِ السَّہْوِ، فَسَجَدَ بَعْضُ الْقَوْمِ ، وَلَمْ یَسْجُدْ بَعْضُہُمْ ، فَذُکِرَ ذَلِکَ لِلْحَسَنِ ، فَلَمْ یَرَ عَلَیْہِمْ سُجُودًا ، وَذُکِرَ ذَلِکَ لابْنِ سِیرِینَ ، فَاخْتَارَ صَنِیعَ الَّذِینَ سَجَدُوا۔","Hasan","Musannaf Ibn Abi Shaybah 4555","","","كتاب الصلوات"
"4556","(۴۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالاَ : إذَا لَمْ یَسْجُدِ الإمَام ، فَلَیْسَ عَلَیْہِمْ سَہْوٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4556","","","كتاب الصلوات"
"4557","(۴۵۵۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ وُہَیب بْنِ عَجْلاَنَ ، قَالَ : رَأَیْتُ الْقَاسِمَ ، وَسَالِمًا صَلَّیَا خَلْفَ إِمَام فَسَہَا فَلَمْ یَسْجُدْ ، فَلَمْ یَسْجُدَا۔","","Musannaf Ibn Abi Shaybah 4557","","","كتاب الصلوات"
"4558","(۴۵۵۸) حَدَّثَنَا عَبْدُالصَّمَدِ بْنُ عَبْدِالْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : قَالَ حَمَّادٌ: إذَا أَوْہَمَ الإِمَام فَلَمْ یَسْجُدْ، فَلاَ یَسْجُدُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 4558","","","كتاب الصلوات"
"4559","(۴۵۵۹) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، قَالَ : حدَّثَنِی مِسْعَرٌ ، قَالَ : سَأَلْتُ عَنْہُ الْحَکَمَ ، وَحَمَّادًا ، فَقَالَ الْحَکَمُ : یَسْجُدُونَ ، وَقَالَ حَمَّادٌ : لَیْسَ عَلَیْہِمْ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 4559","","","كتاب الصلوات"
"4560","(۴۵۶۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَدْخُلُ مَعَ الإِمَامِ فَیَسْہُو ، قَالَ : تُجْزِئہ صَلاَۃُ الإِمَام ، وَلَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4560","","","كتاب الصلوات"
"4561","(۴۵۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُبَیْدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی مَنْ خَلْفَ الإِمَام سَہْوٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4561","","","كتاب الصلوات"
"4562","(۴۵۶۲) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ بَکَّارٍ ، عَنْ مَکْحُولٍ ، قَالَ : لَیْسَ عَلَی مَنْ خَلْفَ الإِمَام سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4562","","","كتاب الصلوات"
"4563","(۴۵۶۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سَجَدَ سَجْدَتَیِ السَّہْوِ ، وَلاَ نَعْلَمُہُ نَقَصَ ، فَنَقُولُ : إنَّک لَمْ تَنْقُصْ شَیْئًا ؟ فَیَقُولُ : إنِّی حَدَّثْتُ نَفْسِی بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 4563","","","كتاب الصلوات"
"4564","(۴۵۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نُعَیْمُ بْنُ حَکِیمٍ ، عَنْ أَبِی مَرْیَمَ الثَّقَفِیِّ ، قَالَ : صَلَّی بِنَا الْحَسَنُ بْنُ عَلِیٍّ الْمَغْرِبَ ، فَلَمَّا قَضَی الصَّلاَۃ سَجَدَ سَجْدَتَیْنِ ، وَلَمْ نَرَہُ سَہَا ، فَلَمَّا سَلَّمَ قُلْنَا لَہُ ، قَالَ : إنِّی سَہَوْت۔","Majhul","Musannaf Ibn Abi Shaybah 4564","","","كتاب الصلوات"
"4565","(۴۵۶۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الالْتِفَاتِ فِی الصَّلاَۃ ؟ فَقَالَ : اخْتِلاَسَۃٌ یَخْتَلِسُہَا الشَّیْطَانُ مِنْ صَلاَۃِ الْعَبْدِ۔ (بخاری ۷۵۱۔ ابوداؤد ۹۰۷)","Sahih","Musannaf Ibn Abi Shaybah 4565","","","كتاب الصلوات"
"4566","(۴۵۶۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ أَبُو بَکْرٍ لاَ یَلْتَفِت إذَا صَلَّی۔","Hasan","Musannaf Ibn Abi Shaybah 4566","","","كتاب الصلوات"
"4567","(۴۵۶۷) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ الدَّالانِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ زَیْدِ بْنِ وَہْبٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَأَی رَجُلاً صَلَّی رَکْعَتَیْنِ بَعْدَ غُرُوبِ الشَّمْسِ وَقَبْلَ الصَّلاَۃ ، فَجَعَلَ یَلْتَفِتُ فَضَرَبَہُ بِالدِّرَّۃِ حِینَ قَضَی الصَّلاَۃ ، وَقَالَ : لاَ تَلْتَفِتْ ، ولم یَعِب الرَّکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 4567","","","كتاب الصلوات"
"4568","(۴۵۶۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : إنَّ اللَّہَ لاَ یَزَالُ مُقْبِلاً عَلَی الْعَبْدِ مَا دَامَ فِی صَلاَتِہِ ، مَا لَمْ یُحْدِثْ ، أَوْ یَلْتَفِتْ۔","","Musannaf Ibn Abi Shaybah 4568","","","كتاب الصلوات"
"4569","(۴۵۶۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بن حَیَّانَ ، قَالَ : حدَّثَنِی جَعْفَرُ بْنُ کَثِیرِ بْنِ الْمُطَّلِبِ السَّہْمِیِّ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : أَیُّہَا النَّاسُ ، إیَّاکُمْ وَالالْتِفَاتَ فِی الصَّلاَۃ ، فَإِنَّہُ لاَ صَلاَۃَ لِلْمُلْتَفِتِ ، وَإِنْ غُلِبْتُمْ عَلَی تَطَوُّعٍ فَلاَ تُغْلَبُوا عَلَی الْمَکْتُوبَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 4569","","","كتاب الصلوات"
"4570","(۴۵۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَکْرَہُ الالْتِفَاتَ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 4570","","","كتاب الصلوات"
"4571","(۴۵۷۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی عَطِیَّۃَ ، قَالَ : قالَتْ عَائِشَۃُ : الالْتِفَاتُ فِی الصَّلاَۃ خِلْسَۃٌ یَخْتَلِسُہَا الشَّیْطَانُ۔","","Musannaf Ibn Abi Shaybah 4571","","","كتاب الصلوات"
"4572","(۴۵۷۲) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : إذَا صَلَّیْتَ فَإِنَّ رَبَّک أَمَامَک وَأَنْتَ مُنَاجِیہِ فَلاَ تَلْتَفِتْ ، قَالَ عَطَائٌ : وَبَلَغَنِی أَنَّ الرَّبَّ یَقُولُ : یَا ابْنَ آدَمَ ، إلَی مَنْ تَلْتَفِت ؟ أَنَا خَیْرٌ لَکَ مِمَّنْ تَلْتَفِتُ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4572","","","كتاب الصلوات"
"4573","(۴۵۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا یُؤْمَنُ ہَذَا الَّذِی یَلْتَفِتُ فِی الصَّلاَۃ أَنْ یُقَلِّبَ اللَّہُ وَجْہَہُ ؟ اللَّہُ مُقْبِلٌ عَلَیْہِ وَہُوَ مُلْتَفِتٌ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 4573","","","كتاب الصلوات"
"4574","(۴۵۷۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ اللہِ بْنِ مُنْقِذ ، قَالَ : إذَا قَامَ الرَّجُلُ إلَی الصَّلاَۃ أَقْبَلَ اللَّہُ عَلَیْہِ بِوَجْہِہِ ، فَإِذَا الْتَفَتَ أَعْرَضَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 4574","","","كتاب الصلوات"
"4575","(۴۵۷۵) حَدَّثَنَا جَرِیرٌ ، عَنْ ثَابِتٍ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہُوَ یَنْقُصُ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4575","","","كتاب الصلوات"
"4576","(۴۵۷۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا ، وَالْقَاسِمَ لاَ یَلْتَفِتَانِ فِی صَلاَتِہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4576","","","كتاب الصلوات"
"4577","(۴۵۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی لَبِیدٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : إذَا قَامَ الرَّجُلُ فِی الصَّلاَۃ أَقْبَلَ اللَّہُ عَلَیْہِ بِوَجْہِہِ مَا لَمْ یَلْتَفِتْ۔","","Musannaf Ibn Abi Shaybah 4577","","","كتاب الصلوات"
"4578","(۴۵۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عُبَیْدَۃَ النَّاجِی ، عَنِ الْحَسَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ قَالَ فِی مَرَضِہِ : أَقْعِدُونِی ، فَإِنَّ عِنْدِی وَدِیعَۃً أَوْدَعَنِیہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَلْتَفِتْ أَحَدُکُمْ فِی صَلاَتِہِ ، فَإِنْ کَانَ لاَ بُدَّ فَاعِلاً فَفِی غَیْرِ مَا افْتَرَضَ اللَّہُ عَلَیْہِ۔ (ترمذی ۵۸۹)","Da'if","Musannaf Ibn Abi Shaybah 4578","","","كتاب الصلوات"
"4579","(۴۵۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا خَطَّابٌ الْعُصْفُرِیُّ ، عَنِ الْحَکَمِ ، قَالَ : إنَّ مِنْ تَمَامِ الصَّلاَۃ أَنْ لاَ تعْرِفَ مَنْ عَنْ یَمِینِکَ ، وَلاَ مَنْ عَنْ شِمَالِک۔","","Musannaf Ibn Abi Shaybah 4579","","","كتاب الصلوات"
"4580","(۴۵۸۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی الأَسْوَدِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ : {وَالَّذِینَ ہُمْ عَلَی صَلاَتِہِمْ دَائِمُونَ} قَالَ : الَّذِی لاَ یَلْتَفِتُ فِی صَلاَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4580","","","كتاب الصلوات"
"4581","(۴۵۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، قَالَ : مَا رَأَیْت أَبَا وَائِلٍ مُلْتَفِتًا فِی صَلاَتِہِ قَطُّ۔","No Data Available","Musannaf Ibn Abi Shaybah 4581","","","كتاب الصلوات"
"4582","(۴۵۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ عِکْرِمَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَلْحَظُ فِی الصَّلاَۃ مِنْ غَیْرِ أَنْ یُثْنِیَ عُنُقَہُ۔ (ابوداؤد ۲۵۔ احمد ۱/۲۷۵)","Majhul","Musannaf Ibn Abi Shaybah 4582","","","كتاب الصلوات"
"4583","(۴۵۸۳) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 4583","","","كتاب الصلوات"
"4584","(۴۵۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : بَعْضُ أَصْحَابِنَا أَخْبَرَنِی عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَلْحَظُ فِی الصَّلاَۃ ، وَلاَ یَلْتَفِتُ۔","Majhul","Musannaf Ibn Abi Shaybah 4584","","","كتاب الصلوات"
"4585","(۴۵۸۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : إذَا دَخَلَ عَلَی الإِمَام السَّہْوُ فَلَمْ یَدْرِ مَا ہُوَ، فَلْیُلَمِّحْ إلَی مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4585","","","كتاب الصلوات"
"4586","(۴۵۸۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ یَتَشَرَّفُ إلَی الشَّیْئِ یَنْظُرُ إلَیْہِ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 4586","","","كتاب الصلوات"
"4587","(۴۵۸۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حُمَیْدٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : قِیلَ لابْنِ عُمَرَ : إِنََّ ابْنَ الزُّبَیْرِ إذَا قَامَ إلَی الصَّلاَۃ لَمْ یَلْتَفِتْ ، وَلَمْ یَتَحَرَّکْ ، قَالَ : لَکِنَّا نَلْتَفِتُ وَنَتَحَرَّکُ۔","Hasan","Musannaf Ibn Abi Shaybah 4587","","","كتاب الصلوات"
"4588","(۴۵۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا سَہَا الإِمَام فَلَمْ یَدْرِ کَمْ صَلَّی نَظَرَ مَا یَصْنَعُ مَنْ خَلْفَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4588","","","كتاب الصلوات"
"4589","(۴۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ جُمَیْعٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَلْحَظُ یَمِینًا وَشِمَالاً۔","No Data Available","Musannaf Ibn Abi Shaybah 4589","","","كتاب الصلوات"
"4590","(۴۵۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : رَأَیْتُ ابْنَ مُغَفَّلٍ ، یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 4590","","","كتاب الصلوات"
"4591","(۴۵۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَسْہُو مِرَارًا فِی صَلاَتِہِ ، قَالَ : تُجْزِئُہ سَجْدَتَانِ لِجَمِیعِ سَہْوِہِ۔","","Musannaf Ibn Abi Shaybah 4591","","","كتاب الصلوات"
"4592","(۴۵۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا انْتَہَی إلَی الإِمَام وَقَدْ سَہَا قَبْلَ ذَلِکَ ، فَلْیَسْجُدْ مَعَ الإِمَامِ ، ثُمَّ لِیَقْضِ مَا سَبَقَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4592","","","كتاب الصلوات"
"4593","(۴۵۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ کَمَا قَالَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 4593","","","كتاب الصلوات"
"4594","(۴۵۹۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سُبِقَ بِبَعْضِ الصَّلاَۃ وَقَدْ سَہَا الإِمَام ، قَالَ: یَسْجُدُ مَعَ الإِمَامِ ، ثُمَّ یَقُومُ فَیَقْضِی۔","","Musannaf Ibn Abi Shaybah 4594","","","كتاب الصلوات"
"4595","(۴۵۹۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ مِثْلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4595","","","كتاب الصلوات"
"4596","(۴۵۹۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، وَالْحَسَنِ ، قَالَ ابْنُ سِیرِینَ : یَقْضِی ، ثُمَّ یَسْجُدُ ، وَقَالَ الْحَسَنُ : یَسْجُدُ مَعَ الإِمَامِ ، ثُمَّ یَقُومُ فَیَقْضِی۔","No Data Available","Musannaf Ibn Abi Shaybah 4596","","","كتاب الصلوات"
"4597","(۴۵۹۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، ??َالَ : یَسْجُدُ مَعَ الإِمَامِ ، فَإِذَا انْصَرَفَ قَامَ فَقَضَی مَا سَبَقَہُ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4597","","","كتاب الصلوات"
"4598","(۴۵۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی سَعِیدٍ ، وَابْنِ عُمَرَ ، وَابْنِ الزُّبَیْرِ ؛ فِی الرَّجُلِ یَدْخُلُ مَعَ الإِمَامِ وَقَدْ فَاتَہُ بَعْضُ الصَّلاَۃ ، قَالُوا : یَصْنَعُ کَمَا یَصْنَعُ الإِمَام ، فَإِذَا قَضَی الإِمَام صَلاَتَہُ قَامَ فَقَضَی، وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4598","","","كتاب الصلوات"
"4599","(۴۵۹۹) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ زَکَرِیَّا بْنِ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : إذَا فَاتَکَ التَّشَہُّدُ فِی الرَّکْعَتَیْنِ ، فَلاَ تَجْلِسْ فِی رَکْعَتِکَ تَشَہَّدُ ، اقْتَدِ بِالإِمَام۔","","Musannaf Ibn Abi Shaybah 4599","","","كتاب الصلوات"
"4600","(۴۶۰۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الرَّجُلِ یَدْخُلُ فِی الصَّلاَۃ وَقَدْ سُبِقَ بِرَکْعَۃٍ ، فَإِنَّہُ یَصْنَعُ کَمَا یَصْنَعُ الإِمَام ، فَإِذَا سَلَّمَ قَامَ وَقَضَی۔","No Data Available","Musannaf Ibn Abi Shaybah 4600","","","كتاب الصلوات"
"4601","(۴۶۰۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُقْبَۃَ بْنِ أَبِی الْعَیْزَارِ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الرَّجُلِ یَدْخُلُ مَعَ الإِمَامِ وَقَدْ سَبَقَہُ الإِمَام بِرَکْعَۃٍ وَقَدْ سَہَا الإِمَام ، فَکَیْفَ یَصْنَعُ ؟ قَالَ : إذَا دَخَلْتَ مَعَ الإِمَامِ فَاصْنَعْ کَمَا یَصْنَعُ۔","","Musannaf Ibn Abi Shaybah 4601","","","كتاب الصلوات"
"4602","(۴۶۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ أَبِی جَابِرٍ الْبَیَاضِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِالنَّاسِ وَہُوَ جُنُبٌ ، فَأَعَادَ وَأَعَادُوا۔ (بیہقی ۴۰۰)","","Musannaf Ibn Abi Shaybah 4602","","","كتاب الصلوات"
"4603","(۴۶۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ صَلَّی بِہِمُ الْغَدَاۃَ ، ثُمَّ ذَکَرَ أَنَّہُ صَلَّی بِغَیْرِ وُضُوئٍ فَأَعَادَ ، وَلَمْ یُعِیدُوا۔","Sahih","Musannaf Ibn Abi Shaybah 4603","","","كتاب الصلوات"
"4604","(۴۶۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ عُمَرَ صَلَّی بِالنَّاسِ وَہُوَ جُنُبٌ فَأَعَادَ ، وَأَمَرَہُمْ أَنْ لاَ یُعِیدُوا۔","","Musannaf Ibn Abi Shaybah 4604","","","كتاب الصلوات"
"4605","(۴۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَلِیٍّ ، قَالَ : یُعِیدُ وَیُعِیدُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 4605","","","كتاب الصلوات"
"4606","(۴۶۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ أَمَّ قَوْمًا فِی شَہْرِ رَمَضَانَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ ، فَصَلَّی بِہِمْ صَلاَۃَ الْعِشَائِ ، وَصَلاَۃَ رَمَضَانَ وَالْوِتْرَ ؟ فَقَالَ : یُعِیدُ ، وَلاَ یُعِیدُ مَنْ خَلْفَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4606","","","كتاب الصلوات"
"4607","(۴۶۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُہُ ، فَقَالَ : أَعِدِ الصَّلاَۃ وَأَخْبِرْ أَصْحَابَک أَنَّک صَلَّیْتَ بِہِمْ وَأَنْتَ غَیْرُ طَاہِرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 4607","","","كتاب الصلوات"
"4608","(۴۶۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُعِیدُ ، وَلاَ یُعِیدُ مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4608","","","كتاب الصلوات"
"4609","(۴۶۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذا صَلَّی الْجُنُبُ بِالْقَوْمِ فَأَتَمَّ بِہِمُ الصَّلاَۃ ، آمُرُہ أَنْ یَغْتَسِلَ وَیُعِیدَ ، وَلَمْ آمُرْہُمْ أَنْ یُعِیدُوا۔","Da'if","Musannaf Ibn Abi Shaybah 4609","","","كتاب الصلوات"
"4610","(۴۶۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ أَنَّہُ قَالَ فِی الرَّجُلِ یُصَلِّی بِالْقَوْمِ وَہُوَ جُنُبٌ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یُعِیدُوا۔","","Musannaf Ibn Abi Shaybah 4610","","","كتاب الصلوات"
"4611","(۴۶۱۱) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الشَّیْبَانِیِّ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا صَلَّی بِہِمْ وَہُوَ عَلَی غَیْرِ وُضُوئٍ أَعَادَ ، وَلَمْ یُعِیدُوا ، قَالَ سُفْیَانُ : وَأَحَبُّ إلَیَّ أَنْ یُعِیدَ وَیُعِیدُوا۔","","Musannaf Ibn Abi Shaybah 4611","","","كتاب الصلوات"
"4612","(۴۶۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا دَخَلَ بَیْتًا ، فَرَأَی فِی قِبْلَۃِ الْمَسْجِدِ مُصْحَفًا ، أَوْ شِبْہَہُ أَخَذَہُ فَرَمَی بِہِ ، وَإِنْ کَانَ عَنْ یَمِینِہِ ، أَوْ شِمَالِہِ تَرَکَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4612","","","كتاب الصلوات"
"4613","(۴۶۱۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَلِّیَ الرَّجُلُ وَفِی قِبْلَۃِ الْمَسْجِدِ مُصْحَفٌ ، أَوْ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 4613","","","كتاب الصلوات"
"4614","(۴۶۱۴) حَدَّثَنَا حَرَمِیّ بن عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَکُونُ بَیْنَہُ وَبَیْنَ الْقِبْلَۃِ الْمُصْحَفُ ؟ فَکَرِہَاہ۔","","Musannaf Ibn Abi Shaybah 4614","","","كتاب الصلوات"
"4615","(۴۶۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَکُونَ بَیْنَہُمْ وَبَیْنَ الْقِبْلَۃِ شَیْئٌ حَتَّی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 4615","","","كتاب الصلوات"
"4616","(۴۶۱۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ خُصَیْفٍ ، عَنْ مِقْسَمٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : لاَ تُصَلِّ فِی بَیْتٍ فِیہِ تَمَاثِیلُ۔","Da'if","Musannaf Ibn Abi Shaybah 4616","","","كتاب الصلوات"
"4617","(۴۶۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، قَالَ : لَمَّا بُنِیَ الْمَسْجِدُ فِی عَہْدِ عُثْمَانَ جَعَلُوا فِی سَقْفِہِ أُتْرُجَّۃ ، فَکَانَ الدَّاخِلُ إذَا دَخَلَ یَسْمُو بَصَرُہُ إلَیْہَا ، فَبَلَغَ ذَلِکَ عُثْمَانَ فَأَمَرَ بِہَا فَنُزِعَتْ۔","","Musannaf Ibn Abi Shaybah 4617","","","كتاب الصلوات"
"4618","(۴۶۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، عَنْ خَالَۃِ مُسَافِعٍ ، عَنْ أُخْتِہِ صَفِیَّۃَ أُمِّ مَنْصُورٍ ، قَالَتْ : أَخْبَرَتْنِی امْرَأَۃٌ مِنْ أَہْلِ الدَّارِ مِنْ بَنِی سُلَیْمٍ ، قَالَتْ : قُلْتُ لِعُثْمَانَ بْنِ طَلْحَۃَ : لِمَ دَعَاک رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ خَرَجَ مِنَ الْبَیْتِ ؟ قَالَ : قَالَ : إنِّی رَأَیْتُ قَرْنَیِ الْکَبْشِ فَنَسِیتُ أَنْ آمُرَک أَنْ تُخَمِّرَہُمَا ، وَإِنَّہُ لاَ یَنْبَغِی أَنْ یَکُونَ فِی الْبَیْتِ شَیْئٌ یَشْغَلُ الْمُصَلِّیَ۔ (ابوداؤد ۲۰۲۳۔ عبدالرزاق ۹۰۸۳)","Majhul","Musannaf Ibn Abi Shaybah 4618","","","كتاب الصلوات"
"4619","(۴۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی بْنِ حُمَیْدٍ ، قَالَ : سَأَلَ عُقْبَۃُ الْحَسَنَ ، قَالَ : إنَّ فِی مَسْجِدِنَا سَاجَۃً فِیہَا تَصَاوِیرُ ، قَالَ : اِنْخَرُوہَا۔","","Musannaf Ibn Abi Shaybah 4619","","","كتاب الصلوات"
"4620","(۴۶۲۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ خَالِدٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : حَدَّثَتْنِی لُبَابَۃُ ، عَنْ أُمِّہَا ، وَکَانَتْ تَخْدِمُ عُثْمَانَ بْنَ عَفَّانَ ؛ أَنَّ عُثْمَانَ بْنَ عَفَّانَ کَانَ یُصَلِّی إلَی تَابُوتٍ فِیہِ تَمَاثِیلُ ، فَأَمَرَ بِہِ فَحُکَّ۔","Majhul","Musannaf Ibn Abi Shaybah 4620","","","كتاب الصلوات"
"4621","(۴۶۲۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الْمَسْجِدِ یُکْتَبُ فِی قِبْلَتِہِ مِنَ الْقُرْآنِ ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4621","","","كتاب الصلوات"
"4622","(۴۶۲۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4622","","","كتاب الصلوات"
"4623","(۴۶۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ الزُّبَیْرِ الْحَنْظَلِیِّ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ رَأَی ابْنًا لَہُ کَتَبَ فِی الْحَائِطِ ، بِسْمِ اللہِ ، فَضَرَبَہُ۔","","Musannaf Ibn Abi Shaybah 4623","","","كتاب الصلوات"
"4624","(۴۶۲۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سَعِیدُ بْنُ زِیَادٍ ، عَنْ زِیَادِ بْنِ صُبَیْحِ الْحَنَفِیِّ ، قَالَ : صَلَّیْت إلَی جَنْبِ ابْنِ عُمَرَ فَوَضَعْتُ یَدِی عَلَی خَاصِرَتِی ، فَلَمَّا صَلَّی ، قَالَ : ہَذَا الصُّلْبُ فِی الصَّلاَۃ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْہُ۔ (ابوداؤد ۸۹۹۔ احمد ۲/۳۰)","Hasan","Musannaf Ibn Abi Shaybah 4624","","","كتاب الصلوات"
"4625","(۴۶۲۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَرِہَتْ أَنْ یَضَعَ یَدَہُ عَلَی خَاصِرَتِہِ فِی الصَّلاَۃ ، وَقَالَتْ : تَفْعَلُہُ الْیَہُودُ۔","Sahih","Musannaf Ibn Abi Shaybah 4625","","","كتاب الصلوات"
"4626","(۴۶۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ الشَّامِیُّ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا رَأَتْ رَجُلاً وَاضِعًا یَدَہُ عَلَی خَاصِرَتِہِ ، فَقَالَتْ : ہَکَذَا أَہْلُ النَّارِ فِی النَّارِ۔","Sahih","Musannaf Ibn Abi Shaybah 4626","","","كتاب الصلوات"
"4627","(۴۶۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَہُ فِی الصَّلاَۃ ، وَقَالَ : إنَّ الشَّیْطَانَ یَحْضُرُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 4627","","","كتاب الصلوات"
"4628","(۴۶۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یَضَعَ الرَّجُلُ یَدَہُ عَلَی خَاصِرَتِہِ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4628","","","كتاب الصلوات"
"4629","(۴۶۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ إِسْحَاقَ بْنِ عُوَیْمِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : وَضْعُ الْیَدَیْنِ عَلَی الْحَقْوِ اسْتِرَاحَۃُ أَہْلِ النَّارِ۔","","Musannaf Ibn Abi Shaybah 4629","","","كتاب الصلوات"
"4630","(۴۶۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ رَأَی رَجُلاً وَاضِعًا یَدَہُ عَلَی خَاصِرَتِہِ فِی الصَّلاَۃ ، فَضَرَبَ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 4630","","","كتاب الصلوات"
"4631","(۴۶۳۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ؛ أَنَّہُ إنَّمَا کُرِہَ التَّخَصُّرُ فِی الصَّلاَۃ ، أَنَّ إبْلِیسَ أُہْبِطَ مُتَخَصِّرًا۔","","Musannaf Ibn Abi Shaybah 4631","","","كتاب الصلوات"
"4632","(۴۶۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نُہِیَ عَنِ الاخْتِصَارِ فِی الصَّلاَۃ ، قَالَ مُحَمَّدٌ : وَہُوَ أَنْ یَضَعَ یَدَہ عَلَی خَاصِرَتِہِ وَہُوَ یُصَلِّی۔ (بخاری ۱۲۲۰۔ ابوداؤد ۹۴۴)","Sahih","Musannaf Ibn Abi Shaybah 4632","","","كتاب الصلوات"
"4633","(۴۶۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُریرِیِّ ، عَنْ حَیَّانَ بْنِ عُمَیْرٍ ، قَالَ : إِنی کُنْتُ مَعَ قَسِ بْنِ عُبَادٍ ، فَرَأَی رَجُلاً یُصَلِّی مُتَخَصِّرًا ، فَقَالَ : اذْہَبْ إلَی ذَلکَ فَقُلْ لَہُ : یَضَعُ یَدَہ مِنْ مَکَانِ یَدِ الراجز۔","","Musannaf Ibn Abi Shaybah 4633","","","كتاب الصلوات"
"4634","(۴۶۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَرِہَتِ الاخْتِصَارَ فِی الصَّلاَۃِ ، وَقَالَتْ : لاَ تَشَبَّہُوا بِالْیَہُودِ۔","Sahih","Musannaf Ibn Abi Shaybah 4634","","","كتاب الصلوات"
"4635","(۴۶۳۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ نَہَی أَنْ یُصَلِّیَ الرَّجُلُ مُتَخَصِّرًا۔","Hasan","Musannaf Ibn Abi Shaybah 4635","","","كتاب الصلوات"
"4636","(۴۶۳۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّ سَلَمَۃَ أُمِّ الْمُؤْمِنِینَ ، قَالَتْ : وَالَّذِی ذَہَبَ بِنَفْسِہِ ، مَا مَاتَ حَتَّی کَانَ أَکْثَرُ صَلاَتِہِ وَہُوَ جَالِسٌ۔ (احمد ۳۲۲۔ طبرانی ۵۱۶)","","Musannaf Ibn Abi Shaybah 4636","","","كتاب الصلوات"
"4637","(۴۶۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : سَأَلْتُ عَائِشَۃَ ، أَکَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی قَاعِدًا ؟ قَالَتْ : بَعْدَ مَا حَطَّمَتْہُ السِّنُّ۔ (مسلم ۵۰۶۔ ابوداؤد ۹۵۳)","Sahih","Musannaf Ibn Abi Shaybah 4637","","","كتاب الصلوات"
"4638","(۴۶۳۸) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ سِمَاکِ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : مَا مَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی صَلَّی قَاعِدًا۔ (مسلم ۱۱۹۔ بیہقی ۴۹۰)","Hasan","Musannaf Ibn Abi Shaybah 4638","","","كتاب الصلوات"
"4639","(۴۶۳۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : مَا رَأَیْت ابْنَ عُمَرَ یُصَلِّی جَالِسًا إِلاَّ مِنْ مَرَضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 4639","","","كتاب الصلوات"
"4640","(۴۶۴۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مُبَارَکٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ أَبِیہِ ، قَالَ : إنِّی لأَکْرَہُ أَنْ یَرَانِی اللَّہُ أُصَلِّی لَہُ قَاعِدًا مِنْ غَیْر مَرَضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 4640","","","كتاب الصلوات"
"4641","(۴۶۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ مَیْمُونِ بْنِ مِہْرَانَ ، عَنْ أَبِیہِ ؛ أَنَّہُ سُئِلَ ، مَا حَدُّ الْمَرِیضِ أَنْ یُصَلِّیَ جَالِسًا ؟ فَقَالَ : حَدُّہُ لَوْ کَانَتْ دُنْیَا تُعْرَضُ لَہُ لَمْ یَقُمْ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 4641","","","كتاب الصلوات"
"4642","(۴۶۴۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ یُصَلِّی فِی الْمَقْصُورَۃِ الْمَکْتُوبَۃَ مَعَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، ثُمَّ یَخرج عَلَیْنَا مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 4642","","","كتاب الصلوات"
"4643","(۴۶۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ؛ أَنَّ الْحَسَنَ کَانَ یُصَلِّی فِی الْمَقْصُورَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4643","","","كتاب الصلوات"
"4644","(۴۶۴۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ جَعْفَرٍ، قَالَ: کَانَ عَلِیُّ بْنُ حُسَیْنٍ، وأبی والْقَاسِمُ یُصَلُّونَ فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4644","","","كتاب الصلوات"
"4645","(۴۶۴۵) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ عُبَیْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ السَّائِبَ بْنَ یَزِیدَ یُصَلِّی الْمَکْتُوبَۃَ فِی الْمَقْصُورَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4645","","","كتاب الصلوات"
"4646","(۴۶۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ قَیْسِ بْنِ عَبْدِ اللہِ ، وَکَانَ ثِقَۃً ، قَالَ : رَأَیْتُ الْحَسَنَ یُصَلِّی فِی الْمَقْصُورَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4646","","","كتاب الصلوات"
"4647","(۴۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ وَرْدَانَ ، قَالَ : رَأَیْتُ أَنَسًا صَلَّی عِنْدَ الْحَجَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 4647","","","كتاب الصلوات"
"4648","(۴۶۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرِ بْنِ ذُؤَیْبٍ ، قَالَ : سَأَلْتُ ابْنُ عُمَرَ عَنِ الصَّلاَۃ مِنْ وَرَائِ الْحَجَرِ ؟ فَقَالَ : إنَّہُمْ یَخَافُونَ أَنْ یَقْتُلُوہُمْ۔","Majhul","Musannaf Ibn Abi Shaybah 4648","","","كتاب الصلوات"
"4649","(۴۶۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ سَالِمًا ، وَالْقَاسِمَ ، وَنَافِعًا یُصَلُّونَ فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4649","","","كتاب الصلوات"
"4650","(۴۶۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنِ الأَحْنَفِ بْنِ قَیْسٍ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِی الْمَقْصُورَۃِ۔","","Musannaf Ibn Abi Shaybah 4650","","","كتاب الصلوات"
"4651","(۴۶۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی الْخَیَّاطِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ الْمَقْصُورَۃُ مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4651","","","كتاب الصلوات"
"4652","(۴۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ جَبَلَۃَ بْنِ عَطِیَّۃَ ، عَنِ ابْنِ مُحَیْرِیزٍ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4652","","","كتاب الصلوات"
"4653","(۴۶۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا حَضَرَتْہُ الصَّلاَۃ وَہُوَ فِی الْمَقْصُورَۃِ خَرَجَ إلَی الْمَسْجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 4653","","","كتاب الصلوات"
"4654","(۴۶۵۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی حَیَّانَ الأَشْجَعِیِّ ،وَکَانَ مِنْ أَصْحَابِ عَبْدِ اللہِ ، قَالَ : قَالَ عبد اللہ : لاَ تُبَادِرُوا أَئِمَّتَکُمْ بِالرُّکُوعِ ، وَلاَ بِالسُّجُودِ ، وَإِذَا رَفَعَ أَحَدُکُمْ رَأْسَہُ وَالإِمَام سَاجِدٌ فَلْیَسْجُدْ ، ثُمَّ لْیَمْکُثْ قَدْرَ مَا سَبَقَ بِہِ الإِمَام۔","Majhul","Musannaf Ibn Abi Shaybah 4654","","","كتاب الصلوات"
"4655","(۴۶۵۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلٍ ، عَنْ أَبِی حَیَّانَ ، قَالَ : قَالَ عبد اللہ : فَذَکَرَ نَحْوَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 4655","","","كتاب الصلوات"
"4656","(۴۶۵۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَعْقُوبَ بْنِ عَبْدِ اللہِ بن الأَشَجِّ ، عَنْ بُسر بْنِ سَعِیدٍ ، عَنِ الْحَارِثِ بْنِ الْمَخْلَدِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : مَنْ رَفَعَ رَأْسَہُ قَبْلَ الإِمَام فَلْیُعِدْ ، وَلْیَمْکُثْ حَتَّی یَرَی أَنَّہُ أَدْرَکَ مَا فَاتَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 4656","","","كتاب الصلوات"
"4657","(۴۶۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ ہَارُونَ الْبَصْرِیُّ ، عَنْ سُلَیْمَانَ بْنِ کِنْدِیرٍ ، قَالَ : صَلَّیْت إلَی جَنْبِ ابْنِ عُمَرَ فَرَفَعْت رَأْسِی قَبْلَ الإِمَام ، فَأَخَذَہُ فَأَعَادَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 4657","","","كتاب الصلوات"
"4658","(۴۶۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا رَفَعَ رَأْسَہُ قَبْلَ الإِمَام وَالإِمَامُ سَاجِدٌ فَلْیَعُدْ ، فَلْیَسْجُدْ۔","","Musannaf Ibn Abi Shaybah 4658","","","كتاب الصلوات"
"4659","(۴۶۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4659","","","كتاب الصلوات"
"4660","(۴۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یَعُودُ فَیَسْجُدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4660","","","كتاب الصلوات"
"4661","(۴۶۶۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا رَفَعْتَ رَأْسَک قَبْلَ الإِمَام فَعُدْ إلَی أَنْ تَرَی ، أَنَّ الإِمَام قَدْ رَفَعَ قَبْلَک۔","No Data Available","Musannaf Ibn Abi Shaybah 4661","","","كتاب الصلوات"
"4662","(۴۶۶۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُخَارِقٍ ، قَالَ : مَرَرْتُ بِأَبِی ذَرٍّ بِالرَّبَذَۃِ وَأَنَا حَاجٌّ ، فَدَخَلْت عَلَیْہِ مَنْزِلَہُ ، فَرَأَیْتُہُ یُصَلِّی یُخَفِّفُ الْقِیَامَ قَدْرَ مَا یَقْرَأُ (إنَّا أَعْطَیْنَاک الْکَوْثَرَ) ، وَ(إذَا جَائَ نَصْرُ اللہِ) وَیُکْثِرُ الرُّکُوعَ وَالسُّجُودَ ، فَلَمَّا قَضَی صَلاَتَہُ ، قُلْتُ : یَا أَبَا ذَرٍّ ، رَأَیْتُک تُخَفِّف الْقِیَامَ وَتُکْثِرُ الرُّکُوعَ وَالسُّجُودَ ؟ فَقَالَ : إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ عَبْدٍ یَسْجُدُ لِلَّہِ سَجْدَۃً ، أَوْ یَرْکَعُ لَہُ رَکْعَۃً ، إِلاَّ حَطَّ اللَّہُ بِہَا عَنہ خَطِیئََۃ ، وَرَفَعَ لَہُ بِہَا دَرَجَۃ۔ (احمد ۵/۱۴۷۔ بزار ۳۹۰۳)","Majhul","Musannaf Ibn Abi Shaybah 4662","","","كتاب الصلوات"
"4663","(۴۶۶۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ذَکَرُوا سُجُودَ الْقُرْآنِ عِنْدَ عَائِشَۃَ ، فَقَالَتْ : ہُوَ فَرِیضَۃٌ أَدَّیْتَہَا ، أَوْ تَطَوُّعٌ تَطَوَّعْتَہُ ، مَا مِنْ مُسْلِمٍ یَسْجُدُ سَجْدَۃً إِلاَّ رَفَعَ اللَّہُ لَہ بِہَا دَرَجَۃً ، وَحَطَّ عَنْہُ خَطِیئَۃ۔","","Musannaf Ibn Abi Shaybah 4663","","","كتاب الصلوات"
"4664","(۴۶۶۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنْ أَبِی عُثْمَانَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : أتَیْتُ الشَّامَ فَإِذَا أَنَا بِرَجُلٍ یُصَلِّی ، یَرْکَعُ وَیَسْجُدُ وَلاَ یَفْصِلُ ، فَقُلْتُ : لَوْ قَعَدْتُ حَتَّی أَرْشُدَ ہَذَا الشَّیْخَ ، قَالَ: فَجَلَسْتُ ، فَلَمَّا قَضَی الصَّلاَۃ قُلْتُ لَہُ : یَا عَبْدَ اللہِ ، أَعَلَی شَفْعٍ انْصَرَفْتَ أَمْ عَلَی وِتْرٍ ؟ قَالَ : قَدْ کُفِیتُ ذَلِکَ ، قُلْتُ : وَمَنْ یَکْفِیک ؟ قَالَ : الْکِرَامُ الْکَاتِبُونَ مَا سَجَدْتُ سَجْدَۃً إِلاَّ رَفَعَنِی اللَّہُ بِہَا دَرَجَۃً ، وَحَطَّ عَنِّی بِہَا خَطِیئَۃً ، قُلْتُ : مَنْ أَنْتَ یَا عَبْدَ اللہِ ؟ قَالَ : أَبُو ذَرٍّ ، قُلْتُ : ثَکِلْت مُطْرِفًا أُمُّہُ یُعْلِمُ أَبَا ذَرٍّ السُّنَّۃَ ، فَلَمَّا أَتَیْتُ مَنْزِلَ کَعْبٍ قِیلَ لِی : قَدْ سَأَلَ عَنْک ، فَلَمَّا لَقِیتُہُ ذَکَرْتُ لَہُ أَمْرَ أَبِی ذَرٍّ ، وَمَا قَالَ لِی ، قَالَ : فَقَالَ لِی مِثْلَ قَوْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4664","","","كتاب الصلوات"
"4665","(۴۶۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قِیلَ لِثَوْبَانَ : حَدِّثْنَا عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَکْذِبُونَ عَلَیَّ سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا مِنْ مُسْلِمٍ یَسْجُدُ لِلَّہِ سَجْدَۃً إِلاَّ رَفَعَہُ اللَّہُ بِہَا دَرَجَۃً ، أَوْ حَطَّ عَنْہُ بِہَا خَطِیئَۃً۔ (مسلم ۲۲۵۔ ترمذی ۳۸۹)","","Musannaf Ibn Abi Shaybah 4665","","","كتاب الصلوات"
"4666","(۴۶۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّہُ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّلاَۃ قَاعِدًا ؟ فَقَالَ : صَلِّ قَائِمًا ، فَإِنَّہُ أَفْضَلُ ، ثُمَّ قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ ، وَصَلاَۃُ النَّائِمِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَاعِدِ۔ (بخاری ۱۱۱۷۔ ابوداؤد ۹۴۸)","Sahih","Musannaf Ibn Abi Shaybah 4666","","","كتاب الصلوات"
"4667","(۴۶۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ شَیْخٍ یُکَنَّی أَبَا مُوسَی ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، قَالَ : أُرَاہُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔ (ابن ماجہ ۱۲۲۹۔ احمد ۲/۱۹۲)","Majhul","Musannaf Ibn Abi Shaybah 4667","","","كتاب الصلوات"
"4668","(۴۶۶۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنِ الزُّہْرِیِّ ، عَنِ ابْنِ عَمْرو ، قَالَ : قَدِمْنَا الْمَدِینَۃَ فَأَصَابَنَا وَبَائٌ حَتَّی سَبَّحْنَا قُعُودًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔","","Musannaf Ibn Abi Shaybah 4668","","","كتاب الصلوات"
"4669","(۴۶۶۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو ، قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 4669","","","كتاب الصلوات"
"4670","(۴۶۷۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ زُہَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ السَّائِبَ سَأَلَ عَائِشَۃَ عَنْ صَلاَۃِ الْقَاعِدِ ؟ فَقَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔ (نسائی ۴۹۴۱۔ احمد ۶/۲۲۷)","","Musannaf Ibn Abi Shaybah 4670","","","كتاب الصلوات"
"4671","(۴۶۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صَلاَۃُ الْقَاعِدِ غَیْرُ مُتَرَبِّعٍ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ۔","","Musannaf Ibn Abi Shaybah 4671","","","كتاب الصلوات"
"4672","(۴۶۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ الْکَاہِلِیِّ ، قَالَ : صَلاَۃُ الْقَاعِدِ عَلَی النِّصْفِ مِنْ صَلاَۃِ الْقَائِمِ إِلاَّ مِنْ عُذْرٍ۔","","Musannaf Ibn Abi Shaybah 4672","","","كتاب الصلوات"
"4673","(۴۶۷۳) حَدَّثَنَا مُعَلَّی بْنُ مَنْصُورٍ ، وَخَالِدُ بْنُ مَخْلَدٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْقَاعِدِ عَلَی مِثْلِ نِصْفِ صَلاَۃِ الْقَائِمِ۔(نسائی ۱۳۶۴۔ احمد ۳/۲۱۴)","Sahih","Musannaf Ibn Abi Shaybah 4673","","","كتاب الصلوات"
"4674","(۴۶۷۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَوْفٌ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُصَلِّیَ الرَّجُلُ وَہُوَ مُحْتَبٍ، وَابْنُ سِیرِینَ کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 4674","","","كتاب الصلوات"
"4675","(۴۶۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُصَلِّی مُحْتَبِیًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4675","","","كتاب الصلوات"
"4676","(۴۶۷۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ؛ أَنَّ أَبَاہُ کَانَ یُصَلَّی مُحْتَبِیًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4676","","","كتاب الصلوات"
"4677","(۴۶۷۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : رَأَیْتُ أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4677","","","كتاب الصلوات"
"4678","(۴۶۷۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ دَاوُد ، عَنْ طَلْحَۃَ بْنَ یَحْیَی ، قَالَ : رَأَیْتُ عِیسَی بْنَ طَلْحَۃَ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4678","","","كتاب الصلوات"
"4679","(۴۶۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ؛ أَنَّہُ رَأَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی مُحْتَبِیًا خَلْفَ الْمَقَامِ تَطَوُّعًا۔","","Musannaf Ibn Abi Shaybah 4679","","","كتاب الصلوات"
"4680","(۴۶۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی مُحْتَبِیًا ، فَإِذَا أَرَادَ أَنْ یَرْکَعَ حَلَّ حَبْوَتَہُ ، ثُمَّ قَامَ فَرَکَعَ۔","","Musannaf Ibn Abi Shaybah 4680","","","كتاب الصلوات"
"4681","(۴۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یُصَلِّی مُحْتَبِیًا۔","","Musannaf Ibn Abi Shaybah 4681","","","كتاب الصلوات"
"4682","(۴۶۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ إسْمَاعِیلَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ عُبَیْدَ بْنَ عُمَیْرٍ یُصَلِّی مُحْتَبِیًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4682","","","كتاب الصلوات"
"4683","(۴۶۸۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ بْنِ صُبَیْحٍ ، قَالَ : رَأَیْتُ عَطَائً یُصَلِّی مُحْتَبِیًا ، یَعْنِی التَّطَوُّعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4683","","","كتاب الصلوات"
"4684","(۴۶۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ ، قَالَ : لَقَدْ رَأَیْت الرِّجَالَ عَاقِدِی أُزُرَہُمْ فِی أَعْنَاقِہِمْ ، مِثْلَ الصِّبْیَانِ ، مِنْ ضِیقِ الأُزُرِ ، خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ قائِلٌ : یَا مَعْشَرَ النِّسَائِ ، لاَ تَرْفَعَنْ رُؤُوسَکُنَّ حَتَّی یَرْفَعَ الرِّجَالُ۔ (بخاری ۳۶۲۔ ابوداؤد ۶۳۰)","Sahih","Musannaf Ibn Abi Shaybah 4684","","","كتاب الصلوات"
"4685","(۴۶۸۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَا مَعْشَرَ النِّسَائِ ، إذَا سَجَدَ الرِّجَالُ فَاغْضُضْنَ أَبْصَارَکُنَّ ، لاَ تَرَیْنَ عَوْرَاتِ الرِّجَالِ مِنْ ضِیقِ الأُزُرِ۔ (احمد ۳۸۷)","Da'if","Musannaf Ibn Abi Shaybah 4685","","","كتاب الصلوات"
"4686","(۴۶۸۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَا مَعْشَرَ النِّسَائِ ، إذَا سَجَدَ الرِّجَالُ فَاغْضُضْنَ أبْصَارَکُنَّ ، لاَ تَرَیْنَ عَوْرَاتِ الرِّجَالِ مِنْ ضِیقِ الأُزُرِ۔ (احمد ۳/۳۔ بیہقی ۱۶)","Da'if","Musannaf Ibn Abi Shaybah 4686","","","كتاب الصلوات"
"4687","(۴۶۸۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، قَالَ : أَخْبَرَنِی سُلَیْمَانُ بْنُ بشر الْخُزَاعِیُّ ، عَنْ خَالِہِ مَالِکِ بْنِ عَبْدِ اللہِ ، قَالَ : غَزَوْت مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ أُصَلِّ خَلْفَ إمَامٍ کَانَ أَخَفَّ صَلاَۃً فِی الْمَکْتُوبَۃِ مِنْہُ۔ (احمد ۵/۲۲۵۔ طبرانی ۶۵۲)","Majhul","Musannaf Ibn Abi Shaybah 4687","","","كتاب الصلوات"
"4688","(۴۶۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوجِزُ الصَّلاَۃَ وَیُکْمِلُہَا۔ (بخاری ۷۰۶۔ مسلم ۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 4688","","","كتاب الصلوات"
"4689","(۴۶۸۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کَانَتْ صَلاَۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَصْدًا ، وَخُطْبَتُہُ قَصْدًا۔ (مسلم ۴۱۔ احمد ۵/۹۱)","Hasan","Musannaf Ibn Abi Shaybah 4689","","","كتاب الصلوات"
"4690","(۴۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَجَوَّزُوا الصَّلاَۃ ، فَإِنَّ فِیہِمُ الضَّعِیفَ وَالْکَبِیرَ وَذَا الْحَاجَۃِ۔ (بخاری ۷۰۳۔ ابوداؤد ۷۹۱)","Sahih","Musannaf Ibn Abi Shaybah 4690","","","كتاب الصلوات"
"4691","(۴۶۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عن قَیْسٍ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی لأَتَأَخَّرُ عَنْ صَلاَۃِ الْغَدَاۃِ مِمَّا یُطِیلُ فُلاَنٌ فِیہَا ، قَالَ : فَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَا رَأَیْتُہُ فِی مَوْعِظَۃٍ أَشَدَّ مِنْہُ غَضَبًا یَوْمَئِذٍ ، فَقَالَ : أَیُّہَا النَّاسُ ، إنَّ فِیکُمْ مُنَفِّرِینَ ، فَأَیُّکُمْ صَلَّی بِالنَّاسِ فَلْیُجَوِّزْ ، فَإِنَّ فِیہِمُ الضَّعِیفَ وَالْکَبِیرَ وَذَا الْحَاجَۃِ۔ (بخاری ۹۰۔ ابن ماجہ ۹۸۴)","Sahih","Musannaf Ibn Abi Shaybah 4691","","","كتاب الصلوات"
"4692","(۴۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَارِبٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ؛ أَنَّ مُعَاذًا صَلَّی بِأَصْحَابِہِ فَقَرَأَ بِالْبَقَرَۃِ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفَتَّانًا ؟ أَفَتَّانًا ؟ (بخاری ۷۰۵۔ احمد ۳/۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 4692","","","كتاب الصلوات"
"4693","(۴۶۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ عُثْمَانَ بْنِ مَوہَبٍ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہُ : أُمَّ قَوْمَک ، وَمَنْ أَمَّ قَوْمًا فَلْیُخَفِّفْ ، فَإِنَّ فِیہِمُ الضَّعِیفَ وَالْکَبِیرَ وَذَا الْحَاجَۃِ ، فَإِذَا صَلَّیْتَ لِنَفْسِکَ فَصَلِّ کَیْفَ شِئْت۔ (مسلم ۱۸۶۔ احمد ۴/۲۱۸)","Sahih","Musannaf Ibn Abi Shaybah 4693","","","كتاب الصلوات"
"4694","(۴۶۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَفَّ النَّاسِ صَلاَۃً فِی تَمَامٍ۔ (بخاری ۷۱۰۔ مسلم ۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 4694","","","كتاب الصلوات"
"4695","(۴۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ عَبَّاسٍ الْجُشَمِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنَ الأَئِمَّۃِ طَرَّادِینَ۔ (دارقطنی ۸۵)","","Musannaf Ibn Abi Shaybah 4695","","","كتاب الصلوات"
"4696","(۴۶۹۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثیم ، عَنْ نَافِعِ بْنِ سَرْجِسَ ، أَبِی سَعِیدٍ ؛ أَنَّہُ سَمِعَ أَبَا وَاقِدٍ اللَّیْثِیَّ صَاحِبَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَذَکَرْتُ الصَّلاَۃ عِنْدَہُ ، فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَفَّ النَّاسِ عَلَی النَّاسِ ، وَأَدْوَمَہُ عَلَی نَفْسِہِ۔ (ابویعلی ۱۴۴۴۔ طبرانی ۳۳۱۴)","Hasan","Musannaf Ibn Abi Shaybah 4696","","","كتاب الصلوات"
"4697","(۴۶۹۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ یَحْیَی بْنِ الْوَلِیدِ بْنِ الْمُسَیَّرِ الطَّائِیِّ ، قَالَ : أَخْبَرَنِی مُحِلٌّ الطَّائِیُّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : إنَّ مَنْ أَمَّنَا فَلْیُتِمَّ الرُّکُوعَ وَالسُّجُودَ ، فَإِنَّ فِینَا الضَّعِیفَ ،وَالْکَبِیرَ ، وَالْمَرِیضَ ، وَالْعَابِرَ سَبِیلٍ ، وَذَا الْحَاجَۃِ ، ہَکَذَا کُنَّا نُصَلِّی مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (طبرانی ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 4697","","","كتاب الصلوات"
"4698","(۴۶۹۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ ثَابِتٍ ، قَالَ : صَلَّیْت مَعَ أَنَسٍ الْعَتَمَۃَ فَتَجَوَّزَ مَا شَائَ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4698","","","كتاب الصلوات"
"4699","(۴۶۹۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُوسَی الْحَنَفِیِّ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، أَنَّہُ حَدَّثَ ، قَالَ : کَانَ أَبِی إذَا صَلَّی فِی الْمَسْجِدِ خَفَّفَ الرُّکُوعَ وَالسُّجُودَ وَجَوَّزَ ، وَإِذَا صَلَّی فِی بَیْتِہِ أَطَالَ الرُّکُوعَ وَالسُّجُودَ وَالصَّلاَۃ ، فَقُلْتُ لَہُ ، فَقَالَ : إِنَّا أَئِمَّۃٌ یُقْتَدَی بِنَا۔","Sahih","Musannaf Ibn Abi Shaybah 4699","","","كتاب الصلوات"
"4700","(۴۷۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ : رَأَیْتُ الزُّبَیْرَ بْنَ الْعَوَّامِ صَلَّی صَلاَۃً خَفِیفَۃً ، فَقُلْتُ : أَنْتُمْ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَفُّ النَّاسِ صَلاَۃً ، قَالَ : إِنَا نُبَادِرُ ہَذَا الْوَسْوَاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 4700","","","كتاب الصلوات"
"4701","(۴۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسٍ ، عَنْ نُسَیر ، عَنْ خُلَیْد الثَّوْرِیِّ ، عَنْ عَمَّارٍ ، قَالَ : احْذِفُوا ہَذِہِ الصَّلاَۃ قَبْلَ وَسْوَسَۃِ الشَّیْطَانِ۔ (عبدالرزاق ۳۷۲۸)","Majhul","Musannaf Ibn Abi Shaybah 4701","","","كتاب الصلوات"
"4702","(۴۷۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ حُذَیْفَۃَ ؛ أَنَّہُ عَلَّمَ رَجُلاً ، فَقَالَ : إنَّ الرَّجُلَ لَیُخَفِّفُ الصَّلاَۃ ، وَیُتِمُّ الرُّکُوعَ وَالسُّجُودَ۔","Sahih","Musannaf Ibn Abi Shaybah 4702","","","كتاب الصلوات"
"4703","(۴۷۰۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُصَلِّی خَلْفَ أَبِی ہُرَیْرَۃَ ، قَالَ : وَکَانَتْ صَلاَتُہُ نَحْوًا مِنْ صَلاَۃِ قَیْسٍ یُتِمُّ الرُّکُوعَ وَالسُّجُودَ وَیُجَوِّزُ ، قَالَ : فَقِیلَ لأَبِی ہُرَیْرَۃَ : ہَکَذَا کَانَتْ صَلاَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، وَأَجْوَزُ۔ (ابویعلی ۶۴۲۲۔ حمیدی ۹۸۷)","Majhul","Musannaf Ibn Abi Shaybah 4703","","","كتاب الصلوات"
"4704","(۴۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنَ أَبِی خَالِدٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ صَلَّی صَلاَۃً تَجَوَّزَ فِیہَا ، فَقُلْتُ لَہُ : ہَکَذَا کَانَتْ صَلاَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : نَعَمْ ، وَأَجْوَزُ۔","Majhul","Musannaf Ibn Abi Shaybah 4704","","","كتاب الصلوات"
"4705","(۴۷۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : لَمَّا طُعِنَ عُمَرُ وَمَاجَ النَّاسُ، تَقَدَّمَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ فَقَرَأَ بِأَقْصَرَ سُورَتَیْنِ فِی الْقُرْآنِ : {إنَّا أَعْطَیْنَاک الْکَوْثَرَ} وَ {إذَا جَائَ نَصْرُ اللہِ وَالْفَتْحُ}۔","Sahih","Musannaf Ibn Abi Shaybah 4705","","","كتاب الصلوات"
"4706","(۴۷۰۶) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ کَانَ یُخَفِّفُ الصَّلاَۃ ، وَیُتِمُّ الرُّکُوعَ وَالسُّجُودَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4706","","","كتاب الصلوات"
"4707","(۴۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانُوا یُتِمُّونَ وَیُوجِزُونَ ، وَیُبَادِرُونَ الْوَسْوَسَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4707","","","كتاب الصلوات"
"4708","(۴۷۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ أَخَفِّ النَّاسِ صَلاَۃً وَأَوْجَزَ۔","Sahih","Musannaf Ibn Abi Shaybah 4708","","","كتاب الصلوات"
"4709","(۴۷۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مِسْعَرٍ ، عَنْ مُہَاجِرٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : مَا رَأَیْت الصَّلاَۃ فِی مَوْضِعٍ أَخَفَّ مِنْہَا فِیمَا بَیْنَ ہَذَیْنِ الْحَائِطَیْنِ ، یَعْنِی مَسْجِدَ الْکُوفَۃِ الأَعْظَمَ۔","","Musannaf Ibn Abi Shaybah 4709","","","كتاب الصلوات"
"4710","(۴۷۱۰) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، قَالَ : کُنَّ النِّسَائُ إذَا مَرَرْنَ عَلَی عبیدَۃَ وَہُوَ یُصَلِّی ، قُلْنَ : خَفِّفُوا ، فَإِنَّہَا صَلاَۃُ عبیدَۃَ ، یَعْنِی مِنْ خِفَّتِہَا۔","","Musannaf Ibn Abi Shaybah 4710","","","كتاب الصلوات"
"4711","(۴۷۱۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنِّی لأَکُونُ فِی الصَّلاَۃ فَأَسْمَعُ صَوْتَ الصَّبِیِّ یَبْکِی ، فَأَتَجَوَّزُ فِی صَلاَتِی مَخَافَۃَ أَنْ أَشُقَّ عَلَی أُمِّہِ۔ (ترمذی ۳۷۶۔ احمد ۲۵۷)","Sahih","Musannaf Ibn Abi Shaybah 4711","","","كتاب الصلوات"
"4712","(۴۷۱۲) حَدَّثَنَا عَلِیُّ بْنُ إِسْحَاقَ ، عَنِ ابْنِ المُبَارَکِ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنِّی لأَکُونُ فِی الصَّلاَۃ فَأُرِیدُ أَنْ أُطَوِّلَ فِیہَا، فَأَسْمَعُ بُکَائَ الصَّبِیِّ فَأَتَجَوَّزُ فِی الصَّلاَۃ ، کَرَاہِیَۃَ أَنْ أَشُقَّ عَلَی أُمِّہِ۔ (بخاری ۷۰۷۔ ابوداؤد ۷۸۵۔ احمد ۳۰۵)","Sahih","Musannaf Ibn Abi Shaybah 4712","","","كتاب الصلوات"
"4713","(۴۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْحُوَیْرِثِ الزُّرَقِیِّ ، عَنْ عَلِیِّ بْنِ حسین ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إنِّی لأَسْمَعُ بُکَائَ الصَّبِیِّ خَلْفِی فَأُخَفِّفُ ، شَفَقَۃَ أَنْ أَفْتِنَ أُمَّہُ۔ (عبدالرزاق ۳۷۲۳)","Da'if","Musannaf Ibn Abi Shaybah 4713","","","كتاب الصلوات"
"4714","(۴۷۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی السَّوْدَائِ النَّہْدِیِّ ، عَنِ ابْنِ سَابِطٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی الرَّکْعَۃِ الأُولَی بِسُورَۃٍ نَحْوًا مِنْ سِتِّینَ آیَۃً ، فَسَمِعَ بُکَائَ صَبِیٍّ ، قَالَ : فَقَرَأَ فِی الثَّانِیَۃِ بِثَلاَثِ آیَاتٍ۔ (ابوداؤد ۳۹۔ عبدالرزاق ۳۷۲۴)","","Musannaf Ibn Abi Shaybah 4714","","","كتاب الصلوات"
"4715","(۴۷۱۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ ، فِیمَا نَعْلَمُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَنِّی لأَکُونُ فِی الصَّلاَۃ ، فَأَسْمَعُ بُکَائَ الصَّبِیِّ ، فَأُخَفِّفُ مَخَافَۃَ أَنْ أَشُقَّ عَلَی أُمِّہِ ، أَوَ قَالَ : أَنْ تُفْتَنَ أُمُّہُ۔ (عبدالرزاق ۳۷۲۱)","Da'if","Musannaf Ibn Abi Shaybah 4715","","","كتاب الصلوات"
"4716","(۴۷۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن?? سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یُدْرِکُ مَعَ الإِمَامِ وِتْرًا مِنْ صَلاَتِہِ ، قَالَ : یُصَلِّی مَا أَدْرَکَ ، وَلاَ یَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4716","","","كتاب الصلوات"
"4717","(۴۷۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : سُئِلَ یُونُسُ عَنِ الرَّجُلِ یُدْرِکُ مِنْ صَلاَۃِ الْقَوْمِ رَکْعَۃً ، أَوْ تَفُوتُہُ رَکْعَۃٌ ؟ قَالَ : کَانَ الْحَسَنُ وَمُحَمَّدُ لاَ یَرَیَانِ عَلَیْہِ سُجُودًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4717","","","كتاب الصلوات"
"4718","(۴۷۱۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ عَبَّاسٍ ، وَابْنَ الزُّبَیْرِ وَأَبَا سَعِیدٍ ، وَابْنَ عُمَرَ ؛ کَانُوا إذَا فَاتَہُمْ وِتْرٌ مِنْ صَلاَۃِ الإِمَام ، سَجَدُوا سَجْدَتَیْنِ۔","Majhul","Musannaf Ibn Abi Shaybah 4718","","","كتاب الصلوات"
"4719","(۴۷۱۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی سَعِیدٍ ، وَابْنِ عُمَرَ ، وَابْنِ الزُّبَیْرِ ؛ قَالُوا : إذَا فَاتَہُ بَعْضُ الصَّلاَۃ قَامَ فَقَضَی ، وَسَجَدَ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4719","","","كتاب الصلوات"
"4720","(۴۷۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إذَا أَدْرَکَ الرَّجُلُ سَجْدَۃً مِنْ صَلاَۃِ الإِمَام سجَدَ إلَیْہَا أُخْرَی ، ثُمَّ سَجَدَ سَجْدَتَیْنِ بَعْدَ مَا یَفْرُغُ مِنْ صَلاَتِہِ ، وَإِذَا أَدْرَکَ سَجْدَتَیْنِ ، سَجَدَ بَعْدَ مَا یَفْرُغُ مِنْ صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4720","","","كتاب الصلوات"
"4721","(۴۷۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنَ عُمَرَ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4721","","","كتاب الصلوات"
"4722","(۴۷۲۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ؛ قَالُوا : إذَا فَاتَکَ وِتْرٌ مِنْ صَلاَۃِ الإِمَام ، فَاقْضِ مَا فَاتَکَ ، وَاسْجُدْ سَجْدَتَیْنِ وَأَنْتَ جَالِسٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4722","","","كتاب الصلوات"
"4723","(۴۷۲۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَسْجُدُ مَعَہُمْ ، وَلاَ یَسْجُدُ إلَیْہَا أُخْرَی۔","","Musannaf Ibn Abi Shaybah 4723","","","كتاب الصلوات"
"4724","(۴۷۲۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ فَاتَتْہُ رَکْعَۃٌ فَقَامَ فَتَطَوَّعَ ، ثُمَّ ذَکَرَ فَصَلَّی الرَّکْعَۃَ الَّتِی فَاتَتْہُ ، وَسَجَدَ سَجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 4724","","","كتاب الصلوات"
"4725","(۴۷۲۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : یَقْطَعُ وَیُصَلِّی الرَّکْعَۃَ ، قَالَ : وَأَظُنُّہُ ، قَالَ : وَیَسْجُدُ سَجْدَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4725","","","كتاب الصلوات"
"4726","(۴۷۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی رَجُلٍ فَاتَتْہُ مَعَ الإِمَامِ رَکْعَۃٌ ، فَلَمَّا سَلَّمَ الإِمَام ظَنَّ أَنَّہُ قَدْ أَدْرَکَ مَعَہُ أَوَّلَ الصَّلاَۃ فَقَامَ یَتَطَوَّعُ ، فَقَالَ الْحَسَنُ : إذَا أَدَخَلَ تَطَوُّعًا فِی فَرِیضَۃٍ فَسَدَتْ عَلَیْہِ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 4726","","","كتاب الصلوات"
"4727","(۴۷۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِی الطَّاقِ۔","Da'if","Musannaf Ibn Abi Shaybah 4727","","","كتاب الصلوات"
"4728","(۴۷۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَتَنَکَّبُ الطَّاقَ۔","","Musannaf Ibn Abi Shaybah 4728","","","كتاب الصلوات"
"4729","(۴۷۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَزِیدَ بْنِ أَبِی زِیاد ، عَنْ عُبَیْدِ بْنِ أَبِی الْجَعْدِ ، عَنْ کَعْبٍ ؛ أَنَّہُ کَرِہَ المذبح فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4729","","","كتاب الصلوات"
"4730","(۴۷۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدِ بْنِ أَبْجَرَ، عَنْ نُعَیْمِ بْنِ أَبِی ہِنْدٍ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : لاَ تَتَّخِذُوا المذابح فِی الْمَسَاجِدِ۔","","Musannaf Ibn Abi Shaybah 4730","","","كتاب الصلوات"
"4731","(۴۷۳۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃ فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4731","","","كتاب الصلوات"
"4732","(۴۷۳۲) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا یَحْیَی بْنُ بَدْرٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃَ فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4732","","","كتاب الصلوات"
"4733","(۴۷۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُبیدَۃُ ، عَنْ عُبید بْنِ أَبِی الْجَعْدِ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُونَ : إِنْ مِنْ أَشْرَاطِ السَّاعَۃِ أَنْ تُتَّخَذَ المذابح فِی الْمَسَاجِدِ ، یَعْنِی الطَّاقَاتِ۔","","Musannaf Ibn Abi Shaybah 4733","","","كتاب الصلوات"
"4734","(۴۷۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا أَبُو إسْرَائِیلَ ، عَنْ مُوسَی الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَزَالُ ہَذِہِ الأُمَّۃُ ، أَوَ قَالَ : أُمَّتِی بِخَیْرٍ مَا لَمْ یَتَّخِذُوا فِی مَسَاجِدِہِمْ مَذَابِحَ کَمَذَابِحِ النَّصَارَی۔","","Musannaf Ibn Abi Shaybah 4734","","","كتاب الصلوات"
"4735","(۴۷۳۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : اتَّقُوا ہَذِہِ الْمَحَارِیبَ ، وَکَانَ إبْرَاہِیمُ لاَ یَقُومُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 4735","","","كتاب الصلوات"
"4736","(۴۷۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ قَیْسٍ ، عَنْ أَبِی ذَرٍّ ، قَالَ : إِنَّ مِنْ أَشْرَاطِ السَّاعَۃِ أَنْ تُتَّخَذَ الْمَذَابِحُ فِی الْمَسَاجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 4736","","","كتاب الصلوات"
"4737","(۴۷۳۷) حَدَّثَنَا عَبْدُ الْحَمِیدِ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ أَبَا خَالِدٍ الْوَالِبِیَّ لاَ یَقُومُ فِی الطَّاقِ ، وَیَقُومُ قِبَلَ الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4737","","","كتاب الصلوات"
"4738","(۴۷۳۸) حَدَّثَنَا حُمَیْدٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : رَأَیْتُُ مَسْجِدَ أَبِی ذَرٍّ فَلَمْ أَرَ فِیہِ طَاقًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4738","","","كتاب الصلوات"
"4739","(۴۷۳۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : کَانَ یُصَلِّی بِنَا فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4739","","","كتاب الصلوات"
"4740","(۴۷۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ نَافِعٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی فِی الطَّاقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4740","","","كتاب الصلوات"
"4741","(۴۷۴۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا نِفَاعَۃُ بْنُ مُسْلِمٍ ، قَالَ : رَأَیْتُ سُوَیْد بْنَ غَفَلَۃَ یُصَلِّی فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4741","","","كتاب الصلوات"
"4742","(۴۷۴۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ أُمِّ عَمْرٍو الْمُرَادِیَّۃِ ، قَالَتْ : رَأَیْت الْبَرَائَ بْنَ عَازِبٍ یُصَلِّی فِی الطَّاقِ۔","Majhul","Musannaf Ibn Abi Shaybah 4742","","","كتاب الصلوات"
"4743","(۴۷۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ وِقَائَ بْنِ إیَاسٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی فِی الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 4743","","","كتاب الصلوات"
"4744","(۴۷۴۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ قطن ، قَالَ : رَأَیْتُ أَبَا رَجَائٍ یُصَلِّی فِی الْمِحْرَابِ۔","","Musannaf Ibn Abi Shaybah 4744","","","كتاب الصلوات"
"4745","(۴۷۴۵) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کُنْتَ فِی الصَّلاَۃ ، فَلاَ تَمْسَحْ جَبْہَتَکَ ، وَلاَ تَنْفُخْ ، وَلاَ تُحَرِّکِ الْحَصْبَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 4745","","","كتاب الصلوات"
"4746","(۴۷۴۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہُوَ مِنَ الْجَفَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4746","","","كتاب الصلوات"
"4747","(۴۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہْمَسِ بْنِ الْحَسَنِ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : کَانَ یُقَالُ، أَرْبَعٌ مِنَ الْجَفَائِ : أَنْ یَمْسَحَ جَبْہَتَہ قَبْلَ أَنْ یَنْصَرِفَ ، أَوْ یَبُولَ قَائِمًا ، أَوْ یَسْمَعَ الْمُنَادِیَ ، ثُمَّ لاَ یُجِیبَہُ ، أَوْ یَنْفُخَ فِی سُجُودِہ۔","","Musannaf Ibn Abi Shaybah 4747","","","كتاب الصلوات"
"4748","(۴۷۴۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَمْسَحَ الرَّجُلُ جَبْہَتَہُ فِی الصَّلاَۃ ، وَیَقُولُ : ہُوَ مِنَ الْجَفَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4748","","","كتاب الصلوات"
"4749","(۴۷۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَمْسَحَ جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4749","","","كتاب الصلوات"
"4750","(۴۷۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَمْسَحُ جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ ، قَالَ : ہُوَ جَفَاء ، وَقَالَ الْحَکَمُ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 4750","","","كتاب الصلوات"
"4751","(۴۷۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ عَبْدُ اللہِ : أَرْبَعٌ مِنَ الْجَفَائِ : أَنْ یُصَلِّیَ الرَّجُلُ إلَی غَیْرِ سُتْرَۃٍ ، وَأَنْ یَمْسَحَ جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ ، أَوْ یَبُولَ قَائِمًا ، أَوْ یَسْمَعَ الْمُنَادِیَ ، ثُمَّ لاَ یُجِیبَہُ۔","","Musannaf Ibn Abi Shaybah 4751","","","كتاب الصلوات"
"4752","(۴۷۵۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِہِ ، یَعْنِی یَمْسَح جَبْہَتَہُ قَبْلَ أَنْ یَنْصَرِفَ۔","","Musannaf Ibn Abi Shaybah 4752","","","كتاب الصلوات"
"4753","(۴۷۵۳) حَدَّثَنَا یَزِیدُ بْنُ أَبِی الْخنْدِقِ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ سَالِمًا عَنِ الرَّجُلِ یَمْسَحُ جَبْہَتَہُ ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4753","","","كتاب الصلوات"
"4754","(۴۷۵۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4754","","","كتاب الصلوات"
"4755","(۴۷۵۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4755","","","كتاب الصلوات"
"4756","(۴۷۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : رَأَیْتُہ قَالَ بِثَوْبِہِ ہَکَذَا ، فَمَسَحَ بِہِ جَبْہَتَہُ ، وَأَمَرَّ وَکِیعٌ یَدَہُ عَلَی جَبْہَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4756","","","كتاب الصلوات"
"4757","(۴۷۵۷) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ؛ بِنَحْوِ حَدِیثِ وَکِیعٍ ، أَوْ مِثْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4757","","","كتاب الصلوات"
"4758","(۴۷۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنَامُ خَلْفَ الإِمَامِ حَتَّی یَرْکَعَ الإِمَامُ وَیَسْجُدَ ، ثُمَّ یَنْتَبِہَ النَّائِمُ ، قَالاَ : یَتْبَعُ الإِمَامَ فَیصلی مَا سَبَقَہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 4758","","","كتاب الصلوات"
"4759","(۴۷۵۹) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنْسَی الصَّلَوَاتِ ، قَالَ : یَبْدَأُ بِالأُولَی فَالأُولَی۔","No Data Available","Musannaf Ibn Abi Shaybah 4759","","","كتاب الصلوات"
"4760","(۴۷۶۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا نَسِیَ الصَّلَوَاتِ فَلْیَبْدَأْ بِالأَولِ فَالأَولِ ، فَإِنْ خَافَ الْفَوْتَ یَبْدَأُ بِالَّتِی یَخَافُ فَوْتَہَا۔","","Musannaf Ibn Abi Shaybah 4760","","","كتاب الصلوات"
"4761","(۴۷۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَاشِدٍ ، قَالَ : نِمْتُ عَنِ الظُّہْرِ ، وَالْعَصْرِ ، وَالْمَغْرِبِ ، وَالْعِشَائِ ، فَأَتَیْتُ عُبَیْدَ بْنَ عُمَیْرٍ فَذَکَرْتُ ذَلِکَ لَہُ ، فَقَالَ : ابْدَأْ بِالظُّہْرِ وَالْعَصْرِ ، وَالْمَغْرِبِ وَالْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 4761","","","كتاب الصلوات"
"4762","(۴۷۶۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی رَجُلٍ نَسِیَ صَلاَۃً فَذَکَرَہَا عِنْدَ غُرُوبِ الشَّمْسِ ، وَلَمْ یَکُنْ صَلَّی تِلْکَ الصَّلاَۃ ، قَالَ : إِنْ خَشِیَ أَنْ یُصَلِّیَ ہَذِہِ الَّتِی کَانَ نَسِیَ فَیَذْہَبَ وَقْتُ تِلْکَ ، فَلْیَبْدَأْ بِالَّتِی یَخَافُ فَوْتَہَا۔","","Musannaf Ibn Abi Shaybah 4762","","","كتاب الصلوات"
"4763","(۴۷۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَقْضِی الأَولَ فَالأَولَ۔","","Musannaf Ibn Abi Shaybah 4763","","","كتاب الصلوات"
"4764","(۴۷۶۴) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَمَّادِ بْنِ فَرْوَۃَ ، قَالَ : أَہْرَقْتُ الْمَائُ فَنَسِیتُ أَنْ أَتَوَضَّأَ ، فَصَلَّیْتُ الظُّہْرَ وَالْعَصْرَ وَالْمَغْرِبَ ، فَذَکَرْت أَنِّی صَلَّیْتہَا عَلَی غَیْرِ طُہْرٍ ، فَلَمَّا أَصْبَحْتُ سَأَلْتُ عَطَائً وَمُجَاہِدًا ، قَالَ جَعْفَرُ : وَأَحْسِبُہُ ، قَالَ : وَسَعِیدَ بْنَ جُبَیْرٍ ، فَکُلُّہُمْ قَال لَہُ : تَوَضَّأْ وَأَعِدْ صَلاَتَکَ الآنَ، تَبْدَأُ بِالأَولِ فَالأَولِ۔","","Musannaf Ibn Abi Shaybah 4764","","","كتاب الصلوات"
"4765","(۴۷۶۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ مَوْلًی لأَبِی بَکْرَۃَ ، قَالَ : دَخَلَ أَبُو بَکْرَۃَ بُسْتَانًا ، فَطَافَ فِیہِ وَنَظَرَ إلَیْہِ وَنَسِیَ صَلاَۃَ الْعَصْرِ حَتَّی مَالَتِ الشَّمْسُ ، فَلَمَّا ذَکَرَہَا تَوَضَّأَ وَجَلَسَ ، فَلَمَّا وَجَبَتْ قَامَ فَصَلَّی الْعَصْرَ ، ثُمَّ صَلَّی الْمَغْرِبَ۔","Majhul","Musannaf Ibn Abi Shaybah 4765","","","كتاب الصلوات"
"4766","(۴۷۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، عَنْ رَجُلٍ یُقَالُ لَہُ : سَعْدٌ ، قَالَ : صَلَّیْت فِی رَمَضَانَ مَعَ النَّاسِ ، ثُمَّ أَتَیْتُ بَیْتًا لأَہْلِی فَدَخَلْت فِیہِ فَنِمْت لَیْلَتِی وَیَوْمِی وَلَیْلَتِی حَتَّی الْغَدِ ، فَأَتَیْت ابْنَ عُمَرَ فَأَخْبَرْتُہُ ؟ قَالَ : فَصَنَعْتَ مَاذَا ؟ قَالَ : صَلَّیْت الظُّہْرَ ، قَالَ : أَحْسَنْت ، قَالَ : ثم مَاذَا ؟ قَالَ : صَلَّیْتُ الْعَصْرَ ، قَالَ : أَحْسَنْت ، قَالَ ، ثُمَّ مَاذَا ؟ قَالَ : صَلَّیْت الْمَغْرِبَ ، قَالَ أَحْسَنْت قَالَ : ثُمَّ مَاذَا ؟ قَالَ : صَلَّیْت الْعِشَائَ ، قَالَ : أَحْسَنْت ، قَالَ ، ثُمَّ مَاذَا ؟ قَالَ : أَوْتَرْت ، قَالَ : مَا کُنْت تَصْنَعُ بِالْوِتْرِ ؟ قَالَ : ثُمَّ مَاذَا ؟ قَالَ : صَلَّیْت الصُّبْحَ ، قَالَ : أَحْسَنْت۔","Majhul","Musannaf Ibn Abi Shaybah 4766","","","كتاب الصلوات"
"4767","(۴۷۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، وَمَنْصُورٌ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : مَنْ نَامَ عَنْ صَلاَۃِ الْعِشَائِ فَاسْتَیْقَظَ عِنْدَ طُلُوعِ الشَّمْسِ ، قَالَ : یُصَلِّی الْفَجْرَ ، ثُمَّ یُصَلِّی الْعِشَائَ۔","","Musannaf Ibn Abi Shaybah 4767","","","كتاب الصلوات"
"4768","(۴۷۶۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : یَبْدَأُ بِالْعِشَائِ الَّتِی نَامَ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 4768","","","كتاب الصلوات"
"4769","(۴۷۶۹) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَنْسَی الْعَتَمَۃَ ، أَوْ یَرْقُدُ عَنْہَا حَتَّی یَکُونَ الصُّبْحُ ، فَقِیلَ لَہُ : فَإِنْ بَدَأَ بِالْعَتَمَۃِ فَاتَتْہُ الصُّبْحُ ؟ قَالَ : فَلْیَبْدَأْ بِالْعَتَمَۃِ وَإِنْ فَاتَتْہُ الصُّبْحُ۔","","Musannaf Ibn Abi Shaybah 4769","","","كتاب الصلوات"
"4770","(۴۷۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، قَالَ : حدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَسِیَ صَلاَۃً ، أَوْ نَامَ عَنْہَا فَکَفَّارَتُہُ أَنْ یُصَلِّیَہَا إذَا ذَکَرَہَا۔ (بخاری ۵۹۷۔ مسلم ۳۱۴)","Hasan","Musannaf Ibn Abi Shaybah 4770","","","كتاب الصلوات"
"4771","(۴۷۷۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی عَلْقَمَۃَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ مَسْعُودٍ ، قَالَ : أَقْبَلْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الْحُدَیْبِیَۃِ ، فَذَکَرُوا أَنَّہُمْ نَزَلُوا دَہَاسًا مِنَ الأَرْضِ ، یَعْنِی بِالدَّہَاسِ : الرَّمْلَ ، قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ یَکْلَؤُنَا ؟ فَقَالَ بِلاَلٌ : أَنَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذًا نَنَامُ ، قَالَ : فَنَامُوا حَتَّی طَلَعَتْ عَلَیْہِمُ الشَّمْسُ ، قَالَ : فَاسْتَیْقَظَ نَاسٌ فِیہِمْ فُلاَنٌ وَفُلاَنٌ وَفِیہِمْ عُمَرُ ، فَقُلْنَا : اہْضِبُوا ، یَعْنِی تَکَلَّمُوا ، قَالَ : فَاسْتَیْقَظَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : افْعَلُوا کَمَا کُنْتُمْ تَفْعَلُونَ ، قَالَ : فَفَعَلْنَا ، قَالَ : کَذَلِکَ لِمَنْ نَامَ ، أَوْ نَسِیَ۔ (ابوداؤد ۴۴۸۔ احمد ۱/۳۸۶)","Hasan","Musannaf Ibn Abi Shaybah 4771","","","كتاب الصلوات"
"4772","(۴۷۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أبی إسْمَاعِیلَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : عَرَّسْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ ، فَلَمْ نَسْتَیْقِظْ حَتَّی آذَتْنَا الشَّمْسُ ، فَقَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لِیَأْخُذْ کُلُّ رَجُلٍ مِنْکُمْ بِرَأْسِ رَاحِلَتِہِ ، ثُمَّ لْیَتَنَحَّ عَنْ ہَذَا الْمَنْزِلِ ، ثُمَّ دَعَا بِمَائٍ فَتَوَضَّأَ فَسَجَدَ سَجْدَتَیْنِ ، ثُمَّ أُقِیمَتِ الصَّلاَۃ فَصَلَّی۔ (مسلم ۳۱۰۔ احمد ۲/۴۲۹)","Sahih","Musannaf Ibn Abi Shaybah 4772","","","كتاب الصلوات"
"4773","(۴۷۷۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْجَبَّارِ بن عَبَّاسٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرِہِ الَّذِی نَامُوا فِیہِ حَتَّی طَلَعَتِ الشَّمْسُ ، ثُمَّ قَالَ : إنَّکُمْ کُنْتُمْ أَمْوَاتًا فَرَدَّ اللَّہُ إلَیْکُمْ أَرْوَاحَکُمْ ، فَمَنْ نَامَ عَنْ صَلاَۃٍ ، أَوْ نَسِیَ صَلاَۃً فَلْیُصَلِّہَا إذَا ذَکَرَہَا ، وَإِذَا اسْتَیْقَظَ۔ (ابو یعلی ۸۹۵۔ طبرانی ۲۶۸)","Hasan","Musannaf Ibn Abi Shaybah 4773","","","كتاب الصلوات"
"4774","(۴۷۷۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا نَامَ الرَّجُلُ عَنْ صَلاَۃٍ ، أَوْ نَسِیَ فَلْیُصَلِّ إذَا اسْتَیْقَظَ ، أَوْ ذَکَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 4774","","","كتاب الصلوات"
"4775","(۴۷۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ وَسَمُرَۃَ بْنَ جُنْدُبٍ اخْتَلَفَا فِی الَّذِی یَنْسَی صَلاَتَہُ ، فَقَالَ عِمْرَانُ : یُصَلِّیہَا إذَا ذَکَرہَا ، وَقَالَ سَمُرَۃُ : یُصَلِّیہَا إذَا ذَکَرَ وَفِی وَقْتِہَا مِنَ الْغَدِ۔","Sahih","Musannaf Ibn Abi Shaybah 4775","","","كتاب الصلوات"
"4776","(۴۷۷۶) حَدَّثَنَا وَکِیعٌ، عَنْ عَلِیِّ بْنِ صَالِحٍ، عَنْ سِمَاکٍ، عَنْ سَبْرَۃَ بْنِ نَخَفٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: یُصَلِّی إذَا ذَکَرَ۔","Majhul","Musannaf Ibn Abi Shaybah 4776","","","كتاب الصلوات"
"4777","(۴۷۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ، عَنْ سَعْدٍ ، قَالَ : قَالَ: یُصَلِّیہَا إذَا ذَکَرَہَا ، وَیُصَلِّی مِثْلَہَا مِنَ الْغَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 4777","","","كتاب الصلوات"
"4778","(۴۷۷۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ نَامَ عَنْ صَلاَۃٍ ، أَوْ نَسِیَہَا ، قَالَ : یُصَلِّی مَتَی ذَکَرَہَا عِنْدَ طُلُوعِ الشَّمْسِ ، أَوَعِنْدَ غُرُوبِہَا ، ثُمَّ قَرَأَ : (أَقِمِ الصَّلاَۃ لِذِکْرِی) قَالَ : إذَا ذَکَرْتَہَا فَصَلِّہَا فِی أَیِّ سَاعَۃٍ کُنْتَ۔","","Musannaf Ibn Abi Shaybah 4778","","","كتاب الصلوات"
"4779","(۴۷۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی حُمَیْدٍ ) ، عَنْ أَبِی مَلِیحٍ ، عَنْ أَبِی ذَرٍّ ، وَعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ؛ فِی الصَّلاَۃ تُنْسَی ؟ قَالاَ : یُصَلِّیہَا إذَا ذَکَرَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 4779","","","كتاب الصلوات"
"4780","(۴۷۸۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُوسَی بْنِ قَیْسٍ ، عَنْ زَکَرِیَّا بْنِ جَرَادٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : مَا کَانَ لَکَ أَحَدٌ یُہبَّکَ ؟ صَلِّہَا لِذِّکْرِی۔","","Musannaf Ibn Abi Shaybah 4780","","","كتاب الصلوات"
"4781","(۴۷۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَإِبْرَاہِیمَ ، قَالاَ : {أَقِمِ الصَّلاَۃ لِذِکْرِی} أَیْ : صَلِّہَا إذَا ذَکَرْتَہَا وَقَدْ نَسِیتَہَا۔","","Musannaf Ibn Abi Shaybah 4781","","","كتاب الصلوات"
"4782","(۴۷۸۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ صَخْرِ بْنِ جُوَیْرِیَۃَ ، قَالَ : سَأَلْتُ نَافِعًا عَنْ رَجُلٍ نَسِیَ صَلاَۃَ الْعَصْرِ حَتَّی اصْفَارَّت الشَّمْسُ ؟ قَالَ : یُصَلِّیہَا لَیْسَتْ کَشَیْئٍ مِنَ الصَّلَوَاتِ۔","","Musannaf Ibn Abi Shaybah 4782","","","كتاب الصلوات"
"4783","(۴۷۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، قَالَ : یُصَلِّیہَا إذَا ذَکَرَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4783","","","كتاب الصلوات"
"4784","(۴۷۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنَامُ عَنْ صَلاَۃِ الْعِشَائِ حَتَّی تَبْزُغَ الشَّمْسُ ، قَالَ : یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 4784","","","كتاب الصلوات"
"4785","(۴۷۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَامَ عَنْ صَلاَۃِ الْفَجْرِ حَتَّی طَلَعَتِ الشَّمْسُ ، فَقَالَ لأَصْحَابِہِ : تَزَحْزَحُوا عَنِ الْمَکَانِ الَّذِی أَصَابَتْکُمْ فِیہِ الْغَفْلَۃُ ، فَصَلَّی ثُمَّ قَالَ : {أَقِمِ الصَّلاَۃ لِذِکْرِی}۔","","Musannaf Ibn Abi Shaybah 4785","","","كتاب الصلوات"
"4786","(۴۷۸۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ بَعْضِ بَنِی أَبِی بَکْرَۃَ ؛ أَنَّ أَبَا بَکْرَۃَ نَامَ فِی دَالِیَۃٍ لَہُمْ وَظَنَنَّا أَنَّہُ قَدْ صَلَّی الْعَصْرَ ، فَاسْتَیْقَظَ عِنْدَ غُرُوبِ الشَّمْسِ ، قَالَ : فَانْتَظَرَ حَتَّی غَابَتِ الشَّمْسُ ، ثُمَّ صَلَّی۔","Majhul","Musannaf Ibn Abi Shaybah 4786","","","كتاب الصلوات"
"4787","(۴۷۸۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ سَعْدِ بن إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ الْمَلِکِ بْنِ کَعْبٍ ، عَنْ أَبِیہِ ، قَالَ : نِمْتُ عَنِ الْفَجْرِ حَتَّی طَلَعَ قَرْنُ الشَّمْسِ ، وَنَحْنُ خَارِفُونَ فِی مَالٍ لَنَا ، فَمِلْتُ إلَی شَرْبَۃٍ مِنَ النَّخْلِ أَتَوَضَّأُ ، قَالَ : فَبَصُرَ بِی أَبِی فَقَالَ : مَا شَأْنُک ؟ قُلْتُ : أُصَلِّی قَدْ تَوَضَّأْت ، فَدَعَانِی فَأَجْلَسَنِی إلَی جَنْبِہِ ، فَلَمَّا أَنْ تَعَلَّتِ الشَّمْسُ وَابْیَضَّتْ وَأَتَیْتُ الْمَسْجِدَ ، ضَرَبَنِی قَبْلَ أَنْ أَقُومَ إلَی الصَّلاَۃ ، وَقَالَ : تَنْسَی ؟ صَلِّ الأَنَ۔","Majhul","Musannaf Ibn Abi Shaybah 4787","","","كتاب الصلوات"
"4788","(۴۷۸۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی الرَّجُلِ إذَا نَسِیَ أَنْ یُصَلِّیَ صَلاَۃً حَتَّی تَصْفَرَّ الشَّمْسُ ، قَالَ: یُصَلِّیہَا إذَا غَابَتِ الشَّمْسُ ، وَقَالَ قَتَادَۃُ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4788","","","كتاب الصلوات"
"4789","(۴۷۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ أَبِی قَتَادَۃَ ، قَالَ : سِرْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ذَاتَ لَیْلَۃٍ ، قَالَ : قُلْنَا : یَا رَسُولَ اللہِ ، لَوْ عَرَّسْت بِنَا ، فَقَالَ : إنِّی أَخَافُ أَنْ تَنَامُوا عَنِ الصَّلاَۃ ، فَمَنْ یُوقِظُنَا لِلصَّلاَۃِ ؟ قَالَ : فَقَالَ بِلاَلٌ : أَنَا ، یَا رَسُولَ اللہِ ، قَالَ : فَعَرَّسَ بِالْقَوْمِ وَاضْطَجَعُوا ، وَاسْتَنَدَ بِلاَلٌ إلَی رَاحِلَتِہِ فَغَلَبَتْہُ عَیْنَاہُ ، وَاسْتَیْقَظَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَدْ طَلَعَ حَاجِبُ الشَّمْسِ ، فَقَالَ : یَا بِلاَلُ ، أَیْنَ مَا قُلْتَ لَنَا ؟ فَقَالَ : یَا رَسُولَ اللہِ ، وَالَّذِی بَعَثَک بِالْحَقِّ مَا أُلْقِیَتْ عَلَیَّ نَوْمَۃٌ مِثْلہَا ، قَالَ : فَقَالَ : إنَّ اللَّہَ قَبَضَ أَرْوَاحَکُمْ حِینَ شَائَ ، وَرَدَّہَا عَلَیْکُمْ حِینَ شَائَ ، قَالَ : ثُمَّ أَمَرَہُمْ فَانْتَشَرُوا لِحَاجَتِہِمْ ، وَتَوَضَّؤُوا وَارْتَفَعَتِ الشَّمْسُ ، فَصَلَّی بِہِمُ الْفَجْرَ۔ (بخاری ۵۹۵۔ ابوداؤد ۴۴۱)","Sahih","Musannaf Ibn Abi Shaybah 4789","","","كتاب الصلوات"
"4790","(۴۷۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ جَابِرٍ ، قَالَ : جَائَ عُمَرُ یَوْمَ الْخَنْدَقِ فَجَعَلَ یَسُبُّ کُفَّارَ قُرَیْشٍ وَیَقُولُ : یَا رَسُولَ اللہِ ، مَا صَلَّیْتُ الْعَصْرَ حَتَّی کَادَتِ الشَّمْسُ أَنْ تَغِیبَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَأَنَا وَاللَّہِ مَا صَلَّیْتُ بَعْدُ ، فَنَزَلَ فَتَوَضَّأَ ثُمَّ صَلَّی الْعَصْرَ بَعْدَ مَا غَرَبَتِ الشَّمْسُ ، ثُمَّ صَلَّی الْمَغْرِبَ بَعْدَ مَا صَلَّی الْعَصْرَ۔ (بخاری ۹۴۵۔ مسلم ۴۳۸)","Hasan","Musannaf Ibn Abi Shaybah 4790","","","كتاب الصلوات"
"4791","(۴۷۹۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی رَجَائٍ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، وَإِنَّا سَرَیْنَا اللَّیْلَۃَ حَتَّی إذَا کَانَ آخِرُ اللَّیْلِ وَقَعْنَا تِلْکَ الْوَقْعَۃَ ، وَلاَ وَقْعَۃَ عِنْدَ الْمُسَافِرِ أَحْلَی مِنْہَا ، فَمَا أَیْقَظَنَا إِلاَّ حَرُّ الشَّمْسِ ، فَجَعَلَ عُمَرُ یُکَبِّرُ ، فَلَمَّا اسْتَیْقَظَ شَکَا النَّاسُ إلَیْہِ مَا أَصَابَہُمْ ، فَقَالَ : لاَ ضَیْرَ ، قَالَ : فَارْتَحَلُوا فَسَارُوا غَیْرَ بَعِیدٍ ، ثُمَّ نَزَلَ فَنُودِیَ بِالصَّلاَۃ ، فَصَلَّی بِالنَّاسِ۔ (بخاری ۳۴۴۔ مسلم ۴۷۶)","Sahih","Musannaf Ibn Abi Shaybah 4791","","","كتاب الصلوات"
"4792","(۴۷۹۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالاَ: إذَا کُنْتَ فِی صَلاَۃِ الْعَصْرِ، فَذَکَرْت أَنَّک لَمْ تُصَلِّ الظُّہْرَ ، فَانْصَرِفْ فَصَلِّ الظُّہْرَ ، ثُمَّ صَلِّ الْعَصْرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4792","","","كتاب الصلوات"
"4793","(۴۷۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ نَسِیَ الظُّہْرَ ، ثُمَّ ذَکَرَہَا وَہُوَ فِی الْعَصْرِ ، قَالَ : یَنْصَرِفُ فَیُصَلِّی الظُّہْرَ ، ثُمَّ یُصَلِّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4793","","","كتاب الصلوات"
"4794","(۴۷۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ فِی حَدِیثِہِ : وَإِنْ ذَکَرَہَا بَعْدَ مَا صَلَّی الْعَصْرَ فَقَدْ مَضَتْ ، وَیُصَلِّی الظُّہْرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4794","","","كتاب الصلوات"
"4795","(۴۷۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إِنْ ذَکَرَ وَہُوَ فِی الصَّلاَۃ ، انْصَرَفَ فَصَلَّی الظُّہْرَ، ثُمَّ صَلَّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4795","","","كتاب الصلوات"
"4796","(۴۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ رَجُلٍ ذَکَرَ صَلاَۃً وَہُوَ فِی صَلاَۃٍ ؟ قَالاَ : إِنْ ذَکَرَہَا قَبْلَ أَنْ یَتَشَہَّدَ ، أَوْ یَجْلِسَ مِقْدَارَ التَّشَہُّدِ تَرَکَ ہَذِہِ وَعَادَ إلَی تِلْکَ ، وَإِنْ ذَکَرَہَا بَعْدَ ذَلِکَ اعْتَدَّ بِہَذِہِ ، وَعَادَ إلَی تِلْکَ۔","","Musannaf Ibn Abi Shaybah 4796","","","كتاب الصلوات"
"4797","(۴۷۹۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالَ : یُصَلِّی الْعَصْرَ ، فَإِذَا فَرَغَ صَلَّی الظُّہْرَ۔","","Musannaf Ibn Abi Shaybah 4797","","","كتاب الصلوات"
"4798","(۴۷۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا ذَکَرَ وَہُوَ فِی الْعَصْرِ أَنَّہُ لَمْ یُصَلِّ الظُّہْرَ ، فَإِنَّہُ یُصَلِّی الْعَصْرَ ، ثُمَّ یُصَلِّی الظُّہْرَ بَعْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4798","","","كتاب الصلوات"
"4799","(۴۷۹۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا ذَکَرْتَ وَأَنْتَ تُصَلِّی الْعَصْرَ أَنَّک لَمْ تُصَلِّ الظُّہْرَ ، مَضَیْت فِیہَا ، ثُمَّ صَلَّیْت الظُّہْرَ ، فَإِذَا صَلَّیْتَ الْعَصْرَ وَذَکَرْت أَنَّک لَمْ تُصَلِّ الظُّہْرَ فَصَلَّیْت أَجْزَأَتْک۔","Sahih","Musannaf Ibn Abi Shaybah 4799","","","كتاب الصلوات"
"4800","(۴۸۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ الْحَسَنِ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4800","","","كتاب الصلوات"
"4801","(۴۸۰۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ صَلَّی بِقَوْمٍ الظُّہْرَ وَہِیَ لَہُ الْعَصْرُ ، قَالَ : تَمَّتْ صَلاَتُہُ ، وَیُعِیدُ مَنْ خَلْفَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4801","","","كتاب الصلوات"
"4802","(۴۸۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ تُجْزِئُ صَلاَۃٌ وَاحِدَۃٌ عَنْ قَوْمَیْنِ شَتَّی۔","","Musannaf Ibn Abi Shaybah 4802","","","كتاب الصلوات"
"4803","(۴۸۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، قَالَ : انْتَہَیْت إلَی الْمَسْجِدِ الْجَامِعِ وَأَنَا أَرَی أَنَّہُمْ لَمْ یُصَلُّوا الظُّہْرَ ، فَقُمْتُ أَتَطَوَّعُ حَتَّی أُقِیمَتِ الصَّلاَۃ ، فَلَمَّا صَلَّوْا إذَا ہِیَ الْعَصْرُ ، فَقُمْت فَصَلَّیْت بِہِمُ الظُّہْرَ ، ثُمَّ صَلَّیْت الْعَصْرَ ، ثُمَّ أَتَیْتُ الْحَسَنَ ، فَذَکَرْت ذَلِکَ لَہُ فَأَمَرَنِی بِمِثْلِ الَّذِی صَنَعْت۔","","Musannaf Ibn Abi Shaybah 4803","","","كتاب الصلوات"
"4804","(۴۸۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : انْتَہَیْنَا إلَی الْمَسْجِدِ وَلَمْ أُصَلِّ الْمَغْرِبَ ، فَأُقِیمَتِ الصَّلاَۃ فَصَلَّیْت مَعَہُمْ وَأَنَا أَرَی أَنَّہَا الْمَغْرِبُ ، فَإِذَا ہِیَ الْعِشَائُ ، فَقُمْت فَصَلَّیْت الْمَغْرِبَ ، ثُمَّ صَلَّیْت الْعِشَائَ ، ثُمَّ سَأَلْتُ ، فَأَمَرُونِی بِالَّذِی صَنَعْت۔","No Data Available","Musannaf Ibn Abi Shaybah 4804","","","كتاب الصلوات"
"4805","(۴۸۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ؛ فِی رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِی الظُّہْرِ ، وَہِیَ لَہُمُ الْعَصْرُ ؟ قَالَ : یَبْدَأُ بِالَّذِی بَدَأَ اللَّہُ بِہِ یُصَلِّی الظُّہْرَ ، ثُمَّ یُصَلِّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 4805","","","كتاب الصلوات"
"4806","(۴۸۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : بَلَغَنِی عَنْ طَاوُوسٍ ، وَعَطَائٍ ، أَنَّہُمَا قَالاَ : یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 4806","","","كتاب الصلوات"
"4807","(۴۸۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ وَسَالِمًا ، وَالْقَاسِمَ ، وَعَطَائً عَنْ رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِی الْعَصْرِ وَہُوَ یَرَی أَنَّہَا الظُّہْرُ ؟ قَالُوا : یَنْصَرِفُ فَیُصَلِّی الظُّہْرَ، ویُجْزِئُ عَنْہُ الْعَصْرُ ، قَالَ : وَسَأَلْت عَامِرًا ، وَمُسْلِمَ بْنَ صُبَیْحٍ ، فَقَالاَ : یَنْصَرِفُ فَیُصَلِّی الظُّہْرَ ، ثُمَّ یُصَلِّی الْعَصْرَ ، فَإِنَّ اللَّہَ قَدْ کَتَبَہَا عِنْدَہُ قَبْلَ الْعَصْرِ ، فَلاَ تَکُونُ لَہُ الظُّہْرُ ۔ وَقَالَ جَابِرٌ : عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4807","","","كتاب الصلوات"
"4808","(۴۸۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : فِی رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِی صَلاَۃِ الْعَصْرِ، وَہُوَ یَحْسَبُہُمْ فِی صَلاَۃِ الظُّہْرِ، فَإِذَا ہُمْ فِی الْعَصْرِ، قَالَ: یَسْتَقْبِلُ الصَّلاَتَیْنِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 4808","","","كتاب الصلوات"
"4809","(۴۸۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْمُسَافِر إذَا نَسِیَ صَلاَۃً فَذَکَرَہَا فِی الْحَضَرِ: صَلَّی صَلاَۃَ السَّفَرِ، وَإِذَا نَسِیَ صَلاَۃً فِی الْحَضَرِ فَذَکَرَہَا فِی السَّفَرِ، فَلْیُصَلِّ صَلاَۃَ الْحَضَرِ۔","","Musannaf Ibn Abi Shaybah 4809","","","كتاب الصلوات"
"4810","(۴۸۱۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، وَعُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ؛ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4810","","","كتاب الصلوات"
"4811","(۴۸۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ أبی الْفَضْلِ ، عَنِ الْحَسَنِ ، قَالَ : إذَا نَسِیَ صَلاَۃً فِی الْحَضَرِ ، فَذَکَرَہَا فِی السَّفَرِ صَلَّی صَلاَۃَ الْحَضَرِ، وَإِذَا نَسِیَ صَلاَۃً فِی السَّفَرِ فَذَکَرَہَا فِی الْحَضَرِ، صَلَّی صَلاَۃَ السَّفَرِ۔","","Musannaf Ibn Abi Shaybah 4811","","","كتاب الصلوات"
"4812","(۴۸۱۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : یُصَلِّی الصَّلاَۃ الَّتِی نَسِیَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4812","","","كتاب الصلوات"
"4813","(۴۸۱۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْخَالِقِ ، عَنْ حَمَّادٍ ، قَالَ : إذَا نَسِیَ صَلاَۃً فِی الْحَضَرِ فَذَکَرَہَا فِی السَّفَرِ صَلَّی أَرْبَعًا ، وَإِذَا نَسِیَ صَلاَۃً فِی السَّفَرِ فَذَکَرَہَا فِی الْحَضَرِ ، صَلَّی صَلاَۃَ سَفَرٍ۔","","Musannaf Ibn Abi Shaybah 4813","","","كتاب الصلوات"
"4814","(۴۸۱۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو الزُّبَیْرِ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ؛ أَنَّ الْمُشْرِکِینَ شَغَلُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْخَنْدَقِ عَنْ أَرْبَعِ صَلَوَاتٍ ، حَتَّی ذَہَبَ مِنَ اللَّیْلِ مَا شَائَ اللَّہُ ، قَالَ : فَأَمَرَ بِلاَلاً فَأَذَّنَ وَأَقَامَ ، فَصَلَّی الظُّہْرَ ، ثُمَّ أَقَامَ فَصَلَّی الْعَصْرَ ، ثُمَّ أَقَامَ فَصَلَّی الْمَغْرِبَ ، ثُمَّ أَقَامَ فَصَلَّی الْعِشَائَ۔ (ترمذی ۱۷۹۔ احمد ۱/۳۷۵)","","Musannaf Ibn Abi Shaybah 4814","","","كتاب الصلوات"
"4815","(۴۸۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، قَالَ : حُبِسْنَا یَوْمَ الْخَنْدَقِ عَنِ الظُّہْرِ وَالْعَصْرِ وَالْمَغْرِبِ وَالْعِشَائِ ، حَتَّی کُفِینَا ذَلِکَ ، وَذَلِکَ قولہ تعالی : {وَکَفَی اللَّہُ الْمُؤْمِنِینَ الْقِتَالَ وَکَانَ اللَّہُ قَوِیًّا عَزِیزًا} فَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَ بِلاَلاً ، فَأَقَامَ الصَّلاَۃ ، ثُمَّ صَلَّی الظُّہْرَ کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، ثُمَّ أَقَامَ الْعَصْرَ ، فَصَلَّی الْعَصْرَ کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، ثُمَّ أَقَامَ الْمَغْرِبَ ، فَصَلَّی الْمَغْرِبَ کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، ثُمَّ أَقَامَ الْعِشَائَ فَصَلاَّہَا کَمَا کَانَ یُصَلِّیہَا قَبْلَ ذَلِکَ ، قَبْلَ أَنْ یَنْزِلَ : {فَإِنْ خِفْتُمْ فَرِجَالاً أَوْ رُکْبَانًا}۔ (احمد ۳/۶۸۔ دارمی ۱۵۲۴)","Sahih","Musannaf Ibn Abi Shaybah 4815","","","كتاب الصلوات"
"4816","(۴۸۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عُمَرُ : مَنْ فَاتَہُ شَیْئٌ مِنْ قِرَائَتِہِ بِاللَّیْلِ ، فَصَلَّی مَا بَیْنَہُ وَبَیْنَ الظُّہْرِ ، فَکَأَنَّمَا صَلَّی بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 4816","","","كتاب الصلوات"
"4817","(۴۸۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدَۃَ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ؛ أَنَّ رَجُلاً اسْتَأْذَنَ عَلَی عُمَرَ بِالْہَاجِرَۃِ ، فَحَجَبَہُ طَوِیلاً ، ثُمَّ أَذِنَ لَہُ ، فَقَالَ : إنِّی کُنْتُ نِمْتُ عَنْ حِزْبِیْ ، فَکُنْت أَقْضِیہِ۔","","Musannaf Ibn Abi Shaybah 4817","","","كتاب الصلوات"
"4818","(۴۸۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ أَبِی عُبَیْدِ اللہِ مَوْلَی ابْنِ عَبَّاسٍ ، قَالَ : قَالَ عَلِیٌّ : مَنْ فَاتَہُ شَیْئٌ مِنْ حِزْبِہِ ، فَصَلاَّہُ ارْتِفَاعَ النَّہَارِ ، فَکَأَنَّمَا صَلاَّہُ بِاللَّیْلِ۔","Majhul","Musannaf Ibn Abi Shaybah 4818","","","كتاب الصلوات"
"4819","(۴۸۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : کُنَّا نَأْتِی عَائِشَۃَ قَبْلَ صَلاَۃِ الْفَجْرِ فَأَتَیْنَاہَا ذَاتَ یَوْمٍ فَإِذَا ہِیَ تُصَلِّی ، فَقَالَتْ : نِمْت عَنْ حِزْبِی فِی ہَذِہِ اللَّیْلَۃِ فَلَمْ أَکُنْ لأَدَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4819","","","كتاب الصلوات"
"4820","(۴۸۲۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : مَنْ فَاتَہُ جُزْؤُہُ مِنَ اللَّیْلِ فَقَضَاہُ قَبْلَ أَنْ تَزُولَ الشَّمْسُ ، فَقَدْ أَدْرَکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4820","","","كتاب الصلوات"
"4821","(۴۸۲۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالاَ : ہُوَ کَلاَمٌ ، یَعْنِی الْفَتْحَ عَلَی الإِمَام۔","Da'if","Musannaf Ibn Abi Shaybah 4821","","","كتاب الصلوات"
"4822","(۴۸۲۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کان یَکْرَہُ أَنْ یَفْتَحَ عَلَی الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 4822","","","كتاب الصلوات"
"4823","(۴۸۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَیْمُونِ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ؛ فِی تَلْقِینِ الإِمَام : إنَّمَا ہُوَ کَلاَمٌ یُلْقِیہِ إلَیْہِ ، قَالَ : وَقَالَ إبْرَاہِیمُ : مَا أُبَالِی لَقَّنتُۃٌ ، أَوْ قُلْتُ : یَا کَبِیرۃ۔","","Musannaf Ibn Abi Shaybah 4823","","","كتاب الصلوات"
"4824","(۴۸۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ سَلَمِ بْنِ عَطِیَّۃَ ؛ أَنَّ رَجُلاً فَتَحَ عَلَی إمَامِ شُرَیْحٍ وَہُوَ فِی الصَّلاَۃ، فَلَمَّا انْصَرَفَ ، قَالَ لَہُ : اقْضِ صَلاَتَک۔","","Musannaf Ibn Abi Shaybah 4824","","","كتاب الصلوات"
"4825","(۴۸۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ کَرِہَ أَنْ یُلَقَّنَ الْقَارِیئُ۔","","Musannaf Ibn Abi Shaybah 4825","","","كتاب الصلوات"
"4826","(۴۸۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : مَنْ فَتَحَ عَلَی الإِمَام فَقَدْ تَکَلَّمَ۔","","Musannaf Ibn Abi Shaybah 4826","","","كتاب الصلوات"
"4827","(۴۸۲۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الْفَتْحَ عَلَی الإِمَام۔","Da'if","Musannaf Ibn Abi Shaybah 4827","","","كتاب الصلوات"
"4828","(۴۸۲۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبِیْدَۃَ بْنِ رَبِیعَۃَ ، قَالَ : أَتَیْتُ الْمَقَامَ فَإِذَا رَجُلٌ حَسَنُ الثِّیَابِ طَیِّبُ الرِّیحِ یُصَلِّی فَقَرَأَ ، وَرَجُلٌ إلَی جَنْبِہِ یَفْتَحُ عَلَیْہِ ، فَقُلْتُ : مَنْ ہَذَا ؟ قَالُوا: عُثْمَانَ۔","Majhul","Musannaf Ibn Abi Shaybah 4828","","","كتاب الصلوات"
"4829","(۴۸۲۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ، قَالَ: إذَا اسْتَطْعَمَک الإِمَام فَأَطْعِمْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4829","","","كتاب الصلوات"
"4830","(۴۸۳۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ مَرْوَانُ یُلَقِّنُ فِی الصَّلاَۃ وَأَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَدِینَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 4830","","","كتاب الصلوات"
"4831","(۴۸۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِتَلْقِینِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 4831","","","كتاب الصلوات"
"4832","(۴۸۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عن ہشام ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : لُـقِّنَ ??لإِمَام۔","","Musannaf Ibn Abi Shaybah 4832","","","كتاب الصلوات"
"4833","(۴۸۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ ابْنَ مُغَفَّلٍ أَمَرَ رَجُلاً یُلَقِّنُہُ إذَا تَعَایَی۔","","Musannaf Ibn Abi Shaybah 4833","","","كتاب الصلوات"
"4834","(۴۸۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُسَاوِرٍ ، قَالَ : حدَّثَنِی ہِلاَلُ بْنُ أَبِی حُمَیْدٍ ، قَالَ : کُنْتُ أَفْتَحُ عَلَی عَبْدِ اللہِ بْنِ عُکَیْمٍ إذَا تَعَایَی فِی الصَّلاَۃ ، فَقَالَ لِی یَوْمًا : أَمَا صَلَّیْتَ مَعَنَا ؟ قَالَ : فَقُلْتُ : لاَ ،قَالَ : قَدِ اسْتَنکَرْتُ ذَلِکَ ، تَرَدَّدْت الْبَارِحَۃَ فَلَمْ أَجِدْ أَحَدًا یَفْتَحُ عَلَیَّ ؟۔","","Musannaf Ibn Abi Shaybah 4834","","","كتاب الصلوات"
"4835","(۴۸۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِتَلْقِینِ الإِمَام۔","No Data Available","Musannaf Ibn Abi Shaybah 4835","","","كتاب الصلوات"
"4836","(۴۸۳۶) حَدَّثَنَا معن بْنُ عِیسَی ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ یَزِیدَ بْنَ رُومَانَ ، قَالَ : کُنْتُ أُصَلِّی إلَی جَنْبِ نَافِعِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، فَیَغْمِزُنِی فَأَفْتَحُ عَلَیْہِ وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 4836","","","كتاب الصلوات"
"4837","(۴۸۳۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ نَافِعٍ ، قَالَ : صَلَّی بِنَا ابْنُ عُمَرَ ، قَالَ : فَتَرَدَّدَ ، قَالَ : فَفَتَحْتُ عَلَیْہِ فَأَخَذَ عَنِّی۔","Da'if","Musannaf Ibn Abi Shaybah 4837","","","كتاب الصلوات"
"4838","(۴۸۳۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ ، عن أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا نُسَلِّمُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی فَیَرُدُّ عَلَیْنَا ، قَبْلَ أَنْ نَأْتِیَ أَرْضَ الْحَبَشَۃِ ، فَلَمَّا قَدِمْنَا مِنْ أَرْضِ الْحَبَشَۃِ سَلَّمْتُ عَلَیْہِ فَلَمْ یَرُدَّ عَلَیَّ ، فَأَخَذَنِی مَا قَرُبَ ، وَمَا بَعُدَ ، فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ : إنَّ اللَّہَ یُحْدِثُ مِنْ أَمْرِہِ مَا شَائَ ، وَقَدْ أَحْدَثَ أَنْ لاَ تَکَلَّمُوا فِی الصَّلاَۃ۔ (ابوداؤد ۹۲۱۔ احمد ۱/۳۷۷)","Hasan","Musannaf Ibn Abi Shaybah 4838","","","كتاب الصلوات"
"4839","(۴۸۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ أبی الزُّبَیْرِ ، عن جابر ، قَالَ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی حَاجَۃٍ ، فَجِئْت وَہُوَ یُصَلِّی ، فَسَلَّمْت عَلَیْہِ ، فَلاَ یَرُدُّ عَلَیَّ السَّلاَمَ ۔(ابوداؤد ۹۲۳۔ احمد ۳/۳۷۹)","Sahih","Musannaf Ibn Abi Shaybah 4839","","","كتاب الصلوات"
"4840","(۴۸۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : السَّلاَمُ عَلَی الْمُصَلِّی عَجْز۔","","Musannaf Ibn Abi Shaybah 4840","","","كتاب الصلوات"
"4841","(۴۸۴۱) حَدَّثَنَا حَفْصٌ ، وَوَکِیعٌ ، عَنْ زَکَرِیَّا ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : أَدْخُلُ عَلَی قَوْمٍ وَہُمْ یُصَلُّونَ فُرَادَی ، أَأُسَلِّمُ عَلَیْہِمْ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 4841","","","كتاب الصلوات"
"4842","(۴۸۴۲) حَدَّثَنَا جَرِیرٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَرُدُّ عَلَیْہِ فِی نَفْسِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4842","","","كتاب الصلوات"
"4843","(۴۸۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ رَجُلٍ مِنْ بَنِی عَامِرٍ ، قَالَ : قُمْتُ إلَی جَنْبِ أَبِی ذَرٍّ وَہُوَ یُصَلِّی ، فَسَلَّمْت عَلَیْہِ ، فَمَا رَدَّ عَلَیَّ۔","Majhul","Musannaf Ibn Abi Shaybah 4843","","","كتاب الصلوات"
"4844","(۴۸۴۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ یَعْقُوبَ بن عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ بُسر بْنِ سَعِیدٍ ، قَالَ : سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ وَہُوَ یُصَلِّی ، فَأَشَارَ إلَیْہِ بِیَدِہِ ، کَأَنَّہُ یَنْہَاہُ۔","","Musannaf Ibn Abi Shaybah 4844","","","كتاب الصلوات"
"4845","(۴۸۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا نُسَلِّمُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی الصَّلاَۃ قَبْلَ أَنْ نَخْرُجَ إلَی النَّجَاشِیِّ فَیَرُدُّ عَلَیْنَا ، فَلَمَّا رَجَعْنَا مِنْ عِنْدِ النَّجَاشِیِّ سَلَّمْت عَلَیْہِ فَلَمْ یَرُدَّ ، وَقَالَ : إنَّ فِی الصَّلاَۃ شُغْلاً۔ (بخاری ۱۱۹۹۔ ابوداؤد ۹۲۰)","Sahih","Musannaf Ibn Abi Shaybah 4845","","","كتاب الصلوات"
"4846","(۴۸۴۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَأَلْتُ صُہَیْبًا ، کَیْفَ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَصْنَعُ حَیْثُ کَانَ یُسَلَّمُ عَلَیْہِ ؟ قَالَ : کَانَ یُشِیرُ بِیَدِہِ۔ (ابوداؤد ۹۲۲۔ ترمذی ۳۶۷)","Sahih","Musannaf Ibn Abi Shaybah 4846","","","كتاب الصلوات"
"4847","(۴۸۴۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، قَالَ : سَلَّمْتُ عَلَی ابْنِ عَبَّاسٍ وَہُوَ یُصَلِّی فِی وَجْہِ الْکَعْبَۃِ ، فَأَخَذَ بِیَدِی۔","Sahih","Musannaf Ibn Abi Shaybah 4847","","","كتاب الصلوات"
"4848","(۴۸۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : سَلَّمْتُ عَلَی ابْنِ عَبَّاسٍ وَہُوَ فِی الصَّلاَۃ ،فَلَمْ یَرُدَّ عَلَیَّ ، وَبَسَطَ یَدَہُ إلَیَّ وَصَافَحَنِی۔","Da'if","Musannaf Ibn Abi Shaybah 4848","","","كتاب الصلوات"
"4849","(۴۸۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا سُلِّمَ عَلَیْک وَأَنْتَ فِی الصَّلاَۃ ، فَرُدَّ۔","Majhul","Musannaf Ibn Abi Shaybah 4849","","","كتاب الصلوات"
"4850","(۴۸۵۰) حَدَّثَنَا حَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : مَا کُنْتُ لِأُسَلِّمُ عَلَی رَجُلٍ وَہُوَ یُصَلِّی ، زَادَ أَبُو مُعَاوِیَۃَ : وَلَوْ سَلَّمَ عَلَیَّ لَرَدَدْت عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 4850","","","كتاب الصلوات"
"4851","(۴۸۵۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا سُلِّمَ علی أَحَدِکُمْ وَہُوَ فِی الصَّلاَۃ فَلْیُشِرْ بِیَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4851","","","كتاب الصلوات"
"4852","(۴۸۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ سُئِلَ عَنِ الرَّجُلِ یُسَلَّمُ عَلَیْہِ فِی الصَّلاَۃ ؟ قَالَ : یَرُدُّ بِشِقِّ رَأْسِہِ الأَیْمَنِ۔","","Musannaf Ibn Abi Shaybah 4852","","","كتاب الصلوات"
"4853","(۴۸۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُسَلَّمُ عَلَیْہِ فِی الصَّلاَۃ ، قَالَ : یَرُدُّ عَلَیْہِ السَّلاَمَ إذَا انْصَرَفَ ، فَإِذَا ذَہَبَ اتَّبَعَہُ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 4853","","","كتاب الصلوات"
"4854","(۴۸۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لَمَّا قَدِمَ عَبْدُ اللہِ مِنَ الْحَبَشَۃِ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی ، فَسَلَّمَ عَلَیْہِ فَأَوْمَأَ ، وَأَشَارَ بِرَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 4854","","","كتاب الصلوات"
"4855","(۴۸۵۵) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ؛ أَنَّ رَجُلاً سَلَّمَ عَلَی ابْنِ عَبَّاسٍ وَہُوَ فِی الصَّلاَۃ ، فَأَخَذَ بِیَدِہِ فَصَافَحَہُ ، وَغَمَزَ یَدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4855","","","كتاب الصلوات"
"4856","(۴۸۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : لاَ یَرُدُّ السَّلاَمَ حَتَّی یُصَلِّیَ ، فَإِنْ کَانَ قَرِیبًا رَدَّ عَلَیْہِ ، وَإِنْ کَانَ بَعِیدًا تبِعَہُ بِالسَّلاَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4856","","","كتاب الصلوات"
"4857","(۴۸۵۷) حَدَّثَنَا یُونُسُ ، عَنْ مُحَمَّدٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ ، قَالَ : حدَّثَنَا عَاصِمٌ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : سُئِلَ عَنِ الرَّجُلِ یُسَلَّمُ عَلَیْہِ وَہُوَ فِی الصَّلاَۃ ؟ قَالَ : إذَا قَضَی الصَّلاَۃ أَتْبَعَہُ بِالسَّلاَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4857","","","كتاب الصلوات"
"4858","(۴۸۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، عَنْ عَمَّارٍ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی فَسَلَّمْت عَلَیْہِ ، قَالَ : فَرَدَّ عَلَیَّ السَّلاَمَ۔ (احمد ۴/۲۶۳۔ ابو یعلی ۱۶۳۴)","Sahih","Musannaf Ibn Abi Shaybah 4858","","","كتاب الصلوات"
"4859","(۴۸۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، عَنْ عَمِّہِ ، عَنْ مَوْلًی لأَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّہُ کَانَ مَعَ أَبِی سَعِیدٍ الْخُدْرِیِّ وَہُوَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسٌ ، قَالَ : فَدَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ فَرَأَی رَجُلاً جَالِسًا وَسَطَ الْمَسْجِدِ مُشَبِّکًا أَصَابِعَہُ یُحَدِّثُ نَفْسَہُ ، قَالَ : فَأَوْمَأَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمْ یَفْطِنْ ، فَالْتَفَتَ إلَی أَبِی سَعِیدٍ الْخُدْرِیِّ ، فَقَالَ : إذَا صَلَّی أَحَدُکُمْ فَلاَ یُشَبِّکَنَّ بَیْنَ أَصَابِعِہِ ، فَإِنَّ التَّشْبِیکَ مِنَ الشَّیْطَانِ ، وَإِنَّ أَحَدَکُمْ لاَ یَزَالُ فِی صَلاَۃٍ مَا دَامَ فِی الْمَسْجِدِ حَتَّی یَخْرُجَ مِنْہُ۔ (احمد ۳/۵۴)","Majhul","Musannaf Ibn Abi Shaybah 4859","","","كتاب الصلوات"
"4860","(۴۸۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ أَحَدُکُمْ فِی الْمَسْجِدِ ، فَلاَ یُشَبِّکَنَّ أَصَابِعَہُ۔","","Musannaf Ibn Abi Shaybah 4860","","","كتاب الصلوات"
"4861","(۴۸۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ سَعْدِ بْنِ إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ أَبِی سعید ، عن أبی ثُمَامَۃَ الْقَمَّاحِ ، قَالَ: لَقِیت کَعْبًا وَأَنَا بِالْبَلاَطِ قَدْ أَدْخَلْت بَعْضَ أَصَابِعِی فِی بَعْضٍ ، فَضَرَبَ یَدِی ضَرْبًا شَدِیدًا ، وَقَالَ : نُہِینَا أَنْ نُشَبِّکَ بَیْنَ أَصَابِعِنا فِی الصَّلاَۃ ، قَالَ : قُلْتُ لَہُ : یَرْحَمُک اللَّہُ تَرَانِی فِی صَلاَۃٍ ؟ فَقَالَ : مَنْ تَوَضَّأَ فَعَمَدَ إلَی الْمَسْجِدِ ، فَہُوَ فِی صَلاَۃٍ۔ (ابوداؤد ۵۶۳۔ احمد ۴/۲۴۱)","Majhul","Musannaf Ibn Abi Shaybah 4861","","","كتاب الصلوات"
"4862","(۴۸۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ النُّعْمَانِ بْنُ أَبِی عَیَّاشٍ ، قَالَ : کَانُوا یَنْہَوْنَ عَنْ تَشْبِیکِ الأَصَابِعِ ، یَعْنِی فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4862","","","كتاب الصلوات"
"4863","(۴۸۶۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یُشَبِّکَ أَصَابِعَہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4863","","","كتاب الصلوات"
"4864","(۴۸۶۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ خَلِیفَۃَ بْنِ غَالِبٍ ، عَنْ نَافِعٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُشَبِّکُ بَیْنَ أَصَابِعِہِ فِی الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 4864","","","كتاب الصلوات"
"4865","(۴۸۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَصْحَابُنَا ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُشَبِّکُ بَیْنَ أَصَابِعِہِ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4865","","","كتاب الصلوات"
"4866","(۴۸۶۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ یُشَبِّکُ بَیْنَ أَصَابِعِہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4866","","","كتاب الصلوات"
"4867","(۴۸۶۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَرَادَ أَنْ یَقُولَ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، قَالَ : یَسْتَغْفِرُ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4867","","","كتاب الصلوات"
"4868","(۴۸۶۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَرَادَ أَنْ یَقُولَ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، فَلاَ سَہْوَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 4868","","","كتاب الصلوات"
"4869","(۴۸۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَغَیْرِہِ ؛ فِی رَجُلٍ أَرَادَ أَنْ یَقُولَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، قَالُوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 4869","","","كتاب الصلوات"
"4870","(۴۸۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، وَعَامِرٍ ، وَعَطَائٍ ، قَالُوا : فِی رَجُلٍ أَرَادَ أَنْ یَقُولَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَالَ : اللَّہُ أَکْبَرُ ، قَالُوا : لَیْسَ عَلَیْہِ سَہْوٌ۔","","Musannaf Ibn Abi Shaybah 4870","","","كتاب الصلوات"
"4871","(۴۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عْن رَجُلٍ نَسِیَ تَکْبِیرَۃً ؟ قَالَ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4871","","","كتاب الصلوات"
"4872","(۴۸۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی الْمَغْرِبَ أَرْبَعًا ، قَالَ : یَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","","Musannaf Ibn Abi Shaybah 4872","","","كتاب الصلوات"
"4873","(۴۸۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُعِیدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4873","","","كتاب الصلوات"
"4874","(۴۸۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : إذَا لَمْ یَجْلِسْ فِی الثَّالِثَۃِ أَعَادَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4874","","","كتاب الصلوات"
"4875","(۴۸۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائِ بْنِ یَسَارٍ ، سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : إذَا أُقِیمَتِ الصَّلاَۃ فَلاَ صَلاَۃَ إِلاَّ الْمَکْتُوبَۃُ۔ (مسلم ۴۹۳۔ ابوداؤد ۱۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 4875","","","كتاب الصلوات"
"4876","(۴۸۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرٍو ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا أُقِیمَتِ الصَّلاَۃ فَلاَ صَلاَۃَ إِلاَّ الْمَکْتُوبَۃُ۔ (مسلم ۴۹۳۔ ابوداؤد ۱۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 4876","","","كتاب الصلوات"
"4877","(۴۸۷۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ رَأَی رَجُلاً یُصَلِّی عِنْدَ إقَامَۃِ الْعَصْرِ ، قَالَ : یَسُرُّک أَنْ یُقَالَ : صَلَّی ابْنُ فُلاَنَۃَ سِتًّا ، قَالَ : فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ ، فَقَالَ : کَانَتْ تُکْرَہُ الصَّلاَۃ مَعَ الإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 4877","","","كتاب الصلوات"
"4878","(۴۸۷۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ الصَّلاَۃ إذَا أَخَذَ الْمُؤَذِّنُ فِی الإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 4878","","","كتاب الصلوات"
"4879","(۴۸۷۹) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : إذَا کَبَّرَ الْمُؤَذِّنُ بِالإِقَامَۃِ فَلاَ تُصَلِّیَنَّ شَیْئًا حَتَّی تُصَلِّیَ الْمَکْتُوبَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4879","","","كتاب الصلوات"
"4880","(۴۸۸۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ ابْنِ أَبِی فَرْوَۃَ ، عَنْ أَبِی بَکْرِ بْنِ الْمُنْکَدِرِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُمَرَ رَأَی رَجُلاً یُصَلِّی رَکْعَتَیْنِ وَالْمُؤَذِّنُ یُقِیمُ فَانْتَہَرَہُ ، وَقَالَ : لاَ صَلاَۃَ وَالْمُؤَذِّنُ یُقِیمُ إِلاَّ الصَّلاَۃ الَّتِی تُقَامُ لَہَا الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 4880","","","كتاب الصلوات"
"4881","(۴۸۸۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ ، قَالَ : إذَا کُنْتَ فِی الْمَسْجِدِ فَأُقِیمَتِ الصَّلاَۃ فَلاَ تَرْکَعْ۔","","Musannaf Ibn Abi Shaybah 4881","","","كتاب الصلوات"
"4882","(۴۸۸۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ قَالَ فِی الرَّجُلِ یُصَلِّی فِی الْمَسْجِدِ رَکْعَتَیْنِ مِنَ الْفَرِیضَۃِ وَحْدَہُ ، ثُمَّ تُقَامُ الصَّلاَۃ ، قَالَ : یُصَلِّی مَعَہُمْ وَلاَ یَعْتَدُّ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4882","","","كتاب الصلوات"
"4883","(۴۸۸۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا سَیَّارٌ ، وَالْمُغِیرَۃُ ، عَنِ الشَّعْبِیِّ (ح) وَأَخْبَرَنَا یُونُسُ ، وَمَنْصُورٌ ، عَنِ الْحَسَنِ (ح) وَحَجَّاجٌ ، عَنْ عَطَائٍ (ح) وَشُعْبَۃُ ، عَنِ الْحَکَمِ ، قَالُوا : یُسَلِّمُ ثُمَّ یَدْخُلُ مَعَ الإِمَامِ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 4883","","","كتاب الصلوات"
"4884","(۴۸۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : أَظُنُّہُ ، عَنْ عُتْبَۃَ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : یَقْطَعُہا ثُمَّ یَدْخُلُ مَعَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4884","","","كتاب الصلوات"
"4885","(۴۸۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : سَمِعْتُ حَمَّادًا یَقُولُ : أَحَبُّ إلَیَّ أَنْ یَتَکَلَّمَ وَیَدْخُلَ مَعَہُمْ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4885","","","كتاب الصلوات"
"4886","(۴۸۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : إذَا دَخَلَ الرَّجُلُ فِی الْفَرِیضَۃِ ، ثُمَّ فَجِئَتْہُ الإِقَامَۃُ قَطَعَہَا ، وَکَانَتْ لَہُ نَافِلَۃً وَدَخَلَ فِی الْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 4886","","","كتاب الصلوات"
"4887","(۴۸۸۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَأْتِی الْمَسْجِدَ فَیری أَنَّہُمْ صَلَّوْا ، فَافْتَرَضَ الصَّلاَۃ فَصَلَّی رَکْعَتَیْنِ مِنَ الْمَکْتُوبَۃِ فَأُقِیمَتِ الصَّلاَۃ ، قَالَ : یَدْخُلُ مَعَ الإِمَامِ فِی صَلاَتِہِ ، فَإِذَا صَلَّی مَعَ الإِمَامِ رَکْعَتَیْنِ ، ثُمَّ یُسَلِّم ، ثُمَّ یَجْعَلُ الرَّکْعَتَیْنِ الأُخْرَیَیْنِ مَعَ الإِمَامِ تَطَوُّعًا۔","","Musannaf Ibn Abi Shaybah 4887","","","كتاب الصلوات"
"4888","(۴۸۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، أَنَّہُ قَالَ : کَمَا قَالَ إبْرَاہِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4888","","","كتاب الصلوات"
"4889","(۴۸۸۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا کَانَ الرَّجُلُ قَائِمًا یُصَلِّی فَسَمِع الإِقَامَۃَ فَلْیَقْطَعْ ۔ وَقَالَ إبْرَاہِیمُ : یُضِیفُ إلَیْہَا أُخْرَی وَلاَ یَقْطَعُ۔","","Musannaf Ibn Abi Shaybah 4889","","","كتاب الصلوات"
"4890","(۴۸۹۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ : إِنْ بَقِیَ عَلَیْک مِنْ صَلاَتِکَ شَیْئٌ فَأَتْمِمْہُ ۔ وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ یَقُولُ : اقْطَعْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 4890","","","كتاب الصلوات"
"4891","(۴۸۹۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا افْتَتَحْت الصَّلاَۃ تَطَوُّعًا وَأُقِیمَتِ الصَّلاَۃ فَأَتِمَّ۔","","Musannaf Ibn Abi Shaybah 4891","","","كتاب الصلوات"
"4892","(۴۸۹۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا أَبُو إِسْحَاقَ ، قَالَ : کُنْتُ إلَی جَنْبِ عَبْدِ اللہِ بْنِ معقل ، وَہُوَ یُصَلِّی وَیَقْرَأُ فِی سُورَۃِ النُّورِ ، فَأَقَامَ الْمُؤَذِّنُ فَرَکَعَ وَسَجَدَ ، وَجَلَسَ فَتَشَہَّدَ ، ثُمَّ قَامَ مَعَ الإِمَامِ فَأَخَذَ مِنْ حَیْثُ انْتَہَی۔","","Musannaf Ibn Abi Shaybah 4892","","","كتاب الصلوات"
"4893","(۴۸۹۳) حَدَّثَنَا ابْنُ آدَمَ ، عَنْ إسْرَائِیلَ ، عَنْ بَیَانَ ، قَالَ : کَانَ قَیْسُ بْنُ أَبِی حَازِمٍ یَؤُمَّنَا ، فَأَقَامَ الْمُؤَذِّنُ الصَّلاَۃ وَقَدْ صَلَّی رَکْعَۃً ، قَالَ : فَتَرَکَہَا ، ثُمَّ تَقَدَّمَ فَصَلَّی بِنَا۔","","Musannaf Ibn Abi Shaybah 4893","","","كتاب الصلوات"
"4894","(۴۸۹۴) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : إِنْ کَبَّرْت بِالصَّلاَۃ تَطَوُّعًا قَبْلَ أَنْ یُکَبِّرَ بِالإِقَامَۃِ، فَصَلِّ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 4894","","","كتاب الصلوات"
"4895","(۴۸۹۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ ، قَالَ : إذَا کُنْتَ فِی الْمَسْجِدِ فَأُقِیمَتِ الصَّلاَۃ فَلاَ تَرْکَعْ ، إِلاَّ أَنْ تَکُونَ عَلَی وِتْرٍ فَتَشْفَع۔","","Musannaf Ibn Abi Shaybah 4895","","","كتاب الصلوات"
"4896","(۴۸۹۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : کَتَبْت إلَی عُمَرَ مِنْ نَجْرَانَ : لَمْ یَجِدُوا مَکَانًا أَنْظَفَ ، وَلاَ أَجْوَدَ مِنْ بَیْعَۃٍ ؟ فَکَتَبَ : انْضَحُوہَا بِمَائٍ وَسِدْرٍ وَصَلُّوا فِیہَا۔","","Musannaf Ibn Abi Shaybah 4896","","","كتاب الصلوات"
"4897","(۴۸۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَعَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُمْ قَالُوا : لاَ بَأْسَ بِالصَّلاَۃ فِی الْبِیَعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4897","","","كتاب الصلوات"
"4898","(۴۸۹۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الصَّلاَۃ فِی الْکَنَائِسِ وَالْبِیَعِ ؟ فَلَمْ یَرَ بِہَا بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 4898","","","كتاب الصلوات"
"4899","(۴۸۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ (ح) وَعَن جَابِرٍ ، عَنِ الشَّعْبِیِّ ، قَالاَ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْکَنِیسَۃِ وَالْبِیعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4899","","","كتاب الصلوات"
"4900","(۴۹۰۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْکَنِیسَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4900","","","كتاب الصلوات"
"4901","(۴۹۰۱) حَدَّثَنَا مُحَمَّدُ بْنِ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَہُ ، وَأَنَّ مُحَمَّدًا لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4901","","","كتاب الصلوات"
"4902","(۴۹۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خُصَیْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ فِی الْکَنِیسَۃِ إذَا کَانَ فِیہَا تَصَاوِیرُ۔","Da'if","Musannaf Ibn Abi Shaybah 4902","","","كتاب الصلوات"
"4903","(۴۹۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ بْنِ أَبِی ہِنْدٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَؤُمُّ النَّاسَ فَوْقَ کَنِیسَۃٍ ، وَالنَّاسُ أَسْفَلُ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4903","","","كتاب الصلوات"
"4904","(۴۹۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ رَافِعٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَؤُمُّ النَّاسَ فِی کَنِیسَۃٍ بِالشَّامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4904","","","كتاب الصلوات"
"4905","(۴۹۰۵) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ طَلْقِ بْنِ عَلِیٍّ ، قَالَ : خَرَجْنَا وَفْدًا إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْنَاہُ أَنَّ بِأَرْضِنَا بِیَعَۃً لَنَا ، فَاسْتَوْہَبْنَاہُ فَضْلَ طَہُورِہِ ، فَدَعَا بِمَائٍ فَتَوَضَّأَ ثُمَّ تَمَضْمَضَ ، ثُمَّ جَعَلَہُ لَنَا فِی إدَاوَۃٍ ، فَقَالَ : اخْرُجُوا بِہِ مَعَکُمْ ، فَإِذَا قَدِمْتُمْ بَلَدَکُمْ فَاکْسِرُوا بِیَعَتَکُمْ ، وَانْضَحُوا مَکَانَہَا بِالْمَائِ ، وَاتَّخِذُوہَا مَسْجِدًا۔ (احمد ۴/۲۳۔ ابن حبان ۱۶۰۲)","Hasan","Musannaf Ibn Abi Shaybah 4905","","","كتاب الصلوات"
"4906","(۴۹۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو فَضَالَۃَ ، قَالَ : حَدَّثَنَا أَزْہَرُ الحَرَازی ؛ أَنَّ أَبَا مُوسَی صَلَّی فِی کَنِیسَۃٍ بِدِمَشْقَ ، یُقَالُ لَہَا : کَنِیسَۃُ یُحَنَّا۔","Da'if","Musannaf Ibn Abi Shaybah 4906","","","كتاب الصلوات"
"4907","(۴۹۰۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَعْتَمِدَ الرَّجُلُ عَلَی الْحَائِطِ فِی صَلاَۃ الْمَکْتُوبَۃِ ، إِلاَّ مِنْ عِلَّۃٍ ، وَلَمْ یَرَ بِہِ فِی التَّطَوُّعِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4907","","","كتاب الصلوات"
"4908","(۴۹۰۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَسَانَدَ الرَّجُلُ عَلَی الْحَائِطِ فِی الصَّلاَۃ ، وَکَانَ یَکْرَہُ رَفْعَ رِجْلَیْہِ إِلاَّ مِنْ عِلَّۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 4908","","","كتاب الصلوات"
"4909","(۴۹۰۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَرْفَعَ إحْدَی رِجْلَیْہِ عَلَی الأُخْرَی فِی الصَّلاَۃ ، وَیُسند إلَی جِدَارٍ إِلاَّ مِنْ عِلَّۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 4909","","","كتاب الصلوات"
"4910","(۴۹۱۰) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یَنْقُصُ مِنْ أَجْرِہِ بِقَدْرِ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 4910","","","كتاب الصلوات"
"4911","(۴۹۱۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یُصَلِّی فَیَتَوَکَّأُ عَلَی الْحَائِطِ ، قَالَ : یَنْقُصُ مِنْ صَلاَتِہِ بِقَدْرِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 4911","","","كتاب الصلوات"
"4912","(۴۹۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَعْتَمِدَ عَلَی الْحَائِطِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4912","","","كتاب الصلوات"
"4913","(۴۹۱۳) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَعْتَمِدَ الرَّجُلُ عَلَی شَیْئٍ فِی الْفَرِیضَۃِ إِلاَّ مِنْ عِلَّۃٍ ، وَکَانَ لاَ یَرَی بِہِ بَأْسًا فِی التَّطَوُّعِ ۔ وَکَانَ ابْنُ سِیرِینَ یَکْرَہُ فِی الْفَرِیضَۃِ وَالتَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 4913","","","كتاب الصلوات"
"4914","(۴۹۱۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الْمُطْعِمِ بْنِ الْمِقْدَامِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا خَلَفَ عَبْدٌ عَلَی أَہْلِہِ أَفْضَلَ مِنْ رَکْعَتَیْنِ یَرْکَعُہُمَا عِنْدَہُمْ حِینَ یُرِیدُ سَفَرًا۔","Hasan","Musannaf Ibn Abi Shaybah 4914","","","كتاب الصلوات"
"4915","(۴۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا خَرَجْت فَصَلِّ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4915","","","كتاب الصلوات"
"4916","(۴۹۱۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَخْرُجَ دَخَلَ الْمَسْجِدَ فَصَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 4916","","","كتاب الصلوات"
"4917","(۴۹۱۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ الْحَارِثَ بْنَ أَبِی رَبِیعَۃَ صَلَّی حِینَ أَرَادَ أَنْ یَخْرُجَ إلَی بَاجُمَیْرا فِی الْحُجْرَۃِ ضُحًی رَکْعَتَیْنِ ، وَصَلَّی مَعَہُ نَفَرٌ مِنْہُمَ الأَسْوَدُ بْنُ یَزِیدَ۔","","Musannaf Ibn Abi Shaybah 4917","","","كتاب الصلوات"
"4918","(۴۹۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ مُعَاذِ بْنِ عَبْدِ اللہِ بْنِ خبیب ، عَنْ جَابِرٍ ، قَالَ : لَمَّا قَدِمْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِی : یَا جَابِرُ ، ہَلْ صَلَّیْت ؟ قُلْتُ : لاَ ، قَالَ : فَصَلِّ رَکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 4918","","","كتاب الصلوات"
"4919","(۴۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ کَامِلٍ أَبِی الْعَلاَئِ ، عَنْ أَبِی صَالِحٍ ؛ أَنَّ عُثْمَانَ کَانَ إذَا قَدِمَ مِنْ سَفَرٍ صَلَّی رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4919","","","كتاب الصلوات"
"4920","(۴۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا قَدِمْت فَصَلِّ رَکْعَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 4920","","","كتاب الصلوات"
"4921","(۴۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ مُقَاتِلِ بْنِ بَشِیرٍ الْعِجْلِیّ ، عَنْ رَجُلٍ یُقَالُ لَہُ : مُوسَی ؛ أَنَّ ابْنَ عَبَّاسٍ قَدِمَ مِنْ سَفَرٍ ، فَصَلَّی فِی بَیْتِہِ رَکْعَتَیْنِ عَلَی طِنْفِسَۃٍ۔","Majhul","Musannaf Ibn Abi Shaybah 4921","","","كتاب الصلوات"
"4922","(۴۹۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَقْدَمُ مِنْ سَفَرٍ إِلاَّ نَہَارًا فِی الضُّحَی ، فَإِذَا قَدِمَ بَدَأَ بِالْمَسْجِدِ فَصَلَّی رَکْعَتَیْنِ۔ (بخاری ۳۰۸۸۔ مسلم ۴۹۶)","Sahih","Musannaf Ibn Abi Shaybah 4922","","","كتاب الصلوات"
"4923","(۴۹۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : کَانَ النَّبِیُّ علیہ الصَّلاَۃ والسلام فِی سَفَرٍ ، فَعَرَّسَ بِأَصْحَابِہِ ، فَلَمْ یُوقِظْہُمْ مَعَ تَعْرِیسِہِمْ إِلاَّ الشَّمْسُ ، فَقَامَ فَأَمَرَ الْمُؤَذِّنَ ، فأذن وَأَقَامَ ، ثُمَّ صَلَّی ، فَقَالَ مَسْرُوقٌ : مَا أُحِبُّ أَنَّ لَنَا الدُّنْیَا ، وَمَا فِیہَا بِصَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ طُلُوعِ الشَّمْسِ۔","Da'if","Musannaf Ibn Abi Shaybah 4923","","","كتاب الصلوات"
"4924","(۴۹۲۴) حَدَّثَنَا عَبیدۃ بْنُ حُمَیْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ مَسْرُوقٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔ (احمد ۱/۲۵۹۔ ابو یعلی ۲۳۷۵)","Da'if","Musannaf Ibn Abi Shaybah 4924","","","كتاب الصلوات"
"4925","(۴۹۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عَطَائِ بْنِ یَسَارٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَکْعَتَیِ الْفَجْرِ بَعْدَ مَا جَازَ الْوَادِیَ ، ثُمَّ أَمَرَ بِلاَلاً فَأَذَّنَ وَأَقَامَ ، ثُمَّ صَلَّی الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 4925","","","كتاب الصلوات"
"4926","(۴۹۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : یُجْزِئُ الرَّجُلَ أَنْ یَقْضِیَ الصَّلواتِ بِإِقَامَۃٍ وَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 4926","","","كتاب الصلوات"
"4927","(۴۹۲۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : سَرَیْنَا ذَاتَ لَیْلَۃٍ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقُلْنَا : یَا رَسُولَ اللہِ ، لَوْ أمسستنا الأَرْضَ فَنِمْنَا وَرَعَتْ رِکَابُنَا ؟ قَالَ : فَمَنْ یَحْرُسُنَا ؟ قَالَ : قُلْتُ : أَنَا ، قَالَ : فَغَلَبَتْنِی عَیْنِی ، فَلَمْ یُوقِظْنَا إِلاَّ وَقْتَ طَلَعَتِ الشَّمْسُ ، وَلَمْ یَسْتَیْقِظْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ بِکَلاَمِنَا ، قَالَ : فَأَمَرَ بِلاَلاً فَأَذَّنَ وَأَقَامَ ، فَصَلَّی بِنَا۔ (احمد ۱/۴۵۰۔ طبرانی ۱۰۳۴۹)","","Musannaf Ibn Abi Shaybah 4927","","","كتاب الصلوات"
"4928","(۴۹۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِعَدَدِ الآیِ فِی الصَّلاَۃ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4928","","","كتاب الصلوات"
"4929","(۴۹۲۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4929","","","كتاب الصلوات"
"4930","(۴۹۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یُسیر بْنِ عَمْرٍو ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِعَدَدِ الآیِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4930","","","كتاب الصلوات"
"4931","(۴۹۳۱) حَدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ ہِشَامٍ ؛ أَنَّ أَبَاہُ کَانَ یَعُدُّ الآیَ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 4931","","","كتاب الصلوات"
"4932","(۴۹۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ یَحْیَی بْنُ وَثَّابٍ یَعُدُّ الآیَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4932","","","كتاب الصلوات"
"4933","(۴۹۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ طَاوُوسًا وَنَافِعًا یَعُدَّانِ الآیَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4933","","","كتاب الصلوات"
"4934","(۴۹۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَعُدُّ الآیَ بِشِمَالِہِ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4934","","","كتاب الصلوات"
"4935","(۴۹۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِعَدِّ الآیِ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4935","","","كتاب الصلوات"
"4936","(۴۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَعُدُّ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4936","","","كتاب الصلوات"
"4937","(۴۹۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ أَبَا عَبْدِ الرَّحْمَنِ یَعُدُّ الآیَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 4937","","","كتاب الصلوات"
"4938","(۴۹۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ ابْنَ أَبِی مُلَیْکَۃَ یَعُدُّ الآیَ فِی الصَّلاَۃ ، فَقُلْتُ لَہُ ؟ فَقَالَ : إِنَّہُ أَحْفَظُ۔","","Musannaf Ibn Abi Shaybah 4938","","","كتاب الصلوات"
"4939","(۴۹۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، قَالَ : رَأَیْتُ طَاوُوسًا وَالْمُغِیرَۃَ بْنَ حَکِیمٍ الصَّنْعَانِیَّ یَعُدَّانِ الآیَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4939","","","كتاب الصلوات"
"4940","(۴۹۴۰) حَدَّثَنَا أَبُو أَیُّوبَ الْقُریعِیُّ ، قَالَ : رَأَیْتُ عِمْرَانَ بْنَ حُدَیْرٍ یَعُدُّ الآیَ فِی الصَّلاَۃ ، وَذَکَرَ أَنَّ أَبَا مِجْلَزٍ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 4940","","","كتاب الصلوات"
"4941","(۴۹۴۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَعُدَّ الآیِ فِی الصَّلاَۃ إذَا خَافَ النِّسْیَانَ۔","","Musannaf Ibn Abi Shaybah 4941","","","كتاب الصلوات"
"4942","(۴۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَعُدُّ الآیَ فِی الْعَصْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4942","","","كتاب الصلوات"
"4943","(۴۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ بِعَدِّ الآیِ فِی الْفَرِیضَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4943","","","كتاب الصلوات"
"4944","(۴۹۴۴) حَدَّثَنَا یَحْیَی بْنُ بَشِیرٍ الْجَزَرِیُّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِعَدِّ الآیِ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 4944","","","كتاب الصلوات"
"4945","(۴۹۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعِ بْنِ عُمَرَ ، قَالَ : رَأَیْتُ ابْنَ أَبِی مُلَیْکَۃَ یَعُدُّ الآیَ فِی الصَّلاَۃ ، قَالَ : وَقَالَ یَحْیَی بْنُ عَبْدِ اللہِ بْنِ صَیْفِیٍّ : ہُوَ رَأْسُ الْعِبَادَۃِ۔","","Musannaf Ibn Abi Shaybah 4945","","","كتاب الصلوات"
"4946","(۴۹۴۶) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیُّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : سَأَلَہُ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ ، تَعُدُّ الآیَ فِی الصَّلاَۃ ؟ فَقَالَ : مَا أَفْعَلُ ، قَالَ : وَأَنَا أَیْضًا مَا أَفْعَلُ۔","","Musannaf Ibn Abi Shaybah 4946","","","كتاب الصلوات"
"4947","(۴۹۴۷) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنِ الْحَارِثِ بن عَبْدِ الرَّحْمَنِ ، قَالَ : سَأَلْتُ سُلَیْمَانَ بْنَ یَسَارٍ عَنِ النَّوْمِ فِی الْمَسْجِدِ ؟ فَقَالَ : کَیْفَ تَسْأَلُونَ عَنْ ہَذَا ، وَقَدْ کَانَ أَہْلُ الصِّفَۃِ یَنَامُونَ فِیہِ وَیُصَلُّونَ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 4947","","","كتاب الصلوات"
"4948","(۴۹۴۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یُونُسَ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَنَامُ فِی الْمَسْجِدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4948","","","كتاب الصلوات"
"4949","(۴۹۴۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لَہُ مَسْجِدٌ یُصَلِّی فِیہِ ، وَیَنَامُ فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4949","","","كتاب الصلوات"
"4950","(۴۹۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا وَنَحْنُ شَبَابٌ نَبِیتُ فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَسْجِدِ وَنَقِیلُ۔ (ترمذی ۳۲۱۔ احمد ۲/۱۲)","Sahih","Musannaf Ibn Abi Shaybah 4950","","","كتاب الصلوات"
"4951","(۴۹۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَجُلٌ لْاِبْنِ عَبَّاسٍ : إنِّی نِمْتُ فِی الْمَسْجِدِ الْحَرَامِ فَاحْتَلَمْت ، فَقَالَ : أَمَّا أَنْ تَتَّخِذَہُ مَبِیتًا ، أَوْ مَقِیلاً فَلاَ ، وَأَمَّا أَنْ تَنَامَ تَسْتَرِیحَ ، أَوْ تَنْتَظِرَ حَاجَۃً فَلاَ بَأْسَ۔","Da'if","Musannaf Ibn Abi Shaybah 4951","","","كتاب الصلوات"
"4952","(۴۹۵۲) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوس، وَمُجَاہِدٍ؛ أَنَّہُمْ کَرِہُوا النَّوْمَ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 4952","","","كتاب الصلوات"
"4953","(۴۹۵۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَتَکْرَہُ النَّوْمَ فِی الْمَسْجِدِ؟ قَالَ: بَلْ أُحِبُّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4953","","","كتاب الصلوات"
"4954","(۴۹۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : نَہَانِی مُجَاہِدٌ عَنِ النَّوْمِ فِی الْمَسَاجِدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4954","","","كتاب الصلوات"
"4955","(۴۹۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَیْمَنِ بْنِ نَابِلٍ ، قَالَ : رَآنِی سَعِیدُ بْنُ جُبَیْرٍ وَأَنَا نَائِمٌ فِی الْحِجْرِ فَأَیْقَظَنِی ، وَقَالَ : مِثْلُک یَنَامُ ہَاہُنَا ؟۔","","Musannaf Ibn Abi Shaybah 4955","","","كتاب الصلوات"
"4956","(۴۹۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ ابْنَ مَسْعُودٍ یَعُسُّ فِی الْمَسْجِدِ لَیْلاً ، فَلاَ یَدَعُ سَوَادًا إِلاَّ أَخْرَجَہُ ، إِلاَّ رَجُلاً یُصَلِّی۔","Sahih","Musannaf Ibn Abi Shaybah 4956","","","كتاب الصلوات"
"4957","(۴۹۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ زِیَادٍ ، قَالَ : کُنْتُ أَنام فِی الْمَسْجِدِ الْحَرَامِ ، فَأَحْتَلِمُ فِی اللَّیْلَۃ مِرَارًا ، فَسَأَلْت عَطَائً ؟ فَقَالَ : نَمْ وَإِنِ احْتَلَمْتَ عَشْرَ مَرَّاتٍ۔","","Musannaf Ibn Abi Shaybah 4957","","","كتاب الصلوات"
"4958","(۴۹۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أمیۃ ، عَنِ الْمُغِیرَۃِ بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ سُئِلَ عَنِ النَّوْمِ فِی الْمَسْجِدِ ؟ فَقَالَ : أَیْنَ کَانَ أَہْلُ الصُّفَّۃِ ؟ یَعْنِی یَنَامُونَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 4958","","","كتاب الصلوات"
"4959","(۴۹۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ نِمْتُ فِی الْمَسْجِدِ الْحَرَامِ فَاحْتَلَمْتُ فِیہِ، فَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ ؟ فَقَالَ : اذْہَبْ وَاغْتَسِلْ ، یَعْنِی ، وَلَمْ یَنْہَہُ۔","","Musannaf Ibn Abi Shaybah 4959","","","كتاب الصلوات"
"4960","(۴۹۶۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ بِتُّ ذَاتَ لَیْلَۃٍ عِنْدَ مَیْمُونَۃَ بِنْتِ الْحَارِثِ ، فَقَامَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی مِنَ اللَّیْلِ ، فَقُمْتُ عَنْ یَسَارِہِ فَأَخَذَ بِذُؤَابَۃٍ کَانَتْ لِی ، أَوْ بِرَأْسِی فَأَقَامَنِی عَنْ یَمِینِہِ۔ (بخاری ۱۱۷۔ احمد ۱/۲۱۵)","Sahih","Musannaf Ibn Abi Shaybah 4960","","","كتاب الصلوات"
"4961","(۴۹۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُوسَی بْنِ أَنَسٍ ، عَنْ أَنَسٍ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی فَأَقَامَنِی عَنْ یَمِینِہِ۔ (مسلم ۲۶۹۔ احمد ۳/۱۹۴)","Sahih","Musannaf Ibn Abi Shaybah 4961","","","كتاب الصلوات"
"4962","(۴۹۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ شُرَحْبِیلَ ، عَنْ جَابِرٍ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَقَامَنِی عَنْ یَمِینِہِ۔ (ابن ماجہ ۹۷۳۔ احمد ۳/۳۲۶)","Hasan","Musannaf Ibn Abi Shaybah 4962","","","كتاب الصلوات"
"4963","(۴۹۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ عُمَرَ وَہُوَ یُصَلِّی ، فَقُمْتُ عَنْ شِمَالِہِ ، فَجَعَلَنِی عَنْ یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4963","","","كتاب الصلوات"
"4964","(۴۹۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : صَلَّیْتُ مَعَہُ فَأَقَامَنِی عَنْ یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4964","","","كتاب الصلوات"
"4965","(۴۹۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَر ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ قَامَ رَجُلٌ یُصَلِّی عَنْ یَسَارِہِ ، فَحَوَّلَہُ عن یَمِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 4965","","","كتاب الصلوات"
"4966","(۴۹۶۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا صَلَّی مَعَہُ رَجُلٌ ، أَقَامَہُ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4966","","","كتاب الصلوات"
"4967","(۴۹۶۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ ، دَخَلْتُ مَعَ مَکْحُولٍ مَسْجِدَ دِمَشْقَ وَقَدْ صَلَّی أَہْلُہُ ، فَأَقَامَنِی عَنْ یَمِینِہِ فَصَلَّیْتُ بِصَلاَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4967","","","كتاب الصلوات"
"4968","(۴۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُقِیمُہُ عَنْ یَمِینِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4968","","","كتاب الصلوات"
"4969","(۴۹۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ إذَا قَامَ مَعَہُ رَجُلٌ ، أَقَامَہُ عَنْ یَمِینِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 4969","","","كتاب الصلوات"
"4970","(۴۹۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : جِئْتُ إلی عُرْوَۃَ وَہُوَ یُصَلِّی ، فَأَقَامَنِی عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 4970","","","كتاب الصلوات"
"4971","(۴۹۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : سَأَلْتُ عَنْہُ سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : یُقِیمُہُ عَنْ یَسَارِہِ۔","","Musannaf Ibn Abi Shaybah 4971","","","كتاب الصلوات"
"4972","(۴۹۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : اسْتَأْذَنَ عَلْقَمَۃُ وَالأَسْوَدُ عَلَی عَبْدِ اللہِ فَأَذِنَ لَہُمَا ، وَقَالَ : إِنَّہُ سَیَکُونُ أُمَرَائُ یَشْغَلُونَ عَنْ وَقْتِ الصَّلاَۃ ، فَصَلُّوہَا لِوَقْتِہَا ، ثُمَّ قَامَ فصلی بَیْنِی وَبَیْنَہُ ، وَقَالَ : ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَ۔","","Musannaf Ibn Abi Shaybah 4972","","","كتاب الصلوات"
"4973","(۴۹۷۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہَارُونَ بْنِ عَنْتَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، وَالأَسْوَدِ ، عَنْ عَبْدِ اللہِ ؛ رَفَعَہُ ، مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4973","","","كتاب الصلوات"
"4974","(۴۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہُمْ أَحَدُہُمْ وَتَأَخَّرَ اثْنَانِ۔","","Musannaf Ibn Abi Shaybah 4974","","","كتاب الصلوات"
"4975","(۴۹۷۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا صَلَّی ثَالِثُ ثَلاَثَۃٍ جَعَلَ اثْنَیْنِ خَلْفَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 4975","","","كتاب الصلوات"
"4976","(۴۹۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ إذَا صَلَّی مَعَہُ الرَّجُلاَنِ خَلَفَہُمَا خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 4976","","","كتاب الصلوات"
"4977","(۴۹۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہُمْ أَحَدُہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4977","","","كتاب الصلوات"
"4978","(۴۹۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : إذَا کَانَ الْقَوْمُ ثَلاَثَۃً سِوَی الإِمَام ، تَقَدَّمَہُمْ أَحَدُہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 4978","","","كتاب الصلوات"
"4979","(۴۹۷۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : صَلَّیْتُ أَنَا وَرَجُلٌ مَعَ مُجَاہِدٍ ، فَأَقَامَ أَحَدَنَا عَنْ یَمِینِہِ ، وَالآَخَر عَنْ یَسَارِہِ ، وَقَالَ : ہَکَذَا یَصْنَعُ الثَّلاَثَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4979","","","كتاب الصلوات"
"4980","(۴۹۸۰) حَدَّثَنَا ابن عُیَیْنَۃُ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ عُمَرَ وَہُوَ یُصَلِّی بِالْہَاجِرَۃِ ، فَقُمْت عَنْ شِمَالِہِ فَجَعَلَنِی عَنْ یَمِینِہِ ، فَجَائَ یَرْفَأ فَتَأَخَّرْنَا فصرنا اثْنَیْنِ خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4980","","","كتاب الصلوات"
"4981","(۴۹۸۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ (ح) وَعَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالُوا : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہُمْ أَحَدُہُمْ وَصَلَّی اثْنَانِ خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4981","","","كتاب الصلوات"
"4982","(۴۹۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : جِئْت إلَی عُمَرَ وَہُوَ یُصَلِّی فَجَعَلَنِی عَنْ یَمِینِہِ ، فَجَائَ یَرْفَأُ فَجَعَلَنَا خَلْفَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 4982","","","كتاب الصلوات"
"4983","(۴۹۸۳) حَدَّثَنَا أَبُو نُعَیْمٍ ، قَالَ: حدَّثَنَا نُصَیْرُ بْنُ أَبِی الأَشْعَثِ ، عَنْ حَمَّادِ بْنِ خُوَارٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا کَانُوا ثَلاَثَۃً تَقَدَّمَہم أَحَدُہُمْ۔","Majhul","Musannaf Ibn Abi Shaybah 4983","","","كتاب الصلوات"
"4984","(۴۹۸۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، عَنْ مُوسَی بْنِ أَنَسٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِہِمْ وَامْرَأَۃٍ مِنْ أَہْلِہِ ، فَجَعَلَ أَنَسًا عَنْ یَمِینِہِ وَالْمَرْأَۃَ خَلْفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 4984","","","كتاب الصلوات"
"4985","(۴۹۸۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ، عَنْ ثَابِتٍ، قَالَ: صَلَّیْتُ مَعَ أَنَسٍ فَقُمْتُ عَنْ یَمِینِہِ ، وَقَامَتْ أُمُّ وَلَدِہِ خَلْفَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 4985","","","كتاب الصلوات"
"4986","(۴۹۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : جِئْت إلَی عُرْوَۃَ وَہُوَ یُصَلِّی وَخَلْفَہُ امْرَأَۃٌ ، فَأَقَامَنِی عَنْ یَمِینِہِ وَالْمَرْأَۃَ خَلْفَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 4986","","","كتاب الصلوات"
"4987","(۴۹۸۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : إذَا کَانَ الإِمَام مَعَہُ رَجُلٌ وَاحِدٌ وَامْرَأَۃٌ ، فَلْیَقُومُوا مُتَوَاتِرَیْنِ۔","","Musannaf Ibn Abi Shaybah 4987","","","كتاب الصلوات"
"4988","(۴۹۸۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، عَنِ امْرَأَۃٍ مِنْ قَوْمِہِ اسْمُہَا حُجَیْرَۃُ ، قَالَتْ أَمَّتْنَا أُمُّ سَلَمَۃَ قَائِمَۃً وَسَطَ النِّسَائِ۔","Majhul","Musannaf Ibn Abi Shaybah 4988","","","كتاب الصلوات"
"4989","(۴۹۸۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أُمِّ الْحَسَنِ ؛ أَنَّہَا رَأَتْ أُمَّ سَلَمَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَؤُمُّ النِّسَائَ ، تَقُومُ مَعَہُنَّ فِی صَفِّہِنَّ۔","Hasan","Musannaf Ibn Abi Shaybah 4989","","","كتاب الصلوات"
"4990","(۴۹۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَؤُمُّ النِّسَائَ فِی الْفَرِیضَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 4990","","","كتاب الصلوات"
"4991","(۴۹۹۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَؤُمُّ النِّسَائَ ، تقوم مَعَہُنَّ فِی الصَّفِّ۔","Da'if","Musannaf Ibn Abi Shaybah 4991","","","كتاب الصلوات"
"4992","(۴۹۹۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ (ح) وَحُصَیْنٌ ، عَنِ الشَّعْبِیِّ ، قَالَ : تَؤُمُّ الْمَرْأَۃُ النِّسَائَ فِی صَلاَۃِ رَمَضَانَ ، تَقُومُ مَعَہُنَّ فِی صَفِّہِنَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 4992","","","كتاب الصلوات"
"4993","(۴۹۹۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُرَیْثٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ تَؤُمَّ الْمَرْأَۃُ النِّسَائَ ، تَقُومُ مَعَہُنَّ فِی الصَّفِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 4993","","","كتاب الصلوات"
"4994","(۴۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مَوْلًی لِبَنِی ہَاشِمٍ ، عَنْ عَلِیٍّ ، قَالَ : لاَ تَؤُمُّ الْمَرْأَۃُ۔","Majhul","Musannaf Ibn Abi Shaybah 4994","","","كتاب الصلوات"
"4995","(۴۹۹۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْتُ إلَی نَافِعٍ أَسْأَلُہُ ، أَتَؤُمُّ الْمَرْأَۃُ النِّسَائَ ؟ فَقَالَ: لاَ أَعْلَمُ الْمَرْأَۃَ تَؤُمُّ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 4995","","","كتاب الصلوات"
"4996","(۴۹۹۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عمرو ، قَالَ : أَخْبَرَنِی مَنْ رَأَی جَابِرَ بْنَ زَیْدٍ یُومِیئُ فِی مَایئٍ وَطِینٍ۔","","Musannaf Ibn Abi Shaybah 4996","","","كتاب الصلوات"
"4997","(۴۹۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا کَانَ فِی مَائٍ وَطِینٍ أَوْمَأَ إیمَائً۔","No Data Available","Musannaf Ibn Abi Shaybah 4997","","","كتاب الصلوات"
"4998","(۴۹۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : الَّذِی فِی الْمَائِ وَالطِّینِ یُومِئُ إیمَائً۔","No Data Available","Musannaf Ibn Abi Shaybah 4998","","","كتاب الصلوات"
"4999","(۴۹۹۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ، قَالَ: إذَا کُنْتَ فِی مَائٍ ، أَوْ سَبْخَۃٍ ، فَأَوْمِیئْ إیمَائً۔","No Data Available","Musannaf Ibn Abi Shaybah 4999","","","كتاب الصلوات"
"5000","(۵۰۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ فِی الرَّجُلِ تُدْرِکُہُ الصَّلاَۃ فِی الْمَائِ وَالطِّینِ ، قَالَ : یُومِیئُ إیمَائً ، وَیَجْعَلُ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 5000","","","كتاب الصلوات"
"5001","(۵۰۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ: رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی الْمَائِ وَالطِّینِ۔ (بخاری ۶۶۹۔ مسلم ۸۲۶)","Sahih","Musannaf Ibn Abi Shaybah 5001","","","كتاب الصلوات"
"5002","(۵۰۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : أَقْبَلْت مَعَ أَنَسِ بْنِ مَالِکٍ مِنَ الْکُوفَۃِ ، حَتَّی إذَا کُنَّا بِأَطَطٍ وَقَدْ أَخَذَتْنَا السَّمَائُ قَبْلَ ذَلِکَ ، وَالأَرْضُ ضَحْضَاحٌ ، فَصَلَّی أَنَسٌ وَہُوَ عَلَی حِمَارٍ مُسْتَقْبِلَ الْقِبْلَۃِ ، وَأَوْمَأَ إیمَائً ، وَجَعَلَ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 5002","","","كتاب الصلوات"
"5003","(۵۰۰۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ سَالِمٍ ، وَعَامِرٍ ، قَالاَ : إذَا کُنْتَ فِی مَائٍ وَطِینٍ لاَ تَجِدُ مَکَانًا تَسْجُدُ عَلَیْہِ ، فَأَوْمِیئْ بِرَأْسِکَ إیمَائً۔","","Musannaf Ibn Abi Shaybah 5003","","","كتاب الصلوات"
"5004","(۵۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ غَالِبِ بْنِ سُلَیْمَانَ ، عَنْ رَجُلٍ مِنْ حُدَّان ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ وَقَعَ فِی مَائٍ وَطِینٍ فَجَعَلَ یَرْکَعُ ، فَإِذَا أَرَادَ أَنْ یَسْجُدَ أَوْمَأَ ، فَقُلْتُ لَہُ ؟ فَقَالَ : یَا أَحْمَقُ ، أَتُرِیدُ أَنْ أُفْسِدَ ثِیَابِی؟","","Musannaf Ibn Abi Shaybah 5004","","","كتاب الصلوات"
"5005","(۵۰۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی ، عَنْ ضَمْضَمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الأَسْوَدَیْنِ فِی الصَّلاَۃ ، الْحَیَّۃِ وَالْعَقْرَبِ۔ (ابن ماجہ ۱۲۴۵۔ احمد ۲/۲۴۸)","Sahih","Musannaf Ibn Abi Shaybah 5005","","","كتاب الصلوات"
"5006","(۵۰۰۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : رَأَی نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یُصَلِّی جَالِسًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِمَ تُصَلِّی جَالِسًا ؟ فَقَالَ : إنَّ عَقْرَبًا لَسَعَتْنِی ، قَالَ : فَإِذَا رَأَی أَحَدُکُمْ عَقْرَبًا ، وَإِنْ کَانَ فِی الصَّلاَۃ ، فَلْیَأْخُذْ نَعْلَہُ الْیُسْرَی ، فَلْیَقْتُلْہَا بِہَا۔","","Musannaf Ibn Abi Shaybah 5006","","","كتاب الصلوات"
"5007","(۵۰۰۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا قَتَلَہَا وَہُوَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5007","","","كتاب الصلوات"
"5008","(۵۰۰۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ؛ رَأَی ابْنُ عُمَرَ رِیشَۃً وَہُوَ یُصَلِّی ، فَحَسِبَ أَنَّہَا عَقْرَبٌ ، فَضَرَبَہَا بِنَعْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 5008","","","كتاب الصلوات"
"5009","(۵۰۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شعبۃ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ قَتَلَہَا وَہُوَ یُصَلِّی۔","No Data Available","Musannaf Ibn Abi Shaybah 5009","","","كتاب الصلوات"
"5010","(۵۰۱۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِقَتْلِہَا وَہُوَ فِی الصَّلاَۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 5010","","","كتاب الصلوات"
