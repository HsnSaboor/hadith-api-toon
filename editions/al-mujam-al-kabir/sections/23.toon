hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"13201","13165  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ، قَالَ :  قَالَ  سَالِمٌ : قَالَ :  قَالَ  ابْنُ عُمَرَ  :  كَانَتْ يَمِينُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا وَمُقَلِّبِ الْقُلُوبِ  "" .","","Al-Mu'jam al-Kabir 13165","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن يحيى بن عبد الله بن سالم بن عبد الله بن عمر عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سالم عن ابن عمر"
"13202","13166  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كَانَتْ يَمِينُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّتِي يَحْلِفُ بِهَا :  لَا وَمُصَرِّفِ الْقُلُوبِ  "" .","","Al-Mu'jam al-Kabir 13166","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن فضيل بن سليمان النميري عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سالم عن ابن عمر"
"13203","13167  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَبُو أُمَيَّةَ عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ ،  ثَنَا  مَخْلَدُ بْنُ يَزِيدَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ  ، عَنِ  ابْنِ عُمَرَ  أَنَّهُ  كَانَ  يَسُبُّ  الْبَيْدَاءَ  أَوْ يَهُمُّ بِسَبِّهَا وَيَقُولُ :  مَا أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  بِذِي الْحُلَيْفَةِ  "" .","","Al-Mu'jam al-Kabir 13167","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن سفيان الثوري عن مخلد بن يزيد الحراني عن عمرو بن هشام بن بزين الحراني عن الحسن بن علي بن شبيب المعمري عن الطبراني","سالم عن ابن عمر"
"13204","13168  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  مُوسَى بْنُ عُقْبَةَ ،  حَدَّثَنِي  سَالِمٌ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَا أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ عِنْدِ  مَسْجِدِ ذِي الْحُلَيْفَةِ  "" .","","Al-Mu'jam al-Kabir 13168","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13205","13169  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  زُهَيْرٌ (  ح  ) .         [12/298]      وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ، قَالَا :  ثَنَا  مُوسَى بْنُ عُقْبَةَ ،  أَخْبَرَنِي  سَالِمٌ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ  يُحَدِّثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَّهُ لَقِيَ  زَيْدَ بْنَ عَمْرِو بْنِ نُفَيْلٍ  بِأَسْفَلِ  بَلْدَحَ  ، وَذَلِكَ قَبْلَ أَنْ يَنْزِلَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْوَحْيُ فَقَدَّمَ إِلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  سُفْرَةً  فِيهَا لَحْمٌ فَأَبَى أَنْ يَأْكُلَ ، قَالَ :  لَا آكُلُ مِمَّا يَذْبَحُونَ عَلَى  أَنْصَابِهِمْ  ، أَنَا لَا آكُلُ إِلَّا مِمَّا ذُكِرَ اسْمُ اللهِ عَلَيْهِ  "" .  تصحفت في طبعة مكتبة ابن تيمية : ( أصنابهم ) وهي على الصواب في النسخ الخطية.","","Al-Mu'jam al-Kabir 13169","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13206","13170  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  أَنَا  مُوسَى بْنُ عُقْبَةَ ،  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنِي عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ الْكَلْبِيِّ  مَوْلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" مَا كُنَّا نَدْعُوهُ إِلَّا  زَيْدَ بْنَ مُحَمَّدٍ  حَتَّى نَزَلَ الْقُرْآنُ :         {      ادْعُوهُمْ لآبَائِهِمْ هُوَ أَقْسَطُ عِنْدَ اللهِ         }      "" .","","Al-Mu'jam al-Kabir 13170","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13207","13171  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  أَنَا  مُوسَى بْنُ عُقْبَةَ ،  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  أَنَّهُ سَمِعَهُ يُحَدِّثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  حِينَ أَمَّرَ  أُسَامَةَ بْنَ زَيْدٍ  فَبَلَغَهُ أَنَّ النَّاسَ عَابُوا  أُسَامَةَ بْنَ زَيْدٍ         [12/299]      وَطَعَنُوا فِي إِمَارَتِهِ ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي النَّاسِ ، فَقَالَ :  أَلَا إِنَّكُمْ تَعِيبُونَ  أُسَامَةَ  وَتَطْعَنُونَ فِي إِمَارَتِهِ  ، وَقَدْ فَعَلْتُمْ ذَلِكَ بِأَبِيهِ مِنْ قَبْلُ ، وَإِنْ كَانَ لَخَلِيقًا لِلْإِمَارَةِ ، وَإِنْ كَانَ لَأَحَبَّ النَّاسِ كُلِّهِمْ إِلَيَّ ، وَإِنَّ هَذَا مِنْ بَعْدِهِ لَأَحَبُّ النَّاسِ إِلَيَّ فَاسْتَوْصُوا بِهِ خَيْرًا فَإِنَّهُ مِنْ خِيَارِكُمْ "" . قَالَ  سَالِمٌ  : فَمَا سَمِعْتُ  عَبْدَ اللهِ  يُحَدِّثُ بِهَذَا الْحَدِيثِ قَطُّ إِلَّا قَالَ : حَاشَا  فَاطِمَةَ  .","","Al-Mu'jam al-Kabir 13171","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13208","13172  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ أَسَدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ وَهُوَ  بِالْمُعَرَّسِ  مِنْ  ذِي الْحُلَيْفَةِ  مِنْ بَطْنِ الْوَادِي ، فَقَالَ :  إِنَّكَ بِبَطْحَاءَ مُبَارَكَةٍ  "" .","","Al-Mu'jam al-Kabir 13172","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سالم عن ابن عمر"
"13209","13173  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ثَنَا  زُهَيْرٌ ،  ثَنَا  مُوسَى بْنُ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ،  عَنْ رُؤْيَا رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  أَبِي بَكْرٍ  ،  وَعُمَرَ  ، قَالَ :  رَأَيْتُ النَّاسَ اجْتَمَعُوا فَقَامَ  أَبُو بَكْرٍ  فَنَزَعَ  ذَنُوبًا أَوْ ذَنُوبَيْنِ  ، فِي نَزْعِهِ  ضَعْفٌ ، وَاللهُ يَغْفِرُ لَهُ ، ثُمَّ قَامَ  عُمَرُ بْنُ الْخَطَّابِ  فَاسْتَحَالَتْ  غَرْبًا  فَمَا رَأَيْتُ  عَبْقَرِيًّا  مِنَ النَّاسِ  يَفْرِي  فَرِيَّهُ حَتَّى  ضَرَبَ  النَّاسُ  بِعَطَنٍ  "" .  تصحفت في طبعة مكتبة ابن تيمية : ( ترعة ) .","","Al-Mu'jam al-Kabir 13173","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13210","13174  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ، ثَنَا  زُهَيْرٌ ،  ثَنَا  مُوسَى بْنُ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، قَالَ : قَالَ         [12/300]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ جَرَّ ثِيَابَهُ مِنَ  الْخُيَلَاءِ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  ، فَقَالَ  أَبُو بَكْرٍ الصِّدِّيقُ  : أَيْ رَسُولَ اللهِ إِنَّ أَحَدَ شِقَّيْ إِزَارِي يَسْتَرْخِي إِلَّا أَنْ أَتَعَاهَدَ ذَاكَ أَوْ ذَلِكَ مِنْهُ ، قَالَ : "" لَسْتَ مِمَّنْ يَصْنَعُهُ  خُيَلَاءَ  "" .","","Al-Mu'jam al-Kabir 13174","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","سالم عن ابن عمر"
"13211","13175  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  عَمْرُو بْنُ أَسْلَمَ الْحِمْصِيُّ ،  ثَنَا  سَلْمُ بْنُ مَيْمُونٍ الْخَوَّاصُ ،  عَنْ  عَلِيِّ بْنِ عَطَاءٍ ،  عَنْ  عُبَيْدِ اللهِ الْعُمَرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ فِي سُوقٍ مِنَ الْأَسْوَاقِ : لَا إِلَهَ إِلَّا اللهُ ، وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، كَتَبَ اللهُ لَهُ أَلْفَ حَسَنَةٍ  "" .","","Al-Mu'jam al-Kabir 13175","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن علي بن عطاء عن سلم بن ميمون الخواص عن عمرو بن أسلم الطرسوسي عن الحسن بن علي بن شبيب المعمري عن الطبراني","سالم عن ابن عمر"
"13212","13176  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  سَعْدُ بْنُ زُنْبُورٍ ،  ثَنَا  سُلَيْمُ بْنُ مُسْلِمٍ الْخَشَّابُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا خَلْفَ  الْكَعْبَيْنِ  فَفِي النَّارِ  "" .","","Al-Mu'jam al-Kabir 13176","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن سليم بن مسلم الخشاب عن سعد بن زنبور البغدادي عن إبراهيم بن هاشم البغوي عن الطبراني","سالم عن ابن عمر"
"13213","[12/301]      13177  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ فِي الْمَنَامِ أَنَّ النَّاسَ جُمِعُوا فَقَامَ  أَبُو بَكْرِ بْنُ أَبِي قُحَافَةَ  فَنَزَعَ  ذَنُوبًا أَوْ ذَنُوبَيْنِ  وَفِي نَزْعِهِ  ضَعْفٌ وَاللهُ يَغْفِرُ لَهُ ، ثُمَّ أَخَذَهَا  عُمَرُ بْنُ الْخَطَّابِ  فَاسْتَحَالَتْ  غَرْبًا  فَلَمْ أَرَ  عَبْقَرِيًّا  يَفْرِي  فَرِيَّهُ حَتَّى  ضَرَبَ  النَّاسُ  بِعَطَنٍ  "" .  تصحفت في طبعة مكتبة ابن تيمية : ( ترعة ) .","","Al-Mu'jam al-Kabir 13177","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سالم عن ابن عمر"
"13214","13178  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ جَرَّ ثَوْبَهُ  خُيَلَاءَ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  ، قَالَ  سَالِمٌ  : فَحَدَّثَنِي  أَبِي  أَنَّ  أَبَا بَكْرٍ  قَالَ : يَا رَسُولَ اللهِ ، إِنَّ أَحَدَ شِقَّيْ إِزَارِي يَسْتَرْخِي إِلَّا أَنْ أَتَعَاهَدَ ذَلِكَ مِنْهُ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَيْسَ مِمَّنْ تَصْنَعُ  الْخُيَلَاءَ  "" .","","Al-Mu'jam al-Kabir 13178","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سالم عن ابن عمر"
"13215","13179  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  بَيْنَمَا  عُمَرُ بْنُ الْخَطَّابِ  يَسِيرُ فِي رَكْبٍ فَسَمِعَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَحْلِفُ بِأَبِيهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ  ، فَمَنْ حَلَفَ فَلْيَحْلِفْ بِاللهِ أَوْ لِيَصْمُتْ  "" .","","Al-Mu'jam al-Kabir 13179","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","سالم عن ابن عمر"
"13216","[12/302]      13180  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَسَارٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ثَلَاثَةٌ لَا يَدْخُلُونَ الْجَنَّةَ  ، وَثَلَاثَةٌ لَا يَنْظُرُ اللهُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ ، فَأَمَّا الَّذِينَ لَا يَدْخُلُونَ الْجَنَّةَ فَالْعَاقُّ لِوَالِدَيْهِ ، وَالْمَرْأَةُ الْمُتَرَجِّلَةُ تَشَبَّهُ بِالرِّجَالِ ،  وَالدَّيُّوثُ  ، وَأَمَّا الثَّلَاثَةُ الَّذِينَ لَا يَنْظُرُ اللهُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ ، فَالْعَاقُّ بِوَالِدَيْهِ ،  وَمُدْمِنُ  الْخَمْرِ ، وَالْمَنَّانُ بِمَا أَعْطَى  "" .","","Al-Mu'jam al-Kabir 13180","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن يسار الأعرج مولى ابن عمر عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","سالم عن ابن عمر"
"13217","13181  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ يَسَارٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  إِنَّكُمْ لَتَعْلَمُونَ أَنَّا كُنَّا نَقُولُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  ""  يَعْنِي فِي الْخِلَافَةِ  .","","Al-Mu'jam al-Kabir 13181","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن يسار الأعرج مولى ابن عمر عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","سالم عن ابن عمر"
"13218","13182  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الْقَطَّانُ الْهَمْدَانِيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ مُحَمَّدِ بْنِ زَيْدِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  وَسَالِمٍ  أَنَّ  ابْنَ عُمَرَ  ، قَالَ : "" إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا  جَدَّ  بِهِ السَّيْرُ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  بَعْدَ أَنْ يَغِيبَ  الشَّفَقُ  بِسَاعَةٍ  "" .","","Al-Mu'jam al-Kabir 13182","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن محمد بن نصر مموس الهمداني عن الطبراني","سالم عن ابن عمر"
"13219","[12/303]      13183  -  حَدَّثَنَا  إِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الْأَشْعَثِ ،  ثَنَا  أَبُو عَاصِمٍ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدٍ  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  ذَكَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَاشُورَاءَ فَقَالَ :  كَانَ صَوْمَ أَهْلِ الْجَاهِلِيَّةِ فَمَنْ شَاءَ صَامَ  ، وَمَنْ شَاءَ أَفْطَرَ  "" .","","Al-Mu'jam al-Kabir 13183","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن أبو عاصم النبيل عن أحمد بن المقدام العجلي عن إسحاق بن داود الصواف التستري عن الطبراني","سالم عن ابن عمر"
"13220","13184  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  فَإِذَا خِفْتَ الصُّبْحَ  فَأَوْتِرْ  بِوَاحِدَةٍ  "" .","","Al-Mu'jam al-Kabir 13184","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","سالم عن ابن عمر"
"13221","13185  -  حَدَّثَنَا  أَبُو عَقِيلٍ أَنَسُ بْنُ سَلْمٍ الْخَوْلَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ رَجَاءٍ السَّخْتِيَانِيُّ ،  ثَنَا  مُنَبِّهُ بْنُ عُثْمَانَ ،  حَدَّثَنِي  عُمَرُ بْنُ مُحَمَّدِ بْنِ زَيْدٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ شَيْءٍ مَعْدِنٌ  ، وَمَعْدِنُ التَّقْوَى قُلُوبُ الْعَارِفِينَ  "" .","","Al-Mu'jam al-Kabir 13185","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن منبه بن عثمان الشامي عن محمد بن رجاء السختياني عن أنس بن سلم الأنطرسوسي عن الطبراني","سالم عن ابن عمر"
"13222","[12/304]      13186  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ مُحَمَّدٍ أَنَّ  سَالِمًا  حَدَّثَهُ  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمَيِّتُ  يُعَذَّبُ  بِبُكَاءِ الْحَيِّ  "" .","","Al-Mu'jam al-Kabir 13186","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","سالم عن ابن عمر"
"13223","13187  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى عَنِ  الْجَلَّالَةِ  وَأَلْبَانِهَا وَظَهْرِهَا  "" .","","Al-Mu'jam al-Kabir 13187","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن إسماعيل بن عياش الأحول عن هشام بن عمار عن أحمد بن علي بن مسلم النخشبي عن الطبراني","سالم عن ابن عمر"
"13224","13188  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ، سَنَةَ إِحْدَى وَثَمَانِينَ وَمِائَةٍ ،  أَنَا  عُمَرُ بْنُ حَمْزَةَ الْعُمَرِيُّ ،  ثَنَا  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ  اسْتَطَاعَ مِنْكُمْ أَنْ يَكُونَ مِثْلَ صَاحِبِ  فَرْقِ  الْأَرُزِّ فَلْيَكُنْ مِثْلَهُ  ، قَالُوا : يَا رَسُولَ اللهِ وَمَنْ صَاحِبُ  فَرْقِ  الْأَرُزِّ ؟ قَالَ : "" خَرَجَ ثَلَاثَةٌ فَغَيَّمَتْ عَلَيْهِمُ السَّمَاءُ فَدَخَلُوا غَارًا فَجَاءَتْ صَخْرَةٌ حَتَّى طَبَقَتِ الْبَابَ عَلَيْهِمْ  فَعَالَجُوهَا  فَلَمْ يَسْتَطِيعُوا ، فَقَالَ بَعْضُهُمْ لِبَعْضٍ : لَقَدْ وَقَعْتُمْ فِي أَمْرٍ عَظِيمٍ فَلْيَدْعُ كُلُّ رَجُلٍ مِنْكُمْ بِأَحْسَنِ مَا عَمِلَ ؛ لَعَلَّ اللهَ أَنْ يُنْجِيَنَا مِنْ هَذَا  "" ثُمَّ ذَكَرَ حَدِيثَ الْغَارِ بِطُولِهِ .","","Al-Mu'jam al-Kabir 13188","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن مروان بن معاوية الفزاري عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سالم عن ابن عمر"
"13225","[12/305]      13189  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  أَبُو عَقِيلٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَمِّهِ  سَالِمٍ ، وَنَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا حَقُّ امْرِئٍ مُسْلِمٍ يَبِيتُ لَيْلَةً مِنَ الدَّهْرِ  إِلَّا وَعَهْدُهُ عِنْدَهُ إِذَا كَانَ لَهُ مِنَ الْمَالِ مَا يُعْهَدُ فِي مِثْلِهِ  "" .","","Al-Mu'jam al-Kabir 13189","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن عبد الله بن عمر بن الخطاب عن يحيى بن المتوكل الحذاء عن عبد الحميد بن صالح البرجمي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سالم عن ابن عمر"
"13226","13190  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ، وَالْحَسَنُ بْنُ الْمُتَوَكِّلِ ، قَالَا :  ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ الْجَوْهَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  ، [ عَاصِمِ بْنِ عُمَرَ ]  عَنْ  أَبِي بَكْرِ بْنِ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ بْنِ الْخَطَّابِ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَا أَوَّلُ مَنْ تَنْشَقُّ عَنْهُ الْأَرْضُ يَوْمَ الْقِيَامَةِ  ، ثُمَّ  أَبُو بَكْرٍ  ، ثُمَّ  عُمَرُ  ، ثُمَّ يَأْتِي  أَهْلُ الْبَقِيعِ  فَيُحْشَرُونَ مَعِي ، ثُمَّ أَنْتَظِرُ  أَهْلَ مَكَّةَ  فَيُحْشَرُونَ مَعِي  "" .  في طبعة مكتبة ابن تيمية والنسخة الخطية : ( عاصم عن ابن عمر ) ويظهر في النسخة الخطية وكأنه ضرب على لفظة ( عن ) وهو الصواب وينظر مصادر التخريج ، والله أعلم .","","Al-Mu'jam al-Kabir 13190","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب عن عاصم بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن عبد الله بن نافع الصائغ عن سريج بن النعمان الجوهري عن الحسن بن علي بن المتوكل البغدادي عن الطبراني","سالم عن ابن عمر"
"13227","13191  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ  ، ثَنَا  خَالِدُ بْنُ أَبِي بَكْرِ بْنِ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  أَبِيهِ  :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ضَرَبَ صَدْرَ  عُمَرَ بْنِ الْخَطَّابِ  بِيَدِهِ حِينَ أَسْلَمَ ثَلَاثَ         [12/306]      مِرَارٍ وَهُوَ يَقُولُ :  اللَّهُمَّ أَخْرِجْ مَا فِي صَدْرِهِ مِنْ غِلٍّ  ، وَأَبْدِلْهُ إِيمَانًا "" يَقُولُ ذَلِكَ ثَلَاثًا  .","","Al-Mu'jam al-Kabir 13191","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن خالد بن أبي بكر العمري عن عبد الله بن محمد النفيلي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","سالم عن ابن عمر"
"13228","13192  -  حَدَّثَنَا  أَحْمَدُ بْنُ طَاهِرِ بْنِ حَرْمَلَةَ بْنِ يَحْيَى ،  ثَنَا  جَدِّي حَرْمَلَةُ بْنُ يَحْيَى  ، ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  الضَّحَّاكُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مُجَبِّرٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فَإِذَا كَانَ يَوْمُ سَابِعِهِ فَأَهْرِيقُوا عَنْهُ دَمًا  ، وَأَزِيلُوا عَنْهُ  الْأَذَى  "" .","","Al-Mu'jam al-Kabir 13192","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الرحمن بن مجبر العدوي عن الضحاك بن عثمان الحزامي عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن أحمد بن طاهر بن حرملة التجيبي عن الطبراني","سالم عن ابن عمر"
"13229","13193  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ أَبِي حَرْمَلَةَ ،  أَخْبَرَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ اقْتَنَى كَلْبًا إِلَّا كَلْبَ مَاشِيَةٍ أَوْ صَيْدٍ  ، نَقَصَ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطَانِ  "" .","","Al-Mu'jam al-Kabir 13193","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن أبي حرملة القرشي عن جعفر بن محمد عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","سالم عن ابن عمر"
"13230","13194  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ  ، ثَنَا  آدَمُ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، قَالَ :  إِنْ كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيَأْمُرُنَا بِالتَّخْفِيفِ  ، وَإِنْ كَانَ لَيَؤُمُّنَا بِالصَّافَّاتِ  "" .","","Al-Mu'jam al-Kabir 13194","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","سالم عن ابن عمر"
"13231","13195  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  سَعِيدُ بْنُ         [12/307]      عُفَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْوَلِيدِ بْنِ أَبِي الْوَلِيدِ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْظُرُ اللهُ إِلَى الْأُشَيْمِطِ الزَّانِي  ، وَلَا الْعَايِلِ  الْمَزْهُوِّ  ، وَلَا الَّذِي يَجُرُّ إِزَارَهُ  خُيَلَاءَ  "" .","","Al-Mu'jam al-Kabir 13195","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوليد بن أبي الوليد مولى عبد الله بن عمر عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن روح بن الفرج القطان عن الطبراني","سالم عن ابن عمر"
"13232","13196  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِذَا قَفَلَ مِنَ  الْحَجِّ  وَالْعُمْرَةِ يَقُولُ كُلَّمَا أَوْفَى عَلَى ثَنِيَّةٍ أَوْ  فَدْفَدٍ  كَبَّرَ ثَلَاثًا ، ثُمَّ قَالَ :  لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، آيِبُونَ تَائِبُونَ عَابِدُونَ سَاجِدُونَ لِرَبِّنَا حَامِدُونَ ، صَدَقَ اللهُ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ  "" .","","Al-Mu'jam al-Kabir 13196","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن صالح بن كيسان الدوسي عن عبد العزيز بن عبد الله الماجشون عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سالم عن ابن عمر"
"13233","13197  -  حَدَّثَنَا  أَبُو عَقِيلٍ أَنَسُ بْنُ سَلْمٍ الْخَوْلَانِيُّ  ، ثَنَا  أَبُو الْأَصْبَغِ عَبْدُ الْعَزِيزِ بْنُ يَحْيَى الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَنْزِلُ  الدَّجَّالُ  بِهَذِهِ السَّبَخَةِ فَيَكُونُ آخِرُ مَنْ يَخْرُجُ إِلَيْهِ النِّسَاءَ  ، حَتَّى إِنَّ الرَّجُلَ لَيَرْجِعُ إِلَى أُمِّهِ ، وَأُخْتِهِ ، وَعَمَّتِهِ فَيُوثِقُهَا رِبَاطًا مَخَافَةَ أَنْ تَخْرُجَ إِلَيْهِ ، ثُمَّ يُسَلِّطُ اللهُ الْمُسْلِمِينَ عَلَيْهِ فَيَقْتُلُونَهُ ، وَيَقْتُلُونُ شِيعَتَهُ حَتَّى إِنَّ الْيَهُودِيَّ         [12/308]      يَخْتَبِئُ تَحْتَ الشَّجَرِ أَوِ الْحَجَرِ ، فَيَقُولُ الْحَجَرُ أَوِ الشَّجَرَةُ : يَا مُسْلِمُ هَذَا يَهُودِيٌّ تَحْتِي فَاقْتُلْهُ  "" .","","Al-Mu'jam al-Kabir 13197","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد العزيز بن يحيى البكائي عن أنس بن سلم الأنطرسوسي عن الطبراني","سالم عن ابن عمر"
"13234","13198  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ عِيسَى بْنِ مَيْسَرَةَ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَسُوقَنَّ  رَجُلٌ  مِنْ  قَحْطَانَ  النَّاسَ بِعَصًا  "" .","","Al-Mu'jam al-Kabir 13198","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن أبي بكر بن محمد  ابن حزم عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن الحسين بن عيسى الحارثي عن علي بن سعيد بن بشير عليك عن الطبراني","سالم عن ابن عمر"
"13235","13199  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ، ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يُصَوِّرُ عَبْدٌ صُورَةً إِلَّا قِيلَ لَهُ يَوْمَ الْقِيَامَةِ : أَحْيِ مَا خَلَقْتَهُ  "" .","","Al-Mu'jam al-Kabir 13199","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","سالم عن ابن عمر"
"13236","13200  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ السَّدُوسِيُّ  ، وَعَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالُوا :  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  أَبُو الرَّبِيعِ السَّمَّانُ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ يُحِبُّ الْمُحْتَرِفَ  "" .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمر بن حفص السدوسي ).","","Al-Mu'jam al-Kabir 13200","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن أشعث السمان عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","سالم عن ابن عمر"
"13237","13201  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ         [12/309]      سُلَيْمَانَ ،  ثَنَا  أَبُو الرَّبِيعِ السَّمَّانُ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَالِمٍ ،  عَنْ  3807 أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَفَاضَ  مِنْ  عَرَفَاتٍ  وَهُوَ يَقُولُ :  إِلَيْكَ تَعْدُو قَلِقًا  وَضِينُهَا  مُخَالِفًا دِينَ النَّصَارَى دِينُهَا  قَالَ أَبُو الْقَاسِمِ :  وَهِمَ عِنْدِي  أَبُو الرَّبِيعِ السَّمَّانُ  فِي  رَفْعِ  هَذَا الْحَدِيثِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لِأَنَّ الْمَشْهُورَ فِي الرِّوَايَةِ عَنِ  ابْنِ عُمَرَ  مِنْ  عَرَفَاتٍ  وَهُوَ يَقُولُ ثُمَّ ذَكَرَ الرَّجَزَ  .","","Al-Mu'jam al-Kabir 13201","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن أشعث السمان عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","سالم عن ابن عمر"
"13238","13202  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يُصَوِّرُ عَبْدٌ صُورَةً إِلَّا قِيلَ لَهُ يَوْمَ الْقِيَامَةِ  : أَحْيِ مَا خَلَقْتَ  "" .","","Al-Mu'jam al-Kabir 13202","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","سالم عن ابن عمر"
"13239","13203  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْوَاحِدِ بْنِ عَنْبَسَةَ بْنِ عَبْدِ الْوَاحِدِ ،  حَدَّثَنِي  جَدِّي  (  ح  ) .  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  عَنْبَسَةُ بْنُ عَبْدِ الْوَاحِدِ ،  عَنْ  حَنْظَلَةَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَصَوْمِ رَمَضَانَ ، وَحَجِّ الْبَيْتِ  "" .","","Al-Mu'jam al-Kabir 13203","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حنظلة الجمحي عن عنبسة بن عبد الواحد عن محمد بن عبد الواحد بن عنبسة بن عبد الواحد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سالم عن ابن عمر"
"13240","13204  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْحَلَبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي         [12/310]      زِيَادٍ ،  ثَنَا  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اقْتَنَى كَلْبًا فَإِنَّهُ يَنْقُصُ مِنْ عَمَلِهِ قِيرَاطٌ  "" .","","Al-Mu'jam al-Kabir 13204","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن أبي زياد القداح عن محمد بن بكر بن عثمان البرساني عن محمد بن إبراهيم الحلبي عن محمد بن أبان الأصبهاني عن الطبراني","سالم عن ابن عمر"
"13241","13205  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اقْتُلُوا الْحَيَّاتِ  ، وَاقْتُلُوا ذَا  الطُّفْيَتَيْنِ  وَالْأَبْتَرَ فَإِنَّهُمَا  يَلْتَمِسَانِ  الْبَصَرَ ، وَيَسْتَسْقِطَانِ الْحَبَلَ فَمَنْ لَمْ يَقْتُلْهُمَا فَلَيْسَ مِنَّا  "" .","","Al-Mu'jam al-Kabir 13205","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن محمد بن رزيق بن جامع العدل عن الطبراني","سالم عن ابن عمر"
"13242","13206  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الرِّجَالِ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اقْتَنَى كَلْبًا إِلَّا كَلْبًا صَائِدًا أَوْ كَلْبَ مَاشِيَةٍ  نَقَصَ مِنْ عَمَلِهِ قِيرَاطٌ ، وَقَيْرَاطٌ مِثْلُ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 13206","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن محمد بن عبد الرحمن بن حارثة النجاري عن عبد الرحمن بن أبي الرجال النجاري عن الحكم بن موسى بن أبي زهير النسائي عن موسى بن هارون الحمال عن الطبراني","سالم عن ابن عمر"
"13243","13207  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبَّادِ بْنِ مُوسَى الْوَاسِطِيُّ ،  ثَنَا  أَبِي  ، ثَنَا  غِيَاثُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَشْعَبَ الطَّامِعِ بْنِ أَبِي حُمَيْدَةَ ، قَالَ :  أَتَيْتُ  سَالِمَ بْنَ عَبْدِ اللهِ أَسْأَلُهُ ، فَأَشْرَفَ عَلَيَّ مِنْ  خَوْخَةٍ  ، فَقَالَ : وَيْلَكَ يَا  أَشْعَبُ  لَا تَسَلْ فَإِنَّ أَبِي  حَدَّثَنِي  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيَجِيئَنَّ أَقْوَامٌ يَوْمَ الْقِيَامَةِ لَيْسَتْ فِي وُجُوهِهِمْ  مُزْعَةٌ  مِنْ لَحْمٍ قَدْ أَخْلَقُوهَا  "" .","","Al-Mu'jam al-Kabir 13207","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الطمع أشعب بن جبير عن غياث بن إبراهيم النخعي عن عباد بن موسى بن راشد العكلي عن محمد بن عباد بن موسى العكلي عن عبد الله بن محمد بن ناجية البربري عن الطبراني","سالم عن ابن عمر"
"13244","[12/311]      13208  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  رَوْحُ بْنُ صَلَاحٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبَا بَكْرٍ  وَعُمَرَ  : كَانُوا يُصَلُّونَ قَبْلَ الْخُطْبَةِ فِي الْعِيدَيْنِ  "" .","","Al-Mu'jam al-Kabir 13208","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب عن سعيد بن أبي أيوب الخزاعي عن روح بن صلاح بن سيابة الحارثي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","سالم عن ابن عمر"
"13245","13209  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، وَثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ، قَالَا :  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِسْبَالُ فِي الْإِزَارِ وَالْقَمِيصِ وَالْعِمَامَةِ سَوَاءٌ  مَنْ جَرَّ مِنْهَا شَيْئًا  خُيَلَاءَ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  "" .","","Al-Mu'jam al-Kabir 13209","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد العزيز بن أبي رواد الخراساني عن الحسين بن علي الجعفي عن علي ابن المديني عن الفضل بن الحباب الجمحي عن الطبراني","سالم عن ابن عمر"
"13246","13210  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ  ، ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِيُّ ،  ثَنَا  عَطَاءُ بْنُ مُسْلِمٍ الْخَفَّافُ ،  عَنِ  الْأَعْمَشِ ، قَالَ :  كَانَ  سَالِمُ بْنُ عَبْدِ اللهِ  قَاعِدًا عِنْدَ  الْحَجَّاجِ  فَقَالَ لَهُ  الْحَجَّاجُ  : قُمْ فَاضْرِبْ عُنُقَ هَذَا ، فَأَخَذَ  سَالِمٌ  السَّيْفَ وَأَخَذَ  الرَّجُلَ  ، وَتَوَجَّهَ بَابَ الْقَصْرِ فَنَظَرَ إِلَيْهِ أَبُوهُ وَهُوَ يَتَوَجَّهُ بِالرَّجُلِ ، فَقَالَ : أَتُرَاهُ فَاعِلًا فَرَدَّهُ مَرَّتَيْنِ أَوْ ثَلَاثًا ، فَلَمَّا خَرَجَ بِهِ  قَالَ لَهُ  سَالِمٌ : صَلَّيْتَ الْغَدَاةَ ؟ قَالَ : نَعَمْ ، قَالَ : فَخُذْ أَيَّ طَرِيقٍ شِئْتَ ، ثُمَّ جَاءَ فَطَرَحَ السَّيْفَ ، فَقَالَ لَهُ  الْحَجَّاجُ  : أَضَرَبْتَ عُنُقَهَ ؟ قَالَ : لَا ، قَالَ : وَلِمَ ؟ قَالَ : إِنِّي  سَمِعْتُ  أَبِي  هَذَا يَقُولُ : قَالَ رَسُولُ اللهِ         [12/312]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى الْغَدَاةَ كَانَ فِي ذِمَّةِ اللهِ حَتَّى يُمْسِيَ  فَقَالَ  ابْنُ عُمَرَ  : "" مُكَيَّسٌ إِنَّمَا سَمَّيْنَاكَ  سَالِمًا  لِتَسْلَمَ  "" .","","Al-Mu'jam al-Kabir 13210","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الأعمش عن عطاء بن مسلم عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","سالم عن ابن عمر"
"13247","13211  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سَعِيدِ بْنِ عَمْرِو بْنِ سَعِيدٍ ،  ثَنَا  أَبِي  أَنَّ  الْحَجَّاجَ  أَمَرَ  سَالِمَ بْنَ عَبْدِ اللهِ  بِقَتْلِ  رَجُلٍ  فَقَالَ لَهُ  سَالِمٌ  : أَصَلَّيْتَ الصُّبْحَ ؟ فَقَالَ لَهُ الرَّجُلُ : نَعَمْ ، فَقَالَ : انْطَلِقْ ، فَقَالَ لَهُ  الْحَجَّاجُ  : مَا مَنَعَكَ مِنْ قَتْلِهِ ؟ فَقَالَ  سَالِمٌ :  حَدَّثَنِي  أَبِي  أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَلَّى الصُّبْحَ فَهُوَ فِي جِوَارِ اللهِ يَوْمَهُ  فَكَرِهْتُ أَنْ أَقْتُلَ رَجُلًا قَدْ أَجَارَهُ اللهُ ، فَقَالَ  الْحَجَّاجُ  لِابْنِ عُمَرَ : أَنْتَ سَمِعْتَ هَذَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ  ابْنُ عُمَرَ  : نَعَمْ  .","","Al-Mu'jam al-Kabir 13211","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن سعيد بن عمرو بن سعيد بن العاص العذري عن إسحاق بن سعيد بن عمرو السعيدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سالم عن ابن عمر"
"13248","13212  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  الْوَلِيدُ بْنُ شُجَاعٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  عَنْ  يَحْيَى بْنِ الْحَارِثِ الذِّمَارِيِّ  أَنَّهُ : سَمِعَ  سَالِمَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ خَمْرٌ وَكُلُّ مُسْكِرٍ حَرَامٌ  "" .","","Al-Mu'jam al-Kabir 13212","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن يحيى بن الحارث الذماري عن محمد بن شعيب بن شابور القرشي عن الوليد بن شجاع عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","سالم عن ابن عمر"
"13249","13213  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَائِذٍ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  حَدَّثَنِي  يَحْيَى بْنُ الْحَارِثِ الذِّمَارِيُّ ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ عَبْدِ اللهِ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ حَرَامٌ  "" .","","Al-Mu'jam al-Kabir 13213","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن يحيى بن الحارث الذماري عن الهيثم بن حميد الغساني عن محمد بن عائذ بن أحمد عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","سالم عن ابن عمر"
"13250","13214  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  عِيسَى بْنُ         [12/313]      هِلَالٍ الْحِمْصِيُّ ،  ثَنَا  أَبُو حَيْوَةَ شُرَيْحُ بْنُ يَزِيدَ ،  عَنْ  خُلَيْدِ بْنِ دَعْلَجٍ ،  عَنْ  عَاصِمِ بْنِ رَزِينٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  :  أَنَّهُ كَانَ يُصَفِّرُ لِحْيَتَهُ ، وَيُسْبِتُ نَعْلَيْهِ  ، وَيَسْتَلِمُ الرُّكْنَيْنِ : الْحَجَرَ الْأَسْوَدَ ، وَالرُّكْنَ الْيَمَانِيَ ، وَيَدَعُ الرُّكْنَيْنِ اللَّذَيْنِ فِي الْحِجْرِ "" وَحَدَّثَ  ابْنُ عُمَرَ  أَنَّهُ رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 13214","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عاصم بن لقيط بن صبرة الطائفي عن خليد بن دعلج السدوسي عن شريح بن يزيد الحمصي عن عيسى بن أبي عيسى السليحي عن أحمد بن النضر بن بحر العسكري عن الطبراني","سالم عن ابن عمر"
"13251","13215  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْعَلَاءِ بْنِ زَيْدٍ ،  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَيْفَ صَلَاةُ اللَّيْلِ ؟ فَقَالَ :  مَثْنَى مَثْنَى ، فَإِذَا خِفْتَ الصُّبْحَ  فَأَوْتِرْ  بِوَاحِدَةٍ  .","","Al-Mu'jam al-Kabir 13215","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن العلاء بن زبر عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سالم عن ابن عمر"
"13252","13216  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْعَلَاءِ بْنِ زَيْدٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةً فَأُلْبِسَ عَلَيْهِ فِيهَا  ، فَلَمَّا انْصَرَفَ ، قَالَ  لِأُبَيِّ بْنِ كَعْبٍ  : أَصَلَّيْتَ مَعَنَا ؟ قَالَ : نَعَمْ ، قَالَ : فَمَا مَنَعَكَ أَنْ تَفْتَحَ عَلَيَّ ؟  .","","Al-Mu'jam al-Kabir 13216","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن العلاء بن زبر عن محمد بن شعيب بن شابور القرشي عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","سالم عن ابن عمر"
"13253","13217  -  حَدَّثَنَا  أَبُو زَكَرِيَّا الدِّينَوَرِيُّ الْبَصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ ثَوَابٍ الْحُصْرِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ         [12/314]      سُلَيْمَانَ بْنِ مُوسَى ، قَالَ :  سَمِعْتُ  سَالِمَ بْنَ عَبْدِ اللهِ بْنِ عُمَرَ  يُحَدِّثُ عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَمَسُّ الْقُرْآنَ إِلَّا طَاهِرٌ  .","","Al-Mu'jam al-Kabir 13217","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن سليمان بن موسى الأشدق عن ابن جريج عن أبو عاصم النبيل عن الحصرى سعيد بن محمد بن ثواب البصري عن أبو زكريا الدينوري البصري عن الطبراني","سالم عن ابن عمر"
"13254","13218  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ مُحَمَّدٍ الصَّنْعَانِيُّ ،  عَنْ  هُودِ بْنِ عَطَاءٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِنَبِيذٍ فَشَرِبَ مِنْهُ  .","","Al-Mu'jam al-Kabir 13218","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن هود بن عطاء اليمامي عن عبد الملك بن محمد البرسمي عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","سالم عن ابن عمر"
"13255","13219  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ  ، ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  عَلِيُّ بْنُ حَوْشَبٍ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَتَّخِذُوا الْمَسَاجِدَ طُرُقًا إِلَّا لِذِكْرٍ أَوْ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 13219","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن حيي بن هانئ السريعي عن علي بن حوشب الفزاري عن يحيى بن صالح الوحاظي عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سالم عن ابن عمر"
"13256","[12/315]      13220  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  أَنَا  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" أَهَلَّ حِينَ انْبَعَثَتْ  بِهِ رَاحِلَتُهُ  .","","Al-Mu'jam al-Kabir 13220","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","سالم عن ابن عمر"
"13257","13221  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  :  أَنَّ  غَيْلَانَ بْنَ سَلَمَةَ  كَانَ تَحْتَهُ عَشْرُ نِسْوَةٍ فِي الْجَاهِلِيَّةِ فَأَسْلَمَ وَأَسْلَمْنَ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اخْتَرْ مِنْهُنَّ أَرْبَعًا  .","","Al-Mu'jam al-Kabir 13221","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","سالم عن ابن عمر"
"13258","13222  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ، قَالَ :  زَعَمَ  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  وَزَعَمَ  عُرْوَةُ ،  عَنْ  عَائِشَةَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَامَ الْأَيَّامَ فِي  الْحَجِّ  وَلَمْ يَجِدْ هَدْيًا  إِذَا اسْتَمْتَعَ فَهُوَ مَا بَيْنَ إِحْرَامِ أَحَدِكُمْ إِلَى يَوْمِ عَرَفَةَ ، فَهُوَ آخِرُهُنَّ  .","","Al-Mu'jam al-Kabir 13222","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","سالم عن ابن عمر"
"13259","13223  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ         [12/316]      بَحْرٍ ،  ثَنَا  قَتَادَةُ بْنُ الْفُضَيْلِ الرَّهَاوِيُّ ، قَالَ :  سَمِعْتُ  أَبَا حَاضِرٍ  يُحَدِّثَ عَنِ  الْوَضِينِ بْنِ عَطَاءٍ الدِّمَشْقِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَدْخُلُ فُقَرَاءُ أُمَّتِي الْجَنَّةَ قَبْلَ أَغْنِيَائِهِمْ بِأَرْبَعِينَ  خَرِيفًا  قُلْتُ : صِفْهُمْ لَنَا ، قَالَ : "" هُمُ  الدَّسِمَةُ  ثِيَابُهُمُ ، الشَّعِثَةُ رُءُوسُهُمُ ، الَّذِينَ لَا يُؤْذَنُ لَهُمْ عَلَى  السُّدَّاتِ  ، وَلَا يَنْكِحُونَ الْمُتَمَنِّعَاتِ ، يُوَكَّلُ بِهِمْ مَشَارِقُ الْأَرْضِ وَمَغَارِبُهَا ، يُعْطُونَ كُلَّ الَّذِي عَلَيْهِمْ ، وَلَا يُعْطَوْنَ كُلَّ الَّذِي لَهُمْ  .","","Al-Mu'jam al-Kabir 13223","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوضين بن عطاء عن أبو حاضر عن قتادة بن الفضيل بن قتادة الرهاوي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","سالم عن ابن عمر"
"13260","13224  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  الزُّبَيْرُ بْنُ مُحَمَّدِ بْنِ الزُّبَيْرِ الرَّهَاوِيُّ ،  ثَنَا  قَتَادَةُ بْنُ الْفُضَيْلِ ،  عَنْ  أَبِي حَاضِرٍ ،  عَنِ  الْوَضِينِ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سُئِلَتِ الْيَهُودُ عَنْ  مُوسَى  فَأَكْثَرُوا وَزَادُوا وَنَقَصُوا حَتَّى كَفَرُوا  ، وَسُئِلَتِ النَّصَارَى عَنْ  عِيسَى  فَأَكْثَرُوا فِيهِ وَزَادُوا وَنَقَصُوا حَتَّى كَفَرُوا ، وَإِنَّهُ سَيَفْشُو عَنِّي أَحَادِيثُ فَمَا أَتَاكُمْ مِنْ حَدِيثِي فَاقْرَءُوا كِتَابَ اللهِ وَاعْتَبِرُوهُ فَمَا وَافَقَ كِتَابَ اللهِ فَأَنَا قُلْتُهُ ، وَمَا لَمْ يُوَافِقْ كِتَابَ اللهِ فَلَمْ أَقُلْهُ  .","","Al-Mu'jam al-Kabir 13224","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوضين بن عطاء عن أبو حاضر عن قتادة بن الفضيل بن قتادة الرهاوي عن الزبير بن محمد الرهاوي عن علي بن سعيد بن بشير عليك عن الطبراني","سالم عن ابن عمر"
"13261","13225  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالَا :  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  شَبِيبِ بْنِ عَبْدِ الْمَلِكِ ،  عَنْ  مُقَاتِلِ بْنِ حَيَّانَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  حَرَّمَ اللهُ الْخَمْرَ ، وَكُلُّ مُسْكِرٍ حَرَامٌ  .         [12/317]","","Al-Mu'jam al-Kabir 13225","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن مقاتل بن حيان عن شبيب بن عبد الملك التميمي عن معتمر بن سليمان عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","سالم عن ابن عمر"
"13262","13226  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ الْمَدَائِنِيُّ مَوْلَى بَنِي هَاشِمٍ ،  ثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ ،  عَنِ  الْوَازِعِ بْنِ نَافِعٍ الْعُقَيْلِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  فِي قَوْلِهِ :         {      كَمِشْكَاةٍ         }      ، قَالَ : "" جَوْفُ  مُحَمَّدٍ  ، وَالزُّجَاجَةُ قَلْبُهُ  ، وَالْمِصْبَاحُ النُّورُ الَّذِي فِي قَلْبِهِ         {      يُوقَدُ مِنْ شَجَرَةٍ مُبَارَكَةٍ         }      الشَّجَرَةُ  إِبْرَاهِيمُ         {      زَيْتُونَةٍ لا شَرْقِيَّةٍ وَلا غَرْبِيَّةٍ         }      . لَا يَهُودِيٌّ وَلَا نَصْرَانِيٌّ ، ثُمَّ قَرَأَ :         {      مَا كَانَ إِبْرَاهِيمُ يَهُودِيًّا وَلا نَصْرَانِيًّا وَلَكِنْ كَانَ حَنِيفًا مُسْلِمًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ         }      .","","Al-Mu'jam al-Kabir 13226","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوازع بن نافع العقيلي عن علي بن ثابت الجزري عن سريج بن يونس المروزي عن أحمد بن منصور المدائني عن الطبراني","سالم عن ابن عمر"
"13263","13227  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ الْحَرَّانِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الطَّرَائِفِيُّ ،  عَنِ  الْوَازِعِ بْنِ نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلَاةِ  وَرَجُلٌ  يُقَلِّبُ الْحَصَا بِيَدِهِ فَلَمَّا انْصَرَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، الْتَفَتَ إِلَيْنَا ، فَقَالَ :  أَيُّكُمُ الْمُقَلِّبُ الْحَصَا بِيَدِهِ  ؟ "" ، فَقَامَ رَجُلٌ فَقَالَ : أَنَا يَا رَسُولَ اللهِ ، فَقَالَ لَهُ : "" حَظُّكَ مِنْ صَلَاتِكَ  .","","Al-Mu'jam al-Kabir 13227","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوازع بن نافع العقيلي عن عثمان بن عبد الرحمن الطرائفي عن المغيرة بن عبد الرحمن بن عون عن الحسين بن إسحاق التستري عن الطبراني","سالم عن ابن عمر"
"13264","13228  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ  ، ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِيُّ ،  ثَنَا  مُغِيرَةُ بْنُ سِقْلَابٍ ،  عَنِ  الْوَازِعِ بْنِ نَافِعٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا خَيْرَ فِي جَمَاعَةِ النِّسَاءِ وَلَا عِنْدَ مَيِّتٍ  ، فَإِنَّهُنَّ إِذَا اجْتَمَعْنَ قُلْنَ وَقُلْنَ  .","","Al-Mu'jam al-Kabir 13228","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الوازع بن نافع العقيلي عن مغيرة بن سقلاب الحراني عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","سالم عن ابن عمر"
"13265","[12/318]      13229  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الرَّاسِبِيُّ  ، ثَنَا  الْعَبَّاسُ بْنُ الْفَرَجِ الرِّيَاشِيُّ ، قَالَا :  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  أَبِي عُبَيْدَةَ مِنْ وَلَدِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَأَنْ يَمْتَلِئَ جَوْفُ أَحَدِكُمْ  قَيْحًا  حَتَّى  يَرِيَهُ  خَيْرٌ  لَهُ مِنْ أَنْ يَمْتَلِئَ شِعْرًا  .  وَنَسَبَ  مُحَمَّدُ بْنُ الْمُثَنَّى  أَبَا عُبَيْدَةَ  فَقَالَ :  أَبُو عَبْدِ اللهِ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ  .","","Al-Mu'jam al-Kabir 13229","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو عبيدة من ولد عبد الله بن عمر عن أبو عاصم النبيل عن عباس بن الفرج الرياشي عن محمد بن خالد الراسبي عن الطبراني","سالم عن ابن عمر"
"13266","13230  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  حَدَّثَنِي  أَبُو مَطَرٍ  أَنَّهُ : سَمِعَ  سَالِمَ بْنَ عَبْدِ اللهِ  يُحَدِّثُ عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا سَمِعَ الرَّعْدَ ، وَالصَّوَاعِقَ قَالَ : "" اللَّهُمَّ لَا تَقْتُلْنَا بِغَضَبِكَ  ، وَلَا تُهْلِكْنَا بِعَذَابِكَ ، وَعَافِنَا قَبْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 13230","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أبو مطر عن حجاج بن أرطاة عن عبد الواحد بن زياد عن حفص بن عمر الحوضى عن محمد بن محمد بن حيان التمار عن الطبراني","سالم عن ابن عمر"
"13267","13231  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ  ، ثَنَا  عُمَرُ بْنُ عَبْدِ الْمَلِكِ الْأَوْصَابِيُّ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدَةَ ،  ثَنَا  الْجَرَّاحُ بْنُ         [12/319]      مَلِيحٍ ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ ذِي حِمَايَةَ  ،  عَنْ  أَيُّوبَ - يَعْنِي السَّخْتِيَانِيَّ - ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِذَا صَلَّى رَفَعَ يَدَيْهِ حِينَ يَسْتَفْتِحُ  ، وَحِينَ يُكَبِّرُ لِلرُّكُوعِ ، وَحِينَ يَرْفَعُ رَأْسَهُ مِنَ الرُّكُوعِ  .  كذا في طبعة مكتبة ابن تيمية ونسخة أحمد الثالث ، والصواب : (إبراهيم بن عبد الحميد بن ذي حماية) كما في المعجم الأوسط ، وينظر مصدر الترجمة . والله أعلم .","","Al-Mu'jam al-Kabir 13231","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن أيوب السختياني عن إبراهيم بن عبد الحميد الرحبي عن الجراح بن مليح البهراني عن محمد بن عبيدة المددي عن عمر بن عبد الملك بن حكيم الحمصي عن إبراهيم بن محمد الطيان عن الطبراني","سالم عن ابن عمر"
"13268","13232  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْحَسَنِ الْعَطَّارُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنْ  رَجُلٍ يُقَالُ لَهُ الْقَاسِمُ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَمَّا مَاتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَظَرَ الْمُسْلِمُونَ خَيْرَهُمْ فَاسْتَخْلَفُوهُ  ، وَهُوَ  أَبُو بَكْرٍ  ، فَلَمَّا مَاتَ  أَبُو بَكْرٍ  نَظَرَ خَيْرَ الْمُسْلِمِينَ فَاسْتَخْلَفَهُ ، وَهُوَ  عُمَرُ  ، فَلَمَّا مَاتَ أَوْ قُتِلَ نَظَرَ الْمُسْلِمُونَ خَيْرَهُمْ فَاسْتَخْلَفُوهُ ، وَهُوَ  عُثْمَانُ  ، إِنْ تَقْتُلُوهُ فَائْتُونِي بِخَيْرٍ مِنْهِ ، وَاللهِ مَا أَرَى أَنْ تَفْعَلُوا  "" .  قَالَ أَبُو الْقَاسِمِ :  الْقَاسِمُ  هُوَ الَّذِي رَوَى عَنْهَ  قُرَّةُ بْنُ خَالِدٍ  هَذَا الْحَدِيثَ هُوَ  أَبُو نَهِيكٍ بَصْرِيٌّ هُوَ ابْنُ مُحَمَّدٍ  .","","Al-Mu'jam al-Kabir 13232","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن القاسم بن محمد الضبي عن قرة بن خالد السدوسي عن عبد الرحمن بن مهدي عن علي بن الحسن العطار عن زكريا بن يحيى السجزي عن الطبراني","سالم عن ابن عمر"
"13269","13233  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  كَثِيرُ بْنُ قُنْبُرٍ ، قَالَ : سَأَلْنَا  سَالِمَ بْنَ عَبْدِ اللهِ عَنْ صَلَاةِ أَبِيهِ فِي السَّفَرِ ،  وَأَخْبَرَنِي  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا حَضَرَ         [12/320]      أَحَدَكُمُ الْأَمْرُ يَخْشَى فَوْتَهُ فَلْيُصَلِّ هَذِهِ الصَّلَاةَ  -  يَعْنِي الْجَمْعَ بَيْنَ الصَّلَاتَيْنِ  - .","","Al-Mu'jam al-Kabir 13233","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن كثير بن قاروندا الكوفي عن يزيد بن زريع العيشي عن إسماعيل بن مسعود الجحدري عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","سالم عن ابن عمر"
"13270","13234  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ بْنِ حَفْصٍ الْأَنْصَارِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى السَّعْدِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا  نَحَلَ  وَالِدٌ وَلَدًا أَفْضَلَ مِنْ أَدَبٍ حَسَنٍ  .","","Al-Mu'jam al-Kabir 13234","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمرو بن دينار قهرمان آل الزبير عن محمد بن موسى السعدي عن محمد بن عبد الله بن حفص الأنصاري عن محمد بن صالح النرسي عن الطبراني","سالم عن ابن عمر"
"13271","13235  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ عَبْدَةَ الضَّبِّيُّ ،  ثَنَا  يَزِيدُ بْنُ أَبَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنِّي نَهَيْتُكُمْ عَنْ نَبِيذِ  الْجَرِّ  ، وَإِنِّي كُنْتُ نَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ ، وَإِنِّي كُنْتُ نَهَيْتُكُمْ عَنِ الْأَضَاحِيِّ ، أَلَا وَإِنَّ الْأَوْعِيَةَ لَا تَحِلُّ شَيْئًا وَلَا تُحَرِّمُهُ ، أَلَا وَزُورُوا الْقُبُورَ فَإِنَّهَا تُرِقُّ الْقُلُوبَ "" . زَادَ  عَبْدَانُ  فِي حَدِيثِهِ "" أَلَا وَإِنِّي نَهَيْتُكُمْ عَنْ لُحُومِ الْأَضَاحِيِّ فَكُلُوا ،  وَادَّخِرُوا  مَا شِئْتُمْ  .","","Al-Mu'jam al-Kabir 13235","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن يزيد بن أبان عن أحمد بن عبدة الضبي عن عبد الله بن أحمد الجواليقي عن الطبراني","سالم عن ابن عمر"
"13272","13236  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ  ، ثَنَا  سَعِيدُ بْنُ         [12/321]      سُلَيْمَانَ ،  ثَنَا  أَبُو الرَّبِيعِ السَّمَّانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طَعَامُ الِاثْنَيْنِ يَكْفِي الْأَرْبَعَةَ ، وَطَعَامُ الْأَرْبَعَةِ يَكْفِي الثَّمَانِيَةَ  فَاجْتَمِعُوا عَلَيْهِ ، وَلَا تَفَرَّقُوا عَنْهُ  .","","Al-Mu'jam al-Kabir 13236","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن أشعث السمان عن سعيد بن سليمان سعدويه عن الحسن بن علي بن الوليد الفسوي عن الطبراني","سالم عن ابن عمر"
"13273","13237  -  حَدَّثَنَا  أَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ ،  ثَنَا  وَهْبُ بْنُ مُحَمَّدٍ السَّامِيُّ  ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ  ،  حَدَّثَنِي  عَمْرُو بْنُ دِينَارٍ قَهْرَمَانُ آلِ الزُّبَيْرِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَأَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  رَجُلٍ  ، فَقَالَ : "" مَنْ يَعْرِفُهُ  ، فَقَالَ  رَجُلٌ  مِنْهُمْ : أَنَا ، قَالَ : "" اسْمُهُ ؟ "" قَالَ : لَا أَدْرِي ، قَالَ : "" مَا اسْمُ أَبِيهِ ؟ "" قَالَ : لَا أَدْرِي ، قَالَ : "" فَمَنْزِلُهُ ؟ "" قَالَ : لَا أَدْرِي ، قَالَ : "" لَيْسَتْ هَذِهِ بِمَعْرِفَةٍ حَتَّى تَعْرِفَ اسْمَهُ وَاسْمَ أَبِيهِ وَقَبِيلَتَهُ إِنْ مَرِضَ عُدْتَهُ ، وَإِنْ مَاتَ اتَّبَعْتَ جِنَازَتَهُ  .  في طبعة مكتبة ابن تيمية : ( محد السامي ) والمثبت من النسخة الخطية ، وينظر ( 16568 ) .  تصحفت في طبعة مكتبة ابن تيمية : ( سليان ) والمثبت من النسخة الخطية.","","Al-Mu'jam al-Kabir 13237","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمرو بن دينار قهرمان آل الزبير عن جعفر بن سليمان الضبعي عن وهب بن محمد السامي عن عبد الوارث بن إبراهيم العسكري عن الطبراني","سالم عن ابن عمر"
"13274","13238  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  عُقْبَةُ بْنُ أَبِي الصَّهْبَاءِ ، قَالَ :  سَمِعْتُ  سَالِمًا ، قَالَ :  حَدَّثَنِي  ابْنُ عُمَرَ  أَنَّهُ : كَانَ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسًا فِي نَفَرٍ مِنْ أَصْحَابِهِ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا هَؤُلَاءِ أَلَيْسَ تَعْلَمُونَ أَنِّي رَسُولُ اللهِ ؟ "" قَالُوا : بَلَى نَشْهَدُ أَنَّكَ رَسُولُ اللهِ  ، قَالَ : "" أَلَيْسَ تَعْلَمُونَ أَنَّ اللهَ أَنْزَلَ فِي كِتَابِهِ مَنْ أَطَاعَنِي فَقَدْ أَطَاعَ اللهَ ؟ "" فَقَالُوا : بَلَى نَشْهَدُ أَنَّهُ مَنْ أَطَاعَكَ فَقَدْ أَطَاعَ اللهَ ، وَأَنَّ مِنْ طَاعَةِ اللهِ طَاعَتَكَ ، قَالَ : "" وَطَاعَةُ اللهِ أَنْ تُطِيعُونِي ، وَإِنَّ مِنْ طَاعَتِي أَنْ تُطِيعُوا أَئِمَّتَكُمْ ، وَإِنْ صَلَّوْا قُعُودًا فَصَلُّوا قُعُودًا أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 13238","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عقبة بن أبي الصهباء البصري عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","سالم عن ابن عمر"
"13275","[12/322]      13239  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ، وَيَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَا :  ثَنَا  أَبُو صَدَقَةَ مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الْقَرَاطِيسِيُّ ،  حَدَّثَنِي  عُبَيْدُ بْنُ زِيَادٍ الْحَضْرَمِيُّ ،  قَالَ  :  لَقِيَ مَالِكُ بْنُ دِينَارٍ سَالِمَ بْنَ عَبْدِ اللهِ بْنِ عُمَرَ بْنِ الْخَطَّابِ وَهُوَ رَاكِبٌ عَلَى حِمَارٍ سَاقِطَةٍ أُذُنَاهُ رَثِّ السُّرُجِ وَالثِّيَابِ فَقَالَ لَهُ  سَالِمٌ  : مِمَّنِ الرَّجُلُ ؟ فَقَالَ : مِنْكَ وَإِلَيْكَ وَمِنْ بَعْضِ مَوَالِيكَ ، فَقَالَ : حَدِّثْنِي عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمُسْلِمَ أَخُو الْمُسْلِمِ لَا يَظْلِمُهُ ، وَلَا يَخُونُهُ  ، وَلَا  يُسْلِمُهُ  فِي مُصِيبَةٍ نَزَلَتْ بِهِ ، وَإِنْ تَلْفَ خِيَارَ الْعَرَبِ وَالْمَوَالِي ، يُحِبُّ بَعْضُهُمْ بَعْضًا حُبًّا لَا يَجِدُونَ مِنْ ذَلِكَ بُدًّا ، وَإِنْ تَلْفَ شِرَارَ الْفَرِيقَيْنِ ، يُبْغِضُ بَعْضُهُمْ بُغْضًا لَا يَجِدُونَ مِنْ ذَلِكَ بُدًّا  .","","Al-Mu'jam al-Kabir 13239","","سالم بن عبد الله بن عمر بن الخطاب عن مالك بن دينار الناجي عن عبيد بن زياد الحضرمي عن محمد بن عبد الأعلى بن موسى القراطيسي عن يحيى بن أيوب العلاف عن الطبراني","سالم عن ابن عمر"
"13276","13240  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا النَّاسُ  كَإِبِلٍ  مِائَةٍ يُلْتَمَسُ الرَّوَاحِلُ فِي النَّاسِ  فَلَا يُوجَدُ إِلَّا وَاحِدَةٌ  .","","Al-Mu'jam al-Kabir 13240","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","سالم عن ابن عمر"
"13277","13241  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزَبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  أَبِي  ، عَنْ  هَارُونَ بْنِ قَيْسٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَحِمَ اللهُ أَخِي  عَبْدَ اللهِ بْنَ رَوَاحَةَ  كَانَ أَيْنَمَا أَدْرَكَتْهُ الصَّلَاةُ أَنَاخَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (الغزي) كما عند المصنف في أحاديث أخرى .","","Al-Mu'jam al-Kabir 13241","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن هارون بن قيس عن همام بن نافع  الصنعاني والد عبد الرزاق عن عبد الرزاق الصنعاني عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","سالم عن ابن عمر"
"13278","[12/323]      13242  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  ثَنَا  الْفَضْلُ بْنُ عَطِيَّةَ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَوْمِ عِيدٍ فَبَدَأَ فَصَلَّى بِغَيْرِ أَذَانٍ  وَلَا إِقَامَةٍ ، ثُمَّ خَطَبَ  .","","Al-Mu'jam al-Kabir 13242","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الفضل بن عطية المروزي عن حصين بن نمير الأنصاري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سالم عن ابن عمر"
"13279","13243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  ثَنَا  هُشَيْمٌ ،  ثَنَا  الْفَضْلُ بْنُ عَطِيَّةَ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ إِذَا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ ، وَإِذَا رَكَعَ  ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، وَلَا يُجَاوِزُ بِهِمَا أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 13243","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الفضل بن عطية المروزي عن هشيم بن بشير عن جندل بن والق التغلبي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سالم عن ابن عمر"
"13280","[  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ  ، عَنْ أَبِيهِ ]  13244  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَبُو الْأَسْوَدِ النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ : "" رَأَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى الْبَعِيرِ حَيْثُ تَوَجَّهَ بِهِ  .","","Al-Mu'jam al-Kabir 13244","","عبد الله بن عمر بن الخطاب عن عبيد الله بن عبد الله بن عمر بن الخطاب عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","عبيد الله بن عبد الله عن أبيه"
"13281","13245  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنِي  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  أَبُو الْأَسْوَدِ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّ  عُبَيْدَ اللهِ بْنَ عَبْدِ اللهِ بْنِ عُمَرَ  حَدَّثَهُ  عَنْ  أَبِيهِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  تَصَدَّقَ  عَلَى  رَجُلٍ  بِفَرَسٍ فِي  سَبِيلِ  اللهِ فَوَجَدَهُ  عُمَرُ  يَبِيعُهَا ، فَأَتَى إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ إِنِّي تَصَدَّقْتُ عَلَى فُلَانٍ بِفَرَسٍ ، وَإِنِّي وَجَدْتُهُ يَبِيعُهَا         [12/324]      أَفَأَشْتَرِيهَا ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَشْتَرِهَا ، وَلَا تَعُدْ فِي صَدَقَتِكَ  .  في طبعة مكتبة ابن تيمية : ( أبو الأسود عن محمد ) والمثبت من نسخة أحمد الثالث ، وينظر ترجمته في التهذيبين .","","Al-Mu'jam al-Kabir 13245","","عبد الله بن عمر بن الخطاب عن عبيد الله بن عبد الله بن عمر بن الخطاب عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","عبيد الله بن عبد الله عن أبيه"
"13282","13246  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ  ، ثَنَا  أَبُو الطَّاهِرِ بْنُ السَّرْحِ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  خَالِي ،  عَنْ  عُقَيْلٍ ، عَنِ ابْنِ شِهَابٍ  أَخْبَرَهُ  ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  أَنَّهُ : سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَفَاتِحُ الْغَيْبِ خَمْسٌ  ثُمَّ يَتْلُو هَذِهِ الْآيَةَ :         {      إِنَّ اللهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَـزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللهَ عَلِيمٌ خَبِيرٌ         }      .","","Al-Mu'jam al-Kabir 13246","","عبد الله بن عمر بن الخطاب عن عبيد الله بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن عبد الرحمن بن عبد الحميد المكفوف عن أحمد بن عمرو بن بن السرح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","عبيد الله بن عبد الله عن أبيه"
"13283","13247  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  :  أَنَّ نَاسًا أَغَارُوا عَلَى إِبِلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاسْتَاقُوهَا  ، وَارْتَدُّوا عَنِ الْإِسْلَامِ ، وَقَتَلُوا  رَاعِيَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُؤْمِنًا ، فَبَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي آثَارِهِمْ ، فَأُخِذُوا فَقَطَعَ أَيْدِيَهُمْ وَأَرْجُلَهُمْ ،  وَسَمَلَ  أَعْيُنَهُمْ  .  يُقَالُ : هَذَا  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ  ، وَيُقَالُ :  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  ، وَاللهُ أَعْلَمُ ""  .","","Al-Mu'jam al-Kabir 13247","","عبد الله بن عمر بن الخطاب عن عبيد الله بن عبد الله بن عمر بن الخطاب عن أبو الزناد عن سعيد بن أبي هلال الليثي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عبيد الله بن عبد الله عن أبيه"
"13284","13248  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي         [12/325]      الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  يَحْيَى بْنُ غَيْلَانَ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  إِنَّمَا  سَمَلَ  النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْيُنَ  الْعُرَنِيِّينَ  لِأَنَّهُمْ  سَمَلُوا  أَعْيُنَ الرُّعَاةِ  .","","Al-Mu'jam al-Kabir 13248","","أنس بن مالك عن سليمان بن طرخان عن يزيد بن زريع العيشي عن يحيى بن غيلان عن الفضل بن سهل الخراساني عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن عبد الله عن أبيه"
"13285","[  حَمْزَةُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ  ، عَنْ أَبِيهِ ]  13249  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى (  ح  ) .  وَحَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ  ، ثَنَا  آدَمُ (  ح  ) .  وَحَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالُوا :  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  عُتْبَةَ بْنِ مُسْلِمٍ ،  عَنْ  حَمْزَةَ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الطِّيَرَةُ فِي الْمَسْكَنِ ، وَالْمَرْأَةِ ، وَالْفَرَسِ  .","","Al-Mu'jam al-Kabir 13249","","عبد الله بن عمر بن الخطاب عن حمزة بن عبد الله بن عمر بن الخطاب عن عتبة بن أبي عتبة المدني عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","حمزة بن عبد الله بن عمر عن أبيه"
"13286","13250  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  حَمْزَةَ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَتْ تَحْتِي  امْرَأَةٌ  كُنْتُ أُحِبُّهَا ، وَكَانَ أَبِي يَكْرَهُهَا فَأَمَرَنِي بِطَلَاقِهَا ، فَأَبَيْتُ فَذَكَرَ ذَلِكَ  عُمَرُ         [12/326]      لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَبْدَ اللهِ  طَلِّقْهَا  .","","Al-Mu'jam al-Kabir 13250","","عبد الله بن عمر بن الخطاب عن حمزة بن عبد الله بن عمر بن الخطاب عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","حمزة بن عبد الله بن عمر عن أبيه"
"13287","[  بِلَالُ بْنُ عَبْدِ اللهِ  ، عَنْ أَبِيهِ ]  13251  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  عُرَابِيُّ بْنُ مُعَاوِيَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ السِّبَئِيِّ ،  حَدَّثَنِي  بِلَالُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ  أَنَّ  أَبَاهُ عَبْدَ اللهِ بْنَ عُمَرَ قَالَ يَوْمًا : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَمْنَعُوا النِّسَاءَ حُظُوظَهُنَّ مِنَ الْمَسَاجِدِ  ، فَقُلْتُ : أَمَّا أَنَا فَسَأَمْنَعُ أَهْلِي ، فَمَنْ شَاءَ فَلْيُسَرِّحْ أَهْلَهُ فَالْتَفَتَ إِلَيَّ ، فَقَالَ فَقَالَ : "" لَعَنَكَ اللهُ ، لَعَنَكَ اللهُ ، لَعَنَكَ اللهُ ، تَسْمَعُنِي أَقُولُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ أَنْ لَا يُمْنَعْنَ ، وَتَقُولُ هَذَا ، ثُمَّ بَكَى ، وَقَامَ مُغْضَبًا  .","","Al-Mu'jam al-Kabir 13251","","عبد الله بن عمر بن الخطاب عن بلال بن عبد الله بن عمر بن الخطاب العدوي عن عبد الله بن هبيرة السبئي عن عرابي بن معاوية الحضرمي عن يحيى بن عبد الله بن بكير المخزومي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","بلال بن عبد الله عن أبيه"
"13288","13252  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ،  حَدَّثَنِي  كَعْبُ بْنُ عَلْقَمَةَ ،  عَنْ  بِلَالِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ بْنِ الْخَطَّابِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَا تَمْنَعُوا النِّسَاءَ حُظُوظَهُنَّ مِنَ الْمَسَاجِدِ  إِذَا اسْتَأْذَنَكُمْ "" فَقَالَ  بِلَالٌ  : وَاللهِ لَنَمْنَعُهُنَّ ، فَقَالَ عَبْدُ اللهِ : "" يَا عَدُوَّ اللهِ أَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَقُولُ لَنَمْنَعُهُنَّ  "" .","","Al-Mu'jam al-Kabir 13252","","عبد الله بن عمر بن الخطاب عن بلال بن عبد الله بن عمر بن الخطاب العدوي عن كعب بن علقمة بن كعب عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","بلال بن عبد الله عن أبيه"
"13289","[12/327]      [  أَبَانُ بْنُ عُثْمَانَ  ، عَنِ  ابْنِ عُمَرَ  ]  13253  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ عُمَرَ بْنِ أَبَانَ بْنِ عُثْمَانَ ،  ثَنَا  أَبِي عُمَرُ بْنُ أَبَانَ ،  عَنْ  أَبِيهِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ  يَقُولُ :  بَيْنَمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسٌ  وَعَائِشَةُ  وَرَاءَهُ إِذِ اسْتَأْذَنَ  أَبُو بَكْرٍ  فَدَخَلَ ، ثُمَّ اسْتَأْذَنَ  عُمَرُ  فَدَخَلَ ، ثُمَّ  سَعْدُ بْنُ مَالِكٍ  فَدَخَلَ ، ثُمَّ اسْتَأْذَنَ  عُثْمَانُ بْنُ عَفَّانَ  وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَحَدَّثُ كَاشِفًا عَنْ رُكْبَتِهِ فَمَدَّ ثَوْبَهُ عَلَى رُكْبَتِهِ حِينَ اسْتَأْذَنَ  عُثْمَانُ  ، وَقَالَ لِامْرَأَتِهِ : اسْتَأْخِرِي ، فَتَحَدَّثُوا سَاعَةً ثُمَّ خَرَجُوا ، فَقَالَتْ  عَائِشَةُ  : يَا نَبِيَّ اللهِ ، دَخَلَ أَبِي وَأَصْحَابُهُ فَلَمْ تُصْلِحْ ثَوْبَكَ عَنْ رُكْبَتِكَ ، وَلَمْ تُؤَخِّرْنِي عَنْكَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَائِشَةُ  أَلَا أَسْتَحِي مِنْ رَجُلٍ تَسْتَحِي مِنْهُ الْمَلَائِكَةُ  ، وَالَّذِي نَفْسُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِيَدِهِ إِنَّ الْمَلَائِكَةَ لَتَسْتَحْيِي مِنْ  عُثْمَانَ  كَمَا تَسْتَحِي مِنَ اللهِ وَرَسُولِهِ ، وَلَوْ دَخَلَ وَأَنْتِ قَرِيبٌ مِنِّي لَمْ يَتَحَدَّثْ ، وَلَمْ يَرْفَعْ رَأْسَهُ حَتَّى يَخْرُجَ  .","","Al-Mu'jam al-Kabir 13253","","عبد الله بن عمر بن الخطاب عن أبان بن عثمان بن عفان عن عمر بن أبان بن عثمان بن عفان عن إبراهيم بن عمر بن أبان البصري عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبان بن عثمان عن ابن عمر"
"13290","13254  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عُمَرَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ فِي حَائِطٍ فَاسْتَأْذَنَ  أَبُو بَكْرٍ  ، فَقَالَ : ائْذَنْ لَهُ وَبَشِّرْهُ         [12/328]      بِالْجَنَّةِ  ، ثُمَّ اسْتَأْذَنَ  عُمَرُ  فَقَالَ : ائْذَنْ لَهُ ، وَبَشِّرْهُ بِالْجَنَّةِ وَبِالشَّهَادَةِ ، ثُمَّ اسْتَأْذَنَ  عُثْمَانُ  ، فَقَالَ : ائْذَنْ لَهُ ، وَبَشِّرْهُ بِالْجَنَّةِ وَبِالشَّهَادَةِ  .","","Al-Mu'jam al-Kabir 13254","","عبد الله بن عمر بن الخطاب عن أبان بن عثمان بن عفان عن عمر بن أبان بن عثمان بن عفان عن إبراهيم بن عمر بن أبان البصري عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبان بن عثمان عن ابن عمر"
"13291","[  مُحَمَّدُ بْنُ عَلِيٍّ  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ]  13255  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ أَبِي يَعْقُوبَ الْكَرْمَانِيُّ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  ثَنَا  أَبُو جَعْفَرٍ يَعْنِي مُحَمَّدَ بْنَ عَلِيِّ بْنِ الْحُسَيْنِ بْنِ عَلِيٍّ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَمْنَعُوا نِسَاءَكُمْ أَنْ يَأْتِينَ الْمَسَاجِدَ  .","","Al-Mu'jam al-Kabir 13255","","عبد الله بن عمر بن الخطاب عن أبو جعفر الباقر عن عبد الغفار بن القاسم الأنصاري عن يحيى بن أبي بكير عن عبد الله بن يعقوب الكرماني عن عبد الله بن أحمد الجواليقي عن الطبراني","محمد بن علي عن عبد الله بن عمر"
"13292","[  مُوسَى بْنُ طَلْحَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ]  13256  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  حَدَّثَنِي  عَمِّي مُوسَى بْنُ طَلْحَةَ ،  قَالَ  :  سَايَرْتُ ابْنَ عُمَرَ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  ، فَلَمْ يَكُنْ يَزِيدُ عَلَى رَكْعَتَيْنِ  ، لَمْ يُصَلِّ قَبْلَهَا وَلَا بَعْدَهَا ، وَقَالَ : "" أُصَلِّي كَمَا رَأَيْتُ أَصْحَابِي يُصَلُّونَ ، وَمَا أَنَا بِمَانِعٍ أَحَدًا يَسْتَزِيدُ مِنْ خَيْرٍ إِنْ أَرَادَهُ  ""  .","","Al-Mu'jam al-Kabir 13256","","عبد الله بن عمر بن الخطاب عن موسى بن طلحة بن عبيد الله التيمي عن طلحة بن يحيى بن طلحة التيمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","موسى بن طلحة عن عبد الله بن عمر"
"13293","[12/329]      [  عِيسَى بْنُ طَلْحَةَ  ، عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ]  13257  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عَمِّهِ عِيسَى بْنِ طَلْحَةَ ،  قَالَ  :  صَحِبْتُ ابْنَ عُمَرَ فِي السَّفَرِ ، وَكَانَ لَا يَزِيدُ عَلَى رَكْعَتَيْنِ  ، وَيَقُومُ بَنُوهُ وَأَصْحَابُهُ يَتَطَوَّعُونَ ، فَقُلْتُ : مَا لَكَ لَا تَطَوَّعُ ؟ قَالَ : "" إِنَّمَا أَصْنَعُ كَمَا رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ  .","","Al-Mu'jam al-Kabir 13257","","عبد الله بن عمر بن الخطاب عن عيسى بن طلحة التيمي عن طلحة بن يحيى بن طلحة التيمي عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","عيسى بن طلحة عن عبد الله بن عمر"
"13294","[  عُرْوَةُ بْنُ الزُّبَيْرِ  ، عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  ]  13258  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا مَالَ حَاجِبُ الشَّمْسِ فَأَخِّرُوا الصَّلَاةَ حَتَّى تَبْرُزَ  ، وَإِذَا غَابَ حَاجِبُ الشَّمْسِ ، فَأَخِّرُوا الصَّلَاةَ حَتَّى تَغِيبَ  .","","Al-Mu'jam al-Kabir 13258","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13295","13259  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا  تَحَرَّوْا  بِصَلَاتِكُمْ طُلُوعَ الشَّمْسِ  ، وَلَا غُرُوبَهَا ، فَإِنَّهَا تَطْلُعُ بِقَرْنَيْ  شَيْطَانٍ  .","","Al-Mu'jam al-Kabir 13259","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13296","[12/330]      13260  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  ثَنَا  سُلَيْمَانُ بْنُ حَيَّانَ أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ  وَأَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  شَطْرًا  مِنْ إِمَارَتِهِ  .","","Al-Mu'jam al-Kabir 13260","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سليمان بن حيان الأحمر عن عمرو بن محمد بن بكير عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13297","13261  -  حَدَّثَنَا  إِسْحَاقُ بْنُ خَالَوَيْهِ الْوَاسِطِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا أَعْطَى أَهْلُ بَيْتٍ  الرِّفْقَ  إِلَّا نَفَعَهُمْ  .","","Al-Mu'jam al-Kabir 13261","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن إسحاق بن خالويه البابسيري عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13298","13262  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمَيِّتَ  يُعَذَّبُ  بِبُكَاءِ أَهْلِهِ  .","","Al-Mu'jam al-Kabir 13262","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن عبد الله بن عمر مشكدانة عن عبد الله بن الصباح الأصبهاني عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13299","13263  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الصَّبَّاحِ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَفَ عَلَى  قَلِيبِ بَدْرٍ  ، فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 13263","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن عبد الله بن عمر مشكدانة عن عبد الله بن الصباح الأصبهاني عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13300","[12/331]      13264  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  عُرْوَةَ ،  قَالَ  :  قُلْتُ لِعَبْدِ اللهِ بْنِ عُمَرَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّا نَدْخُلُ عَلَى الْأُمَرَاءِ فَيَقْضِي أَحَدُهُمْ بِالْقَضَاءِ جَوْرًا  ، فَنَقُولُ : وَفَّقَكَ اللهُ وَيَنْظُرُ إِلَى الرَّجُلِ مِنَّا فَيُثْنِي عَلَيْهِ ، فَقَالَ : "" أَمَّا نَحْنُ مَعْشَرَ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكُنَّا نَعُدُّهُ نِفَاقًا ، فَمَا أَدْرِي مَا تَعُدُّونَهُ أَنْتُمْ ؟  "" .","","Al-Mu'jam al-Kabir 13264","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13301","13265  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ هَارُونَ الْقَزَّازُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَبْدِ اللهِ بْنِ خَارِجَةَ بْنِ زَيْدِ بْنِ ثَابِتٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  قَالَ  :  أَتَيْتُ ابْنَ عُمَرَ فَقُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّا نَجْلِسُ إِلَى الْأُمَرَاءِ فَيَتَكَلَّمُونَ بِالْكَلَامِ  ، وَنَحْنُ نَعْلَمُ أَنَّ الْحَقَّ غَيْرُهُ فَنُصَدِّقُهُمْ ، وَيَقْضُونَ بِالْجَوْرِ فَنُقَوِّيهِمْ عَلَيْهِ ، وَنُحَسِّنُهُ لَهُمْ ، فَكَيْفَ تَرَى فِي ذَلِكَ ؟ فَقَالَ : "" يَا ابْنَ أَخِي كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَعُدُّ هَذَا النِّفَاقَ  "" .","","Al-Mu'jam al-Kabir 13265","","عبد الله بن عمر بن الخطاب عن عروة بن الزبير عن عبد الله بن خارجة الأنصاري عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن أحمد بن يزيد بن عبد الله الجمحي عن الطبراني","عروة بن الزبير عن عبد الله بن عمر"
"13302","[  مُصْعَبُ بْنُ سَعْدٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13266  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ ،  قَالَ  :  دَخَلَ ابْنُ عُمَرَ عَلَى  عَبْدِ اللهِ بْنِ عَامِرٍ  يَعُودُهُ ، فَقَالَ : يَا  ابْنَ عُمَرَ  أَلَا تَدْعُو         [12/332]      لِي ؟ فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ لَا يَقْبَلُ صَلَاةً بِغَيْرِ  طُهُورٍ  ، وَلَا صَدَقَةً مِنْ غُلُولٍ "" وَقَدْ كُنْتُ عَلَى  الْبَصْرَةِ  .","","Al-Mu'jam al-Kabir 13266","","عبد الله بن عمر بن الخطاب عن مصعب بن سعد بن أبي وقاص عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","مصعب بن سعد عن ابن عمر"
"13303","[  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  ، عَنِ  ابْنِ عُمَرَ  ]  13267  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّقِّيُّ  ،  ثَنَا  خَالِدُ بْنُ حَيَّانَ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي دَاوُدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  صَلَّيْتُ مَعَ نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْخَوْفِ فَصَفَّ وَرَاءَهُ طَائِفَةً مِنَّا  ، وَأَقْبَلَتْ طَائِفَةٌ عَلَى الْعَدُوِّ فَكَبَّرَ ثُمَّ رَكَعَ بِهِمْ وَسَجَدَ سَجْدَتَيْنِ ، ثُمَّ انْصَرَفَتِ الطَّائِفَةُ الَّتِي مَعَهُ فَأَقْبَلُوا عَلَى الْعَدُوِّ وَجَاءَتِ الطَّائِفَةُ الْأُخْرَى فَصَفُّوا وَرَاءَهُ ، ثُمَّ سَلَّمَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَامَ كُلُّ رَجُلٍ مِنَ الطَّائِفَتَيْنِ فَقَضَى لِنَفْسِهِ رَكْعَةً وَسَجْدَتَيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : ( علي بن معبد ) .","","Al-Mu'jam al-Kabir 13267","","عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن الزهري عن سليمان بن أبي داود الحراني بومة عن خالد بن حيان الرقي عن علي بن معبد العبدي عن يحيى بن عثمان بن صالح عن الطبراني","أبو سلمة بن عبد الرحمن عن ابن عمر"
"13304","13268  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ أَنَّ ابْنَ عُمَرَ  حَدَّثَهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ مُسْكِرٍ خَمْرٌ وَكُلُّ مُسْكِرٍ حَرَامٌ  .","","Al-Mu'jam al-Kabir 13268","","عبد الله بن عمر بن الخطاب عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","أبو سلمة بن عبد الرحمن عن ابن عمر"
"13305","[  عَطَاءُ بْنُ يَسَارٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13269  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا         [12/333]      عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى عَلَيَّ صَلَاةً صَلَّى اللهُ عَلَيْهِ بِهَا عَشْرًا  .","","Al-Mu'jam al-Kabir 13269","","عبد الله بن عمر بن الخطاب عن عطاء بن يسار الهلالي عن شريك بن عبد الله بن أبي نمر الكناني عن عبد الرحمن بن أبي الزناد عن يحيى بن عبد الحميد عن موسى بن هارون الحمال عن الطبراني","عطاء بن يسار عن ابن عمر"
"13306","[  سُلَيْمَانُ بْنُ يَسَارٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13270  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  قَالَ  :  أَتَيْتُ ابْنَ عُمَرَ وَهُوَ جَالِسٌ عَلَى  الْبَلَاطِ  وَنَاسٌ يُصَلُّونَ فَقُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  أَلَا تُصَلِّي ؟ فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تُصَلِّي صَلَاةً فِي الْيَوْمِ مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 13270","","عبد الله بن عمر بن الخطاب عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمرو بن شعيب عن حسين المعلم عن عباد بن العوام الكلابي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سليمان بن يسار عن ابن عمر"
"13307","[  سَعِيدُ بْنُ يَسَارٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13271  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مَالِكٌ (  ح  ) .         [12/334]      وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَنَا  مَالِكٌ ،  عَنْ  أَبِي بَكْرِ بْنِ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ أَنَّهُ قَالَ :  كُنْتُ أَسِيرُ مَعَ ابْنِ عُمَرَ بِطَرِيقِ  مَكَّةَ  ، قَالَ  سَعِيدٌ  : فَلَمَّا خَشِيتُ الصُّبْحَ نَزَلْتُ فَأَوْتَرْتُ ، قَالَ  عَبْدُ اللهِ  : "" أَلَيْسَ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ ؟ قُلْتُ : بَلَى ، قَالَ :  فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُوتِرُ عَلَى الْبَعِيرِ  .","","Al-Mu'jam al-Kabir 13271","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن أبو بكر بن عمر بن عبد الرحمن بن عبد الله بن عمر بن الخطاب عن مالك بن أنس عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","سعيد بن يسار عن ابن عمر"
"13308","13272  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارِهِ تَطَوُّعًا وَهُوَ يَمْضِي إِلَى  خَيْبَرَ  .","","Al-Mu'jam al-Kabir 13272","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سعيد بن يسار عن ابن عمر"
"13309","13273  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ (  ح  ) .  وَحَدَّثَنِي  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مَالِكٌ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارِهِ وَهُوَ مُتَوَجِّهٌ إِلَى  خَيْبَرَ  .","","Al-Mu'jam al-Kabir 13273","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن مالك بن أنس عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","سعيد بن يسار عن ابن عمر"
"13310","13274  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  حَدَّثَنِي  سَعِيدُ بْنُ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يُصَلِّي وَهُوَ عَلَى حِمَارٍ وَهُوَ مُتَوَجِّهٌ إِلَى  خَيْبَرَ  ""  قَالَ  عَمْرُو بْنُ يَحْيَى  : ""  وَهُوَ وَجْهَ  الشَّامِ  "" .","","Al-Mu'jam al-Kabir 13274","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","سعيد بن يسار عن ابن عمر"
"13311","[12/335]      13275  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  عَمْرُو بْنُ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يُصَلِّي عَلَى حِمَارِهِ وَحِمَارُهُ مُتَوَجِّهٌ  إِلَى  خَيْبَرَ  يُومِئُ  إِيمَاءً  .","","Al-Mu'jam al-Kabir 13275","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سعيد بن يسار عن ابن عمر"
"13312","13276  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  عَمْرِو بْنِ يَحْيَى الْمَازِنِيِّ ،  حَدَّثَنِي  سَعِيدُ بْنُ يَسَارٍ مَوْلَى شُقْرَانَ مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارٍ مُتَوَجِّهًا إِلَى  خَيْبَرَ  .","","Al-Mu'jam al-Kabir 13276","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","سعيد بن يسار عن ابن عمر"
"13313","13277  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  مُوسَى بْنُ دَاوُدَ الضَّبِّيُّ ،  ثَنَا  مِنْدَلٌ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي عَلَى حِمَارٍ ، وَهُوَ مُتَوَجِّهٌ إِلَى  خَيْبَرَ  .","","Al-Mu'jam al-Kabir 13277","","عبد الله بن عمر بن الخطاب عن سعيد بن يسار مولى ميمونة زوج رسول الله عن عمرو بن يحيى بن عمارة المازني عن مندل بن علي عن موسى بن داود الخلقاني عن بشر بن موسى بن صالح الأسدي عن الطبراني","سعيد بن يسار عن ابن عمر"
"13314","[  مُسْلِمُ بْنُ جُنْدُبٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13278  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَبُو مَرْوَانَ الْعُثْمَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُسْلِمِ بْنِ جُنْدُبٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ مَاتَ مُفَارِقًا لِلْجَمَاعَةِ مَاتَ  مِيتَةً  جَاهِلِيَّةً  .","","Al-Mu'jam al-Kabir 13278","","عبد الله بن عمر بن الخطاب عن مسلم بن جندب الهذلي عن عبد الله بن مسلم بن جندب الهذلي عن محمد بن عثمان بن خالد القرشي عن موسى بن هارون الحمال عن الطبراني","مسلم بن جندب عن ابن عمر"
"13315","[12/336]      13279  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ (  ح  ) .  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَبِي  ، قَالَا :  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مُسْلِمِ بْنِ جُنْدُبٍ ،  عَنْ  أَبِيهِ  أَنَّهُ : دَخَلَ مَعَ عَبْدِ اللهِ بْنِ عُمَرَ عَلَى  ابْنِ مُطِيعٍ  فَقَالَ : السَّلَامُ عَلَيْكَ ، فَقَالَ : وَعَلَيْكَ السَّلَامُ وَرَحْمَةُ اللهِ ، وَمَرْحَبًا ، وَأَهْلًا  بِأَبِي عَبْدِ الرَّحْمَنِ  ، ضَعُوا لَهُ وِسَادَةً ، فَقَالَ  ابْنُ عُمَرَ  : لَوْلَا أَنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ثَلَاثٌ لَا يُرَدُّ : اللَّبَنُ ، وَلَا الْوِسَادَةُ ، وَلَا الدُّهْنُ  مَا جَلَسْتُ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 13279","","عبد الله بن عمر بن الخطاب عن مسلم بن جندب الهذلي عن عبد الله بن مسلم بن جندب الهذلي عن محمد بن إسماعيل بن مسلم الديلي عن هارون بن عبد الله بن مروان الحمال عن موسى بن هارون الحمال عن الطبراني","مسلم بن جندب عن ابن عمر"
"13316","[  مُسْلِمٌ الْخَيَّاطُ  ، عَنِ  ابْنِ عُمَرَ  ]  13280  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  مُسْلِمٍ الْخَيَّاطِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُتَلَقَّى الْأَجْلَابُ ، وَلَا يَبِيعَ  حَاضِرٌ  لِبَادٍ  ، وَلَا  يَخْطُبَ  أَحَدُكُمْ عَلَى خِطْبَةِ أَخِيهِ حَتَّى يَنْكِحَ أَوْ يَدَعَ  .","","Al-Mu'jam al-Kabir 13280","","عبد الله بن عمر بن الخطاب عن مسلم بن أبي مسلم الخياط عن محمد بن عبد الرحمن بن المغيرة عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","مسلم الخياط عن ابن عمر"
"13317","[12/337]      [  حَكِيمُ بْنُ أَبِي حُرَّةَ الْأَسْلَمِيُّ  ، عَنِ  ابْنِ عُمَرَ  ]  13281  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  حَدَّثَنِي  حَكِيمُ بْنُ أَبِي حُرَّةَ الْأَسْلَمِيُّ ،  أَنَّهُ : سَمِعَ  رَجُلًا يَسْأَلُ عَبْدَ اللهِ بْنَ عُمَرَ عَنْ رَجُلٍ نَذَرَ أَنْ لَا يَأْتِيَ عَلَيْهِ يَوْمٌ سَمَّاهُ إِلَّا وَهُوَ صَائِمٌ فِيهِ ، فَوَافَقَ ذَلِكَ يَوْمَ أَضْحَى أَوْ يَوْمَ فِطْرٍ ، فَقَالَ  ابْنُ عُمَرَ  : لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ ،  لَمْ يَكُنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ يَوْمَ الْأَضْحَى  ، وَلَا يَوْمَ الْفِطْرِ ، وَلَا يَأْمُرُ بِصِيَامِهِمَا  "" .","","Al-Mu'jam al-Kabir 13281","","عبد الله بن عمر بن الخطاب عن حكيم بن أبي حرة الأسلمي عن موسى بن عقبة عن فضيل بن سليمان النميري عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حكيم بن أبي حرة الأسلمي عن ابن عمر"
"13318","13282  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  حَكِيمٍ ، قَالَ  سَمِعْتُ  رَجُلًا يَسْتَفْتِي ابْنَ عُمَرَ فِي رَجُلٍ نَذَرَ نَذْرًا فِي يَوْمٍ مِنَ الْأَيَّامِ أَنْ لَا يَمُرَّ بِهِ ذَلِكَ الْيَوْمُ إِلَّا وَهُوَ صَائِمٌ فَوَافَقَ ذَلِكَ الْيَوْمُ يَوْمَ الْأَضْحَى أَوْ يَوْمَ فِطْرٍ ، فَقَالَ لَهُ  ابْنُ عُمَرَ  : لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُسْوَةٌ حَسَنَةٌ ، ثُمَّ قَالَ :  لَمْ يَكُنْ يَصُومُ يَوْمَ فِطْرٍ ، وَلَا يَوْمَ أَضْحَى  ، وَلَا يَرَى صِيَامَهُ حَقًّا  .","","Al-Mu'jam al-Kabir 13282","","عبد الله بن عمر بن الخطاب عن حكيم بن أبي حرة الأسلمي عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","حكيم بن أبي حرة الأسلمي عن ابن عمر"
"13319","[  وَهْبُ بْنُ كَيْسَانَ  ، عَنِ  ابْنِ عُمَرَ  ]  13283  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا         [12/338]      عَبْدُ اللهِ بْنُ نَافِعٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُشَدُّ الرِّحَالُ إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ  مَسْجِدِ الْحَرَامِ  ،  وَمَسْجِدِ الْمَدِينَةِ  ،  وَمَسْجِدِ بَيْتِ الْمَقْدِسِ  .","","Al-Mu'jam al-Kabir 13283","","عبد الله بن عمر بن الخطاب عن وهب بن كيسان القرشي عن عبد الله بن عمر العمري عن عبد الله بن نافع الصائغ عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","وهب بن كيسان عن ابن عمر"
"13320","13284  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ، عَنْ وَهْبِ بْنِ كَيْسَانَ ،  أَخْبَرَهُ  - وَقَدْ كَانَ  وَهْبٌ  أَدْرَكَ  عَبْدَ اللهِ بْنَ عُمَرَ  - :  أَنَّ  ابْنَ عُمَرَ رَأَى رَاعِيًا وَغَنَمًا فِي مَكَانٍ قَبِيحٍ ، وَقَدْ رَأَى  ابْنُ عُمَرَ  مَكَانًا أَمْثَلَ مِنْهُ ، فَقَالَ  ابْنُ عُمَرَ  : وَيْحَكَ يَا رَاعِي حَوِّلْهَا ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كُلُّ رَاعٍ مَسْئُولٌ عَنْ رَعِيَّتِهِ  .","","Al-Mu'jam al-Kabir 13284","","عبد الله بن عمر بن الخطاب عن وهب بن كيسان القرشي عن محمد بن عجلان عن بكر بن مضر المصري عن عمرو بن خالد بن فروخ عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","وهب بن كيسان عن ابن عمر"
"13321","13285  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّمَا أَجَلُكُمْ فِيمَا خَلَا مِنَ الْأُمَمِ كَمَا بَيْنَ صَلَاةِ الْعَصْرِ  إِلَى مَغْرِبِ الشَّمْسِ  .","","Al-Mu'jam al-Kabir 13285","","عبد الله بن عمر بن الخطاب عن وهب بن كيسان القرشي عن مالك بن أنس عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","وهب بن كيسان عن ابن عمر"
"13322","[  بُسْرُ بْنُ سَعِيدٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13286  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ أَنَّ بُكَيْرَ بْنَ عَبْدِ اللهِ بْنِ         [12/339]      الْأَشَجِّ  حَدَّثَهُ  ،  عَنْ  بُسْرِ بْنِ سَعِيدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ مُسْتَرْعًى مَسْئُولٌ عَمَّا اسْتُرْعِيَ  حَتَّى إِنَّ الرَّجُلَ لَيُسْأَلُ عَنْ زَوْجِهِ وَعَبْدِهِ وَوَلَدِهِ  .  تصحفت في طبعة مكتبة ابن تيمية : ( الأشبح ) .","","Al-Mu'jam al-Kabir 13286","","عبد الله بن عمر بن الخطاب عن بسر بن سعيد المدني عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","بسر بن سعيد عن ابن عمر"
"13323","[  عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ سُرَاقَةَ  ، عَنِ  ابْنِ عُمَرَ  ]  13287  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ سُرَاقَةَ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ الثِّمَارِ حَتَّى تَذْهَبَ  الْعَاهَةُ  .  قَالَ  ابْنُ سُرَاقَةَ  :  مَتَى ذَاكَ يَا أَبَا عَبْدِ الرَّحْمَنِ ؟ قَالَ : "" طُلُوعَ  الثُّرَيَّا  .","","Al-Mu'jam al-Kabir 13287","","عبد الله بن عمر بن الخطاب عن عثمان بن عبد الله بن سراقة القرشي عن محمد بن عبد الرحمن بن المغيرة عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عثمان بن عبد الله بن سراقة عن ابن عمر"
"13324","[  عَوْنُ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  ، عَنِ  ابْنِ عُمَرَ  ]  13288  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ  أَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ أَنَّ عَوْنَ بْنَ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  قَالَ  :  صَلَّى رَجُلٌ إِلَى جَنْبِ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ  فَسَمِعَهُ حِينَ سَلَّمَ يَقُولُ :  أَنْتَ السَّلَامُ ، وَمِنْكَ السَّلَامُ تَبَارَكْتَ يَا ذَا  الْجَلَالِ  وَالْإِكْرَامِ  ، ثُمَّ صَلَّى إِلَى جَنْبِ  عَبْدِ اللهِ بْنِ عُمَرَ  فَسَمِعَهُ حِينَ سَلَّمَ يَقُولُ مِثْلَ ذَلِكَ ، فَضَحِكَ الرَّجُلُ ، فَقَالَ لَهُ  ابْنُ عُمَرَ  :         [12/340]      مَا أَضْحَكَكَ ؟ فَقَالَ : إِنِّي صَلَّيْتُ إِلَى جَنْبِ  عَبْدِ اللهِ بْنِ عَمْرٍو  فَسَمِعْتُهُ يَقُولُ مِثْلَ مَا قُلْتَ ، فَقَالَ ابْنُ عُمَرَ : "" كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 13288","","عبد الله بن عمر بن الخطاب عن عون بن عبد الله بن عتبة عن جعفر بن ربيعة الكندي عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عون بن عبد الله بن عتبة عن ابن عمر"
"13325","[  عُمَرُ بْنُ كَثِيرِ بْنِ أَفْلَحَ  ، عَنِ  ابْنِ عُمَرَ  ]  13289  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَعْقُوبَ بْنِ أَبِي عَبَّادٍ الْمَلَكِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عُمَرَ بْنِ كَثِيرِ بْنِ أَفْلَحَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي الضَّالَّةِ أَنَّهُ كَانَ يَقُولُ :  اللَّهُمَّ رَادَّ الضَّالَّةِ ، وَهَادِيَ الضَّلَالَةِ  ، تَهْدِي مِنَ الضَّلَالَةِ ، ارْدُدْ عَلَيَّ ضَالَّتِي بِقُدْرَتِكَ وَسُلْطَانِكَ ، فَإِنَّهَا مِنْ عَطَائِكَ وَفَضْلِكَ  .","","Al-Mu'jam al-Kabir 13289","","عبد الله بن عمر بن الخطاب عن عمر بن كثير بن أفلح المدني عن محمد بن عجلان عن سفيان بن عيينة عن عبد الرحمن بن يعقوب بن إسحاق العبدى عن عبيد الله بن محمد بن عبد الله البرقي عن الطبراني","عمر بن كثير بن أفلح عن ابن عمر"
"13326","[  يَعْقُوبُ بْنُ عَبْدِ اللهِ  ، عَنِ  ابْنِ عُمَرَ  ]  13290  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  ابْنُ لَهِيعَةَ ، وَيَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  يَعْقُوبَ بْنِ عَبْدِ اللهِ بْنِ الْمُغِيرَةِ بْنِ الْأَخْنَسِ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :         [12/341]      دَخَلَ إِبْلِيسُ  الْعِرَاقَ  فَقَضَى فِيهِ حَاجَتَهُ  ، ثُمَّ دَخَلَ  الشَّامَ  فَطَرَدُوهُ ، ثُمَّ دَخَلَ  مِصْرَ  فَبَاضَ فِيهَا  وَفَرَّخَ  ، وَبَسَطَ  عَبْقَرِيَّهُ  .","","Al-Mu'jam al-Kabir 13290","","عبد الله بن عمر بن الخطاب عن يعقوب بن عتبة بن المغيرة الثقفي عن الزهري عن عقيل بن خالد الأيلي عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","يعقوب بن عبد الله عن ابن عمر"
"13327","[  أَبُو عَلْقَمَةَ مَوْلَى بَنِي هَاشِمٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13291  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي أَيُّوبَ الْمَخْزُومِيِّ ،  عَنْ  أَبِي عَلْقَمَةَ مَوْلَى بَنِي هَاشِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ نُصَلِّي بَعْدَ الْفَجْرِ فَقَالَ :  لَا صَلَاةَ بَعْدَ الْفَجْرِ إِلَّا رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 13291","","عبد الله بن عمر بن الخطاب عن أبو علقمة الفارسي عن محمد بن أبي أيوب المخزومي عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","أبو علقمة مولى بني هاشم عن ابن عمر"
"13328","[  نُعَيْمٌ الْمُجْمِرُ  ، عَنِ  ابْنِ عُمَرَ  ]  13292  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  نُعَيْمٍ الْمُجْمِرِ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِزْرَةُ  الْمُؤْمِنِ إِلَى أَنْصَافِ سَاقَيْهِ  ، وَلَا جُنَاحَ عَلَيْهِ فِيمَا بَيْنَهُ وَبَيْنَ  الْكَعْبَيْنِ  ، مَنْ جَرَّ ثَوْبَهُ مِنَ  الْمَخِيلَةِ  لَمْ يَنْظُرِ اللهُ إِلَيْهِ  .","","Al-Mu'jam al-Kabir 13292","","عبد الله بن عمر بن الخطاب عن نعيم بن عبد الله المجمر عن العلاء بن عبد الرحمن الحرقي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أحمد بن إسحاق البلدي عن الطبراني","نعيم المجمر عن ابن عمر"
"13329","[12/342]      [  مُحَمَّدُ بْنُ أَبِي حَكِيمٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13293  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي حَكِيمٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّمَا مَثَلُ الْمُؤْمِنِ مَثَلُ شَجَرَةٍ لَا يَسْقُطُ وَرَقُهَا  ، النَّخْلَةُ  .","","Al-Mu'jam al-Kabir 13293","","عبد الله بن عمر بن الخطاب عن محمد بن أبي حكيم عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن قتيبة بن سعيد عن عبدان بن محمد الجنوجردى عن الطبراني","محمد بن أبي حكيم عن ابن عمر"
"13330","[  نُعَيْمٌ الْمُجْمِرُ  ،  وَسَالِمٌ  ، عَنِ  ابْنِ عُمَرَ  ]  13294  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  نُعَيْمٍ الْمُجْمِرِ  وَسَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ ضَرَبَ عَبْدَهُ  حَدًّا  لَمْ يَأْتِهِ فَكَفَّارَتُهُ عِتْقُهُ  .","","Al-Mu'jam al-Kabir 13294","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","نعيم المجمر وسالم عن ابن عمر"
"13331","[  جُبَيْرُ بْنُ أَبِي سُلَيْمَانَ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13295  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عُبَادَةُ بْنُ مُسْلِمٍ الْفَزَارِيُّ ،  حَدَّثَنِي  جُبَيْرُ بْنُ أَبِي سُلَيْمَانَ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ، وَزَعَمَ  أَنَّهُ كَانَ جَالِسًا مَعَ ابْنِ عُمَرَ إِذْ مَرَّ بِهِ فَتًى شَابٌّ عَلَيْهِ جُبَّةٌ صَنْعَانِيَّةٌ يَجُرُّهَا  مُسْبِلًا  ، فَقَالَ : يَا فَتًى هَلُمَّ ، فَقَالَ لَهُ الْفَتَى : مَا حَاجَتُكَ يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟ قَالَ : وَيْحَكَ تُحِبُّ أَنْ يَنْظُرَ اللهُ         [12/343]      إِلَيْكَ يَوْمَ الْقِيَامَةِ ؟ قَالَ : سُبْحَانَ اللهِ ، وَمَا يَمْنَعُنِي أَنْ لَا أُحِبَّ ذَلِكَ ؟ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَنْظُرُ اللهُ إِلَى عَبْدٍ يَوْمَ الْقِيَامَةِ يَجُرُّ إِزَارَهُ  خُيَلَاءَ  قَالَ : فَلَمْ يُرَ ذَلِكَ الْفَتَى إِلَّا مُشَمِّرًا حَتَّى مَاتَ  .","","Al-Mu'jam al-Kabir 13295","","عبد الله بن عمر بن الخطاب عن جبير بن أبي سليمان النوفلي عن عبادة بن مسلم الفزاري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جبير بن أبي سليمان بن جبير بن مطعم عن ابن عمر"
"13332","13296  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عُبَادَةُ بْنُ مُسْلِمٍ ،  ثَنَا  جُبَيْرُ بْنُ أَبِي سُلَيْمَانَ بْنِ جُبَيْرٍ ،  أَنَّهُ  كَانَ جَالِسًا مَعَ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُعَائِهِ حِينَ يُصْبِحُ ، وَحِينَ يُمْسِي لَمْ يَدَعْهُ حَتَّى فَارَقَ الدُّنْيَا ، وَحَتَّى مَاتَ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ  الْعَفْوَ  وَالْعَافِيَةَ فِي دِينِي وَدُنْيَايَ وَأَهْلِي وَمَالِي  ، اللَّهُمَّ اسْتُرْ  عَوْرَاتِي  ، وَآمِنْ  رَوْعَاتِي ،  اللَّهُمَّ احْفَظْنِي مِنْ بَيْنِ يَدَيَّ ، وَمِنْ خَلْفِي ، وَعَنْ يَمِينِي ، وَعَنْ شِمَالِي ، وَمِنْ فَوْقِي ، وَأَعُوذُ بِكَ أَنْ  أُغْتَالَ  مِنْ تَحْتِي  قَالَ  جُبَيْرٌ  :  وَهُوَ الْخَسْفُ  ،  فَلَا أَدْرِي قَوْلَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْ قَوْلَ  جُبَيْرٍ  ؟ .","","Al-Mu'jam al-Kabir 13296","","عبد الله بن عمر بن الخطاب عن جبير بن أبي سليمان النوفلي عن عبادة بن مسلم الفزاري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","جبير بن أبي سليمان بن جبير بن مطعم عن ابن عمر"
"13333","[  قُدَامَةُ بْنُ إِبْرَاهِيمَ الْجُحَمِيُّ  ، عَنِ  ابْنِ عُمَرَ  ]  13297  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ (  ح  ) .  وَحَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  صَدَقَةُ بْنُ بَشِيرٍ مَوْلَى الْعُمَرِيِّينَ ، قَالَ :  سَمِعْتُ  قُدَامَةَ بْنَ         [12/344]      إِبْرَاهِيمَ الْجُمَحِيَّ  يُحَدِّثُ أَنَّهُ  كَانَ يَخْتَلِفُ إِلَى  عَبْدِ اللهِ بْنِ عُمَرَ  ، قَالَ :  فَحَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدَّثَهُمْ :  أَنَّ عَبْدًا مِنْ عِبَادِ اللهِ ، قَالَ : يَا رَبِّ لَكَ الْحَمْدُ كَمَا يَنْبَغِي لِجَلَالِ وَجْهِكَ وَلِعَظِيمِ سُلْطَانِكَ  ،  فَأَعْضَلَتْ  عَلَى الْمَلَكَيْنِ فَلَمْ يَدْرِيَا كَيْفَ يَكْتُبَانِهَا ؟ فَصَعِدَا إِلَى السَّمَاءِ ، فَقَالَا : يَا رَبَّنَا إِنَّ عَبْدَكَ قَالَ مَقَالَةً لَا نَدْرِي كَيْفَ نَكْتُبُهَا ، فَقَالَ اللهُ عَزَّ وَجَلَّ وَهُوَ أَعْلَمُ بِمَا قَالَ عَبْدُهُ : مَاذَا قَالَ عَبْدِي ؟ قَالَا : يَا رَبِّ إِنَّهُ قَالَ : يَا رَبِّ لَكَ الْحَمْدُ كَمَا يَنْبَغِي لِجَلَالِ وَجْهِكَ ، وَلِعَظِيمِ سُلْطَانِكَ ، فَقَالَ اللهُ عَزَّ وَجَلَّ لَهُمَا : اكْتُبَاهَا كَمَا قَالَ عَبْدِي حَتَّى يَلْقَانِي عَبْدِي فَأَجْزِيَهُ بِهَا  .","","Al-Mu'jam al-Kabir 13297","","عبد الله بن عمر بن الخطاب عن قدامة بن إبراهيم الجمحي عن صدقة بن بشير العمري عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","قدامة بن إبراهيم الجحمي عن ابن عمر"
"13334","[  سَعِيدٌ  عَنِ  ابْنِ عُمَرَ  ]  13298  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  جُمْهُورُ بْنُ مَنْصُورٍ ،  ثَنَا  سَيْفُ بْنُ مُحَمَّدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا قَطْعَ فِي مَاشِيَةٍ إِلَّا مَا وَرَاءَ الذِّرَبِ  ، وَلَا فِي  ثَمَرٍ  إِلَّا مَا آوَى  الْجَرِينُ  .","","Al-Mu'jam al-Kabir 13298","","عبد الله بن عمر بن الخطاب عن سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن سفيان الثوري عن سيف بن محمد الثوري عن جمهور بن منصور عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سعيد عن ابن عمر"
"13335","[  أَبُو صَالِحٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13299  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمَيِّتَ  يُعَذَّبُ  بِبُكَاءِ الْحَيِّ  .","","Al-Mu'jam al-Kabir 13299","","عبد الله بن عمر بن الخطاب عن ذكوان السمان عن الأعمش عن أبو معاوية الضرير عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو صالح عن ابن عمر"
"13336","[12/345]      13300  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ  النَّهَرَتِيرِيُّ ،  ثَنَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  وِصَالِ  ثَلَاثَةِ أَيَّامٍ ، فَقَالُوا : إِنَّكَ تُوَاصِلُ ، قَالَ :  إِنِّي أَظَلُّ يُطْعِمُنِي رَبِّي ، وَيَسْقِينِي  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (سهل بن سنان) كما نص عليه الهيثمي في مجمع الزوائد وقال لم أجد من ترجمه وأشار المحقق في الحاشية أنه عند المصنف في المعجم الكبير سهل بن عثمان .","","Al-Mu'jam al-Kabir 13300","","عبد الله بن عمر بن الخطاب عن ذكوان السمان عن الأعمش عن عمرو بن عبد الغفار الفقيمي عن سهل بن سنان النهرتيري عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو صالح عن ابن عمر"
"13337","13301  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نَعُدُّ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ مُتَوَافِرُونَ  :  أَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  ثُمَّ نَسْكُتُ  .","","Al-Mu'jam al-Kabir 13301","","عبد الله بن عمر بن الخطاب عن ذكوان السمان عن سهيل بن أبي صالح السمان عن أبو معاوية الضرير عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو صالح عن ابن عمر"
"13338","[  عَبْدُ اللهِ بْنُ أَبِي سَلَمَةَ الْمَاجِشُونُ  ، عَنِ  ابْنِ عُمَرَ  ]  13302  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يُوسُفُ بْنُ عَبْدِ اللهِ بْنِ أَبِي سَلَمَةَ الْمَاجِشُونُ ،  عَنْ  أَبِيهِ  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ ، قَالَ :  غَدَوْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عَرَفَةَ  ، فَمِنَّا الْمُلَبِّي وَمِنَّا الْمُكَبِّرُ لَا يُعَابُ  عَلَى الْمُكَبِّرِ تَكْبِيرُهُ ، وَلَا عَلَى الْمُلَبِّي تَلْبِيَتُهُ وَكَانَ  عَبْدُ اللهِ بْنُ عُمَرَ  مِمَّنْ يُكَبِّرُ  .","","Al-Mu'jam al-Kabir 13302","","عبد الله بن عمر بن الخطاب عن عبد الله بن أبي سلمة الماجشون عن يوسف بن عبد الله بن أبي سلمة الماجشون عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن أبي سلمة الماجشون عن ابن عمر"
"13339","[12/346]      [  عِكْرِمَةُ مَوْلَى ابْنِ عَبَّاسٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13303  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ السَّرِيَّ الَّذِي قَالَ اللهُ عَزَّ وَجَلَّ :         {      قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّا         }      نَهَرٌ أَخْرَجَهُ اللهُ لِتَشْرَبَ مِنْهُ  .","","Al-Mu'jam al-Kabir 13303","","عبد الله بن عمر بن الخطاب عن عكرمة مولى ابن عباس عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عكرمة مولى ابن عباس عن ابن عمر"
"13340","13304  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، وَابْنِ عُمَرَ ، وَأَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَزْنِي الزَّانِي حِينَ يَزْنِي وَهُوَ  مُؤْمِنٌ  ، وَلَا يَشْرَبُ الْخَمْرَ حِينَ يَشْرَبُهَا وَهُوَ مُؤْمِنٌ ، وَلَا يَسْرِقُ حِينَ يَسْرِقُ وَهُوَ مُؤْمِنٌ ، وَلَا يَنْتَهِبُ نُهْبَةً ذَاتَ  شَرَفٍ ،  وَهُوَ مُؤْمِنٌ  .","","Al-Mu'jam al-Kabir 13304","","أبو هريرة الدوسي عن عكرمة مولى ابن عباس عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عكرمة مولى ابن عباس عن ابن عمر"
"13341","13305  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  ثَنَا  النَّضْرُ أَبُو عُمَرَ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  طَلَّقْتُ امْرَأَتِي وَهِيَ حَائِضٌ فَذَكَرَ  عُمَرُ  ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  مُرْهُ فَلْيُرَاجِعْهَا  .","","Al-Mu'jam al-Kabir 13305","","عبد الله بن عمر بن الخطاب عن عكرمة مولى ابن عباس عن النضر بن عبد الرحمن الخزاز عن يونس بن بكير عن جعفر بن محمد بن الحسن الأسدي عن علي بن سعيد بن بشير عليك عن الطبراني","عكرمة مولى ابن عباس عن ابن عمر"
"13342","[12/347]      13306  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  السَّرِيُّ بْنُ عَاصِمٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  عُمَارَةَ بْنِ أَبِي حَفْصَةَ ،  عَنْ  عِكْرِمَةَ ،  أُرَاهُ  عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْكَوْثَرُ  نَهَرٌ فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 13306","","عبد الله بن عمر بن الخطاب عن عكرمة مولى ابن عباس عن عمارة بن أبي حفصة العتكي عن إسماعيل ابن علية عن السرى بن عاصم مؤدب المعتز بالله عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","عكرمة مولى ابن عباس عن ابن عمر"
"13343","[  يُوحَنَّسُ مَوْلَى الزُّبَيْرِ  ، عَنِ  ابْنِ عُمَرَ  ]  13307  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  قَطَنِ بْنِ وَهْبٍ أَنَّ يُوحَنَّسَ مَوْلَى الزُّبَيْرِ  أَخْبَرَهُ  أَنَّهُ كَانَ جَالِسًا عِنْدَ عَبْدِ اللهِ بْنِ عُمَرَ فِي الْفِتْنَةِ فَجَاءَتْهُ مَوْلَاةٌ لَهُ تُسَلِّمُ عَلَيْهِ ، فَقَالَتْ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنِّي أَرَدْتُ الْخُرُوجَ ، وَاشْتَدَّ عَلَيْنَا الزَّمَانُ ، فَقَالَ لَهَا  عَبْدُ اللهِ بْنُ عُمَرَ  : اقْعُدِي  لَكَاعِ  فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا يَصْبِرُ عَلَى  لَأْوَائِهَا  وَشِدَّتِهَا أَحَدٌ إِلَّا كُنْتُ لَهُ شَفِيعًا أَوْ شَهِيدًا يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13307","","عبد الله بن عمر بن الخطاب عن يحنس بن أبي موسى الزبيري عن قطن بن وهب الخزاعي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يوحنس مولى الزبير عن ابن عمر"
"13344","[  مُحَمَّدُ بْنُ قَيْسٍ الْمَدَنِيُّ أَبُو حَازِمٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13308  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ         [12/348]      مُحَمَّدَ بْنَ قَيْسٍ الْمَدَنِيَّ أَبَا حَازِمٍ ،  يَقُولُ  : ابْنُ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَامَ يَوْمَ الْأَرْبِعَاءِ ، وَيَوْمَ الْخَمِيسِ ، وَيَوْمَ الْجُمُعَةِ  ، ثُمَّ  تَصَدَّقَ  يَوْمَ الْجُمُعَةِ ، بِمَا قَلَّ مِنْ مَالِهِ غُفِرَ لَهُ كُلُّ ذَنْبٍ عَمِلَهُ حَتَّى يَصِيرَ كَيَوْمِ وَلَدَتْهُ أُمُّهُ مِنَ الْخَطَايَا  .","","Al-Mu'jam al-Kabir 13308","","عبد الله بن عمر بن الخطاب عن محمد بن قيس المدني أبا حازم عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","محمد بن قيس المدني أبو حازم عن ابن عمر"
"13345","13309  -  حَدَّثَنَا  أَبُو شُعَيْبٍ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ قَيْسٍ الْمَدَنِيَّ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَقَدْ هَبَطَ عَلَيَّ مَلَكٌ مِنَ السَّمَاءِ مَا هَبَطَ عَلَى نَبِيٍّ قَبْلِي  ، وَلَا يَهْبِطُ عَلَى أَحَدٍ مِنْ بَعْدِي ، وَهُوَ  إِسْرَافِيلُ  وَعِنْدَهُ  جِبْرِيلُ  فَقَالَ : السَّلَامُ عَلَيْكَ يَا  مُحَمَّدُ  ، ثُمَّ قَالَ : أَنَا رَسُولُ رَبِّكِ إِلَيْكَ أَمَرَنِي أَنْ أُخَيِّرُكَ  إِنْ شِئْتَ نَبِيًّا عَبْدًا ، وَإِنْ شِئْتَ نَبِيًّا مَلَكًا ، فَنَظَرْتُ إِلَى  جِبْرِيلَ  فَأَوْمَأَ  جِبْرِيلُ  إِلَيَّ أَنْ تَوَاضَعْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ ذَلِكَ : "" نَبِيًّا عَبْدًا "" فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَوْ أَنِّي قُلْتُ نَبِيًّا مَلَكًا ، ثُمَّ شِئْتُ لَسَارَتِ الْجِبَالُ مَعِيَ ذَهَبًا  .  في طبعة مكتبة ابن تيمية : ( أخبرك ) وهي على الصواب في النسخة الخطية .","","Al-Mu'jam al-Kabir 13309","","عبد الله بن عمر بن الخطاب عن محمد بن قيس المدني عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","محمد بن قيس المدني أبو حازم عن ابن عمر"
"13346","13310  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ قَيْسٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّ الدُّنْيَا أَهْوَنُ عَلَى اللهِ مِنْ هَذِهِ السَّخْلَةِ         [12/349]      عَلَى أَهْلِهَا ، وَلَوْ كَانَتِ الدُّنْيَا تَعْدِلُ عِنْدَ اللهِ  مِثْقَالَ  حَبَّةٍ  مِنْ خَرْدَلٍ لَمْ يُعْطِهَا إِلَّا أَوْلِيَاءَهُ ، وَأَحِبَّاءَهُ مِنْ خَلْقِهِ  .","","Al-Mu'jam al-Kabir 13310","","عبد الله بن عمر بن الخطاب عن محمد بن قيس الهمداني عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","محمد بن قيس المدني أبو حازم عن ابن عمر"
"13347","13311  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ قَيْسٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ  ، وَهُوَ الْحَيُّ الَّذِي لَا يَمُوتُ ، بِيَدِهِ الْخَيْرُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا يُرِيدُ بِهَا إِلَّا وَجْهَهُ ، أَدْخَلَهُ اللهُ بِهَا جَنَّاتِ النَّعِيمِ  .","","Al-Mu'jam al-Kabir 13311","","عبد الله بن عمر بن الخطاب عن محمد بن قيس الهمداني عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","محمد بن قيس المدني أبو حازم عن ابن عمر"
"13348","[  وَاسِعُ بْنُ حَبَّانَ  ، عَنِ  ابْنِ عُمَرَ  ]  13312  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  عَمِّهِ وَاسِعِ بْنِ حَبَّانَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  ارْتَقَيْتُ فَوْقَ سَطْحٍ فَرَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَهُوَ فِي بَيْتِ  حَفْصَةَ  يَضْرِبُ الْخَلَاءَ بَيْنَ لَبِنَتَيْنِ ، وَهُوَ مُتَوَجِّهٌ نَحْوَ  بَيْتِ الْمَقْدِسِ  .","","Al-Mu'jam al-Kabir 13312","","عبد الله بن عمر بن الخطاب عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن عبد الله بن عمر العمري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","واسع بن حبان عن ابن عمر"
"13349","13313  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنْ  عَمْرِو بْنِ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،         [12/350]      عَنْ  عَمِّهِ وَاسِعِ بْنِ حَبَّانَ ،  أَنَّهُ :  سَأَلَ  ابْنَ عُمَرَ عَنْ صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَقَالَ : كَانَ إِذَا صَلَّى قَالَ : "" اللهُ أَكْبَرُ  ، كُلَّمَا رَفَعَ ، وَكُلَّمَا وَضَعَ فِي الرُّكُوعِ وَالسُّجُودِ ، وَإِذَا انْصَرَفَ قَالَ : "" السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ "" ، عَنْ يَمِينِهِ ، وَعَنْ يَسَارِهِ  .","","Al-Mu'jam al-Kabir 13313","","عبد الله بن عمر بن الخطاب عن واسع بن حبان بن منقذ المازني عن محمد بن يحيى بن حبان عن عمرو بن يحيى بن عمارة المازني عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","واسع بن حبان عن ابن عمر"
"13350","[  عُبَيْدُ بْنُ جُرَيْجٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13314  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، وَمَالِكُ بْنُ أَنَسٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ، قَالَ :  قُلْتُ  لِابْنِ عُمَرَ :  رَأَيْتُكَ تَلْبَسُ هَذِهِ النِّعَالَ  السِّبْتِيَّةَ  قَالَ : "" إِنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَلْبَسُهَا ، وَيَتَوَضَّأُ فِيهَا  .","","Al-Mu'jam al-Kabir 13314","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن سعيد المقبري عن مالك بن أنس عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبيد بن جريج عن ابن عمر"
"13351","13315  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الشَّافِعِيُّ ،  ثَنَا  عَمِّي إِبْرَاهِيمُ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ الْمَكِّيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ، قَالَ :  قُلْتُ  لِابْنِ عُمَرَ ، وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 13315","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن سعيد المقبري عن عبيد الله بن عمر العمري عن عبد الله بن رجاء البصري عن إبراهيم بن محمد بن العباس المطلبي عن أحمد بن محمد ابن بنت الشافعى عن الطبراني","عبيد بن جريج عن ابن عمر"
"13352","13316  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  يَزِيدُ بْنُ حَكِيمٍ الْعَسْكَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ مَسْلَمَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ فِي  السِّبْتِيَّيْنِ  ،  وَالرُّكْنِ  .","","Al-Mu'jam al-Kabir 13316","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن سعيد المقبري عن إسماعيل بن أمية الأموي عن سعيد بن مسلمة الأموي عن يزيد بن حكيم العسكري عن عبد الله بن أحمد الجواليقي عن الطبراني","عبيد بن جريج عن ابن عمر"
"13353","[12/351]      13317  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ،  أَنَّهُ رَأَى  ابْنَ عُمَرَ يَخْضِبُ بِصُفْرَةٍ وَيُخْبِرُ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَخْضِبُ بِهَا  .","","Al-Mu'jam al-Kabir 13317","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن سليمان بن موسى الأشدق عن سعيد بن عبد العزيز التنوخي عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن عبيد العجل عن الطبراني","عبيد بن جريج عن ابن عمر"
"13354","13318  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُعَاوِيَةَ الْعُتْبِيُّ  ، ثَنَا  عَمْرُو بْنُ سَوَّادٍ السَّرْخِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ  عِيسَى ابْنَ مَرْيَمَ  عَلَيْهِ جُبَّةٌ  سِيَرَاءُ  يَطُوفُ  بِالْبَيْتِ  "" ، قَالُوا : مَنْ يُشْبِهُهُ  ؟ قَالَ : ""  عُرْوَةُ بْنُ مَسْعُودٍ الثَّقَفِيُّ  ، وَرَأَيْتُ  مُوسَى بْنَ عِمْرَانَ  رَجُلًا آدَمَ ضَرْبًا مِنَ  الْقَوْمِ  كَأَنَّهُ مِنْ رِجَالِ شَنُوءَةَ ، وَرَأَيْتُ  الدَّجَّالَ  "" قُلْنَا : مَنْ يُشْبِهُهُ يَا رَسُولَ اللهِ ؟ قَالَ : ""  عَبْدُ الْعُزَّى بْنُ قَطَنٍ الْمُصْطَلِقِيُّ  .","","Al-Mu'jam al-Kabir 13318","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن عبد الله بن وهب المصري عن عمرو بن سواد السرحي عن عبد الرحمن بن معاوية العتبي عن الطبراني","عبيد بن جريج عن ابن عمر"
"13355","[  عَبْدُ اللهِ بْنُ وَهْبٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13319  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ أَبِي جَمِيلَةَ  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ وَهْبٍ  أَنَّ عُثْمَانَ قَالَ لِابْنِ عُمَرَ : اذْهَبْ فَكُنْ         [12/352]      قَاضِيًا ، قَالَ أَوَتُعْفِينِي ، يَا أَمِيرَ الْمُؤْمِنِينَ ؟ قَالَ : لَا ، اذْهَبْ فَاقْضِ بَيْنَ النَّاسِ ، قَالَ : أَوَتُعْفِينِي ، يَا أَمِيرَ الْمُؤْمِنِينَ ؟ قَالَ : لَا ، عَزَمْتُ عَلَيْكَ إِلَّا ذَهَبْتَ فَقَضَيْتَ ، قَالَ : لَا تَعْجَلْ ، سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ عَاذَ بِاللهِ فَقَدْ [عَاذَ]  بِمَعَاذٍ  ؟ قَالَ : نَعَمْ ، قَالَ : فَإِنَّى أَعُوذُ بِاللهِ أَنْ أَكُونَ قَاضِيًا ، قَالَ : وَمَا يَمْنَعُكَ ، وَقَدْ كَانَ أَبُوكَ يَقْضِي ؟ قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ قَاضِيًا فَقَضَى بِجَهْلٍ كَانَ مِنْ أَهْلِ النَّارِ  ، وَمَنْ كَانَ قَاضِيًا عَالِمًا فَقَضَى بِحَقٍّ أَوْ بِعَدْلٍ سَأَلَ التَّفَلُّتَ كَفَافًا "" فَمَا أَرْجُو بَعْدَ هَذَا  ؟  . قَالَ أَبُو الْقَاسِمِ :  عَبْدُ اللهِ بْنُ وَهْبٍ  هَذَا هُوَ عِنْدِي  عَبْدُ اللهِ بْنُ وَهْبِ بْنِ زَمْعَةَ  ، وَاللهُ أَعْلَمُ  .  سقط من طبعة مكتبة ابن تيمية ، وأثبتناه من النسخة الخطية .","","Al-Mu'jam al-Kabir 13319","","عبد الله بن عمر بن الخطاب عن عبد الله بن وهب بن زمعة الغنمي عن عبد الملك بن أبي جميلة عن معتمر بن سليمان عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","عبد الله بن وهب عن ابن عمر"
"13356","[  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ مُطِيعٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13320  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  ثَنَا  زَكَرِيَّا بْنُ إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ مُطِيعٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أَصَبْنَا  مِنْ دُنْيَاكُمْ إِلَّا نِسَاءَكُمْ  .  في طبعة مكتبة ابن تيمية : ( أحبنا ) والمثبت من النسخ الخطية وكذا هي المصادر التي نقلته عن الطبراني كجامع السيوطي وغيره .","","Al-Mu'jam al-Kabir 13320","","عبد الله بن عمر بن الخطاب عن إبراهيم بن عبد الله بن مطيع القرشي عن زكريا بن إبراهيم بن عبد الله عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","إبراهيم بن عبد الله بن مطيع عن ابن عمر"
"13357","[  مُحَمَّدُ بْنُ الْمُنْكَدِرِ  ، عَنِ  ابْنِ عُمَرَ  ]  13321  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الْجَرْمِيُّ ،  ثَنَا  أَبُو عُبَيْدَةَ الْحَدَّادُ ،  ثَنَا  عَبَّادُ بْنُ مَيْسَرَةَ الْمِنْقَرِيُّ ،         [12/353]      عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَرَأَ هَذِهِ الْآيَةَ وَهُوَ عَلَى الْمِنْبَرِ         {      وَمَا قَدَرُوا اللهَ حَقَّ قَدْرِهِ         }      إِلَى آخِرِ الْآيَةِ ، فَقَالَ الْمِنْبَرُ هَكَذَا وَهَكَذَا -  يَعْنِي ارْتَجَّ الْمِنْبَرُ  .","","Al-Mu'jam al-Kabir 13321","","عبد الله بن عمر بن الخطاب عن محمد بن المنكدر عن عباد بن ميسرة المنقري عن عبد الواحد بن واصل عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن المنكدر عن ابن عمر"
"13358","13322  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  سَلْمُ بْنُ سَالِمٍ ،  عَنْ  عَلِيِّ بْنِ عُرْوَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَادَ أَعْمَى أَرْبَعِينَ خُطْوَةً وَجَبَتْ لَهُ الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 13322","","عبد الله بن عمر بن الخطاب عن محمد بن المنكدر عن علي بن عروة القرشي عن سلم بن سالم البلخي عن عبد الحميد بن صالح البرجمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن المنكدر عن ابن عمر"
"13359","13323  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  عَبْدُ اللهِ بْنُ سِنَانٍ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ الْمُنْكَدِرِ ،  يَقُولُ  :  لَقِيَ لَاقٍ ابْنَ عُمَرَ وَهُوَ عَلَى نَابٍ جَمْعَاءَ لَا تُسَوِّي عَشَرَةَ دَرَاهِمَ ، فَقَالَ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  عَلَى هَذِهِ تَحُجُّ ؟ قَالَ : نَعَمْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تَدَعِ  الْحَجَّ  ، وَلَوْ عَلَى نَابٍ جَمْعَاءَ تُسَوِّي عَشَرَةَ دَرَاهِمَ  فَوَاللهِ مَا حَضَرَنِي مِنْ ظَهْرِي غَيْرُهَا ، وَمَا كُنْتُ لِأَدَعَ  الْحَجَّ  .","","Al-Mu'jam al-Kabir 13323","","عبد الله بن عمر بن الخطاب عن محمد بن المنكدر عن عبد الله بن سنان الزهري عن زكريا بن يحيى زحمويه عن الحسين بن إسحاق التستري عن الطبراني","محمد بن المنكدر عن ابن عمر"
"13360","13324  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ الْوَهَّابِ بْنُ فُلَيْحٍ الْمَكِّيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ         [12/354]      عَامِرٍ الْأَسْلَمِيِّ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا اسْتَفْتَحَ الصَّلَاةَ قَالَ :  وَجَّهْتُ وَجْهِيَ لِلَّذِي فَطَرَ السَّمَاوَاتِ وَالْأَرْضَ حَنِيفًا مُسْلِمًا  ، وَمَا أَنَا مِنَ الْمُشْرِكِينَ ، سُبْحَانَكَ اللَّهُمَّ بِحَمْدِكَ ، وَتَبَارَكَ اسْمُكَ ، وَتَعَالَى  جَدُّكَ ،  وَلَا إِلَهَ غَيْرُكَ ، إِنَّ صَلَاتِي  وَنُسُكِي  ، وَمَحْيَايَ وَمَمَاتِي لِلهِ رَبِّ الْعَالَمِينَ لَا شَرِيكَ لَهُ ، وَبِذَلِكَ أُمِرْتُ ، وَأَنَا مِنَ الْمُسْلِمِينَ  .","","Al-Mu'jam al-Kabir 13324","","عبد الله بن عمر بن الخطاب عن محمد بن المنكدر عن عبد الله بن عامر الأسلمي عن المعافى بن عمران عن عبد الوهاب بن فليح القرشي عن الحسين بن إسحاق التستري عن الطبراني","محمد بن المنكدر عن ابن عمر"
"13361","[  مُوسَى بْنُ أَبِي مُسْلِمٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13325  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  مُوسَى بْنِ أَبِي مُسْلِمٍ  أَنَّهُ :  سَأَلَ ابْنَ عُمَرَ عَنِ النُّزُولِ بِالْمُحَصَّبِ ،  فَقَالَ  : "" سُنَّةٌ ، أَنَاخَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبُو بَكْرٍ  وَعُمَرُ  .","","Al-Mu'jam al-Kabir 13325","","عبد الله بن عمر بن الخطاب عن موسى بن مسلم بن أبي مسلم مولى بنت قارظ عن بكير بن عبد الله بن الأشج القرشي عن عبد الله بن لهيعة عن عبد الغفار بن داود الحراني عن عمرو بن أبي الطاهر المصري عن الطبراني","موسى بن أبي مسلم عن ابن عمر"
"13362","[  فَرْوَةُ بْنُ قَيْسٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13326  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْجَمَّالُ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عُمَرَ رُسْتَهْ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  ثَنَا  نَافِعُ بْنُ عَبْدِ اللهِ ،  عَنْ  فَرْوَةَ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَيُّ النَّاسِ خَيْرٌ  ؟ قَالَ : "" أَحْسَنُهُمْ  خُلُقًا  .","","Al-Mu'jam al-Kabir 13326","","عبد الله بن عمر بن الخطاب عن فروة بن قيس الحجازي عن نافع بن عبد الله الحجازي عن أنس بن عياض الليثي عن رستة عبد الرحمن بن عمر الأزرق عن أحمد بن محمد بن عبد الله الجمال عن الطبراني","فروة بن قيس عن ابن عمر"
"13363","[12/355]      [  عُبَيْدُ اللهِ بْنُ مِقْسَمٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13327  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  ابْنُ أَبِي حَازِمٍ ،  ثَنَا  أَبُو حَازِمٍ  عَنْ  عُبَيْدِ اللهِ بْنِ مِقْسَمٍ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ وَهُوَ يَقُولُ : "" يَأْخُذُ الْجَبَّارُ سَمَاوَاتِهِ وَأَرْضَهُ بِيَدَيْهِ "" وَقَبَضَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدَهُ ، وَجَعَلَ يَقْبِضُهَا ، وَيَبْسُطُهَا ، ثُمَّ قَالَ : فَيَقُولُ :  أَنَا الرَّحْمَنُ ، أَنَا الْمَلِكُ ، أَيْنَ الْجَبَّارُونَ  ؟ أَيْنَ الْمُتَكَبِّرُونَ ؟ "" وَتَمَايَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ حَتَّى نَظَرْتُ إِلَى الْمِنْبَرِ يَتَحَرَّكُ مِنْ أَسْفَلِ شَيْءٍ مِنْهُ حَتَّى أَقُولَ : سَاقِطٌ هُوَ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . ؟","","Al-Mu'jam al-Kabir 13327","","عبد الله بن عمر بن الخطاب عن عبيد الله بن مقسم القرشي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عبيد الله بن مقسم عن ابن عمر"
"13364","[  أَبُو عَبْدِ اللهِ الْقَرَّاطُ  ، عَنِ  ابْنِ عُمَرَ  ]  13328  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو ثَابِتٍ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الْمَدِينِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  أَبِي عَبْدِ اللهِ الْقَرَّاطِ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا تَوَضَّأَ أَحَدُكُمْ فَأَحْسَنَ وُضُوءَهُ  ، ثُمَّ خَرَجَ إِلَى الْمَسْجِدِ لَا يَنْزِعُهُ إِلَّا الصَّلَاةُ ، لَمْ تَزَلْ رِجْلُهُ الْيُسْرَى تَمْحُو سَيِّئَةً ، وَتَكْتُبُ الْأُخْرَى حَسَنَةً حَتَّى يَدْخُلَ الْمَسْجِدَ  .","","Al-Mu'jam al-Kabir 13328","","عبد الله بن عمر بن الخطاب عن دينار القراظ عن كثير بن زيد السهمي عن عبد العزيز بن محمد الدراوردي عن محمد بن عبيد الله بن محمد بن زيد الأموي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو عبد الله القراط عن ابن عمر"
"13365","[12/356]      [  سَعِيدُ بْنُ أَبِي هِنْدٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13329  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ  ، ثَنَا  مُحَمَّدُ بْنُ عَبَّادِ بْنِ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ الْكِلَابِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا دَخَلَ  مَكَّةَ  قَالَ : "" اللَّهُمَّ لَا تَجْعَلْ مَنَايَانَا بِهَا  حَتَّى تُخْرِجَنَا مِنْهَا  .","","Al-Mu'jam al-Kabir 13329","","عبد الله بن عمر بن الخطاب عن سعيد بن أبي هند الفزاري عن عبد الله بن سعيد بن أبي هند الفزاري عن محمد بن ربيعة بن سمير الرؤاسي عن محمد بن عباد بن موسى العكلي عن ابن علويه الحسن بن علي القطان عن الطبراني","سعيد بن أبي هند عن ابن عمر"
"13366","[  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ حَاطِبٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13330  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عُثْمَانَ بْنِ إِبْرَاهِيمَ بْنِ حَاطِبٍ ،  عَنْ  أَبِيهِ  وَعَمِّهِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا رَأَى الْهِلَالَ قَالَ : "" اللَّهُمَّ أَهِلَّهُ عَلَيْنَا بِالْأَمْنِ وَالْإِيمَانِ  ، وَالسَّلَامَةِ وَالْإِسْلَامِ ، وَالتَّوْفِيقِ لِمَا تُحِبُّ وَتَرْضَى ، رَبُّنَا وَرَبُّكَ اللهُ  .","","Al-Mu'jam al-Kabir 13330","","عبد الله بن عمر بن الخطاب عن قدامة بن إبراهيم الجمحي عن عثمان بن إبراهيم الجمحي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","إبراهيم بن محمد بن حاطب عن ابن عمر"
"13367","[  زَيْدُ بْنُ أَسْلَمَ  ، عَنِ  ابْنِ عُمَرَ  ]  13331  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،         [12/357]      ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  ثَنَا  أَيُّوبُ بْنُ أَبِي تَمِيمَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلَيَّ إِزَارٌ تَتَقَعْقَعُ  ، فَقَالَ : "" مَنْ هَذَا ؟ "" فَقُلْتُ :  عَبْدُ اللهِ  ، فَقَالَ : "" إِنْ كُنْتَ  عَبْدَ اللهِ  فَارْفَعْ إِزَارَكَ "" فَرَفَعْتُ إِزَارِي إِلَى نِصْفِ السَّاقَيْنِ ، فَلَمْ يَزَلْ  إِزْرَتَهُ  حَتَّى مَاتَ  .","","Al-Mu'jam al-Kabir 13331","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن أيوب السختياني عن محمد بن عبد الرحمن الطفاوي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","زيد بن أسلم عن ابن عمر"
"13368","13332  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْخَضِرِ الْخُزَاعِيُّ الْمَرْوَزِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدَةَ الْمَرْوَزِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ بْنِ وَاقِدٍ ،  عَنْ  أَبِي عِصْمَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَمَّا نَزَلَتِ الْمُوجِبَاتُ مِثْلَ قَوْلِهِ :         {      الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا         }      إِلَى آخِرِ الْآيَةِ  ، وَمِثْلَ         {      الَّذِينَ يَأْكُلُونَ الرِّبَا         }      ، وَمِثْلَ قَوْلِهِ         {      وَمَنْ يَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُهُ جَهَنَّمُ         }      قَالَ : "" كُنَّا نَشْهَدُ عَلَى مَنْ فَعَلَ شَيْئًا مِنْ هَذَا أَنَّهُ فِي النَّارِ ، فَلَمَّا نَزَلَتْ قَوْلُهُ         {      إِنَّ اللهَ لا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ         }      كَفَفْنَا عَنِ الشَّهَادَةِ فَخِفْنَا عَلَيْهِمْ بِمَا أَوْجَبَ اللهُ لَهُمْ  "" .","","Al-Mu'jam al-Kabir 13332","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن نوح الجامع ، نوح بن أبي مريم المروزي عن علي بن الحسين بن واقد عن محمد بن عبدة المروزي عن أحمد بن الخضر المروزي عن الطبراني","زيد بن أسلم عن ابن عمر"
"13369","13333  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ، وَمُحَمَّدُ بْنُ حُنَيْنٍ الْعَطَّارُ الْبَغْدَادِيُّ ، قَالَا :  ثَنَا  دَاوُدُ بْنُ رُشَيْدِينَ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِي هَاشِمٍ الْأُبُلِّيِّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ دَابَّةٍ مِنْ دَوَابِّ الْبَحْرِ وَالْبَرِّ  لَيْسَ لَهَا دَمٌ يَنْعَقِدُ فَلَيْسَتْ لَهَا زَكَاةٌ  .","","Al-Mu'jam al-Kabir 13333","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن كثير بن عبد الله الأنسي عن سويد بن عبد العزيز السلمي عن داود بن رشيد الخوارزمي عن محمد بن أحمد بن حنين العطار عن الطبراني","زيد بن أسلم عن ابن عمر"
"13370","[12/358]      13334  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  أَحْمَدُ بْنُ طَارِقٍ الْوَابِشِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِلهِ عَزَّ وَجَلَّ خَلْقًا خَلَقَهُمْ لِحَوَائِجِ النَّاسِ  يَفْزَعُ النَّاسُ إِلَيْهِمْ فِي حَوَائِجِهِمْ ، أُولَئِكَ الْآمِنُونَ مِنْ عَذَابِ اللهِ  .","","Al-Mu'jam al-Kabir 13334","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن أحمد بن طارق الوابشي عن محمد بن عثمان بن أبي شيبة عن الطبراني","زيد بن أسلم عن ابن عمر"
"13371","13335  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ زُرَارَةَ ،  ثَنَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَشِّرِ الْمَشَّائِينَ إِلَى الْمَسَاجِدِ فِي الظُّلَمِ بِالنُّورِ التَّامِّ  يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13335","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن داود بن الزبرقان عن إسماعيل بن عبد الله بن زرارة الثغري عن أحمد بن داود بن موسى السدوسي عن الطبراني","زيد بن أسلم عن ابن عمر"
"13372","[  مُحَمَّدُ بْنُ زَيْدٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13336  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ مُحَمَّدٍ أَنَّ أَبَاهُ  حَدَّثَهُ  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَهُمْ فِي  حَجَّةِ الْوَدَاعِ  ، فَقَالَ :  أَلَا إِنَّ اللهَ حَرَّمَ عَلَيْكُمْ دِمَاءَكُمْ وَأَمْوَالَكُمْ  كَحُرْمَةِ  يَوْمِكُمْ هَذَا  فِي بَلَدِكُمْ هَذَا فِي شَهْرِكُمْ هَذَا ، أَلَا هَلْ بَلَّغْتُ ؟ ""         [12/359]      قَالُوا : نَعَمْ ، قَالَ : "" اللَّهُمَّ اشْهَدْ "" ، قَالَ ذَلِكَ ثَلَاثًا ، ثُمَّ قَالَ : "" انْظُرُوا لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 13336","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","محمد بن زيد عن ابن عمر"
"13373","13337  -  وَبِإِسْنَادِهِ  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا صَارَ أَهْلُ الْجَنَّةِ إِلَى الْجَنَّةِ ، وَأَهْلُ النَّارِ إِلَى النَّارِ  ، أُتِيَ بِالْمَوْتِ حَتَّى يُجْعَلَ بَيْنَ الْجَنَّةِ وَالنَّارِ ، ثُمَّ يُذْبَحَ ، ثُمَّ يُنَادِي مُنَادٍ يَا أَهْلَ الْجَنَّةِ لَا مَوْتَ ، وَيَا أَهْلَ النَّارِ لَا مَوْتَ ، فَيَزْدَادُ أَهْلُ الْجَنَّةِ فَرَحًا إِلَى فَرَحِهِمْ ، وَيَزْدَادُ أَهْلُ النَّارِ حُزْنًا إِلَى حُزْنِهِمْ  .","","Al-Mu'jam al-Kabir 13337","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","محمد بن زيد عن ابن عمر"
"13374","13338  -  وَعَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نَتَحَدَّثُ بِحَجَّةِ الْوَدَاعِ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَظْهُرِنَا ، وَلَا نَدْرِي مَا حَجَّةُ الْوَدَاعِ ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطِيبًا ، فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ ذَكَرَ  الْمَسِيحَ الدَّجَّالَ  فَأَطْنَبَ بِذِكْرِهِ ، ثُمَّ قَالَ :  مَا بَعَثَ اللهُ مِنْ نَبِيٍّ إِلَّا وَقَدْ أَنْذَرَ أُمَّتَهُ  الدَّجَّالَ  ، لَقَدْ أَنْذَرَهُ  نُوحٌ  وَالنَّبِيُّونَ مِنْ بَعْدِهِ ، وَإِنَّهُ يَخْرُجُ فِيكُمْ ، فَمَا خَفِيَ عَلَيْكُمْ مِنْ شَأْنِهِ فَلَا يَخْفَى عَلَيْكُمْ أَنَّهُ  أَعْوَرُ  عَيْنِ الْيُمْنَى كَأَنَّهَا عِنَبَةٌ  طَافِيَةٌ  .","","Al-Mu'jam al-Kabir 13338","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن يحيى بن عثمان بن صالح عن الطبراني","محمد بن زيد عن ابن عمر"
"13375","13339  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ زَيْدِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ يَعْلَمُ النَّاسُ مَا فِي الْوَحْدَةِ مَا سَرَى أَحَدٌ بِلَيْلٍ وَحْدَهُ  .","","Al-Mu'jam al-Kabir 13339","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن مؤمل بن إسماعيل العدوي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن زيد عن ابن عمر"
"13376","[12/360]      13340  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا زَالَ  جِبْرِيلُ  يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ  أَنَّهُ سَيُوَرِّثُهُ  .","","Al-Mu'jam al-Kabir 13340","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن يزيد بن زريع العيشي عن محمد بن المنهال عن إبراهيم بن هاشم البغوي عن الطبراني","محمد بن زيد عن ابن عمر"
"13377","13341  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدِ بْنِ زَيْدٍ أَنَّهُ  سَمِعَ  أَبَاهُ  يُحَدِّثُ عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنْ يَكُنِ الشُّؤْمُ فِي شَيْءٍ فَفِي الْمَرْأَةِ  ، وَالْفَرَسِ ، وَالدَّارِ  .","","Al-Mu'jam al-Kabir 13341","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن زيد عن ابن عمر"
"13378","13342  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحُمَّى مِنْ  فَيْحِ  جَهَنَّمَ  فَأَطْفِئُوهَا بِالْمَاءِ ، أَوْ قَالَ : بَرِّدُوهَا بِالْمَاءِ  .","","Al-Mu'jam al-Kabir 13342","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن زيد عن ابن عمر"
"13379","13343  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا زَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ يُوصِينِي بِالْجَارِ  حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ  .","","Al-Mu'jam al-Kabir 13343","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن زيد عن ابن عمر"
"13380","13344  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ         [12/361]      عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُوتِيتُ مَفَاتِيحَ كُلِّ شَيْءٍ إِلَّا الْخَمْسَ  ،         {      إِنَّ اللهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَـزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللهَ عَلِيمٌ خَبِيرٌ         }      .","","Al-Mu'jam al-Kabir 13344","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن زيد عن ابن عمر"
"13381","13345  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَعْدِي عَلَى وَالِدِهِ ، قَالَ : إِنَّهُ أَخَذَ مِنْ مَالِي ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا عَلِمْتَ أَنَّكَ وَمَالَكَ مِنْ كَسْبِ أَبِيكَ  ؟  .","","Al-Mu'jam al-Kabir 13345","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","محمد بن زيد عن ابن عمر"
"13382","13346  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُجَاءُ بِالْمَوْتِ يَوْمَ الْقِيَامَةِ فِي صُورَةِ كَبْشٍ  أَمْلَحَ  فَيُوقَفُ بَيْنَ الْجَنَّةِ وَالنَّارِ  ، فَيُقَالُ : يَا أَهْلَ الْجَنَّةِ هَلْ تَعْرِفُونَ هَذَا ؟ فَيَشْرَئِبُّونَ ، وَيَنْظُرُونَ ، وَيُقَالُ : يَا أَهْلَ النَّارِ هَلْ تَعْرِفُونَ هَذَا ؟ فَيَشْرَئِبُّونَ ، وَيَنْظُرُونَ ، ثُمَّ يُذْبَحُ ، ثُمَّ يُقَالُ : يَا أَهْلَ الْجَنَّةِ خُلُودٌ فَلَا مَوْتَ ، وَيَا أَهْلَ النَّارِ خُلُودٌ وَلَا مَوْتَ  .","","Al-Mu'jam al-Kabir 13346","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","محمد بن زيد عن ابن عمر"
"13383","13347  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ         [12/362]      أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ عَلِمْتُ أَنَّ أَحَبَّ الْبِلَادِ إِلَى اللهِ عَزَّ وَجَلَّ  مَكَّةُ  ، وَلَوْلَا أَنَّ قَوْمِي أَخْرَجُونِي مَا خَرَجْتُ ، اللَّهُمَّ اجْعَلْ فِي قُلُوبِنَا مِنْ حُبِّ  الْمَدِينَةِ  مِثْلَ مَا جَعَلْتَ فِي قُلُوبِنَا مِنْ حُبِّ  مَكَّةَ  "" ، وَمَا أَشْرَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الْمَدِينَةِ  قَطُّ إِلَّا عُرِفَ فِي وَجْهِهِ الْبِشْرُ وَالْفَرَحُ  .","","Al-Mu'jam al-Kabir 13347","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","محمد بن زيد عن ابن عمر"
"13384","13348  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ  ، قَالَ :  سَمِعْنَا بِحَجَّةِ الْوَدَاعِ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَيٌّ بَيْنَ أَظْهُرِنَا ، وَمَا نَرَى أَنَّهُ الْوَدَاعَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَخَطَبَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ  الْمَسِيحَ  فَأَطْنَبَ فِي ذِكْرِهِ ، ثُمَّ ذَكَرَ مِنْ أَمْرِهِ مَا شَاءَ أَنْ يَذْكُرَ ، ثُمَّ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ لَمْ يَبْعَثْ نَبِيًّا قَطُّ إِلَّا وَقَدْ أَنْذَرَ أُمَّتَهُ  الْمَسِيحَ  ، قَدْ أَنْذَرَهُ  نُوحٌ  أُمَّتَهُ ، ثُمَّ الْأَنْبِيَاءُ بَعْدَهُ نَبِيًّا نَبِيًّا ، أَلَا مَنْ خَفِيَ عَلَيْكُمْ مِنْ شَأْنِهِ وَهَابَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَقُولَهَا ، ثُمَّ قَالَ : أَلَا مَنْ خَفِيَ عَلَيْكُمْ مِنْ شَأْنِهِ فَلَا يَخْفَى عَلَيْكُمْ أَنَّ رَبَّكُمْ لَيْسَ  بِأَعْوَرَ  ، وَهُوَ  أَعْوَرُ  عَيْنِ الْيُمْنَى ، كَأَنَّهَا عِنَبَةٌ  طَافِيَةٌ  ، أَلَا هَلْ بَلَّغْتُ ؟ "" فَصَرَخُوا مِنَ النَّوَاحِي : نَعَمْ ، فَقَالَ : "" اللَّهُمَّ اشْهَدْ "" ثَلَاثَ مَرَّاتٍ ، ثُمَّ قَالَ : "" لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 13348","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","محمد بن زيد عن ابن عمر"
"13385","13349  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ ، وَذَكَرَ الْحَرُورِيَّةَ فَقَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [12/363]      يَمْرُقُونَ  مِنَ الْإِسْلَامِ مُرُوقَ السَّهْمِ مِنَ  الرَّمِيَّةِ  .","","Al-Mu'jam al-Kabir 13349","","عبد الله بن عمر بن الخطاب عن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","محمد بن زيد عن ابن عمر"
"13386","[  نَافِعٌ  ، عَنِ  ابْنِ عُمَرَ  ]  13350  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  أَنَا  عَبْدُ الْقَاهِرِ بْنُ رِشْدِينَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَمْنَعُوا إِمَاءَ اللهِ مَسَاجِدَ اللهِ  .","","Al-Mu'jam al-Kabir 13350","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن سعيد بن أبي هند الفزاري عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن عبد القاهر بن رشدين بن سعد عن يحيى بن عثمان بن صالح عن الطبراني","نافع عن ابن عمر"
"13387","13351  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ ،  أَخْبَرَنِي  صَالِحُ بْنُ كَيْسَانَ  أَنَّ  إِسْمَاعِيلَ بْنَ مُحَمَّدِ بْنِ سَعْدٍ  أَخْبَرَهُ  أَنَّ نَافِعًا  أَخْبَرَهُ  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّمَا يَحْسُدُ مَنْ  حَسَدَ  ، أَوْ كَمَا شَاءَ اللهُ أَنْ يَقُولَ عَلَى  خَصْلَتَيْنِ  : رَجُلٌ أَعْطَاهُ اللهُ الْقُرْآنَ فَهُوَ يَقُومُ آنَاءَ اللَّيْلِ وَالنَّهَارِ ، وَرَجُلٌ أَعْطَاهُ اللهُ مَالًا فَهُوَ يُنْفِقُهُ  .","","Al-Mu'jam al-Kabir 13351","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن محمد بن سعد عن صالح بن كيسان الدوسي عن يحيى بن سعيد الأنصاري عن إسماعيل بن عياش الأحول عن علي بن عياش الألهاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13388","13352  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ خَالِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَقْطَعَ  الزُّبَيْرَ  حُضْرَ  فَرَسِهِ بِأَرْضٍ يُقَالُ لَهَا ثُوَيْرٌ  ، فَأَجْرَى فَرَسَهُ حَتَّى قَامَ ، ثُمَّ رَمَى سَوْطَهُ فَقَالَ : "" أَعْطُوهُ حَيْثُ بَلَغَ سَوْطُهُ  .","","Al-Mu'jam al-Kabir 13352","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن حماد بن خالد الخياط عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13389","[12/364]      13353  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ  ، ثَنَا  عَتِيقُ بْنُ يَعْقُوبَ الزُّبَيْرِيُّ ،  ثَنَا  عُقْبَةُ بْنُ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ إِذَا اكْتَحَلَ جَعَلَ فِي الْعَيْنِ الْيُمْنَى ثَلَاثًا  ، وَفِي الْيُسْرَى مِزْوَدَيْنِ فَجَعَلَهَا  وِتْرًا  .","","Al-Mu'jam al-Kabir 13353","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن عقبة بن علي عن عتيق بن يعقوب الزبيري عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","نافع عن ابن عمر"
"13390","13354  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَتِيقُ بْنُ يَعْقُوبَ الزُّبَيْرِيُّ ،  ثَنَا  عُقْبَةُ بْنُ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَكْثِرُوا مِنْ غَرْسِ الْجَنَّةِ فَإِنَّهُ عَذْبٌ مَاؤُهَا طَيِّبٌ تُرَابُهَا  ، فَأَكْثِرُوا مِنْ غِرَاسِهَا ، لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  .","","Al-Mu'jam al-Kabir 13354","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن عقبة بن علي عن عتيق بن يعقوب الزبيري عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","نافع عن ابن عمر"
"13391","13355  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  أَعْطَانَا ابْنُ الْأَشْجَعِيِّ كُتُبًا  عَنْ  أَبِيهِ  ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبِيتُ  بِذِي الْحُلَيْفَةِ  فَإِذَا صَلَّى الْفَجْرَ قَعَدَ عَلَى رَاحِلَتِهِ فَلَبَّى  .","","Al-Mu'jam al-Kabir 13355","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن أبو عبيدة بن عبيد الله الأشجعي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13392","13356  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَخْبَرَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ وَهْبٍ ،  عَنِ  الْعُمَرِيِّ ،         [12/365]      عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَمْ يَسْجُدْ يَوْمَ  ذِي الْيَدَيْنِ  .","","Al-Mu'jam al-Kabir 13356","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن عبد الله بن وهب المصري عن الليث بن سعد عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","نافع عن ابن عمر"
"13393","13357  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  وَلَغَ  الْكَلْبُ فِي إِنَاءِ أَحَدِكُمْ فَلْيَغْسِلْهُ سَبْعَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 13357","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","نافع عن ابن عمر"
"13394","13358  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ ،  ثَنَا  أَبُو مُصْعَبٍ الزُّهْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَرَأَ النَّجْمَ  بِمَكَّةَ  فَسَجَدَ النَّاسُ مَعَهُ  حَتَّى إِنَّ الرَّجُلَ لَيَرْفَعُ إِلَى جَبْهَتِهِ شَيْئًا مِنَ الْأَرْضِ فَيَسْجُدُ عَلَيْهِ ، وَحَتَّى يَسْجُدَ الرَّجُلُ عَلَى الرَّجُلِ  .","","Al-Mu'jam al-Kabir 13358","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن عبد العزيز بن محمد الدراوردي عن أحمد بن أبي بكر العوفى عن عبيد العجل عن الطبراني","نافع عن ابن عمر"
"13395","13359  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  مَا مِنْ سُورَةٍ فِي الْمُفَصَّلِ صَغِيرَةٍ وَلَا كَبِيرَةٍ إِلَّا قَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَؤُهَا فِي الصَّلَاةِ كُلِّهَا  .","","Al-Mu'jam al-Kabir 13359","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن صالح بن كيسان الدوسي عن إسماعيل بن عياش الأحول عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","نافع عن ابن عمر"
"13396","[12/366]      13360  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  الْحَسَنُ بْنُ حَمَّادٍ الْحَضْرَمِيُّ سَجَّادَةُ ،  حَدَّثَنَا  عَمْرُو بْنُ هَاشِمٍ أَبُو مَالِكٍ الْجَنْبِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  امْرَأَةً  كَانَتْ تَسْتَعِيرُ الْحُلِيَّ فِي زَمَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ تُمْسِكُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِتَتُبِ الْمَرْأَةُ إِلَى اللهِ عَزَّ وَجَلَّ وَإِلَى رَسُولِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلْتَرُدَّ مَا عِنْدَهَا  وَهِيَ تَسْمَعُ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قُمْ يَا فُلَانُ فَخُذْ بِيَدِهَا فَاقْطَعْهَا  .","","Al-Mu'jam al-Kabir 13360","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عمرو بن هاشم الجنبي عن الحسن بن حماد سجادة عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13397","13361  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ، وَمُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  بَيْنَمَا أَنَا جَالِسٌ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ جَاءَ  رَجُلٌ  فَسَلَّمَ عَلَيْهِ ثُمَّ وَلَّى عَنْهُ ، فَقُلْتُ :  يَا رَسُولَ اللهِ وَاللهِ إِنِّي لَأُحِبُّ هَذَا ، قَالَ : "" هَلْ أَعْلَمْتَهُ  ؟ "" قُلْتُ : لَا ، قَالَ : "" فَأَعْلِمْ ذَاكَ أَخَاكَ "" ، فَاتَّبَعْتُهُ فَسَلَّمْتُ  عَلَيْهِ فَأَخَذْتُ بِمَنْكِبِهِ ، وَقُلْتُ : وَاللهِ إِنِّي لَأُحِبُّكَ فِي اللهِ ، وَقَالَ هُوَ : وَأَنَا أُحِبُّكَ لِلهِ ، وَقُلْتُ : لَوْلَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَنِي أَنْ أُعْلِمَكَ لَمْ أَفْعَلْ  .  في طبعة مكتبة ابن تيمية : ( فسلت ) وهي على الصواب في النسخة الخطية .","","Al-Mu'jam al-Kabir 13361","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن زهير بن محمد التميمي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","نافع عن ابن عمر"
"13398","13362  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،         [12/367]      ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بَادِرُوا الصُّبْحَ  بِالْوِتْرِ  .","","Al-Mu'jam al-Kabir 13362","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى بن زكريا بن أبي زائدة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13399","13363  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  عُقْبَةُ أَبُو مَسْعُودٍ الْمُجَدَّرُ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : سَبَّقَ بَيْنَ الْخَيْلِ  ، وَسَبَّقَ الْقُرَّحَ فِي الْغَايَةِ  .","","Al-Mu'jam al-Kabir 13363","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عقبة بن خالد بن عقبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13400","13364  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  عُمَرُ بْنُ يَزِيدَ السَّيَّارِيُّ ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نَبِتُّ عَلَى الْقَاتِلِ حَتَّى نَزَلَتْ         {      إِنَّ اللهَ لا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ         }      .","","Al-Mu'jam al-Kabir 13364","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن مسلم بن خالد الزنجي عن عمر بن يزيد السياري عن الحسن بن علي بن شبيب المعمري عن الطبراني","نافع عن ابن عمر"
"13401","13365  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ الْجَوْهَرِيُّ ، قَالَا :  ثَنَا  عَلِيُّ بْنُ ظِبْيَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُدَبَّرُ مِنَ الثُّلُثِ  .","","Al-Mu'jam al-Kabir 13365","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن علي بن ظبيان العبسي عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","نافع عن ابن عمر"
"13402","13366  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ         [12/368]      زُرَارَةَ الرَّقِّيُّ ،  ثَنَا  عَلِيُّ بْنُ ظِبْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  التَّيَمُّمُ ضَرْبَتَانِ  ضَرْبَةٌ لِلْوَجْهِ ، وَضَرْبَةٌ لِلْيَدَيْنِ إِلَى الْمِرْفَقَيْنِ  .","","Al-Mu'jam al-Kabir 13366","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن علي بن ظبيان العبسي عن إسماعيل بن عبد الله بن زرارة الثغري عن علي بن سعيد بن بشير عليك عن الطبراني","نافع عن ابن عمر"
"13403","13367  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ بْنِ سَوْرَةَ الْبَغْدَادِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُونُسَ بْنِ بُكَيْرٍ الشَّيْبَانِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أُكِلَ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ضَبٌّ فَقَذِرَهُ  ، وَنَحْنُ نَقْذِرُ مَا قَذِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13367","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن إسحاق عن يونس بن بكير عن عبد الله بن يونس بن بكير الكوفي عن محمد بن يعقوب بن سورة البغدادي عن الطبراني","نافع عن ابن عمر"
"13404","13368  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قِيلَ لَهُ وَهُوَ  بِالْعَقِيقِ  : "" إِنَّكَ  بِالْوَادِي الْمُبَارَكِ أَوْ بِبَطْحَاءَ مُبَارَكَةٍ  .","","Al-Mu'jam al-Kabir 13368","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن محمد بن نصر بن منصور الصائغ عن الطبراني","نافع عن ابن عمر"
"13405","13369  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  بَعَثَنِي خَالِي  عُثْمَانُ بْنُ مَظْعُونٍ  لِآتِيَهُ بِلِحَافٍ ، فَأَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَاسْتَأْذَنْتُهُ وَهُوَ  بَالْخَنْدَقِ  فَأَذِنَ لِي وَقَالَ لِي :  مَنْ لَقِيتَ فَقُلْ لَهُمْ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَأْمُرُكُمْ أَنْ تَرْجِعُوا         [12/369]      وَكَانَ ذَلِكَ فِي بَرْدٍ شَدِيدٍ ، فَخَرَجْتُ فَلَقِيتُ النَّاسَ فَقُلْتُ لَهُمْ إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُكُمْ أَنْ تَرْجِعُوا ، قَالَ : فَلَا وَاللهِ مَا عَطَفَ عَلَيَّ اثْنَانِ أَوْ وَاحِدٌ  .","","Al-Mu'jam al-Kabir 13369","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن محمد بن نصر بن منصور الصائغ عن الطبراني","نافع عن ابن عمر"
"13406","13370  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ، قَالَ :  قِيلَ لِابْنِ عُمَرَ : أَيْنَ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي  يَوْمَ  الْأَحْزَابِ  ؟ قَالَ :  كَانَ يُصَلِّي فِي بَطْنِ الشِّعْبِ عِنْدَ خَرِبَةٍ هُنَاكَ  وَلَقَدْ أَذِنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الِانْصِرَافِ لِلنَّاسِ ، ثُمَّ أَمَرَنِي أَنْ أَدْعُوَهُمْ فَدَعَوْتُهُمْ  .","","Al-Mu'jam al-Kabir 13370","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن مصعب بن عبد الله بن مصعب الزبيري عن محمد بن الحسين الأنماطي عن الطبراني","نافع عن ابن عمر"
"13407","13371  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَفَلَ مِنْ سَفَرٍ فَمَرَّ  بِفَدْفَدٍ  وَنَشَزٍ  كَبَّرَ ثَلَاثًا  ثُمَّ قَالَ : "" لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ "" ، ثُمَّ يَقُولُ : "" آيِبُونَ تَائِبُونَ عَابِدُونَ سَاجِدُونَ لِرَبِّنَا حَامِدُونَ ، صَدَقَ اللهُ وَعْدَهُ ، وَنَصَرَ عَبْدَهُ ، وَهَزَمَ  الْأَحْزَابَ  وَحْدَهُ  .","","Al-Mu'jam al-Kabir 13371","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع عن ابن عمر"
"13408","13372  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ جَيْشًا غَنِمُوا زَمَانَ رَسُولِ اللهِ صَلَّى اللهُ         [12/370]      عَلَيْهِ وَسَلَّمَ طَعَامًا ، وَعَسَلًا فَلَمْ يُؤْخَذْ مِنْهُمُ الْخُمُسُ  .","","Al-Mu'jam al-Kabir 13372","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن محمد بن نصر بن منصور الصائغ عن الطبراني","نافع عن ابن عمر"
"13409","13373  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ نَصْرٍ التِّرْمِذِيُّ ،  ثَنَا  عُبَادَةُ بْنُ زِيَادٍ الْأَسَدِيُّ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِيُصَلِّ أَحَدُكُمْ فِي مَسْجِدِهِ  ، وَلَا يَتَتَبَّعِ الْمَسَاجِدَ  .","","Al-Mu'jam al-Kabir 13373","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن زهير بن معاوية بن حديج عن عباد بن زياد  بن موسى الساجي عن محمد بن أحمد بن نصر الترمذي عن الطبراني","نافع عن ابن عمر"
"13410","13374  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُعَاذُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِيُّ ، قَالُوا :  ثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ سَبَلَانُ ،  ثَنَا  عَبَّادُ بْنُ عَبَّادٍ ،  ثَنَا  عُبَيْدُ اللهِ وَعَبْدُ اللهِ ابْنَا عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَبُّ أَسْمَائِكُمْ إِلَى اللهِ عَزَّ وَجَلَّ عَبْدُ اللهِ وَعَبْدُ الرَّحْمَنِ  .","","Al-Mu'jam al-Kabir 13374","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عباد بن عباد بن حبيب عن إبراهيم بن زياد سبلان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","نافع عن ابن عمر"
"13411","13375  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْقِلَابِيُّ  ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ أَبُو الْجَمَلِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَيْسَ عَلَى الْمَرْأَةِ  حُرْمٌ  إِلَّا فِي وَجْهِهَا  ""  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (الغلابي) .","","Al-Mu'jam al-Kabir 13375","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أبو الجمل أيوب بن محمد اليمامي عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","نافع عن ابن عمر"
"13412","13376  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ ،  ثَنَا  عَبْدُ اللهِ         [12/371]      بْنُ الرُّومِيِّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  حَمَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  الرَّبَذَةَ  لِأَهْلِ الصَّدَقَةِ  .","","Al-Mu'jam al-Kabir 13376","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن ابن الرومي عن ابن علويه الحسن بن علي القطان عن الطبراني","نافع عن ابن عمر"
"13413","13377  -  حَدَّثَنَا  أَبُو شَيْخٍ مُحَمَّدُ بْنُ الْحَسَنِ بْنِ عَجْلَانَ الْأَصْبَهَانِيُّ ، وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنِ الْوُضُوءِ بَعْدَ الْغُسْلِ فَقَالَ :  وَأَيُّ وُضُوءٍ أَعَمُّ مِنَ الْغُسْلِ  ؟ "" .","","Al-Mu'jam al-Kabir 13377","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الأعلى بن عبد الأعلى القرشي عن محمد بن عبد الله بن بزيع البصري عن أبو شيخ الأبهري محمد بن الحسين عن الطبراني","نافع عن ابن عمر"
"13414","13378  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ عَجْلَانَ ، وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَوَضَّئُوا مِمَّا غَيَّرَتِ النَّارُ  .","","Al-Mu'jam al-Kabir 13378","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الأعلى بن عبد الأعلى القرشي عن محمد بن عبد الله بن بزيع البصري عن أبو شيخ الأبهري محمد بن الحسين عن الطبراني","نافع عن ابن عمر"
"13415","13379  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ،  ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  رَوْحِ بْنِ الْقَاسِمِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  بِلَالًا  يُؤَذِّنُ بِلَيْلٍ فَكُلُوا  ، وَاشْرَبُوا حَتَّى يُؤَذِّنَ  ابْنُ أُمِّ مَكْتُومٍ  "" ، وَزَعَمَ أَنَّ  بِلَالًا  كَانَ يُؤَذِّنُ ، فَإِذَا نَزَلَ  بِلَالٌ  أَذَّنَ  ابْنُ أُمِّ مَكْتُومٍ  .","","Al-Mu'jam al-Kabir 13379","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن أمية بن بسطام عن أحمد بن علي بن مسلم النخشبي عن الطبراني","نافع عن ابن عمر"
"13416","[12/372]      13380  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هَارُونَ أَبُو مُوسَى الْأَنْصَارِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ الْمَرْوَزِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَرَأَ فِي الْمَغْرِبِ بِـ         {      الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللهِ         }      .","","Al-Mu'jam al-Kabir 13380","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أبو معاوية الضرير عن الحسين بن حريث الخزاعي عن محمد بن هارون بن موسى الزرقي عن الطبراني","نافع عن ابن عمر"
"13417","13381  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  سَعْدُ بْنُ زُنْبُورٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، وَعُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : خَرَجَ مِنَ الْمَسْجِدِ إِلَى  الصَّفَا  مِنْ بَابِ  بَنِي مَخْزُومٍ  .","","Al-Mu'jam al-Kabir 13381","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن سعد بن زنبور البغدادي عن إبراهيم بن هاشم البغوي عن الطبراني","نافع عن ابن عمر"
"13418","13382  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  سَعْدُ بْنُ زُنْبُورٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ الْعُمَرِيُّ ،  عَنْ  أَبِيهِ  ، وَعُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَذْهَبُ إِلَى  الْجَبَّانِ  مَاشِيًا ، وَيَرْجِعُ مَاشِيًا ،  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  .","","Al-Mu'jam al-Kabir 13382","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن سعد بن زنبور البغدادي عن إبراهيم بن هاشم البغوي عن الطبراني","نافع عن ابن عمر"
"13419","13383  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  حَدَّثَنِي  أَبِي  ، وَعُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  أَبَا بَكْرٍ الصِّدِّيقَ  نَالَ مِنْ  عُمَرَ  شَيْئًا ، ثُمَّ قَالَ : اسْتَغْفِرْ لِي يَا أَخِي فَغَضِبَ  عُمَرُ  ، فَقَالَ         [12/373]      لَهُ ذَلِكَ مِرَارًا ، فَغَضِبَ  عُمَرُ  ، فَذَكَرَ ذَلِكَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَانَتْهَوْا إِلَيْهِ وَجَلَسُوا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَسْأَلُكَ أَخُوكَ أَنْ تَسْتَغْفِرَ لَهُ فَلَا تَفْعَلُ  ، فَقَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ نَبِيًّا مَا مِنْ مَرَّةٍ يَسْأَلُنِي إِلَّا وَأَنَا أَسْتَغْفِرُ لَهُ ، وَمَا مِنْ خَلْقِ اللهِ بَعْدَكَ أَحَدٌ أَحَبُّ إِلَيَّ مِنْهُ ، فَقَالَ  أَبُو بَكْرٍ  : وَأَنَا وَالَّذِي بَعَثَكَ بِالْحَقِّ ، مَا مِنْ أَحَدٍ بَعْدَكَ أَحَبُّ إِلَيَّ مِنْهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تُؤْذُونِي فِي صَاحِبِي ، فَإِنَّ اللهَ عَزَّ وَجَلَّ بَعَثَنِي بِالْهُدَى وَدِينِ الْحَقِّ فَقُلْتُمْ : كَذَبْتَ ، وَقَالَ  أَبُو بَكْرٍ  : صَدَقْتَ ، وَلَوْلَا أَنَّ اللهَ عَزَّ وَجَلَّ سَمَّاهُ صَاحِبًا لَاتَّخَذْتُهُ  خَلِيلًا  ، وَلَكِنْ أُخُوَّةُ اللهِ ، أَلَا فَسُدُّوا كُلَّ  خَوْخَةٍ  إِلَّا  خَوْخَةَ  ابْنِ أَبِي قُحَافَةَ  .","","Al-Mu'jam al-Kabir 13383","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن سليمان بن داود العتكي عن الساجي عن الطبراني","نافع عن ابن عمر"
"13420","13384  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، وَعُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ : جَاءَهُ رَجُلٌ يُسَلِّمُ عَلَيْهِ فَذَكَرَ أَنَّهُ يَخْرُجُ إِلَى سَفَرٍ ، فَقَالَ لَهُ  ابْنُ عُمَرَ  :  تَعَالَ حَتَّى أُوَدِّعَكَ  كَمَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوَدِّعُ مَنْ خَرَجَ ، ثُمَّ قَالَ  عَبْدُ اللهِ  :  أَسْتَوْدِعُ اللهَ أَمَانَتَكَ وَدِينَكَ وَخَوَاتِيمَ عَمَلِكَ  .","","Al-Mu'jam al-Kabir 13384","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","نافع عن ابن عمر"
"13421","13385  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ تَوْبَةَ الْقَزْوِينِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، وَعُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ         [12/374]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الشُّفْعَةُ  فِيمَا لَمْ تَقَعِ الْحُدُودُ  ، فَإِذَا وَقَعَتِ الْحُدُودُ فَلَا  شُفْعَةَ  .","","Al-Mu'jam al-Kabir 13385","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن إسماعيل بن توبة القزويني عن الحسين بن إسحاق التستري عن الطبراني","نافع عن ابن عمر"
"13422","13386  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ تَوْبَةَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِيهِ  ، وَعُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَمَّا أَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النُّقَبَاءَ قَالَ :  لَا يَجِدَنَّ امْرُؤٌ فِي نَفْسِهِ شَيْئًا ، إِنَّمَا آخُذُ مَنْ أَشَارَ إِلَيْهِ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ  .","","Al-Mu'jam al-Kabir 13386","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن إسماعيل بن توبة القزويني عن الحسين بن إسحاق التستري عن الطبراني","نافع عن ابن عمر"
"13423","13387  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ الْأَبْرَشُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 13387","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن حرب الأبرش عن محمد بن مصفى بن بهلول عن أحمد بن علي بن مسلم النخشبي عن الطبراني","نافع عن ابن عمر"
"13424","13388  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَوَاقِيتَ لِأَهْلِهَا  وَلِمَنْ أَتَى عَلَيْهَا مِمَّنْ أَرَادَ  الْحَجَّ  وَالْعُمْرَةَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنَ  .","","Al-Mu'jam al-Kabir 13388","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن إسماعيل بن أمية الأموي عن يحيى بن سليم الطائفي عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","نافع عن ابن عمر"
"13425","[12/375]      13389  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ صَالِحٍ النَّطَّاحُ ،  ثَنَا  أَرْطَاةُ أَبُو حَاتِمٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 13389","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أرطاة بن المنذر البصري عن ابن النطاح محمد بن صالح بن مهران عن علي بن سعيد بن بشير عليك عن الطبراني","نافع عن ابن عمر"
"13426","13390  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَعَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْجُدْعَانِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  .","","Al-Mu'jam al-Kabir 13390","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن عبد الرحمن بن أبي بكر الجدعاني عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","نافع عن ابن عمر"
"13427","13391  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نَقُولُ فِي عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ أَوْلَى النَّاسِ بِهَذَا الْأَمْرِ  ؟ فَنَقُولُ :  أَبُو بَكْرٍ  ، ثُمَّ نَقُولُ : أَرَأَيْتُمْ إِنْ قُبِضَ  أَبُو بَكْرٍ  مَنْ يَكُونُ أَوْلَى النَّاسِ بِهَذَا الْأَمْرِ ؟ فَنَقُولُ :  عُمَرُ بْنُ الْخَطَّابِ  ، ثُمَّ نَقُولُ : أَرَأَيْتُمْ إِنْ قُبِضَ  عُمَرُ بْنُ الْخَطَّابِ  مَنْ يَكُونُ أَوْلَى النَّاسِ بِهَذَا الْأَمْرِ ؟ فَنَقُولُ :  عُثْمَانُ  "" .","","Al-Mu'jam al-Kabir 13391","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يوسف بن خالد السمتي عن فضيل بن حسين الجحدري عن محمد بن الفضل بن جابر السقطى عن الطبراني","نافع عن ابن عمر"
"13428","[12/376]      13392  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ ،  ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى الْمِنْبَرِ :  مَنْ أَتَى الْجُمُعَةَ فَلْيَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 13392","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن الفضيل بن عياض عن محمد بن حسان بن خالد السمتي عن محمد بن السري بن مهران الناقد عن الطبراني","نافع عن ابن عمر"
"13429","13393  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ ،  ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  مَنْ حَجَّ فَلْيَكُنْ آخِرُ عَهْدِهِ  بِالْبَيْتِ  إِلَّا الْحُيَّضَ رَخَّصَ لَهُنَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13393","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عيسى بن يونس بن أبي إسحاق عن عمرو بن محمد بن بكير عن محمد بن السري بن مهران الناقد عن الطبراني","نافع عن ابن عمر"
"13430","13394  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْجَرْجَرَائِيُّ ،  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلَاةُ الْخَوْفِ يَقُومُ الْإِمَامُ وَطَائِفَةٌ مِنَ النَّاسِ مَعَهُ فَيَسْجُدُونَ سَجْدَةً وَاحِدَةً  ، وَتَكُونُ طَائِفَةٌ بَيْنَهُمْ وَبَيْنَ الْعَدُوِّ ، ثُمَّ يَنْصَرِفُ الَّذِينَ سَجَدُوا مَعَ أَمِيرِهِمْ فَيَكُونُ مَكَانُ الَّذِينَ لَمْ يُصَلُّوا ، وَيَتَقَدَّمُ الَّذِينَ لَمْ يُصَلُّوا فَيُصَلُّونَ مَعَ أَمِيرِهِمْ سَجْدَةً وَاحِدَةً ،         [12/377]      ثُمَّ يَنْصَرِفُ أَمِيرُهُمْ ، وَقَدْ قَضَى صَلَاتَهُ ، وَيُصَلِّي كُلُّ وَاحِدَةٍ مِنَ الطَّائِفَتَيْنِ لِصَلَاتِهِ سَجْدَةً لِنَفْسِهِ ، فَإِنْ كَانَ خَوْفًا أَشَدَّ مِنْ ذَلِكَ فَرِجَالًا وَرُكْبَانًا  يَعْنِي بِالسَّجْدَةِ رَكْعَةً  .","","Al-Mu'jam al-Kabir 13394","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن جرير بن عبد الحميد عن محمد بن الصباح الجرجرائي عن موسى بن هارون الحمال عن الطبراني","نافع عن ابن عمر"
"13431","13395  -  حَدَّثَنَا  مُحَمَّدُ بْنُ فَضَاءٍ الْجَوْهَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ بُدَيْلٍ الْيَامِيُّ ،  ثَنَا  حَفْصٌ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي الْمَغْرِبِ بِـ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13395","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن حفص بن غياث النخعي عن أحمد بن بديل اليامى عن محمد بن قضاء الجوهري عن الطبراني","نافع عن ابن عمر"
"13432","13396  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَخْطُبُ يَوْمَ الْجُمُعَةِ مَرَّتَيْنِ بَيْنَهُمَا جَلْسَةٌ  .","","Al-Mu'jam al-Kabir 13396","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع عن ابن عمر"
"13433","13397  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  وَعَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِزَكَاةِ الْفِطْرِ  عَلَى  كُلِّ مُسْلِمٍ  حُرٍّ  وَعَبْدٍ ،         [12/378]      وَصَغِيرٍ وَكَبِيرٍ ، صَاعٌ مِنْ تَمْرٍ ، أَوْ صَاعٌ مِنْ شَعِيرٍ  .","","Al-Mu'jam al-Kabir 13397","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع عن ابن عمر"
"13434","13398  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  مُقَدَّمُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عَطَاءٍ ،  ثَنَا  عَمِّي الْقَاسِمُ بْنُ يَحْيَى  ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ يَقْبِضُ السَّمَاوَاتِ بِيَمِينِهِ ، وَالْأَرَضِينَ بِيَدِهِ  -  أَحْسَبُهُ قَالَ : الْأُخْرَى  - ثُمَّ يَقُولُ : أَنَا الْمَلِكُ  .  في طبعة مكتبة ابن تيمية : ( محمد ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 13398","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن القاسم بن يحيى المقدمي عن مقدم بن محمد بن يحيى الهلالي عن البزار عن الطبراني","نافع عن ابن عمر"
"13435","13399  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  ثَنَا  سَلْمُ بْنُ سَالِمٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ  ، وَأَعْطَى الْحَجَّامَ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .","","Al-Mu'jam al-Kabir 13399","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن سلم بن سالم البلخي عن محمد بن موسى بن عمران المنقري عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13436","13400  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عُقْبَةُ بْنُ خَالِدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اتَّخَذَ خَاتَمًا ، وَلَبِسَهُ فِي يَمِينِهِ  .","","Al-Mu'jam al-Kabir 13400","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عقبة بن خالد بن عقبة عن سهل بن عثمان العسكري عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13437","13401  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ زَيْدٍ الصُّدَائِيُّ  ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ اسْقِنَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الحسين بن علي بن يزيد الصدائي )","","Al-Mu'jam al-Kabir 13401","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن علي بن عاصم بن صهيب عن الحسين بن علي الصدائي عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13438","13402  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا         [12/379]      بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ :  لَمْ يَكُنْ يَرَى بَأْسًا بِالْقَزِّ وَالْحَرِيرِ لِلنِّسَاءِ  .","","Al-Mu'jam al-Kabir 13402","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13439","13403  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ مِنَ  الْبِرِّ  الصَّوْمُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 13403","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن حرب الأبرش عن محمد بن مصفى بن بهلول عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13440","13404  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى إِلَى بَعِيرٍ  .","","Al-Mu'jam al-Kabir 13404","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن سفيان الثوري عن وكيع بن الجراح عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13441","13405  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ بَهْرَامَ الْكُوفِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَسْدِلُ عِمَامَتَهُ بَيْنَ كَتِفَيْهِ  .","","Al-Mu'jam al-Kabir 13405","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد العزيز بن محمد الدراوردي عن إسماعيل الوشاء عن الحسين بن إسحاق التستري عن الطبراني","نافع عن ابن عمر"
"13442","13406  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو تَقِيٍّ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  مُحَمَّدٌ الْكُوفِيُّ ،  عَنْ  عُبَيْدِ اللهِ         [12/380]      بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا دَخَلَ أَحَدُكُمْ عَلَى أَخِيهِ الْمُسْلِمِ فَأَرَادَ أَنْ يُفْطِرَ فَلْيُفْطِرْ  إِلَّا أَنْ يَكُونَ صَوْمُهُ ذَلِكَ رَمَضَانَ ، أَوْ قَضَاءَ رَمَضَانَ ، أَوْ نَذْرًا  .","","Al-Mu'jam al-Kabir 13406","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن الفضل بن عطية العبسي عن بقية بن الوليد عن هشام بن عبد الملك اليزني عن الحسين بن إسحاق التستري عن الطبراني","نافع عن ابن عمر"
"13443","13407  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ الْيَهُودَ جَاءُوا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  مِنْهُمْ  وَامْرَأَةٍ  قَدْ زَنَيَا ، فَقَالَ لَهُمْ :  كَيْفَ تَفْعَلُونَ بِمَنْ زَنَى مِنْكُمْ  ؟ "" فَقَالُوا : نَضْرِبُهُمَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَمَا تَجِدُونَ فِي التَّوْرَاةِ ؟ "" قَالُوا : مَا نَجِدُ فِيهَا شَيْئًا ، فَقَالَ لَهُمْ  عَبْدُ اللهِ بْنُ سَلَامٍ  : كَذَبْتُمْ ؛ فِي التَّوْرَاةِ الرَّجْمُ ، فَأْتُوا بِالتَّوْرَاةِ فَاقْرَءُوا إِنْ كُنْتُمْ صَادِقِينَ ، فَأُتِيَ بِالتَّوْرَاةِ فَوَضَعَ  مِدْرَاسُهَا  الَّذِي دَرَسَهَا مِنْهُمْ كَفَّهُ عَلَى آيَةِ الرَّجْمِ ، فَطَفِقَ يَقْرَأُ مَا دُونَ يَدِهِ وَمَا وَرَاءَهَا وَلَا يَقْرَأُ آيَةَ الرَّجْمِ ، فَنَتَرَ  عَبْدُ اللهِ  يَدَهُ عَلَى آيَةِ الرَّجْمِ ، فَقَالَ : مَا هَذِهِ ؟ فَلَمَّا رَأَوْا ذَلِكَ قَالُوا : هِيَ الرَّجْمُ فَأَمَرَ بِهِمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرُجِمَا حَيْثُ يُوجَدُ الْجَنَائِزُ ، قَالَ  عَبْدُ اللهِ  : فَرَأَيْتُ صَاحِبَهَا يَحْنُو عَلَيْهَا لِيَقِيَهَا الْحِجَارَةَ  .","","Al-Mu'jam al-Kabir 13407","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع عن ابن عمر"
"13444","13408  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  مُوسَى بْنُ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ كَانَ يَقُولُ :  قَدْ نُهِيَ أَنْ يُنْبَذَ الْبُسْرُ وَالرُّطَبُ جَمِيعًا  ، وَالتَّمْرُ وَالزَّبِيبُ جَمِيعًا  "" .","","Al-Mu'jam al-Kabir 13408","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","نافع عن ابن عمر"
"13445","[12/381]      13409  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  أَبُو ثَابِتٍ الْمَدَنِيِّ  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَلَاةٍ عِنْدَ طُلُوعِ الشَّمْسِ  ، وَعِنْدَ غُرُوبِهَا  .  في طبعة مكتبة ابن تيمية : ( المدين ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 13409","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن محمد بن عبيد الله بن محمد بن زيد الأموي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","نافع عن ابن عمر"
"13446","13410  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلُّوَيْهِ الْقَطَّانُ ،  ثَنَا  عَلِيُّ بْنُ سِيَابَةَ الْكُوفِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ الْقَاسِمِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُصْعَبٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  خَفَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْخَنْدَقَ  إِلَّا عَلَى سِتَّةِ نَفَرٍ  أَرْبَعَةٍ مِنَ  الْمُهَاجِرِينَ  :  طَلْحَةُ  ،  وَالزُّبَيْرُ  ،  وَعَلِيٌّ  ،  وَسَعْدٌ  ، وَمِنَ  الْأَنْصَارِ  أَبُو دُجَانَةَ  ،  وَالْحَارِثُ بْنُ الصِّمَّةِ  .","","Al-Mu'jam al-Kabir 13410","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد الله بن مصعب بن ثابت الزبيري عن يوسف بن يعقوب بن أبي القاسم السلعي عن علي بن سيابة عن ابن علويه الحسن بن علي القطان عن الطبراني","نافع عن ابن عمر"
"13447","13411  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَبُو مُصْعَبٍ ،  ثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أَسْكَرَ كَثِيرُهُ فَقَلِيلُهُ حَرَامٌ  .","","Al-Mu'jam al-Kabir 13411","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن أحمد بن أبي بكر العوفى عن علي بن سعيد بن بشير عليك عن الطبراني","نافع عن ابن عمر"
"13448","13412  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ         [12/382]      نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَلَقَ رَأْسَهُ فِي  حَجَّةِ الْوَدَاعِ  .","","Al-Mu'jam al-Kabir 13412","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن حاتم بن إسماعيل الحارثي عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","نافع عن ابن عمر"
"13449","13413  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رُبَّ صَائِمٍ حَظُّهُ مِنْ صِيَامِهِ الْجُوعُ  وَالْعَطَشُ ، وَرُبَّ قَائِمٍ حَظُّهُ مِنْ قِيَامِهِ السَّهَرُ  .","","Al-Mu'jam al-Kabir 13413","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن معاوية بن يحيى الطرابلسي عن بقية بن الوليد عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","نافع عن ابن عمر"
"13450","13414  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ الْخَلَّالُ الدِّمَشْقِيُّ ،  ثَنَا  زَيْدُ بْنُ يَحْيَى بْنِ عُبَيْدٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَفَى بِالْمَرْءِ إِثْمًا أَنْ يُضَيِّعَ مَنْ  يَقُوتُ  .","","Al-Mu'jam al-Kabir 13414","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن إسماعيل بن عياش الأحول عن زيد بن يحيى بن عبيد الخزاعي عن عباس بن الوليد الخلال عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع عن ابن عمر"
"13451","13415  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ ،  ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  الْعَطَّافُ بْنُ خَالِدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي عَلَى  الْخُمْرَةِ  ، وَيَسْجُدُ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 13415","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عطاف بن خالد المخزومي عن قتيبة بن سعيد عن النسائي عن الطبراني","نافع عن ابن عمر"
"13452","13416  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا         [12/383]      حُسَيْنُ بْنُ مُحَمَّدٍ ،  ثَنَا  سُلَيْمَانُ بْنُ قَرْمٍ ،  عَنْ  زَيْدٍ يَعْنِي ابْنَ جُبَيْرٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ غَزَاهَا عَلَى  امْرَأَةٍ  مَقْتُولَةٍ فَنَهَى عَنْ قَتْلِ النِّسَاءِ  وَالصِّبْيَانِ  .","","Al-Mu'jam al-Kabir 13416","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن زيد بن جبير الطائي عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","نافع عن ابن عمر"
"13453","13417  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْخُتَّلِيُّ  ،  ثَنَا  عِمْرَانُ بْنُ عُيَيْنَةَ ،  عَنْ  حُصَيْنٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يَدْنُوَ الرَّجُلُ مِنَ الرَّجُلَيْنِ وَهُمَا  يَتَنَاجَيَانِ  إِلَّا أَنْ يَسْتَأْذِنَهُمَا  .  كذا في طبعة مكتبة ابن تيمية وغير واضح في النسخ الخطية وتحتمل صورته : (الحنائي) وهي نسبة ثابتة في ترجمته فلعلها الصواب ، والله أعلم .","","Al-Mu'jam al-Kabir 13417","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حصين بن عبد الرحمن السلمي عن عمران بن عيينة الهلالي عن يحيى بن محمد بن البختري الحنائي عن الطبراني","نافع عن ابن عمر"
"13454","13418  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَرَجِ الْهَاشِمِيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْكُمْ بِالْعَمَائِمِ فَإِنَّهَا سِيمَاءُ الْمَلَائِكَةِ  ، وَأَرْخُوا لَهَا خَلْفَ ظُهُورِكُمْ  .","","Al-Mu'jam al-Kabir 13418","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن مغول الصهيبي عن عيسى بن يونس بن أبي إسحاق عن محمد بن الفرج الفراء عن يحيى بن عثمان بن صالح عن الطبراني","نافع عن ابن عمر"
"13455","13419  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ ،  ثَنَا  مُحَمَّدُ بْنُ حَسَّانَ السَّمْتِيُّ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَتَى الْجُمُعَةَ فَلْيَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 13419","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن الفضيل بن عياض عن محمد بن حسان بن خالد السمتي عن محمد بن السري بن مهران الناقد عن الطبراني","نافع عن ابن عمر"
"13456","13420  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ جَبَلَةَ ،  ثَنَا  أُمَيَّةُ بْنُ خَالِدٍ ،  ثَنَا  قُرَّةُ ،  عَنْ  نَافِعٍ ، قَالَ : ""  كَانَ ابْنُ         [12/384]      عُمَرَ إِذَا أَرَادَ أَنْ يُحْرِمَ أَتَى  ذَا الْحُلَيْفَةِ  فَبَاتَ  ، فَإِذَا أَصْبَحَ رَكِبَ رَاحِلَتَهُ فَإِذَا اسْتَوَتْ بِهِ أَهَلَّ  ،  وَزَعَمَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَفْعَلُهُ  .","","Al-Mu'jam al-Kabir 13420","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن قرة بن خالد السدوسي عن أمية بن خالد الثوباني عن محمد بن عمرو بن عباد العتكي عن الحسن بن علي بن شبيب المعمري عن الطبراني","نافع عن ابن عمر"
"13457","13421  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عَوْنٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَتَبَ إِلَيَّ  نَافِعٌ  أَنَّ  ابْنَ عُمَرَ ، قَالَ :  نُهِيَ عَنْ لُحُومِ الْحُمُرِ  الْإِنْسِيَّةِ  ""  .","","Al-Mu'jam al-Kabir 13421","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عون بن أرطبان عن عبيد الله بن عبد الله بن عون عن إسماعيل بن مسعود الجحدري عن الحسن بن علي بن شبيب المعمري عن الطبراني","نافع عن ابن عمر"
"13458","13422  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مَسْعُودٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عَوْنٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ بَارِكْ لَنَا فِي  شَامِنَا  ، اللَّهُمَّ بَارِكْ فِي  يَمَنِنَا  "" فَقَالَهَا مِرَارًا فَلَمَّا كَانَ فِي  الثَّالِثَةِ أَوِ الرَّابِعَةِ  ، قَالُوا : يَا رَسُولَ اللهِ وَفِي  عِرَاقِنَا  قَالَ : "" إِنَّ بِهَا الزَّلَازِلَ ، وَالْفِتَنَ ، وَبِهَا يَطْلُعُ قَرْنُ الشَّيْطَانِ  .","","Al-Mu'jam al-Kabir 13422","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عون بن أرطبان عن عبيد الله بن عبد الله بن عون عن إسماعيل بن مسعود الجحدري عن الحسن بن علي بن شبيب المعمري عن الطبراني","نافع عن ابن عمر"
"13459","13423  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ قُهْزَاذَ  ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ ،  أَنَا  أَبُو حَمْزَةَ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ  إِلَّا كَلْبَ صَيْدٍ أَوْ كَلْبَ مَاشِيَةٍ  .  في طبعة مكتبة ابن تيمية : ( قهراد ) وهي على الصواب في نسخة خطية ، وقال النووي في شرح مسلم : ""أما ( قهزاذ ) فبقاف مضمومة ثم هاء ساكنة ثم زاي ثم ألف ثم ذال معجمة ، هذا هو الصحيح المشهور المعروف في ضبطه"" أ.هـ","","Al-Mu'jam al-Kabir 13423","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الكريم الاصطخري عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن عبد الله بن قهزاذ المروزي عن محمد بن علي بن محمد المروزي عن الطبراني","نافع عن ابن عمر"
"13460","[12/385]      13424  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَبُو مُصْعَبٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عِيسَى بْنِ عُمَرَ بْنِ مُوسَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ إِذَا اعْتَكَفَ طُرِحَ لَهُ فِرَاشُهُ وَسَرِيرُهُ إِلَى  أُسْطُوَانِ التَّوْبَةِ  مِمَّا يَلِي الْقِبْلَةَ ثُمَّ يَسْتَنِدُ إِلَيْهَا  .","","Al-Mu'jam al-Kabir 13424","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عيسى بن عمر بن موسى الحجازي عن عبد العزيز بن محمد الدراوردي عن أحمد بن أبي بكر العوفى عن موسى بن هارون الحمال عن الطبراني","نافع عن ابن عمر"
"13461","13425  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  مُسْلِمِ بْنِ عَبْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ لِلهِ  ضَنَائِنَ  مِنْ خَلْقِهِ يُحْيِيهِمْ فِي عَافِيَةٍ  ، وَإِذَا تَوَفَّاهُمْ إِلَى جَنَّتِهِ ، أُولَئِكَ الَّذِينَ يَمُرُّ عَلَيْهِمُ الْفِتَنُ  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ ، وَهُمْ فِيهَا فِي عَافِيَةٍ  .","","Al-Mu'jam al-Kabir 13425","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مسلم بن عبد الله عن إسماعيل بن عياش الأحول عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","نافع عن ابن عمر"
"13462","13426  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْعَبَّاسِ الْقُرَظِيُّ الْبَغْدَادِيُّ ،  ثَنَا  يَحْيَى بْنُ عُثْمَانَ الْحَرْبِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ، وَمُوسَى بْنِ عُقْبَةَ ، وَعَبْدُ اللهِ بْنُ عُمَرَ ، وَعَبْدُ اللهِ بْنُ زِيَادِ بْنِ سَمْعَانَ ، وَعَبْدُ الْعَزِيزِ بْنُ عُبَيْدِ اللهِ ، وَبُرْدُ بْنُ سِنَانٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" بَعَثَ سَرِيَّةً قِبَلَ  نَجْدٍ  وَعَبْدُ اللهِ  فِيهَا فَغَنِمْنَا إِبِلًا كَثِيرَةً  فَكَانَتْ  سُهْمَانُنَا  قَدْ بَلَغَتِ اثْنَيْ عَشَرَ بَعِيرًا ، وَنَفَّلَنَا رَسُولُ اللهِ بَعِيرًا بَعِيرًا  .","","Al-Mu'jam al-Kabir 13426","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن إسماعيل بن عياش الأحول عن يحيى بن عثمان السجستاني عن الفضل بن العباس بن الوليد البزوري عن الطبراني","نافع عن ابن عمر"
"13463","[12/386]      13427  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ ،  ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  النُّعْمَانِ بْنِ الْمُنْذِرِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُهِلُّ حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ  .","","Al-Mu'jam al-Kabir 13427","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن النعمان بن المنذر الغساني عن يحيى بن حمزة بن البتلهي عن الحكم بن موسى بن أبي زهير النسائي عن محمد بن السري بن مهران الناقد عن الطبراني","نافع عن ابن عمر"
"13464","13428  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ قُهْزَادَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى عَلَى زَانِيَةٍ مَاتَتْ فِي  نِفَاسِهَا  وَوَلَدِهَا  .","","Al-Mu'jam al-Kabir 13428","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن زياد عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن عبد الله بن قهزاذ المروزي عن محمد بن علي بن محمد المروزي عن الطبراني","نافع عن ابن عمر"
"13465","13429  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ قُهْزَادُ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  الْمُطَلَّقَةُ ثَلَاثًا لَا تَحِلُّ لِزَوْجِهَا الْأَوَّلِ  حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ ، وَيُخَالِطَهَا ، وَتَذُوقَ مِنْ  عُسَيْلَتِهِ  "" .","","Al-Mu'jam al-Kabir 13429","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن زياد عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن عبد الله بن قهزاذ المروزي عن محمد بن علي بن محمد المروزي عن الطبراني","نافع عن ابن عمر"
"13466","[  الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13430  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ : "" كَانَ يَتَوَضَّأُ ثَلَاثًا ثَلَاثًا  ، يُسْنِدُ ذَلِكَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13430","","عبد الله بن عمر بن الخطاب عن المطلب بن عبد الله بن حنطب المخزومي عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","المطلب بن عبد الله بن حنطب عن ابن عمر"
"13467","[12/387]      13431  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  قَالَ  :  سَأَلَ رَجُلٌ ابْنَ عُمَرَ عَنِ  الْوِتْرِ  ، فَقَالَ :  أَوْتِرْ  بِوَاحِدَةٍ  ، فَقَالَ الرَّجُلُ : إِنِّي أَخْشَى أَنْ يَقُولَ النَّاسُ إِنَّهَا بُتَيْرَاءُ قَالَ : "" سُنَّةُ اللهِ وَسُنَّةُ رَسُولِهِ "" ، يُرِيدُ هَذِهِ سُنَّةُ اللهِ وَسُنَّةُ رَسُولِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13431","","عبد الله بن عمر بن الخطاب عن المطلب بن عبد الله بن حنطب المخزومي عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","المطلب بن عبد الله بن حنطب عن ابن عمر"
"13468","13432  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ،  ثَنَا  كَثِيرُ بْنُ زَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  مَا رَأَيْتُ أَحَدًا مِنَ النَّاسِ بَعْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَسْوَدَ  مِنْ  مُعَاوِيَةَ  .","","Al-Mu'jam al-Kabir 13432","","عبد الله بن عمر بن الخطاب عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن عبد الله بن يزيد البكري عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","المطلب بن عبد الله بن حنطب عن ابن عمر"
"13469","[  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13433  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  كَسَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  قُبْطِيَّةً  ، وَكَسَى  أُسَامَةَ بْنَ زَيْدٍ  حُلَّةً  سِيَرَاءَ  ، فَنَظَرَ فَرَآنِي أَسْبَلْتُ فَجَاءَ فَأَخَذَ بِمَنْكِبِي فَقَالَ : "" يَا  ابْنَ عُمَرَ  كُلُّ شَيْءٍ يَمَسُّ الْأَرْضَ مِنَ الثِّيَابِ فِي النَّارِ "" فَرَأَيْتُ  ابْنَ عُمَرَ  يَأْتَزِرُ إِلَى نِصْفِ السَّاقِ  .","","Al-Mu'jam al-Kabir 13433","","عبد الله بن عمر بن الخطاب عن عبد الله بن محمد بن عقيل بن أبي طالب عن سفيان الثوري عن محمد بن كثير العبدي عن عثمان بن عمر الضبي عن الطبراني","عبد الله بن محمد بن عقيل عن ابن عمر"
"13470","[12/388]      [  مُحَمَّدُ بْنُ طَلْحَةَ  ، عَنِ  ابْنِ عُمَرَ  ]  13434  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  عَلِيُّ بْنُ زَيْدٍ الْفَرَائِضِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحُنَيْنِيُّ ،  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  يَحْيَى بْنِ مُحَمَّدِ بْنِ طَلْحَةَ  ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَحَبَّ الْبُيُوتِ إِلَى اللهِ ، بَيْتٌ فِيهِ يَتِيمٌ مُكْرَمٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (طحلاء) كما في طرق تخريج الحديث .","","Al-Mu'jam al-Kabir 13434","","عبد الله بن عمر بن الخطاب عن محمد بن طحلاء الغطفاني عن يحيى بن محمد بن طحلاء الليثي عن مالك بن أنس عن إسحاق الحنيني عن علي بن زيد بن عبد الله الفرائضي عن الساجي عن الطبراني","محمد بن طلحة عن ابن عمر"
"13471","[  حُمْرَانُ  ، عَنِ  ابْنِ عُمَرَ  ]  13435  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ شَيْبَةَ الْمِصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  أَبُو الْجَوَّابِ ،  ثَنَا  عَمَّارُ بْنُ رُزَيْقٍ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنِ  الْقَاسِمِ بْنِ أَبِي بَزَّةَ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ ،  عَنْ  حُمْرَانَ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قَالَ : سُبْحَانَ اللهِ ، وَالْحَمْدُ لِلهِ ، وَلَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ  ، كُتِبَتْ لَهُ بِكُلِّ حَرْفٍ عَشْرُ حَسَنَاتٍ ، وَمَنْ أَعَانَ فِي خُصُومَةِ بَاطِلٍ لَمْ يَزَلْ فِي  سَخَطِ  اللهِ حَتَّى يَنْزِعَ ، وَمَنْ حَالَتْ شَفَاعَتُهُ دُونَ حَدٍّ مِنْ حُدُودِ اللهِ فَقَدْ ضَادَّ اللهَ فِي أَمْرِهِ ، وَمَنْ بَهَتَ مُؤْمِنًا أَوْ مُؤْمِنَةً حَبَسَهُ اللهُ فِي  رَدْغَةِ  الْخَبَالِ  يَوْمَ الْقِيَامَةِ ، حَتَّى يَخْرُجَ مِمَّا قَالَ وَلَيْسَ بِخَارِجٍ  .","","Al-Mu'jam al-Kabir 13435","","عبد الله بن عمر بن الخطاب عن حمران بن أبان النمري عن عطاء الخراساني عن القاسم بن أبي بزة عن فطر بن خليفة عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن محمد بن منصور الطوسي عن محمد بن عيسى بن شيبة السدوسي عن الطبراني","حمران عن ابن عمر"
"13472","[12/389]      [  عُبَيْدُ بْنُ عُمَيْرٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13436  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  ثَنَا  الْقَاسِمُ بْنُ يَزِيدَ الْجَرْمِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ اللَّيْثِيِّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الذُّبَابُ  كُلُّهُ فِي النَّارِ إِلَّا النَّحْلَةَ  وَكَانَ يَنْهَى عَنْ قَتْلِهِنَّ ، وَعَنْ إِحْرَاقِ الطَّعَامِ  .  قَالَ  سُفْيَانُ  :  يُشْبِهُ أَنْ يَكُونَ إِحْرَاقُ الطَّعَامِ فِي أَرْضِ الْعَدُوِّ  .","","Al-Mu'jam al-Kabir 13436","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن القاسم بن يزيد الجرمي عن محمد بن عبد الله بن عمار الغامدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد بن عمير عن ابن عمر"
"13473","13437  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى الْمِنْبَرِ وَهُوَ يَقُولُ : "" يَأْخُذُ  الدَّيَّانُ  سَمَاوَاتِهِ ، وَأَرَضِيهِ بِيَدِهِ "" ، وَقَبَضَ يَدَهُ ، وَجَعَلَ يَقْبِضُهُمَا ، وَيَبْسُطُهُمَا ثُمَّ يَقُولُ :  أَنَا الْجَبَّارُ أَيْنَ الْجَبَّارُونَ  ؟ أَيْنَ الْمُتَكَبِّرُونَ ؟ "" وَتَمَيَّلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ ، حَتَّى نَظَرْتُ إِلَى الْمِنْبَرِ يَتَحَرَّكُ مِنْ أَسْفَلِ شَيْءٍ مِنْهُ حَتَّى إِنِّي لَأَقُولُ : أَسَاقِطٌ هُوَ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  ؟","","Al-Mu'jam al-Kabir 13437","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد بن عمير عن ابن عمر"
"13474","13438  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا         [12/390]      مَعْمَرٌ ، وَالثَّوْرِيُّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مَسْحَ الْحَجَرِ الْأَسْوَدِ ،  وَالرُّكْنِ الْيَمَانِي  يَحُطَّانِ الْخَطَايَا حَطًّا  .","","Al-Mu'jam al-Kabir 13438","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبيد بن عمير عن ابن عمر"
"13475","13439  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  ثَنَا  عَطَاءُ بْنُ السَّائِبِ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ اللَّيْثِيُّ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  قُلْتُ لِابْنِ عُمَرَ :  أَرَاكَ تُزَاحِمُ عَلَى هَذَيْنِ الرُّكْنَيْنِ  ، قَالَ : إِنْ أَفْعَلْ فَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مَسْحَهُمَا يَحُطَّانِ الْخَطَايَا  .","","Al-Mu'jam al-Kabir 13439","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عبيد بن عمير عن ابن عمر"
"13476","13440  -  وَسَمِعْتُهُ  يَقُولُ :  مَنْ طَافَ بِهَذَا  الْبَيْتِ  سُبُوعًا  يُحْصِيهِ كُتِبَ لَهُ بِكُلِّ خُطْوَةٍ حَسَنَةٌ  ، وَكُفِّرَتْ عَنْهُ سَيِّئَةٌ ، وَرُفِعَتْ لَهُ دَرَجَةٌ ، وَكَانَ عَدْلَ عِتْقِ رَقَبَةٍ  .","","Al-Mu'jam al-Kabir 13440","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عبيد بن عمير عن ابن عمر"
"13477","13441  -  وَسَمِعْتُهُ  يَقُولُ : ""  مَنْ  شَرِبَ  الْخَمْرَ  لَمْ يُقْبَلْ لَهُ أَوْ لَمْ يَتَقَبَّلِ اللهُ لَهُ  صَلَاةً أَرْبَعِينَ صَبَاحًا  ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ لَمْ يُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ صَبَاحًا ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ لَمْ يُقْبَلْ لَهُ صَلَاةٌ ، وَكَانَ حَقًّا عَلَى اللهِ أَنْ يَسْقِيَهَ مِنْ نَهَرِ  الْخَبَالِ  "" ،  قُلْنَا : يَا أَبَا عَبْدِ الرَّحْمَنِ مَا نَهَرُ  الْخَبَالِ  ؟ قَالَ :  صَدِيدُ  أَهْلِ النَّارِ  .","","Al-Mu'jam al-Kabir 13441","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عبيد بن عمير عن ابن عمر"
"13478","13442  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  ثَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  صَالِحٍ مَوْلَى مَازِنٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : ""  ثَلَاثَةٌ لَا يَنْظُرُ اللهُ إِلَيْهِمْ         [12/391]      يَوْمَ الْقِيَامَةِ  : الْمَنَّانُ عَطَاءَهُ ،  وَالْمُسْبِلُ  إِزَارَهُ  خُيَلَاءَ  ،  وَمُدْمِنُ  الْخَمْرِ ""  قِيلَ : يَا أَبَا عَبْدِ الرَّحْمَنِ مَا  مُدْمِنُ  الْخَمْرِ ؟ قَالَ :  الْمُدَاوَمَةُ عَلَيْهَا  .","","Al-Mu'jam al-Kabir 13442","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن صالح المازني عن الحسين بن واقد المروزي عن علي بن الحسن بن شقيق عن محمود بن غيلان المروزي عن الحسين بن إسحاق التستري عن الطبراني","عبيد بن عمير عن ابن عمر"
"13479","13443  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي دَاوُدَ ،  عَنْ  طُفَيْلِ بْنِ سِنَانٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  سَمِعْتُ  رَجُلًا يَقُولُ لِابْنِ عُمَرَ : أَلَمْ تَسْمَعْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنِّي لَأَمْزَحُ ، وَلَا أَقُولُ إِلَّا حَقًّا ؟ "" قَالَ : نَعَمْ  .","","Al-Mu'jam al-Kabir 13443","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن طفيل بن سنان عن سليمان بن أبي داود الحراني بومة عن عبد الله بن يزيد البكري عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","عبيد بن عمير عن ابن عمر"
"13480","13444  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  خَلِيفَةُ بْنُ خَيَّاطٍ الْعُصْفُرِيُّ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  ثَنَا  عَبْدُ الْمَلِكِ يَعْنِي ابْنَ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ يُزَاحِمُ عَلَى  الرُّكْنَيْنِ  زِحَامًا شَدِيدًا  ، وَقَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُزَاحِمُ عَلَيْهِ  ، وَسَمِعْتُهُ يَقُولُ : "" لَا يَضَعُ قَدَمًا وَلَا يَرْفَعُ إِلَّا كُتِبَ لَهُ بِهَا حَسَنَةٌ  .","","Al-Mu'jam al-Kabir 13444","","عبد الله بن عمر بن الخطاب عن عبيد بن عمير بن قتادة الجندعي عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن زياد بن عبد الله البكائي عن خليفة بن خياط عن عبد الله بن أحمد الجواليقي عن الطبراني","عبيد بن عمير عن ابن عمر"
"13481","[  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13445  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  أَخْبَرَنِي  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً ،  فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ "" قَالَهَا ثَلَاثًا "" فَإِنْ عَادَ كَانَ حَقًّا عَلَى اللهِ أَنْ         [12/392]      يَسْقِيَهُ مِنْ نَهَرِ  الْخَبَالِ  "" قِيلَ : وَمَا نَهَرُ  الْخَبَالِ  ؟ قَالَ : ""  صَدِيدُ  أَهْلِ النَّارِ  .","","Al-Mu'jam al-Kabir 13445","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن عبيد بن عمير عن ابن عمر"
"13482","13446  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  قَالَ رَجُلٌ لِابْنِ عُمَرَ :  يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَا لِي أَرَاكَ تَسْتَلِمُ الرُّكْنَيْنِ  ، وَلَا تَتْرُكُهُمَا ؟ وَكَانَ  ابْنُ عُمَرَ  يَفْعَلُهُ  قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ مَسْحَهُمَا يَحُطُّ الذُّنُوبَ  .","","Al-Mu'jam al-Kabir 13446","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عبيد بن عمير عن ابن عمر"
"13483","13447  -  وَسَمِعْتُهُ  يَقُولُ :  مَنْ طَافَ بِهَذَا الْبَيْتِ  أُسْبُوعًا  كَانَتْ لَهُ بِهَا رَقَبَةٌ  .","","Al-Mu'jam al-Kabir 13447","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عبيد بن عمير عن ابن عمر"
"13484","13448  -  وَسَمِعْتُهُ  يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ فِي الدُّنْيَا لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً  ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ عَادَ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، فَإِنْ شَرِبَهَا الرَّابِعَةَ كَانَ حَقًّا عَلَى اللهِ أَنْ يَسْقِيَهُ مِنْ طِينَةِ  خَبَالٍ  "" قِيلَ : وَمَا طِينَةُ  خَبَالٍ  ؟ قَالَ : ""  صَدِيدُ  أَهْلِ النَّارِ  .","","Al-Mu'jam al-Kabir 13448","","عبد الله بن عمر بن الخطاب عن عبد الله بن عبيد بن عمير الجندعي عن عطاء بن السائب عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عبيد بن عمير عن ابن عمر"
"13485","[  طَاوُسٌ  ، عَنِ  ابْنِ عُمَرَ  ]  13449  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا         [12/393]      سُفْيَانُ ،  عَنْ  حَنْظَلَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمِكْيَالُ  مِكْيَالُ  أَهْلِ الْمَدِينَةِ  ، وَالْوَزْنُ وَزْنُ  أَهْلِ مَكَّةَ  .","","Al-Mu'jam al-Kabir 13449","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن حنظلة الجمحي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عمر"
"13486","13450  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  طَاوُسٍ ، قَالَ :  دَخَلَ  رَجُلٌ  عَلَى ابْنِ عُمَرَ فَسَأَلَهُ عَنْ نَبِيذِ  الْجَرِّ  ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَبِيذِ  الْجَرِّ  .  وَقَالَ  سُلَيْمَانُ بْنُ حَرْبٍ  فِي حَدِيثِهِ : حَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13450","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن سليمان بن طرخان عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عمر"
"13487","13451  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا أَسَدُ بْنُ  مُوسَى ، سَنَةَ إِحْدَى عَشْرَةَ وَمِائَتَيْنِ إِمْلَاءً  ثَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ وَإِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، قَالَا :  سَمِعْنَا  طَاوُسًا ، يَقُولُ :  جَاءَ وَاللهِ  رَجُلٌ  إِلَى ابْنِ عُمَرَ فَقَالَ :  أَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ نَبِيذِ  الْجَرِّ  ؟ قَالَ : نَعَمْ  .  سقط من طبعة مكتبة ابن تيمية ، وأثبتناه من النسخ الخطية .","","Al-Mu'jam al-Kabir 13451","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن شعبة بن الحجاج عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","طاوس عن ابن عمر"
"13488","13452  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،         [12/394]      ثَنَا  سُلَيْمَانُ أَبُو الْمُغِيرَةِ  ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  طَاوُسٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى ابْنِ عُمَرَ ، فَقَالَ :  أَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنْ نَبِيذِ  الْجَرِّ  ؟ قَالَ : نَعَمْ  حَلَفَ لَنَا  طَاوُسٌ  بِاللهِ أَنَّهُ سَمِعَهُ مِنِ  ابْنِ عُمَرَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سليمان بن المغيرة )","","Al-Mu'jam al-Kabir 13452","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن سليمان بن طرخان عن سليمان بن المغيرة القيسي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","طاوس عن ابن عمر"
"13489","13453  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  بَكَّارِ بْنِ وَيْهَكَ  ،  عَنْ  خَلَّادِ بْنِ عَبْدِ الرَّحْمَنِ أَنَّهُ سَأَلَ طَاوُسًا عَنِ الشَّرَابِ ،  فَأَخْبَرَهُ  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْجَرِّ  وَالدُّبَّاءِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (بكار بن عبد الله بن وهب) كما في مسند أحمد .","","Al-Mu'jam al-Kabir 13453","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن خلاد بن عبد الرحمن الأبناوي عن بكار بن عبد الله بن وهب الأبناوي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عمر"
"13490","13454  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  ابْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  جَاءَهُ فَقَالَ :  أَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَنْ يُنْبَذَ فِي  الْجَرِّ  وَالدُّبَّاءِ  ؟ قَالَ : نَعَمْ  .","","Al-Mu'jam al-Kabir 13454","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن عبد الله بن طاووس عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عمر"
"13491","13455  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ نَبِيذَ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 13455","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن عبيد الله بن عمر القواريري عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عمر"
"13492","13456  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  ابْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  أَنَّهُ :  سَمِعَ  ابْنَ عُمَرَ  سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ حَائِضًا : فَقَالَ :  أَتَعْرِفُ  عَبْدَ اللهِ بْنَ عُمَرَ  ؟ قَالَ : نَعَمْ ، قَالَ : فَإِنَّهُ طَلَّقَ امْرَأَتَهُ حَائِضًا فَذَهَبَ  عُمَرُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبَرَهُ الْخَبَرَ ، فَأَمَرَهُ أَنْ يُرَاجِعَهَا  ، قَالَ : لَمْ         [12/395]      أَسْمَعْهُ يَزِيدُ عَلَى ذَلِكَ .","","Al-Mu'jam al-Kabir 13456","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن عبد الله بن طاووس عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عمر"
"13493","13457  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  خَالِدُ بْنُ يُوسُفَ السَّمْتِيُّ ،  ثَنَا  عَبْدُ النُّورِ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوْلَعْتُهُمْ  بِعَمَّارٍ  يَدْعُوهُمْ إِلَى الْجَنَّةِ  ، وَيَدْعُونَهُ إِلَى النَّارِ  .","","Al-Mu'jam al-Kabir 13457","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن ليث بن أبي سليم عن عبد الملك بن أبي سليمان العرزمي عن عبد النور بن عبد الله المسمعي عن خالد بن يوسف بن خالد السمتي عن البزار عن الطبراني","طاوس عن ابن عمر"
"13494","13458  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  كَثِيرُ بْنُ عُبَيْدٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي تَوْبَةَ النُّمَيْرِيِّ ،  عَنْ  عَبَّادِ بْنِ كَثِيرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ كَرَامَةِ الْمُؤْمِنِ عَلَى اللهِ نَقَاءَ ثَوْبِهِ  ، وَرِضَاهُ بِالْيَسِيرِ  .","","Al-Mu'jam al-Kabir 13458","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن عبد الله بن طاووس عن عباد بن كثير الرملي عن جرول بن جنفل النميري عن بقية بن الوليد عن كثير بن عبيد المذحجي عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عمر"
"13495","13459  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ .  وَعَبْدُ اللهِ بْنُ عُمَرَ  ، عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبَّقَ بَيْنَ الْخَيْلِ فَأَرْسَلَهَا مِنَ  الْحَيْفَاءِ  فَكَانَ أَمَدُهَا إِلَى  ثَنِيَّةِ الْوَدَاعِ  ، وَسَابَقَ بَيْنَ الْخَيْلِ الَّتِي لَمْ تُضَمَّرْ ، وَكَانَ أَمَدُهَا مِنَ  الثَّنِيَّةِ  إِلَى  مَسْجِدِ بَنِي زُرَيْقٍ  .         [12/396]","","Al-Mu'jam al-Kabir 13459","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عمر"
"13496","13460  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ ،  ثَنَا  يَحْيَى بْنُ الْمَقَابِرِيِّ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ ، قَالَ :  سَمِعْتُ  طَاوُسًا يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَنْفِرَ الرَّجُلُ حَتَّى يَكُونَ آخِرُ عَهْدِهِ  بِالْبَيْتِ  إِلَّا الْحُيَّضَ رَخَّصَ لَهُنَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنْ يَنْفِرْنَ  .","","Al-Mu'jam al-Kabir 13460","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن إبراهيم بن يزيد الخوزي عن مروان بن معاوية الفزاري عن يحيى بن أيوب المقابري عن الحسن بن علي بن الوليد الفسوي عن الطبراني","طاوس عن ابن عمر"
"13497","13461  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  طَاوُسٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى فَإِذَا خَشِيتَ الصُّبْحَ فَوَاحِدَةً  .","","Al-Mu'jam al-Kabir 13461","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن حبيب بن أبي ثابت الكاهلي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عمر"
"13498","13462  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحِلُّ لِرَجُلٍ يُعْطِي عَطِيَّةً ، أَوْ يَهَبُ هِبَةً ، فَيَرْجِعُ فِيهَا إِلَّا الْوَالِدُ  فِيمَا يُعْطِي وَلَدَهُ ، وَمَثَلُ الَّذِي يُعْطِي الْعَطِيَّةَ ثُمَّ يَرْجِعُ فِيهَا كَمَثَلِ الْكَلْبِ يَأْكُلُ فَإِذَا شَبِعَ فَأَتَمَّ عَادَ فِي قَيْئِهِ  .","","Al-Mu'jam al-Kabir 13462","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن شعيب عن حسين المعلم عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","طاوس عن ابن عمر"
"13499","13463  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ الْعِجْلِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ ،  رَفَعَهُ  قَالَ :  لَا تُبَاعُ  الثَّمَرَةُ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Al-Mu'jam al-Kabir 13463","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أحمد بن المقدام العجلي عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عمر"
"13500","[12/397]      [  مُجَاهِدٌ  ، عَنِ  ابْنِ عُمَرَ  ]  13464  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عُمَرَ ، قَالَ :  نُهِيَ عَنِ  الْجَلَّالَةِ  "" .","","Al-Mu'jam al-Kabir 13464","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبو الزبير المكي عن ابن جريج عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مجاهد عن ابن عمر"
"13501","13465  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَأَلَكُمْ بِاللهِ فَأَعْطُوهُ  ، وَمَنِ اسْتَعَاذَ بِاللهِ فَأَعِيذُوهُ ، وَمَنْ دَعَاكُمْ فَأَجِيبُوهُ ، وَمَنْ أَتَى إِلَيْكُمْ مَعْرُوفًا فَكَافِئُوهُ ، فَإِنْ لَمْ تَجِدُوا مَا تُكَافِئُوهُ فَادْعُوا لَهُ حَتَّى يَرَى أَنْ قَدْ كَافَيْتُمُوهُ  .","","Al-Mu'jam al-Kabir 13465","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن حبان بن علي العنزي عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","مجاهد عن ابن عمر"
"13502","13466  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 13466","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13503","[12/398]      13467  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  يَحْيَى أَبُو زَكَرِيَّا ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الذُّبَابُ  فِي النَّارِ  وَنَهَى عَنْ قَتْلِ النَّحْلِ ، وَأَنْ  يُحْرَقَ  الطَّعَامُ فِي أَرْضِ الْعَدُوِّ  .","","Al-Mu'jam al-Kabir 13467","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","مجاهد عن ابن عمر"
"13504","13468  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  ،  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  ثَنَا  أَبِي  ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ  الذُّبَابِ  فِي النَّارِ إِلَّا النَّحْلَ  .","","Al-Mu'jam al-Kabir 13468","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن عمر بن شقيق الجرمي عن الحسن بن عمر بن شقيق الجرمي عن عثمان بن عمر الضبي عن الطبراني","مجاهد عن ابن عمر"
"13505","13469  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَخَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ ، قَالَا :  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بِشْرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤَذِّنُ يُغْفَرُ لَهُ  مَدَّ  صَوْتِهِ  ، وَيَشْهَدُ لَهُ كُلُّ رَطْبٍ وَيَابِسٍ  .","","Al-Mu'jam al-Kabir 13469","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن عبد الله بن بشر بن النبهان الجزري عن معتمر بن سليمان عن داود بن رشيد الخوارزمي عن خلف بن عمرو بن عبد الرحمن العكبري عن الطبراني","مجاهد عن ابن عمر"
"13506","13470  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ ،  ثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الطُّفَاوِيُّ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ         [12/399]      ابْنِ عُمَرَ ، قَالَ :  أَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمَنْكِبِي فَقَالَ :  كُنْ فِي الدُّنْيَا كَالْغَرِيبِ أَوْ كَعَابِرِ السَّبِيلِ  .","","Al-Mu'jam al-Kabir 13470","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن محمد بن عبد الرحمن الطفاوي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","مجاهد عن ابن عمر"
"13507","13471  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  لَيْثٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ائْذَنُوا لِلنِّسَاءِ بِاللَّيْلِ إِلَى الْمَسْجِدِ  فَقَالَ ابْنُهُ : وَاللهِ لَا نَأْذَنُ لَهُنَّ فَيَتَّخِذْنَ ذَلِكَ  دَغَلًا  ، فَقَالَ : "" فَعَلَ اللهُ بِكَ وَفَعَلَ بِكَ ، تَسْمَعُنِي أَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَقُولُ أَنْتَ : لَا  . قَالَ  لَيْثٌ  فِي حَدِيثِهِ :  وَيَخْرُجْنَ  تَفِلَاتٍ  .","","Al-Mu'jam al-Kabir 13471","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن ليث بن أبي سليم عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مجاهد عن ابن عمر"
"13508","13472  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  لَا تَمْنَعُوا النِّسَاءَ الْمَسَاجِدَ بِاللَّيْلِ  فَقَالَ ابْنُهُ : وَاللهِ لَنَمْنَعُهُنَّ فَمَدَّ يَدَهُ فَلَطَمَهُ ، وَقَالَ : أُحَدِّثُكَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَتَقُولُ مَا تَقُولُ  .","","Al-Mu'jam al-Kabir 13472","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أبو مسلم الكجي عن الطبراني","مجاهد عن ابن عمر"
"13509","13473  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  انْشَقَّ الْقَمَرُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13473","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن أبو مسلم الكجي عن الطبراني","مجاهد عن ابن عمر"
"13510","13474  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمُّويَهْ أَبُو سَيَّارٍ التُّسْتَرِيُّ ،  ثَنَا  يُوسُفُ بْنُ مُوسَى أَبُو غَسَّانَ السُّكَّرِيُّ الرَّازِيُّ ،  ثَنَا  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا يَشْهَدُ الْمَلَائِكَةُ مِنْ  لَهْوِكُمْ  إِلَّا الرِّهَانَ  ، وَالنِّضَالَ  .","","Al-Mu'jam al-Kabir 13474","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الأعمش عن عمرو بن عبد الغفار الفقيمي عن يوسف بن موسى التستري عن أحمد بن حمويه التستري عن الطبراني","مجاهد عن ابن عمر"
"13511","[12/400]      13475  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ جَعْفَرٍ الْمَدَائِنِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  هَارُونُ بْنُ مُوسَى النَّحْوِيُّ ،  عَنْ  أَبَانَ بْنِ تَغْلِبَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ  عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، قَالَ : "" يَا رَسُولَ اللهِ لَوِ اتَّخَذْنَا مِنْ مَقَامِ  إِبْرَاهِيمَ  مُصَلًّى  ، فَنَزَلَتْ :         {      وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلًّى         }      .","","Al-Mu'jam al-Kabir 13475","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن أبان بن تغلب بن رياح عن هارون بن موسى العتكي عن محمد بن جعفر البزاز عن جعفر بن محمد بن جعفر المدائني عن علي بن سعيد بن بشير عليك عن الطبراني","مجاهد عن ابن عمر"
"13512","13476  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّشَائِيُّ ،  ثَنَا  عَبِيدَةُ بْنُ حُمَيْدٍ ،  ثَنَا  ثُوَيْرُ بْنُ أَبِي فَاخِتَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خُذُوا مِنْ هَذَا ، وَدَعُوا هَذَا  يَعْنِي يَأْخُذُ مِنْ  عَنْفَقَتِهِ  ، وَيَدَعُ لِحْيَتَهُ  .","","Al-Mu'jam al-Kabir 13476","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ثوير بن أبي فاختة مولى أم هانئ عن عبيدة بن حميد بن صهيب التيمي عن محمد بن حرب النشائي عن البزار عن الطبراني","مجاهد عن ابن عمر"
"13513","13477  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، الْمُخَنَّثِينَ مِنَ الرِّجَالِ  ، وَالْمُتَرَجِّلَاتِ مِنَ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 13477","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13514","13478  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،         [12/401]      ثَنَا  وَكِيعٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ أَبِي الْمُجَالِدِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ انْتَفَى مِنْ وَلَدِهِ لِيَفْضَحَهُ فِي الدُّنْيَا ، فَضَحَهُ اللهُ يَوْمَ الْقِيَامَةِ  عَلَى رُءُوسِ الْأَشْهَادِ قِصَاصٌ بِقِصَاصٍ  .","","Al-Mu'jam al-Kabir 13478","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الله بن أبي المجالد الكوفي عن الجراح بن مليح الرؤاسي والد وكيع عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عمر"
"13515","13479  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الْمُؤْمِنِ بْنُ عَلِيٍّ الزَّعْفَرَانِيُّ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْقَاسِمِ بْنِ الْوَلِيدِ ، وَالْقَاسِمِ بْنِ أَبِي بَزَّةَ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  سَأَلَ  رَجُلٌ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ رَمْيِ الْجِمَارِ مَا لَهُ فِيهِ ؟ فَسَمِعْتُهُ يَقُولُ :  تَجِدُ ذَلِكَ عِنْدَ رَبِّكَ أَحْوَجَ مَا تَكُونُ إِلَيْهِ  .","","Al-Mu'jam al-Kabir 13479","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن طلحة بن مصرف الهمداني عن القاسم بن أبي بزة عن حجاج بن أرطاة عن عبد السلام بن حرب الملائي عن عبد المؤمن بن على الزعفراني عن علي بن سعيد بن بشير عليك عن الطبراني","مجاهد عن ابن عمر"
"13516","13480  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ ،  عَنْ  حُصَيْنٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَأَلَكُمْ بِاللهِ فَأَعْطُوهُ  ، وَمَنِ اسْتَعَاذَكُمْ بِاللهِ فَأَعِيذُوهُ ، وَمَنْ دَعَاكُمْ فَأَجِيبُوهُ ، وَمَنْ أَهْدَى إِلَيْكُمْ كُرَاعًا فَاقْبَلُوهُ  .","","Al-Mu'jam al-Kabir 13480","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن حصين بن عبد الرحمن السلمي عن عيسى بن أبي عيسى الرازي عن سلمة بن الفضل الأبرش عن عبد الرحمن بن سلمة الأزداني عن علي بن سعيد بن بشير عليك عن الطبراني","مجاهد عن ابن عمر"
"13517","13481  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  أَبُو إِسْرَائِيلَ ،  عَنِ  الْفُضَيْلِ بْنِ عَمْرٍو ،  عَنْ  أَبِي الْحَجَّاجِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  مَسَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَلَاةِ الْعِشَاءِ حَتَّى صَلَّى الْمُصَلِّي ، وَاسْتَيْقَظَ الْمُسْتَيْقِظُ ، وَنَامَ         [12/402]      النَّائِمُونَ ، وَتَهَجَّدَ  الْمُتَهَجِّدُونَ  ثُمَّ خَرَجَ فَقَالَ :  لَوْلَا أَنْ أَشُقَّ عَلَى أُمَّتِي أَمَرْتُهُمْ يُصَلُّونَ  هَذَا الْوَقْتَ ، أَوْ هَذِهِ الصَّلَاةَ  أَوْ نَحْوَ هَذَا .","","Al-Mu'jam al-Kabir 13481","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن فضيل بن عمرو الفقيمي عن إسماعيل بن خليفة الملائي عن غسان بن الربيع الأزدي عن عبد الله بن محمد بن عزيز التميمي عن الطبراني","مجاهد عن ابن عمر"
"13518","13482  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَا :  ثَنَا  عِمْرَانُ بْنُ زَيْدٍ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَهْلَ النَّارِ يَعْظُمُونَ فِي النَّارِ حَتَّى يَصِيرَ مَا بَيْنَ  شَحْمَةِ  أُذُنِ أَحَدِهِمْ إِلَى عَاتِقِهِ  مَسِيرَةَ  سَبْعِمِائَةِ عَامٍ  ، وَغِلَظُ جِلْدِ أَحَدِهِمْ أَرْبَعِينَ ذِرَاعًا ، وَضِرْسُهُ أَعْظَمَ مِنْ جَبَلِ أُحُدٍ  .  وَلَفْظُهُمَا وَاحِدٌ  .","","Al-Mu'jam al-Kabir 13482","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن عمران بن زيد الطويل عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","مجاهد عن ابن عمر"
"13519","13483  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ لِجِنَازَةِ  يَهُودِيٍّ  مَرَّتْ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 13483","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","مجاهد عن ابن عمر"
"13520","13484  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ، وَأَحْمَدُ بْنُ يُونُسَ ، قَالَا  : ثَنَا  إِسْرَائِيلُ ،  ثَنَا  أَبُو يَحْيَى الْقَتَّاتُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَتْبَعَ جِنَازَةً مَعَهَا رَانَّةٌ  .","","Al-Mu'jam al-Kabir 13484","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13521","[12/403]      13485  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْمُثْلَةِ  .","","Al-Mu'jam al-Kabir 13485","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن محمد بن أبان بن صالح عن عبد الحميد بن صالح البرجمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عمر"
"13522","13486  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  كُنْتُ مَعَ ابْنِ عُمَرَ فَثَوَّبَ رَجُلٌ فِي الظُّهْرِ وَالْعَصْرِ ،  فَقَالَ  :  بِدْعَةٌ اخْرُجْ بِنَا فَإِنَّ هَذِهِ بِدْعَةٌ  .","","Al-Mu'jam al-Kabir 13486","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن سفيان الثوري عن محمد بن كثير العبدي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","مجاهد عن ابن عمر"
"13523","13487  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  قَبِيصَةُ بْنُ لَيْثٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ حُجَّاجًا فَقَالَ :  يَا أَيُّهَا النَّاسُ أَهِلُّوا بِعُمْرَةٍ إِلَّا مَنْ كَانَ مَعَهُ هَدْيٌ  ، فَإِنَّهُ قَدْ  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13487","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن قبيصة بن الليث بن قبيصة الأسدي عن محمد بن عبيد بن محمد بن واقد النحاس عن محمد بن عثمان بن أبي شيبة عن الطبراني","مجاهد عن ابن عمر"
"13524","13488  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْقُلُوسِيُّ ،  ثَنَا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ ،  ثَنَا  مِنْدَلٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَا يَرْحَمُ لَا يُرْحَمُ  .","","Al-Mu'jam al-Kabir 13488","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن مندل بن علي عن بكر بن يحيى العنزي عن يعقوب بن إسحاق القلوسي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عمر"
"13525","13489  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  ثَنَا         [12/404]      يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ  أَنَّ  رَجُلًا  قَدِمَ عَلَى ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، فَقَالَ لَهُ : كَيْفَ أَنْتُمْ  وَأَبُو أُنَيْسٍ يَعْنِي الضَّحَّاكَ بْنَ قَيْسٍ  ، قَالَ : نَحْنُ وَهُوَ إِذَا لَقِينَاهُ ، قُلْنَا لَهُ : مَا تُحِبُّ ، وَإِذَا وَلَّيْنَا عَنْهُ قُلْنَا غَيْرَ ذَلِكَ ، قَالَ :  ذَلِكَ مَا كُنَّا نَعُدُّ وَنَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ النِّفَاقِ  "" .","","Al-Mu'jam al-Kabir 13489","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مجاهد عن ابن عمر"
"13526","13490  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ  سَأَلَ رَجُلٌ عَنِ الْفَضِيخِ قَالَ : وَمَا الْفَضِيخُ ؟ قَالَ : نَفْضَخُ الْبُسْرَ ، ثُمَّ نَجْعَلُ مَعَهُ التَّمْرَ ، ثُمَّ نَذَرُهُ وَنَشْرَبُهُ ، قَالَ :  ذَلِكَ  الْفَضُوخُ  ، وَلَقَدْ حُرِّمَتِ الْخَمْرُ ، وَإِنَّ عَامَّةَ شَرَابِهِمُ الَّذِي تَذْكُرُ  "" .","","Al-Mu'jam al-Kabir 13490","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن يزيد بن عطاء بن يزيد اليشكري عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","مجاهد عن ابن عمر"
"13527","13491  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  مُفَضَّلُ بْنُ مُهَلْهِلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَجُلًا سَأَلَهُ عَنِ الْفَضِيخِ ، فَقَالَ : وَمَا الْفَضِيخُ ؟ قَالَ : بُسْرٌ وَتَمْرٌ قَالَ :  ذَاكَ  الْفَضُوخُ  لَقَدْ حُرِّمَتِ الْخَمْرُ  ، وَهُوَ شَرَابُنَا  "" .","","Al-Mu'jam al-Kabir 13491","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن المفضل بن مهلهل السعدي عن يحيى بن آدم عن أحمد بن حنبل عن موسى بن هارون الحمال عن الطبراني","مجاهد عن ابن عمر"
"13528","13492  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ فَجَعَلَهَا فِي بَطْنِهِ لَمْ تُقْبَلْ مِنْهُ صَلَاةٌ سَبْعًا  ، وَإِنْ مَاتَ فِيهِ مَاتَ كَافِرًا ، فَإِنْ أَذْهَلَتْ عَقْلَهُ عَنْ شَيْءٍ مِنَ الْفَرَائِضِ لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ يَوْمًا ، وَإِنْ مَاتَ فِيهَا مَاتَ كَافِرًا  .","","Al-Mu'jam al-Kabir 13492","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عمر"
"13529","[12/405]      13493  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ ، وَأَحْمَدُ بْنُ حَمَّادِ بْنِ زُغْبَةَ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ زَحْرٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      تَعْدِلُ  ثُلُثَ  الْقُرْآنِ  ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      تَعْدِلُ رُبُعَ الْقُرْآنِ "" وَكَانَ يَقْرَأُ بِهِمَا فِي رَكْعَتَيِ الْفَجْرِ ، وَقَالَ : "" هَاتَانِ الرَّكْعَتَانِ فِيهَا رَغَبُ الدَّهْرِ  .","","Al-Mu'jam al-Kabir 13493","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبيد الله بن زحر الضمري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","مجاهد عن ابن عمر"
"13530","13494  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  لَيْثُ بْنُ حَمَّادٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خِيَارُكُمْ أَلْيَنُكُمْ مَنَاكِبًا فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 13494","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حماد بن زيد عن ليث بن حماد الصفار عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عمر"
"13531","13495  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  رَوْحُ بْنُ صَلَاحٍ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِذْ أَتَى  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ         [12/406]      عَلَيْهِ وَسَلَّمَ ، فَصَافَحَهُ فَلَمْ يَنْزِعْ يَدَهُ مِنْ يَدِ الرَّجُلِ حَتَّى انْتَزَعَ الرَّجُلُ يَدَهُ ثُمَّ قَالَ لَهُ : يَا رَسُولَ اللهِ ، مَا  عُثْمَانُ  ؟ قَالَ :  ذَاكَ امْرُؤٌ مِنْ أَهْلِ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 13495","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سفيان الثوري عن روح بن صلاح بن سيابة الحارثي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","مجاهد عن ابن عمر"
"13532","13496  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ هَارُونَ الْأَنْصَارِيُّ ،  ثَنَا  اللَّيْثُ ابْنُ بِنْتِ اللَّيْثِ بْنِ أَبِي سُلَيْمٍ ، قَالَ :  حَدَّثَتْنِي  جَدَّتِي عَائِشَةُ بِنْتُ يُونُسَ امْرَأَةُ اللَّيْثِ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ زَارَ قَبْرِي بَعْدَ مَوْتِي كَانَ كَمَنْ زَارَنِي فِي حَيَاتِي  .","","Al-Mu'jam al-Kabir 13496","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عائشة بنت يونس بن عبيد عن الليث ابن بنت الليث بن أبي سليم عن علي بن الحسن بن هارون الأنصاري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","مجاهد عن ابن عمر"
"13533","13497  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَفْصُ بْنُ أَبِي دَاوُدَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ         [12/407]      ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ حَجَّ فَزَارَ قَبْرِي بَعْدَ وَفَاتِي كَانَ كَمَنْ زَارَنِي فِي حَيَاتِي  .","","Al-Mu'jam al-Kabir 13497","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حفيص الأسدي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عمر"
"13534","13498  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَتْبَعَ جِنَازَةً فِيهَا رَانَّةٌ  .","","Al-Mu'jam al-Kabir 13498","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن عبد الغفار بن داود الحراني عن يحيى بن عثمان بن صالح عن الطبراني","مجاهد عن ابن عمر"
"13535","13499  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  هُرَيْمُ بْنُ سُفْيَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَانَا أَوْ نُهِينَا  أَنْ نُصَلِّيَ فِي مَسْجِدٍ مُشْرِفٍ  .","","Al-Mu'jam al-Kabir 13499","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن هريم بن سفيان البجلي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13536","13500  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ :  سَمِعْتُ  أَبِي  ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ابْنَ آدَمَ اضْمَنْ لِي رَكْعَتَيْنِ مِنْ أَوَّلِ النَّهَارِ أَكْفِكَ آخِرَهُ  .","","Al-Mu'jam al-Kabir 13500","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن علي بن الحسن بن شقيق المطوعي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عمر"
"13537","13501  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُوسَى التَّوَّزِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ يَحْيَى الدَّبِيلِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  أَنَا  جَابِرُ بْنُ يَحْيَى الْحَضْرَمِيُّ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ جَرَّ إِزَارَهُ مِنَ  الْخُيَلَاءِ  لَا يَنْظُرُ اللهُ إِلَيْهِ يَوْمَ الْقِيَامَةِ  .         [12/408]","","Al-Mu'jam al-Kabir 13501","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جابر بن يحيى الحضرمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحيم بن يحيى الدبيلي عن التوزي إبراهيم بن موسى الجوزي عن الطبراني","مجاهد عن ابن عمر"
"13538","13502  -  وَسَمِعْتُهُ  يَقُولُ :  لَا تَدَعُوا الرَّكْعَتَيْنِ اللَّتَيْنِ قَبْلَ صَلَاةِ الْفَجْرِ  ، فَإِنَّ فِيهِمَا  الرَّغَائِبَ  .","","Al-Mu'jam al-Kabir 13502","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جابر بن يحيى الحضرمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحيم بن يحيى الدبيلي عن التوزي إبراهيم بن موسى الجوزي عن الطبراني","مجاهد عن ابن عمر"
"13539","13503  -  وَسَمِعْتُهُ  يَقُولُ :  لَا تَنْتَفِيَنَّ مِنْ وَلَدِكَ فَيَفْضَحَكَ اللهُ عَلَى رُءُوسِ الْخَلَائِقِ  كَمَا فَضَحْتَهُ فِي الدُّنْيَا  .","","Al-Mu'jam al-Kabir 13503","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جابر بن يحيى الحضرمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحيم بن يحيى الدبيلي عن التوزي إبراهيم بن موسى الجوزي عن الطبراني","مجاهد عن ابن عمر"
"13540","13504  -  وَسَمِعْتُهُ  يَقُولُ :  لَا تَمُوتَنَّ وَعَلَيْكَ دَيْنٌ فَإِنَّمَا هِيَ الْحَسَنَاتُ  وَالسَّيِّئَاتُ لَيْسَ ثَمَّ دِينَارٌ وَلَا دِرْهَمٌ ، جَزَاءٌ وَقَضَاءٌ وَلَيْسَ يَظْلِمُ أَحَدًا  .","","Al-Mu'jam al-Kabir 13504","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جابر بن يحيى الحضرمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحيم بن يحيى الدبيلي عن التوزي إبراهيم بن موسى الجوزي عن الطبراني","مجاهد عن ابن عمر"
"13541","13505  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ خَالِدٍ الصَّنْعَانِيُّ ،  ثَنَا  رَبَاحُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ حَبِيبٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَمْنَعَنَّ أَحَدٌ أَهْلَهُ أَنْ يَأْتُوا الْمَسْجِدَ  .","","Al-Mu'jam al-Kabir 13505","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن عمر بن حبيب المكي عن رباح بن زيد الصنعاني عن إبراهيم بن خالد الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عمر"
"13542","13506  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْفَتْحِ  عَنْ لُحُومِ الْإِبِلِ  الْجَلَّالَةِ  وَأَلْبَانِهَا  .","","Al-Mu'jam al-Kabir 13506","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن إسحاق عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عمر"
"13543","13507  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  زَكَرِيَّا         [12/409]      بْنُ يَحْيَى الْمَدَائِنِيُّ ،  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْبَغِي لِمُؤْمِنٍ أَنْ يُذِلَّ نَفْسَهُ  ، قِيلَ : يَا رَسُولَ اللهِ ، وَكَيْفَ يُذِلُّ نَفْسَهُ ؟ قَالَ : "" أَنْ يَتَعَرَّضَ مِنَ الْبَلَاءِ لِمَا لَا يُطِيقُ  .","","Al-Mu'jam al-Kabir 13507","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن ورقاء بن عمر عن شبابة بن سوار المدائني عن زكريا بن يحيى بن أيوب المدائني عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","مجاهد عن ابن عمر"
"13544","13508  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ : صَحِبْتُ ابْنَ عُمَرَ مِنْ  مَكَّةَ  إِلَى  الْمَدِينَةِ  فَلَمْ أَسْمَعْهُ  يُحَدِّثُ عَنْ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا حَدِيثًا وَاحِدًا قَالَ :  كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنَّ مِنَ الشَّجَرَةِ شَجَرَةً ، مَثَلُهَا مَثَلُ الرَّجُلِ الْمُسْلِمِ  ، فَأَرَدْتُ أَنْ أَقُولَ هِيَ النَّخْلَةُ ، فَنَظَرْتُ فَإِذَا أَنَا أَصْغَرُ  الْقَوْمِ  فَسَكَتُّ  .","","Al-Mu'jam al-Kabir 13508","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عمر"
"13545","13509  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  خَطَّابُ بْنُ الْقَاسِمِ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نِسَاءَهُ فَيَتَمَتَّعْنَ ، وَأَمَرَ لَهُنَّ بِالنَّفْرِ  .","","Al-Mu'jam al-Kabir 13509","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن خصيف الجزري عن خطاب بن القاسم الحراني عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","مجاهد عن ابن عمر"
"13546","[12/410]      13510  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" دَخَلَ  الْبَيْتَ  وَمَعَهُ  الْفَضْلُ  ، وَقَامَ  بِلَالٌ  عَلَى الْبَابِ  .","","Al-Mu'jam al-Kabir 13510","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن خصيف الجزري عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن محمود بن محمد بن منويه المفيد عن الطبراني","مجاهد عن ابن عمر"
"13547","13511  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  الْحَسَنُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  ثَنَا  عِمْرَانُ بْنُ مُحَمَّدِ بْنِ أَبِي لَيْلَى ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  بَنِي عَبْدِ مَنَافٍ  لَا أَعْرِفَنَّكُمْ مَا مَنَعْتُمْ أَحَدًا يَطُوفُ بِهَذَا  الْبَيْتِ  سَاعَةً مِنْ لَيْلٍ أَوْ نَهَارٍ  .","","Al-Mu'jam al-Kabir 13511","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الكريم عن عمران بن محمد ابن أبي ليلى عن الحسن بن عبد الرحمن بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عمر"
"13548","13512  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ ،  ثَنَا  مُؤَمَّلُ بْنُ هِشَامٍ ،  ثَنَا  يَحْيَى بْنُ عَبَّادٍ ،  عَنِ  السَّرِيِّ بْنِ يَحْيَى ،  عَنْ  عَبْدِ الْكَرِيمِ هُوَ ابْنُ رُشَيْدٍ - لَمْ  يُسْنِدْ  إِلَّا هَذَا الْحَدِيثَ -  وَحَدَّثَنَا  آخَرُ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  ابْنُ عُمَرَ :  لَقَدْ أُعْطِيتُ مِنْهُ شَيْئًا مَا أَعْلَمُ أَحَدًا أُعْطِيَهُ إِلَّا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  يَعْنِي الْجِمَاعَ  .","","Al-Mu'jam al-Kabir 13512","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الكريم بن رشيد القشيري عن السري بن يحيى الشيباني عن يحيى بن عباد الضبعي عن مؤمل بن هشام اليشكري عن الهيثم بن خلف الدوري عن الطبراني","مجاهد عن ابن عمر"
"13549","13513  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِنَ الشَّجَرِ         [12/411]      لَشَجَرَةٌ كَالرَّجُلِ الْمُؤْمِنِ  ، فَأَرَدْتُ أَنْ أَقُولَ : هِيَ النَّخْلَةُ ، فَنَظَرْتُ فِي وُجُوهِ  الْقَوْمِ  فَإِذَا أَنَا أَحْدَثُهُمْ سِنًّا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هِيَ النَّخْلَةُ  .","","Al-Mu'jam al-Kabir 13513","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن عبد الله بن عبد الوهاب الحجبي عن عثمان بن عمر الضبي عن الطبراني","مجاهد عن ابن عمر"
"13550","13514  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَثَلُ الْمُؤْمِنِ مَثَلُ النَّخْلَةِ  ، مَا أَخَذْتَ مِنْهَا مِنْ شَيْءٍ نَفَعَكَ  .","","Al-Mu'jam al-Kabir 13514","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن جعفر بن إياس اليشكري عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","مجاهد عن ابن عمر"
"13551","13515  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَأْكُلُ  جُمَّارَ  نَخْلٍ  .","","Al-Mu'jam al-Kabir 13515","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن جعفر بن إياس اليشكري عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","مجاهد عن ابن عمر"
"13552","13516  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْمُخَرِّمِيُّ  ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَسْبَاطِ بْنِ عَزْرَةَ ،  عَنْ  جَعْفَرِ بْنِ أَبِي وَحْشِيَّةَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَعَطَسَ فَحَمِدَ اللهَ ، فَقَالُوا : يَرْحَمُكَ اللهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ  .  في طبعة مكتبة ابن تيمية : ( المحزمي ) والمثبت من نسخة خطية ، وفي نسخة ( المخزومي ) ، والصواب المثبت وينظر ترجمته في تهذيب الكمال وغيره .","","Al-Mu'jam al-Kabir 13516","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن جعفر بن إياس اليشكري عن أسباط بن زرعة عن إسرائيل بن يونس بن أبي إسحاق عن الأسود بن عامر شاذان عن محمد بن عبد الله بن المبارك المخرمي عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","مجاهد عن ابن عمر"
"13553","13517  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  صَالِحٍ أَبِي الْخَلِيلِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَصْحَابِهِ :         [12/412]      أَخْبِرُونِي عَنْ شَجَرَةٍ مَثَلُهَا مَثَلُ الْمُؤْمِنِ  ، فَجَعَلَ النَّاسُ يَذْكُرُونَ شَجَرًا مِنْ شَجَرِ الْوَادِي ، فَأُلْقِيَ فِي نَفْسِي أَنَّهَا النَّخْلَةُ فَجَعَلْتُ أُرِيدُ أَنْ أَقُولَ ، فَأَرَى أَسْنَانًا مِنَ  الْقَوْمِ  فَجَعَلْتُ أَهَابُ ذَاكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هِيَ النَّخْلَةُ  .","","Al-Mu'jam al-Kabir 13517","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن صالح بن أبي مريم الضبعي عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13554","13518  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  يَزِيدَ الْأَعْرَجِ الشَّنِّيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَصَوْمِ رَمَضَانَ ، وَحَجِّ الْبَيْتِ ، وَحَجِّ هَذَا الْبَيْتِ  ""  مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 13518","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يزيد الشني عن الحسن بن أبي جعفر الجفري عن حفص بن عمر الحوضى عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مجاهد عن ابن عمر"
"13555","13519  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَرِيكٌ ، قَالَ :  سَمِعْتُ  سَلَمَةَ بْنَ كُهَيْلٍ  يُحَدِّثُ عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالشَّمْسُ عَلَى  قُعَيْقِعَانَ  بَعْدَ الْعَصْرِ فَقَالَ :  مَا أَعْمَارُكُمْ فِي أَعْمَارِ مَنْ مَضَى إِلَّا كَمَا بَقِيَ مِنْ هَذَا النَّهَارِ فِيمَا مَضَى مِنْهُ  .","","Al-Mu'jam al-Kabir 13519","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن شريك بن عبد الله النخعي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13556","13520  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَثَلُ الْمُؤْمِنِ مَثَلُ النَّخْلَةِ  .","","Al-Mu'jam al-Kabir 13520","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن حفص بن عمر سنجة ألف عن الطبراني","مجاهد عن ابن عمر"
"13557","13521  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْوَاهِبِ الْحَارِثِيُّ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ         [12/413]      مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  بَيْنَمَا نَحْنُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَأْكُلُ  جُمَّارًا  وَالْقَوْمُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنَ الشَّجَرِ لَشَجَرَةً مَثَلَ الرَّجُلِ الْمُسْلِمِ  ، قَالَ : فَسَكَتَ  الْقَوْمُ  حَتَّى كِدْتُ أَسْأَلُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أَصْغَرُ  الْقَوْمِ  ، فَقَالَ : "" هِيَ النَّخْلَةُ  .","","Al-Mu'jam al-Kabir 13521","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن محمد بن عبد الواهب بن الزبير الحارثي عن إبراهيم بن هاشم البغوي عن الطبراني","مجاهد عن ابن عمر"
"13558","13522  -  حَدَّثَنَا  سَلَمَةُ بْنُ إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ بْنِ يَحْيَى بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ، [  حَدَّثَنِي  أَبِي ]  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ  ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيتُ خَمْسًا لَمْ يُعْطَهَا نَبِيٌّ قَبْلِي  : بُعِثْتُ إِلَى النَّاسِ كَافَّةً  الْأَحْمَرِ  وَالْأَسْوَدِ ، وَإِنَّمَا كَانَ يُبْعَثُ كُلُّ نَبِيٍّ إِلَى قَرْيَتِهِ ، وَنُصِرْتُ  بِالرُّعْبِ  يُرْعَبُ مِنِّي عَدُوِّي عَلَى  مَسِيرَةِ  شَهْرٍ ، وَأُعْطِيتُ الْمَغْنَمَ ، وَجُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا ، وَأُعْطِيتُ الشَّفَاعَةَ فَأَخَّرْتُهَا لِأُمَّتِي  .  سقط من طبعة مكتبة ابن تيمية ، والمثبت من نسخة الظاهرية (1) .","","Al-Mu'jam al-Kabir 13522","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن سلمة بن إبراهيم بن إسماعيل بن يحيى بن سلمة بن كهيل عن الطبراني","مجاهد عن ابن عمر"
"13559","13523  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ الْوَكِيعِيُّ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ أَبُو عَبْدِ الرَّحْمَنِ النَّسَائِيُّ ،  أَنَا  مُحَمَّدُ بْنُ رَافِعٍ النَّيْسَابُورِيُّ ، قَالَا :  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  مُفَضَّلِ بْنِ مُهَلْهَلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْبَعَ عُمَرٍ إِحْدَاهُنَّ فِي رَجَبٍ  .","","Al-Mu'jam al-Kabir 13523","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن المفضل بن مهلهل السعدي عن يحيى بن آدم عن أحمد بن عمر الوكيعي عن إبراهيم بن أحمد بن عمر الوكيعي عن الطبراني","مجاهد عن ابن عمر"
"13560","13524  -  حَدَّثَنَا  أَبُو مُلَيْلٍ مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مُحَمَّدِ بْنِ         [12/414]      رَبِيعَةَ الْكِلَابِيُّ الْكُوفِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ هَرَاسَةَ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  صَلَاةُ الضُّحَى بِدْعَةٌ  "" .","","Al-Mu'jam al-Kabir 13524","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن إبراهيم بن هراسة الشيباني عن والد محمد بن عبد العزيز بن محمد الكلابي عن محمد بن عبد العزيز بن محمد الكلابي عن الطبراني","مجاهد عن ابن عمر"
"13561","13525  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عِيسَى بْنُ شَاذَانَ ،  ثَنَا  أَبُو هَمَّامٍ الدَّلَّالُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فِي  مَسْجِدِ الْخَيْفِ  قَبْرُ سَبْعِينَ نَبِيًّا  .","","Al-Mu'jam al-Kabir 13525","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن إبراهيم بن طهمان عن محمد بن محبب الدلال عن عيسى بن شاذان عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عمر"
"13562","13526  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمِ بْنِ مَرْزُوقٍ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  كُنْتُ جَالِسًا مَعَ عَبْدِ اللهِ بْنِ عُمَرَ أَنَا  وَعُرْوَةُ بْنُ الزُّبَيْرِ  فَسَأَلَهُ  عُرْوَةُ  فِي أَيِّ شَهْرٍ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَعْتَمِرُ ؟ قَالَ :  كَانَ يَعْتَمِرُ فِي رَجَبٍ  .","","Al-Mu'jam al-Kabir 13526","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن عيسى بن أبي عيسى الرازي عن هاشم بن مرزوق عن علي بن هاشم بن مرزوق الرازي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","مجاهد عن ابن عمر"
"13563","13527  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مِنْ  خَمْسٍ وَعِشْرِينَ مَرَّةً - أَوْ         [12/415]      قَالَ : أَكْثَرَ مِنْ عِشْرِينَ مَرَّةً  - يَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ،  وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13527","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مجاهد عن ابن عمر"
"13564","13528  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُوسَى بْنُ دَاوُدَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13528","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن موسى بن داود الخلقاني عن محمد بن أحمد بن النضر النضري عن الطبراني","مجاهد عن ابن عمر"
"13565","13529  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  عَنْ  شَرِيكٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّتَيْنِ قَبْلَ أَنْ يَحُجَّ  ، فَبَلَغَ ذَلِكَ عَائِشَةَ فَقَالَتِ : اعْتَمَرَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْبَعَ عُمَرٍ قَدْ عَلِمَ بِذَلِكَ  عَبْدُ اللهِ بْنُ عُمَرَ  مِنْهُنَّ عُمْرَةٌ مَعَ حَجَّتِهِ  .","","Al-Mu'jam al-Kabir 13529","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عمر"
"13566","13530  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبِي  ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَأَلَكُمْ بِاللهِ فَأَعْطُوهُ ، وَمَنِ اسْتَعَاذَ بِاللهِ فَأَعِيذُوهُ  ، وَمَنْ أَهْدَى إِلَيْكُمْ كُرَاعًا فَاقْبَلُوهُ  .","","Al-Mu'jam al-Kabir 13530","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عمر"
"13567","13531  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ،         [12/416]      قَالَ :  أَوْصَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْجَارِ حَتَّى رَأَيْنَا أَنَّهُ سَيُوَرِّثُهُ  .","","Al-Mu'jam al-Kabir 13531","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عمر"
"13568","13532  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْوَادِعِيُّ أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  جَنْدَلُ بْنُ وَالِقٍ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَجْلِسٍ يَسْتَغْفِرُ اللهَ مِائَةَ مَرَّةٍ يَقُولُ :  رَبِّ اغْفِرْ لِي ، وَارْحَمْنِي وَتُبْ عَلَيَّ ؛ إِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيمُ  "" .","","Al-Mu'jam al-Kabir 13532","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن يونس بن خباب الأسيدي عن يحيى بن يعلى القطواني عن جندل بن والق التغلبي عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","مجاهد عن ابن عمر"
"13569","13533  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ، وَبِشْرُ بْنُ مُوسَى ، قَالَا :  ثَنَا  يَزِيدُ بْنُ مِهْرَانَ أَبُو خَالِدٍ الْخَبَّازُ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  مُجَالِدٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى ابْنِ عُمَرَ ، فَقَالَ : مَا تَقُولُ فِي  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  ؟  فَقَالَ  : هُوَ ذَاكَ بَيْتُهُ ، فَقَالَ : مَا تَقُولُ فِي  عُثْمَانَ  ؟ قَالَ : مَا أَقُولُ فِي رَجُلٍ أَذْنَبَ ذَنْبًا فِيمَا بَيْنَهُ وَبَيْنَ رَبِّهِ فَعَفَى عَنْهُ ، وَأَذْنَبَ ذَنْبًا فِيمَا بَيْنَكُمْ وَبَيْنَهُ فَقَتَلْتُمُوهُ .  ؟","","Al-Mu'jam al-Kabir 13533","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن مجالد بن سعيد عن أبو بكر بن عياش عن يزيد بن مهران الخباز عن بشر بن موسى بن صالح الأسدي عن الطبراني","مجاهد عن ابن عمر"
"13570","13534  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا  ، ثَنَا  أَحْمَدُ بْنُ سَيَّارٍ الْمَرْوَزِيُّ ،  ثَنَا  عَبْدَانُ بْنُ عُثْمَانَ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  أَشْرَسَ بْنِ حَسَّانَ الْأَسَدِيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي  حَجَّةِ الْوَدَاعِ  :  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 13534","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أشرس بن حسان الأسدي عن محمد بن ميمون أبو حمزة السكري عن عبد الله بن عثمان بن جبلة عن أحمد بن سيار المروزي عن القاسم بن زكريا المطرز عن الطبراني","مجاهد عن ابن عمر"
"13571","[12/417]      13535  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  حَبِيبِ بْنِ حَسَّانَ هُوَ أَخُو أَشْرَسَ  ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ مُسْتَنِدًا إِلَى حُجْرَةِ  عَائِشَةَ  فَسُئِلَ فِي أَيِّ شَهْرٍ اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ؟ فَقَالَ : "" فِي رَجَبٍ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، ولعل الصواب : ( حبيب بن حسان أبو أشرس ) .","","Al-Mu'jam al-Kabir 13535","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن حبيب بن أبي الأشرس الكوفي عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عمر"
"13572","13536  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ شَيْبَةَ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  مُعَلًّى هُوَ الْكِنْدِيُّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَاشِرَ عَشَرَةٍ ، فَجَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  فَقَالَ : يَا نَبِيَّ اللهِ  مَنْ  أَكْيَسُ  النَّاسِ ؟ وَأَحْزَمُ النَّاسِ ؟ قَالَ : "" أَكْثَرُهُمْ ذِكْرًا لِلْمَوْتِ  ، وَأَشَدُّهُمُ اسْتِعْدَادًا لِلْمَوْتِ قَبْلَ نُزُولِ الْمَوْتِ ، أُولَئِكَ هُمُ الْأَكْيَاسُ ذَهَبُوا بِشَرَفِ الدُّنْيَا وَالْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13536","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن معلى الكندي عن مالك بن مغول الصهيبي عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن محمد بن عيسى بن شيبة السدوسي عن الطبراني","مجاهد عن ابن عمر"
"13573","13537  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَالَ لِي : "" أَحِبَّ فِي اللهِ وَأَبْغِضْ فِي اللهِ وَوَالِ فِي اللهِ ، وَعَادِ فِي اللهِ ، فَإِنَّهُ لَا تُنَالُ وِلَايَةُ اللهِ إِلَّا بِذَلِكَ ، وَلَا يَجِدُ رَجُلٌ طَعْمَ الْإِيمَانِ - وَإِنْ كَثُرَتْ صَلَاتُهُ وَصِيَامُهُ - حَتَّى يَكُونَ كَذَلِكَ ، وَصَارَتْ مُؤَاخَاةُ النَّاسِ فِي أَمْرِ الدُّنْيَا ، وَإِنَّ ذَلِكَ لَا يَجْزِي عَنْ أَهْلِهِ شَيْئًا "" .  قَالَ : وَقَالَ لِيَ  ابْنُ عُمَرَ  : "" إِذَا أَصْبَحْتَ فَلَا تُحَدِّثْ نَفْسَكَ بِالْمَسَاءِ ، وَإِذَا أَمْسَيْتَ فَلَا تُحَدِّثْ نَفْسَكَ بِالصَّبَاحِ ، وَخُذْ مِنْ         [12/418]      صِحَّتِكَ لِسَقَمِكَ ، وَمِنْ حَيَاتِكَ لِمَوْتِكَ ، فَإِنَّكَ يَا  عَبْدَ اللهِ بْنَ عُمَرَ  لَا تَدْرِي مَا اسْمُكَ غَدًا "" .  قَالَ : وَأَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِبَعْضِ جَسَدِي ، فَقَالَ :  كُنْ فِي الدُّنْيَا غَرِيبًا أَوْ عَابِرَ سَبِيلٍ  ، وَعُدَّ نَفْسَكَ فِي أَهْلِ الْقُبُورِ  .","","Al-Mu'jam al-Kabir 13537","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13574","13538  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ زُنْبُورٍ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِبَعْضِ جَسَدِي فَقَالَ : "" يَا  ابْنَ عُمَرَ  كُنْ كَالْغَرِيبِ فِي الدُّنْيَا  ، أَوْ عَابِرِ سَبِيلٍ ، وَعُدَّ نَفْسَكَ فِي أَهْلِ الْقُبُورِ  .","","Al-Mu'jam al-Kabir 13538","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن الفضيل بن عياض عن محمد بن زنبور الهاشمي عن الساجي عن الطبراني","مجاهد عن ابن عمر"
"13575","13539  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَأَلَ بِاللهِ فَأَعْطُوهُ ، وَمَنِ اسْتَعَاذَ بِاللهِ فَأَعِيذُوهُ ، وَمَنْ أَهْدَى إِلَيْكُمْ فَاقْبَلُوهُ  .","","Al-Mu'jam al-Kabir 13539","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سعيد بن زيد الجهضمي عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13576","13540  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَأَلَ بِاللهِ فَأَعْطُوهُ ، وَمَنِ اسْتَعَاذَ بِاللهِ فَأَعِيذُوهُ ، وَمَنْ أَهْدَى إِلَيْكُمْ ذِرَاعًا أَوْ كُرَاعًا فَاقْبَلُوهُ  .","","Al-Mu'jam al-Kabir 13540","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مجاهد عن ابن عمر"
"13577","13541  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  هُرَيْمُ بْنُ مِسْعَرٍ التِّرْمِذِيُّ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ الْمُؤْمِنِ كَمَثَلِ الْعَطَّارِ إِنْ جَالَسْتَهُ نَفَعَكَ ، وَإِنْ مَاشَيْتَهُ نَفَعَكَ ، وَإِنْ شَارَكْتَهُ نَفَعَكَ  .","","Al-Mu'jam al-Kabir 13541","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن الفضيل بن عياض عن هريم بن مسعر الترمذي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","مجاهد عن ابن عمر"
"13578","13542  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ         [12/419]      ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الذُّبَابُ  كُلُّهُ فِي النَّارِ إِلَّا النَّحْلَةَ  .","","Al-Mu'jam al-Kabir 13542","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن إسماعيل بن عياش الأحول عن الحكم بن موسى بن أبي زهير النسائي عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عمر"
"13579","13543  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عُبَيْدِ بْنِ عُمَرَ  ، أَوْ  عَنِ  ابْنِ عُمَرَ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ  الذُّبَابِ  فِي النَّارِ إِلَّا النَّحْلَ  كَانَ يَنْهَى عَنْ قَتْلِهِنَّ وَإِحْرَاقِ الطَّعَامِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمير )","","Al-Mu'jam al-Kabir 13543","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مجاهد عن ابن عمر"
"13580","13544  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  سُفْيَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، وَعُبَيْدِ بْنِ عُمَيْرٍ ، قَالَا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الذُّبَابُ  فِي النَّارِ إِلَّا النَّحْلَ  ، فَكَانُوا يَكْرَهُونَ قَتْلَهَا ، وَإِحْرَاقَ الطَّعَامِ  .","","Al-Mu'jam al-Kabir 13544","","عبيد بن عمير بن قتادة الجندعي عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن سفيان الثوري عن الفضل بن موسى السيناني عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مجاهد عن ابن عمر"
"13581","13545  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ ابْنُ بِنْتِ رِشْدِينَ بْنِ سَعْدٍ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  أَبُو الْمُحَيَّاةِ يَحْيَى بْنُ يَعْلَى ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَبِيعُ  حَاضِرٌ  لِبَادٍ  ، وَلَا تَسْتَقْبِلُوا الْجَلَبَ ، وَلَا  تَنَاجَشُوا ،  وَلَا  يَخْطُبْ  أَحَدُكُمْ عَلَى خِطْبَةِ أَخِيهِ  ، وَلَا تَسْأَلِ الْمَرْأَةُ طَلَاقَ أُخْتِهَا  لِتَكْتَفِئَ  مَا فِي صَحْفَتِهَا  ، فَإِنَّمَا لَهَا مَا كُتِبَتْ لَهَا ، وَلَا  تُصَرُّوا  الْإِبِلَ وَالْغَنَمَ لِبَيْعٍ ، فَمَنِ اشْتَرَى شَاةً  مُصَرَّاةً  ، فَإِنَّهُ بِأَحَدِ  النَّظَرَيْنِ  ، إِنْ رَدَّهَا ، رَدَّهَا بِصَاعٍ مِنْ تَمْرٍ  "" .  في طبعة مكتبة ابن تيمية : ( صفحتها ) وهي على الصواب في النسخ الخطية ، وهي وإن كانت تشتبه قليلا في الظاهرية فهي واضحة تماما في نسخة أحمد الثالث . والله أعلم","","Al-Mu'jam al-Kabir 13545","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن يحيى بن يعلى بن حرملة التيمي عن يحيى بن سليمان بن يحيى عن محمد بن الحسين ابن بنت رشدين بن سعد المصري عن الطبراني","مجاهد عن ابن عمر"
"13582","13546  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  مَنْصُورِ بْنِ أَبِي الْأَسْوَدِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ،         [12/420]      قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَتَلَقَّى الْبُيُوعَ فِي أَفْوَاهِ الطُّرُقِ ، وَأَنْ يَبِيعَ  حَاضِرٌ  لِبَادٍ  .","","Al-Mu'jam al-Kabir 13546","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن منصور بن أبي الأسود الليثي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","مجاهد عن ابن عمر"
"13583","13547  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْبَرَاءِ  ، ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَبِعْ  حَاضِرٌ  لِبَادٍ ،  وَلَا يَشْتَرِ لَهُ  .","","Al-Mu'jam al-Kabir 13547","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","مجاهد عن ابن عمر"
"13584","13548  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قِيلَ لَهُ :  إِنَّا إِذَا دَخَلْنَا عَلَى الْأُمَرَاءِ قُلْنَا لَهُمْ مَا لَا نَقُولُ لَهُمْ إِذَا خَرَجْنَا مِنْ عِنْدِهِمْ ، فَقَالَ : "" كُنَّا نَعُدُّ ذَلِكَ نِفَاقًا  عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 13548","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13585","13549  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ هُوَ أَبُو هِشَامٍ الرِّفَاعِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الطُّهَوِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  بَيْنَمَا أَنَا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ظِلٍّ  بِالْمَدِينَةِ  وَهُوَ يَطْلُبُ  عَلِيًّا  رَضِيَ اللهُ عَنْهُ إِذِ انْتَهَيْنَا إِلَى حَائِطٍ ، فَنَظَرْنَا فِيهِ فَنَظَرَ إِلَى  عَلِيٍّ  وَهُوَ نَائِمٌ فِي الْأَرْضِ ، وَقَدْ أَغْبَرَ فَقَالَ :  لَا أَلُومُ النَّاسَ يُكَنُّونَكَ  أَبَا تُرَابٍ  ، فَلَقَدْ رَأَيْتُ  عَلِيًّا  تَغَيَّرَ وَجْهُهُ ، وَاشْتَدَّ ذَلِكَ ، فَقَالَ : "" أَلَا أُرْضِيكَ يَا  عَلِيُّ  ؟ "" قَالَ : بَلَى يَا رَسُولَ اللهِ ، قَالَ : "" أَنْتَ أَخِي وَوَزِيرِي تَقْضِي دَيْنِي وَتُنْجِزُ مَوْعِدِي وَتُبْرِئُ ذِمَّتِي ، فَمَنْ أَحَبَّكَ فِي حَيَاةٍ مِنِّي فَقَدْ قَضَى  نَحْبَهُ  ، وَمَنْ أَحَبَّكَ فِي حَيَاةٍ مِنْكَ بَعْدِي خَتَمَ اللهُ لَهُ بِالْأَمْنِ وَالْإِيمَانِ ، وَمَنْ أَحَبَّكَ بَعْدِي وَلَمْ يَرَكَ خَتَمَ اللهُ لَهُ بِالْأَمْنِ وَالْإِيمَانِ ، وَأَمَّنَهُ يَوْمَ الْفَزَعِ         [12/421]      الْأَكْبَرِ ، وَمَنْ مَاتَ وَهُوَ يُبْغِضُكَ يَا  عَلِيُّ  مَاتَ  مِيتَةً  جَاهِلِيَّةً ، يُحَاسِبُهُ اللهُ بِمَا عَمِلَ فِي الْإِسْلَامِ  .","","Al-Mu'jam al-Kabir 13549","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبد الله بن محمد الطهوي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن محمد بن عثمان بن أبي شيبة عن الطبراني","مجاهد عن ابن عمر"
"13586","13550  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَفْصُ بْنُ أَبِي دَاوُدَ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوَّلُ مَنْ أَشْفَعُ لَهُ يَوْمَ الْقِيَامَةِ أَهْلُ بَيْتِي ، ثُمَّ الْأَقْرَبُ فَالْأَقْرَبُ مِنْ  قُرَيْشٍ  ، ثُمَّ  الْأَنْصَارُ  ، ثُمَّ مَنْ آمَنَ بِي وَاتَّبَعَنِي مِنَ  الْيَمَنِ  ، ثُمَّ سَائِرِ  الْعَرَبِ  ، ثُمَّ  الْأَعَاجِمِ  ، وَأَوَّلُ مَنْ أَشْفَعُ لَهُ أُولُو الْفَضْلِ  .","","Al-Mu'jam al-Kabir 13550","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حفيص الأسدي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عمر"
"13587","13551  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ،  ثَنَا  الْحَكَمُ بْنُ ظُهَيْرٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَاتَ بُكْرَةً ، فَلَا يَقِيلَنَّ إِلَّا فِي قَبْرِهِ  ، وَمَنْ مَاتَ عَشِيَّةً فَلَا يَبِيتَنَّ إِلَّا فِي قَبْرِهِ  .","","Al-Mu'jam al-Kabir 13551","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن الحكم بن ظهير الفزاري عن الحسن بن عرفة العبدي عن محمد بن العباس ابن الأخرم عن الطبراني","مجاهد عن ابن عمر"
"13588","13552  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَلِيٍّ الْجَارُودِيُّ النَّيْسَابُورِيُّ  ، ثَنَا  أَحْمَدُ بْنُ حَفْصٍ ،  ثَنَا  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  مُسْلِمٍ الْأَعْوَرِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ إِسْبَالِ الْإِزَارِ  .","","Al-Mu'jam al-Kabir 13552","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إبراهيم بن طهمان عن حفص بن عبد الله بن راشد النيسابوري عن أحمد بن حفص بن عبد الله النيسابوري عن ابن الجارود عن الطبراني","مجاهد عن ابن عمر"
"13589","13553  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  وَاصِلُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  مُسْلِمٍ الْمُلَائِيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا فَتَحَ اللهُ عَلَى  عَادٍ  مِنَ         [12/422]      الرِّيحِ الَّتِي أُهْلِكُوا فِيهَا إِلَّا مِثْلَ مَوْضِعِ الْخَاتَمِ  ، فَمَرَّتْ بِأَهْلِ الْبَادِيَةِ فَحَمَلَتْ مَوَاشِيَهُمْ وَأَمْوَالَهُمْ فَحَمَلَتْهُمْ بَيْنَ السَّمَاءِ وَالْأَرْضِ ، فَلَمَّا رَأَوْا ذَلِكَ أَهْلُ الْحَاضِرَةِ مِنَ الرِّيحِ ، وَمَا فِيهَا قَالُوا : هَذَا عَارِضٌ  مُمْطِرُنَا فَأَلْقَتْ أَهْلَ الْبَادِيَةِ وَمَوَاشِيَهُمْ عَلَى أَهْلِ الْحَاضِرَةِ  .  في طبعة مكتبة ابن تيمية : ( حاضر ) وهي على الصواب في النسخ الخطية .","","Al-Mu'jam al-Kabir 13553","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن محمد بن فضيل بن غزوان عن واصل بن عبد الأعلى الأسدي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عمر"
"13590","13554  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْجَعْدِ الْوَشَّاءُ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُؤَذِّنُ الْمُحْتَسِبُ كَالشَّهِيدِ  يَتَشَحَّطُ  فِي دَمِهِ حَتَّى يَفْرُغَ مِنْ أَذَانِهِ  ، وَيَشْهَدُ لَهُ كُلُّ رَطْبٍ وَيَابِسٍ وَإِذَا مَاتَ لَمْ يُدَوَّدْ فِي قَبْرِهِ  .","","Al-Mu'jam al-Kabir 13554","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن سالم بن عجلان الأفطس عن محمد بن الفضل بن عطية العبسي عن محمد بن بكار الرصافي عن أحمد بن محمد بن عبد العزيز الوشاء عن الطبراني","مجاهد عن ابن عمر"
"13591","13555  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ النَّهْدِيُّ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  اهْتَزَّ  الْعَرْشُ لِحُبِّ لِقَاءِ اللهِ  سَعْدًا  ، وَكَانَ آخِرَهُمْ خَرَجَ مِنْ قَبْرِهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ :  إِنَّ  سَعْدًا  ضُغِطَ فِي قَبْرِهِ ضَغْطَةً ، فَسَأَلْتُ اللهَ أَنْ يُخَفِّفَ عَنْهُ  .","","Al-Mu'jam al-Kabir 13555","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عطاء بن السائب عن عبد السلام بن حرب الملائي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عمر"
"13592","13556  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْخَيَّاطُ ،  ثَنَا  عِمْرَانُ بْنُ عُتَيْبَةَ  ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْغَازِي فِي  سَبِيلِ  اللهِ ، وَالْحَاجُّ إِلَى بَيْتِ اللهِ وَفْدُ اللهِ دَعَاهُمْ فَأَجَابُوهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عيينة )","","Al-Mu'jam al-Kabir 13556","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عطاء بن السائب عن عمران بن عيينة الهلالي عن الحسن بن سهل الخياط عن محمد بن عثمان بن أبي شيبة عن الطبراني","مجاهد عن ابن عمر"
"13593","[12/423]      13557  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَمْرَوَيْهِ الْهَرَوِيُّ ،  ثَنَا  الْجَارُودُ بْنُ يَزِيدَ ،  ثَنَا  عُمَرُ بْنُ ذَرٍّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ رَبَّكُمْ حَيِيٌّ كَرِيمٌ يَسْتَحْيِ أَنْ يَرْفَعَ الْعَبْدُ يَدَيْهِ فَيَرُدُّهُمَا صِفْرًا لَا خَيْرَ فِيهِمَا  ، فَإِذَا رَفَعَ أَحَدُكُمْ يَدَيْهِ فَلْيَقُلْ : يَا حَيُّ لَا إِلَهَ إِلَّا أَنْتَ يَا أَرْحَمَ الرَّاحِمِينَ ثَلَاثَ مَرَّاتٍ ، ثُمَّ إِذَا رَدَّ يَدَيْهِ  فَلْيُفْرِغْ  ذَلِكَ الْخَيْرَ إِلَى وَجْهِهِ  .","","Al-Mu'jam al-Kabir 13557","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عمر بن ذر عن الجارود بن يزيد أحد أصحاب أبي حنيفة عن ابن عمرويه محمد بن عمرو الهروي عن عبيد العجل عن الطبراني","مجاهد عن ابن عمر"
"13594","13558  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  عَبْدَةُ بْنُ أَبِي لُبَابَةَ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عُمَرَ ، قَالَ :  انْقَطَعَتِ  الْهِجْرَةُ  بَعْدَ  الْفَتْحِ  .","","Al-Mu'jam al-Kabir 13558","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبدة بن أبي لبابة عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","مجاهد عن ابن عمر"
"13595","13559  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صُبَيْحٍ الْأَسَدِيُّ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  عِمْرَانَ بْنِ عَمَّارٍ ،  عَنْ  أَبِي إِدْرِيسَ ،  حَدَّثَنِي  مُجَاهِدٌ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ فَارَقَ  عَلِيًّا  فَارَقَنِي ، وَمَنْ فَارَقَنِي فَارَقَ اللهَ  .","","Al-Mu'jam al-Kabir 13559","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أبو إدريس عن عمران بن عمار عن يحيى بن يعلى القطواني عن أحمد بن صبيح الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عمر"
"13596","13560  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَنْصُورٍ الرُّمَّانِيُّ الْمِصِّيصِيُّ  ، حَدَّثَنِي  مُصْعَبُ بْنُ سَعِيدٍ أَبُو خَيْثَمَةَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  ثَنَا  أَبُو شِهَابٍ الْحَنَّاطُ ،  عَنْ  فِطْرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا الْمُعْطِي مِنْ سَعَةٍ بِأَفْضَلَ مِنَ الْآخِذِ إِذَا كَانَ مُحْتَاجًا  .","","Al-Mu'jam al-Kabir 13560","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن فطر بن خليفة عن عبد ربه بن نافع الحناط عن موسى بن أعين الجزري عن مصعب بن سعيد المصيصي عن الحسين بن منصور الرماني عن الطبراني","مجاهد عن ابن عمر"
"13597","13561  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا         [12/424]      يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ الْحَلَبِيُّ ، قَالَ :  سَمِعْتُ  مُجَاهِدًا يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَرَسُولِهِ فَلْيُؤَدِّ زَكَاةَ مَالِهِ  ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَرَسُولِهِ فَلْيَقُلْ خَيْرًا أَوْ لِيَسْكُتْ ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَرَسُولِهِ فَلْيُكْرِمْ ضَيْفَهُ  .","","Al-Mu'jam al-Kabir 13561","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","مجاهد عن ابن عمر"
"13598","13562  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  مُجَاهِدًا يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ قَالَ : الْحَمْدُ لِلهِ الَّذِي تَوَاضَعَ كُلُّ شَيْءٍ لِعَظَمَتِهِ ، وَالْحَمْدُ لِلهِ الَّذِي ذَلَّ كُلُّ شَيْءٍ لِعِزَّتِهِ  ، وَالْحَمْدُ لِلهِ الَّذِي خَضَعَ كُلُّ شَيْءٍ لِمُلْكِهِ ، وَالْحَمْدُ لِلهِ الَّذِي اسْتَسْلَمَ كُلُّ شَيْءٍ لِقُدْرَتِهِ ، فَقَالَهَا مَا يَطْلُبُ بِهَا مَا عِنْدَهُ ، كَتَبَ اللهُ لَهُ بِهَا أَلْفَ حَسَنَةٍ وَرَفَعَ لَهُ بِهَا أَلْفَ دَرَجَةٍ ، وَوَكَّلَ بِهِ سَبْعِينَ أَلْفَ مَلَكٍ يَسْتَغْفِرُونَ لَهُ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13562","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","مجاهد عن ابن عمر"
"13599","13563  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَنَا  شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عُمَرَ ، قَالَ :  صَلَاةُ الضُّحَى بِدْعَةٌ ، وَنِعْمَتِ  الْبِدْعَةُ  "" .","","Al-Mu'jam al-Kabir 13563","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن إبراهيم بن مهاجر بن جابر البجلي عن شريك بن عبد الله النخعي عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","مجاهد عن ابن عمر"
"13600","13564  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  أَبُو الْجَوَّابِ الْأَحْوَصُ بْنُ جَوَّابٍ ،  عَنْ  عَمَّارِ بْنِ رُزَيْقٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَقْرَأُ فِي رَكْعَتَيِ الْفَجْرِ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Al-Mu'jam al-Kabir 13564","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن إبراهيم بن مهاجر بن جابر البجلي عن أبو إسحاق السبيعي عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن الفضل بن سهل الخراساني عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عمر"
"13601","[12/425]      13565  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ  ، ثَنَا  مَعْمَرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  ثَنَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَمْنَعُوا إِمَاءَ اللهِ مَسَاجِدَ اللهِ  .","","Al-Mu'jam al-Kabir 13565","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن إبراهيم بن مهاجر بن جابر البجلي عن علي بن صالح بن حي عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن محمد بن حنيفة القصبى عن الطبراني","مجاهد عن ابن عمر"
"13602","13566  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ مُجَاهِدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجُلَانِ أَحَدُهُمَا مِنَ  الْأَنْصَارِ  ، وَالْآخَرُ مِنْ  ثَقِيفٍ  فَسَبَقَهُ  الْأَنْصَارِيُّ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلثَّقَفِيِّ  :  يَا أَخَا  ثَقِيفٍ  سَبَقَكَ الْأَنْصَارِيُّ  ، فَقَالَ الْأَنْصَارِيُّ : أَنَا أَبَدُّهُ يَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لَهُ : "" يَا أَخَا  ثَقِيفٍ  سَلْ عَنْ حَاجَتِكَ ، وَإِنْ شِئْتَ أَنْ أُخْبِرَكَ عَمَّا جِئْتَ بِهِ تَسْأَلُ عَنْهُ "" قَالَ : فَذَاكَ أَعْجَبُ إِلَيَّ أَنْ تَفْعَلَ ، قَالَ : "" فَإِنَّكَ تَسْأَلُنِي عَنْ صَلَاتِكَ ، وَعَنْ رُكُوعِكَ ، وَعَنِ سُجُودِكَ ، وَعَنْ صِيَامِكَ ، وَتَقُولُ : مَاذَا لِي فِيهِ ؟ "" ، قَالَ :  إِي  وَالَّذِي بَعَثَكَ بِالْحَقِّ ، قَالَ : "" فَصَلِّ أَوَّلَ اللَّيْلِ وَآخِرَهُ ، وَنَمْ وَسَطَهُ "" قَالَ : فَإِنْ صَلَّيْتُ وَسَطَهُ ، قَالَ : "" فَأَنْتَ إِذًا - قَالَ - فَإِذَا قُمْتَ إِلَى الصَّلَاةِ فَرَكَعْتَ فَضَعْ يَدَكَ عَلَى رُكْبَتَيْكَ ، وَفَرِّجْ بَيْنَ أَصَابِعِكَ ، ثُمَّ ارْفَعْ رَأْسَكَ حَتَّى يَرْجِعَ كُلُّ عُضْوٍ إِلَى مَفْصِلِهِ ، وَإِذَا سَجَدْتَ فَأَمْكِنْ جَبْهَتَكَ مِنَ الْأَرْضِ ، وَلَا تَنْقُرْ ، وَصُمِ اللَّيَالِيَ الْبِيضَ ثَلَاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ "" ، ثُمَّ أَقْبَلَ عَلَى الْأَنْصَارِيِّ ، فَقَالَ : "" سَلْ عَنْ حَاجَتِكَ وَإِنْ شِئْتَ أَخْبَرْتُكَ "" ، قَالَ : فَذَلِكَ أَعْجَبُ إِلَيَّ ، قَالَ : "" فَإِنَّكَ جِئْتَ تَسْأَلُنِي عَنْ خُرُوجِكَ مِنْ بَيْتِكَ تَؤُمُّ  الْبَيْتَ الْحَرَامَ         [12/426]      وَتَقُولُ : مَاذَا لِي فِيهِ ؟ "" ، وَجِئْتَ تَسْأَلُ عَنْ وُقُوفِكَ  بِعَرَفَةَ  وَتَقُولُ : مَاذَا لِي فِيهِ ؟ وَعَنْ رَمْيِكَ الْجِمَارَ ، وَتَقُولُ : مَاذَا لِي فِيهِ ؟ وَعَنْ طَوَافِكَ  بِالْبَيْتِ  ، وَتَقُولُ : مَاذَا لِي فِيهِ ؟ وَعَنْ حَلْقِكَ رَأْسَكَ ، وَتَقُولُ : مَاذَا لِي فِيهِ ؟ "" قَالَ :  إِي  وَالَّذِي بَعَثَكَ بِالْحَقِّ ، قَالَ : "" أَمَّا خُرُوجُكَ مِنْ بَيْتِكَ تَؤُمُّ  الْبَيْتَ  فَإِنَّ لَكَ بِكُلِّ وَطْأَةٍ تَطَؤُهَا رَاحِلَتُكَ يَكْتُبُ اللهُ لَكَ بِهَا حَسَنَةً ، وَيَمْحُو عَنْكَ بِهَا سَيِّئَةً ، وَأَمَّا وُقُوفُكَ  بِعَرَفَةَ  فَإِنَّ اللهَ عَزَّ وَجَلَّ  يَنْزِلُ  إِلَى السَّمَاءِ الدُّنْيَا  فَيُبَاهِي  بِهِمُ الْمَلَائِكَةَ فَيَقُولُ :  هَؤُلَاءِ عِبَادِي جَاءُونِي شُعْثًا غُبْرًا مِنْ كُلِّ  فَجٍّ  عَمِيقٍ يَرْجُونَ رَحْمَتِي ، وَيَخَافُونَ عَذَابِي ، وَلَمْ يَرَوْنِي  ، فَكَيْفَ لَوْ رَأَوْنِي ؟ فَلَوْ كَانَ عَلَيْكَ مِثْلُ رَمْلِ  عَالِجٍ  ، أَوْ مِثْلُ أَيَّامِ الدُّنْيَا أَوْ مِثْلُ قَطْرِ السَّمَاءِ ذُنُوبًا غَسَلَ اللهُ عَنْكَ ، وَأَمَّا رَمْيُكَ الْجِمَارَ فَإِنَّهُ مَذْخُورٌ لَكَ ، وَأَمَّا حَلْقُكَ رَأْسَكَ ، فَإِنَّ لَكَ بِكُلِّ شَعَرَةٍ تَسْقُطُ حَسَنَةً ، فَإِذَا طُفْتَ  بِالْبَيْتِ  خَرَجْتَ مِنْ ذُنُوبِكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ  .","","Al-Mu'jam al-Kabir 13566","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الوهاب بن مجاهد مولى السائب عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مجاهد عن ابن عمر"
"13603","13567  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَيُّوبَ الْقَرَنِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  بِشْرُ بْنُ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيُّ ،  حَدَّثَنِي  عَبْدُ الْوَهَّابِ بْنُ مُجَاهِدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْعَبَادِلَةِ عَبْدِ اللهِ بْنِ عُمَرَ ، وَعَبْدِ اللهِ بْنِ الْعَبَّاسِ ، وَعَبْدِ اللهِ بْنِ الزُّبَيْرِ ، وَعَبْدِ اللهِ بْنِ عَمْرٍو ، قَالُوا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْقَاصُّ  يَنْتَظِرُ الْمَقْتَ ، وَالْمُسْتَمِعُ يَنْتَظِرُ الرَّحْمَةَ ،         [12/427]      وَالتَّاجِرُ يَنْتَظِرُ الرِّزْقَ  ، وَالْمُحْتَكِرُ يَنْتَظِرُ اللَّعْنَةَ ، وَالنَّائِحَةُ وَمَنْ حَوْلَهَا مِنِ امْرَأَةٍ عَلَيْهِمْ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 13567","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الوهاب بن مجاهد مولى السائب عن بشر بن عبد الرحمن الأنصاري عن شيبان بن فروخ الحبطي عن القربي عبد الله بن أيوب بن زاذان عن الطبراني","مجاهد عن ابن عمر"
"13604","13568  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  ثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنِ  ابْنِ مُجَاهِدٍ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ فَبَسَطَ كَفَّهُ الْيُمْنَى فَقَالَ : "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ هَذَا كِتَابٌ مِنَ اللهِ  الرَّحْمَنِ الرَّحِيمِ بِأَسْمَاءِ أَهْلِ الْجَنَّةِ ، وَأَسْمَاءِ آبَائِهِمْ ، وَقَبَائِلِهِمْ ، وَعَشَائِرِهِمْ ، لَا يُزَادُ فِيهِمْ ، وَلَا يُنْقَصُ مِنْهُمْ "" ، ثُمَّ بَسَطَ كَفَّهُ الْيُسْرَى ، فَقَالَ : "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ هَذَا كِتَابٌ مِنَ اللهِ الرَّحْمَنِ الرَّحِيمِ لِأَهْلِ النَّارِ بِأَسْمَائِهِمْ وَأَسْمَاءِ آبَائِهِمْ ، وَقَبَائِلِهِمْ ، وَعَشَائِرِهِمْ لَا يُزَادُ فِيهِمْ ، وَلَا يُنْقَصُ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 13568","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الوهاب بن مجاهد مولى السائب عن حماد بن زيد عن يونس بن محمد بن مسلم البغدادي عن مجاهد بن موسى عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","مجاهد عن ابن عمر"
"13605","13569  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ صَاحِبُ الْمَغَازِي ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَلِمُ  الرُّكْنَ الْيَمَانِي  وَالْحَجَرَ  ، وَلَا يَسْتَلِمُ غَيْرَهُمَا  .","","Al-Mu'jam al-Kabir 13569","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد العزيز بن أبي رواد الخراساني عن أبو بكر بن عياش عن أحمد بن محمد بن أيوب عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عمر"
"13606","13570  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْحَسَنُ بْنُ مُحَمَّدٍ الزَّعْفَرَانِيُّ ،  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ائْذَنُوا لِلنِّسَاءِ فِي الْمَسَاجِدِ بِاللَّيْلِ  .","","Al-Mu'jam al-Kabir 13570","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن شبابة بن سوار المدائني عن الحسن بن محمد الزعفراني عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عمر"
"13607","13571  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، وَأَبُو عَبْدِ الْمَلِكِ         [12/428]      الْقُرَشِيُّ أَحْمَدُ بْنُ إِبْرَاهِيمَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَائِذٍ الدِّمَشْقِيُّ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  ثَنَا  الْمُطْعِمُ بْنُ الْمِقْدَامِ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  خَرَجْتُ إِلَى الْغَزْوِ أَنَا  وَرَجُلٌ  مَعِي فَشَيَّعَنَا عَبْدُ اللهِ بْنُ عُمَرَ فَلَمَّا أَرَادَ فِرَاقَنَا قَالَ : إِنَّهُ لَيَسُرُّنِي مَا أَعْطَيْتُمَاهُ ، وَلَكِنْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا اسْتُودِعَ اللهُ شَيْئًا حَفِظَهُ ، وَإِنِّي أَسْتَوْدِعُ اللهَ دِينَكُمَا وَأَمَانَتَكُمَا ، وَخَوَاتِيمَ عَمَلِكُمَا  .","","Al-Mu'jam al-Kabir 13571","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن مطعم بن المقدام الصنعاني عن الهيثم بن حميد الغساني عن محمد بن عائذ بن أحمد عن أحمد بن إبراهيم بن محمد البسري عن الطبراني","مجاهد عن ابن عمر"
"13608","[  صَدَقَةُ بْنُ يَسَارٍ الْمَكِّيُّ  ، عَنِ  ابْنِ عُمَرَ  ]  13572  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ خَالِدٍ ،  ثَنَا  رَبَاحُ بْنُ زَيْدٍ ،  عَنْ  مَعْمَرٍ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ الْمَكِّيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اعْتَكَفَ ، وَخَطَبَ النَّاسَ ، فَقَالَ :  إِنَّ أَحَدَكُمْ إِذَا قَامَ فِي الصَّلَاةِ فَإِنَّهُ يُنَاجِي رَبَّهُ فَيَعْلَمُ أَحَدُكُمْ بِمَا يُنَاجِي رَبَّهُ  ، وَلَا يَجْهَرْ بَعْضُكُمْ عَلَى بَعْضٍ بِالْقِرَاءَةِ فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 13572","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن معمر بن راشد عن رباح بن زيد الصنعاني عن إبراهيم بن خالد الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","صدقة بن يسار المكي عن ابن عمر"
"13609","13573  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ ،  ثَنَا  الضَّحَّاكُ بْنُ عُثْمَانَ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا كَانَ أَحَدُكُمْ يُصَلِّي فَلَا يَدَعْ أَحَدًا يَمُرُّ بَيْنَ يَدَيْهِ فَإِنْ أَبَى فَلْيُقَاتِلْهُ فَإِنَّ مَعَهُ  الْقَرِينَ  "" .","","Al-Mu'jam al-Kabir 13573","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن الضحاك بن عثمان الحزامي عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","صدقة بن يسار المكي عن ابن عمر"
"13610","[12/429]      13574  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ دُحَيْمٍ الْكُوفِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ بْنِ صُبَيْحٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ صُبَيْحٍ ،  ثَنَا  أَبُو أُوَيْسٍ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ : "" رَأَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُهِلُّ حِينَ تَسْتَهِلُّ بِهِ رَاحِلَتُهُ  .","","Al-Mu'jam al-Kabir 13574","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن عبد الله بن عبد الله بن أويس عن إسماعيل بن صبيح اليشكري عن محمد بن عمارة بن صبيح عن محمد بن سعيد دحيم الكوفى عن الطبراني","صدقة بن يسار المكي عن ابن عمر"
"13611","13575  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  ابْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  .","","Al-Mu'jam al-Kabir 13575","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","صدقة بن يسار المكي عن ابن عمر"
"13612","13576  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ فَقَالَ : "" أَمَّا  بَعْدُ  "" .","","Al-Mu'jam al-Kabir 13576","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن موسى بن عبيدة بن نشيط الحميري عن المعافى بن عمران عن أحمد بن إبراهيم بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","صدقة بن يسار المكي عن ابن عمر"
"13613","[  عَطَاءُ بْنُ أَبِي رَبَاحٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13577  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الْجَرْمِيُّ ،  ثَنَا  قُرَّانُ بْنُ تَمَّامٍ ،  عَنْ  وِقَاءِ بْنِ إِيَاسٍ الْوَالِبِيِّ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَتَى الْجُمُعَةَ فَلْيَغْتَسِلْ  .","","Al-Mu'jam al-Kabir 13577","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن بكير بن الأخنس السدوسي عن وقاء بن إياس الوالبي عن قران بن تمام الوالبي عن سعيد بن محمد الجرمي عن عبد الله بن أحمد بن حنبل عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13614","13578  -  حَدَّثَنَا  عَلِيُّ بْنُ بَيَانٍ الْمُطَرِّزُ  ، ثَنَا  أَبُو مَعْمَرٍ صَالِحُ بْنُ حَرْبٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ يَحْيَى التَّيْمِيُّ ،  عَنْ  مِسْعَرٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي         [12/430]      رَبَاحٍ ، قَالَ :  قُلْتُ لِابْنِ عُمَرَ : أَشَهِدْتَ بَيْعَةَ الرِّضْوَانِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" نَعَمْ  ، قُلْتُ : فَمَا كَانَ عَلَيْهِ ؟ قَالَ : "" قَمِيصٌ مِنْ قُطْنٍ وَجُبَّةٌ مَحْشُوَّةٌ وَرِدَاءٌ وَسَيْفٌ ، وَرَأَيْتُ  النُّعْمَانَ بْنَ مُقَرِّنٍ الْمُزَنِيَّ  قَائِمًا عَلَى رَأْسِهِ قَدْ رَفَعَ أَغْصَانَ الشَّجَرَةِ عَنْ رَأْسِهِ ، وَالنَّاسُ  يُبَايِعُونَهُ  .","","Al-Mu'jam al-Kabir 13578","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن مسعر بن كدام عن إسماعيل بن يحيى التيمي عن صالح بن حرب بن خالد الهاشمي مولاهم عن على بن محمد بن خالد بن بيان المطرز عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13615","13579  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ دِينَارٍ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَهَلَّ حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ  .","","Al-Mu'jam al-Kabir 13579","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن مصعب بن المقدام الخثعمي عن القاسم بن زكريا الطحان عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13616","13580  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ الطَّالْقَانِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تُقَبِّحُوا  الْوَجْهَ ، فَإِنَّ ابْنَ آدَمَ خُلِقَ عَلَى صُورَةِ الرَّحْمَنِ تَعَالَى  "" .","","Al-Mu'jam al-Kabir 13580","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن جرير بن عبد الحميد عن إسحاق بن إسماعيل الطالقاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13617","13581  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ بَهَانٍ الْعَسْكَرِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ  ، ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ سَجَّادَةُ ، قَالَا :  ثَنَا  الْمُطَّلِبُ بْنُ زِيَادٍ الثَّقَفِيُّ ،  عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَتَى رَجُلٌ  ابْنَ عُمَرَ  ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّا نُسَافِرُ فَنَلْقَى أَقْوَامًا يَقُولُونُ لَا قَدَرَ ، قَالَ : فَإِذَا لَقِيتَ أُولَئِكَ فَأَخْبِرْهُمْ أَنَّ  ابْنَ عُمَرَ  مِنْهُمْ بَرِيءٌ ،  كُنَّا عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِذْ         [12/431]      أَتَاهُ رَجُلٌ حَسَنُ الْوَجْهِ طَيِّبُ الرِّيحِ نَقِيُّ الثَّوْبِ  ، فَقَالَ : السَّلَامُ عَلَيْكَ يَا رَسُولَ اللهِ : أَدْنُو مِنْكَ ؟ قَالَ : "" ادْنُهْ "" فَدَنَا دَنْوَةً قَالَ ذَلِكَ مِرَارًا حَتَّى اصْطَكَّتَا رُكْبَتَاهُ رُكْبَتَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ مَا الْإِسْلَامُ ؟ قَالَ : "" شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، وَإِقَامُ الصَّلَاةِ ، وَإِيتَاءُ الزَّكَاةِ ، وَحَجُّ الْبَيْتِ ، وَصِيَامُ رَمَضَانَ ،  وَالْغُسْلُ  مِنَ الْجَنَابَةِ "" قَالَ : فَإِذَا فَعَلْتُ ذَلِكَ فَأَنَا مُسْلِمٌ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : صَدَقْتَ ، قَالَ : فَمَا الْإِيمَانُ ؟ قَالَ : "" الْإِيمَانُ أَنْ تُؤْمِنَ بِاللهِ ، وَمَلَائِكَتِهِ ، وَكُتُبِهِ ، وَرُسُلِهِ ، وَالْجَنَّةِ ، وَالنَّارِ ، وَالْقِيَامَةِ ، وَالْقَدَرِ خَيْرِهِ وَشَرِّهِ ، وَحُلْوِهِ وَمُرِّهِ مِنَ اللهِ "" قَالَ : فَإِذَا فَعَلْتُ ذَلِكَ فَأَنَا مُؤْمِنٌ ؟ قَالَ : نَعَمْ . قَالَ : صَدَقْتَ ، فَمَا  الْإِحْسَانُ  ؟ قَالَ : "" تَعْبُدُ اللهَ كَأَنَّكَ تَرَاهُ فَإِنْ كُنْتَ لَا تَرَاهُ فَإِنَّهُ يَرَاكَ "" قَالَ : فَإِذَا فَعَلْتُ ذَلِكَ فَأَنَا مُحْسِنٌ ؟ قَالَ : "" نَعَمْ "" ، قَالَ : صَدَقْتَ ، قُلْنَا مَا رَأَيْنَا رَجُلًا أَحْسَنَ وَجْهًا وَلَا أَطْيَبَ رِيحًا ، وَأَشَدَّ تَوْقِيرًا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَوْلُهُ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : صَدَقْتَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عَلَيَّ بِالرَّجُلِ فَقُمْنَا ، وَقُمْتُ أَنَا عَلَى طَرِيقٍ مِنْ طُرُقِ  الْمَدِينَةِ  فَلَمْ نَرَ شَيْئًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" تَدْرُونَ مَنْ هَذَا ؟ "" قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ قَالَ : "" هَذَا  جِبْرِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُكُمْ  مَنَاسِكَ  دِينِكُمْ ، مَا أَتَانِي فِي صُورَةٍ قَطُّ إِلَّا عَرَفْتُهُ إِلَّا هَذِهِ الصُّورَةَ  .","","Al-Mu'jam al-Kabir 13581","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن منصور بن المعتمر عن المطلب بن زياد الثقفي عن الحسن بن حماد سجادة عن محمد بن الحسين بن مكرم البارع عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13618","13582  -  حَدَّثَنَا  الْفَضْلُ بْنُ أَبِي رَوْحٍ الْبَصْرِيُّ  ، ثَنَا  عَبْدُ اللهِ         [12/432]      بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلِ بْنِ غَزْوَانَ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ فَأَقْبَلَ  أَعْرَابِيٌّ  ، فَلَمَّا دَنَا قَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَيْنَ تُرِيدُ ؟ "" قَالَ : إِلَى أَهْلِي ، قَالَ : "" هَلْ لَكَ فِي خَيْرٍ ؟ "" قَالَ : مَا هُوَ ؟ قَالَ :  تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  ، قَالَ : مَنْ شَاهِدٌ عَلَى مَا تَقُولُ ؟ قَالَ : "" هَذِهِ الشَّجَرَةُ "" فَدَعَاهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهِيَ بِشَاطِئِ الْوَادِي فَأَقْبَلَتْ  تَخُدُّ  الْأَرْضَ خَدًّا حَتَّى قَامَتْ بَيْنَ يَدَيْهِ ، فَاسْتَشْهَدَهَا ثَلَاثًا فَشَهِدَتْ أَنَّهُ كَمَا قَالَ ، ثُمَّ رَجَعَتْ إِلَى مَنْبَتِهَا ، وَرَجَعَ الْأَعْرَابِيُّ إِلَى قَوْمِهِ فَقَالَ : إِنْ يَتَّبِعُونِي آتِيكَ بِهِمْ ، وَإِلَّا رَجَعْتُ إِلَيْكَ فَكُنْتُ مَعَكَ  .","","Al-Mu'jam al-Kabir 13582","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن يحيى بن سعيد التيمي عن محمد بن فضيل بن غزوان عن عبد الله بن عمر مشكدانة عن الفضل بن أبي روح البصري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13619","13583  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو بَكْرٍ الْأَعْيَنُ مُحَمَّدُ بْنُ أَبِي عَتَّابٍ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَتَى عَلَيْنَا زَمَانٌ ، وَمَا يَرَى أَحَدٌ مِنَّا أَنَّهُ أَحَقُّ بِالدِّينَارِ وَالدِّرْهَمِ مِنْ أَخِيهِ الْمُسْلِمِ ، وَأَنَا فِي زَمَانٍ الدِّينَارُ وَالدِّرْهَمُ أَحَبُّ إِلَيْنَا مِنْ أَخِينَا الْمُسْلِمِ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا ضَنَّ النَّاسُ بِالدِّينَارِ وَالدِّرْهَمِ ، وَتَرَكُوا  الْجِهَادَ  فِي  سَبِيلِ  اللهِ  ، وَلَزِمُوا أَذْنَابَ الْبَقَرِ ، وَتَبَايَعُوا  بِالْعِينَةِ  ، سَلَّطَ اللهُ عَلَيْهِمْ بَلَاءً لَمْ يَرْفَعْهُ حَتَّى يُرَاجِعُوا  .","","Al-Mu'jam al-Kabir 13583","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الأعمش عن أبو بكر بن عياش عن عثمان بن سعيد بن كثير عن محمد بن أبي عتاب الأعين عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13620","[12/433]      13584  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ النَّيْسَابُورِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْفَرَّاءُ النَّيْسَابُورِيُّ ،  ثَنَا  الْحَارِثُ بْنُ مُسْلِمٍ ،  ثَنَا  بَحْرُ بْنُ كَثِيرٍ  ،  عَنِ  الْحَجَّاجِ بْنِ فُرَافِصَةَ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَوْ لَمْ أَسْمَعْهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مَرَّةً وَمَرَّةً وَمَرَّةً ، عَدَّ سَبْعَ مَرَّاتٍ لَمَا حَدَّثْتُ بِهِ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ثَلَاثٌ عَلَى  كُثْبَانِ  الْمِسْكِ يَوْمَ الْقِيَامَةِ لَا يَهُولُهُمُ الْحُزْنُ ، وَلَا يَفْزَعُونَ حِينَ  يَفْزَعُ  النَّاسُ  : رَجُلٌ تَعَلَّمَ الْقُرْآنَ ، فَأَقَامَ بِهِ يَطْلُبُ بِهِ وَجْهَ اللهِ وَمَا عِنْدَهُ ، وَرَجُلٌ نَادَى فِي كُلِّ يَوْمٍ وَلَيْلَةٍ خَمْسَ صَلَوَاتٍ يَطْلُبُ بِهِ وَجْهَ اللهِ وَمَا عِنْدَهُ ، وَمَمْلُوكٌ لَمْ يَمْنَعْهُ رِقُّ الدُّنْيَا مِنْ طَاعَةِ رَبِّهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (بحر بن كنيز) كما في مجمع الزوائد .  في طبعة مكتبة ابن تيمية : ( فراقصة ) وهي على الصواب في النسخ الخطية .  في طبعة مكتبة ابن تيمية : ( حتى ) وهي وإن احتملت في النسخ الخطية إلا أن المثبت هو الأولى بالسياق ، والموافق لما في حلية الأولياء وجامع السيوطي. والله أعلم .  في طبعة مكتبة ابن تيمية : ( يفرغ ) وكذا في النسخ الخطية إلا أن المثبت هو الأولى بالسياق ، والموافق لما في حلية الأولياء وجامع السيوطي. والله أعلم","","Al-Mu'jam al-Kabir 13584","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الأعمش عن حجاج بن فرافصة الباهلي عن بحر بن كنيز السقاء عن الحارث بن مسلم الرازي المقرئ عن عبد الله بن محمد الفراء النيسابوري عن جعفرك المفيد الأعرج عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13621","13585  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَخَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ ، قَالَا :  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَقَدْ أَتَى عَلَيْنَا زَمَانٌ ، وَمَا يَرَى أَحَدُنَا أَنَّهُ أَحَقُّ بِالدِّينَارِ وَالدِّرْهَمِ مِنْ أَخِيهِ الْمُسْلِمِ حَتَّى إِذَا كُنَّا بِآخِرِهِ أَصْبَحْنَا وَالدِّينَارُ وَالدِّرْهَمُ أَحَبُّ إِلَى أَحَدِنَا مِنْ أَخِيهِ الْمُسْلِمِ ، وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا ضَنَّ النَّاسُ بِالدِّينَارِ وَالدِّرْهَمِ ، وَتَبَايَعُوا  بِالْعِينَةِ  ، وَتَبِعُوا أَذْنَابَ الْبَقَرِ  أَرْسَلَ اللهُ عَلَيْهِمْ ذُلًّا لَا يَرْفَعُهُ عَنْهُمْ حَتَّى يُرَاجِعُوا دِينَهُمْ  .","","Al-Mu'jam al-Kabir 13585","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن معلى بن مهدي الموصلي عن خلف بن عمرو بن عبد الرحمن العكبري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13622","13586  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،         [12/434]      ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ عُمَرَ ، قَالَ :  نُهِيَ عَنْ بَيْعِ الْغَنِيمَةِ ، حَتَّى تُقْسَمَ  ""  .","","Al-Mu'jam al-Kabir 13586","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن ليث بن أبي سليم عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13623","13587  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  شَهِدْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَمْسًا وَعِشْرِينَ مَرَّةً فَكَانَ يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ الْفَجْرِ  ، وَالرَّكْعَتَيْنِ قَبْلَ الْمَغْرِبِ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      "" .","","Al-Mu'jam al-Kabir 13587","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13624","13588  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الْقَطَّانُ الْهَمْدَانِيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ مُسْلِمٍ  الْجُرْجَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَيْفٍ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَعَنَ اللهُ مَنْ سَبَّ أَصْحَابِي  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (عبد الحميد بن عصام) كما عند الطبراني في المعجم الأوسط .","","Al-Mu'jam al-Kabir 13588","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن مالك بن مغول الصهيبي عن عبد الله بن سيف الخوارزمي عن الجرجاني عبد الحميد بن عصام الهمذاني عن محمد بن نصر مموس الهمداني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13625","13589  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ، وَسُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ الْحَكَمِ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا رَأَيْتُمُ الْمَدَّاحِينَ  فَاحْثُوا  فِي وُجُوهِهِمُ  التُّرَابَ  .","","Al-Mu'jam al-Kabir 13589","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن علي بن الحكم البناني عن حماد بن سلمة عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13626","[12/435]      13590  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  قُرَّةُ بْنُ حَبِيبٍ الْقَنَوِيُّ ،  ثَنَا  سَعِيدُ بْنُ السَّمَّاكِ أَبُو مُحَمَّدٍ ،  ثَنَا  عَطَاءُ بْنُ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَلَبَ  بِلَالًا  لِيُؤَذِّنَ لَهُمْ . فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلًا  فَأَذَّنَ مَحَلَّ  بِلَالٍ  ، بَعْدَ ذَلِكَ فَأَرَادَ أَنْ يُقِيمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا يُقِيمُ مَنْ أَذَّنَ  .","","Al-Mu'jam al-Kabir 13590","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سعيد بن راشد السماك عن قرة بن حبيب القنوي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13627","13591  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ التُّرْكِيُّ  ، ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ،  ثَنَا  سَعِيدُ بْنُ رَاشِدٍ السَّمَّاكُ ،  ثَنَا  عَطَاءُ بْنُ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  اجْتَمَعَ عِيدَانِ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمُ فِطْرٍ وَجُمُعَةٍ ، فَصَلَّى بِهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْعِيدِ ، ثُمَّ أَقْبَلَ عَلَيْهِمْ بِوَجْهِهِ فَقَالَ :  يَا أَيُّهَا النَّاسُ إِنَّكُمْ قَدْ أَصَبْتُمْ خَيْرًا وَأَجْرًا ، وَإِنَّا مُجْمِعُونَ فَمَنْ أَرَادَ أَنْ يُجْمِعَ مَعَنَا فَلْيُجْمِعْ  ، وَمَنْ أَرَادَ أَنْ يَرْجِعَ إِلَى أَهْلِهِ فَلْيَرْجِعْ  .","","Al-Mu'jam al-Kabir 13591","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سعيد بن راشد السماك عن عيسى بن إبراهيم البركي عن ابن التركي محمد بن يوسف عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13628","13592  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ التُّرْكِيُّ  ، ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ،  ثَنَا  سَعِيدُ بْنُ رَاشِدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 13592","","عبد الله بن عمر بن الخطاب عن عطاء بن السائب عن سعيد بن راشد السماك عن عيسى بن إبراهيم البركي عن ابن التركي محمد بن يوسف عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13629","[12/436]      13593  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ التُّرْكِيُّ  ، ثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْبِرَكِيُّ ،  ثَنَا  سَعِيدُ بْنُ رَاشِدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ لَا يَقْعُدُ سَاعَةً مِنَ اللَّيْلِ إِلَّا أَمَرَّ السِّوَاكَ عَلَى فِيهِ  "" .","","Al-Mu'jam al-Kabir 13593","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سعيد بن راشد السماك عن عيسى بن إبراهيم البركي عن ابن التركي محمد بن يوسف عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13630","13594  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ الْمِصِّيصِيُّ  ، ثَنَا  دَاوُدُ بْنُ مُعَاذٍ ،  ثَنَا  سَعِيدُ بْنُ رَاشِدٍ السَّمَّاكُ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَقَلُّ أُمَّتِي الَّذِينَ يَبْلُغُونَ السَّبْعِينَ  .","","Al-Mu'jam al-Kabir 13594","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سعيد بن راشد السماك عن داود بن معاذ العتكي عن أحمد بن عبد الوهاب المصيصي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13631","13595  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  ثَنَا  عَفِيفُ بْنُ سَالِمٍ ،  عَنْ  أَيُّوبَ بْنِ عُتْبَةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  جَاءَ  رَجُلٌ مِنَ الْحَبَشَةِ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْأَلُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" سَلْ وَاسْتَفْهِمْ "" ، فَقَالَ : يَا رَسُولَ اللهِ فُضِّلْتُمْ عَلَيْنَا بِالصُّوَرِ ، وَالْأَلْوَانِ ، وَالنُّبُوَّةِ ؛ أَفَرَأَيْتَ إِنْ آمَنْتُ بِمِثْلِ مَا آمَنْتَ بِهِ ، وَعَمِلْتُ مِثْلَ مَا عَمِلْتَ بِهِ إِنِّي لَكَائِنٌ مَعَكَ فِي الْجَنَّةِ ؟ قَالَ : "" نَعَمْ "" . ثُمَّ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّهُ لَيُرَى بَيَاضُ الْأَسْوَدِ فِي الْجَنَّةِ مِنْ  مَسِيرَةِ  أَلْفِ عَامٍ  . ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ قَالَ : لَا إِلَهَ إِلَّا         [12/437]      اللهُ كَانَ لَهُ بِهَا عَهْدٌ عِنْدَ اللهِ ، وَمَنْ قَالَ : سُبْحَانَ اللهِ وَبِحَمْدِهِ كُتِبَتْ لَهُ مِائَةُ أَلْفِ حَسَنَةٍ ، وَأَرْبَعَةٌ وَعِشْرُونَ حَسَنَةً "" ، فَقَالَ  رَجُلٌ  : كَيْفَ يَهْلِكُ بَعْدُ هَذَا يَا رَسُولَ اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ الرَّجُلَ لَيَأْتِي يَوْمَ الْقِيَامَةِ بِالْعَمَلِ ، وَلَوْ وُضِعَ عَلَى جَبَلٍ لَاتَّقَلَهُ فَتَقُومُ النِّعْمَةُ مِنْ نِعَمِ اللهِ فَيَكَادُ أَنْ يُسْتَنْفَدَ ذَلِكَ كُلُّهُ إِلَّا أَنْ يَتَطَاوَلَ اللهُ بِرَحْمَتِهِ "" ، وَنَزَلَتْ هَذِهِ السُّورَةُ         {      هَلْ أَتَى عَلَى الإِنْسَانِ حِينٌ مِنَ الدَّهْرِ لَمْ يَكُنْ شَيْئًا مَذْكُورًا         }      إِلَى قَوْلِهِ :         {      وَمُلْكًا كَبِيرًا         }      ، قَالَ الْحَبَشِيُّ : وَإِنَّ عَيْنَيَّ لَيَرَيَانِ مَا يَرَى عَيْنَاكَ فِي الْجَنَّةِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" نَعَمْ "" فَاسْتَبْكَى حَتَّى فَاضَتْ نَفْسُهُ . قَالَ  ابْنُ عُمَرَ  : لَقَدْ رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُدَلِّيهِ فِي حُفْرَتِهِ بِيَدِهِ  .","","Al-Mu'jam al-Kabir 13595","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن عتبة اليمامي عن عفيف بن سالم الموصلي عن محمد بن عبد الله بن عمار الغامدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13632","13596  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  حَبِيبٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" اعْتَمَرَ فِي رَجَبٍ  .","","Al-Mu'jam al-Kabir 13596","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن حبيب المعلم مولى معقل بن يسار عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13633","13597  -  حَدَّثَنَا  جَعْفَرُ بْنُ بُجَيْرٍ الْعَطَّارُ الْبَغْدَادِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  عَامِرُ بْنُ يَسَافٍ ،  عَنِ  النَّضْرِ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ بْنِ ذَكْوَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَالَ : سُبْحَانَ اللهِ وَبِحَمْدِهِ كُتِبَتْ لَهُ مِائَةُ أَلْفِ حَسَنَةٍ وَأَرْبَعَةٌ وَعِشْرُونَ أَلْفَ حَسَنَةٍ  ، وَمَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ كَانَ لَهُ بِهَا عَهْدٌ عِنْدَ اللهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 13597","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسن بن ذكوان البصري عن النضر بن عبد الله الأزدي عن عامر بن عبد الله اليمامي عن إسماعيل بن إبراهيم الترجماني عن جعفر بن محمد بن بجير العطار عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13634","[12/438]      13598  -  حَدَّثَنَا  مُحَمَّدُ بْنُ قَضَاءٍ الْجَوْهَرِيُّ  ، ثَنَا  مُحَمَّدٌ الْمُثَنَّى ،  ثَنَا  أَبُو عَلِيٍّ الْحَنَفِيُّ ،  ثَنَا  حُسَامُ بْنُ مِصَكٍّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ لَا يَتَعَارَّ مِنَ اللَّيْلِ سَاعَةً إِلَّا أَجْرَى السِّوَاكَ عَلَى فِيهِ  .","","Al-Mu'jam al-Kabir 13598","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن حسام بن مصك الأزدي عن عبيد الله بن عبد المجيد الحنفي عن أبو موسى الزمن عن محمد بن قضاء الجوهري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13635","13599  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  عِمْرَانُ بْنُ أَنَسٍ الْمَكِّيُّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اذْكُرُوا مَحَاسِنَ مَوْتَاكُمْ ، وَكُفُّوا عَنْ مَسَاوِئِهِمْ  "" .","","Al-Mu'jam al-Kabir 13599","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن عمران بن أنس المكي عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13636","13600  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  الْيَسَعُ بْنُ طَلْحَةَ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ  يُحَدِّثُ : عَنِ  ابْنِ عُمَرَ ، قَالَ :  صَلَّى لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا صَلَاةً فَلَمَّا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ قَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" ، فَقَالَ  رَجُلٌ  خَلْفَهُ : رَبَّنَا وَلَكَ الْحَمْدُ كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ ، فَلَمَّا انْصَرَفَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ ثَلَاثَ مَرَّاتٍ : "" مَنِ الْمُتَكَلِّمُ آنِفًا ؟ "" قَالَ الرَّجُلُ : أَنَا يَا رَسُولَ اللهِ ، فَقَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ لَقَدْ رَأَيْتُ بِضْعَةً وَثَلَاثِينَ مَلَكًا يَبْتَدِرُونَهَا أَيُّهُمْ يَكْتُبُهَا أَوَّلًا  .","","Al-Mu'jam al-Kabir 13600","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن اليسع بن طلحة بن أبزود المكي عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13637","[12/439]      13601  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  ثَنَا  خَالِدٌ ،  عَنْ  حُسَيْنِ بْنِ قَيْسٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ كَأَنَّ فِي سَاعِدَيْهِ سِوَارَيْنِ مِنْ ذَهَبٍ فَنَفَخَهُمَا فَطَارَا ، فَقَالَ :  هُمَا كَذَّابَا أُمَّتِي صَاحِبُ  الْيَمَنِ  وَصَاحِبُ  الْيَمَامَةِ  ، وَلَيْسَا بِضَارَّيْ أُمَّتِي شَيْئًا  .","","Al-Mu'jam al-Kabir 13601","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن خالد بن عبد الله الطحان عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13638","13602  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى الصَّنْعَانِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَنَشٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  هَجَّرْتُ الرَّوَاحَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَجَاءَ  أَبُو الْحَسَنِ  فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ادْنُ مِنِّي يَا  أَبَا الْحَسَنِ  "" فَلَمْ يَزَلْ يُدْنِيهِ حَتَّى الْتَقَمَ أُذُنَهُ فَأَتَى نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِيَسَارِهِ حَتَّى رَفَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ كَالْفَزِعِ فَقَالَ : "" قَرَعَ الْخَبِيثُ بِسَمْعِهِ الْبَابَ "" فَقَالَ : انْطَلِقْ يَا  أَبَا الْحَسَنِ  فَقُدْهُ كَمَا تُقَادُ الشَّاةُ إِلَى حَالِبِهَا ، فَإِذَا أَنَا  بِعَلِيٍّ  قَدْ جَاءَ  بِالْحَكَمِ  آخِذًا بِأُذُنِهِ وَلَهَازِمِهِ جَمِيعًا حَتَّى وَقَفَهُ بَيْنَ يَدَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَعَنَهُ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثًا ، ثُمَّ قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  : "" اجْلِسْ نَاحِيَةً "" حَتَّى رَاحَ إِلَى نَبِيِّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَاسٌ مِنَ  الْمُهَاجِرِينَ  وَالْأَنْصَارِ ،  ثُمَّ دَعَا بِهِ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : "" هَا إِنَّ هَذَا سَيُخَالِفُ كِتَابَ اللهِ وَسُنَّةَ نَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَيَخْرُجُ مِنْ صُلْبِهِ فِتَنٌ يَبْلُغُ  دُخَانُهَا  السَّمَاءَ ""         [12/440]      فَقَالَ  رَجُلٌ  مِنَ الْمُسْلِمِينَ : صَدَقَ اللهُ وَرَسُولُهُ هُوَ أَقَلُّ وَأَذَلُّ مِنْ أَنْ يَكُونَ مِنْهُ ذَلِكَ ، قَالَ : "" بَلَى ، وَبَعْضُكُمْ يَوْمَئِذٍ شِيعَتُهُ  .","","Al-Mu'jam al-Kabir 13602","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13639","13603  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَنَشٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ وَلِيَ شَيْئًا مِنْ أَمْرِ الْمُسْلِمِينَ لَمْ يَنْظُرِ اللهُ فِي حَاجَتِهِ  حَتَّى يَنْظُرَ فِي حَوَائِجِهِمْ  .","","Al-Mu'jam al-Kabir 13603","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13640","13604  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى ،  ثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَنَشٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ قَائِلٌ بِكَفِّهِ هَكَذَا كَأَنَّهُ يُشَبِّرُ شَيْئًا :  مَنْ  فَارَقَ  جَمَاعَةَ الْمُسْلِمِينَ شِبْرًا أَخْرَجَ مِنْ عُنُقِهِ  رِبْقَةَ  الْإِسْلَامِ ، وَالْمُخَالِفِينَ بَأَلْوِيَتِهِمْ يَتَنَاوَلُونَهَا يَوْمَ الْقِيَامَةِ مِنْ وَرَاءِ ظُهُورِهِمْ ، وَمَنْ مَاتَ مِنْ غَيْرِ إِمَامِ جَمَاعَةٍ مَاتَ  مِيتَةً  جَاهِلِيَّةً  .","","Al-Mu'jam al-Kabir 13604","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن عبد الأعلى القيسي عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13641","13605  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ الْحَلَبِيُّ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ : سَمِعْتُ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا  تَسُبُّوا  أَمْوَاتَكُمْ ، فَإِنَّهُ لَا يَحِلُّ سَبُّهُمْ  .","","Al-Mu'jam al-Kabir 13605","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13642","13606  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ         [12/441]      الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءً ، يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : وَعَادَ  أَبَا سَلَمَةَ  وَهُوَ وَجِعٌ ، فَسَمِعَ قَوْلَ  أُمِّ سَلَمَةَ  وَهِيَ تَبْكِي ، فَنَكَلَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الدُّخُولِ حِينَ سَمِعَهَا تَبْكِيهِ بِكِتَابِ اللهِ تَقُولُ :         {      وَجَاءَتْ سَكْرَةُ الْمَوْتِ بِالْحَقِّ ذَلِكَ مَا كُنْتَ مِنْهُ تَحِيدُ         }      فَدَخَلَ ، ثُمَّ سَلَّمَ ، ثُمَّ قَالَ : "" أَخْلَفَ اللهُ عَلَيْكِ يَا  أُمَّ سَلَمَةَ  "" ، فَلَمَّا خَرَجَ وَمَعَهُ  أَبُو بَكْرٍ  قَالَ لَهُ : رَأَيْتُكَ يَا رَسُولَ اللهِ كَرِهْتَ الدُّخُولَ ، لِأَنَّهُمْ يَنُوحُونَ ، قَالَ :  لَسْتُ أَدْخُلُ دَارًا فِيهَا نَوْحٌ وَلَا كَلْبٌ أَسْوَدُ  .","","Al-Mu'jam al-Kabir 13606","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13643","13607  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَتَى  صَاحِبَ بَزٍّ  فَاشْتَرَى مِنْهُ قَمِيصًا بِأَرْبَعَةِ دَرَاهِمَ فَخَرَجَ وَهُوَ عَلَيْهِ فَإِذَا  رَجُلٌ مِنَ الْأَنْصَارِ  ، فَقَالَ : يَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اكْسُنِي قَمِيصًا كَسَاكَ اللهُ مِنْ ثِيَابِ الْجَنَّةِ ، فَنَزَعَ الْقَمِيصَ فَكَسَاهُ إِيَّاهُ ، ثُمَّ رَجَعَ إِلَى صَاحِبِ الْحَانُوتِ فَاشْتَرَى مِنْهُ قَمِيصًا بِأَرْبَعَةِ دَرَاهِمَ ، وَبَقِيَ مَعَهُ دِرْهَمَانِ ، فَإِذَا هُوَ  بِجَارِيَةٍ  فِي الطَّرِيقِ تَبْكِي ، فَقَالَ : "" مَا يُبْكِيكِ ؟ "" ، فَقَالَتْ : يَا رَسُولَ اللهِ دَفَعَ إِلَيَّ أَهْلِي دِرْهَمَيْنِ أَشْتَرِي بِهِمَا دَقِيقًا فَهَلَكَا ، فَدَفَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَيْهَا الدِّرْهَمَيْنِ الْبَاقِيَيْنِ ، ثُمَّ وَلَّتْ وَهِيَ تَبْكِي ، فَدَعَاهَا ، فَقَالَ : "" مَا يُبْكِيكِ وَقَدْ أَخَذْتِ الدِّرْهَمَيْنِ ؟ "" قَالَتْ : أَخَافُ أَنْ يَضْرِبُونِي فَمَشَى مَعَهَا إِلَى أَهْلِهَا فَسَلَّمَ فَعَرَفُوا صَوْتَهُ ، ثُمَّ عَادَ فَسَلَّمَ ، ثُمَّ عَادَ فَسَلَّمَ ، ثُمَّ عَادَ فَثَلَّثَ فَرَدُّوا ، فَقَالَ : "" أَسَمِعْتُمْ أَوَّلَ السَّلَامِ ؟ "" قَالُوا : نَعَمْ ، لَكِنْ أَحْبَبْنَا أَنْ         [12/442]      تَزِيدَنَا مِنَ السَّلَامِ ، فَمَا أَشْخَصَكَ بِأَبِينَا وَأُمِّنَا ؟ قَالَ : "" أَشْفَقَتْ هَذِهِ الْجَارِيَةُ أَنْ تَضْرِبُوهَا "" ، قَالَ صَاحِبُهَا : فَهِيَ حُرَّةٌ لِوَجْهِ اللهِ لِمَمْشَاكَ مَعَهَا فَبَشَّرَهُمْ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْخَيْرِ وَالْجَنَّةِ ، ثُمَّ قَالَ :  لَقَدْ بَارَكَ اللهُ فِي الْعَشَرَةِ كَسَا اللهُ نَبِيَّهُ قَمِيصًا ، وَرَجُلًا مِنَ الْأَنْصَارِ قَمِيصًا  ، وَأَعْتَقَ اللهُ مِنْهَا رَقَبَةً وَأَحْمَدُ اللهَ هُوَ الَّذِي رَزَقَنَا هَذَا بِقُدْرَتِهِ  .","","Al-Mu'jam al-Kabir 13607","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13644","13608  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ يَذْهَبُ بِكِتَابِي هَذَا إِلَى  طَاغِيَةِ الرُّومِ  ؟  فَعَرَضَ ذَلِكَ عَلَيْهِمْ ثَلَاثَ مَرَّاتٍ ، فَقَالَ عِنْدَ ذَلِكَ : "" مَنْ يَذْهَبُ وَلَهُ الْجَنَّةُ ؟ "" ، فَقَالَ رَجُلٌ مِنَ  الْأَنْصَارِ  يُدْعَى  عُبَيْدَ اللهِ بْنَ عَبْدِ الْخَالِقِ  أَنَا أَذْهَبُ بِهِ وَلِيَ الْجَنَّةُ إِنْ هَلَكْتُ دُونَ ذَلِكَ ؟ قَالَ : "" نَعَمْ ، لَكَ الْجَنَّةُ إِنْ بَلَغْتَ وَإِنْ قُتِلْتَ ، وَإِنْ هَلَكْتَ فَقَدْ أَوْجَبَ اللهُ لَكَ الْجَنَّةَ "" ، فَانْطَلَقَ بِكِتَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى بَلَغَ الطَّاغِيَ ، فَقَالَ : أَنَا رَسُولُ رَسُولِ رَبِّ الْعَالَمِينَ فَأَذِنَ لَهُ فَدَخَلَ عَلَيْهِ فَعَرَفَ طَاغِيَةُ  الرُّومِ  أَنَّهُ قَدْ جَاءَ بِالْحَقِّ مِنْ عِنْدِ نَبِيٍّ مُرْسَلٍ ، ثُمَّ عَرَضَ عَلَيْهِ كِتَابَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَمَعَ  الرُّومَ  عِنْدَهُ ، ثُمَّ عَرَضَهُ عَلَيْهِمْ فَكَرِهُوا مَا جَاءَ بِهِ وَآمَنَ بِهِ  رَجُلٌ  مِنْهُمْ فَقُتِلَ عِنْدَ إِيمَانِهِ ، ثُمَّ إِنَّ الرَّجُلَ رَجَعَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ بِالَّذِي كَانَ مِنْهُ وَمَا كَانَ مِنْ قَتْلِ الرَّجُلِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ ذَلِكَ : "" يَبْعَثُهُ اللهُ  أُمَّةً  وَحْدَهُ "" لِذَلِكَ الرَّجُلِ الْمَقْتُولِ  .","","Al-Mu'jam al-Kabir 13608","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13645","[12/443]      13609  -  وَبِإِسْنَادِهِ  ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ عَبْدٍ مُؤْمِنٍ يَتُوبُ إِلَى اللهِ قَبْلَ الْمَوْتِ بِشَهْرٍ إِلَّا قَبِلَ اللهُ مِنْهُ وَأَدْنَى مِنْ ذَلِكَ  ، وَقَبْلَ مَوْتِهِ بِيَوْمٍ أَوْ سَاعَةٍ يَعْلَمُ اللهُ مِنْهُ التَّوْبَةَ وَالْإِخْلَاصَ إِلَّا قَبِلَ اللهُ مِنْهُ  .","","Al-Mu'jam al-Kabir 13609","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13646","13610  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ أُدْخِلَ  رَجُلٌ  فِي قَبْرِهِ ، فَأَتَاهُ مَلَكَانَ  فَقَالَا لَهُ : إِنَّا ضَارِبُوكَ ضَرْبَةً ، فَقَالَ لَهُمَا : عَلَامَ تَضْرِبَانِي ؟ فَضَرَبَاهُ ضَرْبَةً امْتَلَأَ قَبْرُهُ مِنْهَا نَارًا ، فَتَرَكَاهُ حَتَّى  أَفَاقَ  وَذَهَبَ عَنْهُ الرُّعْبُ ، فَقَالَ لَهُمَا عَلَامَ ضَرَبْتُمَانِي ؟ فَقَالَا : إِنَّكَ صَلَّيْتَ صَلَاةً وَأَنْتَ عَلَى غَيْرِ طُهُورٍ ، وَمَرَرْتَ  بِرَجُلٍ  مَظْلُومٍ وَلَمْ تَنْصُرْهُ  .","","Al-Mu'jam al-Kabir 13610","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13647","13611  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ الْجُمُعَةَ وَصَلَّى بِالنَّاسِ الْعَصْرَ  ، وَهُوَ قَاعِدٌ فِي الرَّكْعَتَيْنِ الْأُولَيَيْنِ فَمَرَّ كَلْبٌ لِيَقْطَعَ عَلَيْهِ صَلَاتَهُ فَأَشْفَقَ أَنْ يَمُرَّ عَلَيْهِ ، فَدَعَا  سَعْدُ بْنُ أَبِي وَقَّاصٍ  عَلَى الْكَلْبِ فَأَهْلَكَهُ اللهُ بِقُدْرَتِهِ ، فَلَمَّا فَرَغَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ صَلَاتِهِ وَنَظَرَ إِلَى الْكَلْبِ قَدْ هَلَكَ ، قَالَ : "" مَنِ الدَّاعِي         [12/444]      مِنْكُمْ عَلَى هَذَا الْكَلْبِ ؟ "" فَلَمْ يَتَكَلَّمْ أَحَدٌ ، فَأَعَادَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  سَعْدٌ  عِنْدَ ذَلِكَ : أَنَا الدَّاعِي عَلَيْهِ يَا رَسُولَ اللهِ بِأَبِي أَنْتَ وَأُمِّي أَشْفَقْتُ أَنْ يَقْطَعَ عَلَيْكَ صَلَاتَكَ فَدَعَوْتُ عَلَيْهِ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" كَيْفَ دَعَوْتَ عَلَيْهِ يَا  سَعْدُ  ؟ "" فَقَالَ  سَعْدٌ  سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ ، يَا ذَا  الْجَلَالِ  وَالْإِكْرَامِ أَهْلِكْ هَذَا الْكَلْبَ أَنْ يَقْطَعَ عَلَى نَبِيِّكَ صَلَاتَهُ ، فَقَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  سَعْدُ  ، لَقَدْ دَعَوْتَ فِي يَوْمٍ وَسَاعَةٍ بِكَلِمَاتٍ لَوْ دَعَوْتَ عَلَى مَنْ بَيْنَ السَّمَاوَاتِ لَاسْتُجِيبَ لَكَ فَأَبْشِرْ يَا  سَعْدُ  .","","Al-Mu'jam al-Kabir 13611","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13648","13612  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ كُلَّ جَارِيَةٍ بِهَا حَبَلٌ حَرَامٌ عَلَى صَاحِبِهَا حَتَّى تَضَعَ مَا فِي بَطْنِهَا  ، وَإِنَّ كُلَّ حِمَارٍ يُعْتَمَلُ عَلَيْهِ حَرَامٌ لَحْمُهُ ، وَإِنَّ الثُّومَ حَرَامٌ ، ثُمَّ إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَلَّ الثُّومَ وَأَمَرَ مَنْ أَكَلَهُ أَنْ لَا يَخْرُجَ إِلَى الْمَسْجِدِ حَتَّى يَذْهَبَ رِيحُهُ ، إِنَّهُ أَذًى فَلَا يَقْرَبْ مَنْ أَكَلَهُ الْمَسْجِدَ  .","","Al-Mu'jam al-Kabir 13612","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13649","13613  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا مَاتَ أَحَدُكُمْ فَلَا تَحْبِسُوهُ ، وَأَسْرِعُوا بِهِ إِلَى قَبْرِهِ  ، وَلْيُقْرَأْ عِنْدَ رَأْسِهِ بِفَاتِحَةِ الْكِتَابِ ، وَعِنْدَ رِجْلَيْهِ بِخَاتِمَةِ الْبَقَرَةِ فِي قَبْرِهِ  .","","Al-Mu'jam al-Kabir 13613","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13650","[12/445]      13614  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ ، قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ أَبِي رَبَاحٍ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا صَلَاةَ لِمَنْ دَخَلَ الْمَسْجِدَ وَالْإِمَامُ قَائِمٌ يُصَلِّي  ، فَلَا يَنْفَرِدْ وَحْدَهُ بِصَلَاتِهِ ، وَلَكِنْ يَدْخُلُ مَعَ الْإِمَامِ فِي الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 13614","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13651","13615  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعْدِ بْنِ يَحْيَى  ، ثَنَا  أَبُو فَرْوَةَ يَزِيدُ بْنُ مُحَمَّدِ بْنِ سِنَانٍ الرَّهَاوِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  النَّمِيمَةُ ، وَالشَّتِيمَةُ ، وَالْحَمِيَّةُ فِي النَّارِ  ، وَلَا يَجْتَمِعَنَّ فِي صَدْرِ مُؤْمِنٍ  .","","Al-Mu'jam al-Kabir 13615","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن عبد الله بن سعد بن يحيى الكريزي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13652","13616  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُوسَى بْنِ أَبِي عُثْمَانَ الْأَنْمَاطِيُّ  ، ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  تَؤَضَّأَ رَسُولُ اللهِ ثَلَاثًا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 13616","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أبو عمرو الأوزاعي عن مسلمة بن علي بن خلف الخشني عن الحكم بن موسى بن أبي زهير النسائي عن ابن بلعها عبد الله بن موسى الدهقان عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13653","13617  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ  ، ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِيُّ ،  ثَنَا  رَوَّادُ بْنُ الْجَرَّاحِ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ صَامَ الْأَبَدَ فَلَا صَامَ  ، وَلَا أَفْطَرَ  .","","Al-Mu'jam al-Kabir 13617","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أبو عمرو الأوزاعي عن رواد بن الجراح عن موسى بن أيوب النصيبي عن الحسين بن السميدع البجلي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13654","[12/446]      13618  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الْمَقْدِسِيُّ ،  ثَنَا  رَوَّادُ بْنُ الْجَرَّاحِ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ بِالسَّفَرِ  .","","Al-Mu'jam al-Kabir 13618","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن أبو عمرو الأوزاعي عن رواد بن الجراح عن إبراهيم بن محمد بن يوسف الفريابي عن الوليد بن حماد بن جابر الزيات عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13655","13619  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ بْنِ أَبِي مَالِكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَقْبَلَ عَلَيْنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  لَمْ يَمْنَعْ قَوْمٌ زَكَاةَ أَمْوَالِهِمْ إِلَّا مُنِعُوا الْقَطْرَ مِنَ السَّمَاءِ  ، وَلَوْلَا الْبَهَائِمُ لَمْ يُمْطَرُوا  .","","Al-Mu'jam al-Kabir 13619","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن يزيد بن عبد الرحمن بن أبي مالك عن خالد بن يزيد الهمداني عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13656","13620  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ، وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ، قَالَا :  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  الْعَبَّاسِ بْنِ عُتْبَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  طَهِّرُوا هَذِهِ الْأَجْسَادَ طَهَّرَكُمُ اللهُ ، فَإِنَّهُ لَيْسَ عَبْدٌ يَبِيتُ طَاهِرًا  إِلَّا بَاتَ مَعَهُ مَلَكٌ فِي شِعَارِهِ لَا يَنْقَلِبُ سَاعَةً مِنَ اللَّيْلِ إِلَّا قَالَ : اللَّهُمَّ اغْفِرْ لِعَبْدِكَ فَإِنَّهُ بَاتَ طَاهِرًا  .","","Al-Mu'jam al-Kabir 13620","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن العباس بن عتبة عن إسماعيل بن عياش الأحول عن عاصم بن علي الواسطي عن لحية الليف محمد بن العباس عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13657","13621  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ  ، ثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنِ  الْحَسَنِ بْنِ ذَكْوَانَ ،  عَنْ  سُلَيْمَانَ بْنِ الرَّبِيعِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طَهِّرُوا هَذِهِ الْأَجْسَادَ طَهَّرَكُمُ         [12/447]      اللهُ . مَا مِنْ عَبْدٍ بَاتَ طَاهِرًا إِلَّا بَاتَ فِي شِعَارِهِ  مَلَكٌ كُلَّمَا تَقَلَّبَ مِنَ اللَّيْلِ سَاعَةً قَالَ الْمَلَكُ : اللَّهُمَّ اغْفِرْ لِعَبْدِكَ كَمَا بَاتَ طَاهِرًا  .","","Al-Mu'jam al-Kabir 13621","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سليمان بن الربيع العدوي عن الحسن بن ذكوان البصري عن ميمون بن زيد الحارثي عن وهب بن يحيى بن زمام العلاف عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13658","13622  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْجَعْدِ الْوَشَّاءُ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَلُّوا عَلَى مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ  ، وَصَلُّوا وَرَاءَ مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ  .","","Al-Mu'jam al-Kabir 13622","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن سالم بن عجلان الأفطس عن محمد بن الفضل بن عطية العبسي عن محمد بن بكار الرصافي عن أحمد بن محمد بن عبد العزيز الوشاء عن الطبراني","عطاء بن أبي رباح عن ابن عمر"
"13659","[  عَمْرُو بْنُ دِينَارٍ  ، عَنِ  ابْنِ عُمَرَ  ]  13623  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  مَرْزُوقٍ مَوْلَى آلِ طَلْحَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَنْ تَجْتَمِعَ أُمَّتِي عَلَى الضَّلَالَةِ أَبَدًا  ، فَعَلَيْكُمْ بِالْجَمَاعَةِ فَإِنَّ  يَدَ  اللهِ عَلَى الْجَمَاعَةِ  .","","Al-Mu'jam al-Kabir 13623","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن مرزوق مولى طلحة بن عبد الرحمن الباهلي عن معتمر بن سليمان عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13660","13624  -  حَدَّثَنَا  سَهْلُ بْنُ أَبِي سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  ثَنَا  سُلَيْمَانُ بْنُ سُفْيَانَ الْمَدَنِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 13624","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سليمان بن سفيان التيمي عن معتمر بن سليمان عن يحيى بن حبيب الحارثي عن سهل بن أبى سهل الواسطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13661","[12/448]      13625  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  شَيْبَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو الرَّبِيعِ السَّمَّانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ  الْوَلَاءِ  ، وَعَنْ هِبَتِهِ  .","","Al-Mu'jam al-Kabir 13625","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن أشعث السمان عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13662","13626  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  أَحْمَدُ بْنُ أَوْفَى ، قَاضِي نَهَرِ تِيرِي ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ، وَعَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ  الْوَلَاءِ  وَهِبَتِهِ  .","","Al-Mu'jam al-Kabir 13626","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن شعبة بن الحجاج عن أحمد بن أوفى الأهوازي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13663","13627  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ  ، ثَنَا  أَبُو صَالِحٍ الْفَرَّاءُ ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي حَيْثُ تَوَجَّهَتْ بِهِ رَاحِلَتُهُ  .","","Al-Mu'jam al-Kabir 13627","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان الثوري عن أبو إسحاق الفزاري عن محبوب بن موسى الفراء عن هاشم بن مرثد الطيالسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13664","13628  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُخْتَارِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي عَلَى الرَّاحِلَةِ  .","","Al-Mu'jam al-Kabir 13628","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن حبويه ، إبراهيم بن المختار عن محمد بن حميد الرازي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13665","13629  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ بُهْلُولٍ الْأَنْبَارِيُّ ،  ثَنَا  عَلِيُّ بْنُ عُبَيْدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،         [12/449]      عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ  بَيِّعَيْنِ  لَا بَيْعَ بَيْنَهُمَا حَتَّى  يَتَفَرَّقَا  إِلَّا بَيْعَ  الْخِيَارِ  .","","Al-Mu'jam al-Kabir 13629","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان الثوري عن علي بن عبيد الله الساعدي عن إسحاق بن بهلول الأنباري عن الحسن بن علي بن شبيب المعمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13666","13630  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَافَ  بِالْبَيْتِ  سَبْعًا  ، وَصَلَّى خَلْفَ  الْمَقَامِ  رَكْعَتَيْنِ ، وَطَافَ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  سَبْعًا ، وَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُسْوَةٌ حَسَنَةٌ  .","","Al-Mu'jam al-Kabir 13630","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13667","13631  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 13631","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13668","13632  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الصَّمَدِ بْنِ أَبِي خِدَاشٍ الْمَوْصِلِيُّ ،  ثَنَا  زَيْدُ بْنُ أَبِي الزَّرْقَاءِ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَافَ  بِالْبَيْتِ  ، وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُسْوَةٌ حَسَنَةٌ  .","","Al-Mu'jam al-Kabir 13632","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان الثوري عن زيد بن أبي الزرقاء التغلبي عن عبد الله بن عبد الصمد عن الحسن بن علي بن شبيب المعمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13669","13633  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَافَ  بِالْبَيْتِ  سَبْعًا  ، وَصَلَّى خَلْفَ  الْمَقَامِ  رَكْعَتَيْنِ ، وَسَعَى بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  "" ، ثُمَّ قَالَ :         {      لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ         }      .","","Al-Mu'jam al-Kabir 13633","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13670","[12/450]      13634  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْقَلَانِسِيُّ  ، ثَنَا  آدَمُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَمْرُو بْنُ الْعَبَّاسِ الرُّزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  لَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  طَافَ  بِالْبَيْتِ  سَبْعًا  ، وَصَلَّى خَلْفَ  الْمَقَامِ  رَكْعَتَيْنِ ، ثُمَّ خَرَجَ إِلَى  الصَّفَا  مِنَ الْبَابِ الَّذِي يَخْرُجُ إِلَيْهِ فَطَافَ  بِالصَّفَا  وَالْمَرْوَةِ  "" زَادَ  غُنْدَرٌ  فِي حَدِيثِهِ ، قَالَ  شُعْبَةُ  :  فَأَخْبَرَنِي  أَيُّوبُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ سُنَّةٌ  .","","Al-Mu'jam al-Kabir 13634","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن غندر ربيب شعبة عن عمرو بن العباس الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13671","13635  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ  ، ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ الْمُؤَذِّنُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ :  أَمَّا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَدِمَ ، فَطَافَ  بِالْبَيْتِ  ، ثُمَّ رَكَعَ رَكْعَتَيْنِ  ، ثُمَّ طَافَ بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  .","","Al-Mu'jam al-Kabir 13635","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن ابن جريج عن عثمان بن الهيثم بن جهم الأشج عن إبراهيم بن صالح الشيرازي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13672","13636  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو الشَّعْثَاءِ ،  أَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  فَذَكَرَ مِثْلَ حَدِيثِ  ابْنِ جُرَيْجٍ  .","","Al-Mu'jam al-Kabir 13636","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حجاج بن أرطاة عن حفص بن غياث النخعي عن علي بن الحسن بن سليمان الحضرمي عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13673","13637  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُقِيمَنَّ أَحَدُكُمْ أَخَاهُ مِنْ مَجْلِسِهِ لِيَجْلِسَ فِي مَكَانِهِ  .","","Al-Mu'jam al-Kabir 13637","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن إبراهيم بن إسماعيل بن مجمع عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13674","[12/451]      13638  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ ، وَيَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيَّانِ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  نَافِعُ بْنُ عُمَرَ الْجُمَحِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَذْهَبُ لِحَاجَتِهِ  إِلَى  الْمُغَمَّسِ  . قَالَ  نَافِعٌ  :  نَحْوَ مِيلَيْنِ مِنْ  مَكَّةَ  .","","Al-Mu'jam al-Kabir 13638","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن نافع بن عمر بن عبد الله بن جميل الجمحي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","عمرو بن دينار عن ابن عمر"
"13675","13639  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْكِلَابِ إِلَّا كَلْبَ مَاشِيَةٍ أَوْ صَيْدٍ  .","","Al-Mu'jam al-Kabir 13639","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13676","13640  -  حَدَّثَنَا  أَبُو حَبِيبٍ يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ لَهُ عَبْدٌ بَيْنَهُ وَبَيْنَ آخَرَ فَأَعْتَقَ نَصِيبَهُ  ، فَإِنَّهُ يُقَامُ عَلَيْهِ  فَيُعْتِقُهُ  .","","Al-Mu'jam al-Kabir 13640","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن داود ابن النصراني عن سعيد بن الحكم الجمحي عن يحيى بن نافع بن خالد المصري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13677","13641  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ صَاحِبُ الْمَغَازِي ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ         [12/452]      بْنِ رُفَيْعٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَارِبَ الْخَمْرِ  ، وَسَاقِيَهَا  .","","Al-Mu'jam al-Kabir 13641","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن عبد العزيز بن رفيع الطائفي عن أبو بكر بن عياش عن أحمد بن محمد بن أيوب عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13678","13642  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ ،  ثَنَا  شِبْلُ بْنُ عَبَّادٍ ، قَالَ :  سَمِعْتُ  عَمْرَو بْنَ دِينَارٍ  يُحَدِّثُ عَنْ  جَابِرٍ ، وَابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ  الثَّمَرِ  حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 13642","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن شبل بن عباد المكي عن عبد الله بن الحارث بن عبد الملك المخزومي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13679","13643  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نَصْرٍ الصَّائِغُ الْبَغْدَادِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  عَاصِمِ بْنِ عَمْرٍو  ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  وَبِهَا ثَلَاثُمِائَةٍ وَثَمَانُونَ صَنَمًا  ، وَفِي يَدِهِ عَصًا ، فَجَعَلَ يُشِيرُ إِلَيْهَا ، وَيَقُولُ :         {      جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ إِنَّ الْبَاطِلَ كَانَ زَهُوقًا         }      ، فَتَسَاقَطَ الْأَصْنَامُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب (عاصم بن عمر) كما في المعجم الأوسط وغيره .","","Al-Mu'jam al-Kabir 13643","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن عاصم بن عمر الظفري عن عبد الله بن نافع الصائغ عن محمد بن إسحاق المسيبي عن محمد بن نصر بن منصور الصائغ عن الطبراني","عمرو بن دينار عن ابن عمر"
"13680","13644  -  حَدَّثَنَا  بَكْرُ بْنُ مُقْبِلٍ الْبَصْرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ إِسْحَاقَ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  زَكَرِيَّا بْنِ إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الدُّبَّاءِ  ،  وَالْمُزَفَّتِ  .","","Al-Mu'jam al-Kabir 13644","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن زكريا بن إسحاق المكي عن أبو عاصم النبيل عن عبد الله بن إسحاق الجوهري عن بكر بن أحمد بن مقبل الهاشمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13681","13645  -  حَدَّثَنَا  عَلِيُّ بْنُ بَيَانٍ الْمُطَرِّزُ الْبَغْدَادِيُّ  ، ثَنَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  ثَنَا  الْمُنْذِرُ بْنُ زِيَادٍ الطَّائِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  فَرَضَ  عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَدَقَةَ رَمَضَانَ صَاعًا مِنْ شَعِيرٍ  ، أَوْ صَاعًا مِنْ تَمْرٍ  .","","Al-Mu'jam al-Kabir 13645","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن منذر بن زياد الطائي عن حفص بن عمرو الربالي عن على بن محمد بن خالد بن بيان المطرز عن الطبراني","عمرو بن دينار عن ابن عمر"
"13682","[12/453]      13646  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ الشَّافِعِيُّ الْحِمْصِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ هَاشِمٍ السِّمْسَارُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ قَيْسٍ الضَّبِّيُّ ،  ثَنَا  سُكَيْنُ بْنُ أَبِي سِرَاجٍ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَيُّ النَّاسِ أَحَبُّ إِلَى اللهِ ؟ وَأَيُّ الْأَعْمَالِ أَحَبُّ إِلَى اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَبُّ النَّاسِ إِلَى اللهِ تَعَالَى أَنْفَعُهُمْ لِلنَّاسِ  ، وَأَحَبُّ الْأَعْمَالِ إِلَى اللهِ تَعَالَى سُرُورٌ يُدْخِلُهُ عَلَى مُسْلِمٍ ، أَوْ يَكْشِفُ عَنْهُ كُرْبَةً ، أَوْ تَقْضِي عَنْهُ دَيْنًا ، أَوْ تَطْرُدُ عَنْهُ جُوعًا ، وَلَأَنْ أَمْشِيَ مَعَ أَخٍ فِي حَاجَةٍ أَحَبُّ إِلَيَّ مِنْ أَنْ أَعْتَكِفَ فِي هَذَا الْمَسْجِدِ -  يَعْنِي  مَسْجِدَ الْمَدِينَةِ  - شَهْرًا ، وَمَنْ كَفَّ غَضَبَهُ سَتَرَ اللهُ  عَوْرَتَهُ  ، وَمَنْ  كَظَمَ  غَيْظَهُ ، وَلَوْ شَاءَ أَنْ يُمْضِيَهُ أَمْضَاهُ مَلَأَ اللهُ قَلْبَهُ رَجَاءً يَوْمَ الْقِيَامَةِ ، وَمَنْ مَشَى مَعَ أَخِيهِ فِي حَاجَةٍ حَتَّى يَتَهَيَّأَ لَهُ أَثْبَتَ اللهُ قَدَمَهُ يَوْمَ تَزُولُ الْأَقْدَامِ  .","","Al-Mu'jam al-Kabir 13646","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سكين بن أبي سراج عن عبد الرحمن بن قيس الزعفراني عن القاسم بن هاشم السمسار عن محمد بن عبد الرحيم الشافعي الحمصي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13683","13647  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِشْكَابَ ،  ثَنَا         [12/454]      مَنْصُورُ بْنُ صُقَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ ثَابِتٍ الْعَبْدِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَعَلَ حَرِيمَ النَّخْلَةِ مَدَّ جَرِيدِهَا  .","","Al-Mu'jam al-Kabir 13647","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن محمد بن ثابت العبدي عن منصور بن صقير البغدادي عن محمد بن الحسين بن إبراهيم العامري عن عبيد العجل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13684","13648  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْجَهْمِ السِّمَّرِيُّ  ، ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ،  ثَنَا  عَوْفُ بْنُ مُحَمَّدٍ أَبُو غَسَّانَ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ طَافَ بَعْدَ صَلَاةِ الصُّبْحِ ، ثُمَّ صَلَّى رَكْعَتَيْنِ  ، ثُمَّ قَالَ : إِنَّمَا يُكْرَهُ عِنْدَ طُلُوعِ الشَّمْسِ  ، لِأَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الشَّمْسَ تَطْلُعُ بَيْنَ  قَرْنَيْ  شَيْطَانٍ  .","","Al-Mu'jam al-Kabir 13648","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن عوف بن محمد المرادي البصري عن عبدة بن عبد الله بن عبدة الخزاعي عن أحمد بن محمد بن الجهم السمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13685","13649  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، وَالْحَسَنُ بْنُ عَبْدِ اللهِ الْكِنْدِيُّ الْبَصْرِيُّ ، قَالُوا :  ثَنَا  زِيَادُ بْنُ يَحْيَى الْحَسَّانِيُّ ،  ثَنَا  صَالِحُ بْنُ زِيَادٍ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ، قَالَ :  رَأَيْتُ  ابْنَ عُمَرَ يُصَفِّرُ لِحْيَتَهُ  ، قُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَا لِي أَرَاكَ لَا تَمَسُّ مِنَ الْأَرْكَانِ إِلَّا  الرُّكْنَ الْيَمَانِيَ  ،  وَالْحَجَرَ الْأَسْوَدَ  ؟ قَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَمْسَحُ غَيْرَهُمَا ، قُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَا لِي أَرَاكَ لَا تَلْبَسُ غَيْرَ النِّعَالِ  السِّبْتِيَّةِ  ؟ قَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَلْبَسُ غَيْرَهَا ، قُلْتُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَا لِي أَرَاكَ لَا تُلَبِّي حَتَّى تَسْتَوِيَ بِكَ رَاحِلَتُكَ ؟ قَالَ : "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 13649","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن صالح بن زياد البصري عن زياد بن يحيى الحساني عن البزار عن الطبراني","عمرو بن دينار عن ابن عمر"
"13686","[12/455]      13650  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ، وَأَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ الْعِجْلِيُّ ،  ثَنَا  حَمَّادُ بْنُ وَاقِدٍ الصَّفَّارُ ،  ثَنَا  مُحَمَّدُ بْنُ ذَكْوَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  إِنَّا لَقُعُودٌ بِفِنَاءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِذْ مَرَّتِ  امْرَأَةٌ  ، فَقَالَ بَعْضُ  الْقَوْمِ  : هَذِهِ ابْنَةُ  مُحَمَّدٍ  ، فَقَالَ  رَجُلٌ  : إِنَّ مَثَلَ  مُحَمَّدٍ  فِي  بَنِي هَاشِمٍ  مَثَلُ الرَّيْحَانَةِ فِي وَسَطِ النَّتْنِ ، فَانْطَلَقَتِ الْمَرْأَةُ فَأَخْبَرَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعْرَفُ فِي وَجْهِهِ الْغَضَبُ حَتَّى قَامَ عَلَى  الْقَوْمِ  ، فَقَالَ :  مَا بَالُ أَقْوَالٍ تَبْلُغُنِي عَنْ أَقْوَامٍ ، إِنَّ اللهَ عَزَّ وَجَلَّ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ سَبْعًا  ، فَاخْتَارَ الْعُلْيَا مِنْهَا فَسَكَنَهَا ، وَأَسْكَنَ سَمَاوَاتِهِ مَنْ شَاءَ مِنْ خَلْقِهِ ، وَخَلَقَ الْأَرْضَ سَبْعًا ، فَاخْتَارَ الْعُلْيَا مِنْهَا فَأَسْكَنَهَا مَنْ شَاءَ مِنْ خَلْقِهِ ، وَخَلَقَ الْخَلْقَ فَاخْتَارَ مِنَ الْخَلْقِ  بَنِي آدَمَ  ، وَاخْتَارَ مِنْ  بَنِي آدَمَ  الْعَرَبَ ، وَاخْتَارَ مِنَ الْعَرَبِ  مُضَرَ  ، وَاخْتَارَ مِنْ  مُضَرَ  قُرَيْشًا  ، وَاخْتَارَ مِنْ  قُرَيْشٍ  بَنِي هَاشِمٍ  ، وَاخْتَارَنِي مِنْ  بَنِي هَاشِمٍ  ، فَأَنَا خِيَارٌ         [12/456]      إِلَى خِيَارٍ ، فَمَنْ أَحَبَّ الْعَرَبَ فَبِحُبِّي أَحَبَّهُمْ ، وَمَنْ أَبْغَضَ الْعَرَبَ فَبِبُغْضِي أَبْغَضَهُمْ  .","","Al-Mu'jam al-Kabir 13650","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن محمد بن ذكوان الطاحي عن حماد بن واقد العيشي عن أحمد بن المقدام العجلي عن محمد بن حنيفة القصبى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13687","13651  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  وَرْقَاءُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَابِعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ، فَإِنَّهُمَا تَمْحُوانِ الْخَطَايَا كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ  .","","Al-Mu'jam al-Kabir 13651","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن حجاج بن نصير الفساطيطي عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13688","13652  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  ابْنَ عُمَرَ سُئِلَ عَنْ رَجُلٍ قَالَ لِرَجُلٍ : بِعْنِي  ثَمَرَةَ  أَرْضِكَ بِمَا كُنْتَ تَكِيلُ مِنْهَا ، قَالَ  ابْنُ عُمَرَ  :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ هَذَا ، وَهِيَ  الْمُزَابَنَةُ  .","","Al-Mu'jam al-Kabir 13652","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن سلمة عن عبد الواحد بن غياث عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13689","13653  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي قَبْلَ الظُّهْرِ رَكْعَتَيْنِ  ، وَبَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ ، وَبَعْدَ الْمَغْرِبِ رَكْعَتَيْنِ ، وَبَعْدَ الْعِشَاءِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 13653","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13690","[12/457]      13654  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  سَعِيدُ بْنُ يَحْيَى اللَّخْمِيُّ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا نَزَلَ  الْحِجْرَ  قَالَ :  لَا تَدْخُلُوا عَلَى هَؤُلَاءِ الْمُعَذَّبِينَ  ، ثُمَّ أَمَرَ بِالْعَجِينِ فَرُمِيَ  .  انْتَهَى الْجُزْءُ الثَّانِيَ عَشَرَ ، وَيَلِيهِ الْجُزْءُ الثَّالِثَ عَشَرَ ، وَأَوَّلُهُ  13655 - حَدَّثَنَا عَبْدَانُ بْنُ أَحْمَدَ ثَنَا أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ثَنَا الْوَلِيدُ بْنُ الْوَلِيدِ ثَنَا ابْنُ ثَوْبَانَ .","","Al-Mu'jam al-Kabir 13654","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن سعيد بن يحيى سعدان عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13691","[13/37]      13655  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ،  ثَنَا  الْوَلِيدُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  ابْنُ ثَوْبَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْجَنَّةَ  لَتُزَخْرَفُ  لِرَمَضَانَ مِنْ رَأْسِ الْحَوْلِ إِلَى الْحَوْلِ الْمُقْبِلِ  ، فَإِذَا كَانَ أَوَّلُ لَيْلَةٍ مِنْ رَمَضَانَ هَبَّتْ رِيحٌ مِنْ تَحْتِ الْعَرْشِ فَنَسَفَتْ وَرَقَ الْجَنَّةِ ، وَتَجِيءُ  الْحُورُ  الْعِينُ  يَقُلْنَ : يَا رَبِّ ، اجْعَلْ لَنَا مِنْ عِبَادِكَ أَزْوَاجًا تَقَرُّ بِهِمْ أَعْيُنُنَا وَتَقَرُّ أَعْيُنُهُمْ بِنَا  .","","Al-Mu'jam al-Kabir 13655","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن عبد الرحمن بن ثابت العنسي عن الوليد بن الوليد بن زيد القلانسي عن أيوب بن محمد الوزان عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13692","[13/38]      13656  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  حَدَّثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ،  ثَنَا  يَحْيَى بْنُ زِيَادٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيِّدُ الْأَيَّامِ عِنْدَ اللهِ يَوْمُ الْجُمُعَةِ  ، فِيهِ خُلِقَ  آدَمُ  أَبُوكُمْ ، وَفِيهِ دَخَلَ الْجَنَّةَ ، وَفِيهِ خَرَجَ ، وَفِيهِ تَقُومُ السَّاعَةُ  .","","Al-Mu'jam al-Kabir 13656","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن يحيى بن زياد بن أبي داود الحراني عن أيوب بن محمد الوزان عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13693","13657  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ،  ثَنَا  مَعْمَرُ بْنُ سُلَيْمَانَ ،  ثَنَا  زَيْدُ بْنُ حَبَّانَ ،  عَنِ  الْخُوزِيِّ - يَعْنِي إِبْرَاهِيمَ بْنَ يَزِيدَ - ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى ابْنِ عُمَرَ ; فَقَالَ :  إِنَّ  ابْنَ الزُّبَيْرِ  يَزْعُمُ أَنَّهُ لَا تُحَرِّمُ مِنَ الرَّضَاعَةِ الْمَصَّةُ وَالْمَصَّتَانِ  ؟ فَقَالَ  ابْنُ عُمَرَ  : قَضَاءُ اللهِ عَزَّ وَجَلَّ وَرَسُولِهِ خَيْرٌ مِنْ قَضَاءِ  ابْنِ الزُّبَيْرِ  ،  قَلِيلُ الرَّضَاعِ وَكَثِيرُهُ سَوَاءٌ  .","","Al-Mu'jam al-Kabir 13657","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن زيد بن حبان الرقي عن معمر بن سليمان النخعي عن أيوب بن محمد الوزان عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13694","[13/39]      13658  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  مَا وَضَعْتُ لَبِنَةً عَلَى لَبِنَةٍ وَلَا غَرَسْتُ مُنْذُ تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13658","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إسماعيل بن إبراهيم المقعد عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13695","13659  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :         [13/40]      سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا يَلْبَسُ الْمُحْرِمُ مِنَ الثِّيَابِ ؟ قَالَ :  لَا يَلْبَسُ ثَوْبًا مَسَّهُ وَرْسٌ وَلَا زَعْفَرَانٌ  .","","Al-Mu'jam al-Kabir 13659","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13696","13660  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  أَبُو الْوَلِيدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَانَ مُتَحَرِّيًا لَيْلَةَ الْقَدْرِ  ،  فَلْيَتَحَرَّهَا  فِي  سَبْعٍ يَبْقَيْنَ أَوْ سَبْعٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 13660","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13697","[13/41]      13661  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  خَلَفُ بْنُ شَاذَانَ بْنِ عُثْمَانَ بْنِ جَبَلَةَ بْنِ أَبِي رَوَّادٍ ،  ثَنَا  أَبِي ،  عَنْ  جَدِّي  ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَانَ  يَتَحَرَّى  لَيْلَةَ الْقَدْرِ فَلَيْلَةُ سَبْعٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 13661","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن عثمان بن جبلة عن عبد العزيز بن عثمان بن جبلة شاذان عن خلف بن شاذان بن عثمان بن جبلة بن أبي رواد عن محمد بن علي بن محمد المروزي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13698","13662  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكَرَّمٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عُبَيْدِ اللهِ الْغَيْلَانِيُّ ،  ثَنَا  أَبُو قُتَيْبَةَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  بِلَالًا  يُؤَذِّنُ بِلَيْلٍ ،  فَكُلُوا وَاشْرَبُوا حَتَّى يُؤَذِّنَ  ابْنُ أُمِّ مَكْتُومٍ  .","","Al-Mu'jam al-Kabir 13662","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن سلم بن قتيبة الشعيري عن سليمان بن عبيد الله الغيلاني عن محمد بن الحسين بن مكرم البارع عن الطبراني","عمرو بن دينار عن ابن عمر"
"13699","[13/42]      13663  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْأَصْبَهَانِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنِ الضَّبِّ ؟ فَقَالَ :  لَا آكُلُهُ وَلَا أُحَرِّمُهُ  .","","Al-Mu'jam al-Kabir 13663","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن محمد بن بكر بن عثمان البرساني عن محمد بن محمد بن مرزوق الباهلي عن محمد بن العباس ابن الأخرم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13700","[13/43]      13664  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  حَدَّثَنِي  أَحْمَدُ بْنُ أَوْفَى قَاضِي نَهَرِتِيرَى ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ وَعَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنَّا إِذَا بَايَعْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى السَّمْعِ وَالطَّاعَةِ  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُلَقِّنُنَا : "" فِيمَا اسْتَطَعْتُمْ  .","","Al-Mu'jam al-Kabir 13664","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن شعبة بن الحجاج عن أحمد بن أوفى الأهوازي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13701","13665  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  قِيلَ  لِابْنِ         [13/44]      عُمَرَ  : إِنَّ  أَبَا نَهِيكٍ  يُكْثِرُ الْأَكْلَ .  فَقَالَ ابْنُ عُمَرَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ ، وَإِنَّ الْمُؤْمِنَ يَأْكُلُ فِي مِعَاءٍ وَاحِدٍ  .  قَالَ  أَبُو نَهِيكٍ  : أَمَّا أَنَا فَأُومِنُ بِاللهِ وَرَسُولِهِ  .","","Al-Mu'jam al-Kabir 13665","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13702","13666  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ عَلَى بَكْرٍ صَعْبٍ  لِعُمَرَ بْنِ الْخَطَّابِ  ، وَكَانَ الْبَكْرُ تَغْلِبُنِي فَتَتَقَدَّمُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَيَنْهَانِي  عُمَرُ  وَيَصِيحُ بِي ، فَلَمَّا رَأَى         [13/45]      النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا أَلْقَى مِنَ الْبَكْرِ وَمَا أَلْقَى مِنْ  عُمَرَ  ، قَالَ  لِعُمَرَ  : "" أَتَبِيعُ الْبَكْرَ ؟ "" قَالَ : بَلْ هُوَ لَكَ يَا رَسُولَ اللهِ ، قَالَ : "" بَلْ بِالثَّمَنِ "" ، فَاشْتَرَاهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  هُوَ لَكَ يَا  عَبْدَ اللهِ  ، اذْهَبْ فَاصْنَعْ بِهِ مَا شِئْتَ  .","","Al-Mu'jam al-Kabir 13666","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13703","13667  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو عُبَيْدَةَ بْنُ أَبِي السَّفَرِ ،  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ         [13/46]      نَافِعٍ قَالَ :  سَمِعْتُ  عَمْرَو بْنَ دِينَارٍ  يَذْكُرُ عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَتَاهُ رَجُلٌ يَقُولُ : عَلَيَّ رَقَبَةٌ مِنْ وَلَدِ إِسْمَاعِيلَ ، يَقُولُ :  عَلَيْكَ  بِحَسَنٍ  وَحُسَيْنٍ  .","","Al-Mu'jam al-Kabir 13667","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن إبراهيم بن نافع المخزومي عن يحيى بن أبي بكير عن أحمد بن عبد الله بن محمد بن عبد الله الهمداني عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13704","13668  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  عَمْرُو بْنُ عِيسَى الضُّبَعِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ رَأَى  سُهَيْلًا  ، فَقَالَ  ابْنُ عُمَرَ  : لَعَنَ اللهُ         [13/47]      سُهَيْلًا  ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  كَانَ  سُهَيْلًا  عَشَّارًا مِنْ عَشَّارِي  الْيَمَنِ  ، فَمَسَخَهُ اللهُ فَعَلَّقَهُ حَيْثُ تَرَوْنَ  .","","Al-Mu'jam al-Kabir 13668","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن عبد الأعلى بن عبد الأعلى القرشي عن عمرو بن عيسى الضبعي عن البزار عن الطبراني","عمرو بن دينار عن ابن عمر"
"13705","13669  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامِ بْنِ أَبِي الدُّمَيْكِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحُولَنَّ بَيْنَ أَحَدِكُمْ وَبَيْنَ الْجَنَّةِ كَفٌّ مِنْ دَمٍ أَصَابَهُ  .","","Al-Mu'jam al-Kabir 13669","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن محمد بن عبد الله بن عبيد الليثي عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عمر مشكدانة عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13706","13670  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،         [13/48]      عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو الزُّبَيْرِ  أَنَّهُ سَمِعَ  ابْنَ عُمَرَ وَسَأَلَهُ  عَبْدُ الرَّحْمَنِ بْنُ أَيْمَنَ مَوْلَى عُرْوَةَ  : كَيْفَ تَرَى فِي رَجُلٍ طَلَّقَ امْرَأَتَهُ حَائِضًا ؟ فَقَالَ : طَلَّقَ  عَبْدُ اللهِ بْنُ عُمَرَ  امْرَأَتَهُ وَهِيَ حَائِضٌ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَأَلَ  عُمَرُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لِيُرَاجِعْهَا "" ، فَرَدَّهَا عَلَيَّ وَلَمْ يَرَهَا شَيْئًا ، فَقَالَ :  إِذَا طَهَرَتْ فَلْيُطَلِّقْ أَوْ لِيُمْسِكْ  ، فَقَالَ  ابْنُ عُمَرَ  : وَقَرَأَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ( يَا أَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ فِي قُبُلِ عِدَّتِهِنَّ )  .","","Al-Mu'jam al-Kabir 13670","","عبد الله بن عمر بن الخطاب عن أبو الزبير المكي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13707","[13/49]      13671  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو الزُّبَيْرِ  أَنَّهُ سَمِعَ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ         [13/50]      رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَنْهَى عَنِ  الْجَرِّ  الْمُزَفَّتِ  وَالدُّبَّاءِ  .","","Al-Mu'jam al-Kabir 13671","","عبد الله بن عمر بن الخطاب عن أبو الزبير المكي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13708","13672  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  زِيَادُ بْنُ         [13/51]      أَيُّوبَ دَلُّوَيْهِ ،  ثَنَا  الْحَارِثُ بْنُ النُّعْمَانِ أَبُو النَّضْرِ ،  ثَنَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ  أَنَّ ابْنَ عُمَرَ أَحْرَمَ مَرَّتَيْنِ مِنْ  مَكَّةَ  ، وَأَحْرَمَ الثَّالِثَةَ حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ  ، وَقَالَ :  مَا عَهِدْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحْرِمُ بِهَا حِينَ تَوَجَّهَ  .","","Al-Mu'jam al-Kabir 13672","","عبد الله بن عمر بن الخطاب عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن الحارث بن النعمان بن سالم الأكفاني عن دلويه زياد بن أيوب عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13709","13673  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلُ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي زَيْدٍ الدَّبَّاغُ ،         [13/52]      ثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الصُّفَيْرَاءِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طُوبَى لِمَنْ أَدْرَكَنِي وَآمَنَ بِي  وَصَدَّقَنِي ، وَطُوبَى لِمَنْ أَدْرَكَنِي وَآمَنَ بِي وَصَدَّقَنِي ، وَطُوبَى لِمَنْ لَمْ يُدْرِكْنِي وَآمَنَ بِي وَصَدَّقَنِي  .","","Al-Mu'jam al-Kabir 13673","","عبد الله بن عمر بن الخطاب عن ابن أبي مليكة عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن محمد بن القاسم الأسدي عن الحسن بن الحكم بن طهمان الدباغ عن عبيد العجل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13710","13674  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الْعَرْزَمِيِّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ :  فِي أَيِّ شَهْرٍ اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : فِي رَجَبٍ  .","","Al-Mu'jam al-Kabir 13674","","عبد الله بن عمر بن الخطاب عن ابن أبي مليكة عن محمد بن عبيد الله بن أبي سليمان العرزمي عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13711","13675  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي حُسَيْنٍ ،  عَنْ  عَلِيٍّ الْأَزْدِيِّ قَالَ :  سُئِلَ ابْنُ عُمَرَ عَنِ الْحَرِيرِ ؟  فَقَالَ  :  سَمِعْنَا أَنَّهُ مَنْ لَبِسَهُ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13675","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13712","13676  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  شَيْبَانُ بْنُ         [13/53]      فَرُّوخَ ،  ثَنَا  الصَّعْقُ بْنُ حَزْنٍ ،  عَنْ  قَتَادَةَ ،  ثَنَا  عَلِيُّ بْنُ عَبْدِ اللهِ الْبَارِقِيُّ ، قَالَ :  اسْتَفْتَتْنِي امْرَأَةٌ  بِمَكَّةَ  ، فَقُلْتُ : هَذَا عَبْدُ اللهِ بْنُ عُمَرَ ، عَلَيْكِ بِهِ فَاسْتَفْتِيهِ ، فَانْدَفَعَتْ نَحْوَهُ فَاتَّبَعْتُهَا أَسْمَعُ مَا تَقُولُ ، فَقَالَتْ  لِعَبْدِ اللهِ بْنِ عُمَرَ  :  أَفْتِنِي عَنِ الْجُبْنِ .  فَقَالَ  : وَمَا الْجُبْنُ ؟  فَقَالَتْ لَهُ : شَيْءٌ يُصْنَعُ مِنَ اللَّبَنِ كَذَا وَكَذَا وَيُجَبِّنُونَ الْإِنْفَحَةَ .  فَقَالَ : مَا صَنَعَ         [13/54]      الْمُسْلِمُونَ وَأَهْلُ الْكِتَابِ فَكُلِيهِ ، وَمَا لَمْ يَصْنَعُوهُ فَلَا تَأْكُلِيهِ ، فَقَالَتْ : يَا  عَبْدَ اللهِ  ، أَفْتِنِي عَنِ الْجَرَادِ . قَالَ : ذَكِيٌّ أَكْلُهُ .  قَالَتْ : يَا  عَبْدَ اللهِ  ، أَفْتِنِي عَنِ الذَّهَبِ . قَالَ : يُكْرَهُ لِلرِّجَالِ  .  قَالَتْ :  فَأَفْتِنِي عَنِ الْحَرِيرِ . قَالَ :  نَهَى عَنْهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13676","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن قتادة بن دعامة عن الصعق بن حزن البكري عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13713","13677  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَلِيٍّ الْبَارِقِيِّ ،  عَنِ  ابْنِ عُمَرَ  وَسَأَلَهُ  رَجُلٌ  عَنْ لُبْسِ الْحَرِيرِ ؟ قَالَ :  كُنَّا نَتَحَدَّثُ أَنَّهُ مَنْ لَبِسَهُ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13677","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن قتادة بن دعامة عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13714","13678  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ الْبَارِقِيِّ  أَنَّهُ سَأَلَ  ابْنَ عُمَرَ عَنِ الْحَرِيرِ ؟ فَقَالَ :  كُنَّا نَتَحَدَّثُ أَنَّهُ مَنْ لَبِسَهُ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13678","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13715","13679  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ الْبَارِقِيِّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ وَالنَّهَارِ مَثْنَى مَثْنَى  .","","Al-Mu'jam al-Kabir 13679","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13716","[13/55]      13680  -  حَدَّثَنَا  السَّرِيُّ بْنُ سَهْلٍ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رُشَيْدٍ ،  ثَنَا  مُجَّاعَةُ بْنُ الزُّبَيْرِ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ الْبَارِقِيِّ ،  عَنِ  ابْنِ عُمَرَ  فِي الْحَرِيرِ ، قَالَ :  كُنَّا نَتَحَدَّثُ أَنَّهُ مَنْ لَبِسَهُ فِي الدُّنْيَا لَمْ يَلْبَسْهُ فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 13680","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن قتادة بن دعامة عن مجاعة بن الزبير عن عبد الله بن رشيد الجند يسابوري عن السري بن سهل الجند يسابوري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13717","13681  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَبَنَا  عَبْدُ الرَّزَّاقِ ،         [13/56]      أَبَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو الزُّبَيْرِ أَنَّ عَلِيًّ الْأَزْدِيَّ  أَخْبَرَهُ  أَنَّ         [13/57]      ابْنَ عُمَرَ أَعْلَمَهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا اسْتَوَى عَلَى بَعِيرِهِ خَارِجًا إِلَى سَفَرٍ كَبَّرَ ثَلَاثًا ، ثُمَّ قَالَ :         {      سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا         }      حَتَّى :         {      وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ         }      ،  اللَّهُمَّ إِنَّا نَسْأَلُكَ فِي سَفَرِنَا هَذَا  الْبِرَّ  وَالتَّقْوَى  ، وَمِنَ الْعَمَلِ مَا تَرْضَى ، اللَّهُمَّ هَوِّنْ عَلَيْنَا سَفَرَنَا هَذَا  وَاطْوِ  عَنَّا بُعْدَهُ ، اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ وَالْخَلِيفَةُ فِي الْأَهْلِ ، اللَّهُمَّ أَعُوذُ بِكَ مِنْ  وَعْثَاءِ  السَّفَرِ  وَكَآبَةِ  الْمُنْقَلَبِ  وَسُوءِ الْمَنْظَرِ فِي الْأَهْلِ "" ، وَإِذَا رَجَعَ قَالَهُنَّ وَزَادَ فِيهِنَّ : "" آيِبُونَ ، تَائِبُونَ ، عَابِدُونَ ، لِرَبِّنَا حَامِدُونَ  .","","Al-Mu'jam al-Kabir 13681","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن أبو الزبير المكي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13718","13682  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْبَرْبَهَارِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَابِقٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا سَافَرَ وَاسْتَوَى عَلَى رَاحِلَتِهِ وَانْبَعَثَتْ بِهِ ، قَالَ : "" اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ "" ، ثُمَّ يَقُولُ :         {      سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ             *          وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ         }      ،  اللَّهُمَّ إِنِّي أَسْأَلُكَ فِي سَفَرِي هَذَا  الْبِرَّ  وَالتَّقْوَى  ، وَمِنَ         [13/58]      الْعَمَلِ مَا تَرْضَى ، اللَّهُمَّ هَوِّنْ عَلَيْنَا السَّفَرَ  وَاطْوِي  عَنَّا بُعْدَهُ ، اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ وَالْخَلِيفَةُ فِي الْأَهْلِ ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ  وَعْثَاءِ  السَّفَرِ  وَكَآبَةِ  الْمُنْقَلَبِ  فِي الْأَهْلِ وَالْمَالِ ، آيِبُونَ تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ  .","","Al-Mu'jam al-Kabir 13682","","عبد الله بن عمر بن الخطاب عن علي بن أبي الوليد البارقي عن أبو الزبير المكي عن إبراهيم بن طهمان عن محمد بن سابق التميمي عن أحمد بن على بن الحسن البربهاري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13719","13683  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَرْفَجَةَ قَالَ :  قُلْتُ لِابْنِ عُمَرَ : إِنِّي أُرِيدُ أَنْ آتِيَ  بِالطُّورِ  ؟  قَالَ  :  إِنَّمَا تُشَدُّ الرِّحَالُ إِلَى ثَلَاثِ         [13/59]      مَسَاجِدَ  :  مَسْجِدِ الْحَرَامِ  ،  وَمَسْجِدِ رَسُولِ اللهِ  ،  وَمَسْجِدِ الْأَقْصَى  ، وَدَعِ  الطُّورَ  فَلَا تَأْتِهِ  .","","Al-Mu'jam al-Kabir 13683","","عبد الله بن عمر بن الخطاب عن عرفجة بن عبد الله الثقفي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13720","13684  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  وَسَمِعَ  أَبَا الْعَبَّاسِ الْأَعْمَى  يُحَدِّثُ عَنِ  ابْنِ عُمَرَ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَاصَرَ  الطَّائِفَ  فَلَمْ يَقْدِرْ         [13/60]      مِنْهُمْ عَلَى شَيْءٍ ، فَقَالَ :  إِنَّا قَافِلُونَ غَدًا إِنْ شَاءَ اللهُ  ، فَشَقَّ ذَلِكَ عَلَى الْمُسْلِمِينَ ، وَقَالُوا : نَرْجِعُ وَلَمْ نَفْتَحْهَا ؟! قَالَ : "" فَاغْدُوا عَلَى الْقِتَالِ "" ، فَغَدَوْا فَأَصَابَهُمْ جِرَاحَاتٌ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّا قَافِلُونَ غَدًا إِنْ شَاءَ اللهُ "" ، فَسَكَتُوا وَسَرَّهُمْ ذَلِكَ ، فَتَبَسَّمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 13684","","عبد الله بن عمر بن الخطاب عن السائب بن فروخ الشاعر عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13721","13685  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  إِسْمَاعِيلَ الشَّيْبَانِيِّ ، قَالَ :  بِعْتُ مَا فِي رُؤُوسِ نَخْلِي بِمِئَةِ وَسْقٍ ، ثُمَّ إِنْ زَادَ فَلَهُمْ وَإِنْ نَقَصَ فَعَلَيْهِمْ ،  فَسَأَلْتُ  ابْنَ عُمَرَ ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ هَذَا ، إِلَّا أَنَّهُ رَخَّصَ فِي الْعَرَايَا  .","","Al-Mu'jam al-Kabir 13685","","عبد الله بن عمر بن الخطاب عن إبراهيم بن إسماعيل السلمي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13722","[13/61]      13686  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الطَّاهِرِ بْنُ السَّرْحِ ،  ثَنَا  مُوسَى بْنُ رَبِيعَةَ ،  عَنِ  الْمُثَنَّى بْنِ الصَّبَّاحِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ أَنَّ إِسْمَاعِيلَ الشَّيْبَانِيَّ  حَدَّثَهُ  أَنَّهُ بَاعَ نَخْلًا بِمِئَةِ وَسْقٍ تَوْفِيَةً مِمَّا فِي رُؤُوسِ نَخْلِهِ ، فَإِنْ زَادَ فَلَهُمْ وَإِنْ نَقَصَ فَعَلَيْهِمْ ،  فَسَأَلَ  عَبْدَ اللهِ بْنَ عُمَرَ ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ هَذَا الْبَيْعِ غَيْرَ أَنَّهُ قَدْ أَرْخَصَ فِي بَيْعِ الْعَرَايَا  .","","Al-Mu'jam al-Kabir 13686","","عبد الله بن عمر بن الخطاب عن إبراهيم بن إسماعيل السلمي عن عمرو بن دينار الأثرم عن المثنى بن الصباح الأبناوي عن موسى بن ربيعة الجمحي عن أحمد بن عمرو بن بن السرح المصري عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13723","13687  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْحُبَابِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي ذُؤَيْبٍ قَالَ :  خَرَجْنَا مَعَ ابْنِ عُمَرَ فَغَرَبَتِ الشَّمْسُ  ، فَهِبْنَا  ابْنَ عُمَرَ  أَنْ نَقُولَ لَهُ : الصَّلَاةَ ، فَأَمْهَلَ حَتَّى إِذَا ذَهَبَ بَيَاضُ الْأُفُقِ  وَفَحْمَةُ  الْعِشَاءِ نَزَلَ فَصَلَّى ثَلَاثَ رَكَعَاتٍ ، ثُمَّ صَلَّى بِنَا رَكْعَتَيْنِ ، ثُمَّ  قَالَ  : هَكَذَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَ  .","","Al-Mu'jam al-Kabir 13687","","عبد الله بن عمر بن الخطاب عن إسماعيل بن عبد الرحمن بن ذؤيب الأعور عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13724","[13/62]      13688  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  شُعْبَةُ  حَدَّثَنِي  ابْنُ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  أَنَّ  رَجُلًا  سَأَلَ ابْنَ عُمَرَ عَنْ صَوْمِ عَرَفَةَ ، فَقَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَصُمْهُ  ،  وَأَنَا لَا أَصُومُهُ وَلَا أَنْهَاكَ وَلَا آمُرُكَ  ، إِنْ شِئْتَ فَصُمْ وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Al-Mu'jam al-Kabir 13688","","عبد الله بن عمر بن الخطاب عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عمرو بن دينار عن ابن عمر"
"13725","[13/63]      13689  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ أَبِي سَمِينَةَ .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْعَلَّافُ ، قَالَا :  ثَنَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  ثَنَا  أَبُو بِشْرٍ جَعْفَرُ بْنُ أَبِي وَحْشِيَّةَ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَاعَ عَبْدًا وَلَهُ مَالٌ فَمَالُهُ لِلْبَائِعِ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  ، وَمَنْ بَاعَ نَخْلًا قَدْ  أُبِّرَ  فَثَمَرَتُهُ  لِلْبَائِعِ إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ  .","","Al-Mu'jam al-Kabir 13689","","عبد الله بن عمر بن الخطاب عن يوسف بن ماهك الفارسي عن جعفر بن إياس اليشكري عن روح بن عطاء بن أبي ميمونة البصري عن وهب بن يحيى بن زمام العلاف عن محمد بن صالح النرسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13726","13690  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  بِشْرُ بْنُ هِلَالٍ         [13/64]      الصَّوَّافُ ،  حَدَّثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  أَيُّوبَ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُعَوَّلُ  عَلَيْهِ  يُعَذَّبُ  .","","Al-Mu'jam al-Kabir 13690","","عبد الله بن عمر بن الخطاب عن يوسف بن ماهك الفارسي عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن بشر بن هلال الصواف عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13727","13691  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  عَنْ  رَبَاحِ بْنِ أَبِي مَعْرُوفٍ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ، قَالَ :  قَالَ  رَجُلٌ  لِعَبْدِ اللهِ بْنِ عُمَرَ :  يَا  أَبَا عَبْدِ الرَّحْمَنِ  أَرَاكَ تَسْتَلِمُ  الرُّكْنَيْنِ  لَا تَدَعُهُمَا  ؟ قَالَ : إِنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَلِمُهُمَا لَا يَدَعُهُمَا ، فَقَالَ الرَّجُلُ : أَرَأَيْتُكَ لَا تَسْتَلِمُ  الرُّكْنَيْنِ  الْآخَرَيْنِ ؟ قَالَ : إِنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَسْتَلِمُهُمَا  .","","Al-Mu'jam al-Kabir 13691","","عبد الله بن عمر بن الخطاب عن يوسف بن ماهك الفارسي عن رباح بن أبي معروف المكي عن مروان بن معاوية الفزاري عن داود بن رشيد الخوارزمي عن محمد بن عبدوس السراج عن الطبراني","عمرو بن دينار عن ابن عمر"
"13728","13692  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يُونُسُ بْنُ الْقَاسِمِ         [13/65]      أَبُو عُمَرَ الْيَمَامِيُّ لَقِيتُهُ  بِمَكَّةَ  ،  ثَنَا  عِكْرِمَةُ بْنُ خَالِدٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ  تَعَظَّمَ  فِي نَفْسِهِ وَاخْتَالَ فِي مِشْيَتِهِ  ; لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  .","","Al-Mu'jam al-Kabir 13692","","عبد الله بن عمر بن الخطاب عن عكرمة بن خالد بن العاص عن يونس بن القاسم اليمامي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13729","13693  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يُونُسُ بْنُ الْقَاسِمِ ،  ثَنَا  عِكْرِمَةُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  صَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ وَأَفْطَرَ  .","","Al-Mu'jam al-Kabir 13693","","عبد الله بن عمر بن الخطاب عن عكرمة بن خالد بن العاص عن يونس بن القاسم اليمامي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13730","13694  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا         [13/66]      حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّ  رَجُلًا  ابْتَاعَ مِنْ  رَجُلٍ  أَرْضًا فِيهَا  ثَمَرَتُهَا  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الثَّمَرَةُ  لِلَّذِي  أَبَّرَهَا  إِلَّا أَنْ يَشْتَرِطَ  ;  يَعْنِي : الْمُبْتَاعَ  .","","Al-Mu'jam al-Kabir 13694","","عبد الله بن عمر بن الخطاب عن عكرمة بن خالد بن العاص عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13731","13695  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ،  حَدَّثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  أَبُو دَاوُدَ الْحَفَرِيُّ ،  ثَنَا  بَدْرُ بْنُ عُثْمَانَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ مَرْوَانَ ،  عَنْ  أَبِي عَائِشَةَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ غَدَاةٍ ، فَقَالَ :  لَقَدْ رَأَيْتُ قُبَيْلَ الْفَجْرِ كَأَنِّي أُعْطِيتُ الْمَقَالِيدَ وَالْمَوَازِينَ  ، فَأَمَّا الْمَقَالِيدُ فَهَذِهِ الْمَفَاتِيحُ وَأَمَّا الْمَوَازِينُ فَهَذِهِ الَّذِي تَزِنُونَ بِهَا ، وَوُضِعْتُ فِي كِفَّةٍ وَوُضِعَتْ أُمَّتِي فِي كِفَّةٍ فَرَجَحْتُ بِهِمْ ، ثُمَّ جِيءَ  بِأَبِي بَكْرٍ  فَوُضِعَ فِي كِفَّةٍ وَوُضِعَتْ أُمَّتِي فِي كِفَّةٍ فَرَجَحَ بِهِمْ ، ثُمَّ جِيءَ  بِعُمَرَ  فَوُضِعَ فِي كِفَّةٍ وَوُضِعَتْ أُمَّتِي فِي كِفَّةٍ فَرَجَحَ بِهِمْ ، ثُمَّ جِيءَ  بِعُثْمَانَ  فَوُضِعَ فِي كِفَّةٍ وَوُضِعَتْ أُمَّتِي فِي كِفَّةٍ فَرَجَحَ بِهِمْ ، ثُمَّ رُفِعَتِ الْمَوَازِينُ  .  قَالَ أَبُو الْقَاسِمِ :  أَبُو عَائِشَةَ  عِنْدِي  مَسْرُوقُ بْنُ الْأَجْدَعِ  ، وَاللهُ أَعْلَمُ .","","Al-Mu'jam al-Kabir 13695","","عبد الله بن عمر بن الخطاب عن أبو عائشة عن عبيد الله بن مروان الكوفي عن بدر بن عثمان الأموي عن عمر بن سعد بن عبيد الحفري عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13732","[13/67]      13696  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ مَنْصُورٍ الْمَشْرِقِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ فِي  غَزْوَةِ تَبُوكَ  بِجُبْنَةٍ ، فَأَخَذَ  السِّكِّينَ  فَقَطَعَ ، وَقَالَ :  كُلُوا بِاسْمِ اللهِ  .  قَالَ أَبُو الْقَاسِمِ :  ""  الْمِشْرَقِيِّينَ  "" ، فَخِذٌ مِنْ  هَمْدَانَ  .","","Al-Mu'jam al-Kabir 13696","","عبد الله بن عمر بن الخطاب عن الشعبي عن عمرو بن منصور المشرقي عن إبراهيم بن عيينة الهلالي عن محمد بن عباد بن الزبرقان المكي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13733","[13/68]      13697  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ وَمُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ قَزَعَةَ ،  ثَنَا  مَسْلَمَةُ بْنُ عَلْقَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ قَالَ :  قَالَ  رَجُلٌ  لِابْنِ عُمَرَ : إِنَّا نَدْخُلُ عَلَى هَؤُلَاءِ الْأُمَرَاءِ ، فَنَقُولُ لَهُمْ ، فَإِذَا خَرَجْنَا قُلْنَا فِيهِمْ غَيْرَهُ ؟  فَقَالَ  :  كُنَّا نَعُدُّ هَذَا نِفَاقًا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13697","","عبد الله بن عمر بن الخطاب عن الشعبي عن داود بن أبي هند عن مسلمة بن علقمة المازني عن الحسن بن قزعة الخلقاني عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13734","13698  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سِنَانُ بْنُ هَارُونَ ،  عَنْ  مُجَالِدٍ ،  عَنْ  عَامِرٍ قَالَ :  قُلْتُ لِابْنِ عُمَرَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّ قَوْمًا يَأْمُرُونَا أَنْ نَصْعَدَ عَلَى الْمَنَابِرِ فَنَتَكَلَّمَ ، فَإِذَا نَزَلْنَا فَوَاللهِ لَأَنْ         [13/69]      يَخِرَّ أَحَدُنَا مِنَ السَّمَاءِ أَحَبُّ إِلَيْهِ مِنْ أَنْ يَلْفِظَ بِشَيْءٍ مِنْهَا ؟  قَالَ  :  كَانَ هَذَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نِفَاقًا  .","","Al-Mu'jam al-Kabir 13698","","عبد الله بن عمر بن الخطاب عن الشعبي عن مجالد بن سعيد عن سنان بن هارون البرجمي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13735","13699  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  يَحْيَى بْنُ إِسْمَاعِيلَ بْنِ سَالِمٍ قَالَ :  سَمِعْتُ  الشَّعْبِيَّ  يُحَدِّثُ عَنِ  ابْنِ عُمَرَ قَالَ :  خُيِّرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الدُّنْيَا وَالْآخِرَةِ فَاخْتَارَ الْآخِرَةَ  .","","Al-Mu'jam al-Kabir 13699","","عبد الله بن عمر بن الخطاب عن الشعبي عن يحيى بن إسماعيل الأسدي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13736","[13/70]      13700  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الدَّوْلَابِيُّ قَالَا :  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ يَعْنِي الْجُعْفِيَّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ وَابْنِ عُمَرَ قَالَا :  سَنَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ السَّفَرِ رَكْعَتَيْنِ  وَهُمَا فِي تَمَامٍ ،  وَالْوِتْرُ  فِي السَّفَرِ مِنَ السُّنَّةِ  .","","Al-Mu'jam al-Kabir 13700","","عبد الله بن عمر بن الخطاب عن الشعبي عن جابر الجعفي عن شريك بن عبد الله النخعي عن محمد بن الصباح الدولابي عن أحمد بن يحيى بن إسحاق الحلواني عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","عمرو بن دينار عن ابن عمر"
"13737","[13/71]      13701  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  لَعَنَ اللهُ مَنْ يَزْعُمُ أَنِّي هَاجَرْتُ قَبْلَ أَبِي  ، إِنَّمَا قَدَّمَنِي فِي ثِقَلِهِ  .","","Al-Mu'jam al-Kabir 13701","","عبد الله بن عمر بن الخطاب عن الشعبي عن جابر الجعفي عن شريك بن عبد الله بن أبي نمر الكناني عن علي بن حكيم بن ذبيان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13738","13702  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبِي ،  ثَنَا  [ أَبِي  ] ،  ثَنَا  شُعْبَةُ ،  عَنْ  تَوْبَةَ الْعَنْبَرِيِّ ،  عَنِ  الشَّعْبِيِّ ،  سَمِعَ  ابْنَ عُمَرَ قَالَ :  كَانَ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَاسٌ مِنْ أَصْحَابِهِ فِيهِمْ  سَعْدٌ  ، فَأُتُوا بِلَحْمِ ضَبٍّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُوا فَإِنَّهُ حَلَالٌ وَلَكِنَّهُ لَيْسَ مِنْ طَعَامِي  .","","Al-Mu'jam al-Kabir 13702","","عبد الله بن عمر بن الخطاب عن الشعبي عن توبة بن أبي الأسد العنبري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13739","[13/72]      13703  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذٍ الْعَنْبَرِيُّ ،  ثَنَا  أَبِي ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  تَوْبَةَ الْعَنْبَرِيِّ ،  عَنِ  الشَّعْبِيِّ قَالَ :  صَحِبْتُ  ابْنَ عُمَرَ فَمَا سَمِعْتُهُ يُحَدِّثُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا حَدِيثَ الضَّبِّ  .","","Al-Mu'jam al-Kabir 13703","","عبد الله بن عمر بن الخطاب عن الشعبي عن توبة بن أبي الأسد العنبري عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13740","13704  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَبَنَا  شُعْبَةُ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ أَبِي السَّفَرِ ، قَالَ :  سَمِعْتُ  الشَّعْبِيَّ يَقُولُ :  جَالَسْتُ ابْنَ عُمَرَ سَنَةً فَمَا سَمِعْتُهُ يُحَدِّثُ حَدِيثًا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13704","","عبد الله بن عمر بن الخطاب عن الشعبي عن عبد الله بن أبي السفر الهمداني عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","عمرو بن دينار عن ابن عمر"
"13741","[13/73]      13705  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  حَدَّثَنَا  عَاصِمُ بْنُ النَّضْرِ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  كَهْمَسَ بْنَ الْحَسَنِ  يُحَدِّثُ عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  عَامِرٍ قَالَ :  لَوَدِدْتُ أَنِّي لَقِيتُ هَذَا الْكَبْشَ فَنَهَيْتُهُ عَنْ قَوْلِهِ : "" قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَقَدْ كُنْتُ مَعَ ابْنِ عُمَرَ سَنَتَيْنِ فَمَا حَدَّثَنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِحَدِيثِ الضَّبِّ  .  قَالَ أَبُو الْقَاسِمِ :  يَعْنِي بِقَوْلِهِ "" الْكَبْشَ "" :  الْحَسَنَ الْبَصْرِيَّ  .","","Al-Mu'jam al-Kabir 13705","","عبد الله بن عمر بن الخطاب عن الشعبي عن داود بن أبي هند عن كهمس بن الحسن النمري عن معتمر بن سليمان عن عاصم بن النضر الأحول عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13742","13706  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ         [13/74]      الدِّمَشْقِيُّ ،  ثَنَا  خَالِدُ بْنُ أَبِي خَالِدٍ الْأَزْرَقُ السُّلَمِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَفْضَلُ الْعِبَادَةِ الْفِقْهُ  ، وَأَفْضَلُ الدِّينِ  الْوَرَعُ  .","","Al-Mu'jam al-Kabir 13706","","عبد الله بن عمر بن الخطاب عن الشعبي عن محمد بن عبد الرحمن بن أبي ليلى عن خالد بن يزيد الأزرق عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","عمرو بن دينار عن ابن عمر"
"13743","13707  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ الْحَلَبِيُّ أَبُو خَالِدٍ الزُّهْرِيُّ مَوْلَى سَعْدِ بْنِ أَبِي وَقَّاصٍ ، قَالَ :  سَمِعْتُ  عَامِرً الشَّعْبِيَّ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَلَّى الضُّحَى وَصَامَ ثَلَاثَةَ أَيَّامٍ مِنَ  الشَّهْرِ  وَلَمْ يَتْرُكِ  الْوِتْرَ  فِي سَفَرٍ وَلَا حَضَرٍ كُتِبَ لَهُ أَجْرُ شَهِيدٍ  .","","Al-Mu'jam al-Kabir 13707","","عبد الله بن عمر بن الخطاب عن الشعبي عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13744","[13/75]      13708  -  حَدَّثَنَا  أَبُو شُعَيْبٍ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  أَيُّوبُ بْنُ نَهِيكٍ قَالَ :  سَمِعْتُ  عَامِرً الشَّعْبِيَّ يَقُولُ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا دَخَلَ أَحَدُكُمُ الْمَسْجِدَ وَالْإِمَامُ عَلَى الْمِنْبَرِ  ، فَلَا صَلَاةَ وَلَا كَلَامَ حَتَّى يَفْرُغَ الْإِمَامُ  .","","Al-Mu'jam al-Kabir 13708","","عبد الله بن عمر بن الخطاب عن الشعبي عن أيوب بن نهيك الحلبي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13745","13709  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  ابْنِ عُمَرَ قَالَ :         [13/76]      لَقِينَا الْعَدُوَّ  فَحَاصَ  الْمُسْلِمُونَ حَيْصَةً ، فَكُنْتُ فِيمَنْ حَاصَ ، فَقُلْنَا : قَدْ بُؤْنَا بِغَضَبٍ مِنَ اللهِ وَرَسُولِهِ ، ثُمَّ قُلْنَا : لَوْ دَخَلْنَا  الْمَدِينَةَ  فَامْتَرْنَا فِيهِ ! فَدَخَلْنَا  الْمَدِينَةَ  فَتَعَرَّضْنَا لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خُرُوجَهُ إِلَى         [13/77]      الصَّلَاةِ ، فَقُلْنَا : يَا رَسُولَ اللهِ نَحْنُ الْفَرَّارُونَ !! فَقَالَ :  بَلْ أَنْتُمُ  الْعَكَّارُونَ  ، إِنِّي  فِئَةٌ  لَكُمْ  .","","Al-Mu'jam al-Kabir 13709","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13746","13710  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطِيَّةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى ، فَإِذَا خَشِيتَ الصُّبْحَ  فَأَوْتِرْ  بِرَكْعَةٍ  ، فَإِنَّ اللهَ  وِتْرٌ  يُحِبُّ  الْوِتْرَ  .","","Al-Mu'jam al-Kabir 13710","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عطية بن سعد العوفي عن الأعمش عن عيسى بن يونس بن أبي إسحاق عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13747","[13/78]      13711  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  حَدَّثَنَا  سَلَمَةُ بْنُ كُهَيْلٍ وَالْحَكَمُ قَالَا :  صَلَّى بِنَا سَعِيدُ بْنُ         [13/79]      جُبَيْرٍ  بِجَمْعٍ  الْمَغْرِبَ ثَلَاثًا  ، فَلَمَّا سَلَّمَ قَامَ فَصَلَّى الْعِشَاءَ رَكْعَتَيْنِ  ،  ثُمَّ  حَدَّثَ  عَنِ ابْنِ عُمَرَ أَنَّهُ صَنَعَ فِي ذَلِكَ الْمَكَانِ مِثْلَ ذَلِكَ  ، ثُمَّ  حَدَّثَ  ابْنُ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَنَعَ فِي ذَلِكَ الْمَكَانِ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 13711","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13748","13712  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ الْبَجَلِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ الْأَسَدِيِّ  أَنَّهُ  أَفَاضَ  مِنْ  عَرَفَاتٍ  ، قَالَ  الْحَكَمُ  : فَتَبِعْتُهُ وَهُوَ عَلَى بَعِيرٍ لَهُ لَا يَزِيدُهُ عَلَى الْعَنَقِ ، فَقُلْتُ :  هَذَا قَدْ صَحِبَ  عَبْدَ اللهِ بْنَ عَبَّاسٍ  وَعَبْدَ اللهِ بْنَ عُمَرَ  ، فَلَأَنْظُرَنَّ كَيْفَ يَصْنَعُ  ؟ فَسَارَ حَتَّى أَتَى  جَمْعًا  ، فَنَزَلَ فَمَا هُوَ إِلَّا أَنْ وَضَعْنَا رِحَالَنَا فَأَقَامَ الصَّلَاةَ ، ثُمَّ صَلَّى بِنَا الْمَغْرِبَ ، فَمَا أَدْرِي حَتَّى قَامَ فَكَبَّرَ فَصَلَّى  الْعَتَمَةَ  ، فَصَلَّى بِنَا  ثُمَّ قَالَ :  هَكَذَا  رَأَيْتُ  عَبْدَ اللهِ بْنَ عُمَرَ  صَنَعَ  ، ثُمَّ  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هَكَذَا صَنَعَ  .","","Al-Mu'jam al-Kabir 13712","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن الحكم بن عتيبة الكندي عن أبو بكر النهشلي عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13749","13713  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [13/80]      عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ :  أَفَضْنَا  مَعَ ابْنِ عُمَرَ حَتَّى أَتَى  جَمْعًا  ، فَصَلَّى بِنَا الْمَغْرِبَ وَالْعِشَاءَ بِإِقَامَةٍ وَاحِدَةٍ  ، ثُمَّ انْصَرَفَ  فَقَالَ  :  هَكَذَا صَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13713","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن إسماعيل بن أبي خالد عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13750","13714  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  حَدَّثَنِي  أَبِي .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ قَالَا :  ثَنَا  هُشَيْمٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  لُعِنَتِ الْخَمْرُ وَعَاصِرُهَا وَمُعْتَصِرُهَا وَشَارِبُهَا وَسَاقِيهَا  .","","Al-Mu'jam al-Kabir 13714","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","عمرو بن دينار عن ابن عمر"
"13751","[13/81]      13715  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ قَالَ :  قَالَ  أَيُّوبُ :  حَدَّثَنِي  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ صَدَاقِي ؟ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كُنْتَ صَادِقًا فَهُوَ لَهَا بِمَا اسْتَحْلَلْتَ مِنْهَا  ، وَإِنْ كُنْتَ كَاذِبًا فَهُوَ         [13/82]      أَوْجَبُ لَهُ ""  أَوْ كَمَا قَالَ فِي الْمُتَلَاعِنَيْنِ  .","","Al-Mu'jam al-Kabir 13715","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عمرو بن دينار الأثرم عن أيوب السختياني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13752","13716  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّهُ مَرَّ بِقَوْمٍ قَدِ اتَّخَذُوا دَجَاجَةً غَرَضًا يَرْمُونَهَا ، فَقَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَنْ يُمَثِّلُ بِالْبَهَائِمِ  .","","Al-Mu'jam al-Kabir 13716","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن المنهال بن عمرو الأسدي عن الأعمش عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13753","13717  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  ثَنَا  الْأَعْمَشُ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُتَّخَذَ الْبَهَائِمُ غَرَضًا  .","","Al-Mu'jam al-Kabir 13717","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن المنهال بن عمرو الأسدي عن الأعمش عن جرير بن حازم عن شيبان بن فروخ الحبطي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13754","[13/83]      13718  -  حَدَّثَنَا  أَبُو خَلِيفَةَ ،  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ  أَخْبَرَنِي  الْمِنْهَالُ بْنُ عَمْرٍو قَالَ :  سَمِعْتُ  سَعِيدَ بْنَ جُبَيْرٍ يَقُولُ :  خَرَجْتُ مَعَ ابْنِ عُمَرَ فِي طَرِيقٍ مِنْ طُرُقِ  الْمَدِينَةِ  ، فَرَأَى أُغَيْلِمَةً يَرْمُونَ دَجَاجَةً ، فَقَالَ  ابْنُ عُمَرَ  : مَنْ فَعَلَ هَذَا ؟! فَتَفَرَّقُوا ، فَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَعَنَ مَنْ تَمَثَّلَ بِالْحَيَوَانِ  .","","Al-Mu'jam al-Kabir 13718","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن المنهال بن عمرو الأسدي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13755","13719  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ وَأَبُو شُعَيْبٍ الْحَرَّانِيُّ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يُتَّخَذَ الرُّوحُ غَرَضًا  .","","Al-Mu'jam al-Kabir 13719","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن المنهال بن عمرو الأسدي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أبو شعيب الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13756","[13/84]      13720  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنَا  أَبُو عُبَيْدٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  نَهَى عَنْ قَتْلِ شَيْءٍ مِنَ الدَّوَابِّ  صَبْرًا  .","","Al-Mu'jam al-Kabir 13720","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن هشيم بن بشير عن أبو عبيد القاسم بن سلام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13757","13721  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  عَنْ  أَبِي إِسْحَاقَ الْفَزَارِيِّ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  فُضَيْلِ بْنِ         [13/85]      عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ :  مَرَّ ابْنُ عُمَرَ عَلَى قَوْمٍ قَدْ نَصَبُوا دَجَاجَةً يَرْمُونَهَا بِالنَّبْلِ ، فَقَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَنْ يُمَثِّلُ بِالْبَهَائِمِ  .","","Al-Mu'jam al-Kabir 13721","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن فضيل بن عمرو الفقيمي عن علاء بن المسيب عن أبو إسحاق الفزاري عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13758","13722  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ،  عَنِ  النَّضْرِ بْنِ مُحَمَّدٍ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنِ  الْفُضَيْلِ بْنِ عَمْرٍو ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْعَنُ مَنْ يُمَثِّلُ بِالْبَهَائِمِ  .","","Al-Mu'jam al-Kabir 13722","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن فضيل بن عمرو الفقيمي عن علاء بن المسيب عن النضر بن محمد القرشي عن محمد بن عبد العزيز بن أبي رزمة عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13759","13723  -  حَدَّثَنَا  أَحْمَدُ بْنُ بَشِيرٍ  الطَّيَالِسِيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  قَرَأْتُ عَلَى  الْفُضَيْلِ بْنِ مَيْسَرَةَ  حَدَّثَنِي  أَبُو حَرِيزٍ  أَنَّهُ سَمِعَ  سَعِيدَ بْنَ جُبَيْرٍ يَقُولُ :  سَأَلَ  رَجُلٌ  عَبْدَ اللهِ بْنَ عُمَرَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ ؟  قَالَ  :  كُنَّا نَعْدِلُهُ وَنَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِصَوْمِ سَنَةٍ  .  كذا في طبعة الجريسي وأكثر المواضع في كتب المصنف ، المعاجم وغيرها ، وكذا هو في لسان الميزان ، وقال محقق تهذيب الكمال 24 / 581 : ""جاء في حواشي النسخ تعقيب للمؤلف على صاحب الكمال نصه : ""كان فيه : أحمد بن بشر وهو خطأ "". والذي في تاريخ بغداد وتاريخ الإسلام : (بشر) فالله أعلم .","","Al-Mu'jam al-Kabir 13723","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن يحيى بن معين عن أحمد بن بشر الطيالسى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13760","[13/86]      13724  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ بْنِ وَاضِحٍ الْعَسَّالُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَبَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أَسْمَعُ عَنْ لَيْلَةِ الْقَدْرِ ؟ فَقَالَ :  هِيَ فِي كُلِّ رَمَضَانَ  .","","Al-Mu'jam al-Kabir 13724","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن موسى بن عقبة عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن أحمد بن إسحاق العسال عن الطبراني","عمرو بن دينار عن ابن عمر"
"13761","13725  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  ثَنَا  سَعِيدُ بْنُ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ وَهُوَ مُقْبِلٌ مِنْ  مَكَّةَ  إِلَى  الْمَدِينَةِ  حَيْثُمَا تَوَجَّهَتْ بِهِ ، وَأُنْزِلَتْ فِيهِ هَذِهِ الْآيَةُ         {      فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللهِ         }      .","","Al-Mu'jam al-Kabir 13725","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الملك بن أبي سليمان العرزمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13762","[13/87]      13726  -  حَدَّثَنَا  أَبُو مَعْنٍ ثَابِتُ بْنُ نُعَيْمٍ الْهُوجِيُّ ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ .         [13/88]      وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ قَالُوا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنْتُ أَبِيعُ الْإِبِلَ فِي  الْبَقِيعِ  فَأَبِيعُ بِالدَّنَانِيرِ وَآخُذُ الدَّرَاهِمَ         [13/89]      وَأَبِيعُ بِالدَّرَاهِمِ وَآخُذُ الدَّنَانِيرَ ، وَآخُذُ هَذِهِ مِنْ هَذِهِ وَهَذِهِ مِنْ هَذِهِ ، وَأُعْطِي هَذِهِ مِنْ هَذِهِ وَهَذِهِ مِنْ هَذِهِ ، فَأَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي بَيْتِ  حَفْصَةَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ  رُوَيْدَكَ  أَسْأَلْكَ ، إِنِّي أَبِيعُ الْإِبِلَ  بِالْبَقِيعِ  فَأَبِيعُ بِالدَّنَانِيرِ وَآخُذُ الدَّرَاهِمَ ، وَأَبِيعُ بِالدَّرَاهِمِ فَآخُذُ الدَّنَانِيرَ ، وَآخُذُ هَذِهِ مِنْ هَذِهِ ، وَأُعْطِي هَذِهِ مِنْ هَذِهِ ؟ قَالَ :  لَا بَأْسَ أَنْ تَأْخُذَهَا بِسِعْرِ يَوْمِهَا مَا لَمْ تَفْتَرِقَا وَبَيْنَكُمَا شَيْءٌ  .","","Al-Mu'jam al-Kabir 13726","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن سماك بن حرب البكري عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13763","13727  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  أَبَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنْتُ أَبِيعُ  بِالْبَقِيعِ  بِالدَّرَاهِمِ وَآخُذُ الدَّنَانِيرَ ، وَآخُذُ الدَّرَاهِمَ مِنَ الدَّنَانِيرِ وَالدَّنَانِيرَ مِنَ الدَّرَاهِمِ ، فَسَأَلْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ :  إِذَا أَخَذْتَ وَاحِدًا مِنْهَا بِصَاحِبِهِ فَلَا يُفَارِقَنَّكَ صَاحِبُكَ وَبَيْنَكُمَا بَيْعٌ  .","","Al-Mu'jam al-Kabir 13727","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن كثير العبدي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13764","[13/90]      13728  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  عِيسَى بْنُ عَلِيٍّ الْعَسْكَرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ بَهْرَامَ الْهِيتِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ : قُلْتُ لِعَبْدِ اللهِ بْنِ عُمَرَ :  حَدِّثْنِي  حَدِيثًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَأْتِي اللهُ بِالْعَبْدِ الْمُؤْمِنِ يَوْمَ الْقِيَامَةِ حَتَّى يَجْعَلَهُ فِي حِجَابِهِ  ، فَيَقُولُ لَهُ : اقْرَأْ فِي صَحِيفَتِكَ ، فَيَقْرَأُ وَيُقَرِّرُهُ بِذَنْبٍ ذَنْبٍ ، وَيَقُولُ لَهُ : أَتَعْرِفُ ؟ أَتَعْرِفُ ؟ فَيَقُولُ : نَعَمْ يَا رَبِّ ، فَيَقُولُ : اقْرَأْ ، فَيَقْرَأُ وَيَلْتَفِتُ يَمْنَةً وَيَسْرَةً ، فَيَقُولُ : لَا بَأْسَ عَلَيْكَ يَا عَبْدِي ، إِنَّكَ فِي سِتْرِي ، لَيْسَ بَيْنِي وَبَيْنَكَ أَنْ يَطَّلِعَ عَلَى ذُنُوبِكَ غَيْرِي ، اذْهَبْ فَقَدْ غَفَرْتُهَا لَكَ ، فَيُقَالُ لَهُ : ادْخُلِ الْجَنَّةَ .  وَأَمَّا الْكَافِرُ فَيُقَالُ عَلَى رُؤُوسِ الْأَشْهَادِ :         {      هَؤُلاءِ الَّذِينَ كَذَبُوا عَلَى رَبِّهِمْ أَلا لَعْنَةُ اللهِ عَلَى الظَّالِمِينَ         }      .","","Al-Mu'jam al-Kabir 13728","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن منصور بن المعتمر عن القاسم بن أبي أيوب الأعرج عن أحمد بن القاسم بن بهرام الهيتي عن عيسى بن علي العسكري عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13765","13729  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  فَرْقَدٍ السَّبَخِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ         [13/91]      عُمَرَ قَالَ :  ادَّهَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ بِزَيْتٍ غَيْرِ  مُقَتَّتٍ  .","","Al-Mu'jam al-Kabir 13729","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن فرقد بن يعقوب السبخي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13766","13730  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبُو بَكْرٍ الْهُذَلِيُّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ نَبِيذِ  الْجَرِّ  ؟  فَقَالَ : حَرَّمَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 13730","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن أبو بكر الهذلي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13767","[13/92]      13731  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  يَعْلَى بْنِ حَكِيمٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ قَالَ :  حَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَبِيذَ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 13731","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن يعلى بن حكيم الثقفي عن جرير بن حازم عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13768","13732  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَبَنَا  هَمَّامٌ ،  عَنْ  يَعْلَى بْنِ حَكِيمٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  حَرَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَبِيذَ  الْجَرِّ  .","","Al-Mu'jam al-Kabir 13732","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن يعلى بن حكيم الثقفي عن همام بن يحيى بن دينار عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13769","[13/93]      13733  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْمُغِيرَةِ عَبْدُ الْقُدُّوسِ بْنُ الْحَجَّاجِ ،  ثَنَا  مُعَانُ بْنُ رِفَاعَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي عَمْرَةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ مَثَّلَ بِحَيَوَانٍ فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ  .","","Al-Mu'jam al-Kabir 13733","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن محمد بن أبي عمرة الأزدي عن معان بن رفاعة السلامي عن عبد القدوس بن الحجاج عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13770","13734  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْحَاقَ الصِّينِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي هَاشِمٍ الرُّمَّانِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ  أَحْسَبُهُ قَدْ  رَفَعَهُ  ، قَالَ :  الْمَرْأَةُ فِي حَمْلِهَا إِلَى وَضْعِهَا إِلَى فِصَالِهَا كَالْمُرَابِطِ فِي  سَبِيلِ  اللهِ  ، فَإِنْ مَاتَتْ فِيمَا بَيْنَ ذَلِكَ فَلَهَا أَجْرُ  شَهِيدٍ  .","","Al-Mu'jam al-Kabir 13734","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن يحيى بن دينار الرماني عن قيس بن الربيع الأسدي عن إبراهيم بن إسحاق الصيني عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13771","[13/94]      13735  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  يَعْقُوبُ الْقُمِّيُّ ،  عَنْ  جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نَزَلَتْ عَلَيْنَا هَذِهِ الْآيَةُ         {      ثُمَّ إِنَّكُمْ يَوْمَ الْقِيَامَةِ عِنْدَ رَبِّكُمْ تَخْتَصِمُونَ         }      ، وَمَا نَدْرِي مَا تَفْسِيرُهَا  ، حَتَّى وَقَعَتِ الْفِتْنَةُ ، فَقُلْنَا : هَذَا الَّذِي وُعِدْنَا - وَيْلَنَا ! - أَنْ نَخْتَصِمَ فِيهِ  .","","Al-Mu'jam al-Kabir 13735","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن جعفر بن أبي المغيرة عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن سليمان بن داود العتكي عن محمد بن محمد بن حيان التمار عن الطبراني","عمرو بن دينار عن ابن عمر"
"13772","13736  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  شَقِيقٍ أَبِي وَائِلٍ  أَنَّ  ابْنَ عُمَرَ  طَلَّقَ امْرَأَتَهُ وَهِيَ حَائِضٌ ،  فَأَمَرَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُرَاجِعَهَا ثُمَّ يُطَلِّقَهَا إِذَا طَهَرَتْ  .","","Al-Mu'jam al-Kabir 13736","","شقيق بن سلمة عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13773","[13/95]      13737  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي بِخَطِّهِ  ،  حَدَّثَنَا  مُسْتَلِمُ بْنُ سَعِيدٍ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنِ  الْحَارِثِ الْعُكْلِيِّ ،  عَنْ  أَبِي وَائِلٍ  أَنَّ  رَجُلًا  قَالَ لِعَبْدِ اللهِ بْنِ عُمَرَ : إِنَّكَ تَحُجُّ وَلَا تَغْزُو !  فَقَالَ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَصِيَامِ رَمَضَانَ ، وَحَجِّ  الْبَيْتِ  .","","Al-Mu'jam al-Kabir 13737","","عبد الله بن عمر بن الخطاب عن شقيق بن سلمة عن الحارث بن يزيد العكلي عن منصور بن زاذان الثقفي عن مستلم بن سعيد الواسطي عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عمر"
"13774","13738  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ،         [13/96]      عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى تَمْرَةً  عَائِرَةً  ، فَأَخَذَهَا فَنَاوَلَهَا  سَائِلًا  ، فَقَالَ :  أَمَا إِنَّكَ لَوْ لَمْ تَأْتِهَا لَأَتَتْكَ  .","","Al-Mu'jam al-Kabir 13738","","عبد الله بن عمر بن الخطاب عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن الأعمش عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13775","13739  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ بَشِيرِ بْنِ سَلْمَانَ ،  عَنْ  بَشِيرِ بْنِ سَلْمَانَ قَالَ :  سَمِعْتُ  قَيْسَ بْنَ أَبِي حَازِمٍ ، قَالَ :  كُنَّا عِنْدَ ابْنِ عُمَرَ  وَغُلَامٌ لَهُ  يَسْلَخُ شَاةً ، فَقَالَ لَهُ : وَيْلَكَ ! إِذَا فَرَغْتَ فَابْدَ بِجَارِنَا  الْيَهُودِيِّ  ، فَقِيلَ         [13/97]      لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، كَمْ تَذْكُرُ هَذَا الْيَهُودِيَّ ! قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يُوصِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ  .","","Al-Mu'jam al-Kabir 13739","","عبد الله بن عمر بن الخطاب عن قيس بن أبي حازم عن بشير بن سلمان عن إسماعيل بن بشير الكوفي عن عبد الله بن عمر مشكدانة عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13776","13740  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عُثْمَانَ أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ثَلَاثَةٌ عَلَى  كُثْبَانِ  الْمِسْكِ  : رَجُلٌ أَمَّ قَوْمًا وَهُمْ بِهِ رَاضُونَ ، وَرَجُلٌ دَعَا إِلَى خَمْسِ صَلَوَاتٍ فِي الْيَوْمِ وَاللَّيْلَةِ ، وَعَبْدٌ أَدَّى حَقَّ اللهِ وَحَقَّ مَوَالِيهِ  .","","Al-Mu'jam al-Kabir 13740","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن عثمان بن عمير البجلي عن سفيان الثوري عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13777","13741  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  زَاذَانَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :         [13/98]      قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لُقِّنَ لَا إِلَهَ إِلَّا اللهُ عِنْدَ مَوْتِهِ دَخَلَ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 13741","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن عطاء بن السائب عن سلام بن سليم الحنفي عن يوسف بن عدي بن رزق الكوفي عن روح بن الفرج القطان عن الطبراني","عمرو بن دينار عن ابن عمر"
"13778","13742  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  فُضَيْلِ بْنِ غَزْوَانَ ،  عَنْ  أَبِي دِهْقَانَةَ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ  بِلَالًا  أَبْدَلَ صَاعَيْنِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْدُدْهُ ، ارْدُدْهُ  .","","Al-Mu'jam al-Kabir 13742","","عبد الله بن عمر بن الخطاب عن أبو دهقانة عن فضيل بن غزوان عن عبد الله بن داود الخريبي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13779","13743  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ         [13/99]      بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  فِرَاسٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  زَاذَانَ  أَنَّ  ابْنَ عُمَرَ أَعْتَقَ مَمْلُوكًا لَهُ ،  ثُمَّ أَخَذَ مِنَ الْأَرْضِ عُودًا ، فَقَالَ : مَا لِي فِيهِ مِنَ الْأَجْرِ مَا يَسْوَى هَذَا ،  ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَطَمَ مَمْلُوكَهُ أَوْ ضَرَبَهُ  حَدًّا  لَمْ يَأْتِهِ ، فَكَفَّارَتُهُ أَنْ  يُعْتِقَهُ  .","","Al-Mu'jam al-Kabir 13743","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن ذكوان السمان عن فراس بن يحيى الخارفي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عمر"
"13780","13744  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  فِرَاسٍ نَحْوَهُ .","","Al-Mu'jam al-Kabir 13744","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن ذكوان السمان عن فراس بن يحيى الخارفي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13781","[13/100]      13745  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَبَنَا  شُعْبَةُ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ اسْتِلَامِ الْحَجَرِ ؟ قَالَ :  كُنَّا نَقْرَعُهُ بِالْعَصَا  .","","Al-Mu'jam al-Kabir 13745","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عمرو بن دينار عن ابن عمر"
"13782","13746  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَخْبَرَنَا  إِسْرَائِيلُ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ وَسَأَلَهُ  رَجُلٌ  ، فَقَالَ : إِنِّي مَرِيضٌ لَا أَسْتَطِيعُ أَنْ أَسْتَلِمَ الْحَجَرَ ؟ فَقَالَ :  كُنَّا إِذَا كُنَّا كَذَلِكَ نَقْرَعُهُ بِالْعَصَا فَنَسْتَلِمُهُ بِهَا  .","","Al-Mu'jam al-Kabir 13746","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13783","13747  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ الْعِجْلِيُّ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ  أَنَّ  رَجُلًا  ذَكَرَ لِابْنِ عُمَرَ الْحَجَرَ وَمَسْحَهُ ، يُحَالُ بَيْنَهُ وَبَيْنَهُ فَلَا يَسْتَطِيعُ أَنْ يَمْسَحَهُ ؟  فَقَالَ  عَبْدُ اللهِ  :  كُنَّا نَقْرَعُهُ بِالْعَصَا إِذَا لَمْ نَسْتَطِعْ مَسْحَهُ  .","","Al-Mu'jam al-Kabir 13747","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن زهير بن معاوية بن حديج عن عبد الله بن صالح العجلي عن لحية الليف محمد بن العباس عن الطبراني","عمرو بن دينار عن ابن عمر"
"13784","[13/101]      13748  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  فَرَضَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَلِأَهْلِ نَجْدٍ  مِنْ  قَرَنٍ  .","","Al-Mu'jam al-Kabir 13748","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13785","13749  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  حَدَّثَنِي  زَيْدُ بْنُ جُبَيْرٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ : مِنْ أَيْنَ يَجُوزُ أَنْ أَعْتَمِرَ ؟ فَقَالَ :  فَرَضَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَلِأَهْلِ نَجْدٍ  مِنْ  قَرَنٍ  .","","Al-Mu'jam al-Kabir 13749","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عمرو بن دينار عن ابن عمر"
"13786","13750  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ : مِنْ أَيْنَ أَعْتَمِرُ ؟ قَالَ :  فَرَضَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَلِأَهْلِ نَجْدٍ  مِنْ  قَرَنٍ  .","","Al-Mu'jam al-Kabir 13750","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13787","[13/102]      13751  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُشْتَرَى  الثَّمَرُ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Al-Mu'jam al-Kabir 13751","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13788","13752  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ  الثَّمَرَةِ  حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Al-Mu'jam al-Kabir 13752","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13789","13753  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الثِّمَارِ حَتَّى يَبْدُوَ صَلَاحُهَا  .","","Al-Mu'jam al-Kabir 13753","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13790","[13/103]      13754  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَقْتُلُ الْمُحْرِمُ الْحُدَيَّا ، وَالْغُرَابَ  ، وَالْكَلْبَ  الْعَقُورَ  ،  وَالْفَأْرَةَ  ، وَالْعَقْرَبَ  .","","Al-Mu'jam al-Kabir 13754","","عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13791","13755  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَبَنَا  إِسْرَائِيلُ ،  عَنْ  آدَمَ بْنِ عَلِيٍّ ، قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنِ الْأَشْرِبَةِ ، فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الدُّبَّاءِ  ،  وَالْحَنْتَمِ  ،  وَالْمُزَفَّتِ  ،  وَالنَّقِيرِ  .","","Al-Mu'jam al-Kabir 13755","","عبد الله بن عمر بن الخطاب عن آدم بن علي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن حفص الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13792","[13/104]      13756  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَبَنَا  إِسْرَائِيلُ ،  عَنْ  آدَمَ بْنِ عَلِيٍّ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  يَصِيرُ كُلُّ الْأُمَمِ يَوْمَ الْقِيَامَةِ جُثًى ، كُلُّ أُمَّةٍ مَعَ نَبِيِّهَا  ، فَيَجِيءُ النَّبِيُّ مَعَ أُمَّتِهِ فَيُرْتَقَى بِهِمْ عَلَى كَوْمٍ عَلَى الْأُمَمِ ، فَيَقُولُونَ : يَا فُلَانُ اشْفَعْ ، يَا فُلَانُ اشْفَعْ . فَيُحِيلُ بَعْضُهُمْ عَلَى بَعْضٍ ، حَتَّى يَنْتَهُونَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَلِكَ قَوْلُ اللهِ عَزَّ وَجَلَّ :         {      عَسَى أَنْ يَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا         }      .","","Al-Mu'jam al-Kabir 13756","","عبد الله بن عمر بن الخطاب عن آدم بن علي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن عثمان بن عمر الضبي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13793","[13/105]      13757  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَعْدِ بْنِ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  ثَنَا  أَبِي وَعَمِّي ،  عَنْ  أَبِيهِمَا  ،  عَنِ  ابْنِ إِسْحَاقَ ،  حَدَّثَنِي  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  آدَمَ بْنِ عَلِيٍّ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا صَلَّيْتَ فَلَا  تَبْسُطْ  ذِرَاعَيْكَ بَسْطَ السَّبُعِ  ، وَادَّعِمْ         [13/106]      عَلَى رَاحَتَيْكَ ، وَجَافِي مِرْفَقَيْكَ عَنْ ضَبْعَيْكَ  .","","Al-Mu'jam al-Kabir 13757","","عبد الله بن عمر بن الخطاب عن آدم بن علي عن مسعر بن كدام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبد الله بن سعد بن إبراهيم بن سعد الزهري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13794","13758  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، وَأَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْجَهْمِ السِّمَّرِيُّ ، قَالَا :  ثَنَا  أَبُو الْجَوْزَاءِ أَحْمَدُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  آدَمَ بْنِ عَلِيٍّ ،  سَمِعَ  ابْنَ عُمَرَ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُبَاعُ  الثَّمَرَةُ  حَتَّى تُونِعَ  .","","Al-Mu'jam al-Kabir 13758","","عبد الله بن عمر بن الخطاب عن آدم بن علي عن شعبة بن الحجاج عن أبو داود الطيالسي عن أحمد بن عثمان بن أبي عثمان أبو الجوزاء النوفلي عن أحمد بن محمد بن الجهم السمري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13795","13759  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ         [13/107]      بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو شَيْبَةَ الْقَاضِي ،  عَنْ  آدَمَ بْنِ عَلِيٍّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا هَلَكَ قَوْمٌ قَطُّ إِلَّا فِي الْأَذَانِ  ، وَلَا تَقُومُ الْقِيَامَةُ إِلَّا فِي الْأَذَانِ  .  قَالَ أَبُو الْقَاسِمِ :  مَعْنَاهُ عِنْدِي ، وَاللهُ أَعْلَمُ ، فِي وَقْتِ أَذَانِ الْفَجْرِ هُوَ وَقْتُ الِاسْتِغْفَارِ وَالدُّعَاءِ  .","","Al-Mu'jam al-Kabir 13759","","عبد الله بن عمر بن الخطاب عن آدم بن علي عن إبراهيم بن عثمان أبو شيبة العبسي عن الباغندي محمد بن سليمان الباغندي عن الحسن بن علي بن الوليد الفسوي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13796","13760  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْخَشَّابُ الرَّقِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْعَلَاءِ بْنِ عِرَارٍ ، قَالَ :  سُئِلَ ابْنُ عُمَرَ عَنْ  عَلِيٍّ  وَعُثْمَانَ  ،         [13/108]      فَقَالَ  :  أَمَّا  عَلِيٌّ  فَلَا تَسْأَلُوا عَنْهُ ، انْظُرُوا إِلَى مَنْزِلِهِ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  فَإِنَّهُ سَدَّ أَبْوَابَنَا فِي الْمَسْجِدِ وَأَقَرَّ بَابَهُ  . وَأَمَّا  عُثْمَانُ  فَإِنَّهُ أَذْنَبَ يَوْمَ الْتَقَى الْجَمْعَانِ ذَنْبًا عَظِيمًا ، فَعَفَا اللهُ عَنْهُ ، وَأَذْنَبَ فِيكُمْ ذَنْبًا دُونًا فَقَتَلْتُمُوهُ  .","","Al-Mu'jam al-Kabir 13760","","عبد الله بن عمر بن الخطاب عن العلاء بن عرار الخارفي عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أحمد بن إسحاق البلدي عن الطبراني","عمرو بن دينار عن ابن عمر"
"13797","13761  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَبْدِ اللهِ بْنِ كَثِيرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  زَاذَانَ ، قَالَ :  قُلْتُ لِابْنِ عُمَرَ :  أَخْبِرْنِي  عَمَّا نَهَى عَنْهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ الْأَوْعِيَةِ ؟ فَقَالَ :  نَهَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْحَنْتَمَةِ  ،  وَهِيَ الْجَرَّةُ  ، وَنَهَى عَنِ الْقَرْعَةِ ،         [13/109]      وَنَهَى عَنِ  النَّقِيرِ  ، وَهِيَ النَّخْلَةُ تُنْسَحُ نَسْحًا وَتُنْقَرُ نَقْرًا ، وَنَهَى عَنِ  الْمُزَفَّتِ  وَهُوَ الْمُقَيَّرُ ، وَأَمَرَ أَنْ يُشْرَبَ فِي الْأَسْقِيَةِ  .","","Al-Mu'jam al-Kabir 13761","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عبد الله بن كثير البصري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13798","13762  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  فِرَاسٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  زَاذَانَ أَبِي عُمَرَ  أَنَّ  ابْنَ عُمَرَ         [13/110]      أَعْتَقَ غُلَامًا لَهُ ،  ثُمَّ أَخَذَ عُودًا مِنَ الْأَرْضِ ، فَقَالَ : مَا لِي فِيهِ مِنَ الْأَجْرِ مَا يَسْوَى هَذَا ،  ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ لَطَمَ مَمْلُوكَهُ أَوْ ضَرَبَهُ  حَدًّا  لَمْ يَأْتِهِ  ، فَكَفَّارَتُهُ أَنْ  يُعْتِقَهُ  ""  .","","Al-Mu'jam al-Kabir 13762","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن ذكوان السمان عن فراس بن يحيى الخارفي عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عمرو بن دينار عن ابن عمر"
"13799","13763  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَبَنَا  شَرِيكٌ ،  عَنْ  فِرَاسٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  زَاذَانَ قَالَ :  كُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ ، فَمَرَّ غُلَامٌ لَهُ ، فَقَالَ :  أَنْتَ  حُرٌّ  ، أَوْ قَالَ : أَنْتَ لِلهِ  ، ثُمَّ رَفَعَ عُودًا مِنَ الْأَرْضِ ، فَقَالَ :  مَا لِي فِيهِ مِنْ أَجْرِهِ مِثْلُ هَذَا  .  قُلْتُ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ؟! قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ ظَلَمَ أَوْ جَلَدَ عَبْدَهُ  حَدًّا  لَمْ يَأْتِهِ  ، فَإِنَّ كَفَّارَةَ ذَلِكَ أَنْ  يُعْتِقَهُ  ""  .","","Al-Mu'jam al-Kabir 13763","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن ذكوان السمان عن فراس بن يحيى الخارفي عن شريك بن عبد الله النخعي عن علي بن الجعد عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","عمرو بن دينار عن ابن عمر"
"13800","13764  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ التُّرْكِيُّ ،  ثَنَا  ابْنُ عَائِشَةَ ،  ثَنَا         [13/111]      صَفْوَانُ بْنُ عِيسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ قَالَ :  كُنْتُ عِنْدَ الْأَعْمَشِ ، فَجَعَلَتِ الذِّبَّانُ يَسْقُطْنَ عَلَى عَيْنَيْهِ ، فَجَعَلَ يَذُبُّهُنَّ وَيَرْجِعْنَ ، فَقَالَ : يَا  إِسْمَاعِيلُ  ، مَا تَحْفَظُ فِي  الذُّبَابِ  ؟ فَقَالَ : أَحْفَظُ أَنَّ عُمُرَ  الذُّبَابِ  أَرْبَعِينَ يَوْمًا ، فَكَأَنِّي لَمْ أَشْفِهِ فِيهِنَّ ، فَقَالَ :  حَدَّثَنِي         [13/112]      خَيْثَمَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ أَوْ قَالَ : ابْنِ عَمْرٍو  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الذُّبَابُ  كُلُّهُ فِي النَّارِ إِلَّا النَّحْلَ  .","","Al-Mu'jam al-Kabir 13764","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن صفوان بن عيسى عباية عن ابن عائشة عن ابن التركي محمد بن يوسف عن الطبراني","عمرو بن دينار عن ابن عمر"
