"2226","(۲۲۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ السُّلَمِیِّ ، قَالَ : رَأَیْتُ رِبْعِیَّ بْنَ حِرَاشٍ یُؤَذِّنُ عَلَی بِرْذَوْنٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2226","","","كتاب الأذان والإقامة"
"2227","(۲۲۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُؤَذِّنَ الرَّجُلُ وَیُقِیمَ عَلَی رَاحِلَتِہِ ، ثُمَّ یَنْزِلَ فَیُصَلِّیَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2227","","","كتاب الأذان والإقامة"
"2228","(۲۲۲۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِاللہِ بْنِ عُمَرَ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یُؤَذِّنُ عَلَی الْبَعِیرِ، وَیَنْزِلُ فَیُقِیمُ۔","Sahih","Musannaf Ibn Abi Shaybah 2228","","","كتاب الأذان والإقامة"
"2229","(۲۲۲۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ الْخَیَّاطُ ، عَنِ الْعُمَرِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْمُجَبِّرِ ، قَالَ : رَأَیْتُ سَالِمًا یَقُومُ عَلَی غَرْزِ الرَّحْلِ فَیُؤَذِّنُ۔","","Musannaf Ibn Abi Shaybah 2229","","","كتاب الأذان والإقامة"
"2230","(۲۲۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکِ الْہُنَائِیِّ ، عَنِ الْحَسَنِ الْعَبْدِیِّ ، قَالَ : رَأَیْتُ أَبَا زَیْدٍ ، صَاحِبَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَتْ رِجْلُہُ أُصِیبَتْ فِی سَبِیلِ اللہِ ، یُؤَذِّنُ وَہُوَ قَاعِدٌ۔","Hasan","Musannaf Ibn Abi Shaybah 2230","","","كتاب الأذان والإقامة"
"2231","(۲۲۳۱) حَدَّثَنَا حًفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُؤَذِّنَ الرَّجُلَ وَہُوَ قَاعِدٌ۔","","Musannaf Ibn Abi Shaybah 2231","","","كتاب الأذان والإقامة"
"2232","(۲۲۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ أَنْ یُؤَذِّنَ وَہُوَ قَاعِدٌ ، إِلاَّ مِنْ عُذْرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2232","","","كتاب الأذان والإقامة"
"2233","(۲۲۳۳) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : یُؤَذِّنُ الرَّجُلُ وَہُوَ قَاعِدٌ ؟ قَالَ : لاَ، إِلاَّ مِنْ عِلَّۃٍ ، قُلْتُ : فَمِنْ نُعَاسٍ أَوْ کَسَلٍ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 2233","","","كتاب الأذان والإقامة"
"2234","(۲۲۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ شَدَّادٍ مَوْلَی عِیَاضِ بْنِ عَامِرٍ ، عَنْ بِلاَلٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تُؤَذِّنْ حَتَّی تَرَی الْفَجْرَ ہَکَذَا ، وَمَدَّ یَدَیْہِ۔ (ابوداؤد ۵۳۵۔ طبرانی ۱۱۲۱)","Majhul","Musannaf Ibn Abi Shaybah 2234","","","كتاب الأذان والإقامة"
"2235","(۲۲۳۵) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ سُوَیْدٍ، عَنْ بِلاَلٍ، قَالَ: کَانَ لاَ یُؤَذِّنُ حَتَّی یَنْشَقَّ الْفَجْرُ۔","","Musannaf Ibn Abi Shaybah 2235","","","كتاب الأذان والإقامة"
"2236","(۲۲۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی مَحْذُورَۃَ ؛ أَنَّہُ أَذَّنَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلأَبِی بَکْرٍ ، وَعُمَرَ ، فَکَانَ لاَ یُؤَذِّنُ حَتَّی یَطْلُعَ الْفَجْرُ۔","","Musannaf Ibn Abi Shaybah 2236","","","كتاب الأذان والإقامة"
"2237","(۲۲۳۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا کَانُوا یُؤَذِّنُونَ حَتَّی یَنْفَجِرَ الْفَجْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 2237","","","كتاب الأذان والإقامة"
"2238","(۲۲۳۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عَلِیِّ بْنِ عَلِیٍّ ، عَنْ إِبْرَاہِیمَ ، قَالَ : شَیَّعْنَا عَلْقَمَۃَ إِلَی مَکَّۃَ ، فَخَرَجْنَا بِلَیْلٍ ، فَسَمِعَ مُؤَذِّنًا یُؤَذِّنُ ، فَقَالَ : أَمَّا ہَذَا فَقَدْ خَالَفَ سُنَّۃَ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، لَوْ کَانَ نَائِمًا کَانَ أَخْیَرَ لَہُ ، فَإِذَا طَلَعَ الْفَجْرُ أَذَّنَ۔","Majhul","Musannaf Ibn Abi Shaybah 2238","","","كتاب الأذان والإقامة"
"2239","(۲۲۳۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُلَیْمَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یُؤَذِّنَ قَبْلَ الْفَجْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2239","","","كتاب الأذان والإقامة"
"2240","(۲۲۴۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ عُبید اللہ ، قَالَ : قُلْتُ لِنَافِعٍ : إِنَّہُمْ کَانُوا یُنَادُونَ قَبْلَ الْفَجْرِ ؟ قَالَ : مَا کَانَ النِّدَائُ إِلاَّ مَعَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 2240","","","كتاب الأذان والإقامة"
"2241","(۲۲۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ، قَالَ: شَکُّوا فِی طُلُوعِ الْفَجْرِ فِی عَہْدِ ابْنِ عَبَّاسٍ، فَأَمَرَ مُؤَذِّنَہُ فَأَقَامَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 2241","","","كتاب الأذان والإقامة"
"2242","(۲۲۴۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنِ ابْنِ سَالِمٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یُؤَذِّنُ لِلصَّلاَۃِ حَتَّی یَدْخُلَ وَقْتُہَا۔","","Musannaf Ibn Abi Shaybah 2242","","","كتاب الأذان والإقامة"
"2243","(۲۲۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ قَالاَ : إِذَا أَذَّنَ الْمُؤَذِّنُ اسْتَقْبَلَ الْقِبْلَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2243","","","كتاب الأذان والإقامة"
"2244","(۲۲۴۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ قَالَ فِی الْمُؤَذِّنِ : یَضُمُّ رِجْلَیْہِ وَیَسْتَقْبِلُ الْقِبْلَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2244","","","كتاب الأذان والإقامة"
"2245","(۲۲۴۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَسْتَقْبِلُ الْمُؤَذِّنُ بِأَوَّلِ أَذَانِہِ وَالشَّہَادَۃِ وَالإِقَامَۃِ : الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 2245","","","كتاب الأذان والإقامة"
"2246","(۲۲۴۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُ کَانَ یُعْجِبُہُمَا إِذَا أَذَّنَ الْمُؤَذِّنُ أَنْ یَسْتَقْبِلَ الْقِبْلَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2246","","","كتاب الأذان والإقامة"
"2247","(۲۲۴۷) حَدَّثَنَا مَالِکُ بْنُ إِسْمَاعِیلَ ، قَالَ : حَدَّثَنَا زُہَیْرٌ ، قَالَ : حَدَّثَنَا أَبُو مَطَر الْجُعْفِیُّ ، قَالَ : أَذَّنْتُ مِرَارًا ، فَقَالَ لِی سُوَیْدٌ : إِذَا أَذَّنْتَ فَاسْتَقْبِلِ الْقِبْلَۃَ ، فَإِنَّہُ مِنَ السُّنَّۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 2247","","","كتاب الأذان والإقامة"
"2248","(۲۲۴۸) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ أَبِیہِ ، عَنْ أَبِی الزُّبَیْرِ مُؤَذِّنِ بَیْتِ الْمَقْدِسِ ، قَالَ : جَائَنَا عُمَرُ بْنُ الْخَطَّابِ ، فَقَالَ : إِذَا أَذَّنْتَ فَتَرَسَّلْ ، وَإِذَا أَقَمْتَ فَاحْذِمْ۔","Majhul","Musannaf Ibn Abi Shaybah 2248","","","كتاب الأذان والإقامة"
"2249","(۲۲۴۹) حَدَّثَنَا شَرِیکٌ ، عَنْ عُثْمَانَ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یُرتِّل الأَذَانَ ، وَیَحْدُرُ الإِقَامَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 2249","","","كتاب الأذان والإقامة"
"2250","(۲۲۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَعَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالَ : کَانَ یُعْجِبُہُمَا إِذَا أَخَذَ الْمُؤَذِّنُ فِی الإِقَامَۃِ أَنْ یَمْضِیَ وَلاَ یَتَرَسَّلُ۔","","Musannaf Ibn Abi Shaybah 2250","","","كتاب الأذان والإقامة"
"2251","(۲۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَحْذِفُ الإِقَامَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 2251","","","كتاب الأذان والإقامة"
"2252","(۲۲۵۲) حَدَّثَنَا مَالِکٌ ، قَالَ : حَدَّثَنَا جعفر الأَحْمَرُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُرَتِّلُ فِی الأَذَانِ ، وَیُتْبِعُ الإِقَامَۃَ بَعْضَہَا بَعْضاً۔","","Musannaf Ibn Abi Shaybah 2252","","","كتاب الأذان والإقامة"
"2253","(۲۲۵۳) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، وَمُسْلِمِ بْنِ أَبِی مَرْیَمَ ؛ أَنَّ عَلِیَّ بْنَ حُسَیْنٍ کَانَ یُؤَذِّنُ، فَإِذَا بَلَغَ : حَیَّ عَلَی الْفَلاَحِ ، قَالَ : حَیَّ عَلَی خَیْرِ الْعَمَلِ ، وَیَقُولُ : ہُوَ الأَذَانُ الأَوَّلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2253","","","كتاب الأذان والإقامة"
"2254","(۲۲۵۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ فِی أَذَانِہِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، وَرُبَّمَا قَالَ : حَیَّ عَلَی خَیْرِ الْعَمَلِ۔","","Musannaf Ibn Abi Shaybah 2254","","","كتاب الأذان والإقامة"
"2255","(۲۲۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ رُبَّمَا زَادَ فِی أَذَانِہِ : حَیَّ عَلَی خَیْرِ الْعَمَلِ۔","Sahih","Musannaf Ibn Abi Shaybah 2255","","","كتاب الأذان والإقامة"
"2256","(۲۲۵۶) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : رَأَیْتُ أَبَا مَحْذُورَۃَ ، جَائَ وَقَدْ أَذَّنَ إِنْسَانٌ ، فَأَذَّنَ ہُوَ وَأَقَامَ۔","Sahih","Musannaf Ibn Abi Shaybah 2256","","","كتاب الأذان والإقامة"
"2257","(۲۲۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ شَیْخٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنْ بَعْضِ بَنِی مُؤَذِّنِی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کَانَ ابْنُ أُمِّ مَکْتُومٍ یُؤَذِّنُ ، وَیُقِیمُ بِلاَلٌ ، وَرُبَّمَا أَذَّنَ بِلاَلٌ ، وَأَقَامَ ابْنُ أُمِّ مَکْتُومٍ۔ n(ابن سعد ۲۰۷)","Majhul","Musannaf Ibn Abi Shaybah 2257","","","كتاب الأذان والإقامة"
"2258","(۲۲۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَذِّنَ الرَّجُلُ ، وَیُقِیمَ غَیْرُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2258","","","كتاب الأذان والإقامة"
"2259","(۲۲۵۹) حَدَّثَنَا أَبُو أُسَامَۃُ ، عَنِ الْفَزَارِیِّ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّمَا یُقِیمُ مَنْ أَذَّنَ۔","","Musannaf Ibn Abi Shaybah 2259","","","كتاب الأذان والإقامة"
"2260","(۲۲۶۰) حَدَّثَنَا یَعْلَی ، قَالَ : حَدَّثَنَا الإِفْرِیقِیُّ ، عَنْ زِیَادِ بْنِ نُعَیْمٍ الْحَضْرَمِیِّ ، عَنْ زِیَادِ بْنِ الْحَارِثِ الصُّدَائِیِّ ، قَالَ : کُنْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَأَمَرَنِی فَأَذَّنْتُ ، فَأَرَادَ بِلاَلٌ أَنْ یُقِیمَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ أَخَا صُدَائٍ أَذَّنَ ، وَمَنْ أَذَّنَ فَہُوَ یُقِیمُ ، فَأَقَمْتُ۔ (ابوداؤد ۵۱۵۔ ترمذی ۱۹۹)","Da'if","Musannaf Ibn Abi Shaybah 2260","","","كتاب الأذان والإقامة"
"2261","(۲۲۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ حَنْظَلَۃَ، عَنْ خَالِدٍ، قَالَ: کَانَ ابْنُ عُمَرَ إِذَا أَذَّنَ جَلَسَ، حَتَّی تَمَسَّ مَقْعَدَتُہُ الأَرْضَ۔","Majhul","Musannaf Ibn Abi Shaybah 2261","","","كتاب الأذان والإقامة"
"2262","(۲۲۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : حَدَّثَنَا أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ بِلاَلاً أَذَّنَ مَثْنَی ، وَأَقَامَ مَثْنَی ، وَقَعَدَ قَعْدَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 2262","","","كتاب الأذان والإقامة"
"2263","(۲۲۶۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مَنْصُورِ بْنِ أَبِی الأَسْوَدِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَقْعُدُ الْمُؤَذِّنُ فِی الْمَغْرِبِ فِیمَا بَیْنَ الأَذَانِ وَالإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2263","","","كتاب الأذان والإقامة"
"2264","(۲۲۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ ابْنَ أُمِّ مَکْتُومٍ کَانَ یُؤَذِّنُ وَہُوَ أَعْمَی۔n(مسلم ۲۸۷۔ ابوداؤد ۵۳۶)","Sahih","Musannaf Ibn Abi Shaybah 2264","","","كتاب الأذان والإقامة"
"2265","(۲۲۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ ابْنَ أُمِّ مَکْتُومٍ کَانَ یُؤَذِّنُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ أَعْمَی۔","","Musannaf Ibn Abi Shaybah 2265","","","كتاب الأذان والإقامة"
"2266","(۲۲۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ الأَحْدَبِ ، عَنْ قَبِیصَۃَ بْنِ بُرْمَۃَ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ ، یَقُولُ : مَا أُحِبُّ أَنْ یَکُونَ مُؤَذِّنُوکُمْ عُمْیَانَکُمْ ، قَالَ : وَحَسِبْتُہُ قَالَ ، وَلاَ قُرَّاؤُکُمْ","Sahih","Musannaf Ibn Abi Shaybah 2266","","","كتاب الأذان والإقامة"
"2267","(۲۲۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ عُقْبَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَ إِقَامَۃَ الأَعْمَی۔","","Musannaf Ibn Abi Shaybah 2267","","","كتاب الأذان والإقامة"
"2268","(۲۲۶۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنْ أَبِی عَرُوبَۃَ ؛ أَنَّ ابْنَ الزُّبَیْرِ کَانَ یَکْرَہُ أَنْ یُؤَذِّنَ الْمُؤَذِّنُ وَہُوَ أَعْمَی۔","Majhul","Musannaf Ibn Abi Shaybah 2268","","","كتاب الأذان والإقامة"
"2269","(۲۲۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُؤَذِّنَانِ : بِلاَلٌ ، وَابْنُ أُمِّ مَکْتُومٍ۔ (مسلم ۲۸۷۔ دارمی ۱۱۹۱)","Sahih","Musannaf Ibn Abi Shaybah 2269","","","كتاب الأذان والإقامة"
"2270","(۲۲۷۰) حَدَّثَنَا یُونُسُ بْنُ محمد ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : کَانَ مُؤَذِّنُ إِبْرَاہِیمَ أَعْمَی۔","","Musannaf Ibn Abi Shaybah 2270","","","كتاب الأذان والإقامة"
"2271","(۲۲۷۱) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ ، عَنِ ابْنِ أَخِی الزُّہْرِیِّ ، عَنْ عَمِّہِ ، عَنْ مُحَمَّدِ بْنِ جُبَیْرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَکُنْ یُؤَذِّنُ فِی شَیْئٍ مِنَ الصَّلاَۃِ فِی السَّفَرِ إِلاَّ بِإِقَامَۃٍ ، إِلاَّ فِی صَلاَۃِ الصُّبْحِ، فَإِنَّہُ کَانَ یُؤَذِّنُ وَیُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2271","","","كتاب الأذان والإقامة"
"2272","(۲۲۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نافع ؛ أَنَّ ابْنَ عُمَرَ ، کَانَ یُقِیمُ فِی السَّفَرِ ، إِلاَّ فِی صَلاَۃِ الْفَجْرِ ، فَإِنَّہُ کَانَ یُؤَذِّنُ وَیُقِیمُ۔","Sahih","Musannaf Ibn Abi Shaybah 2272","","","كتاب الأذان والإقامة"
"2273","(۲۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ مَالِکِ بْنِ الْحُوَیْرِثِ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعِی ابْنُ عَمٍّ لِی ، فَقَالَ : إِذَا سَافَرْتُمَا فَأَذِنَّا وَأَقِیمَا ، وَلْیَؤُمَّکُمَا أَکْبَرُکُمَا۔n(بخاری ۶۲۸۔ مسلم ۲۹۳)","Sahih","Musannaf Ibn Abi Shaybah 2273","","","كتاب الأذان والإقامة"
"2274","(۲۲۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یُؤْمَرُونَ فِی السَّفَرِ أَنْ یُؤَذِّنُوا وَیُقِیمُوا ، وَأَنْ یَؤُمَّہُمْ أَقْرَؤُہُمْ۔","","Musannaf Ibn Abi Shaybah 2274","","","كتاب الأذان والإقامة"
"2275","(۲۲۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : تُجْزِئُہُ الإِقَامَۃُ إِلاَّ فِی الْفَجْرِ ، فَإِنَّہُمْ کَانُوا یَقُولُونَ : یُؤَذِّنُ وَیُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2275","","","كتاب الأذان والإقامة"
"2276","(۲۲۷۶) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : قَالَ عُرْوَۃُ : إِذَا کُنْتَ فِی سَفَرٍ فَأَذِّنْ وَأَقِمْ ، وَإِنْ شِئْتَ فَأَقِمْ وَلاَ تُؤَذِّنْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2276","","","كتاب الأذان والإقامة"
"2277","(۲۲۷۷) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : تُجْزِئُہُ الإِقَامَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2277","","","كتاب الأذان والإقامة"
"2278","(۲۲۷۸) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا کُنْتَ فِی بَیْتِکَ ، أَوْ فِی سَفَرِکَ أَجْزَأَتْکَ الإِقَامَۃُ ، وَإِنْ شِئْتَ أَذَّنْتَ ، غَیْرَ أَنْ لاَ تَدَعَ أَنْ تُثَنِّیَ الإِقَامَۃَ۔","","Musannaf Ibn Abi Shaybah 2278","","","كتاب الأذان والإقامة"
"2279","(۲۲۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ سُئِلَ عَنِ الْمُسَافِرِینَ یُؤَذِّنُونَ وَیُقِیمُونَ ؟ قَالَ : تُجْزِئہُمُ الإِقَامَۃُ ، إِلاَّ أَنْ یَکُونُوا مُتَفَرِّقِینَ ، فَیُرِیدُ أَنْ یَجْمَعَہُمْ فَیُؤَذِّنُ وَیُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2279","","","كتاب الأذان والإقامة"
"2280","(۲۲۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : أَقَمْتُ مَعَ مَکْحُولٍ بِدَابِقٍ خَمْسَۃَ عَشَرَۃ ، فَلَمْ یَکُنْ یَزِیدُ عَلَی الإِقَامَۃِ وَلاَ یُؤَذِّنُ۔","","Musannaf Ibn Abi Shaybah 2280","","","كتاب الأذان والإقامة"
"2281","(۲۲۸۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : إِذَا اجْتَمَعَ الْقَوْمُ فِی السَّفَرِ ، وَکَانَ مَنْزِلُہُمْ جَمِیعًا فَتُجْزِئہُمُ الإِقَامَۃُ۔","","Musannaf Ibn Abi Shaybah 2281","","","كتاب الأذان والإقامة"
"2282","(۲۲۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا مَعَ أَبِی مُوسَی ، بِعَیْنِ التَّمْرِ فِی دَارِ الْبَرِیدِ ، فَأَذَّنَ وَأَقَامَ ، فَقُلْنَا لَہُ : لو خَرَجْتَ إِلَی الْبَرِیَّۃِ ؟فَقَالَ : ذَاکَ وَذَا سَوَاء ٌ۔","Majhul","Musannaf Ibn Abi Shaybah 2282","","","كتاب الأذان والإقامة"
"2283","(۲۲۸۳) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ نَسِیَ الإِقَامَۃَ فِی السَّفَرِ ، قَالَ : یُجْزِئُہُ ۔","","Musannaf Ibn Abi Shaybah 2283","","","كتاب الأذان والإقامة"
"2284","(۲۲۸۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی مُسَافِرٍ نَسِیَ ، فَصَلَّی بِغَیْرِ أَذَانٍ وَلاَ إِقَامَۃٍ ، قَالَ : یُجْزِئُہُ، وَکَانَ یَقُولُ فِی الْمُقِیمِ مِثْلَ ذَلِکَ","","Musannaf Ibn Abi Shaybah 2284","","","كتاب الأذان والإقامة"
"2285","(۲۲۸۵) حَدَّثَنَا ابن فُضَیْلٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا نَسِیَ الإِقَامَۃَ فِی السَّفَرِ أَجْزَأَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2285","","","كتاب الأذان والإقامة"
"2286","(۲۲۸۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ عَطَائٍ ، قَالَ : إِذَا کُنْتَ فِی سَفَرٍ فَلَمْ تُؤَذِّنْ وَلَمْ تُقِمْ، فَأَعِدِ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 2286","","","كتاب الأذان والإقامة"
"2287","(۲۲۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لیث ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا نَسِیَ الإِقَامَۃَ فِی السَّفَرِ أَعَادَ۔","","Musannaf Ibn Abi Shaybah 2287","","","كتاب الأذان والإقامة"
"2288","(۲۲۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ (ح) وَعَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ نَسِیَ الإِقَامَۃَ ، قَالَ : یُعِیدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2288","","","كتاب الأذان والإقامة"
"2289","(۲۲۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ صَلاَۃَ إِلاَّ بِإِقَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2289","","","كتاب الأذان والإقامة"
"2290","(۲۲۹۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : قَالَ عَلِیٌّ : أَیُّمَا رَجُلٍ خَرَجَ إِلَی أَرْضِ قِیٍّ ، فَحَضَرَتِ الصَّلاَۃُ ، فَلْیَتَخَیَّرْ أَطْیَبَ الْبِقَاعِ وَأَنْظَفَہَا ، فَإِنَّ کُلَّ بُقْعَۃٍ تُحِبُّ أَنْ یُذْکَرَ اللَّہُ فِیہَا ، فَإِنْ شَائَ أَذَّنَ وَأَقَامَ ، وَإِنْ شَائَ أَقَامَ إِقَامَۃً وَاحِدَۃً وَصَلَّی۔","","Musannaf Ibn Abi Shaybah 2290","","","كتاب الأذان والإقامة"
"2291","(۲۲۹۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ ، قَالَ : لاَ یَکُونُ رَجُلٌ بِأَرْضِ قِیٍّ فَیَتَوَضَّأُ ، فَإِنْ لَمْ یَجِدْ مَائً تَیَمَّمَ ، ثُمَّ یُنَادِی بِالصَّلاَۃِ ، ثُمَّ یُقِیمُہَا ، إِلاَّ أَمَّ مِنْ جُنُودِ اللہِ مَا لاَ یُرَی طَرَفَاہُ۔n(بیہقی ۴۰۶۔ عبدالرزاق ۱۹۵۵)","Sahih","Musannaf Ibn Abi Shaybah 2291","","","كتاب الأذان والإقامة"
"2292","(۲۲۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی ہَارُونَ الْغَنَوِیِّ ، قَالَ : حَدَّثَنَا أَبُو عُثْمَانَ ، قَالَ : قَالَ سَلْمَانُ : مَا کَانَ رَجُلٌ فِی أَرْضِ قِیٍّ فَأَذَّنَ وَأَقَامَ ، إِلاَّ صَلَّی خَلْفَہُ مِنْ خَلْقِ اللہِ مَا لاَ یُرَی طَرَفَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2292","","","كتاب الأذان والإقامة"
"2293","(۲۲۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ ؛ فِی الرَّجُلِ یُصَلِّی وَحْدَہُ : یُؤَذِّنُ وَیُقِیمُ۔n وَقَالَ ابْنُ سِیرِینَ : عَنْ رَجُلٍ کَانَ یُفَقَّہُ : یُقِیمُ وَلاَ یُؤَذِّنُ إِلاَّ فِی صَلاَۃِ الصُّبْحِ ، فَإِنَّہُ یُؤَذِّنُ فِیہَا وَیُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2293","","","كتاب الأذان والإقامة"
"2294","(۲۲۹۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَرَوْنَ إِذَا صَلَّی فِی الْمِصْرِ وَحْدَہُ ، فَإِنَّہُ تُجْزِئُہُ الإِقَامَۃُ ، إِلاَّ فِی الْفَجْرِ ، فَإِنَّہُ یُؤَذِّنُ وَیُقِیمُ۔n قَالَ : وَکَانَ ابْنُ سِیرِینَ ، یَقُولُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 2294","","","كتاب الأذان والإقامة"
"2295","(۲۲۹۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ ؛ أَنَّ رَجُلاً قَالَ لَہُ : إِذَا کُنْتُ وَحْدِی أُؤَذِّنُ وَأُقِیمُ ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2295","","","كتاب الأذان والإقامة"
"2296","(۲۲۹۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : سَأَلْتُہُ إِذَا کُنْتُ وَحْدِی عَلَیَّ أَذَانٌ ؟ قَالَ : نَعَمْ ، أَذِّنْ وَأَقِمْ۔","","Musannaf Ibn Abi Shaybah 2296","","","كتاب الأذان والإقامة"
"2297","(۲۲۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی یُؤَذِّنُ لِنَفْسِہِ وَیُقِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2297","","","كتاب الأذان والإقامة"
"2298","(۲۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَاصِمٍ الثَّقَفِیِّ ، قَالَ : حَدَّثَنَا عَطَائٌ ، قَالَ : دَخَلْتُ مَعَ عَلِیِّ بْنِ الْحُسَیْنِ عَلَی جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : فَحَضَرَتِ الصَّلاَۃُ فَأَذَّنَ وَأَقَامَ۔","Sahih","Musannaf Ibn Abi Shaybah 2298","","","كتاب الأذان والإقامة"
"2299","(۲۲۹۹) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُصَلِّی فِی بَیْتِہِ بِإِقَامَۃِ النَّاسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2299","","","كتاب الأذان والإقامة"
"2300","(۲۳۰۰) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : إِذَا صَلَّی الرَّجُلُ فِی بَیْتِہِ کَفَتْہُ الإِقَامَۃُ۔","","Musannaf Ibn Abi Shaybah 2300","","","كتاب الأذان والإقامة"
"2301","(۲۳۰۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُصَلِّی فِی بَیْتِہِ عَلَی غَیْرِ إِقَامَۃٍ ، قَالَ : إِنْ أَقَامَ فَہُوَ أَفضل ، وَإِنْ لَمْ یَفْعَلْ أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 2301","","","كتاب الأذان والإقامة"
"2302","(۲۳۰۲) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : بَلَغَنَا أَنَّ رِجَالاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، کَانَ أَحَدُہُمْ إذَا صَلَّی فِی دَارِہِ أَذَّنَ بِالأَولَی ، وَالإِقَامَۃِ فِی کُلِّ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 2302","","","كتاب الأذان والإقامة"
"2303","(۲۳۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، وَعَلْقَمَۃَ ، قَالاَ : أَتَیْنَا عَبْدَ اللہِ فِی دَارِہِ ، فَقَالَ : أَصَلَّی ہَؤُلاَئِ خَلْفَکُمْ ؟ قُلْنَا : لاَ ، قَالَ : فَقُومُوا فَصَلُّوا ، فَلَمْ یَأْمُرْ بِأَذَانٍ ، وَلاَ إقَامَۃٍ۔n(مسلم ۳۷۸۔ نسائی ۶۱۸)","","Musannaf Ibn Abi Shaybah 2303","","","كتاب الأذان والإقامة"
"2304","(۲۳۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ وَاقِدٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یُقِیمُ فِی أَرْضٍ تُقَامُ بِہَا الصَّلاَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 2304","","","كتاب الأذان والإقامة"
"2305","(۲۳۰۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَلَمَۃَ أَبِی بِشْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا صَلَّیْت فِی مَنْزِلِکَ أَجْزَأَک مُؤَذِّنُ الْحَیِّ۔","","Musannaf Ibn Abi Shaybah 2305","","","كتاب الأذان والإقامة"
"2306","(۲۳۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کُنْتَ فِی مِصْرکَ ، أَجْزَأَک إقَامَتُہُمْ۔","","Musannaf Ibn Abi Shaybah 2306","","","كتاب الأذان والإقامة"
"2307","(۲۳۰۷) حَدَّثَنَا أَبُو سَلَمَۃَ ، عَنِ أَبِی الضُّحَی ، عَنِ الشَّعْبِیِّ ، قَالَ : یُجْزِئُہُ إقَامَۃُ الْمِصْرِ۔","","Musannaf Ibn Abi Shaybah 2307","","","كتاب الأذان والإقامة"
"2308","(۲۳۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ دَلْہَمِ بْنِ صَالِحٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی سَفَرٍ فَسَمِعَ إقَامَۃَ مُؤَذِّنٍ فَصَلَّی بِأَصْحَابِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2308","","","كتاب الأذان والإقامة"
"2309","(۲۳۰۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنْ أَبَاہُ صَلَّی فِی بَیْتِہِ مِنْ عُذْرٍ بِإِقَامَۃِ النَّاسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2309","","","كتاب الأذان والإقامة"
"2310","(۲۳۱۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا سَمِعْتَ الإِقَامَۃَ وَأَنْتَ فِی بَیْتِکَ ، کَفَتْک إِنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 2310","","","كتاب الأذان والإقامة"
"2311","(۲۳۱۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنِ الْمُنْذِرِ بْنِ ثَعْلَبَۃَ ، قَالَ : سَأَلْتُ أَبَا مِجْلَزٍ فَقُلْتُ : أَنَا فِی قَرْیَۃٍ تُقَامُ فِیہَا الصَّلاَۃُ فِی جَمَاعَۃٍ ، فَإِنْ صَلَّیْت وَحْدِی أُؤَذِّنُ وَأُقِیمُ ؟ قَالَ : إِنْ شِئْتَ کَفَاکَ أَذَانُ الْعَامَّۃِ ، وَإِنْ شِئْتَ فَأَذِّنْ وَأَقِمْ۔","","Musannaf Ibn Abi Shaybah 2311","","","كتاب الأذان والإقامة"
"2312","(۲۳۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ الْجَعْدِ أَبِی عُثْمَانَ، عَنْ أَنَسٍ؛ أَنَّہُ دَخَلَ الْمَسْجِدَ وَقَدْ صَلَّوْا فَأَمَرَ رَجُلاً فَأَذَّنَ وَأَقَامَ۔","Sahih","Musannaf Ibn Abi Shaybah 2312","","","كتاب الأذان والإقامة"
"2313","(۲۳۱۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَطَائٍ ، وَمُجَاہِدٍ قَالُوا : إذَا دَخَلْت مَسْجِدًا وَقَدْ أُقِیمَتْ فِیہِ الصَّلاَۃُ ، أَوْ لَمْ تَقُمْ ، فَأَقِمْ ثُمَّ صَلِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 2313","","","كتاب الأذان والإقامة"
"2314","(۲۳۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُؤَذِّنُ وَیُقِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2314","","","كتاب الأذان والإقامة"
"2315","(۲۳۱۵) حَدَّثَنَا أَبُو دَاوُد ، عَنْ مُحَمَّدِ بْنِ سُلَیْمٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الْقَوْمِ یَنْتَہُونَ إلَی الْمَسْجِدِ وَقَدْ صُلِّیَ فِیہِ ، قَالَ : یُؤَذِّنُونَ وَیُقِیمُونَ ، وَقَالَ : قتَادَۃُ : لاَ یَأْتِیک مِنْ شَہَادَۃِ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ إِلاَّ خَیْرٌ۔","","Musannaf Ibn Abi Shaybah 2315","","","كتاب الأذان والإقامة"
"2316","(۲۳۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ یَزِیدَ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّہُ سَأَلَ رَجُلٌ قَالَ : دَخَلْتُ الْمَسْجِدَ وَقَدْ صَلَّی أَہْلُہُ ، أَأُؤَذِّنُ ؟ قَالَ : قَدْ کُفِیت ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 2316","","","كتاب الأذان والإقامة"
"2317","(۲۳۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ یَنْتَہِی إلَی الْمَسْجِدِ وَقَدْ صُلِّیَ فِیہِ ، قَالَ : لاَ یُؤَذِّنُ ، وَلاَ یُقِیمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2317","","","كتاب الأذان والإقامة"
"2318","(۲۳۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : دَخَلْت مَعَ إبْرَاہِیمَ مَسْجِدَ مُحَارِبٍ ، فَأَمَّنِی وَلَمْ یُؤَذِّنْ وَلَمْ یُقِمْ۔","","Musannaf Ibn Abi Shaybah 2318","","","كتاب الأذان والإقامة"
"2319","(۲۳۱۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ رَجُلاً جَائَ إلَی الْمَسْجِدِ وَقَدْ صَلَّوْا فَذَہَبَ یُقِیمُ ، فَقَالَ لَہُ عُرْوَۃُ : مَہْ ، فَإِنَّا قَدْ أَقَمْنَا۔","","Musannaf Ibn Abi Shaybah 2319","","","كتاب الأذان والإقامة"
"2320","(۲۳۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرائِل ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَمُجَاہِدٍ ، وَعِکْرِمَۃَ ق??الُوا : إذَا دَخَلَ الْمَسْجِدَ وَقَدْ صُلِّیَ فِیہِ فَلاَ یُؤَذِّنُ وَلاَ یُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2320","","","كتاب الأذان والإقامة"
"2321","(۲۳۲۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : أَذَّنَ بِلاَلٌ بِلَیْلٍ ، فَأَمَرَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُنَادِیَ : نَامَ الْعَبْدُ ، فَرَجَعَ فَنَادَی : نَامَ الْعَبْدُ ، وَہُوَ یَقُولُ : nلَیْتَ بِلاَلاً لَمْ تَلِدْہُ أُمُّہُnوَابْتَلَّ مِنْ نَضْحِ دَمٍ جَبِینُہُnقَالَ : وَبَلَغَنَا أَنَّہُ أَمَرَہُ أَنْ یُعِیدَ الأَذَانَ۔ (دار قطنی ۵۴۔ ۵۵)","Da'if","Musannaf Ibn Abi Shaybah 2321","","","كتاب الأذان والإقامة"
"2322","(۲۳۲۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ نَافِعٍ ؛ أَنَّ مُؤَذِّنًا لِعُمَرَ یُقَالُ لَہُ : مَسْرُوحٌ أَذَّنَ قَبْلَ الْفَجْرِ ، فَأَمَرَہُ عُمَرُ أَنْ یُعِیدَ۔","","Musannaf Ibn Abi Shaybah 2322","","","كتاب الأذان والإقامة"
"2323","(۲۳۲۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : کَانَ الْحَسَنُ إذَا ذُکِرَ عِنْدَہُ ہَؤُلاَئِ الَّذِینَ یُؤَذِّنُونَ بِلَیْلٍ، قَالَ : عُلُوجٌ فُرَّاغٌ لاَ یُصَلُّونَ إِلاَّ بِإِقَامَۃٍ ، لَوْ أَدْرَکَہُمْ عُمَرُ بْنُ الْخَطَّابِ لأَوْجَعَہُمْ ضَرْبًا ، أَوْ لأَوْجَعَ رُؤُوسَہُمْ۔","","Musannaf Ibn Abi Shaybah 2323","","","كتاب الأذان والإقامة"
"2324","(۲۳۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، وَابْنُ نُمَیْرٍ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُؤَذِّنَانِ یُؤَذِّنَانِ ، زَادَ فِیہِ ابْنُ نُمَیْرٍ : ابْنُ أُمِّ مَکْتُومٍ وَبِلاَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2324","","","كتاب الأذان والإقامة"
"2325","(۲۳۲۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ابْنِ أُخْتِ نَمِرٍ ، قَالَ : مَا کَانَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلاَّ مُؤَذِّنٌ وَاحِدٌ ، یُؤَذِّنُ إذَا قَعَدَ عَلَی الْمِنْبَرِ وَیُقِیمُ إذَا نَزَلَ ، ثُمَّ أَبُو بَکْرٍ کَذَلِکَ ، ثُمَّ عُمَرُ کَذَلِکَ ، حَتَّی کَانَ عُثْمَانَ ، وَفَشَا النَّاسُ وَکَثُرُوا ، زَادَ النِّدَائَ الثَّالِثَ عِنْدَ الزَّوَالِ ، أَوِ الزَّوْرَائِ۔ (بخاری ۹۱۲۔ ابوداؤد ۱۰۸۰)","","Musannaf Ibn Abi Shaybah 2325","","","كتاب الأذان والإقامة"
"2326","(۲۳۲۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدِ بْنِ سِیرِینَ ، قَالاَ : لَیْسَ علَی النِّسَائِ أَذَانٌ ، وَلاَ إقَامَۃٌ۔","","Musannaf Ibn Abi Shaybah 2326","","","كتاب الأذان والإقامة"
"2327","(۲۳۲۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی النِّسَائِ أَذَانٌ ، وَلاَ إقَامَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2327","","","كتاب الأذان والإقامة"
"2328","(۲۳۲۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالُوا : لَیْسَ عَلَی النِّسَائِ أَذَانٌ ، وَلاَ إقَامَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2328","","","كتاب الأذان والإقامة"
"2329","(۲۳۲۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی النِّسَائِ أَذَانٌ ، وَلاَ إقَامَۃٌ۔","","Musannaf Ibn Abi Shaybah 2329","","","كتاب الأذان والإقامة"
"2330","(۲۳۳۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2330","","","كتاب الأذان والإقامة"
"2331","(۲۳۳۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا نَسْأَلُ أَنَسًا ہَلْ عَلَی النِّسَائِ أَذَانٌ وَإِقَامَۃٌ ؟ قَالَ : لاَ ، وَإِنْ فَعَلْنَ فَہُوَ ذِکْرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2331","","","كتاب الأذان والإقامة"
"2332","(۲۳۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ رَبِّہِ ، عَنِ امْرَأَۃٍ مِنْ أَہْلِ مَکَّۃَ ، قَالَتْ : قُلْتُ لِجَابِرِ بْنِ زَیْدٍ : ہَلْ عَلَیَّ إقَامَۃٌ ؟ قَالَ: لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2332","","","كتاب الأذان والإقامة"
"2333","(۲۳۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ عَلَی النِّسَائِ أَذَانٌ ، وَلاَ إقَامَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2333","","","كتاب الأذان والإقامة"
"2334","(۲۳۳۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ رَجُلٍ ، عَنْ عَلِیٍّ ، قَالَ : لاَ تُؤَذِّنُ ، وَلاَ تُقِیمُ۔","Majhul","Musannaf Ibn Abi Shaybah 2334","","","كتاب الأذان والإقامة"
"2335","(۲۳۳۵) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ، عَنْ غَالِبِ بْنِ سُلَیْمَانَ، عَنِ الضَّحَّاکِ، قَالَ: لَیْسَ عَلَی النِّسَائِ أَذَانٌ، وَلاَ إقَامَۃٌ۔","","Musannaf Ibn Abi Shaybah 2335","","","كتاب الأذان والإقامة"
"2336","(۲۳۳۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا کَانَتْ تُؤَذِّنُ وَتُقِیمُ۔","Da'if","Musannaf Ibn Abi Shaybah 2336","","","كتاب الأذان والإقامة"
"2337","(۲۳۳۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 2337","","","كتاب الأذان والإقامة"
"2338","(۲۳۳۸) حَدَّثَنَا أَبُو خَالِدٍ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ، قَالَ: سُئِلَ ابْنُ عُمَرَ ، ہَلْ عَلَی النِّسَائِ أَذَانٌ؟ فَغَضِبَ ، قَالَ : أَنَا أُنْہِی عَنْ ذِکْرِ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 2338","","","كتاب الأذان والإقامة"
"2339","(۲۳۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ ، قَالَ : إِنَّہَا کَانَتْ تُقِیمُ إذَا صَلَّتْ۔","","Musannaf Ibn Abi Shaybah 2339","","","كتاب الأذان والإقامة"
"2340","(۲۳۴۰) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی الأَسْلَمِیُّ ، وَابْنُ یَمَانٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ عَلَی النِّسَائِ إقَامَۃٌ۔","","Musannaf Ibn Abi Shaybah 2340","","","كتاب الأذان والإقامة"
"2341","(۲۳۴۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ وَطاووس ؛ أَنَّ عَائِشَۃَ کَانَتْ تُؤَذِّنُ وَتُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2341","","","كتاب الأذان والإقامة"
"2342","(۲۳۴۲) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ، قَالَ : إِنْ شِئْنَ أَذَّنَّ۔","","Musannaf Ibn Abi Shaybah 2342","","","كتاب الأذان والإقامة"
"2343","(۲۳۴۳) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : حَدَّثَنَا ہُرَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : تُقِیمُ الْمَرْأَۃُ إِنْ شَائَتْ۔","","Musannaf Ibn Abi Shaybah 2343","","","كتاب الأذان والإقامة"
"2344","(۲۳۴۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : أَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِلاَلاً أَنْ یُؤَذِّنَ یَوْمَ الْفَتْحِ فَوْقَ الْکَعْبَۃِ۔ (عبدالرزاق ۱۹۴۶۴)","","Musannaf Ibn Abi Shaybah 2344","","","كتاب الأذان والإقامة"
"2345","(۲۳۴۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : مِنَ السُّنَّۃِ الأَذَانُ فِی الْمَنَارَۃِ ، وَالإِقَامَۃُ فِی الْمَسْجِدِ ، وَکَانَ عَبْدُ اللہِ یَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2345","","","كتاب الأذان والإقامة"
"2346","(۲۳۴۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : سَأَلْتُ عَنْ رَجُلٍ أَرَادَ أَنْ یُؤَذِّنَ فَأَقَامَ ؟ قَالَ : یُعِیدُ ، وَقَالَ سُفْیَانُ : یَجْعَلُہُ أَذَانًا وَیُقِیمُ۔","","Musannaf Ibn Abi Shaybah 2346","","","كتاب الأذان والإقامة"
"2347","(۲۳۴۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی کُدَیْنَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَرَادَ أَنْ یُؤَذِّنَ فَأَقَامَ ، قَالَ: یَرْجِعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2347","","","كتاب الأذان والإقامة"
"2348","(۲۳۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، قَالَ : قَالَ عُمَرُ : لَوْ أَطَقْتُ الأَذَانَ مَعَ الْخِلِّیفَی لأَذَّنْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 2348","","","كتاب الأذان والإقامة"
"2349","(۲۳۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ضِرَارٍ ، عَنْ زَاذَانَ ، قَالَ : لَوْ یَعْلَمُ النَّاسُ مَا فِی فَضْلِ الأَذَانِ لاَضْطَرَبُوا عَلَیْہِ بِالسُّیُوفِ۔","","Musannaf Ibn Abi Shaybah 2349","","","كتاب الأذان والإقامة"
"2350","(۲۳۵۰) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ سَعْدٍ ، قَالَ : لأَنْ أَقْوَی عَلَی الأَذَانِ أَحَبُّ ، إلَیَّ مِنْ أَنْ أَحُجَّ وَأَعْتَمِرَ وَأُجَاہِدَ۔","Da'if","Musannaf Ibn Abi Shaybah 2350","","","كتاب الأذان والإقامة"
"2351","(۲۳۵۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ مُصْعَبِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ کَعْبٍ ، قَالَ : مَنْ أَذَّنَ کُتِبَتْ لَہُ سَبْعُونَ حَسَنَۃً ، وَإِنْ أَقَامَ فَہُوَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 2351","","","كتاب الأذان والإقامة"
"2352","(۲۳۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اللَّہُمَّ أَرْشِدِ الأَئِمَّۃَ ، وَاغْفِرْ لِلْمُؤَذِّنِینَ۔ (عبدالرزاق ۱۸۳۹۔ احمد ۴۱۹)","Hasan","Musannaf Ibn Abi Shaybah 2352","","","كتاب الأذان والإقامة"
"2353","(۲۳۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی ، قَالَ : حُدِّثْتُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَوْ عَلِمَ النَّاسُ مَا فِی الأَذَانِ لَتَجَارَوہُ ، قَالَ : وَکَانَ یُقَالُ : ابْتَدِرُوا الأَذَانَ ، وَلاَ تَبْتَدِرُوا الإِقَامَۃَ۔ (احمد ۲۹)","","Musannaf Ibn Abi Shaybah 2353","","","كتاب الأذان والإقامة"
"2354","(۲۳۵۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْمُؤَذِّنُ الْمُحْتَسِبُ أَوَّلُ مَنْ یُکْسَی۔","","Musannaf Ibn Abi Shaybah 2354","","","كتاب الأذان والإقامة"
"2355","(۲۳۵۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : سَمِعْتُ عِیسَی بْنَ طَلْحَۃَ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ یَقُولُ : سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ الْمُؤَذِّنِینَ أَطْوَلُ النَّاسِ أَعْنَاقًا یَوْمَ الْقِیَامَۃِ۔n(مسلم ۲۹۰۔ ابن ماجہ ۷۲۵)","Hasan","Musannaf Ibn Abi Shaybah 2355","","","كتاب الأذان والإقامة"
"2356","(۲۳۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ : أَخْبَرَنَا ہِشَام، عَنِ الْحَسَنِ، قَالَ : أَہْلُ الصَّلاَحِ وَالْحِسْبَۃِ مِنَ الْمُؤَذِّنِینَ، أَوَّلُ مَنْ یُکْسَی یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2356","","","كتاب الأذان والإقامة"
"2357","(۲۳۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شَیْخٌ مِنْ أَہْلِ الْبَصْرَۃِ ، قَالَ : أَخْبَرَنَا الْقَاسِمُ بْنُ عَوْفٍ الشَّیْبَانِیُّ ، عَنْ زَیْدِ بْنِ أَرْقَمَ ، قَالَ: قَالَ النَّبِیُّ صلی اللہ علیہ وسلم: بِلاَلٌ سَیِّدُ الْمُؤَذِّنِینَ یَوْمَ الْقِیَامَۃِ ، وَلاَ یَتْبَعُہُ إِلاَّ مُؤْمِنٌ، وَالْمُؤَذِّنُونَ أَطْوَلُ النَّاسِ أَعْنَاقًا یَوْمَ الْقِیَامَۃِ۔ (طبرانی ۵۱۱۸)","Majhul","Musannaf Ibn Abi Shaybah 2357","","","كتاب الأذان والإقامة"
"2358","(۲۳۵۸) حَدَّثَنَا یَزِیدُ، عَنِ الرَّبِیعِ بْنِ صَبِیحٍ، قَالَ: حَدَّثَنَا أَبُو فَاطِمَۃَ، رَجُلٌ قَدْ أَدْرَکَ أَصْحَابَ النَّبِیِّ صلی اللہ علیہ وسلم، قَالَ: قَالَ ابْنُ مَسْعُودٍ: لَوْ کُنْتُ مُؤَذِّنًا ، مَا بَالَیْتُ أَنْ لاَ أَحُجَّ ، وَلاَ أَغْزُوَ۔","Majhul","Musannaf Ibn Abi Shaybah 2358","","","كتاب الأذان والإقامة"
"2359","(۲۳۵۹) حَدَّثَنَا یَزِیدُ وَوَکِیعٌ ، قَالاَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ شُبَیْلِ بْنِ عَوْفٍ ، قَالَ : قَالَ عُمَرُ : مَنْ مُؤَذِّنُوکُمْ ؟ قَالُوا : عَبِیدُنَا وَمَوَالِینَا ، قَالَ : إنَّ ذَلِکَ لَنَقْصٌ بِکُمْ کَبِیرٌ۔ إِلاَّ أَنَّ وَکِیعًا قَالَ : کَثِیرٌ ، أَوْ کَبِیرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2359","","","كتاب الأذان والإقامة"
"2360","(۲۳۶۰) حَدَّثَنَا یَزِیدُ وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ ، قَالَ : قَالَ قَیْسٌ : قَالَ عُمَرُ : لَوْ کُنْتُ أُطِیقُ الأَذَانَ مَعَ الْخِلِّیفَی لأَذَّنْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 2360","","","كتاب الأذان والإقامة"
"2361","(۲۳۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ عُبَدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا أَرَی ہَذِہِ الآیَۃَ نَزَلَتْ إِلاَّ فِی الْمُؤَذِّنِینَ : {وَمَنْ أَحْسَنُ قَوْلاً مِمَّنْ دَعَا إلَی اللہِ وَعَمِلَ صَالِحًا وَقَالَ إنَّنِی مِنَ الْمُسْلِمِینَ}۔","Da'if","Musannaf Ibn Abi Shaybah 2361","","","كتاب الأذان والإقامة"
"2362","(۲۳۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ مُحَمَّدِ بْنِ نَافِعٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : لاَ أَرَی ہَذِہِ الآیَۃَ نَزَلَتْ إِلاَّ فِی الْمُؤَذِّنِینَ: {وَمَنْ أَحْسَنُ قَوْلاً مِمَّنْ دَعَا إلَی اللہِ وَعَمِلَ صَالِحًا ، وَقَالَ إنَّنِی مِنَ الْمُسْلِمِینَ}۔","Da'if","Musannaf Ibn Abi Shaybah 2362","","","كتاب الأذان والإقامة"
"2363","(۲۳۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ: حدَّثَنِی الْحَسَنُ بْنُ الْحَکَمِ ، قَالَ : حَدَّثَنِی یَحْیَی بْنُ عَبَّادٍ أَبُو ہُبَیْرَۃَ ، عَنْ شَیْخٍ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُؤَذِّنُ یُغْفَرُ لَہُ مَدَّ صَوْتِہِ وَیُصَدِّقُہُ کُلُّ رَطْبٍ وَیَابِسٍ۔ (احمد ۲/۴۱۱)","Sahih","Musannaf Ibn Abi Shaybah 2363","","","كتاب الأذان والإقامة"
"2364","(۲۳۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا أَبُو العَنْبس سَعِیدُ بْنُ کَثِیرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : ارْفَعْ صَوْتَکَ بِالأَذَانِ ، فَإِنَّہُ یَشْہَدُ لَکَ کُلُّ شَیْئٍ سَمِعَک۔","Hasan","Musannaf Ibn Abi Shaybah 2364","","","كتاب الأذان والإقامة"
"2365","(۲۳۶۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمُؤَذِّنُ یَشْہَدُ لَہُ کُلُّ شَیْئٍ رَطْبٍ وَیَابِسٍ سَمِعَہُ۔","","Musannaf Ibn Abi Shaybah 2365","","","كتاب الأذان والإقامة"
"2366","(۲۳۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ قَالَ لِرَجُلٍ : مَا عَمَلُک ؟ قَالَ : الأَذَانُ ، قَالَ : نِعْمَ الْعَمَلُ عملُک ، یَشْہَدُ لَکَ کُلُّ شَیْئٍ سَمِعَک۔","Majhul","Musannaf Ibn Abi Shaybah 2366","","","كتاب الأذان والإقامة"
"2367","(۲۳۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : خَرَجَ عَلْقَمَۃُ ، وَعَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی إِلَی بَدْوٍ لَہُمْ ، قَالَ إبْرَاہِیمُ : فَکَانَ یُعْجِبُنِی أَنَّ عَبْدَ الرَّحْمَنِ بْنَ أَبِی لَیْلَی کَانَ یَأْمُرُ ابْنًا لَہُ غُلاَمًا یُؤَذِّنُ۔","","Musannaf Ibn Abi Shaybah 2367","","","كتاب الأذان والإقامة"
"2368","(۲۳۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَذِّنَ الْغُلاَمُ قَبْلَ أَنْ یَحْتَلِمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2368","","","كتاب الأذان والإقامة"
"2369","(۲۳۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ الأَزْرَقِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ أَنْ یُؤَذِّنَ الْغُلاَمُ إذَا أَحْسَنَ الأَذَانَ قَبْلَ أَنْ یَحْتَلِمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2369","","","كتاب الأذان والإقامة"
"2370","(۲۳۷۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن عِیسَی بْنِ طَلْحَۃَ ، قَالَ : دَخَلْنَا عَلَی مُعَاوِیَۃَ فَجَائَ الْمُؤَذِّنُ فَأَذَّنَ ، فَقَالَ : اللَّہُ أَکْبَرُ، اللَّہُ أَکْبَرُ ، فَقَالَ مُعَاوِیَۃُ بْنُ أَبِی سُفْیَانَ مِثْلَ ذَلِکَ ، فَقَالَ : أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، فَقَالَ مُعَاوِیَۃُ مِثْلَ ذَلِکَ ، فَقَالَ : أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، فَقَالَ : مُعَاوِیَۃُ مِثْلَ ذَلِکَ ، ثُمَّ قَالَ : ہَکَذَا سَمِعْتُ نَبِیَّکُمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ۔ (احمد ۴/۹۱۔ دارمی ۱۲۰۲)","Sahih","Musannaf Ibn Abi Shaybah 2370","","","كتاب الأذان والإقامة"
"2371","(۲۳۷۱) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیء ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنِی کَعْبُ بْنُ عَلْقَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا سَمِعْتُمَ الْمُؤَذِّنَ ، فَقُولُوا کَمَا یَقُولُ۔ (مسلم ۲۸۸۔ ابوداؤد ۵۲۴)","Sahih","Musannaf Ibn Abi Shaybah 2371","","","كتاب الأذان والإقامة"
"2372","(۲۳۷۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ مِثْلَ مَا یَقُولُ الْمُؤَذِّنُ۔ (ابوداؤد ۵۲۵۔ ابن ماجہ ۷۲۰)","Sahih","Musannaf Ibn Abi Shaybah 2372","","","كتاب الأذان والإقامة"
"2373","(۲۳۷۳) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ أَبِی الْمَلِیحِ ، عَنْ أُمِّ حَبِیبَۃَ۔ (احمد ۳۲۶۔ نسائی ۹۸۶۵)","","Musannaf Ibn Abi Shaybah 2373","","","كتاب الأذان والإقامة"
"2374","(۲۳۷۴) (ح) وَحَدَّثَنَا عَفَّانُ ، قَالَ : أَخْبَرَنَا أَبُو عَوَانَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ أَبِی الْمَلِیحِ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ أُمِّ حَبِیبَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ کَانَ إذَا سَمِعَ الْمُؤَذِّنَ ، قَالَ کَمَا یَقُولُ حَتَّی یَسْکُتَ۔","Majhul","Musannaf Ibn Abi Shaybah 2374","","","كتاب الأذان والإقامة"
"2375","(۲۳۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ مِثْلَ مَا یَقُولُ الْمُؤَذِّنُ ، فَإِذَا بَلَغَ حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الْفَلاَحِ، قَالَ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللَّہِ۔ (طبرانی ۳۲۶۶)","Da'if","Musannaf Ibn Abi Shaybah 2375","","","كتاب الأذان والإقامة"
"2376","(۲۳۷۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدِ بْنِ عَلِیٍّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا سَمِعَ صَوْتَ الْمُنَادِی یَقُولُ : أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، قَالَ : وَأَنَا ، وَإذَا قَالَ : أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، قَالَ : وَأَنَا۔","","Musannaf Ibn Abi Shaybah 2376","","","كتاب الأذان والإقامة"
"2377","(۲۳۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا سَمِعَ الْمُؤَذِّنَ ، قَالَ : وَأَنَا ، وَأَنَا۔","","Musannaf Ibn Abi Shaybah 2377","","","كتاب الأذان والإقامة"
"2378","(۲۳۷۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَمَّنْ أَخْبَرَہُ عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ إذَا قَالَ الْمُؤَذِّنُ : حَیَّ عَلَی الصَّلاَۃِ ، قَالَ : الْمُسْتَعَانُ اللَّہُ ، فَإذَا قَالَ : حَیَّ عَلَی الْفَلاَحِ ، قَالَ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللَّہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2378","","","كتاب الأذان والإقامة"
"2379","(۲۳۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ قَالَ مِثْلَ مَا یَقُولُ الْمُؤَذِّنُ کَانَ لَہُ مِثْلُ أَجْرِہِ۔","","Musannaf Ibn Abi Shaybah 2379","","","كتاب الأذان والإقامة"
"2380","(۲۳۸۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا سَمِعْت الْمُؤَذِّنَ فَقُلْ کَمَا یَقُولُ ، فَإذَا قَالَ : حَیَّ عَلَی الصَّلاَۃِ ، فَقُلْ : لاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللَّہِ ، فَإذَا قَالَ : قَدْ قَامَتِ الصَّلاَۃُ ، فَقُلِ : اللَّہُمَّ رَبَّ ہَذِہِ الدَّعْوَۃِ التَّامَّۃِ ، وَالصَّلاَۃِ الْقَائِمَۃِ ، أَعْطِ مُحَمَّدًا سُؤْلَہُ یَوْمَ الْقِیَامَۃِ ، فَلَنْ یَقُولَہَا رَجُلٌ حِینَ یُقِیمُ إِلاَّ أَدْخَلَہُ اللَّہُ فِی شَفَاعَۃِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2380","","","كتاب الأذان والإقامة"
"2381","(۲۳۸۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ أَنَّ عُثْمَانَ کَانَ إذَا سَمِعَ الْمُؤَذِّنَ یُؤَذِّنُ یَقُولُ کَمَا یَقُولُ فِی التَّشَہُّدِ وَالتَّکْبِیرِ کُلِّہِ ، فَإذَا قَالَ : حَیَّ عَلَی الصَّلاَۃِ ، قَالَ : مَا شَائَ اللَّہُ ، وَلاَ حَوْلَ وَلاَ قُوَّۃَ إِلاَّ بِاللَّہِ ، وَإذَا قَالَ : قَدْ قَامَتِ الصَّلاَۃُ ، قَالَ : مَرْحَبًا بِالْقَائِلِینَ عَدْلاً وَصدقًا ، وَبِالصَّلاَۃِ مَرْحَبًا وَأَہْلاً ، ثُمَّ یَنْہَضُ إلَی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 2381","","","كتاب الأذان والإقامة"
"2382","(۲۳۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، قَالَ : مِنَ الْجَفَائِ أَنْ تَسْمَعَ الْمؤَذِّنَ یَقُولُ : لاَ إلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، ثُمَّ لاَ تُجِیبَہُ۔","","Musannaf Ibn Abi Shaybah 2382","","","كتاب الأذان والإقامة"
"2383","(۲۳۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : مِنَ الْجَفَائِ أَنْ تَسْمَعَ الأَذَانَ ، ثُمَّ لاَ تَقُولُ مِثْلَ مَا یَقُولُ۔","","Musannaf Ibn Abi Shaybah 2383","","","كتاب الأذان والإقامة"
"2384","(۲۳۸۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشعثَ ، عَنِ الْحَسَنِ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ، قَالَ : آخِرُ مَا عَہِدَ إلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنِ اتَّخِذْ مُؤَذِّنًا لاَ یَأْخُذُ عَلَی أَذَانِہِ أَجْرًا۔ (ترمذی ۲۰۹۔ ابوداؤد ۵۳۲)","","Musannaf Ibn Abi Shaybah 2384","","","كتاب الأذان والإقامة"
"2385","(۲۳۸۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ الْمُؤَذِّنُ عَلَی أَذَانِہِ جُعْلاً وَیَقُولُ : إِنْ أُعْطِیَ بِغَیْرِ مَسْأَلَۃٍ فَلاَ بَأْسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2385","","","كتاب الأذان والإقامة"
"2386","(۲۳۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَوْنِ بْنِ مُوسَی ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ قَالَ : کَانَ یُقَالُ : لاَ یُؤَذِّنُ لَکَ إِلاَّ مُحْتَسِبٌ۔","","Musannaf Ibn Abi Shaybah 2386","","","كتاب الأذان والإقامة"
"2387","(۲۳۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، عَنْ یَحْیَی الْبَکَّائِ ، قَالَ : کُنْتُ آخِذًا بِیَدِ ابْنِ عُمَرَ وَہُوَ یَطُوفُ بِالْکَعْبَۃِ ، فَلَقِیَہُ رَجُلٌ مِنْ مُؤَذِّنِی الْکَعْبَۃِ ، فَقَالَ : إنِّی لأُحِبُّک فِی اللہِ ، فَقَالَ ابْنُ عُمَرَ : إِنِّی لأبْغِضُک فِی اللہِ ، إنَّک تُحَسِّنُ صَوْتَکَ لأَخْذِ الدَّرَاہِمِ۔","Hasan","Musannaf Ibn Abi Shaybah 2387","","","كتاب الأذان والإقامة"
"2388","(۲۳۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ، عَنْ أَبِی سُفْیَانَ، عَنْ جَابِرٍ، قَالَ: قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا نَادَی الْمُؤَذِّنُ بِالأَذَانِ ہَرَبَ الشَّیْطَانُ ، حَتَّی یَکُونَ بِالرَّوْحَائِ ، وَہِیَ ثَلاَثُونَ مِیلاً مِنَ الْمَدِینَۃِ۔ (مسلم ۱۵)","Hasan","Musannaf Ibn Abi Shaybah 2388","","","كتاب الأذان والإقامة"
"2389","(۲۳۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا نَادَی الْمُؤَذِّنُ بِالصَّلاَۃِ أَدْبَرَ الشَّیْطَانُ وَلَہُ ضُرَاطٌ ، فَإِذَا قَضَی أَمْسَکَ ، فَإِذَا ثَوَّبَ بِہَا أَدْبَرَ۔ (مسلم ۳۹۸۔ احمد ۲/۵۲۲)","Hasan","Musannaf Ibn Abi Shaybah 2389","","","كتاب الأذان والإقامة"
"2390","(۲۳۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ الْمَکِّیِّ ؛ أَنَّ مُؤَذِّنًا أَذَّنَ فَطَرَّبَ فِی أَذَانِہِ ، فَقَالَ لَہُ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : أَذِّنْ أَذَانًا سَمْحًا ، وَإِلا فَاعْتَزِلْنَا۔","","Musannaf Ibn Abi Shaybah 2390","","","كتاب الأذان والإقامة"
"2391","(۲۳۹۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَلاَّمِ بْنِ صَالِحٍ ، عَنْ فَائِدِ بْنِ بُکَیْر ، عَنْ حُذَیْفَۃَ ، قَالَ : مَنْ شَائَ اللَّہُ أَنْ یَجْعَلَ رِزْقَہُ فِی صَوْتِہِ فَعَلَ۔","Majhul","Musannaf Ibn Abi Shaybah 2391","","","كتاب الأذان والإقامة"
"2392","(۲۳۹۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : الأَذَانُ جَزْمٌ۔","","Musannaf Ibn Abi Shaybah 2392","","","كتاب الأذان والإقامة"
"2393","(۲۳۹۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ عَبْدِاللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ، عَنِ ابْنِ الْحَنَفِیَّۃِ، عَنْ أَبِیہِ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِفْتَاحُ الصَّلاَۃِ الطُّہُورُ ، وَتَحْرِیمُہَا التَّکْبِیرُ وَتَحْلِیلُہَا التَّسْلِیمُ۔(دارمی ۶۸۷)","Da'if","Musannaf Ibn Abi Shaybah 2393","","","كتاب الصلوات"
"2394","(۲۳۹۴) حَدَّثَنَا أَبُو الا??َحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ، قَالَ: قَالَ عَبْدُاللہِ: تَحْرِیمُ الصَّلاَۃِ التَّکْبِیرُ، وَتَحْلِیلُہَا التَّسْلِیمُ۔","","Musannaf Ibn Abi Shaybah 2394","","","كتاب الصلوات"
"2395","(۲۳۹۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سُفْیَانَ السَّعْدِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِفْتَاحُ الصَّلاَۃِ الطَّہُورُ ، وَتَحْرِیمُہَا التَّکْبِیرُ ، وَتَحْلِیلُہَا التَّسْلِیمُ۔","Da'if","Musannaf Ibn Abi Shaybah 2395","","","كتاب الصلوات"
"2396","(۲۳۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ ابْنِ کُرَیْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مِفْتَاحُ الصَّلاَۃِ الطَّہُورُ ، وَتَحْرِیمُہَا التَّکْبِیرُ ، وَتَحْلِیلُہَا التَّسْلِیمُ۔","Da'if","Musannaf Ibn Abi Shaybah 2396","","","كتاب الصلوات"
"2397","(۲۳۹۷) حَدَّثَنَا ابْنُ ہَارُونَ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَفْتَتِحُ الصَّلاَۃَ بِالتَّکْبِیرِ ، وَکَانَ یَخْتِمُ بِالتَّسْلِیمِ۔ (مسلم ۶۴۰۔ ابوداؤد ۷۷۹)","Hasan","Musannaf Ibn Abi Shaybah 2397","","","كتاب الصلوات"
"2398","(۲۳۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ سَالِمٍ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : لِکُلِّ شَیْئٍ شِعَارٌ ، وَشِعَارُ الصَّلاَۃِ التَّکْبِیرُ۔","","Musannaf Ibn Abi Shaybah 2398","","","كتاب الصلوات"
"2399","(۲۳۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُوس قَالاَ : التَّشَہُّدُ تَمَامُ الصَّلاَۃِ ، وَالتَّسْلِیمُ إذْنُ قَضَائِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2399","","","كتاب الصلوات"
"2400","(۲۴۰۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ وِقَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَیْسَ بَعْدَ التَّسْلِیمِ صَلاَۃٌ۔","","Musannaf Ibn Abi Shaybah 2400","","","كتاب الصلوات"
"2401","(۲۴۰۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : إذَا سَلَّمَ الإِمَامُ ، فَقَدِ انصرف مَنْ خَلْفَہُ۔","","Musannaf Ibn Abi Shaybah 2401","","","كتاب الصلوات"
"2402","(۲۴۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَبِی وَائِلٍ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ افْتَتَحَ الصَّلاَۃَ فَکَبَّرَ ، ثُمَّ قَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Sahih","Musannaf Ibn Abi Shaybah 2402","","","كتاب الصلوات"
"2403","(۲۴۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ إذَا افْتَتَحَ الصَّلاَۃَ کَبَّرَ ، فَذَکَرَ مِثْلَ حَدِیثِ حُصَیْنٍ ، وَزَادَ فِیہِ : یَجْہَرُ بِہِنَّ ، قَالَ : وَقَالَ : کَانَ إبْرَاہِیمُ لاَ یَجْہَرُ بِہِنَّ۔","","Musannaf Ibn Abi Shaybah 2403","","","كتاب الصلوات"
"2404","(۲۴۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الأَعْمَش ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ حِینَ افْتَتَحَ الصَّلاَۃَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Sahih","Musannaf Ibn Abi Shaybah 2404","","","كتاب الصلوات"
"2405","(۲۴۰۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، عْن عَلْقَمَۃَ ؛ أَنَّہُ انْطَلَقَ إلَی عُمَرَ ، فَقَالُوا لَہُ : احْفَظْ لَنَا مَا اسْتَطَعْت ، فَلَمَّا قَدِمَ قَالَ : فِیمَا حَفِظْت أَنَّہُ تَوَضَّأَ مَرَّتَیْنِ وَنَثَرَ مَرَّتَیْنِ ، فَلَمَّا کَبَّرَ ، أَوْ فَلَمَّا قَامَ إلَی الصَّلاَۃِ ، قَالَ: سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Sahih","Musannaf Ibn Abi Shaybah 2405","","","كتاب الصلوات"
"2406","(۲۴۰۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ إذَا افْتَتَحَ الصَّلاَۃَ ، قَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Da'if","Musannaf Ibn Abi Shaybah 2406","","","كتاب الصلوات"
"2407","(۲۴۰۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ؛ أَنَّ عُمَرَ کَانَ إذَا افْتَتَحَ الصَّلاَۃَ ، قَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Hasan","Musannaf Ibn Abi Shaybah 2407","","","كتاب الصلوات"
"2408","(۲۴۰۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ ابْنِ عَجْلاَنَ ، قَالَ : بَلَغَنِی أَنَّ أَبَا بَکْرٍ کَانَ یَقُولُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 2408","","","كتاب الصلوات"
"2409","(۲۴۰۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : کَانَ عُمَرُ إذَا افْتَتَحَ الصَّلاَۃَ ، قَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک ، یُسْمِعُنَا۔","Da'if","Musannaf Ibn Abi Shaybah 2409","","","كتاب الصلوات"
"2410","(۲۴۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ؛ أَنَّہُ قَالَ حِینَ اسْتَفْتَحَ الصَّلاَۃَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Sahih","Musannaf Ibn Abi Shaybah 2410","","","كتاب الصلوات"
"2411","(۲۴۱۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبَّادِ بْنِ عَاصِمٍ ، عَنْ نَافِعِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ افْتَتَحَ الصَّلاَۃَ ، قَالَ : اللَّہُ أَکْبَرُ ، ثَلاَثًا ، الْحَمْدُ لِلَّہِ کَثِیرًا ، ثَلاَثًا ، سُبْحَانَ اللہِ بُکْرَۃً وَأَصِیلاً ، ثَلاَثًا ، اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الشَّیْطَانِ الرجیم ، مِنْ ہَمْزِہِ ، وَنَفْخِہِ، وَنَفْثِہِ۔ (بیہقی ۳۵)","Majhul","Musannaf Ibn Abi Shaybah 2411","","","كتاب الصلوات"
"2412","(۲۴۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَمَّارِ بْنِ عَاصِمٍ ، عَنِ ابْنِ جُبَیْرِ بْنِ مُطْعِمٍ ، عَنْ أَبِیہِ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الضُّحَی ، فَذَکَرَ مِثْلَ حَدِیثِ ابْنِ إدْرِیسَ۔","","Musannaf Ibn Abi Shaybah 2412","","","كتاب الصلوات"
"2413","(۲۴۱۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ طَلْحَۃَ بْنِ یَزِیدَ الأَنْصَارِیِّ ، عَنْ حُذَیْفَۃَ قَالَ : قَامَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ مِنْ رَمَضَانَ فِی حُجْرَۃٍ مِنْ جَرِیدِ النَّخْلِ ، ثُمَّ صَبَّ علَیْہِ دَلْوًا مِنْ مَائٍ ، ثُمَّ قَالَ : اللَّہُ أَکْبَرُ ذُو الْمَلَکُوتِ ، وَالْجَبَرُوتِ ، وَالْکِبْرِیَائِ ، وَالْعَظَمَۃِ۔n(احمد ۵/۴۰۰۔ نسائی ۱۳۷۸)","","Musannaf Ibn Abi Shaybah 2413","","","كتاب الصلوات"
"2414","(۲۴۱۴) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو الْکَلْبِیُّ ، قَالَ : حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ أَبِی سَلَمَۃَ ، قَالَ : أَخْبَرَنَا الْمَاجِشُونُ عَمِّی، عَنِ الأَعْرَجِ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا افْتَتَحَ الصَّلاَۃَ کَبَّرَ ، ثُمَّ قَالَ : وَجَّہْت وَجْہِی لِلَّذِی فَطَرَ السَّمَاوَاتِ وَالأَرْضَ حَنِیفًا ، وَمَا أَنَا مِنَ الْمُشْرِکِینَ ، إنَّ صَلاَتِی وَنُسُکِی وَمَحْیَایَ وَمَمَاتِی لِلَّہِ رَبِّ الْعَالَمِینَ لاَ شَرِیکَ لَہُ ، وَبِذَلِکَ أُمِرْت وَأَنَا أَوَّلُ الْمُسْلِمِینَ ، اللَّہُمَّ أَنْتَ الْمَلِکُ لاَ إلَہَ إِلاَّ أَنْتَ ، أَنْتَ رَبِّی وَأَنَا عَبْدُک ، ظَلَمْت نَفْسِی ، وَاعْتَرَفْت بِذَنْبِی فَاغْفِرْ لِی ذُنُوبِی جَمِیعًا ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ ، وَاہْدِنِی لأَحْسَنِ الأَخْلاَقِ لاَ یَہْدِینی لأَحْسَنِہَا إِلاَّ أَنْتَ ، وَاصْرِفْ عَنِّی سَیِّئَہَا لاَ یَصْرِفُ عَنِّی سَیِّئَہَا إِلاَّ أَنْتَ ، لَبَّیْکَ وَسَعْدَیْکَ ، وَالْخَیْرُ کُلُّہُ فِی یَدَیْک ، أَنَا بِکَ وَإِلَیْک ، تَبَارَکْت وَتَعَالَیْت ، أَسْتَغْفِرُک وَأَتُوبُ إلَیْک۔ (مسلم ۲۰۱۔ ترمذی ۳۴۲۱)","Sahih","Musannaf Ibn Abi Shaybah 2414","","","كتاب الصلوات"
"2415","(۲۴۱۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ مَیْمُونٍ ، قَالَ : صَلَّی بِنَا عُمَرُ الصُّبْحَ وَہُوَ مُسَافِرٌ بِذِی الْحُلَیْفَۃِ وَہُوَ یُرِیدُ مَکَّۃَ ، فَقَالَ : اللَّہُ أَکْبَرُ ، سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Sahih","Musannaf Ibn Abi Shaybah 2415","","","كتاب الصلوات"
"2416","(۲۴۱۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنِی جَعْفَرُ بْنُ سُلَیْمَانَ الضُّبَعِیُّ ، عَنْ عَلِیِّ بْنِ عَلِیٍّ الرِّفَاعِیِّ ، عَنْ أَبِی الْمُتَوَکِّلِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَفْتِحُ الصَّلاَۃَ یَقُولُ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔ (ابن ماجہ ۸۰۴۔ نسائی ۹۷۳)","","Musannaf Ibn Abi Shaybah 2416","","","كتاب الصلوات"
"2417","(۲۴۱۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ : فِی قَوْلِہِ : وَسَبِّحْ بِحَمْدِ رَبِّکَ حِینَ تَقُومُ ، قَالَ : حِینَ تَقُومُ إلَی الصَّلاَۃِ تَقُولُ ہَؤُلاَئِ الْکَلِمَاتِ ، سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","","Musannaf Ibn Abi Shaybah 2417","","","كتاب الصلوات"
"2418","(۲۴۱۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد، قَالَ: قَالَ ابْنُ مَسْعُودٍ : إنَّ مِنْ أَحَبِّ الْکَلاَمِ إلَی اللہِ أَنْ یَقُولَ الرَّجُلُ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک ، رَبِّ إنِّی ظَلَمْت نَفْسِی فَاغْفِرْ لِی ذنوبی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 2418","","","كتاب الصلوات"
"2419","(۲۴۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عُمَرُ إذَا افْتَتَحَ الصَّلاَۃَ رَفَعَ صَوْتَہُ یُسْمِعُنَا یَقُولُ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک۔","Sahih","Musannaf Ibn Abi Shaybah 2419","","","كتاب الصلوات"
"2420","(۲۴۲۰) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : حَدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْخَلِیلِ ، عَنْ عَلِیٍّ ، قَالَ : سَمِعْتُہُ حِینَ کَبَّرَ فِی الصَّلاَۃِ ، قَالَ : لاَ إلَہَ إِلاَّ أَنْتَ سُبْحَانَک ، إنِّی ظَلَمْت نَفْسِی فَاغْفِرْ لِی ذُنُوبِی ، إِنَّہُ لاَ یَغْفِرُ الذُّنُوبَ إِلاَّ أَنْتَ۔","Hasan","Musannaf Ibn Abi Shaybah 2420","","","كتاب الصلوات"
"2421","(۲۴۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ وَعَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ ابْنِ أَبِی الْخَلِیلِ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 2421","","","كتاب الصلوات"
"2422","(۲۴۲۲) حَدَّثَنَا وَکِیعُ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ حِینَ یَفْتَتِحُ الصَّلاَۃَ : اللَّہُ أَکْبَرُ کَبِیرًا ، وَسُبْحَانَ اللہِ وَبِحَمْدِہِ بُکْرَۃً وَأَصِیلاً ، اللَّہُمَّ اجْعَلْہُ أَحَبَّ شَیْئٍ إلَیَّ ، وَأَخْشَی شَیْئٍ عِنْدِی۔","Majhul","Musannaf Ibn Abi Shaybah 2422","","","كتاب الصلوات"
"2423","(۲۴۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنِ ابْنِ مَسْعُودٍ ، نَحْوَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2423","","","كتاب الصلوات"
"2424","(۲۴۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا افْتَتَحَ الصَّلاَۃَ رَفَعَ یَدَیْہِ حَتَّی یُحَاذِیَ مَنْکِبَیْہِ۔ (ترمذی ۲۵۶۔ ابوداؤد ۷۲۱)","Sahih","Musannaf Ibn Abi Shaybah 2424","","","كتاب الصلوات"
"2425","(۲۴۲۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : قَدِمْتُ الْمَدِینَۃَ ، فَقُلْتُ: لأَنْظُرَنَّ إلَی صَلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَکَبَّرَ وَرَفَعَ یَدَیْہِ ، حَتَّی رَأَیْت إبْہَامَیْہِ قَرِیبًا مِنْ أُذُنَیْہِ۔ (ابوداؤ۹ ۷۲۸۔ نسائی ۱۱۹۱)","Sahih","Musannaf Ibn Abi Shaybah 2425","","","كتاب الصلوات"
"2426","(۲۴۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ افْتَتَحَ الصَّلاَۃَ رَفَعَ یَدَیْہِ حَتَّی کَادَتَا تُحَاذِیَانِ أُذُنَیْہِ۔ (احمد ۴/۲۰۲۔ عبدالرزاق ۳۵۳۰)","Da'if","Musannaf Ibn Abi Shaybah 2426","","","كتاب الصلوات"
"2427","(۲۴۲۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ نَصْرِ بْنِ عَاصِمٍ ، عَنْ مَالِکِ بْنِ الْحُوَیْرِثِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَفَعَ یَدَیْہِ حَتَّی یُحَاذِیَ بِہِمَا فُرُوعَ أُذُنَیْہِ۔ (مسلم ۲۶۔ ابوداؤد ۷۴۵)","Sahih","Musannaf Ibn Abi Shaybah 2427","","","كتاب الصلوات"
"2428","(۲۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّ عُمَرَ کَانَ یَرْفَعُ یَدَیْہِ فِی الصَّلاَۃِ حَذْوَ مَنْکِبَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2428","","","كتاب الصلوات"
"2429","(۲۴۲۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ حَذْوَ مَنْکِبَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2429","","","كتاب الصلوات"
"2430","(۲۴۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُجَاوِزْ بِالْیَدَیْنِ الأُذُنَیْنِ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 2430","","","كتاب الصلوات"
"2431","(۲۴۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ یُجَاوِزُ أُذُنَیْہِ بِیَدَیْہِ فِی الإِفْتِتَاحِ۔","","Musannaf Ibn Abi Shaybah 2431","","","كتاب الصلوات"
"2432","(۲۴۳۲) حَدَّثَنَا عَبَّادُ بْنُ العوام ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ حَذْوَ مَنْکِبَیْہِ۔","","Musannaf Ibn Abi Shaybah 2432","","","كتاب الصلوات"
"2433","(۲۴۳۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، وَعُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ ، قَالَ : کَانَ أَصْحَابُنَا إذَا افْتَتَحُوا الصَّلاَۃَ رَفَعُوا أَیْدِیَہُمْ إلَی آذَانِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2433","","","كتاب الصلوات"
"2434","(۲۴۳۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، قَالَ : لاَ تُجَاوِزْ بِیَدَیْک أُذُنَیْک فِی دُعَائٍ ، أَوْ غَیْرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2434","","","كتاب الصلوات"
"2435","(۲۴۳۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ مُحَارِبٍ ، قَالَ : لَوْ رَأَیْتَ عَبْدَ اللہِ بْنَ عُمَرَ إذَا قامَ إلَی الصَّلاَۃِ ، قَالَ : ہَکَذَا ، وَرَفَعَ یَدَیْہِ حَذْوَ وَجْہِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2435","","","كتاب الصلوات"
"2436","(۲۴۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَرْفَعُ یَدَیْہِ حَذْوَ مَنْکِبَیْہِ۔","","Musannaf Ibn Abi Shaybah 2436","","","كتاب الصلوات"
"2437","(۲۴۳۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدٍ ، عَنِ الأَعْرَجِ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : مِنْکُمْ مَنْ یَقُولُ ہَکَذَا ، وَرَفَعَ سُفْیَانُ یَدَیْہِ حَتَّی تَجَاوَزَ بِہِمَا رَأْسَہُ ، وَمِنْکُمْ مَنْ یَقُولُ ہَکَذَا ، وَوَضَعَ یَدَیْہِ عِنْدَ بَطْنِہِ ، وَمِنْکُمْ مَنْ یَقُولُ ہَکَذَا ، یَعْنِی : حَذْوَ مَنْکِبَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2437","","","كتاب الصلوات"
"2438","(۲۴۳۸) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا إذَا قَامَ یَرْفَعُ یَدَیْہِ حَذْوَ مَنْکِبَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2438","","","كتاب الصلوات"
"2439","(۲۴۳۹) حَدَّثَنَا أَحْمَدُ بْنُ بَشِیرٍ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ سَالِمٍ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ حَذْوَ مَنْکِبَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2439","","","كتاب الصلوات"
"2440","(۲۴۴۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ إذَا افْتَتَحَ ال??َّلاَۃَ ، وَإِذَا رَکَعَ وَبَعْدَمَا یَرْفَعُ ، وَلاَ یَرْفَعُ یَدَیْہِ بَیْنَ السَّجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 2440","","","كتاب الصلوات"
"2441","(۲۴۴۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْفَعُ یَدَیْہِ کُلَّمَا رَکَعَ وَرَفَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 2441","","","كتاب الصلوات"
"2442","(۲۴۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قتادۃ ، عَنْ نَصْرِ بْنِ عَاصِمٍ ، عَنْ مَالِکِ بْنِ الْحُوَیْرِثِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُکَبِّرُ إذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ حَتَّی یُحَاذِیَ بِہِمَا فُرُوعَ أُذُنَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2442","","","كتاب الصلوات"
"2443","(۲۴۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَرْفَعُ یَدَیْہِ إذَا افْتَتَحَ ، وَإِذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ ، وَلاَ یُجَاوِزُ بِہِمَا أُذُنَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2443","","","كتاب الصلوات"
"2444","(۲۴۴۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 2444","","","كتاب الصلوات"
"2445","(۲۴۴۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا لَیْثٌ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ أَبَا سَعِیدٍ الْخُدْرِیَّ ، وَابْنَ عُمَرَ، وَابْنَ عَبَّاسٍ، وَابْنَ الزُّبَیْرِ ؛ یَرْفَعُونَ أَیْدِیَہُمْ ، نَحْوٌ مِنْ حَدِیثِ الزُّہْرِیِّ۔","Da'if","Musannaf Ibn Abi Shaybah 2445","","","كتاب الصلوات"
"2446","(۲۴۴۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو حَمْزَۃَ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَرْفَعُ یَدَیْہِ إذَا افْتَتَحَ الصَّلاَۃَ ، وَإِذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ۔","Hasan","Musannaf Ibn Abi Shaybah 2446","","","كتاب الصلوات"
"2447","(۲۴۴۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی صَلاَتِہِمْ کَأَنَّ أَیْدِیَہُمُ الْمَرَاوِحُ إذَا رَکَعُوا ، وَإِذَا رَفَعُوا رُؤُوسَہُمْ۔","","Musannaf Ibn Abi Shaybah 2447","","","كتاب الصلوات"
"2448","(۲۴۴۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ إذَا دَخَلَ فِی الصَّلاَۃِ ، وَإِذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 2448","","","كتاب الصلوات"
"2449","(۲۴۴۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَرْفَعُ یَدَیْہِ فِی الرُّکُوعِ وَالسُّجُودِ۔ (ابن ماجہ ۸۶۶۔ دارقطنی ۱۱)","Shadh","Musannaf Ibn Abi Shaybah 2449","","","كتاب الصلوات"
"2450","(۲۴۵۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ ، یَفْعَلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2450","","","كتاب الصلوات"
"2451","(۲۴۵۱) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَرْفَعُ یَدَیْہِ إذَا دَخَلَ الصَّلاَۃَ ، وَإِذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2451","","","كتاب الصلوات"
"2452","(۲۴۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ؛ أَنَّ أَبَا قِلاَبَۃَ کَانَ یَرْفَعُ یَدَیْہِ إذَا رَکَعَ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2452","","","كتاب الصلوات"
"2453","(۲۴۵۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا عَبْدُ الْحَمِیدِ بْنُ جَعْفَرٍ الأَنْصَارِیُّ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ الْقُرَشِیِّ، قَالَ : رَأَیْتُ أَبَا حُمَیْدٍ السَّاعِدِیَّ مَعَ عَشَرَۃِ رَہْطٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَلاَ أُحَدِّثُکُمْ عَنْ صَلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالُوا : ہَاتِ ، قَالَ : رَأَیْتُہ إذَا کَبَّرَ عِنْدَ فَاتِحَۃِ الصَّلاَۃِ رَفَعَ یَدَیْہِ ، وَإِذَا رَکَعَ رَفَعَ یَدَیْہِ ، وَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ رَفَعَ یَدَیْہِ ، ثُمَّ یَمْکُثُ قَائِمًا حَتَّی یَقَعَ کُلُّ عَظْمٍ فِی مَوْضِعِہِ ، ثُمَّ یَہْبِطُ سَاجِدًا وَیُکَبِّرُ۔ (ترمذی ۳۰۴۔ ابوداؤد ۷۳۰)","Sahih","Musannaf Ibn Abi Shaybah 2453","","","كتاب الصلوات"
"2454","(۲۴۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : رَأَیْتُہ یَرْفَعُ یَدَیْہِ فِی الرُّکُوعِ وَالسُّجُودِ ، فَقُلْتُ لَہُ : مَا ہَذَا ؟ فَقَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَامَ فی الرَّکْعَتَیْنِ کَبَّرَ وَرَفَعَ یَدَیْہِ۔ (بخاری ۷۳۹۔ ابوداؤد ۷۴۱)","Sahih","Musannaf Ibn Abi Shaybah 2454","","","كتاب الصلوات"
"2455","(۲۴۵۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ وَعِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا افْتَتَحَ الصَّلاَۃَ رَفَعَ یَدَیْہِ ، ثُمَّ لاَ یَرْفَعُہُمَا حَتَّی یَفْرُغَ۔n(ابوداؤد ۷۴۹۔ دارقطنی ۲۲)","Da'if","Musannaf Ibn Abi Shaybah 2455","","","كتاب الصلوات"
"2456","(۲۴۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ عَبْدِ الرحمن بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : أَلاَ أُرِیکُمْ صَلاَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَلَمْ یَرْفَعْ یَدَیْہِ إِلاَّ مَرَّۃً۔n(ترمذی ۲۵۷۔ ابوداؤ ۷۴۸)","Sahih","Musannaf Ibn Abi Shaybah 2456","","","كتاب الصلوات"
"2457","(۲۴۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ بْنِ قِطَافٍ النَّہْشَلِیِّ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ یَرْفَعُ یَدَیْہِ إذَا افْتَتَحَ الصَّلاَۃَ ، ثُمَّ لاَ یَعُودُ۔","Hasan","Musannaf Ibn Abi Shaybah 2457","","","كتاب الصلوات"
"2458","(۲۴۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ فِی أَوَّلِ مَا یَفْْتَتِحُ ، ثُمَّ لاَ یَرْفَعُہُمَا۔","","Musannaf Ibn Abi Shaybah 2458","","","كتاب الصلوات"
"2459","(۲۴۵۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ فِی أَوَّلِ التَّکْبِیرَۃِ ، ثُمَّ لاَ یَرْفَعُہُمَا۔","","Musannaf Ibn Abi Shaybah 2459","","","كتاب الصلوات"
"2460","(۲۴۶۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ : إذَا کَبَّرْتَ فِی فَاتِحَۃِ الصَّلاَۃِ فَارْفَعْ یَدَیْک ، ثُمَّ لاَ تَرْفَعْہُمَا فِیمَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 2460","","","كتاب الصلوات"
"2461","(۲۴۶۱) حَدَّثَنَا وَکِیعٌ ، وَأَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ ، وَأَصْحَابُ عَلِیٍّ ، لاَ یَرْفَعُونَ أَیْدِیَہُمْ إِلاَّ فِی افْتِتَاحِ الصَّلاَۃِ ، قَالَ وَکِیعٌ : ثُمَّ لاَ یَعُودُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2461","","","كتاب الصلوات"
"2462","(۲۴۶۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ حُصَیْنٍ وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَرْفَعْ یَدَیْک فِی شَیْئٍ مِنَ الصَّلاَۃِ إِلاَّ فِی الافْتِتَاحَۃِ الأُولَی۔","No Data Available","Musannaf Ibn Abi Shaybah 2462","","","كتاب الصلوات"
"2463","(۲۴۶۳) حَدَّثَنَا أَبُو بَکْرٍ ، عَنِ الْحَجَّاجِ ، عَنْ طَلْحَۃَ ، عَنْ خَیْثَمَۃَ وَإِبْرَاہِیمَ ، قَالَ : کَانَا لاَ یَرْفَعَانِ أَیْدِیَہُمَا إِلاَّ فِی بَدْئِ الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 2463","","","كتاب الصلوات"
"2464","(۲۴۶۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ إسْمَاعِیلَ ، قَالَ : کَانَ قَیْسٌ یَرْفَعُ یَدَیْہِ أَوَّلَ مَا یَدْخُلُ فِی الصَّلاَۃِ ، ثُمَّ لاَ یَرْفَعُہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2464","","","كتاب الصلوات"
"2465","(۲۴۶۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تُرْفَعُ الأَیْدِی فِی سَبْعَۃِ مَوَاطِنَ : إذَا قَامَ إلَی الصَّلاَۃِ ، وَإِذَا رَأَی الْبَیْتَ ، وَعَلَی الصَّفَا وَالْمَرْوَۃِ ، وَفِی عَرَفَاتٍ ، وَفِی جَمْعٍ ، وَعِنْدَ الْجِمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 2465","","","كتاب الصلوات"
"2466","(۲۴۶۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہُشَیْمٍ ، عَنْ سُفْیَانَ ، عَنْ مُسْلِمٍ الْجُہَنِیِّ ، قَالَ : کَانَ ابْنُ أَبِی لَیْلَی یَرْفَعُ یَدَیْہِ أَوَّلَ شَیْئٍ إذَا کَبَّرَ۔","","Musannaf Ibn Abi Shaybah 2466","","","كتاب الصلوات"
"2467","(۲۴۶۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا رَأَیْت ابْنَ عُمَرَ یَرْفَعُ یَدَیْہِ إِلاَّ فِی أَوَّلِ مَا یَفْتَتِحُ۔","Sahih","Musannaf Ibn Abi Shaybah 2467","","","كتاب الصلوات"
"2468","(۲۴۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ جَابِرٍ ، عَنِ الأَسْوَدِ وَعَلْقَمَۃَ ؛ أَنَّہُمَا کَانَا یَرْفَعَانِ أَیْدِیَہُمَا إذَا افْتَتَحَا ، ثُمَّ لاَ یَعُودَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2468","","","كتاب الصلوات"
"2469","(۲۴۶۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ، عَنْ حَسَنِ بْنِ عَیَّاشٍ، عَنْ عَبْدِالْمَلِکِ بْنِ أَبْجَرَ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ، عَنْ إبْرَاہِیمَ، عَنِ الأَسْوَدِ ، قَالَ : صَلَّیْت مَعَ عُمَرَ فَلَمْ یَرْفَعْ یَدَیْہِ فِی شَیْئٍ مِنْ صَلاَتِہِ إِلاَّ حِینَ افْتَتَحَ الصَّلاَۃَ ، قَالَ عَبْدُ الْمَلِکِ : وَرَأَیْت الشَّعْبِیَّ ، وَإِبْرَاہِیمَ ، وَأَبَا إِسْحَاقَ ، لاَ یَرْفَعُونَ أَیْدِیَہُمْ إِلاَّ حِینَ یَفْتَتِحُونَ الصَّلاَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 2469","","","كتاب الصلوات"
"2470","(۲۴۷۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : افْتَتَحَ عُمَرُ الصَّلاَۃَ ، ثُمَّ کَبَّرَ ، ثُمَّ قَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، وَتَبَارَکَ اسْمُک وَتَعَالَی جَدُّک، وَلاَ إلَہَ غَیْرُک ، أَعُوذُ بِاللَّہِ مِنَ الشَّیْطَانِ الرَّجِیمِ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 2470","","","كتاب الصلوات"
"2471","(۲۴۷۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ ، قَالَ : سَمِعْتُ عُمَرَ افْتَتَحَ الصَّلاَۃَ وَکَبَّرَ ، فَقَالَ : سُبْحَانَک اللَّہُمَّ وَبِحَمْدِکَ ، تَبَارَکَ اسْمُک وَتَعَالَی جَدُّک ، وَلاَ إلَہَ غَیْرُک ، ثُمَّ یَتَعَوَّذُ۔","Sahih","Musannaf Ibn Abi Shaybah 2471","","","كتاب الصلوات"
"2472","(۲۴۷۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ کَانَ یَتَعَوَّذُ یَقُولُ : أَعُوذُ بِاللَّہِ مِنَ الشَّیْطَانِ الرَّجِیمِ ، أَوْ أَعُوذُ بِاللَّہِ السَّمِیعِ الْعَلِیمِ مِنَ الشَّیْطَانِ الرَّجِیمِ۔","Sahih","Musannaf Ibn Abi Shaybah 2472","","","كتاب الصلوات"
"2473","(۲۴۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ کَہْمَسٍ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ، قَالَ: سَمِعَنِی أَبِی وَأَنَا أَسْتَعِیذُ بِالسَّمِیعِ الْعَلِیمِ ، فَقَالَ: مَا ہَذَا ؟ قُلْ : أَعُوذُ بِاللَّہِ مِنَ الشَّیْطَانِ الرَّجِیمِ ، إنَّ اللَّہَ ہُوَ السَّمِیعُ الْعَلِیمُ۔","","Musannaf Ibn Abi Shaybah 2473","","","كتاب الصلوات"
"2474","(۲۴۷۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَتَعَوَّذُ قَبْلَ قِرَائَۃِ فَاتِحَۃِ الْکِتَابِ وَبَعْدَہَا، وَیَقُولُ فِی تَعَوُّذِہِ : أَعُوذُ بِاَللَّہِ السَّمِیعِ الْعَلِیمِ مِنْ ہَمَزَاتِ الشَّیَاطِینِ ، وَأَعُوذُ بِاللَّہِ أَنْ یَحْضُرُونِ۔","","Musannaf Ibn Abi Shaybah 2474","","","كتاب الصلوات"
"2475","(۲۴۷۵) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبَّادِ بْنِ عَاصِمٍ ، عَنْ نَافِعِ بْنِ جُبَیْرِ بْنِ مُطْعِمٍ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ افْتَتَحَ الصَّلاَۃَ ، قَالَ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الشَّیْطَانِ الرَّجِیمِ ، مِنْ ہَمْزِہِ ، وَنَفْخِہِ ، وَنَفْثِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2475","","","كتاب الصلوات"
"2476","(۲۴۷۶) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَبَّحَ ، أَوْ کَبَّرَ ، أَوْ ہَلَّلَ أَجْزَأَہُ فِی الإِفْتِتَاحِ، وَیَسْجُدُ سَجْدَتَیِ السَّہْوِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2476","","","كتاب الصلوات"
"2477","(۲۴۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی، عَنِ الْحَکَمِ ، قَالَ: إذَا سَبَّحَ، أَوْ ہَلَّلَ فِی افْتِتَاحِ الصَّلاَۃِ، أَجْزَأَہُ مِنَ التَّکْبِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2477","","","كتاب الصلوات"
"2478","(۲۴۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زِیَادِ بْنِ أَبِی مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا الْعَالِیَۃِ سُئِلَ ، بِأَیِّ شَیْئٍ کَانَ الأَنْبِیَائُ یَسْتَفْتِحُونَ الصَّلاَۃَ ؟ قَالَ : بِالتَّوْحِیدِ ، وَالتَّسْبِیحِ ، وَالتَّہْلِیلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2478","","","كتاب الصلوات"
"2479","(۲۴۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ رَجُلٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : بِأَیِّ أَسْمَائِ اللہِ افْتَتَحْت الصَّلاَۃَ أَجْزَأَک۔","No Data Available","Musannaf Ibn Abi Shaybah 2479","","","كتاب الصلوات"
"2480","(۲۴۸۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَسِیَ تَکْبِیرَۃَ الافْتِتَاحِ اسْتَأْنَفَ۔","","Musannaf Ibn Abi Shaybah 2480","","","كتاب الصلوات"
"2481","(۲۴۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَنْسَی تَکْبِیرَۃَ الافْتِتَاحِ ، قَالَ : تُجْزِئُہُ تَکْبِیرَۃُ الرُّکُوعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2481","","","كتاب الصلوات"
"2482","(۲۴۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ قَالَ ؛ فِی الرَّجُلِ إذَا نَسِیَ أَنْ یُکَبِّر حِینَ یَفْتَتِحُ الصَّلاَۃَ ، فَإِنَّہُ یُکَبِّرُ إذَا ذَکَرَ ، فَإِن لَمْ یَذْکُرْ حَتَّی یُصَلِّیَ مَضَتْ صَلاَتُہُ ، وَتُجْزِئُ ہُ تَکْبِیرَۃُ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2482","","","كتاب الصلوات"
"2483","(۲۴۸۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ حَمَّادٍ ، قَالَ : إذَا نَسِیَ الإِمَامُ التَّکْبِیرَۃَ الأُولَی الَّتِی یَفْتَتِحُ بِہَا الصَّلاَۃَ أَعَادَہ ، قَالَ الْحَکَمُ : یُجْزِئُ ہُ تَکْبِیرَۃُ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2483","","","كتاب الصلوات"
"2484","(۲۴۸۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، قَالَ : یُکَبِّرُ إذَا ذَکَرَ۔","","Musannaf Ibn Abi Shaybah 2484","","","كتاب الصلوات"
"2485","(۲۴۸۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ رَبِّہِ بْنِ زَیْتُونَ ، قَالَ : رَأَیْتُ أُمَّ الدَّرْدَائِ تَرْفَعُ یَدَیْہَا حَذْوَ مَنْکِبَیْہَا حِینَ تَفْتَتِحُ الصَّلاَۃَ ، وَإذَا قَالَ الإِمَامُ سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، رَفَعَتْ یَدَیْہَا فِی الصَّلاَۃِ ، وَقَالَتَ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 2485","","","كتاب الصلوات"
"2486","(۲۴۸۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا شَیْخٌ لَنَا ، قَالَ : سَمِعْتُ عَطَائً ؛ سُئِلَ عَنِ الْمَرْأَۃِ کَیْفَ تَرْفَعُ یَدَیْہَا فِی الصَّلاَۃِ ؟ قَالَ : حَذْوَ ثَدْیَیْہَا۔","","Musannaf Ibn Abi Shaybah 2486","","","كتاب الصلوات"
"2487","(۲۴۸۷) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَرْفَعُ یَدَیْہَا حَذْوَ مَنْکِبَیْہَا۔","","Musannaf Ibn Abi Shaybah 2487","","","كتاب الصلوات"
"2488","(۲۴۸۸) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ عِیسَی بْنِ کَثِیرٍ ، عَنْ حَمَّادٍ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْمَرْأَۃِ إذَا اسْتَفْتَحَتِ الصَّلاَۃَ ، تَرْفَعُ یَدَیْہَا إلَی ثَدْیَیْہَا۔","","Musannaf Ibn Abi Shaybah 2488","","","كتاب الصلوات"
"2489","(۲۴۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ ??َکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : تُشِیرُ الْمَرْأَۃُ بِیَدَیْہَا بِالتَّکْبِیرِ کَالرَّجُلِ ؟ قَالَ : لاَ تَرْفَعُ بِذَلِکَ یَدَیْہَا کَالرَّجُلِ ، وَأَشَارَ فَخَفَضَ یَدَیْہِ جِدًّا ، وَجَمَعَہُمَا إلَیْہِ جِدًّا ، وَقَالَ : إنَّ لِلْمَرْأَۃِ ہَیْئَۃً لَیْسَتْ لِلرَّجُلِ ، وَإِنْ تَرَکَتْ ذَلِکَ فَلاَ حَرَجَ۔","","Musannaf Ibn Abi Shaybah 2489","","","كتاب الصلوات"
"2490","(۲۴۹۰) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ مَیْمُونٍ ، قَالَ : حَدَّثَنِی عَاصِمٌ الأَحْوَلُ ، قَالَ : رَأَیْتُ حَفْصَۃَ بِنْتَ سِیرِینَ کَبَّرَتْ فِی الصَّلاَۃِ ، وَأَوْمَأَتْ حَذْوَ ثَدْیَیْہَا ، وَوَصَفَ یَحْیَی فَرَفَعَ یَدَیْہِ جَمیعًا۔","","Musannaf Ibn Abi Shaybah 2490","","","كتاب الصلوات"
"2491","(۲۴۹۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ وَالأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُکَبِّرُ فِی کُلِّ رَفْعٍ ، وَوَضْعٍ ، وَقِیَامٍ ، وَقُعُودٍ ، وَأَبُو بَکْرٍ ، وَعُمَرُ۔ (ترمذی ۲۵۳۔ احمد ۴۴۳)","Sahih","Musannaf Ibn Abi Shaybah 2491","","","كتاب الصلوات"
"2492","(۲۴۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ الأَصَمِّ ، عَنْ أَنَسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَأَبُو بَکْرٍ ، وَعُمَرُ ، وَعُثْمَانَ لاَ یُنْقِصُونَ التَّکْبِیرَ۔ (احمد ۳/۱۲۵۔ عبدالرزاق ۲۵۰)","Sahih","Musannaf Ibn Abi Shaybah 2492","","","كتاب الصلوات"
"2493","(۲۴۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْحَکَمِ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ؛ أَنَّ عُمَرَ کَانَ یُتِمُّ التَّکْبِیرَ۔","Sahih","Musannaf Ibn Abi Shaybah 2493","","","كتاب الصلوات"
"2494","(۲۴۹۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ نُعَیْمِ بْنِ حَکِیمٍ ، عَنْ أَبِی مَرْیَمَ ، قَالَ : قَالَ عَمَّارٌ : لَوْ لَمْ یُدْرِکْ عَلِیٌّ مِنَ الْفَضْلِ إِلاَّ إحْیَائَ ہَاتَیْنِ التَّکْبِیرَتَیْنِ ، یَعْنِی : إذَا رَکَعَ ، وَإِذَا سَجَدَ۔","Majhul","Musannaf Ibn Abi Shaybah 2494","","","كتاب الصلوات"
"2495","(۲۴۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : أَوْصَانِی قَیْسُ بْنُ عُبَادٍ أَنْ أُکَبِّرَ کُلَّمَا سَجَدْت وَکُلَّمَا رَفَعْت۔","No Data Available","Musannaf Ibn Abi Shaybah 2495","","","كتاب الصلوات"
"2496","(۲۴۹۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، قَالَ : کَانَ جَابِرُ بْنُ عَبْدِ اللہِ یُعَلِّمُنَا التَّکْبِیْرَ فِی الصَّلاَۃِ ، نُکَبِّرَ إذَا خَفَضْنَا ، وَإِذَا رَفَعْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 2496","","","كتاب الصلوات"
"2497","(۲۴۹۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ مَرْوَانَ کَانَ یَسْتَخْلِفُ أَبَا ہُرَیْرَۃَ ، فَکَانَ یُتِمُّ التَّکْبِیرَ وَکَانَ ابْنُ عُمَرَ یُتِمُّ التَّکْبِیرَ۔","Sahih","Musannaf Ibn Abi Shaybah 2497","","","كتاب الصلوات"
"2498","(۲۴۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَوْنِ بْنِ عَبْدِاللہِ، قَالَ: کَانَ ابْنُ مَسْعُودٍ یُتِمُّ التَّکْبِیرَ۔","Da'if","Musannaf Ibn Abi Shaybah 2498","","","كتاب الصلوات"
"2499","(۲۴۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یُکَبِّرُ کُلَّمَا سَجَدَ ، وَکُلَّمَا رَفَعَ ، وَکُلَّمَا نَہَضَ۔","Sahih","Musannaf Ibn Abi Shaybah 2499","","","كتاب الصلوات"
"2500","(۲۵۰۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی رَزِینٍ ، قَالَ : صَلَّیْت خَلْفَ عَلِیٍّ ، وَابْنِ مَسْعُودٍ فَکَانَا یُتِمَّانِ التَّکْبِیرَ۔","Sahih","Musannaf Ibn Abi Shaybah 2500","","","كتاب الصلوات"
"2501","(۲۵۰۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یُکَبِّرُ إذَا سَجَدَ ، وَإِذَا نَہَضَ بَیْنَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 2501","","","كتاب الصلوات"
"2502","(۲۵۰۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ أَبِی عُثْمَانَ ؛ أَنَّہُ کَانَ یُکَبِّرُ إذَا سَجَدَ ، وَإِذَا نَہَضَ بَیْنَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 2502","","","كتاب الصلوات"
"2503","(۲۵۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُتِمُّ التَّکْبِیرَ۔","","Musannaf Ibn Abi Shaybah 2503","","","كتاب الصلوات"
"2504","(۲۵۰۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ؛ أَنَّ ابْنَ الزُّبَیْرِ کَانَ یُکَبِّرُ لِنَہْضَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2504","","","كتاب الصلوات"
"2505","(۲۵۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ أَبِی مَالِکٍ الأَشْعَرِیِّ ؛ أَنَّہُ قَالَ لِقَوْمِہِ : قُومُوا حَتَّی أُصَلِّیَ بِکُمْ صَلاَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَصَفَّنَا خَلْفَہُ، فَکَبَّرَ ، ثُمَّ قَرَأَ ، ثُمَّ کَبَّرَ ، ثُمَّ رکع ، ثُمَّ رَفَعَ رَأْسَہُ فَکَبَّرَ ، فَصَنَعَ ذَلِکَ فِی صَلاَتِہِ کُلِّہَا۔n(احمد ۳۴۲۔ طبرانی ۳۴۱۱)","","Musannaf Ibn Abi Shaybah 2505","","","كتاب الصلوات"
"2506","(۲۵۰۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بُرَید بْنِ أَبِی مَرْیَمَ ، عْن أَبِی مُوسَی ، قَالَ : صَلَّی بِنَا عَلِیٌّ یَوْمَ الْجَمَلِ صَلاَۃً ، ذَکَّرَنَا بِہَا صَلاَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَإِمَّا أَنْ نَکُونَ نَسِینَاہَا ، وَإِمَّا أَنْ نَکُونَ تَرَکْنَاہَا عَمْدًا ، یُکَبِّرُ فِی کُلِّ رَفْعٍ وَخَفْضٍ ، وَقِیَامٍ وَقُعُودٍ ، وَیُسَلِّمُ عَنْ یَمِینِہِ وَیَسَارِہِ۔n(ابن ماجہ ۹۱۷۔ احمد ۴/۳۹۲)","","Musannaf Ibn Abi Shaybah 2506","","","كتاب الصلوات"
"2507","(۲۵۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، قَالَ : حَدَّثَنَا الْوَلِیدُ ، عَنْ غَیْلاَنَ بْنِ جَرِیرٍ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : صَلَّیْتُ أَنَا وَعِمْرَانُ بْنُ حُصَیْنٍ مَعَ عَلِیٍّ فَجَعَلَ یُکَبِّرُ إذَا سَجَدَ ، وَإِذَا رَفَعَ رَأْسَہُ ، فَلَمَّا انْفَتَلَ مِنْ صَلاَتِہِ ، قَالَ عِمْرَانُ : صَلَّی بِنَا ہَذَا مِثْل صَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(بخاری ۸۲۶۔ مسلم ۳۳)","Sahih","Musannaf Ibn Abi Shaybah 2507","","","كتاب الصلوات"
"2508","(۲۵۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ یُکَبِّرُ کُلَّمَا رَفَعَ وَکُلَّمَا رَکَعَ ، قَالَ : فَذُکِرَ ذَلِکَ لأَبِی جَعْفَرٍ ، فَقَالَ : قَدْ عَلِمَ أَنَّہَا صَلاَۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ سَعِیدٌ : إنَّمَا ہُوَ شَیْئٌ یُزَیِّنُ بِہِ الرَّجُلُ صَلاَتَہُ۔","","Musannaf Ibn Abi Shaybah 2508","","","كتاب الصلوات"
"2509","(۲۵۰۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَخْبَرَنِی عَلِیُّ بْنُ حُسَیْنٍ ، قَالَ : إِنَّہَا کَانَتْ صَلاَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَذُکرَ لَہُ أَنَّ أَبَا ہُرَیْرَۃَ کَانَ یُکَبِّرُ فِی کُلِّ خَفْضٍ وَرَفْعٍ۔ (عبدالرزاق ۲۴۹۷)","","Musannaf Ibn Abi Shaybah 2509","","","كتاب الصلوات"
"2510","(۲۵۱۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : رَأَیْتُ یَعْلَی یُصَلِّی عِنْدَ الْمَقَامِ یُکَبِّرُ فِی کُلِّ وَضْعٍ وَرَفْعٍ ، قَالَ : فَأَتَیْتُ ابْنَ عَبَّاسٍ فَأَخْبَرْتُہُ بِذَلِکَ ، فَقَالَ لِی ابْنُ عَبَّاسٍ : أَوَلَیْسَ تِلْکَ صَلاَۃُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ أُمَّ لِعِکْرِمَۃَ۔ (بخاری ۷۸۷۔ ابن خزیمہ ۵۷۷)","Sahih","Musannaf Ibn Abi Shaybah 2510","","","كتاب الصلوات"
"2511","(۲۵۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کَانَ إذَا صَلَّی لَنَا کَبَّرَ کُلَّمَا رَفَعَ وَوَضَعَ ، وَإِذَا انْصَرَفَ ، قَالَ : أَنَا أَشْبَہُکُمْ صَلاَۃً بِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ۔ (بخاری ۷۸۵۔ مسلم ۲۹۳)","Hasan","Musannaf Ibn Abi Shaybah 2511","","","كتاب الصلوات"
"2512","(۲۵۱۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنِ الْحَسَنِ بْنِ عِمْرَانَ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، قَالَ : صَلَّیْت خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ لاَ یُتِمُّ التَّکْبِیرَ۔ (احمد ۳/۴۰۷)","Hasan","Musannaf Ibn Abi Shaybah 2512","","","كتاب الصلوات"
"2513","(۲۵۱۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَسَنِ بْنِ عِمْرَانَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ لاَ یُتِمُّ التَّکْبِیرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2513","","","كتاب الصلوات"
"2514","(۲۵۱۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَکَانَ لاَ یُتِمُّ التَّکْبِیرَ۔","","Musannaf Ibn Abi Shaybah 2514","","","كتاب الصلوات"
"2515","(۲۵۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَوَّلُ مَنْ نَقَصَ التَّکْبِیرَ زِیَادٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2515","","","كتاب الصلوات"
"2516","(۲۵۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَدِ اللہِ بْنِ عُمَرَ ، قَالَ : صَلَّیْت خَلْفَ الْقَاسِمِ وَسَالِمٍ فَکَانَا لاَ یُتِمَّانِ التَّکْبِیرَ۔","","Musannaf Ibn Abi Shaybah 2516","","","كتاب الصلوات"
"2517","(۲۵۱۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ وَسَالِمٍ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2517","","","كتاب الصلوات"
"2518","(۲۵۱۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : صَلَّیْت مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، فَکَانَ لاَ یُتِمُّ التَّکْبِیرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2518","","","كتاب الصلوات"
"2519","(۲۵۱۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مِسْعَرٍ ، عَنْ یَزِیدَ الْفَقِیرِ ، قَالَ : کَانَ ابْنُ عُمَرَ یَنْقُصُ التَّکْبِیرَ فِی الصَّلاَۃِ، قَالَ مِسْعَرٌ : إذَا انْحَطَّ بَعْدَ الرُّکُوعِ لِلسُّجُودِ لَمْ یُکَبِّرْ ، فَإِذَا أَرَادَ أَنْ یَسْجُدَ الثَّانِیَۃَ لَمْ یُکَبِّرْ۔","Sahih","Musannaf Ibn Abi Shaybah 2519","","","كتاب الصلوات"
"2520","(۲۵۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ وَزَیْدِ بْنِ ثَابِتٍ قَالاَ : إذَا أَدْرَکَ الرَّجُلُ الْقَوْمَ رُکُوعًا ، فَإِنَّہُ یُجْزِئُہُ تَکْبِیرَۃٌ وَاحِدَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2520","","","كتاب الصلوات"
"2521","(۲۵۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ وَزَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُمَا کَانَا یَجِیئَانِ وَالإِمَامُ رَاکِعٌ فَیُکَبِّرَانِ تَکْبِیرَۃَ الافْتِتَاحِ لِلصَّلاَۃِ وَلِلرَّکْعَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 2521","","","كتاب الصلوات"
"2522","(۲۵۲۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : وَاحِدَۃٌ تُجْزِئُک۔","","Musannaf Ibn Abi Shaybah 2522","","","كتاب الصلوات"
"2523","(۲۵۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : قُلْتُ لابْنِ أَبِی نَجِیحٍ : الرَّجُلُ یَنْتَہِی إلَی الْقَوْمِ وَہُمْ رُکُوعٌ فَیُکَبِّرُ تَکْبِیرَۃً وَیَرْکَعُ ؟ قَالَ : کَانَ مُجَاہِدٌ یَقُولُ : تُجْزِئہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2523","","","كتاب الصلوات"
"2524","(۲۵۲۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : تُجْزِئہُ التَّکْبِیرَۃُ ، وَإِنْ زَادَ فَہُوَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 2524","","","كتاب الصلوات"
"2525","(۲۵۲۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : تُجْزِئہُ التَّکْبِیرَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2525","","","كتاب الصلوات"
"2526","(۲۵۲۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عُمَارَۃَ ، عَنْ بَکْرٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : کَبِّرْ تَکْبِیرَۃً۔","","Musannaf Ibn Abi Shaybah 2526","","","كتاب الصلوات"
"2527","(۲۵۲۷) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ؛ تُجْزِئہُ تَکْبِیرَۃٌ۔","","Musannaf Ibn Abi Shaybah 2527","","","كتاب الصلوات"
"2528","(۲۵۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ یُکَبِّرَ تَکْبِیرَتَیْنِ ، فَإِنْ عَجَّلَ ، أَوْ نَسِیَ فَکَبَّرَ تَکْبِیرَۃً أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 2528","","","كتاب الصلوات"
"2529","(۲۵۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، فَقَالَ : تُجْزِئُہُ تَکْبِیرَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2529","","","كتاب الصلوات"
"2530","(۲۵۳۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : یُکَبِّرُ تَکْبِیرَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2530","","","كتاب الصلوات"
"2531","(۲۵۳۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ رَبِیعٍ ، عَنْ إبْرَاہِیمَ الْحَنَفِیِّ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنِ الرَّجُلِ یَجِیئُ إلَی الإِمَامِ وَہُوَ رَاکِعٌ ؟ قَالَ : لِیَفْتَتِح الصَّلاَۃَ بِتَکْبِیرَۃٍ ، وَیُکَبِّرُ لِلرُّکُوعِ ، فَإِنْ لَمْ یَفْعَلْ فَلا یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 2531","","","كتاب الصلوات"
"2532","(۲۵۳۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : یُکَبِّرُ تَکْبِیرَۃً لِلإِفْتِتَاحِ وَیُکَبِّرُ لِلرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2532","","","كتاب الصلوات"
"2533","(۲۵۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنِ أَبی عَبْدِالرَّحْمَنِ، قَالَ: یُکَبِّرُ تَکْبِیرَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 2533","","","كتاب الصلوات"
"2534","(۲۵۳۴) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا جِئْت وَالإِمَامُ رَاکِعٌ فَوَضَعْتَ یَدَیْک عَلَی رُکْبَتَیْک قَبْلَ أَنْ یَرْفَعَ رَأْسَہُ ، فَقَدْ أَدْرَکْت۔","Sahih","Musannaf Ibn Abi Shaybah 2534","","","كتاب الصلوات"
"2535","(۲۵۳۵) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَنْ أَدْرَکَ الإِمَامَ قَبْلَ أَنْ یَرْفَعَ رَأْسَہُ ، فَقَدْ أَدْرَکَ السَّجْدَۃَ۔","","Musannaf Ibn Abi Shaybah 2535","","","كتاب الصلوات"
"2536","(۲۵۳۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ : الرَّجُلُ یَنْتَہِی إلَی الْقَوْمِ وَہُمْ رُکُوعٌ وَقَدْ رَفَعَ الإِمَامُ رَأْسَہُ ؟ قَالَ : بَعْضُکُمْ أَئِمَّۃُ بَعْضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2536","","","كتاب الصلوات"
"2537","(۲۵۳۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : إذَا دَخَلْت الْمَسْجِدَ وَالْقَوْمُ رُکُوعٌ ، فَکَبَّرْتَ ثُمَّ رَکَعْتَ قَبْلَ أَنْ یَرْفَعُوا رُؤُوسَہُمْ ، فَقَدْ أَدْرَکْت الرَّکْعَۃَ۔","","Musannaf Ibn Abi Shaybah 2537","","","كتاب الصلوات"
"2538","(۲۵۳۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمِ الْبَرَّاد ، قَالَ : أَتَیْنَا أَبَا مَسْعُودٍ فَقُلْنَا : أَرِنَا صَلاَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَبَّرَ ثُمَّ رَکَعَ ، فَوَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ ، ثُمَّ قَالَ : ہَکَذَا صَلَّی بِنَا۔n(ابوداؤد ۸۵۹۔ احمد ۴/۱۱۹)","Da'if","Musannaf Ibn Abi Shaybah 2538","","","كتاب الصلوات"
"2539","(۲۵۳۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : کُنْتُ فِیمَنْ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقُلْتُ : لأَنْظُرَنَّ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا أَرَادَ أَنْ یَرْکَعَ رَفَعَ یَدَیْہِ ، ثُمَّ رَکَعَ فَوَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2539","","","كتاب الصلوات"
"2540","(۲۵۴۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عَلِیِّ بْنِ یَحْیَی بْنِ خَلاَّدٍ ، عَنْ رِفَاعَۃَ بْنِ رَافِعٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِرَجُلٍ : إذَا اسْتَقْبَلْتَ الْقِبْلَۃَ فَکَبِّرْ وَاقْرَأْ بِمَا شِئْت ، فَإِذَا أَرَدْت أَنْ تَرْکَعَ فَاجْعَلْ رَاحَتَیْک عَلَی رُکْبَتَیْک ، وَمَکِّنْ لِرُکُوعِک۔ (ترمذی ۳۰۲۔ احمد ۳۴۰)","Hasan","Musannaf Ibn Abi Shaybah 2540","","","كتاب الصلوات"
"2541","(۲۵۴۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَارِثَۃَ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ رَکَعَ فَوَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔ (ابن ماجہ ۸۷۴)","Da'if","Musannaf Ibn Abi Shaybah 2541","","","كتاب الصلوات"
"2542","(۲۵۴۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عُمَرَ رَاکِعًا وَقَدْ وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","","Musannaf Ibn Abi Shaybah 2542","","","كتاب الصلوات"
"2543","(۲۵۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی مَعْمَرٍ ، عَنْ عُمَرَ ؛ أَنَّہُ کَانَ إذَا رَکَعَ وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2543","","","كتاب الصلوات"
"2544","(۲۵۴۴) حَدَّثَنَا عَبْدَۃُ ، وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ مُصْعَبِ بْنِ سعْدٍ ، قَالَ : رَکَعْت إلَی جَنْبِ أَبِی ، فَجَعَلْتُ یَدَیَّ بَیْنَ رُکْبَتَیَّ ، فَضَرَبَ سَعْدٌ یَدِی ، ثُمَّ قَالَ : کُنَّا نَفْعَلُ ہَذَا ، ثُمَّ أُمِرْنَا بِالرُّکَبِ۔n(بخاری ۷۹۰۔ مسلم ۳۱)","Sahih","Musannaf Ibn Abi Shaybah 2544","","","كتاب الصلوات"
"2545","(۲۵۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا رَکَعَ وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2545","","","كتاب الصلوات"
"2546","(۲۵۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : قَامَ فِینَا رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَنْصَارِ یَوْمَ الْقَادِسِیَّۃِ ، فَقَالَ : إذَا رَکَعَ فَلْیَضَعْ یَدَیْہِ عَلَی رُکْبَتَیْہِ ، وَلْیُمَکِّنْ حَتَّی یَعْلُوَ عَجْبُ ذَنَبِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2546","","","كتاب الصلوات"
"2547","(۲۵۴۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : إذَا رَکَعْتَ فَانْصِبْ وَجْہَک للقِبلَۃ، وَضَعْ یَدَیْک عَلَی رُکْبَتَیْک ، وَلاَ تُدَبِّحْ کَمَا یُدَبِّحُ الْحِمَارُ۔","Sahih","Musannaf Ibn Abi Shaybah 2547","","","كتاب الصلوات"
"2548","(۲۵۴۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَکَعْت فَضَعْ کَفَّیْک عَلَی رُکْبَتَیْک ، وَابْسُطْ ظَہْرَک ، وَلاَ تُقَنِّعْ رَأْسَک ، وَلاَ تُصَوِّبْہُ ، وَلاَ تَمْتَدَّ ، وَلاَ تَقْبِضْ۔","Da'if","Musannaf Ibn Abi Shaybah 2548","","","كتاب الصلوات"
"2549","(۲۵۴۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی إذَا رَکَعَ وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2549","","","كتاب الصلوات"
"2550","(۲۵۵۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ یَضَعُ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2550","","","كتاب الصلوات"
"2551","(۲۵۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ نَافِعٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ إذَا رَکَعَ وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2551","","","كتاب الصلوات"
"2552","(۲۵۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عُمَرُ : سُنَّتْ لَکُمُ الرُّکَبُ ، فَأَمْسِکُوا بِالرُّکَبِ۔ (نسائی ۶۲۳)","","Musannaf Ibn Abi Shaybah 2552","","","كتاب الصلوات"
"2553","(۲۵۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فِطْرٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا رَکَعْتَ، فَإِنْ شِئْتَ قُلْتَ ہَکَذَا ، وَإِنْ شِئْتَ وَضَعْت یَدَیْکَ عَلَی رُکْبَتَیْکَ ، وَإِنْ شِئْتَ قُلْتَ ہَکَذَا، یَعْنِی: طَبَّقْتَ۔","","Musannaf Ibn Abi Shaybah 2553","","","كتاب الصلوات"
"2554","(۲۵۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : دَخَلَ الأَسْوَدُ وَعَلْقَمَۃُ عَلَی عَبْدِ اللہِ ، فَقَالَ عَبْدُ اللہِ : صَلَّی ہَؤُلاَئِ بَعْدُ ؟ قَالاَ : لاَ ، قَالَ : فَقُومُوا فَصَلُّوا ، وَلَمْ یَأْمُرْ بِأَذَانٍ ، وَلاَ إقَامَۃٍ ، وَتَقَدَّمَ ہو فَصَلَّی بِنَا ، فَذَہَبْنَا نَتَأَخَّرُ فَأَخَذَ بِأَیْدِینَا فَأَقَامَنَا مَعَہُ ، فَلَمَّا رَکَعْنَا وَضَعَ الأَسْوَدُ یَدَیْہِ عَلَی رُکْبَتَیْہِ ، فَنَظَرَ عَبْدُ اللہِ فَأَبْصَرَہُ فَضَرَبَ یَدَہُ ، فَنَظَرَ الأَسْوَدُ فَإِذَا یَدَا عَبْدِ اللہِ بَیْنَ رُکْبَتَیْہِ وَقَدْ خَالَفَ بین أَصَابِعِہِ ، فَلَمَّا قَضَی الصَّلاَۃَ ، قَالَ : إذَا کُنْتُمْ ثَلاَثَۃً فَلْیَؤُمَّکُمْ أَحَدُکُمْ ، وَإِذَا رَکَعْتَ فَأَفْرِشْ ذِرَاعَیْک فَخِذَیْک ، فَکَأَنِّی أَنْظُرُ إلَی اخْتِلاَفِ أَصَابِعِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ رَاکِعٌ ، ثُمَّ قَالَ : إِنَّہُ سَیَکُونُ أُمَرَائُ یُمِیتُونَ الصَّلاَۃَ شَرَقَ الْمَوْتَی ، وَأَنَّہَا صَلاَۃُ مَنْ ہُوَ شَرٌّ مِنْ حِمَارٍ ، وَصَلاَۃُ مَنْ لاَ یَجِدُ بُدًّا ، فَمَنْ أَدْرَکَ ذَلِکَ مِنْکُمْ فَلْیُصَلِّ الصَّلاَۃَ لِمِیقَاتِہَا ، وَلْتَکُنْ صَلاَتُکُمْ مَعَہُمْ سُبْحَۃً ، فَقُلْتُ لإِبْرَاہِیمَ : کَانَ عَلْقَمَۃُ وَالأَسْوَدُ یَفْعَلاَنِ ذَلِکَ ؟ قَالَ : نَعَمْ ، قُلْتُ لإِبْرَاہِیمَ : تَفْعَلُ أَنْتَ ذَلِکَ ؟ قَالَ : نَعَمْ ، قُلْتُ : إنَّ النَّاسَ یَضَعُونَ أَیْدِیَہُمْ عَلَی رُکَبِہِمْ ؟ فَقَالَ إبْرَاہِیمُ : سَمِعْت أَبَا مَعْمَرٍ یَقُولُ : رَأَیْت عُمَرَ یَضَعُ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2554","","","كتاب الصلوات"
"2555","(۲۵۵۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : عَلَّمَنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الصَّلاَۃَ فَکَبَّرَ وَرَفَعَ یَدَیْہِ ، ثُمَّ رَکَعَ فَطَبَّقَ یَدَیْہِ بَیْنَ رُکْبَتَیْہِ۔ n(نسائی ۶۲۰۔ ابن خزیمہ ۵۹۵)","Sahih","Musannaf Ibn Abi Shaybah 2555","","","كتاب الصلوات"
"2556","(۲۵۵۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَکَانَ عَبْدُ اللہِ یُطَبِّقُ بِإِحْدَی یَدَیْہِ عَلَی الأُخْرَی فَیجعلہما بَیْنَ رِجْلَیْہِ وَیُفْرِشُ ذِرَاعَیْہِ فَخْذَیْہِ إذَا رَکَعَ ؟ قَالَ : نَعَمْ ، قُلْتُ : أَلاَ أَفْعَلُ ذَلِکَ ؟ قَالَ : إنَّ عُمَرَ کَانَ یُطَبِّقُ بِکَفَّیْہِ عَلَی رُکْبَتَیْہِ۔","","Musannaf Ibn Abi Shaybah 2556","","","كتاب الصلوات"
"2557","(۲۵۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُثْمَانَ بْنُ أَبِی ہِنْدٍ ، قَالَ : رَأَیْتُ أَبَا عُبَیْدَۃَ إذَا رَکَعَ طَبَّقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2557","","","كتاب الصلوات"
"2558","(۲۵۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ ، یَعْنِی : یُطَبِّقُ یَدَیْہِ فِی الرُّکُوعِ ۔ قَالَ ابْنُ عَوْنٍ : فَذَکَرْتُہُ لابْنِ سِیرِینَ ، قَالَ : لَعَلَّہُ فَعَلَہُ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 2558","","","كتاب الصلوات"
"2559","(۲۵۵۹) حَدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا ہِشَام ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، رضی اللہ عنہما ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ وَمِلْئَ مَا شِئْت مِنْ شَیْئٍ بَعْدُ ، أَہْلَ الثَّنَائِ وَالْمَجْدِ ، لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، وَلاَ یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔ (مسلم ۳۴۷۔ نسائی ۶۵۴)","Sahih","Musannaf Ibn Abi Shaybah 2559","","","كتاب الصلوات"
"2560","(۲۵۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ أَبِی أَوْفَی ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ مِلْئَ السَّمَاوَاتِ ، وَمِلْئَ الأَرْضِ ، وَمِلْئَ مَا شِئْتَ مِنْ شَیْئٍ بَعْدُ۔ (مسلم ۲۰۲۔ ابوداؤد ۸۴۲)","Sahih","Musannaf Ibn Abi Shaybah 2560","","","كتاب الصلوات"
"2561","(۲۵۶۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ أَبِی زِیَادٍ ، قَالَ : حَدَّثَنَا أَبُو جُحَیْفَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَقُولُ، إذَا رَفَعَ الإِمَامُ رَأْسَہُ مِنَ الرُّکُوعِ ، اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ ، مِلْئَ السَّمَاوَاتِ ، وَمِلْئَ الأَرْضِ ، وَمِلْئَ مَا شِئْت مِنْ شَیْئٍ بَعْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 2561","","","كتاب الصلوات"
"2562","(۲۵۶۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، قَالَ : کَانَ عَلِیٌّ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ ، بِحَوْلِکَ وَقُوَّتِکَ أَقُومُ وَأَقْعُدُ۔","Da'if","Musannaf Ibn Abi Shaybah 2562","","","كتاب الصلوات"
"2563","(۲۵۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ ، قَالَ : حَدَّثَنَا قَزَعَۃُ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ مِلْئَ السَّمَائِ وَمِلْئَ الأَرْضِ ، وَمِلْئَ مَا شِئْت مِنْ شَیْئٍ بَعْدُ ، لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، وَلاَ یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔ (ابوداؤد ۸۴۳۔ نسائی ۶۵۵)","","Musannaf Ibn Abi Shaybah 2563","","","كتاب الصلوات"
"2564","(۲۵۶۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ شَرِیکٍ ، عَنْ أَبِی عُمَرَ ، عَنْ أَبِی جُحَیْفَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَامَ فِی الصَّلاَۃِ ، فَلَمَّا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ مِلْئَ السَّمَائِ وَمِلْئَ الأَرْضِ ، وَمِلْئَ مَا شِئْت مِنْ شَیْئٍ بَعْدُ ، لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، وَلاَ یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ ، یَمُدُّ بِہَا صَوْتَہُ۔ (ابن ماجہ ۸۷۹۔ ابو یعلی ۸۸۲)","Majhul","Musannaf Ibn Abi Shaybah 2564","","","كتاب الصلوات"
"2565","(۲۵۶۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ کَانَ إذَا رَفَعَ رَأْسَہُ ، قَالَ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 2565","","","كتاب الصلوات"
"2566","(۲۵۶۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ بُرْدٍ ؛ أَنَّ مَکْحُولاً کَانَ یَقُولُ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ مِلْئَ السَّمَائِ وَمِلْئَ الأَرْضِ ، وَمِلْئَ مَا شِئْت مِنْ شَیْئٍ بَعْدُ ، أَہْلَ الثَّنَائِ وَالْحمدِ ، وَخَیْرُ مَا قَالَ الْعَبْدُ ، وَکُلُّنَا لَکَ عَبْدٌ ، لاَ مَانِعَ لِمَا أَعْطَیْت ، وَلاَ مُعْطِیَ لِمَا مَنَعْت ، وَلاَ یَنْفَعُ ذَا الْجَدِّ مِنْک الْجَدُّ۔","","Musannaf Ibn Abi Shaybah 2566","","","كتاب الصلوات"
"2567","(۲۵۶۷) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو الْکَلْبِیُّ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ أَبِی سَلَمَۃَ ، قَالَ : أَخْبَرَنَا الْمَاجِشُونُ عَمِّی، عَنِ الأَعْرَجِ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، اللَّہُمَّ رَبَّنَا وَلَک الْحَمْدُ ، مِلْئَ السَّمَاوَاتِ وَمِلْئَ الأَرْضِ ، وَمِلْئَ مَا شِئْت مِنْ شَیْئٍ بَعْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 2567","","","كتاب الصلوات"
"2568","(۲۵۶۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، عَنْ صِلَۃَ بْنِ زُفَرَ ، عَنْ حُذَیْفَۃَ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ رُکُوعُہُ نَحْوًا مِنْ قِیَامِہِ ، ثُمَّ قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، ثُمَّ قَامَ طَوِیلاً۔ (ترمذی ۲۶۲۔ ابوداؤد ۸۶۷)","Sahih","Musannaf Ibn Abi Shaybah 2568","","","كتاب الصلوات"
"2569","(۲۵۶۹) حَدَّثَنَا یَعْلَی ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عُمَرُ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، قَبْلَ أَنْ یُقِیمَ ظَہْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2569","","","كتاب الصلوات"
"2570","(۲۵۷۰) حَدَّثَنَا مُعْتَمِرٌ، عَنْ أَیُّوبَ، عَنِ الأَعْرَجِ، قَالَ: سَمِعْتُ أَبَا ہُرَیْرَۃَ یَرْفَعُ صَوْتَہُ بِـ : اللَّہُمَّ رَبَّنَا وَلَک الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 2570","","","كتاب الصلوات"
"2571","(۲۵۷۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، عَنْ صِلَۃَ ، عَنْ حُذَیْفَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی رُکُوعِہِ : سُبْحَانَ رَبِّی الْعَظِیمِ ، وَفِی سُجُودِہِ : سُبْحَانَ رَبِّی ألأَعْلَی ، قُلْتُ أَنَا لحفص : وَبِحَمْدِہِ ؟ قَالَ : نَعَمْ إِنْ شَائَ اللَّہُ ثَلاَثًا۔ (ابن خزیمۃ ۶۶۸۔ دار قطنی ۳۴۱)","Da'if","Musannaf Ibn Abi Shaybah 2571","","","كتاب الصلوات"
"2572","(۲۵۷۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، عَنْ صِلَۃَ بْنِ زُفَرَ ، عَنْ حُذَیْفَۃَ ، قَالَ : صَلَّیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا رَکَعَ جَعَلَ یَقُولُ : سُبْحَانَ رَبِّی الْعَظِیمِ ، ثُمَّ سَجَدَ ، فَقَالَ : سُبْحَانَ رَبِّی الأَعْلَی۔","Sahih","Musannaf Ibn Abi Shaybah 2572","","","كتاب الصلوات"
"2573","(۲۵۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ بْنِ سُحَیْمٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَّا الرُّکُوعُ فَعَظِّمُوا فِیہِ الرَّبَّ ، وَأَمَّا السُّجُودُ فَاجْتَہِدُوا فِی الدُّعَائِ، فَقَمِنٌ أَنْ یُسْتَجَابَ لَکُمْ۔ (مسلم ۲۰۸۔ ابوداؤد ۸۷۲)","Sahih","Musannaf Ibn Abi Shaybah 2573","","","كتاب الصلوات"
"2574","(۲۵۷۴) حَدَّثَنَا ابْنُ مُسْہِرٍ ، وَابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ ، قَالَ: قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نُہِیت أَنْ أَقْرَأَ الْقُرْآنَ فِی الرُّکُوعِ وَالسُّجُودِ ، فَإِذَا رَکَعْتُمْ فَعَظِّمُوا اللَّہَ ، وَإِذَا سَجَدْتُمْ فَاجْتَہِدُوا فِی الْمَسْأَلَۃِ ، فَقَمِنٌ أَنْ یُسْتَجَابَ لَکُمْ۔ (ابو یعلی ۲۹۷)","Majhul","Musannaf Ibn Abi Shaybah 2574","","","كتاب الصلوات"
"2575","(۲۵۷۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَوْنٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : ثَلاَثُ تَسْبِیحَاتٍ فِی الرُّکُوعِ وَالسُّجُودِ۔","","Musannaf Ibn Abi Shaybah 2575","","","كتاب الصلوات"
"2576","(۲۵۷۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : بَلَغَنِی أَنَّ عُمَرَ کَانَ یَقُولُ فِی الرُّکُوعِ وَالسُّجُودِ قَدْرَ خَمْسِ تَسْبِیحَاتٍ ، سُبْحَانَ اللہِ وَبِحَمْدِہِ۔","","Musannaf Ibn Abi Shaybah 2576","","","كتاب الصلوات"
"2577","(۲۵۷۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : قَالَ : عَلِیٌّ : إذَا رَکَعَ أَحَدُکُمْ فَلْیَقُلَ : اللَّہُمَّ لَکَ رَکَعْتُ ، وَلَک خَشَعْت ، وَبِکَ آمَنْت ، وَعَلَیْک تَوَکَّلْت ، سُبْحَانَ رَبِّی الْعَظِیمِ ، ثَلاَثًا ، وَإِذَا سَجَدَ ، قَالَ : سُبْحَانَ رَبِّی الأَعْلَی ، ثَلاَثًا ، فَإِنْ عَجَّلَ بِہِ أَمْرٌ ، فَقَالَ : سُبْحَانَ رَبِّی الْعَظِیمِ ، وَتَرَکَ ذَلِکَ أَجْزَأَہُ۔ (مسلم ۲۰۱)","","Musannaf Ibn Abi Shaybah 2577","","","كتاب الصلوات"
"2578","(۲۵۷۸) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حرب ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی فَرْوَۃَ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ ؛ أَنَّہُ سَأَلَ أَبَا ہُرَیْرَۃَ ، فَقَالَ : إنِّی رَجُلٌ أَعْوَرُ ، فَمَا نَقُولُ فِی التَّسْبِیحِ فِی السُّجُودِ ؟ قَالَ : ثَلاَثُ تَسْبِیحَاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 2578","","","كتاب الصلوات"
"2579","(۲۵۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صَلَّیْت خَلْفَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَعَدَدْت لَہُ فِی الرُّکُوعِ أَرْبَعَ ، أَوْ خَمْسَ تَسْبِیحَاتٍ ، وَفِی السُّجُودِ خَمْسَ ، أَوْ سِتَّ تَسْبِیحَاتٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2579","","","كتاب الصلوات"
"2580","(۲۵۸۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : جَائَتِ الْحَطَّابَۃُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّا لاَ نَزَالُ سَفْرًا أَبَدًا ، فَکَیْفَ نَصْنَعُ بِالصَّلاَۃِ ؟ قَالَ : سَبِّحُوا ثَلاَثَ تَسْبِیحَاتٍ رُکُوعًا ، وَثَلاَثَ تَسْبِیحَاتٍ سُجُودًا۔ (عبدالرزاق ۲۸۹۴)","","Musannaf Ibn Abi Shaybah 2580","","","كتاب الصلوات"
"2581","(۲۵۸۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : مَنْ لَمْ یُسَبِّحْ فِِی رُکُوعِہِ وَسُجُودِہِ ، فَإِنَّمَا صَلاَتُہُ نَقْرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2581","","","كتاب الصلوات"
"2582","(۲۵۸۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُس ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : وَسَطًا مِنَ الرُّکُوعِ وَالسُّجُودِ أَنْ یَقُولَ الرَّجُلُ فِی رُکُوعِہِ وَسُجُودِہِ ، سُبْحَانَ اللہِ وَبِحَمْدِہِ ، ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 2582","","","كتاب الصلوات"
"2583","(۲۵۸۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : التَّامُّ مِنَ السُّجُودِ ، قَدْرُ سَبْعِ تَسْبِیحَاتٍ ، وَالْمُجْزِیئُ ثَلاَثٌ۔","","Musannaf Ibn Abi Shaybah 2583","","","كتاب الصلوات"
"2584","(۲۵۸۴) حَدَّثَنَا ابْن نُمَیْرٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ؛ أَنَّہُ سَمِعَہُ یَقُولُ : أَدْنَی السُّجُودِ إذَا وَضَعْت رَأْسَک فِی الأَرْضَ أَنْ تَقُولَ : سُبْحَانَ رَبِّی الأَعْلَی ، ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 2584","","","كتاب الصلوات"
"2585","(۲۵۸۵) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِ اللہِ بْنِ أَجْلَح، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ، قَالَ: سَأَلَ الْمُسَیَّبُِ بْنُ رَافِعٍ إبْرَاہِیمَ، فَقَالَ : کَمْ یُجْزِیئُ الرَّجُلَ إذَا وَضَعَ رَأْسَہُ فِی السُّجُودِ مِنْ تَسْبِیحَۃٍ ؟ فَقَالَ إبْرَاہِیمُ : ثَلاَثُ تَسْبِیحَاتٍ۔","","Musannaf Ibn Abi Shaybah 2585","","","كتاب الصلوات"
"2586","(۲۵۸۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ مَیْمُونًا عَنْ مِقْدَارِ الرُّکُوعِ وَالسُّجُودِ ؟ فَقَالَ : لاَ أَرَی أَنْ یَکُونَ أَقَلَّ مِنْ ثَلاَثِ تَسْبِیحَاتٍ ۔ قَالَ جَعْفَرٌ : فَسَأَلْت الزُّہْرِیَّ ، فَقَالَ : إذَا وَقَعَتِ الْعِظَامُ وَاسْتَقَرَّتْ ، فَقُلْتُ لَہُ : إنَّ مَیْمُونًا یَقُولُ : ثَلاَثَ تَسْبِیحَاتٍ ، فَقَالَ : ہُوَ الَّذِی أَقُولُ لَکَ نَحْوٌ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 2586","","","كتاب الصلوات"
"2587","(۲۵۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادٍ الْمُصَفِّرِ ، عَنِ الْحَسَنِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : ثَلاَثُ تَسْبِیحَاتٍ فِی الرُّکُوعِ ، وَالسُّجُودِ وَسَطٌ۔","Hasan","Musannaf Ibn Abi Shaybah 2587","","","كتاب الصلوات"
"2588","(۲۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الضُّحَی ، قَالَ : کَانَ عَلِیٌّ یَقُولُ فِی رُکُوعِہِ : سُبْحَانَ رَبِّی الْعَظِیمِ ، ثَلاَثًا ، وَفِی سُجُودِہِ : سُبْحَانَ رَبِّی الأَعْلَی ، ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 2588","","","كتاب الصلوات"
"2589","(۲۵۸۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ فِی رُکُوعِہِ وَسُجُودِہِ : سُبُّوحٌ قُدُّوسٌ ، رَبُّ الْمَلاَئِکَۃِ وَالرُّوحِ۔ (مسلم ۲۲۴۔ ابوداؤد ۸۶۸)","Sahih","Musannaf Ibn Abi Shaybah 2589","","","كتاب الصلوات"
"2590","(۲۵۹۰) حَدَّثَنَا وَکِیعٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ إِسْحَاقَ بْنِ یَزِیدَ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ مَسْعُودٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا رَکَعَ أَحَدُکُمْ فَلْیَقُلْ : سُبْحَانَ رَبِّی الْعَظِیمِ ، ثَلاَثًا ، وَإِذَا سَجَدَ فَلْیَقُلْ : سُبْحَانَ رَبِّی الأَعْلَی ، ثَلاَثًا ، فَإِنَّہُ إذَا فَعَلَ ذَلِکَ فَقَدْ تَمَّ رُکُوعُہُ وَسُجُودُہُ ، وَذَلِکَ أَدْنَاہُ۔ (ترمذی ۲۶۱۔ ابوداؤد ۸۸۲)","Majhul","Musannaf Ibn Abi Shaybah 2590","","","كتاب الصلوات"
"2591","(۲۵۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ؛ أَنَّ ابْنَ مَسْعُودٍ ، قَالَ فِی رُکُوعِہِ : رَبِّ اغْفِرْ لِی۔","","Musannaf Ibn Abi Shaybah 2591","","","كتاب الصلوات"
"2592","(۲۵۹۲) حَدَّثَنَا حَفْصٌ ، عَنِ الْجَعْدِ ، رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنِ ابْنَۃٍ لِسَعْدٍ ؛ أَنَّہَا کَانَتْ تُفْرِطُ فِی الرُّکُوع تُطَأْطؤًا مُنکَرًا ، فَقَالَ لَہَا سَعْدٌ : إنَّمَا یَکْفِیک إذَا وَضَعْت یَدَیْک عَلَی رُکْبَتَیْک۔","Sahih","Musannaf Ibn Abi Shaybah 2592","","","كتاب الصلوات"
"2593","(۲۵۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ جَرِیرٍ ، عَنِ الضَّحَّاکِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : إذَا أَمْکَنَ الرَّجُلُ یَدَیْہِ مِنْ رُکْبَتَیْہِ ، وَالأَرْضَ مِنْ جَبْہَتِہِ ، فَقَدْ أَجْزَأَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 2593","","","كتاب الصلوات"
"2594","(۲۵۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَمَّنْ سَمِعَ مُحَمَّدَ بْنَ عَلِیٍّ یَقُولُ : یُجْزِئُہُ مِنَ الرُّکُوعِ إذَا وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ ، وَمِنَ السُّجُودِ إذَا وَضَعَ جَبْہَتَہُ عَلَی الأَرْضِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2594","","","كتاب الصلوات"
"2595","(۲۵۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ ابن عُمَرَ ، قَالَ : إذَا وَضَعَ الرَّجُلُ جَبْہَتَہُ بِالأَرْضِ أَجْزَأَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2595","","","كتاب الصلوات"
"2596","(۲۵۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یُجْزِیئُ مِنَ الرُّکُوعِ إذَا أَمْکَنَ یَدَیْہِ مِنْ رُکْبَتَیْہِ، وَمِنَ السُّجُودِ إذَا أَمْکَنَ جَبْہَتَہُ مِنَ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 2596","","","كتاب الصلوات"
"2597","(۲۵۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ابْن أَبِی عَرُوبَۃَ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، قَالَ : قَالَ طَاوُوس وَعِکْرِمَۃُ ، وَأَظُنُّ عَطَائً ثَالِثَہُمْ : إذَا أَمْکَنَ جَبْہَتَہُ مِنَ الأَرْضِ ، فَقَدْ قَضَی مَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2597","","","كتاب الصلوات"
"2598","(۲۵۹۸) حَدَّثَنَا حَفْصٌ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : إذَا وَضَعَ جَبْہَتَہُ علی الأَرْضِ، فَقَدْ أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 2598","","","كتاب الصلوات"
"2599","(۲۵۹۹) حَدَّثَنَا حَفْصٌ ، عَنْ مَعْقِلِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَأَلْتُ عَطَائً عَنْ أَدْنَی مَا یَجُوزُ مِنَ الرُّکُوعِ وَالسُّجُودِ؟ فَقَالَ : إذَا وَضَعَ جَبْہَتَہُ عَلَی الأَرْضِ ، وَوَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ۔","","Musannaf Ibn Abi Shaybah 2599","","","كتاب الصلوات"
"2600","(۲۶۰۰) حُدِّثْت ، عَنِ ابْنِ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا وَضَعَ یَدَیْہِ عَلَی رُکْبَتَیْہِ أَجْزَأَہُ۔","","Musannaf Ibn Abi Shaybah 2600","","","كتاب الصلوات"
"2601","(۲۶۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حُسَیْنِ الْمُکْتِبِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَکَعَ لَمْ یُشْخِصْ رَأْسَہُ ، وَلَمْ یُصَوِّبْہُ ، کَانَ بَیْنَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 2601","","","كتاب الصلوات"
"2602","(۲۶۰۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ رَجُلٍ مِنْ ثَقِیفٍ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ ، فَقَالَ : اتَّقِ الْحَنْوَۃَ فِی الرُّکُوعِ ، وَالْحَدْبَۃَ۔","Majhul","Musannaf Ibn Abi Shaybah 2602","","","كتاب الصلوات"
"2603","(۲۶۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : إذَا رَکَعْت فَانْصَبْ وَجْہَک لِلْقِبْلَۃِ ، وَضَعْ یَدَیْک عَلَی رُکْبَتَیْک ، وَلاَ تُدَبِّح کَمَا یُدَبِّحُ الْحِمَارُ۔","Sahih","Musannaf Ibn Abi Shaybah 2603","","","كتاب الصلوات"
"2604","(۲۶۰۴) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَرْفَعَ الرجل رَأْسَہُ إذَا کَانَ رَاکِعًا، أَوْ یُصَوِّبَہُ۔","","Musannaf Ibn Abi Shaybah 2604","","","كتاب الصلوات"
"2605",") حَدَّثَنَا ابْنُ إدْرِیسُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ التَّحَادُبَ فِی الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2605","","","كتاب الصلوات"
"2606","(۲۶۰۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ سیرین یَقُولُ : الرُّکُوعُ ہَکَذَا ، وَوَصَفَ مُعَاذٌ أَنَّہُ یُسَوِّی ظَہْرَہُ ، لاَ یُصَوِّبُ رَأْسَہُ ، وَلاَ یَرْفَعُہُ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ مِثْلَ ذَلِکَ ، غَیْرَ أَنَّ الْحَسَنَ تَکَلَّمَ بِہِ کَلاَمًا۔","","Musannaf Ibn Abi Shaybah 2606","","","كتاب الصلوات"
"2607","(۲۶۰۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِی فَرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَکَعَ لَوْ صَبَبْتَ عَلَی کَتِفَیْہِ مَائً لاَسْتَقَرَّ۔ (طبرانی ۱۲۷۵۵۔ عبدالرزاق ۲۸۷۲)","","Musannaf Ibn Abi Shaybah 2607","","","كتاب الصلوات"
"2608","(۲۶۰۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا قَالَ الإِمَامُ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقُولُوا : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 2608","","","كتاب الصلوات"
"2609","(۲۶۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخبرنا عُمَرُ بْنُ أَبِی سَلَمَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، رَفَعَہُ ، قَالَ : وَإذَا قَالَ الإِمَامُ: سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقُولُوا : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔ (بخاری ۷۲۲۔ مسلم ۳۰۹)","Hasan","Musannaf Ibn Abi Shaybah 2609","","","كتاب الصلوات"
"2610","(۲۶۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ یُونُسَ بْنِ جُبَیْرٍ ، عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی مُوسَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا قَالَ الإِمَامُ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقُولُوا : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ ۔ یَسْمَعُ اللَّہُ لَکُمْ۔ (مسلم ۴۰۳۔ احمد ۴/۴۰۹)","Sahih","Musannaf Ibn Abi Shaybah 2610","","","كتاب الصلوات"
"2611","(۲۶۱۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا جُعِلَ الإِمَامُ لِیُؤْتَمَّ بِہِ ، فَإِذَا رَکَعَ فَارْکَعُوا ، وَإذَا قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقُولُوا : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔ (مسلم ۳۰۶۔ ابوداؤد ۶۰۴)","Hasan","Musannaf Ibn Abi Shaybah 2611","","","كتاب الصلوات"
"2612","(۲۶۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا قَالَ الإِمَامُ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، قَالَ مَنْ خَلْفَہُ : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 2612","","","كتاب الصلوات"
"2613","(۲۶۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یَقُل الْقَوْمُ خَلْفَ الإِمَامِ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، وَلَکِنْ لِیَقُولُوا : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2613","","","كتاب الصلوات"
"2614","(۲۶۱۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکْیر ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا قَالَ إمَامُکُمْ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقُولُوا : اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔ (احمد ۳/۳)","Da'if","Musannaf Ibn Abi Shaybah 2614","","","كتاب الصلوات"
"2615","(۲۶۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَقُولُ إذَا قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، قَالَ مَنْ خَلْفَہُ: سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، اللَّہُمَّ رَبَّنَا لَکَ الْحَمْدُ۔","","Musannaf Ibn Abi Shaybah 2615","","","كتاب الصلوات"
"2616","(۲۶۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْمَدِینَۃِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ سَمِعَ خَفْقَ نَعْلِی وَہُوَ سَاجِدٌ ، فَلَمَّا فَرَغَ مِنْ صَلاَتِہِ ، قَالَ : مَنْ ہَذَا الَّذِی سَمِعْتُ خَفْقَ نَعْلِہِ ؟ قَالَ : أَنَا یَا رَسُولَ اللہِ ، قَالَ : فَمَا صَنَعْت ؟ قَالَ : وَجَدْتُّک سَاجِدًا فَسَجَدْت ، فَقَالَ : ہَکَذَا فَاصْنَعُوا ، وَلاَ تَعْتَدُّوا بِہَا ، مَنْ وَجَدَنِی رَاکِعًا ، أَوْ سَاجِدًا ، أَوْ قَائِمًا ، فَلْیَکُنْ مَعِی عَلَی حَالِی الَّتِی أَنَا عَلَیْہَا۔n(عبدالرزاق ۳۳۷۳۔ بیہقی ۸۹)","Sahih","Musannaf Ibn Abi Shaybah 2616","","","كتاب الصلوات"
"2617","(۲۶۱۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2617","","","كتاب الصلوات"
"2618","(۲۶۱۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ وَزَیْدِ بْنِ ثَابِتٍ ، قَالاَ : إِنْ وَجَدَہُمْ وَقَدْ رَفَعُوا رُؤُوسَہُمْ مِنَ الرُّکُوعِ کَبَّرَ وَسَجَدَ ، وَلَمْ یَعْتَدَّ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 2618","","","كتاب الصلوات"
"2619","(۲۶۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَنْتَہِی إلَی الإِمَامِ وَہُوَ سَاجِدٌ ، قَالاَ : یَتْبَعُہُ وَیَسْجُدُ مَعَہُ ، وَلاَ یُخَالِفُہُ ، وَلاَ یَعْتَدُّ بِالسُّجُودِ إِلاَّ أَنْ یُدْرِکَ الرُّکُوعَ۔","","Musannaf Ibn Abi Shaybah 2619","","","كتاب الصلوات"
"2620","(۲۶۲۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَی أَیِّ حَالٍ أَدْرَکْتَ الإِمَامَ فَلاَ تُخَالِفْہُ۔","","Musannaf Ibn Abi Shaybah 2620","","","كتاب الصلوات"
"2621","(۲۶۲۱) حدَّثَنَا مُعْتَمِرٌ ، عَنْ سَلْمِ بْنِ أَبِی الذَّیَّالِ ، عَنْ قَتَادَۃَ ، قَالَ : إذَا أَدْرَکْتَہُمْ وَہُمْ سُجُودٌ ، فَاسْجُدْ مَعَہُمْ ، وَلاَ تَعْتَدَّ بِتِلْکَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 2621","","","كتاب الصلوات"
"2622","(۲۶۲۲) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا وَجَدْتہمْ سُجُودًا فَاسْجُدْ مَعَہُمْ ، وَلاَ تَعْتَدَّ بِہَا ، وَقَالَ أَبُو الْعَالِیَۃِ : اُسْجُدْ مَعَہُمْ وَاعْتَدَّ بِہَا۔","","Musannaf Ibn Abi Shaybah 2622","","","كتاب الصلوات"
"2623","(۲۶۲۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : عَلَی أَیِّ حَالٍ وَجَدْتَ الإِمَامَ ، فَاصْنَعْ کَمَا یَصْنَعُ۔","Sahih","Musannaf Ibn Abi Shaybah 2623","","","كتاب الصلوات"
"2624","(۲۶۲۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَی أَیِّ حَالٍ وَجَدْت الإِمَامَ ، فَاصْنَعْ کَمَا یَصْنَعُ۔","","Musannaf Ibn Abi Shaybah 2624","","","كتاب الصلوات"
"2625","(۲۶۲۵) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یَسْتَحِبُّ أَنْ لاَ یُدْرِکَ الْقَوْمَ عَلَی حَالٍ فِی الصَّلاَۃِ ، إِلاَّ دَخَلَ مَعَہُمْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 2625","","","كتاب الصلوات"
"2626","(۲۶۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ؛ فِی الرَّجُلِ یَنْتَہِی إلَی الْقَوْمِ وَہُمْ سُجُودٌ، قَالَ: یَسْجُدُ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 2626","","","كتاب الصلوات"
"2627","(۲۶۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَام ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ قَالاَ : لاَ یَقُومُ الرَّجُلُ قَائِمًا مُنْتَصِبًا ، وَالْقَوْمُ قَدْ وَضَعُوا رُؤُوسَہُمْ۔","","Musannaf Ibn Abi Shaybah 2627","","","كتاب الصلوات"
"2628","(۲۶۲۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَکْرَہُ لِلرَّجُلِ إذَا جَائَ وَالإِمَامُ سَاجِدٌ ، أَنْ یَتَمَثَّلَ قَائِمًا حَتَّی یَتْبَعَہُ۔","","Musannaf Ibn Abi Shaybah 2628","","","كتاب الصلوات"
"2629","(۲۶۲۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی الْمَوَالِی ، عَنْ عُمَرَ بْنِ أَبِی مُسْلِمٍ ، قَالَ : کانَ عُرْوَۃُ بْنُ الزُّبَیْرِ یَقُولُ : إذَا جَائَ أَحَدُکُمْ وَالإِمَامُ سَاجِدٌ ، فَلْیَسْجُدْ مَعَ النَّاسِ ، وَلاَ یَعْتَدَّ بِہَا۔","","Musannaf Ibn Abi Shaybah 2629","","","كتاب الصلوات"
"2630","(۲۶۳۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَعْتَدُّ بِالسُّجُودِ إذَا لَمْ یُدْرِکِ الرُّکُوعَ۔","Hasan","Musannaf Ibn Abi Shaybah 2630","","","كتاب الصلوات"
"2631","(۲۶۳۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ وَہُبَیْرَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا لَمْ تُدْرِکِ الرُّکُوعَ فَلاَ تَعْتَدُّ بِالسُّجُودِ۔","Sahih","Musannaf Ibn Abi Shaybah 2631","","","كتاب الصلوات"
"2632","(۲۶۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ یَزِیدَ الْخَطْمِیِّ إذَا رَفَعَ رَأْسَہُ مِنَ الرَّکْعَۃِ ہَوَی بِالتَّکْبِیرَۃِ ، فَکَأَنَّہُ فِی أُرْجُوحَۃٍ حَتَّی یَسْجُدَ۔","Hasan","Musannaf Ibn Abi Shaybah 2632","","","كتاب الصلوات"
"2633","(۲۶۳۳) حَدَّثَنَا یَعْلَی ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عُمَرُ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، قَبْلَ أَنْ یُقِیمَ ظَہْرَہُ ، وَإِذْا کَبَّرَ کَبَّرَ وَہُوَ مُنْحَطٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 2633","","","كتاب الصلوات"
"2634","(۲۶۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَبِّرْ وَأَنْتَ تَہْوِی ، وَأَنْتَ تَرْکَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2634","","","كتاب الصلوات"
"2635","(۲۶۳۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ؛ أَنَّہُ کَانَ یَہْوِی بِالتَّکْبِیرِ۔","Hasan","Musannaf Ibn Abi Shaybah 2635","","","كتاب الصلوات"
"2636","(۲۶۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَر ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عُمَرُ إذَا قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ، انْحَدَرَ مُکَبِّرًا۔","","Musannaf Ibn Abi Shaybah 2636","","","كتاب الصلوات"
"2637","(۲۶۳۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : خَرَجْت مَعَ عَبْدِ اللہِ مِنْ دَارِہِ إلَی الْمَسْجِدِ ، فَلَمَّا تَوَسَّطْنَا الْمَسْجِدَ رَکَعَ الإِمَامُ فَکَبَّرَ عَبْدُ اللہِ ، ثُمَّ رَکَعَ وَرَکَعْت مَعَہُ ، ثُمَّ مَشَیْنَا رَاکِعَیْنَ حَتَّی انْتَہَیْنَا إلَی الصَّفِّ ، حَتَّی رَفَعَ الْقَوْمُ رُؤُوسَہُمْ ۔ قَالَ : فَلَمَّا قَضَی الإِمَامُ الصَّلاَۃَ قُمْت أَنَا أَرَی أَنی لَمْ أُدْرِکْ ، فَأَخَذَ بِیَدِی عَبْدُ اللہِ فَأَجْلَسَنِی ، وَقَالَ : إنَّک قَدْ أَدْرَکْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 2637","","","كتاب الصلوات"
"2638","(۲۶۳۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ أَبَا عُبَیْدَۃَ جَائَ وَالْقَوْمُ رُکُوعٌ فَرَکَعَ دُونَ الصَّفِّ ، ثُمَّ مَشَی حَتَّی دَخَلَ فِی الصَّفِّ ، ثُمَّ حَدَّثَ ، عَنْ أَبِیہِ ، بِمِثْلِ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 2638","","","كتاب الصلوات"
"2639","(۲۶۳۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی أُمَامَۃَ ؛ أَنَّ زَیْدَ بْنَ ثَابِتٍ رَکَعَ قَبْلَ أَنْ یَصِلَ إلَی الصَّفِّ ، ثُمَّ مَشَی رَاکِعًا۔","Sahih","Musannaf Ibn Abi Shaybah 2639","","","كتاب الصلوات"
"2640","(۲۶۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، عَنْ کَثِیرِ بْنِ أَفْلَحَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ؛ أَنَّہُ دَخَلَ وَالْقَوْمُ رُکُوعٌ ، فَرَکَعَ دُونَ الصَّفِّ ، ثُمَّ دَخَلَ فِی الصَّفِّ۔","Da'if","Musannaf Ibn Abi Shaybah 2640","","","كتاب الصلوات"
"2641","(۲۶۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، قَالَ : رَأَیْتُ ابْنَ جُبَیْرٍ ، فَعَلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2641","","","كتاب الصلوات"
"2642","(۲۶۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ قَالَ : کَانَ أَبِی یَدْخُلُ وَالإِمَامُ رَاکِعٌ ، فَیَرْکَعُ دُونَ الصَّفِّ ، ثُمَّ یَدْخُلُ فِی الصَّفِّ۔","","Musannaf Ibn Abi Shaybah 2642","","","كتاب الصلوات"
"2643","(۲۶۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ وِقَائٍ قَالَ: دَخَلْتُ أَنَا وَسَعِیدُ بْنُ جُبَیْرٍ وَہُمْ رُکُوعٌ ، فَرَکَعْت أَنَا وَہُوَ مِنَ الْبَابِ، ثُمَّ جِئْنَا حَتَّی دَخَلْنَا فِی الصَّفِّ۔","","Musannaf Ibn Abi Shaybah 2643","","","كتاب الصلوات"
"2644","(۲۶۴۴) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیئُ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنِی یَزِیدُ بْنُ أَبِی حَبِیبٍ ؛ أَنَّہُ رَأَی أَبَا سَلَمَۃَ دَخَلَ الْمَسْجِدَ وَالْقَوْمُ رُکُوعٌ فَرَکَعَ ، ثُمَّ دَبَّ رَاکِعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 2644","","","كتاب الصلوات"
"2645","(۲۶۴۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی مَنْ دَخَلَ الْمَسْجِدَ وَالإِمَامُ رَاکِعٌ ، قَالَ : إذَا جَاوَزَ النِّسَائَ کَبَّرَ وَرَکَعَ ، ثُمَّ مَضَی حَتَّی یَدْخُلَ فِی الصَّفِّ ، فَإِنْ أَدْرَکَہُ السُّجُودُ قَبْلَ ذَلِکَ سَجَدَ حَیْثُ أَدْرَکَ۔","","Musannaf Ibn Abi Shaybah 2645","","","كتاب الصلوات"
"2646","(۲۶۴۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : دَخَلْت أَنَا ، وَعَمْرُو بْنُ تَمِیمٍ الْمَسْجِدَ فَرَکَعَ الإِمَامُ ، فَرَکَعْت أَنَا وَہُوَ ، وَمَشَیْنَا رَاکِعَیْنِ حَتَّی دَخَلْنَا الصَّفَّ ، فَلَمَّا قضینا الصلاۃ ، قَالَ لِی عَمْرٌو : اَلَّذِی صَنَعْتَ آنِفًا مِمَّنْ سَمِعْتَہ ؟ قُلْتُ : مِنْ مُجَاہِدٍ ، قَالَ : قَدْ رَأَیْت ابْنَ الزُّبَیْرِ ، فَعَلَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 2646","","","كتاب الصلوات"
"2647","(۲۶۴۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ (ح) وَعَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالاَ : ؛ فِی الرَّجُلِ یَدْخُلُ الْمَسْجِدَ وَالْقَوْمُ قَدْ رَکَعُوا قَالاَ : إِنْ کَانَ یَظُنُّ أَنَّہُ یُدْرِکُ الْقَوْمَ قَبْلَ أَنْ یَرْفَعُوا رُؤُوسَہُمْ فَلْیَرْکَعْ ، وَلِیَمْشِ حَتَّی یَدْخُلَ الصَّفَّ۔","","Musannaf Ibn Abi Shaybah 2647","","","كتاب الصلوات"
"2648","(۲۶۴۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ تُکَبِّرْ حَتَّی تَأْخُذَ مَقَامَک مِنَ الصَّفِّ۔","Hasan","Musannaf Ibn Abi Shaybah 2648","","","كتاب الصلوات"
"2649","(۲۶۴۹) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِی الْمُعَلَّی ، قَالَ : سُئِلَ الْحَسَنُ عَنِ الرَّجُلِ یَرْکَعُ قَبْلَ أَنْ یَصِلَ إلَی الصَّفِّ ؟ فَقَالَ: لاَ یَرْکَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2649","","","كتاب الصلوات"
"2650","(۲۶۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إذَا دَخَلْتُ الْمَسْجِدَ وَالإِمَامُ رَاکِعٌ ، أَأَرْکَعُ قَبْلَ أَنْ أَنْتَہِیَ إلَی الصَّفِّ ؟ قَالَ : أَنْتَ لاَ تَفْعَلْ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2650","","","كتاب الصلوات"
"2651","(۲۶۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إذَا دَخَلْتَ وَالإِمَامُ رَاکِعٌ فَلاَ تَرْکَعْ حَتَّی تَأْخُذَ مَقَامَک مِنَ الصَّفِّ ۔ قَالَ أَبُو بَکْرٍ : إذَا کَانَ ہُوَ وَآخَرُ ، رَکَعَ دُونَ الصَّفِّ ، وَإِذَا کَانَ وَحْدَہُ فَلاَ یَرْکَعُ۔","Hasan","Musannaf Ibn Abi Shaybah 2651","","","كتاب الصلوات"
"2652","(۲۶۵۲) حَدَّثَنَا حَفْصٌ، عَنْ لَیْثٍ، قَالَ: کَانَ مُجَاہِدٌ إذَا رَکَعَ یَضَعُ یَدَیْہِ عَلَی رُکْبَتَیْہِ، قَالَ وَکَانَ عَطَائٌ وَطَاوُوس وَنَافِعٌ یفرِّجُونَ۔","","Musannaf Ibn Abi Shaybah 2652","","","كتاب الصلوات"
"2653","(۲۶۵۳) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ حَفْصٍ ، عَنْ لَیْثٍ، قَالَ: صَلَّی رَجُلٌ إلَی جَنْبِ عَطَائٍ ، فَلَمَّا رَکَعَ ثَنَی رُکْبَتَیْہِ ، قَالَ فَضَرَبَ یَدَہُ ، وَقَالَ : اُبْسُطْہُمَا۔","","Musannaf Ibn Abi Shaybah 2653","","","كتاب الصلوات"
"2654","(۲۶۵۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمٍ الْبَرَّادِ ، قَالَ : أَتَیْنَا أَبَا مَسْعُودٍ فِی بَیْتِہِ ، فَقُلْنَا لَہُ: عَلِّمْنَا صَلاَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَصَلَّی ، فَلَمَّا سَجَدَ جَافَی بِمِرْفَقَیْہِ۔ (ابوداؤد ۸۵۹۔ نسائی ۶۲۴)","Da'if","Musannaf Ibn Abi Shaybah 2654","","","كتاب الصلوات"
"2655","(۲۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، عَنْ مَیْمُونَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَجَدَ رَأَی مَنْ خَلْفَہُ بَیَاضَ إبِطَیْہِ۔ (مسلم ۳۵۷۔ ابوداؤد ۸۹۴)","Sahih","Musannaf Ibn Abi Shaybah 2655","","","كتاب الصلوات"
"2656","(۲۶۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ رَاشِدٍ ، عَنِ الْحَسَنِ ، قَالَ : حدَّثَنِی أَحْمَرُ صَاحِبُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنْ کُنَّا لَنَأْوِی لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِمَّا یُجَافِی عَنْ جَنْبَیْہِ إذَا سَجَدَ۔n(ابوداؤد ۸۹۶۔ ابن ماجہ ۸۸۶)","Hasan","Musannaf Ibn Abi Shaybah 2656","","","كتاب الصلوات"
"2657","(۲۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ أَقْرَمَ الْخُزَاعِیِّ) ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ مَعَ أَبِی بِالْقَاعِ مِنْ نَمِرَۃَ ، فَمَرَّ بِنَا رَکْبٌ فَأَنَاخُوا بِنَاحِیَۃِ الطَّرِیقِ ، فَقَالَ : أَیْ بُنَیَّ ، کُنْ فِی بَہْمِکَ حَتَّی آتِیَ ہَؤُلاَئِ الْقَوْمَ ، فَخَرَجَ وَخَرَجْتُ مَعَہُ ، یَعْنِی دَنَا وَدَنَوْت ، فَإِذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّی وَصَلَّیْت مَعَہُ ، فَکُنْت أَنْظُرُ إلَی عُفْرَۃِ إبْطَیْہِ۔ (ابن ماجہ ۸۸۱۔ احمد ۴/۳۵)","Sahih","Musannaf Ibn Abi Shaybah 2657","","","كتاب الصلوات"
"2658","(۲۶۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شُعْبَۃَ مَوْلَی ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُرَی بَیَاضُ إبْطَیْہِ إذَا سَجَدَ۔ (ابوداؤد ۸۹۵۔ احمد ۱/۲۶۷)","Da'if","Musannaf Ibn Abi Shaybah 2658","","","كتاب الصلوات"
"2659","(۲۶۵۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حُمَیْدٍ ، قَالَ : کَانَ أَنَسٌ إذَا سَجَدَ جَافَی۔","Hasan","Musannaf Ibn Abi Shaybah 2659","","","كتاب الصلوات"
"2660","(۲۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَرَی مَنْ خَلْفَہُ بَیَاضَ إبْطَیْہِ إذَا سَجَدَ۔","","Musannaf Ibn Abi Shaybah 2660","","","كتاب الصلوات"
"2661","(۲۶۶۱) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ، قَالَ: حدَّثَنِی عَاصِمُ بْنُ شُمَیْخٍ الْغَیْلاَنِیُّ أَحَدُ بَنِی تَمِیمٍ، قَالَ : دَخَلْتُ عَلَی أَبِی سَعِیدٍ فَرَأَیْتُہُ وَہُوَ سَاجِدٌ یُجَافِی بِمِرْفَقَیْہِ عَنْ جَنْبَیْہِ ، حَتَّی أَرَی بَیَاضَ إبْطَیْہِ۔","Majhul","Musannaf Ibn Abi Shaybah 2661","","","كتاب الصلوات"
"2662","(۲۶۶۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الرَّجُلُ یَتَجَافَی۔","No Data Available","Musannaf Ibn Abi Shaybah 2662","","","كتاب الصلوات"
"2663","(۲۶۶۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا سَجَدَ الرَّجُلُ فَلْیُخَوِّ۔","Da'if","Musannaf Ibn Abi Shaybah 2663","","","كتاب الصلوات"
"2664","(۲۶۶۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَجَدَ الرَّجُلُ فَلْیُفَرِّجْ بَیْنَ فَخِذَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2664","","","كتاب الصلوات"
"2665","(۲۶۶۵) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : وَصَفَ لَنَا الْبَرَائُ فَاعْتَمَدَ عَلَی کَفَّیْہِ وَرَفَعَ عَجِیزَتَہُ ، فَقَالَ : ہَکَذَا کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ۔ (ابوداؤد ۸۹۲۔ احمد ۴/۳۰۳)","Hasan","Musannaf Ibn Abi Shaybah 2665","","","كتاب الصلوات"
"2666","(۲۶۶۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَأَبُو مُعَاوِیَۃَ ، وَأَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ، عَنْ جَابِرٍ، قَالَ: قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَعْتَدِلْ ، وَلاَ یَفْتَرِشْ ذِرَاعَیْہِ افْتِرَاشَ الْکَلْبِ۔n(ترمذی ۲۷۵۔ احمد ۳/۳۰۵)","Hasan","Musannaf Ibn Abi Shaybah 2666","","","كتاب الصلوات"
"2667","(۲۶۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ تَمِیمِ بْنِ مَحْمُودٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ شِبْلٍ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ افْتِرَاشِ السَّبُعِ۔ (ابوداؤد ۸۵۸۔ دارمی ۱۳۲۳)","Da'if","Musannaf Ibn Abi Shaybah 2667","","","كتاب الصلوات"
"2668","(۲۶۶۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَعْتَدِلْ ، وَلاَ یَفْتَرِشْ ذِرَاعَیْہِ افْتِرَاشَ الْکَلْبِ۔","Da'if","Musannaf Ibn Abi Shaybah 2668","","","كتاب الصلوات"
"2669","(۲۶۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُکْتِبِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ، قَالَتْ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَفْتَرِشَ أَحَدُنَا ذِرَاعَیْہِ افْتِرَاشَ السَّبُعِ۔","Sahih","Musannaf Ibn Abi Shaybah 2669","","","كتاب الصلوات"
"2670","(۲۶۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اعْتَدِلُوا فِی سُجُودِکُمْ ، وَلاَ یَتَبَسَّطْ أَحَدُکُمْ ذِرَاعَیْہِ انْبسَاطَ الْکَلْبِ۔ (بخاری ۸۲۲۔ ابوداؤد ۸۹۳)","Sahih","Musannaf Ibn Abi Shaybah 2670","","","كتاب الصلوات"
"2671","(۲۶۷۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ عَمْرٍوَ قَالَ: حدَّثَنَا زَائِدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ صَالِحِ بْنِ خَبَّابٍ ، عَنْ حُصَیْنِ بْنِ عُقْبَۃَ، عَنْ عُمَرَ (ح) وَعَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَعْتَدِلْ ، وَلاَ یَفْتَرِشْ ذِرَاعَیْہِ افْتِرَاشَ الْکَلْبِ۔","Hasan","Musannaf Ibn Abi Shaybah 2671","","","كتاب الصلوات"
"2672","(۲۶۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی أَبَا ذَرٍّ مُسَوَّدًا مَا بَیْنَ رُسْغِہِ إلَی مِرْفَقَیْہِ۔","Majhul","Musannaf Ibn Abi Shaybah 2672","","","كتاب الصلوات"
"2673","(۲۶۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَامِرِ بْنِ عَبْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : ہُیِّئَتْ عِظَامُ ابْنِ آدَمَ لِسجُودِہِ ، اسْجُدُوا حَتَّی بِالْمَرَافِقِ۔","Sahih","Musannaf Ibn Abi Shaybah 2673","","","كتاب الصلوات"
"2674","(۲۶۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ، قَالَ: قُلْتُ لِمُحَمَّدٍ: الرَّجُلُ یَسْجُدُ یَعْتَمِدُ بِمِرْفَقَیْہِ عَلَی رُکْبَتَیْہِ؟ قَالَ : مَا أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 2674","","","كتاب الصلوات"
"2675","(۲۶۷۵) حَدَّثَنَا عَاصِمٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَضُمُّ یَدَیْہِ إلَی جَنْبَیْہِ إذَا سَجَدَ۔","","Musannaf Ibn Abi Shaybah 2675","","","كتاب الصلوات"
"2676","(۲۶۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ قَیْسِ بْنِ سَکَن ، قَالَ : کُلَّ ذَلِکَ قَدْ کَانُوا یَفْعَلُونَ ، یَنْضَمُّونَ وَیَتَجَافَوْنَ ، کَانَ بَعْضُہُمْ یَنْضَمُّ وَبَعْضُہُمْ یُجَافِی۔","No Data Available","Musannaf Ibn Abi Shaybah 2676","","","كتاب الصلوات"
"2677","(۲۶۷۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُمَیٍّ ، عَنِ النُّعْمَانِ بْنِ أَبِی عَیَّاشٍ ، قَالَ : شَکَوْا إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الإِدِّعَامَ وَالإِعْتِمَادَ فِی الصَّلاَۃِ ، فَرَخَّصَ لَہُمْ أَنْ یَسْتَعِینَ الرَّجُلُ بِمِرْفَقَیْہِ عَلَی رُکْبَتَیْہِ ، أَوْ فَخِذَیْہِ۔n(عبدالرزاق ۲۹۲۸)","","Musannaf Ibn Abi Shaybah 2677","","","كتاب الصلوات"
"2678","(۲۶۷۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ حَبِیبٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ : أَضَعُ مِرْفَقَیَّ عَلَی فَخْذِی إذَا سَجَدْت ؟ فَقَالَ : اُسْجُدْ کَیْفَ تَیَسَّرَ عَلَیْک۔","Sahih","Musannaf Ibn Abi Shaybah 2678","","","كتاب الصلوات"
"2679","(۲۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا سَجَدْتُمْ فَاسْجُدُوا حَتَّی بِالْمَرَافِقِ ، یَعْنِی یَسْتَعِینُ بِمِرْفَقَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2679","","","كتاب الصلوات"
"2680","(۲۶۸۰) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَجَّاجِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : سُئِلَ : أَیْنَ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَضَعُ وَجْہَہُ ؟ قَالَ : کَانَ یَضَعُہُ بَیْنَ کَفَّیْہِ ، أَوَ قَالَ : یَدَیْہِ ، یَعْنِی فِی السُّجُودِ۔","","Musannaf Ibn Abi Shaybah 2680","","","كتاب الصلوات"
"2681","(۲۶۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : قُلْتُ : لأَنْظُرَنَّ إلَی صَلاَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَسَجَدَ ، فَرَأَیْتُ رَأْسَہُ مِنْ یَدَیْہِ عَلَی مِثْلِ مِقْدَارِہِ حَیْثُ اسْتَفْتَحَ ۔ یَقُولُ : قَرِیبًا مِنْ أُذُنَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2681","","","كتاب الصلوات"
"2682","(۲۶۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ سَجَدَ وَیَدَیْہِ قَرِیبًا مِنْ أُذُنَیْہِ۔ (احمد ۴/۳۱۶۔ ابن حبان ۱۸۶۰)","Sahih","Musannaf Ibn Abi Shaybah 2682","","","كتاب الصلوات"
"2683","(۲۶۸۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمٍ الْبَرَّادِ ، قَالَ : أَتَیْنَا أَبَا مَسْعُودٍ الأَنْصَارِیَّ فِی بَیْتِہِ ، فَقُلْنَا : عَلِّمْنَا صَلاَۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّی ، فَلَمَّا سَجَدَ وَضَعَ کَفَّیْہِ قَرِیبًا مِنْ رَأْسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2683","","","كتاب الصلوات"
"2684","(۲۶۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ إذَا سَجَدَ کَیْفَ یَضَعُ یَدَیْہِ ؟ قَالَ : یَضَعُہُمَا حَیْثُ تَیَسَّرا ، أَوْ کَیْفَمَا جَائَتَا۔","Sahih","Musannaf Ibn Abi Shaybah 2684","","","كتاب الصلوات"
"2685","(۲۶۸۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَبِی حَازِمٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : أَکُونُ فِی الصَّفِّ وَفِیہِ ضِیقٌ ، کَیْفَ أَضَعُ یَدَیَّ ؟ قَالَ : ضَعْہُمَا حَیْثُ تَیَسَّرَ۔","Sahih","Musannaf Ibn Abi Shaybah 2685","","","كتاب الصلوات"
"2686","(۲۶۸۶) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا سَجَدَ الرَّجُلُ أَنْ یَقُولَ بِیَدَیْہِ ہَکَذَا، وَضَمَّ أَزْہَرُ أَصَابِعَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2686","","","كتاب الصلوات"
"2687","(۲۶۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَجَدْت فَلاَ تَضُمَّ کَفَّیْک ، وَابْسُطْ أَصَابِعَک۔","No Data Available","Musannaf Ibn Abi Shaybah 2687","","","كتاب الصلوات"
"2688","(۲۶۸۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، قَالَ : صَلَّیْت إلَی جَنْبِ حَفْصِ بْنِ عَاصِمٍ ، فَلَمَّا سَجَدْت فَرَّجْت بَیْنَ أَصَابِعِی وَأَمَلْت کَفِّی عَنِ الْقِبْلَۃِ ، فَلَمَّا سَلَّمْت ، قَالَ : یَا ابْنَ أخِی ، إذَا سَجَدْت فَاضْمُمْ أَصَابِعَک ، وَوَجِّہْ یَدَیْک قِبَلَ الْقِبْلَۃِ ، فَإِنَّ الْیَدَیْنِ تَسْجُدَانِ مَعَ الْوَجْہِ۔","","Musannaf Ibn Abi Shaybah 2688","","","كتاب الصلوات"
"2689","(۲۶۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ سُفْیَانُ : یُفَرِّجُ بَیْنَ أَصَابِعِہِ فِی الرُّکُوعِ ، وَیَضُمُّ فِی السُّجُودِ۔","","Musannaf Ibn Abi Shaybah 2689","","","كتاب الصلوات"
"2690","(۲۶۹۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَان ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : السُّجُودُ عَلَی أَلْیَۃِ الْکَفِّ۔n(ابن خزیمۃ ۶۳۹۔ ابن حبان ۱۹۱۵)","Sahih","Musannaf Ibn Abi Shaybah 2690","","","كتاب الصلوات"
"2691","(۲۶۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ الْبَرَائَ بْنَ عَازِبٍ یَقُولُ : السُّجُودُ عَلَی أَلْیَۃِ الْکَفَّیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 2691","","","كتاب الصلوات"
"2692","(۲۶۹۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، وَأَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن عَامِرِ بْنِ سَعْدٍ ، قَالَ : أَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوَضْعِ الْکَفَّیْنِ وَنَصْبِ الْقَدَمَیْنِ فِی السُّجُودِ۔n(ترمذی ۲۷۲۔ ابوداؤد ۸۸۸)","","Musannaf Ibn Abi Shaybah 2692","","","كتاب الصلوات"
"2693","(۲۶۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَعْظَمُ السُّجُودِ عَلَی الرَّاحَتَیْنِ وَالرُّکْبَتَیْنِ وَصَدْرِ الْقَدَمَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2693","","","كتاب الصلوات"
"2694","(۲۶۹۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ؛ فِی قَوْلِہِ : {وَعَنَتِ الْوُجُوہُ لِلْحَیِّ الْقَیُّومِ} قَالَ : السُّجُودُ عَلَی الْجَبْہَۃِ ، وَالرَّاحَتَیْنِ ، وَالرُّکْبَتَیْنِ ، وَالْقَدَمَیْنِ۔","","Musannaf Ibn Abi Shaybah 2694","","","كتاب الصلوات"
"2695","(۲۶۹۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ عُمَرَ ، قَالَ : وُجِّہَ ابْنُ آدَمَ لِلسُّجُودِ عَلَی سَبْعَۃِ أَعْضَائٍ ؛ الْجَبْہَۃِ ، وَالرَّاحَتَیْنِ ، وَالرُّکْبَتَیْنِ ، وَالْقَدَمَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 2695","","","كتاب الصلوات"
"2696","(۲۶۹۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا أَبُو بِشْرٍ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : السُّجُودُ عَلَی سَبْعَۃِ أَعْضَائٍ؛ الْجَبْہَۃِ ، وَالرَّاحَتَیْنِ ، وَالرُّکْبَتَیْنِ ، وَالْقَدَمَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 2696","","","كتاب الصلوات"
"2697","(۲۶۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أُمِرْت أَنْ أَسْجُدَ عَلَی سَبْعَۃِ أَعْظُمٍ ، لاَ أَکُفَّ شَعْرًا ، وَلاَ ثَوْبًا۔ (بخاری ۸۱۲۔ مسلم ۲۳۱)","Da'if","Musannaf Ibn Abi Shaybah 2697","","","كتاب الصلوات"
"2698","(۲۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ السُّجُودَ عَلَی سَبْعَۃِ أَعْظُمٍ ؛ عَلَی الْیَدَیْنِ ، وَالرُّکْبَتَیْنِ ، وَالْقَدَمَیْنِ ، وَالْجَبْہَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2698","","","كتاب الصلوات"
"2699","(۲۶۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَسْجُدُ عَلَی سَبْعَۃٍ أَعْظُمٍ ؛ یَدَیْہِ ، وَرِجْلَیْہِ ، وَجَبْہَتِہِ ، وَرُکْبَتَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2699","","","كتاب الصلوات"
"2700","(۲۷۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَسْجُدَ وَأَصَابِعُ رِجْلَیْہِ ہَکَذَا ؛ وَوَصَفَ أَنَّہُ یُثْنِیہَا إلَی بَطْنِ رِجْلِہِ ، وَقَالَ : اُبْسُطْہَا۔","","Musannaf Ibn Abi Shaybah 2700","","","كتاب الصلوات"
"2701","(۲۷۰۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی الْعَنْبَسِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : إذَا سَجَدْت فَانْصِبْ قَدَمَیْک۔","","Musannaf Ibn Abi Shaybah 2701","","","كتاب الصلوات"
"2702","(۲۷۰۲) حَدَّثَنَا ہُشَیْمٌ وَحَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ عَلَی جَبْہَتِہِ وَأَنْفِہِ۔","","Musannaf Ibn Abi Shaybah 2702","","","كتاب الصلوات"
"2703","(۲۷۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقُولُ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَلْزَقْ أَنْفَہُ بِالْحَضِیضِ ، فَإِنَّ اللَّہَ قَدِ ابْتَغَی ذَلِکَ مِنْکُمْ۔","","Musannaf Ibn Abi Shaybah 2703","","","كتاب الصلوات"
"2704","(۲۷۰۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْمُغِیرَۃِ ، عَنْ إبْرَاہِیمَ ، قَالَ : السُّجُودُ عَلَی الْجَبْہَۃِ وَالأَنْفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2704","","","كتاب الصلوات"
"2705","(۲۷۰۵) حَدَّثَنَا مُطَّلِبُ بْنُ زِیَادٍ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، قَالَ : مَرَّ عَلَیَّ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی وَأَنَا سَاجِدٌ ، فَقَالَ : یَا ابْنَ عِیسَی ، ضَعْ أَنْفَک لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 2705","","","كتاب الصلوات"
"2706","(۲۷۰۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ وِقَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : مَا تَمَّتْ صَلاَۃُ رَجُلٍ حَتَّی یَلْزَقَ أَنْفَہُ کَمَا یَلْزَقُ جَبْہَتَہُ۔","","Musannaf Ibn Abi Shaybah 2706","","","كتاب الصلوات"
"2707","(۲۷۰۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : نُبِّئْت أَنَّ طَاوُوسًا سُئِلَ عَنِ السُّجُودِ عَلَی الأَنْفِ ؟ قَالَ : أَوَلَیْسَ أَکْرَمَ الْوَجْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2707","","","كتاب الصلوات"
"2708","(۲۷۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ إذَا سَجَدَ عَلَی مَکَان لاَ یَمَسُّ أَنْفُہُ الأَرْضَ ، تَحَوَّلَ إلَی مَکَان آخَرَ۔","","Musannaf Ibn Abi Shaybah 2708","","","كتاب الصلوات"
"2709","(۲۷۰۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ ثَابِتِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ یُمِسّ أَنْفُہُ الأَرْضَ۔","","Musannaf Ibn Abi Shaybah 2709","","","كتاب الصلوات"
"2710","(۲۷۱۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی إنْسَانٍ سَاجِدٍ ، لاَ یَضَعُ أَنْفَہُ فِی الأَرْضِ ، فَقَالَ : مَنْ صَلَّی صَلاَۃً لاَ یُصِیبُ الأَنْفُ مَا یُصِیبُ الْجَبِینُ لَمْ تُقْبَلْ صَلاَتُہُ۔ (دارقطنی ۳۴۸۔ بیہقی ۳)","","Musannaf Ibn Abi Shaybah 2710","","","كتاب الصلوات"
"2711","(۲۷۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا سَجَدَ وَضَعَ أَنْفَہُ مَعَ جَبْہَتِہِ۔","","Musannaf Ibn Abi Shaybah 2711","","","كتاب الصلوات"
"2712","(۲۷۱۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، قَالَ : قُلْتُ لِوَہْبِ بْنِ کَیْسَانَ : یَا أَبَا نُعَیْمٍ ، مَا لَکَ لاَ تُمَکِّنُ جَبْہَتَکَ وَأَنْفَک مِنَ الأَرْضِ ؟ قَالَ : ذَلِکَ أَنِّی سَمِعْت جَابِرَ بْنَ عَبْدِ اللہِ یَقُولُ : رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُ فِی أَعْلَی جَبْہَتِہِ عَلَی قُصَاصِ الشَّعَرِ۔ (دارقطنی ۳۴۹۔ طبرانی ۴۳۵)","Da'if","Musannaf Ibn Abi Shaybah 2712","","","كتاب الصلوات"
"2713","(۲۷۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ شِئْتَ فَاسْجُدْ عَلَی أَنْفِکَ ، وَإِنْ شِئْتَ فَلاَ تَفْعَلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2713","","","كتاب الصلوات"
"2714","(۲۷۱۴) حَدَّثَنَا مَعْنٌ ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ وَسَالِمًا یَسْجُدَانِ عَلَی جِبَاہِہِمَا ، وَلاَ تَمَسُّ الأَرْضَ أُنُوفُہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2714","","","كتاب الصلوات"
"2715","(۲۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی رَجُلٍ لَمْ یَسْجُدْ عَلَی أَنْفِہِ ، قَالَ : یُجْزئُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2715","","","كتاب الصلوات"
"2716","(۲۷۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یَضُرُّہُ۔","","Musannaf Ibn Abi Shaybah 2716","","","كتاب الصلوات"
"2717","(۲۷۱۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ جَدِّہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، یَرْفَعُہُ ، أَنَّہُ قَالَ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَبْتَدِئْ بِرُکْبَتَیْہِ قَبْلَ یَدَیْہِ ، وَلاَ یَبْرُکْ بُرُوکَ الْفَحْلِ۔ (ابوداؤد ۸۳۴۔ طحاوی ۲۵۵۔ بیہقی ۱۰۰ )","Da'if","Musannaf Ibn Abi Shaybah 2717","","","كتاب الصلوات"
"2718","(۲۷۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ عُمَرَ کَانَ یَضَعُ رُکْبَتَیْہِ قَبْلَ یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 2718","","","كتاب الصلوات"
"2719","(۲۷۱۸) حَدَّثَنَا یَعْلَی ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّ عُمَرَ کَانَ یَقَعُ عَلَی رُکْبَتَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2719","","","كتاب الصلوات"
"2720","(۲۷۲۰) حَدَّثَنَا یَعْقُوبُ بْنُ إبْرَاہِیمَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَضَعُ رُکْبَتَیْہِ إذَا سَجَدَ قَبْلَ یَدَیْہِ ، وَیَرْفَعُ یَدَیْہِ إذَا رَفَعَ قَبْلَ رُکْبَتَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2720","","","كتاب الصلوات"
"2721","(۲۷۲۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ إذَا سَجَدَ تَقَعُ رُکْبَتَاہُ، ثُمَّ یَدَاہُ ، ثُمَّ رَأْسُہُ۔","","Musannaf Ibn Abi Shaybah 2721","","","كتاب الصلوات"
"2722","(۲۷۲۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَضَعُ یَدَیْہِ قَبْلَ رُکْبَتَیْہِ ؟ فَکَرِہَ ذَلِکَ ، وَقَالَ : ہَلْ یَفْعَلُہُ إِلاَّ مَجْنُونٌ ؟!۔","No Data Available","Musannaf Ibn Abi Shaybah 2722","","","كتاب الصلوات"
"2723","(۲۷۲۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ خَالِدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ إذَا سَجَدَ بَدَأَ فَوَضَعَ رُکْبَتَیْہِ ، وَإِذَا قَامَ اعْتَمَدَ عَلَی یَدَیْہِ وَرَأَیْتُ الْحَسَنَ یَخِرُّ فَیَبْدَأُ بِیَدَیْہِ ، وَیَعْتَمِدُ إذَا قَامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2723","","","كتاب الصلوات"
"2724","(۲۷۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَضَعُ رُکْبَتَیْہِ قَبْل یَدَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2724","","","كتاب الصلوات"
"2725","(۲۷۲۵) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، قَالَ : سُئِلَ قَتَادَۃُ عَنِ الرَّجُلِ إذَا انْصَبَّ مِنَ الرُّکُوعِ یَبْدَأُ بِیَدَیْہِ ؟ فَقَالَ : یَصْنعُ أَہْوَنَ ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2725","","","كتاب الصلوات"
"2726","(۲۷۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ إذَا انْحَطُّوا لِلسُّجُودِ وَقَعَتْ رُکَبُہُمْ قَبْلَ أَیْدِیہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2726","","","كتاب الصلوات"
"2727","(۲۷۲۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَارِثَۃَ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَجَدَ وَضَعَ یَدَیْہِ وِجَاہَ الْقِبْلَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 2727","","","كتاب الصلوات"
"2728","(۲۷۲۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمان ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ : إذَا سَجَدَ أَحَدُکُمْ فَلْیَسْتَقْبِلِ الْقِبْلَۃَ بِیَدَیْہِ ، فَإِنَّہُمَا یَسْجُدَانِ مَعَ الْوَجْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2728","","","كتاب الصلوات"
"2729","(۲۷۲۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یَسْتَحِبَّانِ إذَا سَجَدَا أَنْ یَسْتَقْبِلاَ ??ِأَکُفِّہِمَا إلَی الْقِبْلَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2729","","","كتاب الصلوات"
"2730","(۲۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ؛ أَنَّ عَائِشَۃَ رَأَتْ رَجُلاً مَائِلاً بِکَفَّیْہِ عَنِ الْقِبْلَۃِ ، فَقَالَتِ : اعْدِلْہُمَا إلَی الْقِبْلَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 2730","","","كتاب الصلوات"
"2731","(۲۷۳۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ حَفْصِ بْنِ عَاصِمٍ ، قَالَ : مِنَ السُّنَّۃِ فِی الصَّلاَۃِ أَنْ یَبْسُطَ کَفَّیْہِ ، وَیَضُمَّ أَصَابِعَہُ وَیُوَجِّہَہُمَا مَعَ وَجْہِہِ إلَی الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 2731","","","كتاب الصلوات"
"2732","(۲۷۳۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ سَالِمًا ، وَالْقَاسِمَ إذَا سَجَدَا اسْتَقْبَلاَ بِأَکُفِّہِمَا إلَی الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 2732","","","كتاب الصلوات"
"2733","(۲۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُثْمَانَ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَرِہَ أَنْ یَعْدِلَ بِکَفَّیْہِ عَنِ الْقِبْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 2733","","","كتاب الصلوات"
"2734","(۲۷۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مِسْعَرٌ ، عَنْ عُثْمَانَ ، عَنْ سَالِمٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، مِثْلَ حَدِیثِ وَکِیعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 2734","","","كتاب الصلوات"
"2735","(۲۷۳۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ سَعِیدِ بْنِ ذِی لَعْوَۃَ ، قَالَ : قَالَ عُمَرُ : إذَا لَمْ یَقْدِرْ أَحَدُکُمْ عَلَی السُّجُودِ یَوْمَ الْجُمُعَۃِ ، فَلْیَسْجُدْ عَلَی ظَہْرِ أَخِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2735","","","كتاب الصلوات"
"2736","(۲۷۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2736","","","كتاب الصلوات"
"2737","(۲۷۳۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُحِبُّ أَنْ یَمْثُلَ قَائِمًا حَتَّی یَرْفَعُوا رُؤُوسَہُمْ، ثُمَّ یَسْجُدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2737","","","كتاب الصلوات"
"2738","(۲۷۳۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا لَمْ یَسْتَطِعْ یَوْمَ الْجُمُعَۃِ أَنْ یَسْجُدَ عَلَی الأَرْضِ فَأَہْوَی بِرَأْسِہِ ، فَلْیَسْجُدْ عَلَی ظَہْرِ أَخِیہِ۔","","Musannaf Ibn Abi Shaybah 2738","","","كتاب الصلوات"
"2739","(۲۷۳۹) حَدَّثَنَا شَرِیکٌ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ ، قَالَ : قَالَ : مُجَاہِدٌ : أَسْجُدُ عَلَی ظَہْرِ رَجُلٍ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 2739","","","كتاب الصلوات"
"2740","(۲۷۴۰) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ عَنْبَسَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ: إذَا رَفَعَ الَّذِی بَیْنَ یَدَیْہِ رَأْسَہُ سَجَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 2740","","","كتاب الصلوات"
"2741","(۲۷۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عُمَرَ ، قَالَ : إذَا لَمْ یَسْتَطِعِ الرَّجُلُ أَنْ یَسْجُدَ یَوْمَ الْجُمُعَۃِ ، فَلْیَسْجُدْ عَلَی ظَہْرِ أَخِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2741","","","كتاب الصلوات"
"2742","(۲۷۴۲) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ فُضَیْلٍ، عَنْ إبْرَاہِیمَ ، قَالَ: قَالَ عُمَرُ ، ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ أَبِی مُعَاوِیَۃَ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ۔","","Musannaf Ibn Abi Shaybah 2742","","","كتاب الصلوات"
"2743","(۲۷۴۳) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی حَبِیبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ، قَالَ : جَائَنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّی بِنَا فِی مَسْجِدِ بَنِی عَبْدِ الأَشْہَلِ ، فَرَأَیْتُہُ وَاضِعًا یَدَیْہِ فِی ثَوْبِہِ إذَا سَجَدَ۔ (ابن ماجہ ۱۰۳۱۔ احمد ۴/۳۳۵)","","Musannaf Ibn Abi Shaybah 2743","","","كتاب الصلوات"
"2744","(۲۷۴۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، أَوْ وَبَرَۃَ، قَالَ: کَانَ ابْنُ عُمَرَ یَلْتَحِفُ بِالْمِلْحَفَۃِ، ثُمَّ یَسْجُدُ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 2744","","","كتاب الصلوات"
"2745","(۲۷۴۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، قَالَ : رَأَیْتُ شُرَیْحًا یَسْجُدُ فِی بُرْنُسِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2745","","","كتاب الصلوات"
"2746","(۲۷۴۶) حَدَّثَنَا عَلِیُّ بْنُ مِسْہِرٍ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی بُرْنُسٍ ، وَلاَ یُخْرِجُ یَدَیْہِ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2746","","","كتاب الصلوات"
"2747","(۲۷۴۷) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنُ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ الأَسْوَدَ یُصَلِّی فِی بُرْنُسِ طَیَالِسِہِ ، یَسْجُدُ فِیہِ ، وَرَأَیْت عَبْدَ الرَّحْمَنِ ، یَعْنِی ابْنَ یَزِیدَ ، یُصَلِّی فِی بُرْنُسٍ شَامِیٍّ یَسْجُدُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 2747","","","كتاب الصلوات"
"2748","(۲۷۴۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَسْجُدُ فِی طَیْلَسَانِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2748","","","كتاب الصلوات"
"2749","(۲۷۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ یَحْیَی بْنَ وَثَّابٍ یُصَلِّی فِی مُسْتُقَۃٍ بَیْنَ أُسْطُوَانَتَیْنِ یَؤُمُّ الْقَوْمَ ، وَیَدَاہُ فِی جَوْفِہَا۔","","Musannaf Ibn Abi Shaybah 2749","","","كتاب الصلوات"
"2750","(۲۷۵۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، قَالَ : رَأَیْتُ الْحَسَنَ یَلْبَسُ أَنْبِجَانِیًّا فِی الشِّتَائِ ، یُصَلِّی فِیْہِ ، وَلاَ یُخْرِجُ یَدَیْہِ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 2750","","","كتاب الصلوات"
"2751","(۲۷۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ نَافِعٍ ؛ رَأَیْت سَعِیدَ بْنَ جُبَیْرٍ یُصَلِّی فِی بُرْنُسٍ ، وَلاَ یُخْرِجُ یَدَیْہِ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2751","","","كتاب الصلوات"
"2752","(۲۷۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ عَلْقَمَۃُ ، وَمَسْرُوقٌ یُصَلُّونَ فِی بَرَانِسِہِمْ وَمُسْتُقَاتِہِمْ ، وَلاَ یُخْرِجُونَ أَیْدِیَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2752","","","كتاب الصلوات"
"2753","(۲۷۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ لاَ یُخْرِجُ یَدَیْہِ مِنَ الْمُسْتُقَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2753","","","كتاب الصلوات"
"2754","(۲۷۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنَّ أَصْحَابَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْجُدُونَ وَأَیْدِیہِمْ فِی ثِیَابِہِمْ ، وَیَسْجُدُ الرَّجُلُ مِنْہُمْ عَلَی عِمَامَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2754","","","كتاب الصلوات"
"2755","(۲۷۵۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ؛ أَنَّ أَبَا قِلاَبَۃَ کَانَ إذَا سَجَدَ أَخَرَجَ یَدَیْہِ مِنْ ثَوْبِہِ۔","","Musannaf Ibn Abi Shaybah 2755","","","كتاب الصلوات"
"2756","(۲۷۵۶) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : رَأَیْتُ سَالِمًا إذَا سَجَدَ أَخْرَجَ یَدَیْہِ مِنْ بُرْنُسِہِ، حَتَّی یَضَعَہُمَا عَلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 2756","","","كتاب الصلوات"
"2757","(۲۷۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْن عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُبَاشِرُ بِکَفَّیْہِ الأَرْضَ إذَا سَجَدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2757","","","كتاب الصلوات"
"2758","(۲۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ مُوسَی بْنِ أَبِی ع??ائِشَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَاصِمٍ ، عَنْ أَبِی ہِنْدٍ الشَّامِیِّ ، قَالَ : قَالَ عُمَرُ : إذَا سَجَدَ أَحَدُکُمْ فَلْیُبَاشِرْ بِکَفَّیْہِ الأَرْضَ ، لَعَلَّ اللَّہَ یَصْرِفُ عَنْہُ الْغَالَّ، إِنْ غُلَّ یَوْمَ الْقِیَامَۃِ۔","Majhul","Musannaf Ibn Abi Shaybah 2758","","","كتاب الصلوات"
"2759","(۲۷۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ؛ أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَسْجُدَ أَخْرَجَ یَدَیْہِ مِنَ الطَّیْلَسَانِ۔","","Musannaf Ibn Abi Shaybah 2759","","","كتاب الصلوات"
"2760","(۲۷۶۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یُخْرِجُ یَدَیْہِ إذَا سَجَدَ ، وَإِنَّہُمَا لَیَقْطُرَانِ دَمًا۔","Sahih","Musannaf Ibn Abi Shaybah 2760","","","كتاب الصلوات"
"2761","(۲۷۶۱) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا عَبْدُ الْوَارِثِ ، قَالَ : أَخْبَرَنَا إِسْحَاقُ بْنُ سُوَیْد ، قَالَ : رَأَیْتُ أَبَا قَتَادَۃَ الْعَدَوِیَّ إذَا سَجَدَ یُخْرِجُ یَدَیْہِ ، یُمِسَّہُمَا الأَرْض۔","","Musannaf Ibn Abi Shaybah 2761","","","كتاب الصلوات"
"2762","(۲۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ؛ أَنَّہُ کَانَ یَسْجُدُ عَلَی کَوْرِ الْعِمَامَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2762","","","كتاب الصلوات"
"2763","(۲۷۶۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ؛أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِالسُّجُودِ عَلَی کَوْرِ الْعِمَامَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2763","","","كتاب الصلوات"
"2764","(۲۷۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَسْجُدُ عَلَی کَوْرِ الْعِمَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2764","","","كتاب الصلوات"
"2765","(۲۷۶۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّہُ کَانَ یَسْجُدُ وَہُوَ مُعْتَمٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 2765","","","كتاب الصلوات"
"2766","(۲۷۶۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَسْجُدُ عَلَی کَوْرِ الْعِمَامَۃِ ، فَقُلْتُ لَہُ ؟ فَقَالَ : إنِّی أَخَافُ عَلَی بَصَرِی مِنْ بَرْدِ الْحَصَی۔","No Data Available","Musannaf Ibn Abi Shaybah 2766","","","كتاب الصلوات"
"2767","(۲۷۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِالسُّجُودِ عَلَی کَوْرِ الْعِمَامَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2767","","","كتاب الصلوات"
"2768","(۲۷۶۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی وَرْقَائَ ، قَالَ : رَأَیْتُ ابْنَ أَبِی أَوْفَی یَسْجُدُ علَی کَوْرِ عِمَامَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2768","","","كتاب الصلوات"
"2769","(۲۷۶۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَنِ بْنَ یَزِیدَ یَسْجُدُ عَلَی عِمَامَتِہِ غَلِیظَۃِ الأَکْوَارِ ، قَدْ حَالَتْ بَیْنَ جَبْہَتِہِ وَبَیْنَ الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 2769","","","كتاب الصلوات"
"2770","(۲۷۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سَکَنِ بْنِ أَبِی کَرِیمَۃَ ، عَنْ مُحَمَّدِ بْنِ عُبَادَۃَ ، عَنْ مَحْمُودِ بْنِ رَبِیعٍ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ؛ أَنَّہُ کَانَ إذَا قَامَ إلَی الصَّلاَۃِ حَسِرَ الْعِمَامَۃَ عَنْ جَبْہَتِہِ۔","Majhul","Musannaf Ibn Abi Shaybah 2770","","","كتاب الصلوات"
"2771","(۲۷۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی الثَّعْلَبِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، قَالَ: إذَا صَلَّی أَحَدُکُمْ فَلْیَحْسِرِ الْعِمَامَۃَ عَنْ جَبْہَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2771","","","كتاب الصلوات"
"2772","(۲۷۷۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَسْجُدُ عَلَی کَوْرِ الْعِمَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 2772","","","كتاب الصلوات"
"2773","(۲۷۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : أَصَابَتْنِی شَجَّۃٌ فَعَصَبْت عَلَیْہَا عِصَابَۃً ، فَسَأَلْت عَبِیْدَۃَ: أَسْجُدُ عَلَیْہَا ؟ قَالَ : لاَ۔ (عبدالرزاق ۱۵۶۹)","","Musannaf Ibn Abi Shaybah 2773","","","كتاب الصلوات"
"2774","(۲۷۷۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ عِیَاضِ بْنِ عَبْدِ اللہِ الْقُرَشِیِّ ؛ قَالَ : رَأَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یَسْجُدُ عَلَی کَوْرِ الْعِمَامَۃِ ، فَأَوْمَأَ بِیَدِہِ أَنِ ارْفَعْ عِمَامَتَکَ فَأَوْمَأَ إلَی جَبْہَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 2774","","","كتاب الصلوات"
"2775","(۲۷۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُحِبُّ لِلْمُعْتَمِّ أَنْ یُنَحِّیَ کَوْرَ الْعِمَامَۃِ عَنْ جَبْہَتِہِ۔","","Musannaf Ibn Abi Shaybah 2775","","","كتاب الصلوات"
"2776","(۲۷۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : أُبْرِزُ جَبِینِی أَحَبُّ إلَیَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 2776","","","كتاب الصلوات"
"2777","(۲۷۷۷) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَرِہَ السُّجُودَ عَلَی کَوْرِ الْعِمَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2777","","","كتاب الصلوات"
"2778","(۲۷۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَعْفَر بْنِ بُرْقَانِ ، عَنْ مَیْمُونٍ ، قَالَ : أُبْرِزُ جَبِینِی أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 2778","","","كتاب الصلوات"
"2779","(۲۷۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَرِہَ السُّجُودَ عَلَی کَوْرِ الْعِمَامَۃِ۔","","Musannaf Ibn Abi Shaybah 2779","","","كتاب الصلوات"
"2780","(۲۷۸۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ فِی الْمُعْتَمِّ ، قَالَ : یُمَکِّنُ جَبْہَتَہُ مِنَ الأَرْضِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2780","","","كتاب الصلوات"
"2781","(۲۷۸۱) حَدَّثَنَا وَکِیعٌ، عَنِ ابْنِ عُلاَثَۃَ، أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ، قَالَ لِرَجُلٍ: لَعَلَّک فِیمَنْ یَسْجُدُ عَلَی کَوْرِ الْعِمَامَۃِ؟!","","Musannaf Ibn Abi Shaybah 2781","","","كتاب الصلوات"
"2782","(۲۷۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ جَعْدَۃَ بْنِ ہُبَیْرَۃَ ؛ أَنَّہُ رَأَی رَجُلاً یَسْجُدُ وَعَلَیْہِ مِغْفَرَۃٌ وَعِمَامَۃٌ ، قَدْ غَطَّی بِہِمَا وَجْہَہُ ، فَأَخَذَ بِمِغْفَرِہِ وَعِمَامَتِہِ فَأَلْقَاہ مِنْ خَلْفِہِ۔","","Musannaf Ibn Abi Shaybah 2782","","","كتاب الصلوات"
"2783","(۲۷۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : صَلَّی عُمَرُ ذَاتَ یَوْمٍ بِالنَّاسِ الْجُمُعَۃَ ، فِی یَوْمٍ شَدِیدِ الْحَرِّ ، فَطَرَحَ طَرَفَ ثَوْبِہِ بِالأَرْضِ ، فَجَعَلَ یَسْجُدُ عَلَیْہِ ، ثُمَّ قَالَ : یَا أَیُّہَا النَّاسُ ، إذَا وَجَدَ أَحَدُکُمُ الْحَرَّ فَلْیَسْجُدْ عَلَی طَرَفِ ثَوْبِہِ۔","","Musannaf Ibn Abi Shaybah 2783","","","كتاب الصلوات"
"2784","(۲۷۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عُمَرَ ، قَالَ : إذَا لَمْ یَسْتَطِعْ أَحَدُکُمْ أَنْ یَسْجُدَ عَلَی الأَرْضِ مِنَ الْحَرِّ وَالْبَرْدِ ، فَلْیَسْجُدْ عَلَی ثَوْبِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2784","","","كتاب الصلوات"
"2785","(۲۷۸۵) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ غَالِبٍ ، عَنْ بَکْرٍ ، عَنْ أَنَسٍ ، قَالَ : کُنَّا نُصَلِّی مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی شِدَّۃِ الْحَرِّ ، فَإِذَا لَمْ یَسْتَطِعْ أَحَدُنَا أَنْ یُمَکِّنَ وَجْہَہُ مِنَ الأَرْضِ بَسَطَ ثَوْبَہُ فَسَجَدَ عَلَیْہِ۔n(مسلم ۱۹۱۔ ابوداؤد ۶۶۰)","Sahih","Musannaf Ibn Abi Shaybah 2785","","","كتاب الصلوات"
"2786","(۲۷۸۶) حَدَّثَنَا شَرِیکٌ ، عَنْ حُسَیْنٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی فِی ثَوْبٍ وَاحِدٍ ، یَتَّقِی بِفُضُولِہِ حَرَّ الأَرْضِ ، وَبَرْدَہَا۔ (احمد ۱/۳۵۴۔ عبدالرزاق ۱۳۶۹)","Da'if","Musannaf Ibn Abi Shaybah 2786","","","كتاب الصلوات"
"2787","(۲۷۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : إذَا وَجَدَ أَحَدُکُمْ حَرَّ الأَرْضِ ، فَلْیَضَعْ ثَوْبَہُ بَیْنَہُ وَبَیْنَ الأَرْضِ ، ثُمَّ لْیَسْجُدْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2787","","","كتاب الصلوات"
"2788","(۲۷۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : إذَا کَانَ حَرٌّ ، أَوْ بَرْدٌ فَلْیَسْجُدْ عَلَی ثَوْبِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2788","","","كتاب الصلوات"
"2789","(۲۷۸۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، قَالَ : رَأَیْتُ مُجَاہِدًا فِی الْمَسْجِدِ الْحَرَامِ فِی یَوْمٍ حَارٍّ ، بَسَطَ ثَوْبَہُ فَسَجَدَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2789","","","كتاب الصلوات"
"2790","(۲۷۹۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ ہِشَامِ بْنِ سَعِیدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : قُلْتُ لِعَطَائِ بْنِ یَسَارٍ : أَسْجُدُ عَلَی ثَوْبِی ؟ قَالَ : ثِیَابِی مِنِّی۔","","Musannaf Ibn Abi Shaybah 2790","","","كتاب الصلوات"
"2791","(۲۷۹۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَسْجُدَ الرَّجُلُ عَلَی الثَّوْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2791","","","كتاب الصلوات"
"2792","(۲۷۹۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : أَسْجُدُ عَلَی ثَوْبِی إذَا آذَانِی الْحَرُّ ، فَأَمَّا عَلَی ظَہْرِ رَجُلٍ فَلاَ۔","","Musannaf Ibn Abi Shaybah 2792","","","كتاب الصلوات"
"2793","(۲۷۹۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا سَجَدَتِ الْمَرْأَۃُ فَلْتَحْتَفِز ، وَلْتَضُمَّ فَخِذَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 2793","","","كتاب الصلوات"
"2794","(۲۷۹۴) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیء ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ سُئِلَ عَنْ صَلاَۃِ الْمَرْأَۃِ ؟ فَقَالَ : تَجْتَمِعُ وَتَحْتَفِزُ۔","","Musannaf Ibn Abi Shaybah 2794","","","كتاب الصلوات"
"2795","(۲۷۹۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَجَدَتِ الْمَرْأَۃُ فَلْتَضُمَّ فَخِذَیْہَا ، وَلْتَضَعْ بَطْنَہَا عَلَیْہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2795","","","كتاب الصلوات"
"2796","(۲۷۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَضَعَ الرَّجُلُ بَطْنَہُ عَلَی فَخِذَیْہِ إذَا سَجَدَ کَمَا تَصْنَعُ الْمَرْأَۃُ۔","","Musannaf Ibn Abi Shaybah 2796","","","كتاب الصلوات"
"2797","(۲۷۹۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْمَرْأَۃُ تَضْطَمُّ فِی السُّجُودِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2797","","","كتاب الصلوات"
"2798","(۲۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَجَدَتِ الْمَرْأَۃُ فَلْتَلْزَقْ بَطْنَہَا بِفَخِذَیْہَا ، وَلاَ تَرْفَعْ عَجِیزَتَہَا ، وَلاَ تُجَافِی کَمَا یُجَافِی الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 2798","","","كتاب الصلوات"
"2799","(۲۷۹۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ زُرْعَۃَ بْنِ إِبْرَاہِیمَ ، عَن خَالِدِ بْنِ اللَّجْلاَجِ ، قَالَ : کُنَّ النِّسَائُ یُؤْمَرْنَ أَنْ یَتَرَبَّعْنَ إذَا جَلَسْنَ فِی الصَّلاَۃِ ، وَلاَ یَجْلِسْنَ جُلُوسَ الرِّجَالِ عَلَی أَوْرَاکِہِنَّ ، یُتَّقی ذَلِکَ عَلَی الْمَرْأَۃِ ، مَخَافَۃَ أَنْ یَکُونَ مِنْہَا الشَّیئُ۔","Sahih","Musannaf Ibn Abi Shaybah 2799","","","كتاب الصلوات"
"2800","(۲۸۰۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ؛ أَنَّ صَفِیَّۃَ کَانَتْ تُصَلِّی وَہِیَ مُتَرَبِّعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2800","","","كتاب الصلوات"
"2801","(۲۸۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ مَکْحُولٍ ؛ أَنَّ أُمَّ الدَّرْدَائِ کَانَتْ تَجْلِسُ فِی الصَّلاَۃِ کَجِلْسَۃِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 2801","","","كتاب الصلوات"
"2802","(۲۸۰۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : تَرَبَّعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2802","","","كتاب الصلوات"
"2803","(۲۸۰۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمٍ ، عَنْ قَتَادَۃَ ، قَالَ : تَجْلِسُ کَمَا تَرَی أَنَّہُ أَیْسَرُ۔","","Musannaf Ibn Abi Shaybah 2803","","","كتاب الصلوات"
"2804","(۲۸۰۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَقْعُدُ الْمَرْأَۃُ فِی الصَّلاَۃِ کَمَا یَقْعُدُ الرَّجُلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2804","","","كتاب الصلوات"
"2805","(۲۸۰۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، قَالَ : کُنَّ نِسَائُ ابْنِ عُمَرَ یَتَرَبَّعْنَ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 2805","","","كتاب الصلوات"
"2806","(۲۸۰۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنْ قُعُودِ الْمَرْأَۃِ فِی الصَّلاَۃِ ؟ قَالَ : تَقْعُدُ کَیْفَ شَائَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2806","","","كتاب الصلوات"
"2807","(۲۸۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَتَجْلِسُ الْمَرْأَۃُ فِی مَثْنَی عَلَی شِقِّہَا الأَیْسَرِ ؟ قَالَ : نَعَمْ ، قُلْتُ : ہُوَ أَحَبُّ إلَیْک مِنَ الأَیْمَنِ ؟ قَالَ : نَعَمْ ، تَجْتَمِعُ جَالِسَۃً مَا اسْتَطَاعَتْ ، قُلْتُ : تَجْلِسُ جُلُوسَ الرَّجُلِ فِی مَثْنَی ، أَوْ تُخْرِجُ رِجْلَہَا الْیُسْرَی مِنْ تَحْتِ أَلْیَتِہَا ؟ قَالَ : لاَ یَضُرُّہَا أَیُّ ذَلِکَ جَلَسَتْ إذَا اجْتَمَعَتْ۔","","Musannaf Ibn Abi Shaybah 2807","","","كتاب الصلوات"
"2808","(۲۸۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَجْلِسُ الْمَرْأَۃُ مِنْ جَانِبٍ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 2808","","","كتاب الصلوات"
"2809","(۲۸۰۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، وَإسْرَائِیلُ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: تَجْلِسُ الْمَرْأَۃُ فِی الصَّلاَۃِ کَمَا تَیَسَّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2809","","","كتاب الصلوات"
"2810","(۲۸۱۰) حَدَّثَنَا ابْن عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَرْفَعُ یَدَیْہِ بَیْنَ السَّجْدَتَیْنِ۔ (بخاری ۷۳۸۔ ابوداؤد ۷۲۱)","Sahih","Musannaf Ibn Abi Shaybah 2810","","","كتاب الصلوات"
"2811","(۲۸۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ بَیْنَ السَّجْدَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 2811","","","كتاب الصلوات"
"2812","(۲۸۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَرْفَعُ یَدَیْہِ إذَا رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ الأُولَی۔","Sahih","Musannaf Ibn Abi Shaybah 2812","","","كتاب الصلوات"
"2813","(۲۸۱۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ نَافِعًا وَطَاوُوسا یَرْفَعَانِ أَیْدِیَہُمَا بَیْنَ السَّجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 2813","","","كتاب الصلوات"
"2814","(۲۸۱۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا یَرْفَعَانِ أَیْدِیَہُمَا بَیْنَ السَّجْدَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2814","","","كتاب الصلوات"
"2815","(۲۸۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُہُ یَفْعَلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2815","","","كتاب الصلوات"
"2816","(۲۸۱۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی فَزَارَۃَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : یَسْجُدُ الْمَرِیضُ عَلَی الْمِرْفَقَۃِ وَالثَّوْبِ الطَّیِّبِ۔","","Musannaf Ibn Abi Shaybah 2816","","","كتاب الصلوات"
"2817","(۲۸۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : حدَّثَتْنِی أُمُّ الْحَسَنِ ؛ أَنَّہَا رَأَتْ أُمَّ سَلَمَۃَ رَمِدَتْ عَیْنُہَا ، فَثَنَیْتُ لَہَا وِسَادَۃً مِنْ أَدَمٍ ، فَجَعَلَتْ تَسْجُدُ عَلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 2817","","","كتاب الصلوات"
"2818","(۲۸۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ ، عَنْ أُمِّ سَلَمَۃَ ، مِثْلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 2818","","","كتاب الصلوات"
"2819","(۲۸۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ، مِثْلَہُ ، إِلاَّ أَنَّہُ قَالَ : اشْتَکَتْ عَیْنَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 2819","","","كتاب الصلوات"
"2820","(۲۸۲۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسٍ ؛ أَنَّہُ سَجَدَ عَلَی مِرْفَقَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 2820","","","كتاب الصلوات"
"2821","(۲۸۲۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : کَانَ أَبُو الْعَالِیَۃِ مَرِیضًا ، وَکَانَتِ الْمِرْفَقَۃُ تُثْنَی لَہُ فَیَسْجُدُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 2821","","","كتاب الصلوات"
"2822","(۲۸۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَسْجُدَ الرَّجُلُ عَلَی الْمِرْفَقَۃِ وَالْوِسَادَۃِ فِی السَّفِینَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2822","","","كتاب الصلوات"
"2823","(۲۸۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ؛ عَادَ ابْنُ عُمَرَ صَفْوَانَ ، فَوَجَدَہُ یَسْجُدُ عَلَی وِسَادَۃٍ فَنَہَاہُ ، وَقَالَ : أَوْمِیئْ إیمَائً۔","Sahih","Musannaf Ibn Abi Shaybah 2823","","","كتاب الصلوات"
"2824","(۲۸۲۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : السُّجُودُ عَلَی الْوِسَادَۃِ مُحْدَثٌ۔","","Musannaf Ibn Abi Shaybah 2824","","","كتاب الصلوات"
"2825","(۲۸۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ ، قَالَ : اشْتَکَی أَبُو الأَسْوَدِ الْفَالِجَ ، فَکَانَ لاَ یَسْجُدُ إِلاَّ مَا رَفَعْنَاہُ لَہُ ، مِرْفَقَۃً یَسْجُدُ عَلَیْہَا ، فَسَأَلْنَا عَنْ ذَلِکَ ، وَأَرْسَلَ إلَی ابْنِ عُمَرَ ، فَقَالَ: إنِ اسْتَطَاعَ أَنْ یَسْجُدَ عَلَی الأَرْضِ ، وَإِلاَّ فَیُومِیئُ إیمَائً۔","Majhul","Musannaf Ibn Abi Shaybah 2825","","","كتاب الصلوات"
"2826","(۲۸۲۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ کَانَ یُصَلِّی عَلَی فِرَاشِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2826","","","كتاب الصلوات"
"2827","(۲۸۲۷) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یُصَلِّی عَلَی الْفِرَاشِ الَّذِی مَرِضَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2827","","","كتاب الصلوات"
"2828","(۲۸۲۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الْحَسَنِ بْنِ عُبَیْدِاللہِ، عَنْ إبْرَاہِیمَ، قَالَ: رَأَیْتُ الأَسْوَدَ یُومِیئُ فِی مَرَضِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2828","","","كتاب الصلوات"
"2829","(۲۸۲۹) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ؛ أَنَّہُ رَأَی سَعِیدَ بْنَ الْمُسَیَّبِ إذَا کَانَ مَرِیضًا لاَ یَسْتَطِیعُ الْجُلُوسَ أَوْمَأَ إیمَائً ، وَلَمْ یَرْفَعْ إلَی رَأْسِہِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 2829","","","كتاب الصلوات"
"2830","(۲۸۳۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُمَا قَالاَ : یُصَلِّی الْمَرِیضُ عَلَی الْحَالَۃِ الَّتِی ہُوَ عَلَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2830","","","كتاب الصلوات"
"2831","(۲۸۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أبی إسحاق عن تَمِیمَۃَ مَوْلاَۃِ وَادعَۃَ ، قَالَتْ : دَخَلَ شُرَیْحٌ عَلَی أَبِی مَیْسَرَۃَ یَعُودُہُ ، فَقَالَ لَہُ : کَیْفَ تُصَلِّی ؟ قَالَ : قَاعِدًا ، قَالَ : فَقَالَ لَہُ شُرَیْحٌ : أَنْتَ أَعْلَمُ مِنَّا۔","","Musannaf Ibn Abi Shaybah 2831","","","كتاب الصلوات"
"2832","(۲۸۳۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، أَنَّہُ کَانَ یَقُولُ : الْمَرِیضُ إذَا لَمْ یَسْتَطِعِ السُّجُودَ أَوْمَأَ إیمَائً۔","","Musannaf Ibn Abi Shaybah 2832","","","كتاب الصلوات"
"2833","(۲۸۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : سَأَلْتُ عَامِرًا عَنْ صَلاَۃِ الْمَرِیضِ ؟ فَقَالَ : إذَا لَمْ یَسْتَطِعْ أَنْ یَضَعَ جَبْہَتَہُ عَلَی الأَرْضِ فَلْیُومِیئْ إیمَائً ، وَلْیَجْعَلِ السُّجُودَ أَخْفَضَ مِنَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 2833","","","كتاب الصلوات"
"2834","(۲۸۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ صَلاَۃِ الْمَرِیضِ عَلَی الْعُودِ؟ فَقَالَ: لاَ آمُرُکُمْ أَنْ تَتَّخِذُوا مِنْ دُونِ اللہِ أَوْثَانًا ، إنِ اسْتَطَعْت أَنْ تُصَلِّیَ قَائِمًا ، وَإِلاَّ فَقَاعِدًا ، وَإِلاَّ فَمُضْطَجِعًا۔","Sahih","Musannaf Ibn Abi Shaybah 2834","","","كتاب الصلوات"
"2835","(۲۸۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : دَخَلْنَا عَلَی إبْرَاہِیمَ وَہُوَ مَرِیضٌ ، وَہُوَ یُصَلِّی عَلَی شِقِّہِ الأَیْمَنِ یُومِیئُ إیمَائً۔","","Musannaf Ibn Abi Shaybah 2835","","","كتاب الصلوات"
"2836","(۲۸۳۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ عَنْ أَبِی خَلْدَۃَ قَالَ : رَأَیْتُ أَبَا الْعَالِیَۃَ وَہُوَ مَرِیضٌ یُومِیئُ۔","","Musannaf Ibn Abi Shaybah 2836","","","كتاب الصلوات"
"2837","(۲۸۳۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : یُصَلِّی قَاعِدًا ، فَإِنْ لَمْ یَسْتَطِعْ فَلْیُومِیء ، وَلاَ یَمَسُّ عُودًا۔","","Musannaf Ibn Abi Shaybah 2837","","","كتاب الصلوات"
"2838","(۲۸۳۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ؛ فِی الْمَرِیضِ إذَا لَمْ یَسْتَطِعْ أَنْ یُصَلِّیَ ، قَالَ : یُومِیئُ إیمَائً۔","","Musannaf Ibn Abi Shaybah 2838","","","كتاب الصلوات"
"2839","(۲۸۳۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حَدَّثَنَا أَبُو عَوَانَۃَ ، عَنِ الْمُغِیرَۃِ ، عَنِ الْحَارِثِ ، قَالَ: یُصَلِّی الْمَرِیضُ إذَا لَمْ یَقْدِرْ عَلَی الْجُلُوسِ مُسْتَلْقِیًا، وَیَجْعَلُ رِجْلَیْہِ مِمَّا یَلِی الْقِبْلَۃَ، وَیَسْتَقْبِلُ بِوَجْہِہِ الْقِبْلَۃَ، یُومِیئُ إیمَائً بِرَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 2839","","","كتاب الصلوات"
"2840","(۲۸۴۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، قَالَ : سَأَلْتُ أَنَسًا عَنْ صَلاَۃِ الْمَرِیضِ ، کَیْفَ یُصَلِّی ؟ قَالَ : یُصَلِّی جَالِسًا ، وَیَسْجُدُ عَلَی الأَرْضِ۔","Sahih","Musannaf Ibn Abi Shaybah 2840","","","كتاب الصلوات"
"2841","(۲۸۴۱) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ الْوَاحِدِ مَوْلَی عُرْوَۃَ ، عَنْ عُرْوَۃَ ، قَالَ : الْمَرِیضُ یُومِیئُ ، وَلاَ یَرْفَعُ إلَی وَجْہِہِ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 2841","","","كتاب الصلوات"
"2842","(۲۸۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خُشَیْنَۃَ حَاجِبِ ابْنِ عُمَرَ ، قَالَ : دَخَلْت مَعَ الْحَکَمِ بْنِ الأَعْرَجِ عَلَی بَکْرٍ الْمُزَنِیّ وَہُوَ مَرِیضٌ ، فَقَالَ : أَصَلَّیْتُمُ الْعَصْرَ ؟ قَالُوا : نَعَمْ ، فَقَامَ فَصَلَّی صَلاَۃً فَأَخَفَّہَا لِمَرَضِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 2842","","","كتاب الصلوات"
"2843","(۲۸۴۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا أَبُو عَبْدِ اللہِ الشَّقَرِیُّ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا عِنْدَ أَبِی سَعِیدٍ الْخُدْرِیِّ فِی مَرَضِہِ الَّذِی تُوُفِّیَ فِیہِ ، قَالَ : فَأُغْمِیَ عَلَیْہِ ، فَلَمَّا أَفَاقَ ، قَالَ : قُلْنَا لَہُ : الصَّلاَۃُ یَا أَبَا سَعِیدٍ ، قَالَ : کَفَانٍ۔n قَالَ أَبُو بَکْرٍ : یُرِیدُ کَفَانٍ ، یَعْنِی أَوْمَأَ۔","Sahih","Musannaf Ibn Abi Shaybah 2843","","","كتاب الصلوات"
"2844","(۲۸۴۴) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَاصِمٌ ، قَالَ: دَخَلَ عَلَیَّ أَبُو وَائِلٍ وَأَنَا مَرِیضٌ، فَقُلْتُ لَہُ : أُصَلِّی یَا أَبَا وَائِلٍ وَأَنَا دَنِفٌ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 2844","","","كتاب الصلوات"
"2845","(۲۸۴۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، قَالَ : کَانَ عُمَرَ یَکْرَہُ أَنْ یَسْجُدَ الرَّجُلُ عَلَی الْعُودِ۔","","Musannaf Ibn Abi Shaybah 2845","","","كتاب الصلوات"
"2846","(۲۸۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : دَخَلَ عَبْدُ اللہِ عَلَی أَخِیہِ عُتْبَۃَ یَعُودُہُ ، فَوَجَدَہُ عَلَی عُودٍ یُصَلِّی ، فَطَرَحَہُ وَقَالَ : إنَّ ہَذَا شَیْئٌ عَرَّضَ بِہِ الشَّیْطَانُ ، ضَعْ وَجْہَک عَلَی الأَرْضِ، فَإِنْ لَمْ تَسْتَطِعْ فَأَوْمِیئْ إیمَائً۔","Sahih","Musannaf Ibn Abi Shaybah 2846","","","كتاب الصلوات"
"2847","(۲۸۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : سُئِلَ عَنِ الصَّلاَۃِ عَلَی الْعُودِ فَکَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2847","","","كتاب الصلوات"
"2848","(۲۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : دَخَلَ ابْنُ مَسْعُودٍ عَلَی أَخِیہِ عُتْبَۃَ وَہُوَ مَرِیضٌ ، وَہُوَ یَسْجُدُ عَلَی سِوَاکٍ ، فَرَمَی بِہِ وَقَالَ : أَوْمِیئْ إیمَائً۔","","Musannaf Ibn Abi Shaybah 2848","","","كتاب الصلوات"
"2849","(۲۸۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِید بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ الصَّلاَۃَ عَلَی الْعُودِ۔","","Musannaf Ibn Abi Shaybah 2849","","","كتاب الصلوات"
"2850","(۲۸۵۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مَالِکِ بْنِ عُمَیْرٍ ، قَالَ : حدَّثَنِی مَنْ رَأَی حُذَیْفَۃَ مَرِضَ ، فَکَانَ یُصَلِّی وَقَدْ جُعِلَ لَہُ وِسَادَۃٌ ، وَجُعِلَ لَہُ لَوْحٌ یَسْجُدُ عَلَیْہِ۔","Majhul","Musannaf Ibn Abi Shaybah 2850","","","كتاب الصلوات"
"2851","(۲۸۵۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ رَزِینٍ مَوْلَی آلِ عَبَّاسٍ ، قَالَ : أَرْسَلَ إلَیَّ عَلِیُّ بْنُ عَبْدِ اللہِ بْنِ عَبَّاسٍ ، أَنْ أَرْسِلْ إلَیَّ بِلَوْحٍ مِنَ الْمَرْوَۃِ ، أَسْجُدُ عَلَیْہِ۔","Majhul","Musannaf Ibn Abi Shaybah 2851","","","كتاب الصلوات"
"2852","(۲۸۵۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ : دَخَلَ عَبْدُ اللہِ عَلَی أَخِیہِ ، فَرَآہُ یُصَلِّی عَلَی عُودٍ فَانْتَزَعَہُ وَرَمَی بِہِ ، وَقَالَ : أَوْمِیئْ إیمَائً حَیْثُ مَا یَبْلُغُ رَأْسُک۔","Sahih","Musannaf Ibn Abi Shaybah 2852","","","كتاب الصلوات"
"2853","(۲۸۵۳) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ فِی الْمَرِیضِ إذَا لَمْ یَقْدِرْ عَلَی السُّجُودِ ، قَالَ : یُومِیئُ حَیْثُ مَا یَبْلُغُ رَأْسُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2853","","","كتاب الصلوات"
"2854","(۲۸۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثُ سَکَتَاتٍ: سَکْتَۃً إذَا افْتَتَحَ التَّکْبِیرَ حَتَّی یَقْرَأَ الْحَمْدَ ، وَإِذَا فَرَغَ مِنَ الْحَمْدِ حَتَّی یَقْرَأَ السُّورَۃَ ، وَإِذَا فَرَغَ مِنَ السُّورَۃِ حَتَّی یَرْکَعَ۔ (ترمذی ۲۵۱۔ ابوداؤد ۷۷۶)","","Musannaf Ibn Abi Shaybah 2854","","","كتاب الصلوات"
"2855","(۲۸۵۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَارَۃَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا کَبَّرَ سَکَتَ بَیْنَ التَّکْبِیرَۃِ وَالْقِرَائَۃِ۔ (بخاری ۷۴۴۔ ابوداؤد ۷۷۷)","Sahih","Musannaf Ibn Abi Shaybah 2855","","","كتاب الصلوات"
"2856","(۲۸۵۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : کَانَتْ لَہُ وَقْفَتَانِ : وَقْفَۃٌ إذَا کَبَّرَ ، وَوَقْفَۃٌ إذَا فَرَغَ مِنْ أُمِّ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 2856","","","كتاب الصلوات"
"2857","(۲۸۵۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَسْکُتُ سَکْتَتَیْنِ : إذَا دَخَلَ فِی الصَّلاَۃِ ، وَإِذَا فَرَغَ مِنَ الْقِرَائَۃِ ، فَأَنْکَرَ ذَلِکَ عِمْرَانُ بْنُ حُصَیْنٍ ، فَکَتَبُوا إلَی أُبَیِّ بْنِ کَعْبٍ فَکَتَبَ إلَیْہِمْ أَنْ صَدَقَ سَمُرَۃُ۔(ابوداؤد ۷۷۳۔ احمد ۵/۲۳)","Hasan","Musannaf Ibn Abi Shaybah 2857","","","كتاب الصلوات"
"2858","(۲۸۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ إذَا کَبَّرَ سَکَتَ ہُنَیْہَۃً ، وَإذَا قَالَ : {غَیْرِ الْمَغْضُوبِ عَلَیْہِمْ وَلاَ الضَّالِّینَ} سَکَتَ ہُنَیْہَۃً ، وَإِذَا نَہَضَ فِی الرَّکْعَۃِ الثَّانِیَۃِ لَمْ یَسْکُتْ ، وَقَالَ : {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","No Data Available","Musannaf Ibn Abi Shaybah 2858","","","كتاب الصلوات"
"2859","(۲۸۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : سَکَتَ الإِمَامُ سَکْتَتَیْنِ : سَکْتَۃً إذَا کَبَّرَ قَبْلَ أَنْ یَقْرَأَ ، وَسَکْتَۃً إذَا فَرَغَ مِنَ السُّورَۃِ قَبْلَ أَنْ یَرْکَعَ۔","","Musannaf Ibn Abi Shaybah 2859","","","كتاب الصلوات"
"2860","(۲۸۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الأَنْصَارِیِّ ، قَالَ: سَمِعْتُ عَبْدَ الرَّحْمَنِ الأَعْرَجَ، قَالَ : صَلَّیْت مَعَ أَبِی ہُرَیْرَۃَ ، فَلَمَّا کَبَّرَ سَکَتَ سَاعَۃً ، ثُمَّ قَالَ : {الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ}۔","Sahih","Musannaf Ibn Abi Shaybah 2860","","","كتاب الصلوات"
"2861","(۲۸۶۱) حَدَّثَنَا أَبُو الأَحْوَصِِ سَلاَّمُ بْنُ سُلَیْمٍ ، عَنْ سِمَاکِ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا وَضَعَ أَحَدُکُمْ وَہُوَ یُرِیدُ أَنْ یُصَلِّیَ مِثْلَ مُؤْخِرَۃِ الرَّحْلِ فَلْیُصَلِّ ، وَلاَ یُبَالِ مَنْ مَرَّ وَرَائَ ذَلِکَ۔ (ابوداؤد ۶۸۵۔ ابن ماجہ ۹۴۰)","Hasan","Musannaf Ibn Abi Shaybah 2861","","","كتاب الصلوات"
"2862","(۲۸۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا قَامَ أَحَدُکُمْ یُصَلِّی ، فَإِنَّہُ یَسْتُرُہُ إذَا کَانَ بَیْنَ یَدَیْہِ ، مِثْلُ آخِرَۃِ الرَّحْلِ۔n(ابوداؤد ۷۰۲۔ احمد ۱۶۰۔ ابن خزیمۃ ۸۰۶)","Sahih","Musannaf Ibn Abi Shaybah 2862","","","كتاب الصلوات"
"2863","(۲۸۶۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُرَکِّزُ الْحَرْبَۃَ یَوْمَ الْعِیدِ یُصَلِّی إلَیْہَا۔ (بخاری ۹۷۳۔ مسلم ۲۴۶)","Hasan","Musannaf Ibn Abi Shaybah 2863","","","كتاب الصلوات"
"2864","(۲۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی إلَی عَنَزَۃٍ ، أَوْ شِبْہِہَا ، وَالطَّرِیقُ مِنْ وَرَائِہَا۔ (بخاری ۴۹۹۔ ابوداؤد ۶۸۸)","Sahih","Musannaf Ibn Abi Shaybah 2864","","","كتاب الصلوات"
"2865","(۲۸۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مَکْحُولٍ ، قَالَ : إنَّمَا کَانَتِ الْحَرْبَۃُ تُحْمَلُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُصَلِّیَ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 2865","","","كتاب الصلوات"
"2866","(۲۸۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عُمَرَ رَکَزَ عَنَزَۃً ، ثُمَّ صَلَّی إلَیْہَا ، وَالظُّعُنُ تَمُرُّ بَیْنَ یَدَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2866","","","كتاب الصلوات"
"2867","(۲۸۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی مَالِکٍ ، عَنْ أَبِی عُبَیْدِ اللہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : یَسْتُرُ الْمُصَلِّی فِی صَلاَتِہِ مِثْلُ مُؤْخِرَۃِ الرَّحْلِ فِی جُلَّۃِ السَّوْطِ۔","Sahih","Musannaf Ibn Abi Shaybah 2867","","","كتاب الصلوات"
"2868","(۲۸۶۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْمُہَلَّبِ بْنِ أَبِی صُفْرَۃَ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ بَیْنَکَ وَبَیْنَ مَنْ یَمُرُّ بَیْنَ یَدَیْک مِثْلُ مُؤْخِرَۃِ الرَّحْلِ ، فَقَدْ سَتَرَک۔","","Musannaf Ibn Abi Shaybah 2868","","","كتاب الصلوات"
"2869","(۲۸۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی مَالِکٍ ، عَنْ أَبِی عُبَیْدِ اللہِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَتْ تُرَکَّزُ لَہُ الْحَرْبَۃُ فِی الْعِیدِ ، فَیُصَلِّی إلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 2869","","","كتاب الصلوات"
"2870","(۲۸۷۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ فِی الْمَسْجِدِ الْحَرَامِ قَدْ نَصَبَ عَصًا یُصَلِّی إلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 2870","","","كتاب الصلوات"
"2871","(۲۸۷۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیْمِ إذَا اشْتَدَّ عَلَیْہِ الْحَرَّ ، رَکَزَ رُمْحَہُ فِی دَارِہِ ، ثُمَّ صَلَّی إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2871","","","كتاب الصلوات"
"2872","(۲۸۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعَیْبِ بْنِ الْحَبْحابِ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : یَسْتُرُ الْمُصَلِّی مَا وَرَائَ حَرْفِ الْعَلَمِ۔","","Musannaf Ibn Abi Shaybah 2872","","","كتاب الصلوات"
"2873","(۲۸۷۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مِسْعَرٍ ، عَنْ مَعْدَانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا صَلَّیْت فِی فَضَائٍ مِنَ الأَرْضِ ، فَأَلْقِ بسَوْطِک حَتَّی تُصَلِّیَ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2873","","","كتاب الصلوات"
"2874","(۲۸۷۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ ثَابِتِ بْنِ قَیْسٍ الغفاری أَبِی الْغُصْنِ ، قَالَ : رَأَیْتُ نَافِعَ بْنَ جُبَیْرٍ یُصَلِّی إلَی السَّوْطِ فِی السَّفَرِ ، وَإِلَی الْعَصَا۔","","Musannaf Ibn Abi Shaybah 2874","","","كتاب الصلوات"
"2875","(۲۸۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ قَالَ : یَسْتُرُ الرَّجُلُ فِی صَلاَتِہِ مِثْلُ آخِرَۃِ الرَّحْلِ۔","","Musannaf Ibn Abi Shaybah 2875","","","كتاب الصلوات"
"2876","(۲۸۷۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ سَلْمٍ ، عَنِ الْحَسَنِ وَقَتَادَۃَ قَالاَ : تَسْتُرُہُ مِثْلُ آخِرَۃِ الرَّحْلِ إذَا کَانَ قُدَّامَ الْمُصَلِّی۔","","Musannaf Ibn Abi Shaybah 2876","","","كتاب الصلوات"
"2877","(۲۸۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : النَّہْرُ سُتْرَۃٌ۔","","Musannaf Ibn Abi Shaybah 2877","","","كتاب الصلوات"
"2878","(۲۸۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا صَلَّوْا فِی فَضَائٍ أَنْ یَکُونَ بَیْنَ أَیْدِیہِمْ مَا یَسْتُرُہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2878","","","كتاب الصلوات"
"2879","(۲۸۷۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ الرَّبِیعِ بْنِ سَبْرَۃَ بْنِ مَعْبِدٍ الْجُہَنِیِّ ، قَالَ : أَخْبَرَنِی أَبِی ، عَنْ أَبِیہِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِیَسْتَتِرْ أَحَدُکُمْ فِی صَلاَتِہِ وَلَوْ بِسَہْمٍ۔n(احمد ۳/۴۰۴۔ ابن خزیمۃ ۸۱۰)","Da'if","Musannaf Ibn Abi Shaybah 2879","","","كتاب الصلوات"
"2880","(۲۸۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ یَزِیدَ بْنِ أَبِی عُبَیْدٍ ، عَنْ سَلَمَۃَ ، قَالَ : رَأَیْتُہ یَنْصِبُ أَحْجَارًا فِی الْبَرِّیَّۃِ ، فَإِذَا أَرَادَ أَنْ یُصَلِّیَ صَلَّی إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 2880","","","كتاب الصلوات"
"2881","(۲۸۸۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یُلْقِی سَوْطَہُ ، ثُمَّ یُصَلِّی إلَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2881","","","كتاب الصلوات"
"2882","(۲۸۸۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جِئْتُ أَنَا وَالْفَضْلُ عَلَی أَتَانٍ ، وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی بِالنَّاسِ ، فَمَرَرْنَا عَلَی بَعْضِ الصَّفِّ ، فَنَزَلْنَا وَتَرَکْنَاہَا تَرْتَعُ ، فَلَمْ یَقُلْ لَنَا شَیْئًا۔ (مسلم ۳۶۲۔ ابوداؤد ۷۱۵)","Sahih","Musannaf Ibn Abi Shaybah 2882","","","كتاب الصلوات"
"2883","(۲۸۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی فَضَائٍ لَیْسَ بَیْنَ یَدَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 2883","","","كتاب الصلوات"
"2884","(۲۸۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الرَّجُلِ یُصَلِّی فِی الْفَضَائِ لَیْسَ بَیْنَ یَدَیْہِ شَیْئٌ؟ قَالَ: لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2884","","","كتاب الصلوات"
"2885","(۲۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : رَأَیْتُ ابن مُغَفَّل یُصَلِّی وَبَیْنَہُ وَبَیْنَ الْقِبْلَۃِ فَجْوَۃٌ۔","","Musannaf Ibn Abi Shaybah 2885","","","كتاب الصلوات"
"2886","(۲۸۸۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ وَسَالِمًا یُصَلِّیَانِ فِی السَّفَرِ فِی الصَّحْرَائِ إلَی غَیْرِ سُتْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 2886","","","كتاب الصلوات"
"2887","(۲۸۸۷) عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی یُصَلِّی إلَی غَیْرِ سُتْرَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2887","","","كتاب الصلوات"
"2888","(۲۸۸۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ وَعَامِرًا یُصَلِّیَانِ إلَی غَیْرِ أُسْطُوَانَۃٍ۔","","Musannaf Ibn Abi Shaybah 2888","","","كتاب الصلوات"
"2889","(۲۸۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، قَالَ : رَأَیْتُ الْحَسَنَ یُصَلِّی فِی الْجَبَّانَۃِ ، إلَی غَیْرِ سُتْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 2889","","","كتاب الصلوات"
"2890","(۲۸۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ الْحَنَفِیَّۃِ یُصَلِّی فِی مَسْجِدِ مِنًی وَالنَّاسُ یُصَلُّونَ بَیْنَ یَدَیْہِ ، فَجَائَ فَتًی مِنْ أَہْلِہِ فَجَلَسَ بَیْنَ یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 2890","","","كتاب الصلوات"
"2891","(۲۸۹۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ صَفْوَانَ بْنِ سُلَیْمٍ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ، عَنْ سَہْلِ بْنِ أَبِی حَثْمۃَ ، یَبْلُغُ بِہِ ، قَالَ : إذَا صَلَّی أَحَدُکُمْ إلَی سُتْرَۃٍ فَلْیَدْنُ مِنْہَا ، لاَ یَقْطَعُ الشَّیْطَانُ عَلَیْہِ صَلاَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2891","","","كتاب الصلوات"
"2892","(۲۸۹۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا صَلَّی أَحَدُکُمْ فَلْیُصَلِّ إلَی سُتْرَۃٍ وَلْیَدْنُ مِنْہَا ، وَلاَ یَدَعْ أَحَدًا یَمُرُّ بَیْنَہُ وَبَیْنَہَا ، فَإِنْ جَائَ أَحَدٌ یَمُرُّ فَلْیُقَاتِلْہُ ، فَإِنَّہُ شَیْطَانٌ۔n(ابوداؤد ۶۹۸۔ ابن حبان ۲۳۷۵)","Hasan","Musannaf Ibn Abi Shaybah 2892","","","كتاب الصلوات"
"2893","(۲۸۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الْمُغِیرَۃِ ، عَنْ أَبِی عُبَیْدَۃَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : لاَ تُصَلِّیَنَّ وَبَیْنَکَ وَبَیْنَ الْقِبْلَۃِ فَجْوَۃٌ ، تَقَدَّمْ إلَی الْقِبْلَۃِ ، أَوِ اسْتَتِرْ بِسَارِیَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 2893","","","كتاب الصلوات"
"2894","(۲۸۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مُسْلِمِ بْنِ أَبِی مَرْیَمَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا صَلَّی أَحَدُکُمْ فَلْیُصَلِّ إلَی سُتْرَۃٍ ، وَلْیَدْنُ مِنْہَا ، کَیْ لاَ یَمُرَّ الشَّیْطَانُ أَمَامَہُ۔","","Musannaf Ibn Abi Shaybah 2894","","","كتاب الصلوات"
"2895","(۲۸۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا لَمْ یَجِدْ سَبِیلاً إلَی سَارِیَۃٍ مِنْ سَوَارِی الْمَسْجِدِ ، قَالَ لِی : وَلِّنِی ظَہْرَک۔","Sahih","Musannaf Ibn Abi Shaybah 2895","","","كتاب الصلوات"
"2896","(۲۸۹۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ سَلْمٍ ، عَنْ قَتَادَۃَ ، قَالَ یَسْتُرُ الرَّجُلُ الرَّجُلَ إذَا کَانَ جَالِسًا وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 2896","","","كتاب الصلوات"
"2897","(۲۸۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الرَّجُلُ یَسْتُرُ الْمُصَلِّیَ فِی الصَّلاَۃِ ، وَقَالَ ابْنُ سِیرِینَ : لاَ یَسْتُرُ الرَّجُلُ الْمُصَلِّی۔","","Musannaf Ibn Abi Shaybah 2897","","","كتاب الصلوات"
"2898","(۲۸۹۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یُقْعِدُ رَجُلاً ، فَیُصَلِّی خَلْفَہُ وَالنَّاسُ یَمُرُّونَ بَیْنَ یَدَیْ ذَلِکَ الرَّجُلِ۔","Sahih","Musannaf Ibn Abi Shaybah 2898","","","كتاب الصلوات"
"2899","(۲۸۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا حَمَّادٌ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ أَیَسْتُرُ النَّائِمُ ؟ قَالَ : لاَ ، قُلْتُ : فَالْقَاعِدُ ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2899","","","كتاب الصلوات"
"2900","(۲۹۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ أَبِی الْوَدَّاکِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ ، وَادْرَؤُوا مَا اسْتَطَعْتُمْ ، فَإِنَّہُ شَیْطَانٌ۔ (ابوداؤد ۷۱۹۔ دارقطنی ۳۶۸)","Da'if","Musannaf Ibn Abi Shaybah 2900","","","كتاب الصلوات"
"2901",") حَدَّثَنَا عَبْدَۃُ ووَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، عَنْ عَلِیٍّ وَعُثْمَانَ قَالاَ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ ، وَادْرَؤُوہُمْ عَنْکُمْ مَا اسْتَطَعْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 2901","","","كتاب الصلوات"
"2902","(۲۹۰۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ؛ أَنَّ ابْنَ عُمَرَ قِیلَ لَہُ : إنَّ عَبْدَ اللہِ بْنَ عَیَّاشٍ بْنِ أَبِی رَبِیعَۃَ یَقُولُ : یَقْطَعُ الصَّلاَۃَ الْحِمَارُ وَالْکَلْبُ ، فَقَالَ : لاَ یَقْطَعُ صَلاَۃَ الْمُسْلِمِ شَیْئٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2902","","","كتاب الصلوات"
"2903","(۲۹۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ قَالَ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ ، وَذُبُّوا عَنْ أَنْفُسِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 2903","","","كتاب الصلوات"
"2904","(۲۹۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جِئْت أَنَا وَالْفَضْلُ عَلَی أَتَانٍ وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی بِالنَّاسِ بِعَرَفَۃَ ، فَمَرَرْنَا عَلَی بَعْضِ الصَّفِّ فَنَزَلْنَا وَتَرَکْنَاہَا تَرْتَعُ ، فَلَمْ یَقُلْ لَنَا شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 2904","","","كتاب الصلوات"
"2905","(۲۹۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِالْکَرِیمِ، قَالَ: سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ؟ فَقَالَ: لاَ یَقْطَعُ الصَّلاَۃَ إِلاَّ الْحَدَثَ۔","","Musannaf Ibn Abi Shaybah 2905","","","كتاب الصلوات"
"2906","(۲۹۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ الزِّبْرِقَانِ ، عَنْ کَعْبِ بْنِ عَبْدِ اللہِ ، عَنْ حُذَیْفَۃَ ، قَالَ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ ، وَادْرَأ مَا اسْتَطَعْتَ۔","Majhul","Musannaf Ibn Abi Shaybah 2906","","","كتاب الصلوات"
"2907","(۲۹۰۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ خَیْثَمَۃَ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ إِلاَّ الْکَلْبُ الأَسْوَدُ۔","Sahih","Musannaf Ibn Abi Shaybah 2907","","","كتاب الصلوات"
"2908","(۲۹۰۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یَقُولُ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ إِلاَّ الْکُفْرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2908","","","كتاب الصلوات"
"2909","(۲۹۰۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ ، اللَّہُ أَقْرَبُ کُلِّ شَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2909","","","كتاب الصلوات"
"2910","(۲۹۱۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی مِنَ اللَّیْلِ وَأَنَا مُعْتَرِضَۃٌ بَیْنَہُ وَبَیْنَ الْقِبْلَۃِ ، کَاعْتِرَاضِ الْجِنَازَۃِ۔ (مسلم ۲۶۷۔ ابن ماجہ ۹۵۶)","Sahih","Musannaf Ibn Abi Shaybah 2910","","","كتاب الصلوات"
"2911","(۲۹۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : اعْزِلُوا صَلاَتَکُمْ مَا اسْتَطَعْتُمْ ، وَأَشَدُّ مَا یَتَّقِی عَلَیْہَا مَرَابِضُ الْکِلاَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 2911","","","كتاب الصلوات"
"2912","(۲۹۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَقْطَعُ الصَّلاَۃَ شَیْئٌ وَلَکِنِ ادْرَؤُوا عَنْہَا مَا اسْتَطَعْتُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2912","","","كتاب الصلوات"
"2913","(۲۹۱۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا لَمْ یَکُنْ بَیْنَ یَدَیْہِ مِثْلَ آخِرَۃِ الرَّحْلِ ، فَإِنَّہُ یَقْطَعُ صَلاَتَہُ : الْمَرْأَۃُ وَالْحِمَارُ وَالْکَلْبُ الأَسْوَدُ ، قَالَ : قُلْتُ : یَا أَبَا ذَرٍّ ، فمَا بَالُ الْکَلْبِ الأَسْوَدِ مِنَ الْکَلْبِ الأَحْمَرِ مِنَ الْکَلْبِ الأَصْفَرِ ؟ فَقَالَ : یَا ابْنَ أَخِی ، إنِّی سَأَلْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَمَا سَأَلْتنِی ، فَقَالَ : الْکَلْبُ الأَسْوَدُ شَیْطَانٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2913","","","كتاب الصلوات"
"2914","(۲۹۱۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْکَلْبُ الأَسْوَدُ الْبَہِیمُ شَیْطَانٌ ، وَہُوَ یَقْطَعُ الصَّلاَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2914","","","كتاب الصلوات"
"2915","(۲۹۱۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ مُعَاذٍ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 2915","","","كتاب الصلوات"
"2916","(۲۹۱۶) حَدَّثَنَا أَبُو دَاوُدَ ، وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ : یَقْطَعُ الصَّلاَۃَ الْمَرْأَۃُ وَالْحِمَارُ وَالْکَلْبُ۔","Sahih","Musannaf Ibn Abi Shaybah 2916","","","كتاب الصلوات"
"2917","(۲۹۱۷) حَدَّثَنَا أَبُو دَاوُدَ ، وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ أَبِی الأَحْوَصِ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2917","","","كتاب الصلوات"
"2918","(۲۹۱۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : یَقْطَعُ صَلاَۃَ الرَّجُلِ الْمَرْأَۃُ وَالْحِمَارُ وَالْکَلْبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2918","","","كتاب الصلوات"
"2919","(۲۹۱۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمٍ ، عَنْ قَتَادَۃَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : یَقْطَعُ الصَّلاَۃَ الْکَلْبُ الأَسْوَدُ، وَالْمَرْأَۃُ الْحَائِضُ۔ (نسائی ۸۲۷)","","Musannaf Ibn Abi Shaybah 2919","","","كتاب الصلوات"
"2920","(۲۹۲۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمٍ ، عَنِ الْحَسَنِ ، قَالَ : یَقْطَعُ الصَّلاَۃَ الْکَلْبُ ، وَالْمَرْأَۃُ ، وَالْحِمَارُ۔","","Musannaf Ibn Abi Shaybah 2920","","","كتاب الصلوات"
"2921","(۲۹۲۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی ، عَنْ عِکْرِمَۃَ ، قَالَ : یَقْطَعُ الصَّلاَۃَ الْکَلْبُ ، وَالْمَرْأَۃُ ، وَالْخِنْزِیرُ ، وَالْحِمَارُ ، وَالْیَہُودِیُّ ، وَالنَّصْرَانِیُّ ، وَالْمَجُوسِیُّ۔ (ابوداؤد ۷۰۴)","","Musannaf Ibn Abi Shaybah 2921","","","كتاب الصلوات"
"2922","(۲۹۲۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : یَقْطَعُ الصَّلاَۃَ الْکَلْبُ ، قِیلَ لَہُ : فَالْمَرْأَۃُ؟ قَالَ : لاَ ، إنَّمَا ہُنَّ شَقَائِقُکُمْ ، أَخَوَاتُکُمْ وَأُمَّہَاتُکُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2922","","","كتاب الصلوات"
"2923","(۲۹۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ بَکْرٍ ؛ أَنَّ ابْنَ عُمَرَ أَعَادَ رَکْعَۃً مِنْ جِرْوٍ مَرَّ بَیْنَ یَدَیْہِ فِی الصَّلاَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 2923","","","كتاب الصلوات"
"2924","(۲۹۲۴) حَدَّثَنَا شَبَابَۃُ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : لاَ یَقْطَعُ الصَّلاَۃَ إِلاَّ الْکَلْبُ الأَسْوَدُ ، وَالْمَرْأَۃُ الْحَائِضُ۔","Hasan","Musannaf Ibn Abi Shaybah 2924","","","كتاب الصلوات"
"2925","(۲۹۲۵) مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ إذَا مَرَّ أَحَدٌ بَیْنَ یَدَیْہِ وَہُوَ یُصَلِّی الْتَزَمَہُ حَتَّی یَرُدَّہُ ، وَیَقُولُ : إِنَّہُ لَیَقْطَعُ نِصْفَ صَلاَۃِ الْمَرْئِ مُرُورُ الْمَرْئِ بَیْنَ یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 2925","","","كتاب الصلوات"
"2926","(۲۹۲۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، وَابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنْ مَرَّ بَیْنَ یَدَیْک فَلاَ تَرُدَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2926","","","كتاب الصلوات"
"2927","(۲۹۲۷) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ أَبِی النَّضْرِ ، عَنْ بُسْر بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ أَبِی جُہَیمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ یَعْلَمُ أَحَدُکُمْ مَا لَہُ فِی الْمَمَرِّ بَیْنَ یَدَیْ أَخِیہِ وَہُوَ یُصَلِّی ۔ یعنی : مِنَ الإِثْمِ ، لَوَقَفَ أَرْبَعِینَ۔ (بخاری ۵۱۰۔ ابوداؤد ۷۰۱)","Sahih","Musannaf Ibn Abi Shaybah 2927","","","كتاب الصلوات"
"2928","(۲۹۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ عَبْدَ الْحَمِیدِ بْنَ عَبْدِ الرَّحْمَنِ عَامِلَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، وَمَرَّ رَجُلٌ بَیْنَ یَدَیْہِ وَہُوَ یُصَلِّی ، فَجَبَذَہُ حَتَّی کَادَ یَخْرِقَ ثِیَابَہُ ، فَلَمَّا انْصَرَفَ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ یَعْلَمُ الْمَارُّ بَیْنَ یَدَیِ الْمُصَلِّی ، لَأَحَبَّ أَنْ یَنْکَسِرَ فَخْذُہُ ، وَلاَ یَمُرُّ بَیْنَ یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 2928","","","كتاب الصلوات"
"2929","(۲۹۲۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، قَالَ : رَأَی أَبِی نَاسًا یَمُرُّ بَعْضُہُمْ بَیْنَ یَدَیْ بَعْضٍ فِی الصَّلاَۃِ ، فَقَالَ : تَرَی أَبْنَائَ ہَؤُلاَئِ إذَا أَدْرَکُوا یَقُولُونَ : إنَّا وَجَدْنَا آبَائَنَا کَذَلِکَ یَفْعَلُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 2929","","","كتاب الصلوات"
"2930","(۲۹۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، حَدَّثَنَا عَاصِمٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ أَبُو سَعِیدٍ الْخُدْرِیُّ قَائِمًا یُصَلِّی ، فَجَائَ عَبْدُ الرَّحْمَنِ بْنُ الْحَارِثِ بْنِ ہِشَامٍ یَمُرُّ بَیْنَ یَدَیْہِ فَدفَعَہُ وَأَبَی إِلاَّ أَنْ یَمْضِیَ ، فَدَفَعَہُ أَبُو سَعِیدٍ فَطَرَحَہُ ، فَقِیلَ لَہُ: تَصْنَعُ ہَذَا بِعَبْدِ الرَّحْمَنِ ؟ فَقَالَ : وَاللَّہِ لَوْ أَبَی إِلاَّ أَنْ آخُذَہُ بِشَعْرِہِ ،لأَخَذْتُ۔","Sahih","Musannaf Ibn Abi Shaybah 2930","","","كتاب الصلوات"
"2931","(۲۹۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ جَائَ أَحَدٌ یَمُرُّ بَیْنَ یَدَیْہِ فَلْیُقَاتِلْہُ ، فَإِنَّمَا ہُوَ شَیْطَانٌ۔","Hasan","Musannaf Ibn Abi Shaybah 2931","","","كتاب الصلوات"
"2932","(۲۹۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنِ اسْتَطَاعَ مِنْکُمْ أَنْ لاَ یَمُرَّ بَیْنَ یَدَیْہِ وَہُوَ یُصَلِّی فَلْیَفْعَلْ ، فَإِنَّ الْمَارَّ بَیْنَ یَدَیِ الْمُصَلِّی أَنْقَصُ مِنَ الْمُمَرِّ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2932","","","كتاب الصلوات"
"2933","(۲۹۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : أَدَعُ أَحَدًا یَمُرُّ بَیْنَ یَدَیَّ ؟ قَالَ : لاَ ، قُلْتُ: فَإِنْ أَبَی ، قَالَ : فَمَا تَصْنَعُ ؟ قُلْتُ : بَلَغَنِی أَنَّ ابْنَ عُمَرَ کَانَ لاَ یَدَعُ أَحَدًا یَمُرُّ بَیْنَ یَدَیْہِ ، قَالَ : إِنْ ذَہَبْتَ تَصْنَعُ صَنِیعَ ابْنِ عُمَرَ دُقَّ أَنْفُکَ۔","","Musannaf Ibn Abi Shaybah 2933","","","كتاب الصلوات"
"2934","(۲۹۳۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی فَجَعَلَ جَدْیٌ یُرِیدُ أَنْ یَمُرَّ بَیْنَ یَدَیِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَجَعَلَ یَتَقَدَّمُ حَتَّی نَزَا الْجَدْیُ۔ (ابوداؤد ۷۰۹۔ احمد ۱/۲۹۱)","Sahih","Musannaf Ibn Abi Shaybah 2934","","","كتاب الصلوات"
"2935","(۲۹۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی فَمَرَّ بَیْنَ یَدَیْہِ عَبْدُ اللہِ ، أَوْ عُمَرُ بْنُ أَبِی سَلَمَۃَ ، فَقَالَ : بِیَدِہِ ، فَرَجَعَ ، فَمَرَّتْ زَیْنَبُ ابْنَۃُ أُمِّ سَلَمَۃَ ، فَقَالَ : بِیَدِہِ ہَکَذَا ، فَمَضَتْ ، فَلَمَّا صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ہُنَّ أَغْلَبُ۔ (احمد ۶/۲۹۴)","Majhul","Musannaf Ibn Abi Shaybah 2935","","","كتاب الصلوات"
"2936","(۲۹۳۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ سُلَیْمَانُ بْنِ حَیَّانَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : بَادَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِہِرٍّ ، أَوْ ہِرَّۃٍ أَنْ تَمُرَّ بَیْنَ یَدَیْہِ۔ (طبرانی ۴۹۶۵)","","Musannaf Ibn Abi Shaybah 2936","","","كتاب الصلوات"
"2937","(۲۹۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عَبْدِ الْعَزِیزِ التَّنُوخِیُّ ، عَنْ مَوْلًی لِیَزِیدَ بْنِ نِمْرَانَ ، عَنْ یَزِیدَ بْنِ نِمْرَانَ ، قَالَ : رَأَیْتُ رَجُلاً مُقْعَدًا ، فَقَالَ : مَرَرْتُ بَیْنَ یَدَیِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا عَلَی حِمَارٍ وَہُوَ یُصَلِّی ، فَقَالَ : اللَّہُمَّ اقْطَعْ أَثَرَہُ ، فَمَا مَشَیْتُ عَلَیْہَا۔ (ابوداؤد ۷۰۶۔ احمد ۴/۳۷۷)","Majhul","Musannaf Ibn Abi Shaybah 2937","","","كتاب الصلوات"
"2938","(۲۹۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ فِطْرٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : مَرَرْت بَیْنَ یَدَیِ ابْنِ عُمَرَ وَہُوَ فِی الصَّلاَۃِ ، فَارْتَفَعَ مِنْ قُعُودِہِ ، ثُمَّ دَفَعَ فِی صَدْرِی۔","Hasan","Musannaf Ibn Abi Shaybah 2938","","","كتاب الصلوات"
"2939","(۲۹۳۹) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ بَیَانٍ ، عَنْ وَبَرَۃَ ، قَالَ : مَا رَأَیْت أَحَدًا أَشَدَّ عَلَیْہِ أَنْ یُمَرَّ بَیْنَ یَدَیْہِ فِی صَلاَۃٍ مِنْ إبْرَاہِیمَ النَّخَعِیِّ ، وَعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ۔","","Musannaf Ibn Abi Shaybah 2939","","","كتاب الصلوات"
"2940","(۲۹۴۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنْ وَائِلِ بْنِ حُجْرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَلَسَ ، فَثَنَی الْیُسْرَی وَنَصَبَ الْیُمْنَی ، یَعْنِی فِی الصَّلاَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 2940","","","كتاب الصلوات"
"2941","(۲۹۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَجَدَ فَرَفَعَ رَأْسَہُ لَمْ یَسْجُدْ حَتَّی یَسْتَوِیَ جَالِسًا ، وَکَانَ یَفْرِشُ رِجْلَہُ الْیُسْرَی، وَیَنْصِبُ رِجْلَہُ الْیُمْنَی۔","Sahih","Musannaf Ibn Abi Shaybah 2941","","","كتاب الصلوات"
"2942","(۲۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا جَلَسَ فِی الصَّلاَۃِ افْتَرَشَ رِجْلَہُ الْیُسْرَی حَتَّی اسْوَدَّ ظَہْرُ قَدَمَیْہِ۔ (ابوداؤد ۴۵۔ عبدالرزاق ۳۰۳۷)","","Musannaf Ibn Abi Shaybah 2942","","","كتاب الصلوات"
"2943","(۲۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَفْتَرِشُ الْیُسْرَی ، وَیَنْصِبُ الْیُمْنَی۔","","Musannaf Ibn Abi Shaybah 2943","","","كتاب الصلوات"
"2944","(۲۹۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَأَبُو أُسَامَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ قَالَ : إنَّ مِنْ سُنَّۃِ الصَّلاَۃِ أَنْ تَفترِشَ الْیُسْرَی ، وَأَنْ تَنْصِبَ الْیُمْنَی۔ (بخاری ۸۲۷۔ ابوداؤد ۴۵)","Sahih","Musannaf Ibn Abi Shaybah 2944","","","كتاب الصلوات"
"2945","(۲۹۴۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ کَعْبٍ ، قَالَ : إذَا قَعَدْتَ فَافْترِشْ رِجْلَک الْیُسْرَی ، فَإِنَّہُ أَقْوَمُ لِصَلاَتِکَ وَلِصُلْبِک۔","","Musannaf Ibn Abi Shaybah 2945","","","كتاب الصلوات"
"2946","(۲۹۴۶) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَنْصِبُ الْیُمْنَی ، وَیَفْترِشُ الْیُسْرَی۔","Da'if","Musannaf Ibn Abi Shaybah 2946","","","كتاب الصلوات"
"2947","(۲۹۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ رُبَّمَا أَضْجَعَ رِجْلَیْہِ جَمِیعًا ، وَرُبَّمَا أَضْجَعَ الْیُمْنَی وَنَصَبَ الْیُسْرَی ۔ وَکَانَ مُحَمَّدٌ إذَا جَلَسَ نَصَبَ الْیُمْنَی وَأَضْجَعَ الْیُسْرَی۔","","Musannaf Ibn Abi Shaybah 2947","","","كتاب الصلوات"
"2948","(۲۹۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، عَنْ إبْرَاہِیمَ ؛ مِثْلُ قَوْلِ مُحَمَّدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2948","","","كتاب الصلوات"
"2949","(۲۹۴۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَانِی خَلِیلِی أَنْ أُقْعِیَ کَإِقْعَائِ الْقِرْدِ۔ (بخاری ۱۹۸۱۔ مسلم ۸۵)","Da'if","Musannaf Ibn Abi Shaybah 2949","","","كتاب الصلوات"
"2950","(۲۹۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الإِقْعَائَ فِی الصَّلاَۃِ ، وَقَالَ : عُقْبَۃُ الشَّیْطَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 2950","","","كتاب الصلوات"
"2951","(۲۹۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ الإِقْعَائَ فِی الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 2951","","","كتاب الصلوات"
"2952","(۲۹۵۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ سَعِیدٍ الْمَقْبُرِیِّ ، قَالَ : صَلَّیْت إلَی جَنْبِ أَبِی ہُرَیْرَۃَ ، فَانْتَصَبْتُ عَلَی صُدُورِ قَدَمِی ، فَجَذَبَنِی حَتَّی اطْمَأْنَنْت۔","Hasan","Musannaf Ibn Abi Shaybah 2952","","","كتاب الصلوات"
"2953","(۲۹۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ الإِقْعَائَ ، وَالتَّوَرُّکَ۔","","Musannaf Ibn Abi Shaybah 2953","","","كتاب الصلوات"
"2954","(۲۹۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ؛ کَرِہَا الإِقْعَائَ فِی الصَّلاَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2954","","","كتاب الصلوات"
"2955","(۲۹۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ أَنَّہُ کَرِہَ الإِقْعَائَ بَیْنَ السَّجْدَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2955","","","كتاب الصلوات"
"2956","(۲۹۵۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْ عُقْبَۃِ الشَّیْطَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 2956","","","كتاب الصلوات"
"2957","(۲۹۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مِنَ السُّنَّۃِ أَنْ تَضَعَ أَلْیَتَیْک عَلَی عَقِبَیْک فِی الصَّلاَۃِ۔ (ترمذی ۲۸۳۔ ابوداؤد ۸۴۱)","Da'if","Musannaf Ibn Abi Shaybah 2957","","","كتاب الصلوات"
"2958","(۲۹۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، عَنْ جَابِرٍ، وَأَبِی سَعِیدٍ؛ أَنَّہُمَا کَانَا یُقْعِیَانِ بَیْنَ السَّجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 2958","","","كتاب الصلوات"
"2959","(۲۹۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ یُقْعِی بَیْنَ السَّجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 2959","","","كتاب الصلوات"
"2960","(۲۹۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَطِیَّۃَ ، قَالَ : رَأَیْتُ الْعَبَادَلَۃَ یُقْعُونَ فِی الصَّلاَۃِ بَیْنَ السَّجْدَتَیْنِ ، یَعْنِی عَبْدَ اللہِ بْنَ الزُّبَیْرِ ، وَابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 2960","","","كتاب الصلوات"
"2961","(۲۹۶۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ عَطِیَّۃَ یُقْعِی بَیْنَ السَّجْدَتَیْنِ ، فَقُلْتُ لَہُ ، فَقَالَ : رَأَیْت ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ ، وَابْنَ الزُّبَیْرِ ، یُقْعُونَ بَیْنَ السَّجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 2961","","","كتاب الصلوات"
"2962","(۲۹۶۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ سُقَیفِ بْنِ بِشْرٍ الْعِجْلِیّ ، قَالَ : رَأَیْتُ طَاوُوسًا یُقْعِی بَیْنَ أَرْبَعِ رَکَعَاتٍ حِینَ یَجْلِسُ۔","","Musannaf Ibn Abi Shaybah 2962","","","كتاب الصلوات"
"2963","(۲۹۶۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُوسَی الطَّحَّانِ ، قَالَ : رَأَیْتُ مُجَاہِدًا یُقْعِی بَیْنَ السَّجْدَتَیْنِ۔۔","No Data Available","Musannaf Ibn Abi Shaybah 2963","","","كتاب الصلوات"
"2964","(۲۹۶۴) حَدَّثَنَا عُبَیْدُ اللہِ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ؛ أَنَّہُ کَانَ یَجْلِسُ عَلَی عَقِبَیْہِ بَیْنَ السَّجْدَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2964","","","كتاب الصلوات"
"2965","(۲۹۶۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا جَلَسَ ثَنَی قَدَمَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2965","","","كتاب الصلوات"
"2966","(۲۹۶۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّہُ کَانَ یُصَلِّی وَالْمَرْأَۃُ تَمُرُّ بِہِ یَمِینًا وَشِمَالاً ، فَلاَ یَرَی بِذَلِکَ بَأْسًا ، قَالَ : وَکَانَ ابْنُ سِیرِینَ إذَا قَامَتْ بِحِذَائِہِ ، سَبَّحَ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 2966","","","كتاب الصلوات"
"2967","(۲۹۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخبرنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَمُرَّ الْمَرْأَۃُ ، عَلی یَمِینِ الرَّجُلِ ، وَعَنْ یَسَارِہِ ، وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 2967","","","كتاب الصلوات"
"2968","(۲۹۶۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنْہُ ؟ فَلَمْ یَرَ بِہِ بَأْسًا ، قَالَ: وَحَدَّثَنِی مَنْ سَأَلَ إبْرَاہِیمَ، فَکَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2968","","","كتاب الصلوات"
"2969","(۲۹۶۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : حدَّثَتْنِی مَیْمُونَۃُ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی وَأَنَا بِحِذَائِہِ ، فَرُبَّمَا أَصَابَنِی ثَوْبُہُ إذَا سَجَدَ ،وَکَانَ یُصَلِّی عَلَی الْخُمْرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 2969","","","كتاب الصلوات"
"2970","(۲۹۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : حدَّثَنِی مُصْعَبُ بْنُ سَعْدٍ ، قَالَ : کَانَ حِذَائَ قِبْلَۃِ سَعْدٍ تَابُوتٌ ، وَکَانَتِ الْخَادِمُ تَجِیئُ فَتَأْخُذُ حَاجَتَہَا عَنْ یَمِینِہِ ، وَعَنْ شِمَالِہِ لاَ تَقْطَعُ صَلاَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 2970","","","كتاب الصلوات"
"2971","(۲۹۷۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الْمَرْأَۃِ تَمُرُّ بِجَنْبِ الرَّجُلِ وَہُوَ یُصَلِّی ؟ فَقَالَ : لاَ بَأْسَ إِلاَّ أَنْ تَعِنَّ بَیْنَ یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 2971","","","كتاب الصلوات"
"2972","(۲۹۷۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یُکْرَہُ أَنْ تُصَلِّیَ الْمَرْأَۃُ بِحِذَائِ الرَّجُلِ إذَا کَانَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 2972","","","كتاب الصلوات"
"2973","(۲۹۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی مَعْمَرٍ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُجْزِیء صَلاَۃٌ لاَ یُقِیمُ الرَّجُلُ فِیہَا صُلْبَہُ فِی الرُّکُوعِ وَالسُّجُودِ۔ n(ابوداؤد ۵۸۱۔ احمد ۴/۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 2973","","","كتاب الصلوات"
"2974","(۲۹۷۴) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرِو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، قَالَ : حدَّثَنِی عَبْدُ الرَّحْمَنِ بْنُ عَلِیِّ بْنِ شَیْبَانَ ، عَنْ أَبِیہِ عَلِیِّ بْنِ شَیْبَانَ ، وَکَانَ مِنَ الْوَفْدِ ، قَالَ : خَرَجْنَا حَتَّی قَدِمْنَا عَلَی نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَبَایَعْنَاہُ ، وَصَلَّیْنَا مَعَہُ ، فَلَمَحَ بِمُؤْخَرِ عَیْنِہِ إلَی رَجُلٍ لاَ یُقِیمُ صُلْبَہُ فِی الرُّکُوعِ وَالسُّجُودِ ، فَلَمَّا قَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الصَّلاَۃَ ، قَالَ : یَا مَعْشَرَ الْمُسْلِمِینَ ، لاَ صَلاَۃَ لمن لاَ یُقِیمُ صُلْبَہُ فِی الرُّکُوعِ وَالسُّجُودِ۔n(احمد ۴/۲۳۔ ابن حبان ۲۲۰۲)","Sahih","Musannaf Ibn Abi Shaybah 2974","","","كتاب الصلوات"
"2975","(۲۹۷۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عَلِیِّ بْنِ یَحْیَی بْنِ خَلاَّدٍ ، عَنْ أَبِیہِ ، عَنْ عَمِّہِ ، وَکَانَ بَدْرِیًّا ، قَالَ : کُنَّا جُلُوسًا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَدَخَلَ رَجُلٌ فَصَلَّی صَلاَۃً خَفِیفَۃً لاَ یُتِمُّ رُکُوعًا ، وَلاَ سُجُودًا ، وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْمُقُہُ وَنَحْنُ لاَ نَشْعُرُ ، قَالَ : فَصَلَّی ، ثُمَّ جَائَ فَسَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَرَدَّ عَلَیْہِ فَقَالَ : أَعِدْ فَإِنَّک لَمْ تُصَلِّ ، قَالَ : فَفَعَلَ ذَلِکَ ، ثَلاَثًا ، کُلَّ ذَلِکَ یَقُولُ لَہُ : أَعِدْ فَإِنَّک لَمْ تُصَلِّ ، فَلَمَّا کَانَ فِی الرَّابِعَۃِ ، قَالَ : یَا رَسُولَ اللہِ ، عَلِّمْنِی ، فَقَدْ وَاللَّہِ اجْتَہَدْتُ ، فَقَالَ : إذَا قُمْتَ إلَی الصَّلاَۃِ فَاسْتَقْبِلِ الْقِبْلَۃَ ، ثُمَّ کَبِّرْ ، ثُمَّ اقْرَأْ ، ثُمَّ ارْکَعْ ، حَتَّی تَطْمَئِنَّ رَاکِعًا ، ثُمَّ ارْفَعْ حَتَّی تَطْمَئِنَّ قَائِمًا ، ثُمَّ اسْجُدْ حَتَّی تَطْمَئِنَّ ساجدًا ، ثُمَّ اجْلِسْ حَتَّی تَطْمَئِنَّ جَالِسًا ، ثُمَّ قُمْ ، فَإِذَا فَعَلْتَ ذَلِکَ فَقَدْ تَمَّتْ صَلاَتُک ، وَمَا نَقَصْتَ مِنْ ذَلِکَ ، نَقَصْتَ مِنْ صَلاَتِک۔n(ابوداؤد ۸۵۶۔ احمد ۴/۳۴۰)","Hasan","Musannaf Ibn Abi Shaybah 2975","","","كتاب الصلوات"
"2976","(۲۹۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَجُلاً دَخَلَ الْمَسْجِدَ فَصَلَّی ، وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَاحِیَۃِ الْمَسْجِدِ ،فَجَائَ فَسَلَّمَ عَلَیْہِ ، وَقَالَ لَہُ : وَعَلَیْک ، ارْجِعْ فَصَلِّ فَإِنَّک لَمْ تُصَلِّ بَعْدُ ، فَرَجَعَ ، فَسَلَّمَ عَلَیْہِ ، فَقَالَ : ارْجِعْ فَإِنَّک لَمْ تُصَلِّ بَعْدُ ، فَقَالَ لَہُ الرَّجُلُ فِی الثَّالِثَۃِ : فَعَلِّمْنِی یَا رَسُولَ اللہِ ، قَالَ : إذَا قُمْتَ إلَی الصَّلاَۃِ فَأسْبِغِ الْوُضُوئَ ، ثُمَّ اسْتَقْبِلِ الْقِبْلَۃَ فَکَبِّرْ، ثُمَّ اقْرَأْ بِمَا تَیَسَّرَ مَعَک مِنَ الْقُرْآنِ ، ثُمَّ ارْکَعْ حَتَّی تَطْمَئِنَّ رَاکِعًا ، ثُمَّ ارْفَعْ حَتَّی تَعْتَدِلَ قَائِمًا، ثُمَّ اسْجُدْ حَتَّی تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّی تَسْتَوِیَ قَائِمًا ، أَو قَالَ : قَاعِدًا ، ثُمَّ افْعَلْ ذَلِکَ فِی صَلاَتِکَ کُلِّہَا۔ (بخاری ۶۶۶۷۔ مسلم ۲۹۸)","Sahih","Musannaf Ibn Abi Shaybah 2976","","","كتاب الصلوات"
"2977","(۲۹۷۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ أَسْوَأَ النَّاسِ سَرِقَۃً الَّذِی یَسْرِقُ صَلاَتَہُ ، قَالُوا : یَا رَسُولَ اللہِ ، کَیْفَ یَسْرِقُہَا ؟ قَالَ : لاَ یُتِمُّ رُکُوعَہَا ، وَلاَ سُجُودَہَا۔ (احمد ۳/۵۶۔ ابویعلی ۱۳۰۶)","Da'if","Musannaf Ibn Abi Shaybah 2977","","","كتاب الصلوات"
"2978","(۲۹۷۸) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، عَنْ أَنَسٍ ، قَالَ : وَصَفَ لَنَا أَنَسٌ صَلاَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ قَامَ یُصَلِّی ، فَرَکَعَ فَرَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ ، فَاسْتَوَی قَائِمًا حَتَّی رَأَی بَعْضُنَا أَنَّہُ قَدْ نَسِیَ ، قَالَ : ثُمَّ سجد فَاسْتَوَی قَاعِداً حَتَّی رَأَی بَعْضُنَا أَنَّہُ قَدْ نَسِیَ۔n(بخاری ۸۲۱۔ مسلم ۱۹۵)","Sahih","Musannaf Ibn Abi Shaybah 2978","","","كتاب الصلوات"
"2979","(۲۹۷۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمٍ الْبَرَّادِ ، قَالَ : أَتَیْنَا أَبَا مَسْعُودٍ الأَنْصَارِیَّ فِی بَیْتِہِ فَقُلْنَا لَہُ : حَدِّثْنَا عَنْ صَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَامَ یُصَلِّی بَیْنَ أَیْدِینَا ، فَلَمَّا رَکَعَ وَضَعَ کَفَّیْہِ عَلَی رُکْبَتَیْہِ ، وَجَعَلَ أَصَابِعَہُ أَسْفَلَ مِنْ ذَلِکَ ، وَجَافَی بِمِرْفَقَیْہِ حَتَّی اسْتَوَی کُلُّ شَیْئٍ مِنْہُ ، ثُمَّ رَفَعَ رَأْسَہُ، ثُمَّ قَالَ : سَمِعَ اللَّہُ لِمَنْ حَمِدَہُ ، فَقَامَ حَتَّی اسْتَوَی کُلُّ شَیْئٍ مِنْہُ ، ثُمَّ سَجَدَ فَفَعَلَ مِثْلَ ذَلِکَ ، فَصَلَّی رَکْعَتَیْنِ، فَلَمَّا قَضَاہا قَالَ : ہَکَذَا رَأَیْنا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی۔","Da'if","Musannaf Ibn Abi Shaybah 2979","","","كتاب الصلوات"
"2980","(۲۹۸۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إنَّ الرَّجُلَ لَیُصَلِّی سِتِّینَ سَنَۃً مَا تُقْبَلُ لَہُ صَلاَۃٌ ، لَعَلَّہُ یُتِمُّ الرُّکُوعَ ، وَلاَ یُتِمُّ السُّجُودَ ، وَیُتِمُّ السُّجُودَ ، وَلاَ یُتِمُّ الرُّکُوعَ۔","Hasan","Musannaf Ibn Abi Shaybah 2980","","","كتاب الصلوات"
"2981","(۲۹۸۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ الأَنْصَارِیِّ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، قَالَ : رَأَیْتُ أَبَا حُمَیْدٍ السَّاعِدِیَّ مَعَ عَشَرَۃِ رَہْطٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقَالَ لَہُم : أَلاَ أُحَدِّثُکُمْ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالُوا : ہَاتِ ، قَالَ : رَأَیْتُہُ إذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ مَکَثَ قَائِمًا حَتَّی یَقَعَ کُلُّ عَظْمٍ مَوْضِعَہُ ، ثُمَّ یَنْحَطُّ سَاجِدًا وَیُکَبِّرُ۔","Sahih","Musannaf Ibn Abi Shaybah 2981","","","كتاب الصلوات"
"2982","(۲۹۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ بُدَیْلٍ ، عَنْ أَبِی الْجَوْزَائِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَکَعَ لَمْ یَشْخَصْ رَأْسَہُ ، وَلَمْ یُصَوِّبْہُ وَلَکِنْ بَیْنَ ذَلِکَ ، فَإِذَا رَفَعَ رَأْسَہُ مِنَ الرُّکُوعِ لَمْ یَسْجُدْ حَتَّی یَسْتَوِیَ قَائِمًا ، وَإِذَا سَجَدَ فَرَفَعَ رَأْسَہُ لَمْ یَسْجُدْ حَتَّی یَسْتَوِیَ جَالِسًا ، وَکَانَ یَقُولُ بَیْنَ کُلِّ رَکْعَتَیْنِ التَّحِیَّۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 2982","","","كتاب الصلوات"
"2983","(۲۹۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ حُذَیْفَۃَ ؛ أَنَّہُ دَخَلَ الْمَسْجِدَ فَإِذَا رَجُلٌ یُصَلِّی نَاحِیَۃً مِنْ أَبْوَابِ کِنْدَۃَ ، فَجَعَلَ لاَ یُتِمُّ الرُّکُوعَ وَالسُّجُودَ ، فَلَمَّا انْصَرَفَ ، قَالَ لَہُ حذَیْفَۃُ : مُذْ کَمْ ہَذِہِ صَلاَتُک ؟ قَالَ : مُذْ أَرْبَعِینَ سَنَۃً ، فَقَالَ حُذَیْفَۃُ : مَا صَلَّیْتَ مُذْ أَرْبَعِینَ سَنَۃً ، وَلَوْ مِتَّ وَہَذِہِ صَلاَتُک مِتَّ عَلَی غَیْرِ الْفِطْرَۃِ الَّتِی فُطِرَ عَلَیْہَا مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ أَقْبَلَ عَلَیْہِ یُعَلِّمُہُ ، فَقَالَ : إنَّ الرَّجُلَ لَیُخَفِّفُ الصَّلاَۃَ وَیُتِمُّ الرُّکُوعَ وَالسُّجُودَ۔ (بخاری ۸۹۱۔ احمد۵/۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 2983","","","كتاب الصلوات"
"2984","(۲۹۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخبرنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَسْوَأَ النَّاسِ سَرِقَۃً الَّذِی یَسْرِقُ صَلاَتَہُ ، قَالُوا : یَا رَسُولَ اللہِ ، وَکَیْفَ یَسْرِقُ صَلاَتَہُ ؟ قَالَ : لاَ یُتِمُّ رُکُوعَہَا ، وَلاَ سُجُودَہَا۔","","Musannaf Ibn Abi Shaybah 2984","","","كتاب الصلوات"
"2985","(۲۹۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی النَّضْرِ مُسْلِمٍ ، قَالَ : سَمِعْتُ حَمْلَۃَ بْنَ عَبْدِ الرَّحْمَنِ ، قَالَ : رَأَی عُبَادَۃُ رَجُلاً لاَ یُتِمُّ الرُّکُوعَ ، وَلاَ السُّجُودَ ، فَأَخَذَ بِیَدِہِ ، فَفَزِعَ الرَّجُلُ ، فَقَالَ عُبَادَۃُ : لاَ تَشَبَّہُوا بِہَذَا ، وَلاَ بِأَمْثَالِہِ ، إِنَّہُ لاَ تُجْزِیٔ صَلاَۃٌ إِلاَّ بِأُمِّ الْکِتَابِ۔","Majhul","Musannaf Ibn Abi Shaybah 2985","","","كتاب الصلوات"
"2986","(۲۹۸۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنِ الْقَاسِمِ بْنِ عَمْرٍو ، عَنْ أَبِی جَعْفَرٍ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً یَنْکُتُ بِرَأْسِہِ فِی سُجُودِہِ، فَقَالَ: لَوْ مَاتَ ہَذَا، وَہَذِہِ صَلاَتُہُ ، مَاتَ عَلَی غَیْرِ دِینِی۔ (بخاری ۲۶۹۰۔ ابن خزیمۃ ۶۶۵)","","Musannaf Ibn Abi Shaybah 2986","","","كتاب الصلوات"
"2987","(۲۹۸۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ رَأَی امْرَأَۃً تُصَلِّی وَہِیَ تَنْقُرُ، فَقَالَ : کَذَبْتِ۔","Hasan","Musannaf Ibn Abi Shaybah 2987","","","كتاب الصلوات"
"2988","(۲۹۸۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ قُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : رَأَی سَعِیدُ بْنُ الْمُسَیَّبِ رَجُلاً یُصَلِّی ، وَلاَ یُتِمُّ رُکُوعَہُ ، وَلاَ سُجُودَہُ ، فَحَصَبَہُ ، وَقَالَ : أَغْلَقْتَ صَلاَتَک۔","","Musannaf Ibn Abi Shaybah 2988","","","كتاب الصلوات"
"2989","(۲۹۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ الأَعْمَش یَقُولُ : رَأَیْت أَنَسَ بْنَ مَالِکٍ بِمَکَّۃَ قَائِمًا یُصَلِّی عِنْدَ الْکَعْبَۃِ ، فَمَا عَرَضْتُ لَہُ ، قَالَ : فَکَانَ قَائِمًا یُصَلِّی مُعْتَدِلاً فِی صَلاَتِہِ ، فَإِذَا رَفَعَ رَأْسَہُ انْتَصَبَ قَائِمًا ، حَتَّی تَسْتَوِیَ غُضُونُ بَطْنِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2989","","","كتاب الصلوات"
"2990","(۲۹۹۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی فَرْوَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : دَخَلَ الْمَسْجِدَ رَجُلٌ فَصَلَّی صَلاَۃً لاَ یُتِمُّ رُکُوعَہَا ، وَلاَ سُجُودَہَا ، قَالَ : فَذَکَرْت ذَلِکَ لِعَبْدِ اللہِ بْنِ یَزِیدَ ، فَقَالَ : ہِیَ عَلَی مَا فِیہَا خَیْرٌ مِنْ تَرْکِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 2990","","","كتاب الصلوات"
"2991","(۲۹۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْمِسْوَرِ بْنِ مَخْرَمَۃَ ؛ أَنَّہُ رَأَی رَجُلاً لاَ یُتِمُّ رُکُوعَہُ ، وَلاَ سُجُودَہُ ، فَقَالَ لَہُ : أَعِدْ ، فَأَبَی ، فَلَمْ یَدَعْہُ حَتَّی أَعَادَ۔","Da'if","Musannaf Ibn Abi Shaybah 2991","","","كتاب الصلوات"
"2992","(۲۹۹۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ مُسْلِمٍ ، قَالَ : جَائَ رَجُلٌ یُصَلِّی وَطَاوُوس جَالِسٌ فَجَعَلَ لاَ یُتِمُّ الرُّکُوعَ ، وَلاَ السُّجُودَ ، فَقَالَ بَعْضُ الْقَوْمِ : مَا لِہَذَا صَلاَۃٌ ، فَقَالَ طَاوُوس : مَہْ ،یُکْتَبُ لَہُ مِنْہَا بِقَدْرِ مَا أَدَّی۔","","Musannaf Ibn Abi Shaybah 2992","","","كتاب الصلوات"
"2993","(۲۹۹۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ یَحْیَی بْنِ عُبَیْدٍ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ لاَ یُتِمُّ الرُّکُوعَ ، وَلاَ السُّجُودَ ؟ فَقَالَ : ہِیَ خَیْرٌ مِنْ لاَ شَیْئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2993","","","كتاب الصلوات"
"2994","(۲۹۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَمْرٍو الْمُلاَئِیِّ ، عَنْ أَبِی قَیْسٍ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ رَأَی رَجُلاً یُصَلِّی ، فَأَبْصَرَہُ رَافِعًا رِجْلَیْہِ وَہُوَ سَاجِدٌ ، فَقَالَ : مَا تَمَّتْ صَلاَۃُ ہَذَا۔","","Musannaf Ibn Abi Shaybah 2994","","","كتاب الصلوات"
"2995","(۲۹۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ رَأَی رَجُلاً سَاجِدًا قَدْ رَفَعَ إحْدَی رِجْلَیْہِ ، فَقَالَ : جَعَلَہَا اللَّہُ سِتًّا ، وَجَعَلْتَہَا خَمْسًا۔","","Musannaf Ibn Abi Shaybah 2995","","","كتاب الصلوات"
"2996","(۲۹۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ سَلْمَانَ الْفَارِسِیِّ، قَالَ: الصَّلاَۃُ مِکْیَالٌ ، فَمَنْ أَوْفَی أَوْفَی اللَّہُ لَہُ ، وَقَدْ عَلِمْتُمْ مَا قَالَ اللَّہُ فِی الْکَیْلِ : {وَیْلٌ لِلْمُطَفِّفِینَ}۔","","Musannaf Ibn Abi Shaybah 2996","","","كتاب الصلوات"
"2997","(۲۹۹۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حَدَّثَنَا سُفْیَانُ ، عَنْ حَجَّاجِ بْنِ فُرَافِصَۃَ ، عَمَّنْ ذَکَرَہُ ، عَنْ أَبِی الدَّرْدَائِ؛ أَنَّہُ مَرَّ بِرَجُلٍ لاَ یُتِمُّ الرُّکُوعَ ، وَلاَ السُّجُودَ ، فَقِیلَ لَہُ ، فَقَالَ أَبُو الدَّرْدَائِ : شَیْئٌ خَیْرٌ مِنْ لاَ شَیْئَ۔","Majhul","Musannaf Ibn Abi Shaybah 2997","","","كتاب الصلوات"
"2998","(۲۹۹۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ مُفَضَّلِ بْنِ مُہَلْہَلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ؛ أَنَّ بِلاَلاً رَأَی رَجُلاً لاَ یُتِمُّ الرُّکُوعَ ، وَلاَ السُّجُودَ ، فَقَالَ : لَوْ مَاتَ ہَذَا مَاتَ عَلَی غَیْرِ مِلَّۃِ عِیسَی ابْنِ مَرْیَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 2998","","","كتاب الصلوات"
"2999","(۲۹۹۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الْحَسَنِ بْنِ الْحُرِّ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، قَالَ : أَخَذَ عَلْقَمَۃُ بِیَدِی ، فَقَالَ : أَخَذَ عَبْدُ اللہِ بِیَدِی ، فَقَالَ : أَخَذَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِی فَعَلِّمنِی التَّشَہُّدَ : التَّحِیَّاتُ لِلَّہِ ، وَالصَّلَوَاتُ ، وَالطَّیِّبَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ۔n(احمد ۱/۴۵۰۔ ابن حبان ۱۹۶۳)","Sahih","Musannaf Ibn Abi Shaybah 2999","","","كتاب الصلوات"
"3000","(۳۰۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَاالأَعْمَش ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا نُصَلِّی خَلْفَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَقُولُ : السَّلاَمُ عَلَی اللہِ قَبْلَ عِبَادِہِ ، السَّلاَمُ عَلَی جِبْرِیلَ ، السَّلاَمُ عَلَی مِیکَائِیلَ ، السَّلاَمُ عَلَی فُلاَنٍ وَفُلاَنٍ ، فَلَمَّا قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنَّ اللَّہَ ہُوَ السَّلاَمُ ، فَإِذَا جَلَسَ أَحَدُکُمْ فِی صَلاَتِہِ فَلْیَقُلِ : التَّحِیَّاتُ لِلَّہِ وَالصَّلَوَاتُ وَالطَّیِّبَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، ثُمَّ یَتَخَیَّرُ۔ (بخاری ۶۲۳۰۔ مسلم ۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 3000","","","كتاب الصلوات"
"3001","(۳۰۰۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ؛ مِثْلَ حَدِیثِ أَبِی وَائِلٍ، عَنْ عَبْدِاللہِ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی التَّشَہُّدِ۔ (احمد ۱/۴۱۳۔ طبرانی ۹۹۳۱)","Sahih","Musannaf Ibn Abi Shaybah 3001","","","كتاب الصلوات"
"3002","(۳۰۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنُ بْنُ عَبْدِ الرَّحْمَنِ ، وَمُغِیرَۃُ ، وَالأَعْمَش ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا إذَا جَلَسْنَا خَلْفَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الصَّلاَۃِ نَقُولُ : السَّلاَمُ عَلَی اللہِ ، السَّلاَمُ عَلَی جبریلَ ، السَّلاَمُ عَلَی مِیکَائِیلَ ، السَّلاَمُ عَلَی فُلاَنٍ وَفُلاَنٍ ، قَالَ : فَالْتَفَتَ إلَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ اللَّہَ ہُوَ السَّلاَمُ ، فَقُولُوا : التَّحِیَّاتُ لِلَّہِ وَالصَّلَوَاتُ وَالطَّیِّبَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، فَإِنَّکُمْ إذَا فَعَلْتُمْ ذَلِکَ ، فَقَدْ سَلَّمْتُمْ عَلَی کُلِّ عَبْدٍ صَالِحٍ فِی السَّموَاتِ وَالأَرْضِ۔n(بخاری ۷۳۸۱۔ مسلم ۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 3002","","","كتاب الصلوات"
"3003","(۳۰۰۳) حَدَّثَنَا أَبُو نُعَیْمٍ ، قَالَ : حدَّثَنَا سَیْفُ بْنُ أَبِی سُلَیْمَانَ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : حَدَّثَنِی عَبْدُ اللہِ بْنُ سَخْبَرَۃَ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ یَقُولُ : عَلَّمَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ التَّشَہُّدَ ، کَفِّی بَیْنَ کَفَّیْہِ، کَمَا یُعَلِّمُنِی السُّورَۃَ مِنَ الْقُرْآنِ : التَّحِیَّاتُ لِلَّہِ ، وَالصَّلَوَاتُ وَالطَّیِّبَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، وَہُوَ بَیْنَ ظَہْرَانَیْنَا ، فَلَمَّا قُبِضَ قُلْنَا : السَّلاَمُ عَلَی النَّبِیِّ۔ (بخاری ۶۲۶۵۔ مسلم ۵۹)","Sahih","Musannaf Ibn Abi Shaybah 3003","","","كتاب الصلوات"
"3004","(۳۰۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ، قَالَ: عَلَّمَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ التَّشَہُّدَ : التَّحِیَّاتُ لِلَّہِ ، وَالصَّلَوَاتُ وَالطَّیِّبَاتُ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ۔n(احمد ۱/۳۷۶)","Da'if","Musannaf Ibn Abi Shaybah 3004","","","كتاب الصلوات"
"3005","(۳۰۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، قَالَ : حدَّثَنِی قَتَادَۃُ ، عَنْ یُونُسَ بْنِ جُبَیْرٍ ، عَنْ حِطَّانَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی مُوسَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا کَانَ عِنْدَ الْقَعْدَۃِ فَلْیَکُنْ مِنْ قَوْلِ أَحَدِکُمْ : التَّحِیَّاتُ الطَّیِّبَاتُ الصَّلَوَاتُ لِلَّہِ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 3005","","","كتاب الصلوات"
"3006","(۳۰۰۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أَیْمَنَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : بِسْمِ اللہِ ، وَبِاللَّہِ ، التَّحِیَّاتُ لِلَّہِ ، وَالصَّلَوَاتُ لِلَّہِ ، السَّلاَمُ عَلَیْک أَیُّہَا النَّبِیُّ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، أَسْأَلُ اللَّہَ الْجَنَّۃَ ، وَأَعُوذُ بِاللَّہِ مِنَ النَّارِ۔ (احمد ۵/۳۶۳۔ ابن ماجہ ۹۰۲)","","Musannaf Ibn Abi Shaybah 3006","","","كتاب الصلوات"
