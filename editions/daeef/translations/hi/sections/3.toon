"444","[AI-translation] ((नमाज़ के दौरान पहलू पर हाथ रखना जहन्नमियों का आराम है))।"
"445","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) नमाज़ के दौरान अपनी दाढ़ी छूते))।"
"446","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) ने सज्दे के दौरान फूँकने से मना किया))।"
"447","[AI-translation] ((तुममें से किसी के लिए कंकड़ियों से अपना हाथ रोकना [सज्दे में] सौ ऊँटनियों से बेहतर है))।"
"448","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) नमाज़ के दौरान चेहरे से पसीना पोंछते))।"
"449","[AI-translation] ((नमाज़ के दौरान छींकना, ऊँघना और जमाही लेना शैतान से है))।"
"450","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) नमाज़ के दौरान जमाही को नापसन्द करते))।"
"451","[AI-translation] ((सबसे ख़ूबसूरत चेहरे वाला लोगों की इमामत करे))।"
"452","[AI-translation] ((अगर चाहते हो कि तुम्हारी नमाज़ें क़ुबूल हों तो तुम्हारे बेहतरीन लोग तुम्हारी नमाज़ों की इमामत करें))।"
"453","[AI-translation] ((जो मुत्तक़ी आलिम के पीछे नमाज़ पढ़े, गोया उसने नबी के पीछे नमाज़ पढ़ी))।"
"454","[AI-translation] ((हर नेक और बदकार के पीछे नमाज़ पढ़ो))।"
"455","[AI-translation] ((जो लोगों की इमामत करे फिर याद आए कि वह बे-वुज़ू या नापाकी की हालत में था, तो वह अपनी नमाज़ दोहराए और मुक़्तदी भी अपनी नमाज़ दोहराएँ))।"
"456","[AI-translation] ((मेरे बाद कोई कभी बैठकर इमामत न करे))।"
