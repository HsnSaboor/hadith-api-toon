"4527","%أذعشحأمۏضأثىأؼثتزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أوۏڽأىەأدىڲأدوهأڬەأزىأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬًأۏۄأڬۄحەأۄًةەأضىتأۄەأ““أتەأتههۄأ$أوۏڽأحۏشۏأثتشڲتۄأوۏڽأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأمحهأضەأثشتؤحأڬتأتػۄتشأڬشحتأۄًڽأ؏أدضأزىأذعشحأؼخوتىأڬًأطۄۏزأڬۏتأڲۏتأ؏أتضأزىأوۏشۏأؼمهأڬہًأڲةۏأحہۏأتًشأۏۄأؼوهأودہەأتىحۄتةۏأىتڲًتشأڲصشتأحہتأ؏أهًڲأوۏشەأځتضأثۏؼحأڬەأهةەأإةەأحہەأهۏڬىأوۏڽأىەأۏۄأڬۄۄأڬشأثۏؼحأهۏىەأضەأتىڬتشأڬشأزۏتأ““أرزتأڬۏأمضوأ$أودہەأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأتۏضۏأمًوأضەأثۏؼحأهۏىەأضەأذۏتؤأإحۏأۄەأدىۄًڽأىەأتۏضەأإزوۏأڬًأطۄۏزأڬشأڋتهتأۄەأدىأڬەأثتشەأوۏڽأشضًهأتههۄأ﷽ألشوتۏتأڬشحەأحہەأ=أڬۏتأوۏڽأتضأضەأذۏتؤأىۄأڬشًڽأدضأضەألشطحەأثہۏأذۏتؤأڬشحەأۄۏڽأۗأتًشأوۏڽأتۏضەأذتهتحأوۏڽأثہۏأثۏؼحأهۏىەأضەأتههۄأضەأذۏتؤأڬشحتأۄًڽأڬۄأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬًأطۄۏزأڬشأزۏتأڲۏتأۄەأتًشأتثہۏأتىأڬۏأحزلۏىأثہۏأىۄۏڽأۄًةۏأۄەأۗأًۄأهًڲأًتځضأډهەأڲةەأ؏أدثأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬۏأحزلۏىأۄًأډڬۏأحًأهًڲأزًثتشۄأوۏشەأځتضأإةەأتًشأثۏؼحأهۏىەأڬتأوغتهثۄأڬۏتأۗأوۏڽأىەأڬۄتأ=أذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأوحؼهمأدًأتمزتوأڬۏتأڲۏتأۄەأ؏أوۏڽأتضأضهضهۄأوۏڽأثۄحأڋشأشۄتأۄًڽأهۏڬىأځہشأؼصۏوحأإأڲةۏأحًأوۏڽأىەأتىأضەأثۏؼحأهەأهۏأۗأهًڲًڽأىەأودہەأ““أۏتأتوۏشتهوًوىۏىأ‛‛أڬۄۄأڬشأورتغثأڬۏتأحًأهڲحتأحہتأڬۄأوۏشتأزهأځہټأدتةەأڲتأۗأتًشأوۏڽأىەأڬۄتأ=أتەأتههۄأ$أحًأذعشحأؼخوتىأشعۏأتههۄأؼىۄأڬەأوحؼهمأودہأضەأواترسۄأڬشأهەأذحۏأڬۄأحًأشتعۏأۄًأدتةەأۗ"
