hadiths[11]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"415","83 - [مَا جَاءَ فِي الدَّفْنِ]  416  -  حَدَّثَنَا  زِيَادُ بْنُ أَيُّوبَ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  مَنْصُورٌ .  عَنِ  الْحَسَنِ ، قَالَ :  جُعِلَ فِي لَحْدِ [النَّبِيِّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَطِيفَةٌ حَمْرَاءُ  أَصَابَهَا  يَوْمَ خَيْبَرَ  ; لِأَنَّ  الْمَدِينَةَ  أَرْضٌ  سَبِخَةٌ  ( 18553 ) .         [1/300]      قَالَ أَبُو دَاوُدَ :  وَهُوَ  مُسْنَدٌ  إِلَّا [أَجْزَاءَ]  الْكَلَامِ [أُغْرِبَ فِيهَا]  ، [صَارَ  مُرْسَلًا]  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: باب في الدفن .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: هو .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: هذا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أغرب به فيه .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فلهذا صار مرسلا .","","Al-Marasil li-Abi Dawud 416","","الحسن البصري عن منصور بن زاذان الثقفي عن هشيم بن بشير عن دلويه زياد بن أيوب عن أبو داود السجستاني","ما جاء فِي الدفن"
"416","417  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ الْأَنْبَارِيُّ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  مُحَمَّدِ بْنِ مُرَّةَ الْقُرَشِيِّ ،  عَنْ  حَمَّادٍ .  عَنْ  إِبْرَاهِيمَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُخِذَ مِنْ قِبَلِ الْقِبْلَةِ  ، وَلَمْ يُسَلَّ سَلًّا [صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ]  ( 18408 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 417","","إبراهيم النخعي عن حماد بن أبي سليمان عن محمد بن مرة القرشي عن عبدة بن سليمان الكلابي عن محمد بن سليمان الأنباري عن أبو داود السجستاني","ما جاء فِي الدفن"
"417","[1/301]      418  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ فَارِسٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ - يَعْنِي الْفَزَازِيَّ  - .  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  أَنَّ [النَّبِيَّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَلَّمَ عَلَى الْجِنَازَةِ تَسْلِيمَةً وَاحِدَةً  ( 19085 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: الفزاري .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .","","Al-Marasil li-Abi Dawud 418","","عطاء بن السائب عن أبو إسحاق الفزاري عن الحسن بن الربيع البوراني عن محمد بن يحيى الذهلي عن أبو داود السجستاني","ما جاء فِي الدفن"
"418","419  -  حَدَّثَنَا  عَبَّادُ بْنُ مُوسَى ، وَسُلَيْمَانُ بْنُ دَاوُدَ الْعَتَكِيُّ الْمَعْنَى ، أَنَّ  خَلَفَ بْنَ خَلِيفَةَ ،  حَدَّثَهُمْ  .  عَنْ  أَبِيهِ  ، قَالَ : بَلَغَهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَضَعَ  نُعَيْمَ بْنَ مَسْعُودٍ  فِي الْقَبْرِ  ، وَنَزَعَ الْأَخِلَّةَ بِفِيهِ  ( 18615 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال عباد في حديثه : الأشجعي"" .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال أبو داود : هذا الاسم خطأ ، نعيم بن مسعود روى عن النبي صلى الله عليه وسلم قصة الخندق .","","Al-Marasil li-Abi Dawud 419","","خليفة بن صاعد بن برام الأشجعي عن خلف بن خليفة الأشجعي عن سليمان بن داود العتكي عن أبو داود السجستاني","ما جاء فِي الدفن"
"419","[1/302]      420  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  [حَدَّثَنَا  حَمَّادُ بْنُ خَالِدٍ]  ،  عَنْ  هِشَامِ بْنِ سَعْدٍ ،  عَنْ  زِيَادٍ - يَعْنِي ابْنَ ثَعْلَبٍ  - .  عَنْ  أَبِي الْمُنْذِرِ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَثَا فِي قَبْرٍ ثَلَاثًا  ( 19599 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا حماد يعني ابن خالد .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تغلب .","","Al-Marasil li-Abi Dawud 420","","أبو المنذر عن زياد عن أبي المنذر عن هشام بن سعد المخزومي عن حماد بن خالد الخياط عن أحمد بن منيع البغوي عن أبو داود السجستاني","ما جاء فِي الدفن"
"420","[1/303]      421  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَلَاءِ ، أَنَّ أَبَا بَكْرِ بْنَ عَيَّاشٍ ،  حَدَّثَهُمْ  .  حَدَّثَنَا  صَالِحُ بْنُ [أَبِي الْأَخْضَرِ]  ، قَالَ :  رَأَيْتُ قَبْرَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شِبْرًا أَوْ نَحْوًا مِنْ شِبْرٍ  ( 18815 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أبي صالح .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: يعني في الارتفاع .","","Al-Marasil li-Abi Dawud 421","","صالح بن أبي صالح المخزومي عن أبو بكر بن عياش عن أبو كريب محمد بن العلاء عن أبو داود السجستاني","ما جاء فِي الدفن"
"421","422  -  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ نَجْدَةَ ،  [حَدَّثَنَا  عِيسَى بْنُ يُونُسَ]  ،  عَنْ  مُحَمَّدِ بْنِ مُرَّةَ ،  عَنْ  حَمَّادٍ .  عَنْ  إِبْرَاهِيمَ ، قَالَ :  جُعِلَ قَبْرُ [النَّبِيِّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَبَثًا وَلَمْ يُسَوَّ تَسْوِيَةً  ( 18467 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: نا عيسى يعني ابن يونس .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .","","Al-Marasil li-Abi Dawud 422","","إبراهيم النخعي عن حماد بن أبي سليمان عن محمد بن مرة القرشي عن عيسى بن يونس بن أبي إسحاق عن عبد الوهاب بن نجدة عن أبو داود السجستاني","ما جاء فِي الدفن"
"422","[1/304]      423  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي حَصِينٍ .  عَنِ  الشَّعْبِيِّ ، قَالَ :  رَأَيْتُ قُبُورَ الشُّهَدَاءِ مُسَنَّمَةً  يَعْنِي  جُثًا  ( 18864 ) .","","Al-Marasil li-Abi Dawud 423","","الشعبي عن عثمان بن عاصم بن حصين عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن أبو داود السجستاني","ما جاء فِي الدفن"
"423","424  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ بْنِ قَعْنَبٍ ، وَعَبْدُ اللهِ بْنُ عُمَرَ بْنِ مُحَمَّدِ بْنِ أَبَانَ بْنِ صَالِحٍ ، أَنَّ عَبْدَ الْعَزِيزِ بْنَ مُحَمَّدٍ  حَدَّثَهُمْ  ،  عَنْ  عَبْدِ اللهِ بْنِ [مُحَمَّدٍ - يَعْنِي ابْنَ عُمَرَ]  - .  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ [رَشَّ عَلَى قَبْرِ]  ابْنِهِ  إِبْرَاهِيمَ  . زَادَ  ابْنُ         [1/305]      عُمَرَ  فِي حَدِيثِهِ : وَإِنَّهُ أَوَّلُ قَبْرٍ رُشَّ عَلَيْهِ ، وَإِنَّهُ قَالَ حِينَ دُفِنَ ، فَفَرَغَ  مِنْهُ عِنْدَ رَأْسِهِ : سَلَامٌ عَلَيْكُمْ . وَلَا أَعْلَمُهُ إِلَّا قَالَ : حَثَا عَلَيْهِ بِيَدِهِ  وَلَمْ يَقُلِ  الْقَعْنَبِيُّ  : [يَعْنِي]  ابْنَ عُمَرَ  ( 19331 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: محمد بن عمر .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رش قبر .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: وفرغ .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 424","","محمد بن عمر بن علي بن أبي طالب عن عبد الله بن محمد بن عمر بن علي بن أبي طالب عن عبد العزيز بن محمد الدراوردي عن عبد الله بن عمر مشكدانة عن أبو داود السجستاني","ما جاء فِي الدفن"
"424","425  -  حَدَّثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  حَدَّثَنَا  بَقِيَّةُ ،  [ح]  [وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَوْفٍ]  ،  حَدَّثَنَا  أَبُو الْمُغِيرَةِ ،  عَنْ  صَفْوَانَ .  عَنْ  أَبِي الْيَمَانِ الْهَوْزَنِيِّ ، قَالَ :  لَمَّا تُوُفِّيَ  أَبُو طَالِبٍ  عَمُّ [النَّبِيِّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ [النَّبِيُّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَارَضَ  جِنَازَتَهُ ، قَالَ  ابْنُ عَوْفٍ  : فَجَعَلَ يَمْشِي مُجَانِبًا لَهَا وَيَقُولُ :  بَرَّتْكَ رَحِمٌ ، وَجُزِيتَ خَيْرًا  . وَلَمْ يَقُمْ عَلَى قَبْرِهِ ( 19605 ) .  زَادَ  ابْنُ عَوْفٍ  : وَلَمْ يَسْتَغْفِرْ  ، وَلَمْ [يَذْكُرْ]  عَمْرٌو  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: وحدثنا ابن عوف .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يعارض .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يقل .","","Al-Marasil li-Abi Dawud 425","","عامر بن أبي عامر الهوزني عن صفوان بن عمرو السكسكي عن عبد القدوس بن الحجاج عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن أبو داود السجستاني","ما جاء فِي الدفن"
"425","[1/306]      426  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ،  حَدَّثَنَا  حَجَّاجٌ ،  عَنِ  ابْنِ جُرَيْجٍ .  أَخْبَرَنِي  مُحَمَّدُ بْنُ عَلِيٍّ ،  أَنَّ  إِبْرَاهِيمَ ابْنَ النَّبِيِّ  ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حُمِلَتْ جِنَازَتُهُ عَلَى  مَنْسِجِ  فَرَسٍ  ( 19323 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""سمعت أحمد بن حنبل قال : أنكر عليه فأخرج كتابه . قال : فإذا فيه أخبرني محمد بن علي ، فقال هذا"" .","","Al-Marasil li-Abi Dawud 426","","أبو جعفر الباقر عن ابن جريج عن حجاج بن محمد الأعور عن أحمد بن حنبل عن أبو داود السجستاني","ما جاء فِي الدفن"
