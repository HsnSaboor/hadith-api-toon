hadiths[83]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3122","«حافظ على العصرين: صلاة قبل طلوع الشمس وصلاة قبل غروبها»","صحيح","Sahih al-Jami al-Saghir 3122","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3123","«حب الأنصار آية الإيمان وبغض الأنصار آية المنافق»","صحيح","Sahih al-Jami al-Saghir 3123","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3124","«حبب إلي من دنياكم: النساء والطيب وجعلت قرة عيني في الصلاة»","صحيح","Sahih al-Jami al-Saghir 3124","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3125","«حبذا المتخللون من أمتي»","حسن","Sahih al-Jami al-Saghir 3125","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3126","«حجبت النار بالشهوات وحجبت الجنة بالمكاره»","صحيح","Sahih al-Jami al-Saghir 3126","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3127","«حج عن أبيك واعتمر»","صحيح","Sahih al-Jami al-Saghir 3127","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3128","«حج عن نفسك! ثم حج عن شبرمة»","صحيح","Sahih al-Jami al-Saghir 3128","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3129","«حد الطريق سبعة أذرع»","صحيح","Sahih al-Jami al-Saghir 3129","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3130","«حد يعمل في الأرض خير لأهل الأرض من أن يمطروا أربعين صباحا»","حسن","Sahih al-Jami al-Saghir 3130","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3131","«حدثوا عن بني إسرائيل ولا حرج»","صحيح","Sahih al-Jami al-Saghir 3131","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3132","«حرام شف ما لم يضمن»","حسن","Sahih al-Jami al-Saghir 3132","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3133","«حرام قليل ما أسكر كثيره»","صحيح","Sahih al-Jami al-Saghir 3133","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3134","«حرم الله الخمر وكل مسكر حرام»","صحيح","Sahih al-Jami al-Saghir 3134","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3135","«حرم على النار كل هين لين سهل قريب من الناس»","صحيح","Sahih al-Jami al-Saghir 3135","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3136","«حرم على عينين أن تنالهما النار: عين بكت من خشية الله وعين باتت تحرس الإسلام وأهله من أهل الكفر»","حسن","Sahih al-Jami al-Saghir 3136","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3137","«حرم لباس الحرير والذهب على ذكور أمتي وأحل لإناثهم»","صحيح","Sahih al-Jami al-Saghir 3137","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3138","«حرم ما بين لابتي المدينة على لساني»","صحيح","Sahih al-Jami al-Saghir 3138","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3139","«حرمت التجارة في الخمر»","صحيح","Sahih al-Jami al-Saghir 3139","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3140","«حرمة مال المسلم كحرمة دمه»","حسن","Sahih al-Jami al-Saghir 3140","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3141","«حرمة نساء المجاهدين على القاعدين كحرمة أمهاتهم وما من رجل من القاعدين يخلف رجلا من المجاهدين في أهله فيخونه فيهم إلا وقف له يوم القيامة فقيل له: قد خلفك في أهلك فخذ من حسناته ما شئت فيأخذ من عمله ما شاء فما ظنكم؟»","صحيح","Sahih al-Jami al-Saghir 3141","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3142","«حريم النخلة مد جريدها»","صحيح","Sahih al-Jami al-Saghir 3142","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3143","«حسبك من نساء العالمين: مريم بنت عمران وخديجة بنت خويلد وفاطمة بنت محمد وآسية امرأة فرعون»","صحيح","Sahih al-Jami al-Saghir 3143","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3144","«حسن الصوت زينة القرآن»","حسن","Sahih al-Jami al-Saghir 3144","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3145","«حسنوا القرآن بأصواتكم فإن الصوت الحسن يزيد القرآن حسنا»","صحيح","Sahih al-Jami al-Saghir 3145","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3146","حسين مني وأنا منه أحب الله من أحب حسينا, الحسن والحسين سبطان من الأسباط","حسن","Sahih al-Jami al-Saghir 3146","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3147","«حفت الجنة بالمكاره وحفت النار بالشهوات»","صحيح","Sahih al-Jami al-Saghir 3147","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3148","«حق الزوج على زوجته أن لو كانت به قرحة فلحستها ما أدت حقه»","صحيح","Sahih al-Jami al-Saghir 3148","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3149","«حق المرأة على الزوج أن يطعمها إذا طعم ويكسوها إذا اكتسى ولا يضرب الوجه ولا يقبح ولا يهجر إلا في البيت»","صحيح","Sahih al-Jami al-Saghir 3149","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3150","«حق المسلم على المسلم خمس: رد السلام وعيادة المريض واتباع الجنائز وإجابة الدعوة وتشميت العاطس»","صحيح","Sahih al-Jami al-Saghir 3150","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3151","«حق المسلم على المسلم ست: إذا لقيته فسلم عليه وإذا دعاك فأجبه وإذا استنصحك فانصح له وإذا عطس فحمد الله فشمته وإذا مرض فعده وإذا مات فاتبعه»","صحيح","Sahih al-Jami al-Saghir 3151","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3152","«حق على الله عون من نكح التماس العفاف عما حرم الله»","حسن","Sahih al-Jami al-Saghir 3152","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3153","حق كل مسلم السواك وغسل يوم الجمعة وأن يمس من طيب أهله إن كان","صحيح","Sahih al-Jami al-Saghir 3153","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3154","«حق لله على كل مسلم أن يغتسل في كل سبعة أيام يوما يغسل فيه رأسه وجسده»","صحيح","Sahih al-Jami al-Saghir 3154","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3155","«حلوة الدنيا مرة الآخرة ومرة الدنيا حلوة الآخرة»","صحيح","Sahih al-Jami al-Saghir 3155","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3156","«حليف القوم منهم وابن أخت القوم منهم»","صحيح","Sahih al-Jami al-Saghir 3156","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3157","«حمزة بن عبد المطلب أخي من الرضاعة»","صحيح","Sahih al-Jami al-Saghir 3157","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3158","«حمزة سيد الشهداء يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3158","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3159","«حوسب رجل ممن كان قبلكم فلم يوجد له من الخير شيء إلا أنه كان رجلا موسرا وكان يخالط الناس وكان يأمر غلمانه أن يتجاوزوا عن المعسر فقال الله عز وجل لملائكته: نحن أحق بذلك منه تجاوزوا عنه»","صحيح","Sahih al-Jami al-Saghir 3159","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3160","«حوضي كما بين صنعاء والمدينة فيه الآنية مثل الكواكب»","صحيح","Sahih al-Jami al-Saghir 3160","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3161","حوضي مسيرة شهر وزواياه سواء وماؤه أبيض من اللبن وريحه أطيب من المسك وكيزانه كنجوم السماء من يشرب منه فلا يظمأ أبدا","صحيح","Sahih al-Jami al-Saghir 3161","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3162","«حوضي من عدن إلى عمان البلقاء ماؤه أشد بياضا من اللبن وأحلى من العسل وأكوابه عدد نجوم السماء من يشرب منه شربة لم يظمأ بعدها أبدا أول الناس ورودا عليه فقراء المهاجرين الشعث رءوسا الدنس ثيابا الذين لا ينكحون المتنعمات ولا تفتح لهم السدد»","صحيح","Sahih al-Jami al-Saghir 3162","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3163","«حولها ندندن»","صحيح","Sahih al-Jami al-Saghir 3163","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3164","«حيثما كنتم فصلوا علي فإن صلاتكم تبلغني»","صحيح","Sahih al-Jami al-Saghir 3164","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3165","«حيثما مررت بقبر كافر فبشره بالنار»","صحيح","Sahih al-Jami al-Saghir 3165","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3166","«الحائض والنفساء إذا أتتا على الوقت تغتسلان وتحرمان وتقضيان المناسك كلها غير الطواف بالبيت»","صحيح","Sahih al-Jami al-Saghir 3166","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3167","«الحاج: الشعث التفل»","حسن","Sahih al-Jami al-Saghir 3167","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3168","«الحبة السوداء فيها شفاء من كل داء إلا الموت»","صحيح","Sahih al-Jami al-Saghir 3168","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3169","«الحجامة على الريق أمثل وفيها شفاء وبركة وتزيد في الحفظ وفي العقل فاحتجموا على بركة الله يوم الخميس واجتنبوا الحجامة يوم الجمعة ويوم السبت ويوم الأحد واحتجموا يوم الاثنين والثلاثاء فإنه اليوم الذي عافى الله فيه أيوب من البلاء واجتنبوا الحجامة يوم الأربعاء فإنه اليوم الذي ابتلي فيه أيوب وما يبدو جذام ولا برص إلا في يوم الأربعاء أو في ليلة الأربعاء»","حسن","Sahih al-Jami al-Saghir 3169","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3170","«الحج المبرور ليس له جزاء إلا الجنة»","حسن","Sahih al-Jami al-Saghir 3170","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3171","«الحج جهاد كل ضعيف»","حسن","Sahih al-Jami al-Saghir 3171","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3172","«الحج عرفة من جاء قبل طلوع الفجر من ليلة جمع فقد أدرك الحج أيام منى ثلاثة فمن تعجل في يومين فلا إثم عليه ومن تأخر فلا إثم عليه»","صحيح","Sahih al-Jami al-Saghir 3172","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3173","«الحجاج والعمار وفد الله دعاهم فأجابوه وسألوه فأعطاهم»","حسن","Sahih al-Jami al-Saghir 3173","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3174","«الحجر الأسود من الجنة»","صحيح","Sahih al-Jami al-Saghir 3174","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3175","«الحجر الأسود من حجارة الجنة»","صحيح","Sahih al-Jami al-Saghir 3175","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3176","«الحرب خدعة»","صحيح","Sahih al-Jami al-Saghir 3176","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3177","«الحرير ثياب من لا خلاق له»","صحيح","Sahih al-Jami al-Saghir 3177","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3178","«الحسب: المال والكرم: التقوى»","صحيح","Sahih al-Jami al-Saghir 3178","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3179","«الحسن مني والحسين من علي»","حسن","Sahih al-Jami al-Saghir 3179","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3180","«الحسن والحسين سيدا شباب أهل الجنة»","حسن","Sahih al-Jami al-Saghir 3180","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3181","«الحسن والحسين سيدا شباب أهل الجنة إلا ابني الخالة عيسى بن مريم ويحيى بن زكريا وفاطمة سيدة نساء أهل الجنة إلا ما كان من مريم بنت عمران»","صحيح","Sahih al-Jami al-Saghir 3181","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3182","«الحسن والحسين سيدا شباب أهل الجنة وأبوهما خير منهما»","صحيح","Sahih al-Jami al-Saghir 3182","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3183","«الحلف منفقة للسلعة ممحقة للبركة»","صحيح","Sahih al-Jami al-Saghir 3183","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3184","«الحمد لله رب العالمين: أم القرآن وأم الكتاب والسبع المثاني»","صحيح","Sahih al-Jami al-Saghir 3184","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3185","«الحمد لله رب العالمين هي: السبع المثاني الذي أوتيته والقرآن العظيم»","صحيح","Sahih al-Jami al-Saghir 3185","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3186","«الحمى حظ المؤمن من النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3186","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3187","«الحمى حظ كل مؤمن من النار»","صحيح","Sahih al-Jami al-Saghir 3187","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3188","«الحمى كير من جهنم فما أصاب المؤمن منها كان حظه من النار»","حسن","Sahih al-Jami al-Saghir 3188","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3189","«الحمى كير من جهنم فنحوها عنكم بالماء البارد»","صحيح","Sahih al-Jami al-Saghir 3189","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3190","«الحمى كير من جهنم وهي نصيب المؤمن من النار»","صحيح","Sahih al-Jami al-Saghir 3190","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3191","«الحمى من فيح جهنم فأبردوها بالماء»","صحيح","Sahih al-Jami al-Saghir 3191","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3192","«الحمام حرام على نساء أمتي»","حسن","Sahih al-Jami al-Saghir 3192","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3193","الحلال بين والحرام بين وبينهما أمور مشتبهات لا يعلمها كثير من الناس فمن اتقى الشبهات فقد استبرأ لعرضه ودينه ومن وقع في الشبهات وقع في الحرام كراع يرعى حول الحمى يوشك أن يواقعه ألا وإن لكل ملك حمى ألا وإن حمى الله تعالى في أرضه محارمه ألا وإن في الجسد مضغة إذا صلحت صلح الجسد كله وإذا فسدت فسد الجسد كله ألا وهي القلب","صحيح","Sahih al-Jami al-Saghir 3193","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3194","«الحلال بين والحرام بين فدع ما يريبك إلى ما لا يريبك»","حسن","Sahih al-Jami al-Saghir 3194","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3195","«الحلال ما أحل الله في كتابه والحرام ما حرم الله في كتابه وما سكت عنه فهو مما عفا عنه»","حسن","Sahih al-Jami al-Saghir 3195","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3196","«الحياء خير كله»","صحيح","Sahih al-Jami al-Saghir 3196","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3197","«الحياء من الإيمان»","صحيح","Sahih al-Jami al-Saghir 3197","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3198","«الحياء من الإيمان وأحيى أمتي عثمان»","صحيح","Sahih al-Jami al-Saghir 3198","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3199","«الحياء من الإيمان والإيمان في الجنة والبذاء من الجفاء والجفاء في النار»","صحيح","Sahih al-Jami al-Saghir 3199","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3200","«الحياء والإيمان قرنا جميعا فإذا رفع أحدهما رفع الآخر»","صحيح","Sahih al-Jami al-Saghir 3200","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3201","«الحياء والعي شعبتان من الإيمان والبذاء والبيان شعبتان من النفاق»","صحيح","Sahih al-Jami al-Saghir 3201","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3202","«الحياء لا يأتي إلا بخير»","صحيح","Sahih al-Jami al-Saghir 3202","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3203","«الحيات مسخ الجن صورة كما مسخت القردة والخنازير من بني إسرائيل»","صحيح","Sahih al-Jami al-Saghir 3203","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
"3204","«الحية فاسقة والعقرب فاسقة والفأرة فاسقة والغراب فاسق»","صحيح","Sahih al-Jami al-Saghir 3204","","","الأحاديث المبدوءة بحرف الحاء Hadith Beginning with the Letter Ha (ح)"
